module readline : Readline export
    (* Raised on a system error, such as a history file that cannot be
     * written *)
    let error: Exception = external "(&quest_exc_readline_error)"
    (* Raised by readLine at the end of the input (Ctrl-D on an empty line) *)
    let endOfInput: Exception = external "(&quest_exc_readline_end_of_input)"
    (* Raised by readLine when the line is interrupted (Ctrl-C); the line typed
     * so far is discarded *)
    let interrupted: Exception = external "(&quest_exc_readline_interrupted)"

    (* Whether readLine edits lines *)
    let editing(): Bool = external "quest_readline_editing"
    (* Writes prompt and reads a line, without its newline *)
    let readLine(prompt: String): String = external "quest_readline_read_line"

    (* Adds a line to the history *)
    let addHistory(line: String): Ok = external "quest_readline_add_history"
    (* Adds the lines of a history file to the history, if the file exists *)
    let readHistory(path: String): Ok = external "quest_readline_read_history"
    (* Writes the history, its last maxLines lines, to a file *)
    let writeHistory(path: String maxLines: Int): Ok = external "quest_readline_write_history"
end
