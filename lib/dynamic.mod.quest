(* Standard library: dynamic values (Cardelli, Typeful Programming §9.1)

   A dynamic value is an auto value whose one component is the value; new and be are the auto operations, and the
   operations that need to traverse values generically are implemented by the runtime. *)

module dynamic : Dynamic
import
    reader: Reader
    writer: Writer
export
    Let T = Auto A::TYPE with a: A end;

    (* Raised by the runtime operations as well, so it is the runtime's exception *)
    let error: Exception = external "(&quest_exc_dynamic_error)";

    let new(A::TYPE a: A): T = auto :A with a end;

    let be(A::TYPE d: T): A =
        inspect d
        when A with x then x.a
        else raise error as A end
        end;

    let copy(d: T): T = external "quest_dynamic_copy";

    let intern(rd: reader.T): T = external "quest_dynamic_intern";

    let extern(wr: writer.T d: T): Ok = external "quest_dynamic_extern";
end;
