(* Real numbers to and from decimal text, exactly; the interface describes the
 * operations.
 *
 * Why this module exists: the C runtime formats a real by asking libc's
 * snprintf for its correctly rounded decimal of p digits, for p from 1 up,
 * until strtod reads one back as the same real (quest_shortest_digits), and
 * reads a real with strtod. A target without libc (WebAssembly,
 * docs/wasm-plan.md section 4.3) has neither, and must print and read reals to
 * the byte as the C runtime does. So this module is the two libc operations,
 * and the runtime's loop over them, in Quest.
 *
 * Method: plain exact arithmetic, not one of the fast algorithms (Ryu, Grisu,
 * Eisel-Lemire), whose subtlety is in avoiding big integers. A finite real is
 * m * 2^e exactly, for integers m and e, and a decimal is c * 10^q, so each
 * question is a comparison or a division of two integers, which may be large
 * (2^1074 has 324 digits):
 *   - the digits of a real: the ratio n / d that it is, scaled by a power of
 *     ten into [1, 10), gives one digit at a time, as long division does;
 *   - whether a decimal reads back as a real: it does when it lies between
 *     the midpoints that separate the real from its neighbors, the midpoints
 *     themselves included when the real's significand is even (the tie goes to
 *     the even neighbor);
 *   - the real nearest a decimal: the ratio, scaled by a power of two so that
 *     its integer part has the significand's 53 bits (fewer for a subnormal),
 *     gives the significand one bit at a time; the remainder rounds it.
 *
 * Integers: a natural number is an Array(Int) of limbs in base 2^30, least
 * significant first, with no zero limbs at the top (zero is one 0 limb). The
 * operations need only a number times a small one plus a small one, a shift,
 * a subtraction, and a comparison: no general multiplication or division.
 * A limb is below 2^30 so that a limb times a small factor, below 2^30 too,
 * fits an Int, and so that on WebAssembly a limb is an i31ref, unboxed in an
 * array (docs/wasm-plan.md section 2.2).
 *
 * Imports: only word, for a real's bits, and string and ascii, for text.
 * util/bignum would serve, but it imports util/strutil and conv, whose real
 * conversions this module is to provide on a target without libc, which
 * would make a cycle of imports there. *)

module realconv : RealConv
import
    word : Word
    stringOp = string : StringOp
    ascii : Ascii
export
    Def Digits = Tuple digits: Array(Int) exponent: Int end

    (* ======================================================================
     * 1. Natural numbers
     * ====================================================================== *)

    (* A natural number in base 2^30, least significant limb first *)
    Let N = Array(Int)

    let base = 1073741824
    let twoTo52 = 4503599627370496
    let twoTo53 = 9007199254740992

    let max(a: Int b: Int): Int = if a > b then a else b end

    (* The floor of a / b, for b > 0 *)
    let floorDiv(a: Int b: Int): Int = if a >= 0 then a / b else 0 - {{{{0 - a} + b} - 1} / b} end

    (* n, for 0 <= n < 2^90 *)
    let nat(n: Int): N =
        if n < base then array of n end
        elsif n < {base * base} then array of {n % base} {n / base} end
        else array of {n % base} {{n / base} % base} {n / {base * base}} end
        end

    let isZero(a: N): Bool = {extent a is 1} andif {a[0] is 0}

    (* a's first k limbs, without the zero limbs at their top: a itself, if
     * that is all of it *)
    let trimmed(a: N k: Int): N =
        begin
            let var n = k
            while {n > 1} andif {a[n - 1] is 0} do n := n - 1 end
            if n is extent a then a
            else
                let r = array of(n 0)
                for i = 0 upto n - 1 do r[i] := a[i] end
                r
            end
        end

    (* a * k + c, for 0 <= k, c < 2^30 *)
    let mulAdd(a: N k: Int c: Int): N =
        begin
            let n = extent a
            let r = array of({n + 1} 0)
            let var carry = c
            for i = 0 upto n - 1 do
                let t = {a[i] * k} + carry
                r[i] := t % base
                carry := t / base
            end
            r[n] := carry
            trimmed(r {n + 1})
        end

    (* 2^p, for 0 <= p < 63 *)
    let pow2(p: Int): Int =
        begin
            let var x = 1
            for i = 1 upto p do x := x * 2 end
            x
        end

    (* 10^p, for 0 <= p <= 18 *)
    let pow10(p: Int): Int =
        begin
            let var x = 1
            for i = 1 upto p do x := x * 10 end
            x
        end

    (* a * 2^bits, for bits >= 0 *)
    let shiftLeft(a: N bits: Int): N =
        begin
            let whole = bits / 30
            let m = mulAdd(a pow2(bits % 30) 0)
            if {whole is 0} orif isZero(m) then m
            else
                let r = array of({extent m + whole} 0)
                for i = 0 upto extent m - 1 do r[i + whole] := m[i] end
                r
            end
        end

    (* a * 10^p, for p >= 0 *)
    let mulPow10(a: N p: Int): N =
        begin
            let var r = a
            let var k = p
            while k >= 9 do
                r := mulAdd(r 1000000000 0)
                k := k - 9
            end
            mulAdd(r pow10(k) 0)
        end

    (* ~1, 0, or 1, as a is less than, equal to, or greater than b *)
    let compare(a: N b: N): Int =
        if extent a < extent b then ~1
        elsif extent a > extent b then 1
        else
            let var i = extent a - 1
            while {i >= 0} andif {a[i] is b[i]} do i := i - 1 end
            if i < 0 then 0 elsif a[i] < b[i] then ~1 else 1 end
        end

    (* a - b, for a >= b *)
    let sub(a: N b: N): N =
        begin
            let n = extent a
            let r = array of(n 0)
            let var borrow = 0
            for i = 0 upto n - 1 do
                let y = if i < extent b then b[i] else 0 end
                let d = {a[i] - y} - borrow
                if d < 0 then
                    r[i] := d + base
                    borrow := 1
                else
                    r[i] := d
                    borrow := 0
                end
            end
            trimmed(r n)
        end

    (* The number of bits of n, for n >= 0: 0 for 0 *)
    let bitsOfInt(n: Int): Int =
        begin
            let var k = 0
            let var x = n
            while x > 0 do
                x := x / 2
                k := k + 1
            end
            k
        end

    let bitLength(a: N): Int = {30 * {extent a - 1}} + bitsOfInt(a[extent a - 1])

    (* The number whose decimal digits are ds's first nd *)
    let natOfDigits(ds: Array(Int) nd: Int): N =
        begin
            let var r = nat(0)
            let var chunk = 0
            let var size = 0
            for i = 0 upto nd - 1 do
                chunk := {chunk * 10} + ds[i]
                size := size + 1
                if size is 9 then
                    r := mulAdd(r 1000000000 chunk)
                    chunk := 0
                    size := 0
                end
            end
            mulAdd(r pow10(size) chunk)
        end

    (* a * b, schoolbook: each step's sum is below 2^61 *)
    let mul(a: N b: N): N =
        begin
            let la = extent a
            let lb = extent b
            let r = array of({la + lb} 0)
            for i = 0 upto la - 1 do
                let ai = a[i]
                let var carry = 0
                for j = 0 upto lb - 1 do
                    let t = {r[i + j] + {ai * b[j]}} + carry
                    r[i + j] := t % base
                    carry := t / base
                end
                r[i + lb] := carry
            end
            trimmed(r {la + lb})
        end

    (* ======================================================================
     * 2. A real's parts
     * ====================================================================== *)

    (* |r| is m * 2^e; narrow when r's lower neighbor is nearer than its upper,
     * as for a power of two that is a normal real other than the least *)
    Def Binary = Tuple m: Int e: Int narrow: Bool end

    let fieldOf(r: Real): Int = word.toInt(word.extract(word.fromReal(r) 52 11))
    let fractionOf(r: Real): Int = word.toInt(word.extract(word.fromReal(r) 0 52))

    (* r's significand and exponent; r finite *)
    let binary(r: Real): Binary =
        begin
            let field = fieldOf(r)
            let fraction = fractionOf(r)
            if field is 0 then tuple let m = fraction let e = ~1074 let narrow = false end
            else tuple let m = fraction + twoTo52 let e = field - 1075 let narrow = {fraction is 0} andif {field > 1} end
            end
        end

    let fromFields(negative: Bool field: Int fraction: Int): Real =
        begin
            let w = word.orBits(word.shift(word.fromInt(field) 52) word.fromInt(fraction))
            word.toReal(if negative then word.orBits(w word.shift(word.fromInt(1) 63)) else w end)
        end

    (* ======================================================================
     * 3. Digits of a real
     * ====================================================================== *)

    (* The first count digits of |r|'s exact decimal, its exponent, and whether
     * any digit after them is not zero (sticky) *)
    Def Generated = Tuple digits: Array(Int) exponent: Int sticky: Bool end

    (* r finite and not zero, count at least 1 *)
    let generate(r: Real count: Int): Generated =
        begin
            let b = binary(r)
            (* |r| is n / d *)
            let var n = shiftLeft(nat(b.m) max(b.e 0))
            let var d = shiftLeft(nat(1) max({0 - b.e} 0))
            (* 2^k <= |r| < 2^(k + 1), so x, the exponent, is floor(k log10 2) or
             * one more; 78913 / 2^18 is log10 2 a little low, so the estimate
             * may be one less still, and the loops below correct it *)
            let k = {bitsOfInt(b.m) - 1} + b.e
            let var x = floorDiv({k * 78913} 262144)
            if x >= 0 then d := mulPow10(d x) else n := mulPow10(n {0 - x}) end
            while compare(n mulAdd(d 10 0)) >= 0 do
                d := mulAdd(d 10 0)
                x := x + 1
            end
            while compare(n d) < 0 do
                n := mulAdd(n 10 0)
                x := x - 1
            end
            (* Now 1 <= n / d < 10: each digit is the integer part, and the rest,
             * times ten, gives the next *)
            let multiples = array of(10 d)
            for j = 0 upto 9 do multiples[j] := mulAdd(d j 0) end
            let digits = array of(count 0)
            for i = 0 upto count - 1 do
                let var j = 9
                while compare(n multiples[j]) < 0 do j := j - 1 end
                digits[i] := j
                n := sub(n multiples[j])
                if i < {count - 1} then n := mulAdd(n 10 0) end
            end
            tuple let digits = digits let exponent = x let sticky = not(isZero(n)) end
        end

    (* g's digits rounded to p of them, ties to even; g has more than p *)
    let roundTo(g: Generated p: Int): Digits =
        begin
            let ds = array of(p 0)
            for i = 0 upto p - 1 do ds[i] := g.digits[i] end
            let next = g.digits[p]
            let var rest = g.sticky
            for i = p + 1 upto extent g.digits - 1 do
                if g.digits[i] isnot 0 then rest := true end
            end
            let up = {next > 5} orif {{next is 5} andif {rest orif {{ds[p - 1] % 2} is 1}}}
            let var x = g.exponent
            if up then
                let var i = p - 1
                while {i >= 0} andif {ds[i] is 9} do
                    ds[i] := 0
                    i := i - 1
                end
                if i >= 0 then ds[i] := ds[i] + 1
                else
                    (* 9.99...9 rounds up to 10.0...0 *)
                    ds[0] := 1
                    x := x + 1
                end
            end
            tuple let digits = ds let exponent = x end
        end

    let rounded(r: Real p: Int): Digits = roundTo(generate(r {p + 1}) p)

    (* The midpoints that separate a real from its neighbors, as integers to
     * compare a candidate's with. A candidate of the real's exponent x (or one
     * more, after rounding up) and at most 17 digits c is c * 10^s times
     * 10^(x - 16), for some s >= 0, and a midpoint is mid * 2^(e - 2) for an
     * integer mid; each negative power moves to the other side, so that the
     * candidate's side is c * 10^s * factor and the midpoints' are below and
     * above. Made once for a real, since the powers may be large and every
     * candidate shares them. *)
    Def Bounds = Tuple factor: N below: N above: N even: Bool x: Int end

    let bounds(b: Binary x: Int): Bounds =
        begin
            let s10 = x - 16
            let s2 = b.e - 2
            let scaled(mid: Int): N = shiftLeft(mulPow10(nat(mid) max({0 - s10} 0)) max(s2 0))
            (* The lower midpoint is a quarter of the spacing below a narrow
             * real, and half of it below any other *)
            let low = if b.narrow then {4 * b.m} - 1 else {4 * b.m} - 2 end
            tuple
                let factor = shiftLeft(mulPow10(nat(1) max(s10 0)) max({0 - s2} 0))
                let below = scaled(low)
                let above = scaled({4 * b.m} + 2)
                let even = {b.m % 2} is 0
                let x = x
            end
        end

    (* Whether ds's first nd digits, with exponent x, read back as the real
     * whose bounds are bd: they lie between its midpoints, either included
     * when its significand is even, since a tie goes to the even neighbor *)
    let readsBack(ds: Array(Int) nd: Int x: Int bd: Bounds): Bool =
        begin
            let v = mul(mulPow10(natOfDigits(ds nd) {{x - bd.x} + {17 - nd}}) bd.factor)
            let below = compare(v bd.below)
            let above = compare(v bd.above)
            if bd.even then {below >= 0} andif {above <= 0} else {below > 0} andif {above < 0} end
        end

    (* Adds delta (1 or ~1) to the last of ds's digits, in place; false when the
     * result would gain or lose a digit (quest_digits_step) *)
    let step(ds: Array(Int) delta: Int): Bool =
        begin
            let var i = extent ds - 1
            let var done = false
            let var result = false
            while {i >= 0} andif not(done) do
                let d = ds[i] + delta
                if {d >= 0} andif {d <= 9} then
                    ds[i] := d
                    done := true
                    result := ds[0] isnot 0
                else
                    ds[i] := if delta > 0 then 0 else 9 end
                    i := i - 1
                end
            end
            result
        end

    let copyDigits(ds: Array(Int)): Array(Int) =
        begin
            let c = array of(extent ds 0)
            for i = 0 upto extent ds - 1 do c[i] := ds[i] end
            c
        end

    (* The C runtime's loop: for each length p from 1, the correctly rounded
     * decimal of p digits if it reads back, else either of its neighbors that
     * does. Beside a power of two the reals' spacing differs on each side, so
     * a neighbor can read back when the nearest does not. 17 digits always
     * read back. *)
    let shortest(r: Real): Digits =
        begin
            let g = generate(r 18)
            let b = bounds(binary(r) g.exponent)
            let var result = roundTo(g 17)
            let var p = 1
            let var found = false
            while {p <= 17} andif not(found) do
                let d = roundTo(g p)
                if readsBack(d.digits p d.exponent b) then
                    result := d
                    found := true
                else
                    let var delta = ~1
                    while {delta <= 1} andif not(found) do
                        let c = copyDigits(d.digits)
                        if step(c delta) andif readsBack(c p d.exponent b) then
                            result := tuple let digits = c let exponent = d.exponent end
                            found := true
                        end
                        delta := delta + 2
                    end
                end
                p := p + 1
            end
            result
        end

    (* ======================================================================
     * 4. Text
     * ====================================================================== *)

    let digitChar(d: Int): Char = ascii.char(48 + d)

    (* ds[start] to ds[stop - 1] as text *)
    let digitText(ds: Array(Int) start: Int stop: Int): String =
        begin
            let s = stringOp.new(max({stop - start} 0) '0')
            for i = start upto stop - 1 do stringOp.setChar(s {i - start} digitChar(ds[i])) end
            s
        end

    let zeros(n: Int): String = stringOp.new(max(n 0) '0')

    (* n >= 0 in decimal, with at least two digits, as printf's %02d *)
    let twoDigits(n: Int): String =
        begin
            let var k = 0
            let var x = n
            while x > 0 do
                x := x / 10
                k := k + 1
            end
            let width = max(k 2)
            let s = stringOp.new(width '0')
            let var y = n
            for i = width - 1 downto 0 do
                stringOp.setChar(s i digitChar(y % 10))
                y := y / 10
            end
            s
        end

    let cat(a: String b: String): String = stringOp.cat(a b)

    (* quest_format_real *)
    let magnitude(r: Real): String =
        if fieldOf(r) is 2047 then "inf"
        elsif {fieldOf(r) is 0} andif {fractionOf(r) is 0} then "0.0"
        else
            let d = shortest(r)
            let ds = d.digits
            let x = d.exponent
            let var nd = extent ds
            while {nd > 1} andif {ds[nd - 1] is 0} do nd := nd - 1 end
            (* |r| is 0.d1d2... * 10^point *)
            let point = x + 1
            if {point <= ~4} orif {point > 16} then
                let e = cat(if x < 0 then "e-" else "e+" end twoDigits(if x < 0 then 0 - x else x end))
                if nd is 1 then cat(digitText(ds 0 1) e)
                else cat(cat(cat(digitText(ds 0 1) ".") digitText(ds 1 nd)) e)
                end
            elsif point <= 0 then cat(cat("0." zeros(0 - point)) digitText(ds 0 nd))
            elsif point >= nd then cat(cat(digitText(ds 0 nd) zeros(point - nd)) ".0")
            else cat(cat(digitText(ds 0 point) ".") digitText(ds point nd))
            end
        end

    let toString(r: Real): String =
        if word.getBit(word.fromReal(r) 63) then cat("~" magnitude(r)) else magnitude(r) end

    (* ======================================================================
     * 5. Reading a real
     * ====================================================================== *)

    (* The real nearest m * 10^q, with m's nd decimal digits significant *)
    let fromDecimal(m: N nd: Int q: Int negative: Bool): Real =
        (* m * 10^q < 10^(q + nd); below 10^-324, it is under half the least
         * subnormal (2^-1074, about 4.9e-324), and at least 10^309 it is past
         * the largest real *)
        if isZero(m) orif {{q + nd} < ~323} then fromFields(negative 0 0)
        elsif {{q + nd} - 1} > 308 then fromFields(negative 2047 0)
        else
            (* The value is n / d *)
            let var n = m
            let var d = nat(1)
            if q >= 0 then n := mulPow10(n q) else d := mulPow10(d {0 - q}) end
            (* 2^k <= n / d < 2^(k + 1) *)
            let t = bitLength(n) - bitLength(d)
            let k = if compare(shiftLeft(n max({0 - t} 0)) shiftLeft(d max(t 0))) >= 0 then t else t - 1 end
            (* The unit of the significand's last bit is 2^e: 53 bits for a
             * normal real, and the subnormals' fixed 2^-1074 below them *)
            let e = max(k ~1022) - 52
            if e >= 0 then d := shiftLeft(d e) else n := shiftLeft(n {0 - e}) end
            (* n / d < 2^(k - e + 1): its integer part, one bit at a time *)
            let bits = {k - e} + 1
            let var significand = 0
            for i = bits - 1 downto 0 do
                significand := significand * 2
                let di = shiftLeft(d i)
                if compare(n di) >= 0 then
                    n := sub(n di)
                    significand := significand + 1
                end
            end
            (* Round by the remainder n / d, ties to even *)
            let half = compare(mulAdd(n 2 0) d)
            if {half > 0} orif {{half is 0} andif {{significand % 2} is 1}} then significand := significand + 1 end
            let var unit = e
            if significand is twoTo53 then
                significand := twoTo52
                unit := unit + 1
            end
            if significand < twoTo52 then fromFields(negative 0 significand)
            elsif {unit + 1075} > 2046 then fromFields(negative 2047 0)
            else fromFields(negative {unit + 1075} {significand - twoTo52})
            end
        end

    let isDigit(c: Char): Bool = {ascii.val(c) >= 48} andif {ascii.val(c) <= 57}

    let toReal(s: String): Real =
        begin
            let size = stringOp.length(s)
            let at(k: Int): Char = if k < size then stringOp.getChar(s k) else ' ' end
            let var i = 0
            let var negative = false
            if {at(0) is '-'} orif {at(0) is '~'} then
                negative := true
                i := 1
            elsif at(0) is '+' then i := 1
            end
            (* The digits, the fraction's included, as one integer m, with nd
             * of them significant (after the leading zeros) and fraction of
             * them after the point; 9 at a time into m *)
            let var m = nat(0)
            let var chunk = 0
            let var size9 = 0
            let var nd = 0
            let var fraction = 0
            let var inFraction = false
            let var more = true
            while more do
                let c = at(i)
                if {c is '.'} andif not(inFraction) then
                    inFraction := true
                    i := i + 1
                elsif isDigit(c) then
                    let v = ascii.val(c) - 48
                    if inFraction then fraction := fraction + 1 end
                    if {nd > 0} orif {v isnot 0} then
                        nd := nd + 1
                        chunk := {chunk * 10} + v
                        size9 := size9 + 1
                        if size9 is 9 then
                            m := mulAdd(m 1000000000 chunk)
                            chunk := 0
                            size9 := 0
                        end
                    end
                    i := i + 1
                else more := false
                end
            end
            m := mulAdd(m pow10(size9) chunk)
            (* The exponent, held below 10^12 so that it cannot overflow: any
             * larger one already decides an infinity or a zero *)
            let var exponent = 0
            if {at(i) is 'e'} orif {at(i) is 'E'} then
                i := i + 1
                let var expNegative = false
                if {at(i) is '-'} orif {at(i) is '~'} then
                    expNegative := true
                    i := i + 1
                elsif at(i) is '+' then i := i + 1
                end
                while isDigit(at(i)) do
                    if exponent < 100000000000 then exponent := {exponent * 10} + {ascii.val(at(i)) - 48} end
                    i := i + 1
                end
                if expNegative then exponent := 0 - exponent end
            end
            fromDecimal(m nd {exponent - fraction} negative)
        end
end
