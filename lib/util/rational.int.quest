(* Exact rational numbers, as Python's fractions.Fraction: a numerator and a
 * denominator of any size (util/bignum), kept in lowest terms with the
 * denominator positive, so that equal numbers have the same parts. Every
 * operation is exact; only toReal rounds.
 *
 *     let third = rational.make(1 3);
 *     rational.toString(rational.add(third rational.make(1 6)))    (* "1/2" *)
 *
 * A real converts exactly (fromReal: every finite real is a fraction with a
 * power of two below), and back, rounded to the nearest real (toReal), so
 * util/stats sums reals exactly through it. Strings are written and read as
 * util/bignum's are, ~ for negatives: "~3/4", "5". *)

interface Rational
import
    word : Word

    util/bignum : util/Bignum
    util/maybe : util/Maybe
export
    (* A rational number in lowest terms *)
    T::TYPE

    (* Raised for a zero denominator, a division by zero, and zero to a
     * negative power *)
    divide: Exception

    (* Raised by fromReal for an infinity or a NaN, and by limitDenominator
     * for a bound below 1 *)
    error: Exception

    zero: T
    one: T

    (* num / den, reduced; raises divide if den is 0 *)
    make(num: Int den: Int): T
    fromBignums(num: bignum.T den: bignum.T): T

    fromInt(n: Int): T
    fromBignum(n: bignum.T): T

    (* The real's exact value; raises error for an infinity or a NaN *)
    fromReal(r: Real): T

    (* The parts in lowest terms; the denominator is positive, and 1 for an
     * integer *)
    numerator(t: T): bignum.T
    denominator(t: T): bignum.T

    add(a: T b: T): T
    sub(a: T b: T): T
    mul(a: T b: T): T
    (* a / b; raises divide if b is zero *)
    div(a: T b: T): T
    neg(t: T): T
    abs(t: T): T
    (* 1 / t; raises divide if t is zero *)
    inv(t: T): T
    (* t to the power n, n of any sign; raises divide for zero to a negative
     * power *)
    pow(t: T n: Int): T

    equal(a: T b: T): Bool
    less(a: T b: T): Bool
    (* Negative, zero, or positive as a is less than, equal to, or greater
     * than b *)
    compare(a: T b: T): Int
    (* ~1, 0, or 1 *)
    sign(t: T): Int
    isInteger(t: T): Bool

    (* The integers below, above, toward zero, and nearest, ties to the even
     * one (as Python's round) *)
    floor(t: T): bignum.T
    ceil(t: T): bignum.T
    trunc(t: T): bignum.T
    round(t: T): bignum.T

    (* The nearest real, ties to the even one, as Python's float(Fraction):
     * exact rounding for results of normal magnitude; an infinity past the
     * largest real *)
    toReal(t: T): Real

    (* The closest rational to t whose denominator is at most maxDenominator,
     * as Python's limit_denominator; raises error if maxDenominator < 1 *)
    limitDenominator(t: T maxDenominator: Int): T

    (* "num/den", or "num" for an integer, ~ for a negative *)
    toString(t: T): String
    (* An integer, "num/den", or a decimal ("1.25", "~0.5"), each with an
     * optional sign (~, -, or +); none for anything else or a zero
     * denominator *)
    fromString(s: String): maybe.T(T)

    (* t in decimal with places digits after the point, the last rounded
     * half to even ("0.333" for 1/3 to 3 places); no point for 0 places *)
    toDecimal(t: T places: Int): String

    (* A hash consistent with equal, for hash maps; it hashes the parts'
     * decimal strings, so it costs their conversion *)
    hash(t: T): word.T
end
