(* Values formatted to a spec, as Python 3.11's format (docs/libraries.md
 * section 1.20). A spec is parsed as CPython's
 * parse_internal_render_format_spec parses it, on every call. Every number
 * becomes a sign, a prefix (0x), a magnitude's text, and a suffix (%); the
 * magnitude's leading digits are grouped and padded and the whole is aligned
 * as CPython's calc_number_widths and InsertThousandsGrouping do, so that zero
 * padding takes the grouping separators too (format(1234, "010,") is
 * 00,001,234). An integer of any kind is formatted from its bignum; a real's
 * digits come from real.format (C's %e and %f, correctly rounded, as Python's
 * are) and from conv.real (the shortest digits, Python's repr). *)

module format : Format
import
    ascii : Ascii
    conv : Conv
    realOp = real : RealOp
    stringOp = string : StringOp
    wordLib = word : Word

    bignumLib = util/bignum : util/Bignum
    util/rational : util/Rational
    sb = util/stringBuilder : util/StringBuilder
export
    let error: Exception = exception error: Ok end

    let at(s: String i: Int): Char = stringOp.getChar(s i)
    let size(s: String): Int = stringOp.length(s)
    let sub(s: String start: Int n: Int): String = stringOp.getSub(s start n)
    let repeated(c: Char n: Int): String = if n <= 0 then "" else stringOp.new(n c) end
    let isDigit(c: Char): Bool = begin let v = ascii.val(c) {v >= 48} /\ {v <= 57} end
    let contains(s: String c: Char): Bool =
        begin
            let var found = false
            for i = 0 upto {size(s) - 1} do if at(s i) is c then found := true end end
            found
        end

    (* =========================================================================
     * Alignment
     * ====================================================================== *)

    (* s with pad copies of fill, aligned left, right, or centered (an odd one
     * on the right) *)
    let padded(s: String fill: Char align: Char pad: Int): String =
        if pad <= 0 then s
        elsif align is '<' then s <> repeated(fill pad)
        elsif align is '>' then repeated(fill pad) <> s
        else
            let left = pad / 2
            repeated(fill left) <> s <> repeated(fill pad - left)
        end

    let alignLeft(s: String width: Int): String = padded(s ' ' '<' width - size(s))
    let alignRight(s: String width: Int): String = padded(s ' ' '>' width - size(s))
    let alignCenter(s: String width: Int): String = padded(s ' ' '^' width - size(s))

    (* =========================================================================
     * Specs
     * ====================================================================== *)

    (* A parsed spec. align is ' ' when not given; zero is the 0 flag, which
     * a value's kind resolves (resolved); signGiven, since a string allows no
     * sign, not even -; grouping is ' ' for none; width and precision are ~1
     * for none, and type is ' ' for none. *)
    Let Spec = Tuple
        fill: Char
        fillGiven: Bool
        align: Char
        sign: Char
        signGiven: Bool
        z: Bool
        alternate: Bool
        zero: Bool
        width: Int
        grouping: Char
        precision: Int
        type: Char
    end

    let isAlign(c: Char): Bool = {c is '<'} \/ {c is '>'} \/ {c is '='} \/ {c is '^'}

    let parseSpec(s: String): Spec =
        begin
            let n = size(s)
            let var pos = 0
            let var fill = ' '
            let var fillGiven = false
            let var align = ' '
            if {n >= 2} andif isAlign(at(s 1)) then
                fill := at(s 0)
                fillGiven := true
                align := at(s 1)
                pos := 2
            elsif {n >= 1} andif isAlign(at(s 0)) then
                align := at(s 0)
                pos := 1
            end
            let var sign = '-'
            let var signGiven = false
            if {pos < n} andif {{at(s pos) is '+'} \/ {at(s pos) is '-'} \/ {at(s pos) is ' '}} then
                sign := at(s pos)
                signGiven := true
                pos := pos + 1
            end
            let var z = false
            if {pos < n} andif {at(s pos) is 'z'} then
                z := true
                pos := pos + 1
            end
            let var alternate = false
            if {pos < n} andif {at(s pos) is '#'} then
                alternate := true
                pos := pos + 1
            end
            let var zero = false
            if not(fillGiven) andif {pos < n} andif {at(s pos) is '0'} then
                zero := true
                pos := pos + 1
            end
            let var width = ~1
            while {pos < n} andif isDigit(at(s pos)) do
                width := {if width < 0 then 0 else width * 10 end} + {ascii.val(at(s pos)) - 48}
                pos := pos + 1
            end
            let var grouping = ' '
            if {pos < n} andif {{at(s pos) is ','} \/ {at(s pos) is '_'}} then
                grouping := at(s pos)
                pos := pos + 1
                if {pos < n} andif {{at(s pos) is ','} \/ {at(s pos) is '_'}} then raise error end end
            end
            let var precision = ~1
            if {pos < n} andif {at(s pos) is '.'} then
                pos := pos + 1
                while {pos < n} andif isDigit(at(s pos)) do
                    precision := {if precision < 0 then 0 else precision * 10 end} + {ascii.val(at(s pos)) - 48}
                    pos := pos + 1
                end
                if precision < 0 then raise error end end
                if precision > 100 then raise error end end
            end
            let var type = ' '
            if pos < n then
                if {n - pos} > 1 then raise error end end
                type := at(s pos)
                if type is ' ' then raise error end end
            end
            if grouping isnot ' ' then
                if contains("defgEFG% " type) then ok
                elsif contains("boxX" type) andif {grouping is '_'} then ok
                else raise error end
                end
            end
            tuple
                let fill = fill
                let fillGiven = fillGiven
                let align = align
                let sign = sign
                let signGiven = signGiven
                let z = z
                let alternate = alternate
                let zero = zero
                let width = width
                let grouping = grouping
                let precision = precision
                let type = type
            end
        end

    (* The spec with its 0 flag and missing align resolved for a value whose
     * default alignment is defaultAlign: the 0 flag fills with 0, and aligns
     * with = where the default would be > *)
    let resolved(p: Spec defaultAlign: Char): Spec =
        begin
            let var fill = p.fill
            let var align = p.align
            if p.zero then
                fill := '0'
                if {align is ' '} /\ {defaultAlign is '>'} then align := '=' end
            end
            if align is ' ' then align := defaultAlign end
            tuple
                let fill = fill
                let fillGiven = p.fillGiven
                let align = align
                let sign = p.sign
                let signGiven = p.signGiven
                let z = p.z
                let alternate = p.alternate
                let zero = p.zero
                let width = p.width
                let grouping = p.grouping
                let precision = p.precision
                let type = p.type
            end
        end

    (* =========================================================================
     * Numbers
     * ====================================================================== *)

    (* digits grouped by size (0 for none) with separator, padded with zeros to
     * at least minWidth, as CPython's InsertThousandsGrouping: groups are
     * taken from the right, zero filled once the digits run out, until both
     * the digits and the width are used up *)
    let maximum(a: Int b: Int): Int = if a > b then a else b end
    let minimum(a: Int b: Int): Int = if a < b then a else b end

    let grouped(digits: String groupSize: Int separator: String minWidth: Int): String =
        if stringOp.isEmpty(digits) then
            ""
        else
            let var count = 0
            let var remaining = stringOp.length(digits)
            let var minW = minWidth
            let var going = true
            let var text = ""
            while going do
                (* This group's length: a whole group, or for no grouping
                 * every digit left and the zeros the width wants *)
                let whole = maximum(maximum(remaining minW) 1)
                let l = if groupSize > 0 then minimum(groupSize whole) else whole end
                let chars = maximum(0 minimum(remaining l))
                let piece = repeated('0' maximum(0 l - remaining)) <> sub(digits remaining - chars chars)
                text := piece <> {if count > 0 then separator else "" end} <> text
                count := count + 1
                remaining := remaining - chars
                if groupSize > 0 then
                    minW := minW - groupSize
                    if {remaining <= 0} /\ {minW <= 0} then
                        going := false
                    else
                        minW := minW - stringOp.length(separator)
                    end
                else
                    going := false
                end
            end
            text
        end

    (* A number's text: its sign, prefix, and magnitude's text (whose leading
     * digits are grouped, groupSize of them a group; all of it for an
     * integer, whose digits may be hexadecimal), then suffix, padded to the
     * spec's width as it aligns, which it has resolved *)
    let number(p: Spec negative: Bool prefix: String body: String allDigits: Bool groupSize: Int
            suffix: String): String =
        begin
            let sign = if negative then "-" elsif p.sign is '+' then "+" elsif p.sign is ' ' then " " else "" end
            let var k = if allDigits then size(body) else 0 end
            while {k < size(body)} andif isDigit(at(body k)) do k := k + 1 end
            let digits = sub(body 0 k)
            let rest = sub(body k size(body) - k) <> suffix
            let separator = if p.grouping is ' ' then "" else stringOp.new(1 p.grouping) end
            let minWidth =
                if {p.fill is '0'} /\ {p.align is '='} then
                    p.width - {size(sign) + size(prefix) + size(rest)}
                else
                    0
                end
            let g = grouped(digits if p.grouping is ' ' then 0 else groupSize end separator minWidth)
            let pad = p.width - {size(sign) + size(prefix) + size(g) + size(rest)}
            if p.align is '=' then
                sign <> prefix <> repeated(p.fill pad) <> g <> rest
            else
                padded(sign <> prefix <> g <> rest p.fill p.align pad)
            end
        end

    (* n's magnitude in base, 2 to 16, lower or upper case *)
    let magnitude(n: bignumLib.T base: Int upper: Bool): String =
        if base is 10 then
            bignumLib.toString(bignumLib.abs(n))
        else
            let digitChars = if upper then "0123456789ABCDEF" else "0123456789abcdef" end
            let b = bignumLib.fromInt(base)
            let var v = bignumLib.abs(n)
            let var text = ""
            if bignumLib.sign(v) is 0 then text := "0" end
            while bignumLib.sign(v) > 0 do
                text := stringOp.new(1 at(digitChars bignumLib.toInt(bignumLib.rem(v b)))) <> text
                v := bignumLib.quot(v b)
            end
            text
        end

    (* ---- Reals *)

    let bits(r: Real): wordLib.T = wordLib.fromReal(r)
    let isNan(r: Real): Bool =
        {wordLib.toInt(wordLib.extract(bits(r) 52 11)) is 2047}
            /\ {wordLib.toInt(wordLib.extract(bits(r) 0 52)) isnot 0}
    let isInfinite(r: Real): Bool =
        {wordLib.toInt(wordLib.extract(bits(r) 52 11)) is 2047}
            /\ {wordLib.toInt(wordLib.extract(bits(r) 0 52)) is 0}
    let signBit(r: Real): Bool = wordLib.getBit(bits(r) 63)

    (* e's exponent text: a sign and at least two digits *)
    let exponentText(e: Char x: Int): String =
        begin
            let a = if x < 0 then 0 - x else x end
            stringOp.new(1 e) <> {if x < 0 then "-" else "+" end} <> {if a < 10 then "0" else "" end} <> conv.int(a)
        end

    (* a (finite, not negative) as g writes it with p significant digits, as
     * CPython's format_float_short: in exponent form when the decimal point
     * would be at -4 or before, or past p (past p - 1 for the empty type,
     * addDot0); trailing zeros dropped unless alternate; and for addDot0, ".0"
     * after an integer written in full *)
    let general(a: Real p: Int e: Char alternate: Bool addDot0: Bool): String =
        begin
            (* The digits rounded to p significant ones, and the exponent *)
            let var digits = "0"
            let var x = 0
            if a isnot 0.0 then
                let t = realOp.format(a 'e' p - 1)
                let ePos = begin let var i = 0 while at(t i) isnot 'e' do i := i + 1 end i end
                let mantissa = sub(t 0 ePos)
                digits :=
                    if size(mantissa) > 1 then sub(mantissa 0 1) <> sub(mantissa 2 size(mantissa) - 2) else mantissa end
                let exponent = sub(t ePos + 1 size(t) - {ePos + 1})
                let var v = 0
                for i = 1 upto {size(exponent) - 1} do v := {v * 10} + {ascii.val(at(exponent i)) - 48} end
                x := if at(exponent 0) is '-' then 0 - v else v end
            end
            if alternate then
                digits := digits <> repeated('0' p - size(digits))
            else
                let var k = size(digits)
                while {k > 1} andif {at(digits k - 1) is '0'} do k := k - 1 end
                digits := sub(digits 0 k)
            end
            let n = size(digits)
            let decpt = x + 1
            let limit = if addDot0 then p - 1 else p end
            if {decpt <= ~4} \/ {decpt > limit} then
                let mantissa =
                    if {n > 1} \/ alternate then sub(digits 0 1) <> "." <> sub(digits 1 n - 1) else digits end
                mantissa <> exponentText(e x)
            elsif decpt <= 0 then
                "0." <> repeated('0' 0 - decpt) <> digits
            elsif decpt >= n then
                digits <> repeated('0' decpt - n) <> {if alternate then "." elsif addDot0 then ".0" else "" end}
            else
                sub(digits 0 decpt) <> "." <> sub(digits decpt n - decpt)
            end
        end

    (* s with e made E (an exponent's letter) *)
    let upperExponent(s: String): String =
        begin
            let t = stringOp.getSub(s 0 size(s))
            for i = 0 upto {size(t) - 1} do if at(t i) is 'e' then stringOp.setChar(t i 'E') end end
            t
        end

    (* r formatted to the spec, unresolved, its type one of a real's *)
    let realSpec(r: Real q: Spec): String =
        begin
            let p = resolved(q '>')
            let t = p.type
            if not(contains(" eEfFgG%" t)) then raise error end end
            let upper = {t is 'E'} \/ {t is 'F'} \/ {t is 'G'}
            (* |r|, its sign bit clear (real.abs keeps negative zero's) *)
            let a = if signBit(r) then 0.0 -- r else r end
            let precision = if p.precision < 0 then 6 else p.precision end
            let withPoint(s: String): String =
                if p.alternate /\ {precision is 0} then
                    if contains(s 'e') then
                        let var i = 0
                        while at(s i) isnot 'e' do i := i + 1 end
                        sub(s 0 i) <> "." <> sub(s i size(s) - i)
                    else
                        s <> "."
                    end
                else
                    s
                end
            let body =
                if isNan(r) then if upper then "NAN" else "nan" end
                elsif isInfinite(r) then if upper then "INF" else "inf" end
                elsif t is ' ' then
                    if p.precision < 0 then conv.real(a)
                    else general(a {if p.precision is 0 then 1 else p.precision end} 'e' p.alternate true)
                    end
                elsif {t is 'g'} \/ {t is 'G'} then
                    general(a {if precision is 0 then 1 else precision end} {if upper then 'E' else 'e' end} p.alternate
                            false)
                elsif {t is 'e'} \/ {t is 'E'} then
                    let s = withPoint(realOp.format(a 'e' precision))
                    if upper then upperExponent(s) else s end
                elsif t is '%' then withPoint(realOp.format(a ** 100.0 'f' precision))
                else withPoint(realOp.format(a 'f' precision))
                end
            let var negative = signBit(r) /\ not(isNan(r))
            if negative /\ p.z /\ not(isInfinite(r)) then
                let var nonzero = false
                for i = 0 upto {size(body) - 1} do
                    let c = at(body i)
                    if isDigit(c) /\ {c isnot '0'} then nonzero := true end
                end
                if not(nonzero) then negative := false end
            end
            number(p negative "" body false 3 {if t is '%' then "%" else "" end})
        end

    (* n formatted to the spec: an integer's type, or a real's, which formats
     * the real nearest n *)
    let integer(n: bignumLib.T spec: String): String =
        begin
            let q = parseSpec(spec)
            if contains("eEfFgG%" q.type) then
                let r = rational.toReal(rational.fromBignum(n))
                if isInfinite(r) then raise error end end
                realSpec(r q)
            else
                let p = resolved(q '>')
                if not(contains(" dboxX" p.type)) then raise error end end
                if {p.precision >= 0} \/ p.z then raise error end end
                let base =
                    if p.type is 'b' then
                        2
                    elsif p.type is 'o' then
                        8
                    elsif {p.type is 'x'} \/ {p.type is 'X'} then
                        16
                    else
                        10
                    end
                let prefix =
                    if not(p.alternate) then ""
                    elsif p.type is 'b' then "0b"
                    elsif p.type is 'o' then "0o"
                    elsif p.type is 'x' then "0x"
                    elsif p.type is 'X' then "0X"
                    else ""
                    end
                let groupSize = if base is 10 then 3 else 4 end
                number(p {bignumLib.sign(n) < 0} prefix magnitude(n base {p.type is 'X'}) true groupSize "")
            end
        end

    let int(n: Int spec: String): String = integer(bignumLib.fromInt(n) spec)
    let word(w: wordLib.T spec: String): String = integer(bignumLib.fromWord(w) spec)
    let bignum(n: bignumLib.T spec: String): String = integer(n spec)
    let real(r: Real spec: String): String = realSpec(r parseSpec(spec))

    let string(s: String spec: String): String =
        begin
            let p = resolved(parseSpec(spec) '<')
            if not(contains(" s" p.type)) then raise error end end
            if p.signGiven \/ p.z \/ p.alternate \/ {p.align is '='} \/ {p.grouping isnot ' '} then raise error end end
            let kept = if {p.precision >= 0} andif {p.precision < size(s)} then sub(s 0 p.precision) else s end
            padded(kept p.fill p.align p.width - size(kept))
        end

    let bool(b: Bool spec: String): String = string(conv.bool(b) spec)

    (* =========================================================================
     * Templates
     * ====================================================================== *)

    Let Arg = Option
        aInt with n: Int end
        aWord with w: wordLib.T end
        aBignum with n: bignumLib.T end
        aReal with r: Real end
        aString with s: String end
        aBool with b: Bool end
    end
    let ofInt(n: Int): Arg = option aInt of Arg with let n = n end
    let ofWord(w: wordLib.T): Arg = option aWord of Arg with let w = w end
    let ofBignum(n: bignumLib.T): Arg = option aBignum of Arg with let n = n end
    let ofReal(r: Real): Arg = option aReal of Arg with let r = r end
    let ofString(s: String): Arg = option aString of Arg with let s = s end
    let ofBool(b: Bool): Arg = option aBool of Arg with let b = b end

    let formatArg(a: Arg spec: String): String =
        case a
            when aInt with x then int(x.n spec)
            when aWord with x then word(x.w spec)
            when aBignum with x then bignum(x.n spec)
            when aReal with x then real(x.r spec)
            when aString with x then string(x.s spec)
            when aBool with x then bool(x.b spec)
        end

    let template(t: String args: Array(Arg)): String =
        begin
            let b = sb.new()
            let n = size(t)
            let var i = 0
            (* 0 until a field is seen, 1 for automatic indexes, 2 explicit *)
            let var mode = 0
            let var next = 0
            while i < n do
                let c = at(t i)
                if c is '{' then
                    if {{i + 1} < n} andif {at(t i + 1) is '{'} then
                        sb.char(b '{')
                        i := i + 2
                    else
                        let var j = i + 1
                        while {j < n} andif {at(t j) isnot '}'} do
                            if at(t j) is '{' then raise error end end
                            j := j + 1
                        end
                        if j >= n then raise error end end
                        let field = sub(t i + 1 j - {i + 1})
                        let var colon = 0
                        while {colon < size(field)} andif {at(field colon) isnot ':'} do colon := colon + 1 end
                        let name = sub(field 0 colon)
                        let spec =
                            if colon < size(field) then sub(field colon + 1 size(field) - {colon + 1}) else "" end
                        let var index = 0
                        if stringOp.isEmpty(name) then
                            if mode is 2 then raise error end end
                            mode := 1
                            index := next
                            next := next + 1
                        else
                            if mode is 1 then raise error end end
                            mode := 2
                            for k = 0 upto {size(name) - 1} do
                                if not(isDigit(at(name k))) then raise error end end
                                index := {index * 10} + {ascii.val(at(name k)) - 48}
                            end
                        end
                        if index >= extent(args) then raise error end end
                        sb.str(b formatArg(args[index] spec))
                        i := j + 1
                    end
                elsif c is '}' then
                    if {{i + 1} < n} andif {at(t i + 1) is '}'} then
                        sb.char(b '}')
                        i := i + 2
                    else
                        raise error end
                    end
                else
                    sb.char(b c)
                    i := i + 1
                end
            end
            sb.toString(b)
        end

    (* =========================================================================
     * Tables
     * ====================================================================== *)

    Let Layout = Tuple aligns: String separator: String header: Bool end
    let layout(aligns: String): Layout = tuple let aligns = aligns let separator = "  " let header = false end

    let table(rows: Array(Array(String)) layout: Layout): String =
        begin
            let var columns = 0
            for i = 0 upto {extent(rows) - 1} do if extent(rows[i]) > columns then columns := extent(rows[i]) end end
            let widths = array of(columns 0)
            for i = 0 upto {extent(rows) - 1} do
                for j = 0 upto {extent(rows[i]) - 1} do
                    if size(rows[i][j]) > widths[j] then widths[j] := size(rows[i][j]) end
                end
            end
            let aligns = array of(columns '<')
            for j = 0 upto {size(layout.aligns) - 1} do
                let c = at(layout.aligns j)
                if not({c is '<'} \/ {c is '>'} \/ {c is '^'}) then raise error end end
                if j < columns then aligns[j] := c end
            end
            let b = sb.new()
            let line(cells: Array(String)): Ok =
                begin
                    let l = sb.new()
                    for j = 0 upto {columns - 1} do
                        if j > 0 then sb.str(l layout.separator) end
                        let cell = if j < extent(cells) then cells[j] else "" end
                        sb.str(l padded(cell ' ' aligns[j] widths[j] - size(cell)))
                    end
                    let s = sb.toString(l)
                    let var k = size(s)
                    while {k > 0} andif {at(s k - 1) is ' '} do k := k - 1 end
                    sb.sub(b s 0 k)
                    sb.char(b '\n')
                end
            for i = 0 upto {extent(rows) - 1} do
                line(rows[i])
                if layout.header /\ {i is 0} then
                    let rule = array of(columns "")
                    for j = 0 upto {columns - 1} do rule[j] := repeated('-' widths[j]) end
                    line(rule)
                end
            end
            sb.toString(b)
        end
end
