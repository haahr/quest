(* Standard Library: regular expressions (docs/regexp.md); patterns as
 * values, on util/regexpSyntax's trees *)

module regexp : Regexp
import
    ascii : Ascii
    stringOp = string : StringOp

    collections/bitset : collections/Bitset
    collections/vector : collections/Vector
    util/iter : util/Iter
    util/maybe : util/Maybe
    vm = util/regexpMatch : util/RegexpMatch
    prog = util/regexpProgram : util/RegexpProgram
    syn = util/regexpSyntax : util/RegexpSyntax
    sb = util/stringBuilder : util/StringBuilder
export
    Let SyntaxError = Tuple message: String offset: Int end
    let syntax: Exception(SyntaxError) = syn.syntax
    let error: Exception = exception error: Ok end

    Let RE = syn.Node

    let parse(pattern: String): RE = syn.parse(pattern)

    let setNode(s: bitset.T): RE = option byteSet of syn.Node with let set = s end

    let literal(s: String): RE =
        if stringOp.isEmpty(s) then option empty of syn.Node end
        else option bytes of syn.Node with let s = s end
        end

    let set(s: String): RE =
        begin
            let bs = syn.newSet()
            for i = 0 upto {stringOp.length(s) - 1} do
                let added = bitset.insert(bs ascii.val(stringOp.getChar(s i)))
            end
            setNode(bs)
        end

    let range(lo: Char hi: Char): RE =
        begin
            if ascii.val(hi) < ascii.val(lo) then raise error end end
            let bs = syn.newSet()
            for b = ascii.val(lo) upto ascii.val(hi) do let added = bitset.insert(bs b) end
            setNode(bs)
        end

    (* The bytes n matches, if it matches exactly one byte; n is simplified,
     * so a caseless node has been folded *)
    let rec oneByte(n: syn.Node into: bitset.T): Bool =
        case n
            when bytes with x then
                {stringOp.length(x.s) is 1} andif begin
                    let added = bitset.insert(into ascii.val(stringOp.getChar(x.s 0)))
                    true
                end
            when byteSet with x then begin let changed = bitset.unionWith(into x.set) true end
            when alternate with x then
                begin
                    let var all = true
                    for i = 0 upto {extent x.choices - 1} do
                        if not(oneByte(x.choices[i] into)) then all := false end
                    end
                    all
                end
            else false
        end

    let complement(re: RE): RE =
        begin
            let bs = syn.newSet()
            if not(oneByte(syn.simplify(re) bs)) then raise error end end
            let c = syn.newSet()
            for b = 0 upto 255 do if not(bitset.contains(bs b)) then let added = bitset.insert(c b) end end
            setNode(c)
        end

    (* The classes and assertions, as the syntax writes them *)
    let anyByte = syn.parse("(?s:.)")
    let notNewline = syn.parse(".")
    let digit = syn.parse("\\d")
    let wordByte = syn.parse("\\w")
    let space = syn.parse("\\s")
    let lineStart = syn.parse("(?m:^)")
    let lineEnd = syn.parse("(?m:$)")
    let textStart = syn.parse("\\A")
    let textEnd = syn.parse("\\z")
    let wordBoundary = syn.parse("\\b")
    let notWordBoundary = syn.parse("\\B")

    (* A copy of res, so that changing the array later changes no pattern *)
    let copied(res: Array(RE)): Array(RE) =
        begin
            let c = array of(extent res option empty of syn.Node end)
            for i = 0 upto {extent res - 1} do c[i] := res[i] end
            c
        end

    let seq(res: Array(RE)): RE = option concat of syn.Node with let parts = copied(res) end

    (* No alternative matches nothing: the empty set *)
    let alt(res: Array(RE)): RE =
        if extent res is 0 then setNode(syn.newSet())
        else option alternate of syn.Node with let choices = copied(res) end
        end

    let repeat(re: RE min: Int max: Int greedy: Bool): RE =
        begin
            if {min < 0} \/ {min > syn.maxRepeat} \/ {max < ~1} \/ {max > syn.maxRepeat}
                    \/ {{max >= 0} /\ {max < min}} then
                raise error end
            end
            option repeat of syn.Node with let body = re let min = min let max = max let greedy = greedy end
        end

    let star(re: RE): RE = repeat(re 0 ~1 true)
    let plus(re: RE): RE = repeat(re 1 ~1 true)
    let opt(re: RE): RE = repeat(re 0 1 true)

    let capture(re: RE): RE = option capture of syn.Node with let body = re let name = "" end

    let namedCapture(name: String re: RE): RE =
        begin
            let n = stringOp.length(name)
            if n is 0 then raise error end end
            for i = 0 upto {n - 1} do
                let b = ascii.val(stringOp.getChar(name i))
                let isDigit = {b >= 48} /\ {b <= 57}
                let isLetter = {{b >= 65} /\ {b <= 90}} \/ {{b >= 97} /\ {b <= 122}}
                if not(isDigit \/ isLetter \/ {b is 95}) \/ {isDigit /\ {i is 0}} then raise error end end
            end
            option capture of syn.Node with let body = re let name = name end
        end

    let caseless(re: RE): RE = option caseless of syn.Node with let body = re end

    let show(re: RE): String = syn.show(syn.simplify(re))

    (* ======================================================================
     * Compiling and matching
     * ====================================================================== *)

    Let T = Tuple pattern: String program: prog.Program end

    let compiled(pattern: String re: RE): T =
        begin
            let program = prog.compile(re)
            (* a name twice, which only patterns built as values can have *)
            for i = 1 upto program.groups do
                for j = 1 upto {i - 1} do
                    if not(stringOp.isEmpty(program.names[i]))
                            andif stringOp.equal(program.names[i] program.names[j]) then
                        raise error end
                    end
                end
            end
            tuple let pattern = pattern let program = program end
        end

    let compile(pattern: String): T = compiled(pattern syn.parse(pattern))
    let compileRE(re: RE): T = compiled(show(re) re)
    let pattern(r: T): String = r.pattern
    let groupCount(r: T): Int = r.program.groups

    let groupIndex(r: T name: String): Int =
        begin
            let var found = ~1
            for i = 1 upto r.program.groups do
                if {found < 0} andif stringOp.equal(r.program.names[i] name) then found := i end
            end
            found
        end

    let matches(r: T s: String): Bool = maybe.isSome(:Array(Int) vm.search(r.program s 0 true true false))
    let contains(r: T s: String): Bool = maybe.isSome(:Array(Int) vm.search(r.program s 0 false false false))

    Let Match = Tuple subject: String slots: Array(Int) re: T end

    let made(r: T s: String found: maybe.T(Array(Int))): maybe.T(Match) =
        if maybe.isNone(:Array(Int) found) then maybe.none(:Match)
        else maybe.some(:Match tuple let subject = s let slots = maybe.unwrap(:Array(Int) found) let re = r end)
        end

    let checkStart(s: String start: Int): Ok = if {start < 0} \/ {start > stringOp.length(s)} then raise error end end

    let findFrom(r: T s: String start: Int): maybe.T(Match) =
        begin
            checkStart(s start)
            made(r s vm.search(r.program s start false false true))
        end

    let find(r: T s: String): maybe.T(Match) = findFrom(r s 0)

    let matchAt(r: T s: String start: Int): maybe.T(Match) =
        begin
            checkStart(s start)
            made(r s vm.search(r.program s start true false true))
        end

    let subject(m: Match): String = m.subject

    let checkGroup(m: Match i: Int): Ok = if {i < 0} \/ {i > m.re.program.groups} then raise error end end

    let matched(m: Match i: Int): Bool = begin checkGroup(m i) m.slots[2 * i] >= 0 end
    let start(m: Match i: Int): Int = begin checkGroup(m i) m.slots[2 * i] end

    let size(m: Match i: Int): Int =
        begin
            checkGroup(m i)
            if m.slots[2 * i] < 0 then ~1 else m.slots[{2 * i} + 1] - m.slots[2 * i] end
        end

    let group(m: Match i: Int): String =
        begin
            checkGroup(m i)
            if m.slots[2 * i] < 0 then "" else stringOp.getSub(m.subject m.slots[2 * i] size(m i)) end
        end

    let named(m: Match name: String): String =
        begin
            let i = groupIndex(m.re name)
            if i < 0 then raise error end end
            group(m i)
        end

    (* ======================================================================
     * Every match, replacing, and splitting, as Go's regexp does them
     * ====================================================================== *)

    (* The matches are found as they are pulled: more searches from pos for
     * the next one that is taken (not an empty match where the previous one
     * ended) and holds it, in current, until next hands it out. A Match is
     * not generic, so the slot needs no option: an empty one starts it *)
    let findIter(r: T s: String): iter.T(Match) =
        begin
            let n = stringOp.length(s)
            let c = tuple
                let var pos = 0
                let var previousEnd = ~1
                let var current = tuple let subject = s let slots = array of :Int end let re = r end
                let var full = false
            end
            let ready(): Bool =
                begin
                    while not(c.full) andif {c.pos <= n} do
                        let found = vm.search(r.program s c.pos false false true)
                        if maybe.isNone(:Array(Int) found) then
                            c.pos := n + 1
                        else
                            let slots = maybe.unwrap(:Array(Int) found)
                            let var accept = true
                            if slots[1] is c.pos then
                                (* an empty match: not one where the last match ended *)
                                if slots[0] is c.previousEnd then accept := false end
                                c.pos := c.pos + 1
                            else
                                c.pos := slots[1]
                            end
                            c.previousEnd := slots[1]
                            if accept then
                                c.current := tuple let subject = s let slots = slots let re = r end
                                c.full := true
                            end
                        end
                    end
                    c.full
                end
            iter.make(ready fun(): Match
                if ready() then
                    c.full := false
                    c.current
                else
                    raise iter.exhausted end
                end)
        end

    let findStringIter(r: T s: String): iter.T(String) = iter.map(findIter(r s) fun(m: Match): String group(m 0))

    let findAll(r: T s: String): vector.T(Match) = vector.fromIter(findIter(r s))

    let isNameByte(b: Int): Bool =
        {{b >= 48} /\ {b <= 57}} \/ {{b >= 65} /\ {b <= 90}} \/ {{b >= 97} /\ {b <= 122}} \/ {b is 95}

    (* Appends template to buf, expanded for m (replaceAll's rules) *)
    let expand(buf: sb.T template: String m: Match): Ok =
        begin
            let t = template
            let n = stringOp.length(t)
            let byteAt(i: Int): Int = ascii.val(stringOp.getChar(t i))
            let var i = 0
            while i < n do
                let c = byteAt(i)
                if {c isnot 36} \/ {{i + 1} >= n} then
                    sb.char(buf stringOp.getChar(t i))
                    i := i + 1
                elsif byteAt(i + 1) is 36 then
                    sb.char(buf '$')
                    i := i + 2
                else
                    (* $name or ${name}; anything else is a $ by itself *)
                    let brace = byteAt(i + 1) is 123
                    let from = if brace then i + 2 else i + 1 end
                    let var k = from
                    while {k < n} andif isNameByte(byteAt(k)) do k := k + 1 end
                    let closed = not(brace) orif {{k < n} andif {byteAt(k) is 125}}
                    if {k is from} \/ not(closed) then
                        sb.char(buf '$')
                        i := i + 1
                    else
                        let name = stringOp.getSub(t from k - from)
                        (* a number, without leading zeros, below 10^8, or else a
                         * name *)
                        let var number = 0
                        for j = 0 upto {stringOp.length(name) - 1} do
                            let d = ascii.val(stringOp.getChar(name j))
                            if {number < 0} \/ {d < 48} \/ {d > 57} \/ {number >= 100000000} then number := ~1
                            else number := {number * 10} + {d - 48}
                            end
                        end
                        if {stringOp.length(name) > 1} andif {ascii.val(stringOp.getChar(name 0)) is 48} then
                            number := ~1
                        end
                        let index = if number >= 0 then number else groupIndex(m.re name) end
                        if {index >= 0} andif {index <= m.re.program.groups} andif {m.slots[2 * index] >= 0} then
                            sb.str(buf group(m index))
                        end
                        i := if brace then k + 1 else k end
                    end
                end
            end
        end

    (* s with its matches replaced by what replacement appends, every match
     * or the first only (Go's regexp.replaceAll) *)
    let replaced(r: T s: String every: Bool replacement: All(buf: sb.T m: Match) Ok): String =
        begin
            let buf = sb.new()
            let n = stringOp.length(s)
            let var lastEnd = 0
            let var pos = 0
            let var done = false
            while {pos <= n} /\ not(done) do
                let found = vm.search(r.program s pos false false true)
                if maybe.isNone(:Array(Int) found) then
                    done := true
                else
                    let slots = maybe.unwrap(:Array(Int) found)
                    sb.str(buf stringOp.getSub(s lastEnd slots[0] - lastEnd))
                    (* an empty match where the last one ended is not one,
                     * unless it is at the start *)
                    if {slots[1] > lastEnd} \/ {slots[0] is 0} then
                        replacement(buf tuple let subject = s let slots = slots let re = r end)
                        if not(every) then done := true end
                    end
                    lastEnd := slots[1]
                    let width = if pos < n then 1 else 0 end
                    if {pos + width} > slots[1] then pos := pos + width
                    elsif {pos + 1} > slots[1] then pos := pos + 1
                    else pos := slots[1]
                    end
                end
            end
            sb.str(buf stringOp.getSub(s lastEnd n - lastEnd))
            sb.toString(buf)
        end

    let replaceFirst(r: T s: String template: String): String =
        replaced(r s false fun(buf: sb.T m: Match): Ok expand(buf template m))
    let replaceAll(r: T s: String template: String): String =
        replaced(r s true fun(buf: sb.T m: Match): Ok expand(buf template m))
    let replaceWith(r: T s: String f: All(m: Match) String): String =
        replaced(r s true fun(buf: sb.T m: Match): Ok sb.str(buf f(m)))

    let split(r: T s: String): vector.T(String) =
        begin
            let pieces = vector.new(:String)
            let n = stringOp.length(s)
            if {n is 0} andif not(stringOp.isEmpty(r.pattern)) then
                vector.append(:String pieces "")
            else
                let all = findAll(r s)
                let var pieceStart = 0
                let var matchStart = 0
                for i = 0 upto {vector.length(:Match all) - 1} do
                    let m = vector.get(:Match all i)
                    matchStart := m.slots[0]
                    if m.slots[1] isnot 0 then
                        vector.append(:String pieces stringOp.getSub(s pieceStart matchStart - pieceStart))
                    end
                    pieceStart := m.slots[1]
                end
                if matchStart isnot n then
                    vector.append(:String pieces stringOp.getSub(s pieceStart n - pieceStart))
                end
            end
            pieces
        end

    let quote(s: String): String =
        begin
            let buf = sb.new()
            let special = "\\.+*?()|[]{}^$"
            for i = 0 upto {stringOp.length(s) - 1} do
                let c = stringOp.getChar(s i)
                let var isSpecial = false
                for j = 0 upto {stringOp.length(special) - 1} do
                    if stringOp.getChar(special j) is c then isSpecial := true end
                end
                if isSpecial then sb.char(buf '\\') end
                sb.char(buf c)
            end
            sb.toString(buf)
        end
end
