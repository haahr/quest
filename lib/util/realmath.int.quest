(* Real's mathematical functions in Quest: what the C runtime asks of libm,
 * FreeBSD's msun ported. realmath.mod.quest's header says how and why. Each
 * function is the one of real's RealOp of the same name, which raises
 * real.error where its result would be NaN. *)

interface RealMath export
    (* Trigonometric functions of an angle in radians; real.error for an
     * infinity *)
    sin(x: Real): Real
    cos(x: Real): Real
    tan(x: Real): Real

    (* Inverse trigonometric functions, in radians: asin and acos raise
     * real.error outside [~1, 1], and atan2(y x) is the angle of the point
     * (x, y) *)
    asin(x: Real): Real
    acos(x: Real): Real
    atan(x: Real): Real
    atan2(y: Real x: Real): Real

    (* e raised to x *)
    exponential(x: Real): Real

    (* The natural logarithm; real.error for x <= 0 *)
    log(x: Real): Real

    (* Hyperbolic functions *)
    sinh(x: Real): Real
    cosh(x: Real): Real
    tanh(x: Real): Real

    (* x raised to y, as real.exp and ^^: real.error for a zero x and a
     * negative y, and for a negative x and a y not an integer *)
    pow(x: Real y: Real): Real
end
