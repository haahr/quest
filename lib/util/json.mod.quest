(* Standard Library: JSON (RFC 8259) Implementation
 *
 * The parser is a recursive descent over the text, and the printer a walk of
 * the tree into a string builder, both as questlang/common/json had them
 * before this library replaced it. Python's json module is the reference for
 * the text: tests/python/test_json.py checks the two agree. *)

module json : JSON
import
    ascii : Ascii
    conv : Conv
    reader : Reader
    stringOp = string : StringOp
    wordLib = word : Word
    writer : Writer

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    sb = util/stringBuilder : util/StringBuilder
    util/strutil : util/Strutil
export
    (* ======================================================================
     * 1. Values
     * ====================================================================== *)

    (* An object's members are two arrays in insertion order, names and
     * values, the first count of them in use. Past smallSize members, index
     * finds a name's position; below it, a scan does, which for the small
     * objects most documents are made of (a .qi file's type nodes have one
     * or two) is quicker than hashing and needs no table *)
    Let Rec Value = Option
        jNull
        jBool with b: Bool end
        jNumber with text: String isInteger: Bool end
        jString with s: String end
        jArray with items: vector.T(Value) end
        jObject with o: Object end
    end
    and Object = Tuple
        var names: Array(String)
        var values: Array(Value)
        var count: Int
        var index: hashMap.T(String Int)
    end

    let smallSize: Int = 8

    (* Where every object starts, never written: an object's arrays are
     * replaced by its first put, and its index by the reindex that its
     * growing past smallSize makes. A parsed .qi or .qm file is mostly
     * objects of one or two members, which would otherwise each carry two
     * empty arrays and an empty table *)
    let noNames = array of :String end
    let noValues = array of :Value end
    let noIndex = hashMap.new(:String :Int stringOp.equal hash.string)

    Let Failure = Tuple message: String offset: Int end
    let error: Exception(Failure) = exception error: Failure end

    let failAt(A::TYPE)(message: String offset: Int): A =
        raise error with tuple let message = message let offset = offset end end
    let failWith(A::TYPE)(message: String): A = failAt(:A message ~1)

    let null: Value = option jNull of Value end
    let bool(b: Bool): Value = option jBool of Value with let b = b end
    let numberOf(text: String isInteger: Bool): Value =
        option jNumber of Value with let text = text let isInteger = isInteger end
    let string(s: String): Value = option jString of Value with let s = s end
    let arrayValue(items: vector.T(Value)): Value = option jArray of Value with let items = items end
    let object(o: Object): Value = option jObject of Value with let o = o end

    (* conv's ~ for a minus sign, as - *)
    let minus(s: String): String =
        if {stringOp.length(s) > 0} andif {stringOp.getChar(s 0) is '~'} then
            "-" <> stringOp.getSub(s 1 {stringOp.length(s) - 1})
        else
            s
        end

    let int(n: Int): Value = numberOf(minus(conv.int(n)) true)
    let word(w: wordLib.T): Value = numberOf(strutil.wordToString(w) true)

    (* conv.real writes a real as Python's repr does, but for its ~ and its
     * "inf" *)
    let realText(r: Real): String =
        begin
            let text = conv.real(r)
            if strutil.contains(text "inf") orif strutil.contains(text "nan") then
                failWith(:Ok "not a finite real: " <> text)
            end
            minus(text)
        end
    let real(r: Real): Value = numberOf(realText(r) false)

    let newObject(): Object =
        tuple
            var names = noNames
            var values = noValues
            var count = 0
            var index = noIndex
        end

    (* The position of name among o's members, or ~1 *)
    let find(o: Object name: String): Int =
        if o.count <= smallSize then
            let var i = 0
            let var found = ~1
            while {i < o.count} andif {found < 0} do
                if stringOp.equal(o.names[i] name) then found := i end
                i := i + 1
            end
            found
        else
            maybe.unwrapOr(hashMap.get(o.index name) ~1)
        end

    (* Indexes every member, once o has grown past smallSize *)
    let reindex(o: Object): Ok =
        begin
            if o.count > smallSize then
                o.index := hashMap.newWithCapacity(:String :Int 2 * o.count stringOp.equal hash.string)
                for i = 0 upto {o.count - 1} do hashMap.insert(o.index o.names[i] i) end
            else
                o.index := noIndex
            end
            ok
        end

    let put(o: Object name: String v: Value): Ok =
        begin
            let i = find(o name)
            if i >= 0 then
                o.values[i] := v
            else
                if o.count is extent o.names then
                    let capacity = if o.count is 0 then 2 else 2 * o.count end
                    let names = array of(capacity name)
                    let values = array of(capacity v)
                    for j = 0 upto {o.count - 1} do
                        names[j] := o.names[j]
                        values[j] := o.values[j]
                    end
                    o.names := names
                    o.values := values
                end
                o.names[o.count] := name
                o.values[o.count] := v
                o.count := o.count + 1
                if o.count is {smallSize + 1} then reindex(o)
                elsif o.count > smallSize then begin hashMap.insert(o.index name o.count - 1) ok end
                end
            end
        end

    let get(o: Object name: String): maybe.T(Value) =
        begin
            let i = find(o name)
            if i >= 0 then maybe.some(o.values[i]) else maybe.none(:Value) end
        end

    let remove(o: Object name: String): maybe.T(Value) =
        begin
            let i = find(o name)
            if i < 0 then
                maybe.none(:Value)
            else
                let v = o.values[i]
                for j = i upto {o.count - 2} do
                    o.names[j] := o.names[j + 1]
                    o.values[j] := o.values[j + 1]
                end
                o.count := o.count - 1
                (* The vacated slot holds a member still in use, not the
                 * removed value *)
                o.names[o.count] := o.names[0]
                o.values[o.count] := o.values[0]
                reindex(o)
                maybe.some(v)
            end
        end

    let names(o: Object): Array(String) =
        begin
            let result = array of(o.count "")
            for i = 0 upto {o.count - 1} do result[i] := o.names[i] end
            result
        end

    let size(o: Object): Int = o.count

    let forEach(o: Object action: All(name: String v: Value) Ok): Ok =
        begin
            for i = 0 upto {o.count - 1} do action(o.names[i] o.values[i]) end
            ok
        end

    (* ======================================================================
     * 2. Parsing
     * ====================================================================== *)

    Let ParseOptions = Record unique: Bool utf8: Bool end
    let parsing: ParseOptions = record unique = false utf8 = false end
    let parsingDynamic: ParseOptions = record unique = true utf8 = false end
    let parsingUtf8: ParseOptions = record unique = false utf8 = true end

    Let Scanner = Tuple text: String var pos: Int unique: Bool utf8: Bool end

    let atEnd(s: Scanner): Bool = s.pos >= stringOp.length(s.text)
    let peek(s: Scanner): Char = if atEnd(s) then '\x00' else stringOp.getChar(s.text s.pos) end
    let advance(s: Scanner): Ok = s.pos := s.pos + 1
    let fail(A::TYPE)(s: Scanner message: String): A = failAt(:A message s.pos)

    let isSpace(c: Char): Bool = {c is ' '} orif {c is '\t'} orif {c is '\n'} orif {c is '\r'}
    let isDigit(c: Char): Bool = {ascii.val(c) >= ascii.val('0')} andif {ascii.val(c) <= ascii.val('9')}

    let skipSpace(s: Scanner): Ok = while not(atEnd(s)) andif isSpace(peek(s)) do advance(s) end

    (* Expects the literal word at the scanner's position *)
    let expectWord(s: Scanner word: String): Ok =
        begin
            let n = stringOp.length(word)
            if {{s.pos + n} > stringOp.length(s.text)}
                    orif not(stringOp.equal(stringOp.getSub(s.text s.pos n) word)) then
                fail(:Ok s "expected " <> word)
            end
            s.pos := s.pos + n
        end

    let digits(s: Scanner): Int =
        begin
            let start = s.pos
            while not(atEnd(s)) andif isDigit(peek(s)) do advance(s) end
            s.pos - start
        end

    (* An optional minus, 0 or digits not starting with 0, an optional
     * fraction, and an optional exponent *)
    let scanNumber(s: Scanner): Value =
        begin
            let start = s.pos
            if peek(s) is '-' then advance(s) end
            if atEnd(s) orif not(isDigit(peek(s))) then fail(:Ok s "expected a digit") end
            if peek(s) is '0' then advance(s) else begin digits(s) ok end end
            let var isInteger = true
            if not(atEnd(s)) andif {peek(s) is '.'} then
                advance(s)
                if digits(s) is 0 then fail(:Ok s "expected a digit") end
                isInteger := false
            end
            if not(atEnd(s)) andif {{peek(s) is 'e'} orif {peek(s) is 'E'}} then
                advance(s)
                if {peek(s) is '+'} orif {peek(s) is '-'} then advance(s) end
                if digits(s) is 0 then fail(:Ok s "expected a digit") end
                isInteger := false
            end
            numberOf(stringOp.getSub(s.text start {s.pos - start}) isInteger)
        end

    let hexValue(s: Scanner c: Char): Int =
        begin
            let v = ascii.val(c)
            if {v >= ascii.val('0')} andif {v <= ascii.val('9')} then v - ascii.val('0')
            elsif {v >= ascii.val('a')} andif {v <= ascii.val('f')} then {v - ascii.val('a')} + 10
            elsif {v >= ascii.val('A')} andif {v <= ascii.val('F')} then {v - ascii.val('A')} + 10
            else fail(s "expected a hexadecimal digit")
            end
        end

    (* The four hexadecimal digits at offset at, as a number *)
    let hex4(s: Scanner at: Int): Int =
        begin
            if {at + 4} > stringOp.length(s.text) then failAt(:Ok "unterminated escape" at) end
            let var code = 0
            for i = 0 upto 3 do code := {code * 16} + hexValue(s stringOp.getChar(s.text {at + i})) end
            code
        end

    (* The UTF-8 encoding of the code point code *)
    let putUtf8(b: sb.T code: Int): Ok =
        if code < 128 then
            sb.char(b ascii.char(code))
        elsif code < 2048 then
            sb.char(b ascii.char(192 + {code / 64}))
            sb.char(b ascii.char(128 + {code % 64}))
        elsif code < 65536 then
            sb.char(b ascii.char(224 + {code / 4096}))
            sb.char(b ascii.char(128 + {{code / 64} % 64}))
            sb.char(b ascii.char(128 + {code % 64}))
        else
            sb.char(b ascii.char(240 + {code / 262144}))
            sb.char(b ascii.char(128 + {{code / 4096} % 64}))
            sb.char(b ascii.char(128 + {{code / 64} % 64}))
            sb.char(b ascii.char(128 + {code % 64}))
        end

    let isHighSurrogate(code: Int): Bool = {code >= 55296} andif {code <= 56319}
    let isLowSurrogate(code: Int): Bool = {code >= 56320} andif {code <= 57343}

    (* A \u escape, whose u is at the scanner's position, which is left at
     * the escape's last digit. In Latin-1 a character is a byte, so an escape
     * past 255 gives none. In UTF-8 an escape gives its code point's
     * encoding, and a high surrogate's escape must be followed by a low one's,
     * the two giving the code point of the pair *)
    let scanEscape(s: Scanner b: sb.T): Ok =
        begin
            let start = s.pos - 1
            if {s.pos + 5} > stringOp.length(s.text) then fail(:Ok s "unterminated escape") end
            let var code = hex4(s s.pos + 1)
            s.pos := s.pos + 4
            if not(s.utf8) then
                if code > 255 then failAt(:Ok "an escape past \\u00ff" start) end
                sb.char(b ascii.char(code))
            else
                if isHighSurrogate(code) then
                    let at = s.pos + 1
                    if {{at + 6} > stringOp.length(s.text)}
                            orif {stringOp.getChar(s.text at) isnot '\\'}
                            orif {stringOp.getChar(s.text at + 1) isnot 'u'} then
                        failAt(:Ok "a surrogate escape without its pair" start)
                    end
                    let low = hex4(s at + 2)
                    if not(isLowSurrogate(low)) then failAt(:Ok "a surrogate escape without its pair" start) end
                    code := 65536 + {{code - 55296} * 1024} + {low - 56320}
                    s.pos := s.pos + 6
                elsif isLowSurrogate(code) then
                    failAt(:Ok "a surrogate escape without its pair" start)
                end
                putUtf8(b code)
            end
        end

    let scanString(s: Scanner): String =
        begin
            advance(s)
            let b = sb.new()
            let var done = false
            while not(done) do
                if atEnd(s) then fail(:Ok s "unterminated string") end
                let c = peek(s)
                if c is '"' then
                    advance(s)
                    done := true
                elsif c is '\\' then
                    advance(s)
                    if atEnd(s) then fail(:Ok s "unterminated string") end
                    let e = peek(s)
                    if e is '"' then sb.char(b '"')
                    elsif e is '\\' then sb.char(b '\\')
                    elsif e is '/' then sb.char(b '/')
                    elsif e is 'b' then sb.char(b ascii.char(8))
                    elsif e is 'f' then sb.char(b ascii.char(12))
                    elsif e is 'n' then sb.char(b '\n')
                    elsif e is 'r' then sb.char(b '\r')
                    elsif e is 't' then sb.char(b '\t')
                    elsif e is 'u' then scanEscape(s b)
                    else failAt(:Ok "unknown escape" s.pos - 1)
                    end
                    advance(s)
                elsif ascii.val(c) < 32 then
                    fail(:Ok s "a control character in a string")
                else
                    sb.char(b c)
                    advance(s)
                end
            end
            sb.toString(b)
        end

    let rec scanValue(s: Scanner): Value =
        begin
            skipSpace(s)
            if atEnd(s) then fail(:Ok s "expected a value") end
            let c = peek(s)
            if c is '{' then
                advance(s)
                let o = newObject()
                skipSpace(s)
                if peek(s) is '}' then
                    advance(s)
                else
                    let var more = true
                    while more do
                        skipSpace(s)
                        if peek(s) isnot '"' then fail(:Ok s "expected a member name") end
                        let at = s.pos
                        let name = scanString(s)
                        skipSpace(s)
                        if peek(s) isnot ':' then fail(:Ok s "expected ':'") end
                        advance(s)
                        if s.unique andif {find(o name) >= 0} then failAt(:Ok "a repeated member name" at) end
                        put(o name scanValue(s))
                        skipSpace(s)
                        if peek(s) is ',' then advance(s)
                        elsif peek(s) is '}' then begin advance(s) more := false end
                        else fail(:Ok s "expected ',' or '}'")
                        end
                    end
                end
                object(o)
            elsif c is '[' then
                advance(s)
                let items = vector.new(:Value)
                skipSpace(s)
                if peek(s) is ']' then
                    advance(s)
                else
                    let var more = true
                    while more do
                        vector.append(items scanValue(s))
                        skipSpace(s)
                        if peek(s) is ',' then advance(s)
                        elsif peek(s) is ']' then begin advance(s) more := false end
                        else fail(:Ok s "expected ',' or ']'")
                        end
                    end
                end
                arrayValue(items)
            elsif c is '"' then
                string(scanString(s))
            elsif c is 't' then
                begin expectWord(s "true") bool(true) end
            elsif c is 'f' then
                begin expectWord(s "false") bool(false) end
            elsif c is 'n' then
                begin expectWord(s "null") null end
            elsif {c is '-'} orif isDigit(c) then
                scanNumber(s)
            else
                fail(:Value s "expected a value")
            end
        end

    let parseWith(text: String options: ParseOptions): Value =
        begin
            let s: Scanner =
                tuple let text = text let var pos = 0 let unique = options.unique let utf8 = options.utf8 end
            let v = scanValue(s)
            skipSpace(s)
            if not(atEnd(s)) then fail(:Ok s "text after the value") end
            v
        end

    let parse(text: String): Value = parseWith(text parsing)

    let number(text: String): Value =
        begin
            let s: Scanner = tuple let text = text let var pos = 0 let unique = false let utf8 = false end
            if atEnd(s) then fail(:Ok s "expected a number") end
            let v = scanNumber(s)
            if not(atEnd(s)) then fail(:Ok s "text after the number") end
            v
        end

    (* The text of one value from rd, a character at a time and no further:
     * an object or array to the bracket that closes it, counting the
     * brackets it nests and ignoring those in strings; a string to its
     * closing quote; anything else (a number, true, ...) to whitespace, a
     * comma, or a closing bracket, which is read too. Then parsed as text *)
    let read(rd: reader.T options: ParseOptions): Value =
        begin
            let b = sb.new()
            let next(): Char =
                if reader.more(rd) then
                    reader.getChar(rd)
                else
                    failAt(:Char "end of stream in a value" sb.length(b))
                end
            let var c = next()
            while isSpace(c) do c := next() end
            sb.char(b c)
            if {c is '{'} orif {c is '['} then
                let var depth = 1
                let var inString = false
                let var escaped = false
                while depth > 0 do
                    let d = next()
                    sb.char(b d)
                    if inString then
                        if escaped then escaped := false
                        elsif d is '\\' then escaped := true
                        elsif d is '"' then inString := false
                        end
                    elsif d is '"' then
                        inString := true
                    elsif {d is '{'} orif {d is '['} then
                        depth := depth + 1
                    elsif {d is '}'} orif {d is ']'} then
                        depth := depth - 1
                    end
                end
            elsif c is '"' then
                let var escaped = false
                let var going = true
                while going do
                    let d = next()
                    sb.char(b d)
                    if escaped then escaped := false
                    elsif d is '\\' then escaped := true
                    elsif d is '"' then going := false
                    end
                end
            else
                let var going = true
                while going andif reader.more(rd) do
                    let d = reader.getChar(rd)
                    if isSpace(d) orif {d is ','} orif {d is ']'} orif {d is '}'} then going := false
                    else sb.char(b d)
                    end
                end
            end
            parseWith(sb.toString(b) options)
        end

    (* ======================================================================
     * 3. Printing
     * ====================================================================== *)

    Let PrintOptions = Record indent: Int utf8: Bool end
    let compact: PrintOptions = record indent = 0 utf8 = false end
    let compactUtf8: PrintOptions = record indent = 0 utf8 = true end
    let indented(n: Int): PrintOptions = record indent = n utf8 = false end

    let hexDigit(n: Int): Char = stringOp.getChar("0123456789abcdef" n)

    (* The length of the well-formed UTF-8 sequence at offset i of text, or,
     * if there is none, minus the length of the maximal subpart there: the
     * longest prefix of a well-formed sequence, or else the one byte.
     * Unicode's practice for U+FFFD substitution, which Python's "replace"
     * follows, replaces each maximal subpart with one U+FFFD *)
    let sequenceAt(text: String i: Int): Int =
        begin
            let n = stringOp.length(text)
            let lead = ascii.val(stringOp.getChar(text i))
            (* need is how many continuation bytes the lead byte asks for, ~1
             * if it is not a lead byte. lo and hi bound the next byte, which
             * excludes overlong forms, surrogates, and code points past
             * U+10FFFF *)
            let var need = ~1
            let var lo = 128
            let var hi = 191
            if lead < 128 then
                need := 0
            elsif {lead >= 194} andif {lead < 224} then
                need := 1
            elsif {lead >= 224} andif {lead < 240} then
                need := 2
                if lead is 224 then lo := 160 elsif lead is 237 then hi := 159 end
            elsif {lead >= 240} andif {lead < 245} then
                need := 3
                if lead is 240 then lo := 144 elsif lead is 244 then hi := 143 end
            end
            if need < 0 then
                ~1
            else
                let var k = 1
                let var good = true
                while good andif {k <= need} do
                    if {i + k} < n then
                        let c = ascii.val(stringOp.getChar(text i + k))
                        if {c >= lo} andif {c <= hi} then
                            k := k + 1
                            lo := 128
                            hi := 191
                        else
                            good := false
                        end
                    else
                        good := false
                    end
                end
                if good then k else 0 - k end
            end
        end

    (* text as a JSON string. In Latin-1 (not utf8), each byte that is not
     * printable ASCII is escaped as \u00XX. In UTF-8, as Python's
     * ensure_ascii=False writes it, only control characters are escaped: a
     * well-formed UTF-8 sequence is written as it is, and each maximal
     * subpart of an ill-formed one as U+FFFD, so the text is always UTF-8 *)
    let quoted(b: sb.T text: String utf8: Bool): Ok =
        begin
            sb.char(b '"')
            let n = stringOp.length(text)
            let var i = 0
            while i < n do
                let c = stringOp.getChar(text i)
                let v = ascii.val(c)
                let var next = i + 1
                if c is '"' then sb.str(b "\\\"")
                elsif c is '\\' then sb.str(b "\\\\")
                elsif c is '\n' then sb.str(b "\\n")
                elsif c is '\r' then sb.str(b "\\r")
                elsif c is '\t' then sb.str(b "\\t")
                elsif v is 8 then sb.str(b "\\b")
                elsif v is 12 then sb.str(b "\\f")
                elsif {v < 32} orif {{v > 126} andif not(utf8)} then
                    sb.str(b "\\u00")
                    sb.char(b hexDigit(v / 16))
                    sb.char(b hexDigit(v % 16))
                elsif v < 128 then
                    sb.char(b c)
                else
                    let size = sequenceAt(text i)
                    if size > 0 then
                        sb.sub(b text i size)
                        next := i + size
                    else
                        sb.str(b "\xef\xbf\xbd")
                        next := i - size
                    end
                end
                i := next
            end
            sb.char(b '"')
            ok
        end

    (* A line break and the indentation of depth levels, when indented *)
    let newline(b: sb.T indent: Int depth: Int): Ok =
        if indent > 0 then
            sb.char(b '\n')
            sb.repeat(b ' ' indent * depth)
        else
            ok
        end

    (* v, at depth levels of indentation *)
    let rec print(b: sb.T v: Value indent: Int utf8: Bool depth: Int): Ok =
        case v
            when jNull then sb.str(b "null")
            when jBool with x then sb.str(b if x.b then "true" else "false" end)
            when jNumber with x then sb.str(b x.text)
            when jString with x then quoted(b x.s utf8)
            when jArray with x then
                if vector.empty(x.items) then
                    sb.str(b "[]")
                else
                    sb.char(b '[')
                    for i = 0 upto {vector.length(x.items) - 1} do
                        if i > 0 then sb.char(b ',') end
                        newline(b indent depth + 1)
                        print(b vector.get(x.items i) indent utf8 {depth + 1})
                    end
                    newline(b indent depth)
                    sb.char(b ']')
                end
            when jObject with x then
                if x.o.count is 0 then
                    sb.str(b "{}")
                else
                    sb.char(b '{')
                    for i = 0 upto {x.o.count - 1} do
                        if i > 0 then sb.char(b ',') end
                        newline(b indent depth + 1)
                        quoted(b x.o.names[i] utf8)
                        sb.str(b if indent > 0 then ": " else ":" end)
                        print(b x.o.values[i] indent utf8 {depth + 1})
                    end
                    newline(b indent depth)
                    sb.char(b '}')
                end
        end

    let dumpWith(v: Value options: PrintOptions): String =
        begin
            let b = sb.new()
            print(b v options.indent options.utf8 0)
            sb.toString(b)
        end

    let dump(v: Value): String = dumpWith(v compact)

    let write(wr: writer.T v: Value options: PrintOptions): Ok = writer.putString(wr dumpWith(v options))

    (* ======================================================================
     * 4. Reading a Tree
     * ====================================================================== *)

    let kindError(A::TYPE)(wanted: String): A = failWith(:A "not " <> wanted)

    let toBool(v: Value): Bool = case v when jBool with x then x.b else kindError("a boolean") end

    let toInt(v: Value): Int =
        case v
            when jNumber with x then
                let n = if x.isInteger then strutil.tryToInt(x.text) else maybe.none(:Int) end
                if maybe.isSome(n) then maybe.unwrap(n) else failWith("not an Int: " <> x.text) end
            else kindError("a number")
        end

    let toWord(v: Value): wordLib.T =
        case v
            when jNumber with x then
                let w = if x.isInteger then strutil.tryToWord(x.text) else maybe.none(:wordLib.T) end
                (* A word that reads back as the same text is in range *)
                if maybe.isSome(w) andif stringOp.equal(strutil.wordToString(maybe.unwrap(w)) x.text) then
                    maybe.unwrap(w)
                else
                    failWith("not a word: " <> x.text)
                end
            else kindError("a number")
        end

    let toReal(v: Value): Real =
        case v
            when jNumber with x then strutil.toReal(x.text)
            else kindError("a number")
        end

    let toString(v: Value): String = case v when jString with x then x.s else kindError("a string") end
    let toArray(v: Value): vector.T(Value) = case v when jArray with x then x.items else kindError("an array") end
    let toObject(v: Value): Object = case v when jObject with x then x.o else kindError("an object") end

    let member(v: Value name: String): Value =
        begin
            let found = get(toObject(v) name)
            if maybe.isSome(found) then maybe.unwrap(found) else failWith("no member " <> name) end
        end

    let optional(v: Value name: String): maybe.T(Value) =
        case v when jObject with x then get(x.o name) else maybe.none(:Value) end

    (* Numbers by value: integers that fit an Int as Ints, others as reals *)
    let sameNumber(a: String aInteger: Bool b: String bInteger: Bool): Bool =
        if stringOp.equal(a b) then
            true
        else
            let m = if aInteger then strutil.tryToInt(a) else maybe.none(:Int) end
            let n = if bInteger then strutil.tryToInt(b) else maybe.none(:Int) end
            if maybe.isSome(m) andif maybe.isSome(n) then
                maybe.unwrap(m) is maybe.unwrap(n)
            else
                strutil.toReal(a) is strutil.toReal(b)
            end
        end

    let rec equal(a: Value b: Value): Bool =
        case a
            when jNull then b?jNull
            when jBool with x then case b when jBool with y then x.b is y.b else false end
            when jNumber with x then
                case b when jNumber with y then sameNumber(x.text x.isInteger y.text y.isInteger) else false end
            when jString with x then case b when jString with y then stringOp.equal(x.s y.s) else false end
            when jArray with x then
                case b
                    when jArray with y then
                        if vector.length(x.items) isnot vector.length(y.items) then
                            false
                        else
                            let var same = true
                            let var i = 0
                            while same andif {i < vector.length(x.items)} do
                                same := equal(vector.get(x.items i) vector.get(y.items i))
                                i := i + 1
                            end
                            same
                        end
                    else false
                end
            when jObject with x then
                case b
                    when jObject with y then
                        if x.o.count isnot y.o.count then
                            false
                        else
                            let var same = true
                            let var i = 0
                            while same andif {i < x.o.count} do
                                let other = get(y.o x.o.names[i])
                                same := maybe.isSome(other) andif equal(x.o.values[i] maybe.unwrap(other))
                                i := i + 1
                            end
                            same
                        end
                    else false
                end
        end

    (* ======================================================================
     * 5. Writing a Stream
     *
     * The text goes to a builder, which is written to the writer when it
     * grows past flushSize and at finish. A frame is an open array or
     * object: how many elements or members it has had, and, for an object,
     * whether a name waits for its value.
     * ====================================================================== *)

    Let Frame = Tuple isObject: Bool var count: Int var named: Bool end
    Let Emitter = Tuple
        wr: writer.T
        b: sb.T
        indent: Int
        utf8: Bool
        frames: vector.T(Frame)
        var done: Bool
    end

    let flushSize: Int = 65536

    let emitter(wr: writer.T options: PrintOptions): Emitter =
        tuple
            let wr = wr
            let b = sb.new()
            let indent = options.indent
            let utf8 = options.utf8
            let frames = vector.new(:Frame)
            let var done = false
        end

    let flush(e: Emitter): Ok =
        if sb.length(e.b) > 0 then
            writer.putString(e.wr sb.toString(e.b))
            sb.clear(e.b)
        else
            ok
        end

    let depth(e: Emitter): Int = vector.length(e.frames)

    (* Where a value may go: at the top before any, after a name in an
     * object, or as an array's next element, after its separator *)
    let beforeValue(e: Emitter): Ok =
        if vector.empty(e.frames) then
            if e.done then failWith(:Ok "a second value") end
        else
            let f = vector.last(e.frames)
            if f.isObject then
                if not(f.named) then failWith(:Ok "a value where a member name belongs") end
            else
                if f.count > 0 then sb.char(e.b ',') end
                newline(e.b e.indent depth(e))
            end
        end

    let afterValue(e: Emitter): Ok =
        begin
            if vector.empty(e.frames) then
                e.done := true
            else
                let f = vector.last(e.frames)
                f.count := f.count + 1
                f.named := false
            end
            if sb.length(e.b) > flushSize then flush(e) end
        end

    let open(e: Emitter isObject: Bool bracket: Char): Ok =
        begin
            beforeValue(e)
            sb.char(e.b bracket)
            vector.append(e.frames tuple let isObject = isObject let var count = 0 let var named = false end)
        end

    let close(e: Emitter isObject: Bool bracket: Char): Ok =
        begin
            if vector.empty(e.frames) then failWith(:Ok "an end without its beginning") end
            let f = vector.last(e.frames)
            if {f.isObject isnot isObject} orif f.named then failWith(:Ok "an end without its beginning") end
            vector.pop(e.frames)
            if f.count > 0 then newline(e.b e.indent depth(e)) end
            sb.char(e.b bracket)
            afterValue(e)
        end

    let beginObject(e: Emitter): Ok = open(e true '{')
    let endObject(e: Emitter): Ok = close(e true '}')
    let beginArray(e: Emitter): Ok = open(e false '[')
    let endArray(e: Emitter): Ok = close(e false ']')

    let name(e: Emitter n: String): Ok =
        begin
            if vector.empty(e.frames) then failWith(:Ok "a member name outside an object") end
            let f = vector.last(e.frames)
            if not(f.isObject) orif f.named then failWith(:Ok "a member name where a value belongs") end
            if f.count > 0 then sb.char(e.b ',') end
            newline(e.b e.indent depth(e))
            quoted(e.b n e.utf8)
            sb.str(e.b if e.indent > 0 then ": " else ":" end)
            f.named := true
        end

    let value(e: Emitter v: Value): Ok =
        begin
            beforeValue(e)
            print(e.b v e.indent e.utf8 depth(e))
            afterValue(e)
        end

    (* A scalar's text *)
    let scalar(e: Emitter text: String): Ok =
        begin
            beforeValue(e)
            sb.str(e.b text)
            afterValue(e)
        end

    let nullValue(e: Emitter): Ok = scalar(e "null")
    let boolValue(e: Emitter b: Bool): Ok = scalar(e if b then "true" else "false" end)
    let intValue(e: Emitter n: Int): Ok = scalar(e minus(conv.int(n)))
    let wordValue(e: Emitter w: wordLib.T): Ok = scalar(e strutil.wordToString(w))
    let realValue(e: Emitter r: Real): Ok = scalar(e realText(r))
    let stringValue(e: Emitter s: String): Ok =
        begin
            beforeValue(e)
            quoted(e.b s e.utf8)
            afterValue(e)
        end

    let finish(e: Emitter): Ok =
        begin
            if not(e.done) then failWith(:Ok "finish before the value is whole") end
            flush(e)
        end
end
