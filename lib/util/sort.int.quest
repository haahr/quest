(* Standard Library: Pure Quest Searching and Sorting Utilities *)

interface Sort
import
    collections/vector : collections/Vector
    util/maybe : util/Maybe
export
    (* ======================================================================
     * Comparators
     * ====================================================================== *)

    (* Standard integer comparator: returns ~1 if a < b, 0 if a == b, 1 if a >
     * b *)
    intCompare(a: Int b: Int): Int

    (* Lexicographical string comparator: returns ~1 if a < b, 0 if a == b, 1 if
     * a > b *)
    stringCompare(a: String b: String): Int

    (* Standard floating-point comparator: returns ~1 if a < b, 0 if a == b, 1
     * if a > b. A NaN compares 0, equal, with every number, so an array
     * holding one has no consistent order to sort into *)
    realCompare(a: Real b: Real): Int

    (* Inverts any comparator to sort or search in descending order *)
    reverse: All(A::TYPE) All(cmp: All(a: A b: A) Int) All(a: A b: A) Int

    (* ======================================================================
     * Bisection & Binary Search (Right / Upper Bound)
     * ====================================================================== *)

    (* Returns insertion index i in [0, size] such that arr[0..i-1] <= key and
     * arr[i..] > key *)
    bisectRight: All(A::TYPE) All(
        arr: Array(A)
        key: A
        cmp: All(a: A b: A) Int
    ) Int

    (* Vector variant of bisectRight *)
    bisectRightVector: All(A::TYPE) All(
        v: vector.T(A)
        key: A
        cmp: All(a: A b: A) Int
    ) Int

    (* Sliced range variant [lo, hi) of bisectRight *)
    bisectRightRange: All(A::TYPE) All(
        arr: Array(A)
        key: A
        lo: Int
        hi: Int
        cmp: All(a: A b: A) Int
    ) Int

    (* ======================================================================
     * Bisection & Binary Search (Left / Lower Bound)
     * ====================================================================== *)

    (* Returns insertion index i in [0, size] such that arr[0..i-1] < key and
     * arr[i..] >= key *)
    bisectLeft: All(A::TYPE) All(
        arr: Array(A)
        key: A
        cmp: All(a: A b: A) Int
    ) Int

    (* Vector variant of bisectLeft *)
    bisectLeftVector: All(A::TYPE) All(
        v: vector.T(A)
        key: A
        cmp: All(a: A b: A) Int
    ) Int

    (* Sliced range variant [lo, hi) of bisectLeft *)
    bisectLeftRange: All(A::TYPE) All(
        arr: Array(A)
        key: A
        lo: Int
        hi: Int
        cmp: All(a: A b: A) Int
    ) Int

    (* ======================================================================
     * Exact Match Binary Search
     * ====================================================================== *)

    (* Exact match search: returns maybe.some(index) if found, else
     * maybe.none *)
    binarySearch: All(A::TYPE) All(
        arr: Array(A)
        key: A
        cmp: All(a: A b: A) Int
    ) maybe.T(Int)

    (* Vector variant of binarySearch *)
    binarySearchVector: All(A::TYPE) All(
        v: vector.T(A)
        key: A
        cmp: All(a: A b: A) Int
    ) maybe.T(Int)

    (* ======================================================================
     * Sorting Algorithms
     * ====================================================================== *)

    (* Sorts arr in place into ascending order by cmp. cmp(a b) must be
     * negative, 0, or positive as a precedes, equals, or follows b, and
     * consistently so (an order in which equal is transitive); with any other
     * cmp, arr ends in some permutation of its elements. Not stable: elements
     * that cmp makes equal may change places. A 3-way quicksort, pivoting on
     * the middle element: O(n log n) comparisons on most inputs, O(n * n) at
     * worst *)
    sort: All(A::TYPE) All(
        arr: Array(A)
        cmp: All(a: A b: A) Int
    ) Ok

    (* Sorts v in place, as sort does an array *)
    sortVector: All(A::TYPE) All(
        v: vector.T(A)
        cmp: All(a: A b: A) Int
    ) Ok

    (* A new array of arr's elements, sorted as sort does; arr is
     * unchanged *)
    sorted: All(A::TYPE) All(
        arr: Array(A)
        cmp: All(a: A b: A) Int
    ) Array(A)

    (* A new vector of v's elements, sorted as sort does; v is unchanged *)
    sortedVector: All(A::TYPE) All(
        v: vector.T(A)
        cmp: All(a: A b: A) Int
    ) vector.T(A)
end
