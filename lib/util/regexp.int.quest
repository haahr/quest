interface Regexp
import
    collections/vector : collections/Vector
    util/iter : util/Iter
    util/maybe : util/Maybe
export
    (* =========================================================================
     * Regular Expressions (Regexp)
     *
     * Patterns in RE2's syntax, matched in time linear in the subject, on
     * bytes, leftmost-first (docs/regexp.md). A pattern is a string,
     * parsed, or a value, built by the functions below; both are regexp.RE.
     *
     *     let date = regexp.compile("(\\d{4})-(\\d\\d)")
     *     let m = regexp.find(date line)
     *     if maybe.isSome(:regexp.Match m) then
     *         print(regexp.group(maybe.unwrap(:regexp.Match m) 1))
     *     end
     *
     * The operations that find more than one match (findAll, the replacing
     * functions, and split) take them as Go's regexp does: left to right, none
     * overlapping, an empty match not taken where the previous match ended.
     * ====================================================================== *)

    (* What parse raises for a pattern that is not one: why, and where in the
     * pattern (a byte offset) *)
    Def SyntaxError = Tuple message: String offset: Int end
    syntax: Exception(SyntaxError)

    (* Raised for an argument out of range: a start outside the subject, a
     * group the expression does not have, a repeat's bounds, a group's name
     * (or one named twice in compileRE's pattern), or complement of a pattern
     * that is not one byte *)
    error: Exception

    (* ---- Compiling *)

    (* A compiled regular expression: immutable, shared freely *)
    T::TYPE
    (* pattern, in RE2's syntax (docs/regexp.md section 2), compiled;
     * raises syntax *)
    compile(pattern: String): T
    (* The pattern r was compiled from; for one compileRE made, as show writes
     * it *)
    pattern(r: T): String
    (* The number of capturing groups; group 0, the whole match, not counted *)
    groupCount(r: T): Int
    (* The number of the group named name, or ~1 if r has none *)
    groupIndex(r: T name: String): Int

    (* ---- Testing: no match is made, so these are the fastest *)

    (* Whether r matches the whole of s *)
    matches(r: T s: String): Bool
    (* Whether r matches somewhere in s *)
    contains(r: T s: String): Bool

    (* ---- Finding *)

    (* A match: its subject, and where each group matched in it *)
    Match::TYPE
    (* The leftmost match of r in s, if any: of the matches that begin
     * leftmost, the one the pattern prefers (alternatives in order, greedy
     * repetitions longest) *)
    find(r: T s: String): maybe.T(Match)
    (* The leftmost match of r in s that begins at start or later; ^ and \b
     * still see the bytes before start. Raises error unless
     * 0 <= start <= length(s) *)
    findFrom(r: T s: String start: Int): maybe.T(Match)
    (* The match of r that begins exactly at start, if any; raises error as
     * findFrom does *)
    matchAt(r: T s: String start: Int): maybe.T(Match)

    (* ---- A match's parts; group 0 is the whole match *)

    subject(m: Match): String
    (* Whether group i took part in the match: in (a)|(b), only one does.
     * This and the next four raise error unless 0 <= i <= groupCount *)
    matched(m: Match i: Int): Bool
    (* Where group i matched: its start and size in the subject, or ~1 for a
     * group that took no part *)
    start(m: Match i: Int): Int
    size(m: Match i: Int): Int
    (* The text group i matched, copied from the subject (as it is now); ""
     * for a group that took no part *)
    group(m: Match i: Int): String
    (* The same for the group named name; raises error if there is none *)
    named(m: Match name: String): String

    (* ---- Every match, replacing, and splitting *)

    (* Every match of r in s, left to right, none overlapping; an empty match
     * where the previous match ended is not one *)
    findAll(r: T s: String): vector.T(Match)
    (* findAll's matches as an iterator, each found as it is pulled
     * (docs/libraries.md, util/iter); and the text of each *)
    findIter(r: T s: String): iter.T(Match)
    findStringIter(r: T s: String): iter.T(String)
    (* s with its first match, or every match, replaced by template expanded
     * for the match: $n and ${n} are group n's text, $name and ${name} a
     * named group's ($name taking as many letters, digits, and _ as there
     * are, so that $1x is ${1x}), and $$ is a $. A group that does not exist
     * or took no part expands to nothing, and a $ that begins none of these
     * is itself, as Go's regexp.Expand has it *)
    replaceFirst(r: T s: String template: String): String
    replaceAll(r: T s: String template: String): String
    (* s with every match replaced by what f makes of it *)
    replaceWith(r: T s: String f: All(m: Match) String): String
    (* The pieces of s between the matches of r, as Go's regexp.Split(s, -1)
     * gives them: an empty match at s's start or end makes no empty piece, and
     * an empty s is one empty piece (none, for the empty pattern) *)
    split(r: T s: String): vector.T(String)
    (* s with every byte that has a meaning in a pattern (\ . + * ? ( ) | [ ]
     * { } ^ $) escaped with \, so that compile(quote(s)) matches s and
     * nothing else *)
    quote(s: String): String

    (* ---- Patterns as values. Each function makes a new pattern and changes
     * none of its arguments *)
    RE::TYPE

    (* The pattern a string is, in RE2's syntax (docs/regexp.md section 2);
     * raises syntax *)
    parse(pattern: String): RE
    (* re compiled; raises error if two groups have one name, and syntax
     * ("expression too large") for a pattern of more than 100,000
     * instructions *)
    compileRE(re: RE): T

    (* The bytes of s, in order *)
    literal(s: String): RE
    (* Any one byte of s *)
    set(s: String): RE
    (* Any one byte from lo to hi; raises error if hi is before lo *)
    range(lo: Char hi: Char): RE
    (* Any one byte that re does not match; raises error unless re matches
     * exactly one byte (a set, a range, a class, a one-byte literal, or an
     * alternation of them) *)
    complement(re: RE): RE

    (* Any byte; any byte but newline (the syntax's .); and the ASCII classes
     * \d, \w (letters, digits, and _), and \s (tab, newline, form feed,
     * carriage return, and space) *)
    anyByte: RE
    notNewline: RE
    digit: RE
    wordByte: RE
    space: RE

    (* The patterns one after another; any one of them, the first preferred *)
    seq(res: Array(RE)): RE
    alt(res: Array(RE)): RE

    (* re at least min times and at most max (~1 for no limit), as many as can
     * be if greedy and as few if not; raises error unless 0 <= min <= 1000
     * and max is ~1 or min <= max <= 1000. star, plus, and opt are its
     * commonest uses, greedy *)
    repeat(re: RE min: Int max: Int greedy: Bool): RE
    star(re: RE): RE
    plus(re: RE): RE
    opt(re: RE): RE

    (* A capturing group, numbered in the order a left-to-right reading of
     * the whole pattern meets groups; and a named one, whose name is letters,
     * digits, and _, not starting with a digit (raises error otherwise) *)
    capture(re: RE): RE
    namedCapture(name: String re: RE): RE

    (* re with ASCII letters matching either case *)
    caseless(re: RE): RE

    (* The zero-width assertions: a line's start and end (^ and $ with the m
     * flag), the subject's start and end (\A and \z), a word boundary (\b),
     * and not one (\B) *)
    lineStart: RE
    lineEnd: RE
    textStart: RE
    textEnd: RE
    wordBoundary: RE
    notWordBoundary: RE

    (* re simplified and written out, for tests and debugging: "ab" for
     * bytes, [a-z] for a set, (cat ...), (alt ...), (rep MIN MAX x) (rep? for
     * lazy, MAX inf for no limit), (cap x) and (cap NAME x) for groups, the
     * assertions by name, and empty *)
    show(re: RE): String
end
