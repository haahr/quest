(* Standard Library: util/regexp's matcher, a Pike VM (docs/regexp-plan.md
 * section 4.3, after Russ Cox's "Regular Expression Matching: the Virtual
 * Machine Approach") *)

module regexpMatch : RegexpMatch
import
    prog = util/regexpProgram : util/RegexpProgram
    util/maybe : util/Maybe
    stringOp = string : StringOp
    ascii: Ascii
export
    (* The threads at one offset, in priority order, as a sparse set of
     * instructions: pcs[0 .. count - 1], with sparse[pc] where pc is in pcs,
     * so that adding, testing, and emptying take constant time. Thread i's
     * capture slots are caps[nslots * i ...] *)
    Let List = Tuple
        pcs: Array(Int)
        sparse: Array(Int)
        var count: Int
        caps: Array(Int)
    end

    let newList(size: Int nslots: Int): List =
        tuple
            let pcs = array of(size 0)
            let sparse = array of(size 0)
            let var count = 0
            let caps = array of({size * nslots} ~1)
        end

    let has(l: List pc: Int): Bool = {l.sparse[pc] < l.count} andif {l.pcs[l.sparse[pc]] is pc}

    let isWordByte(b: Int): Bool =
        {{b >= 48} /\ {b <= 57}} \/ {{b >= 65} /\ {b <= 90}} \/ {{b >= 97} /\ {b <= 122}} \/ {b is 95}

    let byteAt(s: String i: Int): Int = ascii.val(stringOp.getChar(s i))

    (* Whether the assertion coded a (prog.assertionCode) holds at offset pos
     * of s, whose length is n *)
    let holds(a: Int s: String pos: Int n: Int): Bool =
        if a is 0 then {pos is 0} orif {byteAt(s pos - 1) is 10}
        elsif a is 1 then {pos is n} orif {byteAt(s pos) is 10}
        elsif a is 2 then pos is 0
        elsif a is 3 then pos is n
        else
            let before = {pos > 0} andif isWordByte(byteAt(s pos - 1))
            let after = {pos < n} andif isWordByte(byteAt(s pos))
            if a is 4 then before isnot after else before is after end
        end

    (* What a search works in, made for one program and number of slots: the
     * two thread lists; the slots of the thread being added, and the work
     * still to do in adding it (an instruction to visit, pc >= 0, or a slot to
     * put back as it was, ~1 - slot and its value, two entries each); slots
     * all unset; and the best match's. Busy while a search uses it *)
    Let Scratch = Tuple
        program: prog.Program
        nslots: Int
        var busy: Bool
        first: List
        second: List
        work: Array(Int)
        stack: Array(Int)
        unset: Array(Int)
        best: Array(Int)
    end

    (* The scratch the last search made, kept for the next search of its
     * program, since making one costs as much as a short search: a search
     * reuses it unless a search of it is running (one in a replaceWith
     * function, say) *)
    let kept = tuple let var last = maybe.none(:Scratch) end

    let obtain(p: prog.Program nslots: Int): Scratch =
        begin
            let reusable = maybe.isSome(:Scratch kept.last) andif begin
                let k = maybe.unwrap(:Scratch kept.last)
                {k.program is p} andif {k.nslots is nslots} andif not(k.busy)
            end
            if reusable then
                let k = maybe.unwrap(:Scratch kept.last)
                k.busy := true
                k
            else
                let size = extent p.op
                let k = tuple
                    let program = p
                    let nslots = nslots
                    let var busy = true
                    let first = newList(size nslots)
                    let second = newList(size nslots)
                    let work = array of(nslots ~1)
                    let stack = array of({6 * size} + 4 0)
                    let unset = array of(nslots ~1)
                    let best = array of(nslots ~1)
                end
                kept.last := maybe.some(:Scratch k)
                k
            end
        end

    (* A pattern that is bytes and nothing else, found directly: its first
     * byte, then the rest compared, rather than run as a program *)
    let literalSearch(p: prog.Program lit: String s: String start: Int anchored: Bool full: Bool nslots: Int)
        : maybe.T(Array(Int)) =
        begin
            let n = stringOp.length(s)
            let m = stringOp.length(lit)
            let first = stringOp.getChar(lit 0)
            let at(i: Int): Bool = stringOp.equalSub(s i m lit 0 m)
            let var found = ~1
            if anchored \/ full then
                if {{start + m} <= n} andif {not(full) orif {{start + m} is n}} andif at(start) then found := start end
            else
                let var i = start
                let last = n - m
                while {i <= last} /\ {found < 0} do
                    if {stringOp.getChar(s i) is first} andif at(i) then found := i else i := i + 1 end
                end
            end
            if found < 0 then maybe.none(:Array(Int))
            elsif nslots is 0 then maybe.some(:Array(Int) array of :Int end)
            else maybe.some(:Array(Int) array of found found + m end)
            end
        end

    let search(p: prog.Program s: String start: Int anchored: Bool full: Bool captures: Bool): maybe.T(Array(Int)) =
        begin
            let n = stringOp.length(s)
            let size = extent p.op
            let nslots = if captures then 2 * {p.groups + 1} else 0 end
            if maybe.isSome(:String p.literal) then
                literalSearch(p maybe.unwrap(:String p.literal) s start anchored full nslots)
            else
            let scratch = obtain(p nslots)
            let var cur = scratch.first
            let var nxt = scratch.second
            cur.count := 0
            nxt.count := 0
            let work = scratch.work
            let stack = scratch.stack
            let unset = scratch.unset
            let best = scratch.best

            (* Adds to l the thread at pc0, at offset at, with the slots
             * src[off ...]: it and every instruction it reaches without
             * consuming a byte, in priority order *)
            let add(l: List pc0: Int at: Int src: Array(Int) off: Int): Ok =
                begin
                    for k = 0 upto {nslots - 1} do work[k] := src[off + k] end
                    let var top = 0
                    stack[0] := pc0
                    top := 2
                    while top > 0 do
                        top := top - 2
                        let a = stack[top]
                        if a < 0 then
                            work[~1 - a] := stack[top + 1]
                        elsif not(has(l a)) then
                            let i = l.count
                            l.sparse[a] := i
                            l.pcs[i] := a
                            l.count := i + 1
                            let op = p.op[a]
                            if op is prog.opJump then
                                stack[top] := p.x[a]
                                top := top + 2
                            elsif op is prog.opSplit then
                                (* x is taken first, so pushed last *)
                                stack[top] := p.y[a]
                                stack[top + 2] := p.x[a]
                                top := top + 4
                            elsif op is prog.opSave then
                                let slot = p.x[a]
                                if slot < nslots then
                                    stack[top] := ~1 - slot
                                    stack[top + 1] := work[slot]
                                    top := top + 2
                                    work[slot] := at
                                end
                                stack[top] := a + 1
                                top := top + 2
                            elsif op is prog.opAssert then
                                if holds(p.x[a] s at n) then
                                    stack[top] := a + 1
                                    top := top + 2
                                end
                            else
                                (* a byte, a class, or the match: a thread *)
                                for k = 0 upto {nslots - 1} do l.caps[{nslots * i} + k] := work[k] end
                            end
                        end
                    end
                end

            (* an anchored pattern is tried at start only, and a search with no
             * thread running skips to a byte a match can begin with *)
            let once = anchored \/ p.anchored
            let skip = p.startSet
            let canSkip = extent skip > 0
            let prefixSize = stringOp.length(p.prefix)
            let prefixFirst = if prefixSize > 0 then stringOp.getChar(p.prefix 0) else ' ' end
            let var matched = false
            let var pos = start
            let var running = true
            while running do
                if {cur.count is 0} andif not(matched) andif not(once) andif canSkip then
                    if prefixSize > 1 then
                        (* to the prefix's next occurrence *)
                        let at(i: Int): Bool =
                            {{i + prefixSize} <= n} andif {stringOp.getChar(s i) is prefixFirst}
                                andif stringOp.equalSub(s i prefixSize p.prefix 0 prefixSize)
                        while {pos < n} andif not(at(pos)) do pos := pos + 1 end
                    else
                        while {pos < n} andif not(skip[byteAt(s pos)]) do pos := pos + 1 end
                    end
                    (* a match begins with a byte, and none is left *)
                    if pos >= n then running := false end
                end
                if running andif not(matched) andif {not(once) orif {pos is start}} then add(cur 0 pos unset 0) end
                if cur.count > 0 then
                    let c = if pos < n then byteAt(s pos) else ~1 end
                    nxt.count := 0
                    let var i = 0
                    while i < cur.count do
                        let pc = cur.pcs[i]
                        let op = p.op[pc]
                        if op is prog.opMatch then
                            if not(full) orif {pos is n} then
                                matched := true
                                for k = 0 upto {nslots - 1} do best[k] := cur.caps[{nslots * i} + k] end
                                (* the threads after this one have lower
                                 * priority; without captures, any match will
                                 * do *)
                                i := cur.count
                                if not(captures) then running := false end
                            end
                        elsif op is prog.opByte then
                            if c is p.x[pc] then add(nxt pc + 1 pos + 1 cur.caps nslots * i) end
                        elsif op is prog.opClass then
                            if {c >= 0} andif p.classes[{256 * p.x[pc]} + c] then
                                add(nxt pc + 1 pos + 1 cur.caps nslots * i)
                            end
                        end
                        i := i + 1
                    end
                    let t = cur
                    cur := nxt
                    nxt := t
                elsif matched \/ once then
                    running := false
                end
                if {pos >= n} \/ not(running) then running := false else pos := pos + 1 end
            end
            scratch.busy := false
            if matched then
                (* a copy, since a match keeps its slots and the scratch is
                 * reused *)
                let slots = array of(nslots ~1)
                for k = 0 upto {nslots - 1} do slots[k] := best[k] end
                maybe.some(:Array(Int) slots)
            else
                maybe.none(:Array(Int))
            end
            end
        end
end
