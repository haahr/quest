interface RegexpMatch
import
    prog = util/regexpProgram : util/RegexpProgram
    util/maybe : util/Maybe
export
    (* =========================================================================
     * Regular Expression Matching (RegexpMatch)
     *
     * A program (util/regexpProgram) run over a subject (docs/regexp.md
     * section 3.3): a literal search for a program that is one, a bounded
     * backtracker for a small program that records groups, and otherwise a
     * Pike VM, every thread the program could be in advanced together a
     * byte at a time; each is linear in the subject. util/regexp's, not for
     * programs to import.
     * ====================================================================== *)

    (* The leftmost-first match of p in s that begins at start or later (only
     * at start if anchored), and that ends at s's end if full. The bytes
     * before start are still seen by ^ and \b. The result is the match's
     * capture slots, 2 * (p.groups + 1) offsets, group i's start and end at 2i
     * and 2i + 1 (~1 for a group that took no part). If captures is false,
     * only whether there is a match is found, and its array is empty *)
    search(p: prog.Program s: String start: Int anchored: Bool full: Bool captures: Bool): maybe.T(Array(Int))
end
