(* Standard library: raised exceptions (docs/raised.md)

   The value an else branch's binder holds is made by the try itself; this
   module only names its type and raises it again. *)

module raised : Raised export
    (* The caught exception's state (see quest_raised_* in the runtime) *)
    Let T = external "QRaised *"

    let reraise(A::TYPE r: T): A = external "quest_raised_reraise"
end
