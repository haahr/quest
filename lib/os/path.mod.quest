(* Standard Library: Paths as Values Implementation *)

module path : Path
import
    strings = util/path : util/Path
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/stringBuilder : util/StringBuilder
    hashLib = util/hash : util/Hash
    os/fileStats : os/FileStats
    stringOp = string : StringOp
    word : Word
    reader : Reader
    writer : Writer
    system: System
export
    (* A T is its normalized string *)
    Let T = String

    let fromString(s: String): T =
        begin
            let absolute = strings.isAbsolute(s)
            let b = stringBuilder.new()
            if absolute then b.char('/') ok end
            let n = stringOp.length(s)
            let var start = 0
            let var count = 0
            for i = 0 upto n do
                if {i is n} orif {stringOp.getChar(s i) is '/'} then
                    let size = i - start
                    if {size > 0} andif not({size is 1} andif {stringOp.getChar(s start) is '.'}) then
                        if count > 0 then b.char('/') end
                        b.sub(s start size)
                        count := count + 1
                    end
                    start := i + 1
                end
            end
            if {count is 0} andif not(absolute) then "." else b.toString() end
        end

    let toString(p: T): String = p
    let equal(a: T b: T): Bool = stringOp.equal(a b)
    let hash(p: T): word.T = hashLib.string(p)

    let name(p: T): String =
        if stringOp.equal(p "/") orif stringOp.equal(p ".") then "" else strings.baseName(p) end

    let parent(p: T): T =
        if stringOp.equal(p "/") orif stringOp.equal(p ".") then p else fromString(strings.dirName(p)) end

    let suffix(p: T): String = strings.extension(name(p))
    let stem(p: T): String = strings.stem(name(p))

    let withSuffix(p: T newSuffix: String): T =
        if stringOp.length(name(p)) is 0 then raise strings.error end
        else fromString(strings.withExtension(p newSuffix)) end

    let parts(p: T): vector.T(String) =
        if stringOp.equal(p ".") then vector.new(:String) else strings.parts(p) end

    let child(p: T s: String): T = fromString(strings.join(p s))
    let join(p: T q: T): T = fromString(strings.join(p q))
    let isAbsolute(p: T): Bool = strings.isAbsolute(p)
    let normalize(p: T): T = fromString(strings.normalize(p))
    let relativeTo(p: T base: T): T = fromString(strings.relativeTo(p base))
    let resolve(p: T): T = fromString(strings.resolve(p))

    let exists(p: T): Bool = system.fileExists(p)
    let isFile(p: T): Bool = system.isFile(p)
    let isDir(p: T): Bool = system.isDirectory(p)
    let stat(p: T): fileStats.T = fileStats.stat(p)
    let find(p: T): maybe.T(fileStats.T) = fileStats.find(p)

    let iterDir(p: T): Array(T) =
        begin
            let names = system.listDirectory(p)
            let entries = array of(extent names p)
            for i = 0 upto {extent names - 1} do entries[i] := child(p names[i]) end
            entries
        end

    let mkdir(p: T parents: Bool): Ok =
        if exists(p) orif {not(parents) andif not(isDir(parent(p)))} then
            raise system.error end
        else
            system.makeDirectory(p)
        end

    let unlink(p: T): Ok = system.removeFile(p)
    let rename(p: T q: T): Ok = system.renameFile(p q)

    let readText(p: T): String =
        begin
            let r = reader.file(p)
            let b = stringBuilder.new()
            while reader.more(r) do b.str(reader.getString(r 65536)) end
            reader.close(r)
            b.toString()
        end

    let writeText(p: T text: String): Ok =
        begin
            let w = writer.file(p)
            writer.putString(w text)
            writer.close(w)
        end
end
