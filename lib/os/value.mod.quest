unsound module value : Value export
    (* A word, as C sees it (see quest_value_* in runtime/quest_code.c) *)
    Let T = external "void *"

    let error: Exception(Ok) = external "(&quest_exc_value_error)"
    let length = 8
    let new(A::TYPE a: A): T = external "quest_value_new"
    let be(A::TYPE v: T): A = external "quest_value_be"
    let fetch(addr: T displ: Int): T = external "quest_value_fetch"
    let store(addr: T displ: Int w: T): Ok = external "quest_value_store"
end
