(* Standard Library: the system's clocks (docs/time-plan.md section 2), each a
 * runtime function *)

unsound module time : Time
export
    let nowInNanoseconds(): Int = external "quest_time_now_ns"
    let ticks(): Int = external "quest_time_ticks_ns"
    let cpuTimeInNanoseconds(): Int = external "quest_time_cpu_ns"
    let sleepNanoseconds(nanoseconds: Int): Ok = external "quest_time_sleep_ns"
    let localOffsetInSeconds(secondsSinceEpoch: Int): Int = external "quest_time_local_offset"
end
