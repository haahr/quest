module process : Process export
    (* The native handle (see quest_process_* in the runtime) *)
    Let T = external "QProcess *"

    Let Result = Tuple code: Int stdout: String stderr: String end

    let spawn(args: Array(String)): T = external "quest_process_spawn"
    let spawnIn(args: Array(String) dir: String): T = external "quest_process_spawn_in"
    let pid(p: T): Int = external "quest_process_pid"
    let isDone(p: T): Bool = external "quest_process_is_done"
    let wait(p: T): Result = external "quest_process_wait"
    let waitAny(ps: Array(T)): Int = external "quest_process_wait_any"
    let kill(p: T sig: Int): Ok = external "quest_process_kill"
end
