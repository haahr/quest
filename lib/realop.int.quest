interface RealOp export
    (* Exception raised on real arithmetic errors *)
    error: Exception
    (* The most negative finite double-precision real number, maxReal negated
     * (not the smallest positive one) *)
    minReal: Real
    (* The largest finite double-precision real number *)
    maxReal: Real
    (* The gap between 1.0 and the next larger real, 2^-52 (C's DBL_EPSILON) *)
    posEpsilon: Real
    (* posEpsilon negated *)
    negEpsilon: Real
    (* Base of natural logarithms e *)
    e: Real
    (* Convert an integer to a real number *)
    int(n: Int): Real
    (* Largest integer not greater than real number r *)
    floor(r: Real): Int
    (* Nearest integer to real number r *)
    round(r: Real): Int
    (* Absolute value of a real number *)
    abs(r: Real): Real
    (* Natural logarithm of a real number *)
    log(r: Real): Real
    (* Minimum of two real numbers *)
    min(a: Real b: Real): Real
    (* Maximum of two real numbers *)
    max(a: Real b: Real): Real
    (* Addition of two real numbers *)
    plus(a: Real b: Real): Real
    (* Subtraction of two real numbers *)
    diff(a: Real b: Real): Real
    (* Multiplication of two real numbers *)
    mul(a: Real b: Real): Real
    (* Division of two real numbers *)
    div(a: Real b: Real): Real
    (* a raised to the power b (e raised to r is exponential(r)) *)
    exp(a: Real b: Real): Real
    (* Test if real number a is strictly less than b *)
    smaller(a: Real b: Real): Bool
    (* Test if real number a is strictly greater than b *)
    greater(a: Real b: Real): Bool
    (* Test if real number a is less than or equal to b *)
    smallerEq(a: Real b: Real): Bool
    (* Test if real number a is greater than or equal to b *)
    greaterEq(a: Real b: Real): Bool

    (* The extensions below are not in Typeful Programming's RealOp. As for the
     * operators, a result that would be NaN raises error. *)

    (* The ratio of a circle's circumference to its diameter *)
    pi: Real
    (* Positive infinity (negative infinity is 0.0 -- infinity) *)
    infinity: Real
    (* Square root; raises error if r is negative *)
    sqrt(r: Real): Real
    (* Trigonometric functions of an angle in radians *)
    sin(r: Real): Real
    cos(r: Real): Real
    tan(r: Real): Real
    (* Inverse trigonometric functions, in radians: asin and acos raise error
     * outside [~1, 1], and atan2(y x) is the angle of the point (x, y) *)
    asin(r: Real): Real
    acos(r: Real): Real
    atan(r: Real): Real
    atan2(y: Real x: Real): Real
    (* e raised to r (exp(a b) is a raised to b) *)
    exponential(r: Real): Real
    (* Hyperbolic functions *)
    sinh(r: Real): Real
    cosh(r: Real): Real
    tanh(r: Real): Real
    (* Smallest integer not less than r, and r rounded toward zero, as floor
     * raising error for an infinity or a value out of Int's range *)
    ceil(r: Real): Int
    trunc(r: Real): Int
    (* r as C's printf formats it with %.{digits}{style}: style 'e' (scientific),
     * 'f' (fixed), or 'g' (the shorter, with digits significant digits), and
     * negative numbers written with '-'; an infinity is "inf" or "-inf". Raises
     * error for another style, or for digits outside 0 to 100. *)
    format(r: Real style: Char digits: Int): String
end
