interface Dynamic
import
    reader: Reader
    writer: Writer
export
    (* A value packaged with its type (Cardelli, Typeful Programming §9.1). His appendix writes the component
       unnamed (Auto A::TYPE with :A end), but an unnamed component cannot be selected, so this follows §9.1 *)
    Def T = Auto A::TYPE with a: A end
    (* Exception raised by be on a type mismatch, and by copy, intern, and extern when they fail *)
    error: Exception
    (* Package a value of any type with its type *)
    new(A::TYPE a: A): T
    (* The value packaged in d, if its type is a subtype of A; otherwise raise error *)
    be(A::TYPE d: T): A
    (* Make a copy of a dynamic object *)
    copy(d: T): T
    (* Read a dynamic object from an input reader stream *)
    intern(rd: reader.T): T
    (* Write a representation of a dynamic object to an output writer stream *)
    extern(wr: writer.T d: T): Ok
end;
