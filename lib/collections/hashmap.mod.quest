(* Standard Library: Polymorphic Hash Map implementation
 *
 * Implements a compact, insertion-order preserving hash table using the Python
 * 3.6+ indexing scheme:
 * - A sparse power-of-two table of integers 'indices: Array(Int)' holding slot
 *   references:
 *     EMPTY = -1
 *     TOMBSTONE = -2
 *     >= 0: index into the dense parallel arrays.
 * - Dense parallel arrays 'keys', 'values', and 'hashes', filled in insertion
 *   order up to 'used', and 'deleted', which stays empty until the first
 *   delete.
 * - Perturbation recurrence for collision resolution:
 *     pert := pert >> 5
 *     i := (5 * i + 1 + pert) & mask
 *
 * The arrays are a table of their own, which a map makes on its first insert:
 * most maps a program makes stay empty (89% of the 23 million a build of the
 * compiler makes, docs/benchmarks.md section 28), and an empty map is then its
 * own tuple alone. The dense arrays hold denseCapacity(capacity) entries, 2/3
 * of the indices' capacity, as that is all they fill before the table grows.
 *
 * A deleted entry stays in the dense arrays, flagged in 'deleted', and its slot
 * in 'indices' becomes TOMBSTONE, so that a probe never reaches it. rebuild
 * drops deleted entries, keeping the rest in insertion order, and makes new
 * indices. It runs:
 *   in delete, at the same capacity, when deletedCount > 8 and
 *     deletedCount >= count;
 *   in insert, when the dense arrays are full: at the same capacity if
 *     deletedCount > count / 3, else at twice it.
 *)

module hashMap : HashMap
import
    util/hash : util/Hash
    util/maybe : util/Maybe
    collections/vector : collections/Vector
    iterLib = util/iter : util/Iter
    word: Word
export
    let emptySlot: Int = ~1
    let tombstoneSlot: Int = ~2
    let minCapacity: Int = 8

    Def Entry = Fun(K::TYPE V::TYPE) Tuple key: K value: V end

    (* A map's arrays, once it has had an entry *)
    Let Table = Fun(K::TYPE V::TYPE) Tuple
        var indices: Array(Int)
        var mask: word.T
        var keys: Array(K)
        var values: Array(V)
        var hashes: Array(word.T)
        (* Empty until the first delete, then as long as keys *)
        var deleted: Array(Bool)
        (* The dense entries in use, deleted ones included *)
        var used: Int
        var deletedCount: Int
    end

    Let State = Fun(K::TYPE V::TYPE) Option
        empty
        full with table: Table(K V) end
    end

    Let T = Fun(K::TYPE V::TYPE) Tuple
        var state: State(K V)
        var count: Int
        (* The indices' capacity the table starts at *)
        capacity: Int
        equal: All(k1: K k2: K) Bool
        hash: All(k: K) word.T
    end

    let error: Exception = exception error: Ok end

    let nextPowerOfTwo(n: Int): Int =
        begin
            let var p = minCapacity
            while p < n do
                p := p * 2
            end
            p
        end

    (* The dense entries a table of capacity indices holds: insert grows the
     * table when used * 3 >= capacity * 2, at ceiling(2 * capacity / 3) *)
    let denseCapacity(capacity: Int): Int = {{2 * capacity} + 2} / 3

    (* The next slot of a probe from slot i *)
    let nextSlot(i: Int pert: word.T mask: word.T): Int =
        word.toInt(word.andBits(word.add(word.add(word.mul(word.fromInt(5) word.fromInt(i)) word.fromInt(1)) pert) mask))

    (* A map that holds capacity entries before its table grows *)
    let newWithCapacity(K::TYPE V::TYPE)(capacity: Int equal: All(k1: K k2: K) Bool hash: All(k: K) word.T): T(K V) =
        tuple
            var state = option empty of State(K V) end
            var count = 0
            let capacity = nextPowerOfTwo(capacity + {capacity / 2} + 1)
            let equal = equal
            let hash = hash
        end

    let new(K::TYPE V::TYPE)(equal: All(k1: K k2: K) Bool hash: All(k: K) word.T): T(K V) =
        tuple
            var state = option empty of State(K V) end
            var count = 0
            let capacity = minCapacity
            let equal = equal
            let hash = hash
        end

    let newIdentityMap(K::TYPE V::TYPE): T(K V) =
        new(:K :V hash.identityEqual(:K) hash.identityHash(:K))

    let newIdentityMapWithCapacity(K::TYPE V::TYPE)(capacity: Int): T(K V) =
        newWithCapacity(:K :V capacity hash.identityEqual(:K) hash.identityHash(:K))

    let size(K::TYPE V::TYPE)(m: T(K V)): Int =
        m.count

    let empty(K::TYPE V::TYPE)(m: T(K V)): Bool =
        m.count is 0

    (* The dense index of key, whose hash is h, or emptySlot *)
    let findIndex(K::TYPE V::TYPE)(m: T(K V) t: Table(K V) key: K h: word.T): Int =
        begin
            let mask = t.mask
            let var i = word.toInt(word.andBits(h mask))
            let var pert = h
            let var result = emptySlot
            let var searching = true

            while searching do
                let slot = t.indices[i]
                if slot is emptySlot then
                    searching := false
                else
                    (* A tombstone matches nothing; a live slot's entry is
                     * never deleted *)
                    if {slot >= 0} andif {word.toInt(word.xorBits(t.hashes[slot] h)) is 0} andif m.equal(t.keys[slot] key) then
                        result := slot
                        searching := false
                    else
                        pert := word.shift(pert ~5)
                        i := nextSlot(i pert mask)
                    end
                end
            end
            result
        end

    let get(K::TYPE V::TYPE)(m: T(K V) key: K): maybe.T(V) =
        if m.state?full then
            let t = m.state!full.table
            let idx = findIndex(m t key m.hash(key))
            if idx >= 0 then
                maybe.some(t.values[idx])
            else
                maybe.none(:V)
            end
        else
            maybe.none(:V)
        end

    let contains(K::TYPE V::TYPE)(m: T(K V) key: K): Bool =
        if m.state?full then
            findIndex(m m.state!full.table key m.hash(key)) >= 0
        else
            false
        end

    let find(K::TYPE V::TYPE)(m: T(K V) key: K): V =
        if m.state?full then
            let t = m.state!full.table
            let idx = findIndex(m t key m.hash(key))
            if idx >= 0 then
                t.values[idx]
            else
                raise error end
            end
        else
            raise error end
        end

    (* Whether t's dense entry idx is live *)
    let live(K::TYPE V::TYPE)(t: Table(K V) idx: Int): Bool =
        if t.deletedCount is 0 then true else not(t.deleted[idx]) end

    (* Moves t's live entries, in insertion order, into dense arrays for
     * capacity indices, and makes the indices *)
    let rebuild(K::TYPE V::TYPE)(t: Table(K V) capacity: Int): Ok =
        begin
            let dense = denseCapacity(capacity)
            let keys = array of(dense t.keys[0])
            let values = array of(dense t.values[0])
            let hashes = array of(dense word.fromInt(0))
            let indices = array of(capacity emptySlot)
            let mask = word.fromInt(capacity - 1)
            let var n = 0
            for idx = 0 upto {t.used - 1} do
                if live(t idx) then
                    let h = t.hashes[idx]
                    keys[n] := t.keys[idx]
                    values[n] := t.values[idx]
                    hashes[n] := h
                    let var i = word.toInt(word.andBits(h mask))
                    let var pert = h
                    while not(indices[i] is emptySlot) do
                        pert := word.shift(pert ~5)
                        i := nextSlot(i pert mask)
                    end
                    indices[i] := n
                    n := n + 1
                end
            end
            t.indices := indices
            t.mask := mask
            t.keys := keys
            t.values := values
            t.hashes := hashes
            t.deleted := array of :Bool end
            t.used := n
            t.deletedCount := 0
            ok
        end

    (* A table of capacity indices holding key and value alone *)
    let first(K::TYPE V::TYPE)(capacity: Int key: K value: V h: word.T): Table(K V) =
        begin
            let mask = word.fromInt(capacity - 1)
            let indices = array of(capacity emptySlot)
            indices[word.toInt(word.andBits(h mask))] := 0
            let dense = denseCapacity(capacity)
            tuple
                var indices = indices
                var mask = mask
                var keys = array of(dense key)
                var values = array of(dense value)
                var hashes = array of(dense h)
                var deleted = array of :Bool end
                var used = 1
                var deletedCount = 0
            end
        end

    let insert(K::TYPE V::TYPE)(m: T(K V) key: K value: V): Bool =
        if m.state?full then
            let t = m.state!full.table
            let h = m.hash(key)
            let mask = t.mask
            let var i = word.toInt(word.andBits(h mask))
            let var pert = h
            let var existingIdx = emptySlot
            let var firstTombstone = emptySlot
            let var searching = true

            while searching do
                let slot = t.indices[i]
                if slot is emptySlot then
                    searching := false
                else
                    if slot is tombstoneSlot then
                        if firstTombstone is emptySlot then
                            firstTombstone := i
                        end
                    elsif {word.toInt(word.xorBits(t.hashes[slot] h)) is 0} andif m.equal(t.keys[slot] key) then
                        existingIdx := slot
                        searching := false
                    end
                    if searching then
                        pert := word.shift(pert ~5)
                        i := nextSlot(i pert mask)
                    end
                end
            end

            if existingIdx >= 0 then
                t.values[existingIdx] := value
                false
            else
                let targetSlot = if firstTombstone >= 0 then firstTombstone else i end
                let idx = t.used
                t.keys[idx] := key
                t.values[idx] := value
                t.hashes[idx] := h
                if t.deletedCount > 0 then
                    t.deleted[idx] := false
                end
                t.indices[targetSlot] := idx
                t.used := idx + 1
                m.count := m.count + 1

                (* 2/3 load factor threshold: used * 3 >= capacity * 2, when
                 * the dense arrays are full *)
                let capacity = extent t.indices
                if {t.used * 3} >= {capacity * 2} then
                    if t.deletedCount > {m.count / 3} then
                        rebuild(t capacity)
                    else
                        rebuild(t capacity * 2)
                    end
                end
                true
            end
        else
            m.state := option full of State(K V) with let table = first(m.capacity key value m.hash(key)) end
            m.count := 1
            true
        end

    let delete(K::TYPE V::TYPE)(m: T(K V) key: K): maybe.T(V) =
        if m.state?full then
            let t = m.state!full.table
            let h = m.hash(key)
            let mask = t.mask
            let var i = word.toInt(word.andBits(h mask))
            let var pert = h
            let var foundSlot = emptySlot
            let var denseIdx = emptySlot
            let var searching = true

            while searching do
                let slot = t.indices[i]
                if slot is emptySlot then
                    searching := false
                else
                    if {slot >= 0} andif {word.toInt(word.xorBits(t.hashes[slot] h)) is 0} andif m.equal(t.keys[slot] key) then
                        foundSlot := i
                        denseIdx := slot
                        searching := false
                    else
                        pert := word.shift(pert ~5)
                        i := nextSlot(i pert mask)
                    end
                end
            end

            if denseIdx >= 0 then
                let val = t.values[denseIdx]
                if t.deletedCount is 0 then
                    t.deleted := array of(extent t.keys false)
                end
                t.deleted[denseIdx] := true
                t.indices[foundSlot] := tombstoneSlot
                m.count := m.count - 1
                t.deletedCount := t.deletedCount + 1

                (* Periodic compaction if tombstones exceed active elements *)
                if {t.deletedCount > 8} /\ {t.deletedCount >= m.count} then
                    rebuild(t extent t.indices)
                end

                maybe.some(val)
            else
                maybe.none(:V)
            end
        else
            maybe.none(:V)
        end

    let clear(K::TYPE V::TYPE)(m: T(K V)): Ok =
        begin
            m.state := option empty of State(K V) end
            m.count := 0
            ok
        end

    let forEach(K::TYPE V::TYPE)(m: T(K V) action: All(k: K v: V) Ok): Ok =
        if m.state?full then
            let t = m.state!full.table
            for i = 0 upto {t.used - 1} do
                if live(t i) then
                    action(t.keys[i] t.values[i])
                end
            end
            ok
        else
            ok
        end

    let fold(K::TYPE V::TYPE Acc::TYPE)(m: T(K V) init: Acc f: All(acc: Acc k: K v: V) Acc): Acc =
        if m.state?full then
            let t = m.state!full.table
            let var acc: Acc = init
            for i = 0 upto {t.used - 1} do
                if live(t i) then
                    acc := f(acc t.keys[i] t.values[i])
                end
            end
            acc
        else
            init
        end

    let keys(K::TYPE V::TYPE)(m: T(K V)): vector.T(K) =
        begin
            let res = vector.newWithCapacity(:K m.count)
            forEach(m fun(k: K v: V): Ok vector.append(res k))
            res
        end

    let values(K::TYPE V::TYPE)(m: T(K V)): vector.T(V) =
        begin
            let res = vector.newWithCapacity(:V m.count)
            forEach(m fun(k: K v: V): Ok vector.append(res v))
            res
        end

    let entries(K::TYPE V::TYPE)(m: T(K V)): vector.T(Entry(K V)) =
        begin
            let res = vector.newWithCapacity(:Entry(K V) m.count)
            forEach(m fun(k: K v: V): Ok vector.append(res tuple let key = k let value = v end))
            res
        end

    let map(K::TYPE V::TYPE W::TYPE)(m: T(K V) f: All(k: K v: V) W): T(K W) =
        fold(:K :V :T(K W) m newWithCapacity(:K :W m.count m.equal m.hash)
            fun(acc: T(K W) k: K v: V): T(K W)
                begin
                    insert(:K :W acc k f(k v))
                    acc
                end)

    let filter(K::TYPE V::TYPE)(m: T(K V) pred: All(k: K v: V) Bool): T(K V) =
        fold(:K :V :T(K V) m newWithCapacity(:K :V m.count m.equal m.hash)
            fun(acc: T(K V) k: K v: V): T(K V)
                begin
                    if pred(k v) then
                        insert(:K :V acc k v)
                    end
                    acc
                end)

    let filterMap(K::TYPE V::TYPE W::TYPE)(m: T(K V) f: All(k: K v: V) maybe.T(W)): T(K W) =
        fold(:K :V :T(K W) m newWithCapacity(:K :W m.count m.equal m.hash)
            fun(acc: T(K W) k: K v: V): T(K W)
                begin
                    let opt: maybe.T(W) = f(k v)
                    if maybe.isSome(:W opt) then
                        insert(:K :W acc k maybe.unwrap(:W opt))
                    end
                    acc
                end)

    (* An iterator of read(t i) for each live entry i of m's table, in order.
     * Its position is the dense index c.i; more moves it past deleted
     * entries to a live one, if there is one, so that more stays idempotent
     * and next only reads and steps. It reads the table through a case
     * binder, the payload itself, where !full would copy it *)
    let walker(K::TYPE V::TYPE R::TYPE)(m: T(K V) read: All(t: Table(K V) i: Int) R): iterLib.T(R) =
        begin
            let c = tuple let var i = 0 end
            let ready(): Bool =
                case m.state
                    when full with x then
                        let t = x.table
                        while {c.i < t.used} andif not(live(:K :V t c.i)) do c.i := c.i + 1 end
                        c.i < t.used
                    when empty then false
                end
            iterLib.make(ready fun(): R
                if ready() then
                    case m.state
                        when full with x then
                            let r = read(x.table c.i)
                            c.i := c.i + 1
                            r
                        when empty then raise iterLib.exhausted end
                    end
                else
                    raise iterLib.exhausted end
                end)
        end

    let entryIter(K::TYPE V::TYPE)(m: T(K V)): iterLib.T(Entry(K V)) =
        walker(m fun(t: Table(K V) i: Int): Entry(K V) tuple let key = t.keys[i] let value = t.values[i] end)

    let keyIter(K::TYPE V::TYPE)(m: T(K V)): iterLib.T(K) = walker(m fun(t: Table(K V) i: Int): K t.keys[i])

    let valueIter(K::TYPE V::TYPE)(m: T(K V)): iterLib.T(V) = walker(m fun(t: Table(K V) i: Int): V t.values[i])

    let fromEntries(K::TYPE V::TYPE)(it: iterLib.T(Entry(K V)) equal: All(k1: K k2: K) Bool hash: All(k: K) word.T)
        : T(K V) =
        begin
            let m = new(:K :V equal hash)
            while iterLib.more(it) do
                let e = iterLib.next(it)
                insert(m e.key e.value)
            end
            m
        end
end
