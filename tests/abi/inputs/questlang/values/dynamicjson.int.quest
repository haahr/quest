(* Quest Self-Hosted Compiler: The Dynamic Format Interface
 *
 * bootstrap/python/quest/values/dynamic_json.py: serializing dynamic values
 * (dynamic.extern and dynamic.intern), format version 1 (docs/dynamic.md
 * section 2). A document holds a type table and a value:
 *
 *     {"quest":1,"types":[<type node>,...],"type":<type ref>,"value":<value>}
 *
 * The table is canonical, so that the interpreter and compiled code write the
 * same text for the same value: the writer builds the graph of the types it
 * meets, merges structurally equivalent nodes (the coarsest bisimulation), and
 * numbers the rest in the order a depth-first walk from the roots first reaches
 * them. Objects reached more than once are written once, with @id, and then as
 * {"@ref": n}. A failure raises dynamic.error.
 *
 * The bootstrap's parse_type_string, which only .qi files use, is
 * interfacecompiler.parseTypeString. *)

interface DynamicJson
import
    questlang/values/model : questlang/values/Model
export
    (* A dynamic value (an auto value of one component) as a version 1
     * document *)
    encode(d: model.Value): String
    (* A version 1 document's dynamic value *)
    decode(text: String): model.Value
end
