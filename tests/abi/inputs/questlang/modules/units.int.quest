(* Quest Self-Hosted Compiler: Unit Files Interface
 *
 * bootstrap/python/quest/modules/units.py: an interface file (.int.quest) holds
 * one interface declaration, and a module file (.mod.quest) one module
 * declaration (docs/modules.md). parseUnit reads a unit's source for the type
 * checker, as the driver's tokenize, parse, and desugar phases do. *)

interface Units
import
    questlang/common/location : questlang/common/Location
    questlang/syntax/ast : questlang/syntax/Ast
    util/maybe : util/Maybe
export
    Def UnitKind = Option interfaceUnit moduleUnit programUnit end
    (* The kind of the unit in a file, by its name *)
    unitKind(path: String): UnitKind

    (* The bootstrap's name for the class of a phrase, as its messages name
     * them *)
    phraseClassName(p: ast.Phrase): String

    (* Tokenizes, parses, and desugars a unit's source. A syntax error raises
     * diagnostics.compilerError. *)
    parseUnit(sm: location.SourceMap): ast.Program

    (* The declaration a unit file's program holds, which must be its only
     * phrase, of the file's kind *)
    Def Declaration = Option
        interfaceDecl with decl: ast.InterfaceDecl offset: Int end
        moduleDecl with decl: ast.ModuleDecl offset: Int end
    end
    unitDeclaration(prog: ast.Program path: String): Declaration
end
