(* Quest Self-Hosted Compiler: Well-Scopedness Check Interface
 *
 * The check of bootstrap/python/quest/typechecker/scoping.py that a typed
 * program is well scoped: every variable bound locally (a parameter, a block's
 * let, a for variable, a case, try, or inspect binder) is used only within its
 * binder's scope, a polymorphic function's type parameter ids are the
 * quantifiers of its own type, and a type mentioning a function's type
 * parameter occurs only inside that function. Symbols, not names, identify
 * binders, so this finds what the typed AST does not show. It runs after type
 * checking when QUEST_CHECK_SCOPES=1, which the test runners set. *)

interface Scoping
import
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
export
    (* A child of a node: an expression or a binding, in the order of the node's
     * fields *)
    Def Child = Option
        childExpr with e: typedAst.Expr end
        childBinding with b: typedAst.Binding end
    end
    (* The children of an expression, and of a binding *)
    children(e: typedAst.Expr): Array(Child)
    bindingChildren(b: typedAst.Binding): Array(Child)
    (* The let declarations of a binding *)
    letValues(b: typedAst.Binding): Array(typedAst.LetValue)

    scopeChecksEnabled(): Bool
    (* The scoping problems of a typed program (none when it is well scoped) *)
    checkWellScoped(p: typedAst.Program): Array(String)
end
