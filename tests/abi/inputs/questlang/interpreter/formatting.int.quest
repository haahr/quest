(* Quest Self-Hosted Compiler: Printing Values by Their Types Interface
 *
 * bootstrap/python/quest/interpreter/formatting.py: a value as its static type
 * shows it (Cardelli section 5.3), as compiled code prints it from the type's
 * descriptor, and a top-level phrase's result in interactive style. *)

interface Formatting
import
    tm = questlang/types/model : questlang/types/Model
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/values/model : questlang/values/Model
export
    (* A value as its type shows it: a record its type's fields, a function
     * <fun>, an abstract type's <hidden> *)
    formatValueWithType(v: model.Value t: tm.Type): String
    (* t with aliases removed, recursive types unfolded, and type operator
     * applications reduced *)
    exposedType(t: tm.Type): tm.Type
    (* A top-level phrase's result in Cardelli's interactive notation; empty for
     * an ok result or a declaration that shows nothing *)
    formatInteractiveResult(phrase: typedAst.Binding v: model.Value): String
end
