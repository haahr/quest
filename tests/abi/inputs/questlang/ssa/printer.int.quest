(* Quest Self-Hosted Compiler: The SSA's Printer Interface
 *
 * The SSA's textual form (docs/ssa.md section 6), which --stop-after ssa
 * prints and the ssa goldens hold, source positions on lines of their own
 * where they change *)

interface Printer
import
    questlang/ssa/nodes : questlang/ssa/Nodes
export
    formatFunction(f: nodes.Function): String
    formatUnit(u: nodes.Unit): String
end
