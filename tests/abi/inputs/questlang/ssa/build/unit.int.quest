(* Quest Self-Hosted Compiler: The SSA Builder's Unit Interface
 *
 * The unit: a function of the SSA for each IR function, the main routine or
 * a module's initializer, its static data (strings, descriptors, offset and
 * tag tables), and the registration of its tables; questlang/ssa/pipeline
 * runs the passes that follow. *)

interface Unit
import
    ir = questlang/ir/nodes : questlang/ir/Nodes
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export

    buildUnit(unit: ir.Unit): ssa.Unit
end
