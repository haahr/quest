(* Quest Self-Hosted Compiler: Canonical AST Pretty-Printer Interface *)

interface AstPrint
import
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/common/location : questlang/common/Location
    collections/vector : collections/Vector
    util/maybe : util/Maybe
export
    (* Formats an AST Node into a canonical 2-space indented S-expression string.
     * Matches the output of the Python bootstrap ast_dump exactly.
     *)
    dumpTypeExpr(node: ast.TypeExpr indent: Int showOffsets: Bool): String
    dumpExpr(node: ast.Expr indent: Int showOffsets: Bool): String
    dumpDecl(node: ast.Decl indent: Int showOffsets: Bool): String
    dumpPhrase(node: ast.Phrase indent: Int showOffsets: Bool): String
    dumpProgram(node: ast.Program indent: Int showOffsets: Bool): String

    (* Top-level convenience helpers *)
    dump(node: ast.Program): String
    dumpWithOptions(node: ast.Program showOffsets: Bool): String
end
