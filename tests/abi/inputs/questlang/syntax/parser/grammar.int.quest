(* Quest Self-Hosted Compiler: Quest Grammar Interface
 *
 * The grammar of bootstrap/python/quest/syntax/grammar.py, rule for rule and in
 * the same order, with the same syntax targets' names, which syntax errors
 * show. *)

interface Grammar
import
    questlang/syntax/parser/engine : questlang/syntax/parser/Engine
export
    (* The grammar's targets that parsing starts from *)
    Def T = Tuple
        g: engine.Grammar
        program: engine.Construct
        phrase: engine.Construct
        type: engine.Construct
        kind: engine.Construct
        value: engine.Construct
        signature: engine.Construct
    end

    (* The Quest grammar, built anew *)
    new(): T
end
