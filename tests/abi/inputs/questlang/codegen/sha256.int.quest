(* Quest Self-Hosted Compiler: SHA-256 Interface
 *
 * What bootstrap/python/quest/codegen/layout.py takes from Python's hashlib:
 * the SHA-256 digest of a text, in lowercase hexadecimal, as
 * hashlib.sha256(text.encode("utf-8")).hexdigest() gives it. A string's bytes
 * are characters as the bootstrap reads source text (one per byte), so a byte
 * above 127 is encoded as UTF-8 encodes that character, in two bytes. *)

interface Sha256
export
    hexDigest(text: String): String
end
