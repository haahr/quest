interface Path
import
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    os/fileStats : os/FileStats
    word : Word
export
    (* Exception raised on invalid path operations *)
    error: Exception

    (* ======================================================================
     * Path Constants & Separators
     * ====================================================================== *)

    (* Directory separator character '/' *)
    separator: Char

    (* Directory separator string "/" *)
    separatorString: String

    (* ======================================================================
     * Decomposition & Components
     * ====================================================================== *)

    (* Return the directory portion of a path.
     * Examples:
     *   dirName("/a/b/c.txt") => "/a/b"
     *   dirName("a/b")        => "a"
     *   dirName("a")          => "."
     *   dirName("/a")         => "/"
     *   dirName("/")          => "/"
     *)
    dirName(path: String): String

    (* Return the final component of a path.
     * Examples:
     *   baseName("/a/b/c.txt") => "c.txt"
     *   baseName("a/b/")       => "b"
     *   baseName("/")          => "/"
     *   baseName("")           => ""
     *)
    baseName(path: String): String

    (* Return the file extension including the leading dot, or empty string.
     * Examples:
     *   extension("foo.txt")        => ".txt"
     *   extension("archive.tar.gz") => ".gz"
     *   extension(".gitignore")     => ""
     *   extension("foo")            => ""
     *)
    extension(path: String): String

    (* Return the base filename without its final extension (stem).
     * Guaranteed: stem(p) <> extension(p) is baseName(p)
     * Examples:
     *   stem("foo.txt")        => "foo"
     *   stem("archive.tar.gz") => "archive.tar"
     *   stem(".gitignore")     => ".gitignore"
     *   stem("foo")            => "foo"
     *)
    stem(path: String): String

    (* Split path into its constituent component segments.
     * Consecutive separators are coalesced and empty segments dropped
     * (except leading "/" for root).
     * Examples:
     *   parts("/a/b/c") => ["/", "a", "b", "c"]
     *   parts("a/b/c")  => ["a", "b", "c"]
     *)
    parts(path: String): vector.T(String)

    (* ======================================================================
     * Composition & Joining
     * ====================================================================== *)

    (* Join two path components with a separator.
     * If part2 is absolute, part2 is returned.
     *)
    join(part1: String part2: String): String

    (* Join multiple path components from a Vector.
     * If an absolute component is encountered, previous components are
     * discarded.
     *)
    joinVector(items: vector.T(String)): String

    (* Join multiple path components from an Array *)
    joinArray(items: Array(String)): String

    (* Return path with its extension replaced or appended.
     * Accepts either "ext" or ".ext" equivalently.
     * If newExt is empty (""), removes existing extension.
     *)
    withExtension(path: String newExt: String): String

    (* ======================================================================
     * Inspection & Predicates
     * ====================================================================== *)

    (* Test whether path starts with '/' *)
    isAbsolute(path: String): Bool

    (* Test whether path does not start with '/' *)
    isRelative(path: String): Bool

    (* Test whether path has a non-empty extension *)
    hasExtension(path: String): Bool

    (* ======================================================================
     * Normalization & Relationships
     * ====================================================================== *)

    (* Normalize path by collapsing redundant '/' and resolving '.' and '..'
     * segments. Pure lexical normalization; does not access the filesystem.
     * Examples:
     *   normalize("a//b/./c/../d") => "a/b/d"
     *   normalize("/../a")         => "/a"
     *   normalize("")              => "."
     *)
    normalize(path: String): String

    (* Compute path relative to a given base directory.
     * Raises error if one path is absolute and the other relative.
     * Examples:
     *   relativeTo("/a/b/c" "/a") => "b/c"
     *   relativeTo("/a/b" "/a/c") => "../b"
     *)
    relativeTo(path: String base: String): String

    (* Make path absolute relative to cwd if relative, and normalize.
     * Uses system.currentDirectory() when relative.
     *)
    resolve(path: String): String

    (* ======================================================================
     * Paths as Values (T)
     *
     * A T is a path normalized as Python's PurePath normalizes one: repeated
     * separators collapse, and "." components and a trailing separator are
     * dropped, but ".." components stay, since cancelling them needs the
     * file system (normalizePath cancels them lexically). So two paths that
     * name the same way are equal strings, and equal and hash make T a
     * hashMap key. The String functions above are unchanged; the functions
     * over T have names of their own.
     * ====================================================================== *)

    T::TYPE

    (* The path that s spells, normalized.
     * Examples:
     *   toString(fromString("a//b/./c/")) => "a/b/c"
     *   toString(fromString("./a/../b"))  => "a/../b"
     *   toString(fromString(""))          => "."
     *)
    fromString(s: String): T

    (* The path as a string *)
    toString(p: T): String

    equal(a: T b: T): Bool
    hash(p: T): word.T

    (* The final component, or "" for "/" and "." *)
    name(p: T): String

    (* The path without its final component.
     * Examples:
     *   parent(fromString("/a/b")) => "/a"
     *   parent(fromString("a"))    => "."
     *   parent(fromString("/"))    => "/"
     *)
    parent(p: T): T

    (* The final component's extension, including its dot, as extension *)
    suffix(p: T): String

    (* The final component without its extension, as stem *)
    pathStem(p: T): String

    (* The path with its final component's extension replaced, as
     * withExtension does; raises error if the path has no final component *)
    withSuffix(p: T newSuffix: String): T

    (* The components, with "/" first for an absolute path, as parts *)
    pathParts(p: T): vector.T(String)

    (* p with s appended (s itself if it is absolute) *)
    child(p: T s: String): T

    (* q relative to p (q itself if it is absolute) *)
    joinPaths(p: T q: T): T

    pathIsAbsolute(p: T): Bool

    (* The path with ".." components cancelled lexically, as normalize *)
    normalizePath(p: T): T

    (* The path relative to base, as relativeTo; raises error if one is
     * absolute and the other relative *)
    pathRelativeTo(p: T base: T): T

    (* The path made absolute against the current directory, as resolve *)
    resolvePath(p: T): T

    (* ======================================================================
     * The File System, over T
     * ====================================================================== *)

    (* Whether the path names anything (following symlinks) *)
    exists(p: T): Bool

    (* Whether the path names a regular file (following symlinks) *)
    isFile(p: T): Bool

    (* Whether the path names a directory (following symlinks) *)
    isDir(p: T): Bool

    (* What fileStats.stat and fileStats.find say about the path *)
    stat(p: T): fileStats.T
    find(p: T): maybe.T(fileStats.T)

    (* The entries of a directory, as children of p, sorted by name; raises
     * system.error if p is not a directory *)
    iterDir(p: T): Array(T)

    (* Create the directory p, and with parents its missing parents too;
     * raises system.error if p exists, or if without parents its parent is
     * not a directory *)
    mkdir(p: T parents: Bool): Ok

    (* Remove the file p; raises system.error if there is none *)
    unlink(p: T): Ok

    (* Rename p to q *)
    rename(p: T q: T): Ok

    (* The text of the file p; raises what reader.file and reader.getString
     * raise if it cannot be read *)
    readText(p: T): String

    (* Write text to the file p, replacing what it held; raises what
     * writer.file and writer.putString raise if it cannot be written *)
    writeText(p: T text: String): Ok
end
