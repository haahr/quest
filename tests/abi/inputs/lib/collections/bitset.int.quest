interface Bitset
import
    word: Word
export
    (* A set of the integers 0 to size - 1, its size fixed when it is made, a
     * bit for each, 64 to a word *)
    T::TYPE

    (* Raised by an integer outside a set's range, a negative size, and an
     * operation on two sets of different sizes *)
    error: Exception

    (* A new empty set of the integers 0 to size - 1 *)
    new(size: Int): T

    (* The number of integers a set may hold (its size, not its count) *)
    size(s: T): Int

    (* Whether i is in s *)
    contains(s: T i: Int): Bool

    (* Adds i to s; whether it was not there *)
    insert(s: T i: Int): Bool

    (* Takes i out of s; whether it was there *)
    remove(s: T i: Int): Bool

    (* Takes every integer out of s *)
    clear(s: T): Ok

    (* The number of integers in s *)
    count(s: T): Int

    (* Whether s holds no integer *)
    isEmpty(s: T): Bool

    (* A new set holding what s holds *)
    copy(s: T): T

    (* Makes s hold what t holds *)
    assign(s: T t: T): Ok

    (* Adds to s every integer of t; whether s changed. A dataflow analysis
     * iterates until no union changes a set. *)
    unionWith(s: T t: T): Bool

    (* Keeps in s only the integers t holds too; whether s changed *)
    intersectWith(s: T t: T): Bool

    (* Takes out of s every integer of t; whether s changed *)
    subtract(s: T t: T): Bool

    (* Whether s and t hold the same integers *)
    equal(s: T t: T): Bool

    (* Whether every integer of s is in t *)
    isSubset(s: T t: T): Bool

    (* The least integer of s that is at least from, or ~1 if there is none: s's
     * integers in order are next(s 0), then next(s i + 1) after each i *)
    next(s: T from: Int): Int

    (* The integers of s, in increasing order *)
    elements(s: T): Array(Int)
end
