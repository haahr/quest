{
  "@type": "Record abi: Int imports: Array(String) name: String producer: String types: Array(Record isManifest: Bool kind: String manifestType: String name: String end) values: Array(Record isPoly: Bool name: String typeSig: String end) end",
  "@value": {
    "imports": [
      "location=questlang/common/location:questlang/common/Location",
      "diagbag=questlang/common/diagbag:questlang/common/DiagBag",
      "tokens=questlang/syntax/tokens:questlang/syntax/Tokens",
      "vector=collections/vector:collections/Vector"
    ],
    "name": "Tokenizer",
    "types": [
      {
        "isManifest": false,
        "kind": "TYPE",
        "manifestType": "",
        "name": "T"
      }
    ],
    "values": [
      {
        "isPoly": false,
        "name": "new",
        "typeSig": "All(sm: location.SourceMap bag: diagbag.T) T"
      },
      {
        "isPoly": false,
        "name": "nextToken",
        "typeSig": "All(tok: T) tokens.Token"
      },
      {
        "isPoly": false,
        "name": "peekToken",
        "typeSig": "All(tok: T) tokens.Token"
      },
      {
        "isPoly": false,
        "name": "tokenizeAll",
        "typeSig": "All(tok: T) vector.T(tokens.Token)"
      },
      {
        "isPoly": false,
        "name": "formatDump",
        "typeSig": "All(tokensList: vector.T(tokens.Token) sm: location.SourceMap showValues: Bool) String"
      }
    ]
  }
}
