(* A document whose record gives a field twice, in its type and its value, is
 * refused: every reader raises dynamic.error (docs/dynamic.md section 2.1).
 * The library raises it, at no line of the program, so the error is matched
 * by tests/golden/errors/run/dynamic_repeated_field.error. *)
(* @stdin:
{"quest":1,"types":[{"record":{"a":"Int","a":"Int"}}],"type":0,"value":{"a":1,"a":2}}
*)
import reader: Reader;
import dynamic: Dynamic;
dynamic.intern(reader.input)
