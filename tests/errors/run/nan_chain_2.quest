(* A NaN made by the second operation of a chain raises real.error at that operation, though the SSA checks only
   the chain's last value (questlang/ssa/passes/nanChecks) *)
import real : RealOp;
let inputs = tuple let var a = 1.0 let var b = real.infinity let var c = {0.0 -- real.infinity} end;
let chain(a: Real b: Real c: Real): Real =
    begin
        let x = a ** b
        let y = x ++ c (* ERROR: Exception: real.error *)
        let z = y -- a
        z ** 2.0
    end;
chain(inputs.a inputs.b inputs.c);
