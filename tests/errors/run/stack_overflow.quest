(* The interpreters locate stack.overflow at the call that would have gone too deep; the IR interpreters' calls have
   no offsets, and compiled code reports it without a site (docs/exceptions.md section 6) *)
(* @skip-phase: run_ir_core, run_ir_specialized, run_ir_closed, run_ir_represented, run_ir_described, run_c_compiled *)
let rec down(n: Int): Int = 1 + down(n + 1); (* ERROR: Exception: stack.overflow *)
down(0);
