(* A conversion compiled code rejects is a compile-time error, reported in the
 * module where it is needed (rejectedlayout.mod.quest); the interpreters, the
 * IR's included, lay nothing out and run the program, and a whole program,
 * whose modules' abstract types are transparent, makes no conversion *)
(* @skip-phase: interpret, run_ir_core, run_ir_simplified, run_ir_specialized, run_ir_closed, run_ir_represented, run_ir_described, whole *)
import rejectedLayout: RejectedLayout;
rejectedLayout.first(:Bool rejectedLayout.bools)
