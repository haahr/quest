(* A dynamic value cannot record an abstract type of a package value: its identity is not known at run time. *)
import dynamic: Dynamic;
Let T = Tuple A::TYPE a: A end;
let t: T = tuple Let A::TYPE = Int let a = 0 end;
let d = dynamic.new(:t.A t.a); (* ERROR: type of a dynamic value cannot mention t\.A.*package value *)
