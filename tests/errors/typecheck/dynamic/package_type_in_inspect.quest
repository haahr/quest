(* The types of inspect branches on a Dynamic cannot be abstract types of package values. *)
import dynamic: Dynamic;
Let T = Tuple A::TYPE a: A end;
let t: T = tuple Let A::TYPE = Int let a = 0 end;
let n: Int =
    inspect dynamic.new(:Int 3)
    when Tuple x: t.A end with y then 1 (* ERROR: inspect when clause cannot mention t\.A *)
    else 0
    end;
