(* A polymorphic function is a subtype of one whose type parameters have stronger bounds, not weaker ones *)
Let P = Record a: Int end;
Let Q = Record a: Int b: Int end;
let f(X <: Q x: X): Int = x.b;
let g: All(X <: P x: X) Int = f; (* ERROR: is not a subtype of expected type 'All\(X <: P\) Fun\(x: X\): Int' *)
