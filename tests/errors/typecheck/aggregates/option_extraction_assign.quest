(* o!made is a new tuple, so assigning one of its components would change only
   a copy: a case binder is the way to change the payload *)
let o = option made of Option none made with var x: Int end end with let var x = 1 end;
o!made.x := 2; (* ERROR: Cannot assign to a component of 'o!made', which is a copy: use a case binder (when made with c then c.x := ...) *)
