(* A branch naming several tags gives its binder one type, so without a
   declared type the tags' payloads must be equal: x.side would not exist when
   s is a circle. *)
Let Shape = Option square with side: Int end circle with r: Int end end;
let s = option circle of Shape with 2 end;
let bad = case s
    when square, circle with x then x.side
end;
