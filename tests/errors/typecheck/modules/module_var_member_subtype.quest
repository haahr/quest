(* A var member is written through its interface as well as read, so the
 * module's var must have the interface's type itself, not a subtype. *)
interface C export var p: Record a: Int end end

module c : C export  (* ERROR: Var 'p' in module 'c' has type .*, not its interface's type *)
    let var p = record a = 1 b = 2 end
end
