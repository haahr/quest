(* A parameter declared with the interface's type, Iter.T, which no value has: the call that passes the module's
 * type, iter.T, fails, and the help names the declaration's mistake. *)

import collections/vector : collections/Vector
import util/iter : util/Iter
let sum(it: Iter.T(Int)): Int = 0
let v = vector.new(:Int)
let s = sum(vector.iter(v)) (* ERROR: 'Iter.T' is the interface Iter's own type, which no value has; where it is declared, write iter.T *)
