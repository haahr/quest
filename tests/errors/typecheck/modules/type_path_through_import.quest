(* A type path cannot reach through a module to what the module imports:
   util/hash imports word, but a module's scope holds only its exports, so
   hash.word.T names nothing. (The bootstrap's typechecker once crashed here,
   looking the middle part up as a module in the module's scope.) *)

import util/hash : util/Hash
let h(n: Int): hash.word.T = hash.int(n); (* ERROR: Undefined module/interface 'word' in type path 'hash.word.T' *)
