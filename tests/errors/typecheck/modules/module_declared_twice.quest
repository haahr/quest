(* A second module of one name is an error, whatever its interface: the two
 * would be one unit, with one export scope and one record. The first stays
 * declared, so a later use of the name is typed by it. *)
interface A export x: Int end
module m : A export let x = 1 end
interface B export x: String end
module m : B export let x = "hi" end  (* ERROR: Module 'm' is declared more than once *)
m.x + 1
