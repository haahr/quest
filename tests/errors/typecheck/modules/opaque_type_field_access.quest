(* A client cannot see the representation of a module's abstract type, so it cannot select its fields. *)
interface IntStack export
    Stack::TYPE
    empty: Stack
end;

module intStack : IntStack export
    Let Stack = Tuple
        items: Array(Int)
        top: Int
    end;
    let empty = tuple
        let items = array of(10 0)
        let top = 0
    end;
end;

intStack.empty.items; (* ERROR: Cannot select field 'items' from non-record/tuple type 'intStack.Stack' *)
