(* The interface's type inside a type argument: the help finds it there. *)

import collections/vector : collections/Vector
import util/iter : util/Iter
let first(v: vector.T(Iter.T(Int))): Int = 0
let w = vector.new(:iter.T(Int))
let n = first(w) (* ERROR: 'Iter.T' is the interface Iter's own type *)
