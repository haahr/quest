(* An interface's name where its module's is meant: the help names the module. *)

import collections/vector : collections/Vector
import util/iter : util/Iter
let v = vector.new(:Int)
let it = Iter.map(vector.iter(v) fun(x: Int): Int x + 1) (* ERROR: 'Iter' is an interface; the module is imported as 'iter' *)
