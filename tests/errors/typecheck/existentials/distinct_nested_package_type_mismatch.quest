(* Two packages reached through different fields of one value have distinct abstract types: x.y.A != x.z.A, though
   both paths start at x and end in A. *)
Let P = Tuple A::TYPE v: A end;
let x = tuple
    let y: P = tuple Let A = Int let v = 1 end
    let z: P = tuple Let A = String let v = "s" end
end;
let bad(a: x.y.A): x.z.A = a; (* ERROR: synthesized type 'x.y.A' is not a subtype of expected type 'x.z.A' *)
