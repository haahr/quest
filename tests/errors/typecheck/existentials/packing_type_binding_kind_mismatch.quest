(* A tuple's type component must have the kind of the abstract component it is
 * viewed as, whatever that kind: a proper type, Int, is no type operator. *)
let p = tuple Let F = Int let v = 3 end
let q: Tuple F::ALL(A::TYPE) TYPE v: Int end = p  (* ERROR: Type mismatch: synthesized type 'Tuple Let F::TYPE = Int v: Int end' is not a subtype of expected type 'Tuple F::ALL\(A :: TYPE\) TYPE v: Int end' *)
