(* A function's type parameter may have a weaker bound than its expected type gives it, not a stronger one *)
Let P = Record a: Int end;
Let Q = Record a: Int b: Int end;
let f: All(X <: P x: X) Int = fun(X <: Q x: X): Int x.b; (* ERROR: Type parameter 'X' is declared 'X <: Q', which does not include the expected 'X <: P' *)
