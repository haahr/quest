(* A variant is not a subtype of a variant with fewer cases (Cardelli §6.3): Day has cases WeekDay lacks. *)
Let Day = Variant mon, tue, wed, thu, fri, sat, sun:Ok end;
Let WeekDay = Variant mon, tue, wed, thu, fri:Ok end;
let d = variant mon of Day with ok end;
let w: WeekDay = d; (* ERROR: 'Day' is not a subtype of expected type 'WeekDay' *)
