(* Variants with disjoint cases are not subtypes of each other. *)
Let WeekDay = Variant mon, tue, wed, thu, fri:Ok end;
Let WeekendDay = Variant sat, sun:Ok end;
let w = variant mon of WeekDay with ok end;
let e: WeekendDay = w; (* ERROR: 'WeekDay' is not a subtype of expected type 'WeekendDay' *)
