(* The type component of an auto value may mention type parameters of enclosing functions, but not yet a bounded
   one inside mutable data, whose values generic code holds viewed at the bound and could convert only by
   copying. *)
Let Boxed = Auto A::TYPE with a:A end;
let box(A <: Record a: Int end x:A):Boxed = auto :Tuple var y: A end with tuple let var y = x end end; (* ERROR: cannot yet mention a bounded type parameter.*inside mutable data.*A *)
