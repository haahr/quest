(* The types in inspect when clauses may mention type parameters of enclosing functions, but not yet inside mutable
   data, whose values laid out generically could only be converted by copying. *)
Let Boxed = Auto A::TYPE with a:A end;
let isA(A::TYPE b:Boxed): Bool =
    inspect b
    when Array(Tuple y: A end) with x then true (* ERROR: cannot yet mention a type parameter.*inside mutable data.*A *)
    else false
    end;
