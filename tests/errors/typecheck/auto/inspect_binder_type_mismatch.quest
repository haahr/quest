(* An inspect binder's declared type must be a supertype of the branch's components. *)
Let Boxed = Auto A::TYPE with a:A end;
let b: Boxed = auto :Int with 3 end;
let n: Int =
    inspect b
    when Int with x: Tuple a:Bool end then 1 (* ERROR: Inspect binder 'x'.*not a subtype of the declared type *)
    else 0
    end;
