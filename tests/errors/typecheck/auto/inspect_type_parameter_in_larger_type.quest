(* The types in inspect when clauses may be type parameters of enclosing functions, but not yet larger types that
   mention them. *)
Let Boxed = Auto A::TYPE with a:A end;
let isA(A::TYPE b:Boxed): Bool =
    inspect b
    when Tuple y: A end with x then true (* ERROR: cannot yet mention one inside a larger type.*A *)
    else false
    end;
