(* The type component of an auto value whose auto type has var components may be a type parameter of an enclosing
   function, but not yet a larger type that mentions one: the binders of an inspect share the var components, so
   the components cannot be converted from the generic layout. *)
Let Cell = Auto A::TYPE with var a:A end;
let cell(A::TYPE x:A):Cell = auto :Tuple y: A end with tuple x end end; (* ERROR: cannot yet mention a type parameter.*var components.*A *)
