(* The type component of an auto value may mention type parameters of enclosing functions, but not yet inside
   mutable data, whose values laid out generically could only be converted by copying. *)
Let Boxed = Auto A::TYPE with a:A end;
let box(A::TYPE x:A):Boxed = auto :Tuple var y: A end with tuple x end end; (* ERROR: cannot yet mention a type parameter.*inside mutable data.*A *)
