(* An auto type operator's kind bound is substituted when it is applied:
 * Box(Int) is Auto A <: Int with a: A end, which is no Box(String), so its
 * value may not be inspected as a string. *)
Let Box(X::TYPE) = Auto A <: X with a: A end
let bi: Box(Int) = auto :Int with 42 end
let bs: Box(String) = bi  (* ERROR: Type mismatch: synthesized type 'Box\(Int\)' is not a subtype of expected type 'Box\(String\)' *)
