(* The type argument of dynamic.new may mention type parameters of enclosing functions, but not yet a bounded one
   inside mutable data: generic code holds its values viewed at the bound, and converting them would copy. *)
import dynamic: Dynamic;
let pack(A <: Record a: Int end x:A): Dynamic = dynamic.new(:Array(A) array of(1 x)); (* ERROR: cannot yet mention a bounded type parameter.*inside mutable data.*A *)
