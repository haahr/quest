(* The types in inspect when clauses may mention type parameters of enclosing functions, but not yet a bounded one
   inside mutable data, whose values generic code holds viewed at the bound and could convert only by copying. *)
Let Boxed = Auto A::TYPE with a:A end;
let isA(A <: Record a: Int end b:Boxed): Bool =
    inspect b
    when Array(Tuple y: A end) with x then true (* ERROR: cannot yet mention a bounded type parameter.*inside mutable data.*A *)
    else false
    end;
