(* An abstract type operator does not guard its arguments: F may be the
 * identity, Fun(A::TYPE) A, which would make Rec(T::TYPE) F(T) the bare
 * Rec(T::TYPE) T, and checking the call below would never finish. *)
let f(F::ALL(A::TYPE) TYPE x: Rec(T::TYPE) F(T)): Int = 0  (* ERROR: Recursive type 'T' is not contractive *)
f(:Fun(A::TYPE) A 5)
