(* Subtyping between All types with contravariant bounds is undecidable (Pierce, Bounded quantification is
   undecidable): checking T <: All(X0 <: T) All(W <: X0) W unfolds without end. The check runs out of fuel after a
   few levels of bounds and fails as not a subtype *)
Let T = All(X0::TYPE) All(Y <: All(X1 <: X0) All(Z <: X1) Z) Y;
let k(f: T): All(X0 <: T) All(W <: X0) W = f; (* ERROR: synthesized type 'T' is not a subtype of expected type *)
