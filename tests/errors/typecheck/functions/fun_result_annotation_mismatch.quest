(* A function's result type annotation must be a subtype of the result type it is checked against *)
Let P = Record a: Int end;
Let Q = Record a: Int b: Int end;
let good: All(x: Int) P = fun(x: Int): Q record a = x b = x end;
let h: All(x: Int) Q = fun(x: Int): P record a = x end; (* ERROR: Function declared result type 'P' is not a subtype of expected result type 'Q' *)
