(* An argument to an out parameter is a location, passed with @. *)
Let Dog = Record name: String breed: String end;
let getDog(out x: Dog): Ok = x := record name = "Fido" breed = "Terrier" end;
let var pet: Dog = record name = "Rex" breed = "Collie" end;
getDog(@pet);
getDog(pet); (* ERROR: Argument to 'out' parameter must be passed with '@' *)
