(* A function checked against a function type must accept every argument the type promises: each parameter's
   annotation must include the expected parameter type *)
Let P = Record a: Int end;
Let Q = Record a: Int b: Int end;
let good: All(q: Q) Int = fun(p: P): Int p.a;
let f: All(x: Int) Int = fun(x: Bool): Int 3; (* ERROR: Parameter 'x' declared type 'Bool' is not a supertype of expected parameter type 'Int' *)
f(3);
