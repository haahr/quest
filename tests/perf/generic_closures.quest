(* Benchmark: closures over tuples passed through polymorphic functions, adapted by thunks *)
import writer: Writer;
import conv: Conv;
Let Box = Fun(A::TYPE) Tuple x: A end;
let applyTo(A::TYPE f: All(b: Box(A)) A b: Box(A)): A = f(b);
let isSet(b: Box(Bool)): Bool = b.x;
let var total = 0;
for i = 1 upto 20000000 do
    let b: Box(Bool) = tuple let x = {i % 3} is 0 end
    if applyTo(:Bool isSet b) then total := total + 1 end
end;
writer.putString(writer.output conv.int(total) <> "\n")
