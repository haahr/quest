(* Benchmark: tuples of records through an unspecialized polymorphic function, converted by copying at every call *)
import writer: Writer;
import conv: Conv;
Let P = Record a: Int end;
let id(A::TYPE t: Tuple x: A end): Tuple x: A end = t;
let idF: All(A::TYPE t: Tuple x: A end) Tuple x: A end = id;
let var total = 0;
for i = 1 upto 5000000 do
    let t: Tuple x: P end = tuple let x = record a = i % 5 end end;
    total := total + idF(:P t).x.a
end;
writer.putString(writer.output conv.int(total) <> "\n")
