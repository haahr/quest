(* Benchmark: a generic list built and folded by polymorphic functions at Int: casts at every call *)
import writer: Writer;
import conv: Conv;
Let Rec List(A::TYPE) = Option nil cons with head: A tail: List(A) end end;
let cons(A::TYPE h: A t: List(A)): List(A) = option cons of List(A) with let head = h let tail = t end;
let nil(A::TYPE): List(A) = option nil of List(A) end;
let fold(A::TYPE l: List(A) f: All(acc: Int x: A) Int): Int =
    begin
        let var rest = l
        let var acc = 0
        while rest?cons do
            acc := f(acc rest!cons.head)
            rest := rest!cons.tail
        end
        acc
    end;
let var total = 0;
for round = 1 upto 100 do
    let var xs: List(Int) = nil(:Int)
    for i = 1 upto 100000 do xs := cons(:Int i xs) end
    total := total + fold(:Int xs fun(acc: Int x: Int): Int acc + {x % 7})
end;
writer.putString(writer.output conv.int(total) <> "\n")
