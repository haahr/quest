(* Exceptions earlier inputs declare or bind, raised and caught in later ones; a let's exception's own name only labels it *)
exception declared: Int end let held = exception label: Int end
let f(n: Int): Int = if n > 0 then n else raise declared with n end end
try f(~2) when declared with n then n * 10 end
try raise held with 4 as Int end when held with n then n + 1 end
raise label with 1 end
