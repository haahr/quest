(* A phrase continues while a line leaves it incomplete: an open block, a trailing operator, an unclosed comment or
   string *)
let add(x: Int y: Int): Int =
    x + y
add(4 6)
if true then
    100
else
    200
end
let rec fib(n: Int): Int =
    if n <= 1 then
        n
    else
        fib(n - 1) + fib(n - 2)
    end
fib(10)
let total = 1 +
    2
(* a comment
   on two lines *) total
"a string
on two lines"
let total2 = total
+ 1
