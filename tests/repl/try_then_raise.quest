(* An input that binds a try's value and then raises: the try's block after it is reached by nothing, both its arms
   going to the join after the binding, so the JIT's module initializer must not read the input's record there, whose
   let follows the raise (it reported "a use of variable qj_2_record, which nothing binds") *)
exception Bad end
let r = try 5 when Bad then 0 end; raise Bad end
let s = try 6 when Bad then 1 end
s
