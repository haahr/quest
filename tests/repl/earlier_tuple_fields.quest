(* A tuple bound by one input, its fields read and assigned by later ones: a
   field of an earlier input's binding, not a member of a module *)
let kept = tuple let n = 5 let var dir = "" let inner = tuple let m = 6 end end
kept.n
kept.inner.m
let f = fun(d: String): Ok kept.dir := d
f("abc")
kept.dir
kept.dir := "xy"
kept.dir
