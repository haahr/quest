(* One phrase per line, with and without semicolons, several on a line, and silent ok phrases *)
let a = 10
let b = 20;
a + b
let x = 1; let y = 2; x + y;
let var count = 0
count := 5
count
ok

(* A group of bindings shows one per line *)
let p = 1 and q = "two"
Let A = Int and B = String
tuple let i = 1 let s = "abc" let t = true end
