(* An input that fails after redefining leaves the redefinitions, as it leaves an assignment *)
let a = 1
let b = 2
let sum(): Int = a + b
let a = 10; let b = 20; 1 / 0
sum()
let var v = 1
let var v = 5; 1 / 0
v
v := 6; 1 / 0
v
let f(): Int = 1
let callF(): Int = f()
let k = 5; let f(): Int = k + 1; 1 / 0
callF()
k
