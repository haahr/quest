(* A raised exception kept in a top-level variable is shown as <hidden>, and is raised again, from where it was first
   raised, in a later input *)
import raised: Raised
exception Fail : Int end
let r = try raise Fail with 3 as raised.T end else with e then e end
try raised.reraise(:Int r) when Fail with n then n + 1 end
raised.reraise(:Int r)
