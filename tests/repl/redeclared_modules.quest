(* A module declared again in a later input has its own interface; within one input it is an error *)
interface A export x: Int end
module m : A export let x = 1 end
interface B export x: String end
module m : B export let x = "hi" end
m.x
module k : A export let x = 1 end module k : B export let x = "no" end
k.x + 1
