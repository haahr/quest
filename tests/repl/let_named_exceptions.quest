(* An exception a let's value makes binds its own name as well as the let's, for later inputs to raise and catch *)
let error = exception error: Ok end let failed = exception error: Int end
let f(n: Int): Int = if n > 0 then n else raise error with n end end
try f(~2) when error with n then n * 10 end
try raise failed with 4 as Int end when error with n then n + 1 end
