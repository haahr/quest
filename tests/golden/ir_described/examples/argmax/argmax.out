main {
  let empty: Exception = exception empty
  let argmax.1: All(E :: TYPE K :: TYPE) Fun(a: Array(E) key: Fun(e: E): K isGreater: Fun(x: K y: K): Bool): Tuple index: Int element: E end = closure argmax {}
  let argmax_spec.2: Fun(a: Array(String) key: Fun(e: String): Int isGreater: Fun(x: Int y: Int): Bool): Tuple index: Int element: String end = closure argmax_spec {}
  let argmax_spec.3: Fun(a: Array(Tuple name: String years: Int rating: Real end) key: Fun(e: Tuple name: String years: Int rating: Real end): Real isGreater: Fun(x: Real y: Real): Bool): Tuple index: Int element: Tuple name: String years: Int rating: Real end end = closure argmax_spec.1 {}
  let words: Array(String) = array("pear", "fig", "banana", "kiwi")
  let %1: Fun(string: String): Int = member string.length
  let %2: Fun(a: Int b: Int): Bool = builtin >
  let longest: Tuple index: Int element: String end = call argmax_spec.2(words, %1, %2)
  let name: String = "Ada"
  let years: Int = 12
  let rating: Real = 4.5
  let %3: Tuple name: String years: Int rating: Real end = tuple(name, years, rating)
  let name.1: String = "Grace"
  let years.1: Int = 30
  let rating.1: Real = 4.9
  let %4: Tuple name: String years: Int rating: Real end = tuple(name.1, years.1, rating.1)
  let candidates: Array(Tuple name: String years: Int rating: Real end) = array(%3, %4)
  let %5: Fun(c: Candidate): Real = member scoring.score
  let %6: Fun(a: Real b: Real): Bool = builtin >>
  let best: Tuple index: Int element: Tuple name: String years: Int rating: Real end end = call argmax_spec.3(candidates, %5, %6)
}

