import arrayOp = "arrayOp" : ArrayOp
import string = "string" : StringOp
import scoring = "scoring" : Scoring
fun argmax [E::TYPE K::TYPE](descriptor_E: descriptor, descriptor_K: descriptor, a: Array(E), key: Fun(e: E): K, isGreater: Fun(x: K y: K): Bool): Tuple index: Int element: E end {
  let n: Int = prim extent(a)
  let %7: Bool = prim is(n, 0)
  if %7 {
    raise empty
  }
  var best.1: Int = 0
  let %8: E = index(a, 0)
  let %9: K = call key(%8)
  var bestKey: K = %9
  let %10: Int = prim -(n, 1)
  var i: Int = 1
  loop L1 {
    let %11: Bool = prim <=(i, %10)
    if %11 {
      let i.1: Int = i
      let %12: E = index(a, i.1)
      let k: K = call key(%12)
      let %13: Bool = call isGreater(k, bestKey)
      if %13 {
        best.1 := i.1
        bestKey := k
      }
      let %14: Int = prim +(i, 1)
      i := %14
    } else {
      break L1
    }
  }
  let index: Int = best.1
  let element: E = index(a, best.1)
  let %15: Tuple index: Int element: E end = tuple(index, element)
  return %15
}
fun argmax_spec(a.1: Array(String), key.1: Fun(e: String): Int, isGreater.1: Fun(x: Int y: Int): Bool): Tuple index: Int element: String end {
