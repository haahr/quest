import writer = "writer" : Writer
import conv = "conv" : Conv
static descriptor(Record x: Int y: Int z: Int end)
static descriptor(Record x: Int y: Int end)
static descriptor(Record b: Int a: Int end)
static offsets(Record x: Int y: Int z: Int end <- Record x: Int y: Int z: Int end) registered
static offsets(Record b: Int a: Int end <- Record b: Int a: Int end) registered
main {
  let wOut: writer.T = member writer.output @6:12
  let bt: BigTuple = tuple(10, 20, 30) @17:20
  let bt.1: SmallTuple = convert(bt, cast)
  let t: SmallTuple = bt.1 @18:10
  let %1: Int = tuple_field(t, 0) @16:39
  let %2: Int = tuple_field(t, 1) @16:45
  let %3: Int = prim +(%1, %2) @16:39
  let %4: String = call conv.int(%3) @9:31
  do call writer.putString(wOut, %4) @9:9
  let %5: Ok = call writer.putString(wOut, "\n") @10:9
  let br_box: box(BigRec) = record(x = 100, y = 200, z = 300) with offsets(Record x: Int y: Int z: Int end <- Record x: Int y: Int z: Int end) of descriptor(Record x: Int y: Int z: Int end) @24:18
  let br: BigRec = convert(br_box, slot_unbox)
  let br.1: SmallRec = convert(br, record_view(descriptor(Record x: Int y: Int end)))
  let r: SmallRec = br.1 @25:10
  let %6: Int = record_field(r, x) @23:31
  let %7: Int = record_field(r, y) @23:37
  let %8: Int = prim +(%6, %7) @23:31
  let %9: String = call conv.int(%8) @9:31
  do call writer.putString(wOut, %9) @9:9
  let %10: Ok = call writer.putString(wOut, "\n") @10:9
  let permuted_box: box(Record b: Int a: Int end) = record(b = 4, a = 7) with offsets(Record b: Int a: Int end <- Record b: Int a: Int end) of descriptor(Record b: Int a: Int end) @30:16
  let permuted: Record b: Int a: Int end = convert(permuted_box, slot_unbox)
  let r.1: OrderedRec = permuted @31:10
  let %11: Int = record_field(r.1, a) @29:32
  let %12: Int = record_field(r.1, b) @29:43
  let %13: Int = prim +(10, %12) @29:38
  let %14: Int = prim *(%11, %13) @29:32
  let %15: String = call conv.int(%14) @9:31
  do call writer.putString(wOut, %15) @9:9
  let %16: Ok = call writer.putString(wOut, "\n") @10:9
  let br.2: SmallRec = convert(br, record_view(descriptor(Record x: Int y: Int end)))
  let r.2: SmallRec = br.2 @34:56
  let %17: Int = record_field(r.2, x) @23:31
  let %18: Int = record_field(r.2, y) @23:37
  let %19: Int = prim +(%17, %18) @23:31
  let %20: String = call conv.int(%19) @9:31
  do call writer.putString(wOut, %20) @9:9
  let %21: Ok = call writer.putString(wOut, "\n") @10:9
}

