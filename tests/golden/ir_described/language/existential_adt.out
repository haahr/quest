fun new(init: Int): Int {
  return init
}
fun inc(c: Counter): Int {
  let %5: Int = prim +(c, 1)
  return %5
}
fun add(c.1: Counter, n: Int): Int {
  let %6: Int = prim +(c.1, n)
  return %6
}
fun get(c.2: Counter): Int {
  return c.2
}
main {
  let new.1: Fun(init: Int): Int = closure new {}
  let inc.1: Fun(c: Counter): Int = closure inc {}
  let add.1: Fun(c: Counter n: Int): Int = closure add {}
  let get.1: Fun(c: Counter): Int = closure get {}
  let new.2: Fun(init: Int): Counter = convert(new.1, adapt)
  let inc.2: Fun(c: Counter): Counter = convert(inc.1, adapt)
  let add.2: Fun(c: Counter n: Int): Counter = convert(add.1, adapt)
  let get.2: Fun(c: Counter): Int = convert(get.1, adapt)
  let counterModule: CounterPackage = tuple(Let Counter = Int new.2, inc.2, add.2, get.2)
  let %1: Fun(init: Int): counterModule.Counter = tuple_field(counterModule, 0)
  let c0: counterModule.Counter = call %1(0)
  let %2: Fun(c: counterModule.Counter): counterModule.Counter = tuple_field(counterModule, 1)
  let c1: counterModule.Counter = call %2(c0)
  let %3: Fun(c: counterModule.Counter n: Int): counterModule.Counter = tuple_field(counterModule, 2)
  let c2: counterModule.Counter = call %3(c1, 10)
  let %4: Fun(c: counterModule.Counter): Int = tuple_field(counterModule, 3)
  let total: Int = call %4(c2)
}

