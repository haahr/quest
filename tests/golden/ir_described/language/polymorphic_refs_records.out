static descriptor(Record x: Int y: Int end)
static offsets(Record x: Int y: Int end <- Record x: Int y: Int end) registered
main {
  let box: box(Record x: Int y: Int end) = record(x = 10, y = 20) with offsets(Record x: Int y: Int end <- Record x: Int y: Int end) of descriptor(Record x: Int y: Int end)
  let %1: Record x: Int y: Int end = convert(box, slot_unbox)
  var p1: Record x: Int y: Int end = %1
  let p2_box: box(Record x: Int y: Int end) = record(x = 30, y = 40) with offsets(Record x: Int y: Int end <- Record x: Int y: Int end) of descriptor(Record x: Int y: Int end)
  let p2: Record x: Int y: Int end = convert(p2_box, slot_unbox)
  let src: Point = p2
  p1 := src
  let box.1: box(Record x: Int y: Int end) = record(x = 1, y = 2) with offsets(Record x: Int y: Int end <- Record x: Int y: Int end) of descriptor(Record x: Int y: Int end)
  let %2: Record x: Int y: Int end = convert(box.1, slot_unbox)
  var r1: Record x: Int y: Int end = %2
  let box.2: box(Record x: Int y: Int end) = record(x = 8, y = 9) with offsets(Record x: Int y: Int end <- Record x: Int y: Int end) of descriptor(Record x: Int y: Int end)
  let %3: Record x: Int y: Int end = convert(box.2, slot_unbox)
  var r2: Record x: Int y: Int end = %3
  let tmp: Point = r1
  r1 := r2
  r2 := tmp
  let box.3: box(Record x: Int y: Int end) = record(x = 100, y = 200) with offsets(Record x: Int y: Int end <- Record x: Int y: Int end) of descriptor(Record x: Int y: Int end)
  let %4: Record x: Int y: Int end = convert(box.3, slot_unbox)
  var p3: Record x: Int y: Int end = %4
  let p4_box: box(Record x: Int y: Int end) = record(x = 500, y = 600) with offsets(Record x: Int y: Int end <- Record x: Int y: Int end) of descriptor(Record x: Int y: Int end)
  let p4: Record x: Int y: Int end = convert(p4_box, slot_unbox)
  let src.1: Point = p4
  p3 := src.1
  let box.4: box(Record x: Int y: Int end) = record(x = 111, y = 222) with offsets(Record x: Int y: Int end <- Record x: Int y: Int end) of descriptor(Record x: Int y: Int end)
  let %5: Record x: Int y: Int end = convert(box.4, slot_unbox)
  var s1: Record x: Int y: Int end = %5
  let box.5: box(Record x: Int y: Int end) = record(x = 333, y = 444) with offsets(Record x: Int y: Int end <- Record x: Int y: Int end) of descriptor(Record x: Int y: Int end)
  let %6: Record x: Int y: Int end = convert(box.5, slot_unbox)
  var s2: Record x: Int y: Int end = %6
  let tmp.1: Point = s1
  s1 := s2
  s2 := tmp.1
}

