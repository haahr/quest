import arrayOp = "arrayOp" : ArrayOp
import string = "string" : StringOp
import scoring = "scoring" : Scoring
main {
  let empty: Exception = exception empty
  let words: Array(String) = array("pear", "fig", "banana", "kiwi")
  let %1: Fun(string: String): Int = member string.length
  let %2: Fun(a: Int b: Int): Bool = builtin >
  let key: Fun(e: String): Int = %1
  let isGreater: Fun(x: Int y: Int): Bool = %2
  let n: Int = prim extent(words)
  let %3: Bool = prim is(n, 0)
  if %3 {
    raise empty
  }
  var best: Int = 0
  let %4: String = index(words, 0)
  let %5: Int = call key(%4)
  var bestKey: Int = %5
  let %6: Int = prim -(n, 1)
  var i: Int = 1
  loop L1_1 {
    let %7: Bool = prim <=(i, %6)
    if %7 {
      let i.1: Int = i
      let %8: String = index(words, i.1)
      let k: Int = call key(%8)
      let %9: Bool = call isGreater(k, bestKey)
      if %9 {
        best := i.1
        bestKey := k
      }
      let %10: Int = prim +(i, 1)
      i := %10
    } else {
      break L1_1
    }
  }
  let element: String = index(words, best)
  let name: String = "Ada"
  let %11: Tuple name: String years: Int rating: Real end = tuple(name, 12, 4.5)
  let name.1: String = "Grace"
  let %12: Tuple name: String years: Int rating: Real end = tuple(name.1, 30, 4.9)
  let candidates: Array(Tuple name: String years: Int rating: Real end) = array(%11, %12)
  let %13: Fun(c: Candidate): Real = member scoring.score
  let %14: Fun(a: Real b: Real): Bool = builtin >>
  let key.1: Fun(e: Tuple name: String years: Int rating: Real end): Real = %13
  let isGreater.1: Fun(x: Real y: Real): Bool = %14
  let n.1: Int = prim extent(candidates)
  let %15: Bool = prim is(n.1, 0)
  if %15 {
    raise empty
  }
  var best.1: Int = 0
  let %16: Tuple name: String years: Int rating: Real end = index(candidates, 0)
  let %17: Real = call key.1(%16)
  var bestKey.1: Real = %17
  let %18: Int = prim -(n.1, 1)
  var i.2: Int = 1
  loop L1_2 {
    let %19: Bool = prim <=(i.2, %18)
    if %19 {
      let i.3: Int = i.2
      let %20: Tuple name: String years: Int rating: Real end = index(candidates, i.3)
      let k.1: Real = call key.1(%20)
      let %21: Bool = call isGreater.1(k.1, bestKey.1)
      if %21 {
        best.1 := i.3
        bestKey.1 := k.1
      }
      let %22: Int = prim +(i.2, 1)
      i.2 := %22
    } else {
      break L1_2
    }
  }
  let element.1: Tuple name: String years: Int rating: Real end = index(candidates, best.1)
}

