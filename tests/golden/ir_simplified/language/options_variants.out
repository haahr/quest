import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output
  let %1: String = call conv.bool(true)
  do call writer.putString(wOut, %1)
  let %2: Ok = call writer.putString(wOut, "\n")
  let %3: String = call conv.bool(false)
  do call writer.putString(wOut, %3)
  let %4: Ok = call writer.putString(wOut, "\n")
  let %5: String = call conv.int(20)
  do call writer.putString(wOut, %5)
  let %6: Ok = call writer.putString(wOut, "\n")
  let %7: Tuple intensity: Int end = tuple(42)
  let c2: Color = option(blue, %7)
  let unp: Tuple Int intensity: Int end = payload(c2, blue) #2
  let %8: Int = tuple_field(unp, 1)
  let %9: String = call conv.int(%8)
  do call writer.putString(wOut, %9)
  let %10: Ok = call writer.putString(wOut, "\n")
  let %11: String = call conv.bool(true)
  do call writer.putString(wOut, %11)
  let %12: Ok = call writer.putString(wOut, "\n")
  let %13: String = call conv.bool(false)
  do call writer.putString(wOut, %13)
  let %14: Ok = call writer.putString(wOut, "\n")
  let %15: String = call conv.int(123)
  do call writer.putString(wOut, %15)
  let %16: Ok = call writer.putString(wOut, "\n")
}

