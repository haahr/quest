import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @6:12
  let %1: String = call conv.bool(true) @15:31
  do call writer.putString(wOut, %1) @15:9
  let %2: Ok = call writer.putString(wOut, "\n") @16:9
  let %3: String = call conv.bool(false) @15:31
  do call writer.putString(wOut, %3) @15:9
  let %4: Ok = call writer.putString(wOut, "\n") @16:9
  let %5: String = call conv.int(20) @9:31
  do call writer.putString(wOut, %5) @9:9
  let %6: Ok = call writer.putString(wOut, "\n") @10:9
  let %7: Tuple intensity: Int end = tuple(42) @42:36
  let c2: Color = option(blue, %7) @42:10
  let unp: Tuple Int intensity: Int end = payload(c2, blue) #2 @43:11
  let %8: Int = tuple_field(unp, 1) @44:10
  let %9: String = call conv.int(%8) @9:31
  do call writer.putString(wOut, %9) @9:9
  let %10: Ok = call writer.putString(wOut, "\n") @10:9
  let %11: String = call conv.bool(true) @15:31
  do call writer.putString(wOut, %11) @15:9
  let %12: Ok = call writer.putString(wOut, "\n") @16:9
  let %13: String = call conv.bool(false) @15:31
  do call writer.putString(wOut, %13) @15:9
  let %14: Ok = call writer.putString(wOut, "\n") @16:9
  let %15: String = call conv.int(123) @9:31
  do call writer.putString(wOut, %15) @9:9
  let %16: Ok = call writer.putString(wOut, "\n") @10:9
}

