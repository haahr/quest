import writer = "writer" : Writer
import conv = "conv" : Conv
import int = "int" : IntOp
main {
  let %1: String = call conv.int(42)
  let %2: String = prim <>("copies: ", %1)
  let %3: writer.T = member writer.output
  let %4: String = prim <>(%2, "\n")
  let %5: Ok = call writer.putString(%3, %4)
  let %6: String = "taken"
  let %7: String = prim <>("folded: ", %6)
  let %8: writer.T = member writer.output
  let %9: String = prim <>(%7, "\n")
  let %10: Ok = call writer.putString(%8, %9)
  let %11: String = call conv.int(7)
  let %12: String = prim <>("unused: ", %11)
  let %13: writer.T = member writer.output
  let %14: String = prim <>(%12, "\n")
  let %15: Ok = call writer.putString(%13, %14)
  join inlined1(%16: Int) {
    let %17: String = call conv.int(%16)
    let %18: String = prim <>("known option: ", %17)
    let %19: writer.T = member writer.output
    let %20: String = prim <>(%18, "\n")
    let %21: Ok = call writer.putString(%19, %20)
    let %22: String = call conv.bool(true)
    let %23: String = prim <>("known tag: ", %22)
    let %24: writer.T = member writer.output
    let %25: String = prim <>(%23, "\n")
    let %26: Ok = call writer.putString(%24, %25)
    let %27: String = call conv.int(247)
    let %28: String = prim <>("known variant: ", %27)
    let %29: writer.T = member writer.output
    let %30: String = prim <>(%28, "\n")
    let %31: Ok = call writer.putString(%29, %30)
    let u: Tuple var c: Int end = tuple(1)
    store u.#0 := 10
    let %32: Int = tuple_field(u, 0)
    let %33: Int = prim +(2, %32)
    let %34: Int = prim +(1, %33)
    let %35: String = call conv.int(%34)
    let %36: String = prim <>("projections: ", %35)
    let %37: writer.T = member writer.output
    let %38: String = prim <>(%36, "\n")
    let %39: Ok = call writer.putString(%37, %38)
    join inlined4(%40: Int) {
      let %41: String = call conv.int(%40)
      let %42: String = prim <>("payload copy: ", %41)
      let %43: writer.T = member writer.output
      let %44: String = prim <>(%42, "\n")
      let %45: Ok = call writer.putString(%43, %44)
      let %46: String = call conv.int(-9223372036854775808)
      let %47: String = prim <>("wraps: ", %46)
      let %48: writer.T = member writer.output
      let %49: String = prim <>(%47, "\n")
      let %50: Ok = call writer.putString(%48, %49)
      join inlined5(%51: String) {
        let %52: String = prim <>("division: ", %51)
        let %53: writer.T = member writer.output
        let %54: String = prim <>(%52, "\n")
        let %55: Ok = call writer.putString(%53, %54)
        var v: Int = 1
        let a: Int = v
        v := 2
        let %56: String = call conv.int(a)
        let %57: String = prim <>("stale: ", %56)
        let %58: writer.T = member writer.output
        let %59: String = prim <>(%57, "\n")
        let %60: Ok = call writer.putString(%58, %59)
      } in {
        let %61: Exception = member int.error
        try catching (%61) {
          let %62: Int = prim /(7, 0)
          let %63: String = call conv.int(%62)
          jump inlined5(%63)
        } handle (e: Exception) {
          let %64: Bool = prim is(e, %61)
          if %64 {
            jump inlined5("int.error")
          } else {
            reraise e
          }
        }
      }
    } in {
      let %65: Tuple k: Int var x: Int end = tuple(1, 2)
      let o: O = option(some, %65)
      let q: Tuple Int k: Int var x: Int end = payload(o, some) #1
      store q.#2 := 5
      switch tag(o) {
        case some (p: Tuple k: Int var x: Int end): {
          let %66: Int = tuple_field(p, 1)
          jump inlined4(%66)
        }
        else: {
          jump inlined4(0)
        }
      }
    }
  } in {
    let %67: Tuple k: Int var x: Int end = tuple(1, 2)
    let o.1: O = option(some, %67)
    switch tag(o.1) {
      case some (p.1: Tuple k: Int var x: Int end): {
        let %68: Int = tuple_field(p.1, 1)
        let %69: Int = tuple_field(p.1, 0)
        let %70: Int = prim +(%68, %69)
        store p.1.#1 := %70
        let %71: Int = tuple_field(p.1, 1)
        jump inlined1(%71)
      }
      else: {
        jump inlined1(0)
      }
    }
  }
}

