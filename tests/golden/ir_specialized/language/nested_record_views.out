import writer = "writer" : Writer
import conv = "conv" : Conv
import dynamic = "dynamic" : Dynamic
main {
  let big: Big = record(a = 1, b = 2, c = 3) @12:16
  let outerBig: OuterBig = record(inner = big, tag = 10) @17:26
  let outerSmall: OuterSmall = outerBig @18:30
  let %1: Small = record_field(outerSmall, inner) @19:3
  let %2: Int = record_field(%1, c) @19:3
  let %3: writer.T = member writer.output @8:38
  let %4: String = call conv.int(%2) @8:52
  let %5: String = prim <>(%4, "\n") @8:52
  let %6: Ok = call writer.putString(%3, %5) @8:21
  let o: OuterSmall = outerBig @21:3
  let %7: Small = record_field(o, inner) @20:34
  let %8: Int = record_field(%7, c) @20:34
  let %9: Int = record_field(o, tag) @20:46
  let %10: Int = prim +(%8, %9) @20:34
  let %11: writer.T = member writer.output @8:38
  let %12: String = call conv.int(%10) @8:52
  let %13: String = prim <>(%12, "\n") @8:52
  let %14: Ok = call writer.putString(%11, %13) @8:21
  let deep: DeepSmall = record(outer = outerBig) @26:23
  let %15: OuterSmall = record_field(deep, outer) @27:3
  let %16: Small = record_field(%15, inner) @27:3
  let %17: Int = record_field(%16, c) @27:3
  let %18: writer.T = member writer.output @8:38
  let %19: String = call conv.int(%17) @8:52
  let %20: String = prim <>(%19, "\n") @8:52
  let %21: Ok = call writer.putString(%18, %20) @8:21
  let %22: VSmall = variant(two, 7) @34:35
  let hasVBig: HasVBig = record(v = %22) @34:24
  join k1(r: Int) {
    let %23: writer.T = member writer.output @8:38
    let %24: String = call conv.int(r) @8:52
    let %25: String = prim <>(%24, "\n") @8:52
    let %26: Ok = call writer.putString(%23, %25) @8:21
    let %27: Tuple r: Big end = tuple(big) @42:35
    let %28: OSmall = option(some, %27) @42:35
    let hasOBig: HasOBig = record(o = %28) @42:24
    join k2(r.1: Int) {
      let %29: writer.T = member writer.output @8:38
      let %30: String = call conv.int(r.1) @8:52
      let %31: String = prim <>(%30, "\n") @8:52
      let %32: Ok = call writer.putString(%29, %31) @8:21
      let %33: Tuple r: Small n: Int end = tuple(big, 4) @48:48
      let hasPairSmall: HasPairSmall = record(pair = %33) @48:34
      let %34: Tuple r: Small n: Int end = record_field(hasPairSmall, pair) @49:3
      let %35: Small = tuple_field(%34, 0) @49:3
      let %36: Int = record_field(%35, c) @49:3
      let %37: Tuple r: Small n: Int end = record_field(hasPairSmall, pair) @49:27
      let %38: Int = tuple_field(%37, 1) @49:27
      let %39: Int = prim +(%36, %38) @49:3
      let %40: writer.T = member writer.output @8:38
      let %41: String = call conv.int(%39) @8:52
      let %42: String = prim <>(%41, "\n") @8:52
      let %43: Ok = call writer.putString(%40, %42) @8:21
      let d: T = call dynamic.new [OuterSmall](outerBig) @52:9
      let fromDynamic: OuterSmall = call dynamic.be [OuterSmall](d) @53:31
      let %44: Small = record_field(fromDynamic, inner) @54:3
      let %45: Int = record_field(%44, c) @54:3
      let %46: writer.T = member writer.output @8:38
      let %47: String = call conv.int(%45) @8:52
      let %48: String = prim <>(%47, "\n") @8:52
      let %49: Ok = call writer.putString(%46, %48) @8:21
      let %50: writer.T = member writer.output @55:16
      do call dynamic.extern(%50, d) @55:1
      let %51: writer.T = member writer.output @56:18
      do call writer.putString(%51, "\n") @56:1
      let x: OuterSmall = outerBig @60:30
      let %52: Small = record_field(x, inner) @61:3
      let %53: Int = record_field(%52, c) @61:3
      let %54: Int = record_field(x, tag) @61:24
      let %55: Int = prim +(%53, %54) @61:3
      let %56: writer.T = member writer.output @8:38
      let %57: String = call conv.int(%55) @8:52
      let %58: String = prim <>(%57, "\n") @8:52
      let %59: Ok = call writer.putString(%56, %58) @8:21
    } in {
      let %60: OBig = record_field(hasOBig, o) @43:8
      switch tag(%60) { @43:3
        case some (s: Tuple r: Small end): {
          let %61: Small = tuple_field(s, 0) @43:40
          let %62: Int = record_field(%61, c) @43:40
          jump k2(%62) @43:3
        }
        case none, other: {
          jump k2(0) @43:3
        }
      }
    }
  } in {
    let %63: VBig = record_field(hasVBig, v) @35:8
    switch tag(%63) { @35:3
      case one (n: Int): {
        let %64: Int = prim -(0, n) @35:39
        jump k1(%64) @35:3
      }
      case two (n.1: Int): {
        jump k1(n.1) @35:3
      }
    }
  }
}

