import writer = "writer" : Writer
import conv = "conv" : Conv
import dynamic = "dynamic" : Dynamic
main {
  funs {
    fun p(n: Int): Ok {
      let %1: writer.T = member writer.output
      let %2: String = call external "quest_conv_int"(n)
      let %3: String = prim <>(%2, "\n")
      let %4: Ok = call writer.putString(%1, %3)
      return %4
    }
  }
  let big: Big = record(a = 1, b = 2, c = 3)
  let outerBig: OuterBig = record(inner = big, tag = 10)
  let outerSmall: OuterSmall = outerBig
  let %5: Small = record_field(outerSmall, inner)
  let %6: Int = record_field(%5, c)
  do call p(%6)
  funs {
    fun innerC(o: OuterSmall): Int {
      let %7: Small = record_field(o, inner)
      let %8: Int = record_field(%7, c)
      let %9: Int = record_field(o, tag)
      let %10: Int = prim +(%8, %9)
      return %10
    }
  }
  let %11: Int = call innerC(outerBig)
  do call p(%11)
  let deep: DeepSmall = record(outer = outerBig)
  let %12: OuterSmall = record_field(deep, outer)
  let %13: Small = record_field(%12, inner)
  let %14: Int = record_field(%13, c)
  do call p(%14)
  let %15: VSmall = variant(two, 7)
  let hasVBig: HasVBig = record(v = %15)
  join k1(r: Int) {
    do call p(r)
    let r.1: Big = big
    let %16: Tuple r: Big end = tuple(r.1)
    let %17: OSmall = option(some, %16)
    let hasOBig: HasOBig = record(o = %17)
    join k2(r.2: Int) {
      do call p(r.2)
      let r.3: Big = big
      let n.1: Int = 4
      let %18: Tuple r: Small n: Int end = tuple(r.3, n.1)
      let hasPairSmall: HasPairSmall = record(pair = %18)
      let %19: Tuple r: Small n: Int end = record_field(hasPairSmall, pair)
      let %20: Small = tuple_field(%19, 0)
      let %21: Int = record_field(%20, c)
      let %22: Tuple r: Small n: Int end = record_field(hasPairSmall, pair)
      let %23: Int = tuple_field(%22, 1)
      let %24: Int = prim +(%21, %23)
      do call p(%24)
      let d: T = call dynamic.new [OuterSmall](outerBig)
      let fromDynamic: OuterSmall = call dynamic.be [OuterSmall](d)
      let %25: Small = record_field(fromDynamic, inner)
      let %26: Int = record_field(%25, c)
      do call p(%26)
      let %27: writer.T = member writer.output
      do call dynamic.extern(%27, d)
      let %28: writer.T = member writer.output
      do call writer.putString(%28, "\n")
      funs {
        fun first [A::TYPE](x: A, y: A): A {
          return x
        }
        fun first_spec(x.1: OuterSmall, y.1: OuterSmall): OuterSmall {
          return x.1
        }
      }
      let firstSmall: OuterSmall = call first_spec(outerBig, outerSmall)
      let %29: Small = record_field(firstSmall, inner)
      let %30: Int = record_field(%29, c)
      let %31: Int = record_field(firstSmall, tag)
      let %32: Int = prim +(%30, %31)
      do call p(%32)
    } in {
      let %33: OBig = record_field(hasOBig, o)
      switch tag(%33) {
        case some (s: Tuple r: Small end): {
          let %34: Small = tuple_field(s, 0)
          let %35: Int = record_field(%34, c)
          jump k2(%35)
        }
        case none, other: {
          jump k2(0)
        }
      }
    }
  } in {
    let %36: VBig = record_field(hasVBig, v)
    switch tag(%36) {
      case one (n.2: Int): {
        let %37: Int = prim -(0, n.2)
        jump k1(%37)
      }
      case two (n.3: Int): {
        jump k1(n.3)
      }
    }
  }
}

