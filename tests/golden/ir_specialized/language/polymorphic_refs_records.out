main {
  let %1: Record x: Int y: Int end = record(x = 10, y = 20)
  var p1: Record x: Int y: Int end = %1
  let p2: Record x: Int y: Int end = record(x = 30, y = 40)
  let src: Point = p2
  p1 := src
  let %2: Record x: Int y: Int end = record(x = 1, y = 2)
  var r1: Record x: Int y: Int end = %2
  let %3: Record x: Int y: Int end = record(x = 8, y = 9)
  var r2: Record x: Int y: Int end = %3
  let tmp: Point = r1
  r1 := r2
  r2 := tmp
  let %4: Record x: Int y: Int end = record(x = 100, y = 200)
  var p3: Record x: Int y: Int end = %4
  let p4: Record x: Int y: Int end = record(x = 500, y = 600)
  let src.1: Point = p4
  p3 := src.1
  let %5: Record x: Int y: Int end = record(x = 111, y = 222)
  var s1: Record x: Int y: Int end = %5
  let %6: Record x: Int y: Int end = record(x = 333, y = 444)
  var s2: Record x: Int y: Int end = %6
  let tmp.1: Point = s1
  s1 := s2
  s2 := tmp.1
}

