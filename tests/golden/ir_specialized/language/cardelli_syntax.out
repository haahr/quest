main {
  var a: Int = 0
  a := 7
  let t: Record var a: Int end = record(var a = 10)
  funs {
    fun inc(var x: Int): Ok {
      let %1: Int = prim +(x, 1)
      x := %1
      return ok
    }
  }
  let %2: Var(Int) = addr t.a
  do call inc(%2)
  funs {
    fun addFive(var x.1: Int): Int {
      let %3: Int = prim +(x.1, 5)
      x.1 := %3
      return x.1
    }
  }
  let %4: Var(Int) = cell(10)
  let r: Int = call addFive(%4)
  a := 99
  let %5: Array(Int) = array(0, 1, 2, 3, 4)
  var total: Int = 0
  let %6: Int = prim extent(%5)
  let %7: Int = prim -(%6, 1)
  var i: Int = 0
  loop L1_1 {
    let %8: Bool = prim <=(i, %7)
    if %8 {
      let i.1: Int = i
      let %9: Int = index(%5, i.1)
      let %10: Int = prim +(total, %9)
      total := %10
      let %11: Int = prim +(i, 1)
      i := %11
    } else {
      break L1_1
    }
  }
  let %12: Array(Int) = array_rep(5, 1)
  var total.1: Int = 0
  let %13: Int = prim extent(%12)
  let %14: Int = prim -(%13, 1)
  var i.2: Int = 0
  loop L1_2 {
    let %15: Bool = prim <=(i.2, %14)
    if %15 {
      let i.3: Int = i.2
      let %16: Int = index(%12, i.3)
      let %17: Int = prim +(total.1, %16)
      total.1 := %17
      let %18: Int = prim +(i.2, 1)
      i.2 := %18
    } else {
      break L1_2
    }
  }
  let %19: Array(Int) = array(10, 20, 30)
  var total.2: Int = 0
  let %20: Int = prim extent(%19)
  let %21: Int = prim -(%20, 1)
  var i.4: Int = 0
  loop L1_3 {
    let %22: Bool = prim <=(i.4, %21)
    if %22 {
      let i.5: Int = i.4
      let %23: Int = index(%19, i.5)
      let %24: Int = prim +(total.2, %23)
      total.2 := %24
      let %25: Int = prim +(i.4, 1)
      i.4 := %25
    } else {
      break L1_3
    }
  }
}

