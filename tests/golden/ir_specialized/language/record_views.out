import writer = "writer" : Writer
import conv = "conv" : Conv
import dynamic = "dynamic" : Dynamic
main {
  let huge: Huge = record(a = 1, b = 2, c = 3, d = 4) @14:18
  let big: Big = huge @17:16
  let mid: Mid = big @18:16
  let small: Small = mid @19:20
  let %1: Int = record_field(mid, c) @20:3
  let %2: writer.T = member writer.output @8:38
  let %3: String = call conv.int(%1) @8:52
  let %4: String = prim <>(%3, "\n") @8:52
  let %5: Ok = call writer.putString(%2, %4) @8:21
  let %6: Int = record_field(small, d) @21:3
  let %7: writer.T = member writer.output @8:38
  let %8: String = call conv.int(%6) @8:52
  let %9: String = prim <>(%8, "\n") @8:52
  let %10: Ok = call writer.putString(%7, %9) @8:21
  let m: Mid = big @25:3
  let %11: Int = record_field(m, c) @24:27
  let %12: Int = record_field(m, d) @24:33
  let %13: Int = prim +(%11, %12) @24:27
  let %14: writer.T = member writer.output @8:38
  let %15: String = call conv.int(%13) @8:52
  let %16: String = prim <>(%15, "\n") @8:52
  let %17: Ok = call writer.putString(%14, %16) @8:21
  let d: T = call dynamic.new [Mid](mid) @28:9
  let viaDynamic: Small = call dynamic.be [Small](d) @29:25
  let %18: Int = record_field(viaDynamic, d) @30:3
  let %19: writer.T = member writer.output @8:38
  let %20: String = call conv.int(%18) @8:52
  let %21: String = prim <>(%20, "\n") @8:52
  let %22: Ok = call writer.putString(%19, %21) @8:21
  join k1(r: Int) {
    let %23: writer.T = member writer.output @8:38
    let %24: String = call conv.int(r) @8:52
    let %25: String = prim <>(%24, "\n") @8:52
    let %26: Ok = call writer.putString(%23, %25) @8:21
    let %27: Tuple a: Big end = tuple(big) @35:32
    let anyMid: AnyMid = auto[Big](%27) @35:22
    join k2(r.1: Int) {
      let %28: writer.T = member writer.output @8:38
      let %29: String = call conv.int(r.1) @8:52
      let %30: String = prim <>(%29, "\n") @8:52
      let %31: Ok = call writer.putString(%28, %30) @8:21
      let bigTuple: Tuple r: Big n: Int end = tuple(big, 5) @39:41
      let midTuple: Tuple r: Mid n: Int end = bigTuple @40:41
      let %32: Mid = tuple_field(midTuple, 0) @41:3
      let %33: Int = record_field(%32, c) @41:3
      let %34: Int = tuple_field(midTuple, 1) @41:18
      let %35: Int = prim +(%33, %34) @41:3
      let %36: writer.T = member writer.output @8:38
      let %37: String = call conv.int(%35) @8:52
      let %38: String = prim <>(%37, "\n") @8:52
      let %39: Ok = call writer.putString(%36, %38) @8:21
      funs {
        fun same [A::<: Mid](x: A): A {
          return x
        }
        fun same_spec(x.1: Big): Big {
          return x.1
        }
      }
      let bigAgain: Big = call same_spec(big) @45:21
      let %40: Int = record_field(bigAgain, b) @46:3
      let %41: writer.T = member writer.output @8:38
      let %42: String = call conv.int(%40) @8:52
      let %43: String = prim <>(%42, "\n") @8:52
      let %44: Ok = call writer.putString(%41, %43) @8:21
      let %45: writer.T = member writer.output @49:16
      do call dynamic.extern(%45, d) @49:1
      let %46: writer.T = member writer.output @50:18
      do call writer.putString(%46, "\n") @50:1
    } in {
      inspect anyMid { @36:3
        case Mid (x.2: Tuple a: Mid end): {
          let %47: Mid = tuple_field(x.2, 0) @36:39
          let %48: Int = record_field(%47, c) @36:39
          let %49: Mid = tuple_field(x.2, 0) @36:52
          let %50: Int = record_field(%49, d) @36:52
          let %51: Int = prim +(10, %50) @36:47
          let %52: Int = prim *(%48, %51) @36:39
          jump k2(%52) @36:3
        }
        else: {
          jump k2(0) @36:3
        }
      }
    }
  } in {
    inspect d { @33:3
      case Small (s: Tuple a: Small end): {
        let %53: Small = tuple_field(s, 0) @33:36
        let %54: Int = record_field(%53, d) @33:36
        jump k1(%54) @33:3
      }
      else: {
        jump k1(0) @33:3
      }
    }
  }
}

