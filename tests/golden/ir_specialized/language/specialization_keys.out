import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let %1: String = call conv.int(1) @16:7
  let %2: writer.T = member writer.output @8:45
  let %3: String = prim <>(%1, "\n") @8:59
  let %4: Ok = call writer.putString(%2, %3) @8:28
  let %5: Record a: Int end = record(a = 2) @14:35
  let %6: P = %5 @17:16
  let %7: Int = record_field(%6, a) @17:16
  let %8: String = call conv.int(%7) @17:7
  let %9: writer.T = member writer.output @8:45
  let %10: String = prim <>(%8, "\n") @8:59
  let %11: Ok = call writer.putString(%9, %10) @8:28
  let %12: String = "three" @18:7
  let %13: writer.T = member writer.output @8:45
  let %14: String = prim <>(%12, "\n") @8:59
  let %15: Ok = call writer.putString(%13, %14) @8:28
  let %16: Record a: Int end = record(a = 4) @19:25
  let x: P = %16 @19:16
  let %17: Int = record_field(x, a) @19:16
  let %18: String = call conv.int(%17) @19:7
  let %19: writer.T = member writer.output @8:45
  let %20: String = prim <>(%18, "\n") @8:59
  let %21: Ok = call writer.putString(%19, %20) @8:28
  let %22: Record a: Int end = record(a = 5) @20:25
  let x.1: P = %22 @20:16
  let %23: Int = record_field(x.1, a) @20:16
  let %24: String = call conv.int(%23) @20:7
  let %25: writer.T = member writer.output @8:45
  let %26: String = prim <>(%24, "\n") @8:59
  let %27: Ok = call writer.putString(%25, %26) @8:28
}

