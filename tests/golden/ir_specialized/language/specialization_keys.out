import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let %1: String = call conv.int(1)
  let %2: writer.T = member writer.output
  let %3: String = prim <>(%1, "\n")
  let %4: Ok = call writer.putString(%2, %3)
  let %5: Record a: Int end = record(a = 2)
  let %6: P = %5
  let %7: Int = record_field(%6, a)
  let %8: String = call conv.int(%7)
  let %9: writer.T = member writer.output
  let %10: String = prim <>(%8, "\n")
  let %11: Ok = call writer.putString(%9, %10)
  let %12: String = "three"
  let %13: writer.T = member writer.output
  let %14: String = prim <>(%12, "\n")
  let %15: Ok = call writer.putString(%13, %14)
  let %16: Record a: Int end = record(a = 4)
  let x: P = %16
  let %17: Int = record_field(x, a)
  let %18: String = call conv.int(%17)
  let %19: writer.T = member writer.output
  let %20: String = prim <>(%18, "\n")
  let %21: Ok = call writer.putString(%19, %20)
  let %22: Record a: Int end = record(a = 5)
  let x.1: P = %22
  let %23: Int = record_field(x.1, a)
  let %24: String = call conv.int(%23)
  let %25: writer.T = member writer.output
  let %26: String = prim <>(%24, "\n")
  let %27: Ok = call writer.putString(%25, %26)
}

