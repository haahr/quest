import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let %1: String = call conv.int(1) @16:7
  let %2: writer.T = member writer.output @8:45
  let %3: String = prim <>(%1, "\n") @8:59
  let %4: Ok = call writer.putString(%2, %3) @8:28
  let %5: Record a: Int end = record(a = 2) @14:35
  let %6: Int = record_field(%5, a) @17:16
  let %7: String = call conv.int(%6) @17:7
  let %8: writer.T = member writer.output @8:45
  let %9: String = prim <>(%7, "\n") @8:59
  let %10: Ok = call writer.putString(%8, %9) @8:28
  let %11: String = "three" @18:7
  let %12: writer.T = member writer.output @8:45
  let %13: String = prim <>(%11, "\n") @8:59
  let %14: Ok = call writer.putString(%12, %13) @8:28
  let %15: Record a: Int end = record(a = 4) @19:25
  let %16: Int = record_field(%15, a) @19:16
  let %17: String = call conv.int(%16) @19:7
  let %18: writer.T = member writer.output @8:45
  let %19: String = prim <>(%17, "\n") @8:59
  let %20: Ok = call writer.putString(%18, %19) @8:28
  let %21: Record a: Int end = record(a = 5) @20:25
  let %22: Int = record_field(%21, a) @20:16
  let %23: String = call conv.int(%22) @20:7
  let %24: writer.T = member writer.output @8:45
  let %25: String = prim <>(%23, "\n") @8:59
  let %26: Ok = call writer.putString(%24, %25) @8:28
}

