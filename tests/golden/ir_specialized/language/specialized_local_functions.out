import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @8:12
  let %1: Record a: Int end = record(a = 1) @16:24
  let x: P = %1 @16:16
  let %2: Int = record_field(x, a) @16:16
  let %3: String = call conv.int(%2) @16:7
  let %4: String = prim <>(%3, "\n") @9:50
  let %5: Ok = call writer.putString(wOut, %4) @9:28
  let %6: Record a: Int end = record(a = 2) @20:26
  let x.1: P = %6 @20:16
  let %7: Int = record_field(x.1, a) @20:16
  let %8: String = call conv.int(%7) @20:7
  let %9: String = prim <>(%8, "\n") @9:50
  let %10: Ok = call writer.putString(wOut, %9) @9:28
  let %11: String = call conv.int(30) @21:7
  let %12: String = prim <>(%11, "\n") @9:50
  let %13: Ok = call writer.putString(wOut, %12) @9:28
  let %14: String = call conv.int(8) @25:7
  let %15: String = prim <>(%14, "\n") @9:50
  let %16: Ok = call writer.putString(wOut, %15) @9:28
  let %17: Record a: Int end = record(a = 5) @34:24
  let x.2: P = %17 @34:16
  let %18: Int = record_field(x.2, a) @34:16
  let %19: String = call conv.int(%18) @34:7
  let %20: String = prim <>(%19, "\n") @9:50
  let %21: Ok = call writer.putString(wOut, %20) @9:28
  let %22: Record a: Int end = record(a = 6) @38:25
  let x.3: P = %22 @38:16
  let %23: Int = record_field(x.3, a) @38:16
  let %24: String = call conv.int(%23) @38:7
  let %25: String = prim <>(%24, "\n") @9:50
  let %26: Ok = call writer.putString(wOut, %25) @9:28
  let %27: Record a: Int end = record(a = 7) @42:24
  let x.4: P = %27 @42:16
  let %28: Int = record_field(x.4, a) @42:16
  let %29: String = call conv.int(%28) @42:7
  let %30: String = prim <>(%29, "\n") @9:50
  let %31: Ok = call writer.putString(wOut, %30) @9:28
}

