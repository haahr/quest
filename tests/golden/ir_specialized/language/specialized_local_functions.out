import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output
  let %1: Record a: Int end = record(a = 1)
  let x: P = %1
  let %2: Int = record_field(x, a)
  let %3: String = call conv.int(%2)
  let %4: String = prim <>(%3, "\n")
  let %5: Ok = call writer.putString(wOut, %4)
  let %6: Record a: Int end = record(a = 2)
  let x.1: P = %6
  let %7: Int = record_field(x.1, a)
  let %8: String = call conv.int(%7)
  let %9: String = prim <>(%8, "\n")
  let %10: Ok = call writer.putString(wOut, %9)
  let %11: String = call conv.int(30)
  let %12: String = prim <>(%11, "\n")
  let %13: Ok = call writer.putString(wOut, %12)
  let %14: String = call conv.int(8)
  let %15: String = prim <>(%14, "\n")
  let %16: Ok = call writer.putString(wOut, %15)
  let %17: Record a: Int end = record(a = 5)
  let x.2: P = %17
  let %18: Int = record_field(x.2, a)
  let %19: String = call conv.int(%18)
  let %20: String = prim <>(%19, "\n")
  let %21: Ok = call writer.putString(wOut, %20)
  let %22: Record a: Int end = record(a = 6)
  let x.3: P = %22
  let %23: Int = record_field(x.3, a)
  let %24: String = call conv.int(%23)
  let %25: String = prim <>(%24, "\n")
  let %26: Ok = call writer.putString(wOut, %25)
  let %27: Record a: Int end = record(a = 7)
  let x.4: P = %27
  let %28: Int = record_field(x.4, a)
  let %29: String = call conv.int(%28)
  let %30: String = prim <>(%29, "\n")
  let %31: Ok = call writer.putString(wOut, %30)
}

