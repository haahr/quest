import writer = "writer" : Writer
import conv = "conv" : Conv
import dynamic = "dynamic" : Dynamic
import arrayOp = "arrayOp" : ArrayOp
main {
  let wOut: writer.T = member writer.output
  funs rec {
    fun eval(e: Expr): Int {
      switch tag(e) {
        case num (n: Int): {
          return n
        }
        case neg (x: Expr): {
          let %1: Int = call eval(x)
          let %2: Int = prim -(0, %1)
          return %2
        }
        case bind (b: Bind): {
          var b.1: Bind = b
          loop contified1 {
            let b.2: Bind = b.1
            let %3: Expr = tuple_field(b.2, 0)
            let %4: Int = call eval(%3)
            var s: Int = %4
            let %5: Array(Expr) = tuple_field(b.2, 1)
            let %6: Int = prim extent(%5)
            let %7: Int = prim -(%6, 1)
            var i: Int = 0
            loop L1 {
              let %8: Bool = prim <=(i, %7)
              if %8 {
                let i.1: Int = i
                let %9: Array(Expr) = tuple_field(b.2, 1)
                let %10: Expr = index(%9, i.1)
                let %11: Int = call eval(%10)
                let %12: Int = prim +(s, %11)
                s := %12
                let %13: Int = prim +(i, 1)
                i := %13
              } else {
                break L1
              }
            }
            return s
          }
        }
        else: {
          return 0
        }
      }
    }
  }
  let %14: Expr = variant(num, 10)
  let %15: Expr = variant(num, 1)
  let %16: Expr = variant(num, 2)
  let %17: Expr = variant(neg, %16)
  let body: Array(Expr) = array(%15, %17)
  let %18: Tuple value: Expr body: Array(Expr) end = tuple(%14, body)
  let e.1: Expr = variant(bind, %18)
  let %19: Int = call eval(e.1)
  let %20: String = call conv.int(%19)
  do call writer.putString(wOut, %20)
  let %21: Ok = call writer.putString(wOut, "\n")
  let zero: Even = option(zero)
  let %22: Tuple n: Even end = tuple(zero)
  let one: Odd = option(succ, %22)
  let %23: Tuple n: Odd end = tuple(one)
  let two: Even = option(succ, %23)
  let %24: Tuple n: Even end = tuple(two)
  let three: Odd = option(succ, %24)
  funs rec {
    fun evenValue(x.1: Even): Int {
      switch tag(x.1) {
        case succ (p: Tuple n: Odd end): {
          let %25: Odd = tuple_field(p, 0)
          let %26: Int = call oddValue(%25)
          let %27: Int = prim +(%26, 1)
          return %27
        }
        else: {
          return 0
        }
      }
    }
    fun oddValue(x.2: Odd): Int {
      let %28: Tuple Int n: Even end = payload(x.2, succ) #0
      let %29: Even = tuple_field(%28, 1)
      let %30: Int = call evenValue(%29)
      let %31: Int = prim +(%30, 1)
      return %31
    }
  }
  let %32: Int = call oddValue(three)
  let %33: String = call conv.int(%32)
  do call writer.putString(wOut, %33)
  let %34: Ok = call writer.putString(wOut, "\n")
  join k3(r: Int) {
    let %35: String = call conv.int(r)
    do call writer.putString(wOut, %35)
    let %36: Ok = call writer.putString(wOut, "\n")
    let %37: Pets = option(none)
    let alice: Person = record(name = "alice", var pet = %37)
    let rex: Pet = record(name = "rex", owner = alice)
    let %38: Tuple p: Pet end = tuple(rex)
    let %39: Pets = option(some, %38)
    store alice.pet := %39
    join k4(r.1: Int) {
      let %40: String = call conv.int(r.1)
      do call writer.putString(wOut, %40)
      let %41: Ok = call writer.putString(wOut, "\n")
      funs rec {
        fun size(t: Tree2): Int {
          switch tag(t) {
            case leaf (n.1: Int): {
              return n.1
            }
            case node (f: Record trees: Array(Tree2) end): {
              var s.1: Int = 0
              let %42: Array(Tree2) = record_field(f, trees)
              let %43: Int = prim extent(%42)
              let %44: Int = prim -(%43, 1)
              var i.2: Int = 0
              loop L2 {
                let %45: Bool = prim <=(i.2, %44)
                if %45 {
                  let i.3: Int = i.2
                  let %46: Array(Tree2) = record_field(f, trees)
                  let %47: Tree2 = index(%46, i.3)
                  let %48: Int = call size(%47)
                  let %49: Int = prim +(s.1, %48)
                  s.1 := %49
                  let %50: Int = prim +(i.2, 1)
                  i.2 := %50
                } else {
                  break L2
                }
              }
              return s.1
            }
            else: {
              return 0
            }
          }
        }
      }
      let %51: Tree = variant(leaf, 4)
      let %52: Tree = variant(leaf, 5)
      let %53: Array(Tree) = array(%51, %52)
      let %54: Record trees: Array(Tree) end = record(trees = %53)
      let t.1: Tree = variant(node, %54)
      let t2: Tree2 = t.1
      let %55: Int = call size(t2)
      let %56: String = call conv.int(%55)
      do call writer.putString(wOut, %56)
      let %57: Ok = call writer.putString(wOut, "\n")
      let %58: Tree = variant(leaf, 6)
      let trees: Array(Tree2) = array(t.1, %58)
      let %59: Tree2 = index(trees, 0)
      let %60: Int = call size(%59)
      let %61: Tree2 = index(trees, 1)
      let %62: Int = call size(%61)
      let %63: Int = prim +(%60, %62)
      let %64: String = call conv.int(%63)
      do call writer.putString(wOut, %64)
      let %65: Ok = call writer.putString(wOut, "\n")
      let %66: Int = call size(t.1)
      let %67: String = call conv.int(%66)
      do call writer.putString(wOut, %67)
      let %68: Ok = call writer.putString(wOut, "\n")
      let %69: Int = call oddValue(three)
      let %70: String = call conv.int(%69)
      do call writer.putString(wOut, %70)
      let %71: Ok = call writer.putString(wOut, "\n")
      let %72: T = call dynamic.new [Expr](e.1)
      let %73: Expr = call dynamic.be [Expr](%72)
      let %74: Int = call eval(%73)
      let %75: String = call conv.int(%74)
      do call writer.putString(wOut, %75)
      let %76: Ok = call writer.putString(wOut, "\n")
      let %77: T = call dynamic.new [Odd](three)
      let %78: Odd = call dynamic.be [Odd](%77)
      let %79: Int = call oddValue(%78)
      let %80: String = call conv.int(%79)
      do call writer.putString(wOut, %80)
      let %81: Ok = call writer.putString(wOut, "\n")
      let %82: T = call dynamic.new [Tree](t.1)
      let %83: Tree2 = call dynamic.be [Tree2](%82)
      let %84: Int = call size(%83)
      let %85: String = call conv.int(%84)
      do call writer.putString(wOut, %85)
      let %86: Ok = call writer.putString(wOut, "\n")
      let %87: T = call dynamic.new [Tree2](t2)
      let %88: Tree = call dynamic.be [Tree](%87)
      let %89: Int = call size(%88)
      let %90: String = call conv.int(%89)
      do call writer.putString(wOut, %90)
      let %91: Ok = call writer.putString(wOut, "\n")
      join k6(mismatch: Int) {
        let %92: String = call conv.int(mismatch)
        do call writer.putString(wOut, %92)
        let %93: Ok = call writer.putString(wOut, "\n")
      } in {
        let %94: Exception = member dynamic.error
        try catching (%94) {
          let %95: T = call dynamic.new [Odd](three)
          let %96: Even = call dynamic.be [Even](%95)
          let %97: Int = call evenValue(%96)
          jump k6(%97)
        } handle (e.2: Exception) {
          let %98: Bool = prim is(e.2, %94)
          if %98 {
            jump k6(-1)
          } else {
            reraise e.2
          }
        }
      }
    } in {
      let %99: Pets = record_field(alice, pet)
      let %100: Tuple Int p: Pet end = payload(%99, some) #1
      let %101: Pet = tuple_field(%100, 1)
      let %102: Person = record_field(%101, owner)
      let %103: Pets = record_field(%102, pet)
      let %104: Bool = is_tag(%103, some)
      if %104 {
        jump k4(1)
      } else {
        jump k4(0)
      }
    }
  } in {
    let %105: Tuple Int n: Even end = payload(three, succ) #0
    let %106: Even = tuple_field(%105, 1)
    let %107: Tuple Int n: Odd end = payload(%106, succ) #1
    let %108: Odd = tuple_field(%107, 1)
    let %109: Tuple Int n: Even end = payload(%108, succ) #0
    let %110: Even = tuple_field(%109, 1)
    let %111: Bool = is_tag(%110, zero)
    if %111 {
      jump k3(1)
    } else {
      jump k3(0)
    }
  }
}

