import writer = "writer" : Writer
import conv = "conv" : Conv
module m : M {
  funs {
    fun first [A::TYPE](x: A, y: A): A {
      return x
    }
    fun first_spec(x.1: P, y.1: P): P {
      return x.1
    }
  }
  let m_record: Record first: All(A :: TYPE) Fun(x: A y: A): A end = record(first = first)
  export first = first, first_spec1 = first_spec
  record m_record
}
main {
  let wOut: writer.T = member writer.output
  let %1: Record a: Int end = record(a = 1)
  let x.2: P = %1
  let %2: Int = record_field(x.2, a)
  let %3: String = call conv.int(%2)
  let %4: String = prim <>(%3, "\n")
  let %5: Ok = call writer.putString(wOut, %4)
  let %6: Record a: Int end = record(a = 2)
  let %7: Record a: Int end = record(a = 20)
  let %8: P = call m.first_spec1(%6, %7)
  let %9: Int = record_field(%8, a)
  let %10: String = call conv.int(%9)
  let %11: String = prim <>(%10, "\n")
  let %12: Ok = call writer.putString(wOut, %11)
  let %13: Record a: Int end = record(a = 30)
  let y.2: P = %13
  let %14: Int = record_field(y.2, a)
  let %15: String = call conv.int(%14)
  let %16: String = prim <>(%15, "\n")
  let %17: Ok = call writer.putString(wOut, %16)
  let %18: Record a: Int end = record(a = 40)
  let y.3: P = %18
  let %19: Int = record_field(y.3, a)
  let %20: String = call conv.int(%19)
  let %21: String = prim <>(%20, "\n")
  let %22: Ok = call writer.putString(wOut, %21)
  let %23: Record a: Int end = record(a = 50)
  let y.4: P = %23
  let %24: Int = record_field(y.4, a)
  let %25: String = call conv.int(%24)
  let %26: String = prim <>(%25, "\n")
  let %27: Ok = call writer.putString(wOut, %26)
}

