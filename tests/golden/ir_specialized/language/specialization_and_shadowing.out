import writer = "writer" : Writer
import conv = "conv" : Conv
module m : M {
  funs {
    fun first [A::TYPE](x: A, y: A): A {
      return x
    }
    fun first_spec(x.1: P, y.1: P): P {
      return x.1
    }
  }
  let m_record: Record first: All(A :: TYPE) Fun(x: A y: A): A end = record(first = first)
  export first = first, first_spec1 = first_spec
  record m_record
}
main {
  let wOut: writer.T = member writer.output @8:12
  let %1: Record a: Int end = record(a = 1) @18:25
  let x.2: P = %1 @18:16
  let %2: Int = record_field(x.2, a) @18:16
  let %3: String = call conv.int(%2) @18:7
  let %4: String = prim <>(%3, "\n") @9:50
  let %5: Ok = call writer.putString(wOut, %4) @9:28
  let %6: Record a: Int end = record(a = 2) @19:27
  let %7: Record a: Int end = record(a = 20) @19:44
  let %8: P = call m.first_spec1(%6, %7) @19:16
  let %9: Int = record_field(%8, a) @19:16
  let %10: String = call conv.int(%9) @19:7
  let %11: String = prim <>(%10, "\n") @9:50
  let %12: Ok = call writer.putString(wOut, %11) @9:28
  let %13: Record a: Int end = record(a = 30) @25:35
  let y.2: P = %13 @25:9
  let %14: Int = record_field(y.2, a) @25:9
  let %15: String = call conv.int(%14) @27:7
  let %16: String = prim <>(%15, "\n") @9:50
  let %17: Ok = call writer.putString(wOut, %16) @9:28
  let %18: Record a: Int end = record(a = 40) @30:80
  let y.3: P = %18 @30:54
  let %19: Int = record_field(y.3, a) @30:54
  let %20: String = call conv.int(%19) @31:7
  let %21: String = prim <>(%20, "\n") @9:50
  let %22: Ok = call writer.putString(wOut, %21) @9:28
  let %23: Record a: Int end = record(a = 50) @37:37
  let y.4: P = %23 @37:9
  let %24: Int = record_field(y.4, a) @37:9
  let %25: String = call conv.int(%24) @39:7
  let %26: String = prim <>(%25, "\n") @9:50
  let %27: Ok = call writer.putString(wOut, %26) @9:28
}

