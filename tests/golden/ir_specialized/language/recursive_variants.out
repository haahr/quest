import writer = "writer" : Writer
import conv = "conv" : Conv
import dynamic = "dynamic" : Dynamic
main {
  let wOut: writer.T = member writer.output @7:12
  let one: Expr = variant(num, 1) @17:17
  let %1: Tuple l: Expr r: Expr end = tuple(one, one) @18:42
  let two: Expr = variant(add, %1) @18:17
  let %2: Tuple l: Expr r: Expr end = tuple(one, two) @19:40
  let e: Expr = variant(add, %2) @19:15
  funs rec {
    fun eval(x: Expr): Int {
      switch tag(x) { @21:5
        case num (n: Int): {
          return n @21:5
        }
        case add (p: Tuple l: Expr r: Expr end): {
          let %3: Expr = tuple_field(p, 0) @23:35
          let %4: Int = call eval(%3) @23:30
          let %5: Expr = tuple_field(p, 1) @23:47
          let %6: Int = call eval(%5) @23:42
          let %7: Int = prim +(%4, %6) @23:30
          return %7 @21:5
        }
        else: {
          return 0 @21:5
        }
      }
    }
  }
  let %8: Int = call eval(e) @26:10
  let %9: String = call conv.int(%8) @10:31
  do call writer.putString(wOut, %9) @10:9
  let %10: Ok = call writer.putString(wOut, "\n") @11:9
  let %11: Int = call eval(e) @30:10
  let %12: String = call conv.int(%11) @10:31
  do call writer.putString(wOut, %12) @10:9
  let %13: Ok = call writer.putString(wOut, "\n") @11:9
  let %14: Int = call eval(e) @33:10
  let %15: Int = prim +(%14, 7) @33:10
  let %16: String = call conv.int(%15) @10:31
  do call writer.putString(wOut, %16) @10:9
  let %17: Ok = call writer.putString(wOut, "\n") @11:9
  let %18: T = call dynamic.new [Expr](e) @36:29
  let back: Expr = call dynamic.be [Expr](%18) @36:12
  let %19: Int = call eval(back) @37:10
  let %20: String = call conv.int(%19) @10:31
  do call writer.putString(wOut, %20) @10:9
  let %21: Ok = call writer.putString(wOut, "\n") @11:9
  join k2(r: Int) {
    let %22: String = call conv.int(r) @10:31
    do call writer.putString(wOut, %22) @10:9
    let %23: Ok = call writer.putString(wOut, "\n") @11:9
    let %24: Tuple l: Expr r: Expr end = payload(back, add) @39:15
    let %25: Expr = tuple_field(%24, 1) @39:15
    let %26: Int = call eval(%25) @39:10
    let %27: String = call conv.int(%26) @10:31
    do call writer.putString(wOut, %27) @10:9
    let %28: Ok = call writer.putString(wOut, "\n") @11:9
    let %29: T = call dynamic.new [Expr](e) @43:28
    let e2: Expr2 = call dynamic.be [Expr2](%29) @43:10
    join k3(r.1: Int) {
      let %30: String = call conv.int(r.1) @10:31
      do call writer.putString(wOut, %30) @10:9
      let %31: Ok = call writer.putString(wOut, "\n") @11:9
      let l: RExpr(Int) = variant(num, 4) @47:19
      let r.2: RExpr(Int) = variant(num, 5) @47:64
      let %32: Tuple l: Rec(E :: TYPE) Variant num: Int add: Tuple l: E r: E end end r: Rec(E :: TYPE) Variant num: Int add: Tuple l: E r: E end end end = tuple(l, r.2) @47:5
      let re: RExpr(Int) = variant(add, %32) @46:22
      let %33: T = call dynamic.new [RExpr(Int)](re) @48:32
      let %34: Expr = call dynamic.be [Expr](%33) @48:15
      let %35: Int = call eval(%34) @48:10
      let %36: String = call conv.int(%35) @10:31
      do call writer.putString(wOut, %36) @10:9
      let %37: Ok = call writer.putString(wOut, "\n") @11:9
      join k4(o: Int) {
        let %38: String = call conv.int(o) @10:31
        do call writer.putString(wOut, %38) @10:9
        let %39: Ok = call writer.putString(wOut, "\n") @11:9
      } in {
        let %40: Exception = member dynamic.error @55:10
        try catching (%40) {
          join k5(r.3: Int) {
            jump k4(r.3) @53:5
          } in {
            let %41: T = call dynamic.new [Expr](e) @54:30
            let %42: Other = call dynamic.be [Other](%41) @54:12
            let %43: Bool = is_tag(%42, num) @54:12
            if %43 { @54:9
              jump k5(1) @54:9
            } else {
              jump k5(0) @54:9
            }
          }
        } handle (e.1: Exception) {
          let %44: Bool = prim is(e.1, %40) @53:5
          if %44 { @53:5
            jump k4(-1) @53:5
          } else {
            reraise e.1 @53:5
          }
        }
      }
    } in {
      let %45: Bool = is_tag(e2, add) @44:13
      if %45 { @44:10
        jump k3(1) @44:10
      } else {
        jump k3(0) @44:10
      }
    }
  } in {
    let %46: Bool = is_tag(back, add) @38:13
    if %46 { @38:10
      jump k2(1) @38:10
    } else {
      jump k2(0) @38:10
    }
  }
}

