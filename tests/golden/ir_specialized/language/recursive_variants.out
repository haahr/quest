import writer = "writer" : Writer
import conv = "conv" : Conv
import dynamic = "dynamic" : Dynamic
main {
  let wOut: writer.T = member writer.output
  let one: Expr = variant(num, 1)
  let %1: Tuple l: Expr r: Expr end = tuple(one, one)
  let two: Expr = variant(add, %1)
  let %2: Tuple l: Expr r: Expr end = tuple(one, two)
  let e: Expr = variant(add, %2)
  funs rec {
    fun eval(x: Expr): Int {
      switch tag(x) {
        case num (n: Int): {
          return n
        }
        case add (p: Tuple l: Expr r: Expr end): {
          let %3: Expr = tuple_field(p, 0)
          let %4: Int = call eval(%3)
          let %5: Expr = tuple_field(p, 1)
          let %6: Int = call eval(%5)
          let %7: Int = prim +(%4, %6)
          return %7
        }
        else: {
          return 0
        }
      }
    }
  }
  let %8: Int = call eval(e)
  let %9: String = call conv.int(%8)
  do call writer.putString(wOut, %9)
  let %10: Ok = call writer.putString(wOut, "\n")
  let %11: Int = call eval(e)
  let %12: String = call conv.int(%11)
  do call writer.putString(wOut, %12)
  let %13: Ok = call writer.putString(wOut, "\n")
  let %14: Int = call eval(e)
  let %15: Int = prim +(%14, 7)
  let %16: String = call conv.int(%15)
  do call writer.putString(wOut, %16)
  let %17: Ok = call writer.putString(wOut, "\n")
  let %18: T = call dynamic.new [Expr](e)
  let back: Expr = call dynamic.be [Expr](%18)
  let %19: Int = call eval(back)
  let %20: String = call conv.int(%19)
  do call writer.putString(wOut, %20)
  let %21: Ok = call writer.putString(wOut, "\n")
  join k2(r: Int) {
    let %22: String = call conv.int(r)
    do call writer.putString(wOut, %22)
    let %23: Ok = call writer.putString(wOut, "\n")
    let %24: Tuple l: Expr r: Expr end = payload(back, add)
    let %25: Expr = tuple_field(%24, 1)
    let %26: Int = call eval(%25)
    let %27: String = call conv.int(%26)
    do call writer.putString(wOut, %27)
    let %28: Ok = call writer.putString(wOut, "\n")
    let %29: T = call dynamic.new [Expr](e)
    let e2: Expr2 = call dynamic.be [Expr2](%29)
    join k3(r.1: Int) {
      let %30: String = call conv.int(r.1)
      do call writer.putString(wOut, %30)
      let %31: Ok = call writer.putString(wOut, "\n")
      let l: RExpr(Int) = variant(num, 4)
      let r.2: RExpr(Int) = variant(num, 5)
      let %32: Tuple l: Rec(E :: TYPE) Variant num: Int add: Tuple l: E r: E end end r: Rec(E :: TYPE) Variant num: Int add: Tuple l: E r: E end end end = tuple(l, r.2)
      let re: RExpr(Int) = variant(add, %32)
      let %33: T = call dynamic.new [RExpr(Int)](re)
      let %34: Expr = call dynamic.be [Expr](%33)
      let %35: Int = call eval(%34)
      let %36: String = call conv.int(%35)
      do call writer.putString(wOut, %36)
      let %37: Ok = call writer.putString(wOut, "\n")
      join k4(o: Int) {
        let %38: String = call conv.int(o)
        do call writer.putString(wOut, %38)
        let %39: Ok = call writer.putString(wOut, "\n")
      } in {
        let %40: Exception = member dynamic.error
        try catching (%40) {
          join k5(r.3: Int) {
            jump k4(r.3)
          } in {
            let %41: T = call dynamic.new [Expr](e)
            let %42: Other = call dynamic.be [Other](%41)
            let %43: Bool = is_tag(%42, num)
            if %43 {
              jump k5(1)
            } else {
              jump k5(0)
            }
          }
        } handle (e.1: Exception) {
          let %44: Bool = prim is(e.1, %40)
          if %44 {
            jump k4(-1)
          } else {
            reraise e.1
          }
        }
      }
    } in {
      let %45: Bool = is_tag(e2, add)
      if %45 {
        jump k3(1)
      } else {
        jump k3(0)
      }
    }
  } in {
    let %46: Bool = is_tag(back, add)
    if %46 {
      jump k2(1)
    } else {
      jump k2(0)
    }
  }
}

