import writer = "writer" : Writer
import conv = "conv" : Conv
import dynamic = "dynamic" : Dynamic
main {
  let myCar: Car = record(age = 3, fuel = "diesel")
  let %1: Tuple a: Int end = tuple(42)
  let %2: Boxed = auto[Int](%1)
  let %3: Tuple a: Car end = tuple(myCar)
  let %4: Boxed = auto[Car](%3)
  join k1(r: Int) {
    let %5: writer.T = member writer.output
    let %6: String = call conv.int(r)
    let %7: String = prim <>(%6, "\n")
    let %8: Ok = call writer.putString(%5, %7)
    join k2(r.1: String) {
      let %9: writer.T = member writer.output
      let %10: String = prim <>(r.1, "\n")
      let %11: Ok = call writer.putString(%9, %10)
      join inlined1(%12: Int) {
        let %13: writer.T = member writer.output
        let %14: String = call conv.int(%12)
        let %15: String = prim <>(%14, "\n")
        let %16: Ok = call writer.putString(%13, %15)
        join inlined2(%17: Int) {
          let %18: writer.T = member writer.output
          let %19: String = call conv.int(%17)
          let %20: String = prim <>(%19, "\n")
          let %21: Ok = call writer.putString(%18, %20)
          let %22: Record age: Int end = record(age = 0)
          join inlined3(%23: Object) {
            let %24: Int = record_field(%23, age)
            let %25: writer.T = member writer.output
            let %26: String = call conv.int(%24)
            let %27: String = prim <>(%26, "\n")
            let %28: Ok = call writer.putString(%25, %27)
            let y: String = "twice"
            let %29: Tuple a: String end = tuple(y)
            let %30: Boxed = auto[String](%29)
            join k4(r.2: String) {
              let %31: writer.T = member writer.output
              let %32: String = prim <>(r.2, "\n")
              let %33: Ok = call writer.putString(%31, %32)
              let %34: T = call dynamic.new [Int](7)
              let %35: Dynamic = %34
              let %36: Int = call dynamic.be [Int](%35)
              let %37: writer.T = member writer.output
              let %38: String = call conv.int(%36)
              let %39: String = prim <>(%38, "\n")
              let %40: Ok = call writer.putString(%37, %39)
              join k5(r.3: Int) {
                let %41: writer.T = member writer.output
                let %42: String = call conv.int(r.3)
                let %43: String = prim <>(%42, "\n")
                let %44: Ok = call writer.putString(%41, %43)
                funs {
                  fun f(n: Int): String {
                    let %45: Int = prim *(n, 10)
                    let %46: String = call conv.int(%45)
                    return %46
                  }
                }
                let f.1: Fun(_: Int): String = f
                let %47: Tuple x: Int show: Fun(_: Int): String end = tuple(5, f.1)
                let %48: Showable = auto[Int](%47)
                join k6(r.4: String) {
                  let %49: writer.T = member writer.output
                  let %50: String = prim <>(r.4, "\n")
                  let %51: Ok = call writer.putString(%49, %50)
                } in {
                  inspect %48 {
                    case Int exact (i: Tuple x: Int show: Fun(_: Int): String end): {
                      let %52: Fun(_: Int): String = tuple_field(i, 1)
                      let %53: Int = tuple_field(i, 0)
                      let %54: String = call %52(%53)
                      jump k6(%54)
                    }
                    else: {
                      jump k6("?")
                    }
                  }
                }
              } in {
                let %55: T = call dynamic.new [Car](myCar)
                let %56: Dynamic = %55
                inspect %56 {
                  case Object (o: Tuple a: Object end): {
                    let %57: Object = tuple_field(o, 0)
                    let %58: Int = record_field(%57, age)
                    jump k5(%58)
                  }
                  else: {
                    jump k5(0)
                  }
                }
              }
            } in {
              inspect %30 {
                case String (t: Tuple a: String end): {
                  let %59: String = tuple_field(t, 0)
                  jump k4(%59)
                }
                else: {
                  jump k4("?")
                }
              }
            }
          } in {
            let default: Object = %22
            inspect %4 {
              case Object (x: Tuple a: Object end): {
                let %60: Object = tuple_field(x, 0)
                jump inlined3(%60)
              }
              else: {
                jump inlined3(default)
              }
            }
          }
        } in {
          inspect %4 {
            case Int (x.1: Tuple a: Int end): {
              let %61: Int = tuple_field(x.1, 0)
              jump inlined2(%61)
            }
            else: {
              jump inlined2(-1)
            }
          }
        }
      } in {
        inspect %2 {
          case Int (x.2: Tuple a: Int end): {
            let %62: Int = tuple_field(x.2, 0)
            jump inlined1(%62)
          }
          else: {
            jump inlined1(0)
          }
        }
      }
    } in {
      inspect %4 {
        case Car (c: Tuple a: Car end): {
          let %63: Car = tuple_field(c, 0)
          let %64: String = record_field(%63, fuel)
          jump k2(%64)
        }
        else: {
          jump k2("?")
        }
      }
    }
  } in {
    inspect %2 {
      case Int (i.1: Tuple a: Int end): {
        let %65: Int = tuple_field(i.1, 0)
        jump k1(%65)
      }
      else: {
        jump k1(0)
      }
    }
  }
}

