import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output
  let %1: Record a: Int end = record(a = 2)
  let y: P = %1
  let %2: Int = record_field(y, a)
  let %3: String = call conv.int(%2)
  let %4: String = prim <>(%3, "\n")
  let %5: Ok = call writer.putString(wOut, %4)
  let %6: Record a: Int end = record(a = 10)
  let x: P = %6
  let %7: Int = record_field(x, a)
  let %8: Int = prim +(%7, 1)
  let %9: String = call conv.int(%8)
  let %10: String = prim <>(%9, "\n")
  let %11: Ok = call writer.putString(wOut, %10)
  let %12: Record a: Int end = record(a = 20)
  let y.1: P = %12
  let %13: Int = record_field(y.1, a)
  let %14: Int = prim +(%13, 2)
  let %15: String = call conv.int(%14)
  let %16: String = prim <>(%15, "\n")
  let %17: Ok = call writer.putString(wOut, %16)
  var total: Int = 0
  var i: Int = 1
  loop L1_9 {
    let %18: Bool = prim <=(i, 3)
    if %18 {
      let i.1: Int = i
      let %19: Int = prim +(total, i.1)
      total := %19
      let %20: Int = prim +(i, 1)
      i := %20
    } else {
      break L1_9
    }
  }
  let %21: Int = total
  let %22: String = call conv.int(%21)
  let %23: String = prim <>(%22, "\n")
  let %24: Ok = call writer.putString(wOut, %23)
  funs rec {
    fun last [A::TYPE](x.1: A, y.2: A, m: Int): A {
      let %25: Bool = prim is(m, 0)
      if %25 {
        return x.1
      } else {
        let %26: Int = prim -(m, 1)
        let %27: A = call last [A](y.2, x.1, %26)
        return %27
      }
    }
    fun last_spec(x.2: P, y.3: P, m.1: Int): P {
      let %28: Bool = prim is(m.1, 0)
      if %28 {
        return x.2
      } else {
        let %29: Int = prim -(m.1, 1)
        let %30: P = call last_spec(y.3, x.2, %29)
        return %30
      }
    }
  }
  let %31: Record a: Int end = record(a = 1)
  let %32: Record a: Int end = record(a = 7)
  let %33: P = call last_spec(%31, %32, 3)
  let %34: Int = record_field(%33, a)
  let %35: String = call conv.int(%34)
  let %36: String = prim <>(%35, "\n")
  let %37: Ok = call writer.putString(wOut, %36)
}

