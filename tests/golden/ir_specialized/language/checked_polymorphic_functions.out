import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @6:12
  funs {
    fun first [X::TYPE Y::TYPE](x: X, y: Y): X {
      return x
    }
  }
  let %1: String = call conv.int(1) @14:7
  let %2: String = prim <>(%1, "\n") @7:50
  let %3: Ok = call writer.putString(wOut, %2) @7:28
  funs {
    fun widen [A::TYPE B::<: A](x.1: B): A {
      return x.1
    }
  }
  let %4: Int = call widen [Int Int](2) @18:16
  let %5: String = call conv.int(%4) @18:7
  let %6: String = prim <>(%5, "\n") @7:50
  let %7: Ok = call writer.putString(wOut, %6) @7:28
  funs {
    fun view [A::<: P B::<: A](x.2: B): A {
      return x.2
    }
    fun view_spec(x.3: Q): P {
      return x.3
    }
  }
  let %8: Record a: Int b: Int end = record(a = 3, b = 30) @20:27
  let %9: P = call view_spec(%8) @20:16
  let %10: Int = record_field(%9, a) @20:16
  let %11: String = call conv.int(%10) @20:7
  let %12: String = prim <>(%11, "\n") @7:50
  let %13: Ok = call writer.putString(wOut, %12) @7:28
  funs {
    fun getA [X::<: Q](x.4: X): Int {
      let %14: Int = record_field(x.4, a) @23:56
      return %14
    }
    fun getA_spec(x.5: Q): Int {
      let %15: Int = record_field(x.5, a) @23:56
      return %15
    }
  }
  let %16: Record a: Int b: Int end = record(a = 4, b = 40) @24:24
  let %17: Int = call getA_spec(%16) @24:16
  let %18: String = call conv.int(%17) @24:7
  let %19: String = prim <>(%18, "\n") @7:50
  let %20: Ok = call writer.putString(wOut, %19) @7:28
  funs {
    fun pick [X::<: Q](x.6: X): X {
      return x.6
    }
    fun pick_spec(x.7: Q): Q {
      return x.7
    }
  }
  let %21: Record a: Int b: Int end = record(a = 5, b = 50) @26:24
  let %22: Q = call pick_spec(%21) @26:16
  let %23: Int = record_field(%22, b) @26:16
  let %24: String = call conv.int(%23) @26:7
  let %25: String = prim <>(%24, "\n") @7:50
  let %26: Ok = call writer.putString(wOut, %25) @7:28
  let %27: String = call conv.bool(true) @30:7
  let %28: String = prim <>(%27, "\n") @7:50
  let %29: Ok = call writer.putString(wOut, %28) @7:28
  let firstInt: Fun(x: Int y: Int): Int = type_app first [Int Int] @33:16
  let %30: Int = call firstInt(6, 60) @34:16
  let %31: String = call conv.int(%30) @34:7
  let %32: String = prim <>(%31, "\n") @7:50
  let %33: Ok = call writer.putString(wOut, %32) @7:28
}

