import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output
  let p: Record x: Int y: Int end = record(x = 42, y = 100)
  let a: Point = p
  let %1: Int = record_field(a, x)
  let %2: String = call conv.int(%1)
  do call writer.putString(wOut, %2)
  let %3: Ok = call writer.putString(wOut, "\n")
  let %4: Int = record_field(a, y)
  let %5: String = call conv.int(%4)
  do call writer.putString(wOut, %5)
  let %6: Ok = call writer.putString(wOut, "\n")
  let b: Point = p
  let %7: String = call conv.int(10)
  do call writer.putString(wOut, %7)
  let %8: Ok = call writer.putString(wOut, "\n")
  let %9: Int = record_field(b, x)
  let %10: String = call conv.int(%9)
  do call writer.putString(wOut, %10)
  let %11: Ok = call writer.putString(wOut, "\n")
}

