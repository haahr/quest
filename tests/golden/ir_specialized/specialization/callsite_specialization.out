import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @6:12
  let p: Record x: Int y: Int end = record(x = 42, y = 100) @16:9
  let a: Point = p @17:12
  let %1: Int = record_field(a, x) @18:10
  let %2: String = call conv.int(%1) @9:31
  do call writer.putString(wOut, %2) @9:9
  let %3: Ok = call writer.putString(wOut, "\n") @10:9
  let %4: Int = record_field(a, y) @19:10
  let %5: String = call conv.int(%4) @9:31
  do call writer.putString(wOut, %5) @9:9
  let %6: Ok = call writer.putString(wOut, "\n") @10:9
  let b: Point = p @24:10
  let %7: String = call conv.int(10) @9:31
  do call writer.putString(wOut, %7) @9:9
  let %8: Ok = call writer.putString(wOut, "\n") @10:9
  let %9: Int = record_field(b, x) @26:10
  let %10: String = call conv.int(%9) @9:31
  do call writer.putString(wOut, %10) @9:9
  let %11: Ok = call writer.putString(wOut, "\n") @10:9
}

