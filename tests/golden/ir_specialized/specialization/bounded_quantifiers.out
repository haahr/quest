import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @6:12
  funs {
    fun getX [A::<: Point](p: A): Int {
      let %1: Int = record_field(p, x) @16:34
      return %1
    }
    fun getX_spec(p.1: Point3D): Int {
      let %2: Int = record_field(p.1, x) @16:34
      return %2
    }
  }
  funs {
    fun getY [A::<: Point](p.2: A): Int {
      let %3: Int = record_field(p.2, y) @17:34
      return %3
    }
    fun getY_spec(p.3: Point3D): Int {
      let %4: Int = record_field(p.3, y) @17:34
      return %4
    }
  }
  let p.4: Record x: Int y: Int z: Int end = record(x = 42, y = 100, z = 999) @19:9
  let %5: Int = call getX_spec(p.4) @20:10
  let %6: String = call conv.int(%5) @9:31
  do call writer.putString(wOut, %6) @9:9
  let %7: Ok = call writer.putString(wOut, "\n") @10:9
  let %8: Int = call getY_spec(p.4) @21:10
  let %9: String = call conv.int(%8) @9:31
  do call writer.putString(wOut, %9) @9:9
  let %10: Ok = call writer.putString(wOut, "\n") @10:9
  funs {
    fun identity [A::<: Point](p.5: A): A {
      return p.5
    }
    fun identity_spec(p.6: Point3D): Point3D {
      return p.6
    }
  }
  let p2: Point3D = call identity_spec(p.4) @24:19
  let %11: Int = record_field(p2, x) @25:10
  let %12: String = call conv.int(%11) @9:31
  do call writer.putString(wOut, %12) @9:9
  let %13: Ok = call writer.putString(wOut, "\n") @10:9
  let %14: Int = record_field(p2, z) @26:10
  let %15: String = call conv.int(%14) @9:31
  do call writer.putString(wOut, %15) @9:9
  let %16: Ok = call writer.putString(wOut, "\n") @10:9
}

