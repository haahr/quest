import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output
  funs {
    fun getX [A::<: Point](p: A): Int {
      let %1: Int = record_field(p, x)
      return %1
    }
    fun getX_spec(p.1: Point3D): Int {
      let %2: Int = record_field(p.1, x)
      return %2
    }
  }
  funs {
    fun getY [A::<: Point](p.2: A): Int {
      let %3: Int = record_field(p.2, y)
      return %3
    }
    fun getY_spec(p.3: Point3D): Int {
      let %4: Int = record_field(p.3, y)
      return %4
    }
  }
  let p.4: Record x: Int y: Int z: Int end = record(x = 42, y = 100, z = 999)
  let %5: Int = call getX_spec(p.4)
  let %6: String = call conv.int(%5)
  do call writer.putString(wOut, %6)
  let %7: Ok = call writer.putString(wOut, "\n")
  let %8: Int = call getY_spec(p.4)
  let %9: String = call conv.int(%8)
  do call writer.putString(wOut, %9)
  let %10: Ok = call writer.putString(wOut, "\n")
  funs {
    fun identity [A::<: Point](p.5: A): A {
      return p.5
    }
    fun identity_spec(p.6: Point3D): Point3D {
      return p.6
    }
  }
  let p2: Point3D = call identity_spec(p.4)
  let %11: Int = record_field(p2, x)
  let %12: String = call conv.int(%11)
  do call writer.putString(wOut, %12)
  let %13: Ok = call writer.putString(wOut, "\n")
  let %14: Int = record_field(p2, z)
  let %15: String = call conv.int(%14)
  do call writer.putString(wOut, %15)
  let %16: Ok = call writer.putString(wOut, "\n")
}

