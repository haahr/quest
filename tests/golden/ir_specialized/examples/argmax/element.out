import arrayOp = "arrayOp" : ArrayOp
import string = "string" : StringOp
main {
  let empty: Exception = exception empty
  let words: Array(String) = array("pear", "fig", "banana", "kiwi")
  let %1: Fun(string: String): Int = member string.length
  let %2: Fun(a: Int b: Int): Bool = builtin >
  let key: Fun(e: String): Int = %1
  let isGreater: Fun(x: Int y: Int): Bool = %2
  let n: Int = prim extent(words)
  let %3: Bool = prim is(n, 0)
  if %3 {
    raise empty
  }
  var best: Int = 0
  let %4: String = index(words, 0)
  let %5: Int = call key(%4)
  var bestKey: Int = %5
  let %6: Int = prim -(n, 1)
  var i: Int = 1
  loop L1_1 {
    let %7: Bool = prim <=(i, %6)
    if %7 {
      let i.1: Int = i
      let %8: String = index(words, i.1)
      let k: Int = call key(%8)
      let %9: Bool = call isGreater(k, bestKey)
      if %9 {
        best := i.1
        bestKey := k
      }
      let %10: Int = prim +(i, 1)
      i := %10
    } else {
      break L1_1
    }
  }
  let %11: String = index(words, best)
}

