          (ExprString '{"quest":1,"types":[{"record":{"a":"Int"}}],"type":0,"value":{"a":3}}' '"{\\"quest\\":1,\\"types\\":[{\\"record\\":{\\"a\\":\\"Int\\"}}],\\"type\\":0,\\"value\\":{\\"a\\":3}}"')
