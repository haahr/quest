                :field 'close'
              )
              :args (
                (ExprId 'w')
              )
            )
          )
          (LetValueBinding
            :name 'r'
            :value (ExprApp
              :func (ExprSelect
                :target (ExprId 'reader')
                :field 'file'
              )
              :args (
                (ExprString 'document.json' '"document.json"')
              )
            )
          )
          (ExprStmt
            :expr (ExprApp
              :func (ExprId 'print')
              :args (
                (ExprInfix
                  :left (ExprId 'name')
                  :op '<>'
                  :right (ExprInfix
                    :left (ExprString ': ' '": "')
                    :op '<>'
                    :right (ExprTry
                      :body (ExprInfix
                        :left (ExprString 'a = ' '"a = "')
                        :op '<>'
                        :right (ExprApp
                          :func (ExprSelect
                            :target (ExprId 'conv')
                            :field 'int'
                          )
                          :args (
                            (ExprSelect
                              :target (ExprApp
                                :func (ExprSelect
                                  :target (ExprId 'dynamic')
                                  :field 'be'
                                )
                                :args (
                                  (TypeArgument
                                    :type_val (TypePath ('R'))
                                  )
                                  (ExprApp
                                    :func (ExprSelect
                                      :target (ExprId 'dynamic')
                                      :field 'intern'
                                    )
                                    :args (
                                      (ExprId 'r')
                                    )
                                  )
                                )
                              )
                              :field 'a'
                            )
                          )
                        )
                      )
                      :branches (
                        (TryBranch
                          :exc_pattern (ExprSelect
                            :target (ExprId 'dynamic')
                            :field 'error'
                          )
                          :body (ExprString 'dynamic.error' '"dynamic.error"')
                        )
                      )
                    )
                  )
                )
              )
            )
          )
          (ExprStmt
