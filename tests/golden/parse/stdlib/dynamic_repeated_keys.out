    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'read')
        :args (
          (ExprString 'the type repeats a field' '"the type repeats a field"')
          (ExprString '{"quest":1,"types":[{"record":{"a":"Int","a":"Int"}}],"type":0,"value":{"a":1}}' '"{\\"quest\\":1,\\"types\\":[{\\"record\\":{\\"a\\":\\"Int\\",\\"a\\":\\"Int\\"}}],\\"type\\":0,\\"value\\":{\\"a\\":1}}"')
        )
