(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('writer') 'Writer')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('reader') 'Reader')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('dynamic') 'Dynamic')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('conv') 'Conv')
      )
    )
    (LetValueBinding
      :name 'print'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprInfix
            :left (ExprId 's')
            :op '<>'
            :right (ExprString '\n' '"\\n"')
          )
        )
      )
      :params (
        (FormalParam
          :name 's'
          :type_annot (TypePath ('String'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Ok'))
    )
    (TypeBinding
      :name 'R'
      :type_val (TypeRecord
        :fields (
          (RecordFieldSig
            :name 'a'
            :type_sig (TypePath ('Int'))
          )
        )
      )
    )
    (LetValueBinding
      :name 'names'
      :value (ExprArray
        :elements (
          (ExprString 'well-formed' '"well-formed"')
          (ExprString 'the value repeats a field' '"the value repeats a field"')
          (ExprString 'well-formed' '"well-formed"')
          (ExprString 'the type repeats a field' '"the type repeats a field"')
          (ExprString 'well-formed' '"well-formed"')
          (ExprString 'both repeat it' '"both repeat it"')
          (ExprString 'well-formed' '"well-formed"')
          (ExprString 'a repeated key in an array, after a string of brackets' '"a repeated key in an array, after a string of brackets"')
          (ExprString 'well-formed' '"well-formed"')
          (ExprString 'an escape above \\u00ff' '"an escape above \\\\u00ff"')
          (ExprString 'well-formed' '"well-formed"')
          (ExprString 'another version' '"another version"')
          (ExprString 'well-formed' '"well-formed"')
        )
      )
    )
    (ExprStmt
      :expr (ExprFor
        :var_name 'i'
        :start (ExprInt 0 '0')
        :stop (ExprInfix
          :left (ExprApp
            :func (ExprId 'extent')
            :args (
              (ExprId 'names')
            )
          )
          :op '-'
          :right (ExprInt 1 '1')
        )
        :body (ExprApp
          :func (ExprId 'print')
          :args (
            (ExprInfix
              :left (ExprIndex
                :target (ExprId 'names')
                :index (ExprId 'i')
              )
              :op '<>'
              :right (ExprInfix
                :left (ExprString ': ' '": "')
                :op '<>'
                :right (ExprTry
                  :body (ExprInfix
                    :left (ExprString 'a = ' '"a = "')
                    :op '<>'
                    :right (ExprApp
                      :func (ExprSelect
                        :target (ExprId 'conv')
                        :field 'int'
                      )
                      :args (
                        (ExprSelect
                          :target (ExprApp
                            :func (ExprSelect
                              :target (ExprId 'dynamic')
                              :field 'be'
                            )
                            :args (
                              (TypeArgument
                                :type_val (TypePath ('R'))
                              )
                              (ExprApp
                                :func (ExprSelect
                                  :target (ExprId 'dynamic')
                                  :field 'intern'
                                )
                                :args (
                                  (ExprSelect
                                    :target (ExprId 'reader')
                                    :field 'input'
                                  )
                                )
                              )
                            )
                          )
                          :field 'a'
                        )
                      )
                    )
                  )
                  :branches (
                    (TryBranch
                      :exc_pattern (ExprSelect
                        :target (ExprId 'dynamic')
                        :field 'error'
                      )
                      :body (ExprString 'dynamic.error' '"dynamic.error"')
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
