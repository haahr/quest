          :type_annot (TypePath ('String'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Ok'))
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'read')
        :args (
          (ExprString 'the value repeats a field' '"the value repeats a field"')
          (ExprString '{"quest":1,"types":[{"record":{"a":"Int"}}],"type":0,"value":{"a":1,"a":2}}' '"{\\"quest\\":1,\\"types\\":[{\\"record\\":{\\"a\\":\\"Int\\"}}],\\"type\\":0,\\"value\\":{\\"a\\":1,\\"a\\":2}}"')
        )
