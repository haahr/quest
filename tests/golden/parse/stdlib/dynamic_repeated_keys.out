          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprInfix
            :left (ExprId 's')
            :op '<>'
            :right (ExprString '\n' '"\\n"')
          )
        )
      )
      :params (
        (FormalParam
          :name 's'
          :type_annot (TypePath ('String'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Ok'))
    )
    (TypeBinding
      :name 'R'
      :type_val (TypeRecord
        :fields (
          (RecordFieldSig
            :name 'a'
            :type_sig (TypePath ('Int'))
          )
        )
      )
    )
    (LetValueBinding
      :name 'read'
      :value (ExprBlock
        :bindings (
          (LetValueBinding
            :name 'w'
            :value (ExprApp
              :func (ExprSelect
                :target (ExprId 'writer')
                :field 'file'
              )
              :args (
                (ExprString 'document.json' '"document.json"')
              )
            )
          )
          (ExprStmt
            :expr (ExprApp
              :func (ExprSelect
