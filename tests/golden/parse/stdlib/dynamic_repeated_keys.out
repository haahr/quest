        :args (
          (ExprString 'both repeat it' '"both repeat it"')
          (ExprString '{"quest":1,"types":[{"record":{"a":"Int","a":"Int"}}],"type":0,"value":{"a":1,"a":2}}' '"{\\"quest\\":1,\\"types\\":[{\\"record\\":{\\"a\\":\\"Int\\",\\"a\\":\\"Int\\"}}],\\"type\\":0,\\"value\\":{\\"a\\":1,\\"a\\":2}}"')
        )
