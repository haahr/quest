(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('system') 'System')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('writer') 'Writer')
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprString '' '""')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'system')
          :field 'sysexit'
        )
        :args (
          (ExprInt 200 '200')
        )
      )
    )
  )
)
