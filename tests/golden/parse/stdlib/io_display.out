(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('display') 'Display' ('io/display') 'io/Display')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('writer') 'Writer')
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprString 'before\n' '"before\\n"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'display')
          :field 'inKernel'
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'display')
          :field 'html'
        )
        :args (
          (ExprString '<b>bold</b>' '"<b>bold</b>"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'display')
          :field 'markdown'
        )
        :args (
          (ExprString '# A heading' '"# A heading"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'display')
          :field 'svg'
        )
        :args (
          (ExprString '<svg/>' '"<svg/>"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'display')
          :field 'png'
        )
        :args (
          (ExprString '\x89PNG' '"\\137PNG"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'display')
          :field 'bundle'
        )
        :args (
          (ExprArray
            :elements (
              (ExprTuple
                :fields (
                  (TupleBinding
                    :name 'mimeType'
                    :value (ExprString 'application/json' '"application/json"')
                  )
                  (TupleBinding
                    :name 'data'
                    :value (ExprString '{}' '"{}"')
                  )
                )
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'display')
          :field 'bundle'
        )
        :args (
          (ExprArray
            :elements (
              (ExprTuple
                :fields (
                  (TupleBinding
                    :name 'mimeType'
                    :value (ExprString 'text/plain' '"text/plain"')
                  )
                  (TupleBinding
                    :name 'data'
                    :value (ExprString 'plain' '"plain"')
                  )
                )
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprString 'after\n' '"after\\n"')
        )
      )
    )
  )
)
