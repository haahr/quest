(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('system') 'System')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('writer') 'Writer')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('conv') 'Conv')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('real') 'RealOp')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('stringOp') 'StringOp' ('string'))
      )
    )
    (LetValueBinding
      :name 'print'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprInfix
            :left (ExprId 's')
            :op '<>'
            :right (ExprString '\n' '"\\n"')
          )
        )
      )
      :params (
        (FormalParam
          :name 's'
          :type_annot (TypePath ('String'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Ok'))
    )
    (LetValueBinding
      :name 'show'
      :value (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprInfix
            :left (ExprString 'code ' '"code "')
            :op '<>'
            :right (ExprInfix
              :left (ExprApp
                :func (ExprSelect
                  :target (ExprId 'conv')
                  :field 'int'
                )
                :args (
                  (ExprSelect
                    :target (ExprId 'r')
                    :field 'code'
                  )
                )
              )
              :op '<>'
              :right (ExprInfix
                :left (ExprString ', stdout [' '", stdout ["')
                :op '<>'
                :right (ExprInfix
                  :left (ExprSelect
                    :target (ExprId 'r')
                    :field 'stdout'
                  )
                  :op '<>'
                  :right (ExprInfix
                    :left (ExprString '], stderr [' '"], stderr ["')
                    :op '<>'
                    :right (ExprInfix
                      :left (ExprSelect
                        :target (ExprId 'r')
                        :field 'stderr'
                      )
                      :op '<>'
                      :right (ExprString ']' '"]"')
                    )
                  )
                )
              )
            )
          )
        )
      )
      :params (
        (FormalParam
          :name 'r'
          :type_annot (TypeTuple
            :fields (
              (FieldSig
                :name 'code'
                :type_sig (TypePath ('Int'))
                :mode VALUE
              )
              (FieldSig
                :name 'stdout'
                :type_sig (TypePath ('String'))
                :mode VALUE
              )
              (FieldSig
                :name 'stderr'
                :type_sig (TypePath ('String'))
                :mode VALUE
              )
            )
          )
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Ok'))
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'show')
        :args (
          (ExprApp
            :func (ExprSelect
              :target (ExprId 'system')
              :field 'run'
            )
            :args (
              (ExprArray
                :elements (
                  (ExprString 'echo' '"echo"')
                  (ExprString 'two  spaces' '"two  spaces"')
                  (ExprString '$HOME' '"$HOME"')
                )
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'show')
        :args (
          (ExprApp
            :func (ExprSelect
              :target (ExprId 'system')
              :field 'run'
            )
            :args (
              (ExprArray
                :elements (
                  (ExprString 'sh' '"sh"')
                  (ExprString '-c' '"-c"')
                  (ExprString 'echo out; echo err >&2; exit 3' '"echo out; echo err >&2; exit 3"')
                )
              )
            )
          )
        )
      )
    )
    (LetValueBinding
      :name 'big'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'system')
          :field 'run'
        )
        :args (
          (ExprArray
            :elements (
              (ExprString 'sh' '"sh"')
              (ExprString '-c' '"-c"')
              (ExprString 'i=0; while [ $i -lt 20000 ]; do echo line; i=$((i+1)); done' '"i=0; while [ $i -lt 20000 ]; do echo line; i=$((i+1)); done"')
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprInfix
            :left (ExprString 'big: ' '"big: "')
            :op '<>'
            :right (ExprInfix
              :left (ExprApp
                :func (ExprSelect
                  :target (ExprId 'conv')
                  :field 'int'
                )
                :args (
                  (ExprSelect
                    :target (ExprId 'big')
                    :field 'code'
                  )
                )
              )
              :op '<>'
              :right (ExprInfix
                :left (ExprString ' ' '" "')
                :op '<>'
                :right (ExprApp
                  :func (ExprSelect
                    :target (ExprId 'conv')
                    :field 'int'
                  )
                  :args (
                    (ExprApp
                      :func (ExprSelect
                        :target (ExprId 'stringOp')
                        :field 'length'
                      )
                      :args (
                        (ExprSelect
                          :target (ExprId 'big')
                          :field 'stdout'
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprInfix
            :left (ExprString 'killed: ' '"killed: "')
            :op '<>'
            :right (ExprApp
              :func (ExprSelect
                :target (ExprId 'conv')
                :field 'int'
              )
              :args (
                (ExprSelect
                  :target (ExprApp
                    :func (ExprSelect
                      :target (ExprId 'system')
                      :field 'run'
                    )
                    :args (
                      (ExprArray
                        :elements (
                          (ExprString 'sh' '"sh"')
                          (ExprString '-c' '"-c"')
                          (ExprString 'kill -9 $$' '"kill -9 $$"')
                        )
                      )
                    )
                  )
                  :field 'code'
                )
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprTry
            :body (ExprSelect
              :target (ExprApp
                :func (ExprSelect
                  :target (ExprId 'system')
                  :field 'run'
                )
                :args (
                  (ExprArray
                    :elements (
                      (ExprString 'no-such-program-quest' '"no-such-program-quest"')
                    )
                  )
                )
              )
              :field 'stdout'
            )
            :branches (
              (TryBranch
                :exc_pattern (ExprSelect
                  :target (ExprId 'system')
                  :field 'error'
                )
                :body (ExprString 'cannot run' '"cannot run"')
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprTry
            :body (ExprSelect
              :target (ExprApp
                :func (ExprSelect
                  :target (ExprId 'system')
                  :field 'run'
                )
                :args (
                  (ExprArray ())
                )
              )
              :field 'stdout'
            )
            :branches (
              (TryBranch
                :exc_pattern (ExprSelect
                  :target (ExprId 'system')
                  :field 'error'
                )
                :body (ExprString 'no program' '"no program"')
              )
            )
          )
        )
      )
    )
    (LetValueBinding
      :name 'f'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'file'
        )
        :args (
          (ExprString 'written.txt' '"written.txt"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprId 'f')
          (ExprString 'x' '"x"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'close'
        )
        :args (
          (ExprId 'f')
        )
      )
    )
    (LetValueBinding
      :name 't'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'system')
          :field 'modifiedTime'
        )
        :args (
          (ExprString 'written.txt' '"written.txt"')
        )
      )
    )
    (LetValueBinding
      :name 'again'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'system')
          :field 'modifiedTime'
        )
        :args (
          (ExprString 'written.txt' '"written.txt"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprInfix
            :left (ExprString 'time: ' '"time: "')
            :op '<>'
            :right (ExprInfix
              :left (ExprApp
                :func (ExprSelect
                  :target (ExprId 'conv')
                  :field 'bool'
                )
                :args (
                  (ExprApp
                    :func (ExprSelect
                      :target (ExprId 'real')
                      :field 'greater'
                    )
                    :args (
                      (ExprId 't')
                      (ExprReal 1000000000.0 '1000000000.0')
                    )
                  )
                )
              )
              :op '<>'
              :right (ExprInfix
                :left (ExprString ' ' '" "')
                :op '<>'
                :right (ExprApp
                  :func (ExprSelect
                    :target (ExprId 'conv')
                    :field 'bool'
                  )
                  :args (
                    (ExprInfix
                      :left (ExprApp
                        :func (ExprSelect
                          :target (ExprId 'real')
                          :field 'smallerEq'
                        )
                        :args (
                          (ExprId 't')
                          (ExprId 'again')
                        )
                      )
                      :op 'andif'
                      :right (ExprApp
                        :func (ExprSelect
                          :target (ExprId 'real')
                          :field 'greaterEq'
                        )
                        :args (
                          (ExprId 't')
                          (ExprId 'again')
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprTry
            :body (ExprApp
              :func (ExprSelect
                :target (ExprId 'conv')
                :field 'real'
              )
              :args (
                (ExprApp
                  :func (ExprSelect
                    :target (ExprId 'system')
                    :field 'modifiedTime'
                  )
                  :args (
                    (ExprString 'missing.txt' '"missing.txt"')
                  )
                )
              )
            )
            :branches (
              (TryBranch
                :exc_pattern (ExprSelect
                  :target (ExprId 'system')
                  :field 'error'
                )
                :body (ExprString 'missing' '"missing"')
              )
            )
          )
        )
      )
    )
  )
)
