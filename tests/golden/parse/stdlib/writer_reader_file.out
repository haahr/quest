(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('writer') 'Writer')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('reader') 'Reader')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('conv') 'Conv')
      )
    )
    (LetValueBinding
      :name 'w'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'file'
        )
        :args (
          (ExprString 'roundtrip.txt' '"roundtrip.txt"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprId 'w')
          (ExprString 'Hello from Quest Reader/Writer!\n' '"Hello from Quest Reader/Writer!\\n"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putChar'
        )
        :args (
          (ExprId 'w')
          (ExprChar 'X' "'X'")
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprId 'w')
          (ExprString '\n' '"\\n"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'flush'
        )
        :args (
          (ExprId 'w')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'close'
        )
        :args (
          (ExprId 'w')
        )
      )
    )
    (LetValueBinding
      :name 'r'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'reader')
          :field 'file'
        )
        :args (
          (ExprString 'roundtrip.txt' '"roundtrip.txt"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'reader')
          :field 'more'
        )
        :args (
          (ExprId 'r')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'reader')
          :field 'getString'
        )
        :args (
          (ExprId 'r')
          (ExprInt 32 '32')
        )
      )
    )
    (LetValueBinding
      :name 'ch'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'reader')
          :field 'getChar'
        )
        :args (
          (ExprId 'r')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'conv')
          :field 'char'
        )
        :args (
          (ExprId 'ch')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'reader')
          :field 'getChar'
        )
        :args (
          (ExprId 'r')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'reader')
          :field 'more'
        )
        :args (
          (ExprId 'r')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'reader')
          :field 'close'
        )
        :args (
          (ExprId 'r')
        )
      )
    )
  )
)
