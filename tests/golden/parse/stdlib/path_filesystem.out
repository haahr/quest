        :args (
          (ExprInfix
            :left (ExprString 'exists missing: ' '"exists missing: "')
            :op '<>'
            :right (ExprApp
              :func (ExprSelect
                :target (ExprId 'conv')
                :field 'bool'
              )
              :args (
                (ExprApp
                  :func (ExprSelect
                    :target (ExprId 'path')
                    :field 'exists'
                  )
                  :args (
                    (ExprApp
                      :func (ExprId 'at')
                      :args (
                        (ExprString 'work/missing' '"work/missing"')
