        :args (
          (ExprIf
            :cond (ExprApp
              :func (ExprSelect
                :target (ExprId 'system')
                :field 'isTerminal'
              )
              :args (
                (ExprId 'fd')
              )
            )
            :then_branch (ExprString 'terminal' '"terminal"')
            :else_branch (ExprString 'not a terminal' '"not a terminal"')
          )
        )
      )
      :params (
        (FormalParam
          :name 'fd'
          :type_annot (TypePath ('Int'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Ok'))
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'show')
        :args (
          (ExprInt 0 '0')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'show')
        :args (
          (ExprInt 1 '1')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'show')
        :args (
          (ExprInt 2 '2')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'show')
        :args (
          (ExprInt -1 '~1')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
