(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('system') 'System')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('writer') 'Writer')
      )
    )
    (LetValueBinding
      :name 'print'
      :value (ExprApp
        :func (ExprSelect
