                        :target (ExprId 'hashMap')
                        :field 'get'
                      )
                      :args (
                        (TypeArgument
                          :type_val (TypePath ('path' 'T'))
                        )
                        (TypeArgument
                          :type_val (TypePath ('Int'))
                        )
                        (ExprId 'm')
                        (ExprApp
                          :func (ExprId 'at')
                          :args (
                            (ExprString 'src/x.quest' '"src/x.quest"')
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
