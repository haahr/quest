(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('fileStats') 'FileStats' ('os/fileStats') 'os/FileStats')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('maybe') 'Maybe' ('util/maybe') 'util/Maybe')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('system') 'System')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('writer') 'Writer')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('conv') 'Conv')
      )
    )
    (LetValueBinding
      :name 'print'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprInfix
            :left (ExprId 's')
            :op '<>'
            :right (ExprString '\n' '"\\n"')
          )
        )
      )
      :params (
        (FormalParam
          :name 's'
          :type_annot (TypePath ('String'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Ok'))
    )
    (LetValueBinding
      :name 'sh'
      :value (ExprBlock
        :bindings (
          (LetValueBinding
            :name 'r'
            :value (ExprApp
              :func (ExprSelect
                :target (ExprId 'system')
                :field 'run'
              )
              :args (
                (ExprArray
                  :elements (
                    (ExprString 'sh' '"sh"')
                    (ExprString '-c' '"-c"')
                    (ExprId 'command')
                  )
                )
              )
            )
          )
          (ExprStmt
            :expr (ExprIf
              :cond (ExprInfix
                :left (ExprSelect
                  :target (ExprId 'r')
                  :field 'code'
                )
                :op 'isnot'
                :right (ExprInt 0 '0')
              )
              :then_branch (ExprApp
                :func (ExprId 'print')
                :args (
                  (ExprInfix
                    :left (ExprString 'failed: ' '"failed: "')
                    :op '<>'
                    :right (ExprInfix
                      :left (ExprId 'command')
                      :op '<>'
                      :right (ExprInfix
                        :left (ExprString ': ' '": "')
                        :op '<>'
                        :right (ExprSelect
                          :target (ExprId 'r')
                          :field 'stderr'
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
      :params (
        (FormalParam
          :name 'command'
          :type_annot (TypePath ('String'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Ok'))
    )
    (LetValueBinding
      :name 'kindName'
      :value (ExprIf
        :cond (ExprVariantCheck
          :target (ExprId 'k')
          :tag 'file'
        )
        :then_branch (ExprString 'file' '"file"')
        :elsifs (
          (
            (ExprVariantCheck
              :target (ExprId 'k')
              :tag 'directory'
            )
            (ExprString 'directory' '"directory"')
          )
          (
            (ExprVariantCheck
              :target (ExprId 'k')
              :tag 'symlink'
            )
            (ExprString 'symlink' '"symlink"')
          )
        )
        :else_branch (ExprString 'other' '"other"')
      )
      :params (
        (FormalParam
          :name 'k'
          :type_annot (TypePath ('fileStats' 'Kind'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('String'))
    )
    (LetValueBinding
      :name 'octal'
      :value (ExprIf
        :cond (ExprInfix
          :left (ExprId 'n')
          :op '<'
          :right (ExprInt 8 '8')
        )
        :then_branch (ExprApp
          :func (ExprSelect
            :target (ExprId 'conv')
            :field 'int'
          )
          :args (
            (ExprId 'n')
          )
        )
        :else_branch (ExprInfix
          :left (ExprApp
            :func (ExprId 'octal')
            :args (
              (ExprInfix
                :left (ExprId 'n')
                :op '/'
                :right (ExprInt 8 '8')
              )
            )
          )
          :op '<>'
          :right (ExprApp
            :func (ExprSelect
              :target (ExprId 'conv')
              :field 'int'
            )
            :args (
              (ExprInfix
                :left (ExprId 'n')
                :op '%'
                :right (ExprInt 8 '8')
              )
            )
          )
        )
      )
      :params (
        (FormalParam
          :name 'n'
          :type_annot (TypePath ('Int'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('String'))
      :is_rec True
    )
    (LetValueBinding
      :name 'show'
      :value (ExprBlock
        :bindings (
          (LetValueBinding
            :name 'size'
            :value (ExprIf
              :cond (ExprVariantCheck
                :target (ExprSelect
                  :target (ExprId 's')
                  :field 'kind'
                )
                :tag 'directory'
              )
              :then_branch (ExprString '' '""')
              :else_branch (ExprInfix
                :left (ExprString ' size ' '" size "')
                :op '<>'
                :right (ExprApp
                  :func (ExprSelect
                    :target (ExprId 'conv')
                    :field 'int'
                  )
                  :args (
                    (ExprSelect
                      :target (ExprId 's')
                      :field 'size'
                    )
                  )
                )
              )
            )
          )
          (ExprStmt
            :expr (ExprApp
              :func (ExprId 'print')
              :args (
                (ExprInfix
                  :left (ExprId 'what')
                  :op '<>'
                  :right (ExprInfix
                    :left (ExprString ': ' '": "')
                    :op '<>'
                    :right (ExprInfix
                      :left (ExprApp
                        :func (ExprId 'kindName')
                        :args (
                          (ExprSelect
                            :target (ExprId 's')
                            :field 'kind'
                          )
                        )
                      )
                      :op '<>'
                      :right (ExprInfix
                        :left (ExprId 'size')
                        :op '<>'
                        :right (ExprInfix
                          :left (ExprString ' mode ' '" mode "')
                          :op '<>'
                          :right (ExprInfix
                            :left (ExprApp
                              :func (ExprId 'octal')
                              :args (
                                (ExprSelect
                                  :target (ExprId 's')
                                  :field 'mode'
                                )
                              )
                            )
                            :op '<>'
                            :right (ExprInfix
                              :left (ExprString ' mtime ' '" mtime "')
                              :op '<>'
                              :right (ExprInfix
                                :left (ExprApp
                                  :func (ExprSelect
                                    :target (ExprId 'conv')
                                    :field 'real'
                                  )
                                  :args (
                                    (ExprSelect
                                      :target (ExprId 's')
                                      :field 'modifiedTime'
                                    )
                                  )
                                )
                                :op '<>'
                                :right (ExprInfix
                                  :left (ExprString ' mtime_ns ' '" mtime_ns "')
                                  :op '<>'
                                  :right (ExprInfix
                                    :left (ExprApp
                                      :func (ExprSelect
                                        :target (ExprId 'conv')
                                        :field 'int'
                                      )
                                      :args (
                                        (ExprSelect
                                          :target (ExprId 's')
                                          :field 'modifiedNs'
                                        )
                                      )
                                    )
                                    :op '<>'
                                    :right (ExprInfix
                                      :left (ExprString ' atime_ns ' '" atime_ns "')
                                      :op '<>'
                                      :right (ExprApp
                                        :func (ExprSelect
                                          :target (ExprId 'conv')
                                          :field 'int'
                                        )
                                        :args (
                                          (ExprSelect
                                            :target (ExprId 's')
                                            :field 'accessNs'
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
      :params (
        (FormalParam
          :name 'what'
          :type_annot (TypePath ('String'))
          :mode VALUE
        )
        (FormalParam
          :name 's'
          :type_annot (TypePath ('fileStats' 'T'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Ok'))
    )
    (LetValueBinding
      :name 'w'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'file'
        )
        :args (
          (ExprString 'data.txt' '"data.txt"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprId 'w')
          (ExprString 'twelve bytes' '"twelve bytes"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'close'
        )
        :args (
          (ExprId 'w')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'system')
          :field 'makeDirectory'
        )
        :args (
          (ExprString 'dir' '"dir"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'sh')
        :args (
          (ExprString 'chmod 640 data.txt && chmod 750 dir' '"chmod 640 data.txt && chmod 750 dir"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'sh')
        :args (
          (ExprString 'touch -d 2020-01-02T03:04:05.25Z data.txt && touch -d 2021-06-07T08:09:10Z dir' '"touch -d 2020-01-02T03:04:05.25Z data.txt && touch -d 2021-06-07T08:09:10Z dir"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'sh')
        :args (
          (ExprString 'ln -s data.txt link && ln -s missing.txt dangling' '"ln -s data.txt link && ln -s missing.txt dangling"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'show')
        :args (
          (ExprString 'data.txt' '"data.txt"')
          (ExprApp
            :func (ExprSelect
              :target (ExprId 'fileStats')
              :field 'stat'
            )
            :args (
              (ExprString 'data.txt' '"data.txt"')
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'show')
        :args (
          (ExprString 'dir' '"dir"')
          (ExprApp
            :func (ExprSelect
              :target (ExprId 'fileStats')
              :field 'stat'
            )
            :args (
              (ExprString 'dir' '"dir"')
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'show')
        :args (
          (ExprString 'link' '"link"')
          (ExprApp
            :func (ExprSelect
              :target (ExprId 'fileStats')
              :field 'stat'
            )
            :args (
              (ExprString 'link' '"link"')
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprInfix
            :left (ExprString 'lstat link: ' '"lstat link: "')
            :op '<>'
            :right (ExprApp
              :func (ExprId 'kindName')
              :args (
                (ExprSelect
                  :target (ExprApp
                    :func (ExprSelect
                      :target (ExprId 'fileStats')
                      :field 'lstat'
                    )
                    :args (
                      (ExprString 'link' '"link"')
                    )
                  )
                  :field 'kind'
                )
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprInfix
            :left (ExprString 'lstat dangling: ' '"lstat dangling: "')
            :op '<>'
            :right (ExprApp
              :func (ExprId 'kindName')
              :args (
                (ExprSelect
                  :target (ExprApp
                    :func (ExprSelect
                      :target (ExprId 'fileStats')
                      :field 'lstat'
                    )
                    :args (
                      (ExprString 'dangling' '"dangling"')
                    )
                  )
                  :field 'kind'
                )
              )
            )
          )
        )
      )
    )
    (LetValueBinding
      :name 's'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'fileStats')
          :field 'stat'
        )
        :args (
          (ExprString 'data.txt' '"data.txt"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprInfix
            :left (ExprString 'ctime_ns positive: ' '"ctime_ns positive: "')
            :op '<>'
            :right (ExprApp
              :func (ExprSelect
                :target (ExprId 'conv')
                :field 'bool'
              )
              :args (
                (ExprInfix
                  :left (ExprSelect
                    :target (ExprId 's')
                    :field 'changeNs'
                  )
                  :op '>'
                  :right (ExprInt 0 '0')
                )
              )
            )
          )
        )
      )
    )
    (LetValueBinding
      :name 'found'
      :value (ExprIf
        :cond (ExprApp
          :func (ExprSelect
            :target (ExprId 'maybe')
            :field 'isSome'
          )
          :args (
            (TypeArgument
              :type_val (TypePath ('fileStats' 'T'))
            )
            (ExprApp
              :func (ExprSelect
                :target (ExprId 'fileStats')
                :field 'find'
              )
              :args (
                (ExprId 'path')
              )
            )
          )
        )
        :then_branch (ExprString 'found' '"found"')
        :else_branch (ExprString 'none' '"none"')
      )
      :params (
        (FormalParam
          :name 'path'
          :type_annot (TypePath ('String'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('String'))
    )
    (LetValueBinding
      :name 'lfound'
      :value (ExprIf
        :cond (ExprApp
          :func (ExprSelect
            :target (ExprId 'maybe')
            :field 'isSome'
          )
          :args (
            (TypeArgument
              :type_val (TypePath ('fileStats' 'T'))
            )
            (ExprApp
              :func (ExprSelect
                :target (ExprId 'fileStats')
                :field 'lfind'
              )
              :args (
                (ExprId 'path')
              )
            )
          )
        )
        :then_branch (ExprString 'found' '"found"')
        :else_branch (ExprString 'none' '"none"')
      )
      :params (
        (FormalParam
          :name 'path'
          :type_annot (TypePath ('String'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('String'))
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprInfix
            :left (ExprString 'find data.txt: ' '"find data.txt: "')
            :op '<>'
            :right (ExprApp
              :func (ExprId 'found')
              :args (
                (ExprString 'data.txt' '"data.txt"')
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprInfix
            :left (ExprString 'find missing.txt: ' '"find missing.txt: "')
            :op '<>'
            :right (ExprApp
              :func (ExprId 'found')
              :args (
                (ExprString 'missing.txt' '"missing.txt"')
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprInfix
            :left (ExprString 'find data.txt/x: ' '"find data.txt/x: "')
            :op '<>'
            :right (ExprApp
              :func (ExprId 'found')
              :args (
                (ExprString 'data.txt/x' '"data.txt/x"')
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprInfix
            :left (ExprString 'find dangling: ' '"find dangling: "')
            :op '<>'
            :right (ExprApp
              :func (ExprId 'found')
              :args (
                (ExprString 'dangling' '"dangling"')
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprInfix
            :left (ExprString 'lfind dangling: ' '"lfind dangling: "')
            :op '<>'
            :right (ExprApp
              :func (ExprId 'lfound')
              :args (
                (ExprString 'dangling' '"dangling"')
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprInfix
            :left (ExprString 'stat missing.txt: ' '"stat missing.txt: "')
            :op '<>'
            :right (ExprTry
              :body (ExprApp
                :func (ExprId 'kindName')
                :args (
                  (ExprSelect
                    :target (ExprApp
                      :func (ExprSelect
                        :target (ExprId 'fileStats')
                        :field 'stat'
                      )
                      :args (
                        (ExprString 'missing.txt' '"missing.txt"')
                      )
                    )
                    :field 'kind'
                  )
                )
              )
              :branches (
                (TryBranch
                  :exc_pattern (ExprSelect
                    :target (ExprId 'system')
                    :field 'error'
                  )
                  :body (ExprString 'system.error' '"system.error"')
                )
              )
            )
          )
        )
      )
    )
  )
)
