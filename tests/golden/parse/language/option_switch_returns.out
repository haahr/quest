(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('conv') 'Conv')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('writer') 'Writer')
      )
    )
    (LetValueBinding
      :name 'put'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprId 's')
        )
      )
      :params (
        (FormalParam
          :name 's'
          :type_annot (TypePath ('String'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Ok'))
    )
    (TypeBinding
      :name 'Op'
      :type_val (TypeOption
        :variants (
          (OptionFieldSig 'load' ())
          (OptionFieldSig 'store' ())
          (OptionFieldSig 'add' ())
          (OptionFieldSig 'sub' ())
          (OptionFieldSig 'mul' ())
          (OptionFieldSig 'div' ())
          (OptionFieldSig 'jump' ())
          (OptionFieldSig 'branch' ())
          (OptionFieldSig 'call' ())
          (OptionFieldSig 'ret' ())
          (OptionFieldSig 'halt' ())
          (OptionFieldSig 'nop' ())
        )
      )
      :is_def True
    )
    (LetValueBinding
      :name 'all'
      :value (ExprArray
        :elements (
          (ExprOption
            :tag 'load'
            :option_type (TypePath ('Op'))
          )
          (ExprOption
            :tag 'store'
            :option_type (TypePath ('Op'))
          )
          (ExprOption
            :tag 'add'
            :option_type (TypePath ('Op'))
          )
          (ExprOption
            :tag 'sub'
            :option_type (TypePath ('Op'))
          )
          (ExprOption
            :tag 'mul'
            :option_type (TypePath ('Op'))
          )
          (ExprOption
            :tag 'div'
            :option_type (TypePath ('Op'))
          )
          (ExprOption
            :tag 'jump'
            :option_type (TypePath ('Op'))
          )
          (ExprOption
            :tag 'branch'
            :option_type (TypePath ('Op'))
          )
          (ExprOption
            :tag 'call'
            :option_type (TypePath ('Op'))
          )
          (ExprOption
            :tag 'ret'
            :option_type (TypePath ('Op'))
          )
          (ExprOption
            :tag 'halt'
            :option_type (TypePath ('Op'))
          )
          (ExprOption
            :tag 'nop'
            :option_type (TypePath ('Op'))
          )
        )
      )
    )
    (LetValueBinding
      :name 'index'
      :value (ExprCase
        :target (ExprId 'op')
        :branches (
          (CaseBranch
            :tags ('load')
            :body (ExprInt 0 '0')
          )
          (CaseBranch
            :tags ('store')
            :body (ExprInt 1 '1')
          )
          (CaseBranch
            :tags ('add')
            :body (ExprInt 2 '2')
          )
          (CaseBranch
            :tags ('sub')
            :body (ExprInt 3 '3')
          )
          (CaseBranch
            :tags ('mul')
            :body (ExprInt 4 '4')
          )
          (CaseBranch
            :tags ('div')
            :body (ExprInt 5 '5')
          )
          (CaseBranch
            :tags ('jump')
            :body (ExprInt 6 '6')
          )
          (CaseBranch
            :tags ('branch')
            :body (ExprInt 7 '7')
          )
          (CaseBranch
            :tags ('call')
            :body (ExprInt 8 '8')
          )
          (CaseBranch
            :tags ('ret')
            :body (ExprInt 9 '9')
          )
          (CaseBranch
            :tags ('halt')
            :body (ExprInt 10 '10')
          )
          (CaseBranch
            :tags ('nop')
            :body (ExprInt 11 '11')
          )
        )
      )
      :params (
        (FormalParam
          :name 'op'
          :type_annot (TypePath ('Op'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Int'))
    )
    (LetValueBinding
      :name 'name'
      :value (ExprCase
        :target (ExprId 'op')
        :branches (
          (CaseBranch
            :tags ('load')
            :body (ExprString 'LD' '"LD"')
          )
          (CaseBranch
            :tags ('store')
            :body (ExprString 'ST' '"ST"')
          )
          (CaseBranch
            :tags ('add')
            :body (ExprString 'ADD' '"ADD"')
          )
          (CaseBranch
            :tags ('sub')
            :body (ExprString 'SUB' '"SUB"')
          )
          (CaseBranch
            :tags ('mul')
            :body (ExprString 'MUL' '"MUL"')
          )
          (CaseBranch
            :tags ('div')
            :body (ExprString 'DIV' '"DIV"')
          )
          (CaseBranch
            :tags ('jump')
            :body (ExprString 'J' '"J"')
          )
          (CaseBranch
            :tags ('branch')
            :body (ExprString 'B' '"B"')
          )
          (CaseBranch
            :tags ('call')
            :body (ExprString 'CALL' '"CALL"')
          )
          (CaseBranch
            :tags ('ret')
            :body (ExprString 'RET' '"RET"')
          )
          (CaseBranch
            :tags ('halt')
            :body (ExprString 'HLT' '"HLT"')
          )
          (CaseBranch
            :tags ('nop')
            :body (ExprString 'NOP' '"NOP"')
          )
        )
      )
      :params (
        (FormalParam
          :name 'op'
          :type_annot (TypePath ('Op'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('String'))
    )
    (LetValueBinding
      :name 'cost'
      :value (ExprCase
        :target (ExprId 'op')
        :branches (
          (CaseBranch
            :tags ('load')
            :body (ExprInt 3 '3')
          )
          (CaseBranch
            :tags ('store')
            :body (ExprInt 3 '3')
          )
          (CaseBranch
            :tags ('mul')
            :body (ExprInt 4 '4')
          )
          (CaseBranch
            :tags ('div')
            :body (ExprInt 20 '20')
          )
          (CaseBranch
            :tags ('call')
            :body (ExprInt 5 '5')
          )
          (CaseBranch
            :tags ('ret')
            :body (ExprInt 2 '2')
          )
        )
        :else_branch (ExprInt 1 '1')
      )
      :params (
        (FormalParam
          :name 'op'
          :type_annot (TypePath ('Op'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Int'))
    )
    (LetValueBinding
      :name 'indexOf'
      :value (ExprId 'index')
      :is_var True
    )
    (LetValueBinding
      :name 'nameOf'
      :value (ExprId 'name')
      :is_var True
    )
    (LetValueBinding
      :name 'costOf'
      :value (ExprId 'cost')
      :is_var True
    )
    (ExprStmt
      :expr (ExprFor
        :var_name 'i'
        :start (ExprInt 0 '0')
        :stop (ExprInfix
          :left (ExprApp
            :func (ExprId 'extent')
            :args (
              (ExprId 'all')
            )
          )
          :op '-'
          :right (ExprInt 1 '1')
        )
        :body (ExprBlock
          :bindings (
            (LetValueBinding
              :name 'op'
              :value (ExprIndex
                :target (ExprId 'all')
                :index (ExprId 'i')
              )
            )
            (ExprStmt
              :expr (ExprApp
                :func (ExprId 'put')
                :args (
                  (ExprInfix
                    :left (ExprApp
                      :func (ExprSelect
                        :target (ExprId 'conv')
                        :field 'int'
                      )
                      :args (
                        (ExprApp
                          :func (ExprId 'indexOf')
                          :args (
                            (ExprId 'op')
                          )
                        )
                      )
                    )
                    :op '<>'
                    :right (ExprInfix
                      :left (ExprString ' ' '" "')
                      :op '<>'
                      :right (ExprInfix
                        :left (ExprApp
                          :func (ExprId 'nameOf')
                          :args (
                            (ExprId 'op')
                          )
                        )
                        :op '<>'
                        :right (ExprInfix
                          :left (ExprString ' ' '" "')
                          :op '<>'
                          :right (ExprInfix
                            :left (ExprApp
                              :func (ExprSelect
                                :target (ExprId 'conv')
                                :field 'int'
                              )
                              :args (
                                (ExprApp
                                  :func (ExprId 'costOf')
                                  :args (
                                    (ExprId 'op')
                                  )
                                )
                              )
                            )
                            :op '<>'
                            :right (ExprString '\n' '"\\n"')
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
