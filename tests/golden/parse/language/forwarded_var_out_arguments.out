(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('conv') 'Conv')
        (ImportItem ('writer') 'Writer')
      )
    )
    (LetValueBinding
      :name 'mk'
      :value (ExprFun
        :return_type (TypeAll
          :quantifiers (
            (Quantifier
              :name 'x'
              :bound (KindPower
                :bound (TypePath ('Bool'))
              )
              :mode OUT
            )
            (Quantifier
              :name 'y'
              :bound (KindPower
                :bound (TypePath ('Real'))
              )
              :mode VAR
            )
          )
          :result_type (TypePath ('Ok'))
        )
        :body (ExprFun
          :params (
            (FormalParam
              :name 'x'
              :type_annot (TypePath ('Bool'))
              :mode OUT
            )
            (FormalParam
              :name 'y'
              :type_annot (TypePath ('Real'))
              :mode VAR
            )
          )
          :return_type (TypePath ('Ok'))
          :body (ExprBlock
            :bindings (
              (ExprStmt
                :expr (ExprInfix
                  :left (ExprId 'x')
                  :op ':='
                  :right (ExprBool True)
                )
              )
              (ExprStmt
                :expr (ExprInfix
                  :left (ExprId 'y')
                  :op ':='
                  :right (ExprReal 2.5 '2.5')
                )
              )
            )
          )
        )
        :type_params (
          (TypeFormal
            :name 'A'
            :bound (KindType)
          )
        )
      )
      :type_annot (TypeAll
        :quantifiers (
          (Quantifier
            :name 'A'
            :bound (KindType)
            :mode VALUE
            :is_type True
          )
        )
        :result_type (TypeAll
          :quantifiers (
            (Quantifier
              :name 'x'
              :bound (KindPower
                :bound (TypePath ('Bool'))
              )
              :mode OUT
            )
            (Quantifier
              :name 'y'
              :bound (KindPower
                :bound (TypePath ('Real'))
              )
              :mode VAR
            )
          )
          :result_type (TypePath ('Ok'))
        )
      )
    )
    (LetValueBinding
      :name 'keep'
      :value (ExprId 'mk')
      :is_var True
    )
    (LetValueBinding
      :name 'set'
      :value (ExprFun
        :return_type (TypeAll
          :quantifiers (
            (Quantifier
              :name 'x'
              :bound (KindPower
                :bound (TypePath ('Bool'))
              )
              :mode OUT
            )
            (Quantifier
              :name 'y'
              :bound (KindPower
                :bound (TypePath ('Real'))
              )
              :mode VAR
            )
          )
          :result_type (TypePath ('Ok'))
        )
        :body (ExprApp
          :func (ExprId 'keep')
          :args (
            (TypeArgument
              :type_val (TypePath ('A'))
            )
          )
        )
        :type_params (
          (TypeFormal
            :name 'A'
            :bound (KindType)
          )
        )
      )
      :type_annot (TypeAll
        :quantifiers (
          (Quantifier
            :name 'A'
            :bound (KindType)
            :mode VALUE
            :is_type True
          )
        )
        :result_type (TypeAll
          :quantifiers (
            (Quantifier
              :name 'x'
              :bound (KindPower
                :bound (TypePath ('Bool'))
              )
              :mode OUT
            )
            (Quantifier
              :name 'y'
              :bound (KindPower
                :bound (TypePath ('Real'))
              )
              :mode VAR
            )
          )
          :result_type (TypePath ('Ok'))
        )
      )
    )
    (LetValueBinding
      :name 'b'
      :value (ExprBool False)
      :is_var True
    )
    (LetValueBinding
      :name 'r'
      :value (ExprReal 1.25 '1.25')
      :is_var True
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'set')
        :args (
          (TypeArgument
            :type_val (TypePath ('Int'))
          )
          (ExprDerefCell
            :target (ExprId 'b')
          )
          (ExprDerefCell
            :target (ExprId 'r')
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprInfix
            :left (ExprApp
              :func (ExprSelect
                :target (ExprId 'conv')
                :field 'real'
              )
              :args (
                (ExprIf
                  :cond (ExprId 'b')
                  :then_branch (ExprId 'r')
                  :else_branch (ExprReal 0.0 '0.0')
                )
              )
            )
            :op '<>'
            :right (ExprString '\n' '"\\n"')
          )
        )
      )
    )
  )
)
