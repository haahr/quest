(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('writer') 'Writer')
      )
    )
    (LetValueBinding
      :name 'wOut'
      :value (ExprSelect
        :target (ExprId 'writer')
        :field 'output'
      )
    )
    (LetValueBinding
      :name 'count'
      :value (ExprInt 0 '0')
      :is_var True
    )
    (ExprStmt
      :expr (ExprException
        :name 'Never'
        :type_annot (TypePath ('Ok'))
      )
    )
    (ExprStmt
      :expr (ExprIf
        :cond (ExprBool True)
        :then_branch (ExprBlock
          :bindings (
            (LetValueBinding
              :name 'x'
              :value (ExprInt 1 '1')
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprIf
        :cond (ExprBool False)
        :then_branch (ExprOk)
        :else_branch (ExprBlock
          :bindings (
            (LetValueBinding
              :name 'y'
              :value (ExprInt 2 '2')
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprFor
        :var_name 'i'
        :start (ExprInt 1 '1')
        :stop (ExprInt 3 '3')
        :body (ExprBlock
          :bindings (
            (LetValueBinding
              :name 'z'
              :value (ExprId 'i')
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprWhile
        :cond (ExprInfix
          :left (ExprId 'count')
          :op '<'
          :right (ExprInt 2 '2')
        )
        :body (ExprInfix
          :left (ExprId 'count')
          :op ':='
          :right (ExprInfix
            :left (ExprId 'count')
            :op '+'
            :right (ExprInt 1 '1')
          )
        )
      )
    )
    (TypeBinding
      :name 'Color'
      :type_val (TypeOption
        :variants (
          (OptionFieldSig 'red' ())
          (OptionFieldSig 'green' ())
        )
      )
    )
    (LetValueBinding
      :name 'c'
      :value (ExprOption
        :tag 'red'
        :option_type (TypePath ('Color'))
      )
    )
    (ExprStmt
      :expr (ExprCase
        :target (ExprId 'c')
        :branches (
          (CaseBranch
            :tags ('red')
            :body (ExprBlock
              :bindings (
                (LetValueBinding
                  :name 'r'
                  :value (ExprInt 1 '1')
                )
              )
            )
          )
          (CaseBranch
            :tags ('green')
            :body (ExprOk)
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprTry
        :body (ExprBlock
          :bindings (
            (LetValueBinding
              :name 't'
              :value (ExprInt 1 '1')
            )
          )
        )
        :branches (
          (TryBranch
            :exc_pattern (ExprId 'Never')
            :body (ExprBlock
              :bindings (
                (LetValueBinding
                  :name 'u'
                  :value (ExprInt 2 '2')
                )
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprId 'wOut')
          (ExprString 'declaration bodies ok\n' '"declaration bodies ok\\n"')
        )
      )
    )
  )
)
