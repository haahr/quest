          (ExprId 'x')
        )
        :element_type (TypePath ('Sub'))
      )
      :params (
        (FormalParam
          :name 'x'
          :type_annot (TypePath ('Sub'))
          :mode VALUE
        )
      )
      :type_annot (TypeArray
        :element_type (TypePath ('Super'))
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'say')
        :args (
          (ExprInfix
            :left (ExprString '1: ' '"1: "')
            :op '<>'
            :right (ExprApp
              :func (ExprSelect
                :target (ExprId 'conv')
                :field 'int'
              )
              :args (
                (ExprCase
                  :target (ExprIndex
                    :target (ExprApp
                      :func (ExprId 'f')
                      :args (
                        (ExprOption
                          :tag 'b'
                          :option_type (TypePath ('Sub'))
                        )
                      )
                    )
                    :index (ExprInt 0 '0')
                  )
                  :branches (
                    (CaseBranch
                      :tags ('a')
                      :body (ExprInt 1 '1')
                    )
                    (CaseBranch
                      :tags ('b')
                      :body (ExprInt 2 '2')
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    (LetValueBinding
      :name 'g'
      :value (ExprArray
        :elements (
          (ExprOption
            :tag 'b'
            :option_type (TypePath ('Sub'))
          )
          (ExprOption
            :tag 'b'
            :option_type (TypePath ('Sub'))
          )
        )
        :element_type (TypePath ('Sub'))
      )
      :type_annot (TypeArray
        :element_type (TypePath ('Super'))
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'say')
        :args (
          (ExprInfix
            :left (ExprString '2: ' '"2: "')
            :op '<>'
            :right (ExprInfix
              :left (ExprApp
                :func (ExprSelect
                  :target (ExprId 'conv')
                  :field 'int'
                )
                :args (
                  (ExprCase
                    :target (ExprIndex
                      :target (ExprId 'g')
                      :index (ExprInt 1 '1')
                    )
                    :branches (
                      (CaseBranch
                        :tags ('a')
                        :body (ExprInt 1 '1')
                      )
                      (CaseBranch
                        :tags ('b')
                        :body (ExprInt 2 '2')
                      )
                    )
                  )
                )
              )
              :op '<>'
              :right (ExprInfix
                :left (ExprString ' ' '" "')
                :op '<>'
                :right (ExprApp
