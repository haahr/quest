(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('conv') 'Conv')
        (ImportItem ('writer') 'Writer')
      )
    )
    (LetValueBinding
      :name 'say'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprInfix
            :left (ExprId 's')
            :op '<>'
            :right (ExprString '\n' '"\\n"')
          )
        )
      )
      :params (
        (FormalParam
          :name 's'
          :type_annot (TypePath ('String'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Ok'))
    )
    (TypeBinding
      :name 'Super'
      :type_val (TypeOption
        :variants (
          (OptionFieldSig 'a' ())
          (OptionFieldSig 'b' ())
        )
      )
    )
    (TypeBinding
      :name 'Sub'
      :type_val (TypeOption
        :variants (
          (OptionFieldSig 'b' ())
        )
      )
    )
    (LetValueBinding
      :name 'f'
      :value (ExprArray
