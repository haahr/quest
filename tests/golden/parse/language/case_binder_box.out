(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('writer') 'Writer')
        (ImportItem ('conv') 'Conv')
        (ImportItem ('system') 'System')
      )
    )
    (TypeBinding
      :name 'P'
      :type_val (TypeRecord
        :fields (
          (RecordFieldSig
            :name 'x'
            :type_sig (TypePath ('Int'))
          )
          (RecordFieldSig
            :name 'y'
            :type_sig (TypePath ('Int'))
          )
        )
      )
    )
    (TypeBinding
      :name 'V'
      :type_val (TypeVariant
        :fields (
          (VariantFieldSig
            :tag 'point'
            :type_sig (TypePath ('P'))
          )
          (VariantFieldSig
            :tag 'none'
            :type_sig (TypePath ('Ok'))
          )
        )
      )
    )
    (TypeBinding
      :name 'O'
      :type_val (TypeOption
        :variants (
          (OptionFieldSig
            :tag 'some'
            :payload_sig (
              (FieldSig
                :name 'p'
                :type_sig (TypePath ('P'))
                :mode VALUE
              )
            )
          )
          (OptionFieldSig 'nothing' ())
        )
      )
    )
    (TypeBinding
      :name 'Wrapped'
      :type_val (TypeRecord
        :fields (
          (RecordFieldSig
            :name 'inner'
            :type_sig (TypePath ('P'))
          )
          (RecordFieldSig
            :name 'tag'
            :type_sig (TypePath ('Int'))
          )
        )
      )
    )
    (LetValueBinding
      :name 'print'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprInfix
            :left (ExprId 's')
            :op '<>'
            :right (ExprString '\n' '"\\n"')
          )
        )
      )
      :params (
        (FormalParam
          :name 's'
          :type_annot (TypePath ('String'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Ok'))
    )
    (LetValueBinding
      :name 'show'
      :value (ExprInfix
        :left (ExprApp
          :func (ExprSelect
            :target (ExprId 'conv')
            :field 'int'
          )
          :args (
            (ExprSelect
              :target (ExprSelect
                :target (ExprId 'w')
                :field 'inner'
              )
              :field 'x'
            )
          )
        )
        :op '<>'
        :right (ExprInfix
          :left (ExprString ',' '","')
          :op '<>'
          :right (ExprInfix
            :left (ExprApp
              :func (ExprSelect
                :target (ExprId 'conv')
                :field 'int'
              )
              :args (
                (ExprSelect
                  :target (ExprSelect
                    :target (ExprId 'w')
                    :field 'inner'
                  )
                  :field 'y'
                )
              )
            )
            :op '<>'
            :right (ExprInfix
              :left (ExprString ' ' '" "')
              :op '<>'
              :right (ExprApp
                :func (ExprSelect
                  :target (ExprId 'conv')
                  :field 'int'
                )
                :args (
                  (ExprSelect
                    :target (ExprId 'w')
                    :field 'tag'
                  )
                )
              )
            )
          )
        )
      )
      :params (
        (FormalParam
          :name 'w'
          :type_annot (TypePath ('Wrapped'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('String'))
    )
    (LetValueBinding
      :name 'wrap'
      :value (ExprCase
        :target (ExprId 'v')
        :branches (
          (CaseBranch
            :tags ('point')
            :binder 'p'
            :body (ExprRecord
              :fields (
                (RecordBinding
                  :name 'inner'
                  :value (ExprId 'p')
                )
                (RecordBinding
                  :name 'tag'
                  :value (ExprInt 1 '1')
                )
              )
            )
          )
          (CaseBranch
            :tags ('none')
            :body (ExprRecord
              :fields (
                (RecordBinding
                  :name 'inner'
                  :value (ExprRecord
                    :fields (
                      (RecordBinding
                        :name 'x'
                        :value (ExprInt 0 '0')
                      )
                      (RecordBinding
                        :name 'y'
                        :value (ExprInt 0 '0')
                      )
                    )
                  )
                )
                (RecordBinding
                  :name 'tag'
                  :value (ExprInt 0 '0')
                )
              )
            )
          )
        )
      )
      :params (
        (FormalParam
          :name 'v'
          :type_annot (TypePath ('V'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Wrapped'))
    )
    (LetValueBinding
      :name 'twice'
      :value (ExprCase
        :target (ExprId 'v')
        :branches (
          (CaseBranch
            :tags ('point')
            :binder 'p'
            :body (ExprArray
              :elements (
                (ExprId 'p')
                (ExprId 'p')
              )
            )
          )
          (CaseBranch
            :tags ('none')
            :body (ExprArray ())
          )
        )
      )
      :params (
        (FormalParam
          :name 'v'
          :type_annot (TypePath ('V'))
          :mode VALUE
        )
      )
      :type_annot (TypeArray
        :element_type (TypePath ('P'))
      )
    )
    (LetValueBinding
      :name 'wrapOption'
      :value (ExprCase
        :target (ExprId 'o')
        :branches (
          (CaseBranch
            :tags ('some')
            :binder 'c'
            :body (ExprRecord
              :fields (
                (RecordBinding
                  :name 'inner'
                  :value (ExprSelect
                    :target (ExprId 'c')
                    :field 'p'
                  )
                )
                (RecordBinding
                  :name 'tag'
                  :value (ExprInt 2 '2')
                )
              )
            )
          )
          (CaseBranch
            :tags ('nothing')
            :body (ExprRecord
              :fields (
                (RecordBinding
                  :name 'inner'
                  :value (ExprRecord
                    :fields (
                      (RecordBinding
                        :name 'x'
                        :value (ExprInt -1 '~1')
                      )
                      (RecordBinding
                        :name 'y'
                        :value (ExprInt -1 '~1')
                      )
                    )
                  )
                )
                (RecordBinding
                  :name 'tag'
                  :value (ExprInt 0 '0')
                )
              )
            )
          )
        )
      )
      :params (
        (FormalParam
          :name 'o'
          :type_annot (TypePath ('O'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Wrapped'))
    )
    (LetValueBinding
      :name 'many'
      :value (ExprInfix
        :left (ExprApp
          :func (ExprId 'extent')
          :args (
            (ExprSelect
              :target (ExprId 'system')
              :field 'args'
            )
          )
        )
        :op '>'
        :right (ExprInt 5 '5')
      )
    )
    (LetValueBinding
      :name 'v'
      :value (ExprIf
        :cond (ExprId 'many')
        :then_branch (ExprVariant
          :tag 'none'
          :variant_type (TypePath ('V'))
          :payload (ExprOk)
        )
        :else_branch (ExprVariant
          :tag 'point'
          :variant_type (TypePath ('V'))
          :payload (ExprRecord
            :fields (
              (RecordBinding
                :name 'x'
                :value (ExprInt 3 '3')
              )
              (RecordBinding
                :name 'y'
                :value (ExprInt 4 '4')
              )
            )
          )
        )
      )
    )
    (LetValueBinding
      :name 'o'
      :value (ExprIf
        :cond (ExprId 'many')
        :then_branch (ExprOption
          :tag 'nothing'
          :option_type (TypePath ('O'))
        )
        :else_branch (ExprOption
          :tag 'some'
          :option_type (TypePath ('O'))
          :payload (ExprTuple
            :fields (
              (TupleBinding
                :value (ExprRecord
                  :fields (
                    (RecordBinding
                      :name 'x'
                      :value (ExprInt 5 '5')
                    )
                    (RecordBinding
                      :name 'y'
                      :value (ExprInt 6 '6')
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprApp
            :func (ExprId 'show')
            :args (
              (ExprApp
                :func (ExprId 'wrap')
                :args (
                  (ExprId 'v')
                )
              )
            )
          )
        )
      )
    )
    (LetValueBinding
      :name 'ps'
      :value (ExprApp
        :func (ExprId 'twice')
        :args (
          (ExprId 'v')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprInfix
            :left (ExprApp
              :func (ExprSelect
                :target (ExprId 'conv')
                :field 'int'
              )
              :args (
                (ExprApp
                  :func (ExprId 'extent')
                  :args (
                    (ExprId 'ps')
                  )
                )
              )
            )
            :op '<>'
            :right (ExprInfix
              :left (ExprString ' ' '" "')
              :op '<>'
              :right (ExprApp
                :func (ExprSelect
                  :target (ExprId 'conv')
                  :field 'int'
                )
                :args (
                  (ExprInfix
                    :left (ExprSelect
                      :target (ExprIndex
                        :target (ExprId 'ps')
                        :index (ExprInt 0 '0')
                      )
                      :field 'x'
                    )
                    :op '+'
                    :right (ExprSelect
                      :target (ExprIndex
                        :target (ExprId 'ps')
                        :index (ExprInt 1 '1')
                      )
                      :field 'y'
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprApp
            :func (ExprId 'show')
            :args (
              (ExprApp
                :func (ExprId 'wrapOption')
                :args (
                  (ExprId 'o')
                )
              )
            )
          )
        )
      )
    )
  )
)
