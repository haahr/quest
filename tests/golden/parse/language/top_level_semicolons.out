(Program
  :phrases (
    (LetValueBinding
      :name 'a'
      :value (ExprInt 1 '1')
    )
    (LetValueBinding
      :name 'b'
      :value (ExprInt 2 '2')
    )
    (LetValueBinding
      :name 'c'
      :value (ExprInt 3 '3')
    )
    (LetValueBinding
      :name 'd'
      :value (ExprInt 4 '4')
    )
    (ExprStmt
      :expr (ExprInfix
        :left (ExprId 'a')
        :op '+'
        :right (ExprInfix
          :left (ExprId 'b')
          :op '+'
          :right (ExprInfix
            :left (ExprId 'c')
            :op '+'
            :right (ExprId 'd')
          )
        )
      )
    )
  )
)
