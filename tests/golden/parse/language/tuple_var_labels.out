(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('conv') 'Conv')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('stringOp') 'StringOp' ('string'))
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('writer') 'Writer')
      )
    )
    (LetValueBinding
      :name 'print'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprInfix
            :left (ExprId 's')
            :op '<>'
            :right (ExprString '\n' '"\\n"')
          )
        )
      )
      :params (
        (FormalParam
          :name 's'
          :type_annot (TypePath ('String'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Ok'))
    )
    (LetValueBinding
      :name 'lengths'
      :value (ExprBlock
        :bindings (
          (LetValueBinding
            :name 't'
            :value (ExprTuple
              :fields (
                (TupleBinding
                  :name 'text'
                  :value (ExprId 's')
                  :is_var True
                )
                (TupleBinding
                  :name 'n'
                  :value (ExprApp
                    :func (ExprSelect
                      :target (ExprId 'stringOp')
                      :field 'length'
                    )
                    :args (
                      (ExprId 'text')
                    )
                  )
                  :is_var True
                )
              )
            )
          )
          (ExprStmt
            :expr (ExprSelect
              :target (ExprId 't')
              :field 'n'
            )
          )
        )
      )
      :params (
        (FormalParam
          :name 's'
          :type_annot (TypePath ('String'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Int'))
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprApp
            :func (ExprSelect
              :target (ExprId 'conv')
              :field 'int'
            )
            :args (
              (ExprApp
                :func (ExprId 'lengths')
                :args (
                  (ExprString 'abc' '"abc"')
                )
              )
            )
          )
        )
      )
    )
    (LetValueBinding
      :name 'summary'
      :value (ExprBlock
        :bindings (
          (LetValueBinding
            :name 't'
            :value (ExprTuple
              :fields (
                (TupleBinding
                  :name 'count'
                  :value (ExprId 'base')
                  :is_var True
                )
                (TupleBinding
                  :name 'doubled'
                  :value (ExprInfix
                    :left (ExprId 'count')
                    :op '*'
                    :right (ExprInt 2 '2')
                  )
                )
                (TupleBinding
                  :name 'label'
                  :value (ExprInfix
                    :left (ExprString 'n=' '"n="')
                    :op '<>'
                    :right (ExprApp
                      :func (ExprSelect
                        :target (ExprId 'conv')
                        :field 'int'
                      )
                      :args (
                        (ExprId 'count')
                      )
                    )
                  )
                  :is_var True
                )
              )
            )
          )
          (ExprStmt
            :expr (ExprInfix
              :left (ExprSelect
                :target (ExprId 't')
                :field 'count'
              )
              :op ':='
              :right (ExprInfix
                :left (ExprSelect
                  :target (ExprId 't')
                  :field 'count'
                )
                :op '+'
                :right (ExprInt 1 '1')
              )
            )
          )
          (ExprStmt
            :expr (ExprInfix
              :left (ExprSelect
                :target (ExprId 't')
                :field 'label'
              )
              :op '<>'
              :right (ExprInfix
                :left (ExprString ' doubled=' '" doubled="')
                :op '<>'
                :right (ExprInfix
                  :left (ExprApp
                    :func (ExprSelect
                      :target (ExprId 'conv')
                      :field 'int'
                    )
                    :args (
                      (ExprSelect
                        :target (ExprId 't')
                        :field 'doubled'
                      )
                    )
                  )
                  :op '<>'
                  :right (ExprInfix
                    :left (ExprString ' count=' '" count="')
                    :op '<>'
                    :right (ExprApp
                      :func (ExprSelect
                        :target (ExprId 'conv')
                        :field 'int'
                      )
                      :args (
                        (ExprSelect
                          :target (ExprId 't')
                          :field 'count'
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
      :params (
        (FormalParam
          :name 'base'
          :type_annot (TypePath ('Int'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('String'))
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprApp
            :func (ExprId 'summary')
            :args (
              (ExprInt 4 '4')
            )
          )
        )
      )
    )
    (LetValueBinding
      :name 'top'
      :value (ExprTuple
        :fields (
          (TupleBinding
            :name 'word'
            :value (ExprString 'quest' '"quest"')
            :is_var True
          )
          (TupleBinding
            :name 'shout'
            :value (ExprInfix
              :left (ExprId 'word')
              :op '<>'
              :right (ExprString '!' '"!"')
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprSelect
            :target (ExprId 'top')
            :field 'shout'
          )
        )
      )
    )
    (LetValueBinding
      :name 'captured'
      :value (ExprTuple
        :fields (
          (TupleBinding
            :name 'k'
            :value (ExprInt 2 '2')
            :is_var True
          )
          (TupleBinding
            :name 'get'
            :value (ExprFun
              :return_type (TypePath ('Int'))
              :body (ExprId 'k')
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprApp
            :func (ExprSelect
              :target (ExprId 'conv')
              :field 'int'
            )
            :args (
              (ExprApp
                :func (ExprSelect
                  :target (ExprId 'captured')
                  :field 'get'
                )
              )
            )
          )
        )
      )
    )
  )
)
