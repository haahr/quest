(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('writer') 'Writer')
      )
    )
    (TypeBinding
      :name 'P'
      :type_val (TypeTuple
        :fields (
          (TypeFormal
            :name 'A'
            :bound (KindType)
          )
          (FieldSig
            :name 'v'
            :type_sig (TypePath ('A'))
            :mode VALUE
          )
        )
      )
    )
    (LetValueBinding
      :name 'x'
      :value (ExprTuple
        :fields (
          (TupleBinding
            :name 'y'
            :value (ExprTuple
              :fields (
                (TypeBinding
                  :name 'A'
                  :type_val (TypePath ('Int'))
                )
                (TupleBinding
                  :name 'v'
                  :value (ExprInt 1 '1')
                )
              )
            )
            :type_annot (TypePath ('P'))
          )
          (TupleBinding
            :name 'z'
            :value (ExprTuple
              :fields (
                (TypeBinding
                  :name 'A'
                  :type_val (TypePath ('String'))
                )
                (TupleBinding
                  :name 'v'
                  :value (ExprString 's' '"s"')
                )
              )
            )
            :type_annot (TypePath ('P'))
          )
        )
      )
    )
    (LetValueBinding
      :name 'same'
      :value (ExprId 'a')
      :params (
        (FormalParam
          :name 'a'
          :type_annot (TypePath ('x' 'y' 'A'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('x' 'y' 'A'))
    )
    (LetValueBinding
      :name 'pair'
      :value (ExprTuple
        :fields (
          (TupleBinding
            :name 'a'
            :value (ExprApp
              :func (ExprId 'same')
              :args (
                (ExprId 'a')
              )
            )
          )
          (TupleBinding
            :name 'b'
            :value (ExprId 'b')
          )
        )
      )
      :params (
        (FormalParam
          :name 'a'
          :type_annot (TypePath ('x' 'y' 'A'))
          :mode VALUE
        )
        (FormalParam
          :name 'b'
          :type_annot (TypePath ('x' 'z' 'A'))
          :mode VALUE
        )
      )
      :type_annot (TypeTuple
        :fields (
          (FieldSig
            :name 'a'
            :type_sig (TypePath ('x' 'y' 'A'))
            :mode VALUE
          )
          (FieldSig
            :name 'b'
            :type_sig (TypePath ('x' 'z' 'A'))
            :mode VALUE
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprString 'x.y.A and x.z.A checked\n' '"x.y.A and x.z.A checked\\n"')
        )
      )
    )
  )
)
