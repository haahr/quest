(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('writer') 'Writer')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('conv') 'Conv')
      )
    )
    (LetValueBinding
      :name 'print'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprInfix
            :left (ExprId 's')
            :op '<>'
            :right (ExprString '\n' '"\\n"')
          )
        )
      )
      :params (
        (FormalParam
          :name 's'
          :type_annot (TypePath ('String'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Ok'))
    )
    (LetValueBinding
      :name 'down'
      :value (ExprInfix
        :left (ExprInt 1 '1')
        :op '+'
        :right (ExprApp
          :func (ExprId 'down')
          :args (
            (ExprInfix
              :left (ExprId 'n')
              :op '+'
              :right (ExprInt 1 '1')
            )
          )
        )
      )
      :params (
        (FormalParam
          :name 'n'
          :type_annot (TypePath ('Int'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Int'))
      :is_rec True
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprTry
            :body (ExprApp
              :func (ExprSelect
                :target (ExprId 'conv')
                :field 'int'
              )
              :args (
                (ExprApp
                  :func (ExprId 'down')
                  :args (
                    (ExprInt 0 '0')
                  )
                )
              )
            )
            :else_branch (ExprString 'stack overflow' '"stack overflow"')
          )
        )
      )
    )
    (LetValueBinding
      :name 'depth'
      :value (ExprIf
        :cond (ExprInfix
          :left (ExprId 'n')
          :op 'is'
          :right (ExprInt 0 '0')
        )
        :then_branch (ExprInt 0 '0')
        :else_branch (ExprInfix
          :left (ExprInt 1 '1')
          :op '+'
          :right (ExprApp
            :func (ExprId 'depth')
            :args (
              (ExprInfix
                :left (ExprId 'n')
                :op '-'
                :right (ExprInt 1 '1')
              )
            )
          )
        )
      )
      :params (
        (FormalParam
          :name 'n'
          :type_annot (TypePath ('Int'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Int'))
      :is_rec True
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprApp
            :func (ExprSelect
              :target (ExprId 'conv')
              :field 'int'
            )
            :args (
              (ExprApp
                :func (ExprId 'depth')
                :args (
                  (ExprInt 900 '900')
                )
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprApp
            :func (ExprSelect
              :target (ExprId 'conv')
              :field 'int'
            )
            :args (
              (ExprApp
                :func (ExprId 'depth')
                :args (
                  (ExprInt 10 '10')
                )
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprId 'print')
        :args (
          (ExprTry
            :body (ExprApp
              :func (ExprSelect
                :target (ExprId 'conv')
                :field 'int'
              )
              :args (
                (ExprApp
                  :func (ExprId 'down')
                  :args (
                    (ExprInt 0 '0')
                  )
                )
              )
            )
            :else_branch (ExprString 'again' '"again"')
          )
        )
      )
    )
  )
)
