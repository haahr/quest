(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('writer') 'Writer')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('conv') 'Conv')
      )
    )
    (LetValueBinding
      :name 'real'
      :value (ExprReal 2.5 '2.5')
    )
    (LetValueBinding
      :name 'sum'
      :value (ExprInfix
        :left (ExprId 'real')
        :op '++'
        :right (ExprReal 1.0 '1.0')
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprApp
            :func (ExprSelect
              :target (ExprId 'conv')
              :field 'real'
            )
            :args (
              (ExprId 'sum')
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprString '\n' '"\\n"')
        )
      )
    )
  )
)
