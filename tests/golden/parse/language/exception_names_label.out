              :args (
                (ExprId 'c')
              )
            )
          )
          (ExprStmt
            :expr (ExprTry
              :body (ExprRaise
                :exc (ExprId 'e')
                :as_type (TypePath ('Int'))
              )
              :branches (
                (TryBranch
                  :exc_pattern (ExprId 'e')
                  :body (ExprInt 1 '1')
                )
              )
            )
          )
        )
      )
      :params (
