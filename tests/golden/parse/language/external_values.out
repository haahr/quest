(Program
  :phrases (
    (LetValueBinding
      :name 'maxVal'
      :value (ExprExternal 'QUEST_INT_MAX')
      :type_annot (TypePath ('Int'))
    )
    (LetValueBinding
      :name 'minVal'
      :value (ExprExternal 'QUEST_INT_MIN')
      :type_annot (TypePath ('Int'))
    )
    (ExprStmt
      :expr (ExprInfix
        :left (ExprId 'maxVal')
        :op '>'
        :right (ExprInt 0 '0')
      )
    )
    (ExprStmt
      :expr (ExprInfix
        :left (ExprId 'minVal')
        :op '<'
        :right (ExprInt 0 '0')
      )
    )
  )
)
