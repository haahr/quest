(Program
  :phrases (
    (TypeBinding
      :name 'T'
      :type_val (TypeTuple
        :fields (
          (TypeFormal
            :name 'A'
            :bound (KindType)
          )
          (FieldSig
            :name 'a'
            :type_sig (TypePath ('A'))
            :mode VALUE
          )
          (FieldSig
            :name 'f'
            :type_sig (TypeAll
              :quantifiers (
                (Quantifier
                  :name 'x'
                  :bound (KindPower
                    :bound (TypePath ('A'))
                  )
                  :mode VALUE
                )
              )
              :result_type (TypePath ('Int'))
            )
            :mode VALUE
          )
        )
      )
    )
    (LetValueBinding
      :name 't1'
      :value (ExprTuple
        :fields (
          (TypeBinding
            :name 'A'
            :type_val (TypePath ('Int'))
            :bound (KindType)
          )
          (TupleBinding
            :name 'a'
            :value (ExprInt 0 '0')
          )
          (TupleBinding
            :name 'f'
            :value (ExprFun
              :params (
                (FormalParam
                  :name 'x'
                  :type_annot (TypePath ('A'))
                  :mode VALUE
                )
              )
              :return_type (TypePath ('Int'))
              :body (ExprInfix
                :left (ExprId 'x')
                :op '+'
                :right (ExprInt 1 '1')
              )
            )
          )
        )
      )
      :type_annot (TypePath ('T'))
    )
    (ExprStmt
      :expr (ExprSelect
        :target (ExprId 't1')
        :field 'a'
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 't1')
          :field 'f'
        )
        :args (
          (ExprSelect
            :target (ExprId 't1')
            :field 'a'
          )
        )
      )
    )
  )
)
