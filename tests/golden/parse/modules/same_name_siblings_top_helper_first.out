(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('helper') 'Helper')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('um') 'UScaler' ('util/scaler') 'util/Scaler')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('m') 'Scaler' ('scaler'))
      )
    )
    (ExprStmt
      :expr (ExprInfix
        :left (ExprApp
          :func (ExprSelect
            :target (ExprId 'um')
            :field 'combine'
          )
          :args (
            (ExprInt 6 '6')
            (ExprInt 7 '7')
          )
        )
        :op '+'
        :right (ExprInfix
          :left (ExprApp
            :func (ExprSelect
              :target (ExprId 'm')
              :field 'combine'
            )
            :args (
              (ExprInt 100 '100')
            )
          )
          :op '+'
          :right (ExprSelect
            :target (ExprId 'helper')
            :field 'bonus'
          )
        )
      )
    )
  )
)
