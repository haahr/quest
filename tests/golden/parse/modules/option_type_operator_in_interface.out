(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('writer') 'Writer')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('conv') 'Conv')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('shapes') 'Shapes')
      )
    )
    (LetValueBinding
      :name 'c'
      :value (ExprOption
        :tag 'circle'
        :option_type (TypePath ('shapes' 'Shape'))
        :payload (ExprTuple
          :fields (
            (TupleBinding
              :name 'radius'
              :value (ExprInt 2 '2')
            )
          )
        )
      )
      :type_annot (TypePath ('shapes' 'Shape'))
    )
    (LetValueBinding
      :name 's'
      :value (ExprOption
        :tag 'square'
        :option_type (TypeApp
          :constructor (TypePath ('shapes' 'ShapeOf'))
          :arguments (
            (TypePath ('Int'))
          )
        )
        :payload (ExprTuple
          :fields (
            (TupleBinding
              :name 'side'
              :value (ExprInt 3 '3')
            )
          )
        )
      )
      :type_annot (TypeApp
        :constructor (TypePath ('shapes' 'ShapeOf'))
        :arguments (
          (TypePath ('Int'))
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprInfix
            :left (ExprApp
              :func (ExprSelect
                :target (ExprId 'conv')
                :field 'int'
              )
              :args (
                (ExprApp
                  :func (ExprSelect
                    :target (ExprId 'shapes')
                    :field 'area'
                  )
                  :args (
                    (ExprId 'c')
                  )
                )
              )
            )
            :op '<>'
            :right (ExprInfix
              :left (ExprString ' ' '" "')
              :op '<>'
              :right (ExprInfix
                :left (ExprApp
                  :func (ExprSelect
                    :target (ExprId 'conv')
                    :field 'int'
                  )
                  :args (
                    (ExprApp
                      :func (ExprSelect
                        :target (ExprId 'shapes')
                        :field 'area'
                      )
                      :args (
                        (ExprId 's')
                      )
                    )
                  )
                )
                :op '<>'
                :right (ExprString '\n' '"\\n"')
              )
            )
          )
        )
      )
    )
  )
)
