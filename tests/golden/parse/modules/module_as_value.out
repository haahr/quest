(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('calc') 'Calc')
      )
    )
    (LetValueBinding
      :name 'm'
      :value (ExprId 'calc')
    )
    (LetValueBinding
      :name 'fn'
      :value (ExprSelect
        :target (ExprId 'm')
        :field 'addMagic'
      )
    )
    (ExprStmt
      :expr (ExprInfix
        :left (ExprApp
          :func (ExprId 'fn')
          :args (
            (ExprInt 10 '10')
          )
        )
        :op '+'
        :right (ExprApp
          :func (ExprSelect
            :target (ExprId 'm')
            :field 'mulMagic'
          )
          :args (
            (ExprInt 2 '2')
          )
        )
      )
    )
  )
)
