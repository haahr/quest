(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('fileio') 'FileIO')
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'fileio')
          :field 'writeHello'
        )
        :args (
          (ExprSelect
            :target (ExprId 'fileio')
            :field 'stdout'
          )
        )
      )
    )
  )
)
