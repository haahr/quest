(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('pairs') 'Pairs')
      )
    )
    (ExprStmt
      :expr (ExprInfix
        :left (ExprInfix
          :left (ExprApp
            :func (ExprSelect
              :target (ExprId 'pairs')
              :field 'both'
            )
          )
          :op '*'
          :right (ExprInt 100 '100')
        )
        :op '+'
        :right (ExprInfix
          :left (ExprInfix
            :left (ExprSelect
              :target (ExprId 'pairs')
              :field 'first'
            )
            :op '*'
            :right (ExprInt 10 '10')
          )
          :op '+'
          :right (ExprSelect
            :target (ExprId 'pairs')
            :field 'second'
          )
        )
      )
    )
  )
)
