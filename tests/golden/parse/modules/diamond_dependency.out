(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('left') 'Left')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('right') 'Right')
      )
    )
    (LetValueBinding
      :name 'l'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'left')
          :field 'leftBump'
        )
        :args (
          (ExprInt 1 '1')
        )
      )
    )
    (LetValueBinding
      :name 'r'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'right')
          :field 'rightBump'
        )
        :args (
          (ExprInt 1 '1')
        )
      )
    )
    (ExprStmt
      :expr (ExprInfix
        :left (ExprId 'l')
        :op '+'
        :right (ExprId 'r')
      )
    )
  )
)
