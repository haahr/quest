(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('vector') 'Vector' ('collections/vector') 'collections/Vector')
        (ImportItem ('path') 'Path' ('util/path') 'util/Path')
        (ImportItem ('aliasTally') 'AliasTally')
        (ImportItem ('writer') 'Writer')
        (ImportItem ('conv') 'Conv')
      )
    )
    (LetValueBinding
      :name 't'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'aliasTally')
          :field 'make'
        )
        :args (
          (ExprString 'a//b/./c' '"a//b/./c"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'aliasTally')
          :field 'add'
        )
        :args (
          (ExprId 't')
          (ExprInt 5 '5')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'vector')
          :field 'append'
        )
        :args (
          (TypeArgument
            :type_val (TypePath ('Int'))
          )
          (ExprSelect
            :target (ExprId 't')
            :field 'items'
          )
          (ExprInt 6 '6')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprInfix
            :left (ExprString 'total ' '"total "')
            :op '<>'
            :right (ExprInfix
              :left (ExprApp
                :func (ExprSelect
                  :target (ExprId 'conv')
                  :field 'int'
                )
                :args (
                  (ExprApp
                    :func (ExprSelect
                      :target (ExprId 'aliasTally')
                      :field 'total'
                    )
                    :args (
                      (ExprId 't')
                    )
                  )
                )
              )
              :op '<>'
              :right (ExprInfix
                :left (ExprString ', items ' '", items "')
                :op '<>'
                :right (ExprInfix
                  :left (ExprApp
                    :func (ExprSelect
                      :target (ExprId 'conv')
                      :field 'int'
                    )
                    :args (
                      (ExprApp
                        :func (ExprSelect
                          :target (ExprId 'vector')
                          :field 'length'
                        )
                        :args (
                          (TypeArgument
                            :type_val (TypePath ('Int'))
                          )
                          (ExprSelect
                            :target (ExprId 't')
                            :field 'items'
                          )
                        )
                      )
                    )
                  )
                  :op '<>'
                  :right (ExprInfix
                    :left (ExprString ', origin ' '", origin "')
                    :op '<>'
                    :right (ExprInfix
                      :left (ExprApp
                        :func (ExprSelect
                          :target (ExprId 'path')
                          :field 'toString'
                        )
                        :args (
                          (ExprSelect
                            :target (ExprId 't')
                            :field 'origin'
                          )
                        )
                      )
                      :op '<>'
                      :right (ExprString '\n' '"\\n"')
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
