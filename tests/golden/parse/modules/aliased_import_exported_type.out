(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('aliasTally') 'AliasTally')
        (ImportItem ('writer') 'Writer')
        (ImportItem ('conv') 'Conv')
      )
    )
    (LetValueBinding
      :name 't'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'aliasTally')
          :field 'make'
        )
        :args (
          (ExprString 'a//b/./c' '"a//b/./c"')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'aliasTally')
          :field 'add'
        )
        :args (
          (ExprId 't')
          (ExprInt 3 '3')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'aliasTally')
          :field 'add'
        )
        :args (
          (ExprId 't')
          (ExprInt 4 '4')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprInfix
            :left (ExprString 'total ' '"total "')
            :op '<>'
            :right (ExprInfix
              :left (ExprApp
                :func (ExprSelect
                  :target (ExprId 'conv')
                  :field 'int'
                )
                :args (
                  (ExprApp
                    :func (ExprSelect
                      :target (ExprId 'aliasTally')
                      :field 'total'
                    )
                    :args (
                      (ExprId 't')
                    )
                  )
                )
              )
              :op '<>'
              :right (ExprString '\n' '"\\n"')
            )
          )
        )
      )
    )
  )
)
