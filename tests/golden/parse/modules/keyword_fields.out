(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('conv') 'Conv')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('writer') 'Writer')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('keywordFields') 'KeywordFields')
      )
    )
    (LetValueBinding
      :name 'r'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'keywordFields')
          :field 'make'
        )
        :args (
          (ExprInt 3 '3')
        )
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprInfix
            :left (ExprApp
              :func (ExprSelect
                :target (ExprId 'conv')
                :field 'int'
              )
              :args (
                (ExprInfix
                  :left (ExprSelect
                    :target (ExprId 'r')
                    :field 'long'
                  )
                  :op '+'
                  :right (ExprSelect
                    :target (ExprId 'r')
                    :field 'default'
                  )
                )
              )
            )
            :op '<>'
            :right (ExprString '\n' '"\\n"')
          )
        )
      )
    )
  )
)
