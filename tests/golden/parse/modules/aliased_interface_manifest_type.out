(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('pt') 'Pt' ('geom/point') 'geom/Point')
      )
    )
    (LetValueBinding
      :name 'p'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'pt')
          :field 'make'
        )
        :args (
          (ExprInt 15 '15')
          (ExprInt 27 '27')
        )
      )
      :type_annot (TypeManifest 'Pt' 'T')
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'pt')
          :field 'sumCoords'
        )
        :args (
          (ExprId 'p')
        )
      )
    )
    (ExprStmt
      :expr (ExprSelect
        :target (ExprId 'p')
        :field 'x'
      )
    )
  )
)
