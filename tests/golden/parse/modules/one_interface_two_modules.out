(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('ta' 'tb') 'Tally')
      )
    )
    (LetValueBinding
      :name 'x'
      :value (ExprInfix
        :left (ExprApp
          :func (ExprSelect
            :target (ExprId 'ta')
            :field 'get'
          )
          :args (
            (ExprApp
              :func (ExprSelect
                :target (ExprId 'ta')
                :field 'new'
              )
            )
          )
        )
        :op '+'
        :right (ExprApp
          :func (ExprSelect
            :target (ExprId 'tb')
            :field 'get'
          )
          :args (
            (ExprApp
              :func (ExprSelect
                :target (ExprId 'tb')
                :field 'new'
              )
            )
          )
        )
      )
    )
    (ExprStmt
      :expr (ExprId 'x')
    )
  )
)
