(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('writer') 'Writer')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('funValues') 'FunValues')
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'writer')
          :field 'putString'
        )
        :args (
          (ExprSelect
            :target (ExprId 'writer')
            :field 'output'
          )
          (ExprInfix
            :left (ExprApp
              :func (ExprSelect
                :target (ExprId 'funValues')
                :field 'run'
              )
              :args (
                (ExprString 'ab' '"ab"')
              )
            )
            :op '<>'
            :right (ExprString '\n' '"\\n"')
          )
        )
      )
    )
  )
)
