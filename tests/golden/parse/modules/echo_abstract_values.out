    )
    (LetValueBinding
      :name 'f'
      :value (ExprSelect
        :target (ExprId 'counter')
        :field 'get'
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'counter')
          :field 'get'
        )
