(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem () 'PT' 'PointType')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('aliasuse') 'AliasUse')
      )
    )
    (LetValueBinding
      :name 'p'
      :value (ExprTuple
        :fields (
          (TupleBinding
            :name 'x'
            :value (ExprInt 3 '3')
          )
          (TupleBinding
            :name 'y'
            :value (ExprInt 4 '4')
          )
        )
      )
      :type_annot (TypePath ('PT' 'P'))
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'aliasuse')
          :field 'sum'
        )
        :args (
          (ExprId 'p')
        )
      )
    )
  )
)
