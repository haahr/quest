(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('m') 'M' ('util/math') 'util/Math')
      )
    )
    (LetValueBinding
      :name 'res1'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'm')
          :field 'add'
        )
        :args (
          (ExprInt 10 '10')
          (ExprInt 20 '20')
        )
      )
      :type_annot (TypePath ('Int'))
    )
    (LetValueBinding
      :name 'res2'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'm')
          :field 'addWithOffset'
        )
        :args (
          (ExprInt 5 '5')
        )
      )
      :type_annot (TypePath ('Int'))
    )
    (ExprStmt
      :expr (ExprInfix
        :left (ExprId 'res1')
        :op '+'
        :right (ExprId 'res2')
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'm')
          :field 'square'
        )
        :args (
          (ExprInt 7 '7')
        )
      )
    )
  )
)
