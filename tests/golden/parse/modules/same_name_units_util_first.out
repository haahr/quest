(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('stepper') 'Stepper' ('util/stepper') 'util/Stepper')
      )
    )
    (ImportPhrase
      :items (
        (ImportItem ('counter') 'Counter')
      )
    )
    (ExprStmt
      :expr (ExprApp
        :func (ExprSelect
          :target (ExprId 'stepper')
          :field 'next'
        )
        :args (
          (ExprApp
            :func (ExprSelect
              :target (ExprId 'counter')
              :field 'get'
            )
            :args (
              (ExprApp
                :func (ExprSelect
                  :target (ExprId 'counter')
                  :field 'inc'
                )
                :args (
                  (ExprApp
                    :func (ExprSelect
                      :target (ExprId 'counter')
                      :field 'new'
                    )
                    :args (
                      (ExprInt 10 '10')
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
)
