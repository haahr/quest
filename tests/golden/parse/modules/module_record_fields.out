(Program
  :phrases (
    (ImportPhrase
      :items (
        (ImportItem ('service') 'Service')
      )
    )
    (LetValueBinding
      :name 'serv'
      :value (ExprId 'service')
    )
    (LetValueBinding
      :name 'greeting'
      :value (ExprApp
        :func (ExprSelect
          :target (ExprId 'serv')
          :field 'greet'
        )
        :args (
          (ExprString 'Quest' '"Quest"')
        )
      )
    )
    (ExprStmt
      :expr (ExprSelect
        :target (ExprId 'serv')
        :field 'code'
      )
    )
  )
)
