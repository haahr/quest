          :target (TypedVar 'diagbag' :type Module 'diagbag'))
        :args (
          (TypedVar 'bag' :type diagbag.T)
          (TypedVar 'sm' :type location.SourceMap)
          (TypedVar 'wOut' :type Writer.T)
        )))
  ))
