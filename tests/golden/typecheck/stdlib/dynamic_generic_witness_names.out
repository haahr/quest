(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('dynamic') : 'Dynamic')
      ))
    (TypedLetValue 'f' :type All(A :: TYPE) Fun(x: A): Dynamic
      :value (TypedFun :params (('x' : A)) :type All(A :: TYPE) Fun(x: A): Dynamic
        :body (TypedApp :type T
          :func (TypedTypeApp [Tuple v: A w: Int end] :type Fun(a: Tuple v: A w: Int end): T
            :func (TypedSelect 'new' :type All(A :: TYPE) Fun(a: A): T
              :target (TypedVar 'dynamic' :type Module 'dynamic')))
          :args (
            (TypedTuple :type Tuple v: A w: Int end
              :elements (
                (TypedVar 'x' :type A)
                (TypedInt 1 :type Int)
              ))
          ))))
    (TypedLetValue 'g' :type All(A :: TYPE) Fun(x: A): Dynamic
      :value (TypedVar 'f' :type All(A :: TYPE) Fun(x: A): Dynamic))
    (TypedLetValue 'pair' :type All(A :: TYPE B :: TYPE) Fun(a: A b: B): Dynamic
      :value (TypedFun :params (('a' : A) ('b' : B)) :type All(A :: TYPE B :: TYPE) Fun(a: A b: B): Dynamic
        :body (TypedApp :type T
          :func (TypedTypeApp [Tuple first: A second: Record r: B end both: Tuple x: A y: B end end] :type Fun(a: Tuple first: A second: Record r: B end both: Tuple x: A y: B end end): T
            :func (TypedSelect 'new' :type All(A :: TYPE) Fun(a: A): T
              :target (TypedVar 'dynamic' :type Module 'dynamic')))
          :args (
            (TypedTuple :type Tuple first: A second: Record r: B end both: Tuple x: A y: B end end
              :elements (
                (TypedVar 'a' :type A)
                (TypedRecord :type Record r: B end
                  :fields (
                    (TypedRecordField 'r'
                      :value (TypedVar 'b' :type B))
                  ))
                (TypedTuple :type Tuple x: A y: B end
                  :elements (
                    (TypedVar 'a' :type A)
                    (TypedVar 'b' :type B)
                  ))
              ))
          ))))
    (TypedLetValue 'h' :type All(A :: TYPE B :: TYPE) Fun(a: A b: B): Dynamic
      :value (TypedVar 'pair' :type All(A :: TYPE B :: TYPE) Fun(a: A b: B): Dynamic))
    (TypedExprStmt
      :expr (TypedApp :type Dynamic
        :func (TypedTypeApp [String] :type Fun(x: String): Dynamic
          :func (TypedVar 'g' :type All(A :: TYPE) Fun(x: A): Dynamic))
        :args (
          (TypedString 'hi' :type String)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Dynamic
        :func (TypedTypeApp [Int Record r: Bool end] :type Fun(a: Int b: Record r: Bool end): Dynamic
          :func (TypedVar 'h' :type All(A :: TYPE B :: TYPE) Fun(a: A b: B): Dynamic))
        :args (
          (TypedInt 3 :type Int)
          (TypedRecord :type Record r: Bool end
            :fields (
              (TypedRecordField 'r'
                :value (TypedBool true))
            ))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Dynamic
        :func (TypedTypeApp [Array(Int) Tuple Int end] :type Fun(a: Array(Int) b: Tuple Int end): Dynamic
          :func (TypedVar 'h' :type All(A :: TYPE B :: TYPE) Fun(a: A b: B): Dynamic))
        :args (
          (TypedArray :type Array(Int)
            :elements (
              (TypedInt 1 :type Int)
            ))
          (TypedTuple :type Tuple Int end
            :elements (
              (TypedInt 2 :type Int)
            ))
        )))
  ))
