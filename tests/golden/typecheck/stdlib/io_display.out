(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('display') : 'Display')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedSelect 'output' :type writer.T
            :target (TypedVar 'writer' :type Module 'writer'))
          (TypedString 'before\n' :type String)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Bool
        :func (TypedSelect 'inKernel' :type Fun(): Bool
          :target (TypedVar 'display' :type Module 'display'))
        :args ()))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'html' :type Fun(text: String): Ok
          :target (TypedVar 'display' :type Module 'display'))
        :args (
          (TypedString '<b>bold</b>' :type String)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'markdown' :type Fun(text: String): Ok
          :target (TypedVar 'display' :type Module 'display'))
        :args (
          (TypedString '# A heading' :type String)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'svg' :type Fun(text: String): Ok
          :target (TypedVar 'display' :type Module 'display'))
        :args (
          (TypedString '<svg/>' :type String)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'png' :type Fun(bytes: String): Ok
          :target (TypedVar 'display' :type Module 'display'))
        :args (
          (TypedString '\x89PNG' :type String)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'bundle' :type Fun(items: Array(Item)): Ok
          :target (TypedVar 'display' :type Module 'display'))
        :args (
          (TypedArray :type Array(Item)
            :elements (
              (TypedTuple :type Tuple mimeType: String data: String end
                :elements (
                  (TypedString 'application/json' :type String)
                  (TypedString '{}' :type String)
                ))
            ))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'bundle' :type Fun(items: Array(Item)): Ok
          :target (TypedVar 'display' :type Module 'display'))
        :args (
          (TypedArray :type Array(Item)
            :elements (
              (TypedTuple :type Tuple mimeType: String data: String end
                :elements (
                  (TypedString 'text/plain' :type String)
                  (TypedString 'plain' :type String)
                ))
            ))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedSelect 'output' :type writer.T
            :target (TypedVar 'writer' :type Module 'writer'))
          (TypedString 'after\n' :type String)
        )))
  ))
