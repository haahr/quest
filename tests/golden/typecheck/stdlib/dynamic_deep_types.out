(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('dynamic') : 'Dynamic')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('reader') : 'Reader')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedLetType 'Deep' :kind TYPE)
    (TypedLetValue 'd' :type Deep
      :value (TypedApp :type Deep
        :func (TypedTypeApp [Deep] :type Fun(d: T): Deep
          :func (TypedSelect 'be' :type All(A :: TYPE) Fun(d: T): A
            :target (TypedVar 'dynamic' :type Module 'dynamic')))
        :args (
          (TypedApp :type T
            :func (TypedSelect 'intern' :type Fun(rd: reader.T): T
              :target (TypedVar 'dynamic' :type Module 'dynamic'))
            :args (
              (TypedSelect 'input' :type reader.T
                :target (TypedVar 'reader' :type Module 'reader'))
            ))
        )))
    (TypedLetValue 'd10' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
      :value (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
        :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
          :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
            :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
              :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                  :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                    :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                      :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                        :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                          :target (TypedVar 'd' :type Deep))))))))))))
    (TypedLetValue 'd20' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
      :value (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
        :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
          :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
            :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
              :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                  :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                    :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                      :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                        :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                          :target (TypedVar 'd10' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end))))))))))))
    (TypedLetValue 'd30' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
      :value (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
        :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
          :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
            :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
              :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                  :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                    :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                      :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                        :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                          :target (TypedVar 'd20' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end))))))))))))
    (TypedLetValue 'd40' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
      :value (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
        :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
          :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
            :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
              :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                  :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                    :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                      :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                        :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                          :target (TypedVar 'd30' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end))))))))))))
    (TypedLetValue 'd50' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
      :value (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
        :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
          :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
            :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
              :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                  :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                    :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                      :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                        :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                          :target (TypedVar 'd40' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end))))))))))))
    (TypedLetValue 'd60' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
      :value (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
        :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
          :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
            :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
              :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                  :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                    :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                      :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                        :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                          :target (TypedVar 'd50' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end))))))))))))
    (TypedLetValue 'd70' :type Int
      :value (TypedSelect 'x' :type Int
        :target (TypedSelect 'x' :type Tuple x: Int end
          :target (TypedSelect 'x' :type Tuple x: Tuple x: Int end end
            :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Int end end end
              :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Int end end end end
                :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                  :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                    :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                      :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                        :target (TypedSelect 'x' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end
                          :target (TypedVar 'd60' :type Tuple x: Tuple x: Tuple x: Tuple x: Tuple ... end end end end end))))))))))))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedSelect 'output' :type writer.T
            :target (TypedVar 'writer' :type Module 'writer'))
          (TypedInfix '<>' :type String
            :left (TypedApp :type String
              :func (TypedSelect 'int' :type Fun(n: Int): String
                :target (TypedVar 'conv' :type Module 'conv'))
              :args (
                (TypedVar 'd70' :type Int)
              ))
            :right (TypedString '\n' :type String))
        )))
  ))
