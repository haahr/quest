(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('dynamic') : 'Dynamic')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('reader') : 'Reader')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedLetValue 'line' :type Fun(s: String): Ok
      :value (TypedFun :params (('s' : String)) :type Fun(s: String): Ok
        :body (TypedBlock :type Ok
          :bindings (
            (TypedExprStmt
              :expr (TypedApp :type Ok
                :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
                  :target (TypedVar 'writer' :type Module 'writer'))
                :args (
                  (TypedSelect 'output' :type writer.T
                    :target (TypedVar 'writer' :type Module 'writer'))
                  (TypedVar 's' :type String)
                )))
          )
          :result (TypedApp :type Ok
            :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
              :target (TypedVar 'writer' :type Module 'writer'))
            :args (
              (TypedSelect 'output' :type writer.T
                :target (TypedVar 'writer' :type Module 'writer'))
              (TypedString '\n' :type String)
            )))))
    (TypedLetType 'IntList' :kind TYPE)
    (TypedLetValue 'sum' :rec :type Fun(l: IntList): Int
      :value (TypedFun :params (('l' : IntList)) :type Fun(l: IntList): Int
        :body (TypedCase :type Int
          :target (TypedVar 'l' :type IntList)
          :branches (
            (TypedCaseBranch tags=(nil)
              :body (TypedInt 0 :type Int))
            (TypedCaseBranch tags=(cons) :binder 'c'
              :body (TypedInfix '+' :type Int
                :left (TypedSelect 'head' :type Int
                  :target (TypedVar 'c' :type Tuple head: Int tail: IntList end))
                :right (TypedApp :type Int
                  :func (TypedVar 'sum' :type Fun(l: IntList): Int)
                  :args (
                    (TypedSelect 'tail' :type IntList
                      :target (TypedVar 'c' :type Tuple head: Int tail: IntList end))
                  ))))
          ))))
    (TypedLetValue 'l' :type IntList
      :value (TypedApp :type IntList
        :func (TypedTypeApp [IntList] :type Fun(d: T): IntList
          :func (TypedSelect 'be' :type All(A :: TYPE) Fun(d: T): A
            :target (TypedVar 'dynamic' :type Module 'dynamic')))
        :args (
          (TypedApp :type T
            :func (TypedSelect 'intern' :type Fun(rd: reader.T): T
              :target (TypedVar 'dynamic' :type Module 'dynamic'))
            :args (
              (TypedSelect 'input' :type reader.T
                :target (TypedVar 'reader' :type Module 'reader'))
            ))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'line' :type Fun(s: String): Ok)
        :args (
          (TypedInfix '<>' :type String
            :left (TypedApp :type String
              :func (TypedSelect 'int' :type Fun(n: Int): String
                :target (TypedVar 'conv' :type Module 'conv'))
              :args (
                (TypedApp :type Int
                  :func (TypedVar 'sum' :type Fun(l: IntList): Int)
                  :args (
                    (TypedVar 'l' :type IntList)
                  ))
              ))
            :right (TypedInfix '<>' :type String
              :left (TypedString ' ' :type String)
              :right (TypedApp :type String
                :func (TypedSelect 'int' :type Fun(n: Int): String
                  :target (TypedVar 'conv' :type Module 'conv'))
                :args (
                  (TypedApp :type Int
                    :func (TypedVar 'ordinal' :type All(A :: TYPE) Fun(o: A): Int)
                    :args (
                      (TypedVar 'l' :type IntList)
                    ))
                ))))
        )))
    (TypedLetType 'Result' :kind TYPE)
    (TypedLetValue 'r' :type Result
      :value (TypedApp :type Result
        :func (TypedTypeApp [Result] :type Fun(d: T): Result
          :func (TypedSelect 'be' :type All(A :: TYPE) Fun(d: T): A
            :target (TypedVar 'dynamic' :type Module 'dynamic')))
        :args (
          (TypedApp :type T
            :func (TypedSelect 'intern' :type Fun(rd: reader.T): T
              :target (TypedVar 'dynamic' :type Module 'dynamic'))
            :args (
              (TypedSelect 'input' :type reader.T
                :target (TypedVar 'reader' :type Module 'reader'))
            ))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'line' :type Fun(s: String): Ok)
        :args (
          (TypedCase :type String
            :target (TypedVar 'r' :type Result)
            :branches (
              (TypedCaseBranch tags=(success)
                :body (TypedString 'success' :type String))
              (TypedCaseBranch tags=(error) :binder 'n'
                :body (TypedApp :type String
                  :func (TypedSelect 'int' :type Fun(n: Int): String
                    :target (TypedVar 'conv' :type Module 'conv'))
                  :args (
                    (TypedVar 'n' :type Int)
                  )))
            ))
        )))
  ))
