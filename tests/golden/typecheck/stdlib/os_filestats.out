                  :right (TypedInt 8 :type Int))
              ))))))
    (TypedLetValue 'show' :type Fun(what: String s: fileStats.T): Ok
      :value (TypedFun :params (('what' : String) ('s' : fileStats.T)) :type Fun(what: String s: fileStats.T): Ok
