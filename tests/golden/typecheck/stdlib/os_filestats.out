                          :right (TypedInfix '<>' :type String
                            :left (TypedString ': ' :type String)
                            :right (TypedSelect 'stderr' :type String
                              :target (TypedVar 'r' :type Tuple code: Int stdout: String stderr: String end)))))
                    )))
              )
              :result (TypedOk))
            :else (TypedOk)))))
    (TypedLetValue 'kindName' :type Fun(k: fileStats.Kind): String
      :value (TypedFun :params (('k' : fileStats.Kind)) :type Fun(k: fileStats.Kind): String
        :body (TypedIf :type String
