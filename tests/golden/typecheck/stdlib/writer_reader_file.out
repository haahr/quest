        :args (
          (TypedVar 'w' :type Writer.T)
          (TypedString 'Hello from Quest Reader/Writer!\n' :type String)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putChar' :type Fun(writer: Writer.T char: Char): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedVar 'w' :type Writer.T)
          (TypedChar 'X' :type Char)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putString' :type Fun(writer: Writer.T string: String): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedVar 'w' :type Writer.T)
          (TypedString '\n' :type String)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'flush' :type Fun(writer: Writer.T): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedVar 'w' :type Writer.T)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'close' :type Fun(writer: Writer.T): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedVar 'w' :type Writer.T)
        )))
    (TypedLetValue 'r' :type Reader.T
      :value (TypedApp :type Reader.T
        :func (TypedSelect 'file' :type Fun(name: String): Reader.T
          :target (TypedVar 'reader' :type Module 'reader'))
        :args (
          (TypedString 'roundtrip.txt' :type String)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Bool
        :func (TypedSelect 'more' :type Fun(reader: Reader.T): Bool
          :target (TypedVar 'reader' :type Module 'reader'))
        :args (
          (TypedVar 'r' :type Reader.T)
        )))
    (TypedExprStmt
      :expr (TypedApp :type String
        :func (TypedSelect 'getString' :type Fun(reader: Reader.T size: Int): String
          :target (TypedVar 'reader' :type Module 'reader'))
        :args (
          (TypedVar 'r' :type Reader.T)
          (TypedInt 32 :type Int)
        )))
    (TypedLetValue 'ch' :type Char
      :value (TypedApp :type Char
        :func (TypedSelect 'getChar' :type Fun(reader: Reader.T): Char
          :target (TypedVar 'reader' :type Module 'reader'))
        :args (
