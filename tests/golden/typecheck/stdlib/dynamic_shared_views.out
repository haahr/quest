(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('dynamic') : 'Dynamic')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('reader') : 'Reader')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedLetValue 'print' :type Fun(s: String): Ok
      :value (TypedFun :params (('s' : String)) :type Fun(s: String): Ok
        :body (TypedApp :type Ok
          :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
            :target (TypedVar 'writer' :type Module 'writer'))
          :args (
            (TypedSelect 'output' :type writer.T
              :target (TypedVar 'writer' :type Module 'writer'))
            (TypedInfix '<>' :type String
              :left (TypedVar 's' :type String)
              :right (TypedString '\n' :type String))
          ))))
    (TypedLetType 'Big' :kind TYPE)
    (TypedLetType 'Small' :kind TYPE)
    (TypedLetType 'Pair' :kind TYPE)
    (TypedLetType 'One' :kind TYPE)
    (TypedLetType 'Ints' :kind TYPE)
    (TypedLetValue 'r' :type Tuple x: Big y: Small end
      :value (TypedApp :type Tuple x: Big y: Small end
        :func (TypedTypeApp [Tuple x: Big y: Small end] :type Fun(d: T): Tuple x: Big y: Small end
          :func (TypedSelect 'be' :type All(A :: TYPE) Fun(d: T): A
            :target (TypedVar 'dynamic' :type Module 'dynamic')))
        :args (
          (TypedApp :type T
            :func (TypedSelect 'intern' :type Fun(rd: reader.T): T
              :target (TypedVar 'dynamic' :type Module 'dynamic'))
            :args (
              (TypedSelect 'input' :type reader.T
                :target (TypedVar 'reader' :type Module 'reader'))
            ))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedInfix '<>' :type String
            :left (TypedString 'record: ' :type String)
            :right (TypedInfix '<>' :type String
              :left (TypedApp :type String
                :func (TypedSelect 'int' :type Fun(n: Int): String
                  :target (TypedVar 'conv' :type Module 'conv'))
                :args (
                  (TypedSelect 'a' :type Int
                    :target (TypedSelect 'x' :type Big
                      :target (TypedVar 'r' :type Tuple x: Big y: Small end)))
                ))
              :right (TypedInfix '<>' :type String
                :left (TypedString ' ' :type String)
                :right (TypedInfix '<>' :type String
                  :left (TypedApp :type String
                    :func (TypedSelect 'int' :type Fun(n: Int): String
                      :target (TypedVar 'conv' :type Module 'conv'))
                    :args (
                      (TypedSelect 'b' :type Int
                        :target (TypedSelect 'x' :type Big
                          :target (TypedVar 'r' :type Tuple x: Big y: Small end)))
                    ))
                  :right (TypedInfix '<>' :type String
                    :left (TypedString ' ' :type String)
                    :right (TypedApp :type String
                      :func (TypedSelect 'int' :type Fun(n: Int): String
                        :target (TypedVar 'conv' :type Module 'conv'))
                      :args (
                        (TypedSelect 'b' :type Int
                          :target (TypedSelect 'y' :type Small
                            :target (TypedVar 'r' :type Tuple x: Big y: Small end)))
                      )))))))
        )))
    (TypedLetValue 't' :type Tuple x: Pair y: One end
      :value (TypedApp :type Tuple x: Pair y: One end
        :func (TypedTypeApp [Tuple x: Pair y: One end] :type Fun(d: T): Tuple x: Pair y: One end
          :func (TypedSelect 'be' :type All(A :: TYPE) Fun(d: T): A
            :target (TypedVar 'dynamic' :type Module 'dynamic')))
        :args (
          (TypedApp :type T
            :func (TypedSelect 'intern' :type Fun(rd: reader.T): T
              :target (TypedVar 'dynamic' :type Module 'dynamic'))
            :args (
              (TypedSelect 'input' :type reader.T
                :target (TypedVar 'reader' :type Module 'reader'))
            ))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedInfix '<>' :type String
            :left (TypedString 'tuple: ' :type String)
            :right (TypedInfix '<>' :type String
              :left (TypedApp :type String
                :func (TypedSelect 'int' :type Fun(n: Int): String
                  :target (TypedVar 'conv' :type Module 'conv'))
                :args (
                  (TypedSelect 'a' :type Int
                    :target (TypedSelect 'x' :type Pair
                      :target (TypedVar 't' :type Tuple x: Pair y: One end)))
                ))
              :right (TypedInfix '<>' :type String
                :left (TypedString ' ' :type String)
                :right (TypedInfix '<>' :type String
                  :left (TypedApp :type String
                    :func (TypedSelect 'int' :type Fun(n: Int): String
                      :target (TypedVar 'conv' :type Module 'conv'))
                    :args (
                      (TypedSelect 'b' :type Int
                        :target (TypedSelect 'x' :type Pair
                          :target (TypedVar 't' :type Tuple x: Pair y: One end)))
                    ))
                  :right (TypedInfix '<>' :type String
                    :left (TypedString ' ' :type String)
                    :right (TypedApp :type String
                      :func (TypedSelect 'int' :type Fun(n: Int): String
                        :target (TypedVar 'conv' :type Module 'conv'))
                      :args (
                        (TypedSelect 'a' :type Int
                          :target (TypedSelect 'y' :type One
                            :target (TypedVar 't' :type Tuple x: Pair y: One end)))
                      )))))))
        )))
    (TypedLetValue 'a' :type Tuple x: Ints y: Ints end
      :value (TypedApp :type Tuple x: Ints y: Ints end
        :func (TypedTypeApp [Tuple x: Ints y: Ints end] :type Fun(d: T): Tuple x: Ints y: Ints end
          :func (TypedSelect 'be' :type All(A :: TYPE) Fun(d: T): A
            :target (TypedVar 'dynamic' :type Module 'dynamic')))
        :args (
          (TypedApp :type T
            :func (TypedSelect 'intern' :type Fun(rd: reader.T): T
              :target (TypedVar 'dynamic' :type Module 'dynamic'))
            :args (
              (TypedSelect 'input' :type reader.T
                :target (TypedVar 'reader' :type Module 'reader'))
            ))
        )))
    (TypedExprStmt
      :expr (TypedIndexAssign
        :target (TypedSelect 'x' :type Ints
          :target (TypedVar 'a' :type Tuple x: Ints y: Ints end))
        :index (TypedInt 0 :type Int)
        :value (TypedInt 50 :type Int)))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedInfix '<>' :type String
            :left (TypedString 'array: ' :type String)
            :right (TypedInfix '<>' :type String
              :left (TypedApp :type String
                :func (TypedSelect 'int' :type Fun(n: Int): String
                  :target (TypedVar 'conv' :type Module 'conv'))
                :args (
                  (TypedIndex :type Int
                    :target (TypedSelect 'y' :type Ints
                      :target (TypedVar 'a' :type Tuple x: Ints y: Ints end))
                    :index (TypedInt 0 :type Int))
                ))
              :right (TypedInfix '<>' :type String
                :left (TypedString ' ' :type String)
                :right (TypedApp :type String
                  :func (TypedSelect 'int' :type Fun(n: Int): String
                    :target (TypedVar 'conv' :type Module 'conv'))
                  :args (
                    (TypedIndex :type Int
                      :target (TypedSelect 'y' :type Ints
                        :target (TypedVar 'a' :type Tuple x: Ints y: Ints end))
                      :index (TypedInt 1 :type Int))
                  )))))
        )))
    (TypedLetValue 'rejected' :type Fun(label: String): Ok
      :value (TypedFun :params (('label' : String)) :type Fun(label: String): Ok
        :body (TypedTry :type Ok
          :body (TypedBlock :type Ok
            :bindings (
              (TypedExprStmt
                :expr (TypedApp :type T
                  :func (TypedSelect 'intern' :type Fun(rd: reader.T): T
                    :target (TypedVar 'dynamic' :type Module 'dynamic'))
                  :args (
                    (TypedSelect 'input' :type reader.T
                      :target (TypedVar 'reader' :type Module 'reader'))
                  )))
            )
            :result (TypedApp :type Ok
              :func (TypedVar 'print' :type Fun(s: String): Ok)
              :args (
                (TypedInfix '<>' :type String
                  :left (TypedVar 'label' :type String)
                  :right (TypedString ': accepted' :type String))
              )))
          :branches (
            (TypedTryBranch
              :exc_pattern (TypedSelect 'error' :type Exception
                :target (TypedVar 'dynamic' :type Module 'dynamic'))
              :body (TypedApp :type Ok
                :func (TypedVar 'print' :type Fun(s: String): Ok)
                :args (
                  (TypedInfix '<>' :type String
                    :left (TypedVar 'label' :type String)
                    :right (TypedString ': dynamic.error' :type String))
                )))
          ))))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'rejected' :type Fun(label: String): Ok)
        :args (
          (TypedString 'Small at Big' :type String)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'rejected' :type Fun(label: String): Ok)
        :args (
          (TypedString 'tuple at record' :type String)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'rejected' :type Fun(label: String): Ok)
        :args (
          (TypedString 'Array(Big) at Array(Small)' :type String)
        )))
  ))
