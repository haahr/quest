(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedLetValue 'w' :type Module 'writer'
      :value (TypedVar 'writer' :type Module 'writer'))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putString' :type Fun(writer: Writer.T string: String): Ok
          :target (TypedVar 'w' :type Module 'writer'))
        :args (
          (TypedSelect 'output' :type Writer.T
            :target (TypedVar 'w' :type Module 'writer'))
          (TypedString 'First class module record dispatched!\n' :type String)
        )))
    (TypedLetValue 'id' :type All(A :: TYPE) Fun(a: A): A
      :value (TypedFun :params (('a' : A)) :type All(A :: TYPE) Fun(a: A): A
        :body (TypedVar 'a' :type A)))
    (TypedLetValue 'w2' :type Writer.T
      :value (TypedApp :type Writer.T
        :func (TypedTypeApp [Writer.T] :type Fun(a: Writer.T): Writer.T
          :func (TypedVar 'id' :type All(A :: TYPE) Fun(a: A): A))
        :args (
          (TypedSelect 'output' :type Writer.T
            :target (TypedVar 'writer' :type Module 'writer'))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putString' :type Fun(writer: Writer.T string: String): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedVar 'w2' :type Writer.T)
          (TypedString 'Writer.T passed as generic argument!\n' :type String)
        )))
  ))
