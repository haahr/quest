(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('reader') : 'Reader')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('dynamic') : 'Dynamic')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedLetValue 'print' :type Fun(s: String): Ok
      :value (TypedFun :params (('s' : String)) :type Fun(s: String): Ok
        :body (TypedApp :type Ok
          :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
            :target (TypedVar 'writer' :type Module 'writer'))
          :args (
            (TypedSelect 'output' :type writer.T
              :target (TypedVar 'writer' :type Module 'writer'))
            (TypedInfix '<>' :type String
              :left (TypedVar 's' :type String)
              :right (TypedString '\n' :type String))
          ))))
    (TypedLetType 'R' :kind TYPE)
    (TypedLetValue 'names' :type Array(String)
      :value (TypedArray :type Array(String)
        :elements (
          (TypedString 'well-formed' :type String)
          (TypedString 'the value repeats a field' :type String)
          (TypedString 'well-formed' :type String)
          (TypedString 'the type repeats a field' :type String)
          (TypedString 'well-formed' :type String)
          (TypedString 'both repeat it' :type String)
          (TypedString 'well-formed' :type String)
          (TypedString 'a repeated key in an array, after a string of brackets' :type String)
          (TypedString 'well-formed' :type String)
          (TypedString 'an escape above \\u00ff' :type String)
          (TypedString 'well-formed' :type String)
          (TypedString 'another version' :type String)
          (TypedString 'well-formed' :type String)
        )))
    (TypedExprStmt
      :expr (TypedFor 'i' :upto
        :start (TypedInt 0 :type Int)
        :stop (TypedInfix '-' :type Int
          :left (TypedApp :type Int
            :func (TypedTypeApp [String] :type Fun(a: Array(String)): Int
              :func (TypedVar 'extent' :type All(A :: TYPE) Fun(a: Array(A)): Int))
            :args (
              (TypedVar 'names' :type Array(String))
            ))
          :right (TypedInt 1 :type Int))
        :body (TypedApp :type Ok
          :func (TypedVar 'print' :type Fun(s: String): Ok)
          :args (
            (TypedInfix '<>' :type String
              :left (TypedIndex :type String
                :target (TypedVar 'names' :type Array(String))
                :index (TypedVar 'i' :type Int))
              :right (TypedInfix '<>' :type String
                :left (TypedString ': ' :type String)
                :right (TypedTry :type String
                  :body (TypedInfix '<>' :type String
                    :left (TypedString 'a = ' :type String)
                    :right (TypedApp :type String
                      :func (TypedSelect 'int' :type Fun(n: Int): String
                        :target (TypedVar 'conv' :type Module 'conv'))
                      :args (
                        (TypedSelect 'a' :type Int
                          :target (TypedApp :type R
                            :func (TypedTypeApp [R] :type Fun(d: T): R
                              :func (TypedSelect 'be' :type All(A :: TYPE) Fun(d: T): A
                                :target (TypedVar 'dynamic' :type Module 'dynamic')))
                            :args (
                              (TypedApp :type T
                                :func (TypedSelect 'intern' :type Fun(rd: reader.T): T
                                  :target (TypedVar 'dynamic' :type Module 'dynamic'))
                                :args (
                                  (TypedSelect 'input' :type reader.T
                                    :target (TypedVar 'reader' :type Module 'reader'))
                                ))
                            )))
                      )))
                  :branches (
                    (TypedTryBranch
                      :exc_pattern (TypedSelect 'error' :type Exception
                        :target (TypedVar 'dynamic' :type Module 'dynamic'))
                      :body (TypedString 'dynamic.error' :type String))
                  ))))
          ))))
  ))
