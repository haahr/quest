(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('left') : 'Left')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('right') : 'Right')
      ))
    (TypedLetValue 'l' :type Int
      :value (TypedApp :type Int
        :func (TypedSelect 'leftBump' :type Fun(step: Int): Int
          :target (TypedVar 'left' :type Module 'left'))
        :args (
          (TypedInt 1 :type Int)
        )))
    (TypedLetValue 'r' :type Int
      :value (TypedApp :type Int
        :func (TypedSelect 'rightBump' :type Fun(step: Int): Int
          :target (TypedVar 'right' :type Module 'right'))
        :args (
          (TypedInt 1 :type Int)
        )))
    (TypedExprStmt
      :expr (TypedInfix '+' :type Int
        :left (TypedVar 'l' :type Int)
        :right (TypedVar 'r' :type Int)))
  ))
