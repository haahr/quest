(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('service') : 'Service')
      ))
    (TypedLetValue 'serv' :type Module 'service'
      :value (TypedVar 'service' :type Module 'service'))
    (TypedLetValue 'greeting' :type String
      :value (TypedApp :type String
        :func (TypedSelect 'greet' :type Fun(name: String): String
          :target (TypedVar 'serv' :type Module 'service'))
        :args (
          (TypedString 'Quest' :type String)
        )))
    (TypedExprStmt
      :expr (TypedSelect 'code' :type Int
        :target (TypedVar 'serv' :type Module 'service')))
  ))
