(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('aliasTally') : 'AliasTally')
        (TypedImportItem ('writer') : 'Writer')
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedLetValue 't' :type T
      :value (TypedApp :type T
        :func (TypedSelect 'make' :type Fun(origin: String): T
          :target (TypedVar 'aliasTally' :type Module 'aliasTally'))
        :args (
          (TypedString 'a//b/./c' :type String)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'add' :type Fun(t: T n: Int): Ok
          :target (TypedVar 'aliasTally' :type Module 'aliasTally'))
        :args (
          (TypedVar 't' :type T)
          (TypedInt 3 :type Int)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'add' :type Fun(t: T n: Int): Ok
          :target (TypedVar 'aliasTally' :type Module 'aliasTally'))
        :args (
          (TypedVar 't' :type T)
          (TypedInt 4 :type Int)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedSelect 'output' :type writer.T
            :target (TypedVar 'writer' :type Module 'writer'))
          (TypedInfix '<>' :type String
            :left (TypedString 'total ' :type String)
            :right (TypedInfix '<>' :type String
              :left (TypedApp :type String
                :func (TypedSelect 'int' :type Fun(n: Int): String
                  :target (TypedVar 'conv' :type Module 'conv'))
                :args (
                  (TypedApp :type Int
                    :func (TypedSelect 'total' :type Fun(t: T): Int
                      :target (TypedVar 'aliasTally' :type Module 'aliasTally'))
                    :args (
                      (TypedVar 't' :type T)
                    ))
                ))
              :right (TypedString '\n' :type String)))
        )))
  ))
