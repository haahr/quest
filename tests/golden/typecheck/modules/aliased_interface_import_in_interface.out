(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem : 'PT')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('aliasuse') : 'AliasUse')
      ))
    (TypedLetValue 'p' :type PT.P
      :value (TypedTuple :type Tuple x: Int y: Int end
        :elements (
          (TypedInt 3 :type Int)
          (TypedInt 4 :type Int)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Int
        :func (TypedSelect 'sum' :type Fun(p: PT.P): Int
          :target (TypedVar 'aliasuse' :type Module 'aliasuse'))
        :args (
          (TypedVar 'p' :type PT.P)
        )))
  ))
