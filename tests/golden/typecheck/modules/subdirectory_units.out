(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('counter') : 'Counter')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('arith') : 'Arith')
      ))
    (TypedExprStmt
      :expr (TypedApp :type Int
        :func (TypedSelect 'bump' :type Fun(x: Int): Int
          :target (TypedVar 'arith' :type Module 'arith'))
        :args (
          (TypedApp :type Int
            :func (TypedSelect 'get' :type Fun(c: counter.T): Int
              :target (TypedVar 'counter' :type Module 'counter'))
            :args (
              (TypedApp :type counter.T
                :func (TypedSelect 'inc' :type Fun(c: counter.T): counter.T
                  :target (TypedVar 'counter' :type Module 'counter'))
                :args (
                  (TypedApp :type counter.T
                    :func (TypedSelect 'new' :type Fun(init: Int): counter.T
                      :target (TypedVar 'counter' :type Module 'counter'))
                    :args (
                      (TypedInt 10 :type Int)
                    ))
                ))
            ))
        )))
  ))
