(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('fileio') : 'FileIO')
      ))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'writeHello' :type Fun(h: fileio.Handle): Ok
          :target (TypedVar 'fileio' :type Module 'fileio'))
        :args (
          (TypedSelect 'stdout' :type fileio.Handle
            :target (TypedVar 'fileio' :type Module 'fileio'))
        )))
  ))
