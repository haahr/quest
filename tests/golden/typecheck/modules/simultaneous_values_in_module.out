(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('pairs') : 'Pairs')
      ))
    (TypedExprStmt
      :expr (TypedInfix '+' :type Int
        :left (TypedInfix '*' :type Int
          :left (TypedApp :type Int
            :func (TypedSelect 'both' :type Fun(): Int
              :target (TypedVar 'pairs' :type Module 'pairs'))
            :args ())
          :right (TypedInt 100 :type Int))
        :right (TypedInfix '+' :type Int
          :left (TypedInfix '*' :type Int
            :left (TypedSelect 'first' :type Int
              :target (TypedVar 'pairs' :type Module 'pairs'))
            :right (TypedInt 10 :type Int))
          :right (TypedSelect 'second' :type Int
            :target (TypedVar 'pairs' :type Module 'pairs')))))
  ))
