(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('calc') : 'Calc')
      ))
    (TypedLetValue 'm' :type Module 'calc'
      :value (TypedVar 'calc' :type Module 'calc'))
    (TypedLetValue 'fn' :type Fun(x: Int): Int
      :value (TypedSelect 'addMagic' :type Fun(x: Int): Int
        :target (TypedVar 'm' :type Module 'calc')))
    (TypedExprStmt
      :expr (TypedInfix '+' :type Int
        :left (TypedApp :type Int
          :func (TypedVar 'fn' :type Fun(x: Int): Int)
          :args (
            (TypedInt 10 :type Int)
          ))
        :right (TypedApp :type Int
          :func (TypedSelect 'mulMagic' :type Fun(x: Int): Int
            :target (TypedVar 'm' :type Module 'calc'))
          :args (
            (TypedInt 2 :type Int)
          ))))
  ))
