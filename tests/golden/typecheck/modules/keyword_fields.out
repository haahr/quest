(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('keywordFields') : 'KeywordFields')
      ))
    (TypedLetValue 'r' :type R
      :value (TypedApp :type R
        :func (TypedSelect 'make' :type Fun(n: Int): R
          :target (TypedVar 'keywordFields' :type Module 'keywordFields'))
        :args (
          (TypedInt 3 :type Int)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedSelect 'output' :type writer.T
            :target (TypedVar 'writer' :type Module 'writer'))
          (TypedInfix '<>' :type String
            :left (TypedApp :type String
              :func (TypedSelect 'int' :type Fun(n: Int): String
                :target (TypedVar 'conv' :type Module 'conv'))
              :args (
                (TypedInfix '+' :type Int
                  :left (TypedSelect 'long' :type Int
                    :target (TypedVar 'r' :type R))
                  :right (TypedSelect 'default' :type Int
                    :target (TypedVar 'r' :type R)))
              ))
            :right (TypedString '\n' :type String))
        )))
  ))
