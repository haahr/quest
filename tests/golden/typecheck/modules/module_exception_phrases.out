    (TypedLetValue 'describe' :type Fun(n: Int): String
      :value (TypedFun :params (('n' : Int)) :type Fun(n: Int): String
        :body (TypedTry :type String
          :body (TypedBlock :type String
            :bindings (
              (TypedExprStmt
