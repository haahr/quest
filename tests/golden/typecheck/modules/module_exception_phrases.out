          ))))
    (TypedExprStmt
      :expr (TypedInfix '<>' :type String
        :left (TypedApp :type String
          :func (TypedVar 'describe' :type Fun(n: Int): String)
          :args (
            (TypedInt 2 :type Int)
          ))
        :right (TypedInfix '<>' :type String
          :left (TypedString ', ' :type String)
          :right (TypedInfix '<>' :type String
            :left (TypedApp :type String
