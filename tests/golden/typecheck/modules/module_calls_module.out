(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('usepick') : 'UsePick')
      ))
    (TypedExprStmt
      :expr (TypedApp :type Int
        :func (TypedSelect 'combine' :type Fun(): Int
          :target (TypedVar 'usepick' :type Module 'usepick'))
        :args ()))
  ))
