(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('ta' 'tb') : 'Tally')
      ))
    (TypedLetValue 'x' :type Int
      :value (TypedInfix '+' :type Int
        :left (TypedApp :type Int
          :func (TypedSelect 'get' :type Fun(c: ta.T): Int
            :target (TypedVar 'ta' :type Module 'ta'))
          :args (
            (TypedApp :type ta.T
              :func (TypedSelect 'new' :type Fun(): ta.T
                :target (TypedVar 'ta' :type Module 'ta'))
              :args ())
          ))
        :right (TypedApp :type Int
          :func (TypedSelect 'get' :type Fun(c: tb.T): Int
            :target (TypedVar 'tb' :type Module 'tb'))
          :args (
            (TypedApp :type tb.T
              :func (TypedSelect 'new' :type Fun(): tb.T
                :target (TypedVar 'tb' :type Module 'tb'))
              :args ())
          ))))
    (TypedExprStmt
      :expr (TypedVar 'x' :type Int))
  ))
