(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('ledger') : 'Ledger')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedLetValue 'print' :type Fun(s: String): Ok
      :value (TypedFun :params (('s' : String)) :type Fun(s: String): Ok
        :body (TypedApp :type Ok
          :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
            :target (TypedVar 'writer' :type Module 'writer'))
          :args (
            (TypedSelect 'output' :type writer.T
              :target (TypedVar 'writer' :type Module 'writer'))
            (TypedInfix '<>' :type String
              :left (TypedVar 's' :type String)
              :right (TypedString '\n' :type String))
          ))))
    (TypedLetValue 'a' :type ledger.T
      :value (TypedApp :type ledger.T
        :func (TypedSelect 'new' :type Fun(name: String start: Int): ledger.T
          :target (TypedVar 'ledger' :type Module 'ledger'))
        :args (
          (TypedString 'a' :type String)
          (TypedInt 10 :type Int)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedInfix '<>' :type String
            :left (TypedApp :type String
              :func (TypedSelect 'name' :type Fun(l: ledger.T): String
                :target (TypedVar 'ledger' :type Module 'ledger'))
              :args (
                (TypedVar 'a' :type ledger.T)
              ))
            :right (TypedInfix '<>' :type String
              :left (TypedString ' ' :type String)
              :right (TypedApp :type String
                :func (TypedSelect 'int' :type Fun(n: Int): String
                  :target (TypedVar 'conv' :type Module 'conv'))
                :args (
                  (TypedApp :type Int
                    :func (TypedSelect 'balance' :type Fun(l: ledger.T): Int
                      :target (TypedVar 'ledger' :type Module 'ledger'))
                    :args (
                      (TypedVar 'a' :type ledger.T)
                    ))
                ))))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'add' :type Fun(l: ledger.T amount: Int): Ok
          :target (TypedVar 'ledger' :type Module 'ledger'))
        :args (
          (TypedVar 'a' :type ledger.T)
          (TypedInt 5 :type Int)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedInfix '<>' :type String
            :left (TypedApp :type String
              :func (TypedSelect 'name' :type Fun(l: ledger.T): String
                :target (TypedVar 'ledger' :type Module 'ledger'))
              :args (
                (TypedVar 'a' :type ledger.T)
              ))
            :right (TypedInfix '<>' :type String
              :left (TypedString ' ' :type String)
              :right (TypedApp :type String
                :func (TypedSelect 'int' :type Fun(n: Int): String
                  :target (TypedVar 'conv' :type Module 'conv'))
                :args (
                  (TypedApp :type Int
                    :func (TypedSelect 'balance' :type Fun(l: ledger.T): Int
                      :target (TypedVar 'ledger' :type Module 'ledger'))
                    :args (
                      (TypedVar 'a' :type ledger.T)
                    ))
                ))))
        )))
    (TypedLetValue 'b' :type ledger.T
      :value (TypedVar 'a' :type ledger.T))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'add' :type Fun(l: ledger.T amount: Int): Ok
          :target (TypedVar 'ledger' :type Module 'ledger'))
        :args (
          (TypedVar 'b' :type ledger.T)
          (TypedInt 1 :type Int)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedInfix '<>' :type String
            :left (TypedApp :type String
              :func (TypedSelect 'describe' :type Fun(l: ledger.T): String
                :target (TypedVar 'ledger' :type Module 'ledger'))
              :args (
                (TypedVar 'a' :type ledger.T)
              ))
            :right (TypedInfix '<>' :type String
              :left (TypedString ', ' :type String)
              :right (TypedApp :type String
                :func (TypedSelect 'describe' :type Fun(l: ledger.T): String
                  :target (TypedVar 'ledger' :type Module 'ledger'))
                :args (
                  (TypedVar 'b' :type ledger.T)
                ))))
        )))
    (TypedLetValue 'total' :type Fun(n: Int): Int
      :value (TypedFun :params (('n' : Int)) :type Fun(n: Int): Int
        :body (TypedBlock :type Int
          :bindings (
            (TypedLetValue 'l' :type ledger.T
              :value (TypedApp :type ledger.T
                :func (TypedSelect 'new' :type Fun(name: String start: Int): ledger.T
                  :target (TypedVar 'ledger' :type Module 'ledger'))
                :args (
                  (TypedString 'loop' :type String)
                  (TypedInt 0 :type Int)
                )))
            (TypedExprStmt
              :expr (TypedFor 'i' :upto
                :start (TypedInt 1 :type Int)
                :stop (TypedVar 'n' :type Int)
                :body (TypedApp :type Ok
                  :func (TypedSelect 'add' :type Fun(l: ledger.T amount: Int): Ok
                    :target (TypedVar 'ledger' :type Module 'ledger'))
                  :args (
                    (TypedVar 'l' :type ledger.T)
                    (TypedVar 'i' :type Int)
                  ))))
          )
          :result (TypedApp :type Int
            :func (TypedSelect 'balance' :type Fun(l: ledger.T): Int
              :target (TypedVar 'ledger' :type Module 'ledger'))
            :args (
              (TypedVar 'l' :type ledger.T)
            )))))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedInfix '<>' :type String
            :left (TypedString 'total ' :type String)
            :right (TypedApp :type String
              :func (TypedSelect 'int' :type Fun(n: Int): String
                :target (TypedVar 'conv' :type Module 'conv'))
              :args (
                (TypedApp :type Int
                  :func (TypedVar 'total' :type Fun(n: Int): Int)
                  :args (
                    (TypedInt 100 :type Int)
                  ))
              )))
        )))
    (TypedLetType 'Big' :kind TYPE)
    (TypedLetType 'Small' :kind TYPE)
    (TypedLetType 'Wide' :kind TYPE)
    (TypedLetType 'Narrow' :kind TYPE)
    (TypedLetValue 'w' :type Wide
      :value (TypedTuple :type Tuple r: Big var n: Int tag: String end
        :elements (
          (TypedRecord :type Record x: Int y: Int z: Int end
            :fields (
              (TypedRecordField 'x'
                :value (TypedInt 1 :type Int))
              (TypedRecordField 'y'
                :value (TypedInt 2 :type Int))
              (TypedRecordField 'z'
                :value (TypedInt 3 :type Int))
            ))
          (TypedInt 4 :type Int)
          (TypedString 'w' :type String)
        )))
    (TypedLetValue 'narrow' :type Narrow
      :value (TypedVar 'w' :type Wide))
    (TypedExprStmt
      :expr (TypedAssign
        :target (TypedSelect 'n' :type Int
          :target (TypedVar 'narrow' :type Narrow))
        :value (TypedInfix '+' :type Int
          :left (TypedSelect 'n' :type Int
            :target (TypedVar 'narrow' :type Narrow))
          :right (TypedInt 10 :type Int))))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedInfix '<>' :type String
            :left (TypedString 'narrow ' :type String)
            :right (TypedInfix '<>' :type String
              :left (TypedApp :type String
                :func (TypedSelect 'int' :type Fun(n: Int): String
                  :target (TypedVar 'conv' :type Module 'conv'))
                :args (
                  (TypedInfix '+' :type Int
                    :left (TypedSelect 'x' :type Int
                      :target (TypedSelect 'r' :type Small
                        :target (TypedVar 'narrow' :type Narrow)))
                    :right (TypedSelect 'y' :type Int
                      :target (TypedSelect 'r' :type Small
                        :target (TypedVar 'narrow' :type Narrow))))
                ))
              :right (TypedInfix '<>' :type String
                :left (TypedString ' ' :type String)
                :right (TypedInfix '<>' :type String
                  :left (TypedApp :type String
                    :func (TypedSelect 'int' :type Fun(n: Int): String
                      :target (TypedVar 'conv' :type Module 'conv'))
                    :args (
                      (TypedSelect 'n' :type Int
                        :target (TypedVar 'narrow' :type Narrow))
                    ))
                  :right (TypedInfix '<>' :type String
                    :left (TypedString ' wide ' :type String)
                    :right (TypedApp :type String
                      :func (TypedSelect 'int' :type Fun(n: Int): String
                        :target (TypedVar 'conv' :type Module 'conv'))
                      :args (
                        (TypedSelect 'n' :type Int
                          :target (TypedVar 'w' :type Wide))
                      )))))))
        )))
  ))
