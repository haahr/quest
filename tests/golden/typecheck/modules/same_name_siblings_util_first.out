(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('um') : 'UScaler')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('m') : 'Scaler')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('helper') : 'Helper')
      ))
    (TypedExprStmt
      :expr (TypedInfix '+' :type Int
        :left (TypedApp :type Int
          :func (TypedSelect 'combine' :type Fun(a: Int b: Int): Int
            :target (TypedVar 'um' :type Module 'um'))
          :args (
            (TypedInt 6 :type Int)
            (TypedInt 7 :type Int)
          ))
        :right (TypedInfix '+' :type Int
          :left (TypedApp :type Int
            :func (TypedSelect 'combine' :type Fun(a: Int): Int
              :target (TypedVar 'm' :type Module 'm'))
            :args (
              (TypedInt 100 :type Int)
            ))
          :right (TypedSelect 'bonus' :type Int
            :target (TypedVar 'helper' :type Module 'helper')))))
  ))
