(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('vector') : 'Vector')
        (TypedImportItem ('path') : 'Path')
        (TypedImportItem ('aliasTally') : 'AliasTally')
        (TypedImportItem ('writer') : 'Writer')
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedLetValue 't' :type T
      :value (TypedApp :type T
        :func (TypedSelect 'make' :type Fun(origin: String): T
          :target (TypedVar 'aliasTally' :type Module 'aliasTally'))
        :args (
          (TypedString 'a//b/./c' :type String)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'add' :type Fun(t: T n: Int): Ok
          :target (TypedVar 'aliasTally' :type Module 'aliasTally'))
        :args (
          (TypedVar 't' :type T)
          (TypedInt 5 :type Int)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedTypeApp [Int] :type Fun(v: vector.T(Int) value: Int): Ok
          :func (TypedSelect 'append' :type All(A :: TYPE) Fun(v: vector.T(A) value: A): Ok
            :target (TypedVar 'vector' :type Module 'vector')))
        :args (
          (TypedSelect 'items' :type vector.T(Int)
            :target (TypedVar 't' :type T))
          (TypedInt 6 :type Int)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedSelect 'output' :type writer.T
            :target (TypedVar 'writer' :type Module 'writer'))
          (TypedInfix '<>' :type String
            :left (TypedString 'total ' :type String)
            :right (TypedInfix '<>' :type String
              :left (TypedApp :type String
                :func (TypedSelect 'int' :type Fun(n: Int): String
                  :target (TypedVar 'conv' :type Module 'conv'))
                :args (
                  (TypedApp :type Int
                    :func (TypedSelect 'total' :type Fun(t: T): Int
                      :target (TypedVar 'aliasTally' :type Module 'aliasTally'))
                    :args (
                      (TypedVar 't' :type T)
                    ))
                ))
              :right (TypedInfix '<>' :type String
                :left (TypedString ', items ' :type String)
                :right (TypedInfix '<>' :type String
                  :left (TypedApp :type String
                    :func (TypedSelect 'int' :type Fun(n: Int): String
                      :target (TypedVar 'conv' :type Module 'conv'))
                    :args (
                      (TypedApp :type Int
                        :func (TypedTypeApp [Int] :type Fun(v: vector.T(Int)): Int
                          :func (TypedSelect 'length' :type All(A :: TYPE) Fun(v: vector.T(A)): Int
                            :target (TypedVar 'vector' :type Module 'vector')))
                        :args (
                          (TypedSelect 'items' :type vector.T(Int)
                            :target (TypedVar 't' :type T))
                        ))
                    ))
                  :right (TypedInfix '<>' :type String
                    :left (TypedString ', origin ' :type String)
                    :right (TypedInfix '<>' :type String
                      :left (TypedApp :type String
                        :func (TypedSelect 'toString' :type Fun(p: path.T): String
                          :target (TypedVar 'path' :type Module 'path'))
                        :args (
                          (TypedSelect 'origin' :type path.T
                            :target (TypedVar 't' :type T))
                        ))
                      :right (TypedString '\n' :type String)))))))
        )))
  ))
