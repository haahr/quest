(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedLetValue 'wOut' :type Writer.T
      :value (TypedSelect 'output' :type Writer.T
        :target (TypedVar 'writer' :type Module 'writer')))
    (TypedLetValue 'printInt' :type Fun(x: Int): Ok
      :value (TypedFun :params (('x' : Int)) :type Fun(x: Int): Ok
        :body (TypedBlock :type Ok
          :bindings (
            (TypedExprStmt
              :expr (TypedApp :type Ok
                :func (TypedSelect 'putString' :type Fun(writer: Writer.T string: String): Ok
                  :target (TypedVar 'writer' :type Module 'writer'))
                :args (
                  (TypedVar 'wOut' :type Writer.T)
                  (TypedApp :type String
                    :func (TypedSelect 'int' :type Fun(n: Int): String
                      :target (TypedVar 'conv' :type Module 'conv'))
                    :args (
                      (TypedVar 'x' :type Int)
                    ))
                )))
          )
          :result (TypedApp :type Ok
            :func (TypedSelect 'putString' :type Fun(writer: Writer.T string: String): Ok
              :target (TypedVar 'writer' :type Module 'writer'))
            :args (
              (TypedVar 'wOut' :type Writer.T)
              (TypedString '\n' :type String)
            )))))
    (TypedLetType 'Point' :kind TYPE)
    (TypedLetValue 'id' :type All(A :: TYPE) Fun(a: A): A
      :value (TypedFun :params (('a' : A)) :type All(A :: TYPE) Fun(a: A): A
        :body (TypedVar 'a' :type A)))
    (TypedLetValue 'p' :type Record x: Int y: Int end
      :value (TypedRecord :type Record x: Int y: Int end
        :fields (
          (TypedRecordField 'x'
            :value (TypedInt 42 :type Int))
          (TypedRecordField 'y'
            :value (TypedInt 100 :type Int))
        )))
    (TypedLetValue 'pRes' :type Point
      :value (TypedApp :type Point
        :func (TypedTypeApp [Point] :type Fun(a: Point): Point
          :func (TypedVar 'id' :type All(A :: TYPE) Fun(a: A): A))
        :args (
          (TypedVar 'p' :type Record x: Int y: Int end)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'printInt' :type Fun(x: Int): Ok)
        :args (
          (TypedSelect 'x' :type Int
            :target (TypedVar 'pRes' :type Point))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'printInt' :type Fun(x: Int): Ok)
        :args (
          (TypedSelect 'y' :type Int
            :target (TypedVar 'pRes' :type Point))
        )))
    (TypedLetValue 'pair' :type All(A :: TYPE B :: TYPE) Fun(a: A b: B): Tuple first: A second: B end
      :value (TypedFun :params (('a' : A) ('b' : B)) :type All(A :: TYPE B :: TYPE) Fun(a: A b: B): Tuple first: A second: B end
        :body (TypedTuple :type Tuple first: A second: B end
          :elements (
            (TypedVar 'a' :type A)
            (TypedVar 'b' :type B)
          ))))
    (TypedLetValue 'pr' :type Tuple first: Int second: Point end
      :value (TypedApp :type Tuple first: Int second: Point end
        :func (TypedTypeApp [Int Point] :type Fun(a: Int b: Point): Tuple first: Int second: Point end
          :func (TypedVar 'pair' :type All(A :: TYPE B :: TYPE) Fun(a: A b: B): Tuple first: A second: B end))
        :args (
          (TypedInt 10 :type Int)
          (TypedVar 'p' :type Record x: Int y: Int end)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'printInt' :type Fun(x: Int): Ok)
        :args (
          (TypedSelect 'first' :type Int
            :target (TypedVar 'pr' :type Tuple first: Int second: Point end))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'printInt' :type Fun(x: Int): Ok)
        :args (
          (TypedSelect 'x' :type Int
            :target (TypedSelect 'second' :type Point
              :target (TypedVar 'pr' :type Tuple first: Int second: Point end)))
        )))
  ))
