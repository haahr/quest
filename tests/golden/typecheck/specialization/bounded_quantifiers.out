(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedLetValue 'wOut' :type Writer.T
      :value (TypedSelect 'output' :type Writer.T
        :target (TypedVar 'writer' :type Module 'writer')))
    (TypedLetValue 'printInt' :type Fun(x: Int): Ok
      :value (TypedFun :params (('x' : Int)) :type Fun(x: Int): Ok
        :body (TypedBlock :type Ok
          :bindings (
            (TypedExprStmt
              :expr (TypedApp :type Ok
                :func (TypedSelect 'putString' :type Fun(writer: Writer.T string: String): Ok
                  :target (TypedVar 'writer' :type Module 'writer'))
                :args (
                  (TypedVar 'wOut' :type Writer.T)
                  (TypedApp :type String
                    :func (TypedSelect 'int' :type Fun(n: Int): String
                      :target (TypedVar 'conv' :type Module 'conv'))
                    :args (
                      (TypedVar 'x' :type Int)
                    ))
                )))
          )
          :result (TypedApp :type Ok
            :func (TypedSelect 'putString' :type Fun(writer: Writer.T string: String): Ok
              :target (TypedVar 'writer' :type Module 'writer'))
            :args (
              (TypedVar 'wOut' :type Writer.T)
              (TypedString '\n' :type String)
            )))))
    (TypedLetType 'Point' :kind TYPE)
    (TypedLetType 'Point3D' :kind TYPE)
    (TypedLetValue 'getX' :type All(A <: Point) Fun(p: A): Int
      :value (TypedFun :params (('p' : A)) :type All(A <: Point) Fun(p: A): Int
        :body (TypedSelect 'x' :type Int
          :target (TypedVar 'p' :type A))))
    (TypedLetValue 'getY' :type All(A <: Point) Fun(p: A): Int
      :value (TypedFun :params (('p' : A)) :type All(A <: Point) Fun(p: A): Int
        :body (TypedSelect 'y' :type Int
          :target (TypedVar 'p' :type A))))
    (TypedLetValue 'p' :type Record x: Int y: Int z: Int end
      :value (TypedRecord :type Record x: Int y: Int z: Int end
        :fields (
          (TypedRecordField 'x'
            :value (TypedInt 42 :type Int))
          (TypedRecordField 'y'
            :value (TypedInt 100 :type Int))
          (TypedRecordField 'z'
            :value (TypedInt 999 :type Int))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'printInt' :type Fun(x: Int): Ok)
        :args (
          (TypedApp :type Int
            :func (TypedTypeApp [Point3D] :type Fun(p: Point3D): Int
              :func (TypedVar 'getX' :type All(A <: Point) Fun(p: A): Int))
            :args (
              (TypedVar 'p' :type Record x: Int y: Int z: Int end)
            ))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'printInt' :type Fun(x: Int): Ok)
        :args (
          (TypedApp :type Int
            :func (TypedTypeApp [Point3D] :type Fun(p: Point3D): Int
              :func (TypedVar 'getY' :type All(A <: Point) Fun(p: A): Int))
            :args (
              (TypedVar 'p' :type Record x: Int y: Int z: Int end)
            ))
        )))
    (TypedLetValue 'identity' :type All(A <: Point) Fun(p: A): A
      :value (TypedFun :params (('p' : A)) :type All(A <: Point) Fun(p: A): A
        :body (TypedVar 'p' :type A)))
    (TypedLetValue 'p2' :type Point3D
      :value (TypedApp :type Point3D
        :func (TypedTypeApp [Point3D] :type Fun(p: Point3D): Point3D
          :func (TypedVar 'identity' :type All(A <: Point) Fun(p: A): A))
        :args (
          (TypedVar 'p' :type Record x: Int y: Int z: Int end)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'printInt' :type Fun(x: Int): Ok)
        :args (
          (TypedSelect 'x' :type Int
            :target (TypedVar 'p2' :type Point3D))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'printInt' :type Fun(x: Int): Ok)
        :args (
          (TypedSelect 'z' :type Int
            :target (TypedVar 'p2' :type Point3D))
        )))
  ))
