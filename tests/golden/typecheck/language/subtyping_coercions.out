        :args (
          (TypedApp :type Int
            :func (TypedVar 'getA' :type Fun(r: OrderedRec): Int)
            :args (
              (TypedVar 'permuted' :type Record b: Int a: Int end)
            ))
        )))
    (TypedLetValue 'applyRec' :type Fun(f: Fun(r: SmallRec): Int r: BigRec): Int
      :value (TypedFun :params (('f' : Fun(r: SmallRec): Int) ('r' : BigRec)) :type Fun(f: Fun(r: SmallRec): Int r: BigRec): Int
        :body (TypedApp :type Int
