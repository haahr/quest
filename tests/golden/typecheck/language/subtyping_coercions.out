              :target (TypedVar 'writer' :type Module 'writer'))
            :args (
              (TypedVar 'wOut' :type Writer.T)
              (TypedString '\n' :type String)
            )))))
    (TypedLetType 'BigTuple' :kind TYPE)
    (TypedLetType 'SmallTuple' :kind TYPE)
    (TypedLetValue 'getFirstTwo' :type Fun(t: SmallTuple): Int
      :value (TypedFun :params (('t' : SmallTuple)) :type Fun(t: SmallTuple): Int
        :body (TypedInfix '+' :type Int
          :left (TypedSelect 'x' :type Int
            :target (TypedVar 't' :type SmallTuple))
          :right (TypedSelect 'y' :type Int
            :target (TypedVar 't' :type SmallTuple)))))
    (TypedLetValue 'bt' :type BigTuple
      :value (TypedTuple :type Tuple x: Int y: Int z: Int end
        :elements (
          (TypedInt 10 :type Int)
          (TypedInt 20 :type Int)
          (TypedInt 30 :type Int)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'printInt' :type Fun(x: Int): Ok)
        :args (
          (TypedApp :type Int
            :func (TypedVar 'getFirstTwo' :type Fun(t: SmallTuple): Int)
            :args (
              (TypedVar 'bt' :type BigTuple)
            ))
        )))
    (TypedLetType 'BigRec' :kind TYPE)
    (TypedLetType 'SmallRec' :kind TYPE)
    (TypedLetValue 'sumXY' :type Fun(r: SmallRec): Int
      :value (TypedFun :params (('r' : SmallRec)) :type Fun(r: SmallRec): Int
        :body (TypedInfix '+' :type Int
          :left (TypedSelect 'x' :type Int
            :target (TypedVar 'r' :type SmallRec))
          :right (TypedSelect 'y' :type Int
            :target (TypedVar 'r' :type SmallRec)))))
    (TypedLetValue 'br' :type BigRec
      :value (TypedRecord :type Record x: Int y: Int z: Int end
        :fields (
          (TypedRecordField 'x'
            :value (TypedInt 100 :type Int))
          (TypedRecordField 'y'
            :value (TypedInt 200 :type Int))
          (TypedRecordField 'z'
            :value (TypedInt 300 :type Int))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'printInt' :type Fun(x: Int): Ok)
        :args (
          (TypedApp :type Int
            :func (TypedVar 'sumXY' :type Fun(r: SmallRec): Int)
            :args (
              (TypedVar 'br' :type BigRec)
            ))
        )))
    (TypedLetType 'OrderedRec' :kind TYPE)
    (TypedLetValue 'getA' :type Fun(r: OrderedRec): Int
      :value (TypedFun :params (('r' : OrderedRec)) :type Fun(r: OrderedRec): Int
        :body (TypedInfix '*' :type Int
          :left (TypedSelect 'a' :type Int
            :target (TypedVar 'r' :type OrderedRec))
          :right (TypedInfix '+' :type Int
            :left (TypedInt 10 :type Int)
            :right (TypedSelect 'b' :type Int
              :target (TypedVar 'r' :type OrderedRec))))))
    (TypedLetValue 'permuted' :type Record b: Int a: Int end
      :value (TypedRecord :type Record b: Int a: Int end
        :fields (
          (TypedRecordField 'b'
            :value (TypedInt 4 :type Int))
          (TypedRecordField 'a'
            :value (TypedInt 7 :type Int))
