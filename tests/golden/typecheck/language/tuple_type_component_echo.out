(TypedProgram
  :phrases (
    (TypedLetValue 't' :type Tuple Let A = Int x: Int end
      :value (TypedTuple :type Tuple Let A = Int x: Int end
        :elements (
          (TypedTypeWitness 'A' = Int)
          (TypedInt 1 :type Int)
        )))
    (TypedLetValue 'empty' :type Tuple Let A = Bool end
      :value (TypedTuple :type Tuple Let A = Bool end
        :elements (
          (TypedTypeWitness 'A' = Bool)
        )))
    (TypedLetValue 'between' :type Tuple a: Int Let B = Char b: Char Let C = String end
      :value (TypedTuple :type Tuple a: Int Let B = Char b: Char Let C = String end
        :elements (
          (TypedInt 1 :type Int)
          (TypedTypeWitness 'B' = Char)
          (TypedChar 'b' :type Char)
          (TypedTypeWitness 'C' = String)
        )))
    (TypedLetValue 'nested' :type Tuple a: Int b: Tuple Let B = Bool y: Bool end end
      :value (TypedTuple :type Tuple a: Int b: Tuple Let B = Bool y: Bool end end
        :elements (
          (TypedInt 1 :type Int)
          (TypedTuple :type Tuple Let B = Bool y: Bool end
            :elements (
              (TypedTypeWitness 'B' = Bool)
              (TypedBool true)
            ))
        )))
    (TypedLetValue 'arr' :type Array(Tuple Let A = Int x: Int end)
      :value (TypedArray :type Array(Tuple Let A = Int x: Int end)
        :elements (
          (TypedVar 't' :type Tuple Let A = Int x: Int end)
          (TypedVar 't' :type Tuple Let A = Int x: Int end)
        )))
    (TypedLetValue 'rec1' :type Record f: Tuple Let A = Int x: Int end g: Int end
      :value (TypedRecord :type Record f: Tuple Let A = Int x: Int end g: Int end
        :fields (
          (TypedRecordField 'f'
            :value (TypedVar 't' :type Tuple Let A = Int x: Int end))
          (TypedRecordField 'g'
            :value (TypedInt 2 :type Int))
        )))
    (TypedLetType 'O' :kind TYPE)
    (TypedLetValue 'opt' :type O
      :value (TypedOption 'some' :type O
        :payload (TypedTuple :type Tuple Let K = Int k: K end
          :elements (
            (TypedTypeWitness 'K' = Int)
            (TypedInt 2 :type Int)
          ))))
    (TypedLetType 'E' :kind TYPE)
    (TypedLetValue 'p' :type E
      :value (TypedTuple :type Tuple Type A :: TYPE x: A end
        :elements (
          (TypedTypeWitness 'A' = Int)
          (TypedInt 1 :type Int)
        )))
    (TypedLetValue 'inE' :type Tuple a: Int p: E end
      :value (TypedTuple :type Tuple a: Int p: E end
        :elements (
          (TypedInt 1 :type Int)
          (TypedVar 'p' :type E)
        )))
    (TypedLetType 'P' :kind TYPE)
    (TypedLetValue 'q' :type Tuple Let N = P k: Int end
      :value (TypedTuple :type Tuple Let N = P k: Int end
        :elements (
          (TypedTypeWitness 'N' = P)
          (TypedInt 1 :type Int)
        )))
    (TypedLetValue 'r' :type Tuple Let N = Tuple a: Int end k: Int end
      :value (TypedTuple :type Tuple Let N = Tuple a: Int end k: Int end
        :elements (
          (TypedTypeWitness 'N' = Tuple a: Int end)
          (TypedInt 1 :type Int)
        )))
    (TypedLetValue 'qr' :type Array(Tuple Let N = Tuple a: Int end k: Int end)
      :value (TypedArray :type Array(Tuple Let N = Tuple a: Int end k: Int end)
        :elements (
          (TypedVar 'q' :type Tuple Let N = P k: Int end)
          (TypedVar 'r' :type Tuple Let N = Tuple a: Int end k: Int end)
        )))
    (TypedLetValue 'inQ' :type Tuple q: Tuple Let N = P k: Int end r: Tuple Let N = Tuple a: Int end k: Int end end
      :value (TypedTuple :type Tuple q: Tuple Let N = P k: Int end r: Tuple Let N = Tuple a: Int end k: Int end end
        :elements (
          (TypedVar 'q' :type Tuple Let N = P k: Int end)
          (TypedVar 'r' :type Tuple Let N = Tuple a: Int end k: Int end)
        )))
    (TypedLetType 'L' :kind TYPE)
    (TypedLetValue 's' :type Tuple Let M = L l: L end
      :value (TypedTuple :type Tuple Let M = L l: L end
        :elements (
          (TypedTypeWitness 'M' = L)
          (TypedOption 'nil' :type L)
        )))
  ))
