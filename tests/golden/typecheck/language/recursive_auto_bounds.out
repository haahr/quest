(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedLetType 'T1' :kind TYPE)
    (TypedLetType 'T2' :kind TYPE)
    (TypedLetValue 'f' :type Fun(x: T2): Int
      :value (TypedFun :params (('x' : T2)) :type Fun(x: T2): Int
        :body (TypedInt 7 :type Int)))
    (TypedLetValue 'g' :type Fun(x: T1): Int
      :value (TypedVar 'f' :type Fun(x: T2): Int))
    (TypedLetValue 'h' :type Fun(x: T2): Int
      :value (TypedVar 'g' :type Fun(x: T1): Int))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedSelect 'output' :type writer.T
            :target (TypedVar 'writer' :type Module 'writer'))
          (TypedString 'accepted\n' :type String)
        )))
  ))
