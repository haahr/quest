(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedLetValue 'wOut' :type Writer.T
      :value (TypedSelect 'output' :type Writer.T
        :target (TypedVar 'writer' :type Module 'writer')))
    (TypedLetValue 'printInt' :type Fun(x: Int): Ok
      :value (TypedFun :params (('x' : Int)) :type Fun(x: Int): Ok
        :body (TypedBlock :type Ok
          :bindings (
            (TypedExprStmt
              :expr (TypedApp :type Ok
                :func (TypedSelect 'putString' :type Fun(writer: Writer.T string: String): Ok
                  :target (TypedVar 'writer' :type Module 'writer'))
                :args (
                  (TypedVar 'wOut' :type Writer.T)
                  (TypedApp :type String
                    :func (TypedSelect 'int' :type Fun(n: Int): String
                      :target (TypedVar 'conv' :type Module 'conv'))
                    :args (
                      (TypedVar 'x' :type Int)
                    ))
                )))
          )
          :result (TypedApp :type Ok
            :func (TypedSelect 'putString' :type Fun(writer: Writer.T string: String): Ok
              :target (TypedVar 'writer' :type Module 'writer'))
            :args (
              (TypedVar 'wOut' :type Writer.T)
              (TypedString '\n' :type String)
            )))))
    (TypedLetValue 'printBool' :type Fun(b: Bool): Ok
      :value (TypedFun :params (('b' : Bool)) :type Fun(b: Bool): Ok
        :body (TypedBlock :type Ok
          :bindings (
            (TypedExprStmt
              :expr (TypedApp :type Ok
                :func (TypedSelect 'putString' :type Fun(writer: Writer.T string: String): Ok
                  :target (TypedVar 'writer' :type Module 'writer'))
                :args (
                  (TypedVar 'wOut' :type Writer.T)
                  (TypedApp :type String
                    :func (TypedSelect 'bool' :type Fun(b: Bool): String
                      :target (TypedVar 'conv' :type Module 'conv'))
                    :args (
                      (TypedVar 'b' :type Bool)
                    ))
                )))
          )
          :result (TypedApp :type Ok
            :func (TypedSelect 'putString' :type Fun(writer: Writer.T string: String): Ok
              :target (TypedVar 'writer' :type Module 'writer'))
            :args (
              (TypedVar 'wOut' :type Writer.T)
              (TypedString '\n' :type String)
            )))))
    (TypedLetType 'Day' :kind TYPE)
    (TypedLetType 'WeekDay' :kind TYPE)
    (TypedLetValue 'isMon' :type Fun(d: Variant mon: Int tue: Int wed: Int thu: Int fri: Int sat: Int sun: Int end): Bool
      :value (TypedFun :params (('d' : Variant mon: Int tue: Int wed: Int thu: Int fri: Int sat: Int sun: Int end)) :type Fun(d: Variant mon: Int tue: Int wed: Int thu: Int fri: Int sat: Int sun: Int end): Bool
        :body (TypedVariantCheck 'mon' :type Bool
          :target (TypedVar 'd' :type Variant mon: Int tue: Int wed: Int thu: Int fri: Int sat: Int sun: Int end))))
    (TypedLetValue 'w' :type Variant mon: Int tue: Int wed: Int thu: Int fri: Int end
      :value (TypedVariant 'mon' :type Variant mon: Int tue: Int wed: Int thu: Int fri: Int end
        :payload (TypedInt 1 :type Int)))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'printBool' :type Fun(b: Bool): Ok)
        :args (
          (TypedApp :type Bool
            :func (TypedVar 'isMon' :type Fun(d: Variant mon: Int tue: Int wed: Int thu: Int fri: Int sat: Int sun: Int end): Bool)
            :args (
              (TypedVar 'w' :type Variant mon: Int tue: Int wed: Int thu: Int fri: Int end)
            ))
        )))
    (TypedLetValue 'getDayCode' :type Fun(d: Variant mon: Int tue: Int wed: Int thu: Int fri: Int sat: Int sun: Int end): Int
      :value (TypedFun :params (('d' : Variant mon: Int tue: Int wed: Int thu: Int fri: Int sat: Int sun: Int end)) :type Fun(d: Variant mon: Int tue: Int wed: Int thu: Int fri: Int sat: Int sun: Int end): Int
        :body (TypedCase :type Int
          :target (TypedVar 'd' :type Variant mon: Int tue: Int wed: Int thu: Int fri: Int sat: Int sun: Int end)
          :branches (
            (TypedCaseBranch tags=(mon) :binder 'c'
              :body (TypedVar 'c' :type Int))
            (TypedCaseBranch tags=(tue) :binder 'c'
              :body (TypedVar 'c' :type Int))
            (TypedCaseBranch tags=(wed) :binder 'c'
              :body (TypedVar 'c' :type Int))
            (TypedCaseBranch tags=(thu) :binder 'c'
              :body (TypedVar 'c' :type Int))
            (TypedCaseBranch tags=(fri) :binder 'c'
              :body (TypedVar 'c' :type Int))
          )
          :else (TypedInt 0 :type Int))))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'printInt' :type Fun(x: Int): Ok)
        :args (
          (TypedApp :type Int
            :func (TypedVar 'getDayCode' :type Fun(d: Variant mon: Int tue: Int wed: Int thu: Int fri: Int sat: Int sun: Int end): Int)
            :args (
              (TypedVar 'w' :type Variant mon: Int tue: Int wed: Int thu: Int fri: Int end)
            ))
        )))
    (TypedLetValue 'friDay' :type Variant mon: Int tue: Int wed: Int thu: Int fri: Int end
      :value (TypedVariant 'fri' :type Variant mon: Int tue: Int wed: Int thu: Int fri: Int end
        :payload (TypedInt 5 :type Int)))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'printInt' :type Fun(x: Int): Ok)
        :args (
          (TypedApp :type Int
            :func (TypedVar 'getDayCode' :type Fun(d: Variant mon: Int tue: Int wed: Int thu: Int fri: Int sat: Int sun: Int end): Int)
            :args (
              (TypedVar 'friDay' :type Variant mon: Int tue: Int wed: Int thu: Int fri: Int end)
            ))
        )))
  ))
