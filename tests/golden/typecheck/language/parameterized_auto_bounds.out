(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('conv') : 'Conv')
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedLetValue 'say' :type Fun(s: String): Ok
      :value (TypedFun :params (('s' : String)) :type Fun(s: String): Ok
        :body (TypedApp :type Ok
          :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
            :target (TypedVar 'writer' :type Module 'writer'))
          :args (
            (TypedSelect 'output' :type writer.T
              :target (TypedVar 'writer' :type Module 'writer'))
            (TypedInfix '<>' :type String
              :left (TypedVar 's' :type String)
              :right (TypedString '\n' :type String))
          ))))
    (TypedLetType 'Box' :kind ALL(X :: TYPE) TYPE)
    (TypedLetValue 'bi' :type Box(Int)
      :value (TypedAuto :Int :type Box(Int)
        :payload (TypedTuple :type Tuple a: Int end
          :elements (
            (TypedInt 42 :type Int)
          ))))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'say' :type Fun(s: String): Ok)
        :args (
          (TypedInfix '<>' :type String
            :left (TypedString '1: ' :type String)
            :right (TypedApp :type String
              :func (TypedSelect 'int' :type Fun(n: Int): String
                :target (TypedVar 'conv' :type Module 'conv'))
              :args (
                (TypedInspect :type Int
                  :target (TypedVar 'bi' :type Box(Int))
                  :branches (
                    (TypedInspectBranch match=Int
                      :body (TypedSelect 'a' :type Int
                        :target (TypedVar 'i' :type Tuple a: Int end)))
                  )
                  :else (TypedInfix '-' :type Int
                    :left (TypedInt 0 :type Int)
                    :right (TypedInt 1 :type Int)))
              )))
        )))
    (TypedLetType 'Point' :kind TYPE)
    (TypedLetType 'Point3' :kind TYPE)
    (TypedLetValue 'bp' :type Box(Point)
      :value (TypedAuto :Point3 :type Box(Point)
        :payload (TypedTuple :type Tuple a: Point3 end
          :elements (
            (TypedRecord :type Record x: Int z: Int end
              :fields (
                (TypedRecordField 'x'
                  :value (TypedInt 1 :type Int))
                (TypedRecordField 'z'
                  :value (TypedInt 2 :type Int))
              ))
          ))))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'say' :type Fun(s: String): Ok)
        :args (
          (TypedInfix '<>' :type String
            :left (TypedString '2: ' :type String)
            :right (TypedApp :type String
              :func (TypedSelect 'int' :type Fun(n: Int): String
                :target (TypedVar 'conv' :type Module 'conv'))
              :args (
                (TypedInspect :type Int
                  :target (TypedVar 'bp' :type Box(Point))
                  :branches (
                    (TypedInspectBranch match=Point3
                      :body (TypedSelect 'z' :type Int
                        :target (TypedSelect 'a' :type Point3
                          :target (TypedVar 'p' :type Tuple a: Point3 end))))
                  )
                  :else (TypedInfix '-' :type Int
                    :left (TypedInt 0 :type Int)
                    :right (TypedInt 1 :type Int)))
              )))
        )))
    (TypedLetValue 'unbox' :type Fun(b: Box(String)): Int
      :value (TypedFun :params (('b' : Box(String))) :type Fun(b: Box(String)): Int
        :body (TypedInspect :type Int
          :target (TypedVar 'b' :type Box(String))
          :branches (
            (TypedInspectBranch match=String
              :body (TypedApp :type Int
                :func (TypedSelect 'length' :type Fun(string: String): Int
                  :target (TypedVar 'string' :type Module 'string'))
                :args (
                  (TypedSelect 'a' :type String
                    :target (TypedVar 's' :type Tuple a: String end))
                )))
          )
          :else (TypedInfix '-' :type Int
            :left (TypedInt 0 :type Int)
            :right (TypedInt 1 :type Int)))))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'say' :type Fun(s: String): Ok)
        :args (
          (TypedInfix '<>' :type String
            :left (TypedString '3: ' :type String)
            :right (TypedApp :type String
              :func (TypedSelect 'int' :type Fun(n: Int): String
                :target (TypedVar 'conv' :type Module 'conv'))
              :args (
                (TypedApp :type Int
                  :func (TypedVar 'unbox' :type Fun(b: Box(String)): Int)
                  :args (
                    (TypedAuto :String :type Box(String)
                      :payload (TypedTuple :type Tuple a: String end
                        :elements (
                          (TypedString 'four' :type String)
                        )))
                  ))
              )))
        )))
  ))
