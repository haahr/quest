(TypedProgram
  :phrases (
    (TypedLetValue 'a' :type Int
      :value (TypedInt 1 :type Int))
    (TypedLetValue 'b' :type Int
      :value (TypedInt 2 :type Int))
    (TypedLetValue 'c' :type Int
      :value (TypedInt 3 :type Int))
    (TypedLetValue 'd' :type Int
      :value (TypedInt 4 :type Int))
    (TypedExprStmt
      :expr (TypedInfix '+' :type Int
        :left (TypedVar 'a' :type Int)
        :right (TypedInfix '+' :type Int
          :left (TypedVar 'b' :type Int)
          :right (TypedInfix '+' :type Int
            :left (TypedVar 'c' :type Int)
            :right (TypedVar 'd' :type Int)))))
  ))
