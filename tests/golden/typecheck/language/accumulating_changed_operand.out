(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedLetValue 'f' :rec :type Fun(n: Int var g: Int): Int
      :value (TypedFun :params (('n' : Int) ('g' : Int)) :type Fun(n: Int var g: Int): Int
        :body (TypedBlock :type Int
          :bindings (
            (TypedExprStmt
              :expr (TypedAssign
                :target (TypedVar 'g' :type Var(Int))
                :value (TypedInfix '+' :type Int
                  :left (TypedDerefCell :type Int
                    :target (TypedVar 'g' :type Var(Int)))
                  :right (TypedInt 1 :type Int))))
          )
          :result (TypedIf :type Int
            :cond (TypedInfix '<=' :type Bool
              :left (TypedVar 'n' :type Int)
              :right (TypedInt 0 :type Int))
            :then (TypedInt 0 :type Int)
            :else (TypedInfix '+' :type Int
              :left (TypedApp :type Int
                :func (TypedVar 'f' :type Fun(n: Int var g: Int): Int)
                :args (
                  (TypedInfix '-' :type Int
                    :left (TypedVar 'n' :type Int)
                    :right (TypedInt 1 :type Int))
                  (TypedVar 'g' :type Var(Int))
                ))
              :right (TypedDerefCell :type Int
                :target (TypedVar 'g' :type Var(Int))))))))
    (TypedLetValue 'g' :type Int
      :value (TypedInt 0 :type Int))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedSelect 'output' :type writer.T
            :target (TypedVar 'writer' :type Module 'writer'))
          (TypedInfix '<>' :type String
            :left (TypedApp :type String
              :func (TypedSelect 'int' :type Fun(n: Int): String
                :target (TypedVar 'conv' :type Module 'conv'))
              :args (
                (TypedApp :type Int
                  :func (TypedVar 'f' :type Fun(n: Int var g: Int): Int)
                  :args (
                    (TypedInt 2 :type Int)
                    (TypedVar 'g' :type Var(Int))
                  ))
              ))
            :right (TypedString '\n' :type String))
        )))
    (TypedLetValue 'c' :type Tuple var t: Int end
      :value (TypedTuple :type Tuple var t: Int end
        :elements (
          (TypedInt 0 :type Int)
        )))
    (TypedLetValue 'h' :rec :type Fun(n: Int): Int
      :value (TypedFun :params (('n' : Int)) :type Fun(n: Int): Int
        :body (TypedBlock :type Int
          :bindings (
            (TypedExprStmt
              :expr (TypedAssign
                :target (TypedSelect 't' :type Int
                  :target (TypedVar 'c' :type Tuple var t: Int end))
                :value (TypedInfix '+' :type Int
                  :left (TypedSelect 't' :type Int
                    :target (TypedVar 'c' :type Tuple var t: Int end))
                  :right (TypedInt 1 :type Int))))
          )
          :result (TypedIf :type Int
            :cond (TypedInfix '<=' :type Bool
              :left (TypedVar 'n' :type Int)
              :right (TypedInt 0 :type Int))
            :then (TypedInt 1 :type Int)
            :else (TypedInfix '*' :type Int
              :left (TypedApp :type Int
                :func (TypedVar 'h' :type Fun(n: Int): Int)
                :args (
                  (TypedInfix '-' :type Int
                    :left (TypedVar 'n' :type Int)
                    :right (TypedInt 1 :type Int))
                ))
              :right (TypedSelect 't' :type Int
                :target (TypedVar 'c' :type Tuple var t: Int end)))))))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedSelect 'output' :type writer.T
            :target (TypedVar 'writer' :type Module 'writer'))
          (TypedInfix '<>' :type String
            :left (TypedApp :type String
              :func (TypedSelect 'int' :type Fun(n: Int): String
                :target (TypedVar 'conv' :type Module 'conv'))
              :args (
                (TypedApp :type Int
                  :func (TypedVar 'h' :type Fun(n: Int): Int)
                  :args (
                    (TypedInt 2 :type Int)
                  ))
              ))
            :right (TypedString '\n' :type String))
        )))
  ))
