(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedLetType 'P' :kind TYPE)
    (TypedLetValue 'x' :type Tuple y: Tuple Type A :: TYPE v: A end z: Tuple Type A :: TYPE v: A end end
      :value (TypedTuple :type Tuple y: Tuple Type A :: TYPE v: A end z: Tuple Type A :: TYPE v: A end end
        :elements (
          (TypedTuple :type Tuple Type A :: TYPE v: A end
            :elements (
              (TypedTypeWitness 'A' = Int)
              (TypedInt 1 :type Int)
            ))
          (TypedTuple :type Tuple Type A :: TYPE v: A end
            :elements (
              (TypedTypeWitness 'A' = String)
              (TypedString 's' :type String)
            ))
        )))
    (TypedLetValue 'same' :type Fun(a: x.y.A): x.y.A
      :value (TypedFun :params (('a' : x.y.A)) :type Fun(a: x.y.A): x.y.A
        :body (TypedVar 'a' :type x.y.A)))
    (TypedLetValue 'pair' :type Fun(a: x.y.A b: x.z.A): Tuple a: x.y.A b: x.z.A end
      :value (TypedFun :params (('a' : x.y.A) ('b' : x.z.A)) :type Fun(a: x.y.A b: x.z.A): Tuple a: x.y.A b: x.z.A end
        :body (TypedTuple :type Tuple a: x.y.A b: x.z.A end
          :elements (
            (TypedApp :type x.y.A
              :func (TypedVar 'same' :type Fun(a: x.y.A): x.y.A)
              :args (
                (TypedVar 'a' :type x.y.A)
              ))
            (TypedVar 'b' :type x.z.A)
          ))))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedSelect 'output' :type writer.T
            :target (TypedVar 'writer' :type Module 'writer'))
          (TypedString 'x.y.A and x.z.A checked\n' :type String)
        )))
  ))
