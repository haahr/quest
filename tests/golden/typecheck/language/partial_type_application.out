                :func (TypedTypeApp [Int] :type Fun(list: list.T(Int)): Int
                  :func (TypedSelect 'length' :type All(A :: TYPE) Fun(list: list.T(A)): Int
                    :target (TypedVar 'list' :type Module 'list')))
                :args (
                  (TypedTypeApp [Int] :type list.T(Int)
                    :func (TypedVar 'nilOf' :type All(A :: TYPE) list.T(A)))
