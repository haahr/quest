(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedLetValue 'print' :type Fun(s: String): Ok
      :value (TypedFun :params (('s' : String)) :type Fun(s: String): Ok
        :body (TypedApp :type Ok
          :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
            :target (TypedVar 'writer' :type Module 'writer'))
          :args (
            (TypedSelect 'output' :type writer.T
              :target (TypedVar 'writer' :type Module 'writer'))
            (TypedInfix '<>' :type String
              :left (TypedVar 's' :type String)
              :right (TypedString '\n' :type String))
          ))))
    (TypedLetType 'Big' :kind TYPE)
    (TypedLetValue 'w' :type Tuple x: Int y: Int end
      :value (TypedTuple :type Tuple x: Int y: Int end
        :elements (
          (TypedInt 1 :type Int)
          (TypedInt 2 :type Int)
        )))
    (TypedLetValue 'v' :type Tuple x: Int end
      :value (TypedVar 'w' :type Tuple x: Int y: Int end))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedInfix '<>' :type String
            :left (TypedApp :type String
              :func (TypedSelect 'bool' :type Fun(b: Bool): String
                :target (TypedVar 'conv' :type Module 'conv'))
              :args (
                (TypedInfix 'is' :type Bool
                  :left (TypedVar 'v' :type Tuple x: Int end)
                  :right (TypedVar 'w' :type Tuple x: Int y: Int end))
              ))
            :right (TypedInfix '<>' :type String
              :left (TypedString ' ' :type String)
              :right (TypedApp :type String
                :func (TypedSelect 'bool' :type Fun(b: Bool): String
                  :target (TypedVar 'conv' :type Module 'conv'))
                :args (
                  (TypedInfix 'isnot' :type Bool
                    :left (TypedVar 'w' :type Tuple x: Int y: Int end)
                    :right (TypedVar 'v' :type Tuple x: Int end))
                ))))
        )))
    (TypedLetValue 'u' :type Tuple x: Int end
      :value (TypedTuple :type Tuple x: Int end
        :elements (
          (TypedInt 1 :type Int)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedApp :type String
            :func (TypedSelect 'bool' :type Fun(b: Bool): String
              :target (TypedVar 'conv' :type Module 'conv'))
            :args (
              (TypedInfix 'is' :type Bool
                :left (TypedVar 'u' :type Tuple x: Int end)
                :right (TypedVar 'w' :type Tuple x: Int y: Int end))
            ))
        )))
    (TypedLetValue 'pw' :type Tuple p: Big n: Int end
      :value (TypedTuple :type Tuple p: Big n: Int end
        :elements (
          (TypedRecord :type Record a: Int b: Int end
            :fields (
              (TypedRecordField 'a'
                :value (TypedInt 1 :type Int))
              (TypedRecordField 'b'
                :value (TypedInt 2 :type Int))
            ))
          (TypedInt 3 :type Int)
        )))
    (TypedLetValue 'pv' :type Tuple p: Big end
      :value (TypedVar 'pw' :type Tuple p: Big n: Int end))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedApp :type String
            :func (TypedSelect 'bool' :type Fun(b: Bool): String
              :target (TypedVar 'conv' :type Module 'conv'))
            :args (
              (TypedInfix 'is' :type Bool
                :left (TypedVar 'pv' :type Tuple p: Big end)
                :right (TypedVar 'pw' :type Tuple p: Big n: Int end))
            ))
        )))
    (TypedLetValue 'ab' :type Array(Big)
      :value (TypedArray :type Array(Big)
        :elements (
          (TypedRecord :type Record a: Int b: Int end
            :fields (
              (TypedRecordField 'a'
                :value (TypedInt 1 :type Int))
              (TypedRecordField 'b'
                :value (TypedInt 2 :type Int))
            ))
        )))
    (TypedLetValue 'ab2' :type Array(Big)
      :value (TypedVar 'ab' :type Array(Big)))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedApp :type String
            :func (TypedSelect 'bool' :type Fun(b: Bool): String
              :target (TypedVar 'conv' :type Module 'conv'))
            :args (
              (TypedInfix 'is' :type Bool
                :left (TypedVar 'ab' :type Array(Big))
                :right (TypedVar 'ab2' :type Array(Big)))
            ))
        )))
    (TypedLetType 'Small' :kind TYPE)
    (TypedLetValue 'o' :type Option some with Tuple x: Big end none end
      :value (TypedOption 'some' :type Option some with Tuple x: Big end none end
        :payload (TypedTuple :type Tuple x: Big end
          :elements (
            (TypedRecord :type Record a: Int b: Int end
              :fields (
                (TypedRecordField 'a'
                  :value (TypedInt 4 :type Int))
                (TypedRecordField 'b'
                  :value (TypedInt 5 :type Int))
              ))
          ))))
    (TypedLetValue 'os' :type Option some with Tuple x: Small end none end
      :value (TypedVar 'o' :type Option some with Tuple x: Big end none end))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedApp :type String
            :func (TypedSelect 'int' :type Fun(n: Int): String
              :target (TypedVar 'conv' :type Module 'conv'))
            :args (
              (TypedSelect 'a' :type Int
                :target (TypedSelect 'x' :type Small
                  :target (TypedVariantAssert 'some' :type Tuple Int x: Small end
                    :target (TypedVar 'os' :type Option some with Tuple x: Small end none end))))
            ))
        )))
  ))
