(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedLetValue 'print' :type Fun(s: String): Ok
      :value (TypedFun :params (('s' : String)) :type Fun(s: String): Ok
        :body (TypedApp :type Ok
          :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
            :target (TypedVar 'writer' :type Module 'writer'))
          :args (
            (TypedSelect 'output' :type writer.T
              :target (TypedVar 'writer' :type Module 'writer'))
            (TypedInfix '<>' :type String
              :left (TypedVar 's' :type String)
              :right (TypedString '\n' :type String))
          ))))
    (TypedLetType 'Made' :kind TYPE)
    (TypedLetValue 'o' :type Made
      :value (TypedOption 'made' :type Made
        :payload (TypedTuple :type Tuple var x: Int inner: Tuple var y: Int end end
          :elements (
            (TypedInt 1 :type Int)
            (TypedTuple :type Tuple var y: Int end
              :elements (
                (TypedInt 10 :type Int)
              ))
          ))))
    (TypedLetValue 'shown' :type Fun(): String
      :value (TypedFun :params () :type Fun(): String
        :body (TypedInfix '<>' :type String
          :left (TypedApp :type String
            :func (TypedSelect 'int' :type Fun(n: Int): String
              :target (TypedVar 'conv' :type Module 'conv'))
            :args (
              (TypedSelect 'x' :type Int
                :target (TypedVariantAssert 'made' :type Tuple Int var x: Int inner: Tuple var y: Int end end
                  :target (TypedVar 'o' :type Made)))
            ))
          :right (TypedInfix '<>' :type String
            :left (TypedString ' ' :type String)
            :right (TypedApp :type String
              :func (TypedSelect 'int' :type Fun(n: Int): String
                :target (TypedVar 'conv' :type Module 'conv'))
              :args (
                (TypedSelect 'y' :type Int
                  :target (TypedSelect 'inner' :type Tuple var y: Int end
                    :target (TypedVariantAssert 'made' :type Tuple Int var x: Int inner: Tuple var y: Int end end
                      :target (TypedVar 'o' :type Made))))
              ))))))
    (TypedLetValue 't' :type Tuple Int var x: Int inner: Tuple var y: Int end end
      :value (TypedVariantAssert 'made' :type Tuple Int var x: Int inner: Tuple var y: Int end end
        :target (TypedVar 'o' :type Made)))
    (TypedExprStmt
      :expr (TypedAssign
        :target (TypedSelect 'x' :type Int
          :target (TypedVar 't' :type Tuple Int var x: Int inner: Tuple var y: Int end end))
        :value (TypedInt 2 :type Int)))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedInfix '<>' :type String
            :left (TypedString 'copy ' :type String)
            :right (TypedInfix '<>' :type String
              :left (TypedApp :type String
                :func (TypedSelect 'int' :type Fun(n: Int): String
                  :target (TypedVar 'conv' :type Module 'conv'))
                :args (
                  (TypedSelect 'x' :type Int
                    :target (TypedVar 't' :type Tuple Int var x: Int inner: Tuple var y: Int end end))
                ))
              :right (TypedInfix '<>' :type String
                :left (TypedString ', option ' :type String)
                :right (TypedApp :type String
                  :func (TypedVar 'shown' :type Fun(): String)
                  :args ()))))
        )))
    (TypedExprStmt
      :expr (TypedAssign
        :target (TypedSelect 'y' :type Int
          :target (TypedSelect 'inner' :type Tuple var y: Int end
            :target (TypedVariantAssert 'made' :type Tuple Int var x: Int inner: Tuple var y: Int end end
              :target (TypedVar 'o' :type Made))))
        :value (TypedInt 20 :type Int)))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedInfix '<>' :type String
            :left (TypedString 'inner ' :type String)
            :right (TypedApp :type String
              :func (TypedVar 'shown' :type Fun(): String)
              :args ()))
        )))
    (TypedExprStmt
      :expr (TypedCase :type Ok
        :target (TypedVar 'o' :type Made)
        :branches (
          (TypedCaseBranch tags=(made) :binder 'c'
            :body (TypedAssign
              :target (TypedSelect 'x' :type Int
                :target (TypedVar 'c' :type Tuple var x: Int inner: Tuple var y: Int end end))
              :value (TypedInt 3 :type Int)))
          (TypedCaseBranch tags=(none)
            :body (TypedOk))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedInfix '<>' :type String
            :left (TypedString 'binder ' :type String)
            :right (TypedApp :type String
              :func (TypedVar 'shown' :type Fun(): String)
              :args ()))
        )))
    (TypedLetType 'V' :kind TYPE)
    (TypedLetValue 'v' :type V
      :value (TypedVariant 'p' :type V
        :payload (TypedTuple :type Tuple var z: Int end
          :elements (
            (TypedInt 1 :type Int)
          ))))
    (TypedExprStmt
      :expr (TypedAssign
        :target (TypedSelect 'z' :type Int
          :target (TypedVariantAssert 'p' :type Tuple var z: Int end
            :target (TypedVar 'v' :type V)))
        :value (TypedInt 5 :type Int)))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedInfix '<>' :type String
            :left (TypedString 'variant ' :type String)
            :right (TypedApp :type String
              :func (TypedSelect 'int' :type Fun(n: Int): String
                :target (TypedVar 'conv' :type Module 'conv'))
              :args (
                (TypedSelect 'z' :type Int
                  :target (TypedVariantAssert 'p' :type Tuple var z: Int end
                    :target (TypedVar 'v' :type V)))
              )))
