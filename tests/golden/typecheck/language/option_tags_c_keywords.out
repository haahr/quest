(TypedProgram
  :phrases (
    (TypedLetType 'T' :kind TYPE)
    (TypedLetValue 'describe' :type Fun(t: T): String
      :value (TypedFun :params (('t' : T)) :type Fun(t: T): String
        :body (TypedCase :type String
          :target (TypedVar 't' :type T)
          :branches (
            (TypedCaseBranch tags=(int) :binder 'x'
              :body (TypedString 'int' :type String))
            (TypedCaseBranch tags=(struct) :binder 'x'
              :body (TypedIf :type String
                :cond (TypedSelect 'b' :type Bool
                  :target (TypedVar 'x' :type Tuple a: Int b: Bool end))
                :then (TypedString 'struct' :type String)
                :else (TypedString '?' :type String)))
            (TypedCaseBranch tags=(union) :binder 'x'
              :body (TypedSelect 's' :type String
                :target (TypedVar 'x' :type Tuple s: String end)))
            (TypedCaseBranch tags=(float) :binder 'x'
              :body (TypedString 'float' :type String))
            (TypedCaseBranch tags=(void)
              :body (TypedString 'void' :type String))
          ))))
    (TypedLetValue 'i' :type T
      :value (TypedOption 'int' :type T
        :payload (TypedTuple :type Tuple n: Int end
          :elements (
            (TypedInt 3 :type Int)
          ))))
    (TypedLetValue 'names' :type Tuple String String String String String end
      :value (TypedTuple :type Tuple String String String String String end
        :elements (
          (TypedApp :type String
