            :args (
              (TypedOption 'float' :type T
                :payload (TypedTuple :type Tuple r: Real end
                  :elements (
                    (TypedReal 2.5 :type Real)
                  )))
            ))
          (TypedApp :type String
            :func (TypedVar 'describe' :type Fun(t: T): String)
            :args (
              (TypedOption 'void' :type T)
            ))
        )))
    (TypedLetValue 'n' :type Int
      :value (TypedCase :type Int
