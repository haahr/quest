            :args (
              (TypedVar 'i' :type T)
            ))
          (TypedApp :type String
            :func (TypedVar 'describe' :type Fun(t: T): String)
            :args (
              (TypedOption 'struct' :type T
                :payload (TypedTuple :type Tuple a: Int b: Bool end
                  :elements (
                    (TypedInt 1 :type Int)
                    (TypedBool true)
                  )))
            ))
          (TypedApp :type String
            :func (TypedVar 'describe' :type Fun(t: T): String)
            :args (
              (TypedOption 'union' :type T
                :payload (TypedTuple :type Tuple s: String end
                  :elements (
                    (TypedString 'union' :type String)
                  )))
            ))
          (TypedApp :type String
