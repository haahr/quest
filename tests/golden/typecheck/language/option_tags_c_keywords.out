        :branches (
          (TypedCaseBranch tags=(int) :binder 'x'
            :body (TypedSelect 'n' :type Int
              :target (TypedVar 'x' :type Tuple n: Int end)))
        )
        :else (TypedInt 0 :type Int)))
    (TypedLetType 'K' :kind TYPE)
    (TypedLetValue 'valueOf' :type Fun(k: K): Int
      :value (TypedFun :params (('k' : K)) :type Fun(k: K): Int
        :body (TypedCase :type Int
          :target (TypedVar 'k' :type K)
          :branches (
            (TypedCaseBranch tags=(volatile, NULL, default, errno) :binder 'x'
              :body (TypedSelect 'n' :type Int
                :target (TypedVar 'x' :type Tuple n: Int end)))
          )
          :else (TypedInt 0 :type Int))))
    (TypedLetValue 'kv' :type Tuple Int Int Int Int Int end
      :value (TypedTuple :type Tuple Int Int Int Int Int end
        :elements (
