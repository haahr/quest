(TypedProgram
  :phrases (
    (TypedLetType 'Move' :kind TYPE)
    (TypedLetValue 'distance' :type Fun(m: Move): Int
      :value (TypedFun :params (('m' : Move)) :type Fun(m: Move): Int
        :body (TypedCase :type Int
          :target (TypedVar 'm' :type Move)
          :branches (
            (TypedCaseBranch tags=(north, south) :binder 'd'
              :body (TypedSelect 'steps' :type Int
                :target (TypedVar 'd' :type Tuple steps: Int end)))
            (TypedCaseBranch tags=(stay)
              :body (TypedInt 0 :type Int))
          ))))
    (TypedLetValue 'distances' :type Tuple Int Int end
      :value (TypedTuple :type Tuple Int Int end
        :elements (
          (TypedApp :type Int
            :func (TypedVar 'distance' :type Fun(m: Move): Int)
            :args (
              (TypedOption 'north' :type Move
                :payload (TypedTuple :type Tuple steps: Int end
                  :elements (
                    (TypedInt 3 :type Int)
                  )))
            ))
          (TypedApp :type Int
            :func (TypedVar 'distance' :type Fun(m: Move): Int)
            :args (
              (TypedOption 'south' :type Move
                :payload (TypedTuple :type Tuple steps: Int end
                  :elements (
                    (TypedInt 4 :type Int)
                  )))
            ))
        )))
    (TypedLetType 'Shape' :kind TYPE)
    (TypedLetValue 'side' :type Fun(s: Shape): Int
      :value (TypedFun :params (('s' : Shape)) :type Fun(s: Shape): Int
        :body (TypedCase :type Int
          :target (TypedVar 's' :type Shape)
          :branches (
            (TypedCaseBranch tags=(circle, square, rect) :binder 'x'
              :body (TypedSelect 'side' :type Int
                :target (TypedVar 'x' :type Tuple side: Int end)))
          ))))
    (TypedLetValue 'sides' :type Tuple Int Int Int end
      :value (TypedTuple :type Tuple Int Int Int end
        :elements (
          (TypedApp :type Int
            :func (TypedVar 'side' :type Fun(s: Shape): Int)
            :args (
              (TypedOption 'circle' :type Shape
                :payload (TypedTuple :type Tuple side: Int r: Int end
                  :elements (
                    (TypedInt 2 :type Int)
                    (TypedInt 1 :type Int)
                  )))
            ))
          (TypedApp :type Int
            :func (TypedVar 'side' :type Fun(s: Shape): Int)
            :args (
              (TypedOption 'square' :type Shape
                :payload (TypedTuple :type Tuple side: Int end
                  :elements (
                    (TypedInt 3 :type Int)
                  )))
            ))
          (TypedApp :type Int
            :func (TypedVar 'side' :type Fun(s: Shape): Int)
            :args (
              (TypedOption 'rect' :type Shape
                :payload (TypedTuple :type Tuple side: Int w: Int end
                  :elements (
                    (TypedInt 4 :type Int)
                    (TypedInt 5 :type Int)
                  )))
            ))
        )))
    (TypedLetType 'V' :kind TYPE)
    (TypedLetValue 'getX' :type Fun(v: V): Int
      :value (TypedFun :params (('v' : V)) :type Fun(v: V): Int
        :body (TypedCase :type Int
          :target (TypedVar 'v' :type V)
          :branches (
            (TypedCaseBranch tags=(a, b) :binder 'p'
              :body (TypedSelect 'x' :type Int
                :target (TypedVar 'p' :type Record x: Int end)))
            (TypedCaseBranch tags=(c) :binder 'n'
              :body (TypedVar 'n' :type Int))
          ))))
    (TypedLetValue 'xs' :type Tuple Int Int Int end
      :value (TypedTuple :type Tuple Int Int Int end
        :elements (
          (TypedApp :type Int
            :func (TypedVar 'getX' :type Fun(v: V): Int)
            :args (
              (TypedVariant 'a' :type V
                :payload (TypedRecord :type Record x: Int y: Int end
                  :fields (
                    (TypedRecordField 'x'
                      :value (TypedInt 1 :type Int))
                    (TypedRecordField 'y'
                      :value (TypedInt 2 :type Int))
                  )))
            ))
          (TypedApp :type Int
            :func (TypedVar 'getX' :type Fun(v: V): Int)
            :args (
              (TypedVariant 'b' :type V
                :payload (TypedRecord :type Record y: Bool z: Int x: Int end
                  :fields (
                    (TypedRecordField 'y'
                      :value (TypedBool true))
                    (TypedRecordField 'z'
                      :value (TypedInt 7 :type Int))
                    (TypedRecordField 'x'
                      :value (TypedInt 8 :type Int))
                  )))
            ))
          (TypedApp :type Int
            :func (TypedVar 'getX' :type Fun(v: V): Int)
            :args (
              (TypedVariant 'c' :type V
                :payload (TypedInt 9 :type Int))
            ))
        )))
  ))
