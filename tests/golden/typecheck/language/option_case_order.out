(TypedProgram
  :phrases (
    (TypedLetType 'O1' :kind TYPE)
    (TypedLetType 'O2' :kind TYPE)
    (TypedLetType 'O3' :kind TYPE)
    (TypedLetValue 'o' :type O1
      :value (TypedOption 'b' :type O1))
    (TypedLetValue 'p' :type O2
      :value (TypedVar 'o' :type O1))
    (TypedLetValue 'p3' :type O3
      :value (TypedVar 'o' :type O1))
    (TypedLetValue 'ordinals' :type Tuple Int Int Int end
      :value (TypedTuple :type Tuple Int Int Int end
        :elements (
          (TypedApp :type Int
            :func (TypedVar 'ordinal' :type All(A :: TYPE) Fun(o: A): Int)
            :args (
              (TypedVar 'o' :type O1)
            ))
          (TypedApp :type Int
            :func (TypedVar 'ordinal' :type All(A :: TYPE) Fun(o: A): Int)
            :args (
              (TypedVar 'p' :type O2)
            ))
          (TypedApp :type Int
            :func (TypedVar 'ordinal' :type All(A :: TYPE) Fun(o: A): Int)
            :args (
              (TypedVar 'p3' :type O3)
            ))
        )))
    (TypedLetType 'V1' :kind TYPE)
    (TypedLetType 'V2' :kind TYPE)
    (TypedLetValue 'v' :type V1
      :value (TypedVariant 'b' :type V1
        :payload (TypedBool true)))
    (TypedLetValue 'w' :type V2
      :value (TypedVar 'v' :type V1))
    (TypedLetValue 'viaW' :type Int
      :value (TypedCase :type Int
        :target (TypedVar 'w' :type V2)
        :branches (
          (TypedCaseBranch tags=(a) :binder 'x'
            :body (TypedVar 'x' :type Int))
          (TypedCaseBranch tags=(b) :binder 'y'
            :body (TypedInt 2 :type Int))
        )))
    (TypedLetValue 'back' :type V1
      :value (TypedVar 'w' :type V2))
    (TypedLetValue 'viaBack' :type Int
      :value (TypedCase :type Int
        :target (TypedVar 'back' :type V1)
        :branches (
          (TypedCaseBranch tags=(a) :binder 'x'
            :body (TypedVar 'x' :type Int))
          (TypedCaseBranch tags=(b) :binder 'y'
            :body (TypedInt 3 :type Int))
        )))
    (TypedLetType 'P1' :kind TYPE)
    (TypedLetType 'P2' :kind TYPE)
    (TypedLetValue 'q' :type P2
      :value (TypedOption ordinal :type P2
        :ordinal (TypedInt 2 :type Int)))
    (TypedLetValue 'r' :type P1
      :value (TypedVar 'q' :type P2))
    (TypedLetValue 'k' :type Int
      :value (TypedInt 1 :type Int))
    (TypedLetValue 's' :type P2
      :value (TypedOption ordinal :type P2
        :ordinal (TypedVar 'k' :type Int)))
    (TypedLetValue 'made' :type Tuple Int Int Int end
      :value (TypedTuple :type Tuple Int Int Int end
        :elements (
          (TypedApp :type Int
            :func (TypedVar 'ordinal' :type All(A :: TYPE) Fun(o: A): Int)
            :args (
              (TypedVar 'q' :type P2)
            ))
          (TypedApp :type Int
            :func (TypedVar 'ordinal' :type All(A :: TYPE) Fun(o: A): Int)
            :args (
              (TypedVar 'r' :type P1)
            ))
          (TypedApp :type Int
            :func (TypedVar 'ordinal' :type All(A :: TYPE) Fun(o: A): Int)
            :args (
              (TypedVar 's' :type P2)
            ))
        )))
    (TypedLetValue 'fromQ' :type Tuple Int end
      :value (TypedVariantAssert 'b' :type Tuple Int end
        :target (TypedVar 'q' :type P2)))
    (TypedLetValue 'fromR' :type Tuple Int end
      :value (TypedVariantAssert 'b' :type Tuple Int end
        :target (TypedVar 'r' :type P1)))
    (TypedLetValue 'ord' :type All(A <: Option b a end) Fun(x: A): Int
      :value (TypedFun :params (('x' : A)) :type All(A <: Option b a end) Fun(x: A): Int
        :body (TypedApp :type Int
          :func (TypedVar 'ordinal' :type All(A :: TYPE) Fun(o: A): Int)
          :args (
            (TypedVar 'x' :type A)
          ))))
    (TypedLetValue 'generic' :type Tuple Int Int end
      :value (TypedTuple :type Tuple Int Int end
        :elements (
          (TypedApp :type Int
            :func (TypedTypeApp [O1] :type Fun(x: O1): Int
              :func (TypedVar 'ord' :type All(A <: Option b a end) Fun(x: A): Int))
            :args (
              (TypedVar 'o' :type O1)
            ))
          (TypedApp :type Int
            :func (TypedTypeApp [O2] :type Fun(x: O2): Int
              :func (TypedVar 'ord' :type All(A <: Option b a end) Fun(x: A): Int))
            :args (
              (TypedVar 'p' :type O2)
            ))
        )))
  ))
