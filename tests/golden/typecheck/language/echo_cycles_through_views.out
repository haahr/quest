(TypedProgram
  :phrases (
    (TypedLetType 'Small' :kind TYPE)
    (TypedLetType 'Big' :kind TYPE)
    (TypedLetValue 'b' :type Big
      :value (TypedRecord :type Record a: Int var link: Option none some with Tuple s: Small end end end
        :fields (
          (TypedRecordField 'a'
            :value (TypedInt 1 :type Int))
          (TypedRecordField 'link' :var
            :value (TypedOption 'none' :type Option none some with Tuple s: Small end end))
        )))
    (TypedLetValue 's' :type Small
      :value (TypedVar 'b' :type Big))
    (TypedExprStmt
      :expr (TypedAssign
        :target (TypedSelect 'link' :type Option none some with Tuple s: Small end end
          :target (TypedVar 'b' :type Big))
        :value (TypedOption 'some' :type Option none some with Tuple s: Small end end
          :payload (TypedTuple :type Tuple s: Small end
            :elements (
              (TypedVar 's' :type Small)
            )))))
    (TypedExprStmt
      :expr (TypedVar 'b' :type Big))
    (TypedExprStmt
      :expr (TypedVar 's' :type Small))
    (TypedLetType 'TB' :kind TYPE)
    (TypedLetType 'TS' :kind TYPE)
    (TypedLetValue 'tb' :type TB
      :value (TypedTuple :type Tuple x: Big var next: Option none some with Tuple t: TB end end end
        :elements (
          (TypedRecord :type Record a: Int var link: Option none some with Tuple s: Small end end end
            :fields (
              (TypedRecordField 'a'
                :value (TypedInt 2 :type Int))
              (TypedRecordField 'link' :var
                :value (TypedOption 'none' :type Option none some with Tuple s: Small end end))
            ))
          (TypedOption 'none' :type Option none some with Tuple t: TB end end)
        )))
    (TypedLetValue 'ts' :type TS
      :value (TypedVar 'tb' :type TB))
    (TypedExprStmt
      :expr (TypedAssign
        :target (TypedSelect 'next' :type Option none some with Tuple t: TB end end
          :target (TypedVar 'tb' :type TB))
        :value (TypedOption 'some' :type Option none some with Tuple t: TB end end
          :payload (TypedTuple :type Tuple t: TB end
            :elements (
              (TypedVar 'tb' :type TB)
            )))))
    (TypedExprStmt
      :expr (TypedVar 'ts' :type TS))
  ))
