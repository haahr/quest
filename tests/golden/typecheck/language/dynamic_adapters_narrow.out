(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('ascii') : 'Ascii')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('dynamic') : 'Dynamic')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedLetType 'Big' :kind TYPE)
    (TypedLetType 'Small' :kind TYPE)
    (TypedLetValue 'show' :type Fun(s: String): Ok
      :value (TypedFun :params (('s' : String)) :type Fun(s: String): Ok
        :body (TypedApp :type Ok
          :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
            :target (TypedVar 'writer' :type Module 'writer'))
          :args (
            (TypedSelect 'output' :type writer.T
              :target (TypedVar 'writer' :type Module 'writer'))
            (TypedInfix '<>' :type String
              :left (TypedVar 's' :type String)
              :right (TypedString '\n' :type String))
          ))))
    (TypedLetValue 'f' :type Fun(b: Bool c: Char r: Small): Int
      :value (TypedFun :params (('b' : Bool) ('c' : Char) ('r' : Small)) :type Fun(b: Bool c: Char r: Small): Int
        :body (TypedIf :type Int
          :cond (TypedVar 'b' :type Bool)
          :then (TypedInfix '+' :type Int
            :left (TypedSelect 'y' :type Int
              :target (TypedVar 'r' :type Small))
            :right (TypedInt 1 :type Int))
          :else (TypedApp :type Int
            :func (TypedSelect 'val' :type Fun(c: Char): Int
              :target (TypedVar 'ascii' :type Module 'ascii'))
            :args (
              (TypedVar 'c' :type Char)
            )))))
    (TypedLetValue 'g' :type Fun(b: Bool c: Char r: Big): Int
      :value (TypedApp :type Fun(b: Bool c: Char r: Big): Int
        :func (TypedTypeApp [Fun(b: Bool c: Char r: Big): Int] :type Fun(d: T): Fun(b: Bool c: Char r: Big): Int
          :func (TypedSelect 'be' :type All(A :: TYPE) Fun(d: T): A
            :target (TypedVar 'dynamic' :type Module 'dynamic')))
        :args (
          (TypedApp :type T
            :func (TypedTypeApp [Fun(b: Bool c: Char r: Small): Int] :type Fun(a: Fun(b: Bool c: Char r: Small): Int): T
              :func (TypedSelect 'new' :type All(A :: TYPE) Fun(a: A): T
                :target (TypedVar 'dynamic' :type Module 'dynamic')))
            :args (
              (TypedVar 'f' :type Fun(b: Bool c: Char r: Small): Int)
            ))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'show' :type Fun(s: String): Ok)
        :args (
          (TypedApp :type String
            :func (TypedSelect 'int' :type Fun(n: Int): String
              :target (TypedVar 'conv' :type Module 'conv'))
            :args (
              (TypedApp :type Int
                :func (TypedVar 'g' :type Fun(b: Bool c: Char r: Big): Int)
                :args (
                  (TypedBool true)
                  (TypedChar 'a' :type Char)
                  (TypedRecord :type Record name: String y: Int end
                    :fields (
                      (TypedRecordField 'name'
                        :value (TypedString 'n' :type String))
                      (TypedRecordField 'y'
                        :value (TypedInt 40 :type Int))
                    ))
                ))
            ))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'show' :type Fun(s: String): Ok)
        :args (
          (TypedApp :type String
            :func (TypedSelect 'int' :type Fun(n: Int): String
              :target (TypedVar 'conv' :type Module 'conv'))
            :args (
              (TypedApp :type Int
                :func (TypedVar 'g' :type Fun(b: Bool c: Char r: Big): Int)
                :args (
                  (TypedBool false)
                  (TypedChar 'a' :type Char)
                  (TypedRecord :type Record name: String y: Int end
                    :fields (
                      (TypedRecordField 'name'
                        :value (TypedString 'n' :type String))
                      (TypedRecordField 'y'
                        :value (TypedInt 40 :type Int))
                    ))
                ))
            ))
        )))
  ))
