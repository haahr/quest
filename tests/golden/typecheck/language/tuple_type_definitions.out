(TypedProgram
  :phrases (
    (TypedLetType 'T' :kind TYPE)
    (TypedLetValue 'tt' :type T
      :value (TypedTuple :type Tuple Let K = Int k: K end
        :elements (
          (TypedTypeWitness 'K' = Int)
          (TypedInt 2 :type Int)
        )))
    (TypedLetValue 'tk' :type Int
      :value (TypedSelect 'k' :type Int
        :target (TypedVar 'tt' :type T)))
    (TypedExprStmt
      :expr (TypedInfix '+' :type Int
        :left (TypedVar 'tk' :type Int)
        :right (TypedInt 1 :type Int)))
    (TypedLetValue 'mk' :type Fun(): T
      :value (TypedFun :params () :type Fun(): T
        :body (TypedVar 'tt' :type T)))
    (TypedLetValue 'mkK' :type Int
      :value (TypedSelect 'k' :type Int
        :target (TypedApp :type T
          :func (TypedVar 'mk' :type Fun(): T)
          :args ())))
    (TypedLetType 'O' :kind TYPE)
    (TypedLetValue 'getK' :type Fun(t: T): Int
      :value (TypedFun :params (('t' : T)) :type Fun(t: T): Int
        :body (TypedSelect 'k' :type Int
          :target (TypedVar 't' :type T))))
    (TypedLetValue 'viaBlock' :type Int
      :value (TypedBlock :type Int
        :bindings (
          (TypedLetValue 'u' :type T
            :value (TypedTuple :type Tuple Let K = Int k: K end
              :elements (
                (TypedTypeWitness 'K' = Int)
                (TypedInt 3 :type Int)
              )))
        )
        :result (TypedSelect 'k' :type Int
          :target (TypedVar 'u' :type T))))
  ))
