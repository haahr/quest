(TypedProgram
  :phrases (
    (TypedLetType 'T' :kind TYPE)
    (TypedLetValue 't1' :type T
      :value (TypedTuple :type Tuple Type A :: TYPE a: A f: Fun(x: A): Int end
        :elements (
          (TypedTypeWitness 'A' = Int)
          (TypedInt 0 :type Int)
          (TypedFun :params (('x' : A)) :type Fun(x: A): Int
            :body (TypedInfix '+' :type Int
              :left (TypedVar 'x' :type A)
              :right (TypedInt 1 :type Int)))
        )))
    (TypedExprStmt
      :expr (TypedSelect 'a' :type t1.A
        :target (TypedVar 't1' :type T)))
    (TypedExprStmt
      :expr (TypedApp :type Int
        :func (TypedSelect 'f' :type Fun(x: t1.A): Int
          :target (TypedVar 't1' :type T))
        :args (
          (TypedSelect 'a' :type t1.A
            :target (TypedVar 't1' :type T))
        )))
  ))
