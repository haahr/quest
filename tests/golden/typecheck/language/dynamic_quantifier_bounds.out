(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('dynamic') : 'Dynamic')
      ))
    (TypedLetValue 'print' :type Fun(s: String): Ok
      :value (TypedFun :params (('s' : String)) :type Fun(s: String): Ok
        :body (TypedApp :type Ok
          :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
            :target (TypedVar 'writer' :type Module 'writer'))
          :args (
            (TypedSelect 'output' :type writer.T
              :target (TypedVar 'writer' :type Module 'writer'))
            (TypedInfix '<>' :type String
              :left (TypedVar 's' :type String)
              :right (TypedString '\n' :type String))
          ))))
    (TypedLetType 'Small' :kind TYPE)
    (TypedLetType 'Big' :kind TYPE)
    (TypedLetValue 'idS' :type All(A <: Small) Fun(x: A): A
      :value (TypedFun :params (('x' : A)) :type All(A <: Small) Fun(x: A): A
        :body (TypedVar 'x' :type A)))
    (TypedLetValue 'idB' :type All(A <: Big) Fun(x: A): A
      :value (TypedFun :params (('x' : A)) :type All(A <: Big) Fun(x: A): A
        :body (TypedVar 'x' :type A)))
    (TypedLetValue 'f' :type All(A <: Small) Fun(x: Small): Int
      :value (TypedFun :params (('x' : Small)) :type All(A <: Small) Fun(x: Small): Int
        :body (TypedSelect 'y' :type Int
          :target (TypedVar 'x' :type Small))))
    (TypedLetValue 'g' :type All(A <: Small B <: A) Fun(x: B): Small
      :value (TypedFun :params (('x' : B)) :type All(A <: Small B <: A) Fun(x: B): Small
        :body (TypedVar 'x' :type B)))
    (TypedLetValue 'be' :type Fun(what: String try1: Fun(): Ok): Ok
      :value (TypedFun :params (('what' : String) ('try1' : Fun(): Ok)) :type Fun(what: String try1: Fun(): Ok): Ok
        :body (TypedApp :type Ok
          :func (TypedVar 'print' :type Fun(s: String): Ok)
          :args (
            (TypedInfix '<>' :type String
              :left (TypedVar 'what' :type String)
              :right (TypedInfix '<>' :type String
                :left (TypedString ': ' :type String)
                :right (TypedTry :type String
                  :body (TypedBlock :type String
                    :bindings (
                      (TypedExprStmt
                        :expr (TypedApp :type Ok
                          :func (TypedVar 'try1' :type Fun(): Ok)
                          :args ()))
                    )
                    :result (TypedString 'accepted' :type String))
                  :branches (
                    (TypedTryBranch
                      :exc_pattern (TypedSelect 'error' :type Exception
                        :target (TypedVar 'dynamic' :type Module 'dynamic'))
                      :body (TypedString 'dynamic.error' :type String))
                  ))))
          ))))
    (TypedLetValue 's1' :type All(A <: Big) Fun(x: A): A
      :value (TypedVar 'idS' :type All(A <: Small) Fun(x: A): A))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'be' :type Fun(what: String try1: Fun(): Ok): Ok)
        :args (
          (TypedString 'Small bound as Big bound' :type String)
          (TypedFun :params () :type Fun(): Ok
            :body (TypedBlock :type Ok
              :bindings (
                (TypedExprStmt
                  :expr (TypedApp :type All(A <: Big) Fun(x: A): A
                    :func (TypedTypeApp [All(A <: Big) Fun(x: A): A] :type Fun(d: T): All(A <: Big) Fun(x: A): A
                      :func (TypedSelect 'be' :type All(A :: TYPE) Fun(d: T): A
                        :target (TypedVar 'dynamic' :type Module 'dynamic')))
                    :args (
                      (TypedApp :type T
                        :func (TypedTypeApp [All(A <: Small) Fun(x: A): A] :type Fun(a: All(A <: Small) Fun(x: A): A): T
                          :func (TypedSelect 'new' :type All(A :: TYPE) Fun(a: A): T
                            :target (TypedVar 'dynamic' :type Module 'dynamic')))
                        :args (
                          (TypedVar 'idS' :type All(A <: Small) Fun(x: A): A)
                        ))
                    )))
              )
              :result (TypedOk)))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'be' :type Fun(what: String try1: Fun(): Ok): Ok)
        :args (
          (TypedString 'Big bound as Small bound' :type String)
          (TypedFun :params () :type Fun(): Ok
            :body (TypedBlock :type Ok
              :bindings (
                (TypedExprStmt
                  :expr (TypedApp :type All(A <: Small) Fun(x: A): A
                    :func (TypedTypeApp [All(A <: Small) Fun(x: A): A] :type Fun(d: T): All(A <: Small) Fun(x: A): A
                      :func (TypedSelect 'be' :type All(A :: TYPE) Fun(d: T): A
                        :target (TypedVar 'dynamic' :type Module 'dynamic')))
                    :args (
                      (TypedApp :type T
                        :func (TypedTypeApp [All(A <: Big) Fun(x: A): A] :type Fun(a: All(A <: Big) Fun(x: A): A): T
                          :func (TypedSelect 'new' :type All(A :: TYPE) Fun(a: A): T
                            :target (TypedVar 'dynamic' :type Module 'dynamic')))
                        :args (
                          (TypedVar 'idB' :type All(A <: Big) Fun(x: A): A)
                        ))
                    )))
              )
              :result (TypedOk)))
        )))
    (TypedLetValue 's3' :type All(A <: Small) Fun(x: A): Int
      :value (TypedVar 'f' :type All(A <: Small) Fun(x: Small): Int))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'be' :type Fun(what: String try1: Fun(): Ok): Ok)
        :args (
          (TypedString 'parameter at its bound' :type String)
          (TypedFun :params () :type Fun(): Ok
            :body (TypedBlock :type Ok
              :bindings (
                (TypedExprStmt
                  :expr (TypedApp :type All(A <: Small) Fun(x: A): Int
                    :func (TypedTypeApp [All(A <: Small) Fun(x: A): Int] :type Fun(d: T): All(A <: Small) Fun(x: A): Int
                      :func (TypedSelect 'be' :type All(A :: TYPE) Fun(d: T): A
                        :target (TypedVar 'dynamic' :type Module 'dynamic')))
                    :args (
                      (TypedApp :type T
                        :func (TypedTypeApp [All(A <: Small) Fun(x: Small): Int] :type Fun(a: All(A <: Small) Fun(x: Small): Int): T
                          :func (TypedSelect 'new' :type All(A :: TYPE) Fun(a: A): T
                            :target (TypedVar 'dynamic' :type Module 'dynamic')))
                        :args (
                          (TypedVar 'f' :type All(A <: Small) Fun(x: Small): Int)
                        ))
                    )))
              )
              :result (TypedOk)))
        )))
    (TypedLetValue 's4' :type All(A <: Small) Fun(x: A): Small
      :value (TypedVar 'idS' :type All(A <: Small) Fun(x: A): A))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'be' :type Fun(what: String try1: Fun(): Ok): Ok)
        :args (
          (TypedString 'result at its bound' :type String)
          (TypedFun :params () :type Fun(): Ok
            :body (TypedBlock :type Ok
              :bindings (
                (TypedExprStmt
                  :expr (TypedApp :type All(A <: Small) Fun(x: A): Small
                    :func (TypedTypeApp [All(A <: Small) Fun(x: A): Small] :type Fun(d: T): All(A <: Small) Fun(x: A): Small
                      :func (TypedSelect 'be' :type All(A :: TYPE) Fun(d: T): A
                        :target (TypedVar 'dynamic' :type Module 'dynamic')))
                    :args (
                      (TypedApp :type T
                        :func (TypedTypeApp [All(A <: Small) Fun(x: A): A] :type Fun(a: All(A <: Small) Fun(x: A): A): T
                          :func (TypedSelect 'new' :type All(A :: TYPE) Fun(a: A): T
                            :target (TypedVar 'dynamic' :type Module 'dynamic')))
                        :args (
                          (TypedVar 'idS' :type All(A <: Small) Fun(x: A): A)
                        ))
                    )))
              )
              :result (TypedOk)))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'be' :type Fun(what: String try1: Fun(): Ok): Ok)
        :args (
          (TypedString 'bound as the parameter' :type String)
          (TypedFun :params () :type Fun(): Ok
            :body (TypedBlock :type Ok
              :bindings (
                (TypedExprStmt
                  :expr (TypedApp :type All(A <: Small) Fun(x: Small): A
                    :func (TypedTypeApp [All(A <: Small) Fun(x: Small): A] :type Fun(d: T): All(A <: Small) Fun(x: Small): A
                      :func (TypedSelect 'be' :type All(A :: TYPE) Fun(d: T): A
                        :target (TypedVar 'dynamic' :type Module 'dynamic')))
                    :args (
                      (TypedApp :type T
                        :func (TypedTypeApp [All(A <: Small) Fun(x: A): Small] :type Fun(a: All(A <: Small) Fun(x: A): Small): T
                          :func (TypedSelect 'new' :type All(A :: TYPE) Fun(a: A): T
                            :target (TypedVar 'dynamic' :type Module 'dynamic')))
                        :args (
                          (TypedFun :params (('x' : A)) :type All(A <: Small) Fun(x: A): Small
                            :body (TypedVar 'x' :type A))
                        ))
                    )))
              )
              :result (TypedOk)))
        )))
    (TypedLetValue 's5' :type All(A <: Big B <: A) Fun(x: B): Small
      :value (TypedVar 'g' :type All(A <: Small B <: A) Fun(x: B): Small))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'be' :type Fun(what: String try1: Fun(): Ok): Ok)
        :args (
          (TypedString 'bound through a bound' :type String)
          (TypedFun :params () :type Fun(): Ok
            :body (TypedBlock :type Ok
              :bindings (
                (TypedExprStmt
                  :expr (TypedApp :type All(A <: Big B <: A) Fun(x: B): Small
                    :func (TypedTypeApp [All(A <: Big B <: A) Fun(x: B): Small] :type Fun(d: T): All(A <: Big B <: A) Fun(x: B): Small
                      :func (TypedSelect 'be' :type All(A :: TYPE) Fun(d: T): A
                        :target (TypedVar 'dynamic' :type Module 'dynamic')))
                    :args (
                      (TypedApp :type T
                        :func (TypedTypeApp [All(A <: Small B <: A) Fun(x: B): Small] :type Fun(a: All(A <: Small B <: A) Fun(x: B): Small): T
                          :func (TypedSelect 'new' :type All(A :: TYPE) Fun(a: A): T
                            :target (TypedVar 'dynamic' :type Module 'dynamic')))
                        :args (
                          (TypedVar 'g' :type All(A <: Small B <: A) Fun(x: B): Small)
                        ))
                    )))
              )
              :result (TypedOk)))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'be' :type Fun(what: String try1: Fun(): Ok): Ok)
        :args (
          (TypedString 'bound through a narrower bound' :type String)
          (TypedFun :params () :type Fun(): Ok
            :body (TypedBlock :type Ok
              :bindings (
                (TypedExprStmt
                  :expr (TypedApp :type All(A <: Small B <: A) Fun(x: B): Big
                    :func (TypedTypeApp [All(A <: Small B <: A) Fun(x: B): Big] :type Fun(d: T): All(A <: Small B <: A) Fun(x: B): Big
                      :func (TypedSelect 'be' :type All(A :: TYPE) Fun(d: T): A
                        :target (TypedVar 'dynamic' :type Module 'dynamic')))
                    :args (
                      (TypedApp :type T
                        :func (TypedTypeApp [All(A <: Small B <: A) Fun(x: B): Small] :type Fun(a: All(A <: Small B <: A) Fun(x: B): Small): T
                          :func (TypedSelect 'new' :type All(A :: TYPE) Fun(a: A): T
                            :target (TypedVar 'dynamic' :type Module 'dynamic')))
                        :args (
                          (TypedVar 'g' :type All(A <: Small B <: A) Fun(x: B): Small)
                        ))
