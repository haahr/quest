(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedLetValue 'print' :type Fun(s: String): Ok
      :value (TypedFun :params (('s' : String)) :type Fun(s: String): Ok
        :body (TypedApp :type Ok
          :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
            :target (TypedVar 'writer' :type Module 'writer'))
          :args (
            (TypedSelect 'output' :type writer.T
              :target (TypedVar 'writer' :type Module 'writer'))
            (TypedInfix '<>' :type String
              :left (TypedVar 's' :type String)
              :right (TypedString '\n' :type String))
          ))))
    (TypedExprStmt
      :expr (TypedException 'other' :type Exception))
    (TypedLetValue 'guarded' :rec :type Fun(n: Int): Int
      :value (TypedFun :params (('n' : Int)) :type Fun(n: Int): Int
        :body (TypedTry :type Int
          :body (TypedApp :type Int
            :func (TypedVar 'guarded' :type Fun(n: Int): Int)
            :args (
              (TypedInfix '+' :type Int
                :left (TypedVar 'n' :type Int)
                :right (TypedInt 1 :type Int))
            ))
          :branches (
            (TypedTryBranch
              :exc_pattern (TypedVar 'other' :type Exception)
              :body (TypedInt 0 :type Int))
          ))))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedTry :type String
            :body (TypedApp :type String
              :func (TypedSelect 'int' :type Fun(n: Int): String
                :target (TypedVar 'conv' :type Module 'conv'))
              :args (
                (TypedApp :type Int
                  :func (TypedVar 'guarded' :type Fun(n: Int): Int)
                  :args (
                    (TypedInt 0 :type Int)
                  ))
              ))
            :branches ()
            :else (TypedString 'overflow in a try' :type String))
        )))
    (TypedLetValue 'looping' :rec :type Fun(n: Int): Ok
      :value (TypedFun :params (('n' : Int)) :type Fun(n: Int): Ok
        :body (TypedFor 'i' :upto
          :start (TypedInt 0 :type Int)
          :stop (TypedInt 0 :type Int)
          :body (TypedApp :type Ok
            :func (TypedVar 'looping' :type Fun(n: Int): Ok)
            :args (
              (TypedInfix '+' :type Int
                :left (TypedVar 'n' :type Int)
                :right (TypedInt 1 :type Int))
            )))))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedTry :type String
            :body (TypedBlock :type String
              :bindings (
                (TypedExprStmt
                  :expr (TypedApp :type Ok
                    :func (TypedVar 'looping' :type Fun(n: Int): Ok)
                    :args (
                      (TypedInt 0 :type Int)
                    )))
              )
              :result (TypedString 'no overflow' :type String))
            :branches ()
            :else (TypedString 'overflow in a loop' :type String))
        )))
    (TypedLetValue 'next' :type Fun(n: Int): Int
      :value (TypedFun :params (('n' : Int)) :type Fun(n: Int): Int
        :body (TypedInfix '+' :type Int
          :left (TypedVar 'n' :type Int)
          :right (TypedInt 1 :type Int))))
    (TypedLetValue 'nested' :rec :type Fun(n: Int): Int
      :value (TypedFun :params (('n' : Int)) :type Fun(n: Int): Int
        :body (TypedApp :type Int
          :func (TypedVar 'next' :type Fun(n: Int): Int)
          :args (
            (TypedApp :type Int
              :func (TypedVar 'nested' :type Fun(n: Int): Int)
              :args (
                (TypedInfix '+' :type Int
                  :left (TypedVar 'n' :type Int)
                  :right (TypedInt 1 :type Int))
              ))
          ))))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedTry :type String
            :body (TypedApp :type String
              :func (TypedSelect 'int' :type Fun(n: Int): String
                :target (TypedVar 'conv' :type Module 'conv'))
              :args (
                (TypedApp :type Int
                  :func (TypedVar 'nested' :type Fun(n: Int): Int)
                  :args (
                    (TypedInt 0 :type Int)
                  ))
              ))
            :branches ()
            :else (TypedString 'overflow in an argument' :type String))
        )))
  ))
