(TypedProgram
  :phrases (
    (TypedLetType 'Nest' :kind TYPE)
    (TypedLetValue 'n' :type Nest
      :value (TypedAuto :Int :type Nest
        :payload (TypedTuple :type Tuple a: Int inner: Auto B :: TYPE with b: B a2: Int end end
          :elements (
            (TypedInt 5 :type Int)
            (TypedAuto :String :type Auto B :: TYPE with b: B a2: Int end
              :payload (TypedTuple :type Tuple b: String a2: Int end
                :elements (
                  (TypedString 's' :type String)
                  (TypedInt 6 :type Int)
                )))
          ))))
    (TypedExprStmt
      :expr (TypedVar 'n' :type Nest))
    (TypedLetType 'Deep' :kind TYPE)
    (TypedLetValue 'd' :type Deep
      :value (TypedAuto :Bool :type Deep
        :payload (TypedTuple :type Tuple a: Bool mid: Auto B :: TYPE with b: B low: Auto C :: TYPE with c: C aa: Array(Bool) bs: Tuple x: B end end end end
          :elements (
            (TypedBool true)
            (TypedAuto :Char :type Auto B :: TYPE with b: B low: Auto C :: TYPE with c: C aa: Array(Bool) bs: Tuple x: B end end end
              :payload (TypedTuple :type Tuple b: Char low: Auto C :: TYPE with c: C aa: Array(Bool) bs: Tuple x: Char end end end
                :elements (
                  (TypedChar 'x' :type Char)
                  (TypedAuto :Real :type Auto C :: TYPE with c: C aa: Array(Bool) bs: Tuple x: Char end end
                    :payload (TypedTuple :type Tuple c: Real aa: Array(Bool) bs: Tuple x: Char end end
                      :elements (
                        (TypedReal 1.5 :type Real)
                        (TypedArray :type Array(Bool)
                          :elements (
                            (TypedBool false)
                            (TypedBool true)
                          ))
                        (TypedTuple :type Tuple x: Char end
                          :elements (
                            (TypedChar 'y' :type Char)
                          ))
                      )))
                )))
          ))))
  ))
