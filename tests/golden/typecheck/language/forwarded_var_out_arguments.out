(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('conv') : 'Conv')
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedLetValue 'mk' :type All(A :: TYPE) Fun(out x: Bool var y: Real): Ok
      :value (TypedFun :params (('x' : Bool) ('y' : Real)) :type All(A :: TYPE) Fun(out x: Bool var y: Real): Ok
        :body (TypedBlock :type Ok
          :bindings (
            (TypedExprStmt
              :expr (TypedAssign
                :target (TypedVar 'x' :type Var(Bool))
                :value (TypedBool true)))
          )
          :result (TypedAssign
            :target (TypedVar 'y' :type Var(Real))
            :value (TypedReal 2.5 :type Real)))))
    (TypedLetValue 'keep' :type All(A :: TYPE) Fun(out x: Bool var y: Real): Ok
      :value (TypedVar 'mk' :type All(A :: TYPE) Fun(out x: Bool var y: Real): Ok))
    (TypedLetValue 'set' :type All(A :: TYPE) Fun(out x: Bool var y: Real): Ok
      :value (TypedFun :params (('x' : Bool) ('y' : Real)) :type All(A :: TYPE) Fun(out x: Bool var y: Real): Ok
        :body (TypedApp :type Ok
          :func (TypedTypeApp [A] :type Fun(out x: Bool var y: Real): Ok
            :func (TypedDerefCell :type All(A :: TYPE) Fun(out x: Bool var y: Real): Ok
              :target (TypedVar 'keep' :type Var(All(A :: TYPE) Fun(out x: Bool var y: Real): Ok))))
          :args (
            (TypedVar 'x' :type Out(Bool))
            (TypedVar 'y' :type Var(Real))
          ))))
    (TypedLetValue 'b' :type Bool
      :value (TypedBool false))
    (TypedLetValue 'r' :type Real
      :value (TypedReal 1.25 :type Real))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedTypeApp [Int] :type Fun(out x: Bool var y: Real): Ok
          :func (TypedVar 'set' :type All(A :: TYPE) Fun(out x: Bool var y: Real): Ok))
        :args (
          (TypedVar 'b' :type Var(Bool))
          (TypedVar 'r' :type Var(Real))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedSelect 'output' :type writer.T
            :target (TypedVar 'writer' :type Module 'writer'))
          (TypedInfix '<>' :type String
            :left (TypedApp :type String
              :func (TypedSelect 'real' :type Fun(r: Real): String
                :target (TypedVar 'conv' :type Module 'conv'))
              :args (
                (TypedIf :type Real
                  :cond (TypedDerefCell :type Bool
                    :target (TypedVar 'b' :type Var(Bool)))
                  :then (TypedDerefCell :type Real
                    :target (TypedVar 'r' :type Var(Real)))
                  :else (TypedReal 0.0 :type Real))
              ))
            :right (TypedString '\n' :type String))
        )))
  ))
