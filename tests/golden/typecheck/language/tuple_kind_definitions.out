                  :target (TypedVar 'synthesized' :type Tuple Let Pair = Fun(A :: TYPE) Tuple first: A second: A end swap: All(F :: KOp) Fun(p: F(Int)): F(Int) pair: Tuple first: Int second: Int end end)))
            ))
