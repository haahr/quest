      :value (TypedTuple :type Tuple Let Pair = Fun(A :: TYPE) Tuple first: A second: A end swap: All(F :: KOp) Fun(p: F(Int)): F(Int) pair: Tuple first: Int second: Int end end
        :elements (
          (TypedTypeWitness 'Pair' = Fun(A :: TYPE) Tuple first: A second: A end)
          (TypedFun :params (('p' : F(Int))) :type All(F :: KOp) Fun(p: F(Int)): F(Int)
