(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedLetValue 'inner' :type All(G :: ALL(C :: TYPE) <: C) Ok
      :value (TypedFun :params () :type All(G :: ALL(C :: TYPE) <: C) Ok
        :body (TypedOk)))
    (TypedLetValue 'outer' :type All(F :: ALL(B :: TYPE) <: B) Ok
      :value (TypedFun :params () :type All(F :: ALL(B :: TYPE) <: B) Ok
        :body (TypedTypeApp [F] :type Ok
          :func (TypedVar 'inner' :type All(G :: ALL(C :: TYPE) <: C) Ok))))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedSelect 'output' :type writer.T
            :target (TypedVar 'writer' :type Module 'writer'))
          (TypedString 'ok\n' :type String)
        )))
  ))
