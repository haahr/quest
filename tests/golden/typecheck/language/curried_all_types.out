              :target (TypedVar 'writer' :type Module 'writer'))
            (TypedInfix '<>' :type String
              :left (TypedVar 's' :type String)
              :right (TypedString '\n' :type String))
          ))))
    (TypedLetValue 'k' :type All(A :: TYPE B :: TYPE) Fun(x: A y: B): A
      :value (TypedFun :params (('x' : A) ('y' : B)) :type All(A :: TYPE B :: TYPE) Fun(x: A y: B): A
        :body (TypedVar 'x' :type A)))
    (TypedLetValue 'k2' :type All(A :: TYPE) All(B :: TYPE) Fun(x: A y: B): A
