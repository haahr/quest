    (TypedLetValue 'k3' :type All(A :: TYPE B :: TYPE) Fun(x: A y: B): A
      :value (TypedVar 'k2' :type All(A :: TYPE) All(B :: TYPE) Fun(x: A y: B): A))
    (TypedExprStmt
      :expr (TypedApp :type Ok
