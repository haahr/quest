                      :func (TypedTypeApp [Int] :type All(B :: TYPE) Fun(x: Int y: B): Int
                        :func (TypedVar 'k2' :type All(A :: TYPE) All(B :: TYPE) Fun(x: A y: B): A)))
                    :args (
                      (TypedInt 1 :type Int)
                      (TypedString 'a' :type String)
                    ))
                ))
              :right (TypedInfix '<>' :type String
                :left (TypedString ' ' :type String)
                :right (TypedApp :type String
                  :func (TypedSelect 'int' :type Fun(n: Int): String
                    :target (TypedVar 'conv' :type Module 'conv'))
                  :args (
                    (TypedApp :type Int
                      :func (TypedTypeApp [Int String] :type Fun(x: Int y: String): Int
                        :func (TypedVar 'k3' :type All(A :: TYPE B :: TYPE) Fun(x: A y: B): A))
                      :args (
                        (TypedInt 2 :type Int)
                        (TypedString 'b' :type String)
                      ))
                  )))))
        )))
    (TypedExprStmt
