(TypedProgram
  :phrases (
    (TypedLetType 'O' :kind TYPE)
    (TypedLetValue 'k' :type Int
      :value (TypedBlock :type Int
        :bindings (
          (TypedLetValue 'o' :type O
            :value (TypedOption 'some' :type O
              :payload (TypedTuple :type Tuple Let K = Int k: K end
                :elements (
                  (TypedTypeWitness 'K' = Int)
                  (TypedInt 2 :type Int)
                ))))
        )
        :result (TypedInfix '+' :type Int
          :left (TypedSelect 'k' :type K
            :target (TypedVariantAssert 'some' :type Tuple Int Let K = Int k: K end
              :target (TypedVar 'o' :type O)))
          :right (TypedInt 1 :type Int))))
    (TypedLetType 'V' :kind TYPE)
    (TypedLetValue 'n' :type Int
      :value (TypedBlock :type Int
        :bindings (
          (TypedLetValue 'v' :type V
            :value (TypedOption 'some' :type V
              :payload (TypedTuple :type Tuple var n: Int end
                :elements (
                  (TypedInt 1 :type Int)
                ))))
        )
        :result (TypedInfix '+' :type Int
          :left (TypedSelect 'n' :type Int
            :target (TypedVariantAssert 'some' :type Tuple Int var n: Int end
              :target (TypedVar 'v' :type V)))
          :right (TypedInt 1 :type Int))))
    (TypedLetType 'R' :kind TYPE)
    (TypedLetValue 'h' :type Int
      :value (TypedBlock :type Int
        :bindings (
          (TypedLetValue 'r' :type R
            :value (TypedOption 'cons' :type R
              :payload (TypedTuple :type Tuple Let X = Int h: X t: R end
                :elements (
                  (TypedTypeWitness 'X' = Int)
                  (TypedInt 1 :type Int)
                  (TypedOption 'nil' :type R)
                ))))
        )
        :result (TypedInfix '+' :type Int
          :left (TypedSelect 'h' :type X
            :target (TypedVariantAssert 'cons' :type Tuple Int Let X = Int h: X t: R end
              :target (TypedVar 'r' :type R)))
          :right (TypedInt 1 :type Int))))
    (TypedLetType 'E' :kind TYPE)
    (TypedLetValue 'isSome' :type Bool
      :value (TypedBlock :type Bool
        :bindings (
          (TypedLetValue 'e' :type E
            :value (TypedOption 'some' :type E
              :payload (TypedTuple :type Tuple Type A :: TYPE x: A get: Fun(): A end
                :elements (
                  (TypedTypeWitness 'A' = Int)
                  (TypedInt 3 :type Int)
                  (TypedFun :params () :type Fun(): A
                    :body (TypedVar 'x' :type Int))
                ))))
        )
        :result (TypedVariantCheck 'some' :type Bool
          :target (TypedVar 'e' :type E))))
  ))
