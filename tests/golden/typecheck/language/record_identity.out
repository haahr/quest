                :target (TypedVar 'conv' :type Module 'conv'))
              :args (
                (TypedInfix 'is' :type Bool
                  :left (TypedVar 'wp' :type P)
                  :right (TypedVar 'w' :type Q))
              )))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedInfix '<>' :type String
            :left (TypedString 'a view isnot another record: ' :type String)
            :right (TypedApp :type String
              :func (TypedSelect 'bool' :type Fun(b: Bool): String
                :target (TypedVar 'conv' :type Module 'conv'))
              :args (
                (TypedInfix 'isnot' :type Bool
                  :left (TypedVar 'wp' :type P)
                  :right (TypedVar 'p' :type P))
              )))
        )))
    (TypedLetValue 'same' :type All(A :: TYPE) Fun(x: A y: A): Bool
      :value (TypedFun :params (('x' : A) ('y' : A)) :type All(A :: TYPE) Fun(x: A y: A): Bool
        :body (TypedInfix 'is' :type Bool
          :left (TypedVar 'x' :type A)
          :right (TypedVar 'y' :type A))))
    (TypedLetValue 'sameValue' :type All(A :: TYPE) Fun(x: A y: A): Bool
