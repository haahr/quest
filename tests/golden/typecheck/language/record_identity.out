                  :func (TypedTypeApp [P] :type Fun(x: P y: P): Bool
                    :func (TypedVar 'sameValue' :type All(A :: TYPE) Fun(x: A y: A): Bool))
                  :args (
                    (TypedVar 'wp' :type P)
                    (TypedVar 'w' :type Q)
                  ))
              )))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'print' :type Fun(s: String): Ok)
        :args (
          (TypedInfix '<>' :type String
            :left (TypedString 'generic p view: ' :type String)
            :right (TypedApp :type String
              :func (TypedSelect 'bool' :type Fun(b: Bool): String
