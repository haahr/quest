(TypedProgram
  :phrases (
    (TypedLetType 'P' :kind TYPE)
    (TypedLetType 'R' :kind TYPE)
    (TypedLetValue 'rr' :type R
      :value (TypedOption 'cons' :type R
        :payload (TypedTuple :type Tuple Let X = P h: Int t: R end
          :elements (
            (TypedTypeWitness 'X' = P)
            (TypedInt 1 :type Int)
            (TypedOption 'nil' :type R)
          ))))
    (TypedLetValue 'two' :type R
      :value (TypedOption 'cons' :type R
        :payload (TypedTuple :type Tuple Let X = P h: Int t: R end
          :elements (
            (TypedTypeWitness 'X' = P)
            (TypedInt 2 :type Int)
            (TypedVar 'rr' :type R)
          ))))
    (TypedLetTypeGroup 'Forest' 'Tree'
      :members (
        (TypedLetType 'Forest' :kind TYPE)
        (TypedLetType 'Tree' :kind TYPE)
      ))
    (TypedLetValue 'leaf' :type Tree
      :value (TypedVariant 'leaf' :type Tree
        :payload (TypedTuple :type Tuple Let Y = P y: Int end
          :elements (
            (TypedTypeWitness 'Y' = P)
            (TypedInt 3 :type Int)
          ))))
    (TypedLetValue 'forest' :type Forest
      :value (TypedRecord :type Record trees: Array(Tree) end
        :fields (
          (TypedRecordField 'trees'
            :value (TypedArray :type Array(Tree)
              :elements (
                (TypedVar 'leaf' :type Tree)
                (TypedVariant 'node' :type Tree
                  :payload (TypedRecord :type Record trees: Array(Tree) end
                    :fields (
                      (TypedRecordField 'trees'
                        :value (TypedArray :type Array(Tree)
                          :elements (
                            (TypedVar 'leaf' :type Tree)
                          )))
                    )))
              )))
        )))
    (TypedLetValue 'anon' :type Rec(S :: TYPE) Option stop more with Tuple Let Z = P s: S end end
      :value (TypedOption 'more' :type Rec(S :: TYPE) Option stop more with Tuple Let Z = P s: S end end
        :payload (TypedTuple :type Tuple Let Z = P s: Rec(S :: TYPE) Option stop more with Tuple Let Z = P s: S end end end
          :elements (
            (TypedTypeWitness 'Z' = P)
            (TypedOption 'stop' :type Rec(S :: TYPE) Option stop more with Tuple Let Z = P s: S end end)
          ))))
  ))
