(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedLetValue 'f' :rec :type Fun(n: Int): Int
      :value (TypedFun :params (('n' : Int)) :type Fun(n: Int): Int
        :body (TypedIf :type Int
          :cond (TypedInfix '>' :type Bool
            :left (TypedVar 'n' :type Int)
            :right (TypedInt 100 :type Int))
          :then (TypedInfix '+' :type Int
            :left (TypedApp :type Int
              :func (TypedVar 'f' :type Fun(n: Int): Int)
              :args (
                (TypedInfix '-' :type Int
                  :left (TypedVar 'n' :type Int)
                  :right (TypedInt 100 :type Int))
              ))
            :right (TypedInt 1 :type Int))
          :else (TypedBlock :type Int
            :bindings (
              (TypedLetValue 'g' :rec :type Fun(x: Int): Int
                :value (TypedBlock :type Fun(x: Int): Int
                  :bindings (
                    (TypedLetValue 'h' :rec :type Fun(y: Int): Int
                      :value (TypedFun :params (('y' : Int)) :type Fun(y: Int): Int
                        :body (TypedIf :type Int
                          :cond (TypedInfix 'is' :type Bool
                            :left (TypedVar 'y' :type Int)
                            :right (TypedInt 0 :type Int))
                          :then (TypedVar 'n' :type Int)
                          :else (TypedInfix '+' :type Int
                            :left (TypedApp :type Int
                              :func (TypedVar 'g' :type Fun(x: Int): Int)
                              :args (
                                (TypedInfix '-' :type Int
                                  :left (TypedVar 'y' :type Int)
                                  :right (TypedInt 1 :type Int))
                              ))
                            :right (TypedApp :type Int
                              :func (TypedVar 'h' :type Fun(y: Int): Int)
                              :args (
                                (TypedInt 0 :type Int)
                              ))))))
                  )
                  :result (TypedVar 'h' :type Fun(y: Int): Int)))
            )
            :result (TypedApp :type Int
              :func (TypedVar 'g' :type Fun(x: Int): Int)
              :args (
                (TypedVar 'n' :type Int)
              ))))))
    (TypedLetValue 't' :type Int
      :value (TypedInt 3 :type Int))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putString' :type Fun(writer: writer.T string: String): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedSelect 'output' :type writer.T
            :target (TypedVar 'writer' :type Module 'writer'))
          (TypedInfix '<>' :type String
            :left (TypedApp :type String
              :func (TypedSelect 'int' :type Fun(n: Int): String
                :target (TypedVar 'conv' :type Module 'conv'))
              :args (
                (TypedApp :type Int
                  :func (TypedVar 'f' :type Fun(n: Int): Int)
                  :args (
                    (TypedDerefCell :type Int
                      :target (TypedVar 't' :type Var(Int)))
                  ))
              ))
            :right (TypedString '\n' :type String))
        )))
  ))
