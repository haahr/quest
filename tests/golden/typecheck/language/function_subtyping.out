                  :target (TypedApp :type Small
                    :func (TypedSelect 'a' :type Fun(x: Big): Small
                      :target (TypedVar 'g' :type Tuple a: Fun(x: Big): Small end))
                    :args (
                      (TypedVar 'big' :type Big)
                    ))))
            )
            :else (TypedInt 0 :type Int))
        )))
    (TypedLetValue 'wrong' :type Int
      :value (TypedTry :type Int
        :body (TypedBlock :type Int
          :bindings (
            (TypedLetValue 'g' :type Fun(x: Small): Int
              :value (TypedApp :type Fun(x: Small): Int
                :func (TypedTypeApp [Fun(x: Small): Int] :type Fun(d: Dynamic.T): Fun(x: Small): Int
                  :func (TypedSelect 'be' :type All(A :: TYPE) Fun(d: Dynamic.T): A
                    :target (TypedVar 'dynamic' :type Module 'dynamic')))
                :args (
                  (TypedApp :type Dynamic.T
                    :func (TypedTypeApp [Fun(x: Big): Int] :type Fun(a: Fun(x: Big): Int): Dynamic.T
                      :func (TypedSelect 'new' :type All(A :: TYPE) Fun(a: A): Dynamic.T
                        :target (TypedVar 'dynamic' :type Module 'dynamic')))
                    :args (
                      (TypedFun :params (('x' : Big)) :type Fun(x: Big): Int
                        :body (TypedSelect 'a' :type Int
                          :target (TypedVar 'x' :type Big)))
                    ))
                )))
          )
          :result (TypedApp :type Int
            :func (TypedVar 'g' :type Fun(x: Small): Int)
            :args (
              (TypedRecord :type Record c: Int end
