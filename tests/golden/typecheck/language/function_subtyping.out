        :func (TypedVar 'p' :type Fun(n: Int): Ok)
        :args (
          (TypedInspect :type Int
            :target (TypedVar 'd' :type Dynamic.T)
            :branches (
              (TypedInspectBranch match=Fun(x: Big): Small
                :body (TypedSelect 'c' :type Int
                  :target (TypedApp :type Small
                    :func (TypedVar 'g' :type Fun(x: Big): Small)
                    :args (
                      (TypedVar 'big' :type Big)
                    ))))
            )
            :else (TypedInt 0 :type Int))
        )))
    (TypedLetType 'Boxed' :kind TYPE)
    (TypedLetValue 'boxedNarrow' :type Boxed
      :value (TypedAuto :Fun(x: Small): Big :type Boxed
        :payload (TypedTuple :type Tuple a: Fun(x: Small): Big end
          :elements (
            (TypedVar 'narrow' :type Fun(x: Small): Big)
