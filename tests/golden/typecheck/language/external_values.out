(TypedProgram
  :phrases (
    (TypedLetValue 'maxVal' :type Int
      :value (TypedExternal 'QUEST_INT_MAX' :type Int))
    (TypedLetValue 'minVal' :type Int
      :value (TypedExternal 'QUEST_INT_MIN' :type Int))
    (TypedExprStmt
      :expr (TypedInfix '>' :type Bool
        :left (TypedVar 'maxVal' :type Int)
        :right (TypedInt 0 :type Int)))
    (TypedExprStmt
      :expr (TypedInfix '<' :type Bool
        :left (TypedVar 'minVal' :type Int)
        :right (TypedInt 0 :type Int)))
  ))
