(TypedProgram
  :phrases (
    (TypedDefKind 'BOOL' :kind ALL(Then :: TYPE) ALL(Else :: TYPE) TYPE)
    (TypedLetType 'True' :kind BOOL)
    (TypedLetType 'False' :kind BOOL)
    (TypedLetType 'Cond' :kind ALL(If :: BOOL) ALL(Then :: TYPE) ALL(Else :: TYPE) TYPE)
    (TypedLetValue 't' :type Cond(True Int String)
      :value (TypedInt 3 :type Int))
    (TypedLetValue 'f' :type Cond(False Int String)
      :value (TypedString 'three' :type String))
    (TypedDefKind 'K3' :kind ALL(A :: TYPE) ALL(B :: TYPE) ALL(C :: TYPE) TYPE)
    (TypedLetType 'Third' :kind K3)
    (TypedLetValue 'c' :type Third(Int Bool String)
      :value (TypedString 'third' :type String))
    (TypedLetValue 'tInt' :type Int
      :value (TypedVar 't' :type Cond(True Int String)))
    (TypedLetValue 'fString' :type String
      :value (TypedVar 'f' :type Cond(False Int String)))
    (TypedLetValue 'cString' :type String
      :value (TypedVar 'c' :type Third(Int Bool String)))
    (TypedLetValue 'allPassed' :type Bool
      :value (TypedInfix '/\\' :type Bool
        :left (TypedInfix 'is' :type Bool
          :left (TypedVar 'tInt' :type Int)
          :right (TypedInt 3 :type Int))
        :right (TypedInfix '/\\' :type Bool
          :left (TypedApp :type Bool
            :func (TypedSelect 'equal' :type Fun(s1: String s2: String): Bool
              :target (TypedVar 'string' :type Module 'string'))
            :args (
              (TypedVar 'fString' :type String)
              (TypedString 'three' :type String)
            ))
          :right (TypedApp :type Bool
            :func (TypedSelect 'equal' :type Fun(s1: String s2: String): Bool
              :target (TypedVar 'string' :type Module 'string'))
            :args (
              (TypedVar 'cString' :type String)
              (TypedString 'third' :type String)
            )))))
  ))
