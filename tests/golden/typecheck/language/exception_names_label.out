(TypedProgram
  :phrases (
    (TypedLetValue 'pick' :type Fun(c: Bool): Exception
      :value (TypedFun :params (('c' : Bool)) :type Fun(c: Bool): Exception
        :body (TypedIf :type Exception
          :cond (TypedVar 'c' :type Bool)
          :then (TypedException 'I' :type Exception)
          :else (TypedException 'J' :type Exception))))
    (TypedLetValue 'f' :type Fun(c: Bool): Int
      :value (TypedFun :params (('c' : Bool)) :type Fun(c: Bool): Int
        :body (TypedBlock :type Int
          :bindings (
            (TypedLetValue 'e' :type Exception
              :value (TypedApp :type Exception
                :func (TypedVar 'pick' :type Fun(c: Bool): Exception)
                :args (
                  (TypedVar 'c' :type Bool)
                )))
          )
          :result (TypedTry :type Int
            :body (TypedRaise :type Int
              :exc (TypedVar 'e' :type Exception))
            :branches (
              (TypedTryBranch
                :exc_pattern (TypedVar 'e' :type Exception)
                :body (TypedInt 1 :type Int))
            )))))
    (TypedLetValue 'first' :type Exception
      :value (TypedApp :type Exception
        :func (TypedVar 'pick' :type Fun(c: Bool): Exception)
        :args (
          (TypedBool false)
        )))
    (TypedLetValue 'second' :type Exception
      :value (TypedApp :type Exception
        :func (TypedVar 'pick' :type Fun(c: Bool): Exception)
        :args (
          (TypedBool false)
        )))
    (TypedLetValue 'distinct' :type Bool
      :value (TypedApp :type Bool
        :func (TypedVar 'not' :type Fun(b: Bool): Bool)
        :args (
          (TypedInfix 'is' :type Bool
            :left (TypedVar 'first' :type Exception)
            :right (TypedVar 'second' :type Exception))
        )))
    (TypedLetValue 'caught' :type String
      :value (TypedTry :type String
        :body (TypedRaise :type String
          :exc (TypedVar 'second' :type Exception))
        :branches (
          (TypedTryBranch
            :exc_pattern (TypedVar 'first' :type Exception)
            :body (TypedString 'first' :type String))
          (TypedTryBranch
            :exc_pattern (TypedVar 'second' :type Exception)
            :body (TypedString 'second' :type String))
        )))
    (TypedExprStmt
      :expr (TypedException 'K' :type Exception(Int)))
    (TypedLetValue 'k' :type Int
      :value (TypedTry :type Int
        :body (TypedRaise :type Int
          :exc (TypedVar 'K' :type Exception(Int))
          :payload (TypedInt 4 :type Int))
        :branches (
          (TypedTryBranch
            :exc_pattern (TypedVar 'K' :type Exception(Int))
            :body (TypedInfix '+' :type Int
              :left (TypedVar 'n' :type Int)
              :right (TypedInt 1 :type Int)))
        )))
    (TypedExprStmt
      :expr (TypedTuple :type Tuple fTrue: Int fFalse: Int distinct: Bool caught: String k: Int end
        :elements (
          (TypedApp :type Int
            :func (TypedVar 'f' :type Fun(c: Bool): Int)
            :args (
              (TypedBool true)
            ))
          (TypedApp :type Int
            :func (TypedVar 'f' :type Fun(c: Bool): Int)
            :args (
              (TypedBool false)
            ))
          (TypedVar 'distinct' :type Bool)
          (TypedVar 'caught' :type String)
          (TypedVar 'k' :type Int)
        )))
  ))
