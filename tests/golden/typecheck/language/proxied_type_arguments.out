          :func (TypedVar 'writeN' :type All(A <: TS) Fun(p: A v: Int): Ok))
        :args (
          (TypedVar 'ts' :type TS)
          (TypedInt 8 :type Int)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'show' :type Fun(s: String): Ok)
        :args (
          (TypedApp :type String
            :func (TypedSelect 'int' :type Fun(n: Int): String
              :target (TypedVar 'conv' :type Module 'conv'))
            :args (
              (TypedSelect 'n' :type Int
                :target (TypedVar 'tb' :type TB))
            ))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedTypeApp [TS] :type Fun(p: TS): Ok
          :func (TypedVar 'addrN' :type All(A <: TS) Fun(p: A): Ok))
        :args (
          (TypedVar 'ts' :type TS)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'show' :type Fun(s: String): Ok)
        :args (
          (TypedApp :type String
            :func (TypedSelect 'int' :type Fun(n: Int): String
              :target (TypedVar 'conv' :type Module 'conv'))
            :args (
              (TypedSelect 'n' :type Int
                :target (TypedVar 'tb' :type TB))
            ))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'show' :type Fun(s: String): Ok)
        :args (
          (TypedApp :type String
            :func (TypedSelect 'int' :type Fun(n: Int): String
              :target (TypedVar 'conv' :type Module 'conv'))
            :args (
