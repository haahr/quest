    (TypedLetValue 'readN' :type All(A <: TS) Fun(p: A): Int
      :value (TypedIndex :type All(A <: TS) Fun(p: A): Int
        :target (TypedArray :type Array(All(A <: TS) Fun(p: A): Int)
          :elements (
            (TypedVar 'readN0' :type All(A <: TS) Fun(p: A): Int)
          ))
        :index (TypedInt 0 :type Int)))
    (TypedLetValue 'writeN0' :type All(A <: TS) Fun(p: A v: Int): Ok
      :value (TypedFun :params (('p' : A) ('v' : Int)) :type All(A <: TS) Fun(p: A v: Int): Ok
        :body (TypedAssign
          :target (TypedSelect 'n' :type Int
            :target (TypedVar 'p' :type A))
          :value (TypedVar 'v' :type Int))))
    (TypedLetValue 'writeN' :type All(A <: TS) Fun(p: A v: Int): Ok
      :value (TypedIndex :type All(A <: TS) Fun(p: A v: Int): Ok
        :target (TypedArray :type Array(All(A <: TS) Fun(p: A v: Int): Ok)
          :elements (
            (TypedVar 'writeN0' :type All(A <: TS) Fun(p: A v: Int): Ok)
          ))
        :index (TypedInt 0 :type Int)))
    (TypedLetValue 'bumpAt' :type Fun(var n: Int): Ok
      :value (TypedFun :params (('n' : Int)) :type Fun(var n: Int): Ok
        :body (TypedAssign
          :target (TypedVar 'n' :type Var(Int))
          :value (TypedInfix '+' :type Int
            :left (TypedDerefCell :type Int
              :target (TypedVar 'n' :type Var(Int)))
            :right (TypedInt 1 :type Int)))))
    (TypedLetValue 'addrN0' :type All(A <: TS) Fun(p: A): Ok
      :value (TypedFun :params (('p' : A)) :type All(A <: TS) Fun(p: A): Ok
        :body (TypedApp :type Ok
          :func (TypedVar 'bumpAt' :type Fun(var n: Int): Ok)
          :args (
            (TypedTupleSelectRef .n (ref) :type Var(Int)
              :target (TypedVar 'p' :type A))
          ))))
    (TypedLetValue 'addrN' :type All(A <: TS) Fun(p: A): Ok
      :value (TypedIndex :type All(A <: TS) Fun(p: A): Ok
        :target (TypedArray :type Array(All(A <: TS) Fun(p: A): Ok)
          :elements (
            (TypedVar 'addrN0' :type All(A <: TS) Fun(p: A): Ok)
          ))
        :index (TypedInt 0 :type Int)))
    (TypedLetValue 'readA0' :type All(A <: TS) Fun(p: A): Int
      :value (TypedFun :params (('p' : A)) :type All(A <: TS) Fun(p: A): Int
        :body (TypedSelect 'a' :type Int
          :target (TypedSelect 'x' :type Small
            :target (TypedVar 'p' :type A)))))
    (TypedLetValue 'readA' :type All(A <: TS) Fun(p: A): Int
      :value (TypedIndex :type All(A <: TS) Fun(p: A): Int
        :target (TypedArray :type Array(All(A <: TS) Fun(p: A): Int)
          :elements (
            (TypedVar 'readA0' :type All(A <: TS) Fun(p: A): Int)
          ))
        :index (TypedInt 0 :type Int)))
    (TypedLetValue 'tb' :type TB
      :value (TypedTuple :type Tuple x: Big var n: Int end
        :elements (
          (TypedRecord :type Record a: Int b: Int end
            :fields (
              (TypedRecordField 'a'
                :value (TypedInt 1 :type Int))
              (TypedRecordField 'b'
                :value (TypedInt 2 :type Int))
            ))
          (TypedInt 7 :type Int)
        )))
    (TypedLetValue 'ts' :type TS
      :value (TypedVar 'tb' :type TB))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'show' :type Fun(s: String): Ok)
        :args (
          (TypedApp :type String
            :func (TypedSelect 'int' :type Fun(n: Int): String
              :target (TypedVar 'conv' :type Module 'conv'))
            :args (
              (TypedApp :type Int
                :func (TypedTypeApp [TS] :type Fun(p: TS): Int
                  :func (TypedVar 'readN' :type All(A <: TS) Fun(p: A): Int))
                :args (
                  (TypedVar 'ts' :type TS)
                ))
            ))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
