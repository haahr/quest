                  :func (TypedVar 'readA' :type All(A <: TS) Fun(p: A): Int))
                :args (
                  (TypedVar 'ts' :type TS)
                ))
            ))
        )))
    (TypedLetType 'OS' :kind TYPE)
    (TypedLetType 'OB' :kind TYPE)
    (TypedLetValue 'caseN0' :type All(A <: OS) Fun(o: A): Int
      :value (TypedFun :params (('o' : A)) :type All(A <: OS) Fun(o: A): Int
        :body (TypedCase :type Int
          :target (TypedVar 'o' :type A)
          :branches (
            (TypedCaseBranch tags=(s) :binder 't'
              :body (TypedSelect 'n' :type Int
                :target (TypedVar 't' :type TS)))
            (TypedCaseBranch tags=(none)
              :body (TypedInt 0 :type Int))
          ))))
    (TypedLetValue 'caseN' :type All(A <: OS) Fun(o: A): Int
      :value (TypedIndex :type All(A <: OS) Fun(o: A): Int
        :target (TypedArray :type Array(All(A <: OS) Fun(o: A): Int)
          :elements (
            (TypedVar 'caseN0' :type All(A <: OS) Fun(o: A): Int)
          ))
        :index (TypedInt 0 :type Int)))
    (TypedLetValue 'ob' :type OB
      :value (TypedVariant 's' :type OB
        :payload (TypedVar 'tb' :type TB)))
    (TypedLetValue 'os' :type OS
      :value (TypedVar 'ob' :type OB))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'show' :type Fun(s: String): Ok)
        :args (
          (TypedApp :type String
            :func (TypedSelect 'int' :type Fun(n: Int): String
              :target (TypedVar 'conv' :type Module 'conv'))
            :args (
              (TypedApp :type Int
                :func (TypedTypeApp [OS] :type Fun(o: OS): Int
                  :func (TypedVar 'caseN' :type All(A <: OS) Fun(o: A): Int))
                :args (
                  (TypedVar 'os' :type OS)
                ))
            ))
        )))
  ))
