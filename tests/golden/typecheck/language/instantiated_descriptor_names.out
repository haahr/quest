(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('dynamic') : 'Dynamic')
      ))
    (TypedLetValue 'f' :type All(A :: TYPE) Fun(x: A): Dynamic
      :value (TypedFun :params (('x' : A)) :type All(A :: TYPE) Fun(x: A): Dynamic
        :body (TypedApp :type T
          :func (TypedTypeApp [Tuple v: A w: Int end] :type Fun(a: Tuple v: A w: Int end): T
            :func (TypedSelect 'new' :type All(A :: TYPE) Fun(a: A): T
              :target (TypedVar 'dynamic' :type Module 'dynamic')))
          :args (
            (TypedTuple :type Tuple v: A w: Int end
              :elements (
                (TypedVar 'x' :type A)
                (TypedInt 1 :type Int)
              ))
          ))))
    (TypedLetValue 'g' :type All(A :: TYPE) Fun(x: A): Dynamic
      :value (TypedVar 'f' :type All(A :: TYPE) Fun(x: A): Dynamic))
    (TypedLetValue 'h' :type All(A :: TYPE B :: TYPE) Fun(x: A y: B): Dynamic
      :value (TypedFun :params (('x' : A) ('y' : B)) :type All(A :: TYPE B :: TYPE) Fun(x: A y: B): Dynamic
        :body (TypedApp :type T
          :func (TypedTypeApp [Tuple a: A b: Tuple c: B d: A end end] :type Fun(a: Tuple a: A b: Tuple c: B d: A end end): T
            :func (TypedSelect 'new' :type All(A :: TYPE) Fun(a: A): T
              :target (TypedVar 'dynamic' :type Module 'dynamic')))
          :args (
            (TypedTuple :type Tuple a: A b: Tuple c: B d: A end end
              :elements (
                (TypedVar 'x' :type A)
                (TypedTuple :type Tuple c: B d: A end
                  :elements (
                    (TypedVar 'y' :type B)
                    (TypedVar 'x' :type A)
                  ))
              ))
          ))))
    (TypedExprStmt
      :expr (TypedTuple :type Tuple Dynamic Dynamic Dynamic end
        :elements (
          (TypedApp :type Dynamic
            :func (TypedTypeApp [String] :type Fun(x: String): Dynamic
              :func (TypedVar 'g' :type All(A :: TYPE) Fun(x: A): Dynamic))
            :args (
              (TypedString 'hi' :type String)
            ))
          (TypedApp :type Dynamic
            :func (TypedTypeApp [Int Bool] :type Fun(x: Int y: Bool): Dynamic
              :func (TypedVar 'h' :type All(A :: TYPE B :: TYPE) Fun(x: A y: B): Dynamic))
            :args (
              (TypedInt 3 :type Int)
              (TypedBool true)
            ))
          (TypedApp :type Dynamic
            :func (TypedTypeApp [Tuple p: Char end] :type Fun(x: Tuple p: Char end): Dynamic
              :func (TypedVar 'f' :type All(A :: TYPE) Fun(x: A): Dynamic))
            :args (
              (TypedTuple :type Tuple p: Char end
                :elements (
                  (TypedChar 'c' :type Char)
                ))
            ))
        )))
  ))
