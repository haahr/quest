(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedLetValue 'real' :type Real
      :value (TypedReal 2.5 :type Real))
    (TypedLetValue 'sum' :type Real
      :value (TypedInfix '++' :type Real
        :left (TypedVar 'real' :type Real)
        :right (TypedReal 1.0 :type Real)))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putString' :type Fun(writer: Writer.T string: String): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedSelect 'output' :type Writer.T
            :target (TypedVar 'writer' :type Module 'writer'))
          (TypedApp :type String
            :func (TypedSelect 'real' :type Fun(r: Real): String
              :target (TypedVar 'conv' :type Module 'conv'))
            :args (
              (TypedVar 'sum' :type Real)
            ))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putString' :type Fun(writer: Writer.T string: String): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedSelect 'output' :type Writer.T
            :target (TypedVar 'writer' :type Module 'writer'))
          (TypedString '\n' :type String)
        )))
  ))
