(TypedProgram
  :phrases (
    (TypedImport
      :items (
        (TypedImportItem ('writer') : 'Writer')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('conv') : 'Conv')
      ))
    (TypedImport
      :items (
        (TypedImportItem ('dynamic') : 'Dynamic')
      ))
    (TypedLetValue 'p' :type Fun(n: Int): Ok
      :value (TypedFun :params (('n' : Int)) :type Fun(n: Int): Ok
        :body (TypedApp :type Ok
          :func (TypedSelect 'putString' :type Fun(writer: Writer.T string: String): Ok
            :target (TypedVar 'writer' :type Module 'writer'))
          :args (
            (TypedSelect 'output' :type Writer.T
              :target (TypedVar 'writer' :type Module 'writer'))
            (TypedInfix '<>' :type String
              :left (TypedApp :type String
                :func (TypedSelect 'int' :type Fun(n: Int): String
                  :target (TypedVar 'conv' :type Module 'conv'))
                :args (
                  (TypedVar 'n' :type Int)
                ))
              :right (TypedString '\n' :type String))
          ))))
    (TypedLetType 'Huge' :kind TYPE)
    (TypedLetType 'Big' :kind TYPE)
    (TypedLetType 'Mid' :kind TYPE)
    (TypedLetType 'Small' :kind TYPE)
    (TypedLetValue 'huge' :type Huge
      :value (TypedRecord :type Record a: Int b: Int c: Int d: Int end
        :fields (
          (TypedRecordField 'a'
            :value (TypedInt 1 :type Int))
          (TypedRecordField 'b'
            :value (TypedInt 2 :type Int))
          (TypedRecordField 'c'
            :value (TypedInt 3 :type Int))
          (TypedRecordField 'd'
            :value (TypedInt 4 :type Int))
        )))
    (TypedLetValue 'big' :type Big
      :value (TypedVar 'huge' :type Huge))
    (TypedLetValue 'mid' :type Mid
      :value (TypedVar 'big' :type Big))
    (TypedLetValue 'small' :type Small
      :value (TypedVar 'mid' :type Mid))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'p' :type Fun(n: Int): Ok)
        :args (
          (TypedSelect 'c' :type Int
            :target (TypedVar 'mid' :type Mid))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'p' :type Fun(n: Int): Ok)
        :args (
          (TypedSelect 'd' :type Int
            :target (TypedVar 'small' :type Small))
        )))
    (TypedLetValue 'sumMid' :type Fun(m: Mid): Int
      :value (TypedFun :params (('m' : Mid)) :type Fun(m: Mid): Int
        :body (TypedInfix '+' :type Int
          :left (TypedSelect 'c' :type Int
            :target (TypedVar 'm' :type Mid))
          :right (TypedSelect 'd' :type Int
            :target (TypedVar 'm' :type Mid)))))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'p' :type Fun(n: Int): Ok)
        :args (
          (TypedApp :type Int
            :func (TypedVar 'sumMid' :type Fun(m: Mid): Int)
            :args (
              (TypedVar 'big' :type Big)
            ))
        )))
    (TypedLetValue 'd' :type Dynamic.T
      :value (TypedApp :type Dynamic.T
        :func (TypedTypeApp [Mid] :type Fun(a: Mid): Dynamic.T
          :func (TypedSelect 'new' :type All(A :: TYPE) Fun(a: A): Dynamic.T
            :target (TypedVar 'dynamic' :type Module 'dynamic')))
        :args (
          (TypedVar 'mid' :type Mid)
        )))
    (TypedLetValue 'viaDynamic' :type Small
      :value (TypedApp :type Small
        :func (TypedTypeApp [Small] :type Fun(d: Dynamic.T): Small
          :func (TypedSelect 'be' :type All(A :: TYPE) Fun(d: Dynamic.T): A
            :target (TypedVar 'dynamic' :type Module 'dynamic')))
        :args (
          (TypedVar 'd' :type Dynamic.T)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'p' :type Fun(n: Int): Ok)
        :args (
          (TypedSelect 'd' :type Int
            :target (TypedVar 'viaDynamic' :type Small))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'p' :type Fun(n: Int): Ok)
        :args (
          (TypedInspect :type Int
            :target (TypedVar 'd' :type Dynamic.T)
            :branches (
              (TypedInspectBranch match=Small
                :body (TypedSelect 'd' :type Int
                  :target (TypedVar 's' :type Small)))
            )
            :else (TypedInt 0 :type Int))
        )))
    (TypedLetType 'AnyMid' :kind TYPE)
    (TypedLetValue 'anyMid' :type AnyMid
      :value (TypedAuto :Big :type AnyMid
        :payload (TypedTuple :type Tuple a: Big end
          :elements (
            (TypedVar 'big' :type Big)
          ))))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'p' :type Fun(n: Int): Ok)
        :args (
          (TypedInspect :type Int
            :target (TypedVar 'anyMid' :type AnyMid)
            :branches (
              (TypedInspectBranch match=Mid
                :body (TypedInfix '*' :type Int
                  :left (TypedSelect 'c' :type Int
                    :target (TypedSelect 'a' :type Mid
                      :target (TypedVar 'x' :type Tuple a: Mid end)))
                  :right (TypedInfix '+' :type Int
                    :left (TypedInt 10 :type Int)
                    :right (TypedSelect 'd' :type Int
                      :target (TypedSelect 'a' :type Mid
                        :target (TypedVar 'x' :type Tuple a: Mid end))))))
            )
            :else (TypedInt 0 :type Int))
        )))
    (TypedLetValue 'bigTuple' :type Tuple r: Big n: Int end
      :value (TypedTuple :type Tuple r: Big n: Int end
        :elements (
          (TypedVar 'big' :type Big)
          (TypedInt 5 :type Int)
        )))
    (TypedLetValue 'midTuple' :type Tuple r: Mid n: Int end
      :value (TypedVar 'bigTuple' :type Tuple r: Big n: Int end))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'p' :type Fun(n: Int): Ok)
        :args (
          (TypedInfix '+' :type Int
            :left (TypedSelect 'c' :type Int
              :target (TypedSelect 'r' :type Mid
                :target (TypedVar 'midTuple' :type Tuple r: Mid n: Int end)))
            :right (TypedSelect 'n' :type Int
              :target (TypedVar 'midTuple' :type Tuple r: Mid n: Int end)))
        )))
    (TypedLetValue 'same' :type All(A <: Mid) Fun(x: A): A
      :value (TypedFun :params (('x' : A)) :type All(A <: Mid) Fun(x: A): A
        :body (TypedVar 'x' :type A)))
    (TypedLetValue 'bigAgain' :type Big
      :value (TypedApp :type Big
        :func (TypedTypeApp [Big] :type Fun(x: Big): Big
          :func (TypedVar 'same' :type All(A <: Mid) Fun(x: A): A))
        :args (
          (TypedVar 'big' :type Big)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedVar 'p' :type Fun(n: Int): Ok)
        :args (
          (TypedSelect 'b' :type Int
            :target (TypedVar 'bigAgain' :type Big))
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'extern' :type Fun(wr: Writer.T d: Dynamic.T): Ok
          :target (TypedVar 'dynamic' :type Module 'dynamic'))
        :args (
          (TypedSelect 'output' :type Writer.T
            :target (TypedVar 'writer' :type Module 'writer'))
          (TypedVar 'd' :type Dynamic.T)
        )))
    (TypedExprStmt
      :expr (TypedApp :type Ok
        :func (TypedSelect 'putString' :type Fun(writer: Writer.T string: String): Ok
          :target (TypedVar 'writer' :type Module 'writer'))
        :args (
          (TypedSelect 'output' :type Writer.T
            :target (TypedVar 'writer' :type Module 'writer'))
          (TypedString '\n' :type String)
        )))
  ))
