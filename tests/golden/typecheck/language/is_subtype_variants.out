(TypedProgram
  :phrases (
    (TypedLetType 'Sub' :kind TYPE)
    (TypedLetType 'Super' :kind TYPE)
    (TypedLetValue 'x' :type Sub
      :value (TypedVariant 'z' :type Sub
        :payload (TypedInt 1 :type Int)))
    (TypedLetValue 'y' :type Super
      :value (TypedVariant 'z' :type Super
        :payload (TypedInt 1 :type Int)))
    (TypedLetValue 'z' :type Super
      :value (TypedVariant 'a' :type Super
        :payload (TypedInt 1 :type Int)))
    (TypedExprStmt
      :expr (TypedTuple :type Tuple xy: Bool xz: Bool yx: Bool zx: Bool end
        :elements (
          (TypedInfix 'is' :type Bool
            :left (TypedDerefCell :type Sub
              :target (TypedVar 'x' :type Var(Sub)))
            :right (TypedDerefCell :type Super
              :target (TypedVar 'y' :type Var(Super))))
          (TypedInfix 'is' :type Bool
            :left (TypedDerefCell :type Sub
              :target (TypedVar 'x' :type Var(Sub)))
            :right (TypedDerefCell :type Super
              :target (TypedVar 'z' :type Var(Super))))
          (TypedInfix 'is' :type Bool
            :left (TypedDerefCell :type Super
              :target (TypedVar 'y' :type Var(Super)))
            :right (TypedDerefCell :type Sub
              :target (TypedVar 'x' :type Var(Sub))))
          (TypedInfix 'isnot' :type Bool
            :left (TypedDerefCell :type Super
              :target (TypedVar 'z' :type Var(Super)))
            :right (TypedDerefCell :type Sub
              :target (TypedVar 'x' :type Var(Sub))))
        )))
    (TypedLetType 'Few' :kind TYPE)
    (TypedLetType 'Many' :kind TYPE)
    (TypedLetValue 'f' :type Few
      :value (TypedOption 'q' :type Few))
    (TypedLetValue 'm' :type Many
      :value (TypedOption 'q' :type Many))
    (TypedLetValue 'n' :type Many
      :value (TypedOption 'p' :type Many))
    (TypedExprStmt
      :expr (TypedTuple :type Tuple fm: Bool fn: Bool mf: Bool nf: Bool end
        :elements (
          (TypedInfix 'is' :type Bool
            :left (TypedDerefCell :type Few
              :target (TypedVar 'f' :type Var(Few)))
            :right (TypedDerefCell :type Many
              :target (TypedVar 'm' :type Var(Many))))
          (TypedInfix 'is' :type Bool
            :left (TypedDerefCell :type Few
              :target (TypedVar 'f' :type Var(Few)))
            :right (TypedDerefCell :type Many
              :target (TypedVar 'n' :type Var(Many))))
          (TypedInfix 'is' :type Bool
            :left (TypedDerefCell :type Many
              :target (TypedVar 'm' :type Var(Many)))
            :right (TypedDerefCell :type Few
              :target (TypedVar 'f' :type Var(Few))))
          (TypedInfix 'isnot' :type Bool
            :left (TypedDerefCell :type Many
              :target (TypedVar 'n' :type Var(Many)))
            :right (TypedDerefCell :type Few
              :target (TypedVar 'f' :type Var(Few))))
        )))
    (TypedLetType 'OneSome' :kind TYPE)
    (TypedLetType 'TwoSome' :kind TYPE)
    (TypedLetValue 's1' :type OneSome
      :value (TypedOption 'q' :type OneSome
        :payload (TypedTuple :type Tuple n: Int end
          :elements (
            (TypedInt 3 :type Int)
          ))))
    (TypedLetValue 's2' :type TwoSome
      :value (TypedOption 'q' :type TwoSome
        :payload (TypedTuple :type Tuple n: Int end
          :elements (
            (TypedInt 3 :type Int)
          ))))
    (TypedLetValue 's3' :type TwoSome
      :value (TypedOption 'p' :type TwoSome))
    (TypedExprStmt
      :expr (TypedTuple :type Tuple s2s1: Bool s3s1: Bool s1s2: Bool end
        :elements (
          (TypedInfix 'is' :type Bool
            :left (TypedDerefCell :type TwoSome
              :target (TypedVar 's2' :type Var(TwoSome)))
            :right (TypedDerefCell :type OneSome
              :target (TypedVar 's1' :type Var(OneSome))))
          (TypedInfix 'is' :type Bool
            :left (TypedDerefCell :type TwoSome
              :target (TypedVar 's3' :type Var(TwoSome)))
            :right (TypedDerefCell :type OneSome
              :target (TypedVar 's1' :type Var(OneSome))))
          (TypedInfix 'is' :type Bool
            :left (TypedDerefCell :type OneSome
              :target (TypedVar 's1' :type Var(OneSome)))
            :right (TypedDerefCell :type TwoSome
              :target (TypedVar 's2' :type Var(TwoSome))))
        )))
  ))
