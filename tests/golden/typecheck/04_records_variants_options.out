      :value (TypedRecord :type Record x: Int y: Int end
        :fields (
          (TypedRecordField 'x'
            :value (TypedInt 10 :type Int))
          (TypedRecordField 'y'
            :value (TypedInt 20 :type Int))
        )))
    (TypedLetValue 'px' :type Int
      :value (TypedSelect 'x' :type Int
        :target (TypedVar 'p' :type Record x: Int y: Int end)))
    (TypedLetValue 'arr1' :type Array(Int)
      :value (TypedArray :type Array(Int)
        :elements (
          (TypedInt 1 :type Int)
          (TypedInt 2 :type Int)
          (TypedInt 3 :type Int)
          (TypedInt 4 :type Int)
          (TypedInt 5 :type Int)
        )))
    (TypedLetValue 'arr2' :type Array(Int)
