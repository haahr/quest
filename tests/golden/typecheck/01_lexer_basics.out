(TypedProgram
  :phrases (
    (TypedLetType 'T' :kind TYPE)
    (TypedLetValue 'origin' :type T
      :value (TypedTuple :type Tuple x: Int y: Real end
        :elements (
          (TypedInt 0 :type Int)
          (TypedReal 0.0 :type Real)
        )))
    (TypedLetValue 'add' :type Fun(p1: T p2: T): T
      :value (TypedFun :params (('p1' : T) ('p2' : T)) :type Fun(p1: T p2: T): T
        :body (TypedTuple :type Tuple x: Int y: Real end
          :elements (
            (TypedInfix '+' :type Int
              :left (TypedSelect 'x' :type Int
                :target (TypedVar 'p1' :type T))
              :right (TypedSelect 'x' :type Int
                :target (TypedVar 'p2' :type T)))
            (TypedInfix '++' :type Real
              :left (TypedSelect 'y' :type Real
                :target (TypedVar 'p1' :type T))
              :right (TypedSelect 'y' :type Real
                :target (TypedVar 'p2' :type T)))
          ))))
  ))
