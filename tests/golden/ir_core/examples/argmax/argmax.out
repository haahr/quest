import arrayOp = "arrayOp" : ArrayOp
import string = "string" : StringOp
import scoring = "scoring" : Scoring
main {
  let empty: Exception = exception empty @8:1
  funs {
    fun argmax [E::TYPE K::TYPE](a: Array(E), key: Fun(e: E): K, isGreater: Fun(x: K y: K): Bool): Tuple index: Int element: E end {
      let n: Int = prim extent(a) @15:17
      let %1: Bool = prim is(n, 0) @16:12
      if %1 { @16:9
        raise empty @16:24
      }
      var best: Int = 0 @17:9
      let %2: E = index(a, 0) @18:31
      let %3: K = call key(%2) @18:27
      var bestKey: K = %3 @18:9
      let %4: Int = prim -(n, 1) @19:24
      var i: Int = 1 @19:9
      let %5: Bool = prim <=(i, %4) @19:9
      if %5 { @19:9
        loop L1 {
          let i.1: Int = i @19:9
          let %6: E = index(a, i.1) @20:25
          let k: K = call key(%6) @20:21
          let %7: Bool = call isGreater(k, bestKey) @21:16
          if %7 { @21:13
            best := i.1 @22:17
            bestKey := k @23:17
          }
          let %8: Bool = prim is(i, %4) @19:9
          if %8 { @19:9
            break L1 @19:9
          }
          let %9: Int = prim +(i, 1) @19:9
          i := %9 @19:9
        }
      }
      let index: Int = best @26:27
      let element: E = index(a, best) @26:46
      let %10: Tuple index: Int element: E end = tuple(index, element) @26:9
      return %10
    }
  }
  let words: Array(String) = array("pear", "fig", "banana", "kiwi") @30:13
  let %11: Fun(string: String): Int = member string.length @31:28
  let %12: Fun(a: Int b: Int): Bool = builtin > @31:43
  let longest: Tuple index: Int element: String end = call argmax [String Int](words, %11, %12) @31:15
  let name: String = "Ada" @35:22
  let years: Int = 12 @35:40
  let rating: Real = 4.5 @35:56
  let %13: Tuple name: String years: Int rating: Real end = tuple(name, years, rating) @35:5
  let name.1: String = "Grace" @36:22
  let years.1: Int = 30 @36:42
  let rating.1: Real = 4.9 @36:58
  let %14: Tuple name: String years: Int rating: Real end = tuple(name.1, years.1, rating.1) @36:5
  let candidates: Array(Tuple name: String years: Int rating: Real end) = array(%13, %14) @34:18
  let %15: Fun(c: Candidate): Real = member scoring.score @38:30
  let %16: Fun(a: Real b: Real): Bool = builtin >> @38:45
  let best.1: Tuple index: Int element: Tuple name: String years: Int rating: Real end end = call argmax [Tuple name: String years: Int rating: Real end Real](candidates, %15, %16) @38:12
}

