import arrayOp = "arrayOp" : ArrayOp
import string = "string" : StringOp
main {
  let empty: Exception = exception empty @7:1
  funs {
    fun argmax [E::TYPE K::TYPE](a: Array(E), key: Fun(e: E): K, isGreater: Fun(x: K y: K): Bool): E {
      let n: Int = prim extent(a) @14:17
      let %1: Bool = prim is(n, 0) @15:12
      if %1 { @15:9
        raise empty @15:24
      }
      var best: Int = 0 @16:9
      let %2: E = index(a, 0) @17:31
      let %3: K = call key(%2) @17:27
      var bestKey: K = %3 @17:9
      let %4: Int = prim -(n, 1) @18:24
      var i: Int = 1 @18:9
      let %5: Bool = prim <=(i, %4) @18:9
      if %5 { @18:9
        loop L1 {
          let i.1: Int = i @18:9
          let %6: E = index(a, i.1) @19:25
          let k: K = call key(%6) @19:21
          let %7: Bool = call isGreater(k, bestKey) @20:16
          if %7 { @20:13
            best := i.1 @21:17
            bestKey := k @22:17
          }
          let %8: Bool = prim is(i, %4) @18:9
          if %8 { @18:9
            break L1 @18:9
          }
          let %9: Int = prim +(i, 1) @18:9
          i := %9 @18:9
        }
      }
      let %10: E = index(a, best) @25:9
      return %10
    }
  }
  let words: Array(String) = array("pear", "fig", "banana", "kiwi") @28:13
  let %11: Fun(string: String): Int = member string.length @29:28
  let %12: Fun(a: Int b: Int): Bool = builtin > @29:43
  let longest: String = call argmax [String Int](words, %11, %12) @29:15
}

