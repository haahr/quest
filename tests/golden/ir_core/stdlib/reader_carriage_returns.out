import writer = "writer" : Writer
import reader = "reader" : Reader
import ascii = "ascii" : Ascii
import conv = "conv" : Conv
main {
  let w: writer.T = call writer.file("carriage_returns.txt") @8:9
  do call writer.putString(w, "a\r\nb\rc\n") @9:1
  do call writer.close(w) @10:1
  let r: reader.T = call reader.file("carriage_returns.txt") @12:9
  loop L1 {
    let %1: Bool = call reader.more(r) @13:7
    if %1 { @13:1
      let %2: writer.T = member writer.output @14:22
      let %3: Char = call reader.getChar(r) @14:55
      let %4: Int = call ascii.val(%3) @14:45
      let %5: String = call conv.int(%4) @14:36
      let %6: String = prim <>(%5, " ") @14:36
      do call writer.putString(%2, %6) @14:5
    } else {
      break L1 @13:1
    }
  }
  do call reader.close(r) @16:1
  let %7: writer.T = member writer.output @17:18
  do call writer.putString(%7, "\n") @17:1
}

