import strutil = "util/strutil" : util/Strutil
import maybe = "util/maybe" : util/Maybe
import vector = "collections/vector" : collections/Vector
import word = "word" : Word
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output
  funs {
    fun printInt(n: Int): Ok {
      let %1: String = call external "quest_conv_int"(n)
      do call writer.putString(wOut, %1)
      let %2: Ok = call writer.putString(wOut, " ")
      return %2
    }
  }
  funs {
    fun printBool(b: Bool): Ok {
      let %3: String = call conv.bool(b)
      do call writer.putString(wOut, %3)
      let %4: Ok = call writer.putString(wOut, " ")
      return %4
    }
  }
  funs {
    fun printString(s: String): Ok {
      do call writer.putString(wOut, s)
      let %5: Ok = call writer.putString(wOut, " ")
      return %5
    }
  }
  funs {
    fun printNewline(dummy: Int): Ok {
      let %6: Ok = call writer.putString(wOut, "\n")
      return %6
    }
  }
  let sp: vector.T(String) = call strutil.split("apple,banana,cherry", ",")
  let %7: Int = call vector.length [String](sp)
  do call printInt(%7)
  let %8: String = call vector.get [String](sp, 0)
  do call printString(%8)
  let %9: String = call vector.get [String](sp, 1)
  do call printString(%9)
  let %10: String = call vector.get [String](sp, 2)
  do call printString(%10)
  do call printNewline(0)
  let spChars: vector.T(String) = call strutil.split("abc", "")
  let %11: Int = call vector.length [String](spChars)
  do call printInt(%11)
  let %12: String = call vector.get [String](spChars, 0)
  do call printString(%12)
  let %13: String = call vector.get [String](spChars, 1)
  do call printString(%13)
  let %14: String = call vector.get [String](spChars, 2)
  do call printString(%14)
  do call printNewline(0)
  let spEmpty: vector.T(String) = call strutil.split("", ",")
  let %15: Int = call vector.length [String](spEmpty)
  do call printInt(%15)
  let %16: String = call vector.get [String](spEmpty, 0)
  do call printString(%16)
  do call printNewline(0)
  let lines: vector.T(String) = call strutil.splitlines("line1\nline2\r\nline3\rline4\n")
  let %17: Int = call vector.length [String](lines)
  do call printInt(%17)
  let %18: String = call vector.get [String](lines, 0)
  do call printString(%18)
  let %19: String = call vector.get [String](lines, 1)
  do call printString(%19)
  let %20: String = call vector.get [String](lines, 2)
  do call printString(%20)
  let %21: String = call vector.get [String](lines, 3)
  do call printString(%21)
  do call printNewline(0)
  let linesEmpty: vector.T(String) = call strutil.splitlines("")
  let %22: Int = call vector.length [String](linesEmpty)
  do call printInt(%22)
  do call printNewline(0)
  let %23: String = call strutil.join(" - ", sp)
  do call printString(%23)
  do call printNewline(0)
  let arr: Array(String) = array("one", "two", "three")
  let %24: String = call strutil.joinArray("/", arr)
  do call printString(%24)
  do call printNewline(0)
  let %25: Bool = call strutil.startsWith("hello world", "hello")
  do call printBool(%25)
  let %26: Bool = call strutil.startsWith("hello world", "world")
  do call printBool(%26)
  do call printNewline(0)
  let %27: Bool = call strutil.endsWith("hello world", "world")
  do call printBool(%27)
  let %28: Bool = call strutil.endsWith("hello world", "hello")
  do call printBool(%28)
  do call printNewline(0)
  let %29: Int = call strutil.find("banana", "an")
  do call printInt(%29)
  let %30: Int = call strutil.findFrom("banana", "an", 2)
  do call printInt(%30)
  let %31: Int = call strutil.findFrom("banana", "an", 4)
  do call printInt(%31)
  let %32: Int = call strutil.rfind("banana", "an")
  do call printInt(%32)
  let %33: Bool = call strutil.contains("banana", "nan")
  do call printBool(%33)
  let %34: Bool = call strutil.contains("banana", "xyz")
  do call printBool(%34)
  do call printNewline(0)
  let %35: String = call strutil.strip("  \t\n hello world \r\n ")
  do call printString(%35)
  let %36: String = call strutil.stripLeading("   left   ")
  do call printString(%36)
  let %37: String = call strutil.stripTrailing("   right   ")
  do call printString(%37)
  do call printNewline(0)
  let %38: String = call strutil.replace("a-b-c", "-", ":")
  do call printString(%38)
  let %39: String = call strutil.escapeC("hello\n\"world\"\t\\")
  do call printString(%39)
  let %40: String = call strutil.unescapeC("hello\\n\\\"world\\\"\\t\\\\")
  do call printString(%40)
  do call printNewline(0)
  let %41: Bool = call strutil.isDigit('5')
  do call printBool(%41)
  let %42: Bool = call strutil.isDigit('a')
  do call printBool(%42)
  let %43: Bool = call strutil.isAlpha('x')
  do call printBool(%43)
  let %44: Bool = call strutil.isAlpha('9')
  do call printBool(%44)
  let %45: Bool = call strutil.isAlnum('Z')
  do call printBool(%45)
  let %46: Bool = call strutil.isAlnum('3')
  do call printBool(%46)
  let %47: Bool = call strutil.isAlnum('!')
  do call printBool(%47)
  let %48: Bool = call strutil.isSpace(' ')
  do call printBool(%48)
  let %49: Bool = call strutil.isSpace('\t')
  do call printBool(%49)
  let %50: Bool = call strutil.isSpace('a')
  do call printBool(%50)
  do call printNewline(0)
  let w42: word.T = call external "quest_word_from_int"(42)
  let %51: String = call strutil.formatWord(w42, 10)
  do call printString(%51)
  let %52: String = call strutil.formatWord(w42, 16)
  do call printString(%52)
  let %53: String = call strutil.formatWord(w42, 2)
  do call printString(%53)
  let %54: String = call strutil.wordToString(w42)
  do call printString(%54)
  let parsedW: word.T = call strutil.toWord("42")
  let %55: Bool = prim is(parsedW, w42)
  do call printBool(%55)
  let parsedHexW: word.T = call strutil.toWordBase("2a", 16)
  let %56: Bool = prim is(parsedHexW, w42)
  do call printBool(%56)
  do call printNewline(0)
  let %57: Int = call strutil.toInt("12345")
  do call printInt(%57)
  let %58: Int = call strutil.toInt("~678")
  do call printInt(%58)
  let %59: Int = call strutil.toInt("-678")
  do call printInt(%59)
  let %60: Int = call strutil.toInt("+99")
  do call printInt(%60)
  let %61: Int = call strutil.toIntBase("ff", 16)
  do call printInt(%61)
  let %62: Int = call strutil.toIntBase("1010", 2)
  do call printInt(%62)
  do call printNewline(0)
  let maybeInt1: maybe.T(Int) = call strutil.tryToInt("456")
  let maybeInt2: maybe.T(Int) = call strutil.tryToInt("not_an_int")
  let %63: Bool = call maybe.isSome [Int](maybeInt1)
  do call printBool(%63)
  let %64: Int = call maybe.unwrap [Int](maybeInt1)
  do call printInt(%64)
  let %65: Bool = call maybe.isNone [Int](maybeInt2)
  do call printBool(%65)
  let %66: Int = call maybe.unwrapOr [Int](maybeInt2, 9999)
  do call printInt(%66)
  do call printNewline(0)
  let maybeW1: maybe.T(word.T) = call strutil.tryToWord("100")
  let maybeW2: maybe.T(word.T) = call strutil.tryToWord("bad_word")
  let %67: Bool = call maybe.isSome [word.T](maybeW1)
  do call printBool(%67)
  let %68: Bool = call maybe.isNone [word.T](maybeW2)
  do call printBool(%68)
  do call printNewline(0)
  let maybeR1: maybe.T(Real) = call strutil.tryToReal("3.14")
  let maybeR2: maybe.T(Real) = call strutil.tryToReal("-2.5e2")
  let maybeR3: maybe.T(Real) = call strutil.tryToReal("invalid_real")
  let %69: Bool = call maybe.isSome [Real](maybeR1)
  do call printBool(%69)
  let %70: Bool = call maybe.isSome [Real](maybeR2)
  do call printBool(%70)
  let %71: Bool = call maybe.isNone [Real](maybeR3)
  do call printBool(%71)
  do call printNewline(0)
  let %72: Bool = call strutil.toBool("true")
  do call printBool(%72)
  let %73: Bool = call strutil.toBool("false")
  do call printBool(%73)
  let maybeB1: maybe.T(Bool) = call strutil.tryToBool("true")
  let maybeB2: maybe.T(Bool) = call strutil.tryToBool("false")
  let maybeB3: maybe.T(Bool) = call strutil.tryToBool("maybe")
  let %74: Bool = call maybe.isSome [Bool](maybeB1)
  do call printBool(%74)
  let %75: Bool = call maybe.unwrap [Bool](maybeB1)
  do call printBool(%75)
  let %76: Bool = call maybe.isSome [Bool](maybeB2)
  do call printBool(%76)
  let %77: Bool = call maybe.unwrap [Bool](maybeB2)
  do call printBool(%77)
  let %78: Bool = call maybe.isNone [Bool](maybeB3)
  do call printBool(%78)
  do call printNewline(0)
  let %79: Exception = member strutil.error
  try catching (%79) {
    let bad: Int = call strutil.toInt("invalid")
    do call printInt(bad)
  } handle (e: Exception) {
    let %80: Bool = prim is(e, %79)
    if %80 {
      do call printString("caught_int_error")
    } else {
      reraise e
    }
  }
  do call printNewline(0)
  let %81: Exception = member strutil.error
  try catching (%81) {
    let badW: word.T = call strutil.toWord("not_a_word")
    do call printString("should_not_reach")
  } handle (e.1: Exception) {
    let %82: Bool = prim is(e.1, %81)
    if %82 {
      do call printString("caught_word_error")
    } else {
      reraise e.1
    }
  }
  do call printNewline(0)
  let %83: Exception = member strutil.error
  try catching (%83) {
    let badR: Real = call strutil.toReal("not_a_real")
    do call printString("should_not_reach")
  } handle (e.2: Exception) {
    let %84: Bool = prim is(e.2, %83)
    if %84 {
      do call printString("caught_real_error")
    } else {
      reraise e.2
    }
  }
  do call printNewline(0)
  let %85: Exception = member strutil.error
  try catching (%85) {
    let badB: Bool = call strutil.toBool("not_a_bool")
    do call printString("should_not_reach")
  } handle (e.3: Exception) {
    let %86: Bool = prim is(e.3, %85)
    if %86 {
      do call printString("caught_bool_error")
    } else {
      reraise e.3
    }
  }
  do call printNewline(0)
  funs {
    fun realOf(s.1: String): String {
      let %87: maybe.T(Real) = call strutil.tryToReal(s.1)
      let %88: Real = call maybe.unwrapOr [Real](%87, 0.5)
      let %89: String = call external "quest_conv_real"(%88)
      return %89
    }
  }
  let %90: String = call realOf("~3.5e~2")
  do call printString(%90)
  let %91: String = call realOf("0.1")
  do call printString(%91)
  let %92: String = call realOf("1.0e40")
  do call printString(%92)
  let %93: String = call realOf("~0.0")
  do call printString(%93)
  let %94: String = call realOf("4.9e~324")
  do call printString(%94)
  let %95: String = call realOf("1e400")
  do call printString(%95)
  let %96: String = call realOf("5.")
  do call printString(%96)
  let %97: String = call realOf(".5")
  do call printString(%97)
  let %98: maybe.T(Real) = call strutil.tryToReal(".")
  let %99: Bool = call maybe.isNone [Real](%98)
  do call printBool(%99)
  let %100: maybe.T(Real) = call strutil.tryToReal("1e")
  let %101: Bool = call maybe.isNone [Real](%100)
  do call printBool(%101)
  do call printNewline(0)
  let %102: Int = call strutil.toInt("9223372036854775807")
  do call printInt(%102)
  let %103: Int = call strutil.toInt("~9223372036854775808")
  do call printInt(%103)
  let %104: maybe.T(Int) = call strutil.tryToInt("9223372036854775808")
  let %105: Bool = call maybe.isNone [Int](%104)
  do call printBool(%105)
  let %106: maybe.T(Int) = call strutil.tryToInt("~9223372036854775809")
  let %107: Bool = call maybe.isNone [Int](%106)
  do call printBool(%107)
  let %108: maybe.T(Int) = call strutil.tryToInt("99999999999999999999")
  let %109: Bool = call maybe.isNone [Int](%108)
  do call printBool(%109)
  let %110: Int = call strutil.toIntBase("7fffffffffffffff", 16)
  do call printInt(%110)
  let %111: maybe.T(Int) = call strutil.tryToIntBase("8000000000000000", 16)
  let %112: Bool = call maybe.isNone [Int](%111)
  do call printBool(%112)
  do call printNewline(0)
}

