import display = "io/display" : io/Display
import writer = "writer" : Writer
main {
  let %1: writer.T = member writer.output @8:18
  do call writer.putString(%1, "before\n") @8:1
  let %2: Bool = call display.inKernel() @9:1
  do call display.html("<b>bold</b>") @10:1
  do call display.markdown("# A heading") @11:1
  do call display.svg("<svg/>") @12:1
  do call display.png("\u0089PNG") @13:1
  let mimeType: String = "application/json" @14:46
  let data: String = "{}" @14:76
  let %3: Tuple mimeType: String data: String end = tuple(mimeType, data) @14:25
  let %4: Array(Item) = array(%3) @14:16
  do call display.bundle(%4) @14:1
  let mimeType.1: String = "text/plain" @15:46
  let data.1: String = "plain" @15:70
  let %5: Tuple mimeType: String data: String end = tuple(mimeType.1, data.1) @15:25
  let %6: Array(Item) = array(%5) @15:16
  do call display.bundle(%6) @15:1
  let %7: writer.T = member writer.output @16:18
  do call writer.putString(%7, "after\n") @16:1
}

