import writer = "writer" : Writer
import display = "io/display" : io/Display
main {
  let %1: writer.T = member writer.output @9:18
  do call writer.putString(%1, "before\n") @9:1
  let %2: Bool = call display.inKernel() @10:1
  do call display.html("<b>bold</b>") @11:1
  do call display.markdown("# A heading") @12:1
  do call display.svg("<svg/>") @13:1
  do call display.png("\u0089PNG") @14:1
  let mimeType: String = "application/json" @15:46
  let data: String = "{}" @15:76
  let %3: Tuple mimeType: String data: String end = tuple(mimeType, data) @15:25
  let %4: Array(Item) = array(%3) @15:16
  do call display.bundle(%4) @15:1
  let mimeType.1: String = "text/plain" @16:46
  let data.1: String = "plain" @16:70
  let %5: Tuple mimeType: String data: String end = tuple(mimeType.1, data.1) @16:25
  let %6: Array(Item) = array(%5) @16:16
  do call display.bundle(%6) @16:1
  let %7: writer.T = member writer.output @17:18
  do call writer.putString(%7, "after\n") @17:1
}

