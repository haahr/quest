import dynamic = "dynamic" : Dynamic
import writer = "writer" : Writer
import reader = "reader" : Reader
import conv = "conv" : Conv
import int = "int" : IntOp
import ascii = "ascii" : Ascii
import string = "string" : StringOp
import arrayOp = "arrayOp" : ArrayOp
import real = "real" : RealOp
import list = "list" : List
main {
  let %1: String = call conv.int(42) @11:1
  let %2: Int = call int.abs(-100) @12:1
  let %3: Char = call ascii.char(65) @13:1
  let %4: String = call string.new(3, 'x') @14:1
  let %5: Array(Int) = array_rep(2, 7) @15:1
  let %6: Int = call real.floor(3.7) @16:1
  let rIn: reader.T = member reader.input @17:11
  let d: T = call dynamic.new [Int](42) @20:9
  let %7: Int = call dynamic.be [Int](d) @21:1
  let dInferred: T = call dynamic.new [String]("hello") @22:17
  let %8: String = call dynamic.be [String](dInferred) @23:1
  join k1(r: Bool) {
    let w: writer.T = call writer.file("int.json") @27:9
    let %9: T = call dynamic.new [Int](12345) @28:18
    do call dynamic.extern(w, %9) @28:1
    do call writer.close(w) @29:1
    let r.1: reader.T = call reader.file("int.json") @30:9
    let dIn: T = call dynamic.intern(r.1) @31:11
    do call reader.close(r.1) @32:1
    let %10: Int = call dynamic.be [Int](dIn) @33:1
    let %11: T = call dynamic.new [Ok](ok) @43:20
    let node: Record name: String var next: T end = record(name = "cycle", var next = %11) @41:16
    let %12: T = call dynamic.new [Node](node) @45:18
    store node.next := %12 @45:5
    let cw: writer.T = call writer.file("cycle.json") @46:14
    let %13: T = call dynamic.new [Node](node) @47:23
    do call dynamic.extern(cw, %13) @47:5
    do call writer.close(cw) @48:5
    let cr: reader.T = call reader.file("cycle.json") @49:14
    let %14: T = call dynamic.intern(cr) @50:36
    let n: Node = call dynamic.be [Node](%14) @50:19
    do call reader.close(cr) @51:5
    let %15: Dynamic.T = record_field(n, next) @52:40
    let nNext: Node = call dynamic.be [Node](%15) @52:23
    let %16: String = record_field(nNext, name) @53:5
    let l0: list.T(Int) = type_app list.nil [Int] @57:10
    let %17: Bool = call list.null [Int](l0) @58:1
    let %18: Int = call list.length [Int](l0) @59:1
    let l1: list.T(Int) = call list.cons [Int](10, l0) @60:10
    let %19: Bool = call list.null [Int](l1) @61:1
    let %20: Int = call list.head [Int](l1) @62:1
    let %21: Int = call list.length [Int](l1) @63:1
    let l2: list.T(Int) = call list.cons [Int](20, l1) @64:10
    let %22: Int = call list.head [Int](l2) @65:1
    let %23: list.T(Int) = call list.tail [Int](l2) @66:16
    let %24: Int = call list.head [Int](%23) @66:1
    let %25: Int = call list.length [Int](l2) @67:1
    let %26: Array(Int) = array(1, 2, 3) @68:23
    let lEnum: list.T(Int) = call list.enum [Int](%26) @68:13
    let %27: Int = call list.length [Int](lEnum) @69:1
    let %28: Int = call list.head [Int](lEnum) @70:1
    join k2(r.2: Int) {
      join k3(r.3: Int) {
        let s1: String = "abcdef" @80:10
        let s2: String = "bcxyz" @81:10
        let s3: String = "abxyz" @82:10
        let %29: Bool = call string.precedesSub(s1, 1, 3, s2, 0, 3) @83:1
        let %30: Bool = call string.precedesSub(s1, 1, 3, s3, 0, 3) @84:1
        let %31: Bool = call string.precedesSub(s1, 1, 3, s1, 1, 3) @85:1
        join k4(r.4: Bool) {
        } in {
          let %32: Exception = member string.error @86:46
          try catching (%32) {
            let %33: Bool = call string.precedesSub(s1, 0, 100, s2, 0, 3) @86:5
            jump k4(%33) @86:1
          } handle (e: Exception) {
            let %34: Bool = prim is(e, %32) @86:1
            if %34 { @86:1
              jump k4(false) @86:1
            } else {
              reraise e @86:1
            }
          }
        }
      } in {
        let %35: Exception = member list.error @75:6
        try catching (%35) {
          let ignored: list.T(Int) = call list.tail [Int](l0) @73:19
          jump k3(0) @72:1
        } handle (e.1: Exception) {
          let %36: Bool = prim is(e.1, %35) @72:1
          if %36 { @72:1
            jump k3(-2) @72:1
          } else {
            reraise e.1 @72:1
          }
        }
      }
    } in {
      let %37: Exception = member list.error @71:29
      try catching (%37) {
        let %38: Int = call list.head [Int](l0) @71:5
        jump k2(%38) @71:1
      } handle (e.2: Exception) {
        let %39: Bool = prim is(e.2, %37) @71:1
        if %39 { @71:1
          jump k2(-1) @71:1
        } else {
          reraise e.2 @71:1
        }
      }
    }
  } in {
    let %40: Exception = member dynamic.error @24:30
    try catching (%40) {
      let %41: Bool = call dynamic.be [Bool](d) @24:5
      jump k1(%41) @24:1
    } handle (e.3: Exception) {
      let %42: Bool = prim is(e.3, %40) @24:1
      if %42 { @24:1
        jump k1(false) @24:1
      } else {
        reraise e.3 @24:1
      }
    }
  }
}

