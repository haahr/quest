import dynamic = "dynamic" : Dynamic
import reader = "reader" : Reader
import writer = "writer" : Writer
import conv = "conv" : Conv
import arrayOp = "arrayOp" : ArrayOp
main {
  let p: Record x: Int y: Int end = record(x = 10, y = 20) @14:9
  let dPt: T = call dynamic.new [Point](p) @15:11
  let %1: writer.T = member writer.output @16:16
  do call dynamic.extern(%1, dPt) @16:1
  let %2: writer.T = member writer.output @17:18
  do call writer.putString(%2, "\n") @17:1
  let %3: Status = variant(error, 404) @21:30
  let s1: T = call dynamic.new [Status](%3) @21:10
  let %4: Status = variant(success, ok) @22:30
  let s2: T = call dynamic.new [Status](%4) @22:10
  let %5: writer.T = member writer.output @23:16
  do call dynamic.extern(%5, s1) @23:1
  let %6: writer.T = member writer.output @24:18
  do call writer.putString(%6, "\n") @24:1
  let %7: writer.T = member writer.output @25:16
  do call dynamic.extern(%7, s2) @25:1
  let %8: writer.T = member writer.output @26:18
  do call writer.putString(%8, "\n") @26:1
  let %9: T = call dynamic.new [Ok](ok) @30:35
  let n1: Record id: Int var next: T end = record(id = 1, var next = %9) @30:10
  let %10: T = call dynamic.new [Node](n1) @31:35
  let n2: Record id: Int var next: T end = record(id = 2, var next = %10) @31:10
  let %11: T = call dynamic.new [Node](n2) @32:12
  store n1.next := %11 @32:1
  let dNode: T = call dynamic.new [Node](n1) @33:13
  let %12: writer.T = member writer.output @34:16
  do call dynamic.extern(%12, dNode) @34:1
  let %13: writer.T = member writer.output @35:18
  do call writer.putString(%13, "\n") @35:1
  let %14: reader.T = member reader.input @39:26
  let dIn: T = call dynamic.intern(%14) @39:11
  let rIn: InRec = call dynamic.be [InRec](dIn) @40:11
  let %15: writer.T = member writer.output @41:18
  let %16: Int = record_field(rIn, a) @41:41
  let %17: String = call conv.int(%16) @41:32
  do call writer.putString(%15, %17) @41:1
  let %18: writer.T = member writer.output @42:18
  do call writer.putString(%18, " ") @42:1
  let %19: writer.T = member writer.output @43:18
  let %20: String = record_field(rIn, b) @43:32
  do call writer.putString(%19, %20) @43:1
  let %21: writer.T = member writer.output @44:18
  do call writer.putString(%21, " ") @44:1
  let %22: writer.T = member writer.output @45:18
  let %23: Array(Int) = record_field(rIn, c) @45:58
  let %24: Int = index(%23, 0) @45:41
  let %25: String = call conv.int(%24) @45:32
  do call writer.putString(%22, %25) @45:1
  let %26: writer.T = member writer.output @46:18
  do call writer.putString(%26, " ") @46:1
  let %27: writer.T = member writer.output @47:18
  let %28: Array(Int) = record_field(rIn, c) @47:58
  let %29: Int = index(%28, 1) @47:41
  let %30: String = call conv.int(%29) @47:32
  do call writer.putString(%27, %30) @47:1
  let %31: writer.T = member writer.output @48:18
  do call writer.putString(%31, " ") @48:1
  let %32: writer.T = member writer.output @49:18
  let %33: Array(Int) = record_field(rIn, c) @49:58
  let %34: Int = index(%33, 2) @49:41
  let %35: String = call conv.int(%34) @49:32
  do call writer.putString(%32, %35) @49:1
  let %36: writer.T = member writer.output @50:18
  do call writer.putString(%36, "\n") @50:1
}

