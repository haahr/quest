import dynamic = "dynamic" : Dynamic
import reader = "reader" : Reader
import writer = "writer" : Writer
import conv = "conv" : Conv
import arrayOp = "arrayOp" : ArrayOp
main {
  let p: Record x: Int y: Int end = record(x = 10, y = 20)
  let dPt: T = call dynamic.new [Point](p)
  let %1: writer.T = member writer.output
  do call dynamic.extern(%1, dPt)
  let %2: writer.T = member writer.output
  do call writer.putString(%2, "\n")
  let %3: Status = variant(error, 404)
  let s1: T = call dynamic.new [Status](%3)
  let %4: Status = variant(success, ok)
  let s2: T = call dynamic.new [Status](%4)
  let %5: writer.T = member writer.output
  do call dynamic.extern(%5, s1)
  let %6: writer.T = member writer.output
  do call writer.putString(%6, "\n")
  let %7: writer.T = member writer.output
  do call dynamic.extern(%7, s2)
  let %8: writer.T = member writer.output
  do call writer.putString(%8, "\n")
  let %9: T = call dynamic.new [Ok](ok)
  let n1: Record id: Int var next: T end = record(id = 1, var next = %9)
  let %10: T = call dynamic.new [Node](n1)
  let n2: Record id: Int var next: T end = record(id = 2, var next = %10)
  let %11: T = call dynamic.new [Node](n2)
  store n1.next := %11
  let dNode: T = call dynamic.new [Node](n1)
  let %12: writer.T = member writer.output
  do call dynamic.extern(%12, dNode)
  let %13: writer.T = member writer.output
  do call writer.putString(%13, "\n")
  let %14: reader.T = member reader.input
  let dIn: T = call dynamic.intern(%14)
  let rIn: InRec = call dynamic.be [InRec](dIn)
  let %15: writer.T = member writer.output
  let %16: Int = record_field(rIn, a)
  let %17: String = call conv.int(%16)
  do call writer.putString(%15, %17)
  let %18: writer.T = member writer.output
  do call writer.putString(%18, " ")
  let %19: writer.T = member writer.output
  let %20: String = record_field(rIn, b)
  do call writer.putString(%19, %20)
  let %21: writer.T = member writer.output
  do call writer.putString(%21, " ")
  let %22: writer.T = member writer.output
  let %23: Array(Int) = record_field(rIn, c)
  let %24: Int = call arrayOp.get [Int](%23, 0)
  let %25: String = call conv.int(%24)
  do call writer.putString(%22, %25)
  let %26: writer.T = member writer.output
  do call writer.putString(%26, " ")
  let %27: writer.T = member writer.output
  let %28: Array(Int) = record_field(rIn, c)
  let %29: Int = call arrayOp.get [Int](%28, 1)
  let %30: String = call conv.int(%29)
  do call writer.putString(%27, %30)
  let %31: writer.T = member writer.output
  do call writer.putString(%31, " ")
  let %32: writer.T = member writer.output
  let %33: Array(Int) = record_field(rIn, c)
  let %34: Int = call arrayOp.get [Int](%33, 2)
  let %35: String = call conv.int(%34)
  do call writer.putString(%32, %35)
  let %36: writer.T = member writer.output
  do call writer.putString(%36, "\n")
}

