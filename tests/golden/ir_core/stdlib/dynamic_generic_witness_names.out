import dynamic = "dynamic" : Dynamic
main {
  funs {
    fun f [A::TYPE](x: A): Dynamic {
      let v: A = x @5:73
      let w: Int = 1 @5:75
      let %1: Tuple v: A w: Int end = tuple(v, w) @5:67
      let %2: T = call dynamic.new [Tuple v: A w: Int end](%1) @5:32
      return %2
    }
  }
  let g: All(A :: TYPE) Fun(x: A): Dynamic = f @6:36
  funs {
    fun pair [A::TYPE B::TYPE](a: A, b: B): Dynamic {
      let first: A = a @8:11
      let second: Record r: B end = record(r = b) @8:13
      let x.1: A = a @8:36
      let y: B = b @8:38
      let both: Tuple x: A y: B end = tuple(x.1, y) @8:30
      let %3: Tuple first: A second: Record r: B end both: Tuple x: A y: B end end = tuple(first, second, both) @8:5
      let %4: T = call dynamic.new [Tuple first: A second: Record r: B end both: Tuple x: A y: B end end](%3) @7:48
      return %4
    }
  }
  let h: All(A :: TYPE B :: TYPE) Fun(a: A b: B): Dynamic = pair @9:49
  let %5: Dynamic = call g [String]("hi") @10:1
  let %6: Record r: Bool end = record(r = true) @11:30
  let %7: Dynamic = call h [Int Record r: Bool end](3, %6) @11:1
  let %8: Array(Int) = array(1) @12:31
  let %9: Tuple Int end = tuple(2) @12:46
  let %10: Dynamic = call h [Array(Int) Tuple Int end](%8, %9) @12:1
}

