import dynamic = "dynamic" : Dynamic
main {
  funs {
    fun f [A::TYPE](x: A): Dynamic {
      let v: A = x
      let w: Int = 1
      let %1: Tuple v: A w: Int end = tuple(v, w)
      let %2: T = call dynamic.new [Tuple v: A w: Int end](%1)
      return %2
    }
  }
  let g: All(A :: TYPE) Fun(x: A): Dynamic = f
  funs {
    fun pair [A::TYPE B::TYPE](a: A, b: B): Dynamic {
      let first: A = a
      let second: Record r: B end = record(r = b)
      let x.1: A = a
      let y: B = b
      let both: Tuple x: A y: B end = tuple(x.1, y)
      let %3: Tuple first: A second: Record r: B end both: Tuple x: A y: B end end = tuple(first, second, both)
      let %4: T = call dynamic.new [Tuple first: A second: Record r: B end both: Tuple x: A y: B end end](%3)
      return %4
    }
  }
  let h: All(A :: TYPE B :: TYPE) Fun(a: A b: B): Dynamic = pair
  let %5: Dynamic = call g [String]("hi")
  let %6: Record r: Bool end = record(r = true)
  let %7: Dynamic = call h [Int Record r: Bool end](3, %6)
  let %8: Array(Int) = array(1)
  let %9: Tuple Int end = tuple(2)
  let %10: Dynamic = call h [Array(Int) Tuple Int end](%8, %9)
}

