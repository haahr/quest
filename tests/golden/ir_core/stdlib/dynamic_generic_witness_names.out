import dynamic = "dynamic" : Dynamic
main {
  funs {
    fun f [A::TYPE](x: A): Dynamic {
      let v: A = x @5:73
      let w: Int = 1 @5:75
      let %1: Tuple v: A w: Int end = tuple(v, w) @5:67
      let %2: T = call dynamic.new [Tuple v: A w: Int end](%1) @5:32
      return %2
    }
  }
  let g: All(A :: TYPE) Fun(x: A): Dynamic = f @6:36
  funs {
    fun pair [A::TYPE B::TYPE](a: A, b: B): Dynamic {
      let first: A = a @9:19
      let second: Record r: B end = record(r = b) @9:21
      let x.1: A = a @9:44
      let y: B = b @9:46
      let both: Tuple x: A y: B end = tuple(x.1, y) @9:38
      let %3: Tuple first: A second: Record r: B end both: Tuple x: A y: B end end = tuple(first, second, both) @9:13
      let %4: T = call dynamic.new [Tuple first: A second: Record r: B end both: Tuple x: A y: B end end](%3) @8:5
      return %4
    }
  }
  let h: All(A :: TYPE B :: TYPE) Fun(a: A b: B): Dynamic = pair @10:49
  let %5: Dynamic = call g [String]("hi") @11:1
  let %6: Record r: Bool end = record(r = true) @12:30
  let %7: Dynamic = call h [Int Record r: Bool end](3, %6) @12:1
  let %8: Array(Int) = array(1) @13:31
  let %9: Tuple Int end = tuple(2) @13:46
  let %10: Dynamic = call h [Array(Int) Tuple Int end](%8, %9) @13:1
}

