import real = "real" : RealOp
import conv = "conv" : Conv
import writer = "writer" : Writer
main {
  funs {
    fun show(label: String, s: String): Ok {
      let %1: writer.T = member writer.output @10:58
      let %2: String = prim <>(s, "\n") @10:88
      let %3: String = prim <>(" ", %2) @10:81
      let %4: String = prim <>(label, %3) @10:72
      let %5: Ok = call writer.putString(%1, %4) @10:41
      return %5
    }
  }
  funs {
    fun g(r: Real): String {
      let %6: String = call real.format(r, 'g', 12) @11:26
      return %6
    }
  }
  let %7: Real = member real.pi @13:13
  let %8: String = call g(%7) @13:11
  do call show("pi", %8) @13:1
  let %9: Real = member real.infinity @14:27
  let %10: String = call conv.real(%9) @14:17
  do call show("infinity", %10) @14:1
  let %11: Real = member real.infinity @15:43
  let %12: Real = prim --(0.0, %11) @15:36
  let %13: String = call conv.real(%12) @15:26
  do call show("negative infinity", %13) @15:1
  let %14: Real = call real.sqrt(2.25) @16:23
  let %15: String = call conv.real(%14) @16:13
  do call show("sqrt", %15) @16:1
  let %16: Real = call real.sin(1.0) @17:14
  let %17: String = call g(%16) @17:12
  do call show("sin", %17) @17:1
  let %18: Real = call real.cos(1.0) @18:14
  let %19: String = call g(%18) @18:12
  do call show("cos", %19) @18:1
  let %20: Real = call real.tan(1.0) @19:14
  let %21: String = call g(%20) @19:12
  do call show("tan", %21) @19:1
  let %22: Real = call real.asin(0.5) @20:15
  let %23: String = call g(%22) @20:13
  do call show("asin", %23) @20:1
  let %24: Real = call real.acos(0.5) @21:15
  let %25: String = call g(%24) @21:13
  do call show("acos", %25) @21:1
  let %26: Real = call real.atan(1.0) @22:15
  let %27: String = call g(%26) @22:13
  do call show("atan", %27) @22:1
  let %28: Real = call real.atan2(1.0, -1.0) @23:16
  let %29: String = call g(%28) @23:14
  do call show("atan2", %29) @23:1
  let %30: Real = call real.exponential(1.0) @24:22
  let %31: String = call g(%30) @24:20
  do call show("exponential", %31) @24:1
  let %32: Real = call real.exponential(1000.0) @25:39
  let %33: String = call conv.real(%32) @25:29
  do call show("exponential overflow", %33) @25:1
  let %34: Real = call real.sinh(1.0) @26:15
  let %35: String = call g(%34) @26:13
  do call show("sinh", %35) @26:1
  let %36: Real = call real.cosh(1.0) @27:15
  let %37: String = call g(%36) @27:13
  do call show("cosh", %37) @27:1
  let %38: Real = call real.tanh(1.0) @28:15
  let %39: String = call g(%38) @28:13
  do call show("tanh", %39) @28:1
  let %40: Real = call real.sinh(-1000.0) @29:32
  let %41: String = call conv.real(%40) @29:22
  do call show("sinh overflow", %41) @29:1
  let %42: Int = call real.ceil(2.1) @30:22
  let %43: String = call conv.int(%42) @30:13
  let %44: Int = call real.ceil(-2.1) @30:57
  let %45: String = call conv.int(%44) @30:48
  let %46: String = prim <>(" ", %45) @30:41
  let %47: String = prim <>(%43, %46) @30:13
  do call show("ceil", %47) @30:1
  let %48: Int = call real.trunc(2.9) @31:23
  let %49: String = call conv.int(%48) @31:14
  let %50: Int = call real.trunc(-2.9) @31:59
  let %51: String = call conv.int(%50) @31:50
  let %52: String = prim <>(" ", %51) @31:43
  let %53: String = prim <>(%49, %52) @31:14
  do call show("trunc", %53) @31:1
  let %54: String = call real.format(3.14159, 'f', 2) @32:17
  do call show("format f", %54) @32:1
  let %55: String = call real.format(-0.000123456, 'e', 3) @33:17
  do call show("format e", %55) @33:1
  let %56: String = call real.format(1234567.0, 'g', 4) @34:17
  do call show("format g", %56) @34:1
  let %57: String = call real.format(0.5, 'g', 12) @35:23
  do call show("format g fixed", %57) @35:1
  let %58: Real = member real.infinity @36:38
  let %59: String = call real.format(%58, 'g', 6) @36:26
  let %60: Real = member real.infinity @36:88
  let %61: Real = prim --(0.0, %60) @36:81
  let %62: String = call real.format(%61, 'f', 2) @36:69
  let %63: String = prim <>(" ", %62) @36:62
  let %64: String = prim <>(%59, %63) @36:26
  do call show("format infinities", %64) @36:1
  funs {
    fun raises(label.1: String, f: Fun(): Ok): Ok {
      let %65: Exception = member real.error @39:51
      try catching (%65) {
        do call f() @39:15
        do call show(label.1, "returned") @39:19
      } handle (e: Exception) {
        let %66: Bool = prim is(e, %65) @39:5
        if %66 { @39:5
          do call show(label.1, "raises real.error") @39:67
        } else {
          reraise e @39:5
        }
      }
      return ok
    }
  }
  funs {
    fun f.1(): Ok {
      let %67: Real = call real.sqrt(-1.0) @41:37
      return ok
    }
  }
  do call raises("sqrt(~1.0)", f.1) @41:1
  funs {
    fun f.2(): Ok {
      let %68: Real = call real.asin(2.0) @42:36
      return ok
    }
  }
  do call raises("asin(2.0)", f.2) @42:1
  funs {
    fun f.3(): Ok {
      let %69: Real = member real.infinity @43:49
      let %70: Real = call real.sin(%69) @43:40
      return ok
    }
  }
  do call raises("sin(infinity)", f.3) @43:1
  funs {
    fun f.4(): Ok {
      let %71: Real = member real.infinity @44:51
      let %72: Int = call real.ceil(%71) @44:41
      return ok
    }
  }
  do call raises("ceil(infinity)", f.4) @44:1
  funs {
    fun f.5(): Ok {
      let %73: Int = call real.trunc(1e+30) @45:40
      return ok
    }
  }
  do call raises("trunc(1.0e30)", f.5) @45:1
  funs {
    fun f.6(): Ok {
      let %74: String = call real.format(1.0, 'x', 2) @46:44
      return ok
    }
  }
  do call raises("format(1.0 'x' 2)", f.6) @46:1
  funs {
    fun f.7(): Ok {
      let %75: String = call real.format(1.0, 'f', 101) @47:46
      return ok
    }
  }
  do call raises("format(1.0 'f' 101)", f.7) @47:1
}

