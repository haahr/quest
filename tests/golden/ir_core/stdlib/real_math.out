import real = "real" : RealOp
import conv = "conv" : Conv
import writer = "writer" : Writer
main {
  funs {
    fun show(label: String, s: String): Ok {
      let %1: writer.T = member writer.output
      let %2: String = prim <>(s, "\n")
      let %3: String = prim <>(" ", %2)
      let %4: String = prim <>(label, %3)
      let %5: Ok = call writer.putString(%1, %4)
      return %5
    }
  }
  funs {
    fun g(r: Real): String {
      let %6: String = call external "quest_real_format"(r, 'g', 12)
      return %6
    }
  }
  let %7: Real = member real.pi
  let %8: String = call g(%7)
  do call show("pi", %8)
  let %9: Real = member real.infinity
  let %10: String = call external "quest_conv_real"(%9)
  do call show("infinity", %10)
  let %11: Real = member real.infinity
  let %12: Real = prim --(0.0, %11)
  let %13: String = call external "quest_conv_real"(%12)
  do call show("negative infinity", %13)
  let %14: Real = call external "quest_real_sqrt"(2.25)
  let %15: String = call external "quest_conv_real"(%14)
  do call show("sqrt", %15)
  let %16: Real = call external "quest_real_sin"(1.0)
  let %17: String = call g(%16)
  do call show("sin", %17)
  let %18: Real = call external "quest_real_cos"(1.0)
  let %19: String = call g(%18)
  do call show("cos", %19)
  let %20: Real = call external "quest_real_tan"(1.0)
  let %21: String = call g(%20)
  do call show("tan", %21)
  let %22: Real = call external "quest_real_asin"(0.5)
  let %23: String = call g(%22)
  do call show("asin", %23)
  let %24: Real = call external "quest_real_acos"(0.5)
  let %25: String = call g(%24)
  do call show("acos", %25)
  let %26: Real = call external "quest_real_atan"(1.0)
  let %27: String = call g(%26)
  do call show("atan", %27)
  let %28: Real = call external "quest_real_atan2"(1.0, -1.0)
  let %29: String = call g(%28)
  do call show("atan2", %29)
  let %30: Real = call external "quest_real_exponential"(1.0)
  let %31: String = call g(%30)
  do call show("exponential", %31)
  let %32: Real = call external "quest_real_exponential"(1000.0)
  let %33: String = call external "quest_conv_real"(%32)
  do call show("exponential overflow", %33)
  let %34: Real = call external "quest_real_sinh"(1.0)
  let %35: String = call g(%34)
  do call show("sinh", %35)
  let %36: Real = call external "quest_real_cosh"(1.0)
  let %37: String = call g(%36)
  do call show("cosh", %37)
  let %38: Real = call external "quest_real_tanh"(1.0)
  let %39: String = call g(%38)
  do call show("tanh", %39)
  let %40: Real = call external "quest_real_sinh"(-1000.0)
  let %41: String = call external "quest_conv_real"(%40)
  do call show("sinh overflow", %41)
  let %42: Int = call external "quest_real_ceil"(2.1)
  let %43: String = call external "quest_conv_int"(%42)
  let %44: Int = call external "quest_real_ceil"(-2.1)
  let %45: String = call external "quest_conv_int"(%44)
  let %46: String = prim <>(" ", %45)
  let %47: String = prim <>(%43, %46)
  do call show("ceil", %47)
  let %48: Int = call external "quest_real_trunc"(2.9)
  let %49: String = call external "quest_conv_int"(%48)
  let %50: Int = call external "quest_real_trunc"(-2.9)
  let %51: String = call external "quest_conv_int"(%50)
  let %52: String = prim <>(" ", %51)
  let %53: String = prim <>(%49, %52)
  do call show("trunc", %53)
  let %54: String = call external "quest_real_format"(3.14159, 'f', 2)
  do call show("format f", %54)
  let %55: String = call external "quest_real_format"(-0.000123456, 'e', 3)
  do call show("format e", %55)
  let %56: String = call external "quest_real_format"(1234567.0, 'g', 4)
  do call show("format g", %56)
  let %57: String = call external "quest_real_format"(0.5, 'g', 12)
  do call show("format g fixed", %57)
  let %58: Real = member real.infinity
  let %59: String = call external "quest_real_format"(%58, 'g', 6)
  let %60: Real = member real.infinity
  let %61: Real = prim --(0.0, %60)
  let %62: String = call external "quest_real_format"(%61, 'f', 2)
  let %63: String = prim <>(" ", %62)
  let %64: String = prim <>(%59, %63)
  do call show("format infinities", %64)
  funs {
    fun raises(label.1: String, f: Fun(): Ok): Ok {
      let %65: Exception = member real.error
      try catching (%65) {
        do call f()
        do call show(label.1, "returned")
      } handle (e: Exception) {
        let %66: Bool = prim is(e, %65)
        if %66 {
          do call show(label.1, "raises real.error")
        } else {
          reraise e
        }
      }
      return ok
    }
  }
  funs {
    fun f.1(): Ok {
      let %67: Real = call external "quest_real_sqrt"(-1.0)
      return ok
    }
  }
  do call raises("sqrt(~1.0)", f.1)
  funs {
    fun f.2(): Ok {
      let %68: Real = call external "quest_real_asin"(2.0)
      return ok
    }
  }
  do call raises("asin(2.0)", f.2)
  funs {
    fun f.3(): Ok {
      let %69: Real = member real.infinity
      let %70: Real = call external "quest_real_sin"(%69)
      return ok
    }
  }
  do call raises("sin(infinity)", f.3)
  funs {
    fun f.4(): Ok {
      let %71: Real = member real.infinity
      let %72: Int = call external "quest_real_ceil"(%71)
      return ok
    }
  }
  do call raises("ceil(infinity)", f.4)
  funs {
    fun f.5(): Ok {
      let %73: Int = call external "quest_real_trunc"(1e+30)
      return ok
    }
  }
  do call raises("trunc(1.0e30)", f.5)
  funs {
    fun f.6(): Ok {
      let %74: String = call external "quest_real_format"(1.0, 'x', 2)
      return ok
    }
  }
  do call raises("format(1.0 'x' 2)", f.6)
  funs {
    fun f.7(): Ok {
      let %75: String = call external "quest_real_format"(1.0, 'f', 101)
      return ok
    }
  }
  do call raises("format(1.0 'f' 101)", f.7)
}

