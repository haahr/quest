import conv = "conv" : Conv
import word = "word" : Word
import writer = "writer" : Writer
import hashSet = "collections/hashSet" : collections/HashSet
import vector = "collections/vector" : collections/Vector
main {
  let wOut: writer.T = member writer.output @10:12
  funs {
    fun printInt(n: Int): Ok {
      let %1: String = call conv.int(n) @14:31
      do call writer.putString(wOut, %1) @14:9
      let %2: Ok = call writer.putString(wOut, " ") @15:9
      return %2
    }
  }
  funs {
    fun printBool(b: Bool): Ok {
      let %3: String = call conv.bool(b) @20:31
      do call writer.putString(wOut, %3) @20:9
      let %4: Ok = call writer.putString(wOut, " ") @21:9
      return %4
    }
  }
  funs {
    fun printNewline(dummy: Int): Ok {
      let %5: Ok = call writer.putString(wOut, "\n") @24:36
      return %5
    }
  }
  funs {
    fun intEqual(a: Int, b.1: Int): Bool {
      let %6: Bool = prim is(a, b.1) @26:37
      return %6
    }
  }
  funs {
    fun intHash(a.1: Int): word.T {
      let %7: word.T = call word.fromInt(a.1) @27:40
      let %8: word.T = call word.fromInt(2654435761) @27:56
      let %9: word.T = call word.mul(%7, %8) @27:31
      return %9
    }
  }
  let s: hashSet.T(Int) = call hashSet.new [Int](intEqual, intHash) @30:9
  let %10: Bool = call hashSet.empty [Int](s) @31:11
  do call printBool(%10) @31:1
  let %11: Int = call hashSet.size [Int](s) @32:10
  do call printInt(%11) @32:1
  do call printNewline(0) @33:1
  let %12: Bool = call hashSet.insert [Int](s, 10) @36:11
  do call printBool(%12) @36:1
  let %13: Bool = call hashSet.insert [Int](s, 20) @37:11
  do call printBool(%13) @37:1
  let %14: Bool = call hashSet.insert [Int](s, 30) @38:11
  do call printBool(%14) @38:1
  let %15: Bool = call hashSet.insert [Int](s, 10) @39:11
  do call printBool(%15) @39:1
  let %16: Int = call hashSet.size [Int](s) @40:10
  do call printInt(%16) @40:1
  let %17: Bool = call hashSet.empty [Int](s) @41:11
  do call printBool(%17) @41:1
  do call printNewline(0) @42:1
  let %18: Bool = call hashSet.contains [Int](s, 10) @45:11
  do call printBool(%18) @45:1
  let %19: Bool = call hashSet.contains [Int](s, 20) @46:11
  do call printBool(%19) @46:1
  let %20: Bool = call hashSet.contains [Int](s, 25) @47:11
  do call printBool(%20) @47:1
  let %21: Bool = call hashSet.contains [Int](s, 30) @48:11
  do call printBool(%21) @48:1
  do call printNewline(0) @49:1
  let elems: vector.T(Int) = call hashSet.elements [Int](s) @52:13
  let %22: Int = call vector.length [Int](elems) @53:10
  do call printInt(%22) @53:1
  funs {
    fun f(elem: Int): Ok {
      let %23: Ok = call printInt(elem) @54:41
      return %23
    }
  }
  do call vector.forEach [Int](elems, f) @54:1
  do call printNewline(0) @55:1
  funs {
    fun f.1(elem.1: Int): Ok {
      let %24: Ok = call printInt(elem.1) @57:38
      return %24
    }
  }
  do call hashSet.forEach [Int](s, f.1) @57:1
  do call printNewline(0) @58:1
  let %25: Bool = call hashSet.delete [Int](s, 20) @61:11
  do call printBool(%25) @61:1
  let %26: Bool = call hashSet.delete [Int](s, 20) @62:11
  do call printBool(%26) @62:1
  let %27: Int = call hashSet.size [Int](s) @63:10
  do call printInt(%27) @63:1
  let %28: Bool = call hashSet.contains [Int](s, 20) @64:11
  do call printBool(%28) @64:1
  do call printNewline(0) @65:1
  funs {
    fun f.2(elem.2: Int): Ok {
      let %29: Ok = call printInt(elem.2) @68:38
      return %29
    }
  }
  do call hashSet.forEach [Int](s, f.2) @68:1
  do call printNewline(0) @69:1
  let sCopy: hashSet.T(Int) = call hashSet.copy [Int](s) @72:13
  let %30: Int = call hashSet.size [Int](sCopy) @73:10
  do call printInt(%30) @73:1
  let %31: Bool = call hashSet.equal [Int](s, sCopy) @74:11
  do call printBool(%31) @74:1
  do call printNewline(0) @75:1
  let setA: hashSet.T(Int) = call hashSet.new [Int](intEqual, intHash) @78:12
  let %32: Bool = call hashSet.insert [Int](setA, 1) @79:1
  let %33: Bool = call hashSet.insert [Int](setA, 2) @80:1
  let %34: Bool = call hashSet.insert [Int](setA, 3) @81:1
  let setB: hashSet.T(Int) = call hashSet.new [Int](intEqual, intHash) @83:12
  let %35: Bool = call hashSet.insert [Int](setB, 2) @84:1
  let %36: Bool = call hashSet.insert [Int](setB, 3) @85:1
  let %37: Bool = call hashSet.insert [Int](setB, 4) @86:1
  let sUnion: hashSet.T(Int) = call hashSet.union [Int](setA, setB) @89:14
  let %38: Int = call hashSet.size [Int](sUnion) @90:10
  do call printInt(%38) @90:1
  funs {
    fun f.3(elem.3: Int): Ok {
      let %39: Ok = call printInt(elem.3) @91:43
      return %39
    }
  }
  do call hashSet.forEach [Int](sUnion, f.3) @91:1
  do call printNewline(0) @92:1
  let sInter: hashSet.T(Int) = call hashSet.intersection [Int](setA, setB) @95:14
  let %40: Int = call hashSet.size [Int](sInter) @96:10
  do call printInt(%40) @96:1
  funs {
    fun f.4(elem.4: Int): Ok {
      let %41: Ok = call printInt(elem.4) @97:43
      return %41
    }
  }
  do call hashSet.forEach [Int](sInter, f.4) @97:1
  do call printNewline(0) @98:1
  let sDiff: hashSet.T(Int) = call hashSet.difference [Int](setA, setB) @101:13
  let %42: Int = call hashSet.size [Int](sDiff) @102:10
  do call printInt(%42) @102:1
  funs {
    fun f.5(elem.5: Int): Ok {
      let %43: Ok = call printInt(elem.5) @103:42
      return %43
    }
  }
  do call hashSet.forEach [Int](sDiff, f.5) @103:1
  do call printNewline(0) @104:1
  let %44: Bool = call hashSet.isSubset [Int](sInter, setA) @107:11
  do call printBool(%44) @107:1
  let %45: Bool = call hashSet.isSubset [Int](setA, setB) @108:11
  do call printBool(%45) @108:1
  let %46: Bool = call hashSet.isSubset [Int](setA, setA) @109:11
  do call printBool(%46) @109:1
  do call printNewline(0) @110:1
  do call hashSet.clear [Int](s) @113:1
  let %47: Int = call hashSet.size [Int](s) @114:10
  do call printInt(%47) @114:1
  let %48: Bool = call hashSet.empty [Int](s) @115:11
  do call printBool(%48) @115:1
  do call printNewline(0) @116:1
}

