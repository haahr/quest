import hashSet = "collections/hashSet" : collections/HashSet
import vector = "collections/vector" : collections/Vector
import word = "word" : Word
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @9:12
  funs {
    fun printInt(n: Int): Ok {
      let %1: String = call conv.int(n) @13:31
      do call writer.putString(wOut, %1) @13:9
      let %2: Ok = call writer.putString(wOut, " ") @14:9
      return %2
    }
  }
  funs {
    fun printBool(b: Bool): Ok {
      let %3: String = call conv.bool(b) @19:31
      do call writer.putString(wOut, %3) @19:9
      let %4: Ok = call writer.putString(wOut, " ") @20:9
      return %4
    }
  }
  funs {
    fun printNewline(dummy: Int): Ok {
      let %5: Ok = call writer.putString(wOut, "\n") @24:5
      return %5
    }
  }
  funs {
    fun intEqual(a: Int, b.1: Int): Bool {
      let %6: Bool = prim is(a, b.1) @26:37
      return %6
    }
  }
  funs {
    fun intHash(a.1: Int): word.T {
      let %7: word.T = call word.fromInt(a.1) @28:14
      let %8: word.T = call word.fromInt(2654435761) @28:30
      let %9: word.T = call word.mul(%7, %8) @28:5
      return %9
    }
  }
  let s: hashSet.T(Int) = call hashSet.new [Int](intEqual, intHash) @31:9
  let %10: Bool = call hashSet.empty [Int](s) @32:11
  do call printBool(%10) @32:1
  let %11: Int = call hashSet.size [Int](s) @33:10
  do call printInt(%11) @33:1
  do call printNewline(0) @34:1
  let %12: Bool = call hashSet.insert [Int](s, 10) @37:11
  do call printBool(%12) @37:1
  let %13: Bool = call hashSet.insert [Int](s, 20) @38:11
  do call printBool(%13) @38:1
  let %14: Bool = call hashSet.insert [Int](s, 30) @39:11
  do call printBool(%14) @39:1
  let %15: Bool = call hashSet.insert [Int](s, 10) @40:11
  do call printBool(%15) @40:1
  let %16: Int = call hashSet.size [Int](s) @41:10
  do call printInt(%16) @41:1
  let %17: Bool = call hashSet.empty [Int](s) @42:11
  do call printBool(%17) @42:1
  do call printNewline(0) @43:1
  let %18: Bool = call hashSet.contains [Int](s, 10) @46:11
  do call printBool(%18) @46:1
  let %19: Bool = call hashSet.contains [Int](s, 20) @47:11
  do call printBool(%19) @47:1
  let %20: Bool = call hashSet.contains [Int](s, 25) @48:11
  do call printBool(%20) @48:1
  let %21: Bool = call hashSet.contains [Int](s, 30) @49:11
  do call printBool(%21) @49:1
  do call printNewline(0) @50:1
  let elems: vector.T(Int) = call hashSet.elements [Int](s) @53:13
  let %22: Int = call vector.length [Int](elems) @54:10
  do call printInt(%22) @54:1
  funs {
    fun f(elem: Int): Ok {
      let %23: Ok = call printInt(elem) @55:41
      return %23
    }
  }
  do call vector.forEach [Int](elems, f) @55:1
  do call printNewline(0) @56:1
  funs {
    fun f.1(elem.1: Int): Ok {
      let %24: Ok = call printInt(elem.1) @58:38
      return %24
    }
  }
  do call hashSet.forEach [Int](s, f.1) @58:1
  do call printNewline(0) @59:1
  let %25: Bool = call hashSet.delete [Int](s, 20) @62:11
  do call printBool(%25) @62:1
  let %26: Bool = call hashSet.delete [Int](s, 20) @63:11
  do call printBool(%26) @63:1
  let %27: Int = call hashSet.size [Int](s) @64:10
  do call printInt(%27) @64:1
  let %28: Bool = call hashSet.contains [Int](s, 20) @65:11
  do call printBool(%28) @65:1
  do call printNewline(0) @66:1
  funs {
    fun f.2(elem.2: Int): Ok {
      let %29: Ok = call printInt(elem.2) @69:38
      return %29
    }
  }
  do call hashSet.forEach [Int](s, f.2) @69:1
  do call printNewline(0) @70:1
  let sCopy: hashSet.T(Int) = call hashSet.copy [Int](s) @73:13
  let %30: Int = call hashSet.size [Int](sCopy) @74:10
  do call printInt(%30) @74:1
  let %31: Bool = call hashSet.equal [Int](s, sCopy) @75:11
  do call printBool(%31) @75:1
  do call printNewline(0) @76:1
  let setA: hashSet.T(Int) = call hashSet.new [Int](intEqual, intHash) @79:12
  let %32: Bool = call hashSet.insert [Int](setA, 1) @80:1
  let %33: Bool = call hashSet.insert [Int](setA, 2) @81:1
  let %34: Bool = call hashSet.insert [Int](setA, 3) @82:1
  let setB: hashSet.T(Int) = call hashSet.new [Int](intEqual, intHash) @84:12
  let %35: Bool = call hashSet.insert [Int](setB, 2) @85:1
  let %36: Bool = call hashSet.insert [Int](setB, 3) @86:1
  let %37: Bool = call hashSet.insert [Int](setB, 4) @87:1
  let sUnion: hashSet.T(Int) = call hashSet.union [Int](setA, setB) @90:14
  let %38: Int = call hashSet.size [Int](sUnion) @91:10
  do call printInt(%38) @91:1
  funs {
    fun f.3(elem.3: Int): Ok {
      let %39: Ok = call printInt(elem.3) @92:43
      return %39
    }
  }
  do call hashSet.forEach [Int](sUnion, f.3) @92:1
  do call printNewline(0) @93:1
  let sInter: hashSet.T(Int) = call hashSet.intersection [Int](setA, setB) @96:14
  let %40: Int = call hashSet.size [Int](sInter) @97:10
  do call printInt(%40) @97:1
  funs {
    fun f.4(elem.4: Int): Ok {
      let %41: Ok = call printInt(elem.4) @98:43
      return %41
    }
  }
  do call hashSet.forEach [Int](sInter, f.4) @98:1
  do call printNewline(0) @99:1
  let sDiff: hashSet.T(Int) = call hashSet.difference [Int](setA, setB) @102:13
  let %42: Int = call hashSet.size [Int](sDiff) @103:10
  do call printInt(%42) @103:1
  funs {
    fun f.5(elem.5: Int): Ok {
      let %43: Ok = call printInt(elem.5) @104:42
      return %43
    }
  }
  do call hashSet.forEach [Int](sDiff, f.5) @104:1
  do call printNewline(0) @105:1
  let %44: Bool = call hashSet.isSubset [Int](sInter, setA) @108:11
  do call printBool(%44) @108:1
  let %45: Bool = call hashSet.isSubset [Int](setA, setB) @109:11
  do call printBool(%45) @109:1
  let %46: Bool = call hashSet.isSubset [Int](setA, setA) @110:11
  do call printBool(%46) @110:1
  do call printNewline(0) @111:1
  do call hashSet.clear [Int](s) @114:1
  let %47: Int = call hashSet.size [Int](s) @115:10
  do call printInt(%47) @115:1
  let %48: Bool = call hashSet.empty [Int](s) @116:11
  do call printBool(%48) @116:1
  do call printNewline(0) @117:1
}

