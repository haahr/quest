import hashSet = "collections/hashSet" : collections/HashSet
import vector = "collections/vector" : collections/Vector
import word = "word" : Word
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output
  funs {
    fun printInt(n: Int): Ok {
      let %1: String = call conv.int(n)
      do call writer.putString(wOut, %1)
      let %2: Ok = call writer.putString(wOut, " ")
      return %2
    }
  }
  funs {
    fun printBool(b: Bool): Ok {
      let %3: String = call conv.bool(b)
      do call writer.putString(wOut, %3)
      let %4: Ok = call writer.putString(wOut, " ")
      return %4
    }
  }
  funs {
    fun printNewline(dummy: Int): Ok {
      let %5: Ok = call writer.putString(wOut, "\n")
      return %5
    }
  }
  funs {
    fun intEqual(a: Int, b.1: Int): Bool {
      let %6: Bool = prim is(a, b.1)
      return %6
    }
  }
  funs {
    fun intHash(a.1: Int): word.T {
      let %7: word.T = call word.fromInt(a.1)
      let %8: word.T = call word.fromInt(2654435761)
      let %9: word.T = call word.mul(%7, %8)
      return %9
    }
  }
  let s: hashSet.T(Int) = call hashSet.new [Int](intEqual, intHash)
  let %10: Bool = call hashSet.empty [Int](s)
  do call printBool(%10)
  let %11: Int = call hashSet.size [Int](s)
  do call printInt(%11)
  do call printNewline(0)
  let %12: Bool = call hashSet.insert [Int](s, 10)
  do call printBool(%12)
  let %13: Bool = call hashSet.insert [Int](s, 20)
  do call printBool(%13)
  let %14: Bool = call hashSet.insert [Int](s, 30)
  do call printBool(%14)
  let %15: Bool = call hashSet.insert [Int](s, 10)
  do call printBool(%15)
  let %16: Int = call hashSet.size [Int](s)
  do call printInt(%16)
  let %17: Bool = call hashSet.empty [Int](s)
  do call printBool(%17)
  do call printNewline(0)
  let %18: Bool = call hashSet.contains [Int](s, 10)
  do call printBool(%18)
  let %19: Bool = call hashSet.contains [Int](s, 20)
  do call printBool(%19)
  let %20: Bool = call hashSet.contains [Int](s, 25)
  do call printBool(%20)
  let %21: Bool = call hashSet.contains [Int](s, 30)
  do call printBool(%21)
  do call printNewline(0)
  let elems: vector.T(Int) = call hashSet.elements [Int](s)
  let %22: Int = call vector.length [Int](elems)
  do call printInt(%22)
  funs {
    fun f(elem: Int): Ok {
      let %23: Ok = call printInt(elem)
      return %23
    }
  }
  do call vector.forEach [Int](elems, f)
  do call printNewline(0)
  funs {
    fun f.1(elem.1: Int): Ok {
      let %24: Ok = call printInt(elem.1)
      return %24
    }
  }
  do call hashSet.forEach [Int](s, f.1)
  do call printNewline(0)
  let %25: Bool = call hashSet.delete [Int](s, 20)
  do call printBool(%25)
  let %26: Bool = call hashSet.delete [Int](s, 20)
  do call printBool(%26)
  let %27: Int = call hashSet.size [Int](s)
  do call printInt(%27)
  let %28: Bool = call hashSet.contains [Int](s, 20)
  do call printBool(%28)
  do call printNewline(0)
  funs {
    fun f.2(elem.2: Int): Ok {
      let %29: Ok = call printInt(elem.2)
      return %29
    }
  }
  do call hashSet.forEach [Int](s, f.2)
  do call printNewline(0)
  let sCopy: hashSet.T(Int) = call hashSet.copy [Int](s)
  let %30: Int = call hashSet.size [Int](sCopy)
  do call printInt(%30)
  let %31: Bool = call hashSet.equal [Int](s, sCopy)
  do call printBool(%31)
  do call printNewline(0)
  let setA: hashSet.T(Int) = call hashSet.new [Int](intEqual, intHash)
  let %32: Bool = call hashSet.insert [Int](setA, 1)
  let %33: Bool = call hashSet.insert [Int](setA, 2)
  let %34: Bool = call hashSet.insert [Int](setA, 3)
  let setB: hashSet.T(Int) = call hashSet.new [Int](intEqual, intHash)
  let %35: Bool = call hashSet.insert [Int](setB, 2)
  let %36: Bool = call hashSet.insert [Int](setB, 3)
  let %37: Bool = call hashSet.insert [Int](setB, 4)
  let sUnion: hashSet.T(Int) = call hashSet.union [Int](setA, setB)
  let %38: Int = call hashSet.size [Int](sUnion)
  do call printInt(%38)
  funs {
    fun f.3(elem.3: Int): Ok {
      let %39: Ok = call printInt(elem.3)
      return %39
    }
  }
  do call hashSet.forEach [Int](sUnion, f.3)
  do call printNewline(0)
  let sInter: hashSet.T(Int) = call hashSet.intersection [Int](setA, setB)
  let %40: Int = call hashSet.size [Int](sInter)
  do call printInt(%40)
  funs {
    fun f.4(elem.4: Int): Ok {
      let %41: Ok = call printInt(elem.4)
      return %41
    }
  }
  do call hashSet.forEach [Int](sInter, f.4)
  do call printNewline(0)
  let sDiff: hashSet.T(Int) = call hashSet.difference [Int](setA, setB)
  let %42: Int = call hashSet.size [Int](sDiff)
  do call printInt(%42)
  funs {
    fun f.5(elem.5: Int): Ok {
      let %43: Ok = call printInt(elem.5)
      return %43
    }
  }
  do call hashSet.forEach [Int](sDiff, f.5)
  do call printNewline(0)
  let %44: Bool = call hashSet.isSubset [Int](sInter, setA)
  do call printBool(%44)
  let %45: Bool = call hashSet.isSubset [Int](setA, setB)
  do call printBool(%45)
  let %46: Bool = call hashSet.isSubset [Int](setA, setA)
  do call printBool(%46)
  do call printNewline(0)
  do call hashSet.clear [Int](s)
  let %47: Int = call hashSet.size [Int](s)
  do call printInt(%47)
  let %48: Bool = call hashSet.empty [Int](s)
  do call printBool(%48)
  do call printNewline(0)
}

