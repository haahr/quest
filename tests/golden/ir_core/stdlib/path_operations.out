  let %70: String = call path.relativeTo("a/b", "a") @102:10
  do call printStr(%70) @102:1
  let %71: Exception = member path.error @107:6
  try catching (%71) {
    let dummy: String = call path.relativeTo("/a/b", "a/b") @105:17
    do call printStr("FAILED: should have raised error") @106:5
  } handle (e: Exception) {
    let %72: Bool = prim is(e, %71) @104:1
    if %72 { @104:1
      do call printStr("CAUGHT: path.error") @108:5
    } else {
      reraise e @104:1
    }
  }
  let resolved: String = call path.resolve("foo/bar") @112:16
  let %73: Bool = call path.isAbsolute(resolved) @113:11
  do call printBool(%73) @113:1
  let %74: String = call path.normalize(resolved) @114:26
  let %75: Bool = call stringOp.equal(%74, resolved) @114:11
  do call printBool(%75) @114:1
}

