      let %1: writer.T = member writer.output @11:26
      do call writer.putString(%1, s) @11:9
      let %2: writer.T = member writer.output @12:26
      let %3: Ok = call writer.putString(%2, "\n") @12:9
      return %3
    }
  }
  funs {
    fun printBool(b: Bool): Ok {
