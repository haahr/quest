import path = "util/path" : util/Path
import vector = "collections/vector" : collections/Vector
import writer = "writer" : Writer
import conv = "conv" : Conv
import stringOp = "string" : StringOp
main {
  funs {
    fun printStr(s: String): Ok {
      let %1: writer.T = member writer.output
      do call writer.putString(%1, s)
      let %2: writer.T = member writer.output
      let %3: Ok = call writer.putString(%2, "\n")
      return %3
    }
  }
  funs {
    fun printBool(b: Bool): Ok {
      let %4: String = call conv.bool(b)
      let %5: Ok = call printStr(%4)
      return %5
    }
  }
  funs {
    fun printInt(n: Int): Ok {
      let %6: String = call conv.int(n)
      let %7: Ok = call printStr(%6)
      return %7
    }
  }
  let %8: Char = member path.separator
  let %9: Bool = prim is(%8, '/')
  do call printBool(%9)
  let %10: String = member path.separatorString
  do call printStr(%10)
  let %11: Bool = call path.isAbsolute("/foo/bar")
  do call printBool(%11)
  let %12: Bool = call path.isAbsolute("foo/bar")
  do call printBool(%12)
  let %13: Bool = call path.isRelative("foo/bar")
  do call printBool(%13)
  let %14: Bool = call path.isRelative("/foo/bar")
  do call printBool(%14)
  let %15: String = call path.dirName("/a/b/c.txt")
  do call printStr(%15)
  let %16: String = call path.dirName("a/b")
  do call printStr(%16)
  let %17: String = call path.dirName("a")
  do call printStr(%17)
  let %18: String = call path.dirName("/a")
  do call printStr(%18)
  let %19: String = call path.dirName("/")
  do call printStr(%19)
  let %20: String = call path.baseName("/a/b/c.txt")
  do call printStr(%20)
  let %21: String = call path.baseName("a/b/")
  do call printStr(%21)
  let %22: String = call path.baseName("/")
  do call printStr(%22)
  let %23: String = call path.baseName("")
  do call printStr(%23)
  let %24: String = call path.extension("foo.txt")
  do call printStr(%24)
  let %25: String = call path.extension("archive.tar.gz")
  do call printStr(%25)
  let %26: String = call path.extension(".gitignore")
  do call printStr(%26)
  let %27: String = call path.extension("foo")
  do call printStr(%27)
  let %28: Bool = call path.hasExtension("foo.txt")
  do call printBool(%28)
  let %29: Bool = call path.hasExtension("foo")
  do call printBool(%29)
  let %30: String = call path.stem("foo.txt")
  do call printStr(%30)
  let %31: String = call path.stem("archive.tar.gz")
  do call printStr(%31)
  let %32: String = call path.stem(".gitignore")
  do call printStr(%32)
  let %33: String = call path.stem("foo")
  do call printStr(%33)
  let %34: String = call path.stem("foo.txt")
  let %35: String = call path.extension("foo.txt")
  let s1: String = prim <>(%34, %35)
  let %36: String = call path.baseName("foo.txt")
  let %37: Bool = call stringOp.equal(s1, %36)
  do call printBool(%37)
  let %38: String = call path.stem("archive.tar.gz")
  let %39: String = call path.extension("archive.tar.gz")
  let s2: String = prim <>(%38, %39)
  let %40: String = call path.baseName("archive.tar.gz")
  let %41: Bool = call stringOp.equal(s2, %40)
  do call printBool(%41)
  let %42: String = call path.stem(".gitignore")
  let %43: String = call path.extension(".gitignore")
  let s3: String = prim <>(%42, %43)
  let %44: String = call path.baseName(".gitignore")
  let %45: Bool = call stringOp.equal(s3, %44)
  do call printBool(%45)
  let pList: vector.T(String) = call path.parts("/a/b/c")
  let %46: Int = call vector.length [String](pList)
  do call printInt(%46)
  let %47: String = call vector.get [String](pList, 0)
  do call printStr(%47)
  let %48: String = call vector.get [String](pList, 1)
  do call printStr(%48)
  let %49: String = call vector.get [String](pList, 2)
  do call printStr(%49)
  let %50: String = call vector.get [String](pList, 3)
  do call printStr(%50)
  let %51: String = call path.join("a", "b")
  do call printStr(%51)
  let %52: String = call path.join("a/", "b")
  do call printStr(%52)
  let %53: String = call path.join("a", "/b")
  do call printStr(%53)
  let %54: String = call path.join("", "b")
  do call printStr(%54)
  let %55: String = call path.join("a", "")
  do call printStr(%55)
  let vParts: vector.T(String) = type_app vector.new [String]
  do call vector.append [String](vParts, "a")
  do call vector.append [String](vParts, "b")
  do call vector.append [String](vParts, "c")
  let %56: String = call path.joinVector(vParts)
  do call printStr(%56)
  let arrParts: Array(String) = array("x", "y", "z")
  let %57: String = call path.joinArray(arrParts)
  do call printStr(%57)
  let %58: String = call path.withExtension("foo.txt", "md")
  do call printStr(%58)
  let %59: String = call path.withExtension("foo.txt", ".md")
  do call printStr(%59)
  let %60: String = call path.withExtension("foo.txt", "")
  do call printStr(%60)
  let %61: String = call path.withExtension("/dir/foo", "o")
  do call printStr(%61)
  let %62: String = call path.normalize("a//b/./c/../d")
  do call printStr(%62)
  let %63: String = call path.normalize("/../a")
  do call printStr(%63)
  let %64: String = call path.normalize("")
  do call printStr(%64)
  let %65: String = call path.normalize("/a/b/../../c")
  do call printStr(%65)
  let %66: String = call path.normalize("a/b/../../../c")
  do call printStr(%66)
  let %67: String = call path.relativeTo("/a/b/c", "/a")
  do call printStr(%67)
  let %68: String = call path.relativeTo("/a/b", "/a/c")
  do call printStr(%68)
  let %69: String = call path.relativeTo("/a/b/c", "/a/b/c")
  do call printStr(%69)
  let %70: String = call path.relativeTo("a/b", "a")
  do call printStr(%70)
  let %71: Exception = member path.error
  try catching (%71) {
    let dummy: String = call path.relativeTo("/a/b", "a/b")
    do call printStr("FAILED: should have raised error")
  } handle (e: Exception) {
    let %72: Bool = prim is(e, %71)
    if %72 {
      do call printStr("CAUGHT: path.error")
    } else {
      reraise e
    }
  }
  let resolved: String = call path.resolve("foo/bar")
  let %73: Bool = call path.isAbsolute(resolved)
  do call printBool(%73)
  let %74: String = call path.normalize(resolved)
  let %75: Bool = call stringOp.equal(%74, resolved)
  do call printBool(%75)
}

