  let %35: String = call path.extension("foo.txt") @54:34
  let s1: String = prim <>(%34, %35) @54:10
  let %36: String = call path.baseName("foo.txt") @55:29
  let %37: Bool = call stringOp.equal(s1, %36) @55:11
  do call printBool(%37) @55:1
  let %38: String = call path.stem("archive.tar.gz") @56:10
  let %39: String = call path.extension("archive.tar.gz") @56:41
  let s2: String = prim <>(%38, %39) @56:10
  let %40: String = call path.baseName("archive.tar.gz") @57:29
  let %41: Bool = call stringOp.equal(s2, %40) @57:11
  do call printBool(%41) @57:1
  let %42: String = call path.stem(".gitignore") @58:10
  let %43: String = call path.extension(".gitignore") @58:37
  let s3: String = prim <>(%42, %43) @58:10
  let %44: String = call path.baseName(".gitignore") @59:29
  let %45: Bool = call stringOp.equal(s3, %44) @59:11
  do call printBool(%45) @59:1
