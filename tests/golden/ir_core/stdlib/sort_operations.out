main {
  let wOut: writer.T = member writer.output
  funs {
    fun printInt(n: Int): Ok {
      let %1: String = call conv.int(n)
      do call writer.putString(wOut, %1)
      let %2: Ok = call writer.putString(wOut, " ")
      return %2
    }
  }
  funs {
    fun printBool(b: Bool): Ok {
      let %3: String = call conv.bool(b)
      do call writer.putString(wOut, %3)
      let %4: Ok = call writer.putString(wOut, " ")
      return %4
    }
  }
  funs {
    fun printString(s: String): Ok {
      do call writer.putString(wOut, s)
      let %5: Ok = call writer.putString(wOut, " ")
      return %5
    }
  }
  funs {
    fun printNewline(dummy: Int): Ok {
      let %6: Ok = call writer.putString(wOut, "\n")
      return %6
    }
  }
  let %7: Int = call sort.intCompare(10, 20)
  do call printInt(%7)
  let %8: Int = call sort.intCompare(20, 20)
  do call printInt(%8)
  let %9: Int = call sort.intCompare(30, 20)
  do call printInt(%9)
  let %10: Int = call sort.stringCompare("apple", "banana")
  do call printInt(%10)
  let %11: Int = call sort.stringCompare("apple", "apple")
  do call printInt(%11)
  let %12: Int = call sort.stringCompare("banana", "apple")
  do call printInt(%12)
  let %13: Fun(a: Int b: Int): Int = member sort.intCompare
  let revInt: Fun(a: Int b: Int): Int = call sort.reverse [Int](%13)
  let %14: Int = call revInt(10, 20)
  do call printInt(%14)
  let %15: Int = call revInt(20, 10)
  do call printInt(%15)
  do call printNewline(0)
  let arr1: Array(Int) = array_rep(6, 0)
  store arr1[0] := 10
  store arr1[1] := 20
  store arr1[2] := 20
  store arr1[3] := 20
  store arr1[4] := 30
  store arr1[5] := 40
  let %16: Fun(a: Int b: Int): Int = member sort.intCompare
  let %17: Int = call sort.bisectRight [Int](arr1, 5, %16)
  do call printInt(%17)
  let %18: Fun(a: Int b: Int): Int = member sort.intCompare
  let %19: Int = call sort.bisectRight [Int](arr1, 10, %18)
  do call printInt(%19)
  let %20: Fun(a: Int b: Int): Int = member sort.intCompare
  let %21: Int = call sort.bisectRight [Int](arr1, 20, %20)
  do call printInt(%21)
  let %22: Fun(a: Int b: Int): Int = member sort.intCompare
  let %23: Int = call sort.bisectRight [Int](arr1, 25, %22)
  do call printInt(%23)
  let %24: Fun(a: Int b: Int): Int = member sort.intCompare
  let %25: Int = call sort.bisectRight [Int](arr1, 40, %24)
  do call printInt(%25)
  let %26: Fun(a: Int b: Int): Int = member sort.intCompare
  let %27: Int = call sort.bisectRight [Int](arr1, 50, %26)
  do call printInt(%27)
  do call printNewline(0)
  let %28: Fun(a: Int b: Int): Int = member sort.intCompare
  let %29: Int = call sort.bisectLeft [Int](arr1, 5, %28)
  do call printInt(%29)
  let %30: Fun(a: Int b: Int): Int = member sort.intCompare
  let %31: Int = call sort.bisectLeft [Int](arr1, 10, %30)
  do call printInt(%31)
  let %32: Fun(a: Int b: Int): Int = member sort.intCompare
  let %33: Int = call sort.bisectLeft [Int](arr1, 20, %32)
  do call printInt(%33)
  let %34: Fun(a: Int b: Int): Int = member sort.intCompare
  let %35: Int = call sort.bisectLeft [Int](arr1, 25, %34)
  do call printInt(%35)
  let %36: Fun(a: Int b: Int): Int = member sort.intCompare
  let %37: Int = call sort.bisectLeft [Int](arr1, 40, %36)
  do call printInt(%37)
  let %38: Fun(a: Int b: Int): Int = member sort.intCompare
  let %39: Int = call sort.bisectLeft [Int](arr1, 50, %38)
  do call printInt(%39)
  do call printNewline(0)
  let %40: Fun(a: Int b: Int): Int = member sort.intCompare
  let s1: maybe.T(Int) = call sort.binarySearch [Int](arr1, 20, %40)
  let %41: Bool = call maybe.isSome [Int](s1)
  do call printBool(%41)
  let %42: Int = call maybe.unwrap [Int](s1)
  do call printInt(%42)
  let %43: Fun(a: Int b: Int): Int = member sort.intCompare
  let s2: maybe.T(Int) = call sort.binarySearch [Int](arr1, 25, %43)
  let %44: Bool = call maybe.isNone [Int](s2)
  do call printBool(%44)
  do call printNewline(0)
  let vec1: vector.T(Int) = type_app vector.new [Int]
  do call vector.append [Int](vec1, 10)
  do call vector.append [Int](vec1, 20)
  do call vector.append [Int](vec1, 20)
  do call vector.append [Int](vec1, 30)
  let %45: Fun(a: Int b: Int): Int = member sort.intCompare
  let %46: Int = call sort.bisectRightVector [Int](vec1, 20, %45)
  do call printInt(%46)
  let %47: Fun(a: Int b: Int): Int = member sort.intCompare
  let %48: Int = call sort.bisectLeftVector [Int](vec1, 20, %47)
  do call printInt(%48)
  let %49: Fun(a: Int b: Int): Int = member sort.intCompare
  let sv1: maybe.T(Int) = call sort.binarySearchVector [Int](vec1, 30, %49)
  let %50: Bool = call maybe.isSome [Int](sv1)
  do call printBool(%50)
  let %51: Int = call maybe.unwrap [Int](sv1)
  do call printInt(%51)
  let %52: Fun(a: Int b: Int): Int = member sort.intCompare
  let sv2: maybe.T(Int) = call sort.binarySearchVector [Int](vec1, 99, %52)
  let %53: Bool = call maybe.isNone [Int](sv2)
  do call printBool(%53)
  do call printNewline(0)
  let toSort: Array(Int) = array_rep(8, 0)
  store toSort[0] := 50
  store toSort[1] := 10
  store toSort[2] := 40
  store toSort[3] := 20
  store toSort[4] := 10
  store toSort[5] := 30
  store toSort[6] := 20
  store toSort[7] := 50
  let %54: Fun(a: Int b: Int): Int = member sort.intCompare
  do call sort.sort [Int](toSort, %54)
  var i: Int = 0
  loop L1 {
    let %55: Bool = prim <=(i, 7)
    if %55 {
      let i.1: Int = i
      let %56: Int = index(toSort, i.1)
      do call printInt(%56)
      let %57: Int = prim +(i, 1)
      i := %57
    } else {
      break L1
    }
  }
  do call printNewline(0)
  let original: Array(Int) = array_rep(4, 0)
  store original[0] := 9
  store original[1] := 3
  store original[2] := 7
  store original[3] := 1
  let %58: Fun(a: Int b: Int): Int = member sort.intCompare
  let sortedArr: Array(Int) = call sort.sorted [Int](original, %58)
  var i.2: Int = 0
  loop L2 {
    let %59: Bool = prim <=(i.2, 3)
    if %59 {
      let i.3: Int = i.2
      let %60: Int = index(original, i.3)
      do call printInt(%60)
      let %61: Int = prim +(i.2, 1)
      i.2 := %61
    } else {
      break L2
    }
  }
  do call printString("|")
  var i.4: Int = 0
  loop L3 {
    let %62: Bool = prim <=(i.4, 3)
    if %62 {
      let i.5: Int = i.4
      let %63: Int = index(sortedArr, i.5)
      do call printInt(%63)
      let %64: Int = prim +(i.4, 1)
      i.4 := %64
    } else {
      break L3
    }
  }
  do call printNewline(0)
  let vec2: vector.T(String) = type_app vector.new [String]
  do call vector.append [String](vec2, "banana")
  do call vector.append [String](vec2, "apple")
  do call vector.append [String](vec2, "cherry")
  do call vector.append [String](vec2, "date")
  let %65: Fun(a: String b: String): Int = member sort.stringCompare
  let vecSorted: vector.T(String) = call sort.sortedVector [String](vec2, %65)
  let %66: Int = call vector.length [String](vecSorted)
  let %67: Int = prim -(%66, 1)
  var i.6: Int = 0
  loop L4 {
    let %68: Bool = prim <=(i.6, %67)
    if %68 {
      let i.7: Int = i.6
      let %69: String = call vector.get [String](vecSorted, i.7)
      do call printString(%69)
      let %70: Int = prim +(i.6, 1)
      i.6 := %70
    } else {
      break L4
    }
  }
  do call printNewline(0)
  let %71: Fun(a: String b: String): Int = member sort.stringCompare
  let revStr: Fun(a: String b: String): Int = call sort.reverse [String](%71)
  do call sort.sortVector [String](vec2, revStr)
  let %72: Int = call vector.length [String](vec2)
  let %73: Int = prim -(%72, 1)
  var i.8: Int = 0
  loop L5 {
    let %74: Bool = prim <=(i.8, %73)
    if %74 {
      let i.9: Int = i.8
      let %75: String = call vector.get [String](vec2, i.9)
      do call printString(%75)
      let %76: Int = prim +(i.8, 1)
      i.8 := %76
    } else {
      break L5
    }
  }
  do call printNewline(0)
}

