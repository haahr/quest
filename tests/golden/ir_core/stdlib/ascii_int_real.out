import ascii = "ascii" : Ascii
import int = "int" : IntOp
import real = "real" : RealOp
import conv = "conv" : Conv
import writer = "writer" : Writer
main {
  let ch: Char = call ascii.char(66) @9:10
  let val: Int = call ascii.val(ch) @10:11
  let absVal: Int = call int.abs(-15) @11:14
  let maxVal: Int = call int.max(10, 25) @12:14
  let minVal: Int = call int.min(10, 25) @13:14
  let rFloor: Int = call real.floor(4.9) @14:14
  let rRound: Int = call real.round(4.4) @15:14
  let rPlus: Real = call real.plus(1.25, 2.75) @16:13
  let rDiff: Real = call real.diff(5.5, 1.5) @17:13
  let rMul: Real = call real.mul(2.5, 4.0) @18:12
  let rDiv: Real = call real.div(9.0, 3.0) @19:12
  let rSmaller: Bool = call real.smaller(1.0, 2.0) @20:16
  let %1: writer.T = member writer.output @22:18
  let %2: String = call conv.char(ch) @22:32
  do call writer.putString(%1, %2) @22:1
  let %3: writer.T = member writer.output @23:18
  do call writer.putString(%3, "\n") @23:1
  let %4: writer.T = member writer.output @24:18
  let %5: String = call conv.int(val) @24:32
  do call writer.putString(%4, %5) @24:1
  let %6: writer.T = member writer.output @25:18
  do call writer.putString(%6, "\n") @25:1
  let %7: writer.T = member writer.output @26:18
  let %8: String = call conv.int(absVal) @26:32
  do call writer.putString(%7, %8) @26:1
  let %9: writer.T = member writer.output @27:18
  do call writer.putString(%9, "\n") @27:1
  let %10: writer.T = member writer.output @28:18
  let %11: String = call conv.int(maxVal) @28:32
  do call writer.putString(%10, %11) @28:1
  let %12: writer.T = member writer.output @29:18
  do call writer.putString(%12, "\n") @29:1
  let %13: writer.T = member writer.output @30:18
  let %14: String = call conv.int(minVal) @30:32
  do call writer.putString(%13, %14) @30:1
  let %15: writer.T = member writer.output @31:18
  do call writer.putString(%15, "\n") @31:1
  let %16: writer.T = member writer.output @32:18
  let %17: String = call conv.int(rFloor) @32:32
  do call writer.putString(%16, %17) @32:1
  let %18: writer.T = member writer.output @33:18
  do call writer.putString(%18, "\n") @33:1
  let %19: writer.T = member writer.output @34:18
  let %20: String = call conv.int(rRound) @34:32
  do call writer.putString(%19, %20) @34:1
  let %21: writer.T = member writer.output @35:18
  do call writer.putString(%21, "\n") @35:1
  let %22: writer.T = member writer.output @36:18
  let %23: String = call conv.real(rPlus) @36:32
  do call writer.putString(%22, %23) @36:1
  let %24: writer.T = member writer.output @37:18
  do call writer.putString(%24, "\n") @37:1
  let %25: writer.T = member writer.output @38:18
  let %26: String = call conv.real(rDiff) @38:32
  do call writer.putString(%25, %26) @38:1
  let %27: writer.T = member writer.output @39:18
  do call writer.putString(%27, "\n") @39:1
  let %28: writer.T = member writer.output @40:18
  let %29: String = call conv.real(rMul) @40:32
  do call writer.putString(%28, %29) @40:1
  let %30: writer.T = member writer.output @41:18
  do call writer.putString(%30, "\n") @41:1
  let %31: writer.T = member writer.output @42:18
  let %32: String = call conv.real(rDiv) @42:32
  do call writer.putString(%31, %32) @42:1
  let %33: writer.T = member writer.output @43:18
  do call writer.putString(%33, "\n") @43:1
  let %34: writer.T = member writer.output @44:18
  let %35: String = call conv.bool(rSmaller) @44:32
  do call writer.putString(%34, %35) @44:1
  let %36: writer.T = member writer.output @45:18
  do call writer.putString(%36, "\n") @45:1
}

