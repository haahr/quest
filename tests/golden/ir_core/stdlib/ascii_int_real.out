main {
  let ch: Char = call ascii.char(66)
  let val: Int = call ascii.val(ch)
  let absVal: Int = call int.abs(-15)
  let maxVal: Int = call int.max(10, 25)
  let minVal: Int = call int.min(10, 25)
  let rFloor: Int = call real.floor(4.9)
  let rRound: Int = call real.round(4.4)
  let rPlus: Real = call real.plus(1.25, 2.75)
  let rDiff: Real = call real.diff(5.5, 1.5)
  let rMul: Real = call real.mul(2.5, 4.0)
  let rDiv: Real = call real.div(9.0, 3.0)
  let rSmaller: Bool = call real.smaller(1.0, 2.0)
  let %1: writer.T = member writer.output
  let %2: String = call conv.char(ch)
  do call writer.putString(%1, %2)
  let %3: writer.T = member writer.output
  do call writer.putString(%3, "\n")
  let %4: writer.T = member writer.output
  let %5: String = call conv.int(val)
  do call writer.putString(%4, %5)
  let %6: writer.T = member writer.output
  do call writer.putString(%6, "\n")
  let %7: writer.T = member writer.output
  let %8: String = call conv.int(absVal)
  do call writer.putString(%7, %8)
  let %9: writer.T = member writer.output
  do call writer.putString(%9, "\n")
  let %10: writer.T = member writer.output
  let %11: String = call conv.int(maxVal)
  do call writer.putString(%10, %11)
  let %12: writer.T = member writer.output
  do call writer.putString(%12, "\n")
  let %13: writer.T = member writer.output
  let %14: String = call conv.int(minVal)
  do call writer.putString(%13, %14)
  let %15: writer.T = member writer.output
  do call writer.putString(%15, "\n")
  let %16: writer.T = member writer.output
  let %17: String = call conv.int(rFloor)
  do call writer.putString(%16, %17)
  let %18: writer.T = member writer.output
  do call writer.putString(%18, "\n")
  let %19: writer.T = member writer.output
  let %20: String = call conv.int(rRound)
  do call writer.putString(%19, %20)
  let %21: writer.T = member writer.output
  do call writer.putString(%21, "\n")
  let %22: writer.T = member writer.output
  let %23: String = call conv.real(rPlus)
  do call writer.putString(%22, %23)
  let %24: writer.T = member writer.output
  do call writer.putString(%24, "\n")
  let %25: writer.T = member writer.output
  let %26: String = call conv.real(rDiff)
  do call writer.putString(%25, %26)
  let %27: writer.T = member writer.output
  do call writer.putString(%27, "\n")
  let %28: writer.T = member writer.output
  let %29: String = call conv.real(rMul)
  do call writer.putString(%28, %29)
  let %30: writer.T = member writer.output
  do call writer.putString(%30, "\n")
  let %31: writer.T = member writer.output
  let %32: String = call conv.real(rDiv)
  do call writer.putString(%31, %32)
  let %33: writer.T = member writer.output
  do call writer.putString(%33, "\n")
  let %34: writer.T = member writer.output
  let %35: String = call conv.bool(rSmaller)
  do call writer.putString(%34, %35)
  let %36: writer.T = member writer.output
  do call writer.putString(%36, "\n")
}

