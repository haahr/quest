import writer = "writer" : Writer
import real = "real" : RealOp
main {
  funs {
    fun show(r: Real, digits: Int): Ok {
      let %1: writer.T = member writer.output @8:54
      let %2: String = call real.format(r, 'g', digits) @8:68
      let %3: String = prim <>(%2, "\n") @8:68
      let %4: Ok = call writer.putString(%1, %3) @8:37
      return %4
    }
  }
  do call show(9805.0, 3) @10:1
  do call show(9815.0, 3) @11:1
  do call show(98050.0, 3) @12:1
  do call show(9850.0, 2) @13:1
  do call show(125.0, 2) @14:1
  do call show(2.5, 1) @15:1
  do call show(0.125, 2) @16:1
  do call show(1250000.0, 2) @17:1
  do call show(100.0, 3) @18:1
  do call show(0.000123, 3) @19:1
}

