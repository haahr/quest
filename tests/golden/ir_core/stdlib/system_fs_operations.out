import system = "system" : System
import writer = "writer" : Writer
import conv = "conv" : Conv
import arrayOp = "arrayOp" : ArrayOp
import string = "string" : StringOp
main {
  funs {
    fun printBool(b: Bool): Ok {
      let %1: writer.T = member writer.output
      let %2: String = call conv.bool(b)
      do call writer.putString(%1, %2)
      let %3: writer.T = member writer.output
      let %4: Ok = call writer.putString(%3, "\n")
      return %4
    }
  }
  funs {
    fun printInt(n: Int): Ok {
      let %5: writer.T = member writer.output
      let %6: String = call external "quest_conv_int"(n)
      do call writer.putString(%5, %6)
      let %7: writer.T = member writer.output
      let %8: Ok = call writer.putString(%7, "\n")
      return %8
    }
  }
  funs {
    fun printString(s: String): Ok {
      let %9: writer.T = member writer.output
      do call writer.putString(%9, s)
      let %10: writer.T = member writer.output
      let %11: Ok = call writer.putString(%10, "\n")
      return %11
    }
  }
  let probe: writer.T = call writer.file("probe.txt")
  do call writer.close(probe)
  let %12: Ok = call external "quest_system_make_directory"("probe_dir")
  let %13: Bool = call external "quest_system_is_file"("probe.txt")
  do call printBool(%13)
  let %14: Bool = call external "quest_system_is_directory"("probe.txt")
  do call printBool(%14)
  let %15: Bool = call external "quest_system_is_file"("probe_dir")
  do call printBool(%15)
  let %16: Bool = call external "quest_system_is_directory"("probe_dir")
  do call printBool(%16)
  let %17: Bool = call external "quest_system_is_file"("does_not_exist_abc_123.txt")
  do call printBool(%17)
  let %18: Bool = call external "quest_system_is_directory"("does_not_exist_abc_123.txt")
  do call printBool(%18)
  let testDir: String = "tmp_system_fs_test"
  let %19: Ok = call external "quest_system_make_directory"(testDir)
  let %20: Bool = call external "quest_system_is_directory"(testDir)
  do call printBool(%20)
  let subDir: String = "tmp_system_fs_test/nested/deep"
  let %21: Ok = call external "quest_system_make_directory"(subDir)
  let %22: Bool = call external "quest_system_is_directory"(subDir)
  do call printBool(%22)
  let fileA: String = "tmp_system_fs_test/nested/fileA.txt"
  let w: writer.T = call writer.file(fileA)
  do call writer.putString(w, "hello world\n")
  do call writer.close(w)
  let %23: Bool = call external "quest_system_is_file"(fileA)
  do call printBool(%23)
  let fileB: String = "tmp_system_fs_test/nested/fileB.txt"
  let %24: Ok = call external "quest_system_rename_file"(fileA, fileB)
  let %25: Bool = call external "quest_system_file_exists"(fileA)
  do call printBool(%25)
  let %26: Bool = call external "quest_system_is_file"(fileB)
  do call printBool(%26)
  let %27: Ok = call external "quest_system_remove_file"(fileB)
  let %28: Bool = call external "quest_system_file_exists"(fileB)
  do call printBool(%28)
  let subFile1: String = "tmp_system_fs_test/nested/deep/file1.txt"
  let w1: writer.T = call writer.file(subFile1)
  do call writer.putString(w1, "1")
  do call writer.close(w1)
  let subFile2: String = "tmp_system_fs_test/nested/deep/file2.txt"
  let w2: writer.T = call writer.file(subFile2)
  do call writer.putString(w2, "2")
  do call writer.close(w2)
  let entries: Array(String) = call system.listDirectory(subDir)
  let %29: Int = prim extent(entries)
  do call printInt(%29)
  let %30: String = index(entries, 0)
  do call printString(%30)
  let %31: String = index(entries, 1)
  do call printString(%31)
  let %32: Ok = call external "quest_system_remove_file"(subFile1)
  let %33: Ok = call external "quest_system_remove_file"(subFile2)
  let %34: Ok = call external "quest_system_remove_directory"(subDir)
  let %35: Ok = call external "quest_system_remove_directory"("tmp_system_fs_test/nested")
  let origCwd: String = call external "quest_system_current_directory"()
  let %36: Ok = call external "quest_system_change_directory"(testDir)
  let newCwd: String = call external "quest_system_current_directory"()
  let %37: Bool = call external "quest_string_equal"(origCwd, newCwd)
  do call printBool(%37)
  let %38: Ok = call external "quest_system_change_directory"(origCwd)
  let %39: String = call external "quest_system_current_directory"()
  let %40: Bool = call external "quest_string_equal"(origCwd, %39)
  do call printBool(%40)
  let %41: Ok = call external "quest_system_remove_directory"(testDir)
  let %42: Bool = call external "quest_system_file_exists"(testDir)
  do call printBool(%42)
  let %43: Exception = member system.error
  try catching (%43) {
    let %44: Ok = call external "quest_system_remove_file"("does_not_exist_xyz_999.txt")
    do call printString("FAIL: should have raised")
  } handle (e: Exception) {
    let %45: Bool = prim is(e, %43)
    if %45 {
      do call printString("CAUGHT: system.error")
    } else {
      reraise e
    }
  }
}

