import system = "system" : System
import writer = "writer" : Writer
import conv = "conv" : Conv
import arrayOp = "arrayOp" : ArrayOp
import string = "string" : StringOp
main {
  funs {
    fun printBool(b: Bool): Ok {
      let %1: writer.T = member writer.output @7:26
      let %2: String = call conv.bool(b) @7:40
      do call writer.putString(%1, %2) @7:9
      let %3: writer.T = member writer.output @8:26
      let %4: Ok = call writer.putString(%3, "\n") @8:9
      return %4
    }
  }
  funs {
    fun printInt(n: Int): Ok {
      let %5: writer.T = member writer.output @13:26
      let %6: String = call conv.int(n) @13:40
      do call writer.putString(%5, %6) @13:9
      let %7: writer.T = member writer.output @14:26
      let %8: Ok = call writer.putString(%7, "\n") @14:9
      return %8
    }
  }
  funs {
    fun printString(s: String): Ok {
      let %9: writer.T = member writer.output @19:26
      do call writer.putString(%9, s) @19:9
      let %10: writer.T = member writer.output @20:26
      let %11: Ok = call writer.putString(%10, "\n") @20:9
      return %11
    }
  }
  let probe: writer.T = call writer.file("probe.txt") @27:13
  do call writer.close(probe) @28:1
  do call system.makeDirectory("probe_dir") @29:1
  let %12: Bool = call system.isFile("probe.txt") @30:11
  do call printBool(%12) @30:1
  let %13: Bool = call system.isDirectory("probe.txt") @31:11
  do call printBool(%13) @31:1
  let %14: Bool = call system.isFile("probe_dir") @32:11
  do call printBool(%14) @32:1
  let %15: Bool = call system.isDirectory("probe_dir") @33:11
  do call printBool(%15) @33:1
  let %16: Bool = call system.isFile("does_not_exist_abc_123.txt") @34:11
  do call printBool(%16) @34:1
  let %17: Bool = call system.isDirectory("does_not_exist_abc_123.txt") @35:11
  do call printBool(%17) @35:1
  let testDir: String = "tmp_system_fs_test" @38:15
  do call system.makeDirectory(testDir) @39:1
  let %18: Bool = call system.isDirectory(testDir) @40:11
  do call printBool(%18) @40:1
  let subDir: String = "tmp_system_fs_test/nested/deep" @42:14
  do call system.makeDirectory(subDir) @43:1
  let %19: Bool = call system.isDirectory(subDir) @44:11
  do call printBool(%19) @44:1
  let fileA: String = "tmp_system_fs_test/nested/fileA.txt" @47:13
  let w: writer.T = call writer.file(fileA) @48:9
  do call writer.putString(w, "hello world\n") @49:1
  do call writer.close(w) @50:1
  let %20: Bool = call system.isFile(fileA) @52:11
  do call printBool(%20) @52:1
  let fileB: String = "tmp_system_fs_test/nested/fileB.txt" @54:13
  do call system.renameFile(fileA, fileB) @55:1
  let %21: Bool = call system.fileExists(fileA) @56:11
  do call printBool(%21) @56:1
  let %22: Bool = call system.isFile(fileB) @57:11
  do call printBool(%22) @57:1
  do call system.removeFile(fileB) @59:1
  let %23: Bool = call system.fileExists(fileB) @60:11
  do call printBool(%23) @60:1
  let subFile1: String = "tmp_system_fs_test/nested/deep/file1.txt" @63:16
  let w1: writer.T = call writer.file(subFile1) @64:10
  do call writer.putString(w1, "1") @65:1
  do call writer.close(w1) @66:1
  let subFile2: String = "tmp_system_fs_test/nested/deep/file2.txt" @68:16
  let w2: writer.T = call writer.file(subFile2) @69:10
  do call writer.putString(w2, "2") @70:1
  do call writer.close(w2) @71:1
  let entries: Array(String) = call system.listDirectory(subDir) @73:15
  let %24: Int = prim extent(entries) @74:10
  do call printInt(%24) @74:1
  let %25: String = index(entries, 0) @75:13
  do call printString(%25) @75:1
  let %26: String = index(entries, 1) @76:13
  do call printString(%26) @76:1
  do call system.removeFile(subFile1) @78:1
  do call system.removeFile(subFile2) @79:1
  do call system.removeDirectory(subDir) @80:1
  do call system.removeDirectory("tmp_system_fs_test/nested") @81:1
  let origCwd: String = call system.currentDirectory() @84:15
  do call system.changeDirectory(testDir) @85:1
  let newCwd: String = call system.currentDirectory() @86:14
  let %27: Bool = call string.equal(origCwd, newCwd) @87:11
  do call printBool(%27) @87:1
  do call system.changeDirectory(origCwd) @88:1
  let %28: String = call system.currentDirectory() @89:32
  let %29: Bool = call string.equal(origCwd, %28) @89:11
  do call printBool(%29) @89:1
  do call system.removeDirectory(testDir) @91:1
  let %30: Bool = call system.fileExists(testDir) @92:11
  do call printBool(%30) @92:1
  let %31: Exception = member system.error @100:6
  try catching (%31) {
    do call system.removeFile("does_not_exist_xyz_999.txt") @97:9
    do call printString("FAIL: should have raised") @98:9
  } handle (e: Exception) {
    let %32: Bool = prim is(e, %31) @95:1
    if %32 { @95:1
      do call printString("CAUGHT: system.error") @101:5
    } else {
      reraise e @95:1
    }
  }
}

