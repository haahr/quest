import system = "system" : System
import writer = "writer" : Writer
import conv = "conv" : Conv
import arrayOp = "arrayOp" : ArrayOp
import string = "string" : StringOp
main {
  funs {
    fun printBool(b: Bool): Ok {
      let %1: writer.T = member writer.output
      let %2: String = call conv.bool(b)
      do call writer.putString(%1, %2)
      let %3: writer.T = member writer.output
      let %4: Ok = call writer.putString(%3, "\n")
      return %4
    }
  }
  funs {
    fun printInt(n: Int): Ok {
      let %5: writer.T = member writer.output
      let %6: String = call conv.int(n)
      do call writer.putString(%5, %6)
      let %7: writer.T = member writer.output
      let %8: Ok = call writer.putString(%7, "\n")
      return %8
    }
  }
  funs {
    fun printString(s: String): Ok {
      let %9: writer.T = member writer.output
      do call writer.putString(%9, s)
      let %10: writer.T = member writer.output
      let %11: Ok = call writer.putString(%10, "\n")
      return %11
    }
  }
  let probe: writer.T = call writer.file("probe.txt")
  do call writer.close(probe)
  do call system.makeDirectory("probe_dir")
  let %12: Bool = call system.isFile("probe.txt")
  do call printBool(%12)
  let %13: Bool = call system.isDirectory("probe.txt")
  do call printBool(%13)
  let %14: Bool = call system.isFile("probe_dir")
  do call printBool(%14)
  let %15: Bool = call system.isDirectory("probe_dir")
  do call printBool(%15)
  let %16: Bool = call system.isFile("does_not_exist_abc_123.txt")
  do call printBool(%16)
  let %17: Bool = call system.isDirectory("does_not_exist_abc_123.txt")
  do call printBool(%17)
  let testDir: String = "tmp_system_fs_test"
  do call system.makeDirectory(testDir)
  let %18: Bool = call system.isDirectory(testDir)
  do call printBool(%18)
  let subDir: String = "tmp_system_fs_test/nested/deep"
  do call system.makeDirectory(subDir)
  let %19: Bool = call system.isDirectory(subDir)
  do call printBool(%19)
  let fileA: String = "tmp_system_fs_test/nested/fileA.txt"
  let w: writer.T = call writer.file(fileA)
  do call writer.putString(w, "hello world\n")
  do call writer.close(w)
  let %20: Bool = call system.isFile(fileA)
  do call printBool(%20)
  let fileB: String = "tmp_system_fs_test/nested/fileB.txt"
  do call system.renameFile(fileA, fileB)
  let %21: Bool = call system.fileExists(fileA)
  do call printBool(%21)
  let %22: Bool = call system.isFile(fileB)
  do call printBool(%22)
  do call system.removeFile(fileB)
  let %23: Bool = call system.fileExists(fileB)
  do call printBool(%23)
  let subFile1: String = "tmp_system_fs_test/nested/deep/file1.txt"
  let w1: writer.T = call writer.file(subFile1)
  do call writer.putString(w1, "1")
  do call writer.close(w1)
  let subFile2: String = "tmp_system_fs_test/nested/deep/file2.txt"
  let w2: writer.T = call writer.file(subFile2)
  do call writer.putString(w2, "2")
  do call writer.close(w2)
  let entries: Array(String) = call system.listDirectory(subDir)
  let %24: Int = prim extent(entries)
  do call printInt(%24)
  let %25: String = index(entries, 0)
  do call printString(%25)
  let %26: String = index(entries, 1)
  do call printString(%26)
  do call system.removeFile(subFile1)
  do call system.removeFile(subFile2)
  do call system.removeDirectory(subDir)
  do call system.removeDirectory("tmp_system_fs_test/nested")
  let origCwd: String = call system.currentDirectory()
  do call system.changeDirectory(testDir)
  let newCwd: String = call system.currentDirectory()
  let %27: Bool = call string.equal(origCwd, newCwd)
  do call printBool(%27)
  do call system.changeDirectory(origCwd)
  let %28: String = call system.currentDirectory()
  let %29: Bool = call string.equal(origCwd, %28)
  do call printBool(%29)
  do call system.removeDirectory(testDir)
  let %30: Bool = call system.fileExists(testDir)
  do call printBool(%30)
  try {
    do call system.removeFile("does_not_exist_xyz_999.txt")
    do call printString("FAIL: should have raised")
  } handle (e: Exception) {
    let %31: Exception = member system.error
    let %32: Bool = prim is(e, %31)
    if %32 {
      do call printString("CAUGHT: system.error")
    } else {
      reraise e
    }
  }
}

