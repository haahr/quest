import system = "system" : System
import writer = "writer" : Writer
import conv = "conv" : Conv
import stringOp = "string" : StringOp
main {
  funs {
    fun print(s: String): Ok {
      let %1: writer.T = member writer.output @7:45
      let %2: String = prim <>(s, "\n") @7:59
      let %3: Ok = call writer.putString(%1, %2) @7:28
      return %3
    }
  }
  funs {
    fun show(r: Tuple code: Int stdout: String stderr: String end): Ok {
      let %4: Int = tuple_field(r, 0) @9:31
      let %5: String = call conv.int(%4) @9:22
      let %6: String = tuple_field(r, 1) @9:58
      let %7: String = tuple_field(r, 2) @9:87
      let %8: String = prim <>(%7, "]") @9:87
      let %9: String = prim <>("], stderr [", %8) @9:70
      let %10: String = prim <>(%6, %9) @9:58
      let %11: String = prim <>(", stdout [", %10) @9:42
      let %12: String = prim <>(%5, %11) @9:22
      let %13: String = prim <>("code ", %12) @9:11
      let %14: Ok = call print(%13) @9:5
      return %14
    }
  }
  let %15: Array(String) = array("echo", "two  spaces", "$HOME") @12:17
  let %16: Tuple code: Int stdout: String stderr: String end = call system.run(%15) @12:6
  do call show(%16) @12:1
  let %17: Array(String) = array("sh", "-c", "echo out; echo err >&2; exit 3") @15:17
  let %18: Tuple code: Int stdout: String stderr: String end = call system.run(%17) @15:6
  do call show(%18) @15:1
  let %19: Array(String) = array("sh", "-c", "i=0; while [ $i -lt 20000 ]; do echo line; i=$((i+1)); done") @16:22
  let big: Tuple code: Int stdout: String stderr: String end = call system.run(%19) @16:11
  let %20: Int = tuple_field(big, 0) @17:27
  let %21: String = call conv.int(%20) @17:18
  let %22: String = tuple_field(big, 1) @17:72
  let %23: Int = call stringOp.length(%22) @17:56
  let %24: String = call conv.int(%23) @17:47
  let %25: String = prim <>(" ", %24) @17:40
  let %26: String = prim <>(%21, %25) @17:18
  let %27: String = prim <>("big: ", %26) @17:7
  do call print(%27) @17:1
  let %28: Array(String) = array("sh", "-c", "kill -9 $$") @20:41
  let %29: Tuple code: Int stdout: String stderr: String end = call system.run(%28) @20:30
  let %30: Int = tuple_field(%29, 0) @20:30
  let %31: String = call conv.int(%30) @20:21
  let %32: String = prim <>("killed: ", %31) @20:7
  do call print(%32) @20:1
  join k1(r.1: String) {
    do call print(r.1) @23:1
    join k2(r.2: String) {
      do call print(r.2) @24:1
    } in {
      let %33: Exception = member system.error @24:48
      try catching (%33) {
        let %34: Array(String) = array() @24:22
        let %35: Tuple code: Int stdout: String stderr: String end = call system.run(%34) @24:11
        let %36: String = tuple_field(%35, 1) @24:11
        jump k2(%36) @24:7
      } handle (e: Exception) {
        let %37: Bool = prim is(e, %33) @24:7
        if %37 { @24:7
          jump k2("no program") @24:7
        } else {
          reraise e @24:7
        }
      }
    }
  } in {
    let %38: Exception = member system.error @23:72
    try catching (%38) {
      let %39: Array(String) = array("no-such-program-quest") @23:22
      let %40: Tuple code: Int stdout: String stderr: String end = call system.run(%39) @23:11
      let %41: String = tuple_field(%40, 1) @23:11
      jump k1(%41) @23:7
    } handle (e.1: Exception) {
      let %42: Bool = prim is(e.1, %38) @23:7
      if %42 { @23:7
        jump k1("cannot run") @23:7
      } else {
        reraise e.1 @23:7
      }
    }
  }
}

