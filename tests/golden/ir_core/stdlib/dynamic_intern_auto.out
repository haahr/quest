import dynamic = "dynamic" : Dynamic
import reader = "reader" : Reader
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  funs {
    fun line(s: String): Ok {
      let %1: writer.T = member writer.output
      do call writer.putString(%1, s)
      let %2: writer.T = member writer.output
      let %3: Ok = call writer.putString(%2, "\n")
      return %3
    }
  }
  let %4: reader.T = member reader.input
  let %5: T = call dynamic.intern(%4)
  let p: Pair = call dynamic.be [Pair](%5)
  join k1(r: String) {
    do call line(r)
    let %6: reader.T = member reader.input
    let %7: T = call dynamic.intern(%6)
    let n: Named = call dynamic.be [Named](%7)
    join k2(r.1: String) {
      do call line(r.1)
      let %8: reader.T = member reader.input
      let %9: T = call dynamic.intern(%8)
      let o: Outer = call dynamic.be [Outer](%9)
      join k3(r.2: String) {
        do call line(r.2)
        let %10: reader.T = member reader.input
        let %11: T = call dynamic.intern(%10)
        let c: Cell = call dynamic.be [Cell](%11)
        join k5(r.3: String) {
          do call line(r.3)
          let %12: reader.T = member reader.input
          let %13: T = call dynamic.intern(%12)
          let ps: Record ps: Array(Pair) end = call dynamic.be [Record ps: Array(Pair) end](%13)
          join k6(r.4: String) {
            do call line(r.4)
            join k7(r.5: String) {
              do call line(r.5)
              join k9(r.6: String) {
                do call line(r.6)
              } in {
                let %14: Exception = member dynamic.error
                try catching (%14) {
                  let %15: reader.T = member reader.input
                  let %16: T = call dynamic.intern(%15)
                  jump k9("read")
                } handle (e: Exception) {
                  let %17: Bool = prim is(e, %14)
                  if %17 {
                    jump k9("rejected")
                  } else {
                    reraise e
                  }
                }
              }
            } in {
              let %18: Array(Pair) = record_field(ps, ps)
              let %19: Pair = index(%18, 1)
              inspect %19 {
                case Bool (b: Tuple a: Bool b: Bool end): {
                  join k8(r.7: String) {
                    jump k7(r.7)
                  } in {
                    let %20: Bool = tuple_field(b, 0)
                    if %20 {
                      jump k8("true")
                    } else {
                      jump k8("false")
                    }
                  }
                }
                else: {
                  jump k7("?")
                }
              }
            }
          } in {
            let %21: Array(Pair) = record_field(ps, ps)
            let %22: Pair = index(%21, 0)
            inspect %22 {
              case String (s.1: Tuple a: String b: String end): {
                let %23: String = tuple_field(s.1, 0)
                let %24: String = tuple_field(s.1, 1)
                let %25: String = prim <>(%23, %24)
                jump k6(%25)
              }
              else: {
                jump k6("?")
              }
            }
          }
        } in {
          inspect c {
            case Tuple n: Int f: Bool end exact (k: Tuple var c: Tuple n: Int f: Bool end d: Dynamic end): {
              let n.1: Int = 2
              let f: Bool = false
              let %26: Tuple n: Int f: Bool end = tuple(n.1, f)
              store k.#0 := %26
              let %27: Tuple n: Int f: Bool end = tuple_field(k, 0)
              let %28: Int = tuple_field(%27, 0)
              let %29: String = call conv.int(%28)
              let %30: Dynamic = tuple_field(k, 1)
              let %31: Char = call dynamic.be [Char](%30)
              let %32: String = call conv.char(%31)
              let %33: String = prim <>(%29, %32)
              jump k5(%33)
            }
            else: {
              jump k5("?")
            }
          }
        }
      } in {
        inspect o {
          case Int exact (v: Tuple a: Int inner: Auto B :: TYPE with b: B back: Int end end): {
            join k4(r.8: String) {
              jump k3(r.8)
            } in {
              let %34: Auto B :: TYPE with b: B back: Int end = tuple_field(v, 1)
              inspect %34 {
                case String (w: Tuple b: String back: Int end): {
                  let %35: String = tuple_field(w, 0)
                  let %36: Int = tuple_field(v, 0)
                  let %37: Int = tuple_field(w, 1)
                  let %38: Int = prim +(%36, %37)
                  let %39: String = call conv.int(%38)
                  let %40: String = prim <>(%35, %39)
                  jump k4(%40)
                }
                else: {
                  jump k4("?")
                }
              }
            }
          }
          else: {
            jump k3("?")
          }
        }
      }
    } in {
      inspect n {
        case Record name: String age: Int end (r.9: Tuple x: Record name: String age: Int end end): {
          let %41: Record name: String age: Int end = tuple_field(r.9, 0)
          let %42: String = record_field(%41, name)
          let %43: Record name: String age: Int end = tuple_field(r.9, 0)
          let %44: Int = record_field(%43, age)
          let %45: String = call conv.int(%44)
          let %46: String = prim <>(%42, %45)
          jump k2(%46)
        }
        else: {
          jump k2("?")
        }
      }
    }
  } in {
    inspect p {
      case Int (q: Tuple a: Int b: Int end): {
        let %47: Int = tuple_field(q, 0)
        let %48: Int = tuple_field(q, 1)
        let %49: Int = prim +(%47, %48)
        let %50: String = call conv.int(%49)
        jump k1(%50)
      }
      else: {
        jump k1("?")
      }
    }
  }
}

