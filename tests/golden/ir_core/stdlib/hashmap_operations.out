  do call vector.forEach [Int](ksReinserted, f.5) @110:1
  do call printNewline(0) @111:1
  let m2: hashMap.T(Int Int) = call hashMap.newWithCapacity [Int Int](8, intEqual, intHash) @114:10
  var i: Int = 1 @115:1
  let %44: Bool = prim <=(i, 50) @115:1
  if %44 { @115:1
    loop L1 {
      let i.1: Int = i @115:1
      let %45: Int = prim *(i.1, 10) @116:26
      let %46: Bool = call hashMap.insert [Int Int](m2, i.1, %45) @116:5
      let %47: Bool = prim is(i, 50) @115:1
      if %47 { @115:1
        break L1 @115:1
      }
      let %48: Int = prim +(i, 1) @115:1
      i := %48 @115:1
    }
  }
  let %49: Int = call hashMap.size [Int Int](m2) @118:10
  do call printInt(%49) @118:1
  let %50: Int = call hashMap.find [Int Int](m2, 25) @119:10
  do call printInt(%50) @119:1
  let %51: Int = call hashMap.find [Int Int](m2, 50) @120:10
  do call printInt(%51) @120:1
  do call printNewline(0) @121:1
  var i.2: Int = 1 @124:1
  let %52: Bool = prim <=(i.2, 50) @124:1
  if %52 { @124:1
    loop L2 {
      let i.3: Int = i.2 @124:1
      let %53: Int = prim %(i.3, 2) @125:9
      let %54: Bool = prim is(%53, 0) @125:9
      if %54 { @125:5
        let %55: maybe.T(Int) = call hashMap.delete [Int Int](m2, i.3) @126:9
      }
      let %56: Bool = prim is(i.2, 50) @124:1
      if %56 { @124:1
        break L2 @124:1
      }
      let %57: Int = prim +(i.2, 1) @124:1
      i.2 := %57 @124:1
    }
  }
  let %58: Int = call hashMap.size [Int Int](m2) @129:10
  do call printInt(%58) @129:1
  let %59: Bool = call hashMap.contains [Int Int](m2, 2) @130:11
  do call printBool(%59) @130:1
  let %60: Bool = call hashMap.contains [Int Int](m2, 3) @131:11
  do call printBool(%60) @131:1
  let %61: Int = call hashMap.find [Int Int](m2, 3) @132:10
  do call printInt(%61) @132:1
  do call printNewline(0) @133:1
  do call hashMap.clear [Int Int](m2) @136:1
  let %62: Int = call hashMap.size [Int Int](m2) @137:10
  do call printInt(%62) @137:1
  let %63: Bool = call hashMap.empty [Int Int](m2) @138:11
  do call printBool(%63) @138:1
  do call printNewline(0) @139:1
