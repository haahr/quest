    }
  }
  do call vector.forEach [String](vs, f.1) @74:1
  do call printNewline(0) @75:1
  funs {
    fun f.2(k.1: Int, v.1: String): Ok {
      do call printInt(k.1) @78:5
      let %31: Ok = call printString(v.1) @79:5
      return %31
    }
  }
  do call hashMap.forEach [Int String](m, f.2) @77:1
  do call printNewline(0) @81:1
  let es: vector.T(Entry(Int String)) = call hashMap.entries [Int String](m) @84:10
  funs {
    fun f.3(e: hashMap.Entry(Int String)): Ok {
      let %32: Int = record_field(e, key) @86:14
      do call printInt(%32) @86:5
      let %33: String = record_field(e, value) @87:17
      let %34: Ok = call printString(%33) @87:5
      return %34
    }
  }
  do call vector.forEach [hashMap.Entry(Int String)](es, f.3) @85:1
  do call printNewline(0) @89:1
  let d2: maybe.T(String) = call hashMap.delete [Int String](m, 2) @92:10
  let %35: Bool = call maybe.isSome [String](d2) @93:11
  do call printBool(%35) @93:1
  let %36: String = call maybe.unwrap [String](d2) @94:13
  do call printString(%36) @94:1
  let %37: Int = call hashMap.size [Int String](m) @95:10
  do call printInt(%37) @95:1
  let %38: Bool = call hashMap.contains [Int String](m, 2) @96:11
  do call printBool(%38) @96:1
  let d4: maybe.T(String) = call hashMap.delete [Int String](m, 4) @97:10
