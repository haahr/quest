import hashMap = "collections/hashMap" : collections/HashMap
import vector = "collections/vector" : collections/Vector
import maybe = "util/maybe" : util/Maybe
import word = "word" : Word
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @10:12
  funs {
    fun printInt(n: Int): Ok {
      let %1: String = call conv.int(n) @14:31
      do call writer.putString(wOut, %1) @14:9
      let %2: Ok = call writer.putString(wOut, " ") @15:9
      return %2
    }
  }
  funs {
    fun printBool(b: Bool): Ok {
      let %3: String = call conv.bool(b) @20:31
      do call writer.putString(wOut, %3) @20:9
      let %4: Ok = call writer.putString(wOut, " ") @21:9
      return %4
    }
  }
  funs {
    fun printString(s: String): Ok {
      do call writer.putString(wOut, s) @26:9
      let %5: Ok = call writer.putString(wOut, " ") @27:9
      return %5
    }
  }
  funs {
    fun printNewline(dummy: Int): Ok {
      let %6: Ok = call writer.putString(wOut, "\n") @31:5
      return %6
    }
  }
  funs {
    fun intEqual(a: Int, b.1: Int): Bool {
      let %7: Bool = prim is(a, b.1) @34:37
      return %7
    }
  }
  funs {
    fun intHash(a.1: Int): word.T {
      let %8: word.T = call word.fromInt(a.1) @36:14
      let %9: word.T = call word.fromInt(2654435761) @36:30
      let %10: word.T = call word.mul(%8, %9) @36:5
      return %10
    }
  }
  let m: hashMap.T(Int String) = call hashMap.new [Int String](intEqual, intHash) @39:9
  let %11: Bool = call hashMap.empty [Int String](m) @40:11
  do call printBool(%11) @40:1
  let %12: Int = call hashMap.size [Int String](m) @41:10
  do call printInt(%12) @41:1
  do call printNewline(0) @42:1
  let %13: Bool = call hashMap.insert [Int String](m, 1, "one") @45:11
  do call printBool(%13) @45:1
  let %14: Bool = call hashMap.insert [Int String](m, 2, "two") @46:11
  do call printBool(%14) @46:1
  let %15: Bool = call hashMap.insert [Int String](m, 3, "three") @47:11
  do call printBool(%15) @47:1
  let %16: Bool = call hashMap.insert [Int String](m, 1, "ONE") @48:11
  do call printBool(%16) @48:1
  let %17: Int = call hashMap.size [Int String](m) @49:10
  do call printInt(%17) @49:1
  let %18: Bool = call hashMap.empty [Int String](m) @50:11
  do call printBool(%18) @50:1
  do call printNewline(0) @51:1
  let %19: Bool = call hashMap.contains [Int String](m, 1) @54:11
  do call printBool(%19) @54:1
  let %20: Bool = call hashMap.contains [Int String](m, 2) @55:11
  do call printBool(%20) @55:1
  let %21: Bool = call hashMap.contains [Int String](m, 4) @56:11
  do call printBool(%21) @56:1
  let %22: String = call hashMap.find [Int String](m, 1) @57:13
  do call printString(%22) @57:1
  let %23: String = call hashMap.find [Int String](m, 2) @58:13
  do call printString(%23) @58:1
  let g1: maybe.T(String) = call hashMap.get [Int String](m, 3) @59:10
  let %24: Bool = call maybe.isSome [String](g1) @60:11
  do call printBool(%24) @60:1
  let %25: String = call maybe.unwrap [String](g1) @61:13
  do call printString(%25) @61:1
  let g4: maybe.T(String) = call hashMap.get [Int String](m, 4) @62:10
  let %26: Bool = call maybe.isNone [String](g4) @63:11
  do call printBool(%26) @63:1
  do call printNewline(0) @64:1
  let ks: vector.T(Int) = call hashMap.keys [Int String](m) @67:10
  let %27: Int = call vector.length [Int](ks) @68:10
  do call printInt(%27) @68:1
  funs {
    fun f(k: Int): Ok {
      let %28: Ok = call printInt(k) @69:40
      return %28
    }
  }
  do call vector.forEach [Int](ks, f) @69:1
  do call printNewline(0) @70:1
  let vs: vector.T(String) = call hashMap.values [Int String](m) @72:10
  let %29: Int = call vector.length [String](vs) @73:10
  do call printInt(%29) @73:1
  funs {
    fun f.1(v: String): Ok {
      let %30: Ok = call printString(v) @74:46
      return %30
    }
  }
  do call vector.forEach [String](vs, f.1) @74:1
  do call printNewline(0) @75:1
  funs {
    fun f.2(k.1: Int, v.1: String): Ok {
      do call printInt(k.1) @78:5
      let %31: Ok = call printString(v.1) @79:5
      return %31
    }
  }
  do call hashMap.forEach [Int String](m, f.2) @77:1
  do call printNewline(0) @81:1
  let d2: maybe.T(String) = call hashMap.delete [Int String](m, 2) @84:10
  let %32: Bool = call maybe.isSome [String](d2) @85:11
  do call printBool(%32) @85:1
  let %33: String = call maybe.unwrap [String](d2) @86:13
  do call printString(%33) @86:1
  let %34: Int = call hashMap.size [Int String](m) @87:10
  do call printInt(%34) @87:1
  let %35: Bool = call hashMap.contains [Int String](m, 2) @88:11
  do call printBool(%35) @88:1
  let d4: maybe.T(String) = call hashMap.delete [Int String](m, 4) @89:10
  let %36: Bool = call maybe.isNone [String](d4) @90:11
  do call printBool(%36) @90:1
  do call printNewline(0) @91:1
  let ksAfter: vector.T(Int) = call hashMap.keys [Int String](m) @94:15
  let %37: Int = call vector.length [Int](ksAfter) @95:10
  do call printInt(%37) @95:1
  funs {
    fun f.3(k.2: Int): Ok {
      let %38: Ok = call printInt(k.2) @96:45
      return %38
    }
  }
  do call vector.forEach [Int](ksAfter, f.3) @96:1
  do call printNewline(0) @97:1
  let %39: Bool = call hashMap.insert [Int String](m, 2, "two_reinserted") @100:11
  do call printBool(%39) @100:1
  let ksReinserted: vector.T(Int) = call hashMap.keys [Int String](m) @101:20
  funs {
    fun f.4(k.3: Int): Ok {
      let %40: Ok = call printInt(k.3) @102:50
      return %40
    }
  }
  do call vector.forEach [Int](ksReinserted, f.4) @102:1
  do call printNewline(0) @103:1
  let m2: hashMap.T(Int Int) = call hashMap.newWithCapacity [Int Int](8, intEqual, intHash) @106:10
  var i: Int = 1 @107:1
  let %41: Bool = prim <=(i, 50) @107:1
  if %41 { @107:1
    loop L1 {
      let i.1: Int = i @107:1
      let %42: Int = prim *(i.1, 10) @108:26
      let %43: Bool = call hashMap.insert [Int Int](m2, i.1, %42) @108:5
      let %44: Bool = prim is(i, 50) @107:1
      if %44 { @107:1
        break L1 @107:1
      }
      let %45: Int = prim +(i, 1) @107:1
      i := %45 @107:1
    }
  }
  let %46: Int = call hashMap.size [Int Int](m2) @110:10
  do call printInt(%46) @110:1
  let %47: Int = call hashMap.find [Int Int](m2, 25) @111:10
  do call printInt(%47) @111:1
  let %48: Int = call hashMap.find [Int Int](m2, 50) @112:10
  do call printInt(%48) @112:1
  do call printNewline(0) @113:1
  var i.2: Int = 1 @116:1
  let %49: Bool = prim <=(i.2, 50) @116:1
  if %49 { @116:1
    loop L2 {
      let i.3: Int = i.2 @116:1
      let %50: Int = prim %(i.3, 2) @117:9
      let %51: Bool = prim is(%50, 0) @117:9
      if %51 { @117:5
        let %52: maybe.T(Int) = call hashMap.delete [Int Int](m2, i.3) @118:9
      }
      let %53: Bool = prim is(i.2, 50) @116:1
      if %53 { @116:1
        break L2 @116:1
      }
      let %54: Int = prim +(i.2, 1) @116:1
      i.2 := %54 @116:1
    }
  }
  let %55: Int = call hashMap.size [Int Int](m2) @121:10
  do call printInt(%55) @121:1
  let %56: Bool = call hashMap.contains [Int Int](m2, 2) @122:11
  do call printBool(%56) @122:1
  let %57: Bool = call hashMap.contains [Int Int](m2, 3) @123:11
  do call printBool(%57) @123:1
  let %58: Int = call hashMap.find [Int Int](m2, 3) @124:10
  do call printInt(%58) @124:1
  do call printNewline(0) @125:1
  do call hashMap.clear [Int Int](m2) @128:1
  let %59: Int = call hashMap.size [Int Int](m2) @129:10
  do call printInt(%59) @129:1
  let %60: Bool = call hashMap.empty [Int Int](m2) @130:11
  do call printBool(%60) @130:1
  do call printNewline(0) @131:1
}

