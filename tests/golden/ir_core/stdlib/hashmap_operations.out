      return %5
    }
  }
  funs {
    fun printNewline(dummy: Int): Ok {
      let %6: Ok = call writer.putString(wOut, "\n") @31:5
      return %6
    }
  }
  funs {
    fun intEqual(a: Int, b.1: Int): Bool {
      let %7: Bool = prim is(a, b.1) @34:37
      return %7
    }
  }
  funs {
    fun intHash(a.1: Int): word.T {
      let %8: word.T = call word.fromInt(a.1) @36:14
      let %9: word.T = call word.fromInt(2654435761) @36:30
      let %10: word.T = call word.mul(%8, %9) @36:5
      return %10
    }
  }
  let m: hashMap.T(Int String) = call hashMap.new [Int String](intEqual, intHash) @39:9
  let %11: Bool = call hashMap.empty [Int String](m) @40:11
  do call printBool(%11) @40:1
  let %12: Int = call hashMap.size [Int String](m) @41:10
  do call printInt(%12) @41:1
  do call printNewline(0) @42:1
  let %13: Bool = call hashMap.insert [Int String](m, 1, "one") @45:11
  do call printBool(%13) @45:1
  let %14: Bool = call hashMap.insert [Int String](m, 2, "two") @46:11
  do call printBool(%14) @46:1
  let %15: Bool = call hashMap.insert [Int String](m, 3, "three") @47:11
  do call printBool(%15) @47:1
  let %16: Bool = call hashMap.insert [Int String](m, 1, "ONE") @48:11
  do call printBool(%16) @48:1
  let %17: Int = call hashMap.size [Int String](m) @49:10
  do call printInt(%17) @49:1
  let %18: Bool = call hashMap.empty [Int String](m) @50:11
  do call printBool(%18) @50:1
  do call printNewline(0) @51:1
  let %19: Bool = call hashMap.contains [Int String](m, 1) @54:11
