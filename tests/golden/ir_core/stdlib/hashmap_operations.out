  let %20: Bool = call hashMap.contains [Int String](m, 2) @55:11
  do call printBool(%20) @55:1
  let %21: Bool = call hashMap.contains [Int String](m, 4) @56:11
  do call printBool(%21) @56:1
  let %22: String = call hashMap.find [Int String](m, 1) @57:13
  do call printString(%22) @57:1
  let %23: String = call hashMap.find [Int String](m, 2) @58:13
  do call printString(%23) @58:1
  let g1: maybe.T(String) = call hashMap.get [Int String](m, 3) @59:10
  let %24: Bool = call maybe.isSome [String](g1) @60:11
  do call printBool(%24) @60:1
  let %25: String = call maybe.unwrap [String](g1) @61:13
  do call printString(%25) @61:1
  let g4: maybe.T(String) = call hashMap.get [Int String](m, 4) @62:10
  let %26: Bool = call maybe.isNone [String](g4) @63:11
  do call printBool(%26) @63:1
  do call printNewline(0) @64:1
  let ks: vector.T(Int) = call hashMap.keys [Int String](m) @67:10
  let %27: Int = call vector.length [Int](ks) @68:10
  do call printInt(%27) @68:1
  funs {
    fun f(k: Int): Ok {
      let %28: Ok = call printInt(k) @69:40
      return %28
    }
  }
  do call vector.forEach [Int](ks, f) @69:1
  do call printNewline(0) @70:1
  let vs: vector.T(String) = call hashMap.values [Int String](m) @72:10
  let %29: Int = call vector.length [String](vs) @73:10
  do call printInt(%29) @73:1
  funs {
    fun f.1(v: String): Ok {
      let %30: Ok = call printString(v) @74:46
