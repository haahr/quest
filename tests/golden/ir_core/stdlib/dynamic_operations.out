import dynamic = "dynamic" : Dynamic
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let d: T = call dynamic.new [Int](12345)
  let x: Int = call dynamic.be [Int](d)
  let %1: writer.T = member writer.output
  let %2: String = call external "quest_conv_int"(x)
  do call writer.putString(%1, %2)
  let %3: writer.T = member writer.output
  do call writer.putString(%3, "\n")
}

