import dynamic = "dynamic" : Dynamic
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let d: T = call dynamic.new [Int](12345) @7:9
  let x: Int = call dynamic.be [Int](d) @8:14
  let %1: writer.T = member writer.output @9:18
  let %2: String = call conv.int(x) @9:32
  do call writer.putString(%1, %2) @9:1
  let %3: writer.T = member writer.output @10:18
  do call writer.putString(%3, "\n") @10:1
}

