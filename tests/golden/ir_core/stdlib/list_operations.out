import list = "list" : List
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let l0: list.T(Int) = type_app list.nil [Int] @7:10
  let b0: Bool = call list.null [Int](l0) @8:10
  let l1: list.T(Int) = call list.cons [Int](10, l0) @9:10
  let l2: list.T(Int) = call list.cons [Int](20, l1) @10:10
  let l3: list.T(Int) = call list.cons [Int](30, l2) @11:10
  let len: Int = call list.length [Int](l3) @12:11
  let h: Int = call list.head [Int](l3) @13:9
  let %1: list.T(Int) = call list.tail [Int](l3) @14:24
  let t: Int = call list.head [Int](%1) @14:9
  let %2: writer.T = member writer.output @16:18
  let %3: String = call conv.bool(b0) @16:32
  do call writer.putString(%2, %3) @16:1
  let %4: writer.T = member writer.output @17:18
  do call writer.putString(%4, " ") @17:1
  let %5: writer.T = member writer.output @18:18
  let %6: String = call conv.int(len) @18:32
  do call writer.putString(%5, %6) @18:1
  let %7: writer.T = member writer.output @19:18
  do call writer.putString(%7, " ") @19:1
  let %8: writer.T = member writer.output @20:18
  let %9: String = call conv.int(h) @20:32
  do call writer.putString(%8, %9) @20:1
  let %10: writer.T = member writer.output @21:18
  do call writer.putString(%10, " ") @21:1
  let %11: writer.T = member writer.output @22:18
  let %12: String = call conv.int(t) @22:32
  do call writer.putString(%11, %12) @22:1
  let %13: writer.T = member writer.output @23:18
  do call writer.putString(%13, "\n") @23:1
}

