import list = "list" : List
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let l0: list.T(Int) = type_app list.nil [Int]
  let b0: Bool = call list.null [Int](l0)
  let l1: list.T(Int) = call list.cons [Int](10, l0)
  let l2: list.T(Int) = call list.cons [Int](20, l1)
  let l3: list.T(Int) = call list.cons [Int](30, l2)
  let len: Int = call list.length [Int](l3)
  let h: Int = call list.head [Int](l3)
  let %1: list.T(Int) = call list.tail [Int](l3)
  let t: Int = call list.head [Int](%1)
  let %2: writer.T = member writer.output
  let %3: String = call conv.bool(b0)
  do call writer.putString(%2, %3)
  let %4: writer.T = member writer.output
  do call writer.putString(%4, " ")
  let %5: writer.T = member writer.output
  let %6: String = call external "quest_conv_int"(len)
  do call writer.putString(%5, %6)
  let %7: writer.T = member writer.output
  do call writer.putString(%7, " ")
  let %8: writer.T = member writer.output
  let %9: String = call external "quest_conv_int"(h)
  do call writer.putString(%8, %9)
  let %10: writer.T = member writer.output
  do call writer.putString(%10, " ")
  let %11: writer.T = member writer.output
  let %12: String = call external "quest_conv_int"(t)
  do call writer.putString(%11, %12)
  let %13: writer.T = member writer.output
  do call writer.putString(%13, "\n")
}

