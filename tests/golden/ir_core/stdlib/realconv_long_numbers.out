import writer = "writer" : Writer
import string = "string" : StringOp
import realconv = "util/realconv" : util/RealConv
main {
  funs {
    fun show(s: String): Ok {
      let %1: writer.T = member writer.output @11:44
      let %2: Real = call realconv.toReal(s) @11:74
      let %3: String = call realconv.format(%2, 'e', 17) @11:58
      let %4: String = prim <>(%3, "\n") @11:58
      let %5: Ok = call writer.putString(%1, %4) @11:27
      return %5
    }
  }
  let half: String = "1.00000000000000011102230246251565404236316680908203125" @13:12
  do call show(half) @14:1
  let %6: String = call string.new(1000, '0') @15:14
  let %7: String = prim <>(%6, "1") @15:14
  let %8: String = prim <>(half, %7) @15:6
  do call show(%8) @15:1
  let %9: String = call string.new(1000, '0') @16:14
  let %10: String = prim <>(half, %9) @16:6
  do call show(%10) @16:1
  do call show("0.99999999999999994448884876874217297882") @17:1
  let %11: String = call string.new(400, '0') @18:13
  let %12: String = prim <>("1", %11) @18:6
  do call show(%12) @18:1
  let %13: String = call string.new(320, '0') @19:13
  let %14: String = prim <>("1", %13) @19:6
  do call show(%14) @19:1
  let %15: String = call string.new(330, '0') @20:14
  let %16: String = prim <>(%15, "1") @20:14
  let %17: String = prim <>("0.", %16) @20:6
  do call show(%17) @20:1
  let %18: String = call string.new(320, '0') @21:14
  let %19: String = prim <>(%18, "4940656458412465441765687928682213723651") @21:14
  let %20: String = prim <>("0.", %19) @21:6
  do call show(%20) @21:1
  let %21: String = call string.new(2000, '7') @22:21
  let %22: String = prim <>(%21, "e-2000") @22:21
  let %23: String = prim <>("123456789", %22) @22:6
  do call show(%23) @22:1
}

