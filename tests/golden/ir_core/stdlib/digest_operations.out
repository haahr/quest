import digest = "util/digest" : util/Digest
import stringOp = "string" : StringOp
import ascii = "ascii" : Ascii
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  funs {
    fun print(s: String): Ok {
      let %1: writer.T = member writer.output @14:45
      let %2: String = prim <>(s, "\n") @14:59
      let %3: Ok = call writer.putString(%1, %2) @14:28
      return %3
    }
  }
  funs {
    fun check(what: String, holds: Bool): Ok {
      let %4: String = call conv.bool(holds) @15:65
      let %5: String = prim <>(": ", %4) @15:57
      let %6: String = prim <>(what, %5) @15:49
      let %7: Ok = call print(%6) @15:43
      return %7
    }
  }
  funs {
    fun letters(n: Int): String {
      let %8: String = call stringOp.new(n, 'a') @19:31
      return %8
    }
  }
  let %9: Char = call ascii.char(0) @21:30
  let s.1: String = call stringOp.new(512, %9) @21:13
  var i: Int = 0 @22:5
  let %10: Bool = prim <=(i, 511) @22:5
  if %10 { @22:5
    loop L1 {
      let i.1: Int = i @22:5
      let %11: Int = prim %(i.1, 256) @22:59
      let %12: Char = call ascii.char(%11) @22:48
      do call stringOp.setChar(s.1, i.1, %12) @22:27
      let %13: Bool = prim is(i, 511) @22:5
      if %13 { @22:5
        break L1 @22:5
      }
      let %14: Int = prim +(i, 1) @22:5
      i := %14 @22:5
    }
  }
  let allBytes: String = s.1 @23:5
  let %15: String = call digest.sha256Hex("") @27:27
  let %16: String = prim <>("sha256 empty: ", %15) @27:7
  do call print(%16) @27:1
  let %17: String = call digest.sha256Hex("abc") @28:25
  let %18: String = prim <>("sha256 abc: ", %17) @28:7
  do call print(%18) @28:1
  let %19: String = call digest.sha256Hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq") @29:28
  let %20: String = prim <>("sha256 fips56: ", %19) @29:7
  do call print(%20) @29:1
  let lengths: Array(Int) = array(1, 55, 56, 57, 63, 64, 65, 119, 120, 127, 128, 1000) @30:15
  let %21: Int = prim extent(lengths) @31:17
  let %22: Int = prim -(%21, 1) @31:17
  var k: Int = 0 @31:1
  let %23: Bool = prim <=(k, %22) @31:1
  if %23 { @31:1
    loop L2 {
      let k.1: Int = k @31:1
      let %24: Int = index(lengths, k.1) @32:35
      let %25: String = call conv.int(%24) @32:26
      let %26: Int = index(lengths, k.1) @32:83
      let %27: String = call letters(%26) @32:75
      let %28: String = call digest.sha256Hex(%27) @32:58
      let %29: String = prim <>(": ", %28) @32:50
      let %30: String = prim <>(%25, %29) @32:26
      let %31: String = prim <>("sha256 a*", %30) @32:11
      do call print(%31) @32:5
      let %32: Bool = prim is(k, %22) @31:1
      if %32 { @31:1
        break L2 @31:1
      }
      let %33: Int = prim +(k, 1) @31:1
      k := %33 @31:1
    }
  }
  let %34: String = call digest.sha256Hex(allBytes) @34:27
  let %35: String = prim <>("sha256 bytes: ", %34) @34:7
  do call print(%35) @34:1
  let part: String = call stringOp.getSub(allBytes, 0, 300) @38:12
  let whole: String = call digest.sha256Of(part) @39:13
  var pieces: Bool = true @40:1
  let d: digest.T = call digest.sha256() @41:9
  let sizes: Array(Int) = array(1, 2, 3, 5, 7, 13, 31, 55, 56, 63, 64, 65, 70, 129) @42:13
  let %36: Int = prim extent(sizes) @43:17
  let %37: Int = prim -(%36, 1) @43:17
  var k.2: Int = 0 @43:1
  let %38: Bool = prim <=(k.2, %37) @43:1
  if %38 { @43:1
    loop L3 {
      let k.3: Int = k.2 @43:1
      let size: Int = index(sizes, k.3) @44:16
      var i.2: Int = 0 @45:5
      loop L4 {
        let %39: Bool = prim <(i.2, 300) @46:11
        if %39 { @46:5
          join k1(n.1: Int) {
            let %40: Int = prim %(size, 3) @48:13
            let %41: Bool = prim is(%40, 0) @48:13
            if %41 { @48:9
              let %42: String = call stringOp.getSub(part, i.2, n.1) @49:26
              do call digest.add(d, %42) @49:13
            } else {
              let %43: Int = prim %(size, 3) @50:16
              let %44: Bool = prim is(%43, 1) @50:16
              if %44 { @50:16
                do call digest.addSub(d, part, i.2, n.1) @51:13
              } else {
                let %45: Int = prim +(i.2, n.1) @53:30
                let %46: Int = prim -(%45, 1) @53:30
                var j: Int = i.2 @53:13
                let %47: Bool = prim <=(j, %46) @53:13
                if %47 { @53:13
                  loop L5 {
                    let j.1: Int = j @53:13
                    let %48: Char = call stringOp.getChar(part, j.1) @53:62
                    do call digest.addChar(d, %48) @53:45
                    let %49: Bool = prim is(j, %46) @53:13
                    if %49 { @53:13
                      break L5 @53:13
                    }
                    let %50: Int = prim +(j, 1) @53:13
                    j := %50 @53:13
                  }
                }
              }
            }
            let %51: Int = prim +(i.2, n.1) @55:14
            i.2 := %51 @55:9
          } in {
            let %52: Int = prim -(300, i.2) @47:21
            let %53: Bool = prim <(%52, size) @47:21
            if %53 { @47:17
              let %54: Int = prim -(300, i.2) @47:42
              jump k1(%54) @47:17
            } else {
              jump k1(size) @47:17
            }
          }
        } else {
          break L4 @46:5
        }
      }
      let %55: String = call digest.finish(d) @57:27
      let %56: Bool = call stringOp.equal(%55, whole) @57:12
      let %57: Bool = prim not(%56) @57:8
      if %57 { @57:5
        pieces := false @57:57
      }
      let %58: Bool = prim is(k.2, %37) @43:1
      if %58 { @43:1
        break L3 @43:1
      }
      let %59: Int = prim +(k.2, 1) @43:1
      k.2 := %59 @43:1
    }
  }
  do call check("pieces agree", pieces) @59:1
  do call digest.add(d, "") @60:1
  do call digest.addSub(d, "xyz", 3, 0) @61:1
  let %60: String = call digest.finish(d) @62:76
  let %61: String = call digest.hex(%60) @62:65
  let %62: String = call digest.sha256Hex("") @62:94
  let %63: Bool = call stringOp.equal(%61, %62) @62:50
  do call check("empty pieces leave the digest of nothing", %63) @62:1
  let e: digest.T = call digest.sha256() @65:9
  do call digest.add(e, "abc") @66:1
  let first: String = call digest.finish(e) @67:13
  let %64: String = call digest.hex(first) @68:48
  let %65: String = call digest.sha256Hex("abc") @68:66
  let %66: Bool = call stringOp.equal(%64, %65) @68:33
  do call check("finish gives the digest", %66) @68:1
  let %67: String = call digest.finish(e) @69:77
  let %68: String = call digest.hex(%67) @69:66
  let %69: String = call digest.sha256Hex("") @69:95
  let %70: Bool = call stringOp.equal(%68, %69) @69:51
  do call check("a second finish gives the empty message's", %70) @69:1
  let %71: Int = call digest.size(e) @70:28
  let %72: String = call conv.int(%71) @70:19
  let %73: Int = call stringOp.length(first) @70:63
  let %74: String = call conv.int(%73) @70:54
  let %75: String = prim <>(" ", %74) @70:47
  let %76: String = prim <>(%72, %75) @70:19
  let %77: String = prim <>("size: ", %76) @70:7
  do call print(%77) @70:1
  let %78: String = call stringOp.getSub(allBytes, 250, 10) @71:29
  let %79: String = call digest.hex(%78) @71:18
  let %80: String = call digest.hex("") @71:74
  let %81: String = prim <>(%80, ")") @71:74
  let %82: String = prim <>(" (", %81) @71:66
  let %83: String = prim <>(%79, %82) @71:18
  let %84: String = prim <>("hex: ", %83) @71:7
  do call print(%84) @71:1
  let %85: Int = call digest.crc32("") @74:35
  let %86: String = call conv.int(%85) @74:26
  let %87: String = prim <>("crc32 empty: ", %86) @74:7
  do call print(%87) @74:1
  let %88: Int = call digest.crc32("123456789") @75:35
  let %89: String = call conv.int(%88) @75:26
  let %90: String = prim <>("crc32 check: ", %89) @75:7
  do call print(%90) @75:1
  let %91: Int = call digest.crc32(allBytes) @76:35
  let %92: String = call conv.int(%91) @76:26
  let %93: String = prim <>("crc32 bytes: ", %92) @76:7
  do call print(%93) @76:1
  let %94: String = call letters(1000) @77:49
  let %95: Int = call digest.crc32(%94) @77:36
  let %96: String = call conv.int(%95) @77:27
  let %97: String = prim <>("crc32 a*1000: ", %96) @77:7
  do call print(%97) @77:1
  let %98: Int = call digest.crc32Add(0, "123456789") @78:25
  let %99: Int = call digest.crc32("123456789") @78:59
  let %100: Bool = prim is(%98, %99) @78:25
  do call check("crc32Add from 0", %100) @78:1
  let %101: Int = call digest.crc32("1234") @79:49
  let %102: Int = call digest.crc32Add(%101, "56789") @79:33
  let %103: Int = call digest.crc32("123456789") @79:82
  let %104: Bool = prim is(%102, %103) @79:33
  do call check("crc32Add across a split", %104) @79:1
  funs {
    fun err(what.1: String, f: Fun(): Ok): Ok {
      join k2(r: String) {
        let %105: String = prim <>(": ", r) @82:55
        let %106: String = prim <>(what.1, %105) @82:47
        let %107: Ok = call print(%106) @82:41
        return %107
      } in {
        let %108: Exception = member stringOp.error @83:42
        try catching (%108) {
          do call f() @83:18
          jump k2("no error") @83:8
        } handle (e.1: Exception) {
          let %109: Bool = prim is(e.1, %108) @83:8
          if %109 { @83:8
            jump k2("string.error") @83:8
          } else {
            reraise e.1 @83:8
          }
        }
      }
    }
  }
  funs {
    fun f.1(): Ok {
      let %110: Ok = call digest.addSub(d, "abc", 0, -1) @84:35
      return %110
    }
  }
  do call err("addSub of size ~1", f.1) @84:1
  funs {
    fun f.2(): Ok {
      let %111: Ok = call digest.addSub(d, "abc", -1, 1) @85:32
      return %111
    }
  }
  do call err("addSub from ~1", f.2) @85:1
  funs {
    fun f.3(): Ok {
      let %112: Ok = call digest.addSub(d, "abc", 2, 2) @86:37
      return %112
    }
  }
  do call err("addSub past the end", f.3) @86:1
  funs {
    fun f.4(): Ok {
      let %113: Ok = call digest.addSub(d, "abc", 3, 0) @87:35
      return %113
    }
  }
  do call err("addSub to the end", f.4) @87:1
}

