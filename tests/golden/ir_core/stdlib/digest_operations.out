import ascii = "ascii" : Ascii
import conv = "conv" : Conv
import stringOp = "string" : StringOp
import writer = "writer" : Writer
import digest = "util/digest" : util/Digest
main {
  funs {
    fun print(s: String): Ok {
      let %1: writer.T = member writer.output @15:45
      let %2: String = prim <>(s, "\n") @15:59
      let %3: Ok = call writer.putString(%1, %2) @15:28
      return %3
    }
  }
  funs {
    fun check(what: String, holds: Bool): Ok {
      let %4: String = call conv.bool(holds) @16:65
      let %5: String = prim <>(": ", %4) @16:57
      let %6: String = prim <>(what, %5) @16:49
      let %7: Ok = call print(%6) @16:43
      return %7
    }
  }
  funs {
    fun letters(n: Int): String {
      let %8: String = call stringOp.new(n, 'a') @20:31
      return %8
    }
  }
  let %9: Char = call ascii.char(0) @22:30
  let s.1: String = call stringOp.new(512, %9) @22:13
  var i: Int = 0 @23:5
  let %10: Bool = prim <=(i, 511) @23:5
  if %10 { @23:5
    loop L1 {
      let i.1: Int = i @23:5
      let %11: Int = prim %(i.1, 256) @23:59
      let %12: Char = call ascii.char(%11) @23:48
      do call stringOp.setChar(s.1, i.1, %12) @23:27
      let %13: Bool = prim is(i, 511) @23:5
      if %13 { @23:5
        break L1 @23:5
      }
      let %14: Int = prim +(i, 1) @23:5
      i := %14 @23:5
    }
  }
  let allBytes: String = s.1 @24:5
  let %15: String = call digest.sha256Hex("") @28:27
  let %16: String = prim <>("sha256 empty: ", %15) @28:7
  do call print(%16) @28:1
  let %17: String = call digest.sha256Hex("abc") @29:25
  let %18: String = prim <>("sha256 abc: ", %17) @29:7
  do call print(%18) @29:1
  let %19: String = call digest.sha256Hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq") @30:28
  let %20: String = prim <>("sha256 fips56: ", %19) @30:7
  do call print(%20) @30:1
  let lengths: Array(Int) = array(1, 55, 56, 57, 63, 64, 65, 119, 120, 127, 128, 1000) @31:15
  let %21: Int = prim extent(lengths) @32:17
  let %22: Int = prim -(%21, 1) @32:17
  var k: Int = 0 @32:1
  let %23: Bool = prim <=(k, %22) @32:1
  if %23 { @32:1
    loop L2 {
      let k.1: Int = k @32:1
      let %24: Int = index(lengths, k.1) @33:35
      let %25: String = call conv.int(%24) @33:26
      let %26: Int = index(lengths, k.1) @33:83
      let %27: String = call letters(%26) @33:75
      let %28: String = call digest.sha256Hex(%27) @33:58
      let %29: String = prim <>(": ", %28) @33:50
      let %30: String = prim <>(%25, %29) @33:26
      let %31: String = prim <>("sha256 a*", %30) @33:11
      do call print(%31) @33:5
      let %32: Bool = prim is(k, %22) @32:1
      if %32 { @32:1
        break L2 @32:1
      }
      let %33: Int = prim +(k, 1) @32:1
      k := %33 @32:1
    }
  }
  let %34: String = call digest.sha256Hex(allBytes) @35:27
  let %35: String = prim <>("sha256 bytes: ", %34) @35:7
  do call print(%35) @35:1
  let part: String = call stringOp.getSub(allBytes, 0, 300) @39:12
  let whole: String = call digest.sha256Of(part) @40:13
  var pieces: Bool = true @41:1
  let d: digest.T = call digest.sha256() @42:9
  let sizes: Array(Int) = array(1, 2, 3, 5, 7, 13, 31, 55, 56, 63, 64, 65, 70, 129) @43:13
  let %36: Int = prim extent(sizes) @44:17
  let %37: Int = prim -(%36, 1) @44:17
  var k.2: Int = 0 @44:1
  let %38: Bool = prim <=(k.2, %37) @44:1
  if %38 { @44:1
    loop L3 {
      let k.3: Int = k.2 @44:1
      let size: Int = index(sizes, k.3) @45:16
      var i.2: Int = 0 @46:5
      loop L4 {
        let %39: Bool = prim <(i.2, 300) @47:11
        if %39 { @47:5
          join k1(n.1: Int) {
            let %40: Int = prim %(size, 3) @49:13
            let %41: Bool = prim is(%40, 0) @49:13
            if %41 { @49:9
              let %42: String = call stringOp.getSub(part, i.2, n.1) @50:26
              do call digest.add(d, %42) @50:13
            } else {
              let %43: Int = prim %(size, 3) @51:16
              let %44: Bool = prim is(%43, 1) @51:16
              if %44 { @51:16
                do call digest.addSub(d, part, i.2, n.1) @52:13
              } else {
                let %45: Int = prim +(i.2, n.1) @54:30
                let %46: Int = prim -(%45, 1) @54:30
                var j: Int = i.2 @54:13
                let %47: Bool = prim <=(j, %46) @54:13
                if %47 { @54:13
                  loop L5 {
                    let j.1: Int = j @54:13
                    let %48: Char = call stringOp.getChar(part, j.1) @54:62
                    do call digest.addChar(d, %48) @54:45
                    let %49: Bool = prim is(j, %46) @54:13
                    if %49 { @54:13
                      break L5 @54:13
                    }
                    let %50: Int = prim +(j, 1) @54:13
                    j := %50 @54:13
                  }
                }
              }
            }
            let %51: Int = prim +(i.2, n.1) @56:14
            i.2 := %51 @56:9
          } in {
            let %52: Int = prim -(300, i.2) @48:21
            let %53: Bool = prim <(%52, size) @48:21
            if %53 { @48:17
              let %54: Int = prim -(300, i.2) @48:42
              jump k1(%54) @48:17
            } else {
              jump k1(size) @48:17
            }
          }
        } else {
          break L4 @47:5
        }
      }
      let %55: String = call digest.finish(d) @58:27
      let %56: Bool = call stringOp.equal(%55, whole) @58:12
      let %57: Bool = prim not(%56) @58:8
      if %57 { @58:5
        pieces := false @58:57
      }
      let %58: Bool = prim is(k.2, %37) @44:1
      if %58 { @44:1
        break L3 @44:1
      }
      let %59: Int = prim +(k.2, 1) @44:1
      k.2 := %59 @44:1
    }
  }
  do call check("pieces agree", pieces) @60:1
  do call digest.add(d, "") @61:1
  do call digest.addSub(d, "xyz", 3, 0) @62:1
  let %60: String = call digest.finish(d) @63:76
  let %61: String = call digest.hex(%60) @63:65
  let %62: String = call digest.sha256Hex("") @63:94
  let %63: Bool = call stringOp.equal(%61, %62) @63:50
  do call check("empty pieces leave the digest of nothing", %63) @63:1
  let e: digest.T = call digest.sha256() @66:9
  do call digest.add(e, "abc") @67:1
  let first: String = call digest.finish(e) @68:13
  let %64: String = call digest.hex(first) @69:48
  let %65: String = call digest.sha256Hex("abc") @69:66
  let %66: Bool = call stringOp.equal(%64, %65) @69:33
  do call check("finish gives the digest", %66) @69:1
  let %67: String = call digest.finish(e) @70:77
  let %68: String = call digest.hex(%67) @70:66
  let %69: String = call digest.sha256Hex("") @70:95
  let %70: Bool = call stringOp.equal(%68, %69) @70:51
  do call check("a second finish gives the empty message's", %70) @70:1
  let %71: Int = call digest.size(e) @71:28
  let %72: String = call conv.int(%71) @71:19
  let %73: Int = call stringOp.length(first) @71:63
  let %74: String = call conv.int(%73) @71:54
  let %75: String = prim <>(" ", %74) @71:47
  let %76: String = prim <>(%72, %75) @71:19
  let %77: String = prim <>("size: ", %76) @71:7
  do call print(%77) @71:1
  let %78: String = call stringOp.getSub(allBytes, 250, 10) @72:29
  let %79: String = call digest.hex(%78) @72:18
  let %80: String = call digest.hex("") @72:74
  let %81: String = prim <>(%80, ")") @72:74
  let %82: String = prim <>(" (", %81) @72:66
  let %83: String = prim <>(%79, %82) @72:18
  let %84: String = prim <>("hex: ", %83) @72:7
  do call print(%84) @72:1
  let %85: Int = call digest.crc32("") @75:35
  let %86: String = call conv.int(%85) @75:26
  let %87: String = prim <>("crc32 empty: ", %86) @75:7
  do call print(%87) @75:1
  let %88: Int = call digest.crc32("123456789") @76:35
  let %89: String = call conv.int(%88) @76:26
  let %90: String = prim <>("crc32 check: ", %89) @76:7
  do call print(%90) @76:1
  let %91: Int = call digest.crc32(allBytes) @77:35
  let %92: String = call conv.int(%91) @77:26
  let %93: String = prim <>("crc32 bytes: ", %92) @77:7
  do call print(%93) @77:1
  let %94: String = call letters(1000) @78:49
  let %95: Int = call digest.crc32(%94) @78:36
  let %96: String = call conv.int(%95) @78:27
  let %97: String = prim <>("crc32 a*1000: ", %96) @78:7
  do call print(%97) @78:1
  let %98: Int = call digest.crc32Add(0, "123456789") @79:25
  let %99: Int = call digest.crc32("123456789") @79:59
  let %100: Bool = prim is(%98, %99) @79:25
  do call check("crc32Add from 0", %100) @79:1
  let %101: Int = call digest.crc32("1234") @80:49
  let %102: Int = call digest.crc32Add(%101, "56789") @80:33
  let %103: Int = call digest.crc32("123456789") @80:82
  let %104: Bool = prim is(%102, %103) @80:33
  do call check("crc32Add across a split", %104) @80:1
  funs {
    fun err(what.1: String, f: Fun(): Ok): Ok {
      join k2(r: String) {
        let %105: String = prim <>(": ", r) @83:55
        let %106: String = prim <>(what.1, %105) @83:47
        let %107: Ok = call print(%106) @83:41
        return %107
      } in {
        let %108: Exception = member stringOp.error @84:42
        try catching (%108) {
          do call f() @84:18
          jump k2("no error") @84:8
        } handle (e.1: Exception) {
          let %109: Bool = prim is(e.1, %108) @84:8
          if %109 { @84:8
            jump k2("string.error") @84:8
          } else {
            reraise e.1 @84:8
          }
        }
      }
    }
  }
  funs {
    fun f.1(): Ok {
      let %110: Ok = call digest.addSub(d, "abc", 0, -1) @85:35
      return %110
    }
  }
  do call err("addSub of size ~1", f.1) @85:1
  funs {
    fun f.2(): Ok {
      let %111: Ok = call digest.addSub(d, "abc", -1, 1) @86:32
      return %111
    }
  }
  do call err("addSub from ~1", f.2) @86:1
  funs {
    fun f.3(): Ok {
      let %112: Ok = call digest.addSub(d, "abc", 2, 2) @87:37
      return %112
    }
  }
  do call err("addSub past the end", f.3) @87:1
  funs {
    fun f.4(): Ok {
      let %113: Ok = call digest.addSub(d, "abc", 3, 0) @88:35
      return %113
    }
  }
  do call err("addSub to the end", f.4) @88:1
}

