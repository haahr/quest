import conv = "conv" : Conv
import ascii = "ascii" : Ascii
import int = "int" : IntOp
import real = "real" : RealOp
import string = "string" : StringOp
import arrayOp = "arrayOp" : ArrayOp
import dynamic = "dynamic" : Dynamic
import writer = "writer" : Writer
import reader = "reader" : Reader
main {
  let %1: String = call conv.int(42) @15:1
  let %2: String = call conv.int(-42) @16:1
  let %3: String = call conv.real(3.14) @17:1
  let %4: String = call conv.real(-2.5) @18:1
  let %5: String = call conv.bool(true) @19:1
  let %6: String = call conv.okay() @20:1
  let c: Char = call ascii.char(65) @23:9
  let %7: Int = call ascii.val(c) @24:1
  join k1(r: Char) {
    let %8: Int = prim -(0, 100) @28:9
    let %9: Int = call int.abs(%8) @28:1
    let %10: Int = call int.min(5, 10) @29:1
    let %11: Int = call int.max(5, 10) @30:1
    let %12: Int = call ascii.val('Z') @31:9
    let %13: Int = call int.max(%12, 100) @31:1
    let %14: Int = call real.floor(3.9) @32:1
    let %15: Int = call real.round(3.2) @33:1
    let %16: Real = prim --(0.0, 5.5) @34:10
    let %17: Real = call real.abs(%16) @34:1
    let %18: Real = call real.min(1.5, 2.5) @35:1
    let %19: Real = call real.max(1.5, 2.5) @36:1
    let %20: Real = call real.plus(10.0, 2.5) @37:1
    let %21: Real = call real.diff(10.0, 2.5) @38:1
    let %22: Real = call real.mul(3.0, 4.0) @39:1
    let %23: Bool = call real.smaller(1.0, 2.0) @40:1
    let %24: Bool = call real.greater(2.0, 1.0) @41:1
    let %25: Bool = call real.smallerEq(1.0, 1.0) @42:1
    let %26: Bool = call real.greaterEq(1.0, 1.0) @43:1
    let s: String = call string.new(5, 'x') @46:9
    do call string.setSub(s, 0, "hello", 0, 5) @47:1
    let %27: Int = call string.length(s) @48:1
    let %28: Char = call string.getChar(s, 1) @49:1
    do call string.setChar(s, 0, 'H') @50:1
    let %29: String = call string.getSub(s, 0, 2) @52:1
    let %30: String = call string.cat(s, " world") @53:1
    let a: Array(Int) = array_rep(4, 10) @56:9
    let %31: Int = prim extent(a) @57:1
    store a[2] := 99 @58:1
    let %32: Int = index(a, 2) @59:1
    join k2(r.1: Int) {
      let d: T = call dynamic.new [Int](123) @67:9
      let copied: T = call dynamic.copy(d) @68:14
      let %33: Int = call dynamic.be [Int](copied) @69:1
      let w: writer.T = call writer.file("io.txt") @72:9
      do call writer.putString(w, "Quest I/O\n") @73:1
      do call writer.close(w) @74:1
      let r.2: reader.T = call reader.file("io.txt") @75:9
      let %34: String = call reader.getString(r.2, 9) @76:1
      do call reader.close(r.2) @77:1
    } in {
      let %35: Exception = member arrayOp.error @62:6
      try catching (%35) {
        let %36: Int = index(a, 10) @61:5
        jump k2(%36) @60:1
      } handle (e: Exception) {
        let %37: Bool = prim is(e, %35) @60:1
        if %37 { @60:1
          let %38: Int = prim -(0, 1) @63:5
          jump k2(%38) @60:1
        } else {
          reraise e @60:1
        }
      }
    }
  } in {
    let %39: Exception = member ascii.error @25:26
    try catching (%39) {
      let %40: Char = call ascii.char(999) @25:5
      jump k1(%40) @25:1
    } handle (e.1: Exception) {
      let %41: Bool = prim is(e.1, %39) @25:1
      if %41 { @25:1
        jump k1('?') @25:1
      } else {
        reraise e.1 @25:1
      }
    }
  }
}

