import system = "system" : System
import writer = "writer" : Writer
import conv = "conv" : Conv
import string = "string" : StringOp
main {
  let val: String = call external "quest_system_getenv"("QUEST_TEST_ENV_VAR")
  let %1: writer.T = member writer.output
  do call writer.putString(%1, val)
  let %2: writer.T = member writer.output
  do call writer.putString(%2, "\n")
  let missing: String = call external "quest_system_getenv"("NON_EXISTENT_VAR_ABCXYZ")
  let lenMissing: Int = call external "quest_string_length"(missing)
  let %3: writer.T = member writer.output
  let %4: String = call external "quest_conv_int"(lenMissing)
  do call writer.putString(%3, %4)
  let %5: writer.T = member writer.output
  do call writer.putString(%5, "\n")
  let %6: writer.T = call writer.file("present.txt")
  do call writer.close(%6)
  let hasFile: Bool = call external "quest_system_file_exists"("present.txt")
  let %7: writer.T = member writer.output
  let %8: String = call conv.bool(hasFile)
  do call writer.putString(%7, %8)
  let %9: writer.T = member writer.output
  do call writer.putString(%9, "\n")
  let noFile: Bool = call external "quest_system_file_exists"("does_not_exist_file_987654.txt")
  let %10: writer.T = member writer.output
  let %11: String = call conv.bool(noFile)
  do call writer.putString(%10, %11)
  let %12: writer.T = member writer.output
  do call writer.putString(%12, "\n")
}

