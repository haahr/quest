import system = "system" : System
import writer = "writer" : Writer
import conv = "conv" : Conv
import string = "string" : StringOp
main {
  let val: String = call system.getEnv("QUEST_TEST_ENV_VAR") @6:11
  let %1: writer.T = member writer.output @7:18
  do call writer.putString(%1, val) @7:1
  let %2: writer.T = member writer.output @8:18
  do call writer.putString(%2, "\n") @8:1
  let missing: String = call system.getEnv("NON_EXISTENT_VAR_ABCXYZ") @10:15
  let lenMissing: Int = call string.length(missing) @11:18
  let %3: writer.T = member writer.output @12:18
  let %4: String = call conv.int(lenMissing) @12:32
  do call writer.putString(%3, %4) @12:1
  let %5: writer.T = member writer.output @13:18
  do call writer.putString(%5, "\n") @13:1
  let %6: writer.T = call writer.file("present.txt") @16:14
  do call writer.close(%6) @16:1
  let hasFile: Bool = call system.fileExists("present.txt") @17:15
  let %7: writer.T = member writer.output @18:18
  let %8: String = call conv.bool(hasFile) @18:32
  do call writer.putString(%7, %8) @18:1
  let %9: writer.T = member writer.output @19:18
  do call writer.putString(%9, "\n") @19:1
  let noFile: Bool = call system.fileExists("does_not_exist_file_987654.txt") @21:14
  let %10: writer.T = member writer.output @22:18
  let %11: String = call conv.bool(noFile) @22:32
  do call writer.putString(%10, %11) @22:1
  let %12: writer.T = member writer.output @23:18
  do call writer.putString(%12, "\n") @23:1
}

