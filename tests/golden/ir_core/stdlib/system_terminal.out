import system = "system" : System
import writer = "writer" : Writer
main {
  funs {
    fun print(s: String): Ok {
      let %1: writer.T = member writer.output @10:45
      let %2: String = prim <>(s, "\n") @10:59
      let %3: Ok = call writer.putString(%1, %2) @10:28
      return %3
    }
  }
  funs {
    fun show(fd: Int): Ok {
      join k1(r: String) {
        let %4: Ok = call print(r) @11:25
        return %4
      } in {
        let %5: Bool = call system.isTerminal(fd) @11:34
        if %5 { @11:31
          jump k1("terminal") @11:31
        } else {
          jump k1("not a terminal") @11:31
        }
      }
    }
  }
  do call show(0) @12:1
  do call show(1) @13:1
  do call show(2) @14:1
  do call show(-1) @15:1
  do call show(1000) @16:1
  do call show(4611686018427387903) @17:1
}

