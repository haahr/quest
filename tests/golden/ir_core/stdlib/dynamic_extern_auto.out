import dynamic = "dynamic" : Dynamic
import writer = "writer" : Writer
main {
  funs {
    fun emit(d: Dynamic): Ok {
      let %1: writer.T = member writer.output
      do call dynamic.extern(%1, d)
      let %2: writer.T = member writer.output
      let %3: Ok = call writer.putString(%2, "\n")
      return %3
    }
  }
  let a: Int = 1
  let b: Int = 2
  let %4: Tuple a: Int b: Int end = tuple(a, b)
  let %5: Pair = auto[Int](%4)
  let %6: T = call dynamic.new [Pair](%5)
  do call emit(%6)
  let x: Record name: String age: Int end = record(name = "n", age = 3)
  let %7: Tuple x: Record name: String age: Int end end = tuple(x)
  let %8: Named = auto[Record name: String age: Int end](%7)
  let %9: T = call dynamic.new [Named](%8)
  do call emit(%9)
  let a.1: Int = 7
  let b.1: String = "s"
  let back: Int = 8
  let %10: Tuple b: String back: Int end = tuple(b.1, back)
  let inner: Auto B :: TYPE with b: B back: Int end = auto[String](%10)
  let %11: Tuple a: Int inner: Auto B :: TYPE with b: B back: Int end end = tuple(a.1, inner)
  let %12: Outer = auto[Int](%11)
  let %13: T = call dynamic.new [Outer](%12)
  do call emit(%13)
  let n: Int = 1
  let f: Bool = true
  let c: Tuple n: Int f: Bool end = tuple(n, f)
  let d.1: T = call dynamic.new [Char]('x')
  let %14: Tuple var c: Tuple n: Int f: Bool end d: Dynamic end = tuple(c, d.1)
  let %15: Cell = auto[Tuple n: Int f: Bool end](%14)
  let %16: T = call dynamic.new [Cell](%15)
  do call emit(%16)
  funs {
    fun mk [A::TYPE](x.1: A): Pair {
      let a.2: A = x.1
      let b.2: A = x.1
      let %17: Tuple a: A b: A end = tuple(a.2, b.2)
      let %18: Pair = auto[A](%17)
      return %18
    }
  }
  let mkAll: All(A :: TYPE) Fun(x: A): Pair = mk
  let %19: Pair = call mkAll [String]("p")
  let %20: Pair = call mk [Bool](true)
  let %21: Array(Pair) = array(%19, %20)
  let %22: Record ps: Array(Pair) end = record(ps = %21)
  let %23: T = call dynamic.new [Record ps: Array(Pair) end](%22)
  do call emit(%23)
}

