import conv = "conv" : Conv
import writer = "writer" : Writer
main {
  let %1: writer.T = member writer.output @6:18
  let %2: String = call conv.okay() @6:32
  do call writer.putString(%1, %2) @6:1
  let %3: writer.T = member writer.output @7:18
  do call writer.putString(%3, "\n") @7:1
  let %4: writer.T = member writer.output @8:18
  let %5: String = call conv.bool(true) @8:32
  do call writer.putString(%4, %5) @8:1
  let %6: writer.T = member writer.output @9:18
  do call writer.putString(%6, "\n") @9:1
  let %7: writer.T = member writer.output @10:18
  let %8: String = call conv.bool(false) @10:32
  do call writer.putString(%7, %8) @10:1
  let %9: writer.T = member writer.output @11:18
  do call writer.putString(%9, "\n") @11:1
  let %10: writer.T = member writer.output @12:18
  let %11: String = call conv.int(42) @12:32
  do call writer.putString(%10, %11) @12:1
  let %12: writer.T = member writer.output @13:18
  do call writer.putString(%12, "\n") @13:1
  let %13: writer.T = member writer.output @14:18
  let %14: String = call conv.int(-42) @14:32
  do call writer.putString(%13, %14) @14:1
  let %15: writer.T = member writer.output @15:18
  do call writer.putString(%15, "\n") @15:1
  funs {
    fun showInt(n: Int): Ok {
      let %16: writer.T = member writer.output @17:44
      let %17: String = call conv.int(n) @17:58
      let %18: Int = prim -(0, n) @17:89
      let %19: String = call conv.int(%18) @17:80
      let %20: String = prim <>(%19, "\n") @17:80
      let %21: String = prim <>(" ", %20) @17:73
      let %22: String = prim <>(%17, %21) @17:58
      let %23: Ok = call writer.putString(%16, %22) @17:27
      return %23
    }
  }
  do call showInt(0) @18:1
  var power: Int = 1 @19:1
  var k: Int = 1 @20:1
  let %24: Bool = prim <=(k, 18) @20:1
  if %24 { @20:1
    loop L1 {
      let k.1: Int = k @20:1
      let %25: Int = prim *(power, 10) @21:14
      let %26: Int = prim -(%25, 1) @21:14
      do call showInt(%26) @21:5
      let %27: Int = prim *(power, 10) @22:14
      power := %27 @22:5
      do call showInt(power) @23:5
      let %28: Bool = prim is(k, 18) @20:1
      if %28 { @20:1
        break L1 @20:1
      }
      let %29: Int = prim +(k, 1) @20:1
      k := %29 @20:1
    }
  }
  do call showInt(9223372036854775807) @25:1
  let %30: writer.T = member writer.output @26:18
  let %31: Int = prim -(-9223372036854775807, 1) @26:41
  let %32: String = call conv.int(%31) @26:32
  let %33: String = prim <>(%32, "\n") @26:32
  do call writer.putString(%30, %33) @26:1
  let %34: writer.T = member writer.output @27:18
  let %35: String = call conv.real(3.14) @27:32
  do call writer.putString(%34, %35) @27:1
  let %36: writer.T = member writer.output @28:18
  do call writer.putString(%36, "\n") @28:1
  let %37: writer.T = member writer.output @29:18
  let %38: String = call conv.real(-2.5) @29:32
  do call writer.putString(%37, %38) @29:1
  let %39: writer.T = member writer.output @30:18
  do call writer.putString(%39, "\n") @30:1
  let %40: writer.T = member writer.output @31:18
  let %41: String = call conv.char('Z') @31:32
  do call writer.putString(%40, %41) @31:1
  let %42: writer.T = member writer.output @32:18
  do call writer.putString(%42, "\n") @32:1
  let %43: writer.T = member writer.output @33:18
  let %44: String = call conv.string("text") @33:32
  do call writer.putString(%43, %44) @33:1
  let %45: writer.T = member writer.output @34:18
  do call writer.putString(%45, "\n") @34:1
