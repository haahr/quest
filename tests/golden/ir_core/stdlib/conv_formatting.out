import conv = "conv" : Conv
import writer = "writer" : Writer
main {
  let %1: writer.T = member writer.output @6:18
  let %2: String = call conv.okay() @6:32
  do call writer.putString(%1, %2) @6:1
  let %3: writer.T = member writer.output @7:18
  do call writer.putString(%3, "\n") @7:1
  let %4: writer.T = member writer.output @8:18
  let %5: String = call conv.bool(true) @8:32
  do call writer.putString(%4, %5) @8:1
  let %6: writer.T = member writer.output @9:18
  do call writer.putString(%6, "\n") @9:1
  let %7: writer.T = member writer.output @10:18
  let %8: String = call conv.bool(false) @10:32
  do call writer.putString(%7, %8) @10:1
  let %9: writer.T = member writer.output @11:18
  do call writer.putString(%9, "\n") @11:1
  let %10: writer.T = member writer.output @12:18
  let %11: String = call conv.int(42) @12:32
  do call writer.putString(%10, %11) @12:1
  let %12: writer.T = member writer.output @13:18
  do call writer.putString(%12, "\n") @13:1
  let %13: writer.T = member writer.output @14:18
  let %14: String = call conv.int(-42) @14:32
  do call writer.putString(%13, %14) @14:1
  let %15: writer.T = member writer.output @15:18
  do call writer.putString(%15, "\n") @15:1
  let %16: writer.T = member writer.output @16:18
  let %17: String = call conv.real(3.14) @16:32
  do call writer.putString(%16, %17) @16:1
  let %18: writer.T = member writer.output @17:18
  do call writer.putString(%18, "\n") @17:1
  let %19: writer.T = member writer.output @18:18
  let %20: String = call conv.real(-2.5) @18:32
  do call writer.putString(%19, %20) @18:1
  let %21: writer.T = member writer.output @19:18
  do call writer.putString(%21, "\n") @19:1
  let %22: writer.T = member writer.output @20:18
  let %23: String = call conv.char('Z') @20:32
  do call writer.putString(%22, %23) @20:1
  let %24: writer.T = member writer.output @21:18
  do call writer.putString(%24, "\n") @21:1
  let %25: writer.T = member writer.output @22:18
  let %26: String = call conv.string("text") @22:32
  do call writer.putString(%25, %26) @22:1
  let %27: writer.T = member writer.output @23:18
  do call writer.putString(%27, "\n") @23:1
}

