import dynamic = "dynamic" : Dynamic
import reader = "reader" : Reader
import writer = "writer" : Writer
import conv = "conv" : Conv
import arrayOp = "arrayOp" : ArrayOp
main {
  let %1: reader.T = member reader.input @23:25
  let d1: T = call dynamic.intern(%1) @23:10
  let i1: Int = call dynamic.be [Int](d1) @24:10
  let %2: writer.T = member writer.output @25:18
  let %3: String = call conv.int(i1) @25:32
  do call writer.putString(%2, %3) @25:1
  let %4: writer.T = member writer.output @26:18
  do call writer.putString(%4, "\n") @26:1
