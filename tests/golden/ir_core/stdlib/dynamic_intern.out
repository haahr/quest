import dynamic = "dynamic" : Dynamic
import reader = "reader" : Reader
import writer = "writer" : Writer
import conv = "conv" : Conv
import arrayOp = "arrayOp" : ArrayOp
main {
  let %1: reader.T = member reader.input
  let d1: T = call dynamic.intern(%1)
  let i1: Int = call dynamic.be [Int](d1)
  let %2: writer.T = member writer.output
  let %3: String = call external "quest_conv_int"(i1)
  do call writer.putString(%2, %3)
  let %4: writer.T = member writer.output
  do call writer.putString(%4, "\n")
  let %5: reader.T = member reader.input
  let d2: T = call dynamic.intern(%5)
  let r2: Real = call dynamic.be [Real](d2)
  let %6: writer.T = member writer.output
  let %7: String = call external "quest_conv_real"(r2)
  do call writer.putString(%6, %7)
  let %8: writer.T = member writer.output
  do call writer.putString(%8, "\n")
  let %9: reader.T = member reader.input
  let d3: T = call dynamic.intern(%9)
  let s3: String = call dynamic.be [String](d3)
  let %10: writer.T = member writer.output
  do call writer.putString(%10, s3)
  let %11: writer.T = member writer.output
  do call writer.putString(%11, "\n")
  let %12: reader.T = member reader.input
  let d4: T = call dynamic.intern(%12)
  let t4: Tup = call dynamic.be [Tup](d4)
  let %13: writer.T = member writer.output
  let %14: Int = tuple_field(t4, 0)
  let %15: String = call external "quest_conv_int"(%14)
  do call writer.putString(%13, %15)
  let %16: writer.T = member writer.output
  do call writer.putString(%16, " ")
  let %17: writer.T = member writer.output
  let %18: String = tuple_field(t4, 1)
  do call writer.putString(%17, %18)
  let %19: writer.T = member writer.output
  do call writer.putString(%19, " ")
  let %20: writer.T = member writer.output
  let %21: Bool = tuple_field(t4, 2)
  let %22: String = call conv.bool(%21)
  do call writer.putString(%20, %22)
  let %23: writer.T = member writer.output
  do call writer.putString(%23, "\n")
  let %24: reader.T = member reader.input
  let d5: T = call dynamic.intern(%24)
  let v5: Either = call dynamic.be [Either](d5)
  switch tag(v5) {
    case left (n: Int): {
      let %25: writer.T = member writer.output
      let %26: String = call external "quest_conv_int"(n)
      do call writer.putString(%25, %26)
    }
    case right (s: String): {
      let %27: writer.T = member writer.output
      do call writer.putString(%27, s)
    }
  }
  let %28: writer.T = member writer.output
  do call writer.putString(%28, "\n")
  let %29: reader.T = member reader.input
  let d6: T = call dynamic.intern(%29)
  let n1: Node = call dynamic.be [Node](d6)
  let %30: Dynamic.T = record_field(n1, next)
  let n2: Node = call dynamic.be [Node](%30)
  let %31: Dynamic.T = record_field(n2, next)
  let n3: Node = call dynamic.be [Node](%31)
  let %32: writer.T = member writer.output
  let %33: Int = record_field(n1, id)
  let %34: String = call external "quest_conv_int"(%33)
  do call writer.putString(%32, %34)
  let %35: writer.T = member writer.output
  do call writer.putString(%35, " -> ")
  let %36: writer.T = member writer.output
  let %37: Int = record_field(n2, id)
  let %38: String = call external "quest_conv_int"(%37)
  do call writer.putString(%36, %38)
  let %39: writer.T = member writer.output
  do call writer.putString(%39, " -> ")
  let %40: writer.T = member writer.output
  let %41: Int = record_field(n3, id)
  let %42: String = call external "quest_conv_int"(%41)
  do call writer.putString(%40, %42)
  let %43: writer.T = member writer.output
  do call writer.putString(%43, "\n")
  let it: Record name: String qty: Int end = record(name = "widgets", qty = 5)
  let dIt: T = call dynamic.new [Item](it)
  let %44: writer.T = member writer.output
  do call dynamic.extern(%44, dIt)
  let %45: writer.T = member writer.output
  do call writer.putString(%45, "\n")
}

