  let %14: Int = tuple_field(t4, 0) @42:41
  let %15: String = call conv.int(%14) @42:32
  do call writer.putString(%13, %15) @42:1
  let %16: writer.T = member writer.output @43:18
  do call writer.putString(%16, " ") @43:1
  let %17: writer.T = member writer.output @44:18
  let %18: String = tuple_field(t4, 1) @44:32
  do call writer.putString(%17, %18) @44:1
  let %19: writer.T = member writer.output @45:18
  do call writer.putString(%19, " ") @45:1
  let %20: writer.T = member writer.output @46:18
  let %21: Bool = tuple_field(t4, 2) @46:42
  let %22: String = call conv.bool(%21) @46:32
  do call writer.putString(%20, %22) @46:1
  let %23: writer.T = member writer.output @47:18
  do call writer.putString(%23, "\n") @47:1
  let %24: reader.T = member reader.input @51:25
  let d5: T = call dynamic.intern(%24) @51:10
  let v5: Either = call dynamic.be [Either](d5) @52:10
  switch tag(v5) { @53:1
    case left (n: Int): {
      let %25: writer.T = member writer.output @54:42
      let %26: String = call conv.int(n) @54:56
      do call writer.putString(%25, %26) @54:25
    }
    case right (s: String): {
      let %27: writer.T = member writer.output @55:43
      do call writer.putString(%27, s) @55:26
    }
  }
  let %28: writer.T = member writer.output @57:18
  do call writer.putString(%28, "\n") @57:1
  let %29: reader.T = member reader.input @61:25
  let d6: T = call dynamic.intern(%29) @61:10
  let n1: Node = call dynamic.be [Node](d6) @62:10
  let %30: Dynamic.T = record_field(n1, next) @63:27
  let n2: Node = call dynamic.be [Node](%30) @63:10
  let %31: Dynamic.T = record_field(n2, next) @64:27
  let n3: Node = call dynamic.be [Node](%31) @64:10
  let %32: writer.T = member writer.output @65:18
  let %33: Int = record_field(n1, id) @65:41
  let %34: String = call conv.int(%33) @65:32
  do call writer.putString(%32, %34) @65:1
  let %35: writer.T = member writer.output @66:18
  do call writer.putString(%35, " -> ") @66:1
  let %36: writer.T = member writer.output @67:18
  let %37: Int = record_field(n2, id) @67:41
  let %38: String = call conv.int(%37) @67:32
  do call writer.putString(%36, %38) @67:1
  let %39: writer.T = member writer.output @68:18
  do call writer.putString(%39, " -> ") @68:1
  let %40: writer.T = member writer.output @69:18
