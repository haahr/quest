import writer = "writer" : Writer
import reader = "reader" : Reader
import dynamic = "dynamic" : Dynamic
import conv = "conv" : Conv
main {
  funs {
    fun print(s: String): Ok {
      let %1: writer.T = member writer.output @12:45
      let %2: String = prim <>(s, "\n") @12:59
      let %3: Ok = call writer.putString(%1, %2) @12:28
      return %3
    }
  }
  funs {
    fun read(name: String, document: String): Ok {
      let w: writer.T = call writer.file("document.json") @16:17
      do call writer.putString(w, document) @17:9
      do call writer.close(w) @18:9
      let r: reader.T = call reader.file("document.json") @19:17
      join k1(r.1: String) {
        let %4: String = prim <>(": ", r.1) @20:23
        let %5: String = prim <>(name, %4) @20:15
        do call print(%5) @20:9
        let %6: Ok = call reader.close(r) @22:9
        return %6
      } in {
        let %7: Exception = member dynamic.error @21:18
        try catching (%7) {
          let %8: T = call dynamic.intern(r) @20:68
          let %9: R = call dynamic.be [R](%8) @20:54
          let %10: Int = record_field(%9, a) @20:54
          let %11: String = call conv.int(%10) @20:45
          let %12: String = prim <>("a = ", %11) @20:35
          jump k1(%12) @20:31
        } handle (e: Exception) {
          let %13: Bool = prim is(e, %7) @20:31
          if %13 { @20:31
            jump k1("dynamic.error") @20:31
          } else {
            reraise e @20:31
          }
        }
      }
    }
  }
  do call read("the value repeats a field", "{\"quest\":1,\"types\":[{\"record\":{\"a\":\"Int\"}}],\"type\":0,\"value\":{\"a\":1,\"a\":2}}") @24:1
  do call read("the type repeats a field", "{\"quest\":1,\"types\":[{\"record\":{\"a\":\"Int\",\"a\":\"Int\"}}],\"type\":0,\"value\":{\"a\":1}}") @26:1
  do call read("both repeat it", "{\"quest\":1,\"types\":[{\"record\":{\"a\":\"Int\",\"a\":\"Int\"}}],\"type\":0,\"value\":{\"a\":1,\"a\":2}}") @28:1
  do call read("well-formed", "{\"quest\":1,\"types\":[{\"record\":{\"a\":\"Int\"}}],\"type\":0,\"value\":{\"a\":3}}") @30:1
}

