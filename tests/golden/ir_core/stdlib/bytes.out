  let %7: Bool = call external "quest_string_equal"("caf\u00c3\u00a9", "caf\u00c3\u00a9")
  let %8: Int = call external "quest_ascii_val"('ÿ')
  let %9: Char = call external "quest_ascii_char"(200)
  join k1(r: Char) {
    let %10: Bool = call external "quest_string_precedes"("z", "\u0080")
    let %11: writer.T = member writer.output
    do call writer.putString(%11, "caf\u00c3\u00a9\n")
    let %12: writer.T = member writer.output
    do call writer.putChar(%12, 'Ã')
    let %13: writer.T = member writer.output
    do call writer.putChar(%13, '©')
    let %14: writer.T = member writer.output
    do call writer.putString(%14, "\n")
    let %15: reader.T = member reader.input
