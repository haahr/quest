import conv = "conv" : Conv
import intOp = "int" : IntOp
import writer = "writer" : Writer
import time = "os/time" : os/Time
main {
  funs {
    fun print(s: String): Ok {
      let %1: writer.T = member writer.output @13:45
      let %2: String = prim <>(s, "\n") @13:59
      let %3: Ok = call writer.putString(%1, %2) @13:28
      return %3
    }
  }
  funs {
    fun check(what: String, holds: Bool): Ok {
      let %4: String = call conv.bool(holds) @14:65
      let %5: String = prim <>(": ", %4) @14:57
      let %6: String = prim <>(what, %5) @14:49
      let %7: Ok = call print(%6) @14:43
      return %7
    }
  }
  let %8: Int = call time.ticks() @17:16
  var last: Int = %8 @17:1
  var back: Bool = false @18:1
  var i: Int = 1 @19:1
  let %9: Bool = prim <=(i, 1000) @19:1
  if %9 { @19:1
    loop L1 {
      let i.1: Int = i @19:1
      let t: Int = call time.ticks() @20:13
      let %10: Bool = prim <(t, last) @21:8
      if %10 { @21:5
        back := true @21:22
      }
      last := t @22:5
      let %11: Bool = prim is(i, 1000) @19:1
      if %11 { @19:1
        break L1 @19:1
      }
      let %12: Int = prim +(i, 1) @19:1
      i := %12 @19:1
    }
  }
  let %13: Bool = prim not(back) @24:29
  do call check("ticks never go back", %13) @24:1
  let wallBefore: Int = call time.nowInNanoseconds() @27:18
  let ticksBefore: Int = call time.ticks() @28:19
  do call time.sleepNanoseconds(50000000) @29:1
  let %14: Int = call time.ticks() @30:13
  let slept: Int = prim -(%14, ticksBefore) @30:13
  let %15: Int = call time.nowInNanoseconds() @31:17
  let wallSlept: Int = prim -(%15, wallBefore) @31:17
  let %16: Bool = prim >=(slept, 50000000) @32:36
  do call check("sleep lasts at least 50 ms", %16) @32:1
  let %17: Bool = prim <(slept, 5000000000) @33:31
  do call check("sleep lasts under 5 s", %17) @33:1
  let %18: Int = prim -(wallSlept, slept) @34:45
  let %19: Int = call intOp.abs(%18) @34:35
  let %20: Bool = prim <(%19, 1000000000) @34:35
  do call check("the wall clock keeps pace", %20) @34:1
  let shortStart: Int = call time.ticks() @35:18
  do call time.sleepNanoseconds(0) @36:1
  do call time.sleepNanoseconds(-1000000000) @37:1
  let %21: Int = call time.ticks() @38:33
  let %22: Int = prim -(%21, shortStart) @38:33
  let %23: Bool = prim <(%22, 1000000000) @38:33
  do call check("no sleep for 0 or less", %23) @38:1
  let cpuBefore: Int = call time.cpuTimeInNanoseconds() @41:17
  var sum: Int = 0 @42:1
  var i.2: Int = 1 @43:1
  let %24: Bool = prim <=(i.2, 100000) @43:1
  if %24 { @43:1
    loop L2 {
      let i.3: Int = i.2 @43:1
      let %25: Int = prim %(i.3, 7) @43:40
      let %26: Int = prim +(sum, %25) @43:33
      sum := %26 @43:26
      let %27: Bool = prim is(i.2, 100000) @43:1
      if %27 { @43:1
        break L2 @43:1
      }
      let %28: Int = prim +(i.2, 1) @43:1
      i.2 := %28 @43:1
    }
  }
  let %29: Int = call time.cpuTimeInNanoseconds() @44:36
  let %30: Bool = prim >=(%29, cpuBefore) @44:36
  let %31: Bool = prim >(sum, 0) @44:82
  let %32: Bool = prim /\(%30, %31) @44:36
  do call check("CPU time grows under work", %32) @44:1
  let wall: Int = call time.nowInNanoseconds() @47:12
  let %33: Bool = prim >(wall, 1735689600000000000) @48:41
  let %34: Bool = prim <(wall, 4102444800000000000) @48:73
  let %35: Bool = prim /\(%33, %34) @48:41
  do call check("the wall clock is this century", %35) @48:1
  let %36: Int = prim /(wall, 1000000000) @52:46
  let %37: Int = call time.localOffsetInSeconds(%36) @52:20
  let %38: Int = call intOp.abs(%37) @52:10
  let %39: Bool = prim <(%38, 86400) @52:10
  let %40: Int = prim -(0, 1577836800) @53:45
  let %41: Int = call time.localOffsetInSeconds(%40) @53:19
  let %42: Int = call intOp.abs(%41) @53:9
  let %43: Bool = prim <(%42, 86400) @53:9
  let %44: Bool = prim /\(%39, %43) @52:10
  do call check("the local offset is less than a day", %44) @51:1
}

