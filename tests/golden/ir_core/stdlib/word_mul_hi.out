import word = "word" : Word
import conv = "conv" : Conv
import writer = "writer" : Writer
main {
  funs {
    fun show(w: word.T): Ok {
      let %1: writer.T = member writer.output @11:26
      let %2: Int = call word.toInt(w) @11:49
      let %3: String = call conv.int(%2) @11:40
      do call writer.putString(%1, %3) @11:9
      let %4: writer.T = member writer.output @12:26
      let %5: Ok = call writer.putString(%4, "\n") @12:9
      return %5
    }
  }
  let zero: word.T = call word.fromInt(0) @15:12
  let one: word.T = call word.fromInt(1) @16:11
  let all: word.T = call word.notBits(zero) @17:11
  let high: word.T = call word.shift(one, 63) @18:12
  let half: word.T = call word.shift(one, 32) @19:12
  let %6: word.T = call word.mulHi(zero, zero) @21:6
  do call show(%6) @21:1
  let %7: word.T = call word.fromInt(3) @22:17
  let %8: word.T = call word.fromInt(5) @22:33
  let %9: word.T = call word.mulHi(%7, %8) @22:6
  do call show(%9) @22:1
  let %10: word.T = call word.mulHi(all, one) @23:6
  do call show(%10) @23:1
  let %11: word.T = call word.fromInt(2) @24:21
  let %12: word.T = call word.mulHi(all, %11) @24:6
  do call show(%12) @24:1
  let %13: word.T = call word.mulHi(all, all) @25:6
  do call show(%13) @25:1
  let %14: word.T = call word.fromInt(2) @26:22
  let %15: word.T = call word.mulHi(high, %14) @26:6
  do call show(%15) @26:1
  let %16: word.T = call word.mulHi(high, high) @27:6
  do call show(%16) @27:1
  let %17: word.T = call word.mulHi(half, half) @28:6
  do call show(%17) @28:1
  let %18: word.T = call word.sub(half, one) @29:17
  let %19: word.T = call word.sub(half, one) @29:36
  let %20: word.T = call word.mulHi(%18, %19) @29:6
  do call show(%20) @29:1
  let %21: word.T = call word.fromInt(-2) @30:17
  let %22: word.T = call word.fromInt(3) @30:34
  let %23: word.T = call word.mulHi(%21, %22) @30:6
  do call show(%23) @30:1
  let %24: word.T = call word.fromInt(81985529216486895) @35:5
  let %25: word.T = call word.fromInt(-1) @35:37
  let %26: word.T = call word.fromInt(9223372036854775807) @35:54
  let %27: word.T = call word.fromInt(-25214903917) @35:87
  let %28: word.T = call word.fromInt(1103515245) @36:5
  let %29: Int = prim -(-9223372036854775807, 1) @36:43
  let %30: word.T = call word.fromInt(%29) @36:30
  let %31: word.T = call word.fromInt(3735928559) @36:69
  let %32: word.T = call word.fromInt(42) @36:94
  let ws: Array(word.T) = array(%24, %25, %26, %27, %28, %30, %31, %32) @34:10
  var hiSum: word.T = zero @38:1
  var loSum: word.T = zero @39:1
  var i: Int = 0 @40:1
  loop L1 {
    let %33: Bool = prim <=(i, 7) @40:1
    if %33 { @40:1
      let i.1: Int = i @40:1
      var j: Int = 0 @41:5
      loop L2 {
        let %34: Bool = prim <=(j, 7) @41:5
        if %34 { @41:5
          let j.1: Int = j @41:5
          let %35: word.T = index(ws, i.1) @42:44
          let %36: word.T = index(ws, j.1) @42:50
          let %37: word.T = call word.mulHi(%35, %36) @42:33
          let %38: word.T = call word.add(hiSum, %37) @42:18
          hiSum := %38 @42:9
          let %39: word.T = index(ws, i.1) @43:42
          let %40: word.T = index(ws, j.1) @43:48
          let %41: word.T = call word.mul(%39, %40) @43:33
          let %42: word.T = call word.add(loSum, %41) @43:18
          loSum := %42 @43:9
          let %43: Int = prim +(j, 1) @41:5
          j := %43 @41:5
        } else {
          break L2 @41:5
        }
      }
      let %44: Int = prim +(i, 1) @40:1
      i := %44 @40:1
    } else {
      break L1 @40:1
    }
  }
  do call show(hiSum) @46:1
  do call show(loSum) @47:1
}

