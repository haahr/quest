import writer = "writer" : Writer
import reader = "reader" : Reader
import conv = "conv" : Conv
main {
  let w: writer.T = call writer.file("roundtrip.txt") @8:9
  do call writer.putString(w, "Hello from Quest Reader/Writer!\n") @9:1
  do call writer.putChar(w, 'X') @10:1
  do call writer.putString(w, "\n") @11:1
  do call writer.flush(w) @12:1
  do call writer.close(w) @13:1
  let r: reader.T = call reader.file("roundtrip.txt") @15:9
  let %1: Bool = call reader.more(r) @16:1
  let %2: String = call reader.getString(r, 32) @17:1
  let ch: Char = call reader.getChar(r) @18:10
  let %3: String = call conv.char(ch) @19:1
  let %4: Char = call reader.getChar(r) @20:1
  let %5: Bool = call reader.more(r) @21:1
  do call reader.close(r) @22:1
}

