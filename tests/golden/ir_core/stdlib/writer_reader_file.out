import writer = "writer" : Writer
import reader = "reader" : Reader
import conv = "conv" : Conv
main {
  let w: writer.T = call writer.file("roundtrip.txt")
  do call writer.putString(w, "Hello from Quest Reader/Writer!\n")
  do call writer.putChar(w, 'X')
  do call writer.putString(w, "\n")
  do call writer.flush(w)
  do call writer.close(w)
  let r: reader.T = call reader.file("roundtrip.txt")
  let %1: Bool = call reader.more(r)
  let %2: String = call reader.getString(r, 32)
  let ch: Char = call reader.getChar(r)
  let %3: String = call conv.char(ch)
  let %4: Char = call reader.getChar(r)
  let %5: Bool = call reader.more(r)
  do call reader.close(r)
}

