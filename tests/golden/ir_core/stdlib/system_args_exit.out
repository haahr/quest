import system = "system" : System
import writer = "writer" : Writer
import conv = "conv" : Conv
import arrayOp = "arrayOp" : ArrayOp
main {
  let %1: Array(String) = member system.args @7:28
  let numArgs: Int = prim extent(%1) @7:15
  let %2: writer.T = member writer.output @8:18
  let %3: String = call conv.int(numArgs) @8:32
  do call writer.putString(%2, %3) @8:1
  let %4: writer.T = member writer.output @9:18
  do call writer.putString(%4, "\n") @9:1
  let %5: Array(String) = member system.args @10:36
  let firstArg: String = index(%5, 1) @10:16
  let %6: writer.T = member writer.output @11:18
  do call writer.putString(%6, firstArg) @11:1
  let %7: writer.T = member writer.output @12:18
  do call writer.putString(%7, "\n") @12:1
  do call system.sysexit(42) @13:1
}

