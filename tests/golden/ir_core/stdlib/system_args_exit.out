import system = "system" : System
import writer = "writer" : Writer
import conv = "conv" : Conv
import arrayOp = "arrayOp" : ArrayOp
main {
  let %1: Array(String) = member system.args
  let numArgs: Int = prim extent(%1)
  let %2: writer.T = member writer.output
  let %3: String = call conv.int(numArgs)
  do call writer.putString(%2, %3)
  let %4: writer.T = member writer.output
  do call writer.putString(%4, "\n")
  let %5: Array(String) = member system.args
  let firstArg: String = index(%5, 1)
  let %6: writer.T = member writer.output
  do call writer.putString(%6, firstArg)
  let %7: writer.T = member writer.output
  do call writer.putString(%7, "\n")
  do call system.sysexit(42)
}

