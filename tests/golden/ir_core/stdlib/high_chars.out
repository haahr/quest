import ascii = "ascii" : Ascii
import dynamic = "dynamic" : Dynamic
import reader = "reader" : Reader
import string = "string" : StringOp
import writer = "writer" : Writer
import hashMap = "collections/hashMap" : collections/HashMap
import vector = "collections/vector" : collections/Vector
import maybe = "util/maybe" : util/Maybe
import conv = "conv" : Conv
main {
  let hi: Char = 'È' @18:10
  let %1: Int = call ascii.val(hi) @19:1
  let %2: Int = call ascii.val('ÿ') @20:1
  let %3: Char = call ascii.char(200) @21:7
  let %4: Bool = prim is(hi, %3) @21:1
  let %5: Char = call ascii.char(255) @22:11
  let %6: Bool = prim is('ÿ', %5) @22:1
  let %7: Char = call ascii.char(128) @23:11
  let %8: Bool = prim is('\x80', %7) @23:1
  let %9: Char = call ascii.char(127) @24:1
  let %10: Bool = prim is(%9, '\x7f') @24:1
  let s: String = "a\u00c8\u00ff" @27:9
  let %11: Char = call string.getChar(s, 1) @28:1
  let %12: Bool = prim is(%11, hi) @28:1
  let %13: Char = call string.getChar(s, 2) @29:1
  let %14: Bool = prim is(%13, 'ÿ') @29:1
  let %15: Char = call string.getChar(s, 2) @30:11
  let %16: Int = call ascii.val(%15) @30:1
  let t: String = call string.new(2, hi) @31:9
  do call string.setChar(t, 1, 'ÿ') @32:1
  let %17: Bool = call string.equal(t, "\u00c8\u00ff") @33:1
  let c: Char = hi @36:25
  let d: Char = 'x' @36:40
  let tup: Tuple c: Char var d: Char end = tuple(c, d) @36:11
  let %18: Char = tuple_field(tup, 0) @37:1
  let %19: Char = call ascii.char(200) @37:10
  let %20: Bool = prim is(%18, %19) @37:1
  store tup.#1 := 'ÿ' @38:1
  let %21: Char = tuple_field(tup, 1) @39:11
  let %22: Int = call ascii.val(%21) @39:1
  let opt: maybe.T(Char) = call maybe.some [Char](hi) @40:11
  let %23: Char = call maybe.unwrap [Char](opt) @41:1
  let %24: Char = call ascii.char(200) @41:28
  let %25: Bool = prim is(%23, %24) @41:1
  let arr: Array(Char) = array('\x80', hi, 'ÿ') @42:11
  let %26: Char = index(arr, 1) @43:1
  let %27: Char = call ascii.char(200) @43:11
  let %28: Bool = prim is(%26, %27) @43:1
  let %29: Char = index(arr, 0) @44:11
  let %30: Int = call ascii.val(%29) @44:1
  let %31: Char = index(arr, 2) @44:31
  let %32: Int = call ascii.val(%31) @44:21
  let %33: Int = prim +(%30, %32) @44:1
  funs {
    fun captured(): Char {
      return hi
    }
  }
  let %34: Char = call captured() @46:1
  let %35: Char = call ascii.char(200) @46:15
  let %36: Bool = prim is(%34, %35) @46:1
  let v: vector.T(Char) = type_app vector.new [Char] @49:9
  do call vector.append [Char](v, hi) @50:1
  let %37: Char = call ascii.char(255) @51:23
  do call vector.append [Char](v, %37) @51:1
  let %38: Char = call vector.get [Char](v, 0) @52:1
  let %39: Char = call ascii.char(200) @52:26
  let %40: Bool = prim is(%38, %39) @52:1
  let %41: Char = call vector.get [Char](v, 1) @53:1
  let %42: Bool = prim is(%41, 'ÿ') @53:1
  let m: hashMap.T(Char Int) = type_app hashMap.newIdentityMap [Char Int] @54:9
  let %43: Bool = call hashMap.insert [Char Int](m, hi, 1) @55:1
  let %44: Bool = call hashMap.insert [Char Int](m, 'ÿ', 2) @56:1
  let %45: Char = call ascii.char(200) @57:31
  let %46: Bool = call hashMap.contains [Char Int](m, %45) @57:1
  let %47: Char = call ascii.char(255) @58:27
  let %48: Int = call hashMap.find [Char Int](m, %47) @58:1
  funs {
    fun pick(first: Bool, a: Char, b: Char): Char {
      join k1(r: Char) {
        return r
      } in {
        if first { @61:47
          jump k1(a) @61:47
        } else {
          jump k1(b) @61:47
        }
      }
    }
  }
  let %49: Char = call pick(true, hi, 'a') @62:1
  let %50: Char = call ascii.char(200) @62:22
  let %51: Bool = prim is(%49, %50) @62:1
  let %52: Char = call pick(false, 'a', 'ÿ') @63:11
  let %53: Int = call ascii.val(%52) @63:1
  var c.1: Char = 'a' @64:1
  let %54: Char = call ascii.char(233) @65:6
  c.1 := %54 @65:1
  let %55: Bool = prim is(c.1, 'é') @66:1
  let %56: T = call dynamic.new [Char](hi) @69:18
  let %57: Char = call dynamic.be [Char](%56) @69:1
  let %58: Char = call ascii.char(200) @69:44
  let %59: Bool = prim is(%57, %58) @69:1
  let w: writer.T = call writer.file("high_chars.json") @70:9
  let c.2: Char = hi @71:71
  let d.1: Char = 'ÿ' @71:82
  let %60: Tuple c: Char d: Char end = tuple(c.2, d.1) @71:57
  let %61: T = call dynamic.new [Tuple c: Char d: Char end](%60) @71:18
  do call dynamic.extern(w, %61) @71:1
  do call writer.close(w) @72:1
  let r.1: reader.T = call reader.file("high_chars.json") @73:9
  let %62: T = call dynamic.intern(r.1) @74:50
  let back: Tuple c: Char d: Char end = call dynamic.be [Tuple c: Char d: Char end](%62) @74:12
  do call reader.close(r.1) @75:1
  let %63: Char = tuple_field(back, 0) @76:1
  let %64: Bool = prim is(%63, hi) @76:1
  let %65: Char = tuple_field(back, 1) @77:1
  let %66: Char = call ascii.char(255) @77:11
  let %67: Bool = prim is(%65, %66) @77:1
  let %68: Char = tuple_field(back, 0) @78:31
  let %69: Bool = call hashMap.contains [Char Int](m, %68) @78:1
  let %70: String = call conv.char(hi) @82:1
  let %71: String = call conv.char('\n') @83:1
  let %72: String = call conv.char("'") @84:1
  let %73: String = call conv.string("a\tb\"c\u00c8\u00ff") @85:1
}

