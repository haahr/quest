import ascii = "ascii" : Ascii
import dynamic = "dynamic" : Dynamic
import reader = "reader" : Reader
import string = "string" : StringOp
import writer = "writer" : Writer
import vector = "collections/vector" : collections/Vector
import hashMap = "collections/hashMap" : collections/HashMap
import maybe = "util/maybe" : util/Maybe
import conv = "conv" : Conv
main {
  let hi: Char = 'È' @17:10
  let %1: Int = call ascii.val(hi) @18:1
  let %2: Int = call ascii.val('ÿ') @19:1
  let %3: Char = call ascii.char(200) @20:7
  let %4: Bool = prim is(hi, %3) @20:1
  let %5: Char = call ascii.char(255) @21:11
  let %6: Bool = prim is('ÿ', %5) @21:1
  let %7: Char = call ascii.char(128) @22:11
  let %8: Bool = prim is('\x80', %7) @22:1
  let %9: Char = call ascii.char(127) @23:1
  let %10: Bool = prim is(%9, '\x7f') @23:1
  let s: String = "a\u00c8\u00ff" @26:9
  let %11: Char = call string.getChar(s, 1) @27:1
  let %12: Bool = prim is(%11, hi) @27:1
  let %13: Char = call string.getChar(s, 2) @28:1
  let %14: Bool = prim is(%13, 'ÿ') @28:1
  let %15: Char = call string.getChar(s, 2) @29:11
  let %16: Int = call ascii.val(%15) @29:1
  let t: String = call string.new(2, hi) @30:9
  do call string.setChar(t, 1, 'ÿ') @31:1
  let %17: Bool = call string.equal(t, "\u00c8\u00ff") @32:1
  let c: Char = hi @35:25
  let d: Char = 'x' @35:40
  let tup: Tuple c: Char var d: Char end = tuple(c, d) @35:11
  let %18: Char = tuple_field(tup, 0) @36:1
  let %19: Char = call ascii.char(200) @36:10
  let %20: Bool = prim is(%18, %19) @36:1
  store tup.#1 := 'ÿ' @37:1
  let %21: Char = tuple_field(tup, 1) @38:11
  let %22: Int = call ascii.val(%21) @38:1
  let opt: maybe.T(Char) = call maybe.some [Char](hi) @39:11
  let %23: Char = call maybe.unwrap [Char](opt) @40:1
  let %24: Char = call ascii.char(200) @40:28
  let %25: Bool = prim is(%23, %24) @40:1
  let arr: Array(Char) = array('\x80', hi, 'ÿ') @41:11
  let %26: Char = index(arr, 1) @42:1
  let %27: Char = call ascii.char(200) @42:11
  let %28: Bool = prim is(%26, %27) @42:1
  let %29: Char = index(arr, 0) @43:11
  let %30: Int = call ascii.val(%29) @43:1
  let %31: Char = index(arr, 2) @43:31
  let %32: Int = call ascii.val(%31) @43:21
  let %33: Int = prim +(%30, %32) @43:1
  funs {
    fun captured(): Char {
      return hi
    }
  }
  let %34: Char = call captured() @45:1
  let %35: Char = call ascii.char(200) @45:15
  let %36: Bool = prim is(%34, %35) @45:1
  let v: vector.T(Char) = type_app vector.new [Char] @48:9
  do call vector.append [Char](v, hi) @49:1
  let %37: Char = call ascii.char(255) @50:23
  do call vector.append [Char](v, %37) @50:1
  let %38: Char = call vector.get [Char](v, 0) @51:1
  let %39: Char = call ascii.char(200) @51:26
  let %40: Bool = prim is(%38, %39) @51:1
  let %41: Char = call vector.get [Char](v, 1) @52:1
  let %42: Bool = prim is(%41, 'ÿ') @52:1
  let m: hashMap.T(Char Int) = type_app hashMap.newIdentityMap [Char Int] @53:9
  let %43: Bool = call hashMap.insert [Char Int](m, hi, 1) @54:1
  let %44: Bool = call hashMap.insert [Char Int](m, 'ÿ', 2) @55:1
  let %45: Char = call ascii.char(200) @56:31
  let %46: Bool = call hashMap.contains [Char Int](m, %45) @56:1
  let %47: Char = call ascii.char(255) @57:27
  let %48: Int = call hashMap.find [Char Int](m, %47) @57:1
  funs {
    fun pick(first: Bool, a: Char, b: Char): Char {
      join k1(r: Char) {
        return r
      } in {
        if first { @60:47
          jump k1(a) @60:47
        } else {
          jump k1(b) @60:47
        }
      }
    }
  }
  let %49: Char = call pick(true, hi, 'a') @61:1
  let %50: Char = call ascii.char(200) @61:22
  let %51: Bool = prim is(%49, %50) @61:1
  let %52: Char = call pick(false, 'a', 'ÿ') @62:11
  let %53: Int = call ascii.val(%52) @62:1
  var c.1: Char = 'a' @63:1
  let %54: Char = call ascii.char(233) @64:6
  c.1 := %54 @64:1
  let %55: Bool = prim is(c.1, 'é') @65:1
  let %56: T = call dynamic.new [Char](hi) @68:18
  let %57: Char = call dynamic.be [Char](%56) @68:1
  let %58: Char = call ascii.char(200) @68:44
  let %59: Bool = prim is(%57, %58) @68:1
  let w: writer.T = call writer.file("high_chars.json") @69:9
  let c.2: Char = hi @70:71
  let d.1: Char = 'ÿ' @70:82
  let %60: Tuple c: Char d: Char end = tuple(c.2, d.1) @70:57
  let %61: T = call dynamic.new [Tuple c: Char d: Char end](%60) @70:18
  do call dynamic.extern(w, %61) @70:1
  do call writer.close(w) @71:1
  let r.1: reader.T = call reader.file("high_chars.json") @72:9
  let %62: T = call dynamic.intern(r.1) @73:50
  let back: Tuple c: Char d: Char end = call dynamic.be [Tuple c: Char d: Char end](%62) @73:12
  do call reader.close(r.1) @74:1
  let %63: Char = tuple_field(back, 0) @75:1
  let %64: Bool = prim is(%63, hi) @75:1
  let %65: Char = tuple_field(back, 1) @76:1
  let %66: Char = call ascii.char(255) @76:11
  let %67: Bool = prim is(%65, %66) @76:1
  let %68: Char = tuple_field(back, 0) @77:31
  let %69: Bool = call hashMap.contains [Char Int](m, %68) @77:1
  let %70: String = call conv.char(hi) @81:1
  let %71: String = call conv.char('\n') @82:1
  let %72: String = call conv.char("'") @83:1
  let %73: String = call conv.string("a\tb\"c\u00c8\u00ff") @84:1
}

