main {
  let w: Module 'writer' = module writer
  let %1: Fun(writer: writer.T string: String): Ok = record_field(w, putString)
  let %2: writer.T = record_field(w, output)
  do call %1(%2, "First class module record dispatched!\n")
  funs {
    fun id [A::TYPE](a: A): A {
      return a
    }
  }
  let %3: writer.T = member writer.output
  let w2: writer.T = call id [writer.T](%3)
  do call writer.putString(w2, "Writer.T passed as generic argument!\n")
}

