import writer = "writer" : Writer
main {
  let w: Module 'writer' = module writer @5:9
  let %1: Fun(writer: writer.T string: String): Ok = record_field(w, putString) @6:1
  let %2: writer.T = record_field(w, output) @6:13
  do call %1(%2, "First class module record dispatched!\n") @6:1
  funs {
    fun id [A::TYPE](a: A): A {
      return a
    }
  }
  let %3: writer.T = member writer.output @9:23
  let w2: writer.T = call id [writer.T](%3) @9:10
  do call writer.putString(w2, "Writer.T passed as generic argument!\n") @10:1
}

