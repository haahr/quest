import reader = "reader" : Reader
import system = "system" : System
import writer = "writer" : Writer
import readline = "io/readline" : io/Readline
main {
  let %1: Bool = call readline.editing() @15:1
  let %2: String = call readline.readLine("1> ") @18:1
  let %3: String = call readline.readLine("2> ") @19:1
  let %4: reader.T = member reader.input @20:16
  let %5: Char = call reader.getChar(%4) @20:1
  let %6: String = call readline.readLine("") @21:1
  let %7: String = call readline.readLine("3> ") @22:1
  join k1(r: String) {
    join k2(r.1: String) {
      do call readline.addHistory("alpha") @27:1
      do call readline.addHistory("beta gamma") @28:1
      do call readline.addHistory("") @29:1
      do call readline.addHistory("delta") @30:1
      do call readline.writeHistory("short.txt", 2) @31:1
      funs {
        fun contents(name: String): String {
          let r.2: reader.T = call reader.file(name) @33:19
          let s: String = call reader.getString(r.2, 1000) @33:45
          do call reader.close(r.2) @33:70
          return s
        }
      }
      let %8: String = call contents("short.txt") @34:1
      do call readline.readHistory("missing.txt") @35:1
      let %9: Bool = call system.isFile("missing.txt") @36:1
      do call readline.readHistory("short.txt") @37:1
      do call readline.writeHistory("all.txt", 100) @38:1
      let %10: String = call contents("all.txt") @39:1
      let w: writer.T = call writer.file("unterminated.txt") @40:9
      do call writer.putString(w, "one\ntwo") @41:1
      do call writer.close(w) @42:1
      do call readline.readHistory("unterminated.txt") @43:1
      do call readline.writeHistory("tail.txt", 3) @44:1
      let %11: String = call contents("tail.txt") @45:1
      do call readline.writeHistory("none.txt", 0) @46:1
      let %12: String = call contents("none.txt") @47:1
      join k3(r.3: String) {
        join k4(r.4: String) {
        } in {
          let %13: Exception = member readline.error @49:61
          try catching (%13) {
            do call readline.writeHistory("negative.txt", -1) @49:5
            jump k4("written") @49:1
          } handle (e: Exception) {
            let %14: Bool = prim is(e, %13) @49:1
            if %14 { @49:1
              jump k4("negative") @49:1
            } else {
              reraise e @49:1
            }
          }
        }
      } in {
        let %15: Exception = member readline.error @48:69
        try catching (%15) {
          do call readline.writeHistory("no/such/directory.txt", 5) @48:5
          jump k3("written") @48:1
        } handle (e.1: Exception) {
          let %16: Bool = prim is(e.1, %15) @48:1
          if %16 { @48:1
            jump k3("no file") @48:1
          } else {
            reraise e.1 @48:1
          }
        }
      }
    } in {
      let %17: Exception = member readline.endOfInput @24:35
      try catching (%17) {
        let %18: String = call readline.readLine("5> ") @24:5
        jump k2(%18) @24:1
      } handle (e.2: Exception) {
        let %19: Bool = prim is(e.2, %17) @24:1
        if %19 { @24:1
          jump k2("still the end") @24:1
        } else {
          reraise e.2 @24:1
        }
      }
    }
  } in {
    let %20: Exception = member readline.endOfInput @23:35
    try catching (%20) {
      let %21: String = call readline.readLine("4> ") @23:5
      jump k1(%21) @23:1
    } handle (e.3: Exception) {
      let %22: Bool = prim is(e.3, %20) @23:1
      if %22 { @23:1
        jump k1("the end") @23:1
      } else {
        reraise e.3 @23:1
      }
    }
  }
}

