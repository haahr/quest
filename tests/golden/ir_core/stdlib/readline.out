import readline = "io/readline" : io/Readline
import reader = "reader" : Reader
import writer = "writer" : Writer
import system = "system" : System
main {
  let %1: Bool = call readline.editing() @14:1
  let %2: String = call readline.readLine("1> ") @17:1
  let %3: String = call readline.readLine("2> ") @18:1
  let %4: reader.T = member reader.input @19:16
  let %5: Char = call reader.getChar(%4) @19:1
  let %6: String = call readline.readLine("") @20:1
  let %7: String = call readline.readLine("3> ") @21:1
  join k1(r: String) {
    join k2(r.1: String) {
      do call readline.addHistory("alpha") @26:1
      do call readline.addHistory("beta gamma") @27:1
      do call readline.addHistory("") @28:1
      do call readline.addHistory("delta") @29:1
      do call readline.writeHistory("short.txt", 2) @30:1
      funs {
        fun contents(name: String): String {
          let r.2: reader.T = call reader.file(name) @32:19
          let s: String = call reader.getString(r.2, 1000) @32:45
          do call reader.close(r.2) @32:70
          return s
        }
      }
      let %8: String = call contents("short.txt") @33:1
      do call readline.readHistory("missing.txt") @34:1
      let %9: Bool = call system.isFile("missing.txt") @35:1
      do call readline.readHistory("short.txt") @36:1
      do call readline.writeHistory("all.txt", 100) @37:1
      let %10: String = call contents("all.txt") @38:1
      let w: writer.T = call writer.file("unterminated.txt") @39:9
      do call writer.putString(w, "one\ntwo") @40:1
      do call writer.close(w) @41:1
      do call readline.readHistory("unterminated.txt") @42:1
      do call readline.writeHistory("tail.txt", 3) @43:1
      let %11: String = call contents("tail.txt") @44:1
      do call readline.writeHistory("none.txt", 0) @45:1
      let %12: String = call contents("none.txt") @46:1
      join k3(r.3: String) {
        join k4(r.4: String) {
        } in {
          let %13: Exception = member readline.error @48:61
          try catching (%13) {
            do call readline.writeHistory("negative.txt", -1) @48:5
            jump k4("written") @48:1
          } handle (e: Exception) {
            let %14: Bool = prim is(e, %13) @48:1
            if %14 { @48:1
              jump k4("negative") @48:1
            } else {
              reraise e @48:1
            }
          }
        }
      } in {
        let %15: Exception = member readline.error @47:69
        try catching (%15) {
          do call readline.writeHistory("no/such/directory.txt", 5) @47:5
          jump k3("written") @47:1
        } handle (e.1: Exception) {
          let %16: Bool = prim is(e.1, %15) @47:1
          if %16 { @47:1
            jump k3("no file") @47:1
          } else {
            reraise e.1 @47:1
          }
        }
      }
    } in {
      let %17: Exception = member readline.endOfInput @23:35
      try catching (%17) {
        let %18: String = call readline.readLine("5> ") @23:5
        jump k2(%18) @23:1
      } handle (e.2: Exception) {
        let %19: Bool = prim is(e.2, %17) @23:1
        if %19 { @23:1
          jump k2("still the end") @23:1
        } else {
          reraise e.2 @23:1
        }
      }
    }
  } in {
    let %20: Exception = member readline.endOfInput @22:35
    try catching (%20) {
      let %21: String = call readline.readLine("4> ") @22:5
      jump k1(%21) @22:1
    } handle (e.3: Exception) {
      let %22: Bool = prim is(e.3, %20) @22:1
      if %22 { @22:1
        jump k1("the end") @22:1
      } else {
        reraise e.3 @22:1
      }
    }
  }
}

