import dynamic = "dynamic" : Dynamic
import reader = "reader" : Reader
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  funs {
    fun line(s: String): Ok {
      let %1: writer.T = member writer.output
      do call writer.putString(%1, s)
      let %2: writer.T = member writer.output
      let %3: Ok = call writer.putString(%2, "\n")
      return %3
    }
  }
  funs rec {
    fun sum(l: IntList): Int {
      join k1(r: Int) {
        return r
      } in {
        switch tag(l) {
          case nil: {
            jump k1(0)
          }
          case cons (c: Tuple head: Int tail: IntList end): {
            let %4: Int = tuple_field(c, 0)
            let %5: IntList = tuple_field(c, 1)
            let %6: Int = call sum(%5)
            let %7: Int = prim +(%4, %6)
            jump k1(%7)
          }
        }
      }
    }
  }
  let %8: reader.T = member reader.input
  let %9: T = call dynamic.intern(%8)
  let l.1: IntList = call dynamic.be [IntList](%9)
  let %10: Int = call sum(l.1)
  let %11: String = call conv.int(%10)
  let %12: Int = ordinal(l.1) in (nil cons)
  let %13: String = call conv.int(%12)
  let %14: String = prim <>(" ", %13)
  let %15: String = prim <>(%11, %14)
  do call line(%15)
  let %16: reader.T = member reader.input
  let %17: T = call dynamic.intern(%16)
  let r.1: Result = call dynamic.be [Result](%17)
  join k2(r.2: String) {
    do call line(r.2)
  } in {
    switch tag(r.1) {
      case success: {
        jump k2("success")
      }
      case error (n: Int): {
        let %18: String = call conv.int(n)
        jump k2(%18)
      }
    }
  }
}

