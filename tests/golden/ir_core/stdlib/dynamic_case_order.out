import dynamic = "dynamic" : Dynamic
import reader = "reader" : Reader
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  funs {
    fun line(s: String): Ok {
      let %1: writer.T = member writer.output @11:50
      do call writer.putString(%1, s) @11:33
      let %2: writer.T = member writer.output @11:84
      let %3: Ok = call writer.putString(%2, "\n") @11:67
      return %3
    }
  }
  funs rec {
    fun sum(l: IntList): Int {
      join k1(r: Int) {
        return r
      } in {
        switch tag(l) { @14:32
          case nil: {
            jump k1(0) @14:32
          }
          case cons (c: Tuple head: Int tail: IntList end): {
            let %4: Int = tuple_field(c, 0) @14:77
            let %5: IntList = tuple_field(c, 1) @14:90
            let %6: Int = call sum(%5) @14:86
            let %7: Int = prim +(%4, %6) @14:77
            jump k1(%7) @14:32
          }
        }
      }
    }
  }
  let %8: reader.T = member reader.input @15:44
  let %9: T = call dynamic.intern(%8) @15:29
  let l.1: IntList = call dynamic.be [IntList](%9) @15:9
  let %10: Int = call sum(l.1) @16:15
  let %11: String = call conv.int(%10) @16:6
  let %12: Int = ordinal(l.1) in (nil cons) @16:42
  let %13: String = call conv.int(%12) @16:33
  let %14: String = prim <>(" ", %13) @16:26
  let %15: String = prim <>(%11, %14) @16:6
  do call line(%15) @16:1
  let %16: reader.T = member reader.input @19:43
  let %17: T = call dynamic.intern(%16) @19:28
  let r.1: Result = call dynamic.be [Result](%17) @19:9
  join k2(r.2: String) {
    do call line(r.2) @20:1
  } in {
    switch tag(r.1) { @20:6
      case success: {
        jump k2("success") @20:6
      }
      case error (n: Int): {
        let %18: String = call conv.int(n) @20:64
        jump k2(%18) @20:6
      }
    }
  }
}

