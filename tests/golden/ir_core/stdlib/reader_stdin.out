import reader = "reader" : Reader
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let r: reader.T = member reader.input
  let m: Bool = call reader.more(r)
  let %1: writer.T = member writer.output
  let %2: String = call conv.bool(m)
  do call writer.putString(%1, %2)
  let %3: writer.T = member writer.output
  do call writer.putString(%3, "\n")
  let line: String = call reader.getString(r, 18)
  let %4: writer.T = member writer.output
  do call writer.putString(%4, line)
  let ch: Char = call reader.getChar(r)
  let %5: writer.T = member writer.output
  let %6: String = call external "quest_conv_char"(ch)
  do call writer.putString(%5, %6)
  let %7: writer.T = member writer.output
  do call writer.putString(%7, "\n")
}

