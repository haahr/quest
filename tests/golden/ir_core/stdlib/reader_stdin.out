import reader = "reader" : Reader
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let r: reader.T = member reader.input @9:9
  let m: Bool = call reader.more(r) @10:9
  let %1: writer.T = member writer.output @11:18
  let %2: String = call conv.bool(m) @11:32
  do call writer.putString(%1, %2) @11:1
  let %3: writer.T = member writer.output @12:18
  do call writer.putString(%3, "\n") @12:1
  let line: String = call reader.getString(r, 18) @14:12
  let %4: writer.T = member writer.output @15:18
  do call writer.putString(%4, line) @15:1
  let ch: Char = call reader.getChar(r) @17:10
  let %5: writer.T = member writer.output @18:18
  let %6: String = call conv.char(ch) @18:32
  do call writer.putString(%5, %6) @18:1
  let %7: writer.T = member writer.output @19:18
  do call writer.putString(%7, "\n") @19:1
}

