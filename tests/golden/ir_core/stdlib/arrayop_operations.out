import arrayOp = "arrayOp" : ArrayOp
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let a: Array(Int) = array_rep(3, 42) @7:9
  let sz: Int = prim extent(a) @8:10
  let elem0: Int = index(a, 0) @9:13
  store a[1] := 99 @10:1
  let elem1: Int = index(a, 1) @11:13
  let %1: writer.T = member writer.output @13:18
  let %2: String = call conv.int(sz) @13:32
  do call writer.putString(%1, %2) @13:1
  let %3: writer.T = member writer.output @14:18
  do call writer.putString(%3, " ") @14:1
  let %4: writer.T = member writer.output @15:18
  let %5: String = call conv.int(elem0) @15:32
  do call writer.putString(%4, %5) @15:1
  let %6: writer.T = member writer.output @16:18
  do call writer.putString(%6, " ") @16:1
  let %7: writer.T = member writer.output @17:18
  let %8: String = call conv.int(elem1) @17:32
  do call writer.putString(%7, %8) @17:1
  let %9: writer.T = member writer.output @18:18
  do call writer.putString(%9, "\n") @18:1
}

