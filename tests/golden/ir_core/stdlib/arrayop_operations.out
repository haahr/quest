main {
  let a: Array(Int) = call arrayOp.new [Int](3, 42)
  let sz: Int = call arrayOp.size [Int](a)
  let elem0: Int = call arrayOp.get [Int](a, 0)
  do call arrayOp.set [Int](a, 1, 99)
  let elem1: Int = call arrayOp.get [Int](a, 1)
  let %1: writer.T = member writer.output
  let %2: String = call conv.int(sz)
  do call writer.putString(%1, %2)
  let %3: writer.T = member writer.output
  do call writer.putString(%3, " ")
  let %4: writer.T = member writer.output
  let %5: String = call conv.int(elem0)
  do call writer.putString(%4, %5)
  let %6: writer.T = member writer.output
  do call writer.putString(%6, " ")
  let %7: writer.T = member writer.output
  let %8: String = call conv.int(elem1)
  do call writer.putString(%7, %8)
  let %9: writer.T = member writer.output
  do call writer.putString(%9, "\n")
}

