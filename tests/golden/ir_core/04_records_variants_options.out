main {
  let c: Color = option(red) @10:9
  funs {
    fun colorCode(col: Color): Int {
      join k1(r: Int) {
        return r
      } in {
        switch tag(col) { @13:5
          case red: {
            jump k1(1) @13:5
          }
          case green: {
            jump k1(2) @13:5
          }
          case blue (b: Tuple intensity: Int end): {
            let %1: Int = tuple_field(b, 0) @16:57
            jump k1(%1) @13:5
          }
          else: {
            jump k1(0) @13:5
          }
        }
      }
    }
  }
  let p: Record x: Int y: Int end = record(x = 10, y = 20) @25:9
  let px: Int = record_field(p, x) @30:10
  let arr1: Array(Int) = array(1, 2, 3, 4, 5) @32:12
  let arr2: Array(Int) = array_rep(10, 0) @33:12
  let first: Int = index(arr1, 0) @34:13
  let codeRed: Int = call colorCode(c) @35:15
}

