main {
  let c: Color = option(red)
  funs {
    fun colorCode(col: Color): Int {
      join k1(r: Int) {
        return r
      } in {
        switch tag(col) {
          case red: {
            jump k1(1)
          }
          case green: {
            jump k1(2)
          }
          case blue (b: Tuple intensity: Int end): {
            let %1: Int = tuple_field(b, 0)
            jump k1(%1)
          }
          else: {
            jump k1(0)
          }
        }
      }
    }
  }
  let p: Record x: Int y: Int end = record(x = 10, y = 20)
  let px: Int = record_field(p, x)
  let arr1: Array(Int) = array(1, 2, 3, 4, 5)
  let arr2: Array(Int) = array_rep(10, 0)
  let first: Int = index(arr1, 0)
  let codeRed: Int = call colorCode(c)
}

