module intStack : IntStack {
  let items: Array(Int) = array_rep(10, 0)
  let top: Int = 0
  let empty: Tuple items: Array(Int) top: Int end = tuple(items, top)
  funs {
    fun push(s: Stack, x: Int): Stack {
      return s
    }
  }
  funs {
    fun pop(s.1: Stack): Int {
      return 0
    }
  }
  let intStack_record: Record empty: Tuple items: Array(Int) top: Int end push: Fun(s: Stack x: Int): Stack pop: Fun(s: Stack): Int end = record(empty = empty, push = push, pop = pop)
  export empty = empty, push = push, pop = pop
  record intStack_record
}
main {
}

