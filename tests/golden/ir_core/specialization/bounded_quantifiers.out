import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @6:12
  funs {
    fun printInt(x: Int): Ok {
      let %1: String = call conv.int(x) @9:31
      do call writer.putString(wOut, %1) @9:9
      let %2: Ok = call writer.putString(wOut, "\n") @10:9
      return %2
    }
  }
  funs {
    fun getX [A::<: Point](p: A): Int {
      let %3: Int = record_field(p, x) @16:34
      return %3
    }
  }
  funs {
    fun getY [A::<: Point](p.1: A): Int {
      let %4: Int = record_field(p.1, y) @17:34
      return %4
    }
  }
  let p.2: Record x: Int y: Int z: Int end = record(x = 42, y = 100, z = 999) @19:9
  let %5: Int = call getX [Point3D](p.2) @20:10
  do call printInt(%5) @20:1
  let %6: Int = call getY [Point3D](p.2) @21:10
  do call printInt(%6) @21:1
  funs {
    fun identity [A::<: Point](p.3: A): A {
      return p.3
    }
  }
  let p2: Point3D = call identity [Point3D](p.2) @24:19
  let %7: Int = record_field(p2, x) @25:10
  do call printInt(%7) @25:1
  let %8: Int = record_field(p2, z) @26:10
  do call printInt(%8) @26:1
}

