import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @6:12
  funs {
    fun printInt(x: Int): Ok {
      let %1: String = call conv.int(x) @9:31
      do call writer.putString(wOut, %1) @9:9
      let %2: Ok = call writer.putString(wOut, "\n") @10:9
      return %2
    }
  }
  let %3: Record id: Int val: Int end = record(id = 1, val = 10) @16:5
  let %4: Record id: Int val: Int end = record(id = 2, val = 20) @17:5
  let %5: Record id: Int val: Int end = record(id = 3, val = 30) @18:5
  let a: Array(Record id: Int val: Int end) = array(%3, %4, %5) @15:9
  let %6: Record id: Int val: Int end = index(a, 0) @21:10
  let %7: Int = record_field(%6, id) @21:10
  do call printInt(%7) @21:1
  let %8: Record id: Int val: Int end = index(a, 0) @22:10
  let %9: Int = record_field(%8, val) @22:10
  do call printInt(%9) @22:1
  let %10: Record id: Int val: Int end = index(a, 2) @23:10
  let %11: Int = record_field(%10, id) @23:10
  do call printInt(%11) @23:1
  let %12: Record id: Int val: Int end = index(a, 2) @24:10
  let %13: Int = record_field(%12, val) @24:10
  do call printInt(%13) @24:1
  let %14: Record id: Int val: Int end = record(id = 99, val = 200) @26:9
  store a[1] := %14 @26:1
  let %15: Record id: Int val: Int end = index(a, 1) @27:10
  let %16: Int = record_field(%15, id) @27:10
  do call printInt(%16) @27:1
  let %17: Record id: Int val: Int end = index(a, 1) @28:10
  let %18: Int = record_field(%17, val) @28:10
  do call printInt(%18) @28:1
}

