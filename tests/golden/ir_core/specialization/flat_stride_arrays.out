main {
  let wOut: writer.T = member writer.output
  funs {
    fun printInt(x: Int): Ok {
      let %1: String = call conv.int(x)
      do call writer.putString(wOut, %1)
      let %2: Ok = call writer.putString(wOut, "\n")
      return %2
    }
  }
  let %3: Record id: Int val: Int end = record(id = 1, val = 10)
  let %4: Record id: Int val: Int end = record(id = 2, val = 20)
  let %5: Record id: Int val: Int end = record(id = 3, val = 30)
  let a: Array(Record id: Int val: Int end) = array(%3, %4, %5)
  let %6: Record id: Int val: Int end = index(a, 0)
  let %7: Int = record_field(%6, id)
  do call printInt(%7)
  let %8: Record id: Int val: Int end = index(a, 0)
  let %9: Int = record_field(%8, val)
  do call printInt(%9)
  let %10: Record id: Int val: Int end = index(a, 2)
  let %11: Int = record_field(%10, id)
  do call printInt(%11)
  let %12: Record id: Int val: Int end = index(a, 2)
  let %13: Int = record_field(%12, val)
  do call printInt(%13)
  let %14: Record id: Int val: Int end = record(id = 99, val = 200)
  store a[1] := %14
  let %15: Record id: Int val: Int end = index(a, 1)
  let %16: Int = record_field(%15, id)
  do call printInt(%16)
  let %17: Record id: Int val: Int end = index(a, 1)
  let %18: Int = record_field(%17, val)
  do call printInt(%18)
}

