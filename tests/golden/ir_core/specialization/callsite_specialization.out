import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @6:12
  funs {
    fun printInt(x: Int): Ok {
      let %1: String = call conv.int(x) @9:31
      do call writer.putString(wOut, %1) @9:9
      let %2: Ok = call writer.putString(wOut, "\n") @10:9
      return %2
    }
  }
  funs {
    fun id [A::TYPE](a: A): A {
      return a
    }
  }
  let p: Record x: Int y: Int end = record(x = 42, y = 100) @16:9
  let pRes: Point = call id [Point](p) @17:12
  let %3: Int = record_field(pRes, x) @18:10
  do call printInt(%3) @18:1
  let %4: Int = record_field(pRes, y) @19:10
  do call printInt(%4) @19:1
  funs {
    fun pair [A::TYPE B::TYPE](a.1: A, b: B): Tuple first: A second: B end {
      let first: A = a.1 @22:23
      let second: B = b @22:38
      let %5: Tuple first: A second: B end = tuple(first, second) @22:5
      return %5
    }
  }
  let pr: Tuple first: Int second: Point end = call pair [Int Point](10, p) @24:10
  let %6: Int = tuple_field(pr, 0) @25:10
  do call printInt(%6) @25:1
  let %7: Point = tuple_field(pr, 1) @26:10
  let %8: Int = record_field(%7, x) @26:10
  do call printInt(%8) @26:1
}

