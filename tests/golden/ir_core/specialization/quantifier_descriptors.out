import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output
  funs {
    fun printInt(x: Int): Ok {
      let %1: String = call external "quest_conv_int"(x)
      do call writer.putString(wOut, %1)
      let %2: Ok = call writer.putString(wOut, "\n")
      return %2
    }
  }
  funs {
    fun id [A::TYPE](x.1: A): A {
      return x.1
    }
  }
  let %3: Int = call id [Int](10)
  do call printInt(%3)
  let %4: Int = call id [Int](20)
  do call printInt(%4)
  funs {
    fun forward [A::TYPE](x.2: A): A {
      let %5: A = call id [A](x.2)
      return %5
    }
  }
  let %6: Int = call forward [Int](30)
  do call printInt(%6)
  funs {
    fun nested [A::TYPE B::TYPE](x.3: A, y: B): Int {
      let f: A = call id [A](x.3)
      let g: B = call id [B](y)
      return 42
    }
  }
  let %7: Int = call nested [Int String](1, "test")
  do call printInt(%7)
}

