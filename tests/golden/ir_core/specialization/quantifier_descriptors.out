import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @6:12
  funs {
    fun printInt(x: Int): Ok {
      let %1: String = call conv.int(x) @9:31
      do call writer.putString(wOut, %1) @9:9
      let %2: Ok = call writer.putString(wOut, "\n") @10:9
      return %2
    }
  }
  funs {
    fun id [A::TYPE](x.1: A): A {
      return x.1
    }
  }
  let %3: Int = call id [Int](10) @14:10
  do call printInt(%3) @14:1
  let %4: Int = call id [Int](20) @15:10
  do call printInt(%4) @15:1
  funs {
    fun forward [A::TYPE](x.2: A): A {
      let %5: A = call id [A](x.2) @17:32
      return %5
    }
  }
  let %6: Int = call forward [Int](30) @18:10
  do call printInt(%6) @18:1
  funs {
    fun nested [A::TYPE B::TYPE](x.3: A, y: B): Int {
      let f: A = call id [A](x.3) @22:17
      let g: B = call id [B](y) @23:17
      return 42
    }
  }
  let %7: Int = call nested [Int String](1, "test") @26:10
  do call printInt(%7) @26:1
}

