main {
  let wOut: writer.T = member writer.output
  funs {
    fun printInt(x: Int): Ok {
      let %1: String = call conv.int(x)
      do call writer.putString(wOut, %1)
      let %2: Ok = call writer.putString(wOut, "\n")
      return %2
    }
  }
  funs {
    fun getX(b: Base): Int {
      let %3: Int = record_field(b, x)
      return %3
    }
  }
  let d: Record x: Int y: Int end = record(x = 100, y = 200)
  let a: Array(Record x: Int y: Int end) = array(d, d)
  let %4: Record x: Int y: Int end = index(a, 0)
  let %5: Int = call getX(%4)
  do call printInt(%5)
  let %6: Record x: Int y: Int end = index(a, 1)
  let %7: Int = call getX(%6)
  do call printInt(%7)
  let first: Record x: Int y: Int end = d
  let tag: Int = 1
  let t: Tuple first: Record x: Int y: Int end tag: Int end = tuple(first, tag)
  let %8: Record x: Int y: Int end = tuple_field(t, 0)
  let %9: Int = call getX(%8)
  do call printInt(%9)
  let %10: Int = tuple_field(t, 1)
  do call printInt(%10)
}

