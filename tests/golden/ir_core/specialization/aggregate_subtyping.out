import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @6:12
  funs {
    fun printInt(x: Int): Ok {
      let %1: String = call conv.int(x) @9:31
      do call writer.putString(wOut, %1) @9:9
      let %2: Ok = call writer.putString(wOut, "\n") @10:9
      return %2
    }
  }
  funs {
    fun getX(b: Base): Int {
      let %3: Int = record_field(b, x) @16:26
      return %3
    }
  }
  let d: Record x: Int y: Int end = record(x = 100, y = 200) @18:9
  let a: Array(Record x: Int y: Int end) = array(d, d) @19:9
  let %4: Record x: Int y: Int end = index(a, 0) @21:15
  let %5: Int = call getX(%4) @21:10
  do call printInt(%5) @21:1
  let %6: Record x: Int y: Int end = index(a, 1) @22:15
  let %7: Int = call getX(%6) @22:10
  do call printInt(%7) @22:1
  let first: Record x: Int y: Int end = d @24:27
  let tag: Int = 1 @24:39
  let t: Tuple first: Record x: Int y: Int end tag: Int end = tuple(first, tag) @24:9
  let %8: Record x: Int y: Int end = tuple_field(t, 0) @25:15
  let %9: Int = call getX(%8) @25:10
  do call printInt(%9) @25:1
  let %10: Int = tuple_field(t, 1) @26:10
  do call printInt(%10) @26:1
}

