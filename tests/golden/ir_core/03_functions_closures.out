main {
  funs {
    fun add1(x: Int): Int {
      let %1: Int = prim +(x, 1)
      return %1
    }
  }
  funs {
    fun adder(x.1: Int): Fun(y: Int): Int {
      funs {
        fun f(y: Int): Int {
          let %2: Int = prim +(x.1, y)
          return %2
        }
      }
      return f
    }
  }
  funs {
    fun apply(f.1: Fun(x: Int): Int, x.2: Int): Int {
      let %3: Int = call f.1(x.2)
      return %3
    }
  }
  let res: Int = call apply(add1, 41)
}

