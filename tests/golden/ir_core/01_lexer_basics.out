main {
  let x: Int = 0 @9:13
  let y: Real = 0.0 @10:13
  let origin: T = tuple(x, y) @8:18
  funs {
    fun add(p1: T, p2: T): T {
      let %1: Int = tuple_field(p1, 0) @14:13
      let %2: Int = tuple_field(p2, 0) @14:20
      let x.1: Int = prim +(%1, %2) @14:13
      let %3: Real = tuple_field(p1, 1) @15:13
      let %4: Real = tuple_field(p2, 1) @15:21
      let y.1: Real = prim ++(%3, %4) @15:13
      let %5: Tuple x: Int y: Real end = tuple(x.1, y.1) @13:27
      return %5
    }
  }
}

