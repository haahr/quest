main {
  let x: Int = 0
  let y: Real = 0.0
  let origin: T = tuple(x, y)
  funs {
    fun add(p1: T, p2: T): T {
      let %1: Int = tuple_field(p1, 0)
      let %2: Int = tuple_field(p2, 0)
      let x.1: Int = prim +(%1, %2)
      let %3: Real = tuple_field(p1, 1)
      let %4: Real = tuple_field(p2, 1)
      let y.1: Real = prim ++(%3, %4)
      let %5: Tuple x: Int y: Real end = tuple(x.1, y.1)
      return %5
    }
  }
}

