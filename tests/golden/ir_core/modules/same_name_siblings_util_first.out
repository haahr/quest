import helper = "helper" : Helper
import m = "scaler" : Scaler
import um = "util/scaler" : util/Scaler
main {
  let %1: Int = call um.combine(6, 7) @7:1
  let %2: Int = call m.combine(100) @7:19
  let %3: Int = member helper.bonus @7:36
  let %4: Int = prim +(%2, %3) @7:19
  let %5: Int = prim +(%1, %4) @7:1
}

