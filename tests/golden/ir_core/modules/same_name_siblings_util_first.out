import um = "util/scaler" : util/Scaler
import m = "scaler" : Scaler
import helper = "helper" : Helper
main {
  let %1: Int = call um.combine(6, 7) @6:1
  let %2: Int = call m.combine(100) @6:19
  let %3: Int = member helper.bonus @6:36
  let %4: Int = prim +(%2, %3) @6:19
  let %5: Int = prim +(%1, %4) @6:1
}

