import aliasTally = "aliasTally" : AliasTally
import conv = "conv" : Conv
import writer = "writer" : Writer
main {
  let t: T = call aliasTally.make("a//b/./c") @10:9
  do call aliasTally.add(t, 3) @11:1
  do call aliasTally.add(t, 4) @12:1
  let %1: writer.T = member writer.output @13:18
  let %2: Int = call aliasTally.total(t) @13:53
  let %3: String = call conv.int(%2) @13:44
  let %4: String = prim <>(%3, "\n") @13:44
  let %5: String = prim <>("total ", %4) @13:32
  do call writer.putString(%1, %5) @13:1
}

