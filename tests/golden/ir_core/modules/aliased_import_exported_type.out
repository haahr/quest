import aliasTally = "aliasTally" : AliasTally
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let t: T = call aliasTally.make("a//b/./c")
  do call aliasTally.add(t, 3)
  do call aliasTally.add(t, 4)
  let %1: writer.T = member writer.output
  let %2: Int = call aliasTally.total(t)
  let %3: String = call conv.int(%2)
  let %4: String = prim <>(%3, "\n")
  let %5: String = prim <>("total ", %4)
  do call writer.putString(%1, %5)
}

