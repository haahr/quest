import aliasTally = "aliasTally" : AliasTally
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let t: T = call aliasTally.make("a//b/./c") @11:9
  do call aliasTally.add(t, 3) @12:1
  do call aliasTally.add(t, 4) @13:1
  let %1: writer.T = member writer.output @14:18
  let %2: Int = call aliasTally.total(t) @14:53
  let %3: String = call conv.int(%2) @14:44
  let %4: String = prim <>(%3, "\n") @14:44
  let %5: String = prim <>("total ", %4) @14:32
  do call writer.putString(%1, %5) @14:1
}

