main {
  funs {
    fun f(): Real {
      let %2: openedCounter.T = call opened/tests/source/modules/openedcounter.make(2.0) @10:21
      var c.2: openedCounter.T = %2 @10:9
      let %3: Var(openedCounter.T) = addr c.2 @11:28
