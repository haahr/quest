import small = "geom/small" : geom/Small
main {
  let big: Big = record(a = 1, b = 2) @14:16
  let r: Record f: Mid g: Int end = record(f = big, g = 7) @15:35
  let a: Int = 5 @18:30
  let b: String = "s" @18:50
  let a2: Int = 6 @18:54
  let %1: Tuple b: String a2: Int end = tuple(b, a2) @18:45
  let inner: Auto B :: TYPE with b: B a2: Int end = auto[String](%1) @18:32
  let %2: Tuple a: Int inner: Auto B :: TYPE with b: B a2: Int end end = tuple(a, inner) @18:25
  let n: Nest = auto[Int](%2) @18:15
  let p: small.P = call small.p(4) @20:26
  let held: Tuple p: small.P end = tuple(p) @20:12
}

