import small = "geom/small" : geom/Small
main {
  let big: Big = record(a = 1, b = 2) @12:16
  let r: Record f: Mid g: Int end = record(f = big, g = 7) @13:35
  let a: Int = 5 @16:30
  let b: String = "s" @16:50
  let a2: Int = 6 @16:54
  let %1: Tuple b: String a2: Int end = tuple(b, a2) @16:45
  let inner: Auto B :: TYPE with b: B a2: Int end = auto[String](%1) @16:32
  let %2: Tuple a: Int inner: Auto B :: TYPE with b: B a2: Int end end = tuple(a, inner) @16:25
  let n: Nest = auto[Int](%2) @16:15
  let p: small.P = call small.p(4) @18:26
  let held: Tuple p: small.P end = tuple(p) @18:12
}

