import alarms = "alarms" : Alarms
import conv = "conv" : Conv
main {
  funs {
    fun describe(n: Int): String {
      join k1(r: String) {
        return r
      } in {
        let %1: Exception = member alarms.alarm @5:10
        let %2: Exception(Int) = member alarms.signal @6:10
        try catching (%1, %2) {
          let %3: Int = call alarms.check(n) @4:15
          jump k1("fine") @4:5
        } handle (e: Exception) {
          let %4: Bool = prim is(e, %1) @4:5
          if %4 { @4:5
            jump k1("alarm") @4:5
          } else {
            let %5: Bool = prim is(e, %2) @4:5
            if %5 { @4:5
              let k: Int = exception_payload(e) @4:5
              let %6: String = call conv.int(k) @6:49
              let %7: String = prim <>("signal ", %6) @6:36
              jump k1(%7) @4:5
            } else {
              reraise e @4:5
            }
          }
        }
      }
    }
  }
  let %8: String = call describe(2) @8:1
  let %9: String = call describe(1) @8:24
  let %10: String = call describe(0) @8:47
  let %11: String = prim <>(", ", %10) @8:39
  let %12: String = prim <>(%9, %11) @8:24
  let %13: String = prim <>(", ", %12) @8:16
  let %14: String = prim <>(%8, %13) @8:1
}

