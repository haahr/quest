import vector = "collections/vector" : collections/Vector
import path = "util/path" : util/Path
import aliasTally = "aliasTally" : AliasTally
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let t: T = call aliasTally.make("a//b/./c") @11:9
  do call aliasTally.add(t, 5) @12:1
  let %1: vector.T(Int) = tuple_field(t, 0) @13:20
  do call vector.append [Int](%1, 6) @13:1
  let %2: writer.T = member writer.output @14:18
  let %3: Int = call aliasTally.total(t) @14:53
  let %4: String = call conv.int(%3) @14:44
  let %5: vector.T(Int) = tuple_field(t, 0) @15:50
  let %6: Int = call vector.length [Int](%5) @15:31
  let %7: String = call conv.int(%6) @15:22
  let %8: path.T = tuple_field(t, 1) @15:92
  let %9: String = call path.toString(%8) @15:78
  let %10: String = prim <>(%9, "\n") @15:78
  let %11: String = prim <>(", origin ", %10) @15:63
  let %12: String = prim <>(%7, %11) @15:22
  let %13: String = prim <>(", items ", %12) @15:8
  let %14: String = prim <>(%4, %13) @14:44
  let %15: String = prim <>("total ", %14) @14:32
  do call writer.putString(%2, %15) @14:1
}

