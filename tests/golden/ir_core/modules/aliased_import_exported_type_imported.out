import vector = "collections/vector" : collections/Vector
import path = "util/path" : util/Path
import aliasTally = "aliasTally" : AliasTally
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let t: T = call aliasTally.make("a//b/./c")
  do call aliasTally.add(t, 5)
  let %1: vector.T(Int) = tuple_field(t, 0)
  do call vector.append [Int](%1, 6)
  let %2: writer.T = member writer.output
  let %3: Int = call aliasTally.total(t)
  let %4: String = call conv.int(%3)
  let %5: vector.T(Int) = tuple_field(t, 0)
  let %6: Int = call vector.length [Int](%5)
  let %7: String = call conv.int(%6)
  let %8: path.T = tuple_field(t, 1)
  let %9: String = call path.toString(%8)
  let %10: String = prim <>(%9, "\n")
  let %11: String = prim <>(", origin ", %10)
  let %12: String = prim <>(%7, %11)
  let %13: String = prim <>(", items ", %12)
  let %14: String = prim <>(%4, %13)
  let %15: String = prim <>("total ", %14)
  do call writer.putString(%2, %15)
}

