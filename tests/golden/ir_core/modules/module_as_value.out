import calc = "calc" : Calc
main {
  let m: Module 'calc' = module calc @4:9
  let fn: Fun(x: Int): Int = record_field(m, addMagic) @5:10
  let %1: Int = call fn(10) @6:1
  let %2: Fun(x: Int): Int = record_field(m, mulMagic) @6:10
  let %3: Int = call %2(2) @6:10
  let %4: Int = prim +(%1, %3) @6:1
}

