module small : Small {
  funs {
    fun q(i: Int): Int {
      let %1: Int = prim *(i, 10)
      return %1
    }
  }
  let v: Int = 7
  let oops: Exception(Int) = exception oops: Int
  let oops.1: Exception(Int) = oops
  export q = q, v = v, oops = oops.1
}
main {
  let q.1: Int = call small.q(5)
  let %2: Int = member small.v
  let v.1: Int = prim +(%2, 1)
  let oops.2: Exception(Int) = exception oops: Int
  let oops.3: Exception(Int) = oops.2
  join k1(caught: Int) {
    let %3: Int = prim +(v.1, caught)
    let %4: Int = prim +(q.1, %3)
  } in {
    try {
      let %5: Exception(Int) = member small.oops
      raise %5 with 3
    } handle (e: Exception) {
      let %6: Bool = prim is(e, oops.3)
      if %6 {
        let n: Int = exception_payload(e)
        let %7: Int = prim -(0, n)
        jump k1(%7)
      } else {
        let %8: Exception(Int) = member small.oops
        let %9: Bool = prim is(e, %8)
        if %9 {
          let n.1: Int = exception_payload(e)
          jump k1(n.1)
        } else {
          raise e
        }
      }
    }
  }
}

