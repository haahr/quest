module small : Small {
  funs {
    fun q(i: Int): Int {
      let %1: Int = prim *(i, 10) @13:26
      return %1
    }
  }
  let v: Int = 7 @14:18
  let oops: Exception(Int) = exception oops: Int @15:16
  let oops.1: Exception(Int) = oops @15:16
  let small_record: Record q: Fun(i: Int): Int v: Int oops: Exception(Int) end = record(q = q, v = v, oops = oops.1)
  export q = q, v = v, oops = oops.1
  record small_record
}
main {
  let q.1: Int = call small.q(5) @17:9
  let %2: Int = member small.v @18:9
  let v.1: Int = prim +(%2, 1) @18:9
  let oops.2: Exception(Int) = exception oops: Int @19:12
  let oops.3: Exception(Int) = oops.2 @19:12
  join k1(caught: Int) {
    let %3: Int = prim +(v.1, caught) @21:5
    let %4: Int = prim +(q.1, %3) @21:1
  } in {
    let %5: Exception(Int) = member small.oops @20:86
    try catching (oops.3, %5) {
      let %6: Exception(Int) = member small.oops @20:24
      raise %6 with 3 @20:18
    } handle (e: Exception) {
      let %7: Bool = prim is(e, oops.3) @20:14
      if %7 { @20:14
        let n: Int = exception_payload(e) @20:14
        let %8: Int = prim -(0, n) @20:75
        jump k1(%8) @20:14
      } else {
        let %9: Bool = prim is(e, %5) @20:14
        if %9 { @20:14
          let n.1: Int = exception_payload(e) @20:14
          jump k1(n.1) @20:14
        } else {
          reraise e @20:14
        }
      }
    }
  }
}

