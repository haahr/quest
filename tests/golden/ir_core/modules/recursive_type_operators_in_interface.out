import polytrees = "polytrees" : PolyTrees
main {
  funs {
    fun cons(t: polytrees.Tree(Int), ts: Trees): Trees {
      let head: polytrees.Tree(Int) = t
      let tail: Trees = ts
      let %1: Tuple head: polytrees.Tree(Int) tail: Rec(List :: TYPE) Option nil cons with Tuple head: polytrees.Tree(Int) tail: List end end end = tuple(head, tail)
      let %2: Trees = option(cons, %1)
      return %2
    }
  }
  let none: Trees = option(nil)
  let %3: Tree(Int) = call polytrees.leaf(1)
  let %4: Tree(Int) = call polytrees.leaf(2)
  let %5: Trees = call cons(%4, none)
  let %6: Trees = call cons(%3, %5)
  let t.1: Tree(Int) = call polytrees.node(%6)
  let %7: Trees = call cons(t.1, none)
  let %8: Record trees: List(Rec(Tree :: TYPE) Variant leaf: Int node: Wood end) end = record(trees = %7)
  let direct: polytrees.Tree(Int) = variant(node, %8)
  join k1(wood: polytrees.Wood(Int)) {
    let %9: List(Bool) = type_app polytrees.nil [Bool]
    let flags: polytrees.List(Bool) = call polytrees.cons [Bool](true, %9)
    let %10: Tree(Int) = call polytrees.leafOf [Int](1)
    let %11: List(polytrees.Tree(Int)) = type_app polytrees.nil [polytrees.Tree(Int)]
    let fromModule: Trees = call polytrees.cons [polytrees.Tree(Int)](%10, %11)
    let %12: Tuple Int head: Bool tail: Rec(List :: TYPE) Option nil cons with Tuple head: Bool tail: List end end end = payload(flags, cons) #1
    let %13: Bool = tuple_field(%12, 1)
    let boolTree: Tree(Bool) = call polytrees.leafOf [Bool](%13)
    let %14: Tree(Int) = call polytrees.node(fromModule)
    let %15: Int = call polytrees.count [Int](%14)
    let %16: Int = call polytrees.count [Bool](boolTree)
    let counted: Int = prim +(%15, %16)
    let %17: Tree(Int) = call polytrees.leaf(4)
    let mine: MyList(polytrees.Tree(Int)) = call cons(%17, none)
    let %18: Int = call polytrees.sum(direct)
    let %19: Int = call polytrees.sumWood(wood)
    let %20: Int = prim *(%19, 10)
    let %21: Tree(Int) = call polytrees.node(mine)
    let %22: Int = call polytrees.sum(%21)
    let %23: Int = prim *(%22, 100)
    let %24: Int = prim *(counted, 1000)
    let %25: Int = prim +(%23, %24)
    let %26: Int = prim +(%20, %25)
    let %27: Int = prim +(%18, %26)
  } in {
    switch tag(direct) {
      case node (w: Rec(Wood :: TYPE) Record trees: List(Tree) end): {
        jump k1(w)
      }
      else: {
        let %28: Record trees: List(Rec(Tree :: TYPE) Variant leaf: Int node: Wood end) end = record(trees = none)
        jump k1(%28)
      }
    }
  }
}

