import polytrees = "polytrees" : PolyTrees
main {
  funs {
    fun cons(t: polytrees.Tree(Int), ts: Trees): Trees {
      let head: polytrees.Tree(Int) = t @6:79
      let tail: Trees = ts @6:81
      let %1: Tuple head: polytrees.Tree(Int) tail: Rec(List :: TYPE) Option nil cons with Tuple head: polytrees.Tree(Int) tail: List end end end = tuple(head, tail) @6:53
      let %2: Trees = option(cons, %1) @6:53
      return %2
    }
  }
  let none: Trees = option(nil) @7:19
  let %3: Tree(Int) = call polytrees.leaf(1) @8:29
  let %4: Tree(Int) = call polytrees.leaf(2) @8:52
  let %5: Trees = call cons(%4, none) @8:47
  let %6: Trees = call cons(%3, %5) @8:24
  let t.1: Tree(Int) = call polytrees.node(%6) @8:9
  let %7: Trees = call cons(t.1, none) @9:91
  let %8: Record trees: List(Rec(Tree :: TYPE) Variant leaf: Int node: Wood end) end = record(trees = %7) @9:76
  let direct: polytrees.Tree(Int) = variant(node, %8) @9:35
  join k1(wood: polytrees.Wood(Int)) {
    let %9: List(Bool) = type_app polytrees.nil [Bool] @13:61
    let flags: polytrees.List(Bool) = call polytrees.cons [Bool](true, %9) @13:35
    let %10: Tree(Int) = call polytrees.leafOf [Int](1) @14:61
    let %11: List(polytrees.Tree(Int)) = type_app polytrees.nil [polytrees.Tree(Int)] @14:86
    let fromModule: Trees = call polytrees.cons [polytrees.Tree(Int)](%10, %11) @14:25
    let %12: Tuple Int head: Bool tail: Rec(List :: TYPE) Option nil cons with Tuple head: Bool tail: List end end end = payload(flags, cons) #1 @15:39
    let %13: Bool = tuple_field(%12, 1) @15:39
    let boolTree: Tree(Bool) = call polytrees.leafOf [Bool](%13) @15:16
    let %14: Tree(Int) = call polytrees.node(fromModule) @16:36
    let %15: Int = call polytrees.count [Int](%14) @16:15
    let %16: Int = call polytrees.count [Bool](boolTree) @16:66
    let counted: Int = prim +(%15, %16) @16:15
    let %17: Tree(Int) = call polytrees.leaf(4) @20:46
    let mine: MyList(polytrees.Tree(Int)) = call cons(%17, none) @20:41
    let %18: Int = call polytrees.sum(direct) @21:1
    let %19: Int = call polytrees.sumWood(wood) @21:26
    let %20: Int = prim *(%19, 10) @21:26
    let %21: Tree(Int) = call polytrees.node(mine) @21:73
    let %22: Int = call polytrees.sum(%21) @21:59
    let %23: Int = prim *(%22, 100) @21:59
    let %24: Int = prim *(counted, 1000) @21:105
    let %25: Int = prim +(%23, %24) @21:59
    let %26: Int = prim +(%20, %25) @21:26
    let %27: Int = prim +(%18, %26) @21:1
  } in {
    switch tag(direct) { @10:33
      case node (w: Rec(Wood :: TYPE) Record trees: List(Tree) end): {
        jump k1(w) @10:33
      }
      else: {
        let %28: Record trees: List(Rec(Tree :: TYPE) Variant leaf: Int node: Wood end) end = record(trees = none) @10:74
