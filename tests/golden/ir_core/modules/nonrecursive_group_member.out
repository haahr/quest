import conv = "conv" : Conv
import groupItems = "groupItems" : GroupItems
import itemBuilder = "itemBuilder" : ItemBuilder
import writer = "writer" : Writer
import maybe = "util/maybe" : util/Maybe
main {
  let %1: groupItems.Item = call itemBuilder.item(3, "x") @12:34
  let %2: groupItems.Item = call itemBuilder.item(4, "y") @12:58
  let %3: Array(Item) = array(%1, %2) @12:25
  let n: Node = call groupItems.node(%3) @12:9
  let %4: writer.T = member writer.output @13:18
  let %5: Int = tuple_field(n, 0) @13:41
  let %6: String = call conv.int(%5) @13:32
  let %7: Array(Item) = tuple_field(n, 1) @13:65
  let %8: Item = index(%7, 1) @13:65
  let %9: Int = tuple_field(%8, 0) @13:65
  let %10: String = call conv.int(%9) @13:56
  let %11: Array(Item) = tuple_field(n, 1) @14:31
  let %12: Item = index(%11, 0) @14:31
  let %13: maybe.T(String) = tuple_field(%12, 2) @14:31
  let %14: String = call maybe.unwrapOr [String](%13, "none") @14:8
  let %15: Array(Item) = tuple_field(n, 1) @14:64
  let %16: Item = index(%15, 0) @14:64
  let %17: Array(String) = tuple_field(%16, 1) @14:64
  let %18: String = index(%17, 1) @14:64
  let %19: String = prim <>(%18, "\n") @14:64
  let %20: String = prim <>(" ", %19) @14:57
  let %21: String = prim <>(%14, %20) @14:8
  let %22: String = prim <>(" ", %21) @13:87
  let %23: String = prim <>(%10, %22) @13:56
  let %24: String = prim <>(" ", %23) @13:49
  let %25: String = prim <>(%6, %24) @13:32
  do call writer.putString(%4, %25) @13:1
}

