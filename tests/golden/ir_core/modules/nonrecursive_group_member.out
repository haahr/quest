import groupItems = "groupItems" : GroupItems
import itemBuilder = "itemBuilder" : ItemBuilder
import maybe = "util/maybe" : util/Maybe
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let %1: groupItems.Item = call itemBuilder.item(3, "x") @11:34
  let %2: groupItems.Item = call itemBuilder.item(4, "y") @11:58
  let %3: Array(Item) = array(%1, %2) @11:25
  let n: Node = call groupItems.node(%3) @11:9
  let %4: writer.T = member writer.output @12:18
  let %5: Int = tuple_field(n, 0) @12:41
  let %6: String = call conv.int(%5) @12:32
  let %7: Array(Item) = tuple_field(n, 1) @12:65
  let %8: Item = index(%7, 1) @12:65
  let %9: Int = tuple_field(%8, 0) @12:65
  let %10: String = call conv.int(%9) @12:56
  let %11: Array(Item) = tuple_field(n, 1) @13:28
  let %12: Item = index(%11, 0) @13:28
  let %13: maybe.T(String) = tuple_field(%12, 2) @13:28
  let %14: String = call maybe.unwrapOr [String](%13, "none") @13:5
  let %15: Array(Item) = tuple_field(n, 1) @13:61
  let %16: Item = index(%15, 0) @13:61
  let %17: Array(String) = tuple_field(%16, 1) @13:61
  let %18: String = index(%17, 1) @13:61
  let %19: String = prim <>(%18, "\n") @13:61
  let %20: String = prim <>(" ", %19) @13:54
  let %21: String = prim <>(%14, %20) @13:5
  let %22: String = prim <>(" ", %21) @12:87
  let %23: String = prim <>(%10, %22) @12:56
  let %24: String = prim <>(" ", %23) @12:49
  let %25: String = prim <>(%6, %24) @12:32
  do call writer.putString(%4, %25) @12:1
}

