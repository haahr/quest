import pairs = "pairs" : Pairs
main {
  let %1: Int = call pairs.both() @4:2
  let %2: Int = prim *(%1, 100) @4:2
  let %3: Int = member pairs.first @4:25
  let %4: Int = prim *(%3, 10) @4:25
  let %5: Int = member pairs.second @4:45
  let %6: Int = prim +(%4, %5) @4:25
  let %7: Int = prim +(%2, %6) @4:2
}

