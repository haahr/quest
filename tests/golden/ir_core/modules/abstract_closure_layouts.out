import conv = "conv" : Conv
import writer = "writer" : Writer
import handler = "layouts/handler" : layouts/Handler
main {
  funs {
    fun line(s: String): Ok {
      let %1: writer.T = member writer.output @11:50
      do call writer.putString(%1, s) @11:33
      let %2: writer.T = member writer.output @11:84
      let %3: Ok = call writer.putString(%2, "\n") @11:67
      return %3
    }
  }
  funs {
    fun real(r: Real): Ok {
      let %4: String = call conv.real(r) @12:30
      let %5: Ok = call line(%4) @12:25
      return %5
    }
  }
  funs {
    fun point(p: handler.Point): Ok {
      let %6: Int = record_field(p, x) @13:49
      let %7: String = call conv.int(%6) @13:40
      let %8: Int = record_field(p, y) @13:73
      let %9: String = call conv.int(%8) @13:64
      let %10: String = prim <>(" ", %9) @13:57
      let %11: String = prim <>(%7, %10) @13:40
      let %12: Ok = call line(%11) @13:35
      return %12
    }
  }
  let p.1: Record x: Int y: Int end = record(x = 1, y = 2) @15:9
  let %13: handler.T(Real) = type_app handler.echo [Real] @18:24
  let %14: Real = call handler.run [Real](%13, 1.5) @18:6
  do call real(%14) @18:1
  let %15: handler.T(Real) = type_app handler.echo [Real] @19:22
  let %16: Real = call handler.runReal(%15, 2.5) @19:6
  do call real(%16) @19:1
  let %17: handler.T(Real) = call handler.shifted(10.0) @20:24
  let %18: Real = call handler.run [Real](%17, 1.5) @20:6
  do call real(%18) @20:1
  let %19: handler.T(Real) = call handler.shifted(10.0) @21:22
  let %20: Real = call handler.runReal(%19, 2.5) @21:6
  do call real(%20) @21:1
  let %21: handler.T(handler.Point) = type_app handler.echo [handler.Point] @24:34
  let %22: handler.Point = call handler.run [handler.Point](%21, p.1) @24:7
  do call point(%22) @24:1
  let %23: handler.T(handler.Point) = type_app handler.echo [handler.Point] @25:24
  let %24: Point = call handler.runPoint(%23, p.1) @25:7
  do call point(%24) @25:1
  let %25: handler.T(Point) = call handler.swapped() @26:34
  let %26: handler.Point = call handler.run [handler.Point](%25, p.1) @26:7
  do call point(%26) @26:1
  let %27: handler.T(Point) = call handler.swapped() @27:24
  let %28: Point = call handler.runPoint(%27, p.1) @27:7
  do call point(%28) @27:1
  let h: handler.T(Real) = call handler.shifted(0.5) @30:9
  let %29: Real = call handler.run [Real](h, 1.0) @31:6
  do call real(%29) @31:1
  let %30: Real = call handler.runReal(h, 2.0) @32:6
  do call real(%30) @32:1
}

