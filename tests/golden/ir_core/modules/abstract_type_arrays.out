import marks = "marks" : Marks
main {
  let %1: marks.T = call marks.mark(1)
  let %2: marks.T = call marks.mark(2)
  let %3: marks.T = call marks.mark(3)
  let a: Array(marks.T) = array(%1, %2, %3)
  let b: Array(marks.T) = call marks.fill(4)
  let %4: marks.T = call marks.mark(10)
  do call marks.setFirst(b, %4)
  let %5: Int = call marks.total(a)
  let %6: Fun(marks: Array(marks.T)): Int = call marks.totaler()
  let %7: Int = call %6(a)
  let %8: Int = call marks.total(b)
  let %9: Tuple Int Int Int end = tuple(%5, %7, %8)
}

