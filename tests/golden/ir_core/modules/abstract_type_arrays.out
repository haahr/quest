import marks = "marks" : Marks
main {
  let %1: marks.T = call marks.mark(1) @5:18
  let %2: marks.T = call marks.mark(2) @5:32
  let %3: marks.T = call marks.mark(3) @5:46
  let a: Array(marks.T) = array(%1, %2, %3) @5:9
  let b: Array(marks.T) = call marks.fill(4) @6:9
  let %4: marks.T = call marks.mark(10) @7:18
  do call marks.setFirst(b, %4) @7:1
  let %5: Int = call marks.total(a) @8:7
  let %6: Fun(marks: Array(marks.T)): Int = call marks.totaler() @8:22
  let %7: Int = call %6(a) @8:22
  let %8: Int = call marks.total(b) @8:41
  let %9: Tuple Int Int Int end = tuple(%5, %7, %8) @8:1
}

