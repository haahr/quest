import ifvalues = "ifvalues" : IfValues
module local : Local {
  join k1(small: Int) {
    let big: Int = prim *(small, 10) @16:15
    let local_record: Record small: Int big: Int end = record(small = small, big = big)
  } in {
    join k2(r: Bool) {
      if r { @15:17
        jump k1(1) @15:17
      } else {
        jump k1(2) @15:17
      }
    } in {
      let %1: Bool = prim <(2, 1) @15:21
      if %1 { @15:21
        jump k2(true) @15:21
      } else {
        let %2: Bool = prim <(1, 0) @15:34
        jump k2(%2) @15:21
      }
    }
  }
  export small = small, big = big
  record local_record
}
main {
  let %3: Int = member ifvalues.limit @19:16
  let %4: Int = call ifvalues.twice(%3) @19:1
  let %5: Int = member local.big @19:34
  let %6: Int = member ifvalues.scale @19:46
  let %7: Int = prim +(%5, %6) @19:34
  let %8: Int = prim +(%4, %7) @19:1
}

