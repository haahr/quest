import counter = "counter" : Counter
import c2 = "util/counter" : util/Counter
import stepper = "util/stepper" : util/Stepper
main {
  let %1: Int = member c2.step @7:50
  let %2: counter.T = call counter.new(%1) @7:38
  let %3: counter.T = call counter.inc(%2) @7:26
  let %4: Int = call counter.get(%3) @7:14
  let %5: Int = call stepper.next(%4) @7:1
}

