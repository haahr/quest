import conv = "conv" : Conv
import tallies = "tallies" : Tallies
import writer = "writer" : Writer
module c : C {
  var count: Int = 0 @10:21
  let c_record: Record var count: Int end = record(var count = count)
  export count = count
  record c_record
}
main {
  funs {
    fun bump(var n: Int): Ok {
      let %1: Int = prim +(n, 1) @12:33
      n := %1 @12:28
      return ok
    }
  }
  let %2: Module 'c' = module c @14:1
  store %2.count := 5 @14:1
  let %3: Module 'c' = module c @15:7
  let %4: Var(Int) = addr %3.count @15:6
  do call bump(%4) @15:1
  let r: Module 'c' = module c @16:9
  let %5: Int = record_field(r, count) @17:12
  let %6: Int = prim *(%5, 10) @17:12
  store r.count := %6 @17:1
  let %7: writer.T = member writer.output @18:18
  let %8: Module 'c' = module c @18:41
  let %9: Int = record_field(%8, count) @18:41
  let %10: String = call conv.int(%9) @18:32
  let %11: String = prim <>(%10, "\n") @18:32
  do call writer.putString(%7, %11) @18:1
  let %12: Module 'tallies' = module tallies @20:1
  store %12.total := 7 @20:1
  let %13: Module 'tallies' = module tallies @21:7
  let %14: Var(Int) = addr %13.total @21:6
  do call bump(%14) @21:1
  let %15: writer.T = member writer.output @22:18
  let %16: Module 'tallies' = module tallies @22:41
  let %17: Int = record_field(%16, total) @22:41
  let %18: String = call conv.int(%17) @22:32
  let %19: String = prim <>(%18, "\n") @22:32
  do call writer.putString(%15, %19) @22:1
  let %20: Module 'c' = module c @23:1
  let %21: Int = record_field(%20, count) @23:1
  let %22: Module 'tallies' = module tallies @23:11
  let %23: Int = record_field(%22, total) @23:11
  let %24: Int = prim +(%21, %23) @23:1
}

