import conv = "conv" : Conv
import keywordFields = "keywordFields" : KeywordFields
import writer = "writer" : Writer
main {
  let r: R = call keywordFields.make(3) @8:9
  let %1: writer.T = member writer.output @9:18
  let %2: Int = record_field(r, long) @9:41
  let %3: Int = record_field(r, default) @9:50
  let %4: Int = prim +(%2, %3) @9:41
  let %5: String = call conv.int(%4) @9:32
  let %6: String = prim <>(%5, "\n") @9:32
  do call writer.putString(%1, %6) @9:1
}

