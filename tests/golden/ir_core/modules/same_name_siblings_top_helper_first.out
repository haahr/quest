import helper = "helper" : Helper
import um = "util/scaler" : util/Scaler
import m = "scaler" : Scaler
main {
  let %1: Int = call um.combine(6, 7) @8:1
  let %2: Int = call m.combine(100) @8:19
  let %3: Int = member helper.bonus @8:36
  let %4: Int = prim +(%2, %3) @8:19
  let %5: Int = prim +(%1, %4) @8:1
}

