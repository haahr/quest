import writer = "writer" : Writer
import conv = "conv" : Conv
import shapes = "shapes" : Shapes
main {
  let radius: Int = 2 @8:71
  let %1: Tuple radius: Int end = tuple(radius) @8:23
  let c: shapes.Shape = option(circle, %1) @8:23
  let side: Int = 3 @9:83
  let %2: Tuple side: Int end = tuple(side) @9:30
  let s: shapes.ShapeOf(Int) = option(square, %2) @9:30
  let %3: writer.T = member writer.output @10:18
  let %4: Int = call shapes.area(c) @10:41
  let %5: String = call conv.int(%4) @10:32
  let %6: Int = call shapes.area(s) @10:76
  let %7: String = call conv.int(%6) @10:67
  let %8: String = prim <>(%7, "\n") @10:67
  let %9: String = prim <>(" ", %8) @10:60
  let %10: String = prim <>(%5, %9) @10:32
  do call writer.putString(%3, %10) @10:1
}

