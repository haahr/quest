main {
  let radius: Int = 2
  let %1: Tuple radius: Int end = tuple(radius)
  let c: shapes.Shape = option(circle, %1)
  let side: Int = 3
  let %2: Tuple side: Int end = tuple(side)
  let s: shapes.ShapeOf(Int) = option(square, %2)
  let %3: writer.T = member writer.output
  let %4: Int = call shapes.area(c)
  let %5: String = call conv.int(%4)
  let %6: Int = call shapes.area(s)
  let %7: String = call conv.int(%6)
  let %8: String = prim <>(%7, "\n")
  let %9: String = prim <>(" ", %8)
  let %10: String = prim <>(%5, %9)
  do call writer.putString(%3, %10)
}

