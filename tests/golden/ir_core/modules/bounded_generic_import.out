import bounded = "geom/bounded" : geom/Bounded
main {
  let wide: Record c: Int a: Int end = record(c = 4, a = 3) @9:12
  let %1: Int = call bounded.getA [Record c: Int a: Int end](wide) @10:1
  let %2: Record a: Int end = record(a = 10) @11:14
  let %3: Int = call bounded.getA [Record a: Int end](%2) @11:1
  let %4: Record a: Int end = record(a = 100, z = 1) @12:29
  let %5: Int = call bounded.getA [Bounded.Small](%4) @12:1
  let %6: Record c: Int a: Int end = call bounded.keep [Record c: Int a: Int end](wide) @13:1
  let %7: Int = record_field(%6, c) @13:1
  funs {
    fun f(): Int {
      return 7
    }
  }
  let %8: Record size: Fun(): Int name: String end = record(size = f, name = "seven") @14:17
  let %9: Int = call bounded.measure [Record size: Fun(): Int name: String end](%8) @14:1
  funs {
    fun f.1(): Int {
      return 7
    }
  }
  let %10: Record size: Fun(): Int name: String end = record(size = f.1, name = "seven") @15:23
  let %11: Int = call bounded.measureInline [Record size: Fun(): Int name: String end](%10) @15:1
  let %12: Array(Int) = array(1, 2, 3) @16:40
  funs {
    fun f.2(y: Array(Int)): Int {
      let %13: Int = prim extent(y) @16:83
      return %13
    }
  }
  let %14: Int = call bounded.applied [Fun(X :: TYPE) Array(X)](%12, f.2) @16:1
}

