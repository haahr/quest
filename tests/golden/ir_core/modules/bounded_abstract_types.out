import small = "geom/small" : geom/Small
main {
  let three: small.N = call small.n(3) @9:13
  let %1: Int = prim +(three, 1) @10:1
  let p: small.P = call small.p(4) @11:9
  let %2: Int = record_field(p, x) @12:1
  let %3: Int = call small.y(p) @13:1
  let asRecord: Record x: Int end = p @14:35
  let %4: Int = record_field(asRecord, x) @15:1
  let q: small.Q = call small.q(5) @16:9
  let %5: Int = record_field(q, y) @17:1
  let %6: Int = call small.qx(q) @18:1
  let %7: small.P = member small.origin @19:9
  let %8: Int = call small.y(%7) @19:1
  let %9: small.P = member small.origin @20:1
  let %10: Int = record_field(%9, x) @20:1
  join k1(r: Int) {
    let %11: small.V = call small.b(true) @22:14
    let %12: Bool = call small.isTrue(%11) @22:1
    let %13: small.V = member small.yes @23:14
    let %14: Bool = call small.isTrue(%13) @23:1
    join k3(r.1: Int) {
    } in {
      let %15: small.V = member small.yes @24:6
      switch tag(%15) { @24:1
        case a (i: Int): {
          let %16: Int = prim -(0, i) @24:35
          jump k3(%16) @24:1
        }
        case b (t: Bool): {
          join k4(r.2: Int) {
            jump k3(r.2) @24:1
          } in {
            if t { @24:60
              jump k4(1) @24:60
            } else {
              jump k4(2) @24:60
            }
          }
        }
      }
    }
  } in {
    let %17: small.V = call small.b(false) @21:6
    switch tag(%17) { @21:1
      case a (i.1: Int): {
        let %18: Int = prim -(0, i.1) @21:40
        jump k1(%18) @21:1
      }
      case b (t.1: Bool): {
        join k2(r.3: Int) {
          jump k1(r.3) @21:1
        } in {
          if t.1 { @21:65
            jump k2(1) @21:65
          } else {
            jump k2(2) @21:65
          }
        }
      }
    }
  }
}

