import small = "geom/small" : geom/Small
import held = "geom/held" : geom/Held
main {
  let three: small.N = call small.n(3) @12:13
  let %1: Int = prim +(three, 1) @13:1
  let p: small.P = call small.p(4) @14:9
  let %2: Int = record_field(p, x) @15:1
  let %3: Int = call small.y(p) @16:1
  let asRecord: Record x: Int end = p @17:35
  let %4: Int = record_field(asRecord, x) @18:1
  let q: small.Q = call small.q(5) @19:9
  let %5: Int = record_field(q, y) @20:1
  let %6: Int = call small.qx(q) @21:1
  let %7: small.P = member small.origin @22:9
  let %8: Int = call small.y(%7) @22:1
  let %9: small.P = member small.origin @23:1
  let %10: Int = record_field(%9, x) @23:1
  join k1(r: Int) {
    let %11: small.V = call small.b(true) @25:14
    let %12: Bool = call small.isTrue(%11) @25:1
    let %13: small.V = member small.yes @26:14
    let %14: Bool = call small.isTrue(%13) @26:1
    join k3(r.1: Int) {
      let %15: held.S = call held.s(1) @29:1
      let %16: Int = tuple_field(%15, 0) @29:1
      let w: held.W = call held.w(2) @30:9
      let %17: Int = tuple_field(w, 0) @31:1
      let %18: Int = call held.wb(w) @32:1
      let u: held.U = call held.u(4) @33:9
      let %19: Record x: Int end = tuple_field(u, 0) @34:1
      let %20: Int = record_field(%19, x) @34:1
      let %21: Int = tuple_field(u, 1) @35:1
      store u.#1 := 100 @36:1
      let %22: Int = tuple_field(u, 1) @37:1
      let %23: Int = call held.uy(u) @38:1
      let o: held.O = call held.o(4) @39:9
      join k5(r.2: Int) {
        let %24: Int = call held.oy(o) @41:1
      } in {
        switch tag(o) { @40:1
          case a: {
            jump k5(0) @40:1
          }
          case b (t: Tuple x: Int end): {
            let %25: Int = tuple_field(t, 0) @40:41
            jump k5(%25) @40:1
          }
        }
      }
    } in {
      let %26: small.V = member small.yes @27:6
      switch tag(%26) { @27:1
        case a (i: Int): {
          let %27: Int = prim -(0, i) @27:35
          jump k3(%27) @27:1
        }
        case b (t.1: Bool): {
          join k4(r.3: Int) {
            jump k3(r.3) @27:1
          } in {
            if t.1 { @27:60
              jump k4(1) @27:60
            } else {
              jump k4(2) @27:60
            }
          }
        }
      }
    }
  } in {
    let %28: small.V = call small.b(false) @24:6
    switch tag(%28) { @24:1
      case a (i.1: Int): {
        let %29: Int = prim -(0, i.1) @24:40
        jump k1(%29) @24:1
      }
      case b (t.2: Bool): {
        join k2(r.4: Int) {
          jump k1(r.4) @24:1
        } in {
          if t.2 { @24:65
            jump k2(1) @24:65
          } else {
            jump k2(2) @24:65
          }
        }
      }
    }
  }
}

