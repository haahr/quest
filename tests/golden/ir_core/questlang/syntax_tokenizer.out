import conv = "conv" : Conv
import writer = "writer" : Writer
import diagbag = "questlang/common/diagbag" : questlang/common/DiagBag
import location = "questlang/common/location" : questlang/common/Location
import tokenizer = "questlang/syntax/tokenizer" : questlang/syntax/Tokenizer
import tokens = "questlang/syntax/tokens" : questlang/syntax/Tokens
main {
  let wOut: writer.T = member writer.output @12:12
  funs {
    fun printStr(s: String): Ok {
      do call writer.putString(wOut, s) @16:9
      let %1: Ok = call writer.putString(wOut, "\n") @17:9
      return %1
    }
  }
  funs {
    fun printInt(n: Int): Ok {
      let %2: String = call conv.int(n) @20:37
      let %3: Ok = call printStr(%2) @20:28
      return %3
    }
  }
  funs {
    fun printBool(b: Bool): Ok {
      let %4: String = call conv.bool(b) @22:39
      let %5: Ok = call printStr(%4) @22:30
      return %5
    }
  }
  let %6: String = prim <>("    else\n", "        { n * fact(n - 1) };\n") @33:12
  let %7: String = prim <>("        1\n", %6) @32:12
  let %8: String = prim <>("    if n <= 1 then\n", %7) @31:12
  let %9: String = prim <>("let rec fact(n: Int): Int =\n", %8) @30:12
  let code1: String = prim <>("(* Sample Quest program *)\n", %9) @29:5
  let sm1: location.SourceMap = call location.newSourceMap("fact.quest", code1) @36:11
  let bag1: diagbag.T = call diagbag.new() @37:12
  let tk1: tokenizer.T = call tokenizer.new(sm1, bag1) @38:11
  let allTokens: vector.T(tokens.Token) = call tokenizer.tokenizeAll(tk1) @40:17
  let dump1: String = call tokenizer.formatDump(allTokens, sm1, false) @41:13
  do call printStr(dump1) @42:1
  let %10: Bool = call diagbag.hasErrors(bag1) @43:11
  do call printBool(%10) @43:1
  let %11: Int = call diagbag.errorCount(bag1) @44:10
  do call printInt(%11) @44:1
  let code2: String = "let x = 42;" @50:13
  let sm2: location.SourceMap = call location.newSourceMap("peek.quest", code2) @51:11
  let bag2: diagbag.T = call diagbag.new() @52:12
  let tk2: tokenizer.T = call tokenizer.new(sm2, bag2) @53:11
  let p1: tokens.Token = call tokenizer.peekToken(tk2) @55:10
  let %12: TokenKind = tuple_field(p1, 0) @56:31
  let %13: String = call tokens.tokenKindName(%12) @56:10
  do call printStr(%13) @56:1
  let %14: String = tuple_field(p1, 1) @57:10
  do call printStr(%14) @57:1
  let t1: tokens.Token = call tokenizer.nextToken(tk2) @59:10
  let %15: TokenKind = tuple_field(t1, 0) @60:31
  let %16: String = call tokens.tokenKindName(%15) @60:10
  do call printStr(%16) @60:1
  let %17: String = tuple_field(t1, 1) @61:10
  do call printStr(%17) @61:1
  let p2: tokens.Token = call tokenizer.peekToken(tk2) @63:10
  let %18: TokenKind = tuple_field(p2, 0) @64:31
  let %19: String = call tokens.tokenKindName(%18) @64:10
  do call printStr(%19) @64:1
  let %20: String = tuple_field(p2, 1) @65:10
  do call printStr(%20) @65:1
  let t2: tokens.Token = call tokenizer.nextToken(tk2) @67:10
  let %21: TokenKind = tuple_field(t2, 0) @68:31
  let %22: String = call tokens.tokenKindName(%21) @68:10
  do call printStr(%22) @68:1
  let %23: String = tuple_field(t2, 1) @69:10
  do call printStr(%23) @69:1
  let %24: String = prim <>("(* outer (* nested level 2 (* nested 3 *) *) back *)\n", "ident_1 _validIdent == !=\n") @79:12
  let %25: String = prim <>("\"hello\" \"with \\\"quotes\\\" and \\n newline\"\n", %24) @78:12
  let %26: String = prim <>("'a' '\\n' '\\t' '\\'' '\\\\' '\\x41' '\\065'\n", %25) @77:12
  let code3: String = prim <>("0 42 ~100 3.14 1.5e-3 ~2.0E+2\n", %26) @76:5
  let sm3: location.SourceMap = call location.newSourceMap("literals.quest", code3) @82:11
  let bag3: diagbag.T = call diagbag.new() @83:12
  let tk3: tokenizer.T = call tokenizer.new(sm3, bag3) @84:11
  let tokens3: vector.T(tokens.Token) = call tokenizer.tokenizeAll(tk3) @86:15
  let %27: String = call tokenizer.formatDump(tokens3, sm3, false) @87:10
  do call printStr(%27) @87:1
  let %28: Bool = call diagbag.hasErrors(bag3) @88:11
  do call printBool(%28) @88:1
  let %29: String = prim <>("'too long'\n", "let final = 3;\n") @99:12
  let %30: String = prim <>("'\\z' (* invalid char escape *)\n", %29) @98:12
  let %31: String = prim <>("let alsoValid = 2;\n", %30) @97:12
  let %32: String = prim <>("\"unclosed string literal\n", %31) @96:12
  let codeErr: String = prim <>("let valid = 1;\n", %32) @95:5
  let smErr: location.SourceMap = call location.newSourceMap("error_recovery.quest", codeErr) @102:13
  let bagErr: diagbag.T = call diagbag.new() @103:14
  let tkErr: tokenizer.T = call tokenizer.new(smErr, bagErr) @104:13
  let tokensErr: vector.T(tokens.Token) = call tokenizer.tokenizeAll(tkErr) @106:17
  let %33: String = call tokenizer.formatDump(tokensErr, smErr, false) @107:10
  do call printStr(%33) @107:1
  let %34: Bool = call diagbag.hasErrors(bagErr) @108:11
  do call printBool(%34) @108:1
  let %35: Int = call diagbag.errorCount(bagErr) @109:10
  do call printInt(%35) @109:1
  do call printStr("--- Diagnostics Rendered ---") @111:1
  do call diagbag.renderAll(bagErr, smErr, wOut) @112:1
  let codeRange: String = "'\\255' '\\256' \"\\xff\\xc3\\xa9 caf\u00c3\u00a9\"\n" @118:17
  let smRange: location.SourceMap = call location.newSourceMap("byte_range.quest", codeRange) @120:15
  let bagRange: diagbag.T = call diagbag.new() @121:16
  let tkRange: tokenizer.T = call tokenizer.new(smRange, bagRange) @122:15
  let tokensRange: vector.T(tokens.Token) = call tokenizer.tokenizeAll(tkRange) @124:19
  let %36: String = call tokenizer.formatDump(tokensRange, smRange, false) @125:10
  do call printStr(%36) @125:1
  let %37: Int = call diagbag.errorCount(bagRange) @126:10
  do call printInt(%37) @126:1
  do call diagbag.renderAll(bagRange, smRange, wOut) @127:1
}

