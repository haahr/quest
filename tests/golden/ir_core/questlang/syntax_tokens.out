  let %18: Int = tuple_field(%17, 2) @36:10
  do call printInt(%18) @36:1
  let %19: TokenKind = tuple_field(tokLet, 0) @37:28
  let %20: Bool = call tokens.isKeyword(%19) @37:11
  do call printBool(%20) @37:1
  let %21: TokenKind = tuple_field(tokLet, 0) @38:28
  let %22: Bool = call tokens.isLiteral(%21) @38:11
  do call printBool(%22) @38:1
  let sp2: Span = call location.span("test.quest", 4, 7) @40:11
  let %23: tokens.TokenKind = option(ident) @41:28
