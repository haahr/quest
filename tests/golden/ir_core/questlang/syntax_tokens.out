import location = "questlang/common/location" : questlang/common/Location
import tokens = "questlang/syntax/tokens" : questlang/syntax/Tokens
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @10:12
  funs {
    fun printStr(s: String): Ok {
      do call writer.putString(wOut, s) @14:9
      let %1: Ok = call writer.putString(wOut, "\n") @15:9
      return %1
    }
  }
  funs {
    fun printInt(n: Int): Ok {
      let %2: String = call conv.int(n) @19:14
      let %3: Ok = call printStr(%2) @19:5
      return %3
    }
  }
  funs {
    fun printReal(r: Real): Ok {
      let %4: String = call conv.real(r) @22:14
      let %5: Ok = call printStr(%4) @22:5
      return %5
    }
  }
  funs {
    fun printChar(c: Char): Ok {
      let %6: String = call conv.char(c) @25:14
      let %7: Ok = call printStr(%6) @25:5
      return %7
    }
  }
  funs {
    fun printBool(b: Bool): Ok {
      let %8: String = call conv.bool(b) @28:14
      let %9: Ok = call printStr(%8) @28:5
      return %9
    }
  }
  let sp1: Span = call location.span("test.quest", 0, 3) @34:11
  let %10: tokens.TokenKind = option(kwLet) @35:26
  let %11: TokenValue = call tokens.valNone() @35:69
  let tokLet: Token = call tokens.make(%10, "let", %11, sp1) @35:14
  let %12: TokenKind = tuple_field(tokLet, 0) @37:31
  let %13: String = call tokens.tokenKindName(%12) @37:10
  do call printStr(%13) @37:1
  let %14: String = tuple_field(tokLet, 1) @38:10
  do call printStr(%14) @38:1
  let %15: location.Span = tuple_field(tokLet, 3) @39:10
  let %16: Int = tuple_field(%15, 1) @39:10
  do call printInt(%16) @39:1
  let %17: location.Span = tuple_field(tokLet, 3) @40:10
  let %18: Int = tuple_field(%17, 2) @40:10
  do call printInt(%18) @40:1
  let %19: TokenKind = tuple_field(tokLet, 0) @41:28
  let %20: Bool = call tokens.isKeyword(%19) @41:11
  do call printBool(%20) @41:1
  let %21: TokenKind = tuple_field(tokLet, 0) @42:28
  let %22: Bool = call tokens.isLiteral(%21) @42:11
  do call printBool(%22) @42:1
  let sp2: Span = call location.span("test.quest", 4, 7) @44:11
  let %23: tokens.TokenKind = option(ident) @45:28
  let %24: TokenValue = call tokens.valNone() @45:71
  let tokIdent: Token = call tokens.make(%23, "foo", %24, sp2) @45:16
  let %25: TokenKind = tuple_field(tokIdent, 0) @46:31
  let %26: String = call tokens.tokenKindName(%25) @46:10
  do call printStr(%26) @46:1
  let %27: String = tuple_field(tokIdent, 1) @47:10
  do call printStr(%27) @47:1
  let %28: TokenKind = tuple_field(tokIdent, 0) @48:28
  let %29: Bool = call tokens.isKeyword(%28) @48:11
  do call printBool(%29) @48:1
  let sp3: Span = call location.span("test.quest", 8, 10) @50:11
  let %30: tokens.TokenKind = option(intLit) @51:26
  let %31: TokenValue = call tokens.valInt(42) @51:69
  let tokInt: Token = call tokens.make(%30, "42", %31, sp3) @51:14
  let %32: TokenKind = tuple_field(tokInt, 0) @52:31
  let %33: String = call tokens.tokenKindName(%32) @52:10
  do call printStr(%33) @52:1
  let %34: String = tuple_field(tokInt, 1) @53:10
  do call printStr(%34) @53:1
  let %35: TokenKind = tuple_field(tokInt, 0) @54:28
  let %36: Bool = call tokens.isLiteral(%35) @54:11
  do call printBool(%36) @54:1
  let vInt: TokenValue = tuple_field(tokInt, 2) @55:12
  let %37: Bool = is_tag(vInt, intVal) @56:4
  if %37 { @56:1
    let %38: Tuple Int val: Int end = payload(vInt, intVal) #1 @57:14
    let %39: Int = tuple_field(%38, 1) @57:14
    do call printInt(%39) @57:5
  } else {
    do call printStr("not int") @59:5
  }
  let sp4: Span = call location.span("test.quest", 11, 15) @62:11
  let %40: tokens.TokenKind = option(realLit) @63:27
  let %41: TokenValue = call tokens.valReal(3.14) @63:73
  let tokReal: Token = call tokens.make(%40, "3.14", %41, sp4) @63:15
  let %42: TokenKind = tuple_field(tokReal, 0) @64:31
  let %43: String = call tokens.tokenKindName(%42) @64:10
  do call printStr(%43) @64:1
  let %44: String = tuple_field(tokReal, 1) @65:10
  do call printStr(%44) @65:1
  let %45: TokenKind = tuple_field(tokReal, 0) @66:28
  let %46: Bool = call tokens.isLiteral(%45) @66:11
  do call printBool(%46) @66:1
  let vReal: TokenValue = tuple_field(tokReal, 2) @67:13
  let %47: Bool = is_tag(vReal, realVal) @68:4
  if %47 { @68:1
    let %48: Tuple Int val: Real end = payload(vReal, realVal) #2 @69:15
    let %49: Real = tuple_field(%48, 1) @69:15
    do call printReal(%49) @69:5
  } else {
    do call printStr("not real") @71:5
  }
  let sp5: Span = call location.span("test.quest", 16, 19) @74:11
  let %50: tokens.TokenKind = option(charLit) @75:27
  let %51: TokenValue = call tokens.valChar('Z') @75:72
  let tokChar: Token = call tokens.make(%50, "'Z'", %51, sp5) @75:15
  let %52: TokenKind = tuple_field(tokChar, 0) @76:31
  let %53: String = call tokens.tokenKindName(%52) @76:10
  do call printStr(%53) @76:1
  let %54: String = tuple_field(tokChar, 1) @77:10
  do call printStr(%54) @77:1
  let %55: TokenKind = tuple_field(tokChar, 0) @78:28
  let %56: Bool = call tokens.isLiteral(%55) @78:11
  do call printBool(%56) @78:1
  let vChar: TokenValue = tuple_field(tokChar, 2) @79:13
  let %57: Bool = is_tag(vChar, charVal) @80:4
  if %57 { @80:1
    let %58: Tuple Int val: Char end = payload(vChar, charVal) #3 @81:15
    let %59: Char = tuple_field(%58, 1) @81:15
    do call printChar(%59) @81:5
  } else {
    do call printStr("not char") @83:5
  }
  let sp6: Span = call location.span("test.quest", 20, 27) @86:11
  let %60: tokens.TokenKind = option(stringLit) @87:26
  let %61: TokenValue = call tokens.valString("hello") @87:79
  let tokStr: Token = call tokens.make(%60, "\"hello\"", %61, sp6) @87:14
  let %62: TokenKind = tuple_field(tokStr, 0) @88:31
  let %63: String = call tokens.tokenKindName(%62) @88:10
  do call printStr(%63) @88:1
  let %64: String = tuple_field(tokStr, 1) @89:10
  do call printStr(%64) @89:1
  let %65: TokenKind = tuple_field(tokStr, 0) @90:28
  let %66: Bool = call tokens.isLiteral(%65) @90:11
  do call printBool(%66) @90:1
  let vStr: TokenValue = tuple_field(tokStr, 2) @91:12
  let %67: Bool = is_tag(vStr, stringVal) @92:4
  if %67 { @92:1
    let %68: Tuple Int val: String end = payload(vStr, stringVal) #4 @93:14
    let %69: String = tuple_field(%68, 1) @93:14
    do call printStr(%69) @93:5
  } else {
    do call printStr("not str") @95:5
  }
  let sp7: Span = call location.span("test.quest", 28, 30) @98:11
  let %70: tokens.TokenKind = option(symbolicInfix) @99:25
  let %71: TokenValue = call tokens.valNone() @99:75
  let tokOp: Token = call tokens.make(%70, ":=", %71, sp7) @99:13
  let %72: TokenKind = tuple_field(tokOp, 0) @100:31
  let %73: String = call tokens.tokenKindName(%72) @100:10
  do call printStr(%73) @100:1
  let %74: String = tuple_field(tokOp, 1) @101:10
  do call printStr(%74) @101:1
  let %75: TokenKind = tuple_field(tokOp, 0) @102:30
  let %76: Bool = call tokens.isDelimiter(%75) @102:11
  do call printBool(%76) @102:1
  let %77: TokenKind = tuple_field(tokOp, 0) @103:32
  let %78: Bool = call tokens.isPunctuation(%77) @103:11
  do call printBool(%78) @103:1
  let tokEof: Token = call tokens.eofToken("test.quest", 31) @105:14
  let %79: TokenKind = tuple_field(tokEof, 0) @106:31
  let %80: String = call tokens.tokenKindName(%79) @106:10
  do call printStr(%80) @106:1
  let %81: String = tuple_field(tokEof, 1) @107:10
  do call printStr(%81) @107:1
  let %82: location.Span = tuple_field(tokEof, 3) @108:10
  let %83: Int = tuple_field(%82, 1) @108:10
  do call printInt(%83) @108:1
  let %84: location.Span = tuple_field(tokEof, 3) @109:10
  let %85: Int = tuple_field(%84, 2) @109:10
  do call printInt(%85) @109:1
  let kLparen: tokens.TokenKind = option(lparen) @115:15
  let kColon: tokens.TokenKind = option(colon) @116:14
  let %86: String = call tokens.tokenKindName(kLparen) @118:10
  do call printStr(%86) @118:1
  let %87: Bool = call tokens.isDelimiter(kLparen) @119:11
  do call printBool(%87) @119:1
  let %88: Bool = call tokens.isPunctuation(kLparen) @120:11
  do call printBool(%88) @120:1
  let %89: String = call tokens.tokenKindName(kColon) @122:10
  do call printStr(%89) @122:1
  let %90: Bool = call tokens.isDelimiter(kColon) @123:11
  do call printBool(%90) @123:1
  let %91: Bool = call tokens.isPunctuation(kColon) @124:11
  do call printBool(%91) @124:1
}

