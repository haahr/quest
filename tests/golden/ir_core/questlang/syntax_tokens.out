  let vChar: TokenValue = tuple_field(tokChar, 2) @75:13
  let %57: Bool = is_tag(vChar, charVal) @76:4
  if %57 { @76:1
    let %58: Tuple Int val: Char end = payload(vChar, charVal) #3 @77:15
