import conv = "conv" : Conv
import writer = "writer" : Writer
import location = "questlang/common/location" : questlang/common/Location
import tokens = "questlang/syntax/tokens" : questlang/syntax/Tokens
main {
  let wOut: writer.T = member writer.output @10:12
  funs {
    fun printStr(s: String): Ok {
      do call writer.putString(wOut, s) @14:9
      let %1: Ok = call writer.putString(wOut, "\n") @15:9
      return %1
    }
  }
  funs {
    fun printInt(n: Int): Ok {
      let %2: String = call conv.int(n) @18:37
      let %3: Ok = call printStr(%2) @18:28
      return %3
    }
  }
  funs {
    fun printReal(r: Real): Ok {
      let %4: String = call conv.real(r) @20:39
      let %5: Ok = call printStr(%4) @20:30
      return %5
    }
  }
  funs {
    fun printChar(c: Char): Ok {
      let %6: String = call conv.char(c) @22:39
      let %7: Ok = call printStr(%6) @22:30
      return %7
    }
  }
  funs {
    fun printBool(b: Bool): Ok {
      let %8: String = call conv.bool(b) @24:39
      let %9: Ok = call printStr(%8) @24:30
      return %9
    }
  }
  let sp1: Span = call location.span("test.quest", 0, 3) @30:11
  let %10: tokens.TokenKind = option(kwLet) @31:26
  let %11: TokenValue = call tokens.valNone() @31:69
  let tokLet: Token = call tokens.make(%10, "let", %11, sp1) @31:14
  let %12: TokenKind = tuple_field(tokLet, 0) @33:31
  let %13: String = call tokens.tokenKindName(%12) @33:10
  do call printStr(%13) @33:1
