  let %25: TokenKind = tuple_field(tokIdent, 0) @42:31
  let %26: String = call tokens.tokenKindName(%25) @42:10
  do call printStr(%26) @42:1
  let %27: String = tuple_field(tokIdent, 1) @43:10
  do call printStr(%27) @43:1
  let %28: TokenKind = tuple_field(tokIdent, 0) @44:28
  let %29: Bool = call tokens.isKeyword(%28) @44:11
  do call printBool(%29) @44:1
  let sp3: Span = call location.span("test.quest", 8, 10) @46:11
  let %30: tokens.TokenKind = option(intLit) @47:26
  let %31: TokenValue = call tokens.valInt(42) @47:69
  let tokInt: Token = call tokens.make(%30, "42", %31, sp3) @47:14
  let %32: TokenKind = tuple_field(tokInt, 0) @48:31
  let %33: String = call tokens.tokenKindName(%32) @48:10
  do call printStr(%33) @48:1
  let %34: String = tuple_field(tokInt, 1) @49:10
  do call printStr(%34) @49:1
  let %35: TokenKind = tuple_field(tokInt, 0) @50:28
  let %36: Bool = call tokens.isLiteral(%35) @50:11
  do call printBool(%36) @50:1
  let vInt: TokenValue = tuple_field(tokInt, 2) @51:12
  let %37: Bool = is_tag(vInt, intVal) @52:4
  if %37 { @52:1
    let %38: Tuple Int val: Int end = payload(vInt, intVal) #1 @53:14
    let %39: Int = tuple_field(%38, 1) @53:14
    do call printInt(%39) @53:5
  } else {
    do call printStr("not int") @55:5
  }
  let sp4: Span = call location.span("test.quest", 11, 15) @58:11
  let %40: tokens.TokenKind = option(realLit) @59:27
  let %41: TokenValue = call tokens.valReal(3.14) @59:73
  let tokReal: Token = call tokens.make(%40, "3.14", %41, sp4) @59:15
  let %42: TokenKind = tuple_field(tokReal, 0) @60:31
  let %43: String = call tokens.tokenKindName(%42) @60:10
  do call printStr(%43) @60:1
