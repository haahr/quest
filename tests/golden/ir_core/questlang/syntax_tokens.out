  do call printStr(%44) @61:1
  let %45: TokenKind = tuple_field(tokReal, 0) @62:28
  let %46: Bool = call tokens.isLiteral(%45) @62:11
  do call printBool(%46) @62:1
  let vReal: TokenValue = tuple_field(tokReal, 2) @63:13
  let %47: Bool = is_tag(vReal, realVal) @64:4
  if %47 { @64:1
    let %48: Tuple Int val: Real end = payload(vReal, realVal) #2 @65:15
    let %49: Real = tuple_field(%48, 1) @65:15
    do call printReal(%49) @65:5
  } else {
    do call printStr("not real") @67:5
  }
  let sp5: Span = call location.span("test.quest", 16, 19) @70:11
  let %50: tokens.TokenKind = option(charLit) @71:27
  let %51: TokenValue = call tokens.valChar('Z') @71:72
  let tokChar: Token = call tokens.make(%50, "'Z'", %51, sp5) @71:15
  let %52: TokenKind = tuple_field(tokChar, 0) @72:31
  let %53: String = call tokens.tokenKindName(%52) @72:10
