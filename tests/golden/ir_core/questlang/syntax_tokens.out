  let sp6: Span = call location.span("test.quest", 20, 27) @82:11
  let %60: tokens.TokenKind = option(stringLit) @83:26
  let %61: TokenValue = call tokens.valString("hello") @83:79
  let tokStr: Token = call tokens.make(%60, "\"hello\"", %61, sp6) @83:14
  let %62: TokenKind = tuple_field(tokStr, 0) @84:31
  let %63: String = call tokens.tokenKindName(%62) @84:10
  do call printStr(%63) @84:1
  let %64: String = tuple_field(tokStr, 1) @85:10
  do call printStr(%64) @85:1
  let %65: TokenKind = tuple_field(tokStr, 0) @86:28
  let %66: Bool = call tokens.isLiteral(%65) @86:11
  do call printBool(%66) @86:1
  let vStr: TokenValue = tuple_field(tokStr, 2) @87:12
  let %67: Bool = is_tag(vStr, stringVal) @88:4
  if %67 { @88:1
    let %68: Tuple Int val: String end = payload(vStr, stringVal) #4 @89:14
    let %69: String = tuple_field(%68, 1) @89:14
    do call printStr(%69) @89:5
  } else {
    do call printStr("not str") @91:5
  }
  let sp7: Span = call location.span("test.quest", 28, 30) @94:11
  let %70: tokens.TokenKind = option(symbolicInfix) @95:25
  let %71: TokenValue = call tokens.valNone() @95:75
  let tokOp: Token = call tokens.make(%70, ":=", %71, sp7) @95:13
  let %72: TokenKind = tuple_field(tokOp, 0) @96:31
  let %73: String = call tokens.tokenKindName(%72) @96:10
  do call printStr(%73) @96:1
  let %74: String = tuple_field(tokOp, 1) @97:10
  do call printStr(%74) @97:1
  let %75: TokenKind = tuple_field(tokOp, 0) @98:30
  let %76: Bool = call tokens.isDelimiter(%75) @98:11
  do call printBool(%76) @98:1
  let %77: TokenKind = tuple_field(tokOp, 0) @99:32
  let %78: Bool = call tokens.isPunctuation(%77) @99:11
  do call printBool(%78) @99:1
  let tokEof: Token = call tokens.eofToken("test.quest", 31) @101:14
  let %79: TokenKind = tuple_field(tokEof, 0) @102:31
  let %80: String = call tokens.tokenKindName(%79) @102:10
  do call printStr(%80) @102:1
  let %81: String = tuple_field(tokEof, 1) @103:10
  do call printStr(%81) @103:1
  let %82: location.Span = tuple_field(tokEof, 3) @104:10
  let %83: Int = tuple_field(%82, 1) @104:10
  do call printInt(%83) @104:1
  let %84: location.Span = tuple_field(tokEof, 3) @105:10
  let %85: Int = tuple_field(%84, 2) @105:10
  do call printInt(%85) @105:1
  let kLparen: tokens.TokenKind = option(lparen) @111:15
  let kColon: tokens.TokenKind = option(colon) @112:14
  let %86: String = call tokens.tokenKindName(kLparen) @114:10
  do call printStr(%86) @114:1
  let %87: Bool = call tokens.isDelimiter(kLparen) @115:11
  do call printBool(%87) @115:1
  let %88: Bool = call tokens.isPunctuation(kLparen) @116:11
