  let %8: Int = tuple_field(p1, 1) @39:10
  do call printInt(%8) @39:1
  let %9: Int = tuple_field(p1, 2) @40:10
  do call printInt(%9) @40:1
  let p2: Pos = call location.locate(sm, 4) @42:10
