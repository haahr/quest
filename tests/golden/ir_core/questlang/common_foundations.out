  let %41: Int = call diagbag.errorCount(bag) @100:10
  do call printInt(%41) @100:1
  let %42: Int = call diagbag.count(bag) @101:10
  do call printInt(%42) @101:1
  let %43: Span = call location.span("test.quest", 8, 10) @103:22
  do call diagbag.addError(bag, %43, "invalid literal") @103:1
  let %44: Bool = call diagbag.hasErrors(bag) @104:11
  do call printBool(%44) @104:1
  let %45: Int = call diagbag.warningCount(bag) @105:10
  do call printInt(%45) @105:1
  let %46: Int = call diagbag.errorCount(bag) @106:10
  do call printInt(%46) @106:1
  let %47: Int = call diagbag.count(bag) @107:10
  do call printInt(%47) @107:1
  join k1(caughtFatal: Bool) {
    do call printBool(caughtFatal) @118:1
    let %48: Int = call diagbag.errorCount(bag) @119:10
    do call printInt(%48) @119:1
    let %49: Int = call diagbag.count(bag) @120:10
    do call printInt(%49) @120:1
    do call printStr("--- Render All Diagnostics ---") @122:1
