  do call printInt(%12) @48:1
  let %13: Int = tuple_field(p3, 2) @49:10
  do call printInt(%13) @49:1
  let p4: Pos = call location.locate(sm, 24) @52:10
  let %14: Int = tuple_field(p4, 1) @53:10
  do call printInt(%14) @53:1
  let %15: Int = tuple_field(p4, 2) @54:10
  do call printInt(%15) @54:1
  let %16: String = call location.getLine(sm, 1) @57:10
  do call printStr(%16) @57:1
  let %17: String = call location.getLine(sm, 2) @58:10
  do call printStr(%17) @58:1
  let %18: String = call location.getLine(sm, 3) @59:10
  do call printStr(%18) @59:1
  let %19: String = call location.getLine(sm, 99) @60:10
  do call printStr(%19) @60:1
  let sp1: Span = call location.span("test.quest", 4, 5) @63:11
  let %20: String = call location.extractSnippet(sm, sp1) @64:10
  do call printStr(%20) @64:1
  let sp2: Span = call location.span("test.quest", 12, 17) @66:11
  let %21: String = call location.extractSnippet(sm, sp2) @67:10
  do call printStr(%21) @67:1
  let spSpan: Tuple start: Pos endPos: Pos end = call location.locateSpan(sm, sp2) @69:14
  let %22: Pos = tuple_field(spSpan, 0) @70:10
  let %23: Int = tuple_field(%22, 1) @70:10
  do call printInt(%23) @70:1
  let %24: Pos = tuple_field(spSpan, 0) @71:10
  let %25: Int = tuple_field(%24, 2) @71:10
  do call printInt(%25) @71:1
  let %26: Pos = tuple_field(spSpan, 1) @72:10
  let %27: Int = tuple_field(%26, 1) @72:10
  do call printInt(%27) @72:1
  let %28: Pos = tuple_field(spSpan, 1) @73:10
  let %29: Int = tuple_field(%28, 2) @73:10
  do call printInt(%29) @73:1
  let %30: Span = call location.span("test.quest", 16, 17) @79:55
  let dWarn: diagnostics.Diagnostic = call diagnostics.warning("unused variable 'y'", %30) @79:13
  do call diagnostics.addNote(dWarn, "variable defined here but never read") @80:1
  do call diagnostics.setHelp(dWarn, "prefix with underscore if intentionally unused") @81:1
  let %31: Severity = call diagnostics.severity(dWarn) @83:37
  let %32: String = call diagnostics.severityString(%31) @83:10
  do call printStr(%32) @83:1
  let %33: String = call diagnostics.format(dWarn, sm) @84:10
  do call printStr(%33) @84:1
  let %34: Span = call location.span("test.quest", 34, 39) @86:46
  let dErr: diagnostics.Diagnostic = call diagnostics.error("type mismatch", %34) @86:12
  let %35: String = call diagnostics.format(dErr, sm) @87:10
  do call printStr(%35) @87:1
  let bag: diagbag.T = call diagbag.new() @93:11
  let %36: Bool = call diagbag.hasErrors(bag) @94:11
  do call printBool(%36) @94:1
  let %37: Int = call diagbag.count(bag) @95:10
  do call printInt(%37) @95:1
  let %38: Span = call location.span("test.quest", 0, 3) @97:24
  do call diagbag.addWarning(bag, %38, "consider explicit type") @97:1
  let %39: Bool = call diagbag.hasErrors(bag) @98:11
  do call printBool(%39) @98:1
  let %40: Int = call diagbag.warningCount(bag) @99:10
