import vector = "collections/vector" : collections/Vector
import maybe = "util/maybe" : util/Maybe
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @13:12
  funs {
    fun printStr(s: String): Ok {
      do call writer.putString(wOut, s) @17:9
      let %1: Ok = call writer.putString(wOut, "\n") @18:9
      return %1
    }
  }
  funs {
    fun printInt(n: Int): Ok {
      let %2: String = call conv.int(n) @22:14
      let %3: Ok = call printStr(%2) @22:5
      return %3
    }
  }
  funs {
    fun printBool(b: Bool): Ok {
      let %4: String = call conv.bool(b) @25:14
      let %5: Ok = call printStr(%4) @25:5
      return %5
    }
  }
  let sampleCode: String = "let x = 10;\nlet y = 20;\nlet sum = x + y;\n" @31:18
  let sm: location.SourceMap = call location.newSourceMap("test.quest", sampleCode) @32:10
  let %6: String = call location.file(sm) @34:10
  do call printStr(%6) @34:1
  let %7: Int = call location.lineCount(sm) @35:10
  do call printInt(%7) @35:1
