  } in {
    let %50: Exception(diagnostics.Diagnostic) = member diagbag.fatalError @114:10
    try catching (%50) {
      let %51: Span = call location.span("test.quest", 24, 39) @112:30
      do call diagbag.addFatal(bag, %51, "unrecoverable syntax failure") @112:9
      jump k1(false) @111:5
    } handle (e: Exception) {
      let %52: Bool = prim is(e, %50) @111:5
      if %52 { @111:5
        let fatalDiag: diagnostics.Diagnostic = exception_payload(e) @111:5
        let %53: String = call diagnostics.message(fatalDiag) @115:18
        do call printStr(%53) @115:9
        jump k1(true) @111:5
      } else {
        reraise e @111:5
      }
    }
  }
}

