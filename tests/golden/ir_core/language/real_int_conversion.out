import conv = "conv" : Conv
import writer = "writer" : Writer
import real = "real" : RealOp
main {
  funs {
    fun print(s: String): Ok {
      let %1: writer.T = member writer.output @6:45
      let %2: String = prim <>(s, "\n") @6:59
      let %3: Ok = call writer.putString(%1, %2) @6:28
      return %3
    }
  }
  funs {
    fun toReal(n: Int): Real {
      let %4: Real = call real.int(n) @8:28
      return %4
    }
  }
  let %5: Real = call toReal(0) @9:17
  let %6: String = call conv.real(%5) @9:7
  do call print(%6) @9:1
  let %7: Int = prim -(0, 7) @10:24
  let %8: Real = call toReal(%7) @10:17
  let %9: String = call conv.real(%8) @10:7
  do call print(%9) @10:1
  let %10: Real = call toReal(9007199254740993) @12:17
  let %11: String = call conv.real(%10) @12:7
  do call print(%11) @12:1
  let %12: Int = prim -(0, 9223372036854775807) @13:25
  let %13: Int = prim -(%12, 1) @13:25
  let %14: Real = call toReal(%13) @13:17
  let %15: String = call conv.real(%14) @13:7
  do call print(%15) @13:1
  let %16: Real = call toReal(3) @14:17
  let %17: Real = prim **(%16, 0.5) @14:17
  let %18: String = call conv.real(%17) @14:7
  do call print(%18) @14:1
}

