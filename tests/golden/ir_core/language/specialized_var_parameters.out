main {
  funs rec {
    fun count(f: Fun(x: Int): Bool, var n: Int, i: Int): Ok {
      let %1: Bool = prim >(i, 0) @6:8
      if %1 { @6:5
        let %2: Bool = call f(i) @8:16
        if %2 { @8:13
          let %3: Int = prim +(n, 1) @8:31
          n := %3 @8:26
        }
        let %4: Var(Int) = addr n @9:21
        let %5: Int = prim -(i, 1) @9:24
        do call count(f, %4, %5) @9:13
      }
      return ok
    }
  }
  funs {
    fun even(x: Int): Bool {
      let %6: Bool = prim >(x, 4) @12:26
      return %6
    }
  }
  funs {
    fun main(): Int {
      var c: Int = 0 @13:25
      let %7: Var(Int) = addr c @13:50
      do call count(even, %7, 10) @13:39
      return c
    }
  }
  let %8: Int = call main() @14:1
}

