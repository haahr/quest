main {
  let t: Cond(True Int String) = 3
  let f: Cond(False Int String) = "three"
  let c: Third(Int Bool String) = "third"
  let tInt: Int = t
  let fString: String = f
  let cString: String = c
  let %1: Bool = prim is(tInt, 3)
  let %2: Bool = call string.equal(fString, "three")
  let %3: Bool = call string.equal(cString, "third")
  let %4: Bool = prim /\(%2, %3)
  let allPassed: Bool = prim /\(%1, %4)
}

