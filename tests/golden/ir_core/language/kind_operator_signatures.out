import string = "string" : StringOp
main {
  let t: Cond(True Int String) = 3 @9:32
  let f: Cond(False Int String) = "three" @10:33
  let c: Third(Int Bool String) = "third" @15:33
  let tInt: Int = t @18:17
  let fString: String = f @19:23
  let cString: String = c @20:23
  let %1: Bool = prim is(tInt, 3) @23:6
  let %2: Bool = call string.equal(fString, "three") @24:8
  let %3: Bool = call string.equal(cString, "third") @25:8
  let %4: Bool = prim /\(%2, %3) @24:8
  let allPassed: Bool = prim /\(%1, %4) @23:6
}

