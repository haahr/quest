import conv = "conv" : Conv
import int = "int" : IntOp
import real = "real" : RealOp
import writer = "writer" : Writer
main {
  let wOut: writer.T = member writer.output @8:12
  funs {
    fun printInt(x: Int): Ok {
      let %1: String = call conv.int(x) @11:31
      do call writer.putString(wOut, %1) @11:9
      let %2: Ok = call writer.putString(wOut, "\n") @12:9
      return %2
    }
  }
  let MyExc: Exception = exception MyExc @16:1
  funs {
    fun compute(x.1: Int): Int {
      join k1(r: Int) {
        return r
      } in {
        try catching (MyExc) {
          join k2(r.1: Int) {
            jump k1(r.1) @18:5
          } in {
            let %3: Bool = prim <(x.1, 0) @19:12
            if %3 { @19:9
              raise MyExc @20:13
            } else {
              let %4: Int = prim *(x.1, 2) @22:13
              jump k2(%4) @19:9
            }
          }
        } handle (e: Exception) {
          let %5: Bool = prim is(e, MyExc) @18:5
          if %5 { @18:5
            jump k1(-1) @18:5
          } else {
            reraise e @18:5
          }
        }
      }
    }
  }
  let %6: Int = call compute(5) @28:10
  do call printInt(%6) @28:1
  let %7: Int = call compute(-3) @29:10
  do call printInt(%7) @29:1
  let Fail: Exception(Int) = exception Fail: Int @32:1
  funs {
    fun tryWork(code: Int): Int {
      join k3(r.2: Int) {
        return r.2
      } in {
        try catching (Fail) {
          join k4(r.3: Int) {
            jump k3(r.3) @34:5
          } in {
            let %8: Bool = prim <(code, 0) @35:12
            if %8 { @35:9
              raise Fail with code : "Int" @36:13
            } else {
              let %9: Int = prim *(code, 10) @38:13
              jump k4(%9) @35:9
            }
          }
        } handle (e.1: Exception) {
          let %10: Bool = prim is(e.1, Fail) @34:5
          if %10 { @34:5
            let errCode: Int = exception_payload(e.1) @34:5
            let %11: Int = prim -(0, errCode) @41:9
            jump k3(%11) @34:5
          } else {
            reraise e.1 @34:5
          }
        }
      }
    }
  }
  let %12: Int = call tryWork(7) @44:10
  do call printInt(%12) @44:1
  let %13: Int = call tryWork(-42) @45:10
  do call printInt(%13) @45:1
  join k5(r3: Int) {
    do call printInt(r3) @54:1
    funs {
      fun mk(x.2: Int): Exception(Int) {
        let %14: Exception(Int) = exception Made: Int @58:34
        return %14
      }
    }
    let m1: Exception(Int) = call mk(1) @59:10
    let m2: Exception(Int) = call mk(2) @60:10
    join k6(r4: Int) {
      do call printInt(r4) @67:1
      join k8(r5: Int) {
        do call printInt(r5) @76:1
      } in {
        let %15: Exception = member real.error @73:10
        try catching (%15) {
          let %16: Real = prim //(1.0, 0.0) @72:15
          jump k8(0) @71:5
        } handle (e.2: Exception) {
          let %17: Bool = prim is(e.2, %15) @71:5
          if %17 { @71:5
            jump k8(555) @71:5
          } else {
            reraise e.2 @71:5
          }
        }
      }
    } in {
      try catching (m1) {
        join k7(r.4: Int) {
          jump k6(r.4) @62:5
        } in {
          try catching (m2) {
            raise m1 with 6 : "Int" @63:13
          } handle (e.3: Exception) {
            let %18: Bool = prim is(e.3, m2) @63:9
            if %18 { @63:9
              let n: Int = exception_payload(e.3) @63:9
              let %19: Int = prim -(0, n) @63:60
              jump k7(%19) @63:9
            } else {
              reraise e.3 @63:9
            }
          }
        }
      } handle (e.4: Exception) {
        let %20: Bool = prim is(e.4, m1) @62:5
        if %20 { @62:5
          let n.1: Int = exception_payload(e.4) @62:5
          jump k6(n.1) @62:5
        } else {
          reraise e.4 @62:5
        }
      }
    }
  } in {
    let %21: Exception = member int.error @51:10
    try catching (%21) {
      let %22: Int = prim /(42, 0) @50:9
      jump k5(%22) @49:5
    } handle (e.5: Exception) {
      let %23: Bool = prim is(e.5, %21) @49:5
      if %23 { @49:5
        jump k5(777) @49:5
      } else {
        reraise e.5 @49:5
      }
    }
  }
}

