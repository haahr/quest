import writer = "writer" : Writer
import conv = "conv" : Conv
import int = "int" : IntOp
import real = "real" : RealOp
main {
  let wOut: writer.T = member writer.output @8:12
  funs {
    fun printInt(x: Int): Ok {
      let %1: String = call conv.int(x) @11:31
      do call writer.putString(wOut, %1) @11:9
      let %2: Ok = call writer.putString(wOut, "\n") @12:9
      return %2
    }
  }
  let MyExc: Exception = exception MyExc @16:1
  funs {
    fun compute(x.1: Int): Int {
      join k1(r: Int) {
        return r
      } in {
        try catching (MyExc) {
          join k2(r.1: Int) {
            jump k1(r.1) @18:5
          } in {
            let %3: Bool = prim <(x.1, 0) @19:12
            if %3 { @19:9
              raise MyExc @20:13
            } else {
              let %4: Int = prim *(x.1, 2) @22:13
              jump k2(%4) @19:9
            }
          }
        } handle (e: Exception) {
          let %5: Bool = prim is(e, MyExc) @18:5
          if %5 { @18:5
            jump k1(-1) @18:5
          } else {
            reraise e @18:5
          }
        }
      }
    }
  }
  let %6: Int = call compute(5) @28:10
  do call printInt(%6) @28:1
  let %7: Int = call compute(-3) @29:10
  do call printInt(%7) @29:1
  let Fail: Exception(Int) = exception Fail: Int @32:1
  funs {
    fun tryWork(code: Int): Int {
      join k3(r.2: Int) {
        return r.2
      } in {
        try catching (Fail) {
          join k4(r.3: Int) {
            jump k3(r.3) @34:5
          } in {
            let %8: Bool = prim <(code, 0) @35:12
            if %8 { @35:9
              raise Fail with code @36:13
            } else {
              let %9: Int = prim *(code, 10) @38:13
              jump k4(%9) @35:9
            }
          }
        } handle (e.1: Exception) {
          let %10: Bool = prim is(e.1, Fail) @34:5
          if %10 { @34:5
            let errCode: Int = exception_payload(e.1) @34:5
            let %11: Int = prim -(0, errCode) @41:9
            jump k3(%11) @34:5
          } else {
            reraise e.1 @34:5
          }
        }
      }
    }
  }
  let %12: Int = call tryWork(7) @44:10
  do call printInt(%12) @44:1
  let %13: Int = call tryWork(-42) @45:10
  do call printInt(%13) @45:1
  join k5(r3: Int) {
    do call printInt(r3) @53:1
    funs {
      fun mk(x.2: Int): Exception(Int) {
        let Made: Exception(Int) = exception Made: Int @57:34
        return Made
      }
    }
    let m1: Exception(Int) = call mk(1) @58:10
    let m2: Exception(Int) = call mk(2) @59:10
    join k6(r4: Int) {
      do call printInt(r4) @65:1
      join k8(r5: Int) {
        do call printInt(r5) @73:1
      } in {
        let %14: Exception = member real.error @70:6
        try catching (%14) {
          let %15: Real = prim //(1.0, 0.0) @69:11
          jump k8(0) @68:10
        } handle (e.2: Exception) {
          let %16: Bool = prim is(e.2, %14) @68:10
          if %16 { @68:10
            jump k8(555) @68:10
          } else {
            reraise e.2 @68:10
          }
        }
      }
    } in {
      try catching (m1) {
        join k7(r.4: Int) {
          jump k6(r.4) @60:10
        } in {
          try catching (m2) {
            raise m1 with 6 @61:9
          } handle (e.3: Exception) {
            let %17: Bool = prim is(e.3, m2) @61:5
            if %17 { @61:5
              let n: Int = exception_payload(e.3) @61:5
              let %18: Int = prim -(0, n) @61:56
              jump k7(%18) @61:5
            } else {
              reraise e.3 @61:5
            }
          }
        }
      } handle (e.4: Exception) {
        let %19: Bool = prim is(e.4, m1) @60:10
        if %19 { @60:10
          let n.1: Int = exception_payload(e.4) @60:10
          jump k6(n.1) @60:10
        } else {
          reraise e.4 @60:10
        }
      }
    }
  } in {
    let %20: Exception = member int.error @50:6
    try catching (%20) {
      let %21: Int = prim /(42, 0) @49:5
      jump k5(%21) @48:10
    } handle (e.5: Exception) {
      let %22: Bool = prim is(e.5, %20) @48:10
      if %22 { @48:10
        jump k5(777) @48:10
      } else {
        reraise e.5 @48:10
      }
    }
  }
}

