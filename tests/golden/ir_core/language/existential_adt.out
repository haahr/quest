main {
  funs {
    fun new(init: Int): Int {
      return init
    }
  }
  funs {
    fun inc(c: Counter): Int {
      let %1: Int = prim +(c, 1)
      return %1
    }
  }
  funs {
    fun add(c.1: Counter, n: Int): Int {
      let %2: Int = prim +(c.1, n)
      return %2
    }
  }
  funs {
    fun get(c.2: Counter): Int {
      return c.2
    }
  }
  let counterModule: CounterPackage = tuple(Let Counter = Int new, inc, add, get)
  let %3: Fun(init: Int): counterModule.Counter = tuple_field(counterModule, 0)
  let c0: counterModule.Counter = call %3(0)
  let %4: Fun(c: counterModule.Counter): counterModule.Counter = tuple_field(counterModule, 1)
  let c1: counterModule.Counter = call %4(c0)
  let %5: Fun(c: counterModule.Counter n: Int): counterModule.Counter = tuple_field(counterModule, 2)
  let c2: counterModule.Counter = call %5(c1, 10)
  let %6: Fun(c: counterModule.Counter): Int = tuple_field(counterModule, 3)
  let total: Int = call %6(c2)
}

