import writer = "writer" : Writer
main {
  let v: Int = 1 @8:42
  let y: Tuple Type A :: TYPE v: A end = tuple(Let A = Int v) @8:16
  let v.1: String = "s" @9:45
  let z: Tuple Type A :: TYPE v: A end = tuple(Let A = String v.1) @9:16
  let x: Tuple y: Tuple Type A :: TYPE v: A end z: Tuple Type A :: TYPE v: A end end = tuple(y, z) @7:9
  funs {
    fun same(a: x.y.A): x.y.A {
      return a
    }
  }
  funs {
    fun pair(a.1: x.y.A, b: x.z.A): Tuple a: x.y.A b: x.z.A end {
      let a.2: x.y.A = call same(a.1) @15:74
      let b.1: x.z.A = b @15:90
      let %1: Tuple a: x.y.A b: x.z.A end = tuple(a.2, b.1) @15:60
      return %1
    }
  }
  let %2: writer.T = member writer.output @16:18
  do call writer.putString(%2, "x.y.A and x.z.A checked\n") @16:1
}

