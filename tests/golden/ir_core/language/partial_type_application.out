import writer = "writer" : Writer
import conv = "conv" : Conv
import list = "list" : List
main {
  funs {
    fun s(text: String): Ok {
      let %1: writer.T = member writer.output @7:44
      let %2: String = prim <>(text, "\n") @7:58
      let %3: Ok = call writer.putString(%1, %2) @7:27
      return %3
    }
  }
  funs {
    fun g [A::TYPE B::TYPE](): Int {
      do call s("g runs") @10:37
      return 1
    }
  }
  funs {
    fun h [B::TYPE](): Int {
      let %4: Int = type_app g [Int B] @11:9
      return %4 @11:9
    }
  }
  do call s("g applied to its first type") @12:1
  let %5: Int = type_app h [Bool] @13:12
  let %6: String = call conv.int(%5) @13:3
  do call s(%6) @13:1
  let %7: Int = type_app g [Int Bool] @14:12
  let %8: String = call conv.int(%7) @14:3
  do call s(%8) @14:1
  funs {
    fun k [A::TYPE B::TYPE](x: B): Int {
      do call s("k runs") @17:42
      return 2
    }
  }
  funs {
    fun kp [B::TYPE](x.1: B): Int {
      let %9: Int = call k [Int B](x.1) @18:10
      return %9 @18:10
    }
  }
  do call s("k applied to its first type") @19:1
  let %10: Int = call kp [Bool](true) @20:12
  let %11: String = call conv.int(%10) @20:3
  do call s(%11) @20:1
  funs {
    fun bump [A::TYPE B::TYPE](var n: Int): Ok {
      let %12: Int = prim +(n, 1) @23:49
      n := %12 @23:44
      return ok
    }
  }
  funs {
    fun bumpInt [B::TYPE](var n.1: Int): Ok {
      let %13: Var(Int) = addr n.1 @24:15
      let %14: Ok = call bump [Int B](%13) @24:15
      return %14 @24:15
    }
  }
  var count: Int = 0 @25:1
  let %15: Var(Int) = addr count @26:15
  do call bumpInt [Bool](%15) @26:1
  let %16: Var(Int) = addr count @27:17
  do call bumpInt [String](%16) @27:1
  let %17: String = call conv.int(count) @28:3
  do call s(%17) @28:1
  let nilOf: All(A :: TYPE) list.T(A) = member list.nil @32:13
  let %18: list.T(Int) = type_app nilOf [Int] @33:24
  let %19: Int = call list.length [Int](%18) @33:12
  let %20: String = call conv.int(%19) @33:3
  do call s(%20) @33:1
}

