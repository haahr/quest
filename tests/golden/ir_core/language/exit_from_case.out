import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  funs {
    fun say(n: Int): Ok {
      let %1: writer.T = member writer.output @7:40
      let %2: String = call conv.int(n) @7:54
      let %3: String = prim <>(%2, "\n") @7:54
      let %4: Ok = call writer.putString(%1, %3) @7:23
      return %4
    }
  }
  funs {
    fun step(n.1: Int, limit: Int): Step {
      join k1(r: Step) {
        return r
      } in {
        let %5: Bool = prim >=(n.1, limit) @10:40
        if %5 { @10:37
          let %6: Step = option(stop) @10:56
          jump k1(%6) @10:37
        } else {
          let %7: Step = option(go) @10:85
          jump k1(%7) @10:37
        }
      }
    }
  }
  var n.2: Int = 0 @13:1
  loop L1 {
    let %8: Int = prim +(n.2, 1) @15:10
    n.2 := %8 @15:5
    let %9: Step = call step(n.2, 3) @16:10
    switch tag(%9) { @16:5
      case stop: {
        break L1 @16:35
      }
      else: {
      }
    }
  }
  do call say(n.2) @18:1
  var w: Int = 0 @21:1
  loop L2 {
    let %10: Bool = prim <(w, 100) @22:7
    if %10 { @22:1
      let %11: Int = prim +(w, 1) @23:10
      w := %11 @23:5
      let %12: Step = call step(w, 5) @24:10
      switch tag(%12) { @24:5
        case go: {
        }
        case stop: {
          break L2 @24:51
        }
      }
    } else {
      break L2 @22:1
    }
  }
  do call say(w) @26:1
  var last: Int = 0 @29:1
  var i: Int = 1 @30:1
  let %13: Bool = prim <=(i, 100) @30:1
  if %13 { @30:1
    loop L3 {
      let i.1: Int = i @30:1
      last := i.1 @31:5
      let %14: Step = call step(i.1, 7) @32:10
      switch tag(%14) { @32:5
        case stop: {
          break L3 @32:35
        }
        else: {
        }
      }
      let %15: Bool = prim is(i, 100) @30:1
      if %15 { @30:1
        break L3 @30:1
      }
      let %16: Int = prim +(i, 1) @30:1
      i := %16 @30:1
    }
  }
  do call say(last) @34:1
  var outer: Int = 0 @37:1
  var inner: Int = 0 @38:1
  var i.2: Int = 1 @39:1
  let %17: Bool = prim <=(i.2, 4) @39:1
  if %17 { @39:1
    loop L4 {
      let i.3: Int = i.2 @39:1
      let %18: Int = prim +(outer, 1) @40:14
      outer := %18 @40:5
      loop L5 {
        let %19: Int = prim +(inner, 1) @42:18
        inner := %19 @42:9
        let %20: Int = prim *(2, i.3) @43:26
        let %21: Step = call step(inner, %20) @43:14
        switch tag(%21) { @43:9
          case stop: {
            break L5 @43:49
          }
          else: {
          }
        }
      }
      let %22: Bool = prim is(i.2, 4) @39:1
      if %22 { @39:1
        break L4 @39:1
      }
      let %23: Int = prim +(i.2, 1) @39:1
      i.2 := %23 @39:1
    }
  }
  do call say(outer) @46:1
  do call say(inner) @47:1
}

