import conv = "conv" : Conv
import writer = "writer" : Writer
main {
  funs rec {
    fun f(n: Int, var g: Int): Int {
      let %1: Int = prim +(g, 1) @10:48
      g := %1 @10:43
      join k1(r: Int) {
        return r
      } in {
        let %2: Bool = prim <=(n, 0) @10:57
        if %2 { @10:54
          jump k1(0) @10:54
        } else {
          let %3: Int = prim -(n, 1) @10:78
          let %4: Var(Int) = addr g @10:84
          let %5: Int = call f(%3, %4) @10:76
          let %6: Int = prim +(%5, g) @10:76
          jump k1(%6) @10:54
        }
      }
    }
  }
  var g.1: Int = 0 @11:1
  let %7: writer.T = member writer.output @12:18
  let %8: Var(Int) = addr g.1 @12:45
  let %9: Int = call f(2, %8) @12:41
  let %10: String = call conv.int(%9) @12:32
  let %11: String = prim <>(%10, "\n") @12:32
  do call writer.putString(%7, %11) @12:1
  let t: Int = 0 @14:27
  let c: Tuple var t: Int end = tuple(t) @14:9
  funs rec {
    fun h(n.1: Int): Int {
      let %12: Int = tuple_field(c, 0) @15:39
      let %13: Int = prim +(%12, 1) @15:39
      store c.#0 := %13 @15:32
      join k2(r.1: Int) {
        return r.1
      } in {
        let %14: Bool = prim <=(n.1, 0) @15:50
        if %14 { @15:47
          jump k2(1) @15:47
        } else {
          let %15: Int = prim -(n.1, 1) @15:71
          let %16: Int = call h(%15) @15:69
          let %17: Int = tuple_field(c, 0) @15:80
          let %18: Int = prim *(%16, %17) @15:69
          jump k2(%18) @15:47
        }
      }
    }
  }
  let %19: writer.T = member writer.output @16:18
  let %20: Int = call h(2) @16:41
  let %21: String = call conv.int(%20) @16:32
  let %22: String = prim <>(%21, "\n") @16:32
  do call writer.putString(%19, %22) @16:1
}

