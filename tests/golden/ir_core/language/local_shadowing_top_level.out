main {
  funs {
    fun twice(n: Int): Int {
      let %1: Int = prim *(n, 2)
      return %1
    }
  }
  funs {
    fun shadowFun(): Int {
      funs {
        fun twice.1(n.1: Int): Int {
          let %2: Int = prim *(n.1, 10)
          return %2
        }
      }
      funs {
        fun viaClosure(n.2: Int): Int {
          let %3: Int = call twice.1(n.2)
          let %4: Int = prim +(%3, 1)
          return %4
        }
      }
      let %5: Int = call twice.1(1)
      let %6: Int = call viaClosure(2)
      let %7: Int = prim +(%5, %6)
      return %7
    }
  }
  let %8: Int = call shadowFun()
  let %9: Int = call twice(4)
  funs {
    fun captureValue(): Int {
      let base: Int = 100
      funs {
        fun add(n.3: Int): Int {
          let %10: Int = prim +(base, n.3)
          return %10
        }
      }
      let %11: Int = call add(5)
      return %11
    }
  }
  let base.1: Int = 1
  let %12: Int = call captureValue()
}

