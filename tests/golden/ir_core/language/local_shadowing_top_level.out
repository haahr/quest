main {
  funs {
    fun twice(n: Int): Int {
      let %1: Int = prim *(n, 2) @5:26
      return %1
    }
  }
  funs {
    fun shadowFun(): Int {
      funs {
        fun twice.1(n.1: Int): Int {
          let %2: Int = prim *(n.1, 10) @9:30
          return %2
        }
      }
      funs {
        fun viaClosure(n.2: Int): Int {
          let %3: Int = call twice.1(n.2) @10:39
          let %4: Int = prim +(%3, 1) @10:39
          return %4
        }
      }
      let %5: Int = call twice.1(1) @11:5
      let %6: Int = call viaClosure(2) @11:16
      let %7: Int = prim +(%5, %6) @11:5
      return %7
    }
  }
  let %8: Int = call shadowFun() @13:1
  let %9: Int = call twice(4) @14:1
  funs {
    fun captureValue(): Int {
      let base: Int = 100 @18:16
      funs {
        fun add(n.3: Int): Int {
          let %10: Int = prim +(base, n.3) @19:32
          return %10
        }
      }
      let %11: Int = call add(5) @20:5
      return %11
    }
  }
  let base.1: Int = 1 @22:12
  let %12: Int = call captureValue() @23:1
}

