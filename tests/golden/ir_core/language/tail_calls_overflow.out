import conv = "conv" : Conv
import writer = "writer" : Writer
main {
  funs {
    fun print(s: String): Ok {
      let %1: writer.T = member writer.output @8:45
      let %2: String = prim <>(s, "\n") @8:59
      let %3: Ok = call writer.putString(%1, %2) @8:28
      return %3
    }
  }
  let other: Exception = exception other @9:1
  funs rec {
    fun guarded(n: Int): Int {
      join k1(r: Int) {
        return r
      } in {
        try catching (other) {
          let %4: Int = prim +(n, 1) @12:44
          let %5: Int = call guarded(%4) @12:36
          jump k1(%5) @12:32
        } handle (e: Exception) {
          let %6: Bool = prim is(e, other) @12:32
          if %6 { @12:32
            jump k1(0) @12:32
          } else {
            reraise e @12:32
          }
        }
      }
    }
  }
  join k2(r.1: String) {
    do call print(r.1) @13:1
    funs rec {
      fun looping(n.1: Int): Ok {
        var i: Int = 0 @18:31
        let %7: Bool = prim <=(i, 0) @18:31
        if %7 { @18:31
          loop L1 {
            let i.1: Int = i @18:31
            let %8: Int = prim +(n.1, 1) @18:59
            do call looping(%8) @18:51
            let %9: Bool = prim is(i, 0) @18:31
            if %9 { @18:31
              break L1 @18:31
            }
            let %10: Int = prim +(i, 1) @18:31
            i := %10 @18:31
          }
        }
        return ok
      }
    }
    join k3(r.2: String) {
      do call print(r.2) @19:1
      funs {
        fun next(n.2: Int): Int {
          let %11: Int = prim +(n.2, 1) @24:25
          return %11
        }
      }
      funs rec {
        fun nested(n.3: Int): Int {
          let %12: Int = prim +(n.3, 1) @25:43
          let %13: Int = call nested(%12) @25:36
          let %14: Int = call next(%13) @25:31
          return %14
        }
      }
      join k4(r.3: String) {
        do call print(r.3) @26:1
      } in {
        try catching all {
          let %15: Int = call nested(0) @26:20
          let %16: String = call conv.int(%15) @26:11
          jump k4(%16) @26:7
        } handle (e.1: Exception) {
          jump k4("overflow in an argument") @26:7
        }
      }
    } in {
      try catching all {
        do call looping(0) @19:17
        jump k3("no overflow") @19:7
      } handle (e.2: Exception) {
        jump k3("overflow in a loop") @19:7
      }
    }
  } in {
    try catching all {
      let %17: Int = call guarded(0) @13:20
      let %18: String = call conv.int(%17) @13:11
      jump k2(%18) @13:7
    } handle (e.3: Exception) {
      jump k2("overflow in a try") @13:7
    }
  }
}

