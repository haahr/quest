import conv = "conv" : Conv
import stringOp = "string" : StringOp
import writer = "writer" : Writer
main {
  funs {
    fun line(s: String): Ok {
      let %1: writer.T = member writer.output @11:50
      do call writer.putString(%1, s) @11:33
      let %2: writer.T = member writer.output @11:84
      let %3: Ok = call writer.putString(%2, "\n") @11:67
      return %3
    }
  }
  let a: String = call stringOp.new(1, 'a') @14:9
  let b: String = call stringOp.new(2, 'b') @15:9
  let c: String = call stringOp.new(3, 'c') @16:9
  let %4: String = prim <>(a, b) @17:15
  let %5: String = prim <>("1. ", %4) @17:6
  do call line(%5) @17:1
  let %6: String = prim <>("-", c) @18:32
  let %7: String = prim <>(b, %6) @18:27
  let %8: String = prim <>("-", %7) @18:20
  let %9: String = prim <>(a, %8) @18:15
  let %10: String = prim <>("1. ", %9) @18:6
  do call line(%10) @18:1
  let %11: String = prim <>(c, a) @19:40
  let %12: String = prim <>(b, %11) @19:35
  let %13: String = prim <>(a, %12) @19:30
  let %14: String = prim <>(c, %13) @19:25
  let %15: String = prim <>(b, %14) @19:20
  let %16: String = prim <>(a, %15) @19:15
  let %17: String = prim <>("1. ", %16) @19:6
  do call line(%17) @19:1
  let %18: String = prim <>(a, b) @20:45
  let %19: String = prim <>(c, %18) @20:40
  let %20: String = prim <>(b, %19) @20:35
  let %21: String = prim <>(a, %20) @20:30
  let %22: String = prim <>(c, %21) @20:25
  let %23: String = prim <>(b, %22) @20:20
  let %24: String = prim <>(a, %23) @20:15
  let %25: String = prim <>("1. ", %24) @20:6
  do call line(%25) @20:1
  let %26: String = prim <>("x", "y") @21:100
  let %27: String = prim <>(c, %26) @21:95
  let %28: String = prim <>(b, %27) @21:90
  let %29: String = prim <>(a, %28) @21:85
  let %30: String = prim <>("9", %29) @21:78
  let %31: String = prim <>("8", %30) @21:71
  let %32: String = prim <>("7", %31) @21:64
  let %33: String = prim <>("6", %32) @21:57
  let %34: String = prim <>("5", %33) @21:50
  let %35: String = prim <>("4", %34) @21:43
  let %36: String = prim <>("3", %35) @21:36
  let %37: String = prim <>("2", %36) @21:29
  let %38: String = prim <>("1", %37) @21:22
  let fifteen: String = prim <>("0", %38) @21:15
  let %39: Int = call stringOp.length(fifteen) @22:42
  let %40: String = call conv.int(%39) @22:33
  let %41: String = prim <>(" ", %40) @22:26
  let %42: String = prim <>(fifteen, %41) @22:15
  let %43: String = prim <>("1. ", %42) @22:6
  do call line(%43) @22:1
  let empty: String = call stringOp.new(0, ' ') @25:13
  let %44: String = prim <>(b, "]") @26:45
  let %45: String = prim <>(empty, %44) @26:36
  let %46: String = prim <>("", %45) @26:30
  let %47: String = prim <>(a, %46) @26:25
  let %48: String = prim <>(empty, %47) @26:16
  let %49: String = prim <>("2. [", %48) @26:6
  do call line(%49) @26:1
  let %50: String = prim <>(c, c) @27:30
  let %51: String = prim <>(a, %50) @27:25
  let %52: String = prim <>(a, %51) @27:20
  let %53: String = prim <>(a, %52) @27:15
  let %54: String = prim <>("2. ", %53) @27:6
  do call line(%54) @27:1
  let %55: String = prim <>("", "]") @28:40
  let %56: String = prim <>(empty, %55) @28:31
  let %57: String = prim <>("", %56) @28:25
  let %58: String = prim <>(empty, %57) @28:16
  let %59: String = prim <>("2. [", %58) @28:6
  do call line(%59) @28:1
  let d: String = call stringOp.new(3, 'd') @31:9
  let %60: String = prim <>("+", d) @32:31
  let %61: String = prim <>(d, %60) @32:26
  let %62: String = prim <>("+", %61) @32:19
  let joined: String = prim <>(d, %62) @32:14
  do call stringOp.setChar(d, 0, 'X') @33:1
  do call stringOp.setChar(joined, 2, 'Y') @34:1
  let %63: String = prim <>(" ", d) @35:25
  let %64: String = prim <>(joined, %63) @35:15
  let %65: String = prim <>("3. ", %64) @35:6
  do call line(%65) @35:1
  let middle: String = prim <>(a, b) @38:14
  let %66: String = prim <>(c, "!") @39:22
  let left: String = prim <>(middle, %66) @39:12
  let %67: String = prim <>(middle, c) @40:20
  let right: String = prim <>("?", %67) @40:13
  let %68: String = prim <>(" ", middle) @41:39
  let %69: String = prim <>(right, %68) @41:30
  let %70: String = prim <>(" ", %69) @41:23
  let %71: String = prim <>(left, %70) @41:15
  let %72: String = prim <>("4. ", %71) @41:6
  do call line(%72) @41:1
  funs {
    fun label(n: Int): String {
      let %73: String = call conv.int(n) @44:36
      let %74: Int = prim *(n, n) @44:67
      let %75: String = call conv.int(%74) @44:58
      let %76: String = prim <>(%75, ";") @44:58
      let %77: String = prim <>(":", %76) @44:51
      let %78: String = prim <>(%73, %77) @44:36
      let %79: String = prim <>("#", %78) @44:29
      return %79
    }
  }
  var all: String = "" @45:1
  var i: Int = 1 @46:1
  let %80: Bool = prim <=(i, 4) @46:1
  if %80 { @46:1
    loop L1 {
      let i.1: Int = i @46:1
      let %81: String = call label(i.1) @46:35
      let %82: String = prim <>(all, %81) @46:28
      all := %82 @46:21
      let %83: Bool = prim is(i, 4) @46:1
      if %83 { @46:1
        break L1 @46:1
      }
      let %84: Int = prim +(i, 1) @46:1
      i := %84 @46:1
    }
  }
  let %85: String = prim <>("5. ", all) @47:6
  do call line(%85) @47:1
  let e: String = call stringOp.new(2, 'e') @50:9
  let before: String = prim <>(e, "|") @51:14
  do call stringOp.setChar(e, 0, 'Z') @52:1
  let after: String = prim <>(before, e) @53:13
  let %86: String = prim <>("6. ", after) @54:6
  do call line(%86) @54:1
}

