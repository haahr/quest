main {
  let wd: WeekDay = variant(mon, ok)
  let we: WeekendDay = variant(sun, ok)
  let asDay: Day = wd
  let alsoDay: Day = we
  funs {
    fun dayNum(x: WeekDay): Int {
      join k1(r: Int) {
        return r
      } in {
        switch tag(x) {
          case mon: {
            jump k1(1)
          }
          case tue: {
            jump k1(2)
          }
          else: {
            jump k1(0)
          }
        }
      }
    }
  }
  let %1: Int = call dayNum(wd)
  let %2: Bool = is_tag(wd, mon)
  let %3: Bool = is_tag(wd, tue)
  let n: Number = variant(int, 42)
  let %4: Bool = is_tag(n, int)
  let %5: Bool = is_tag(n, real)
  let %6: Int = payload(n, int)
  let cRed: Color = option(red)
  let val: Int = 100
  let %7: Tuple val: Int end = tuple(val)
  let cBlue: Color = option(blue, %7)
  let %8: Bool = is_tag(cRed, red)
  let %9: Bool = is_tag(cRed, green)
  let %10: Bool = is_tag(cBlue, blue)
  let redPayload: Tuple Int end = payload(cRed, red) #0
  let bluePayload: Tuple Int val: Int end = payload(cBlue, blue) #2
  let %11: Int = tuple_field(bluePayload, 1)
}

