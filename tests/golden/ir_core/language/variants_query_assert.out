main {
  let wd: WeekDay = variant(mon, ok) @11:10
  let we: WeekendDay = variant(sun, ok) @12:10
  let asDay: Day = wd @13:18
  let alsoDay: Day = we @14:20
  funs {
    fun dayNum(x: WeekDay): Int {
      join k1(r: Int) {
        return r
      } in {
        switch tag(x) { @18:5
          case mon: {
            jump k1(1) @18:5
          }
          case tue: {
            jump k1(2) @18:5
          }
          else: {
            jump k1(0) @18:5
          }
        }
      }
    }
  }
  let %1: Int = call dayNum(wd) @23:1
  let %2: Bool = is_tag(wd, mon) @26:1
  let %3: Bool = is_tag(wd, tue) @27:1
  let n: Number = variant(int, 42) @29:9
  let %4: Bool = is_tag(n, int) @30:1
  let %5: Bool = is_tag(n, real) @31:1
  let %6: Int = payload(n, int) @32:1
  let cRed: Color = option(red) @36:12
  let val: Int = 100 @37:45
  let %7: Tuple val: Int end = tuple(val) @37:39
  let cBlue: Color = option(blue, %7) @37:13
  let %8: Bool = is_tag(cRed, red) @38:1
  let %9: Bool = is_tag(cRed, green) @39:1
  let %10: Bool = is_tag(cBlue, blue) @40:1
  let redPayload: Tuple Int end = payload(cRed, red) #0 @41:18
  let bluePayload: Tuple Int val: Int end = payload(cBlue, blue) #2 @42:19
  let %11: Int = tuple_field(bluePayload, 1) @43:1
}

