module limits : Limits {
  let maxVal: Int = external "QUEST_INT_MAX" @7:23
  let minVal: Int = external "QUEST_INT_MIN" @8:23
  let limits_record: Record maxVal: Int minVal: Int end = record(maxVal = maxVal, minVal = minVal)
  export maxVal = maxVal, minVal = minVal
  record limits_record
}
main {
  let maxVal.1: Int = member limits.maxVal @10:14
  let minVal.1: Int = member limits.minVal @11:14
  let %1: Bool = prim >(maxVal.1, 0) @12:1
  let %2: Bool = prim <(minVal.1, 0) @13:1
}

