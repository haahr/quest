      let %4: Int = prim +(n, 1) @9:38
      let %5: Int = call down(%4) @9:33
      let %6: Int = prim +(1, %5) @9:29
      return %6
    }
  }
  let n.1: Int = 0 @10:30
  let seen: Tuple var n: Int end = tuple(n.1) @10:12
  funs {
    fun guarded(): Int {
      join k1(r: Int) {
        return r
      } in {
        try catching all traced {
          let %7: Int = call down(0) @11:26
          jump k1(%7) @11:22
        } handle (e: Exception) {
          let e.1: raised.T = caught_exception(e) @11:22
          let %8: Int = tuple_field(seen, 0) @11:61
