  }
  join k2(r.1: String) {
    do call print(r.1) @12:1
    let %11: Int = tuple_field(seen, 0) @13:27
    let %12: String = call conv.int(%11) @13:18
    let %13: String = prim <>("seen ", %12) @13:7
    do call print(%13) @13:1
  } in {
    try catching all {
      let %14: Int = call guarded() @12:20
      let %15: String = call conv.int(%14) @12:11
      jump k2(%15) @12:7
    } handle (e.2: Exception) {
      jump k2("stack overflow") @12:7
