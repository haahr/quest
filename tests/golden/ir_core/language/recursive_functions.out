import writer = "writer" : Writer
import conv = "conv" : Conv
import arrayOp = "arrayOp" : ArrayOp
main {
  funs {
    fun printInt(x: Int): Ok {
      let %1: writer.T = member writer.output @9:26
      let %2: String = call conv.int(x) @9:40
      do call writer.putString(%1, %2) @9:9
      let %3: writer.T = member writer.output @10:26
      let %4: Ok = call writer.putString(%3, "\n") @10:9
      return %4
    }
  }
  funs rec {
    fun f(n: Int): F {
      do call printInt(n) @16:30
      return f
    }
  }
  let a: Int = 1 @17:46
  let b: Fun(n: Int): F = f @17:56
  let p: Tuple a: Int b: F end = tuple(a, b) @17:32
  let q: Tuple a: Int b: Fun(n: Int): F end = p @18:44
  let r: Tuple a: Int b: F2 end = q @19:33
  let g: F2 = tuple_field(r, 1) @20:13
  let %5: Fun(n: Int): F2 = call g(2) @21:1
  let %6: F2 = call %5(3) @21:1
  let %7: Fun(n: Int): F2 = call %6(4) @21:1
  let back: Tuple a: Int b: F end = r @22:35
  let %8: F = tuple_field(back, 1) @23:1
  let %9: F = call %8(5) @23:1
  funs {
    fun curried(n.1: Int): Fun(m: Int): Ok {
      do call printInt(n.1) @26:45
      funs {
        fun f.1(m: Int): Ok {
          let %10: Ok = call printInt(m) @26:73
          return %10
        }
      }
      return f.1
    }
  }
  let %11: Fun(m: Int): Ok = call curried(6) @27:1
  do call %11(7) @27:1
  let leaf: Nest = array() @31:18
  let a.1: Int = 5 @32:50
  let b.1: Array(Nest) = array(leaf, leaf) @32:60
  let n1: Tuple a: Int b: Nest end = tuple(a.1, b.1) @32:36
  let n2: Tuple a: Int b: Array(Array(Nest)) end = n1 @33:50
  let %12: Int = tuple_field(n2, 0) @34:10
  let %13: Array(Array(Nest)) = tuple_field(n2, 1) @34:30
  let %14: Int = prim extent(%13) @34:17
  let %15: Int = prim +(%12, %14) @34:10
  do call printInt(%15) @34:1
  let n3: Nest = tuple_field(n2, 1) @35:16
  let %16: Int = prim extent(n3) @36:10
  do call printInt(%16) @36:1
}

