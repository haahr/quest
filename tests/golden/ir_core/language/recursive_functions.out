import writer = "writer" : Writer
import conv = "conv" : Conv
import arrayOp = "arrayOp" : ArrayOp
main {
  funs {
    fun printInt(x: Int): Ok {
      let %1: writer.T = member writer.output
      let %2: String = call conv.int(x)
      do call writer.putString(%1, %2)
      let %3: writer.T = member writer.output
      let %4: Ok = call writer.putString(%3, "\n")
      return %4
    }
  }
  funs rec {
    fun f(n: Int): F {
      do call printInt(n)
      return f
    }
  }
  let a: Int = 1
  let b: Fun(n: Int): F = f
  let p: Tuple a: Int b: F end = tuple(a, b)
  let q: Tuple a: Int b: Fun(n: Int): F end = p
  let r: Tuple a: Int b: F2 end = q
  let g: F2 = tuple_field(r, 1)
  let %5: Fun(n: Int): F2 = call g(2)
  let %6: F2 = call %5(3)
  let %7: Fun(n: Int): F2 = call %6(4)
  let back: Tuple a: Int b: F end = r
  let %8: F = tuple_field(back, 1)
  let %9: F = call %8(5)
  funs {
    fun curried(n.1: Int): Fun(m: Int): Ok {
      do call printInt(n.1)
      funs {
        fun f.1(m: Int): Ok {
          let %10: Ok = call printInt(m)
          return %10
        }
      }
      return f.1
    }
  }
  let %11: Fun(m: Int): Ok = call curried(6)
  do call %11(7)
  let leaf: Nest = array()
  let a.1: Int = 5
  let b.1: Array(Nest) = array(leaf, leaf)
  let n1: Tuple a: Int b: Nest end = tuple(a.1, b.1)
  let n2: Tuple a: Int b: Array(Array(Nest)) end = n1
  let %12: Int = tuple_field(n2, 0)
  let %13: Array(Array(Nest)) = tuple_field(n2, 1)
  let %14: Int = call arrayOp.size [Array(Nest)](%13)
  let %15: Int = prim +(%12, %14)
  do call printInt(%15)
  let n3: Nest = tuple_field(n2, 1)
  let %16: Int = call arrayOp.size [Array(Nest)](n3)
  do call printInt(%16)
}

