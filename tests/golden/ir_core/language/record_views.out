main {
  funs {
    fun p(n: Int): Ok {
      let %1: writer.T = member writer.output
      let %2: String = call conv.int(n)
      let %3: String = prim <>(%2, "\n")
      let %4: Ok = call writer.putString(%1, %3)
      return %4
    }
  }
  let huge: Huge = record(a = 1, b = 2, c = 3, d = 4)
  let big: Big = huge
  let mid: Mid = big
  let small: Small = mid
  let %5: Int = record_field(mid, c)
  do call p(%5)
  let %6: Int = record_field(small, d)
  do call p(%6)
  funs {
    fun sumMid(m: Mid): Int {
      let %7: Int = record_field(m, c)
      let %8: Int = record_field(m, d)
      let %9: Int = prim +(%7, %8)
      return %9
    }
  }
  let %10: Int = call sumMid(big)
  do call p(%10)
  let d: T = call dynamic.new [Mid](mid)
  let viaDynamic: Small = call dynamic.be [Small](d)
  let %11: Int = record_field(viaDynamic, d)
  do call p(%11)
  join k1(r: Int) {
    do call p(r)
    let a: Big = big
    let %12: Tuple a: Big end = tuple(a)
    let anyMid: AnyMid = auto[Big](%12)
    join k2(r.1: Int) {
      do call p(r.1)
      let r.2: Big = big
      let n.1: Int = 5
      let bigTuple: Tuple r: Big n: Int end = tuple(r.2, n.1)
      let midTuple: Tuple r: Mid n: Int end = bigTuple
      let %13: Mid = tuple_field(midTuple, 0)
      let %14: Int = record_field(%13, c)
      let %15: Int = tuple_field(midTuple, 1)
      let %16: Int = prim +(%14, %15)
      do call p(%16)
      funs {
        fun same [A::<: Mid](x: A): A {
          return x
        }
      }
      let bigAgain: Big = call same [Big](big)
      let %17: Int = record_field(bigAgain, b)
      do call p(%17)
      let %18: writer.T = member writer.output
      do call dynamic.extern(%18, d)
      let %19: writer.T = member writer.output
      do call writer.putString(%19, "\n")
    } in {
      inspect anyMid {
        case Mid (x.1: Tuple a: Mid end): {
          let %20: Mid = tuple_field(x.1, 0)
          let %21: Int = record_field(%20, c)
          let %22: Mid = tuple_field(x.1, 0)
          let %23: Int = record_field(%22, d)
          let %24: Int = prim +(10, %23)
          let %25: Int = prim *(%21, %24)
          jump k2(%25)
        }
        else: {
          jump k2(0)
        }
      }
    }
  } in {
    inspect d {
      case Small (s: Tuple a: Small end): {
        let %26: Small = tuple_field(s, 0)
        let %27: Int = record_field(%26, d)
        jump k1(%27)
      }
      else: {
        jump k1(0)
      }
    }
  }
}

