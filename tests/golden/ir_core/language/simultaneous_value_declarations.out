import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @6:12
  funs {
    fun printInt(x: Int): Ok {
      let %1: String = call conv.int(x) @9:31
      do call writer.putString(wOut, %1) @9:9
      let %2: Ok = call writer.putString(wOut, "\n") @10:9
      return %2
    }
  }
  let x.1: Int = 1 @14:9
  let x.2: Int = 2 @15:9
  let y: Int = x.1 @15:19
  let %3: Int = prim *(x.2, 10) @16:11
  let %4: Int = prim +(%3, y) @16:11
  do call printInt(%4) @16:1
  let a: Int = 3 @17:9
  let b: Int = 4 @17:19
  let %5: Int = prim *(a, 10) @18:11
  let %6: Int = prim +(%5, b) @18:11
  do call printInt(%6) @18:1
  let p: Int = 1 @23:17
  let q: Int = 2 @24:17
  let p.1: Int = q @25:17
  let q.1: Int = p @25:27
  let %7: Int = prim *(p.1, 10) @26:10
  let swapped: Int = prim +(%7, q.1) @26:10
  do call printInt(swapped) @28:1
  funs {
    fun shift(n: Int): Int {
      let n.1: Int = prim +(n, 1) @31:17
      let m: Int = n @31:31
      let %8: Int = prim *(n.1, 100) @32:10
      let %9: Int = prim +(%8, m) @32:10
      return %9
    }
  }
  let %10: Int = call shift(5) @34:10
  do call printInt(%10) @34:1
  funs {
    fun captured(): Int {
      let u: Int = 3 @39:17
      let u.1: Int = 4 @40:17
      funs {
        fun f(): Int {
          return u
        }
      }
      let %11: Int = call f() @41:10
      let %12: Int = prim *(%11, 10) @41:10
      let %13: Int = prim +(%12, u.1) @41:10
      return %13
    }
  }
  let %14: Int = call captured() @43:10
  do call printInt(%14) @43:1
  funs {
    fun counted(): Int {
      var c: Int = 0 @48:9
      let %15: Int = prim +(c, 1) @49:32
      c := %15 @49:27
      let first: Int = c @49:38
      let done: Ok = call printInt(c) @49:55
      let %16: Int = prim +(c, 10) @49:91
      c := %16 @49:86
      let second: Int = c @49:98
      let %17: Int = prim *(first, 100) @50:10
      let %18: Int = prim +(%17, second) @50:10
      return %18
    }
  }
  let %19: Int = call counted() @52:10
  do call printInt(%19) @52:1
  funs {
    fun mutable(): Int {
      var v: Int = 1 @55:17
      var w: Int = 2 @55:31
      let %20: Int = prim +(v, w) @56:14
      v := %20 @56:9
      w := 0 @57:9
      let %21: Int = prim *(v, 10) @58:10
      let %22: Int = prim +(%21, w) @58:10
      return %22
    }
  }
  let %23: Int = call mutable() @60:10
  do call printInt(%23) @60:1
  funs {
    fun later(): Int {
      let k: Int = 1 @65:17
      funs {
        fun get(): Int {
          return k
        }
      }
      let k.1: Int = 2 @67:17
      let %24: Int = call get() @68:10
      let %25: Int = prim *(%24, 10) @68:10
      let %26: Int = prim +(%25, k.1) @68:10
      return %26
    }
  }
  let %27: Int = call later() @70:10
  do call printInt(%27) @70:1
}

