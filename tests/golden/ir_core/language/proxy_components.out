import writer = "writer" : Writer
import conv = "conv" : Conv
import dynamic = "dynamic" : Dynamic
main {
  funs {
    fun print(s: String): Ok {
      let %1: writer.T = member writer.output
      let %2: String = prim <>(s, "\n")
      let %3: Ok = call writer.putString(%1, %2)
      return %3
    }
  }
  let s.1: String = "hello"
  let n: Int = 7
  let x: Record a: Int b: Int end = record(a = 1, b = 2)
  let tb: TB = tuple(s.1, n, x)
  let ts: TS = tb
  let q: T0 = tb
  funs {
    fun show(t: T0): String {
      let %4: String = tuple_field(t, 0)
      let %5: Int = tuple_field(t, 1)
      let %6: String = call conv.int(%5)
      let %7: String = prim <>(" ", %6)
      let %8: String = prim <>(%4, %7)
      return %8
    }
  }
  let p: TS = ts
  let %9: Tuple p: TS end = tuple(p)
  let o: OS = option(some, %9)
  let o0: O0 = o
  let %10: Tuple Int p: T0 end = payload(o0, some) #0
  let p0: T0 = tuple_field(%10, 1)
  let %11: String = call show(p0)
  let %12: Bool = prim is(p0, q)
  let %13: String = call conv.bool(%12)
  let %14: Bool = prim is(p0, tb)
  let %15: String = call conv.bool(%14)
  let %16: Bool = prim is(o0, o)
  let %17: String = call conv.bool(%16)
  let %18: String = prim <>(" ", %17)
  let %19: String = prim <>(%15, %18)
  let %20: String = prim <>(" ", %19)
  let %21: String = prim <>(%13, %20)
  let %22: String = prim <>(" ", %21)
  let %23: String = prim <>(%11, %22)
  let %24: String = prim <>("option: ", %23)
  do call print(%24)
  join k1(r: String) {
    let %25: String = prim <>("option, case: ", r)
    do call print(%25)
    let head: TS = ts
    let tail: L(TS) = option(nil)
    let %26: Tuple head: TS tail: Rec(L :: TYPE) Option nil cons with Tuple head: TS tail: L end end end = tuple(head, tail)
    let l: L(TS) = option(cons, %26)
    let l0: L(T0) = l
    let %27: Tuple Int head: T0 tail: Rec(L :: TYPE) Option nil cons with Tuple head: T0 tail: L end end end = payload(l0, cons) #1
    let %28: T0 = tuple_field(%27, 1)
    let %29: String = call show(%28)
    let %30: Tuple Int head: T0 tail: Rec(L :: TYPE) Option nil cons with Tuple head: T0 tail: L end end end = payload(l0, cons) #1
    let %31: T0 = tuple_field(%30, 1)
    let %32: Bool = prim is(%31, q)
    let %33: String = call conv.bool(%32)
    let %34: Bool = prim is(l0, l)
    let %35: String = call conv.bool(%34)
    let %36: String = prim <>(" ", %35)
    let %37: String = prim <>(%33, %36)
    let %38: String = prim <>(" ", %37)
    let %39: String = prim <>(%29, %38)
    let %40: String = prim <>("list: ", %39)
    do call print(%40)
    let c: TS = ts
    let w: Tuple c: TS end = tuple(c)
    let w0: Tuple c: T0 end = w
    let %41: T0 = tuple_field(w0, 0)
    let %42: String = call show(%41)
    let %43: T0 = tuple_field(w0, 0)
    let %44: Bool = prim is(%43, q)
    let %45: String = call conv.bool(%44)
    let %46: Bool = prim is(w0, w)
    let %47: String = call conv.bool(%46)
    let %48: String = prim <>(" ", %47)
    let %49: String = prim <>(%45, %48)
    let %50: String = prim <>(" ", %49)
    let %51: String = prim <>(%42, %50)
    let %52: String = prim <>("tuple: ", %51)
    do call print(%52)
    let d: Tuple c: TS end = w
    let ww: Tuple d: Tuple c: TS end end = tuple(d)
    let ww0: Tuple d: Tuple c: T0 end end = ww
    let %53: Tuple c: T0 end = tuple_field(ww0, 0)
    let %54: T0 = tuple_field(%53, 0)
    let %55: String = call show(%54)
    let %56: Tuple c: T0 end = tuple_field(ww0, 0)
    let %57: T0 = tuple_field(%56, 0)
    let %58: Bool = prim is(%57, q)
    let %59: String = call conv.bool(%58)
    let %60: Tuple c: T0 end = tuple_field(ww0, 0)
    let %61: Bool = prim is(%60, w)
    let %62: String = call conv.bool(%61)
    let %63: String = prim <>(" ", %62)
    let %64: String = prim <>(%59, %63)
    let %65: String = prim <>(" ", %64)
    let %66: String = prim <>(%55, %65)
    let %67: String = prim <>("nested tuple: ", %66)
    do call print(%67)
    let p.1: OS = o
    let %68: Tuple p: OS end = tuple(p.1)
    let oo: Option some with Tuple p: OS end end = option(some, %68)
    let oo0: Option some with Tuple p: O0 end end = oo
    let %69: Tuple Int p: O0 end = payload(oo0, some) #0
    let %70: O0 = tuple_field(%69, 1)
    let %71: Tuple Int p: T0 end = payload(%70, some) #0
    let %72: T0 = tuple_field(%71, 1)
    let %73: String = call show(%72)
    let %74: Tuple Int p: O0 end = payload(oo0, some) #0
    let %75: O0 = tuple_field(%74, 1)
    let %76: Tuple Int p: T0 end = payload(%75, some) #0
    let %77: T0 = tuple_field(%76, 1)
    let %78: Bool = prim is(%77, q)
    let %79: String = call conv.bool(%78)
    let %80: String = prim <>(" ", %79)
    let %81: String = prim <>(%73, %80)
    let %82: String = prim <>("nested option: ", %81)
    do call print(%82)
    let v: Variant k: TS j: Int end = variant(k, ts)
    let v0: Variant k: T0 j: Int end = v
    join k2(r.1: String) {
      let %83: String = prim <>("variant: ", r.1)
      do call print(%83)
      let arr: Array(T0) = array(p0)
      let c.1: T0 = q
      let cell: Tuple var c: T0 end = tuple(c.1)
      store cell.#0 := p0
      let %84: T0 = index(arr, 0)
      let %85: String = call show(%84)
      let %86: T0 = tuple_field(cell, 0)
      let %87: String = call show(%86)
      let %88: T0 = index(arr, 0)
      let %89: Bool = prim is(%88, q)
      let %90: String = call conv.bool(%89)
      let %91: String = prim <>(" ", %90)
      let %92: String = prim <>(%87, %91)
      let %93: String = prim <>(" ", %92)
      let %94: String = prim <>(%85, %93)
      let %95: String = prim <>("stored: ", %94)
      do call print(%95)
      funs {
        fun first [A::TYPE](p.2: Tuple c: A end): A {
          let %96: A = tuple_field(p.2, 0)
          return %96
        }
      }
      let firstF: All(A :: TYPE) Fun(p: Tuple c: A end): A = first
      let %97: T0 = call firstF [T0](w0)
      let %98: String = call show(%97)
      let %99: T0 = call firstF [T0](w0)
      let %100: Bool = prim is(%99, q)
      let %101: String = call conv.bool(%100)
      let %102: String = prim <>(" ", %101)
      let %103: String = prim <>(%98, %102)
      let %104: String = prim <>("generic: ", %103)
      do call print(%104)
      funs {
        fun firstB [A::<: T0](p.3: Tuple c: A end): A {
          let %105: A = tuple_field(p.3, 0)
          return %105
        }
      }
      let firstBF: All(A <: T0) Fun(p: Tuple c: A end): A = firstB
      let %106: T0 = call firstBF [T0](w0)
      let %107: String = call show(%106)
      let %108: TS = call firstBF [TS](w)
      let %109: String = call show(%108)
      let %110: String = prim <>(" ", %109)
      let %111: String = prim <>(%107, %110)
      let %112: String = prim <>("generic, bounded: ", %111)
      do call print(%112)
      let %113: T = call dynamic.new [T0](p0)
      let %114: T0 = call dynamic.be [T0](%113)
      let %115: String = call show(%114)
      let %116: T = call dynamic.new [TS](ts)
      let %117: T0 = call dynamic.be [T0](%116)
      let %118: String = call show(%117)
      let %119: String = prim <>(" ", %118)
      let %120: String = prim <>(%115, %119)
      let %121: String = prim <>("dynamic: ", %120)
      do call print(%121)
    } in {
      switch tag(v0) {
        case k (z: T0): {
          let %122: String = call show(z)
          let %123: Bool = prim is(z, q)
          let %124: String = call conv.bool(%123)
          let %125: String = prim <>(" ", %124)
          let %126: String = prim <>(%122, %125)
          jump k2(%126)
        }
        else: {
          jump k2("")
        }
      }
    }
  } in {
    switch tag(o0) {
      case some (c.2: Tuple p: T0 end): {
        let %127: T0 = tuple_field(c.2, 0)
        let %128: String = call show(%127)
        jump k1(%128)
      }
    }
  }
}

