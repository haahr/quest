main {
  let x: Int = 1
  let t: Tuple Let A = Int x: Int end = tuple(Let A = Int x)
  let empty: Tuple Let A = Bool end = tuple(Let A = Bool )
  let a: Int = 1
  let b: Char = 'b'
  let between: Tuple a: Int Let B = Char b: Char Let C = String end = tuple(Let B = Char Let C = String a, b)
  let a.1: Int = 1
  let y: Bool = true
  let b.1: Tuple Let B = Bool y: Bool end = tuple(Let B = Bool y)
  let nested: Tuple a: Int b: Tuple Let B = Bool y: Bool end end = tuple(a.1, b.1)
  let arr: Array(Tuple Let A = Int x: Int end) = array(t, t)
  let rec1: Record f: Tuple Let A = Int x: Int end g: Int end = record(f = t, g = 2)
  let k: Int = 2
  let %1: Tuple Let K = Int k: K end = tuple(Let K = Int k)
  let opt: O = option(some, %1)
  let x.1: Int = 1
  let p: E = tuple(Let A = Int x.1)
  let a.2: Int = 1
  let p.1: E = p
  let inE: Tuple a: Int p: E end = tuple(a.2, p.1)
  let k.1: Int = 1
  let q: Tuple Let N = P k: Int end = tuple(Let N = P k.1)
  let k.2: Int = 1
  let r: Tuple Let N = Tuple a: Int end k: Int end = tuple(Let N = Tuple a: Int end k.2)
  let qr: Array(Tuple Let N = Tuple a: Int end k: Int end) = array(q, r)
  let q.1: Tuple Let N = P k: Int end = q
  let r.1: Tuple Let N = Tuple a: Int end k: Int end = r
  let inQ: Tuple q: Tuple Let N = P k: Int end r: Tuple Let N = Tuple a: Int end k: Int end end = tuple(q.1, r.1)
  let l: L = option(nil)
  let s: Tuple Let M = L l: L end = tuple(Let M = L l)
}

