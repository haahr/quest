import int = "int" : IntOp
module tally : Tally {
  let start: Int = 100 @12:17
  let sum: Int = 0 @13:37
  let state: Tuple var sum: Int end = tuple(sum) @13:17
  funs {
    fun add(n: Int): Int {
      let %1: Int = tuple_field(state, 0) @14:47
      let %2: Int = prim +(%1, n) @14:47
      store state.#0 := %2 @14:34
      let %3: Int = tuple_field(state, 0) @14:61
      return %3
    }
  }
  funs {
    fun total(): Int {
      let %4: Int = tuple_field(state, 0) @15:32
      let %5: Int = prim +(start, %4) @15:24
      return %5
    }
  }
  let tally_record: Record start: Int state: Tuple var sum: Int end add: Fun(n: Int): Int total: Fun(): Int end = record(start = start, state = state, add = add, total = total)
  export start = start, state = state, add = add, total = total
  record tally_record
}
module counter : Counter {
  funs {
    fun make(n.1: Int): T {
      return n.1
    }
  }
  funs {
    fun get(c: T): Int {
      return c
    }
  }
  funs {
    fun next(c.1: T): T {
      let %6: Int = prim +(c.1, 1) @39:25
      return %6
    }
  }
  let counter_record: Record make: Fun(n: Int): T get: Fun(c: T): Int next: Fun(c: T): T end = record(make = make, get = get, next = next)
  export make = make, get = get, next = next
  record counter_record
}
module absolute : Absolute {
  funs {
    fun value(n.2: Int): Int {
      let %7: Int = call int.abs(n.2) @53:30
      return %7
    }
  }
  let absolute_record: Record value: Fun(n: Int): Int end = record(value = value)
  export value = value
  record absolute_record
}
main {
  let %8: Int = member tally.start @18:1
  let %9: Int = call tally.add(3) @19:1
  let %10: Int = call tally.add(4) @20:1
  let %11: Int = call tally.total() @21:1
  funs {
    fun addTwice(n.3: Int): Int {
      let %12: Int = call tally.add(n.3) @24:35
      let %13: Int = call tally.add(n.3) @24:48
      return %13
    }
  }
  let %14: Int = call addTwice(10) @25:1
  let %15: Int = call tally.total() @26:1
  let k: counter.T = call counter.make(4) @41:9
  let %16: counter.T = call counter.next(k) @42:13
  let %17: Int = call counter.get(%16) @42:1
  let m: Module 'counter' = module counter @45:9
  let %18: Fun(c: counter.T): Int = record_field(m, get) @46:1
  let %19: Fun(n: Int): counter.T = record_field(m, make) @46:7
  let %20: counter.T = call %19(9) @46:7
  let %21: Int = call %18(%20) @46:1
  let %22: Int = call absolute.value(-7) @55:1
}

