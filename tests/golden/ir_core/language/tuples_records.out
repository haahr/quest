import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @6:12
  funs {
    fun printInt(x: Int): Ok {
      let %1: String = call conv.int(x) @9:31
      do call writer.putString(wOut, %1) @9:9
      let %2: Ok = call writer.putString(wOut, "\n") @10:9
      return %2
    }
  }
  let x.1: Int = 10 @15:26
  let y: Int = 20 @15:37
  let t: T = tuple(x.1, y) @15:12
  let %3: Int = tuple_field(t, 0) @16:10
  let %4: Int = tuple_field(t, 1) @16:16
  let %5: Int = prim +(%3, %4) @16:10
  do call printInt(%5) @16:1
  funs {
    fun swap(pair: T): T {
      let x.2: Int = tuple_field(pair, 1) @20:13
      let y.1: Int = tuple_field(pair, 0) @21:13
      let %6: Tuple x: Int y: Int end = tuple(x.2, y.1) @19:24
      return %6
    }
  }
  let x.3: Int = 1 @23:34
  let y.2: Int = 2 @23:44
  let %7: Tuple x: Int y: Int end = tuple(x.3, y.2) @23:20
  let swapped: T = call swap(%7) @23:15
  let %8: Int = tuple_field(swapped, 0) @24:10
  let %9: Int = tuple_field(swapped, 1) @24:27
  let %10: Int = prim +(10, %9) @24:22
  let %11: Int = prim *(%8, %10) @24:10
  do call printInt(%11) @24:1
  let p: Record x: Int y: Int end = record(x = 30, y = 40) @28:9
  let %12: Int = record_field(p, x) @29:10
  let %13: Int = record_field(p, y) @29:16
  let %14: Int = prim +(%12, %13) @29:10
  do call printInt(%14) @29:1
  let cr: Record var val: Int end = record(var val = 100) @33:10
  let %15: Int = record_field(cr, val) @34:11
  let %16: Int = prim +(%15, 23) @34:11
  store cr.val := %16 @34:1
  let %17: Int = record_field(cr, val) @35:10
  do call printInt(%17) @35:1
  let %18: Record x: Int y: Int end = record(x = 5, y = 7) @39:11
  let nested: Record pos: Record x: Int y: Int end var count: Int end = record(pos = %18, var count = 0) @38:14
  let %19: Record x: Int y: Int end = record_field(nested, pos) @42:17
  let %20: Int = record_field(%19, x) @42:17
  let %21: Record x: Int y: Int end = record_field(nested, pos) @42:32
  let %22: Int = record_field(%21, y) @42:32
  let %23: Int = prim *(%20, %22) @42:17
  store nested.count := %23 @42:1
  let %24: Int = record_field(nested, count) @43:10
  do call printInt(%24) @43:1
}

