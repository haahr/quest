import writer = "writer" : Writer
import conv = "conv" : Conv
import intOp = "int" : IntOp
main {
  funs {
    fun say(n: Int): Ok {
      let %1: writer.T = member writer.output @7:40
      let %2: String = call conv.int(n) @7:54
      let %3: String = prim <>(%2, "\n") @7:54
      let %4: Ok = call writer.putString(%1, %3) @7:23
      return %4
    }
  }
  let %5: Int = member intOp.minInt @9:5
  let %6: Int = prim /(%5, 10) @9:5
  do call say(%6) @9:1
  let %7: Int = member intOp.minInt @10:5
  let %8: Int = prim %(%7, 10) @10:5
  do call say(%8) @10:1
  let %9: Int = member intOp.maxInt @11:5
  let %10: Int = prim /(%9, 10) @11:5
  do call say(%10) @11:1
  let %11: Int = member intOp.maxInt @12:5
  let %12: Int = prim %(%11, 10) @12:5
  do call say(%12) @12:1
  let %13: Int = prim /(9007199254740993, 1) @13:5
  do call say(%13) @13:1
  let %14: Int = prim /(-9007199254740993, 3) @14:5
  do call say(%14) @14:1
  let %15: Int = prim %(-9007199254740993, 3) @15:5
  do call say(%15) @15:1
  let %16: Int = prim /(123456789012345678, -1000) @16:5
  do call say(%16) @16:1
  let %17: Int = prim %(123456789012345678, -1000) @17:5
  do call say(%17) @17:1
}

