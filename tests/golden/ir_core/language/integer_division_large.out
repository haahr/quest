import writer = "writer" : Writer
import conv = "conv" : Conv
import intOp = "int" : IntOp
main {
  funs {
    fun say(n: Int): Ok {
      let %1: writer.T = member writer.output
      let %2: String = call external "quest_conv_int"(n)
      let %3: String = prim <>(%2, "\n")
      let %4: Ok = call writer.putString(%1, %3)
      return %4
    }
  }
  let %5: Int = member intOp.minInt
  let %6: Int = prim /(%5, 10)
  do call say(%6)
  let %7: Int = member intOp.minInt
  let %8: Int = prim %(%7, 10)
  do call say(%8)
  let %9: Int = member intOp.maxInt
  let %10: Int = prim /(%9, 10)
  do call say(%10)
  let %11: Int = member intOp.maxInt
  let %12: Int = prim %(%11, 10)
  do call say(%12)
  let %13: Int = prim /(9007199254740993, 1)
  do call say(%13)
  let %14: Int = prim /(-9007199254740993, 3)
  do call say(%14)
  let %15: Int = prim %(-9007199254740993, 3)
  do call say(%15)
  let %16: Int = prim /(123456789012345678, -1000)
  do call say(%16)
  let %17: Int = prim %(123456789012345678, -1000)
  do call say(%17)
}

