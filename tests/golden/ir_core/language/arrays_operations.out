import arrayOp = "arrayOp" : ArrayOp
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @7:12
  funs {
    fun printInt(x: Int): Ok {
      let %1: String = call conv.int(x) @10:31
      do call writer.putString(wOut, %1) @10:9
      let %2: Ok = call writer.putString(wOut, "\n") @11:9
      return %2
    }
  }
  let a1: Array(Int) = array(10, 20, 30, 40, 50) @15:10
  let %3: Int = index(a1, 0) @16:10
  do call printInt(%3) @16:1
  let %4: Int = index(a1, 4) @17:10
  do call printInt(%4) @17:1
  let a2: Array(Int) = array_rep(5, 77) @20:10
  let %5: Int = prim extent(a2) @21:10
  do call printInt(%5) @21:1
  let %6: Int = index(a2, 2) @22:10
  do call printInt(%6) @22:1
  store a1[2] := 999 @25:1
  let %7: Int = index(a1, 2) @26:10
  do call printInt(%7) @26:1
  var sum: Int = 0 @29:1
  var i: Int = 0 @30:1
  loop L1 {
    let %8: Bool = prim <=(i, 4) @30:1
    if %8 { @30:1
      let i.1: Int = i @30:1
      let %9: Int = index(a1, i.1) @31:18
      let %10: Int = prim +(sum, %9) @31:12
      sum := %10 @31:5
      let %11: Int = prim +(i, 1) @30:1
      i := %11 @30:1
    } else {
      break L1 @30:1
    }
  }
  do call printInt(sum) @33:1
}

