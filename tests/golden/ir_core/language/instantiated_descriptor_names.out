import dynamic = "dynamic" : Dynamic
main {
  funs {
    fun f [A::TYPE](x: A): Dynamic {
      let v: A = x @7:73
      let w: Int = 1 @7:75
      let %1: Tuple v: A w: Int end = tuple(v, w) @7:67
      let %2: T = call dynamic.new [Tuple v: A w: Int end](%1) @7:32
      return %2
    }
  }
  let g: All(A :: TYPE) Fun(x: A): Dynamic = f @8:36
  funs {
    fun h [A::TYPE B::TYPE](x.1: A, y: B): Dynamic {
      let a: A = x.1 @10:62
      let c: B = y @10:70
      let d: A = x.1 @10:72
      let b: Tuple c: B d: A end = tuple(c, d) @10:64
      let %3: Tuple a: A b: Tuple c: B d: A end end = tuple(a, b) @10:56
      let %4: T = call dynamic.new [Tuple a: A b: Tuple c: B d: A end end](%3) @10:5
      return %4
    }
  }
  let %5: Dynamic = call g [String]("hi") @12:7
  let %6: Dynamic = call h [Int Bool](3, true) @12:23
  let p: Char = 'c' @12:71
  let %7: Tuple p: Char end = tuple(p) @12:65
  let %8: Dynamic = call f [Tuple p: Char end](%7) @12:44
  let %9: Tuple Dynamic Dynamic Dynamic end = tuple(%5, %6, %8) @12:1
}

