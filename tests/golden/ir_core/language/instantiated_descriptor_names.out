import dynamic = "dynamic" : Dynamic
main {
  funs {
    fun f [A::TYPE](x: A): Dynamic {
      let v: A = x
      let w: Int = 1
      let %1: Tuple v: A w: Int end = tuple(v, w)
      let %2: T = call dynamic.new [Tuple v: A w: Int end](%1)
      return %2
    }
  }
  let g: All(A :: TYPE) Fun(x: A): Dynamic = f
  funs {
    fun h [A::TYPE B::TYPE](x.1: A, y: B): Dynamic {
      let a: A = x.1
      let c: B = y
      let d: A = x.1
      let b: Tuple c: B d: A end = tuple(c, d)
      let %3: Tuple a: A b: Tuple c: B d: A end end = tuple(a, b)
      let %4: T = call dynamic.new [Tuple a: A b: Tuple c: B d: A end end](%3)
      return %4
    }
  }
  let %5: Dynamic = call g [String]("hi")
  let %6: Dynamic = call h [Int Bool](3, true)
  let p: Char = 'c'
  let %7: Tuple p: Char end = tuple(p)
  let %8: Dynamic = call f [Tuple p: Char end](%7)
  let %9: Tuple Dynamic Dynamic Dynamic end = tuple(%5, %6, %8)
}

