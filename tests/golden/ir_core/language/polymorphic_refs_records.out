main {
  funs {
    fun updatePoint [A::TYPE](out dest: A, src: A): Ok {
      dest := src @8:5
      return ok
    }
  }
  let %1: Record x: Int y: Int end = record(x = 10, y = 20) @10:14
  var p1: Record x: Int y: Int end = %1 @10:1
  let p2: Record x: Int y: Int end = record(x = 30, y = 40) @11:10
  let %2: Var(Record x: Int y: Int end) = addr p1 @12:20
  do call updatePoint [Point](%2, p2) @12:1
  let p1x: Int = record_field(p1, x) @13:11
  let p1y: Int = record_field(p1, y) @14:11
  funs {
    fun swapPoly [A::TYPE](var a: A, var b: A): Ok {
      let tmp: A = a @18:19
      a := b @19:9
      b := tmp @20:9
      return ok
    }
  }
  let %3: Record x: Int y: Int end = record(x = 1, y = 2) @23:14
  var r1: Record x: Int y: Int end = %3 @23:1
  let %4: Record x: Int y: Int end = record(x = 8, y = 9) @24:14
  var r2: Record x: Int y: Int end = %4 @24:1
  let %5: Var(Record x: Int y: Int end) = addr r1 @25:17
  let %6: Var(Record x: Int y: Int end) = addr r2 @25:21
  do call swapPoly [Point](%5, %6) @25:1
  let r1x: Int = record_field(r1, x) @26:11
  let r2x: Int = record_field(r2, x) @27:11
  let assignClosure: All(A :: TYPE) Fun(out dest: A src: A): Ok = updatePoint @30:21
  let %7: Record x: Int y: Int end = record(x = 100, y = 200) @31:14
  var p3: Record x: Int y: Int end = %7 @31:1
  let p4: Record x: Int y: Int end = record(x = 500, y = 600) @32:10
  let %8: Var(Record x: Int y: Int end) = addr p3 @33:22
  do call assignClosure [Point](%8, p4) @33:1
  let p3x: Int = record_field(p3, x) @34:11
  let p3y: Int = record_field(p3, y) @35:11
  let swapClosure: All(A :: TYPE) Fun(var a: A var b: A): Ok = swapPoly @37:19
  let %9: Record x: Int y: Int end = record(x = 111, y = 222) @38:14
  var s1: Record x: Int y: Int end = %9 @38:1
  let %10: Record x: Int y: Int end = record(x = 333, y = 444) @39:14
  var s2: Record x: Int y: Int end = %10 @39:1
  let %11: Var(Record x: Int y: Int end) = addr s1 @40:20
  let %12: Var(Record x: Int y: Int end) = addr s2 @40:24
  do call swapClosure [Point](%11, %12) @40:1
  let s1x: Int = record_field(s1, x) @41:11
  let s2x: Int = record_field(s2, x) @42:11
  funs {
    fun makePair [A::TYPE B::TYPE](a.1: A, b.1: B): Tuple first: A second: B end {
      let first: A = a.1 @46:23
      let second: B = b.1 @46:38
      let %13: Tuple first: A second: B end = tuple(first, second) @46:5
      return %13
    }
  }
  let pt1: Record x: Int y: Int end = record(x = 77, y = 88) @48:11
  let directPair: Tuple first: Point second: String end = call makePair [Point String](pt1, "hello") @49:18
  let %14: Point = tuple_field(directPair, 0) @50:11
  let dpx: Int = record_field(%14, x) @50:11
  let %15: Point = tuple_field(directPair, 0) @51:11
  let dpy: Int = record_field(%15, y) @51:11
  let dps: String = tuple_field(directPair, 1) @52:11
  let pairClosure: All(A :: TYPE B :: TYPE) Fun(a: A b: B): Tuple first: A second: B end = makePair @54:19
  let pt2: Record x: Int y: Int end = record(x = 99, y = 101) @55:11
  let closPair: Tuple first: Point second: Int end = call pairClosure [Point Int](pt2, 42) @56:16
  let %16: Point = tuple_field(closPair, 0) @57:11
  let cpx: Int = record_field(%16, x) @57:11
  let %17: Point = tuple_field(closPair, 0) @58:11
  let cpy: Int = record_field(%17, y) @58:11
  let cpi: Int = tuple_field(closPair, 1) @59:11
  let p3d: Record x: Int y: Int z: Int end = record(x = 1, y = 2, z = 3) @62:11
  let pt: Record x: Int y: Int z: Int end = p3d @63:61
  let tag: String = "3D" @63:75
  let t3d: Tuple pt: Point3D tag: String end = tuple(pt, tag) @63:46
  let t2d: Tuple pt: Point tag: String end = t3d @64:44
  let %18: Point = tuple_field(t2d, 0) @65:12
  let t2dx: Int = record_field(%18, x) @65:12
  let %19: Point = tuple_field(t2d, 0) @66:12
  let t2dy: Int = record_field(%19, y) @66:12
  let t2dtag: String = tuple_field(t2d, 1) @67:14
}

