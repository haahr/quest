  funs rec {
    fun twice(k: Int): Bool {
      join k1(r: Bool) {
        return r
      } in {
        let %34: Bool = prim is(k, 0) @33:8
        if %34 { @33:5
          jump k1(true) @33:5
        } else {
          join k2(r.1: Bool) {
            jump k1(r.1) @33:5
          } in {
            let %35: Bool = call same [Int](own, own) @34:10
            if %35 { @34:10
              join k3(r.2: Bool) {
                jump k2(r.2) @34:10
              } in {
                let %36: Fun(a: Int b: Int): Int = member sort.intCompare @34:46
                let %37: Fun(a: Int b: Int): Int = member sort.intCompare @34:62
                let %38: Bool = call same [Int](%36, %37) @34:36
                if %38 { @34:36
                  let %39: Int = prim -(k, 1) @34:93
                  let %40: Bool = call twice(%39) @34:87
                  jump k3(%40) @34:36
                } else {
                  jump k3(false) @34:36
                }
              }
            } else {
              jump k2(false) @34:10
            }
          }
        }
      }
    }
  }
  let %41: Bool = call twice(3) @36:37
  let %42: String = call conv.bool(%41) @36:27
