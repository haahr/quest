      return %3
    }
  }
  funs {
    fun same [A::TYPE](f: Fun(x: A y: A): Int, g: Fun(x: A y: A): Int): Bool {
      let %4: Bool = prim is(f, g) @17:71
      return %4
    }
  }
  funs {
    fun own(x: Int, y: Int): Int {
      let %5: Int = prim -(x, y) @19:31
      return %5
    }
  }
  funs {
    fun other(x.1: Int, y.1: Int): Int {
      let %6: Int = prim -(y.1, x.1) @20:33
