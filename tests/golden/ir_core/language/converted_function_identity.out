  let %22: Fun(a: Int b: Int): Int = builtin - @28:42
  let %23: Fun(a: Int b: Int): Int = builtin - @28:46
  let %24: Bool = call same [Int](%22, %23) @28:31
  let %25: String = call conv.bool(%24) @28:21
