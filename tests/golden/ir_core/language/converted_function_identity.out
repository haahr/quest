  let %10: Fun(a: Int b: Int): Int = member sort.intCompare @24:42
  let %11: Fun(a: Int b: Int): Int = member sort.intCompare @24:58
  let %12: Bool = call same [Int](%10, %11) @24:32
  let %13: String = call conv.bool(%12) @24:22
  let %14: String = prim <>("imported ", %13) @24:7
  do call print(%14) @24:1
