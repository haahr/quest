import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  funs {
    fun print(s: String): Ok {
      let %1: writer.T = member writer.output
      let %2: String = prim <>(s, "\n")
      let %3: Ok = call writer.putString(%1, %2)
      return %3
    }
  }
  funs {
    fun get [A::TYPE](s.1: Holder(A)): A {
      let %4: A = record_field(s.1, x)
      return %4
    }
  }
  funs {
    fun make [A::TYPE](v: A): Holder(A) {
      let %5: Record x: A end = record(x = v)
      return %5
    }
  }
  let getF: All(A :: TYPE) Fun(s: Holder(A)): A = get
  let makeF: All(A :: TYPE) Fun(v: A): Holder(A) = make
  let %6: Record a: Int end = record(a = 4)
  let hp: Holder(P) = record(x = %6)
  let %7: P = call getF [P](hp)
  let %8: Int = record_field(%7, a)
  let %9: String = call conv.int(%8)
  do call print(%9)
  let %10: Record a: Int end = record(a = 9)
  let %11: Holder(P) = call makeF [P](%10)
  let %12: P = record_field(%11, x)
  let %13: Int = record_field(%12, a)
  let %14: String = call conv.int(%13)
  do call print(%14)
  let %15: V = variant(p, 5)
  let hv: Holder(V) = record(x = %15)
  join k1(r: Int) {
    let %16: String = call conv.int(r)
    do call print(%16)
    join k2(r.1: Int) {
      let %17: String = call conv.int(r.1)
      do call print(%17)
      let getP: Fun(s: Holder(P)): P = type_app get [P]
      let %18: P = call getP(hp)
      let %19: Int = record_field(%18, a)
      let %20: String = call conv.int(%19)
      do call print(%20)
    } in {
      let %21: V = variant(p, 6)
      let %22: Holder(V) = call makeF [V](%21)
      let %23: V = record_field(%22, x)
      switch tag(%23) {
        case p (k: Int): {
          jump k2(k)
        }
        else: {
          jump k2(0)
        }
      }
    }
  } in {
    let %24: V = call getF [V](hv)
    switch tag(%24) {
      case p (k.1: Int): {
        jump k1(k.1)
      }
      else: {
        jump k1(0)
      }
    }
  }
}

