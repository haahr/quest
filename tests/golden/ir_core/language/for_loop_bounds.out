      let %20: Bool = prim is(i.2, %17) @18:1
      if %20 { @18:1
        break L2 @18:1
      }
      let %21: Int = prim -(i.2, 1) @18:1
      i.2 := %21 @18:1
    }
  }
  do call count("downto minInt", n.1) @19:1
  n.1 := 0 @21:1
  let %22: Int = member intOp.maxInt @22:9
  let %23: Int = member intOp.maxInt @22:27
  var i.4: Int = %22 @22:1
  let %24: Bool = prim <=(i.4, %23) @22:1
  if %24 { @22:1
    loop L3 {
      let i.5: Int = i.4 @22:1
      let %25: Int = prim +(n.1, 1) @22:48
      n.1 := %25 @22:43
      let %26: Bool = prim is(i.4, %23) @22:1
      if %26 { @22:1
        break L3 @22:1
      }
      let %27: Int = prim +(i.4, 1) @22:1
      i.4 := %27 @22:1
    }
  }
  do call count("maxInt to maxInt", n.1) @23:1
  n.1 := 0 @25:1
  var i.6: Int = 3 @26:1
  let %28: Bool = prim <=(i.6, 2) @26:1
  if %28 { @26:1
    loop L4 {
      let i.7: Int = i.6 @26:1
      let %29: Int = prim +(n.1, 1) @26:26
      n.1 := %29 @26:21
      let %30: Bool = prim is(i.6, 2) @26:1
      if %30 { @26:1
        break L4 @26:1
      }
      let %31: Int = prim +(i.6, 1) @26:1
      i.6 := %31 @26:1
    }
  }
  do call count("empty upto", n.1) @27:1
  n.1 := 0 @29:1
  var i.8: Int = 2 @30:1
  let %32: Bool = prim >=(i.8, 3) @30:1
  if %32 { @30:1
    loop L5 {
      let i.9: Int = i.8 @30:1
      let %33: Int = prim +(n.1, 1) @30:28
      n.1 := %33 @30:23
      let %34: Bool = prim is(i.8, 3) @30:1
      if %34 { @30:1
        break L5 @30:1
      }
      let %35: Int = prim -(i.8, 1) @30:1
      i.8 := %35 @30:1
    }
  }
  do call count("empty downto", n.1) @31:1
  var last: Int = 0 @33:1
  var i.10: Int = 1 @34:1
  let %36: Bool = prim <=(i.10, 5) @34:1
  if %36 { @34:1
    loop L6 {
      let i.11: Int = i.10 @34:1
      last := i.11 @34:21
      let %37: Bool = prim is(i.10, 5) @34:1
      if %37 { @34:1
        break L6 @34:1
