import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @6:12
  funs {
    fun printInt(x: Int): Ok {
      let %1: String = call conv.int(x) @9:31
      do call writer.putString(wOut, %1) @9:9
      let %2: Ok = call writer.putString(wOut, "\n") @10:9
      return %2
    }
  }
  funs {
    fun printBool(b: Bool): Ok {
      let %3: String = call conv.bool(b) @15:31
      do call writer.putString(wOut, %3) @15:9
      let %4: Ok = call writer.putString(wOut, "\n") @16:9
      return %4
    }
  }
  funs {
    fun isMon(d: Day): Bool {
      let %5: Bool = is_tag(d, mon) @22:27
      return %5
    }
  }
  let w: WeekDay = variant(mon, 1) @23:18
  let %6: Bool = call isMon(w) @24:11
  do call printBool(%6) @24:1
  funs {
    fun getDayCode(d.1: Day): Int {
      join k1(r: Int) {
        return r
      } in {
        switch tag(d.1) { @27:5
          case mon (c: Int): {
            jump k1(c) @27:5
          }
          case tue (c.1: Int): {
            jump k1(c.1) @27:5
          }
          case wed (c.2: Int): {
            jump k1(c.2) @27:5
          }
          case thu (c.3: Int): {
            jump k1(c.3) @27:5
          }
          case fri (c.4: Int): {
            jump k1(c.4) @27:5
          }
          else: {
            jump k1(0) @27:5
          }
        }
      }
    }
  }
  let %7: Int = call getDayCode(w) @36:10
  do call printInt(%7) @36:1
  let friDay: WeekDay = variant(fri, 5) @37:23
  let %8: Int = call getDayCode(friDay) @38:10
  do call printInt(%8) @38:1
}

