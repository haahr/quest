main {
  let h: Int = 1
  let t: R = option(nil)
  let %1: Tuple Let X = P h: Int t: R end = tuple(Let X = P h, t)
  let rr: R = option(cons, %1)
  let h.1: Int = 2
  let t.1: R = rr
  let %2: Tuple Let X = P h: Int t: R end = tuple(Let X = P h.1, t.1)
  let two: R = option(cons, %2)
  let y: Int = 3
  let %3: Tuple Let Y = P y: Int end = tuple(Let Y = P y)
  let leaf: Tree = variant(leaf, %3)
  let %4: Array(Tree) = array(leaf)
  let %5: Record trees: Array(Tree) end = record(trees = %4)
  let %6: Tree = variant(node, %5)
  let %7: Array(Tree) = array(leaf, %6)
  let forest: Forest = record(trees = %7)
  let s: Rec(S :: TYPE) Option stop more with Tuple Let Z = P s: S end end = option(stop)
  let %8: Tuple Let Z = P s: Rec(S :: TYPE) Option stop more with Tuple Let Z = P s: S end end end = tuple(Let Z = P s)
  let anon: Rec(S :: TYPE) Option stop more with Tuple Let Z = P s: S end end = option(more, %8)
}

