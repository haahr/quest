  let %11: String = call conv.int(%10) @15:22
  let %12: String = prim <>("generic: ", %11) @15:7
  do call print(%12) @15:1
  funs {
    fun call [F::<: Fun(x: Sub): Int](f.3: F): Int {
      let h.1: Fun(x: Sub): Int = f.3 @19:75
      let %13: Record a: Int z: Int end = record(a = 1, z = 2) @19:79
      let %14: Int = call h.1(%13) @19:77
      return %14
    }
  }
  funs {
    fun tens(x.2: Super): Int {
      let %15: Int = record_field(x.2, z) @20:27
      let %16: Int = prim *(%15, 10) @20:27
      return %16
    }
  }
  let %17: Int = call call [Fun(x: Super): Int](tens) @21:38
  let %18: String = call conv.int(%17) @21:29
  let %19: String = prim <>("direct subtype: ", %18) @21:7
  do call print(%19) @21:1
  let callF: All(F <: Fun(x: Sub): Int) Fun(f: F): Int = call @22:49
  let %20: Int = call callF [Fun(x: Super): Int](tens) @23:39
  let %21: String = call conv.int(%20) @23:30
  let %22: String = prim <>("generic subtype: ", %21) @23:7
