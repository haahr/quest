      return %5
    }
  }
  let %6: Int = call apply [Fun(x: Int): Int](f.1) @13:30
  let %7: String = call conv.int(%6) @13:21
  let %8: String = prim <>("direct: ", %7) @13:7
  do call print(%8) @13:1
  let applyF: All(F <: Fun(x: Int): Int) Fun(f: F): Int = apply @14:50
