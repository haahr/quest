main {
  let a: Int = 0
  funs {
    fun f(x: A): Int {
      let %1: Int = prim +(x, 1)
      return %1
    }
  }
  let t1: T = tuple(Let A = Int a, f)
  let a1: t1.A = tuple_field(t1, 0)
  let %2: Fun(x: t1.A): Int = tuple_field(t1, 1)
  let res1: Int = call %2(a1)
  let a.1: Int = 42
  let tb: TB = tuple(Let A = Int a.1)
  let %3: tb.A = tuple_field(tb, 0)
  let res2: Int = prim +(%3, 1)
  let a.2: Int = 100
  let tTrans: Tuple Let A = Int a: Int end = tuple(Let A = Int a.2)
  let t2: SimpleT = tTrans
}

