import writer = "writer" : Writer
import conv = "conv" : Conv
module counter : Counter {
  let base: Int = 1
  funs {
    fun first(): Int {
      return base
    }
  }
  let base.1: Int = 2
  funs {
    fun second(): Int {
      return base.1
    }
  }
  let counter_record: Record base: Int first: Fun(): Int second: Fun(): Int end = record(base = base.1, first = first, second = second)
  export base = base.1, first = first, second = second
  record counter_record
}
main {
  funs {
    fun show(n: Int): Ok {
      let %1: writer.T = member writer.output
      let %2: String = call external "quest_conv_int"(n)
      do call writer.putString(%1, %2)
      let %3: writer.T = member writer.output
      let %4: Ok = call writer.putString(%3, "\n")
      return %4
    }
  }
  let x: Int = 1
  funs {
    fun f(): Int {
      return x
    }
  }
  let x.1: Int = 2
  let %5: Int = call f()
  let %6: Int = prim *(%5, 10)
  let %7: Int = prim +(%6, x.1)
  do call show(%7)
  funs {
    fun g(): Int {
      return 10
    }
  }
  funs {
    fun callsG(): Int {
      let %8: Int = call g()
      return %8
    }
  }
  funs {
    fun g.1(): Int {
      return 20
    }
  }
  let %9: Int = call callsG()
  let %10: Int = call g.1()
  let %11: Int = prim +(%9, %10)
  do call show(%11)
  let y: Int = 100
  funs {
    fun makeAdder(): Fun(n: Int): Int {
      funs {
        fun f.1(n.1: Int): Int {
          let %12: Int = prim +(n.1, y)
          return %12
        }
      }
      return f.1
    }
  }
  let add: Fun(n: Int): Int = call makeAdder()
  let y.1: Int = 200
  let %13: Int = call add(1)
  let %14: Int = prim +(%13, y.1)
  do call show(%14)
  funs rec {
    fun count(n.2: Int): Int {
      join k1(r: Int) {
        return r
      } in {
        let %15: Bool = prim is(n.2, 0)
        if %15 {
          jump k1(0)
        } else {
          let %16: Int = prim -(n.2, 1)
          let %17: Int = call count(%16)
          let %18: Int = prim +(1, %17)
          jump k1(%18)
        }
      }
    }
  }
  funs {
    fun countThree(): Int {
      let %19: Int = call count(3)
      return %19
    }
  }
  funs rec {
    fun count.1(n.3: Int): Int {
      join k2(r.1: Int) {
        return r.1
      } in {
        let %20: Bool = prim is(n.3, 0)
        if %20 {
          jump k2(0)
        } else {
          let %21: Int = prim -(n.3, 1)
          let %22: Int = call count.1(%21)
          let %23: Int = prim +(2, %22)
          jump k2(%23)
        }
      }
    }
  }
  let %24: Int = call countThree()
  let %25: Int = prim *(%24, 10)
  let %26: Int = call count.1(3)
  let %27: Int = prim +(%25, %26)
  do call show(%27)
  let n.4: Int = 1
  let v: Tuple var n: Int end = tuple(n.4)
  funs {
    fun bump(): Int {
      let %28: Int = tuple_field(v, 0)
      let %29: Int = prim +(%28, 1)
      store v.#0 := %29
      let %30: Int = tuple_field(v, 0)
      return %30
    }
  }
  let v.1: Int = 50
  let %31: Int = call bump()
  let %32: Int = prim +(%31, v.1)
  do call show(%32)
  let %33: Int = call counter.first()
  let %34: Int = prim *(%33, 10)
  let %35: Int = call counter.second()
  let %36: Int = prim +(%34, %35)
  do call show(%36)
  let a: Int = 1
  let b: Int = 2
  funs {
    fun sumAB(): Int {
      let %37: Int = prim +(a, b)
      return %37
    }
  }
  let a.1: Int = 10
  let b.1: Int = 20
  let %38: Int = call sumAB()
  let %39: Int = prim *(%38, 100)
  let %40: Int = prim +(a.1, b.1)
  let %41: Int = prim +(%39, %40)
  do call show(%41)
}

