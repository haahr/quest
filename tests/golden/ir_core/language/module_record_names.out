import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let real: Real = 2.5 @7:12
  let sum: Real = prim ++(real, 1.0) @8:11
  let %1: writer.T = member writer.output @10:18
  let %2: String = call conv.real(sum) @10:32
  do call writer.putString(%1, %2) @10:1
  let %3: writer.T = member writer.output @11:18
  do call writer.putString(%3, "\n") @11:1
}

