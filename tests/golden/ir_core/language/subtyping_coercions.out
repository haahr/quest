import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @6:12
  funs {
    fun printInt(x: Int): Ok {
      let %1: String = call conv.int(x) @9:31
      do call writer.putString(wOut, %1) @9:9
      let %2: Ok = call writer.putString(wOut, "\n") @10:9
      return %2
    }
  }
  funs {
    fun getFirstTwo(t: SmallTuple): Int {
      let %3: Int = tuple_field(t, 0) @16:39
      let %4: Int = tuple_field(t, 1) @16:45
      let %5: Int = prim +(%3, %4) @16:39
      return %5
    }
  }
  let x.1: Int = 10 @17:34
  let y: Int = 20 @17:45
  let z: Int = 30 @17:56
  let bt: BigTuple = tuple(x.1, y, z) @17:20
  let %6: Int = call getFirstTwo(bt) @18:10
  do call printInt(%6) @18:1
  funs {
    fun sumXY(r: SmallRec): Int {
      let %7: Int = record_field(r, x) @23:31
      let %8: Int = record_field(r, y) @23:37
      let %9: Int = prim +(%7, %8) @23:31
      return %9
    }
  }
  let br: BigRec = record(x = 100, y = 200, z = 300) @24:18
  let %10: Int = call sumXY(br) @25:10
  do call printInt(%10) @25:1
  funs {
    fun getA(r.1: OrderedRec): Int {
      let %11: Int = record_field(r.1, a) @29:32
      let %12: Int = record_field(r.1, b) @29:43
      let %13: Int = prim +(10, %12) @29:38
      let %14: Int = prim *(%11, %13) @29:32
      return %14
    }
  }
  let permuted: Record b: Int a: Int end = record(b = 4, a = 7) @30:16
  let %15: Int = call getA(permuted) @31:10
  do call printInt(%15) @31:1
  funs {
    fun applyRec(f: Fun(r: SmallRec): Int, r.2: BigRec): Int {
      let %16: Int = call f(r.2) @34:56
      return %16
    }
  }
  let %17: Int = call applyRec(sumXY, br) @35:10
  do call printInt(%17) @35:1
}

