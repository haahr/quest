import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  funs {
    fun print(s: String): Ok {
      let %1: writer.T = member writer.output
      let %2: String = prim <>(s, "\n")
      let %3: Ok = call writer.putString(%1, %2)
      return %3
    }
  }
  funs {
    fun boxed [A::TYPE](x: A): Tuple x: A end {
      let x.1: A = x
      let %4: Tuple x: A end = tuple(x.1)
      return %4
    }
  }
  funs {
    fun ti(u: Int): Int {
      return 1
    }
  }
  funs {
    fun tp(u.1: Int): P {
      let %5: Record a: Int end = record(a = 2)
      return %5
    }
  }
  funs {
    fun ts(u.2: Int): String {
      return "three"
    }
  }
  let %6: Tuple x: Thunk(Int) end = call boxed [Thunk(Int)](ti)
  let %7: Thunk(Int) = tuple_field(%6, 0)
  let %8: Int = call %7(0)
  let %9: String = call external "quest_conv_int"(%8)
  do call print(%9)
  let %10: Tuple x: Thunk(P) end = call boxed [Thunk(P)](tp)
  let %11: Thunk(P) = tuple_field(%10, 0)
  let %12: P = call %11(0)
  let %13: Int = record_field(%12, a)
  let %14: String = call external "quest_conv_int"(%13)
  do call print(%14)
  let %15: Tuple x: Thunk(String) end = call boxed [Thunk(String)](ts)
  let %16: Thunk(String) = tuple_field(%15, 0)
  let %17: String = call %16(0)
  do call print(%17)
  let %18: Record a: Int end = record(a = 4)
  let %19: Tuple x: P end = call boxed [P](%18)
  let %20: P = tuple_field(%19, 0)
  let %21: Int = record_field(%20, a)
  let %22: String = call external "quest_conv_int"(%21)
  do call print(%22)
  let %23: Record a: Int end = record(a = 5)
  let %24: Tuple x: P end = call boxed [P](%23)
  let %25: P = tuple_field(%24, 0)
  let %26: Int = record_field(%25, a)
  let %27: String = call external "quest_conv_int"(%26)
  do call print(%27)
}

