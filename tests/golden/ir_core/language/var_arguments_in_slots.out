import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  funs {
    fun print(s: String): Ok {
      let %1: writer.T = member writer.output
      let %2: String = prim <>(s, "\n")
      let %3: Ok = call writer.putString(%1, %2)
      return %3
    }
  }
  let r: Record a: Int end = record(a = 1)
  let v: V = variant(p, 1)
  let t: Tuple var r: P var v: V end = tuple(r, v)
  funs {
    fun setR(var x: P): Int {
      let %4: Record a: Int end = record(a = 2)
      x := %4
      let %5: P = tuple_field(t, 0)
      let %6: Int = record_field(%5, a)
      return %6
    }
  }
  let %7: Var(P) = addr t.#0
  let %8: Int = call setR(%7)
  let %9: String = call conv.int(%8)
  do call print(%9)
  funs {
    fun setV(var x.1: V): Bool {
      let %10: V = variant(q, true)
      x.1 := %10
      let %11: V = tuple_field(t, 1)
      let %12: Bool = is_tag(%11, q)
      return %12
    }
  }
  let %13: Var(V) = addr t.#1
  let %14: Bool = call setV(%13)
  let %15: String = call conv.bool(%14)
  do call print(%15)
  let %16: Record a: Int end = record(a = 3)
  let rec0: Record var r: Record a: Int end end = record(var r = %16)
  let %17: Var(Record a: Int end) = addr rec0.r
  let %18: Int = call setR(%17)
  let %19: String = call conv.int(%18)
  let %20: Record a: Int end = record_field(rec0, r)
  let %21: Int = record_field(%20, a)
  let %22: String = call conv.int(%21)
  let %23: String = prim <>(" ", %22)
  let %24: String = prim <>(%19, %23)
  do call print(%24)
  let %25: Record a: Int end = record(a = 5)
  let %26: Record a: Int end = record(a = 6)
  let arr: Array(Record a: Int end) = array(%25, %26)
  funs {
    fun setG [A::TYPE](var x.2: A, y: A): Ok {
      x.2 := y
      return ok
    }
  }
  let setGF: All(A :: TYPE) Fun(var x: A y: A): Ok = setG
  let %27: Var(Record a: Int end) = addr arr[1]
  let %28: Record a: Int end = record(a = 7)
  do call setGF [P](%27, %28)
  let %29: Var(P) = addr t.#0
  let %30: Record a: Int end = record(a = 8)
  do call setGF [P](%29, %30)
  let %31: Record a: Int end = index(arr, 1)
  let %32: Int = record_field(%31, a)
  let %33: String = call conv.int(%32)
  let %34: P = tuple_field(t, 0)
  let %35: Int = record_field(%34, a)
  let %36: String = call conv.int(%35)
  let %37: String = prim <>(" ", %36)
  let %38: String = prim <>(%33, %37)
  do call print(%38)
  let %39: Record a: Int end = record(a = 9)
  var local: P = %39
  let %40: Var(P) = addr local
  let %41: Record a: Int end = record(a = 10)
  do call setGF [P](%40, %41)
  let %42: Int = record_field(local, a)
  let %43: String = call conv.int(%42)
  do call print(%43)
  funs {
    fun swap [A::TYPE](var x.3: A, var y.1: A): Ok {
      let z: A = x.3
      x.3 := y.1
      y.1 := z
      return ok
    }
  }
  let swapF: All(A :: TYPE) Fun(var x: A var y: A): Ok = swap
  let %44: Var(Record a: Int end) = addr arr[0]
  let %45: Var(Record a: Int end) = addr arr[1]
  do call swapF [P](%44, %45)
  let %46: Record a: Int end = index(arr, 0)
  let %47: Int = record_field(%46, a)
  let %48: String = call conv.int(%47)
  let %49: Record a: Int end = index(arr, 1)
  let %50: Int = record_field(%49, a)
  let %51: String = call conv.int(%50)
  let %52: String = prim <>(" ", %51)
  let %53: String = prim <>(%48, %52)
  do call print(%53)
}

