import list = "list" : List
import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let %1: list.T(Int) = type_app list.nil [Int]
  let tail: list.T(Int) = call list.cons [Int](2, %1)
  let fromArgs: list.T(Int) = call list.cons [Int](3, tail)
  let %2: list.T(Int) = type_app list.nil [Int]
  let fromContext: list.T(Int) = call list.cons [Int](3, %2)
  let declared: list.T(Int) = type_app list.nil [Int]
  let %3: list.T(Int) = type_app list.nil [Int]
  let %4: list.T(Int) = type_app list.nil [Int]
  let %5: list.T(Int) = call list.cons [Int](1, %4)
  let %6: list.T(list.T(Int)) = type_app list.nil [list.T(Int)]
  let %7: list.T(list.T(Int)) = call list.cons [list.T(Int)](%5, %6)
  let nested: list.T(list.T(Int)) = call list.cons [list.T(Int)](%3, %7)
  let %8: list.T(Int) = type_app list.nil [Int]
  let explicit: list.T(Int) = call list.cons [Int](4, %8)
  let %9: writer.T = member writer.output
  let %10: Int = call list.length [Int](fromArgs)
  let %11: String = call conv.int(%10)
  do call writer.putString(%9, %11)
  let %12: writer.T = member writer.output
  do call writer.putString(%12, " ")
  let %13: writer.T = member writer.output
  let %14: Int = call list.head [Int](fromContext)
  let %15: String = call conv.int(%14)
  do call writer.putString(%13, %15)
  let %16: writer.T = member writer.output
  do call writer.putString(%16, " ")
  let %17: writer.T = member writer.output
  let %18: Bool = call list.null [Int](declared)
  let %19: String = call conv.bool(%18)
  do call writer.putString(%17, %19)
  let %20: writer.T = member writer.output
  do call writer.putString(%20, " ")
  let %21: writer.T = member writer.output
  let %22: Int = call list.length [list.T(Int)](nested)
  let %23: String = call conv.int(%22)
  do call writer.putString(%21, %23)
  let %24: writer.T = member writer.output
  do call writer.putString(%24, " ")
  let %25: writer.T = member writer.output
  let %26: list.T(Int) = call list.head [list.T(Int)](nested)
  let %27: Bool = call list.null [Int](%26)
  let %28: String = call conv.bool(%27)
  do call writer.putString(%25, %28)
  let %29: writer.T = member writer.output
  do call writer.putString(%29, " ")
  let %30: writer.T = member writer.output
  let %31: Int = call list.head [Int](explicit)
  let %32: String = call conv.int(%31)
  do call writer.putString(%30, %32)
  let %33: writer.T = member writer.output
  do call writer.putString(%33, "\n")
}

