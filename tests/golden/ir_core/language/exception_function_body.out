import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output
  funs {
    fun printInt(x: Int): Ok {
      let %1: String = call conv.int(x)
      do call writer.putString(wOut, %1)
      let %2: Ok = call writer.putString(wOut, "\n")
      return %2
    }
  }
  funs {
    fun mk(x.1: Int): Exception(Int) {
      let Made: Exception(Int) = exception Made: Int
      return Made
    }
  }
  let m1: Exception(Int) = call mk(1)
  let m2: Exception(Int) = call mk(2)
  join k1(r: Int) {
    do call printInt(r)
    join k2(r.1: Int) {
      do call printInt(r.1)
      funs {
        fun g(x.2: Int): Int {
          declare Inline: Exception(Int)
          join k4(r.2: Int) {
            return r.2
          } in {
            try {
              let Inline: Exception(Int) = exception Inline: Int
              raise Inline with x.2
            } handle (e: Exception) {
              let %3: Bool = prim is(e, Inline)
              if %3 {
                let n: Int = exception_payload(e)
                let %4: Int = prim +(n, 1)
                jump k4(%4)
              } else {
                reraise e
              }
            }
          }
        }
      }
      let %5: Int = call g(4)
      do call printInt(%5)
      funs {
        fun h(x.3: Int): Int {
          declare Pos: Exception(Int)
          join k5(r.3: Int) {
            return r.3
          } in {
            let %6: Bool = prim >(x.3, 0)
            if %6 {
              join k6(r.4: Int) {
                jump k5(r.4)
              } in {
                try {
                  let Pos: Exception(Int) = exception Pos: Int
                  raise Pos with x.3
                } handle (e.1: Exception) {
                  let %7: Bool = prim is(e.1, Pos)
                  if %7 {
                    let n.1: Int = exception_payload(e.1)
                    let %8: Int = prim *(n.1, 2)
                    jump k6(%8)
                  } else {
                    reraise e.1
                  }
                }
              }
            } else {
              jump k5(0)
            }
          }
        }
      }
      let %9: Int = call h(8)
      do call printInt(%9)
      let %10: Int = call h(-8)
      do call printInt(%10)
      funs {
        fun k(x.4: Int): Int {
          funs {
            fun catcher(y: Int): Int {
              declare Cap: Exception(Int)
              join k7(r.5: Int) {
                return r.5
              } in {
                try {
                  let Cap: Exception(Int) = exception Cap: Int
                  raise Cap with y
                } handle (e.2: Exception) {
                  let %11: Bool = prim is(e.2, Cap)
                  if %11 {
                    let n.2: Int = exception_payload(e.2)
                    let %12: Int = prim +(n.2, x.4)
                    jump k7(%12)
                  } else {
                    reraise e.2
                  }
                }
              }
            }
          }
          let %13: Int = call catcher(10)
          return %13
        }
      }
      let %14: Int = call k(1)
      do call printInt(%14)
      funs {
        fun lam(x.5: Int): Int {
          let Outer: Exception(Int) = exception Outer: Int
          let e.3: Exception(Int) = Outer
          funs {
            fun thrower(y.1: Int): Int {
              join k8(r.6: Int) {
                return r.6
              } in {
                let %15: Bool = prim >(y.1, 0)
                if %15 {
                  raise Outer with y.1
                } else {
                  jump k8(y.1)
                }
              }
            }
          }
          join k9(r.7: Int) {
            return r.7
          } in {
            try catching (e.3) {
              let %16: Int = call thrower(x.5)
              jump k9(%16)
            } handle (e.4: Exception) {
              let %17: Bool = prim is(e.4, e.3)
              if %17 {
                let n.3: Int = exception_payload(e.4)
                let %18: Int = prim *(n.3, 2)
                jump k9(%18)
              } else {
                reraise e.4
              }
            }
          }
        }
      }
      let %19: Int = call lam(21)
      do call printInt(%19)
      let Shadow: Exception(Int) = exception Shadow: Int
      funs {
        fun sh(x.6: Int): Int {
          declare Shadow.1: Exception(Int)
          join k10(r.8: Int) {
            return r.8
          } in {
            try {
              let Shadow.1: Exception(Int) = exception Shadow: Int
              raise Shadow.1 with x.6
            } handle (e.5: Exception) {
              let %20: Bool = prim is(e.5, Shadow.1)
              if %20 {
                let n.4: Int = exception_payload(e.5)
                jump k10(n.4)
              } else {
                reraise e.5
              }
            }
          }
        }
      }
      let %21: Int = call sh(9)
      do call printInt(%21)
      join k11(r.9: Int) {
        do call printInt(r.9)
      } in {
        try catching (Shadow) {
          raise Shadow with 3
        } handle (e.6: Exception) {
          let %22: Bool = prim is(e.6, Shadow)
          if %22 {
            let n.5: Int = exception_payload(e.6)
            let %23: Int = prim +(n.5, 30)
            jump k11(%23)
          } else {
            reraise e.6
          }
        }
      }
    } in {
      try catching (m1) {
        join k3(r.10: Int) {
          jump k2(r.10)
        } in {
          try catching (m2) {
            raise m1 with 6
          } handle (e.7: Exception) {
            let %24: Bool = prim is(e.7, m2)
            if %24 {
              let n.6: Int = exception_payload(e.7)
              let %25: Int = prim -(0, n.6)
              jump k3(%25)
            } else {
              reraise e.7
            }
          }
        }
      } handle (e.8: Exception) {
        let %26: Bool = prim is(e.8, m1)
        if %26 {
          let n.7: Int = exception_payload(e.8)
          jump k2(n.7)
        } else {
          reraise e.8
        }
      }
    }
  } in {
    try catching (m1) {
      raise m1 with 5
    } handle (e.9: Exception) {
      let %27: Bool = prim is(e.9, m1)
      if %27 {
        let n.8: Int = exception_payload(e.9)
        jump k1(n.8)
      } else {
        reraise e.9
      }
    }
  }
}

