main {
  funs {
    fun distance(m: Move): Int {
      join k1(r: Int) {
        return r
      } in {
        switch tag(m) {
          case north, south (d: Tuple steps: Int end): {
            let %1: Int = tuple_field(d, 0)
            jump k1(%1)
          }
          case stay: {
            jump k1(0)
          }
        }
      }
    }
  }
  let steps: Int = 3
  let %2: Tuple steps: Int end = tuple(steps)
  let %3: Move = option(north, %2)
  let %4: Int = call distance(%3)
  let steps.1: Int = 4
  let %5: Tuple steps: Int end = tuple(steps.1)
  let %6: Move = option(south, %5)
  let %7: Int = call distance(%6)
  let distances: Tuple Int Int end = tuple(%4, %7)
  funs {
    fun side(s: Shape): Int {
      join k2(r.1: Int) {
        return r.1
      } in {
        switch tag(s) {
          case circle, square, rect (x: Tuple side: Int end): {
            let %8: Int = tuple_field(x, 0)
            jump k2(%8)
          }
        }
      }
    }
  }
  let side.1: Int = 2
  let r.2: Int = 1
  let %9: Tuple side: Int r: Int end = tuple(side.1, r.2)
  let %10: Shape = option(circle, %9)
  let %11: Int = call side(%10)
  let side.2: Int = 3
  let %12: Tuple side: Int end = tuple(side.2)
  let %13: Shape = option(square, %12)
  let %14: Int = call side(%13)
  let side.3: Int = 4
  let w: Int = 5
  let %15: Tuple side: Int w: Int end = tuple(side.3, w)
  let %16: Shape = option(rect, %15)
  let %17: Int = call side(%16)
  let sides: Tuple Int Int Int end = tuple(%11, %14, %17)
  funs {
    fun getX(v: V): Int {
      join k3(r.3: Int) {
        return r.3
      } in {
        switch tag(v) {
          case a, b (p: Record x: Int end): {
            let %18: Int = record_field(p, x)
            jump k3(%18)
          }
          case c (n: Int): {
            jump k3(n)
          }
        }
      }
    }
  }
  let %19: Record x: Int y: Int end = record(x = 1, y = 2)
  let %20: V = variant(a, %19)
  let %21: Int = call getX(%20)
  let %22: Record y: Bool z: Int x: Int end = record(y = true, z = 7, x = 8)
  let %23: V = variant(b, %22)
  let %24: Int = call getX(%23)
  let %25: V = variant(c, 9)
  let %26: Int = call getX(%25)
  let xs: Tuple Int Int Int end = tuple(%21, %24, %26)
}

