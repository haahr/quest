import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output
  funs {
    fun print(s: String): Ok {
      let %1: String = prim <>(s, "\n")
      let %2: Ok = call writer.putString(wOut, %1)
      return %2
    }
  }
  funs {
    fun first [X::TYPE Y::TYPE](x: X, y: Y): X {
      return x
    }
  }
  let %3: Int = call first [Int Bool](1, true)
  let %4: String = call external "quest_conv_int"(%3)
  do call print(%4)
  funs {
    fun widen [A::TYPE B::<: A](x.1: B): A {
      return x.1
    }
  }
  let %5: Int = call widen [Int Int](2)
  let %6: String = call external "quest_conv_int"(%5)
  do call print(%6)
  funs {
    fun view [A::<: P B::<: A](x.2: B): A {
      return x.2
    }
  }
  let %7: Record a: Int b: Int end = record(a = 3, b = 30)
  let %8: P = call view [P Q](%7)
  let %9: Int = record_field(%8, a)
  let %10: String = call external "quest_conv_int"(%9)
  do call print(%10)
  funs {
    fun getA [X::<: Q](x.3: X): Int {
      let %11: Int = record_field(x.3, a)
      return %11
    }
  }
  let %12: Record a: Int b: Int end = record(a = 4, b = 40)
  let %13: Int = call getA [Q](%12)
  let %14: String = call external "quest_conv_int"(%13)
  do call print(%14)
  funs {
    fun pick [X::<: Q](x.4: X): X {
      return x.4
    }
  }
  let %15: Record a: Int b: Int end = record(a = 5, b = 50)
  let %16: Q = call pick [Q](%15)
  let %17: Int = record_field(%16, b)
  let %18: String = call external "quest_conv_int"(%17)
  do call print(%18)
  funs {
    fun same [T::TYPE](x.5: T): T {
      return x.5
    }
  }
  let %19: Bool = call same [Bool](true)
  let %20: String = call conv.bool(%19)
  do call print(%20)
  let firstInt: Fun(x: Int y: Int): Int = type_app first [Int Int]
  let %21: Int = call firstInt(6, 60)
  let %22: String = call external "quest_conv_int"(%21)
  do call print(%22)
}

