import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @6:12
  funs {
    fun print(s: String): Ok {
      let %1: String = prim <>(s, "\n") @7:50
      let %2: Ok = call writer.putString(wOut, %1) @7:28
      return %2
    }
  }
  funs {
    fun first [X::TYPE Y::TYPE](x: X, y: Y): X {
      return x
    }
  }
  let %3: Int = call first [Int Bool](1, true) @14:16
  let %4: String = call conv.int(%3) @14:7
  do call print(%4) @14:1
  funs {
    fun widen [A::TYPE B::<: A](x.1: B): A {
      return x.1
    }
  }
  let %5: Int = call widen [Int Int](2) @18:16
  let %6: String = call conv.int(%5) @18:7
  do call print(%6) @18:1
  funs {
    fun view [A::<: P B::<: A](x.2: B): A {
      return x.2
    }
  }
  let %7: Record a: Int b: Int end = record(a = 3, b = 30) @20:27
  let %8: P = call view [P Q](%7) @20:16
  let %9: Int = record_field(%8, a) @20:16
  let %10: String = call conv.int(%9) @20:7
  do call print(%10) @20:1
  funs {
    fun getA [X::<: Q](x.3: X): Int {
      let %11: Int = record_field(x.3, a) @23:56
      return %11
    }
  }
  let %12: Record a: Int b: Int end = record(a = 4, b = 40) @24:24
  let %13: Int = call getA [Q](%12) @24:16
  let %14: String = call conv.int(%13) @24:7
  do call print(%14) @24:1
  funs {
    fun pick [X::<: Q](x.4: X): X {
      return x.4
    }
  }
  let %15: Record a: Int b: Int end = record(a = 5, b = 50) @26:24
  let %16: Q = call pick [Q](%15) @26:16
  let %17: Int = record_field(%16, b) @26:16
  let %18: String = call conv.int(%17) @26:7
  do call print(%18) @26:1
  funs {
    fun same [T::TYPE](x.5: T): T {
      return x.5
    }
  }
  let %19: Bool = call same [Bool](true) @30:17
  let %20: String = call conv.bool(%19) @30:7
  do call print(%20) @30:1
  let firstInt: Fun(x: Int y: Int): Int = type_app first [Int Int] @33:16
  let %21: Int = call firstInt(6, 60) @34:16
  let %22: String = call conv.int(%21) @34:7
  do call print(%22) @34:1
}

