main {
  let %1: Sub = variant(z, 1) @9:13
  var x: Sub = %1 @9:1
  let %2: Super = variant(z, 1) @10:13
  var y: Super = %2 @10:1
  let %3: Super = variant(a, 1) @11:13
  var z: Super = %3 @11:1
  let xy: Bool = prim is(x, y) @12:16
  let xz: Bool = prim is(x, z) @12:32
  let yx: Bool = prim is(y, x) @12:48
  let zx: Bool = prim isnot(z, x) @12:64
  let %4: Tuple xy: Bool xz: Bool yx: Bool zx: Bool end = tuple(xy, xz, yx, zx) @12:1
  let %5: Few = option(q) @16:13
  var f: Few = %5 @16:1
  let %6: Many = option(q) @17:13
  var m: Many = %6 @17:1
  let %7: Many = option(p) @18:13
  var n: Many = %7 @18:1
  let fm: Bool = prim is(f, m) @19:16
  let fn: Bool = prim is(f, n) @19:32
  let mf: Bool = prim is(m, f) @19:48
  let nf: Bool = prim isnot(n, f) @19:64
  let %8: Tuple fm: Bool fn: Bool mf: Bool nf: Bool end = tuple(fm, fn, mf, nf) @19:1
}

