main {
  let %1: Sub = variant(z, 1) @10:13
  var x: Sub = %1 @10:1
  let %2: Super = variant(z, 1) @11:13
  var y: Super = %2 @11:1
  let %3: Super = variant(a, 1) @12:13
  var z: Super = %3 @12:1
  let xy: Bool = prim is(x, y) @13:16
  let xz: Bool = prim is(x, z) @13:32
  let yx: Bool = prim is(y, x) @13:48
  let zx: Bool = prim isnot(z, x) @13:64
  let %4: Tuple xy: Bool xz: Bool yx: Bool zx: Bool end = tuple(xy, xz, yx, zx) @13:1
  let %5: Few = option(q) @17:13
  var f: Few = %5 @17:1
  let %6: Many = option(q) @18:13
  var m: Many = %6 @18:1
  let %7: Many = option(p) @19:13
  var n: Many = %7 @19:1
  let fm: Bool = prim is(f, m) @20:16
  let fn: Bool = prim is(f, n) @20:32
  let mf: Bool = prim is(m, f) @20:48
  let nf: Bool = prim isnot(n, f) @20:64
  let %8: Tuple fm: Bool fn: Bool mf: Bool nf: Bool end = tuple(fm, fn, mf, nf) @20:1
  let n.1: Int = 3 @24:47
  let %9: Tuple n: Int end = tuple(n.1) @24:14
  let %10: OneSome = option(q, %9) @24:14
  var s1: OneSome = %10 @24:1
  let n.2: Int = 3 @25:47
  let %11: Tuple n: Int end = tuple(n.2) @25:14
  let %12: TwoSome = option(q, %11) @25:14
  var s2: TwoSome = %12 @25:1
  let %13: TwoSome = option(p) @26:14
  var s3: TwoSome = %13 @26:1
  let s2s1: Bool = prim is(s2, s1) @27:18
  let s3s1: Bool = prim is(s3, s1) @27:38
  let s1s2: Bool = prim is(s1, s2) @27:58
  let %14: Tuple s2s1: Bool s3s1: Bool s1s2: Bool end = tuple(s2s1, s3s1, s1s2) @27:1
}

