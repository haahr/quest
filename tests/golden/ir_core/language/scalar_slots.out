import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  funs {
    fun print(s: String): Ok {
      let %1: writer.T = member writer.output
      let %2: String = prim <>(s, "\n")
      let %3: Ok = call writer.putString(%1, %2)
      return %3
    }
  }
  funs {
    fun pair [A::TYPE B::TYPE](a: A, b: B): Tuple a: A b: B end {
      let a.1: A = a
      let b.1: B = b
      let %4: Tuple a: A b: B end = tuple(a.1, b.1)
      return %4
    }
  }
  let pairF: All(A :: TYPE B :: TYPE) Fun(a: A b: B): Tuple a: A b: B end = pair
  let p: Tuple a: Bool b: Bool end = call pairF [Bool Bool](true, true)
  let %5: Bool = tuple_field(p, 0)
  let %6: String = call conv.bool(%5)
  let %7: Bool = tuple_field(p, 1)
  let %8: String = call conv.bool(%7)
  let %9: String = prim <>(" ", %8)
  let %10: String = prim <>(%6, %9)
  do call print(%10)
  let q: Tuple a: Char b: Char end = call pairF [Char Char]('x', 'y')
  let %11: Char = tuple_field(q, 0)
  let %12: String = call conv.char(%11)
  let %13: Char = tuple_field(q, 1)
  let %14: String = call conv.char(%13)
  let %15: String = prim <>(" ", %14)
  let %16: String = prim <>(%12, %15)
  do call print(%16)
  let r: Record a: Bool b: Bool c: Char end = record(a = false, b = true, c = 'z')
  let a.2: Bool = false
  let b.2: Bool = true
  let r.1: Record a: Bool b: Bool c: Char end = r
  let t: Tuple var a: Bool b: Bool r: Record a: Bool b: Bool c: Char end end = tuple(a.2, b.2, r.1)
  funs {
    fun flip(var x: Bool): Ok {
      x := true
      return ok
    }
  }
  let %17: Var(Bool) = addr t.#0
  do call flip(%17)
}

