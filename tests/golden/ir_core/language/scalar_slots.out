import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  funs {
    fun print(s: String): Ok {
      let %1: writer.T = member writer.output @5:45
      let %2: String = prim <>(s, "\n") @5:59
      let %3: Ok = call writer.putString(%1, %2) @5:28
      return %3
    }
  }
  funs {
    fun pair [A::TYPE B::TYPE](a: A, b: B): Tuple a: A b: B end {
      let a.1: A = a @6:74
      let b.1: B = b @6:84
      let %4: Tuple a: A b: B end = tuple(a.1, b.1) @6:60
      return %4
    }
  }
  let pairF: All(A :: TYPE B :: TYPE) Fun(a: A b: B): Tuple a: A b: B end = pair @7:65
  let p: Tuple a: Bool b: Bool end = call pairF [Bool Bool](true, true) @8:9
  let %5: Bool = tuple_field(p, 0) @9:17
  let %6: String = call conv.bool(%5) @9:7
  let %7: Bool = tuple_field(p, 1) @9:42
  let %8: String = call conv.bool(%7) @9:32
  let %9: String = prim <>(" ", %8) @9:25
  let %10: String = prim <>(%6, %9) @9:7
  do call print(%10) @9:1
  let q: Tuple a: Char b: Char end = call pairF [Char Char]('x', 'y') @10:9
  let %11: Char = tuple_field(q, 0) @11:17
  let %12: String = call conv.char(%11) @11:7
  let %13: Char = tuple_field(q, 1) @11:42
  let %14: String = call conv.char(%13) @11:32
  let %15: String = prim <>(" ", %14) @11:25
  let %16: String = prim <>(%12, %15) @11:7
  do call print(%16) @11:1
  let r: Record a: Bool b: Bool c: Char end = record(a = false, b = true, c = 'z') @12:9
  let a.2: Bool = false @14:21
  let b.2: Bool = true @14:35
  let r.1: Record a: Bool b: Bool c: Char end = r @14:48
  let t: Tuple var a: Bool b: Bool r: Record a: Bool b: Bool c: Char end end = tuple(a.2, b.2, r.1) @14:3
  funs {
    fun flip(var x: Bool): Ok {
      x := true @15:29
      return ok
    }
  }
  let %17: Var(Bool) = addr t.#0 @16:6
  do call flip(%17) @16:1
}

