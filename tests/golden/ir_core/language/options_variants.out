import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @6:12
  funs {
    fun printInt(x: Int): Ok {
      let %1: String = call conv.int(x) @9:31
      do call writer.putString(wOut, %1) @9:9
      let %2: Ok = call writer.putString(wOut, "\n") @10:9
      return %2
    }
  }
  funs {
    fun printBool(b: Bool): Ok {
      let %3: String = call conv.bool(b) @15:31
      do call writer.putString(wOut, %3) @15:9
      let %4: Ok = call writer.putString(wOut, "\n") @16:9
      return %4
    }
  }
  let c: Traffic = option(yellow) @21:9
  let %5: Bool = is_tag(c, yellow) @22:11
  do call printBool(%5) @22:1
  let %6: Bool = is_tag(c, red) @23:11
  do call printBool(%6) @23:1
  funs {
    fun evalTraffic(t: Traffic): Int {
      join k1(r: Int) {
        return r
      } in {
        switch tag(t) { @27:5
          case red: {
            jump k1(10) @27:5
          }
          case yellow: {
            jump k1(20) @27:5
          }
          case green: {
            jump k1(30) @27:5
          }
          else: {
            jump k1(0) @27:5
          }
        }
      }
    }
  }
  let %7: Int = call evalTraffic(c) @33:10
  do call printInt(%7) @33:1
  let intensity: Int = 42 @42:58
  let %8: Tuple intensity: Int end = tuple(intensity) @42:36
  let c2: Color = option(blue, %8) @42:10
  let unp: Tuple Int intensity: Int end = payload(c2, blue) #2 @43:11
  let %9: Int = tuple_field(unp, 1) @44:10
  do call printInt(%9) @44:1
  let v: Num = variant(int, 123) @48:9
  let %10: Bool = is_tag(v, int) @49:11
  do call printBool(%10) @49:1
  let %11: Bool = is_tag(v, real) @50:11
  do call printBool(%11) @50:1
  let %12: Int = payload(v, int) @51:10
  do call printInt(%12) @51:1
}

