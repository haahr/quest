import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  funs {
    fun swap [F::KOp](p: F(Int)): F(Int) {
      return p
    }
  }
  let first: Int = 1
  let second: Int = 2
  let pair: Tuple first: Int second: Int end = tuple(first, second)
  let synthesized: Tuple Let Pair = Fun(A :: TYPE) Tuple first: A second: A end swap: All(F :: KOp) Fun(p: F(Int)): F(Int) pair: Tuple first: Int second: Int end end = tuple(Let Pair = Fun(A :: TYPE) Tuple first: A second: A end swap, pair)
  let n: Int = 3
  let checked: Tuple Type X :: K n: Int end = tuple(Let X = Int n)
  let radius: Int = 4
  let %1: Tuple radius: Int end = tuple(radius)
  let shape: Shape = option(circle, %1)
  join k1(radius.1: Int) {
    let %2: writer.T = member writer.output
    let %3: Tuple first: Int second: Int end = tuple_field(synthesized, 1)
    let %4: Int = tuple_field(%3, 1)
    let %5: String = call conv.int(%4)
    do call writer.putString(%2, %5)
    let %6: writer.T = member writer.output
    do call writer.putString(%6, " ")
    let %7: writer.T = member writer.output
    let %8: Int = tuple_field(checked, 0)
    let %9: String = call conv.int(%8)
    do call writer.putString(%7, %9)
    let %10: writer.T = member writer.output
    do call writer.putString(%10, " ")
    let %11: writer.T = member writer.output
    let %12: String = call conv.int(radius.1)
    do call writer.putString(%11, %12)
    let %13: writer.T = member writer.output
    do call writer.putString(%13, "\n")
  } in {
    switch tag(shape) {
      case circle (c: Tuple radius: Int end): {
        let %14: Int = tuple_field(c, 0)
        jump k1(%14)
      }
    }
  }
}

