main {
  let e: Ok = ok
  let s: Int = 1
  let p: P = tuple(e, s)
  let n: Int = tuple_field(p, 1)
  let e.1: Ok = tuple_field(p, 0)
  funs {
    fun mk(s.1: Int): P {
      let e.2: Ok = ok
      let s.2: Int = s.1
      let %1: Tuple e: Ok s: Int end = tuple(e.2, s.2)
      return %1
    }
  }
  let %2: P = call mk(5)
  let %3: Int = tuple_field(%2, 1)
  let total: Int = prim +(%3, n)
  let r: R = record(a = ok, b = 7)
  let rb: Int = record_field(r, b)
  let ra: Ok = record_field(r, a)
  let cr: Record var a: Ok end = record(var a = ok)
  funs {
    fun set(): Ok {
      store cr.a := ok
      return ok
    }
  }
  let sr: Ok = call set()
  funs {
    fun count(o: O): Int {
      join k1(r.1: Int) {
        return r.1
      } in {
        switch tag(o) {
          case some (x: Tuple done: Ok count: Int end): {
            let %4: Int = tuple_field(x, 1)
            jump k1(%4)
          }
          case none: {
            jump k1(0)
          }
        }
      }
    }
  }
  let done: Ok = ok
  let count.1: Int = 3
  let %5: Tuple done: Ok count: Int end = tuple(done, count.1)
  let %6: O = option(some, %5)
  let c: Int = call count(%6)
  let %7: O = option(none)
  let d: Int = call count(%7)
  funs {
    fun first [A::TYPE B::TYPE](t: Tuple a: A b: B end): A {
      let %8: A = tuple_field(t, 0)
      return %8
    }
  }
  let a: Ok = ok
  let b: Int = 4
  let %9: Tuple a: Ok b: Int end = tuple(a, b)
  let f: Ok = call first [Ok Int](%9)
  funs {
    fun second [A::TYPE B::TYPE](t.1: Tuple a: A b: B end): B {
      let %10: B = tuple_field(t.1, 1)
      return %10
    }
  }
  let a.1: Ok = ok
  let b.1: Int = 4
  let %11: Tuple a: Ok b: Int end = tuple(a.1, b.1)
  let g: Int = call second [Ok Int](%11)
  let arr: Array(Ok) = array(ok, ok)
  let k: Int = prim extent(arr)
  let t.2: Tuple Ok Int end = tuple(ok, 1)
  let o.1: Ok = ok
  let nested: Tuple t: Tuple Ok Int end o: Ok end = tuple(t.2, o.1)
  let nn: Tuple Ok Int end = tuple_field(nested, 0)
  let wide: Tuple e: Ok end = p
  let ws: Ok = tuple_field(wide, 0)
}

