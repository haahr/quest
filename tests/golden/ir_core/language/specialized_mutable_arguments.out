import string = "string" : StringOp
main {
  funs rec {
    fun count(f: Fun(x: Int): Bool, k: Int, i: Int): Int {
      join k1(r: Int) {
        return r
      } in {
        let %1: Bool = prim >(i, 0) @7:8
        if %1 { @7:5
          join k2(r.1: Int) {
