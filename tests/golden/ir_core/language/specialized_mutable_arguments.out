            loop L1 {
              let j.1: Int = j @15:13
              let %12: Int = prim +(k.1, 1) @15:38
              k.1 := %12 @15:33
              let %13: Bool = prim is(j, n) @15:13
              if %13 { @15:13
                break L1 @15:13
              }
              let %14: Int = prim +(j, 1) @15:13
              j := %14 @15:13
