            let %5: Int = prim +(i, k) @7:25
            let %6: Bool = call f(%5) @7:23
            if %6 { @7:20
              jump k2(1) @7:20
            } else {
              jump k2(0) @7:20
            }
          }
        } else {
          jump k1(0) @7:5
        }
      }
    }
