main {
  let a: Int = 0
  funs {
    fun f(x: A): Int {
      let %1: Int = prim +(x, 1)
      return %1
    }
  }
  let t1: T = tuple(Let A = Int a, f)
  let %2: t1.A = tuple_field(t1, 0)
  let %3: Fun(x: t1.A): Int = tuple_field(t1, 1)
  let %4: t1.A = tuple_field(t1, 0)
  let %5: Int = call %3(%4)
}

