main {
  let k: Int = 2
  let %1: Tuple Let K = Int k: K end = tuple(Let K = Int k)
  let o: O = option(some, %1)
  let %2: Tuple Int Let K = Int k: K end = payload(o, some)
  let %3: Int = tuple_field(%2, 1)
  let k.1: Int = prim +(%3, 1)
  let n: Int = 1
  let %4: Tuple var n: Int end = tuple(n)
  let v: V = option(some, %4)
  let %5: Tuple Int var n: Int end = payload(v, some)
  let %6: Int = tuple_field(%5, 1)
  let n.1: Int = prim +(%6, 1)
  let h: Int = 1
  let t: R = option(nil)
  let %7: Tuple Let X = Int h: X t: R end = tuple(Let X = Int h, t)
  let r: R = option(cons, %7)
  let %8: Tuple Int Let X = Int h: X t: R end = payload(r, cons)
  let %9: Int = tuple_field(%8, 1)
  let h.1: Int = prim +(%9, 1)
  let x: Int = 3
  funs {
    fun get(): A {
      return x
    }
  }
  let %10: Tuple Type A :: TYPE x: A get: Fun(): A end = tuple(Let A = Int x, get)
  let e: E = option(some, %10)
  let isSome: Bool = is_tag(e, some)
}

