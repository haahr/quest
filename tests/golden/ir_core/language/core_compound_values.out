  let %2: Int = record_field(p, y) @6:7
  let %3: Int = prim +(%1, %2) @6:1
  let %4: Record x: Int y: Int end = record(x = 10, y = 20) @7:1
  let %5: Int = record_field(%4, x) @7:1
  let r: Record var count: Int end = record(var count = 0) @8:9
  let %6: Int = record_field(r, count) @9:12
  let %7: Int = prim +(%6, 5) @9:12
  store r.count := %7 @9:1
  let %8: Int = record_field(r, count) @10:12
  let %9: Int = prim *(%8, 3) @10:12
  store r.count := %9 @10:1
  let %10: Int = record_field(r, count) @11:1
  let count: Int = 10 @14:27
  let name: String = "quest" @14:41
