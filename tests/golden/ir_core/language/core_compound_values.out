  let %13: Int = prim +(%12, 5) @17:13
  store mt.#0 := %13 @17:1
  let %14: Int = tuple_field(mt, 0) @18:1
  let intensity: Int = 100 @19:23
  let %15: Tuple intensity: Int end = tuple(intensity) @19:1
  let %16: Int = tuple_field(%15, 0) @19:1
  let x: Int = 0 @22:50
