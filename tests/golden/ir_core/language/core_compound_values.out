  let %23: Int = prim extent(none) @37:1
  funs {
    fun code(c: Color): Int {
      join k1(r.1: Int) {
        return r.1
      } in {
        switch tag(c) { @46:5
          case red: {
            jump k1(1) @46:5
          }
          case green: {
            jump k1(2) @46:5
          }
          case blue (b: Tuple intensity: Int end): {
            let %24: Int = tuple_field(b, 0) @49:57
            jump k1(%24) @46:5
          }
          else: {
            jump k1(0) @46:5
          }
        }
      }
    }
  }
  let c1: Color = option(red) @52:10
  let intensity.1: Int = 100 @53:58
  let %25: Tuple intensity: Int end = tuple(intensity.1) @53:36
  let c2: Color = option(blue, %25) @53:10
  let %26: Int = call code(c1) @54:1
  let %27: Int = call code(c2) @55:1
  let %28: Int = call code(c1) @56:1
  let %29: Int = call code(c2) @56:12
  let %30: Int = prim +(%28, %29) @56:1
  funs {
    fun shade(c.1: Color): Int {
      join k2(r.2: Int) {
        return r.2
      } in {
        switch tag(c.1) { @60:5
          case red: {
            jump k2(1) @60:5
          }
          case green: {
            jump k2(2) @60:5
          }
          case blue (b.1: Tuple intensity: Int end): {
            let %31: Int = tuple_field(b.1, 0) @63:57
