      let %105: Int = tuple_field(t, 1)
      let %106: String = call conv.int(%105)
      let %107: String = prim <>("a component passed as a var argument: ", %106)
      do call print(%107)
      let s3: Tuple x: Record end var n: Int end = s.1
      let %108: Bool = prim is(s3, t)
      let %109: String = call conv.bool(%108)
      let %110: Int = tuple_field(s3, 1)
      let %111: String = call conv.int(%110)
      let %112: String = prim <>(" ", %111)
      let %113: String = prim <>(%109, %112)
      let %114: String = prim <>("upcast again: ", %113)
      do call print(%114)
      let inner: T = t
