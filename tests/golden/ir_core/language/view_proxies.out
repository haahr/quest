      let ns: Tuple inner: S end = nt
      store t.#1 := 45
      let %115: Bool = prim is(ns, nt)
      let %116: String = call conv.bool(%115)
      let %117: S = tuple_field(ns, 0)
      let %118: Bool = prim is(%117, t)
      let %119: String = call conv.bool(%118)
      let %120: S = tuple_field(ns, 0)
      let %121: Int = tuple_field(%120, 1)
      let %122: String = call conv.int(%121)
      let %123: S = tuple_field(ns, 0)
      let %124: Small = tuple_field(%123, 0)
      let %125: Int = record_field(%124, a)
      let %126: String = call conv.int(%125)
      let %127: String = prim <>(" ", %126)
