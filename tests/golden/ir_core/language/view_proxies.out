    let %39: String = call conv.int(%38)
    let %40: O2 = tuple_field(so, 0)
    let %41: Bool = is_tag(%40, b)
    let %42: String = call conv.bool(%41)
    let %43: Bool = prim is(so, to)
    let %44: String = call conv.bool(%43)
    let %45: String = prim <>(" ", %44)
    let %46: String = prim <>(%42, %45)
