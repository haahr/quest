    let o: O1 = option(b, %52)
    let ou: O2 = o
    let %53: Bool = prim is(ou, o)
    let %54: String = call conv.bool(%53)
    let %55: Bool = is_tag(ou, b)
    let %56: String = call conv.bool(%55)
    join k2(r.1: Int) {
      let %57: String = call conv.int(r.1)
      let %58: String = prim <>(" ", %57)
      let %59: String = prim <>(%56, %58)
      let %60: String = prim <>(" ", %59)
      let %61: String = prim <>(%54, %60)
      let %62: String = prim <>("whole option: ", %61)
      do call print(%62)
      let head: S = s.1
      let tail: L(S) = option(nil)
