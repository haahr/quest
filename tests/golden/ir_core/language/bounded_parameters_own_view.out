    }
  }
  let set: All(A <: Small) Fun(b: Boxed v: A): Bool = set0
  let %57: Record a: Int b: Int end = record(a = 30, b = 31)
  let boxed: Boxed = call box [Big](%57)
  let %58: Record a: Int b: Int end = record(a = 32, b = 33)
  let %59: Bool = call set [Big](boxed, %58)
  join k3(r.2: Int) {
    do call printInt(r.2)
    funs {
      fun cell0 [A::<: Small](x.7: A): Cell {
        let y.2: A = x.7
        let a.1: Tuple y: A end = tuple(y.2)
        let %60: Tuple var a: Tuple y: A end end = tuple(a.1)
        let %61: Cell = auto[Tuple y: A end](%60)
        return %61
      }
