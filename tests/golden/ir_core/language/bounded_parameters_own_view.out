      let %39: Int = record_field(%38, a)
      let %40: Int = call bump [A](x.3)
      let %41: Int = prim +(%39, %40)
      return %41
    }
  }
  let viaBound: All(A <: P) Fun(x: A): Int = viaBound0
  let %42: Int = call viaBound [Car](car)
  do call printInt(%42)
  let %43: Int = record_field(car, n)
  do call printInt(%43)
  funs {
    fun pack [B::TYPE](x.4: B): Dynamic {
      let %44: T = call dynamic.new [B](x.4)
      return %44
    }
  }
  funs {
    fun cars0 [A::<: Small](x.5: A): Dynamic {
      let v.1: A = x.5
      let %45: Tuple v: A end = tuple(v.1)
      let %46: Array(Tuple v: A end) = array_rep(1, %45)
      let %47: Dynamic = call pack [Array(Tuple v: A end)](%46)
      return %47
    }
  }
  let carsOf: All(A <: Small) Fun(x: A): Dynamic = cars0
  let %48: Record a: Int b: Int end = record(a = 20, b = 21)
  let d: Dynamic = call carsOf [Big](%48)
  let inDynamic: Array(Tuple v: Big end) = call dynamic.be [Array(Tuple v: Big end)](d)
  let v.2: Record a: Int b: Int end = record(a = 22, b = 23)
  let %49: Tuple v: Big end = tuple(v.2)
  store inDynamic[0] := %49
  let %50: Array(Tuple v: Big end) = call dynamic.be [Array(Tuple v: Big end)](d)
  let %51: Tuple v: Big end = index(%50, 0)
  let %52: Big = tuple_field(%51, 0)
  let %53: Int = record_field(%52, b)
  do call printInt(%53)
  funs {
    fun box0 [A::<: Small](x.6: A): Boxed {
      let y.1: A = x.6
      let a: Tuple var y: A end = tuple(y.1)
      let %54: Tuple a: Tuple var y: A end end = tuple(a)
      let %55: Boxed = auto[Tuple var y: A end](%54)
