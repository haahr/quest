    let cell: All(A <: Small) Fun(x: A): Cell = cell0
    funs {
      fun reset0 [A::<: Small](c: Cell, v.4: A): Ok {
        inspect c {
          case Tuple y: A end exact (t.1: Tuple var a: Tuple y: A end end): {
            let y.3: A = v.4
            let %62: Tuple y: A end = tuple(y.3)
            store t.1.#0 := %62
          }
          else: {
          }
        }
        return ok
      }
    }
    let reset: All(A <: Small) Fun(c: Cell v: A): Ok = reset0
    let %63: Record a: Int b: Int end = record(a = 40, b = 41)
    let c.1: Cell = call cell [Big](%63)
    let %64: Record a: Int b: Int end = record(a = 42, b = 43)
    do call reset [Big](c.1, %64)
    join k4(r.3: Int) {
      do call printInt(r.3)
    } in {
      inspect c.1 {
        case Tuple y: Big end exact (t.2: Tuple var a: Tuple y: Big end end): {
          let %65: Tuple y: Big end = tuple_field(t.2, 0)
          let %66: Big = tuple_field(%65, 0)
          let %67: Int = record_field(%66, b)
          jump k4(%67)
        }
        else: {
          jump k4(0)
        }
      }
    }
  } in {
    inspect boxed {
      case Tuple var y: Big end (t.3: Tuple a: Tuple var y: Big end end): {
        let %68: Tuple var y: Big end = tuple_field(t.3, 0)
        let %69: Big = tuple_field(%68, 0)
        let %70: Int = record_field(%69, b)
