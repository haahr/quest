    }
  }
  let box: All(A <: Small) Fun(x: A): Boxed = box0
  funs {
    fun set0 [A::<: Small](b: Boxed, v.3: A): Bool {
      join k2(r.1: Bool) {
        return r.1
      } in {
        inspect b {
          case Tuple var y: A end (t: Tuple a: Tuple var y: A end end): {
            let %56: Tuple var y: A end = tuple_field(t, 0)
            store %56.#0 := v.3
