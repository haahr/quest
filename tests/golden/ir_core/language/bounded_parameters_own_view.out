      store xs[1] := first
      return ok
    }
  }
  let rotate: All(A <: P) Fun(xs: Array(A)): Ok = rotate0
  let %13: Record a: Int b: Int end = record(a = 7, b = 8)
  let %14: Record fuel: String var n: Int s: Big end = record(fuel = "diesel", var n = 2, s = %13)
  let cars: Array(Car) = array(car, %14)
