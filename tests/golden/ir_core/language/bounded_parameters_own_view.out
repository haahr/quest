  let %15: Car = index(cars, 0)
  let %16: Int = record_field(%15, n)
  do call printInt(%16)
  let %17: Car = index(cars, 0)
  let %18: Big = record_field(%17, s)
  let %19: Int = record_field(%18, b)
  do call printInt(%19)
  funs {
    fun swapIn0 [A::<: P](var x.1: A, y: A): Int {
      let old: A = x.1
      x.1 := y
      let %20: Int = record_field(old, n)
      return %20
    }
  }
  let swapIn: All(A <: P) Fun(var x: A y: A): Int = swapIn0
  var held: Car = car
  let %21: Var(Car) = addr held
  let %22: Car = index(cars, 1)
  let %23: Int = call swapIn [Car](%21, %22)
  do call printInt(%23)
  let %24: Int = record_field(held, n)
  do call printInt(%24)
  funs {
    fun sizeOf0 [A::<: V](v: A): Int {
      join k1(r: Int) {
        return r
      } in {
        switch tag(v) {
          case a (s: Small): {
            let %25: Int = record_field(s, a)
            jump k1(%25)
          }
          case b (n.1: Int): {
            jump k1(n.1)
          }
          case z: {
            jump k1(0)
          }
        }
      }
    }
  }
  let sizeOf: All(A <: V) Fun(v: A): Int = sizeOf0
  let %26: Record a: Int b: Int end = record(a = 3, b = 4)
  let wa: Variant a: Big b: Int end = variant(a, %26)
  let %27: Int = call sizeOf [Variant a: Big b: Int end](wa)
  do call printInt(%27)
  let %28: Variant b: Int z end = variant(b, 9)
  let %29: Int = call sizeOf [Variant b: Int z end](%28)
  do call printInt(%29)
  funs {
    fun pick0 [A::<: V](vs: Array(A), i: Int): Int {
      let %30: A = index(vs, i)
      let %31: Int = call sizeOf [A](%30)
      return %31
    }
  }
  let pick: All(A <: V) Fun(vs: Array(A) i: Int): Int = pick0
  let %32: Variant a: Big b: Int end = variant(b, 11)
  let %33: Array(Variant a: Big b: Int end) = array(wa, %32)
  let %34: Int = call pick [Variant a: Big b: Int end](%33, 1)
  do call printInt(%34)
  funs {
    fun ord0 [A::<: O](o: A): Int {
      let %35: Int = ordinal(o) in (none some)
      return %35
    }
  }
  let ord: All(A <: O) Fun(o: A): Int = ord0
  let x.2: Record a: Int b: Int end = record(a = 12, b = 13)
  let %36: Tuple x: Big end = tuple(x.2)
  let qs: S = option(some, %36)
  let %37: Int = call ord [S](qs)
  do call printInt(%37)
  funs {
    fun viaBound0 [A::<: P](x.3: A): Int {
      let p: P = x.3
