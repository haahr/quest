      return %2
    }
  }
  funs {
    fun bump0 [A::<: P](x: A): Int {
      let %3: Int = record_field(x, n)
      let %4: Int = prim +(%3, 10)
      store x.n := %4
      let %5: Small = record_field(x, s)
      let %6: Int = record_field(%5, a)
      let %7: Int = record_field(x, n)
      let %8: Int = prim +(%6, %7)
