import writer = "writer" : Writer
import conv = "conv" : Conv
import dynamic = "dynamic" : Dynamic
main {
  let wOut: writer.T = member writer.output
  funs {
    fun printInt(x: Int): Ok {
      let %1: String = call conv.int(x)
      do call writer.putString(wOut, %1)
      let %2: Ok = call writer.putString(wOut, "\n")
      return %2
    }
  }
  let empty: IntList = option(nil)
  let head: Int = 1
  let head.1: Int = 2
  let tail: IntList = empty
  let %3: Tuple head: Int tail: IntList end = tuple(head.1, tail)
  let tail.1: IntList = option(cons, %3)
  let %4: Tuple head: Int tail: IntList end = tuple(head, tail.1)
  let l: IntList = option(cons, %4)
  funs rec {
    fun sum(x.1: IntList): Int {
      join k1(r: Int) {
        return r
      } in {
        switch tag(x.1) {
          case cons (c: Tuple head: Int tail: IntList end): {
            let %5: Int = tuple_field(c, 0)
            let %6: IntList = tuple_field(c, 1)
            let %7: Int = call sum(%6)
            let %8: Int = prim +(%5, %7)
            jump k1(%8)
          }
          else: {
            jump k1(0)
          }
        }
      }
    }
  }
  let %9: Int = call sum(l)
  do call printInt(%9)
  funs {
    fun id [A::TYPE](x.2: A): A {
      return x.2
    }
  }
  let %10: IntList = call id [IntList](l)
  let %11: Int = call sum(%10)
  do call printInt(%11)
  let t: IntList = l
  let n: Int = 7
  let h: Holder = tuple(t, n)
  let %12: IntList = tuple_field(h, 0)
  let %13: Int = call sum(%12)
  let %14: Int = tuple_field(h, 1)
  let %15: Int = prim +(%13, %14)
  do call printInt(%15)
  let %16: Tuple Int head: Int tail: IntList end = payload(l, cons)
  let %17: IntList = tuple_field(%16, 2)
  let %18: Tuple Int head: Int tail: IntList end = payload(%17, cons)
  let %19: Int = tuple_field(%18, 1)
  do call printInt(%19)
  join k2(r.1: Int) {
    do call printInt(r.1)
    let %20: T = call dynamic.new [IntList](l)
    let back: IntList = call dynamic.be [IntList](%20)
    let %21: Int = call sum(back)
    do call printInt(%21)
    let %22: Tuple Int head: Int tail: IntList end = payload(back, cons)
    let %23: IntList = tuple_field(%22, 2)
    let %24: Tuple Int head: Int tail: IntList end = payload(%23, cons)
    let %25: Int = tuple_field(%24, 1)
    do call printInt(%25)
    let head.2: Int = 5
    let tail.2: List(Int) = option(nil)
    let %26: Tuple head: Int tail: Rec(L :: TYPE) Option nil cons with Tuple head: Int tail: L end end end = tuple(head.2, tail.2)
    let pl: List(Int) = option(cons, %26)
    let %27: Tuple Int head: Int tail: Rec(L :: TYPE) Option nil cons with Tuple head: Int tail: L end end end = payload(pl, cons)
    let %28: Int = tuple_field(%27, 1)
    do call printInt(%28)
    let %29: T = call dynamic.new [List(Int)](pl)
    let %30: IntList = call dynamic.be [IntList](%29)
    let %31: Int = call sum(%30)
    do call printInt(%31)
    join k3(o: Int) {
      do call printInt(o)
    } in {
      let %32: Exception = member dynamic.error
      try catching (%32) {
        join k4(r.2: Int) {
          jump k3(r.2)
        } in {
          let %33: T = call dynamic.new [IntList](l)
          let %34: Other = call dynamic.be [Other](%33)
          let %35: Bool = is_tag(%34, nil)
          if %35 {
            jump k4(1)
          } else {
            jump k4(0)
          }
        }
      } handle (e: Exception) {
        let %36: Bool = prim is(e, %32)
        if %36 {
          jump k3(-1)
        } else {
          reraise e
        }
      }
    }
  } in {
    let %37: Tuple Int head: Int tail: IntList end = payload(l, cons)
    let %38: IntList = tuple_field(%37, 2)
    let %39: Tuple Int head: Int tail: IntList end = payload(%38, cons)
    let %40: IntList = tuple_field(%39, 2)
    let %41: Bool = is_tag(%40, nil)
    if %41 {
      jump k2(1)
    } else {
      jump k2(0)
    }
  }
}

