    let %22: Tuple Int head: Int tail: IntList end = payload(back, cons) #1 @40:10
    let %23: IntList = tuple_field(%22, 2) @40:10
    let %24: Tuple Int head: Int tail: IntList end = payload(%23, cons) #1 @40:10
    let %25: Int = tuple_field(%24, 1) @40:10
    do call printInt(%25) @40:1
    let head.2: Int = 5 @44:51
    let tail.2: List(Int) = option(nil) @44:53
