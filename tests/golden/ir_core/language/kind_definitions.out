import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  funs {
    fun first [F::KOp](x: F(Int)): F(Int) {
      return x
    }
  }
  let first.1: Int = 1
  let second: Int = 2
  let p: Twice(Int) = tuple(first.1, second)
  let q: Twice(Int) = call first [Twice](p)
  funs {
    fun unbox [G::KLocal](y: G(Num)): G(Num) {
      return y
    }
  }
  let item: Int = 7
  let %1: Tuple item: Num end = tuple(item)
  let local: Box(Num) = call unbox [Box](%1)
  funs {
    fun poly [G::KEscaping](y.1: G(Int)): G(Int) {
      return y.1
    }
  }
  let r: Twice(Int) = call poly [Twice](p)
  let %2: writer.T = member writer.output
  let %3: Int = tuple_field(q, 1)
  let %4: String = call external "quest_conv_int"(%3)
  do call writer.putString(%2, %4)
  let %5: writer.T = member writer.output
  do call writer.putString(%5, " ")
  let %6: writer.T = member writer.output
  let %7: Num = tuple_field(local, 0)
  let %8: String = call external "quest_conv_int"(%7)
  do call writer.putString(%6, %8)
  let %9: writer.T = member writer.output
  do call writer.putString(%9, " ")
  let %10: writer.T = member writer.output
  let %11: Int = tuple_field(r, 0)
  let %12: String = call external "quest_conv_int"(%11)
  do call writer.putString(%10, %12)
  let %13: writer.T = member writer.output
  do call writer.putString(%13, "\n")
}

