main {
  funs {
    fun describe(t: T): String {
      join k1(r: String) {
        return r
      } in {
        switch tag(t) {
          case int (x: Tuple n: Int end): {
            jump k1("int")
          }
          case struct (x.1: Tuple a: Int b: Bool end): {
            join k2(r.1: String) {
              jump k1(r.1)
            } in {
              let %1: Bool = tuple_field(x.1, 1)
              if %1 {
                jump k2("struct")
              } else {
                jump k2("?")
              }
            }
          }
          case union (x.2: Tuple s: String end): {
            let %2: String = tuple_field(x.2, 0)
            jump k1(%2)
          }
          case float (x.3: Tuple r: Real end): {
            jump k1("float")
          }
          case void: {
            jump k1("void")
          }
        }
      }
    }
  }
  let n: Int = 3
  let %3: Tuple n: Int end = tuple(n)
  let i: T = option(int, %3)
