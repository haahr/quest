import conv = "conv" : Conv
import string = "string" : StringOp
import writer = "writer" : Writer
import maybe = "util/maybe" : util/Maybe
main {
  var total: Int = 0 @19:1
  var i: Int = 0 @20:1
  let %1: Bool = prim <=(i, 99999) @20:1
  if %1 { @20:1
    loop L1 {
      let i.1: Int = i @20:1
      let x: String = "alpha" @21:27
      let y: String = "beta" @21:43
      let t: Tuple x: String y: String end = tuple(x, y) @21:13
      let r: Pair = record(first = "gamma", second = "delta") @22:19
      let a: Array(String) = array("epsilon", "zeta") @26:13
      let o: maybe.T(String) = call maybe.some [String]("eta") @27:13
      funs {
        fun f(): String {
          let %2: String = tuple_field(t, 0) @28:38
          let %3: String = prim <>("theta", %2) @28:27
          return %3
        }
      }
      let %4: String = tuple_field(t, 1) @29:36
      let %5: Int = call string.length(%4) @29:22
      let %6: String = record_field(r, second) @29:57
      let %7: Int = call string.length(%6) @29:43
      let %8: String = index(a, 1) @29:83
      let %9: Int = call string.length(%8) @29:69
      let %10: String = call maybe.unwrap [String](o) @30:25
      let %11: Int = call string.length(%10) @30:11
      let %12: String = call f() @30:66
      let %13: Int = call string.length(%12) @30:52
      let %14: Int = prim +(%11, %13) @30:11
      let %15: Int = prim +(%9, %14) @29:69
      let %16: Int = prim +(%7, %15) @29:43
      let %17: Int = prim +(%5, %16) @29:22
      let %18: Int = prim +(total, %17) @29:14
      total := %18 @29:5
      let %19: Bool = prim is(i, 99999) @20:1
      if %19 { @20:1
        break L1 @20:1
      }
      let %20: Int = prim +(i, 1) @20:1
      i := %20 @20:1
    }
  }
  let %21: writer.T = member writer.output @32:18
  let %22: String = call conv.int(total) @32:32
  let %23: String = prim <>(%22, "\n") @32:32
  do call writer.putString(%21, %23) @32:1
}

