import writer = "writer" : Writer
import conv = "conv" : Conv
import string = "string" : StringOp
import maybe = "util/maybe" : util/Maybe
main {
  var total: Int = 0 @18:1
  var i: Int = 0 @19:1
  let %1: Bool = prim <=(i, 99999) @19:1
  if %1 { @19:1
    loop L1 {
      let i.1: Int = i @19:1
      let x: String = "alpha" @20:27
      let y: String = "beta" @20:43
      let t: Tuple x: String y: String end = tuple(x, y) @20:13
      let r: Pair = record(first = "gamma", second = "delta") @21:19
      let a: Array(String) = array("epsilon", "zeta") @25:13
      let o: maybe.T(String) = call maybe.some [String]("eta") @26:13
      funs {
        fun f(): String {
          let %2: String = tuple_field(t, 0) @27:38
          let %3: String = prim <>("theta", %2) @27:27
          return %3
        }
      }
      let %4: String = tuple_field(t, 1) @28:36
      let %5: Int = call string.length(%4) @28:22
      let %6: String = record_field(r, second) @28:57
      let %7: Int = call string.length(%6) @28:43
      let %8: String = index(a, 1) @28:83
      let %9: Int = call string.length(%8) @28:69
      let %10: String = call maybe.unwrap [String](o) @29:25
      let %11: Int = call string.length(%10) @29:11
      let %12: String = call f() @29:66
      let %13: Int = call string.length(%12) @29:52
      let %14: Int = prim +(%11, %13) @29:11
      let %15: Int = prim +(%9, %14) @28:69
      let %16: Int = prim +(%7, %15) @28:43
      let %17: Int = prim +(%5, %16) @28:22
      let %18: Int = prim +(total, %17) @28:14
      total := %18 @28:5
      let %19: Bool = prim is(i, 99999) @19:1
      if %19 { @19:1
        break L1 @19:1
      }
      let %20: Int = prim +(i, 1) @19:1
      i := %20 @19:1
    }
  }
  let %21: writer.T = member writer.output @31:18
  let %22: String = call conv.int(total) @31:32
  let %23: String = prim <>(%22, "\n") @31:32
  do call writer.putString(%21, %23) @31:1
}

