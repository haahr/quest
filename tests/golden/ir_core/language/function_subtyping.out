import writer = "writer" : Writer
import conv = "conv" : Conv
import dynamic = "dynamic" : Dynamic
main {
  funs {
    fun p(n: Int): Ok {
      let %1: writer.T = member writer.output
      let %2: String = call conv.int(n)
      let %3: String = prim <>(%2, "\n")
      let %4: Ok = call writer.putString(%1, %3)
      return %4
    }
  }
  let big: Big = record(a = 1, b = 2, c = 3)
  funs {
    fun small(x: Small): Int {
      let %5: Int = record_field(x, c)
      return %5
    }
  }
  funs {
    fun useBig(h: Fun(x: Big): Int): Int {
      let %6: Int = call h(big)
      return %6
    }
  }
  let %7: Int = call useBig(small)
  do call p(%7)
  funs {
    fun makeBig(): Big {
      return big
    }
  }
  funs {
    fun useSmall(h.1: Fun(): Small): Int {
      let %8: Small = call h.1()
      let %9: Int = record_field(%8, c)
      return %9
    }
  }
  let %10: Int = call useSmall(makeBig)
  do call p(%10)
  funs {
    fun narrow(x.1: Small): Big {
      let %11: Int = record_field(x.1, c)
      let %12: Record a: Int b: Int c: Int end = record(a = 10, b = 20, c = %11)
      return %12
    }
  }
  let wide: Fun(x: Big): Small = narrow
  let %13: Small = call wide(big)
  let %14: Int = record_field(%13, c)
  do call p(%14)
  funs {
    fun applyBig(h.2: Fun(x: Big): Int): Int {
      let %15: Int = call h.2(big)
      return %15
    }
  }
  let applySmall: Fun(h: Fun(x: Small): Int): Int = applyBig
  let %16: Int = call applySmall(small)
  do call p(%16)
  let hasNarrow: HasNarrow = record(f = narrow)
  let hasWide: HasWide = hasNarrow
  let %17: Fun(x: Big): Small = record_field(hasWide, f)
  let %18: Small = call %17(big)
  let %19: Int = record_field(%18, c)
  do call p(%19)
  let d: T = call dynamic.new [Fun(x: Small): Big](narrow)
  let fromDynamic: Fun(x: Big): Small = call dynamic.be [Fun(x: Big): Small](d)
  let %20: Small = call fromDynamic(big)
  let %21: Int = record_field(%20, c)
  do call p(%21)
  join k1(r: Int) {
    do call p(r)
    let a: Fun(x: Small): Big = narrow
    let %22: Tuple a: Fun(x: Small): Big end = tuple(a)
    let boxedNarrow: Boxed = auto[Fun(x: Small): Big](%22)
    join k2(r.1: Int) {
      do call p(r.1)
      join k3(wrong: Int) {
        do call p(wrong)
      } in {
        try {
          funs {
            fun f(x.2: Big): Int {
              let %23: Int = record_field(x.2, a)
              return %23
            }
          }
          let %24: T = call dynamic.new [Fun(x: Big): Int](f)
          let g: Fun(x: Small): Int = call dynamic.be [Fun(x: Small): Int](%24)
          let %25: Record c: Int end = record(c = 0)
          let %26: Int = call g(%25)
          jump k3(%26)
        } handle (e: Exception) {
          let %27: Exception = member dynamic.error
          let %28: Bool = prim is(e, %27)
          if %28 {
            let %29: Int = prim -(0, 1)
            jump k3(%29)
          } else {
            raise e
          }
        }
      }
    } in {
      inspect boxedNarrow {
        case Fun(x: Big): Small (g.1: Tuple a: Fun(x: Big): Small end): {
          let %30: Fun(x: Big): Small = tuple_field(g.1, 0)
          let %31: Small = call %30(big)
          let %32: Int = record_field(%31, c)
          jump k2(%32)
        }
        else: {
          jump k2(0)
        }
      }
    }
  } in {
    inspect d {
      case Fun(x: Big): Small (g.2: Tuple a: Fun(x: Big): Small end): {
        let %33: Fun(x: Big): Small = tuple_field(g.2, 0)
        let %34: Small = call %33(big)
        let %35: Int = record_field(%34, c)
        jump k1(%35)
      }
      else: {
        jump k1(0)
      }
    }
  }
}

