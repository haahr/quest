                } in {
                  try catching (Inner) {
                    raise inner with x.1 @39:13
                  } handle (e.1: Exception) {
                    let %3: Bool = prim is(e.1, Inner) @39:9
                    if %3 { @39:9
                      let n: Int = exception_payload(e.1) @39:9
                      let %4: Int = prim *(n, 100) @39:66
