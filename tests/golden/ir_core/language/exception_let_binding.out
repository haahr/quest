    } handle (e.6: Exception) {
      let %13: Bool = prim is(e.6, Boom) @19:10
      if %13 { @19:10
        let n.4: Int = exception_payload(e.6) @19:10
        let %14: Int = prim +(n.4, 1) @19:58
