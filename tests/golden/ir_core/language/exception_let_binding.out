            reraise e.4 @21:10
          }
        }
      }
    } in {
      try catching (Boom) {
        raise e with 8 @20:14
      } handle (e.5: Exception) {
        let %11: Bool = prim is(e.5, Boom) @20:10
        if %11 { @20:10
          let n.3: Int = exception_payload(e.5) @20:10
          let %12: Int = prim +(n.3, 2) @20:55
          jump k2(%12) @20:10
        } else {
          reraise e.5 @20:10
        }
