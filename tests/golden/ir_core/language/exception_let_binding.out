import writer = "writer" : Writer
import conv = "conv" : Conv
import dynamic = "dynamic" : Dynamic
main {
  let wOut: writer.T = member writer.output
  funs {
    fun printInt(x: Int): Ok {
      let %1: String = call conv.int(x)
      do call writer.putString(wOut, %1)
      let %2: Ok = call writer.putString(wOut, "\n")
      return %2
    }
  }
  let Boom: Exception(Int) = exception Boom: Int
  let e: Exception(Int) = Boom
  let d1: T = call dynamic.new [Exception(Int)](Boom)
  let d2: T = call dynamic.new [Exception(Int)](e)
  join k1(r: Int) {
    do call printInt(r)
    join k2(r.1: Int) {
      do call printInt(r.1)
      join k3(r.2: Int) {
        do call printInt(r.2)
        declare Quiet: Exception
        let Quiet: Exception = exception Quiet
        let d3: T = call dynamic.new [Exception](Quiet)
        join k4(r.3: Int) {
          do call printInt(r.3)
          let Local: Exception(Int) = exception Local: Int
          let local: Exception(Int) = Local
          join k5(r4: Int) {
            do call printInt(r4)
            funs {
              fun f(x.1: Int): Int {
                let Inner: Exception(Int) = exception Inner: Int
                let inner: Exception(Int) = Inner
                join k6(r.4: Int) {
                  return r.4
                } in {
                  try {
                    raise inner with x.1
                  } handle (e.1: Exception) {
                    let %3: Bool = prim is(e.1, Inner)
                    if %3 {
                      let n: Int = exception_payload(e.1)
                      let %4: Int = prim *(n, 100)
                      jump k6(%4)
                    } else {
                      reraise e.1
                    }
                  }
                }
              }
            }
            let %5: Int = call f(3)
            do call printInt(%5)
          } in {
            try {
              raise Local with 5
            } handle (e.2: Exception) {
              let %6: Bool = prim is(e.2, local)
              if %6 {
                let n.1: Int = exception_payload(e.2)
                let %7: Int = prim *(n.1, 10)
                jump k5(%7)
              } else {
                reraise e.2
              }
            }
          }
        } in {
          try {
            raise Quiet
          } handle (e.3: Exception) {
            let %8: Bool = prim is(e.3, Quiet)
            if %8 {
              jump k4(42)
            } else {
              reraise e.3
            }
          }
        }
      } in {
        try {
          raise Boom with 9
        } handle (e.4: Exception) {
          let %9: Bool = prim is(e.4, e)
          if %9 {
            let n.2: Int = exception_payload(e.4)
            let %10: Int = prim +(n.2, 3)
            jump k3(%10)
          } else {
            reraise e.4
          }
        }
      }
    } in {
      try {
        raise e with 8
      } handle (e.5: Exception) {
        let %11: Bool = prim is(e.5, Boom)
        if %11 {
          let n.3: Int = exception_payload(e.5)
          let %12: Int = prim +(n.3, 2)
          jump k2(%12)
        } else {
          reraise e.5
        }
      }
    }
  } in {
    try {
      raise Boom with 7
    } handle (e.6: Exception) {
      let %13: Bool = prim is(e.6, Boom)
      if %13 {
        let n.4: Int = exception_payload(e.6)
        let %14: Int = prim +(n.4, 1)
        jump k1(%14)
      } else {
        reraise e.6
      }
    }
  }
}

