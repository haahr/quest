    }
    join k5(r.4: String) {
      let %38: Int = index(marks, 0) @31:17
      let %39: String = call conv.int(%38) @31:8
      let %40: Int = tuple_field(stores, 0) @31:46
      let %41: String = call conv.int(%40) @31:37
      let %42: String = prim <>(" ", %41) @31:30
      let %43: String = prim <>(%39, %42) @31:8
      let %44: String = prim <>(" ", %43) @30:99
      let %45: String = prim <>(r.4, %44) @30:28
      let %46: String = prim <>("after a store: ", %45) @30:7
      do call print(%46) @30:1
      let q: Int = 0 @33:34
      let quotient: Tuple var q: Int end = tuple(q) @33:16
      funs rec {
