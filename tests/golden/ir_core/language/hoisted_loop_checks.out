  let %26: Int = call chars(3, 65, 0) @21:30
  let %27: String = call conv.int(%26) @21:21
  let %28: String = prim <>("passes: ", %27) @21:7
  do call print(%28) @21:1
  join k3(r.2: String) {
    let %29: String = prim <>("raises: ", r.2) @22:7
    do call print(%29) @22:1
    let n.1: Int = 0 @24:32
    let stores: Tuple var n: Int end = tuple(n.1) @24:14
    let marks: Array(Int) = array_rep(4, 0) @25:13
    funs rec {
      fun marked(i.1: Int, code.1: Int): Int {
        join k4(r.3: Int) {
          return r.3
        } in {
          let %30: Bool = prim >=(i.1, 4) @27:8
          if %30 { @27:5
            jump k4(0) @27:5
          } else {
            store marks[i.1] := 1 @28:16
            let %31: Int = tuple_field(stores, 0) @28:42
            let %32: Int = prim +(%31, 1) @28:42
            store stores.#0 := %32 @28:30
            let %33: Char = call ascii.char(code.1) @28:65
            let %34: Int = call ascii.val(%33) @28:55
            let %35: Int = prim +(i.1, 1) @28:92
            let %36: Int = call marked(%35, code.1) @28:85
            let %37: Int = prim +(%34, %36) @28:55
            jump k4(%37) @27:5
