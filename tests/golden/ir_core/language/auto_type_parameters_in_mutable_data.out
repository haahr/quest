import writer = "writer" : Writer
import conv = "conv" : Conv
import dynamic = "dynamic" : Dynamic
main {
  let wOut: writer.T = member writer.output @10:12
  funs {
    fun printInt(n: Int): Ok {
      let %1: String = call conv.int(n) @13:31
      do call writer.putString(wOut, %1) @13:9
      let %2: Ok = call writer.putString(wOut, "\n") @14:9
      return %2
    }
  }
  funs {
    fun pack [A::TYPE](x: A): Dynamic {
      let %3: Array(A) = array_rep(1, x) @18:56
      let %4: T = call dynamic.new [Array(A)](%3) @18:34
      return %4
    }
  }
  let a: Int = 1 @19:46
  let b: Bool = true @19:48
  let %5: Tuple a: Int b: Bool end = tuple(a, b) @19:40
  let d: Dynamic = call pack [Tuple a: Int b: Bool end](%5) @19:9
  let arr: Array(Tuple a: Int b: Bool end) = call dynamic.be [Array(Tuple a: Int b: Bool end)](d) @20:11
  let a.1: Int = 5 @21:17
  let b.1: Bool = false @21:19
  let %6: Tuple a: Int b: Bool end = tuple(a.1, b.1) @21:11
  store arr[0] := %6 @21:1
  let %7: Array(Tuple a: Int b: Bool end) = call dynamic.be [Array(Tuple a: Int b: Bool end)](d) @22:10
  let %8: Tuple a: Int b: Bool end = index(%7, 0) @22:10
  let %9: Int = tuple_field(%8, 0) @22:10
  do call printInt(%9) @22:1
  funs {
    fun box [A::TYPE](x.1: A): Boxed {
      let y: A = x.1 @26:78
      let a.2: Tuple var y: A end = tuple(y) @26:60
      let %10: Tuple a: Tuple var y: A end end = tuple(a.2) @26:55
      let %11: Boxed = auto[Tuple var y: A end](%10) @26:30
      return %11
    }
  }
  funs {
    fun set [A::TYPE](b.2: Boxed, v: A): Bool {
      join k1(r: Bool) {
        return r
      } in {
        inspect b.2 { @28:5
          case Tuple var y: A end (t: Tuple a: Tuple var y: A end end): {
            let %12: Tuple var y: A end = tuple_field(t, 0) @29:47
            store %12.#0 := v @29:47
            jump k1(true) @28:5
          }
          else: {
            jump k1(false) @28:5
          }
        }
      }
    }
  }
  funs {
    fun get(b.3: Boxed): Int {
      join k2(r.1: Int) {
        return r.1
      } in {
        inspect b.3 { @33:5
          case Tuple var y: Int end (t.1: Tuple a: Tuple var y: Int end end): {
            let %13: Tuple var y: Int end = tuple_field(t.1, 0) @33:53
            let %14: Int = tuple_field(%13, 0) @33:53
            jump k2(%14) @33:5
          }
          else: {
            jump k2(0) @33:5
          }
        }
      }
    }
  }
  let b.4: Boxed = call box [Int](3) @34:9
  let %15: Bool = call set [Int](b.4, 7) @35:1
  let %16: Int = call get(b.4) @36:10
  do call printInt(%16) @36:1
  funs {
    fun cell [A::TYPE](x.2: A): Cell {
      let y.1: A = x.2 @40:74
      let a.3: Tuple y: A end = tuple(y.1) @40:68
      let %17: Tuple var a: Tuple y: A end end = tuple(a.3) @40:51
      let %18: Cell = auto[Tuple y: A end](%17) @40:30
      return %18
    }
  }
  funs {
    fun reset [A::TYPE](c: Cell, v.1: A): Ok {
      inspect c { @42:5
        case Tuple y: A end exact (t.2: Tuple var a: Tuple y: A end end): {
          let y.2: A = v.1 @42:60
          let %19: Tuple y: A end = tuple(y.2) @42:54
          store t.2.#0 := %19 @42:47
        }
        else: {
        }
      }
      return ok
    }
  }
  let c.1: Cell = call cell [Int](3) @43:9
  do call reset [Int](c.1, 9) @44:1
  join k3(r.2: Int) {
    do call printInt(r.2) @45:1
  } in {
    inspect c.1 { @45:10
      case Tuple y: Int end exact (v.2: Tuple var a: Tuple y: Int end end): {
        let %20: Tuple y: Int end = tuple_field(v.2, 0) @45:54
        let %21: Int = tuple_field(%20, 0) @45:54
        jump k3(%21) @45:10
      }
      else: {
        jump k3(0) @45:10
      }
    }
  }
}

