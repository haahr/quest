main {
  let a: Int = prim +(10, 20)
  let prefixMul: Int = prim *(a, 3)
  let plus: Fun(a: Int b: Int): Int = builtin +
  let b: Int = call plus(1, 2)
  funs {
    fun apply(op: Fun(x: Int y: Int): Int, x: Int, y: Int): Int {
      let %1: Int = call op(x, y)
      return %1
    }
  }
  let applyPlus: Int = call apply(plus, 15, 25)
  let less: Fun(a: Int b: Int): Bool = builtin <
  let lessRes: Bool = call less(10, 20)
  funs {
    fun <+>(x.1: Int, y.1: Int): Int {
      let %2: Int = prim +(y.1, 100)
      let %3: Int = prim +(x.1, %2)
      return %3
    }
  }
  let customRes: Int = call <+>(10, 20)
  let fst: Int = 42
  let snd: String = "hello"
  let p: PairIntStr = tuple(fst, snd)
  let pFst: Int = tuple_field(p, 0)
  let pAnon: Tuple Int String end = tuple(42, "hello")
  funs {
    fun f(o: Int): Ok {
      return ok
    }
  }
  funs {
    fun g(x.2: Int, out y.2: Int): Ok {
      return ok
    }
  }
  funs {
    fun double(fn: Fun(x: Int): Int): Fun(x: Int): Int {
      funs {
        fun f.1(x.3: Int): Int {
          let %4: Int = call fn(x.3)
          let %5: Int = call fn(%4)
          return %5
        }
      }
      return f.1
    }
  }
  funs {
    fun inc(x.4: Int): Int {
      let %6: Int = prim +(x.4, 1)
      return %6
    }
  }
  let %7: Fun(x: Int): Int = call double(inc)
  let curriedRes: Int = call %7(5)
  let %8: Bool = prim is(a, 30)
  let %9: Bool = prim is(prefixMul, 90)
  let %10: Bool = prim is(b, 3)
  let %11: Bool = prim is(applyPlus, 40)
  let %12: Bool = prim is(customRes, 130)
  let %13: Bool = prim is(pFst, 42)
  let %14: Bool = prim is(curriedRes, 7)
  let %15: Bool = prim /\(%13, %14)
  let %16: Bool = prim /\(%12, %15)
  let %17: Bool = prim /\(lessRes, %16)
  let %18: Bool = prim /\(%11, %17)
  let %19: Bool = prim /\(%10, %18)
  let %20: Bool = prim /\(%9, %19)
  let allPassed: Bool = prim /\(%8, %20)
}

