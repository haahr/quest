import string = "string" : StringOp
main {
  let %1: Int = call external "quest_string_length"("\u0001a")
  let %2: Int = call external "quest_string_length"("\u00017")
  let %3: Int = call external "quest_string_length"("\u001f\u007fz\u00ff0")
  let %4: Char = call external "quest_string_get_char"("\u0001a", 1)
  let %5: Char = call external "quest_string_get_char"("\u00017", 1)
}

