          let %18: Bool = prim is(n, 0) @31:8
          if %18 { @31:5
            jump k4(0) @31:5
          } else {
            let %19: vector.T(Int) = call vector.map [Int Int](v, addSome) @33:52
            let %20: vector.T(Int) = call vector.map [Int Int](%19, shift) @33:31
            let %21: Int = call vector.fold [Int Int](%20, 0, combine) @33:9
