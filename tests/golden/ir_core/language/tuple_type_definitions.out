main {
  let k: Int = 2
  let tt: T = tuple(Let K = Int k)
  let tk: Int = tuple_field(tt, 0)
  let %1: Int = prim +(tk, 1)
  funs {
    fun mk(): T {
      return tt
    }
  }
  let %2: T = call mk()
  let mkK: Int = tuple_field(%2, 0)
  funs {
    fun getK(t: T): Int {
      let %3: Int = tuple_field(t, 0)
      return %3
    }
  }
  let k.1: Int = 3
  let u: T = tuple(Let K = Int k.1)
  let viaBlock: Int = tuple_field(u, 0)
}

