module pair : Pair {
  funs {
    fun first [A::TYPE](x: A, y: A): A {
      return x
    }
  }
  funs {
    fun empty [A::TYPE](): Tuple items: Array(A) end {
      let items: Array(A) = array()
      let %1: Tuple items: Array(A) end = tuple(items)
      return %1
    }
  }
  let pair_record: Record first: All(A :: TYPE) Fun(x: A y: A): A empty: All(A :: TYPE) Tuple items: Array(A) end end = record(first = first, empty = empty)
  export first = first, empty = empty
  record pair_record
}
main {
  let firstInt: Fun(x: Int y: Int): Int = type_app pair.first [Int]
  let %2: Int = call firstInt(3, 4)
  let firstString: Fun(x: String y: String): String = type_app pair.first [String]
  let %3: String = call firstString("a", "b")
  let %4: Tuple items: Array(Real) end = type_app pair.empty [Real]
  let %5: Array(Real) = tuple_field(%4, 0)
  let %6: Int = prim extent(%5)
}

