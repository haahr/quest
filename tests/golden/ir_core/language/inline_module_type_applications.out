module pair : Pair {
  funs {
    fun first [A::TYPE](x: A, y: A): A {
      return x
    }
  }
  funs {
    fun empty [A::TYPE](): Tuple items: Array(A) end {
      let items: Array(A) = array() @12:71
      let %1: Tuple items: Array(A) end = tuple(items) @12:53
      return %1
    }
  }
  let pair_record: Record first: All(A :: TYPE) Fun(x: A y: A): A empty: All(A :: TYPE) Tuple items: Array(A) end end = record(first = first, empty = empty)
  export first = first, empty = empty
  record pair_record
}
main {
  let firstInt: Fun(x: Int y: Int): Int = type_app pair.first [Int] @15:16
  let %2: Int = call firstInt(3, 4) @16:1
  let firstString: Fun(x: String y: String): String = type_app pair.first [String] @17:19
  let %3: String = call firstString("a", "b") @18:1
  let %4: Tuple items: Array(Real) end = type_app pair.empty [Real] @19:8
  let %5: Array(Real) = tuple_field(%4, 0) @19:8
  let %6: Int = prim extent(%5) @19:1
}

