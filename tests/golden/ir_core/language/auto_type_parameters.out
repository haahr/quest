import writer = "writer" : Writer
import conv = "conv" : Conv
import dynamic = "dynamic" : Dynamic
main {
  funs {
    fun p(n: Int): Ok {
      let %1: writer.T = member writer.output
      let %2: String = call conv.int(n)
      let %3: String = prim <>(%2, "\n")
      let %4: Ok = call writer.putString(%1, %3)
      return %4
    }
  }
  funs {
    fun s(text: String): Ok {
      let %5: writer.T = member writer.output
      let %6: String = prim <>(text, "\n")
      let %7: Ok = call writer.putString(%5, %6)
      return %7
    }
  }
  let myCar: Car = record(age = 3, fuel = "diesel")
  funs {
    fun box [A::TYPE](x: A): Boxed {
      let a: A = x
      let %8: Tuple a: A end = tuple(a)
      let %9: Boxed = auto[A](%8)
      return %9
    }
  }
  let boxedInt: Boxed = call box [Int](42)
  let boxedCar: Boxed = call box [Car](myCar)
  join k1(r: Int) {
    do call p(r)
    join k2(r.1: String) {
      do call s(r.1)
      funs {
        fun unbox [A::TYPE](b: Boxed, default: A): A {
          join k3(r.2: A) {
            return r.2
          } in {
            inspect b {
              case A (x.1: Tuple a: A end): {
                let %10: A = tuple_field(x.1, 0)
                jump k3(%10)
              }
              else: {
                jump k3(default)
              }
            }
          }
        }
      }
      let %11: Int = call unbox [Int](boxedInt, 0)
      do call p(%11)
      let %12: Int = prim -(0, 1)
      let %13: Int = call unbox [Int](boxedCar, %12)
      do call p(%13)
      let %14: Record age: Int end = record(age = 0)
      let %15: Object = call unbox [Object](boxedCar, %14)
      let %16: Int = record_field(%15, age)
      do call p(%16)
      funs {
        fun boxTwice [B::TYPE](y: B): Tuple first: Boxed second: Boxed end {
          let first: Boxed = call box [B](y)
          let second: Boxed = call box [B](y)
          let %17: Tuple first: Boxed second: Boxed end = tuple(first, second)
          return %17
        }
      }
      let twice: Tuple first: Boxed second: Boxed end = call boxTwice [String]("twice")
      join k4(r.3: String) {
        do call s(r.3)
        funs {
          fun pack [A::TYPE](x.2: A): Dynamic {
            let %18: T = call dynamic.new [A](x.2)
            return %18
          }
        }
        let %19: Dynamic = call pack [Int](7)
        let %20: Int = call dynamic.be [Int](%19)
        do call p(%20)
        join k5(r.4: Int) {
          do call p(r.4)
          funs {
            fun showable [A::TYPE](x.3: A, f: Fun(_: A): String): Showable {
              let x.4: A = x.3
              let show: Fun(_: A): String = f
              let %21: Tuple x: A show: Fun(_: A): String end = tuple(x.4, show)
              let %22: Showable = auto[A](%21)
              return %22
            }
          }
          funs {
            fun f.1(n.1: Int): String {
              let %23: Int = prim *(n.1, 10)
              let %24: String = call conv.int(%23)
              return %24
            }
          }
          let showInt: Showable = call showable [Int](5, f.1)
          join k6(r.5: String) {
            do call s(r.5)
          } in {
            inspect showInt {
              case Int exact (i: Tuple x: Int show: Fun(_: Int): String end): {
                let %25: Fun(_: Int): String = tuple_field(i, 1)
                let %26: Int = tuple_field(i, 0)
                let %27: String = call %25(%26)
                jump k6(%27)
              }
              else: {
                jump k6("?")
              }
            }
          }
        } in {
          let %28: Dynamic = call pack [Car](myCar)
          inspect %28 {
            case Object (o: Tuple a: Object end): {
              let %29: Object = tuple_field(o, 0)
              let %30: Int = record_field(%29, age)
              jump k5(%30)
            }
            else: {
              jump k5(0)
            }
          }
        }
      } in {
        let %31: Boxed = tuple_field(twice, 1)
        inspect %31 {
          case String (t: Tuple a: String end): {
            let %32: String = tuple_field(t, 0)
            jump k4(%32)
          }
          else: {
            jump k4("?")
          }
        }
      }
    } in {
      inspect boxedCar {
        case Car (c: Tuple a: Car end): {
          let %33: Car = tuple_field(c, 0)
          let %34: String = record_field(%33, fuel)
          jump k2(%34)
        }
        else: {
          jump k2("?")
        }
      }
    }
  } in {
    inspect boxedInt {
      case Int (i.1: Tuple a: Int end): {
        let %35: Int = tuple_field(i.1, 0)
        jump k1(%35)
      }
      else: {
        jump k1(0)
      }
    }
  }
}

