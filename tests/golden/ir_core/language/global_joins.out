import writer = "writer" : Writer
import conv = "conv" : Conv
import ascii = "ascii" : Ascii
import string = "string" : StringOp
import maybe = "util/maybe" : util/Maybe
main {
  let n: Int = call string.length("abc") @10:9
  join k1(size: String) {
    join k3(char: Char) {
      join k4(r: maybe.T(Int)) {
        let found: Int = call maybe.unwrapOr [Int](r, 0) @13:13
        join k5(r.1: Int) {
          var count: Int = r.1 @14:1
          funs {
            fun show(): String {
              let %1: String = call conv.char(char) @16:37
              let %2: String = call conv.int(found) @16:63
              let %3: String = prim <>(" ", %2) @16:56
              let %4: String = prim <>(%1, %3) @16:37
              let %5: String = prim <>(" ", %4) @16:30
              let %6: String = prim <>(size, %5) @16:22
              return %6
            }
          }
          let %7: writer.T = member writer.output @18:18
          let %8: String = call show() @18:32
          let %9: String = call conv.int(count) @18:49
          let %10: String = prim <>(%9, "\n") @18:49
          let %11: String = prim <>(" ", %10) @18:42
          let %12: String = prim <>(%8, %11) @18:32
          do call writer.putString(%7, %12) @18:1
          let %13: Int = prim +(count, 1) @19:10
          count := %13 @19:1
          let %14: writer.T = member writer.output @20:18
          let %15: String = call show() @20:32
          let %16: String = call conv.int(count) @20:49
          let %17: String = prim <>(%16, "\n") @20:49
          let %18: String = prim <>(" ", %17) @20:42
          let %19: String = prim <>(%15, %18) @20:32
          do call writer.putString(%14, %19) @20:1
        } in {
          let %20: Bool = prim >(n, 2) @14:20
          if %20 { @14:17
            jump k5(10) @14:17
          } else {
            jump k5(20) @14:17
          }
        }
      } in {
        let %21: Bool = prim >(n, 2) @13:36
        if %21 { @13:33
          let %22: maybe.T(Int) = call maybe.some [Int](n) @13:47
          jump k4(%22) @13:33
        } else {
          let %23: maybe.T(Int) = type_app maybe.none [Int] @13:71
          jump k4(%23) @13:33
        }
      }
    } in {
      let %24: Exception = member ascii.error @12:41
      try catching (%24) {
        let %25: Int = prim *(n, 100) @12:27
        let %26: Char = call ascii.char(%25) @12:16
        jump k3(%26) @12:12
      } handle (e: Exception) {
        let %27: Bool = prim is(e, %24) @12:12
        if %27 { @12:12
          jump k3('?') @12:12
        } else {
          reraise e @12:12
        }
      }
    }
  } in {
    let %28: Bool = prim >(n, 2) @11:15
    if %28 { @11:12
      jump k1("big") @11:12
    } else {
      join k2(r.2: String) {
        jump k1(r.2) @11:12
      } in {
        let %29: Bool = prim >(n, 1) @11:38
        if %29 { @11:38
          jump k2("middling") @11:38
        } else {
          jump k2("small") @11:38
        }
      }
    }
  }
}

