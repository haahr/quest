import writer = "writer" : Writer
import conv = "conv" : Conv
import ascii = "ascii" : Ascii
import string = "string" : StringOp
import maybe = "util/maybe" : util/Maybe
main {
  let n: Int = call string.length("abc")
  join k1(size: String) {
    join k3(char: Char) {
      join k4(r: maybe.T(Int)) {
        let found: Int = call maybe.unwrapOr [Int](r, 0)
        join k5(r.1: Int) {
          var count: Int = r.1
          funs {
            fun show(): String {
              let %1: String = call conv.char(char)
              let %2: String = call conv.int(found)
              let %3: String = prim <>(" ", %2)
              let %4: String = prim <>(%1, %3)
              let %5: String = prim <>(" ", %4)
              let %6: String = prim <>(size, %5)
              return %6
            }
          }
          let %7: writer.T = member writer.output
          let %8: String = call show()
          let %9: String = call conv.int(count)
          let %10: String = prim <>(%9, "\n")
          let %11: String = prim <>(" ", %10)
          let %12: String = prim <>(%8, %11)
          do call writer.putString(%7, %12)
          let %13: Int = prim +(count, 1)
          count := %13
          let %14: writer.T = member writer.output
          let %15: String = call show()
          let %16: String = call conv.int(count)
          let %17: String = prim <>(%16, "\n")
          let %18: String = prim <>(" ", %17)
          let %19: String = prim <>(%15, %18)
          do call writer.putString(%14, %19)
        } in {
          let %20: Bool = prim >(n, 2)
          if %20 {
            jump k5(10)
          } else {
            jump k5(20)
          }
        }
      } in {
        let %21: Bool = prim >(n, 2)
        if %21 {
          let %22: maybe.T(Int) = call maybe.some [Int](n)
          jump k4(%22)
        } else {
          let %23: maybe.T(Int) = type_app maybe.none [Int]
          jump k4(%23)
        }
      }
    } in {
      let %24: Exception = member ascii.error
      try catching (%24) {
        let %25: Int = prim *(n, 100)
        let %26: Char = call ascii.char(%25)
        jump k3(%26)
      } handle (e: Exception) {
        let %27: Bool = prim is(e, %24)
        if %27 {
          jump k3('?')
        } else {
          reraise e
        }
      }
    }
  } in {
    let %28: Bool = prim >(n, 2)
    if %28 {
      jump k1("big")
    } else {
      join k2(r.2: String) {
        jump k1(r.2)
      } in {
        let %29: Bool = prim >(n, 1)
        if %29 {
          jump k2("middling")
        } else {
          jump k2("small")
        }
      }
    }
  }
}

