import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  funs {
    fun show(n: Int): Ok {
      let %1: writer.T = member writer.output @6:47
      let %2: String = call conv.int(n) @6:61
      do call writer.putString(%1, %2) @6:30
      let %3: writer.T = member writer.output @6:91
      let %4: Ok = call writer.putString(%3, "\n") @6:74
      return %4
    }
  }
  do call show(0) @7:1
  do call show(255) @8:1
  do call show(255) @9:1
  let %5: Int = prim +(31, 1) @10:6
  do call show(%5) @10:1
  do call show(-16) @11:1
  do call show(2332033024) @12:1
  do call show(9223372036854775807) @13:1
  do call show(-9223372036854775808) @14:1
}

