import conv = "conv" : Conv
import writer = "writer" : Writer
main {
  funs rec {
    fun f(n: Int): Int {
      join k1(r: Int) {
        return r
      } in {
        let %1: Bool = prim >(n, 100) @9:8
        if %1 { @9:5
          let %2: Int = prim -(n, 100) @10:11
          let %3: Int = call f(%2) @10:9
          let %4: Int = prim +(%3, 1) @10:9
          jump k1(%4) @9:5
        } else {
          let rec (g: Fun(x: Int): Int) {
            funs rec {
              fun h(y: Int): Int {
                join k2(r.1: Int) {
                  return r.1
                } in {
                  let %5: Bool = prim is(y, 0) @15:49
                  if %5 { @15:46
                    jump k2(n) @15:46
                  } else {
                    let %6: Int = prim -(y, 1) @15:70
                    let %7: Int = call g(%6) @15:68
                    let %8: Int = call h(0) @15:79
                    let %9: Int = prim +(%7, %8) @15:68
                    jump k2(%9) @15:46
                  }
                }
              }
            }
            let g: Fun(x: Int): Int = h @16:21
          }
          let %10: Int = call g(n) @18:13
          jump k1(%10) @9:5
        }
      }
    }
  }
  var t: Int = 3 @21:1
  let %11: writer.T = member writer.output @22:18
  let %12: Int = call f(t) @22:41
  let %13: String = call conv.int(%12) @22:32
  let %14: String = prim <>(%13, "\n") @22:32
  do call writer.putString(%11, %14) @22:1
}

