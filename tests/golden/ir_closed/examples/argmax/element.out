import arrayOp = "arrayOp" : ArrayOp
import string = "string" : StringOp
fun argmax [E::TYPE K::TYPE](a: Array(E), key: Fun(e: E): K, isGreater: Fun(x: K y: K): Bool): E {
  let n: Int = prim extent(a)
  let %3: Bool = prim is(n, 0)
  if %3 {
    raise empty
  }
  var best: Int = 0
  let %4: E = index(a, 0)
  let %5: K = call key(%4)
  var bestKey: K = %5
  let %6: Int = prim -(n, 1)
  var i: Int = 1
  loop L1 {
    let %7: Bool = prim <=(i, %6)
    if %7 {
      let i.1: Int = i
      let %8: E = index(a, i.1)
      let k: K = call key(%8)
      let %9: Bool = call isGreater(k, bestKey)
      if %9 {
        best := i.1
        bestKey := k
      }
      let %10: Int = prim +(i, 1)
      i := %10
    } else {
      break L1
    }
  }
  let %11: E = index(a, best)
  return %11
}
main {
  let empty: Exception = exception empty
  let argmax.1: All(E :: TYPE K :: TYPE) Fun(a: Array(E) key: Fun(e: E): K isGreater: Fun(x: K y: K): Bool): E = closure argmax {}
  let words: Array(String) = array("pear", "fig", "banana", "kiwi")
  let %1: Fun(string: String): Int = member string.length
  let %2: Fun(a: Int b: Int): Bool = builtin >
  let longest: String = call argmax.1 [String Int](words, %1, %2)
}

