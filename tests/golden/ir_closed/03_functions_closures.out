fun add1(x: Int): Int {
  let %1: Int = prim +(x, 1)
  return %1
}
fun f {env}(y: Int): Int {
  let x.1: Int = env_field(env, 0)
  let %2: Int = prim +(x.1, y)
  return %2
}
fun adder(x.2: Int): Fun(y: Int): Int {
  let f.1: Fun(y: Int): Int = closure f {x.2}
  return f.1
}
fun apply(f.2: Fun(x: Int): Int, x.3: Int): Int {
  let %3: Int = call f.2(x.3)
  return %3
}
main {
  let add1.1: Fun(x: Int): Int = closure add1 {}
  let adder.1: Fun(x: Int): Fun(y: Int): Int = closure adder {}
  let apply.1: Fun(f: Fun(x: Int): Int x: Int): Int = closure apply {}
  let res: Int = call apply.1(add1.1, 41)
}

