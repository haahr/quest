fun sum(x.1: IntList): Int {
  switch tag(x.1) {
    case cons (c: Tuple head: Int tail: IntList end): {
      let %57: Int = tuple_field(c, 0)
      let %58: IntList = tuple_field(c, 1)
      let %59: Int = call sum.1(%58)
      let %60: Int = prim +(%57, %59)
      return %60
    }
    else: {
      return 0
    }
  }
}
fun sum2(x.2: L2): Int {
  switch tag(x.2) {
    case cons (c.1: Tuple head: Int tail: Option nil cons with Tuple head: Int tail: L2 end end end): {
      let %61: Int = tuple_field(c.1, 0)
      let %62: Option nil cons with Tuple head: Int tail: L2 end end = tuple_field(c.1, 1)
      let %63: Int = call sum2.1(%62)
      let %64: Int = prim +(%61, %63)
      return %64
    }
    else: {
      return 0
    }
  }
}
fun next {env}(): Stream {
  let n: Int = env_field(env, 0)
  let %65: Int = prim -(n, 1)
  let %66: Stream = call count.1(%65)
  return %66
}
fun count(n.1: Int): Stream {
  let %67: Bool = prim is(n.1, 0)
  if %67 {
    let %68: Stream = option(done)
    return %68
  } else {
    let next.1: Fun(): Stream = closure next {n.1}
    let %69: Tuple value: Int next: Fun(): Stream end = tuple(n.1, next.1)
    let %70: Stream = option(more, %69)
    return %70
  }
}
fun total(s: Stream2): Int {
  switch tag(s) {
    case more (c.2: Tuple value: Int next: Fun(): Option done more with Tuple value: Int next: Fun(...) end end end): {
      let %71: Int = tuple_field(c.2, 0)
      let %72: Fun(): Option done more with Tuple value: Int next: Fun(): Stream2 end end = tuple_field(c.2, 1)
      let %73: Option done more with Tuple value: Int next: Fun(): Stream2 end end = call %72()
      let %74: Int = call total.1(%73)
      let %75: Int = prim +(%71, %74)
      return %75
    }
    else: {
      return 0
    }
  }
}
