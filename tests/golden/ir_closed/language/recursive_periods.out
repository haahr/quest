}
fun next {env}(): Stream {
  let n: Int = env_field(env, 0)
  let %12: Int = prim -(n, 1)
  let %13: Stream = call count?(%12)
  return %13
}
fun count(n.1: Int): Stream {
  join k3(r.2: Stream) {
    return r.2
  } in {
    let %14: Bool = prim is(n.1, 0)
    if %14 {
      let %15: Stream = option(done)
      jump k3(%15)
    } else {
      let value: Int = n.1
      let next.1: Fun(): Stream = closure next {n.1}
      let %16: Tuple value: Int next: Fun(): Stream end = tuple(value, next.1)
      let %17: Stream = option(more, %16)
      jump k3(%17)
    }
  }
}
fun total(s: Stream2): Int {
  join k4(r.3: Int) {
    return r.3
  } in {
    switch tag(s) {
      case more (c.2: Tuple value: Int next: Fun(): Option done more with Tuple value: Int next: Fun(...) end end end): {
        let %18: Int = tuple_field(c.2, 0)
        let %19: Fun(): Option done more with Tuple value: Int next: Fun(): Stream2 end end = tuple_field(c.2, 1)
        let %20: Option done more with Tuple value: Int next: Fun(): Stream2 end end = call %19()
        let %21: Int = call total?(%20)
        let %22: Int = prim +(%18, %21)
        jump k4(%22)
      }
      else: {
        jump k4(0)
