import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output
  let %1: String = call conv.int(21)
  do call writer.putString(wOut, %1)
  let %2: Ok = call writer.putString(wOut, "\n")
  let %3: String = call conv.int(34)
  do call writer.putString(wOut, %3)
  let %4: Ok = call writer.putString(wOut, "\n")
  let %5: String = call conv.int(21)
  do call writer.putString(wOut, %5)
  let %6: Ok = call writer.putString(wOut, "\n")
  let %7: String = call conv.int(605)
  do call writer.putString(wOut, %7)
  let %8: Ok = call writer.putString(wOut, "\n")
  let %9: String = call conv.int(34)
  do call writer.putString(wOut, %9)
  let %10: Ok = call writer.putString(wOut, "\n")
  var c: Int = 0
  let %11: Int = prim +(c, 1)
  c := %11
  let first: Int = c
  let x: Int = c
  let %12: String = call conv.int(x)
  do call writer.putString(wOut, %12)
  let %13: Ok = call writer.putString(wOut, "\n")
  let %14: Int = prim +(c, 10)
  c := %14
  let second: Int = c
  let %15: Int = prim *(first, 100)
  let %16: Int = prim +(%15, second)
  let %17: String = call conv.int(%16)
  do call writer.putString(wOut, %17)
  let %18: Ok = call writer.putString(wOut, "\n")
  var v: Int = 1
  var w: Int = 2
  let %19: Int = prim +(v, w)
  v := %19
  w := 0
  let %20: Int = prim *(v, 10)
  let %21: Int = prim +(%20, w)
  let %22: String = call conv.int(%21)
  do call writer.putString(wOut, %22)
  let %23: Ok = call writer.putString(wOut, "\n")
  let %24: String = call conv.int(12)
  do call writer.putString(wOut, %24)
  let %25: Ok = call writer.putString(wOut, "\n")
}

