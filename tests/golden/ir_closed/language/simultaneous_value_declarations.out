import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @6:12
  let %1: String = call conv.int(21) @9:31
  do call writer.putString(wOut, %1) @9:9
  let %2: Ok = call writer.putString(wOut, "\n") @10:9
  let %3: String = call conv.int(34) @9:31
  do call writer.putString(wOut, %3) @9:9
  let %4: Ok = call writer.putString(wOut, "\n") @10:9
  let %5: String = call conv.int(21) @9:31
  do call writer.putString(wOut, %5) @9:9
  let %6: Ok = call writer.putString(wOut, "\n") @10:9
  let %7: String = call conv.int(605) @9:31
  do call writer.putString(wOut, %7) @9:9
  let %8: Ok = call writer.putString(wOut, "\n") @10:9
  let %9: String = call conv.int(34) @9:31
  do call writer.putString(wOut, %9) @9:9
  let %10: Ok = call writer.putString(wOut, "\n") @10:9
  var c: Int = 0 @48:9
  let %11: Int = prim +(c, 1) @49:32
  c := %11 @49:27
  let first: Int = c @49:38
  let x: Int = c @49:55
  let %12: String = call conv.int(x) @9:31
  do call writer.putString(wOut, %12) @9:9
  let %13: Ok = call writer.putString(wOut, "\n") @10:9
  let %14: Int = prim +(c, 10) @49:91
  c := %14 @49:86
  let second: Int = c @49:98
  let %15: Int = prim *(first, 100) @50:10
  let %16: Int = prim +(%15, second) @50:10
  let %17: String = call conv.int(%16) @9:31
  do call writer.putString(wOut, %17) @9:9
  let %18: Ok = call writer.putString(wOut, "\n") @10:9
  var v: Int = 1 @55:17
  var w: Int = 2 @55:31
  let %19: Int = prim +(v, w) @56:14
  v := %19 @56:9
  w := 0 @57:9
  let %20: Int = prim *(v, 10) @58:10
  let %21: Int = prim +(%20, w) @58:10
  let %22: String = call conv.int(%21) @9:31
  do call writer.putString(wOut, %22) @9:9
  let %23: Ok = call writer.putString(wOut, "\n") @10:9
  let %24: String = call conv.int(12) @9:31
  do call writer.putString(wOut, %24) @9:9
  let %25: Ok = call writer.putString(wOut, "\n") @10:9
}

