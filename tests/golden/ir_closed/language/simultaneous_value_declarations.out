import writer = "writer" : Writer
import conv = "conv" : Conv
fun printInt(x: Int): Ok {
  let %1: String = call conv.int(x)
  do call writer.putString(wOut?, %1)
  let %2: Ok = call writer.putString(wOut?, "\n")
  return %2
}
fun shift(n: Int): Int {
  let n.1: Int = prim +(n, 1)
  let m: Int = n
  let %3: Int = prim *(n.1, 100)
  let %4: Int = prim +(%3, m)
  return %4
}
fun f {env}(): Int {
  let u: Int = env_field(env, 0)
  return u
}
fun captured(): Int {
  let u.1: Int = 3
  let u.2: Int = 4
  let f.1: Fun(): Int = closure f {u.1}
  let %5: Int = call f.1()
  let %6: Int = prim *(%5, 10)
  let %7: Int = prim +(%6, u.2)
  return %7
}
fun counted(): Int {
  var c: Int = 0
  let %8: Int = prim +(c, 1)
  c := %8
  let first: Int = c
  let done: Ok = call printInt?(c)
  let %9: Int = prim +(c, 10)
  c := %9
  let second: Int = c
  let %10: Int = prim *(first, 100)
  let %11: Int = prim +(%10, second)
  return %11
}
fun mutable(): Int {
  var v: Int = 1
  var w: Int = 2
  let %12: Int = prim +(v, w)
  v := %12
  w := 0
  let %13: Int = prim *(v, 10)
  let %14: Int = prim +(%13, w)
  return %14
}
fun get {env.1}(): Int {
  let k: Int = env_field(env.1, 0)
  return k
}
fun later(): Int {
  let k.1: Int = 1
  let get.1: Fun(): Int = closure get {k.1}
  let k.2: Int = 2
  let %15: Int = call get.1()
  let %16: Int = prim *(%15, 10)
  let %17: Int = prim +(%16, k.2)
  return %17
}
main {
  let wOut: writer.T = member writer.output
  let printInt.1: Fun(x: Int): Ok = closure printInt {}
  let x.1: Int = 1
  let x.2: Int = 2
  let y: Int = x.1
  let %18: Int = prim *(x.2, 10)
  let %19: Int = prim +(%18, y)
  do call printInt.1(%19)
  let a: Int = 3
  let b: Int = 4
  let %20: Int = prim *(a, 10)
  let %21: Int = prim +(%20, b)
  do call printInt.1(%21)
  let p: Int = 1
  let q: Int = 2
  let p.1: Int = q
  let q.1: Int = p
  let %22: Int = prim *(p.1, 10)
  let swapped: Int = prim +(%22, q.1)
  do call printInt.1(swapped)
  let shift.1: Fun(n: Int): Int = closure shift {}
  let %23: Int = call shift.1(5)
  do call printInt.1(%23)
  let captured.1: Fun(): Int = closure captured {}
  let %24: Int = call captured.1()
  do call printInt.1(%24)
  let counted.1: Fun(): Int = closure counted {}
  let %25: Int = call counted.1()
  do call printInt.1(%25)
  let mutable.1: Fun(): Int = closure mutable {}
  let %26: Int = call mutable.1()
  do call printInt.1(%26)
  let later.1: Fun(): Int = closure later {}
  let %27: Int = call later.1()
  do call printInt.1(%27)
}

