import writer = "writer" : Writer
import conv = "conv" : Conv
import dynamic = "dynamic" : Dynamic
fun p(n: Int): Ok {
  let %20: writer.T = member writer.output
  let %21: String = call conv.int(n)
  let %22: String = prim <>(%21, "\n")
  let %23: Ok = call writer.putString(%20, %22)
  return %23
}
fun s(text: String): Ok {
  let %24: writer.T = member writer.output
  let %25: String = prim <>(text, "\n")
  let %26: Ok = call writer.putString(%24, %25)
  return %26
}
fun box [A::TYPE](x: A): Boxed {
  let a: A = x
  let %27: Tuple a: A end = tuple(a)
  let %28: Boxed = auto[A](%27)
  return %28
}
fun box_spec(x.1: Car): Boxed {
  let a.1: Car = x.1
  let %29: Tuple a: Car end = tuple(a.1)
  let %30: Boxed = auto[Car](%29)
  return %30
}
fun unbox [A::TYPE](b: Boxed, default: A): A {
  join k3(r.5: A) {
    return r.5
  } in {
    inspect b {
      case A (x.2: Tuple a: A end): {
        let %31: A = tuple_field(x.2, 0)
        jump k3(%31)
      }
      else: {
        jump k3(default)
      }
    }
  }
}
fun unbox_spec(b.1: Boxed, default.1: Object): Object {
  join k3(r.6: Object) {
    return r.6
  } in {
    inspect b.1 {
      case Object (x.3: Tuple a: Object end): {
        let %32: Object = tuple_field(x.3, 0)
        jump k3(%32)
      }
      else: {
        jump k3(default.1)
      }
    }
  }
}
fun boxTwice [B::TYPE](y: B): Tuple first: Boxed second: Boxed end {
  let first: Boxed = call box.1 [B](y)
  let second: Boxed = call box.1 [B](y)
  let %33: Tuple first: Boxed second: Boxed end = tuple(first, second)
  return %33
}
fun pack [A::TYPE](x.4: A): Dynamic {
  let %34: T = call dynamic.new [A](x.4)
  return %34
}
fun pack_spec(x.5: Car): Dynamic {
  let %35: T = call dynamic.new [Car](x.5)
  return %35
}
fun showable [A::TYPE](x.6: A, f.2: Fun(_: A): String): Showable {
  let x.7: A = x.6
  let show: Fun(_: A): String = f.2
  let %36: Tuple x: A show: Fun(_: A): String end = tuple(x.7, show)
  let %37: Showable = auto[A](%36)
  return %37
}
fun f(n.1: Int): String {
  let %38: Int = prim *(n.1, 10)
  let %39: String = call conv.int(%38)
  return %39
}
main {
  let p.1: Fun(n: Int): Ok = closure p {}
  let s.1: Fun(text: String): Ok = closure s {}
  let myCar: Car = record(age = 3, fuel = "diesel")
  let box.1: All(A :: TYPE) Fun(x: A): Boxed = closure box {}
  let box_spec.1: Fun(x: Car): Boxed = closure box_spec {}
  let boxedInt: Boxed = call box.1 [Int](42)
  let boxedCar: Boxed = call box_spec.1(myCar)
  join k1(r: Int) {
    do call p.1(r)
    join k2(r.1: String) {
      do call s.1(r.1)
      let unbox.1: All(A :: TYPE) Fun(b: Boxed default: A): A = closure unbox {}
      let unbox_spec.1: Fun(b: Boxed default: Object): Object = closure unbox_spec {}
      let %1: Int = call unbox.1 [Int](boxedInt, 0)
      do call p.1(%1)
      let %2: Int = prim -(0, 1)
      let %3: Int = call unbox.1 [Int](boxedCar, %2)
      do call p.1(%3)
      let %4: Record age: Int end = record(age = 0)
      let %5: Object = call unbox_spec.1(boxedCar, %4)
      let %6: Int = record_field(%5, age)
      do call p.1(%6)
      let boxTwice.1: All(B :: TYPE) Fun(y: B): Tuple first: Boxed second: Boxed end = closure boxTwice {}
      let twice: Tuple first: Boxed second: Boxed end = call boxTwice.1 [String]("twice")
      join k4(r.2: String) {
        do call s.1(r.2)
        let pack.1: All(A :: TYPE) Fun(x: A): Dynamic = closure pack {}
        let pack_spec.1: Fun(x: Car): Dynamic = closure pack_spec {}
        let %7: Dynamic = call pack.1 [Int](7)
        let %8: Int = call dynamic.be [Int](%7)
        do call p.1(%8)
        join k5(r.3: Int) {
          do call p.1(r.3)
          let showable.1: All(A :: TYPE) Fun(x: A f: Fun(_: A): String): Showable = closure showable {}
          let f.1: Fun(n: Int): String = closure f {}
          let showInt: Showable = call showable.1 [Int](5, f.1)
          join k6(r.4: String) {
            do call s.1(r.4)
          } in {
            inspect showInt {
              case Int exact (i: Tuple x: Int show: Fun(_: Int): String end): {
                let %9: Fun(_: Int): String = tuple_field(i, 1)
                let %10: Int = tuple_field(i, 0)
                let %11: String = call %9(%10)
                jump k6(%11)
              }
              else: {
                jump k6("?")
              }
            }
          }
        } in {
          let %12: Dynamic = call pack_spec.1(myCar)
          inspect %12 {
            case Object (o: Tuple a: Object end): {
              let %13: Object = tuple_field(o, 0)
              let %14: Int = record_field(%13, age)
              jump k5(%14)
            }
            else: {
              jump k5(0)
            }
          }
        }
      } in {
        let %15: Boxed = tuple_field(twice, 1)
        inspect %15 {
          case String (t: Tuple a: String end): {
            let %16: String = tuple_field(t, 0)
            jump k4(%16)
          }
          else: {
            jump k4("?")
          }
        }
      }
    } in {
      inspect boxedCar {
        case Car (c: Tuple a: Car end): {
          let %17: Car = tuple_field(c, 0)
          let %18: String = record_field(%17, fuel)
          jump k2(%18)
        }
        else: {
          jump k2("?")
        }
      }
    }
  } in {
    inspect boxedInt {
      case Int (i.1: Tuple a: Int end): {
        let %19: Int = tuple_field(i.1, 0)
        jump k1(%19)
      }
      else: {
        jump k1(0)
      }
    }
  }
}

