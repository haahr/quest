import writer = "writer" : Writer
import conv = "conv" : Conv
fun printInt(x: Int): Ok {
  let %8: String = call conv.int(x)
  do call writer.putString(wOut, %8)
  let %9: Ok = call writer.putString(wOut, "\n")
  return %9
}
fun apply(fn: Fun(x: Int): Int, x.1: Int): Int {
  let %10: Int = call fn(x.1)
  return %10
}
fun inc(x.2: Int): Int {
  let %11: Int = prim +(x.2, 1)
  return %11
}
fun f(x.3: Int): Int {
  let %12: Int = prim *(x.3, 3)
  return %12
}
fun f.1 {env}(x.4: Int): Int {
  let base: Int = env_field(env, 0)
  let %13: Int = prim +(base, x.4)
  return %13
}
fun makeAdder(base.1: Int): Fun(x: Int): Int {
  let f.7: Fun(x: Int): Int = closure f.1 {base.1}
  return f.7
}
fun f.2 {env.1}(c: Int): Int {
  let b: Int = env_field(env.1, 0)
  let a: Int = env_field(env.1, 1)
  let %14: Int = prim +(b, c)
  let %15: Int = prim +(a, %14)
  return %15
}
fun f.3 {env.2}(b.1: Int): Fun(c: Int): Int {
  let a.1: Int = env_field(env.2, 0)
  let f.8: Fun(c: Int): Int = closure f.2 {b.1, a.1}
  return f.8
}
fun f.4(a.2: Int): Fun(b: Int): Fun(c: Int): Int {
  let f.9: Fun(b: Int): Fun(c: Int): Int = closure f.3 {a.2}
  return f.9
}
fun bump(delta: Int): Ok {
  let %16: Int = tuple_field(counter, 0)
  let %17: Int = prim +(%16, delta)
  store counter.#0 := %17
  return ok
}
main {
  let wOut: writer.T = member writer.output
  let printInt.1: Fun(x: Int): Ok = closure printInt {}
  let apply.1: Fun(fn: Fun(x: Int): Int x: Int): Int = closure apply {}
  let inc.1: Fun(x: Int): Int = closure inc {}
  let %1: Int = call apply.1(inc.1, 41)
  do call printInt.1(%1)
  let f.5: Fun(x: Int): Int = closure f {}
  let %2: Int = call apply.1(f.5, 14)
  do call printInt.1(%2)
  let makeAdder.1: Fun(base: Int): Fun(x: Int): Int = closure makeAdder {}
  let add100: Fun(x: Int): Int = call makeAdder.1(100)
  let %3: Int = call add100(42)
  do call printInt.1(%3)
  let f.6: Fun(a: Int): Fun(b: Int): Fun(c: Int): Int = closure f.4 {}
  let %4: Fun(b: Int): Fun(c: Int): Int = call f.6(10)
  let %5: Fun(c: Int): Int = call %4(20)
  let %6: Int = call %5(12)
  do call printInt.1(%6)
  let count: Int = 10
  let counter: Tuple var count: Int end = tuple(count)
  let bump.1: Fun(delta: Int): Ok = closure bump {}
  do call bump.1(5)
  do call bump.1(27)
  let %7: Int = tuple_field(counter, 0)
  do call printInt.1(%7)
}

