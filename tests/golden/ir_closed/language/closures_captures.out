import writer = "writer" : Writer
import conv = "conv" : Conv
fun printInt(x: Int): Ok {
  let %1: String = call conv.int(x)
  do call writer.putString(wOut?, %1)
  let %2: Ok = call writer.putString(wOut?, "\n")
  return %2
}
fun apply(fn: Fun(x: Int): Int, x.1: Int): Int {
  let %3: Int = call fn(x.1)
  return %3
}
fun inc(x.2: Int): Int {
  let %4: Int = prim +(x.2, 1)
  return %4
}
fun f(x.3: Int): Int {
  let %5: Int = prim *(x.3, 3)
  return %5
}
fun f.1 {env}(x.4: Int): Int {
  let base: Int = env_field(env, 0)
  let %6: Int = prim +(base, x.4)
  return %6
}
fun makeAdder(base.1: Int): Fun(x: Int): Int {
  let f.5: Fun(x: Int): Int = closure f.1 {base.1}
  return f.5
}
fun f.2 {env.1}(c: Int): Int {
  let b: Int = env_field(env.1, 0)
  let a: Int = env_field(env.1, 1)
  let %7: Int = prim +(b, c)
  let %8: Int = prim +(a, %7)
  return %8
}
fun f.3 {env.2}(b.1: Int): Fun(c: Int): Int {
  let a.1: Int = env_field(env.2, 0)
  let f.6: Fun(c: Int): Int = closure f.2 {b.1, a.1}
  return f.6
}
fun f.4(a.2: Int): Fun(b: Int): Fun(c: Int): Int {
  let f.7: Fun(b: Int): Fun(c: Int): Int = closure f.3 {a.2}
  return f.7
}
fun bump(delta: Int): Ok {
  let %9: Int = prim +(count?, delta)
  count? := %9
  return ok
}
main {
  let wOut: writer.T = member writer.output
  let printInt.1: Fun(x: Int): Ok = closure printInt {}
  let apply.1: Fun(fn: Fun(x: Int): Int x: Int): Int = closure apply {}
  let inc.1: Fun(x: Int): Int = closure inc {}
  let %10: Int = call apply.1(inc.1, 41)
  do call printInt.1(%10)
  let f.8: Fun(x: Int): Int = closure f {}
  let %11: Int = call apply.1(f.8, 14)
  do call printInt.1(%11)
  let makeAdder.1: Fun(base: Int): Fun(x: Int): Int = closure makeAdder {}
  let add100: Fun(x: Int): Int = call makeAdder.1(100)
  let %12: Int = call add100(42)
  do call printInt.1(%12)
  let f.9: Fun(a: Int): Fun(b: Int): Fun(c: Int): Int = closure f.4 {}
  let %13: Fun(b: Int): Fun(c: Int): Int = call f.9(10)
  let %14: Fun(c: Int): Int = call %13(20)
  let %15: Int = call %14(12)
  do call printInt.1(%15)
  var count: Int = 10
  let bump.1: Fun(delta: Int): Ok = closure bump {}
  do call bump.1(5)
  do call bump.1(27)
  do call printInt.1(count)
}

