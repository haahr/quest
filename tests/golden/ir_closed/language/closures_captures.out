import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @6:12
  let %1: String = call conv.int(42) @9:31
  do call writer.putString(wOut, %1) @9:9
  let %2: Ok = call writer.putString(wOut, "\n") @10:9
  let %3: String = call conv.int(42) @9:31
  do call writer.putString(wOut, %3) @9:9
  let %4: Ok = call writer.putString(wOut, "\n") @10:9
  let %5: String = call conv.int(142) @9:31
  do call writer.putString(wOut, %5) @9:9
  let %6: Ok = call writer.putString(wOut, "\n") @10:9
  let %7: String = call conv.int(42) @9:31
  do call writer.putString(wOut, %7) @9:9
  let %8: Ok = call writer.putString(wOut, "\n") @10:9
  let counter: Tuple var count: Int end = tuple(10) @34:15
  let %9: Int = tuple_field(counter, 0) @37:26
  let %10: Int = prim +(%9, 5) @37:26
  store counter.#0 := %10 @37:9
  let %11: Int = tuple_field(counter, 0) @37:26
  let %12: Int = prim +(%11, 27) @37:26
  store counter.#0 := %12 @37:9
  let %13: Int = tuple_field(counter, 0) @42:10
  let %14: String = call conv.int(%13) @9:31
  do call writer.putString(wOut, %14) @9:9
  let %15: Ok = call writer.putString(wOut, "\n") @10:9
}

