}
fun sumForest(f.2: Forest): Int {
  var s: Int = 0
  let %42: Array(Tree) = record_field(f.2, trees)
  let %43: Int = call arrayOp.size [Tree](%42)
  let %44: Int = prim -(%43, 1)
