      let %47: Tree = index(%46, i.1)
      let %48: Int = call sumTree?(%47)
      let %49: Int = prim +(s, %48)
      s := %49
      let %50: Int = prim +(i, 1)
      i := %50
    } else {
      break L1
    }
  }
  return s
}
