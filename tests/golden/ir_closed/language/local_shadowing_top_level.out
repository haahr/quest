fun twice(n: Int): Int {
  let %4: Int = prim *(n, 2)
  return %4
}
fun twice.1(n.1: Int): Int {
  let %5: Int = prim *(n.1, 10)
  return %5
}
fun viaClosure {env}(n.2: Int): Int {
  let twice.3: Fun(n: Int): Int = env_field(env, 0)
  let %6: Int = call twice.3(n.2)
  let %7: Int = prim +(%6, 1)
  return %7
}
fun shadowFun(): Int {
  let twice.4: Fun(n: Int): Int = closure twice.1 {}
  let viaClosure.1: Fun(n: Int): Int = closure viaClosure {twice.4}
  let %8: Int = call twice.4(1)
  let %9: Int = call viaClosure.1(2)
  let %10: Int = prim +(%8, %9)
  return %10
}
fun add {env.1}(n.3: Int): Int {
  let base.1: Int = env_field(env.1, 0)
  let %11: Int = prim +(base.1, n.3)
  return %11
}
fun captureValue(): Int {
  let base.2: Int = 100
  let add.1: Fun(n: Int): Int = closure add {base.2}
  let %12: Int = call add.1(5)
  return %12
}
main {
  let twice.2: Fun(n: Int): Int = closure twice {}
  let shadowFun.1: Fun(): Int = closure shadowFun {}
  let %1: Int = call shadowFun.1()
  let %2: Int = call twice.2(4)
  let captureValue.1: Fun(): Int = closure captureValue {}
  let base: Int = 1
  let %3: Int = call captureValue.1()
}

