fun twice(n: Int): Int {
  let %1: Int = prim *(n, 2)
  return %1
}
fun twice.1(n.1: Int): Int {
  let %2: Int = prim *(n.1, 10)
  return %2
}
fun viaClosure {env}(n.2: Int): Int {
  let twice.2: Fun(n: Int): Int = env_field(env, 0)
  let %3: Int = call twice.2(n.2)
  let %4: Int = prim +(%3, 1)
  return %4
}
fun shadowFun(): Int {
  let twice.3: Fun(n: Int): Int = closure twice.1 {}
  let viaClosure.1: Fun(n: Int): Int = closure viaClosure {twice.3}
  let %5: Int = call twice.3(1)
  let %6: Int = call viaClosure.1(2)
  let %7: Int = prim +(%5, %6)
  return %7
}
fun add {env.1}(n.3: Int): Int {
  let base: Int = env_field(env.1, 0)
  let %8: Int = prim +(base, n.3)
  return %8
}
fun captureValue(): Int {
  let base.1: Int = 100
  let add.1: Fun(n: Int): Int = closure add {base.1}
  let %9: Int = call add.1(5)
  return %9
}
main {
  let twice.4: Fun(n: Int): Int = closure twice {}
  let shadowFun.1: Fun(): Int = closure shadowFun {}
  let %10: Int = call shadowFun.1()
  let %11: Int = call twice.4(4)
  let captureValue.1: Fun(): Int = closure captureValue {}
  let base.2: Int = 1
  let %12: Int = call captureValue.1()
}

