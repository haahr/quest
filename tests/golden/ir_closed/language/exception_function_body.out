import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output
  let Made: Exception(Int) = exception Made: Int
  let Made.1: Exception(Int) = exception Made: Int
  join k1(r: Int) {
    let %1: String = call conv.int(r)
    do call writer.putString(wOut, %1)
    let %2: Ok = call writer.putString(wOut, "\n")
    join k2(r.1: Int) {
      let %3: String = call conv.int(r.1)
      do call writer.putString(wOut, %3)
      let %4: Ok = call writer.putString(wOut, "\n")
      join inlined1(%5: Int) {
        let %6: String = call conv.int(%5)
        do call writer.putString(wOut, %6)
        let %7: Ok = call writer.putString(wOut, "\n")
        join inlined2(%8: Int) {
          let %9: String = call conv.int(%8)
          do call writer.putString(wOut, %9)
          let %10: Ok = call writer.putString(wOut, "\n")
          let %11: String = call conv.int(0)
          do call writer.putString(wOut, %11)
          let %12: Ok = call writer.putString(wOut, "\n")
          join inlined5(%13: Int) {
            let %14: String = call conv.int(%13)
            do call writer.putString(wOut, %14)
            let %15: Ok = call writer.putString(wOut, "\n")
            join inlined7(%16: Int) {
              let %17: String = call conv.int(%16)
              do call writer.putString(wOut, %17)
              let %18: Ok = call writer.putString(wOut, "\n")
              let Shadow: Exception(Int) = exception Shadow: Int
              join inlined8(%19: Int) {
                let %20: String = call conv.int(%19)
                do call writer.putString(wOut, %20)
                let %21: Ok = call writer.putString(wOut, "\n")
                join k11(r.2: Int) {
                  let %22: String = call conv.int(r.2)
                  do call writer.putString(wOut, %22)
                  let %23: Ok = call writer.putString(wOut, "\n")
                } in {
                  try catching (Shadow) {
                    raise Shadow with 3
                  } handle (e: Exception) {
                    let %24: Bool = prim is(e, Shadow)
                    if %24 {
                      let n: Int = exception_payload(e)
                      let %25: Int = prim +(n, 30)
                      jump k11(%25)
                    } else {
                      reraise e
                    }
                  }
                }
              } in {
                let Shadow.1: Exception(Int) = exception Shadow: Int
                try catching (Shadow.1) {
                  raise Shadow.1 with 9
                } handle (e.1: Exception) {
                  let %26: Bool = prim is(e.1, Shadow.1)
                  if %26 {
                    let n.1: Int = exception_payload(e.1)
                    jump inlined8(n.1)
                  } else {
                    reraise e.1
                  }
                }
              }
            } in {
              let Outer: Exception(Int) = exception Outer: Int
              try catching (Outer) {
                raise Outer with 21
              } handle (e.2: Exception) {
                let %27: Bool = prim is(e.2, Outer)
                if %27 {
                  let n.2: Int = exception_payload(e.2)
                  let %28: Int = prim *(n.2, 2)
                  jump inlined7(%28)
                } else {
                  reraise e.2
                }
              }
            }
          } in {
            let Cap: Exception(Int) = exception Cap: Int
            try catching (Cap) {
              raise Cap with 10
            } handle (e.3: Exception) {
              let %29: Bool = prim is(e.3, Cap)
              if %29 {
                let n.3: Int = exception_payload(e.3)
                let %30: Int = prim +(n.3, 1)
                jump inlined5(%30)
              } else {
                reraise e.3
              }
            }
          }
        } in {
          let Pos: Exception(Int) = exception Pos: Int
          try catching (Pos) {
            raise Pos with 8
          } handle (e.4: Exception) {
            let %31: Bool = prim is(e.4, Pos)
            if %31 {
              let n.4: Int = exception_payload(e.4)
              let %32: Int = prim *(n.4, 2)
              jump inlined2(%32)
            } else {
              reraise e.4
            }
          }
        }
      } in {
        let Inline: Exception(Int) = exception Inline: Int
        try catching (Inline) {
          raise Inline with 4
        } handle (e.5: Exception) {
          let %33: Bool = prim is(e.5, Inline)
          if %33 {
            let n.5: Int = exception_payload(e.5)
            let %34: Int = prim +(n.5, 1)
            jump inlined1(%34)
          } else {
            reraise e.5
          }
        }
      }
    } in {
      try catching (Made) {
        join k3(r.3: Int) {
          jump k2(r.3)
        } in {
          try catching (Made.1) {
            raise Made with 6
          } handle (e.6: Exception) {
            let %35: Bool = prim is(e.6, Made.1)
            if %35 {
              let n.6: Int = exception_payload(e.6)
              let %36: Int = prim -(0, n.6)
              jump k3(%36)
            } else {
              reraise e.6
            }
          }
        }
      } handle (e.7: Exception) {
        let %37: Bool = prim is(e.7, Made)
        if %37 {
          let n.7: Int = exception_payload(e.7)
          jump k2(n.7)
        } else {
          reraise e.7
        }
      }
    }
  } in {
    try catching (Made) {
      raise Made with 5
    } handle (e.8: Exception) {
      let %38: Bool = prim is(e.8, Made)
      if %38 {
        let n.8: Int = exception_payload(e.8)
        jump k1(n.8)
      } else {
        reraise e.8
      }
    }
  }
}

