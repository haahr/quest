import int = "int" : IntOp
fun add(n: Int): Int {
  let %15: Int = tuple_field(state, 0)
  let %16: Int = prim +(%15, n)
  store state.#0 := %16
  let %17: Int = tuple_field(state, 0)
  return %17
}
fun total(): Int {
  let %18: Int = tuple_field(state, 0)
  let %19: Int = prim +(start, %18)
  return %19
}
fun make(n.1: Int): T {
  return n.1
}
fun get(c: T): Int {
  return c
}
fun next(c.1: T): T {
  let %20: Int = prim +(c.1, 1)
  return %20
}
fun value(n.2: Int): Int {
  let %21: Int = call int.abs(n.2)
  return %21
}
module tally : Tally {
  let start: Int = 100
  let state: Tuple var sum: Int end = tuple(0)
  let add.1: Fun(n: Int): Int = closure add {}
  let total.1: Fun(): Int = closure total {}
  let tally_record: Record start: Int state: Tuple var sum: Int end add: Fun(n: Int): Int total: Fun(): Int end = record(start = start, state = state, add = add.1, total = total.1)
  export start = start, state = state, add = add.1, total = total.1
  record tally_record
}
module counter : Counter {
  let make.1: Fun(n: Int): T = closure make {}
  let get.1: Fun(c: T): Int = closure get {}
  let next.1: Fun(c: T): T = closure next {}
  let counter_record: Record make: Fun(n: Int): T get: Fun(c: T): Int next: Fun(c: T): T end = record(make = make.1, get = get.1, next = next.1)
  export make = make.1, get = get.1, next = next.1
  record counter_record
}
module absolute : Absolute {
  let value.1: Fun(n: Int): Int = closure value {}
  let absolute_record: Record value: Fun(n: Int): Int end = record(value = value.1)
  export value = value.1
  record absolute_record
}
main {
  let %1: Int = member tally.start
  let %2: Int = call tally.add(3)
  let %3: Int = call tally.add(4)
  let %4: Int = call tally.total()
  let %5: Int = call tally.add(10)
  let %6: Int = call tally.add(10)
  let %7: Int = call tally.total()
  let k: counter.T = call counter.make(4)
  let %8: counter.T = call counter.next(k)
  let %9: Int = call counter.get(%8)
  let m: Module 'counter' = module counter
  let %10: Fun(c: counter.T): Int = record_field(m, get)
  let %11: Fun(n: Int): counter.T = record_field(m, make)
  let %12: counter.T = call %11(9)
  let %13: Int = call %10(%12)
  let %14: Int = call absolute.value(-7)
}

