import writer = "writer" : Writer
import conv = "conv" : Conv
fun printInt(x: Int): Ok {
  let %9: String = call external "quest_conv_int"(x)
  do call writer.putString(wOut, %9)
  let %10: Ok = call writer.putString(wOut, "\n")
  return %10
}
fun square(x.1: Int): Int {
  let %11: Int = prim *(x.1, x.1)
  return %11
}
fun add3(a: Int, b: Int, c: Int): Int {
  let %12: Int = prim +(b, c)
  let %13: Int = prim +(a, %12)
  return %13
}
fun f {env}(y: Int): Int {
  let x.2: Int = env_field(env, 0)
  let %14: Int = prim -(x.2, y)
  return %14
}
fun sub(x.3: Int): Fun(y: Int): Int {
  let f.1: Fun(y: Int): Int = closure f {x.3}
  return f.1
}
fun fact(n: Int): Int {
  join k1(r: Int) {
    return r
  } in {
    let %15: Bool = prim <=(n, 1)
    if %15 {
      jump k1(1)
    } else {
      let %16: Int = prim -(n, 1)
      let %17: Int = call fact.1(%16)
      let %18: Int = prim *(n, %17)
      jump k1(%18)
    }
  }
}
fun fib(n.1: Int): Int {
  join k2(r.1: Int) {
    return r.1
  } in {
    let %19: Bool = prim <=(n.1, 0)
    if %19 {
      jump k2(0)
    } else {
      join k3(r.2: Int) {
        jump k2(r.2)
      } in {
        let %20: Bool = prim is(n.1, 1)
        if %20 {
          jump k3(1)
        } else {
          let %21: Int = prim -(n.1, 1)
          let %22: Int = call fib.1(%21)
          let %23: Int = prim -(n.1, 2)
          let %24: Int = call fib.1(%23)
          let %25: Int = prim +(%22, %24)
          jump k3(%25)
        }
      }
    }
  }
}
fun increment(step: Int): Ok {
  let %26: Int = tuple_field(counter, 0)
  let %27: Int = prim +(%26, step)
  store counter.#0 := %27
  return ok
}
fun doubleVal(x.4: Int): Int {
  let %28: Int = prim +(x.4, x.4)
  return %28
}
fun combine(a.1: Int, b.1: Int): Int {
  let %29: Int = call square.1(a.1)
  let %30: Int = call doubleVal.1(b.1)
  let %31: Int = prim +(%29, %30)
  return %31
}
main {
  let wOut: writer.T = member writer.output
  let printInt.1: Fun(x: Int): Ok = closure printInt {}
  let square.1: Fun(x: Int): Int = closure square {}
  let %1: Int = call square.1(7)
  do call printInt.1(%1)
  let add3.1: Fun(a: Int b: Int c: Int): Int = closure add3 {}
  let %2: Int = call add3.1(10, 20, 30)
  do call printInt.1(%2)
  let sub.1: Fun(x: Int): Fun(y: Int): Int = closure sub {}
  let %3: Fun(y: Int): Int = call sub.1(100)
  let %4: Int = call %3(42)
  do call printInt.1(%4)
  let fact.1: Fun(n: Int): Int = closure fact {}
  let %5: Int = call fact.1(6)
  do call printInt.1(%5)
  let fib.1: Fun(n: Int): Int = closure fib {}
  let %6: Int = call fib.1(10)
  do call printInt.1(%6)
  let count: Int = 0
  let counter: Tuple var count: Int end = tuple(count)
  let increment.1: Fun(step: Int): Ok = closure increment {}
  do call increment.1(5)
  do call increment.1(10)
  let %7: Int = tuple_field(counter, 0)
  do call printInt.1(%7)
  let doubleVal.1: Fun(x: Int): Int = closure doubleVal {}
  let combine.1: Fun(a: Int b: Int): Int = closure combine {}
  let %8: Int = call combine.1(5, 3)
  do call printInt.1(%8)
}

