fun fact(n: Int): Int {
  let %1: Bool = prim <=(n, 1) @25:32
  if %1 { @25:29
    return 1 @25:29
  } else {
    let %2: Int = prim -(n, 1) @25:60
    let %3: Int = call fact.1(%2) @25:55
    let %4: Int = prim *(n, %3) @25:51
    return %4 @25:29
  }
}
fun fib(n.1: Int): Int {
  let %5: Bool = prim <=(n.1, 0) @29:8
  if %5 { @29:5
    return 0 @29:5
  } else {
    let %6: Bool = prim is(n.1, 1) @30:11
    if %6 { @30:11
      return 1 @30:11
    } else {
      let %7: Int = prim -(n.1, 1) @31:14
      let %8: Int = call fib.1(%7) @31:10
      let %9: Int = prim -(n.1, 2) @31:27
      let %10: Int = call fib.1(%9) @31:23
      let %11: Int = prim +(%8, %10) @31:10
      return %11 @30:11
    }
  }
}
