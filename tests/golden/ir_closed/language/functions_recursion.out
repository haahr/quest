import writer = "writer" : Writer
import conv = "conv" : Conv
fun fact(n: Int): Int {
  let %23: Bool = prim <=(n, 1)
  if %23 {
    return 1
  } else {
    let %24: Int = prim -(n, 1)
    let %25: Int = call fact.1(%24)
    let %26: Int = prim *(n, %25)
    return %26
  }
}
fun fib(n.1: Int): Int {
  let %27: Bool = prim <=(n.1, 0)
  if %27 {
    return 0
  } else {
    let %28: Bool = prim is(n.1, 1)
    if %28 {
      return 1
    } else {
      let %29: Int = prim -(n.1, 1)
      let %30: Int = call fib.1(%29)
      let %31: Int = prim -(n.1, 2)
      let %32: Int = call fib.1(%31)
      let %33: Int = prim +(%30, %32)
      return %33
    }
  }
}
main {
  let wOut: writer.T = member writer.output
  let %1: String = call conv.int(49)
  do call writer.putString(wOut, %1)
  let %2: Ok = call writer.putString(wOut, "\n")
  let %3: String = call conv.int(60)
  do call writer.putString(wOut, %3)
  let %4: Ok = call writer.putString(wOut, "\n")
  join contified2(%5: Int) {
    let %6: String = call conv.int(%5)
    do call writer.putString(wOut, %6)
    let %7: Ok = call writer.putString(wOut, "\n")
    let fact.1: Fun(n: Int): Int = closure fact {}
    let %8: Int = call fact.1(6)
    let %9: String = call conv.int(%8)
    do call writer.putString(wOut, %9)
    let %10: Ok = call writer.putString(wOut, "\n")
    let fib.1: Fun(n: Int): Int = closure fib {}
    let %11: Int = call fib.1(10)
    let %12: String = call conv.int(%11)
    do call writer.putString(wOut, %12)
    let %13: Ok = call writer.putString(wOut, "\n")
    let counter: Tuple var count: Int end = tuple(0)
    let %14: Int = tuple_field(counter, 0)
    let %15: Int = prim +(%14, 5)
    store counter.#0 := %15
    let %16: Int = tuple_field(counter, 0)
    let %17: Int = prim +(%16, 10)
    store counter.#0 := %17
    let %18: Int = tuple_field(counter, 0)
    let %19: String = call conv.int(%18)
    do call writer.putString(wOut, %19)
    let %20: Ok = call writer.putString(wOut, "\n")
    let %21: String = call conv.int(31)
    do call writer.putString(wOut, %21)
    let %22: Ok = call writer.putString(wOut, "\n")
  } in {
    var y: Int = 42
    loop contified1 {
      let y.1: Int = y
      let %34: Int = prim -(100, y.1)
      jump contified2(%34)
    }
  }
}

