import writer = "writer" : Writer
import conv = "conv" : Conv
fun printInt(x: Int): Ok {
  let %1: String = call conv.int(x)
  do call writer.putString(wOut?, %1)
  let %2: Ok = call writer.putString(wOut?, "\n")
  return %2
}
fun square(x.1: Int): Int {
  let %3: Int = prim *(x.1, x.1)
  return %3
}
fun add3(a: Int, b: Int, c: Int): Int {
  let %4: Int = prim +(b, c)
  let %5: Int = prim +(a, %4)
  return %5
}
fun f {env}(y: Int): Int {
  let x.2: Int = env_field(env, 0)
  let %6: Int = prim -(x.2, y)
  return %6
}
fun sub(x.3: Int): Fun(y: Int): Int {
  let f.1: Fun(y: Int): Int = closure f {x.3}
  return f.1
}
fun fact(n: Int): Int {
  join k1(r: Int) {
    return r
  } in {
    let %7: Bool = prim <=(n, 1)
    if %7 {
      jump k1(1)
    } else {
      let %8: Int = prim -(n, 1)
      let %9: Int = call fact?(%8)
      let %10: Int = prim *(n, %9)
      jump k1(%10)
    }
  }
}
fun fib(n.1: Int): Int {
  join k2(r.1: Int) {
    return r.1
  } in {
    let %11: Bool = prim <=(n.1, 0)
    if %11 {
      jump k2(0)
    } else {
      join k3(r.2: Int) {
        jump k2(r.2)
      } in {
        let %12: Bool = prim is(n.1, 1)
        if %12 {
          jump k3(1)
        } else {
          let %13: Int = prim -(n.1, 1)
          let %14: Int = call fib?(%13)
          let %15: Int = prim -(n.1, 2)
          let %16: Int = call fib?(%15)
          let %17: Int = prim +(%14, %16)
          jump k3(%17)
        }
      }
    }
  }
}
fun increment(step: Int): Ok {
  let %18: Int = prim +(count?, step)
  count? := %18
  return ok
}
fun doubleVal(x.4: Int): Int {
  let %19: Int = prim +(x.4, x.4)
  return %19
}
fun combine(a.1: Int, b.1: Int): Int {
  let %20: Int = call square?(a.1)
  let %21: Int = call doubleVal?(b.1)
  let %22: Int = prim +(%20, %21)
  return %22
}
main {
  let wOut: writer.T = member writer.output
  let printInt.1: Fun(x: Int): Ok = closure printInt {}
  let square.1: Fun(x: Int): Int = closure square {}
  let %23: Int = call square.1(7)
  do call printInt.1(%23)
  let add3.1: Fun(a: Int b: Int c: Int): Int = closure add3 {}
  let %24: Int = call add3.1(10, 20, 30)
  do call printInt.1(%24)
  let sub.1: Fun(x: Int): Fun(y: Int): Int = closure sub {}
  let %25: Fun(y: Int): Int = call sub.1(100)
  let %26: Int = call %25(42)
  do call printInt.1(%26)
  let fact.1: Fun(n: Int): Int = closure fact {}
  let %27: Int = call fact.1(6)
  do call printInt.1(%27)
  let fib.1: Fun(n: Int): Int = closure fib {}
  let %28: Int = call fib.1(10)
  do call printInt.1(%28)
  var count: Int = 0
  let increment.1: Fun(step: Int): Ok = closure increment {}
  do call increment.1(5)
  do call increment.1(10)
  do call printInt.1(count)
  let doubleVal.1: Fun(x: Int): Int = closure doubleVal {}
  let combine.1: Fun(a: Int b: Int): Int = closure combine {}
  let %29: Int = call combine.1(5, 3)
  do call printInt.1(%29)
}

