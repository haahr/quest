fun fact(n: Int): Int {
  let %23: Bool = prim <=(n, 1) @26:8
  if %23 { @26:5
    return 1 @26:5
  } else {
    let %24: Int = prim -(n, 1) @26:36
    let %25: Int = call fact.1(%24) @26:31
    let %26: Int = prim *(n, %25) @26:27
    return %26 @26:5
  }
}
fun fib(n.1: Int): Int {
  let %27: Bool = prim <=(n.1, 0) @30:8
  if %27 { @30:5
    return 0 @30:5
  } else {
    let %28: Bool = prim is(n.1, 1) @31:11
    if %28 { @31:11
      return 1 @31:11
    } else {
      let %29: Int = prim -(n.1, 1) @32:14
      let %30: Int = call fib.1(%29) @32:10
      let %31: Int = prim -(n.1, 2) @32:27
      let %32: Int = call fib.1(%31) @32:23
      let %33: Int = prim +(%30, %32) @32:10
      return %33 @31:11
    }
  }
}
