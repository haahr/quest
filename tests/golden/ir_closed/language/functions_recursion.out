import writer = "writer" : Writer
import conv = "conv" : Conv
fun fact(n: Int): Int {
  let %1: Bool = prim <=(n, 1) @26:8
  if %1 { @26:5
    return 1 @26:5
  } else {
    let %2: Int = prim -(n, 1) @26:36
    let %3: Int = call fact.1(%2) @26:31
    let %4: Int = prim *(n, %3) @26:27
    return %4 @26:5
  }
}
fun fib(n.1: Int): Int {
  let %5: Bool = prim <=(n.1, 0) @30:8
  if %5 { @30:5
    return 0 @30:5
  } else {
    let %6: Bool = prim is(n.1, 1) @31:11
    if %6 { @31:11
      return 1 @31:11
    } else {
      let %7: Int = prim -(n.1, 1) @32:14
      let %8: Int = call fib.1(%7) @32:10
      let %9: Int = prim -(n.1, 2) @32:27
      let %10: Int = call fib.1(%9) @32:23
      let %11: Int = prim +(%8, %10) @32:10
      return %11 @31:11
    }
  }
}
