import writer = "writer" : Writer
import list = "list" : List
main {
  let %1: list.T(Int) = type_app list.nil [Int]
  let %2: list.T(Int) = call list.cons [Int](2, %1)
  let two: list.T(Int) = call list.cons [Int](1, %2)
  let %3: Int = call list.length [Int](two)
  let %4: Int = call list.length [Int](two)
  let %5: writer.T = call writer.file("unused.txt")
  do call writer.close(%5)
  let %6: Int = call list.length [Int](two)
}

