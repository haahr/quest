main {
  let plus: Fun(a: Int b: Int): Int = builtin + @6:13
  let b: Int = call plus(1, 2) @7:9
  let op: Fun(x: Int y: Int): Int = plus @9:17
  let %1: Int = call op(15, 25) @8:56
  let less: Fun(a: Int b: Int): Bool = builtin < @10:13
  let lessRes: Bool = call less(10, 20) @11:15
  join contified2(curriedRes: Int) {
    let %2: Bool = prim is(curriedRes, 7) @47:9
    let %3: Bool = prim /\(true, %2) @46:9
  } in {
    var x: Int = 5 @36:18
    loop contified1 {
      let x.1: Int = x
      let %4: Int = prim +(x.1, 1) @35:24
      let %5: Int = prim +(%4, 1) @35:24
      jump contified2(%5)
    }
  }
}

