main {
  let plus: Fun(a: Int b: Int): Int = builtin +
  let b: Int = call plus(1, 2)
  let op: Fun(x: Int y: Int): Int = plus
  let %1: Int = call op(15, 25)
  let less: Fun(a: Int b: Int): Bool = builtin <
  let lessRes: Bool = call less(10, 20)
  join contified2(curriedRes: Int) {
    let %2: Bool = prim is(curriedRes, 7)
    let %3: Bool = prim /\(true, %2)
  } in {
    var x: Int = 5
    loop contified1 {
      let x.1: Int = x
      let %4: Int = prim +(x.1, 1)
      let %5: Int = prim +(%4, 1)
      jump contified2(%5)
    }
  }
}

