fun bump(c.1: Counter): Ok {
  inspect c.1 {
    case Car exact (x.5: Tuple a: Car var count: Int end): {
      let %75: Int = tuple_field(x.5, 1)
      let %76: Car = tuple_field(x.5, 0)
      let %77: Int = record_field(%76, age)
      let %78: Int = prim +(%75, %77)
      store x.5.#1 := %78
    }
    case Object exact (x.6: Tuple a: Object var count: Int end): {
      let %79: Int = tuple_field(x.6, 1)
      let %80: Int = prim +(%79, 1)
      store x.6.#1 := %80
    }
  }
  return ok
}
main {
