fun fibPair(n.2: Int): unboxed(Tuple a: Int b: Int end) {
  let %42: Bool = prim is(n.2, 0)
  if %42 {
    let %43: unboxed(Tuple a: Int b: Int end) = tuple(0, 1)
    return %43
  } else {
    let %44: Int = prim -(n.2, 1)
    let p: unboxed(Tuple a: Int b: Int end) = call fibPair.1(%44)
    let a: Int = tuple_field(p, 1)
    let %45: Int = tuple_field(p, 0)
    let %46: Int = tuple_field(p, 1)
    let b: Int = prim +(%45, %46)
    let %47: unboxed(Tuple a: Int b: Int end) = tuple(a, b)
    return %47
  }
}
fun named(n.3: Int): unboxed(Tuple name: String even: Bool end) {
  let %48: Bool = prim <=(n.3, 1)
  if %48 {
    let name: String = "x"
    let even: Bool = prim is(n.3, 0)
