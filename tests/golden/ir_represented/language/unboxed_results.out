    let %50: Int = prim -(n.3, 2)
    let r.1: unboxed(Tuple name: String even: Bool end) = call named.1(%50)
    let %51: String = tuple_field(r.1, 0)
    let name.1: String = prim <>(%51, "x")
    let even.1: Bool = tuple_field(r.1, 1)
    let %52: unboxed(Tuple name: String even: Bool end) = tuple(name.1, even.1)
    return %52
  }
}
fun one(n.4: Int): unboxed(Tuple total: Int end) {
  let %53: Bool = prim is(n.4, 0)
  if %53 {
    let %54: unboxed(Tuple total: Int end) = tuple(0)
    return %54
  } else {
    let %55: Int = prim -(n.4, 1)
    let t: unboxed(Tuple total: Int end) = call one.1(%55)
    let %56: Int = tuple_field(t, 0)
    let total: Int = prim +(%56, n.4)
    let %57: unboxed(Tuple total: Int end) = tuple(total)
    return %57
  }
}
