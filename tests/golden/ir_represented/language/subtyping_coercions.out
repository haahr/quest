import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output
  let bt: BigTuple = tuple(10, 20, 30)
  let bt.1: SmallTuple = convert(bt, cast)
  let t: SmallTuple = bt.1
  let %1: Int = tuple_field(t, 0)
  let %2: Int = tuple_field(t, 1)
  let %3: Int = prim +(%1, %2)
  let %4: String = call conv.int(%3)
  do call writer.putString(wOut, %4)
  let %5: Ok = call writer.putString(wOut, "\n")
  let br_box: box(BigRec) = record(x = 100, y = 200, z = 300)
  let br: BigRec = convert(br_box, slot_unbox)
  let br.1: SmallRec = convert(br, record_view)
  let r: SmallRec = br.1
  let %6: Int = record_field(r, x)
  let %7: Int = record_field(r, y)
  let %8: Int = prim +(%6, %7)
  let %9: String = call conv.int(%8)
  do call writer.putString(wOut, %9)
  let %10: Ok = call writer.putString(wOut, "\n")
  let permuted_box: box(Record b: Int a: Int end) = record(b = 4, a = 7)
  let permuted: Record b: Int a: Int end = convert(permuted_box, slot_unbox)
  let r.1: OrderedRec = permuted
  let %11: Int = record_field(r.1, a)
  let %12: Int = record_field(r.1, b)
  let %13: Int = prim +(10, %12)
  let %14: Int = prim *(%11, %13)
  let %15: String = call conv.int(%14)
  do call writer.putString(wOut, %15)
  let %16: Ok = call writer.putString(wOut, "\n")
  let br.2: SmallRec = convert(br, record_view)
  let r.2: SmallRec = br.2
  let %17: Int = record_field(r.2, x)
  let %18: Int = record_field(r.2, y)
  let %19: Int = prim +(%17, %18)
  let %20: String = call conv.int(%19)
  do call writer.putString(wOut, %20)
  let %21: Ok = call writer.putString(wOut, "\n")
}

