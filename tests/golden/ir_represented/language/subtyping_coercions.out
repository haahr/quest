import writer = "writer" : Writer
import conv = "conv" : Conv
fun printInt(x.1: Int): Ok {
  let %5: String = call external "quest_conv_int"(x.1)
  do call writer.putString(wOut, %5)
  let %6: Ok = call writer.putString(wOut, "\n")
  return %6
}
fun getFirstTwo(t: SmallTuple): Int {
  let %7: Int = tuple_field(t, 0)
  let %8: Int = tuple_field(t, 1)
  let %9: Int = prim +(%7, %8)
  return %9
}
fun sumXY(r: SmallRec): Int {
  let %10: Int = record_field(r, x)
  let %11: Int = record_field(r, y)
  let %12: Int = prim +(%10, %11)
  return %12
}
fun getA(r.1: OrderedRec): Int {
  let %13: Int = record_field(r.1, a)
  let %14: Int = record_field(r.1, b)
  let %15: Int = prim +(10, %14)
  let %16: Int = prim *(%13, %15)
  return %16
}
fun applyRec(f: Fun(r: SmallRec): Int, r.2: BigRec): Int {
  let r.3: Record x: Int y: Int end = convert(r.2, record_view)
  let %17: Int = call f(r.3)
  return %17
}
main {
  let wOut: writer.T = member writer.output
  let printInt.1: Fun(x: Int): Ok = closure printInt {}
  let getFirstTwo.1: Fun(t: SmallTuple): Int = closure getFirstTwo {}
  let x: Int = 10
  let y: Int = 20
  let z: Int = 30
  let bt: BigTuple = tuple(x, y, z)
  let bt.1: Tuple x: Int y: Int end = convert(bt, cast)
  let %1: Int = call getFirstTwo.1(bt.1)
  do call printInt.1(%1)
  let sumXY.1: Fun(r: SmallRec): Int = closure sumXY {}
  let br_box: box(BigRec) = record(x = 100, y = 200, z = 300)
  let br: BigRec = convert(br_box, slot_unbox)
  let br.1: Record x: Int y: Int end = convert(br, record_view)
  let %2: Int = call sumXY.1(br.1)
  do call printInt.1(%2)
  let getA.1: Fun(r: OrderedRec): Int = closure getA {}
  let permuted_box: box(Record b: Int a: Int end) = record(b = 4, a = 7)
  let permuted: Record b: Int a: Int end = convert(permuted_box, slot_unbox)
  let %3: Int = call getA.1(permuted)
  do call printInt.1(%3)
  let applyRec.1: Fun(f: Fun(r: SmallRec): Int r: BigRec): Int = closure applyRec {}
  let %4: Int = call applyRec.1(sumXY.1, br)
  do call printInt.1(%4)
}

