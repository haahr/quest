import writer = "writer" : Writer
import conv = "conv" : Conv
main {
  let wOut: writer.T = member writer.output @6:12
  let %1: String = call conv.int(30) @9:31
  do call writer.putString(wOut, %1) @9:9
  let %2: Ok = call writer.putString(wOut, "\n") @10:9
  let br_box: box(BigRec) = record(x = 100, y = 200, z = 300) @24:18
  let br: BigRec = convert(br_box, slot_unbox)
  let br.1: SmallRec = convert(br, record_view)
  let r: SmallRec = br.1 @25:10
  let %3: Int = record_field(r, x) @23:31
  let %4: Int = record_field(r, y) @23:37
  let %5: Int = prim +(%3, %4) @23:31
  let %6: String = call conv.int(%5) @9:31
  do call writer.putString(wOut, %6) @9:9
  let %7: Ok = call writer.putString(wOut, "\n") @10:9
  let permuted_box: box(Record b: Int a: Int end) = record(b = 4, a = 7) @30:16
  let permuted: Record b: Int a: Int end = convert(permuted_box, slot_unbox)
  let %8: Int = record_field(permuted, a) @29:32
  let %9: Int = record_field(permuted, b) @29:43
  let %10: Int = prim +(10, %9) @29:38
  let %11: Int = prim *(%8, %10) @29:32
  let %12: String = call conv.int(%11) @9:31
  do call writer.putString(wOut, %12) @9:9
  let %13: Ok = call writer.putString(wOut, "\n") @10:9
  let br.2: SmallRec = convert(br, record_view)
  let r.1: SmallRec = br.2 @34:56
  let %14: Int = record_field(r.1, x) @23:31
  let %15: Int = record_field(r.1, y) @23:37
  let %16: Int = prim +(%14, %15) @23:31
  let %17: String = call conv.int(%16) @9:31
  do call writer.putString(wOut, %17) @9:9
  let %18: Ok = call writer.putString(wOut, "\n") @10:9
}

