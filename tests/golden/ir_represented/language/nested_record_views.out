import writer = "writer" : Writer
import conv = "conv" : Conv
import dynamic = "dynamic" : Dynamic
main {
  let big_box: box(Big) = record(a = 1, b = 2, c = 3)
  let big: Big = convert(big_box, slot_unbox)
  let outerBig_box: box(OuterBig) = record(inner = big_box, tag = 10)
  let outerBig: OuterBig = convert(outerBig_box, slot_unbox)
  let outerBig.1: OuterSmall = convert(outerBig, record_view)
  let outerSmall: OuterSmall = outerBig.1
  let %1: Small = record_field(outerSmall, inner) via stored types
  let %2: Int = record_field(%1, c)
  let %3: writer.T = member writer.output
  let %4: String = call conv.int(%2)
  let %5: String = prim <>(%4, "\n")
  let %6: Ok = call writer.putString(%3, %5)
  let outerBig.2: OuterSmall = convert(outerBig, record_view)
  let o: OuterSmall = outerBig.2
  let %7: Small = record_field(o, inner) via stored types
  let %8: Int = record_field(%7, c)
  let %9: Int = record_field(o, tag)
  let %10: Int = prim +(%8, %9)
  let %11: writer.T = member writer.output
  let %12: String = call conv.int(%10)
  let %13: String = prim <>(%12, "\n")
  let %14: Ok = call writer.putString(%11, %13)
  let deep_box: box(DeepSmall) = record(outer = outerBig_box) with runtime offsets
  let deep: DeepSmall = convert(deep_box, slot_unbox)
  let %15: OuterSmall = record_field(deep, outer) via stored types
  let %16: Small = record_field(%15, inner) via stored types
  let %17: Int = record_field(%16, c)
  let %18: writer.T = member writer.output
  let %19: String = call conv.int(%17)
  let %20: String = prim <>(%19, "\n")
  let %21: Ok = call writer.putString(%18, %20)
  let %22: VSmall = variant(two, 7)
  let hasVBig_box: box(HasVBig) = record(v = box %22) with runtime offsets
  let hasVBig: HasVBig = convert(hasVBig_box, slot_unbox)
  join k1(r: Int) {
    let %23: writer.T = member writer.output
    let %24: String = call conv.int(r)
    let %25: String = prim <>(%24, "\n")
    let %26: Ok = call writer.putString(%23, %25)
    let %27: Tuple r: Big end = tuple(big_box)
    let %28: OSmall = option(some, %27)
    let hasOBig_box: box(HasOBig) = record(o = %28) with runtime offsets
    let hasOBig: HasOBig = convert(hasOBig_box, slot_unbox)
    join k2(r.1: Int) {
      let %29: writer.T = member writer.output
      let %30: String = call conv.int(r.1)
      let %31: String = prim <>(%30, "\n")
      let %32: Ok = call writer.putString(%29, %31)
      let big.1: Record c: Int end = convert(big, record_view)
      let %33: Tuple r: Small n: Int end = tuple(box big.1, 4)
      let hasPairSmall_box: box(HasPairSmall) = record(pair = %33)
      let hasPairSmall: HasPairSmall = convert(hasPairSmall_box, slot_unbox)
      let %34: Tuple r: Small n: Int end = record_field(hasPairSmall, pair) via stored types
      let box: box(Small) = tuple_field(%34, 0) via proxy
      let %35: Small = convert(box, slot_unbox)
      let %36: Int = record_field(%35, c)
      let %37: Tuple r: Small n: Int end = record_field(hasPairSmall, pair) via stored types
      let %38: Int = tuple_field(%37, 1) via original
      let %39: Int = prim +(%36, %38)
      let %40: writer.T = member writer.output
      let %41: String = call conv.int(%39)
      let %42: String = prim <>(%41, "\n")
      let %43: Ok = call writer.putString(%40, %42)
      let outerBig.3: OuterSmall = convert(outerBig, record_view)
      let outerBig.4: A = convert(outerBig.3, box)
      let d: T = call dynamic.new [OuterSmall](outerBig.4)
      let fromDynamic: A = call dynamic.be [OuterSmall](d)
      let fromDynamic_box: box(OuterSmall) = convert(fromDynamic, unbox)
      let fromDynamic.1: OuterSmall = convert(fromDynamic_box, slot_unbox)
      let fromDynamic.2: OuterSmall = fromDynamic.1
      let %44: Small = record_field(fromDynamic.2, inner) via stored types
      let %45: Int = record_field(%44, c)
      let %46: writer.T = member writer.output
      let %47: String = call conv.int(%45)
      let %48: String = prim <>(%47, "\n")
      let %49: Ok = call writer.putString(%46, %48)
      let %50: writer.T = member writer.output
      do call dynamic.extern(%50, d)
      let %51: writer.T = member writer.output
      do call writer.putString(%51, "\n")
      let outerBig.5: OuterSmall = convert(outerBig, record_view)
      let x: OuterSmall = outerBig.5
      let %52: Small = record_field(x, inner) via stored types
      let %53: Int = record_field(%52, c)
      let %54: Int = record_field(x, tag)
      let %55: Int = prim +(%53, %54)
      let %56: writer.T = member writer.output
      let %57: String = call conv.int(%55)
      let %58: String = prim <>(%57, "\n")
      let %59: Ok = call writer.putString(%56, %58)
    } in {
      let %60: OBig = record_field(hasOBig, o) via stored types
      switch tag(%60) via proxy {
        case some (s: Tuple r: Small end) via (proxy): {
          let box.1: box(Small) = tuple_field(s, 0) via proxy
          let %61: Small = convert(box.1, slot_unbox)
          let %62: Int = record_field(%61, c)
          jump k2(%62)
        }
        case none, other: {
          jump k2(0)
        }
      }
    }
  } in {
    let %63: VBig = record_field(hasVBig, v) via stored types
    switch tag(%63) {
      case one (n: Int): {
        let %64: Int = prim -(0, n)
        jump k1(%64)
      }
      case two (n.1: Int): {
        jump k1(n.1)
      }
    }
  }
}

