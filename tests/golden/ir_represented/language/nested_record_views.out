import writer = "writer" : Writer
import conv = "conv" : Conv
import dynamic = "dynamic" : Dynamic
main {
  let big_box: box(Big) = record(a = 1, b = 2, c = 3) @12:16
  let big: Big = convert(big_box, slot_unbox)
  let outerBig_box: box(OuterBig) = record(inner = big_box, tag = 10) @17:26
  let outerBig: OuterBig = convert(outerBig_box, slot_unbox)
  let outerBig.1: OuterSmall = convert(outerBig, record_view)
  let outerSmall: OuterSmall = outerBig.1 @18:30
  let %1: Small = record_field(outerSmall, inner) via stored types @19:3
  let %2: Int = record_field(%1, c) @19:3
  let %3: writer.T = member writer.output @8:38
  let %4: String = call conv.int(%2) @8:52
  let %5: String = prim <>(%4, "\n") @8:52
  let %6: Ok = call writer.putString(%3, %5) @8:21
  let outerBig.2: OuterSmall = convert(outerBig, record_view)
  let o: OuterSmall = outerBig.2 @21:3
  let %7: Small = record_field(o, inner) via stored types @20:34
  let %8: Int = record_field(%7, c) @20:34
  let %9: Int = record_field(o, tag) @20:46
  let %10: Int = prim +(%8, %9) @20:34
  let %11: writer.T = member writer.output @8:38
  let %12: String = call conv.int(%10) @8:52
  let %13: String = prim <>(%12, "\n") @8:52
  let %14: Ok = call writer.putString(%11, %13) @8:21
  let deep_box: box(DeepSmall) = record(outer = outerBig_box) with runtime offsets @26:23
  let deep: DeepSmall = convert(deep_box, slot_unbox)
  let %15: OuterSmall = record_field(deep, outer) via stored types @27:3
  let %16: Small = record_field(%15, inner) via stored types @27:3
  let %17: Int = record_field(%16, c) @27:3
  let %18: writer.T = member writer.output @8:38
  let %19: String = call conv.int(%17) @8:52
  let %20: String = prim <>(%19, "\n") @8:52
  let %21: Ok = call writer.putString(%18, %20) @8:21
  let %22: VSmall = variant(two, 7) @34:35
  let hasVBig_box: box(HasVBig) = record(v = box %22) with runtime offsets @34:24
  let hasVBig: HasVBig = convert(hasVBig_box, slot_unbox)
  join k1(r: Int) {
    let %23: writer.T = member writer.output @8:38
    let %24: String = call conv.int(r) @8:52
    let %25: String = prim <>(%24, "\n") @8:52
    let %26: Ok = call writer.putString(%23, %25) @8:21
    let %27: Tuple r: Big end = tuple(big_box) @42:35
    let %28: OSmall = option(some, %27) @42:35
    let hasOBig_box: box(HasOBig) = record(o = %28) with runtime offsets @42:24
    let hasOBig: HasOBig = convert(hasOBig_box, slot_unbox)
    join k2(r.1: Int) {
      let %29: writer.T = member writer.output @8:38
      let %30: String = call conv.int(r.1) @8:52
      let %31: String = prim <>(%30, "\n") @8:52
      let %32: Ok = call writer.putString(%29, %31) @8:21
      let big.1: Record c: Int end = convert(big, record_view)
      let %33: Tuple r: Small n: Int end = tuple(box big.1, 4) @48:48
      let hasPairSmall_box: box(HasPairSmall) = record(pair = %33) @48:34
      let hasPairSmall: HasPairSmall = convert(hasPairSmall_box, slot_unbox)
      let %34: Tuple r: Small n: Int end = record_field(hasPairSmall, pair) via stored types @49:3
      let box: box(Small) = tuple_field(%34, 0) via proxy @49:3
      let %35: Small = convert(box, slot_unbox)
      let %36: Int = record_field(%35, c) @49:3
      let %37: Tuple r: Small n: Int end = record_field(hasPairSmall, pair) via stored types @49:27
      let %38: Int = tuple_field(%37, 1) via original @49:27
      let %39: Int = prim +(%36, %38) @49:3
      let %40: writer.T = member writer.output @8:38
      let %41: String = call conv.int(%39) @8:52
      let %42: String = prim <>(%41, "\n") @8:52
      let %43: Ok = call writer.putString(%40, %42) @8:21
      let outerBig.3: OuterSmall = convert(outerBig, record_view)
      let outerBig.4: A = convert(outerBig.3, box)
      let d: T = call dynamic.new [OuterSmall](outerBig.4) @52:9
      let fromDynamic: A = call dynamic.be [OuterSmall](d) @53:31
      let fromDynamic_box: box(OuterSmall) = convert(fromDynamic, unbox)
      let fromDynamic.1: OuterSmall = convert(fromDynamic_box, slot_unbox)
      let fromDynamic.2: OuterSmall = fromDynamic.1
      let %44: Small = record_field(fromDynamic.2, inner) via stored types @54:3
      let %45: Int = record_field(%44, c) @54:3
      let %46: writer.T = member writer.output @8:38
      let %47: String = call conv.int(%45) @8:52
      let %48: String = prim <>(%47, "\n") @8:52
      let %49: Ok = call writer.putString(%46, %48) @8:21
      let %50: writer.T = member writer.output @55:16
      do call dynamic.extern(%50, d) @55:1
      let %51: writer.T = member writer.output @56:18
      do call writer.putString(%51, "\n") @56:1
      let outerBig.5: OuterSmall = convert(outerBig, record_view)
      let x: OuterSmall = outerBig.5 @60:30
      let %52: Small = record_field(x, inner) via stored types @61:3
      let %53: Int = record_field(%52, c) @61:3
      let %54: Int = record_field(x, tag) @61:24
      let %55: Int = prim +(%53, %54) @61:3
      let %56: writer.T = member writer.output @8:38
      let %57: String = call conv.int(%55) @8:52
      let %58: String = prim <>(%57, "\n") @8:52
      let %59: Ok = call writer.putString(%56, %58) @8:21
    } in {
      let %60: OBig = record_field(hasOBig, o) via stored types @43:8
      switch tag(%60) via proxy { @43:3
        case some (s: Tuple r: Small end) via (proxy): {
          let box.1: box(Small) = tuple_field(s, 0) via proxy @43:40
          let %61: Small = convert(box.1, slot_unbox)
          let %62: Int = record_field(%61, c) @43:40
          jump k2(%62) @43:3
        }
        case none, other: {
          jump k2(0) @43:3
        }
      }
    }
  } in {
    let %63: VBig = record_field(hasVBig, v) via stored types @35:8
    switch tag(%63) { @35:3
      case one (n: Int): {
        let %64: Int = prim -(0, n) @35:39
        jump k1(%64) @35:3
      }
      case two (n.1: Int): {
        jump k1(n.1) @35:3
      }
    }
  }
}

