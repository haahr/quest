fun updatePoint [A::TYPE](out dest: A, src: A): Ok {
  dest := src
  return ok
}
fun updatePoint_spec(out dest.1: Point, src.1: Point): Ok {
  dest.1 := src.1
  return ok
}
fun swapPoly [A::TYPE](var a: A, var b: A): Ok {
  let tmp: A = a
  a := b
  b := tmp
  return ok
}
fun swapPoly_spec(var a.1: Point, var b.1: Point): Ok {
  let tmp.1: Point = a.1
  a.1 := b.1
  b.1 := tmp.1
  return ok
}
fun makePair [A::TYPE B::TYPE](a.2: A, b.2: B): Tuple first: A second: B end {
  let first: A = a.2
  let second: B = b.2
  let %33: Tuple first: A second: B end = tuple(first, second)
  return %33
}
fun makePair_spec(a.3: Point, b.3: String): Tuple first: Point second: String end {
  let first.1: Point = a.3
  let second.1: String = b.3
  let %34: Tuple first: Point second: String end = tuple(first.1, second.1)
  return %34
}
main {
  let updatePoint.1: All(A :: TYPE) Fun(out dest: A src: A): Ok = closure updatePoint {}
  let updatePoint_spec.1: Fun(out dest: Point src: Point): Ok = closure updatePoint_spec {}
  let %1: Record x: Int y: Int end = record(x = 10, y = 20)
  var p1: Record x: Int y: Int end = %1
  let p2: Record x: Int y: Int end = record(x = 30, y = 40)
  let %2: Var(Record x: Int y: Int end) = addr p1
  do call updatePoint_spec.1(%2, p2)
  let p1x: Int = record_field(p1, x)
  let p1y: Int = record_field(p1, y)
  let swapPoly.1: All(A :: TYPE) Fun(var a: A var b: A): Ok = closure swapPoly {}
  let swapPoly_spec.1: Fun(var a: Point var b: Point): Ok = closure swapPoly_spec {}
  let %3: Record x: Int y: Int end = record(x = 1, y = 2)
  var r1: Record x: Int y: Int end = %3
  let %4: Record x: Int y: Int end = record(x = 8, y = 9)
  var r2: Record x: Int y: Int end = %4
  let %5: Var(Record x: Int y: Int end) = addr r1
  let %6: Var(Record x: Int y: Int end) = addr r2
  do call swapPoly_spec.1(%5, %6)
  let r1x: Int = record_field(r1, x)
  let r2x: Int = record_field(r2, x)
  let assignClosure: All(A :: TYPE) Fun(out dest: A src: A): Ok = updatePoint.1
  let %7: Record x: Int y: Int end = record(x = 100, y = 200)
  var p3: Record x: Int y: Int end = %7
  let p4: Record x: Int y: Int end = record(x = 500, y = 600)
  let %8: Var(Record x: Int y: Int end) = addr p3
  var cell: A
  let %9: Out(A) = addr cell
  let p4.1: A = convert(p4, box)
  do call assignClosure [Point](%9, p4.1)
  let %10: A = cell
  let %11: Record x: Int y: Int end = convert(%10, unbox)
  store *%8 := %11
  let p3x: Int = record_field(p3, x)
  let p3y: Int = record_field(p3, y)
  let swapClosure: All(A :: TYPE) Fun(var a: A var b: A): Ok = swapPoly.1
  let %12: Record x: Int y: Int end = record(x = 111, y = 222)
  var s1: Record x: Int y: Int end = %12
  let %13: Record x: Int y: Int end = record(x = 333, y = 444)
  var s2: Record x: Int y: Int end = %13
  let %14: Var(Record x: Int y: Int end) = addr s1
  let %15: Var(Record x: Int y: Int end) = addr s2
  let %16: Record x: Int y: Int end = load %14
  let %17: A = convert(%16, box)
  var cell.1: A = %17
  let %18: Var(A) = addr cell.1
  let %19: Record x: Int y: Int end = load %15
  let %20: A = convert(%19, box)
  var cell.2: A = %20
  let %21: Var(A) = addr cell.2
  do call swapClosure [Point](%18, %21)
  let %22: A = cell.1
  let %23: Record x: Int y: Int end = convert(%22, unbox)
  store *%14 := %23
  let %24: A = cell.2
  let %25: Record x: Int y: Int end = convert(%24, unbox)
  store *%15 := %25
  let s1x: Int = record_field(s1, x)
  let s2x: Int = record_field(s2, x)
  let makePair.1: All(A :: TYPE B :: TYPE) Fun(a: A b: B): Tuple first: A second: B end = closure makePair {}
  let makePair_spec.1: Fun(a: Point b: String): Tuple first: Point second: String end = closure makePair_spec {}
  let pt1: Record x: Int y: Int end = record(x = 77, y = 88)
  let directPair: Tuple first: Point second: String end = call makePair_spec.1(pt1, "hello")
  let %26: Point = tuple_field(directPair, 0)
  let dpx: Int = record_field(%26, x)
  let %27: Point = tuple_field(directPair, 0)
  let dpy: Int = record_field(%27, y)
  let dps: String = tuple_field(directPair, 1)
  let pairClosure: All(A :: TYPE B :: TYPE) Fun(a: A b: B): Tuple first: A second: B end = makePair.1
  let pt2: Record x: Int y: Int end = record(x = 99, y = 101)
  let pt2.1: A = convert(pt2, box)
  let %28: B = convert(42, box)
  let closPair: Tuple first: A second: B end = call pairClosure [Point Int](pt2.1, %28)
  let closPair.1: Tuple first: Point second: Int end = convert(closPair, cast)
  let closPair.2: Tuple first: Point second: Int end = closPair.1
  let %29: Point = tuple_field(closPair.2, 0)
  let cpx: Int = record_field(%29, x)
  let %30: Point = tuple_field(closPair.2, 0)
  let cpy: Int = record_field(%30, y)
  let cpi: Int = tuple_field(closPair.2, 1)
  let p3d: Record x: Int y: Int z: Int end = record(x = 1, y = 2, z = 3)
  let pt: Record x: Int y: Int z: Int end = p3d
  let tag: String = "3D"
  let t3d: Tuple pt: Point3D tag: String end = tuple(pt, tag)
  let t3d.1: Tuple pt: Point tag: String end = convert(t3d, copy)
  let t2d: Tuple pt: Point tag: String end = t3d.1
  let %31: Point = tuple_field(t2d, 0)
  let t2dx: Int = record_field(%31, x)
  let %32: Point = tuple_field(t2d, 0)
  let t2dy: Int = record_field(%32, y)
  let t2dtag: String = tuple_field(t2d, 1)
}

