main {
  let box: box(Record x: Int y: Int end) = record(x = 10, y = 20) @10:14
  let %1: Record x: Int y: Int end = convert(box, slot_unbox)
  var p1: Record x: Int y: Int end = %1 @10:1
  let p2_box: box(Record x: Int y: Int end) = record(x = 30, y = 40) @11:10
  let p2: Record x: Int y: Int end = convert(p2_box, slot_unbox)
  let src: Point = p2 @12:1
  p1 := src @8:5
  let box.1: box(Record x: Int y: Int end) = record(x = 1, y = 2) @23:14
  let %2: Record x: Int y: Int end = convert(box.1, slot_unbox)
  var r1: Record x: Int y: Int end = %2 @23:1
  let box.2: box(Record x: Int y: Int end) = record(x = 8, y = 9) @24:14
  let %3: Record x: Int y: Int end = convert(box.2, slot_unbox)
  var r2: Record x: Int y: Int end = %3 @24:1
  let tmp: Point = r1 @18:19
  r1 := r2 @19:9
  r2 := tmp @20:9
  let box.3: box(Record x: Int y: Int end) = record(x = 100, y = 200) @31:14
  let %4: Record x: Int y: Int end = convert(box.3, slot_unbox)
  var p3: Record x: Int y: Int end = %4 @31:1
  let p4_box: box(Record x: Int y: Int end) = record(x = 500, y = 600) @32:10
  let p4: Record x: Int y: Int end = convert(p4_box, slot_unbox)
  let src.1: Point = p4 @33:1
  p3 := src.1 @8:5
  let box.4: box(Record x: Int y: Int end) = record(x = 111, y = 222) @38:14
  let %5: Record x: Int y: Int end = convert(box.4, slot_unbox)
  var s1: Record x: Int y: Int end = %5 @38:1
  let box.5: box(Record x: Int y: Int end) = record(x = 333, y = 444) @39:14
  let %6: Record x: Int y: Int end = convert(box.5, slot_unbox)
  var s2: Record x: Int y: Int end = %6 @39:1
  let tmp.1: Point = s1 @18:19
  s1 := s2 @19:9
  s2 := tmp.1 @20:9
}

