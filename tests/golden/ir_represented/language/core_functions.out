fun factorial(n: Int): Int {
  let %10: Bool = prim is(n, 0)
  if %10 {
    return 1
  } else {
    let %11: Int = prim -(n, 1)
    let %12: Int = call factorial.1(%11)
    let %13: Int = prim *(n, %12)
    return %13
  }
}
