fun id [X::TYPE](x.2: X): X {
  return x.2
}
fun factorial(n: Int): Int {
  join k1(r: Int) {
    return r
  } in {
    let %32: Bool = prim is(n, 0)
    if %32 {
      jump k1(1)
    } else {
      let %33: Int = prim -(n, 1)
      let %34: Int = call factorial.1(%33)
      let %35: Int = prim *(n, %34)
      jump k1(%35)
    }
  }
}
main {
