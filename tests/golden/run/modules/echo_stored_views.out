Let Mid::TYPE = Record a: Int end
Let Big::TYPE = Record a: Int b: Int end
let big:Big = record a=1 b=2 end
let r:Record f: Mid g: Int end = record f=record a=1 end g=7 end
record f=record a=1 end g=7 end : Record f: Mid g: Int end
Let Nest::TYPE = Auto A :: TYPE with a: A inner: Auto B :: TYPE with b: B a2: A end end
let n:Nest = auto :Int with a=5 inner=auto :String with b="s" a2=6 end end
auto :Int with a=5 inner=auto :String with b="s" a2=6 end end : Nest
let held:Tuple p: small.P end = tuple p=<hidden> end
tuple p=<hidden> end : Tuple p: small.P end
