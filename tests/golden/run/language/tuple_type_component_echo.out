let t:Tuple Let A::TYPE = Int x: Int end = tuple Let A = Int x=1 end
let empty:Tuple Let A::TYPE = Bool end = tuple Let A = Bool end
let between:Tuple a: Int Let B::TYPE = Char b: Char Let C::TYPE = String end = tuple a=1 Let B = Char b='b' Let C = String end
let nested:Tuple a: Int b: Tuple Let B::TYPE = Bool y: Bool end end = tuple a=1 b=tuple Let B = Bool y=true end end
let arr:Array(Tuple Let A::TYPE = Int x: Int end) = array of tuple Let A = Int x=1 end tuple Let A = Int x=1 end end
let rec1:Record f: Tuple Let A::TYPE = Int x: Int end g: Int end = record f=tuple Let A = Int x=1 end g=2 end
Let O::TYPE = Option none some with Tuple Let K::TYPE = Int k: K end end
let opt:O = option some with tuple Let K = Int k=2 end end
Let E::TYPE = Tuple A::TYPE x: A end
let p:E = tuple <Hidden>::TYPE x=<hidden> end
let inE:Tuple a: Int p: E end = tuple a=1 p=tuple <Hidden>::TYPE x=<hidden> end end
Let P::TYPE = Tuple a: Int end
let q:Tuple Let N::TYPE = P k: Int end = tuple Let N = P k=1 end
let r:Tuple Let N::TYPE = Tuple a: Int end k: Int end = tuple Let N = Tuple a: Int end k=1 end
let qr:Array(Tuple Let N::TYPE = Tuple a: Int end k: Int end) = array of tuple Let N = Tuple a: Int end k=1 end tuple Let N = Tuple a: Int end k=1 end end
let inQ:Tuple q: Tuple Let N::TYPE = P k: Int end r: Tuple Let N::TYPE = Tuple a: Int end k: Int end end = tuple q=tuple Let N = P k=1 end r=tuple Let N = Tuple a: Int end k=1 end end
Let L::TYPE = Rec(L :: TYPE) Option nil cons with Tuple h: Int t: L end end
let s:Tuple Let M::TYPE = L l: L end = tuple Let M = L l=option nil end end
