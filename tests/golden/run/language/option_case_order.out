Let O1::TYPE = Option a b end
Let O2::TYPE = Option b a end
Let O3::TYPE = Option b c a end
let o:O1 = option b end
let p:O2 = option b end
let p3:O3 = option b end
let ordinals:Tuple :Int :Int :Int end = tuple 1 0 0 end
Let V1::TYPE = Variant a: Int b: Bool end
Let V2::TYPE = Variant b: Bool a: Int end
let v:V1 = variant b with true end
let w:V2 = variant b with true end
let viaW:Int = 2
let back:V1 = variant b with true end
let viaBack:Int = 3
Let P1::TYPE = Option a b c end
Let P2::TYPE = Option c a b end
let q:P2 = option b end
let r:P1 = option b end
let k:Int = 1
let s:P2 = option a end
let made:Tuple :Int :Int :Int end = tuple 2 1 1 end
let fromQ:Tuple :Int end = tuple 2 end
let fromR:Tuple :Int end = tuple 1 end
let ord:All(A <: Option b a end) Fun(x: A): Int = <fun>
let generic:Tuple :Int :Int end = tuple 0 0 end
