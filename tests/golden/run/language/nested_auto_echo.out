Let Nest::TYPE = Auto A :: TYPE with a: A inner: Auto B :: TYPE with b: B a2: A end end
let n:Nest = auto :Int with a=5 inner=auto :String with b="s" a2=6 end end
auto :Int with a=5 inner=auto :String with b="s" a2=6 end end : Nest
Let Deep::TYPE = Auto A :: TYPE with a: A mid: Auto B :: TYPE with b: B low: Auto C :: TYPE with c: C aa: Array(A) bs: Tuple x: B end end end end
let d:Deep = auto :Bool with a=true mid=auto :Char with b='x' low=auto :Real with c=1.5 aa=array of false true end bs=tuple x='y' end end end end
