Let Sub::TYPE = Variant z: Int end
Let Super::TYPE = Variant a: Int z: Int end
let var x:Sub = variant z with 1 end
let var y:Super = variant z with 1 end
let var z:Super = variant a with 1 end
tuple xy=true xz=false yx=true zx=true end : Tuple xy: Bool xz: Bool yx: Bool zx: Bool end
Let Few::TYPE = Option q end
Let Many::TYPE = Option p q end
let var f:Few = option q end
let var m:Many = option q end
let var n:Many = option p end
tuple fm=true fn=false mf=true nf=true end : Tuple fm: Bool fn: Bool mf: Bool nf: Bool end
