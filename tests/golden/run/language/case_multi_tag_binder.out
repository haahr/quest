Let Move::TYPE = Option north with Tuple steps: Int end south with Tuple steps: Int end stay end
let distance:Fun(m: Move): Int = <fun>
let distances:Tuple :Int :Int end = tuple 3 4 end
Let Shape::TYPE = Option square with Tuple side: Int end circle with Tuple side: Int r: Int end rect with Tuple side: Int w: Int end end
let side:Fun(s: Shape): Int = <fun>
let sides:Tuple :Int :Int :Int end = tuple 2 3 4 end
Let V::TYPE = Variant a: Record x: Int y: Int end b: Record y: Bool z: Int x: Int end c: Int end
let getX:Fun(v: V): Int = <fun>
let xs:Tuple :Int :Int :Int end = tuple 1 8 9 end
