let t:Tuple x: Int y: Real end = tuple x=10 y=2.5 end
let t2:Tuple :Int :Char :String end = tuple 1 'c' "s\n" end
let et:Tuple end = tuple end
let p:Record y: Int x: Int end = record x=30 y=40 end
let er:Record end = record end
let nested:Record pos: Record x: Int y: Int end var count: Int f: Fun(x: Int): Int end = record count=0 f=<fun> pos=record x=5 y=7 end end
record n=record count=0 f=<fun> pos=record x=5 y=7 end end end : Record n: Record pos: Record x: Int y: Int end var count: Int f: Fun(x: Int): Int end end
Let Huge::TYPE = Record a: Int b: Real c: String d: Char end
Let Mid::TYPE = Record c: String d: Char end
let huge:Huge = record a=1 b=1.5 c="q\"x" d='\t' end
let mid:Mid = record c="q\"x" d='\t' end
let rm:Record m: Mid end = record m=record c="q\"x" d='\t' end end
let var tv:Tuple var x: Int y: Char end = tuple x=1 y='z' end
tuple x=5 y='z' end : Tuple var x: Int y: Char end
let arr:Array(Int) = array of 1 2 3 end
let e:Array(Int) = array of end
let arr2:Array(Record a: Int end) = array of record a=1 end record a=2 end end
let tups:Array(Tuple :Int :String end) = array of tuple 1 "a" end tuple 2 "b" end end
let arrs:Array(Array(Int)) = array of array of 1 end array of end end
Let Traffic::TYPE = Option red yellow green end
let c:Traffic = option yellow end
Let Color::TYPE = Option red blue with Tuple intensity: Int end end
let c2:Color = option blue with tuple intensity=42 end end
Let Shape::TYPE = Variant circle: Real square: Record side: Int end none: Ok end
let s1:Shape = variant square with record side=3 end end
let s2:Shape = variant none end
let shapes:Array(Shape) = array of variant square with record side=3 end end variant none end variant circle with 2.0 end end
Let Node::TYPE = Rec(Node :: TYPE) Record v: Int kids: Array(Node) end
let leaf:Node = record kids=array of end v=2 end
let n1:Node = record kids=array of record kids=array of end v=2 end record kids=array of end v=2 end end v=1 end
Let IntList::TYPE = Rec(IntList :: TYPE) Option nil cons with Tuple head: Int tail: IntList end end
let il:IntList = option cons with tuple head=1 tail=option cons with tuple head=2 tail=option nil end end end end end
let wr:Record w: Word.T o: Writer.T l: list.T(Int) end = record l=<hidden> o=<hidden> w=16#a# end
let ex:Exception(Int) = exception Boom
let d:T = auto :Int with a=3 end
Let UniformPair::TYPE = Auto A :: TYPE with fst: A snd: A end
let up:UniformPair = auto :Int with fst=6 snd=7 end
let ur:UniformPair = auto :Record k: Int end with fst=record k=1 end snd=record k=2 end end
Let Pair::TYPE = Tuple fst: Int snd: Bool end
let ua:UniformPair = auto :Tuple fst: Int snd: Bool end with fst=tuple fst=1 snd=true end snd=tuple fst=2 snd=false end end
tuple a=tuple 1 2 end b=array of 1 2 3 end end : Tuple a: Tuple :Int :Int end b: Array(Int) end
