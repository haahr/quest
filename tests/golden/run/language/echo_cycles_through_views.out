Let Small::TYPE = Rec(Small :: TYPE) Record var link: Option none some with Tuple s: Small end end end
Let Big::TYPE = Record a: Int var link: Option none some with Tuple s: Small end end end
let b:Big = record a=1 link=option none end end
let s:Small = record link=option none end end
record a=1 link=option some with tuple s=record ... end end end end : Big
record link=option some with tuple s=record ... end end end end : Small
Let TB::TYPE = Rec(TB :: TYPE) Tuple x: Big var next: Option none some with Tuple t: TB end end end
Let TS::TYPE = Tuple x: Small var next: Option none some with Tuple t: TB end end end
let tb:TB = tuple x=record a=2 link=option none end end next=option none end end
let ts:TS = tuple x=record link=option none end end next=option none end end
tuple x=record link=option none end end next=option some with tuple t=tuple ... end end end end : TS
