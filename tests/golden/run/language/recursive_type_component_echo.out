Let P::TYPE = Tuple a: Int end
Let R::TYPE = Rec(R :: TYPE) Option nil cons with Tuple Let X::TYPE = P h: Int t: R end end
let rr:R = option cons with tuple Let X = P h=1 t=option nil end end end
let two:R = option cons with tuple Let X = P h=2 t=option cons with tuple Let X = P h=1 t=option nil end end end end end
Let Forest::TYPE = Rec(Forest :: TYPE) Record trees: Array(Tree) end
Let Tree::TYPE = Rec(Tree :: TYPE) Variant leaf: Tuple Let Y::TYPE = P y: Int end node: Forest end
let leaf:Tree = variant leaf with tuple Let Y = P y=3 end end
let forest:Forest = record trees=array of variant leaf with tuple Let Y = P y=3 end end variant node with record trees=array of variant leaf with tuple Let Y = P y=3 end end end end end end end
let anon:Rec(S :: TYPE) Option stop more with Tuple Let Z::TYPE = P s: S end end = option more with tuple Let Z = P s=option stop end end end
