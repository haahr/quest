Let Day::TYPE = Variant mon: Ok tue: Ok wed: Ok thu: Ok fri: Ok sat: Ok sun: Ok end
Let WeekDay::TYPE = Variant mon: Ok tue: Ok wed: Ok thu: Ok fri: Ok end
Let WeekendDay::TYPE = Variant sat: Ok sun: Ok end
let wd:WeekDay = variant mon end
let we:WeekendDay = variant sun end
let asDay:Day = variant mon end
let alsoDay:Day = variant sun end
let dayNum:Fun(x: WeekDay): Int = <fun>
1 : Int
true : Bool
false : Bool
Let Number::TYPE = Variant int: Int real: Real end
let n:Number = variant int with 42 end
true : Bool
false : Bool
42 : Int
Let Color::TYPE = Option red green blue with Tuple val: Int end end
let cRed:Color = option red end
let cBlue:Color = option blue with tuple val=100 end end
true : Bool
false : Bool
true : Bool
let redPayload:Tuple :Int end = tuple 0 end
let bluePayload:Tuple :Int val: Int end = tuple 2 val=100 end
100 : Int
