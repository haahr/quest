=== Test 1: Simple Let Binding ===
(Program
  :phrases (
    (LetValueBinding
      :name 'x'
      :value (ExprInt 42 '42')
      :type_annot (TypePath ('Int'))
    )
  )
)
=== Test 2: Recursive Fact Function ===
(Program
  :phrases (
    (LetValueBinding
      :name 'fact'
      :value (ExprIf
        :cond (ExprInfix
          :left (ExprId 'n')
          :op 'is'
          :right (ExprInt 0 '0')
        )
        :then_branch (ExprStmt
          :expr (ExprInt 1 '1')
        )
        :else_branch (ExprStmt
          :expr (ExprInfix
            :left (ExprId 'n')
            :op '*'
            :right (ExprApp
              :func (ExprId 'fact')
              :args (
                (ExprInfix
                  :left (ExprId 'n')
                  :op '-'
                  :right (ExprInt 1 '1')
                )
              )
            )
          )
        )
      )
      :params (
        (FormalParam
          :name 'n'
          :type_annot (TypePath ('Int'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Int'))
      :is_rec True
    )
  )
)
