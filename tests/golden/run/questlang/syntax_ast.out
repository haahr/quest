=== Test 1: Simple Let Binding ===
(Program
  :phrases (
    (LetValueBinding
      :name 'x'
      :value (ExprInt 42 '42')
      :type_annot (TypePath ('Int'))
    )
  )
)
=== Test 2: Recursive Fact Function ===
(Program
  :phrases (
    (LetValueBinding
      :name 'fact'
      :value (ExprIf
        :cond (ExprInfix
          :left (ExprId 'n')
          :op 'is'
          :right (ExprInt 0 '0')
        )
        :then_branch (ExprInt 1 '1')
        :else_branch (ExprInfix
          :left (ExprId 'n')
          :op '*'
          :right (ExprApp
            :func (ExprId 'fact')
            :args (
              (ExprInfix
                :left (ExprId 'n')
                :op '-'
                :right (ExprInt 1 '1')
              )
            )
          )
        )
      )
      :params (
        (FormalParam
          :name 'n'
          :type_annot (TypePath ('Int'))
          :mode VALUE
        )
      )
      :type_annot (TypePath ('Int'))
      :is_rec True
    )
  )
)
=== Test 3: Recursive Type Definition ===
(Program
  :phrases (
    (TypeBinding
      :name 'T'
      :type_val (TypeFun
        :params (
          (TypeFormal
            :name 'X'
            :bound (KindType)
          )
        )
        :result_kind (KindPower
          :bound (TypePath ('Int'))
        )
        :body (TypePath ('X'))
      )
      :is_rec True
      :is_def True
    )
  )
)
=== Test 4: Auto Value ===
(Program
  :phrases (
    (LetValueBinding
      :name 'p'
      :value (ExprAuto
        :witness_type (TypePath ('Int'))
        :payload (ExprTuple
          :fields (
            (TupleBinding
              :value (ExprInt 3 '3')
            )
          )
        )
        :witness_name 'A'
        :witness_bound (KindType)
      )
    )
  )
)
