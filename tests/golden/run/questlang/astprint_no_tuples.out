(Program
  :phrases (
    (LetValueBinding
      :name 'i'
      :value (ExprInt 42 '42')
    )
    (LetValueBinding
      :name 'r'
      :value (ExprReal -3.14 '~3.14')
    )
    (ExprStmt
      :expr (ExprInfix
        :left (ExprId 'i')
        :op '+'
        :right (ExprInt 1 '1')
      )
    )
  )
)
