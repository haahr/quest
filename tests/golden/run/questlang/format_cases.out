== indentation
let gcd(n: Int m: Int): Int =
    begin
        let var a = n
        while a isnot m do
            if a > m then a := a - m
            else m := m - a
            end
        end
        a
    end
== control
let f(x: Int): String =
    if x > 1 then
        "big"
    elsif x is 1 then
        "one"
    else
        "small"
    end
let g(x: Int): Int =
    case x
        when a then 10
        when b then
            f(x)
            20
        else 0
    end
let h(): Int =
