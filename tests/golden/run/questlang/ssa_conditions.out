== checks that stay: another array, and one not dominated
function others(%0: ptr, %1: ptr, %2: int): int {
b0(%0: ptr, %1: ptr, %2: int):
  %3: ptr = null
  %4: int = peq %0, %3
  branch %4, b5(), b1()
b1():
  %5: int = peq %1, %3
  branch %5, b5(), b2()
b2():
  branch %2, b3(), b4()
b3():
  %6: int = const 1
  return %6
b4():
  %7: int = const 2
  return %7
b5():
  %8: int = peq %0, %3
  branch %8, b6(), b7()
b6():
  unreachable
b7():
  %9: int = const 3
  return %9
}
