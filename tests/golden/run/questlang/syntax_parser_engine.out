a => [a]
a, b=c, (d, (e)), () => [a b=c [d [e]] ()@18-20]
( ) , begin ;; end => [()@0-3 block of 0]
 => error at 0-1: Expected '(', 'begin', or a name, found the end of the file
a b => error at 2-3: Expected ',' or '=', found 'b'
a, (b, c => error at 3-4: '(' has no matching ')'
a = 1 => error at 4-5: Expected a name, found '1'
begin ; ; => error at 0-5: 'begin' has no matching 'end'
a, "it's" => error at 3-9: Expected '(', 'begin', or a name, found '"it's"'
