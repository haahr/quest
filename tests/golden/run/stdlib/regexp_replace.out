a in "banana": 1-2 3-4 5-6
an in "banana": 1-3 3-5
x* in "abc": 0-0 1-1 2-2 3-3
a* in "baaac": 0-0 1-4 5-5
a*? in "aa": 0-0 1-1 2-2
\b in "hi there": 0-0 2-2 3-3 8-8
 in "": 0-0
(a)|b in "abab": 0-1 1-2 2-3 3-4
q in "abc":
a in "banana" by "o": first "bonana" all "bonono"
(\w+)@(\w+) in "me@here, you@there" by "$2 at $1": first "here at me, you@there" all "here at me, there at you"
(?P<k>\w+)=(?P<v>\w+) in "a=1 b=2" by "${v}:${k}": first "1:a b=2" all "1:a 2:b"
(\w) in "ab" by "$1x|${1}x": first "|axb" all "|ax|bx"
(a) in "a" by "[$$][$][$}][${][${a-}][$9][$01][$0]": first "[$][$][$}][${][${a-}][][][a]" all "[$][$][$}][${][${a-}][][][a]"
(a)|(b) in "ab" by "<$1$2>": first "<a>b" all "<a><b>"
x* in "abc" by "-": first "-abc" all "-a-b-c-"
a* in "baaac" by "-": first "-baaac" all "-b-c-"
q in "abc" by "-": first "abc" all "abc"
<3:two> <5:words>
, splits "a,b,,c,": [a] [b] [] [c] []
, splits ",a": [] [a]
, splits "": []
x* splits "abc": [a] [b] [c]
 splits "abc": [a] [b] [c]
 splits "":
\s+ splits "  two   words ": [] [two] [words] []
q splits "abc": [abc]
1\.5\*\[x\]\+\(y\)\? \{a\|b\} \^\$ \\ end
