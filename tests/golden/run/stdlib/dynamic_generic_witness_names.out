let f:All(A :: TYPE) Fun(x: A): Dynamic = <fun>
let g:All(A :: TYPE) Fun(x: A): Dynamic = <fun>
let pair:All(A :: TYPE B :: TYPE) Fun(a: A b: B): Dynamic = <fun>
let h:All(A :: TYPE B :: TYPE) Fun(a: A b: B): Dynamic = <fun>
auto :Tuple v: String w: Int end with a=tuple v="hi" w=1 end end : Dynamic
auto :Tuple first: Int second: Record r: Record r: Bool end end both: Tuple x: Int y: ... with a=tuple first=3 second=record r=record r=true end end both=tuple x=3 y=record r=true end end end end : Dynamic
auto :Tuple first: Array(Int) second: Record r: Tuple :Int end end both: Tuple x: Arra... with a=tuple first=array of 1 end second=record r=tuple 2 end end both=tuple x=array of 1 end y=tuple 2 end end end end : Dynamic
