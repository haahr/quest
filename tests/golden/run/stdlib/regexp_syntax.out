abc  =>  "abc"
a.b  =>  (cat "a" [\x00-\x09\x0b-\xff] "b")
\.\*\+\?\(\)\[\]\{\}\|\^\$\\  =>  ".*+?()[]{}|^$\\"
\t\n\r\f\v\a  =>  "\x09\x0a\x0d\x0c\x0b\x07"
\x41\x{42}\x{000043}\0\012\101  =>  "ABC\x00\x0aA"
a{  =>  "a{"
a{x}  =>  "a{x}"
a{2  =>  "a{2"
  =>  empty
[abc]  =>  [a-c]
[a-z0-9_]  =>  [0-9_a-z]
[^a-z]  =>  [\x00-`{-\xff]
[]a]  =>  [\]a]
[a-]  =>  [\-a]
[-a]  =>  [\-a]
[\d\s]  =>  [\x09\x0a\x0c\x0d\x200-9]
[^\D]  =>  [0-9]
[[:alpha:][:digit:]]  =>  [0-9A-Za-z]
[[:^space:]]  =>  [\x00-\x08\x0e-\x1f!-\xff]
[\x00-\x1f]  =>  [\x00-\x1f]
[[:]  =>  [:\[]
\d\w\s  =>  (cat [0-9] [0-9A-Z_a-z] [\x09\x0a\x0c\x0d\x20])
\D  =>  [\x00-/:-\xff]
[a]  =>  "a"
a*b+c?  =>  (cat (rep 0 inf "a") (rep 1 inf "b") (rep 0 1 "c"))
a*?b+?c??  =>  (cat (rep? 0 inf "a") (rep? 1 inf "b") (rep? 0 1 "c"))
a{3}b{2,}c{1,4}d{0,0}e{1,1}  =>  (cat (rep 3 3 "a") (rep 2 inf "b") (rep 1 4 "c") "e")
a{2,5}?  =>  (rep? 2 5 "a")
(?U)a*b*?  =>  (cat (rep? 0 inf "a") (rep 0 inf "b"))
(ab)*  =>  (rep 0 inf (cap "ab"))
^*  =>  (rep 0 inf textStart)
a|b|c  =>  (alt "a" "b" "c")
a|  =>  (alt "a" empty)
|  =>  (alt empty empty)
(a)(?:b)(?P<word>c)(?<other>d)  =>  (cat (cap "a") "b" (cap word "c") (cap other "d"))
((a)|b)+  =>  (rep 1 inf (cap (alt (cap "a") "b")))
(?i)Ab[x-z]  =>  (cat [Aa] [Bb] [X-Zx-z])
(?i)[^a]  =>  [\x00-@B-`b-\xff]
a(?i)b|c  =>  (alt (cat "a" [Bb]) [Cc])
(?i:a)b  =>  (cat [Aa] "b")
(?i)a(?-i)b  =>  (cat [Aa] "b")
(?s).(?-s).  =>  (cat [\x00-\xff] [\x00-\x09\x0b-\xff])
^a$  =>  (cat textStart "a" textEnd)
(?m)^a$  =>  (cat lineStart "a" lineEnd)
\A\z\b\B  =>  (cat textStart textEnd wordBoundary notWordBoundary)
(?ims-U:x)  =>  [Xx]
a**  =>  syntax error at 2: invalid nested repetition operator
a*+  =>  syntax error at 2: invalid nested repetition operator
*a  =>  syntax error at 0: missing argument to repetition operator
+  =>  syntax error at 0: missing argument to repetition operator
{2}  =>  syntax error at 0: missing argument to repetition operator
(a  =>  syntax error at 0: missing closing )
a)  =>  syntax error at 1: unexpected )
((a)  =>  syntax error at 0: missing closing )
[a  =>  syntax error at 0: missing closing ]
[z-a]  =>  syntax error at 1: invalid character class range
[a-\d]  =>  syntax error at 1: invalid character class range
[[:nope:]]  =>  syntax error at 1: invalid character class range
\  =>  syntax error at 0: trailing backslash at end of expression
\q  =>  syntax error at 0: invalid escape sequence
\1  =>  syntax error at 0: backreferences are not supported
\pL  =>  syntax error at 0: Unicode classes are not supported
\x4  =>  syntax error at 0: invalid escape sequence
\x{}  =>  syntax error at 0: invalid escape sequence
\x{100}  =>  syntax error at 0: invalid escape sequence
[\b]  =>  syntax error at 1: invalid escape sequence
a{1001}  =>  syntax error at 1: invalid repeat count
a{3,2}  =>  syntax error at 1: invalid repeat count
(?=a)  =>  syntax error at 0: lookaround is not supported
(?!a)  =>  syntax error at 0: lookaround is not supported
(?<=a)  =>  syntax error at 0: lookaround is not supported
(?<!a)  =>  syntax error at 0: lookaround is not supported
(?P=name)  =>  syntax error at 0: backreferences are not supported
(?P<>a)  =>  syntax error at 0: invalid named capture
(?<1a>b)  =>  syntax error at 0: invalid named capture
(?P<x>a)(?P<x>b)  =>  syntax error at 8: duplicate capture group name
(?z)  =>  syntax error at 0: invalid or unsupported Perl syntax
(?)  =>  syntax error at 0: invalid or unsupported Perl syntax
(?i  =>  syntax error at 0: missing closing )
"ab"
empty
[ac]
[a-f]
(cat "xy" [0-9])
(alt "x" "y" "z")
[]
(rep 0 inf (rep 1 inf (rep 0 1 "a")))
(rep? 2 inf "a")
(cap (cap n [0-9A-Z_a-z]))
(cat [Hh] [Ii] [X-Zx-z])
[\x00-/:-`d-y{-\xff]
"\x0a"
(cat lineStart lineEnd textStart textEnd wordBoundary notWordBoundary)
(cat [\x00-\xff] [\x00-\x09\x0b-\xff] [\x09\x0a\x0c\x0d\x20])
(cat (cap y (rep 4 4 [0-9])) "-" (cap m (rep 2 2 [0-9])))
(cat (cap y (rep 4 4 [0-9])) "-" (cap m (rep 2 2 [0-9])))
"ab"
range backwards: regexp.error
repeat min ~1: regexp.error
repeat max < min: regexp.error
repeat max ~2: regexp.error
repeat 1001: regexp.error
name empty: regexp.error
name 1x: regexp.error
name a-b: regexp.error
name _1: (cap _1 [0-9])
complement of ab: regexp.error
complement of a*: regexp.error
