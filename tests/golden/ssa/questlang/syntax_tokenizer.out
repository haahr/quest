data qs_2 text "    else\n"
data qs_3 text "        { n * fact(n - 1) };\n"
data qs_4 text "        1\n"
data qs_5 text "    if n <= 1 then\n"
data qs_6 text "let rec fact(n: Int): Int =\n"
data qs_7 text "(* Sample Quest program *)\n"
data qs_8 text "fact.quest"
data qs_9 text "\n"
data qs_10 text "let x = 42;"
data qs_11 text "peek.quest"
data qs_12 text "(* outer (* nested level 2 (* nested 3 *) *) back *)\n"
data qs_13 text "ident_1 _validIdent == !=\n"
data qs_14 text "\"hello\" \"with \\\"quotes\\\" and \\n newline\"\n"
data qs_15 text "'a' '\\n' '\\t' '\\'' '\\\\' '\\x41' '\\065'\n"
data qs_16 text "0 42 ~100 3.14 1.5e-3 ~2.0E+2\n"
data qs_17 text "literals.quest"
data qs_18 text "'too long'\n"
data qs_19 text "let final = 3;\n"
data qs_20 text "'\\z' (* invalid char escape *)\n"
data qs_21 text "let alsoValid = 2;\n"
data qs_22 text "\"unclosed string literal\n"
data qs_23 text "let valid = 1;\n"
data qs_24 text "error_recovery.quest"
data qs_25 text "--- Diagnostics Rendered ---"
data qs_26 text "'\\255' '\\256' \"\\xff\\xc3\\xa9 caf\303\251\"\n"
data qs_27 text "byte_range.quest"

