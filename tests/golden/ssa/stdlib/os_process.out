data qs_1 text "<main>"
data qr_funcs words [main, qs_1]
data qs_2 text "echo out; echo err >&2; exit 3"
data qs_3 text "sh"
data qs_4 text "-c"
data qs_5 text "pid positive: "
data qs_6 text "\n"
data qs_7 text "first wait"
data qs_8 text "]"
data qs_9 text "], stderr ["
data qs_10 text ", stdout ["
data qs_11 text ": code "
data qs_12 text "second wait"
data qs_13 text "done after wait: "
data qs_14 text "i=0; while [ $i -lt 20000 ]; do echo line; i=$((i+1)); done"
data qs_15 text " "
data qs_16 text "big: "
data qs_17 text "sleep 1; echo slow"
data qs_18 text "echo quick; exit 4"
data qs_19 text "first to finish: "
data qs_20 text "tests/source/stdlib/os_process.quest:31:27"
data qs_21 text "quick"
data qs_22 text "waitAny again: "
data qs_23 text "tests/source/stdlib/os_process.quest:33:26"
data qs_24 text "slow"
data qs_25 text "exit 1"
data qs_26 text "exit 2"
data qs_27 text "exit 3"
data qs_28 text "exit 4"
data qs_29 text "tests/source/stdlib/os_process.quest:38:51"
data qs_30 text "total: "
data qs_31 text "sub"
data qs_32 text "sub/inside.txt"
data qs_33 text "ls"
data qs_34 text "spawnIn"
data qs_35 text "sleep 10"
data qs_36 text "killed: "
data qs_37 text "kill after wait: ok"
data qs_38 text "no-such-program-quest"
