data qs_1 text "<main>"
data qr_funcs words [main, qs_1]
data qs_2 text "echo out; echo err >&2; exit 3"
data qs_3 text "sh"
data qs_4 text "-c"
data qs_5 text "pid positive: "
data qs_6 text "\n"
data qs_7 text "first wait"
data qs_8 text "]"
data qs_9 text "], stderr ["
data qs_10 text ", stdout ["
data qs_11 text ": code "
data qs_12 text "second wait"
data qs_13 text "done after wait: "
data qs_14 text "i=0; while [ $i -lt 20000 ]; do echo line; i=$((i+1)); done"
data qs_15 text " "
data qs_16 text "big: "
data qs_17 text "sleep 1; echo slow"
