data qs_1 text "<main>"
data qr_funcs words [main, qs_1]
data qs_2 text "questc"
data qs_3 text "Quest Compiler Driver"
data qs_4 text "echo"
data qs_5 text "-e --echo"
data qs_6 text "Echo compilation steps"
data qs_7 text "output"
data qs_8 text "-o --output"
data qs_9 text "a.out"
data qs_10 text "Output file path"
data qs_11 text "parse"
data qs_12 text "typecheck"
data qs_13 text "codegen"
data qs_14 text "phase"
data qs_15 text "-p --phase"
data qs_16 text "Stop after phase"
data qs_17 text "optLevel"
data qs_18 text "-O"
data qs_19 text "Optimization level"
data qs_20 text "include"
data qs_21 text "-I --include"
data qs_22 text "Search path directory"
data qs_23 text "source"
data qs_24 text "Source file to compile"
data qs_25 text "Usage: questc [options] source"
data qs_26 text "\n"
data qs_27 text "choices: parse, typecheck, codegen"
data qs_28 text "main.quest"
data qs_29 text ""
data qs_30 text "-e"
data qs_31 text "-o"
data qs_32 text "myprog"
data qs_33 text "--phase=typecheck"
data qs_34 text "3"
data qs_35 text "-I"
data qs_36 text "lib"
data qs_37 text "-Iextra/lib"
data qs_38 text "src1.quest"
data qs_39 text "src2.quest"
data qs_40 text "--"
data qs_41 text "target_arg1"
data qs_42 text "target_arg2"
data qs_43 text "--unknown"
data qs_44 text "FAILED: should have raised on --unknown"
data qs_45 text "CAUGHT: unrecognized option error"
data qs_46 text "--phase"
data qs_47 text "invalid_phase"
data qs_48 text "FAILED: should have raised on invalid choice"
data qs_49 text "CAUGHT: invalid choice error"
data qs_50 text "FAILED: should have raised on missing arg"
data qs_51 text "CAUGHT: missing argument error"
data qs_52 text "not_a_number"
data qs_53 text "FAILED: should have raised on invalid int"
data qs_54 text "CAUGHT: invalid integer error"

