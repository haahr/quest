interface Geometry
export
    Def Point = Record x: Int y: Int end
    Def Shape = Option
        dot with at: Point end
        segment with from: Point to: Point end
    end
    scaled(p: Point k: Int): Point
    sum(ps: Array(Point)): Point
    apply(f: All(p: Point) Point p: Point): Point
    tooFar: Exception(Int)
    check(p: Point): Point
    first(A::TYPE xs: Array(A)): A
    length(s: Shape): Int
    origin: Point
    (* More arguments than registers: Ints, Reals, and a record between them *)
    many(a: Int b: Int c: Int d: Int e: Int f: Int g: Int p: Point h: Int i: Int x: Real y: Real z: Real u: Real
        v: Real w: Real s: Real t: Real q: Real k: Bool c2: Char): Real
    (* A function of a closure called with as many *)
    callMany(m: All(a: Int b: Int c: Int d: Int e: Int f: Int g: Int p: Point h: Int i: Int x: Real y: Real
        z: Real u: Real v: Real w: Real s: Real t: Real q: Real k: Bool c2: Char) Real): Real
end
