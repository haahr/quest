module geometry : Geometry
import
    realOp = real : RealOp
    ascii : Ascii
export
    Def Point = Record x: Int y: Int end
    Def Shape = Option
        dot with at: Point end
        segment with from: Point to: Point end
    end

    let scaled(p: Point k: Int): Point = record x = p.x * k y = p.y * k end
    let sum(ps: Array(Point)): Point =
        begin
            let var x = 0
            let var y = 0
            for i = 0 upto {extent ps - 1} do
                x := x + ps[i].x
                y := y + ps[i].y
            end
            record x = x y = y end
        end
    let apply(f: All(p: Point) Point p: Point): Point = f(p)
    let tooFar: Exception(Int) = exception tooFar: Int end
    let fail(A::TYPE n: Int): A = raise tooFar with n end
    let check(p: Point): Point = if p.x > 100 then fail(:Point p.x) else p end
    let first(A::TYPE xs: Array(A)): A = xs[0]
    let length(s: Shape): Int =
        case s
            when dot then 0
            when segment with g: Tuple from: Point to: Point end then {g.to.x - g.from.x} + {g.to.y - g.from.y}
        end
    let origin: Point = record x = 0 y = 0 end
    let many(a: Int b: Int c: Int d: Int e: Int f: Int g: Int p: Point h: Int i: Int x: Real y: Real z: Real u: Real
        v: Real w: Real s: Real t: Real q: Real k: Bool c2: Char): Real =
        begin
            let ints = a + {2 * b} + {3 * c} + {4 * d} + {5 * e} + {6 * f} + {7 * g} + {8 * h} + {9 * i}
            let reals = x ++ {2.0 ** y} ++ {3.0 ** z} ++ {4.0 ** u} ++ {5.0 ** v} ++ {6.0 ** w} ++ {7.0 ** s} ++ {8.0 ** t} ++ {9.0 ** q}
            let flags = {if k then 1000 else 0 end} + {10000 * ascii.val(c2)}
            realOp.int(ints + {100 * p.x} + {10000 * p.y} + flags) ++ reals
        end
    let callMany(m: All(a: Int b: Int c: Int d: Int e: Int f: Int g: Int p: Point h: Int i: Int x: Real y: Real
        z: Real u: Real v: Real w: Real s: Real t: Real q: Real k: Bool c2: Char) Real): Real =
        m(9 8 7 6 5 4 3 record x = 2 y = 1 end 2 1 0.5 0.25 0.125 1.5 2.5 3.5 4.5 5.5 6.5 false 'z')
end
