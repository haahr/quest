(* Modules in three waves of the build queue (the main program imports left
 * and right, left and right import base, and right imports top, which imports
 * the library's modules), with abstract types of their own and the library's
 * (hierarchical, and external, as os/process's is) *)
import
    left : Left
    right : Right
    writer : Writer
    conv : Conv
;
writer.putString(writer.output conv.int(left.total(left.make(3))) <> " " <> right.describe(4) <> "\n")
