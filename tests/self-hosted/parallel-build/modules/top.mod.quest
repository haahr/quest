module top : Top
import
    util/path : util/Path
    os/process : os/Process
    conv : Conv
export
    (* A process's type, which only a module holding one names *)
    let pidOf(p: process.T): Int = process.pid(p)
    let name(n: Int): String = path.toString(path.child(path.fromString("top") conv.int(n)))
end
