module left : Left
import
    base : Base
    collections/vector : collections/Vector
export
    Let T = vector.T(base.T)
    let make(n: Int): T =
        begin
            let v = vector.new(:base.T)
            for i = 1 upto n do vector.append(:base.T v base.of(i)) end
            v
        end
    let total(t: T): Int =
        begin
            let var sum = 0
            for i = 0 upto {vector.length(:base.T t) - 1} do sum := sum + base.value(vector.get(:base.T t i)) end
            sum
        end
end
