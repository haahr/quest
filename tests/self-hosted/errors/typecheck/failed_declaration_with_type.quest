(* A declaration with a declared type that fails is bound at that type, so its users are still checked *)
let f(n: Int): Int = "oops"; (* ERROR: synthesized type .String. is not a subtype of expected type .Int. *)
let g: Bool = f(1); (* ERROR: synthesized type .Int. is not a subtype of expected type .Bool. *)
let h: Int = f(2);
let k: String = 3; (* ERROR: synthesized type .Int. is not a subtype of expected type .String. *)
let rec r: Int = "r"; (* ERROR: synthesized type .String. is not a subtype of expected type .Int. *)
let s: Bool = r; (* ERROR: synthesized type .Int. is not a subtype of expected type .Bool. *)
