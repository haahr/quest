(* Independent errors in one program are all reported, in source order *)
let a: Int = "one"; (* ERROR: synthesized type .String. is not a subtype of expected type .Int. *)
let b: String = 2; (* ERROR: synthesized type .Int. is not a subtype of expected type .String. *)
let c = undefinedName; (* ERROR: Undefined variable .undefinedName. *)
let d: Bool = true;
let e: Bool = d + 1; (* ERROR: synthesized type .Bool. is not a subtype of expected type .Int. *)
