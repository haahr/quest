(* Each binding of a block is a recovery point: the errors of a block are all reported, and the block then fails
   without another error *)
let f(): Int =
    begin
        let a: Int = "x" (* ERROR: synthesized type .String. is not a subtype of expected type .Int. *)
        let b: String = 1 (* ERROR: synthesized type .Int. is not a subtype of expected type .String. *)
        let c = a + 1
        c
    end;
let g: Bool = f(); (* ERROR: synthesized type .Int. is not a subtype of expected type .Bool. *)
