(* A declaration that fails binds its names to poisoned symbols: their uses fail without another error, and the
   errors that do not depend on them are still reported *)
let x = undefinedThing; (* ERROR: Undefined variable .undefinedThing. *)
let y = x + 1;
let z = y + x;
let w: Int = "s"; (* ERROR: synthesized type .String. is not a subtype of expected type .Int. *)
