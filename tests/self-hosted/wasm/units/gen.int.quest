(* Generic functions in a unit of their own, which the program that imports
 * them cannot specialize: called with descriptors (docs/wasm-plan.md, step
 * 7) *)
interface Gen
export
    (* How many of xs f holds for *)
    count(A::TYPE)(xs: Array(A) f: All(x: A) Bool): Int
    (* x if b, else y *)
    pick(A::TYPE)(b: Bool x: A y: A): A
    (* f applied twice, as a closure that captures f *)
    twice(A::TYPE)(f: All(x: A) A): All(x: A) A
    (* A pair of x and y *)
    pair(A::TYPE B::TYPE)(x: A y: B): Tuple first: A second: B end
end
