module gen : Gen
export
    let rec countFrom(A::TYPE)(xs: Array(A) f: All(x: A) Bool k: Int): Int =
        if k >= extent xs then 0 else {if f(xs[k]) then 1 else 0 end} + countFrom(:A xs f k + 1) end
    let count(A::TYPE)(xs: Array(A) f: All(x: A) Bool): Int = countFrom(:A xs f 0)
    let pick(A::TYPE)(b: Bool x: A y: A): A = if b then x else y end
    let twice(A::TYPE)(f: All(x: A) A): All(x: A) A = fun(x: A): A f(f(x))
    let pair(A::TYPE B::TYPE)(x: A y: B): Tuple first: A second: B end =
        tuple let first = x let second = y end
end
