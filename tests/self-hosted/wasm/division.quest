(* Division and remainder on this target (docs/wasm-plan.md section 2.10): the
 * divisor is tested before the instruction, so that ~1 wraps, as natively,
 * rather than trapping, and 0 raises int.error at its site. *)
let say(s: String): Ok = writer.putString(writer.output s <> "\n");
let least = ~9223372036854775807 - 1;
let divide(a: Int b: Int): Ok = say(conv.int(a) <> " / " <> conv.int(b) <> " = " <> conv.int(a / b) <> ", remainder "
    <> conv.int(a % b));
divide(7 2);
divide(~7 2);
divide(7 ~2);
divide(least ~1);
divide(least 1);
divide(0 ~1);
divide(1 0);
say("not reached");
