let groups = tuple let a1 = 1 and a2 = 2 let rec ev(n: Int): Bool = n is 0 and od(n: Int): Bool = ev(n) Let Rec N = Option z s with p: N end end end;
Let RecTuple = Tuple Def Rec M = Option e c with t: M end end x: M end;
let rcd = record a = 1 var b = "x" end;
let arr = array of 1 2 3 end;
let arrT = array of :Int end;
let rep = array of(3 0);
