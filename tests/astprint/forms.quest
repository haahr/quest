(* Input for tests/astprint/generate.py: a program that uses every node of the bootstrap AST. It only has to
   parse; it is not typechecked or run. *)

import writer: Writer;
import pick = util/pick, util/other : util/Pick;

interface Shapes
import base: Base
export
    T::TYPE
    Def U = Int
    Def Rec L = Option nil cons with head: Int tail: L end end
    Def A = Tuple x: Int end and B = Tuple y: A end
    area(s: T): Int
end;

module shapes : Shapes
import base: Base
export
    Let T = Tuple side: Int end;
    let area(s: T): Int = s.side * s.side;
end;

unsound module raw : Raw export
    let id(x: Int): Int = x;
end;

