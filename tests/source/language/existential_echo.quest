(* Cardelli §5.3: a value of an existential tuple type echoes its type components as <Hidden>::TYPE and its values
   of the hidden type as <hidden>, and so does a component selected from it. *)
(* @echo *)

Let T = Tuple A::TYPE a:A f(x:A):Int end;
let t1: T = tuple Let A::TYPE = Int let a = 0 let f(x: A): Int = x + 1 end;
t1.a;
t1.f(t1.a)
