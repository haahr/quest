(* An imported module's external type is named module.T wherever a type
 * mentions it: inferred type arguments, inferred types of lets, and results,
 * as in annotations (both compilers; the bootstrap once printed a bare T for
 * the types it inferred) *)

import word: Word;
import conv: Conv;
import writer: Writer;

let ws = array of word.fromInt(1) word.fromInt(2) end;
for i = 0 upto extent ws - 1 do ws[i] := word.add(ws[i] ws[i]) end;
let first(A::TYPE a: Array(A)): A = a[0];
let w = first(ws);
let annotated: word.T = word.mul(w w);
writer.putString(writer.output conv.int(word.toInt(annotated)) <> "\n");
