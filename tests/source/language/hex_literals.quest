(* Integers written in hexadecimal: 0x or 0X and digits of either case, negated with a tilde as decimals are, over the
   whole range of Int *)
import writer: Writer;
import conv: Conv;

let show(n: Int): Ok = begin writer.putString(writer.output conv.int(n)) writer.putString(writer.output "\n") end;
show(0x0);
show(0xff);
show(0XFF);
show(0x1f + 0x1);
show(~0x10);
show(0x8B000000);
show(0x7FFFFFFFFFFFFFFF);
show(~0x8000000000000000);
0xAbC
