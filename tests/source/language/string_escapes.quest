(* Strings and characters outside printable ASCII, as C literals: an escaped character followed by a hex digit or an
   octal digit stays two characters, whatever escape the C uses. *)
(* @echo *)
import string: StringOp;

"\x01a";
string.length("\x01a");
"\x017";
string.length("\x017");
"\x1f\x7fz\xff0";
string.length("\x1f\x7fz\xff0");
"tab\tnewline\nquote\"backslash\\";

'\x01';
'\x7f';
'\255';
'\'';
'"';
string.getChar("\x01a" 1);
string.getChar("\x017" 1);
