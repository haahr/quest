(* The first programs compiled to C: arithmetic, booleans and relations, strings and chars, mutable variables and
   tuple components, conditionals, loops, and blocks. *)
(* @echo *)

(* Integer and real arithmetic *)
let a = 10 + 5;
let b = 10 - 3;
let c = 4 * 6;
let d = 20 / 4;
let e = 17 % 5;
let f = ~42;
a + b + c + d + e + f;
let ra = 1.5 ++ 2.5;
let rb = 5.0 -- 1.25;
let rc = 2.0 ^^ 3.0;
let rd = 10.0 // 4.0;
let re = ~2.5;
ra ++ rb ++ rc ++ rd ++ re;

(* Booleans and relations *)
let eq = 10 is 10;
let ne = 10 isnot 5;
let lt = 3 < 7;
let le = 3 <= 3;
let gt = 5 > 2;
let ge = 5 >= 5;
let rlt = 1.0 << 2.0;
let rgt = 2.0 >> 1.0;
eq andif {ne} andif {lt} andif {le} andif {gt} andif {ge} andif {rlt} andif {rgt};

(* Strings and chars *)
let ch = 'Z';
"Hello, " <> "world!";

(* Mutable variables and tuple components *)
let var acc = 0;
acc := acc + 10;
acc := acc + 5;
acc;
let t = tuple let var x = 10 let var y = 20 end;
t.x := t.x + 5;
t.y := t.y + 10;
t.x + t.y;

(* Conditionals *)
let ifTrue = if 10 > 5 then 100 else 200 end;
let ifFalse = if false then 100 else 200 end;
ifTrue + ifFalse;

(* Loops *)
let var i = 1;
let var sum = 0;
while i <= 5 do
    sum := sum + i;
    i := i + 1;
end;
sum;
let var k = 0;
loop
    k := k + 1;
    if k is 10 then exit end;
end;
k;
let var updown = 0;
for j = 1 upto 4 do
    updown := updown + j;
end;
for j = 4 downto 1 do
    updown := updown + j;
end;
updown;

(* Blocks *)
let r = begin
    let u = 7;
    let v = 6;
    u * v
end
