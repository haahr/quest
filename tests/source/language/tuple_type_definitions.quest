(* Language: a type definition in a tuple type prints with its kind, as a tuple value's type components do, and a
   field selected from the tuple has the definition, not its name, in its type, since the name means nothing outside
   the tuple *)
(* @echo *)
Let T = Tuple Def K = Int k: K end;
let tt: T = tuple Let K = Int let k: K = 2 end;
let tk = tt.k;
tk + 1;
let mk(): T = tt;
let mkK = mk().k;
Let O = Option none some with Def S = String s: S end end;
(* The definition does not outlive the scope of a variable it might be named through *)
let getK(t: T) = t.k;
let viaBlock = begin let u: T = tuple Let K = Int let k: K = 3 end u.k end;
