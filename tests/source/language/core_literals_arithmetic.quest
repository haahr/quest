(* Literals, negative literals, integer and real arithmetic, relational operators, equality, string concatenation,
   and eager boolean operators. Division and remainder truncate toward zero. *)
(* @echo *)

(* Literals *)
42;
3.14;
true;
false;
'z';
"hello";
let u = ok;

(* Negative literals *)
~42;
~3.14;
~5.1E~4;
3.2E~4;
~7 / 2;
~7 % 2;
10 - ~3;
~10 + 3;
~5.0 ++ 2.5;

(* Integer arithmetic, truncating toward zero *)
10 + 20;
50 - 15;
6 * 7;
7 / 2;
7 % 2;
{0 - 7} / 2;
{0 - 7} % 2;
7 / {0 - 2};
7 % {0 - 2};

(* Real arithmetic *)
1.5 ++ 2.5;
5.0 -- 1.25;
2.5 ** 4.0;
9.0 // 2.0;
2.0 ^^ 3.0;

(* Relational operators: single for Int, doubled for Real *)
1 < 2;
2 <= 2;
3 > 5;
5 >= 5;
1.5 << 2.5;
2.5 <<= 2.5;
3.0 >> 5.0;
5.0 >>= 5.0;

(* Equality *)
10 is 10;
10 isnot 20;
10 is 20;
10 isnot 10;

(* String concatenation and eager boolean operators *)
"hello " <> "world";
true /\ false;
true \/ false
