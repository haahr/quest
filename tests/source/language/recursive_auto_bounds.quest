(* Recursive Types in Kind Bounds
 *
 * Kinds compared while comparing types share the proof's coinductive trail: T1
 * and T2, each an auto type bounded by itself, are compared through their
 * bounds, POWER(T1) <= POWER(T2), whose goal T1 <: T2 is the one already
 * assumed, so the proof closes and f, taking a T2, may be used as a function
 * taking a T1. *)

import writer : Writer

Let Rec T1 = Auto A <: T1 with a: A end
Let Rec T2 = Auto A <: T2 with a: A end
let f(x: T2): Int = 7
let g: All(x: T1) Int = f
let h: All(x: T2) Int = g
(* No value of T1 or T2 can be made, so only the bindings are checked *)
writer.putString(writer.output "accepted\n")
