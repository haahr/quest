(* Language: subkinding of operator kinds whose result kind names the parameter
 *
 * ALL(X :: K1) K2 is a subkind of ALL(Y :: K1') K2' when K2 is a subkind of K2'
 * with Y renamed X. Here the result kind POWER(B) names B, so the renaming
 * must reach it: passing F of ALL(B::TYPE) POWER(B) where ALL(C::TYPE)
 * POWER(C) is expected checks POWER(B) against POWER(C) renamed, POWER(B). *)

import writer: Writer;

let inner(G::ALL(C::TYPE) POWER(C)): Ok = ok;
let outer(F::ALL(B::TYPE) POWER(B)): Ok = inner(:F);
writer.putString(writer.output "ok\n")
