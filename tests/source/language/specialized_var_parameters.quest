(* A recursive function specialized to a known function passed to a static
   parameter (the inliner's static argument transform), which also takes a var
   parameter: the specialized copy keeps its mode. *)

let rec count(f: All(x: Int) Bool var n: Int i: Int): Ok =
    if i > 0 then
        begin
            if f(i) then n := n + 1 end
            count(f @n i - 1)
        end
    end
let even(x: Int): Bool = x > 4
let main(): Int = begin let var c = 0 count(even @c 10) c end
main()
