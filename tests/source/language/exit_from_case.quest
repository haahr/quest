(* Language: exit inside a case branch leaves the innermost loop (compiled to C, a case is a switch, whose break
   would only leave the switch) *)

import writer: Writer;
import conv: Conv;

let say(n: Int): Ok = writer.putString(writer.output conv.int(n) <> "\n");

Let Step = Option go stop end;
let step(n: Int limit: Int): Step = if n >= limit then option stop of Step end else option go of Step end end;

(* loop *)
let var n = 0;
loop
    n := n + 1
    case step(n 3) when stop then exit else ok end
end;
say(n);

(* while, and a case with a binder-free branch per tag *)
let var w = 0;
while w < 100 do
    w := w + 1
    case step(w 5) when go then ok when stop then exit end
end;
say(w);

(* for *)
let var last = 0;
for i = 1 upto 100 do
    last := i
    case step(i 7) when stop then exit else ok end
end;
say(last);

(* Nested loops: the exit leaves only the inner loop *)
let var outer = 0;
let var inner = 0;
for i = 1 upto 4 do
    outer := outer + 1
    loop
        inner := inner + 1
        case step(inner {2 * i}) when stop then exit else ok end
    end
end;
say(outer);
say(inner);
