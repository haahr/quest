(* Language: auto values made by generic code print their witnesses at their type arguments
   (C: a descriptor instantiated from a template at run time is named from the template's name, its holes replaced
   by the arguments' names) *)

import dynamic: Dynamic;

let f(A::TYPE x: A): Dynamic = dynamic.new(:Tuple v: A w: Int end tuple x 1 end);
let g: All(A::TYPE x: A) Dynamic = f;
let h(A::TYPE B::TYPE x: A y: B): Dynamic = dynamic.new(:Tuple a: A b: Tuple c: B d: A end end tuple x tuple y x end end);

tuple g(:String "hi") h(:Int :Bool 3 true) f(:Tuple p: Char end tuple 'c' end) end
