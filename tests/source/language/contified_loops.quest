(* Local functions the self-hosted compiler's simplifier makes loops of their
 * callers (docs/ir.md section 8.6, contification), whose results are those
 * of the calls: a tail-recursive function with parameters, called where its
 * result is used, not returned; one returning Ok, whose recursive calls are
 * statements; one whose own function captures a parameter, each iteration's;
 * and what it leaves: a function called twice, and one whose recursive call
 * is in a try, not a tail call. The ir_simplified golden shows the loops. *)
import writer: Writer;
import conv: Conv;
let print(s: String): Ok = writer.putString(writer.output s <> "\n");

let sum(n: Int): Int =
    begin
        let rec go(i: Int total: Int): Int = if i > n then total else go(i + 1 total + i) end
        go(1 0) * 2
    end;
print("sum: " <> conv.int(sum(100)));

let count(n: Int): Int =
    begin
        let cell = tuple let var k = 0 end
        let rec step(i: Int): Ok = if i < n then begin cell.k := cell.k + i step(i + 1) end end
        step(0)
        cell.k
    end;
print("count: " <> conv.int(count(10)));

let captured(n: Int): Int =
    begin
        let fs = array of(n fun(): Int 0)
        let rec fill(i: Int): Ok = if i < n then begin fs[i] := fun(): Int i * i fill(i + 1) end end
        fill(0)
        fs[3]() + fs[n - 1]()
    end;
print("captured: " <> conv.int(captured(5)));

let twice(n: Int): Int =
    begin
        let rec down(i: Int): Int = if i is 0 then 0 else down(i - 1) end
        down(n) + down(n + 1)
    end;
print("twice: " <> conv.int(twice(4)));

let stop: Exception = exception stop end;
let caught(n: Int): Int =
    begin
        let rec tries(i: Int): Int =
            if i >= n then raise stop end else try tries(i + 1) when stop then i end end
        tries(0)
    end;
print("caught: " <> conv.int(caught(3)));
