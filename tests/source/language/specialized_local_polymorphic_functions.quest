(* Language: local polymorphic functions called with record and variant type arguments. Like top-level and module
   functions, they get specialized clones (docs/ir.md §8.1), closures like the originals where they capture variables
   of the enclosing function, so records and variants are passed unboxed. *)

import writer: Writer;
import conv: Conv;

let wOut = writer.output;
let print(s: String): Ok = writer.putString(wOut s <> "\n");

Let P = Record a: Int end;
Let V = Variant p: Int q: Bool end;

(* 1. A local polymorphic function capturing nothing *)
let first(n: Int): Int =
    begin
        let pick(A::TYPE x: A y: A): A = y;
        pick(:P record a = n end record a = n + 1 end).a
    end;
print(conv.int(first(1)));

(* 2. A local polymorphic function capturing a variable of the enclosing function *)
let second(n: Int): Int =
    begin
        let pick(A::TYPE x: A y: A): A = if n > 0 then x else y end;
        pick(:P record a = 10 end record a = 20 end).a + pick(:Int 1 2)
    end;
print(conv.int(second(1)));
print(conv.int(second(0)));

(* 3. At a variant type, from inside a loop *)
let third(): Int =
    begin
        let var total = 0;
        let tag(A::TYPE v: A): A = v;
        for i = 1 upto 3 do
            let v = tag(:V variant p of V with i end);
            total := total + {if v?p then v!p else 0 end}
        end;
        total
    end;
print(conv.int(third()));

(* 4. A local recursive polymorphic function at a record type *)
let fourth(k: Int): Int =
    begin
        let rec last(A::TYPE x: A y: A m: Int): A = if m is 0 then x else last(:A y x m - 1) end;
        last(:P record a = 1 end record a = k end 3).a
    end;
print(conv.int(fourth(7)));
