(* Records, labeled tuples, arrays, and options, with selection, mutation, and case. *)
(* @echo *)

(* Records, including a mutable field *)
let p = record x = 10 y = 20 end;
p.x + p.y;
record x = 10 y = 20 end.x;
let r = record var count = 0 end;
r.count := r.count + 5;
r.count := r.count * 3;
r.count;

(* Labeled tuples, including a mutable component *)
let t = tuple let count = 10 let name = "quest" end;
t.count;
let mt = tuple let var count = 10 let name = "quest" end;
mt.count := mt.count + 5;
mt.count;
tuple let intensity = 100; end.intensity;

(* A tuple literal checked against a mutable component's type declares it var; mutable converts to immutable *)
let mx: Tuple var x: Int end = tuple let var x = 0 end;
mx.x := 7;
let ix: Tuple x: Int end = mx;
ix.x;

(* Arrays: indexing, element assignment, and repetition *)
let a = array of 10 20 30 end;
let v1 = a[1];
a[1] := 99;
v1 + a[1];
a;
let rep = array of(5 42);
rep[0] + rep[4];
(* An empty array literal takes its element type from the expected type *)
let none: Array(Int) = array of end;
extent(none);

(* Options and case *)
Let Color = Option
    red
    green
    blue with intensity: Int end
end;
let code(c: Color): Int =
    case c
        when red then 1
        when green then 2
        when blue with b: Tuple intensity: Int end then b.intensity
        else 0
    end;
let c1 = option red of Color end;
let c2 = option blue of Color with tuple let intensity = 100 end end;
code(c1);
code(c2);
code(c1) + code(c2);

(* A case without else names every tag *)
let shade(c: Color): Int =
    case c
        when red then 1
        when green then 2
        when blue with b: Tuple intensity: Int end then b.intensity
    end;
shade(option green of Color end) + shade(c2)
