(* Language: a closure may capture a local var variable of an enclosing function, and update it; the frame and every
   closure that captures it share one variable, which the lowering holds in a box (docs/type-system.md section
   6.2.3). *)

import writer: Writer;
import conv: Conv;
let s(text: String): Ok = writer.putString(writer.output text <> "\n");

(* 1. A counter *)
let counter(): All() Int = begin
    let var n = 0
    fun(): Int begin n := n + 1 n end
end;
let c = counter();
c(); c();
s(conv.int(c()));

(* 2. Two closures sharing one variable, and the frame seeing their updates *)
let pair(): Int = begin
    let var total = 10
    let add(k: Int): Ok = total := total + k
    let get(): Int = total
    add(5)
    add(7)
    total := total * 2
    get()
end;
s(conv.int(pair()));

(* 3. A capture in a loop, and an update after the closure is made *)
let looped(): Int = begin
    let var sum = 0
    let addTo(k: Int): Ok = sum := sum + k
    for i = 1 upto 4 do addTo(i) end
    sum := sum + 100
    let read(): Int = sum
    read()
end;
s(conv.int(looped()));

(* 4. Passed by address from the frame, then read by a closure *)
let incr(var x: Int): Ok = x := x + 1;
let viaAddress(): Int = begin
    let var v = 41
    let read(): Int = v
    incr(@v)
    read()
end;
s(conv.int(viaAddress()));

(* 5. A record held in a captured variable *)
Let P = Record x: Int end;
let records(): Int = begin
    let var p: P = record x = 1 end
    let set(k: Int): Ok = p := record x = k end
    set(9)
    p.x
end;
s(conv.int(records()));

(* 6. A variable of a type parameter's type, in a polymorphic function *)
let latest(A::TYPE first: A second: A): A = begin
    let var v: A = first
    let replace(x: A): Ok = v := x
    replace(second)
    v
end;
s(latest(:String "first" "second"));

(* 7. Captured two functions deep *)
let deep(): Int = begin
    let var d = 1
    let outer(): Int = begin
        let inner(): Ok = d := d * 7
        inner()
        d
    end
    outer() + d
end;
s(conv.int(deep()));
