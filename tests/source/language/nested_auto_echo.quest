(* An auto value inside another echoes the values of both type components: a
 * component of the inner one's type is written at its witness, and so is one of
 * the outer one's type (a type parameter of an enclosing auto type), at any
 * depth and inside other values. *)
(* @echo *)

Let Nest = Auto A::TYPE with a: A inner: Auto B::TYPE with b: B a2: A end end
let n: Nest = auto :Int with 5 auto :String with "s" 6 end end
n
Let Deep =
    Auto A::TYPE with
        a: A
        mid: Auto B::TYPE with b: B low: Auto C::TYPE with c: C aa: Array(A) bs: Tuple x: B end end end
    end
let d: Deep =
    auto :Bool with
        true
        auto :Char with 'x' auto :Real with 1.5 array of false true end tuple let x = 'y' end end end
    end
