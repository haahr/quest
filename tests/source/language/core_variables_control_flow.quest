(* Bindings, mutable variables, block scopes, conditionals, short-circuit operators, loops, and recursion. *)
(* @echo *)

(* Immutable and mutable bindings *)
let x = 10;
let y = 20;
x + y;
let var count = 0;
count := count + 5;
count := count * 2;
count;

(* A block's bindings shadow outer ones only inside it *)
let outer = 100;
let res = begin
    let outer = 50;
    outer + 5
end;
res + outer;

(* Conditionals *)
if 1 < 2 then 10 else 20 end;
if 2 < 1 then 10 else 20 end;
let sum = x + y * 2;
let boolVal = {x < y} andif {{x isnot 0} orif {y is 20}};

(* andif and orif do not evaluate their right operand when the left one decides the result *)
let var evaluated = false;
{1 > 2} andif {begin evaluated := true; true end};
evaluated;
{1 < 2} orif {begin evaluated := true; false end};
evaluated;

(* Loops *)
let var i = 0;
while i < 5 do
    i := i + 1
end;
i;
loop
    if i is 7 then
        exit
    else
        i := i + 1
    end
end;
i;
let var total = 0;
for k = 1 upto 5 do
    total := total + k
end;
total;
let var prod = 1;
for k = 4 downto 1 do
    prod := prod * k
end;
prod;
let var iterations = 0;
for k = 10 upto 5 do
    iterations := iterations + 1
end;
iterations;

(* Recursion *)
let rec fact(n: Int): Int =
    if n <= 1 then
        1
    else
        n * fact(n - 1)
    end;
fact(5)
