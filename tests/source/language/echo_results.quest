(* With @echo every top-level phrase prints its result as the interpreter's REPL does, and compiled code prints the
   same: bindings, declarations, functions, exceptions, and values of base, alias, and existential types. Reals are
   written with the fewest digits that read back as the same value. *)
(* @echo *)

import word: Word;
let r1 = 0.1 ++ 0.2;
let r2 = 1.0E16;
let r3 = 3.14159265;
let r4 = ~0.00001;
let r5 = 1.0 // 3.0;
100.0;
let c1 = '\n';
let c2 = '\'';
let s1 = "tab\there \"quoted\" back\\slash";
let w = word.fromInt(255);
word.fromInt(16);
Let N = Int;
let n: N = 3;
n;
let var v = 1;
v := 2;
let u = ok;
let g = fun(x: Int): Int x;
let h(A::TYPE x: A): A = x;
h;
exception Plain end;
exception WithInt: Int end;
Let Pkg = Tuple A::TYPE a: A end;
let pkg: Pkg = tuple Let A::TYPE = Int let a: A = 1 end;
DEF K = TYPE;
true
