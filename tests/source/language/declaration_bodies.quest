(* Language: bodies consisting of a single declaration (if/else, loops, case, try) *)

import writer: Writer;

let wOut = writer.output;
let var count = 0;
exception Never: Ok end;

(* 1. A lone declaration as an if/else branch *)
if true then let x = 1 end;
if false then ok else let y = 2 end;

(* 2. A lone declaration as a loop body *)
for i = 1 upto 3 do let z = i end;
while count < 2 do count := count + 1 end;

(* 3. A lone declaration as a case branch, a try body and a handler *)
Let Color = Option red green end;
let c = option red of Color end;
case c when red then let r = 1 when green then ok end;
try let t = 1 when Never then let u = 2 end;

writer.putString(wOut "declaration bodies ok\n");
