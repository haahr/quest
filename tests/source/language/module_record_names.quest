(* A top-level identifier named like a linked library module (here 'real', linked for Real arithmetic)
   must not collide with that module's record in generated C. *)

import writer: Writer;
import conv: Conv;

let real = 2.5;
let sum = real ++ 1.0;

writer.putString(writer.output conv.real(sum));
writer.putString(writer.output "\n");
