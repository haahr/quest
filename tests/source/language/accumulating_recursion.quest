(* @skip-phase: interpret, run_ir_core, run_ir_simplified, run_ir_specialized, run_ir_closed, run_ir_represented, run_ir_described *)
(* Recursions whose result is combined with + or * after the call, which the
 * backends make loops with an accumulator, so that they run as deep as a
 * loop does (the SSA's accumulate pass; the wasm backend's own,
 * docs/wasm.md section 3.3): a constant added, a product, fib's two
 * calls, a value computed before the call, a tail call of another function
 * whose result is still combined, and a plain self tail call among the
 * sites *)

import writer : Writer;
import conv : Conv;

let show(s: String): Ok = writer.putString(writer.output s <> "\n");

let rec depth(n: Int): Int = if n is 0 then 0 else 1 + depth(n - 1) end;
show(conv.int(depth(1000000)));

let rec fact(n: Int): Int = if n <= 1 then 1 else n * fact(n - 1) end;
show(conv.int(fact(20)));

let rec fib(n: Int): Int = if n < 2 then n else fib(n - 1) + fib(n - 2) end;
show(conv.int(fib(25)));

let rec sumSquares(n: Int): Int =
    if n is 0 then 0
    else
        let sq = n * n
        sumSquares(n - 1) + sq
    end;
show(conv.int(sumSquares(100000)));

let base(n: Int): Int = n * 10;
let rec viaOther(n: Int): Int = if n is 0 then base(7) else 2 + viaOther(n - 1) end;
show(conv.int(viaOther(500000)));

let rec mixed(n: Int): Int =
    if n is 0 then 0
    elsif {n % 2} is 0 then mixed(n - 1)
    else 3 + mixed(n - 1)
    end;
show(conv.int(mixed(1000000)))
