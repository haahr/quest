(* is and isnot of a variant or option and one of a subtype, whose tags are
 * numbered otherwise: they are equal when their tags (and payloads) are, and
 * not when only the tags' numbers are, the subtype's options among them
 * compared by the supertype's rule (by case, with an empty case). *)

(* @echo *)

Let Sub = Variant z: Int end
Let Super = Variant a: Int z: Int end
let var x = variant z of Sub with 1 end
let var y = variant z of Super with 1 end
let var z = variant a of Super with 1 end
tuple let xy = x is y let xz = x is z let yx = y is x let zx = z isnot x end

Let Few = Option q end
Let Many = Option p q end
let var f = option q of Few end
let var m = option q of Many end
let var n = option p of Many end
tuple let fm = f is m let fn = f is n let mf = m is f let nf = n isnot f end

Let OneSome = Option q with n: Int end end
Let TwoSome = Option p q with n: Int end end
let var s1 = option q of OneSome with let n = 3 end
let var s2 = option q of TwoSome with let n = 3 end
let var s3 = option p of TwoSome end
tuple let s2s1 = s2 is s1 let s3s1 = s3 is s1 let s1s2 = s1 is s2 end
