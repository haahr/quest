(* Recursive functions whose recursive call's result is combined with another
 * value by an associative and commutative operation, which the self-hosted
 * compiler's SSA makes loops of, with an accumulator (docs/ssa.md section
 * 4.1, ssa/passes/accumulate): a sum, a product, fib's second call, an exclusive or
 * over an array, a disjunction, and a count that also tail-calls itself; and
 * a difference, which it leaves. The ssa golden shows the loops. *)
import writer: Writer;
import conv: Conv;
import word: Word;
let print(s: String): Ok = writer.putString(writer.output s <> "\n");

let rec sum(n: Int): Int = if n is 0 then 0 else n + sum(n - 1) end;
print("sum: " <> conv.int(sum(100)));

let rec factorial(n: Int): Int = if n <= 1 then 1 else factorial(n - 1) * n end;
print("factorial: " <> conv.int(factorial(20)));

let rec fib(n: Int): Int = if n < 2 then n else fib(n - 1) + fib(n - 2) end;
print("fib: " <> conv.int(fib(20)));

let rec xors(a: Array(Int) i: Int): word.T =
    if i is extent a then word.fromInt(0) else word.xorBits(word.fromInt(a[i]) xors(a i + 1)) end;
print("xors: " <> conv.int(word.toInt(xors(array of 1 2 4 8 3 end 0))));

let rec bits(n: Int): word.T = if n is 0 then word.fromInt(1) else word.orBits(bits(n / 2) word.fromInt(n)) end;
print("bits: " <> conv.int(word.toInt(bits(1000))));

let rec odds(n: Int): Int =
    if n is 0 then 0
    elsif {{n / 2} * 2} is n then odds(n - 1)
    else 1 + odds(n - 1)
    end;
print("odds: " <> conv.int(odds(99)));

let rec alternating(n: Int): Int = if n is 0 then 0 else n - alternating(n - 1) end;
print("alternating: " <> conv.int(alternating(10)));
