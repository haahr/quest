(* Language: values of bounded type parameters (A <: B) crossing between generic and concrete code: as the type
   components of auto values, and as results of polymorphic functions (C: generic code holds such a value viewed at
   the bound, a variant tagged as B tags it, while auto values store the type component's values at their own type
   and callers view results at their own type; first-class polymorphic values keep calls from being specialized) *)

import writer: Writer;
import conv: Conv;

let s(text: String): Ok = writer.putString(writer.output text <> "\n");
Let Big = Variant a: Int b: String c: Bool end;
Let Small = Variant b: String c: Bool end;
let show(x: Big): String =
    case x when a with n then conv.int(n) when b with t then t when c with f then conv.bool(f) end;
let small: Small = variant c of Small with true end;
let other: Small = variant b of Small with "other" end;
Let AnyBig = Auto A<:Big with a: A end;

(* 1. Made by generic code, inspected at a particular type and at the bound *)
let mk0(A <: Big x: A): AnyBig = auto :A with x end;
let mk: All(A <: Big x: A) AnyBig = mk0;
s(inspect mk(:Small small) when Small with t then show(t.a) else "no" end);
s(inspect mk(:Small small) when Big with t then show(t.a) else "no" end);

(* 2. Made by concrete code, inspected by generic code at its bounded type parameter *)
let unbox0(A <: Big b: AnyBig default: A): A = inspect b when A with x then x.a else default end;
let unbox: All(A <: Big b: AnyBig default: A) A = unbox0;
let direct: AnyBig = auto :Small with small end;
s(show(unbox(:Small direct other)));
s(show(unbox(:Big direct variant a of Big with 0 end)));

(* 3. Made and inspected by generic code *)
s(show(unbox(:Small mk(:Small small) other)));
let roundTrip0(A <: Big x: A): A = unbox(:A mk(:A x) x);
let roundTrip: All(A <: Big x: A) A = roundTrip0;
s(show(roundTrip(:Small small)));
s(show(roundTrip(:Small other)));

(* 4. Records, viewed at the bound by generic code *)
Let Object = Record age: Int end;
Let Car = Record age: Int fuel: String end;
Let AnyObject = Auto A<:Object with a: A end;
let mkObj0(A <: Object x: A): AnyObject = auto :A with x end;
let mkObj: All(A <: Object x: A) AnyObject = mkObj0;
let car: Car = record age = 3 fuel = "diesel" end;
s(inspect mkObj(:Car car) when Car with t then t.a.fuel else "no" end);
let unboxObj0(A <: Object b: AnyObject default: A): A = inspect b when A with x then x.a else default end;
let unboxObj: All(A <: Object b: AnyObject default: A) A = unboxObj0;
s(unboxObj(:Car mkObj(:Car car) record age = 0 fuel = "none" end).fuel);
s(conv.int(unboxObj(:Object mkObj(:Car car) record age = 0 end).age));

(* 5. Results of bounded polymorphic functions, which generic code returns viewed at the bound *)
let id0(A <: Big x: A): A = x;
let id: All(A <: Big x: A) A = id0;
let showSmall(x: Small): String = case x when b with t then t when c with f then conv.bool(f) end;
s(showSmall(id(:Small small)));
s(show(id(:Small other)));
let same0(A <: Object x: A): A = x;
let same: All(A <: Object x: A) A = same0;
s(same(:Car car).fuel);
let viaGeneric0(B <: Small y: B): B = id(:B y);
let viaGeneric: All(B <: Small y: B) B = viaGeneric0;
s(showSmall(viaGeneric(:Small small)));
