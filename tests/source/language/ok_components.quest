(* Language: Ok as a component of an aggregate. An Ok value has no C type of
   its own (a function returning Ok returns void), so in compiled code a slot
   of type Ok -- a tuple component, record field, option payload component, or
   array element -- holds the word Q_OK_VAL (docs/c-representation.md section
   5), and each such slot is a word like any other. *)
(* @echo *)

(* 1. A tuple with an Ok component, made, returned, and projected *)
Let P = Tuple e: Ok s: Int end;
let p: P = tuple let e = ok let s = 1 end;
let n = p.s;
let e = p.e;
let mk(s: Int): P = tuple let e = ok let s = s end;
let total = mk(5).s + n;

(* 2. Records, with an immutable Ok field and a var one *)
Let R = Record a: Ok b: Int end;
let r: R = record a = ok b = 7 end;
let rb = r.b;
let ra = r.a;
let cr = record var a = ok end;
let set(): Ok = cr.a := ok;
let sr = set();

(* 3. An option tag whose payload has an Ok component *)
Let O = Option some with done: Ok count: Int end none end;
let count(o: O): Int = case o when some with x then x.count when none then 0 end;
let c = count(option some of O with ok 3 end);
let d = count(option none of O end);

(* 4. Generic code, whose slot for a type parameter is a word, reading an Ok
   slot and the one after it *)
let first(A::TYPE B::TYPE t: Tuple a: A b: B end): A = t.a;
let f = first(:Ok :Int tuple ok 4 end);
let second(A::TYPE B::TYPE t: Tuple a: A b: B end): B = t.b;
let g = second(:Ok :Int tuple ok 4 end);

(* 5. Arrays, nesting, and a prefix supertype *)
let arr = array of ok ok end;
let k = extent arr;
let nested = tuple let t = tuple ok 1 end let o = ok end;
let nn = nested.t;
let wide: Tuple e: Ok end = p;
let ws = wide.e;
