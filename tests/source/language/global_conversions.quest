(* Conversions of immutable globals made once (docs/ir.md section 8.4.1): a
 * global holding a closure the program computes, converted where a library's
 * generic function takes it, is converted once, where it is bound, and each
 * conversion reads the converted global. The results are as before: a global
 * converted in a function called many times, one converted at two types, and
 * one whose binding contification makes a join's parameter. *)

import conv : Conv
import writer : Writer

import collections/vector : collections/Vector

let print(s: String): Ok = writer.putString(writer.output s <> "\n")

(* Recursive, so that its closures are not inlined into known functions *)
let rec make(k: Int depth: Int): All(x: Int) Int = if depth is 0 then fun(x: Int): Int x + k else make(k depth - 1) end
let rec pair(k: Int depth: Int): All(a: Int b: Int) Int =
    if depth is 0 then fun(a: Int b: Int): Int a + b * k else pair(k depth - 1) end

let v = vector.new(:Int)
for i = 1 upto 5 do vector.append(v i) end

(* Bound by a let *)
let addSome = make(vector.get(v 2) 3)
(* Converted at two types: to vector.map's and to vector.fold's *)
let combine = pair(vector.get(v 1) 2)
(* Bound by a join's parameter: an if whose arms both call *)
let shift = if vector.length(v) > 3 then make(10 1) else make(20 1) end

let rec total(n: Int): Int =
    if n is 0 then
        0
    else
        vector.fold(:Int :Int vector.map(:Int :Int vector.map(:Int :Int v addSome) shift) 0 combine)
            + total(n - 1)
    end
print("total " <> conv.int(total(200)))
print("mapped " <> conv.int(vector.get(vector.map(:Int :Int v addSome) 4)))
