(* An auto value whose component is a record mentioning the auto type's
 * type component: inspected at its witness, read through a function, and
 * subsumed to an auto type with a narrower record (covariant). The wasm
 * backend once built the arm's converted record box from an untyped local,
 * which made the module invalid. *)

import writer : Writer;
import conv : Conv;

let print(s: String): Ok = writer.putString(writer.output s <> "\n");

Let W = Auto A::TYPE with r: Record p: A end end;
let w: W = auto :Int with record p = 5 end end;
print(inspect w when Int with arm then conv.int(arm.r.p) else "other" end);

Let Wide = Auto A::TYPE with r: Record p: A q: Int end k: Int end;
Let Narrow = Auto A::TYPE with r: Record p: A end k: Int end;
let show(a: Narrow): String =
    inspect a
    when Int with arm then "int " <> conv.int(arm.r.p) <> " " <> conv.int(arm.k)
    when String with arm then "string " <> arm.r.p <> " " <> conv.int(arm.k)
    else "other"
    end;
let x: Wide = auto :Int with record p = 6 q = 7 end 8 end;
let y: Wide = auto :String with record p = "s" q = 9 end 10 end;
print(show(x));
print(show(y));
let narrowed = array of(2 x);
narrowed[1] := y;
print(show(narrowed[1]));
