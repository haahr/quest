(* Language: echo writes the type components of tuples inside recursive types with their alias names, in compiled
   code as in the interpreter, however deep the recursion *)
(* @echo *)
Let P = Tuple a: Int end;
Let Rec R = Option nil cons with Def X = P h: Int t: R end end;
let rr = option cons of R with Let X = P let h = 1 let t: R = option nil of R end end;
let two: R = option cons of R with Let X = P let h = 2 let t: R = rr end;
Let Rec Forest = Record trees: Array(Tree) end
and Tree = Variant leaf: Tuple Def Y = P y: Int end node: Forest end;
let leaf: Tree = variant leaf of Tree with tuple Let Y = P let y = 3 end end;
let forest: Forest = record trees = array of leaf variant node of Tree with record trees = array of leaf end end end end end;
let anon: Rec(S::TYPE) Option stop more with Def Z = P s: S end end =
    option more of Rec(S::TYPE) Option stop more with Def Z = P s: S end end with
        Let Z = P let s = option stop of Rec(S::TYPE) Option stop more with Def Z = P s: S end end end end;
