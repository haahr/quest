(* Language: an option case's payload is a tuple type, so it may have type components and var fields *)
(* @echo *)

Let O = Option none some with Def K = Int k: K end end;
let k = begin let o = option some of O with Let K = Int let k: K = 2 end o!some.k + 1 end;

Let V = Option none some with var n: Int end end;
let n = begin let v = option some of V with var n = 1 end v!some.n + 1 end;

Let Rec R = Option nil cons with Def X = Int h: X t: R end end;
let h = begin
  let r = option cons of R with Let X = Int let h: X = 1 let t: R = option nil of R end end
  r!cons.h + 1
end;

Let E = Option none some with A::TYPE x: A get(): A end end;
let isSome = begin
  let e = option some of E with Let A = Int let x: A = 3 let get(): A = x end
  e?some
end;
