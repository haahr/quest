(* A for loop binds its variable once per iteration (docs/syntax.md), so a
 * closure made in the body keeps the value of the iteration that made it:
 * stored and called after the loop, called within it, captured through a
 * nested closure, counting up and down, in nested loops, and in a loop left
 * early. *)

import conv : Conv
import writer : Writer

let print(s: String): Ok = writer.putString(writer.output s <> "\n")

let show(fs: Array(All(x: Int) Int) x: Int): String =
    begin
        let var s = ""
        for i = 0 upto {extent fs - 1} do
            if i > 0 then s := s <> " " end
            s := s <> conv.int(fs[i](x))
        end
        s
    end

(* Upward: stored, and called after the loop *)
let adders = array of(5 fun(x: Int): Int x)
for i = 0 upto 4 do adders[i] := fun(x: Int): Int x + i end
print("upto: " <> show(adders 100))

let down = array of(5 fun(x: Int): Int x)
for i = 4 downto 0 do down[4 - i] := fun(x: Int): Int x * i end
print("downto: " <> show(down 10))

(* Downward: called in the iteration that made it *)
let var sum = 0
for i = 1 upto 4 do
    let twice = fun(): Int i + i
    sum := sum + twice()
end
print("downward: " <> conv.int(sum))

(* Through a nested closure, which captures the outer closure's copy *)
let makers = array of(3 fun(): All(x: Int) Int fun(x: Int): Int x)
for i = 0 upto 2 do makers[i] := fun(): All(x: Int) Int fun(x: Int): Int x - i end
let made = array of(3 fun(x: Int): Int x)
for k = 0 upto 2 do made[k] := makers[k]() end
print("nested: " <> show(made 50))

(* Nested loops: each closure keeps its pair *)
let pairs = array of(6 fun(x: Int): Int x)
for i = 0 upto 1 do
    for j = 0 upto 2 do pairs[{i * 3} + j] := fun(x: Int): Int {x * i} + j end
end
print("pairs: " <> show(pairs 10))

(* Left early: the closures made before the exit keep their values *)
let early = array of(5 fun(x: Int): Int ~1)
for i = 0 upto 4 do
    if i is 3 then exit end
    early[i] := fun(x: Int): Int i
end
print("early: " <> show(early 0))
