(* Language: integer division and remainder are exact for integers beyond 2^53, rounding toward zero as in C *)

import writer: Writer;
import conv: Conv;
import intOp = int: IntOp;

let say(n: Int): Ok = writer.putString(writer.output conv.int(n) <> "\n");

say(intOp.minInt / 10);
say(intOp.minInt % 10);
say(intOp.maxInt / 10);
say(intOp.maxInt % 10);
say(9007199254740993 / 1);
say(~9007199254740993 / 3);
say(~9007199254740993 % 3);
say(123456789012345678 / ~1000);
say(123456789012345678 % ~1000);
