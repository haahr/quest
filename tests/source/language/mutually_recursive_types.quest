(* Language: Mutually Recursive Types in C *)

import writer: Writer;
import conv: Conv;
import dynamic: Dynamic;
import arrayOp: ArrayOp;

let wOut = writer.output;
let printInt(x: Int): Ok =
    begin
        writer.putString(wOut conv.int(x));
        writer.putString(wOut "\n")
    end;

(* 1. Variants and tuples that refer to each other: a small expression language *)
Let Rec Expr = Variant num: Int neg: Expr bind: Bind end
and Bind = Tuple value: Expr body: Array(Expr) end;
let rec eval(e: Expr): Int =
    case e
        when num with n then n
        when neg with x then 0 - eval(x)
        when bind with b then evalBind(b)
        else 0
    end
and evalBind(b: Bind): Int =
    begin
        let var s = eval(b.value);
        for i = 0 upto arrayOp.size(:Expr b.body) - 1 do
            s := s + eval(b.body[i])
        end;
        s
    end;
let num(n: Int): Expr = variant num of Expr with n end;
let e: Expr =
    variant bind of Expr with
        tuple let value = num(10) let body = array of num(1) variant neg of Expr with num(2) end end end
    end;
printInt(eval(e));

(* 2. Options that refer to each other: even and odd naturals *)
Let Rec Even = Option zero succ with n: Odd end end
and Odd = Option succ with n: Even end end;
let zero: Even = option zero of Even end;
let one: Odd = option succ of Odd with zero end;
let two: Even = option succ of Even with one end;
let three: Odd = option succ of Odd with two end;
let rec evenValue(x: Even): Int =
    case x
        when succ with p then oddValue(p.n) + 1
        else 0
    end
and oddValue(x: Odd): Int = evenValue(x!succ.n) + 1;
printInt(oddValue(three));
printInt(if three!succ.n!succ.n!succ.n?zero then 1 else 0 end);

(* 3. Records with mutable fields that refer to each other *)
Let Rec Person = Record name: String var pet: Pets end
and Pet = Record name: String owner: Person end
and Pets = Option none some with p: Pet end end;
let alice: Person = record name = "alice" var pet = option none of Pets end end;
let rex: Pet = record name = "rex" owner = alice end;
alice.pet := option some of Pets with rex end;
printInt(if alice.pet!some.p.owner.pet?some then 1 else 0 end);

(* 4. A group member equals a single recursive type written differently, with the same representation *)
Let Rec Forest = Record trees: Array(Tree) end
and Tree = Variant leaf: Int node: Forest end;
Let Rec Tree2 = Variant leaf: Int node: Record trees: Array(Tree2) end end;
let rec size(t: Tree2): Int =
    case t
        when leaf with n then n
        when node with f then
            begin
                let var s = 0;
                for i = 0 upto arrayOp.size(:Tree2 f.trees) - 1 do
                    s := s + size(f.trees[i])
                end;
                s
            end
        else 0
    end;
let leaf(n: Int): Tree = variant leaf of Tree with n end;
let t: Tree = variant node of Tree with record trees = array of leaf(4) leaf(5) end end end;
let t2: Tree2 = t;
printInt(size(t2));
let trees: Array(Tree2) = array of t leaf(6) end;
printInt(size(trees[0]) + size(trees[1]));

(* 5. Through a polymorphic function *)
let id(A::TYPE x: A): A = x;
printInt(size(id(:Tree t)));
printInt(oddValue(id(:Odd three)));

(* 6. Dynamic values of group types, narrowed back, also to an equal type written differently *)
printInt(eval(dynamic.be(:Expr dynamic.new(:Expr e))));
printInt(oddValue(dynamic.be(:Odd dynamic.new(:Odd three))));
printInt(size(dynamic.be(:Tree2 dynamic.new(:Tree t))));
printInt(size(dynamic.be(:Tree dynamic.new(:Tree2 t2))));
let mismatch =
    try
        evenValue(dynamic.be(:Even dynamic.new(:Odd three)))
    when dynamic.error then
        ~1
    end;
printInt(mismatch);
