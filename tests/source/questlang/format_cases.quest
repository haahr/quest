(* Self-Hosted Quest Compiler: quest fmt (questlang/format), on one case for
 * each rule of docs/formatter.md section 2: each case formatted, then
 * formatted again, which must change nothing. Each case's input is a string
 * between bars; the output is printed between bars, so that line ends show. *)
(* @skip-phase: tokenize, parse, typecheck, ir_core *)
(* @timeout: 300.0 *)

import
    questlang/format/format : questlang/format/Format
    stringOp = string : StringOp
    writer : Writer

let print(s: String): Ok = writer.putString(writer.output s <> "\n")

let show(name: String text: String): Ok =
    begin
        print("== " <> name)
        case format.source(name text)
            when formatted with x then
                writer.putString(writer.output x.text)
                let again = case format.source(name x.text) when formatted with y then y.text else "" end
                if not(stringOp.equal(again x.text)) then print("-- changes when formatted again:") print(again) end
            when invalid then print("-- does not parse")
            when failed with x then print("-- internal error: " <> x.message)
        end
    end

(* Spacing: one space around operators, = and :=, after a colon; none inside
 * brackets, before a call's parenthesis, around . or :: *)
show("spacing" "let f(a:Int b :Int):Int=a+b*2
let g = f( 1 2 )
Def F=Fun(A::TYPE) A
let h(x: Int): Int = {x+1}*2
let t = vector.new(:Int)
r.field:=a [i]+1
")

(* Indentation: from the structure, whatever the source's *)
show("indentation" "let gcd(n: Int m: Int): Int =
  begin
let var a = n
      while a isnot m do
   if a > m then a := a - m
 else m := m - a end
          end
    a
  end
")

(* if, case, and try *)
show("control" "let f(x: Int): String =
    if x > 1 then
    \"big\"
        elsif x is 1 then
            \"one\"
          else
       \"small\"
      end
let g(x: Int): Int =
case x
when a then 10
when b then
f(x)
20
else 0
end
let h(): Int =
    try
    g(1)
        when e then 2
    end
")

(* A compact if (in the middle of a line, its first arm on that line)
 * continues; an if whose arms are on lines of their own lines up with its
 * line *)
show("compact if" "let a = if c then x
elsif d then y
else z end
let b = if c then
x
else
y
end
")

(* Continuations are 8 past the phrase's line; a phrase nested in a
 * continued one does not step further *)
show("continuations" "let message = \"module \" <> name
<> \" imports \" <> other
if found
andif ready then go() end
Let T = Tuple x: Tuple a: Int
b: Int end end
")

(* Types *)
show("types" "Let Point = Tuple x: Int y: Int end
Let Options = Tuple
width: Int
indent: String
end
Let Rec Doc = Option
empty
text with s: String end
pair with a: Doc
b: Doc end
end
")

(* Comments: kept, reindented with their code; end-of-line comments on
 * consecutive lines aligned *)
show("comments" "let f(x: Int): Int =
        begin
                (* A comment of two lines, its second
                 * line moved with its first *)
    let y = x (* why *)
    let longer = y + 1 (* and why *)
    longer
end
")

(* Imports sorted in sections, a blank line between two: unqualified names,
 * paths into lib/, other paths; a comment moves with its import *)
show("module imports" "module m : M
import
    writer : Writer
    util/maybe : util/Maybe
    (* the AST *)
    questlang/syntax/ast : questlang/syntax/Ast
    support/bench : support/Bench

    stringOp = string : StringOp
    collections/vector : collections/Vector
export
    let x = 1
end
")
show("program imports" "import writer : Writer;
import conv : Conv;
import util/maybe : util/Maybe;
writer.putString(writer.output conv.int(1));
")

(* Semicolons removed where the program means the same without them *)
show("semicolons" "let x = 1;
let y = 2;
;
x + y;
")

(* A body or a field that starts a line puts its construct's end on a line
 * of its own; so does a tuple's first field each of its fields, and an if's
 * first arm each of its arms *)
show("ends" "if c then
    x := 1 end
for i = 0 upto 9 do
    step(i) end
let t = tuple
    let a = 1 let b = 2 end
let u = tuple let a = 1 let b = 2 end
let v = if c then
        a
    elsif d then b
    else c end
let w = if c then a
    elsif d then b
    else c end
")

(* A then or do that starts a line goes back to the line before *)
show("then and do" "if {x > 0}
then f(x)
end
while more(r)
do step(r) end
")

(* Lines over 120 columns are broken: a declaration after its = first, an
 * if in every arm, an infix chain before an operator, arguments as many as
 * fit *)
show("long lines" "let describe(kind: String count: Int): String = \"there are \" <> conv.int(count) <> \" of the kind \" <> kind <> \", which is more than enough for anyone who asks\" <> \" and more\"
let check(x: Int): Ok = if x > 100000 then report(\"the value is far too large to be handled by this function or by any other one that we know of\" x) else ok end
let lowerModule(environment: Env unit: ast.Module imports: Array(Import) tables: Tables options: Options more: Int): ir.Module = begin go() end
")

(* Braces are kept as written, and symbolic names selected and bound *)
show("braces and symbols" "let x = if {a} then {b + 1} * 2 else {+}(1 2) end
let <+> = pp.<+>
let d = a <+> b
")

(* Type arguments keep their colons against the type *)
show("type arguments" "let found = locate(:K :V t key)
let e = array of :Int end
")

(* A file that says @no-format is left as it is *)
show("no-format" "(* @no-format *)
let   x=1;
")

(* Not Quest: reported, not formatted *)
show("invalid" "let x = (")
