(* Self-Hosted Quest Compiler: Test Constant Globals
 *
 * questlang/ssa/constants (docs/ssa.md section 4.1) on units of the SSA
 * written as text and read by questlang/ssa/parser, each printed before and
 * after the pass and verified. Made constant: a global stored an integer in
 * an initialization guarded by a flag, as a module's is, and one stored a
 * symbol's address. Left: a global stored twice, stored after a call, loaded
 * before it is stored, whose address is passed on, exported, stored in a
 * loop, loaded a byte at a time, or stored a value that is not a constant. *)
(* @skip-phase: tokenize, parse, typecheck, ir_core *)

import
    questlang/ssa/parser : questlang/ssa/Parser
    questlang/ssa/printer : questlang/ssa/Printer
    questlang/ssa/constants : questlang/ssa/Constants
    questlang/ssa/verify : questlang/ssa/Verify
    util/strutil : util/Strutil
    collections/vector : collections/Vector
    writer : Writer
;

let emit(s: String): Ok = writer.putString(writer.output s);

let show(title: String lines: Array(String)): Ok =
    begin
        emit("== " <> title <> "\n")
        let u = parser.readUnit(strutil.joinArray("\n" lines) <> "\n")
        emit(printer.formatUnit(u))
        constants.constantUnit(u)
        emit("-- after constants\n")
        emit(printer.formatUnit(u))
        try verify.checkUnit(u) when verify.verifyError with m then emit(m <> "\n") end
    end;

(* A function adding the global at g to its argument *)
let user(g: String): Array(String) = array of
    "function use(%0: int): int {"
    "b0(%0: int):"
    "  %1: ptr = symbol " <> g
    "  %2: int = load8 %1 + 0"
    "  %3: int = add %0, %2"
    "  return %3"
    "}"
    ""
end;

(* The lines of parts, one after another *)
let unit(parts: Array(Array(String))): Array(String) =
    begin
        let lines = vector.new(:String)
        for k = 0 upto {extent parts - 1} do
            for j = 0 upto {extent parts[k] - 1} do vector.append(:String lines parts[k][j]) end
        end
        vector.toArray(:String lines)
    end;

show("an integer, in an initialization guarded by a flag" unit(array of
    user("g_one")
    array of
        "function init() {"
        "b0():"
        "  %0: ptr = symbol initialized"
        "  %1: int = load1 %0 + 0"
        "  branch %1, b1(), b2()"
        "b1():"
        "  return"
        "b2():"
        "  %2: int = const 1"
        "  store1 %0 + 0, %2"
        "  %3: ptr = symbol g_one"
        "  store8 %3 + 0, %2"
        "  %4: int = const 56"
        "  %5: ptr = call quest_alloc(%4)"
        "  %6: int = load8 %3 + 0"
        "  store8 %5 + 0, %6"
        "  return"
        "}"
        ""
        "data initialized writable zero 8"
        "data g_one writable zero 8"
    end
end));

show("a symbol's address" array of
    "function get(): ptr {"
    "b0():"
    "  %0: ptr = symbol g_f"
    "  %1: ptr = load8 %0 + 0"
    "  return %1"
    "}"
    ""
    "function init() {"
    "b0():"
    "  %0: ptr = symbol f_closure"
    "  %1: ptr = symbol g_f"
    "  store8 %1 + 0, %0"
    "  return"
    "}"
    ""
    "data f_closure words [0, 0]"
    "data g_f writable zero 8"
end);

show("stored twice" unit(array of
    user("g")
    array of
        "function init() {"
        "b0():"
        "  %0: int = const 1"
        "  %1: ptr = symbol g"
        "  store8 %1 + 0, %0"
        "  %2: int = const 2"
        "  store8 %1 + 0, %2"
        "  return"
        "}"
        ""
        "data g writable zero 8"
    end
end));

show("stored after a call" unit(array of
    user("g")
    array of
        "function init() {"
        "b0():"
        "  %0: int = const 5"
        "  %1: int = call use(%0)"
        "  %2: int = const 1"
        "  %3: ptr = symbol g"
        "  store8 %3 + 0, %2"
        "  return"
        "}"
        ""
        "data g writable zero 8"
    end
end));

show("loaded before it is stored, in an earlier block" unit(array of
    user("g")
    array of
        "function init(): int {"
        "b0():"
        "  %0: ptr = symbol g"
        "  %1: int = load8 %0 + 0"
        "  jump b1()"
        "b1():"
        "  %2: int = const 1"
        "  store8 %0 + 0, %2"
        "  return %1"
        "}"
        ""
        "data g writable zero 8"
    end
end));

show("its address passed on" unit(array of
    user("g")
    array of
        "function init() {"
        "b0():"
        "  %0: int = const 1"
        "  %1: ptr = symbol g"
        "  store8 %1 + 0, %0"
        "  %2: ptr = call keep(%1)"
        "  return"
        "}"
        ""
        "data g writable zero 8"
    end
end));

show("exported" unit(array of
    user("g")
    array of
        "function init() {"
        "b0():"
        "  %0: int = const 1"
        "  %1: ptr = symbol g"
        "  store8 %1 + 0, %0"
        "  return"
        "}"
        ""
        "data g exported writable zero 8"
    end
end));

show("stored in a loop" unit(array of
    user("g")
    array of
        "function init(%0: int) {"
        "b0(%0: int):"
        "  %1: ptr = symbol g"
        "  %2: int = const 1"
        "  jump b1(%0)"
        "b1(%3: int):"
        "  store8 %1 + 0, %2"
        "  %4: int = sub %3, %2"
        "  branch %4, b1(%4), b2()"
        "b2():"
        "  return"
        "}"
        ""
        "data g writable zero 8"
    end
end));

show("loaded a byte at a time" array of
    "function use(): int {"
    "b0():"
    "  %0: ptr = symbol g"
    "  %1: int = load1 %0 + 0"
    "  return %1"
    "}"
    ""
    "function init() {"
    "b0():"
    "  %0: int = const 1"
    "  %1: ptr = symbol g"
    "  store8 %1 + 0, %0"
    "  return"
    "}"
    ""
    "data g writable zero 8"
end);

show("stored a value that is not a constant" unit(array of
    user("g")
    array of
        "function init(%0: int) {"
        "b0(%0: int):"
        "  %1: ptr = symbol g"
        "  store8 %1 + 0, %0"
        "  return"
        "}"
        ""
        "data g writable zero 8"
    end
end));
