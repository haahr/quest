parse("forms.quest" "(* Values: selection, cells, and control *)\nlet sel = rcd.a.b;\nlet idx = arr[0][i + 1];\narr[1] := 5;\nv := 3;\nlet cell = var(v);\nlet deref = @cell;\nlet chk = vrt?a;\nlet asr = vrt!a.x;\nlet cs = case opt when red, green then 1 when green with x: Tuple c: Int end then x.c when blue with y then y else 0 end;\nlet cs2 = case opt when red then 1 end;\nlet ins = inspect d when Int with x then x when Tuple a: Int b: String end with y, z: String then 1 else 2 end;\nlet ins2 = inspect d when Int then 0 end;\nlet e = exception Bad: Int end;\nlet e2 = exception Plain end;\nlet rs = raise Bad with 3 as Int end;\nlet rs2 = raise Plain end;\nlet tr = try 1 when Bad with x: Int then x when Plain then 0 when other with y then y else 5 end;\nlet tr2 = try let x = 1 x when Plain then 0 end;\nwhile v > 0 do v := v - 1 end;\nloop exit end;\nloop let x = 1 end;\nfor k = 10 downto 1 do ok end;\nfor k = 1 upto 10 do ok end;\nfor k = 1 10 do let y = k end;\nif a then b end;\nif a b elsif c d else let e = 1 end;\nbegin let x = 1 Let T = Int DEF K3 = TYPE x end;\nbegin end;\n:Int;\n::TYPE\n");
