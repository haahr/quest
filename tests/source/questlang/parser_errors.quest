parse("errors.quest" "let f(x: Int = x\n");
parse("errors.quest" "let t = tuple let a = 1\n");
parse("errors.quest" "if a then b\n");
parse("errors.quest" "case x when then 1 end\n");
parse("errors.quest" "let x = 1 2 )\n");
parse("errors.quest" "Let T = Tuple x: end\n");
