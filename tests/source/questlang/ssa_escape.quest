(* Self-Hosted Quest Compiler: Test Escape Analysis
 *
 * questlang/ssa/escape (docs/ssa.md section 4.2) on functions of the SSA
 * written as text and read by questlang/ssa/parser, each printed with what
 * the analysis says of its allocations, and after the pass (which makes
 * those that do not escape slots) and promotion, each verified: one only
 * loaded from and stored to,
 * through a pointer derived from it, which does not escape; one stored into
 * another, passed to a call, returned, bound to a block's parameter that
 * another value is also bound to, and compared, which do; one made in a loop;
 * a tuple holding a pointer to its own fields, behind the proxy tests that
 * reading it makes; an access outside it; one in a function that enters a
 * try; and one whose stores write barriers follow, which keep no pointer and
 * go with it. Each allocation names its layout, as the builder's do
 * (quest_alloc(size, layout)): the pass takes no other call for one. *)
(* @skip-phase: tokenize, parse, typecheck, ir_core *)

import
    questlang/ssa/parser : questlang/ssa/Parser
    questlang/ssa/printer : questlang/ssa/Printer
    questlang/ssa/escape : questlang/ssa/Escape
    questlang/ssa/promote : questlang/ssa/Promote
    questlang/ssa/verify : questlang/ssa/Verify
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    util/strutil : util/Strutil
    collections/vector : collections/Vector
    writer : Writer
    conv : Conv
;

let emit(s: String): Ok = writer.putString(writer.output s);

let show(title: String lines: Array(String)): Ok =
    begin
        emit("== " <> title <> "\n")
        let u = parser.readUnit(strutil.joinArray("\n" lines) <> "\n")
        for k = 0 upto {vector.length(:ssa.Function u.functions) - 1} do
            let f = vector.get(:ssa.Function u.functions k)
            emit(printer.formatFunction(f))
            let vs = escape.analyze(f)
            for a = 0 upto {extent vs - 1} do
                let v = vs[a]
                emit("-- %" <> conv.int(v.value) <> " (" <> conv.int(v.bytes) <> " bytes): "
                    <> if v.escapes then "escapes, " <> v.reason else "does not escape" end <> "\n")
            end
            let check(): Ok =
                begin
                    let problems = verify.functionProblems(f)
                    for j = 0 upto {extent problems - 1} do emit("!! " <> problems[j] <> "\n") end
                end
            let removed = escape.escapeFunction(f)
            if removed > 0 then
                emit("-- after escape: " <> conv.int(removed) <> " removed\n")
                emit(printer.formatFunction(f))
                check()
                let promoted = promote.promoteFunction(f)
                emit("-- after promote: " <> conv.int(promoted) <> " promoted\n")
                emit(printer.formatFunction(f))
                check()
            end
        end
    end;

show("loaded and stored, through a derived pointer" array of
    "function pair(%0: int, %1: int): int {"
    "b0(%0: int, %1: int):"
    "  %2: int = const 16"
    "  %100: ptr = symbol quest_layout_t"
    "  %3: ptr = call quest_alloc(%2, %100)"
    "  store8 %3 + 0, %0"
    "  %4: int = const 8"
    "  %5: ptr = ptrAdd %3, %4"
    "  store8 %5 + 0, %1"
    "  %6: int = load8 %3 + 0"
    "  %7: int = load8 %5 + 0"
    "  %8: int = add %6, %7"
    "  return %8"
    "}"
end);

show("escaping: stored, passed, returned, compared" array of
    "function stored(%0: ptr): int {"
    "b0(%0: ptr):"
    "  %1: int = const 8"
    "  %100: ptr = symbol quest_layout_t"
    "  %2: ptr = call quest_alloc(%1, %100)"
    "  store8 %0 + 0, %2"
    "  %3: int = const 0"
    "  return %3"
    "}"
    "function passed(): int {"
    "b0():"
    "  %0: int = const 8"
    "  %100: ptr = symbol quest_layout_t"
    "  %1: ptr = call quest_alloc(%0, %100)"
    "  call fill(%1)"
    "  %2: int = load8 %1 + 0"
    "  return %2"
    "}"
    "function returned(): ptr {"
    "b0():"
    "  %0: int = const 8"
    "  %100: ptr = symbol quest_layout_t"
    "  %1: ptr = call quest_alloc(%0, %100)"
    "  return %1"
    "}"
    "function compared(%0: ptr): int {"
    "b0(%0: ptr):"
    "  %1: int = const 8"
    "  %100: ptr = symbol quest_layout_t"
    "  %2: ptr = call quest_alloc(%1, %100)"
    "  %3: int = peq %2, %0"
    "  return %3"
    "}"
end);

show("stored into another" array of
    "function nested(%0: int): int {"
    "b0(%0: int):"
    "  %1: int = const 8"
    "  %100: ptr = symbol quest_layout_t"
    "  %2: ptr = call quest_alloc(%1, %100)"
    "  store8 %2 + 0, %0"
    "  %101: ptr = symbol quest_layout_t"
    "  %3: ptr = call quest_alloc(%1, %101)"
    "  store8 %3 + 0, %2"
    "  %4: ptr = load8 %3 + 0"
    "  %5: int = load8 %4 + 0"
    "  return %5"
    "}"
end);

show("bound to a parameter, alone and with another value" array of
    "function alone(%0: int): int {"
    "b0(%0: int):"
    "  %1: int = const 8"
    "  %100: ptr = symbol quest_layout_t"
    "  %2: ptr = call quest_alloc(%1, %100)"
    "  store8 %2 + 0, %0"
    "  jump b1(%2)"
    "b1(%3: ptr):"
    "  %4: int = load8 %3 + 0"
    "  return %4"
    "}"
    "function either(%0: int, %1: ptr): int {"
    "b0(%0: int, %1: ptr):"
    "  %2: int = const 8"
    "  %100: ptr = symbol quest_layout_t"
    "  %3: ptr = call quest_alloc(%2, %100)"
    "  branch %0, b1(%3), b1(%1)"
    "b1(%4: ptr):"
    "  %5: int = load8 %4 + 0"
    "  return %5"
    "}"
end);

show("made in a loop" array of
    "function loop(%0: int): int {"
    "b0(%0: int):"
    "  %1: int = const 0"
    "  jump b1(%1)"
    "b1(%2: int):"
    "  %3: int = lt %2, %0"
    "  branch %3, b2(), b3()"
    "b2():"
    "  %4: int = const 8"
    "  %100: ptr = symbol quest_layout_t"
    "  %5: ptr = call quest_alloc(%4, %100)"
    "  store8 %5 + 0, %2"
    "  %6: int = load8 %5 + 0"
    "  %7: int = const 1"
    "  %8: int = add %6, %7"
    "  jump b1(%8)"
    "b3():"
    "  return %2"
    "}"
end);

show("a tuple holding a pointer to its fields, read behind proxy tests" array of
    "function fields(%0: int, %1: int): int {"
    "b0(%0: int, %1: int):"
    "  %2: int = const 24"
    "  %100: ptr = symbol quest_layout_t"
    "  %3: ptr = call quest_alloc(%2, %100)"
    "  %4: int = const 8"
    "  %5: ptr = ptrAdd %3, %4"
    "  store8 %5 + 0, %0"
    "  store8 %5 + 8, %1"
    "  store8 %3 + 0, %5"
    "  %6: int = ptrToInt %3"
    "  %7: int = const 1"
    "  %8: int = and %6, %7"
    "  branch %8, b1(), b2()"
    "b1():"
    "  %9: ptr = load8 %3 + ~1"
    "  jump b3(%9)"
    "b2():"
    "  jump b3(%3)"
    "b3(%10: ptr):"
    "  %11: ptr = load8 %10 + 0"
    "  %12: int = load8 %11 + 8"
    "  return %12"
    "}"
end);

show("accessed outside it" array of
    "function outside(): int {"
    "b0():"
    "  %0: int = const 8"
    "  %100: ptr = symbol quest_layout_t"
    "  %1: ptr = call quest_alloc(%0, %100)"
    "  %2: int = load8 %1 + 8"
    "  return %2"
    "}"
end);

show("in a function that enters a try" array of
    "function tries(%0: int): int slots [240:16] {"
    "b0(%0: int):"
    "  %1: int = const 8"
    "  %100: ptr = symbol quest_layout_t"
    "  %2: ptr = call quest_alloc(%1, %100)"
    "  store8 %2 + 0, %0"
    "  try slot 0, b1(), handler b2"
    "b1():"
    "  %3: int = load8 %2 + 0"
    "  return %3"
    "b2():"
    "  %4: int = load8 %2 + 0"
    "  return %4"
    "}"
end);

show("followed by write barriers" array of
    "function logged(%0: ptr): ptr {"
    "b0(%0: ptr):"
    "  %1: int = const 16"
    "  %100: ptr = symbol quest_layout_t"
    "  %2: ptr = call quest_alloc(%1, %100)"
    "  store8 %2 + 0, %0"
    "  call quest_barrier(%2)"
    "  %3: int = const 8"
    "  %4: ptr = ptrAdd %2, %3"
    "  store8 %4 + 0, %0"
    "  call quest_barrier_slot(%4)"
    "  %5: ptr = load8 %4 + 0"
    "  return %5"
    "}"
end);
