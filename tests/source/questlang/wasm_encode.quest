(* Self-Hosted Quest Compiler: Test the WebAssembly Encoder and Printer
 *
 * Builds a corpus of WebAssembly modules by hand (questlang/wasm/model,
 * docs/wasm.md section 8.1) and prints each with
 * questlang/wasm/printer, then its bytes from questlang/wasm/encode in hex,
 * as comments of the text format, so that each module's part of the output
 * is text that wasm-tools parses:
 *
 * - empty: a module with nothing in it;
 * - runtime: R alone (questlang/wasm/runtimeTypes);
 * - numbers: constants at each length of their encodings, reals of every
 *   kind, arithmetic, selects, runs of locals, an if with a result, a loop,
 *   a br_table, a shadowed label, several results, and a block of a type;
 * - gc: R's structs and arrays made, read, and written, casts and tests,
 *   both br_on_casts, null references, packed fields, and a passive data
 *   segment with bytes the text must escape;
 * - control: imports and exports of each kind, a start function, globals,
 *   tags, a try_table with every kind of catch, throw_ref, calls through
 *   references and tail calls of either kind, a declared function, and the
 *   memory's instructions, with an active and a passive data segment;
 * - indices: types, locals, and immediates past one byte of their encoding;
 * - run: a WASI command, which writes a sum that a tail call computes a
 *   million times around, an exception's value, and a tuple's component.
 *
 * tests/python/test_wasm.py checks the golden: wasm-tools parse of each
 * module's text is its bytes, every module validates, and wasmtime and node
 * run the last and write what its expect lines say. *)
(* @skip-phase: tokenize, parse, typecheck, ir_core *)

import
    questlang/wasm/model : questlang/wasm/Model
    questlang/wasm/ops : questlang/wasm/Ops
    questlang/wasm/encode : questlang/wasm/Encode
    questlang/wasm/printer : questlang/wasm/Printer
    rt = questlang/wasm/runtimeTypes : questlang/wasm/RuntimeTypes
    collections/vector : collections/Vector
    stringOp = string : StringOp
    ascii : Ascii
    writer : Writer
;

let put(s: String): Ok = writer.putString(writer.output s);

(* ======================================================================
 * Building
 * ====================================================================== *)

let none = array of :Int end;
let noTypes = array of :model.ValType end;
let noNames = array of :String end;
let i(o: model.Op): model.Inst = model.op(o none);
let i1(o: model.Op a: Int): model.Inst = model.op(o array of a end);
let i2(o: model.Op a: Int b: Int): model.Inst = model.op(o array of a b end);
let empty = option blockEmpty of model.BlockType end;
let result(t: model.ValType): model.BlockType = option blockValue of model.BlockType with let type = t end;
let typed(t: Int): model.BlockType = option blockIndex of model.BlockType with let index = t end;
let heap(t: Int): model.HeapType = option heapIndex of model.HeapType with let index = t end;
let abstractRef(nullable: Bool h: model.HeapType): model.RefType = tuple let nullable = nullable let heap = h end;
let refOf(nullable: Bool t: Int): model.RefType = abstractRef(nullable heap(t));
let eq = option heapEq of model.HeapType end;
let i31 = option heapI31 of model.HeapType end;
let exnref = model.refTo(true option heapExn of model.HeapType end);
let f64Bits(bits: Int): model.Inst = option instF64Const of model.Inst with let bits = bits end;
let local(name: String t: model.ValType): model.Local = tuple let name = name let type = t end;

let typeCount(m: model.Module): Int =
    begin
        let var n = 0
        for g = 0 upto vector.length(:model.RecGroup m.types) - 1 do
            n := n + extent vector.get(:model.RecGroup m.types g)
        end
        n
    end;

(* A type of its own, in a group of one, by its index *)
let addType(m: model.Module name: String c: model.Composite): Int =
    begin
        let n = typeCount(m)
        vector.append(:model.RecGroup m.types array of
            tuple let name = name let final = true let supers = none let composite = c end
        end)
        n
    end;
let funcType(m: model.Module name: String params: Array(model.ValType) results: Array(model.ValType)): Int =
    addType(m name option compFunc of model.Composite with let params = params let results = results end);

(* A function defined, by its index in the function space *)
let addFunction(m: model.Module name: String t: Int params: Array(String) locals: Array(model.Local)
    body: Array(model.Inst)): Int =
    begin
        let n = model.importedFunctions(m) + vector.length(:model.Function m.functions)
        vector.append(:model.Function m.functions tuple
            let name = name let type = t let params = params let locals = vector.fromArray(:model.Local locals)
            let body = vector.fromArray(:model.Inst body)
        end)
        n
    end;

let addImport(m: model.Module moduleName: String field: String name: String kind: model.ImportKind): Ok =
    vector.append(:model.Import m.imports
        tuple let moduleName = moduleName let field = field let name = name let kind = kind end);
let addExport(m: model.Module field: String kind: model.ExportKind index: Int): Ok =
    vector.append(:model.Export m.exports tuple let field = field let kind = kind let index = index end);

(* ======================================================================
 * Printing
 * ====================================================================== *)

let hexDigit(d: Int): String = stringOp.getSub("0123456789abcdef" d 1);

(* m's text and bytes, after a line naming it *)
let show(kind: String m: model.Module label: String): Ok =
    begin
        put(";; " <> kind <> " " <> label <> "\n")
        put(printer.print(m))
        put(";; bytes\n")
        let bytes = encode.encode(m)
        let n = stringOp.length(bytes)
        let var k = 0
        while k < n do
            put(";;")
            let var j = 0
            while {j < 32} andif {{k + j} < n} do
                let c = ascii.val(stringOp.getChar(bytes {k + j}))
                if {j - {{j / 4} * 4}} is 0 then put(" ") end
                put(hexDigit(c / 16) <> hexDigit(c - {{c / 16} * 16}))
                j := j + 1
            end
            put("\n")
            k := k + 32
        end
    end;

(* ======================================================================
 * empty, runtime
 * ====================================================================== *)

show("module" model.newModule("") "empty");

let runtime = model.newModule("runtime");
vector.append(:model.RecGroup runtime.types rt.group);
show("module" runtime "runtime");

(* ======================================================================
 * numbers
 * ====================================================================== *)

let numbers = model.newModule("numbers");
let binop = funcType(numbers "binop" array of model.i64 model.i64 end array of model.i64 end);
let pair = funcType(numbers "pair" array of model.i64 end array of model.i64 model.i64 end);
let void = funcType(numbers "void" noTypes noTypes);
let realType = funcType(numbers "real" array of model.f64 end array of model.f64 end);
let switchType = funcType(numbers "" array of model.i32 end array of model.i32 end);

let constants = vector.new(:model.Inst);
let ints32 = array of 0 63 64 ~64 ~65 8191 8192 ~8193 2147483647 ~2147483648 end;
for k = 0 upto extent ints32 - 1 do
    vector.append(:model.Inst constants model.i32Const(ints32[k]))
    vector.append(:model.Inst constants i(ops.drop))
end;
let ints64 = array of 127 128 ~129 4294967296 9223372036854775807 ~9223372036854775808 end;
for k = 0 upto extent ints64 - 1 do
    vector.append(:model.Inst constants model.i64Const(ints64[k]))
    vector.append(:model.Inst constants i(ops.drop))
end;
(* 0, -0, 1.5, 0.1, the least subnormal, the greatest finite, infinities, the
 * canonical NaN, a NaN with a payload *)
let reals = array of
    0 ~9223372036854775808 0x3FF8000000000000 0x3FB999999999999A 1 0x7FEFFFFFFFFFFFFF 0x7FF0000000000000
    ~4503599627370496 0x7FF8000000000000 0x7FF0000000000004
end;
for k = 0 upto extent reals - 1 do
    vector.append(:model.Inst constants f64Bits(reals[k]))
    vector.append(:model.Inst constants i(ops.drop))
end;
vector.append(:model.Inst constants model.f64Const(1.0 // 3.0));
vector.append(:model.Inst constants i(ops.drop));
addFunction(numbers "constants" void noNames array of :model.Local end vector.toArray(:model.Inst constants));

let arith = addFunction(numbers "arith" binop array of "a" "b" end
    array of local("t" model.i64) local("" model.i64) local("" model.i32) local("" model.i64) local("" model.f64)
        local("" model.eqref) local("" model.eqref) end
    array of
        i1(ops.localGet 0) i1(ops.localGet 1) i(ops.i64Add) i1(ops.localGet 1) i(ops.i64Mul) model.i64Const(3)
        i(ops.i64ShrS) i1(ops.localTee 2) i1(ops.localGet 0) i(ops.i64LtS)
        model.ifInst(result(model.i64) "positive") i1(ops.localGet 2) model.elseInst model.i64Const(0) model.endInst
        i1(ops.localGet 0) i1(ops.localGet 1) i1(ops.localGet 1) i(ops.i64Eqz)
        option instSelect of model.Inst with let types = noTypes end
        i1(ops.localGet 1) model.i64Const(7) i1(ops.localGet 0) i(ops.i32WrapI64)
        option instSelect of model.Inst with let types = array of model.i64 end end
        i(ops.i64Add) i(ops.i64Add)
    end);

addFunction(numbers "sum" binop array of "n" "acc" end array of :model.Local end array of
    model.blockInst(result(model.i64) "done")
    model.loopInst(empty "again")
    i1(ops.localGet 0) i(ops.i64Eqz)
    model.ifInst(empty "") i1(ops.localGet 1) i1(ops.br 2) model.endInst
    i1(ops.localGet 1) i1(ops.localGet 0) i(ops.i64Add) i1(ops.localSet 1)
    i1(ops.localGet 0) model.i64Const(1) i(ops.i64Sub) i1(ops.localSet 0)
    i1(ops.br 0)
    model.endInst
    i(ops.unreachable)
    model.endInst
end);

addFunction(numbers "switch" switchType array of "x" end array of :model.Local end array of
    model.blockInst(empty "high")
    model.blockInst(empty "")
    model.blockInst(empty "low")
    i1(ops.localGet 0)
    option instBrTable of model.Inst with let labels = array of 0 1 2 end let default = 0 end
    model.endInst
    model.i32Const(10) i(ops.returnOp)
    model.endInst
    model.i32Const(11) i(ops.returnOp)
    model.endInst
    model.i32Const(12)
end);

(* The inner $x shadows the outer, so a branch to the outer is by depth *)
addFunction(numbers "shadow" void noNames array of :model.Local end array of
    model.blockInst(empty "x") model.blockInst(empty "x") i1(ops.br 1) i1(ops.br 0) model.endInst model.endInst
end);

let swap = addFunction(numbers "swap" pair array of "" end array of :model.Local end array of
    i1(ops.localGet 0) model.blockInst(typed(pair) "") model.i64Const(2) model.endInst
end);
addFunction(numbers "useSwap" binop array of "x" "y" end array of :model.Local end array of
    i1(ops.localGet 0) i1(ops.call swap) i1(ops.call arith)
end);

addFunction(numbers "convert" realType array of "r" end array of :model.Local end array of
    i1(ops.localGet 0) i(ops.i64TruncSatF64S) i(ops.f64ConvertI64S) i1(ops.localGet 0) i(ops.f64Sqrt) i(ops.f64Add)
    i1(ops.localGet 0) i(ops.i64ReinterpretF64) i(ops.f64ReinterpretI64) i(ops.f64Mul)
end);
show("module" numbers "numbers");

(* ======================================================================
 * gc
 * ====================================================================== *)

let gc = model.newModule("gc");
vector.append(:model.RecGroup gc.types rt.group);
let tTuple = rt.index("tuple");
let tSlots = rt.index("slots");
let tBytes = rt.index("bytes");
let tBoxInt = rt.index("boxInt");
let packed = addType(gc "packed" option compStruct of model.Composite with let fields = array of
    tuple let name = "lo" let storage = option storageI8 of model.Storage end let mutable = true end
    tuple let name = "hi" let storage = option storageI16 of model.Storage end let mutable = false end
end end);
let mkType = funcType(gc "mk" array of model.i64 end array of model.ref(tTuple) end);
let testType = funcType(gc "test" array of model.eqref end array of model.i32 end);
let gcVoid = funcType(gc "" noTypes noTypes);
vector.append(:model.Data gc.data tuple let name = "d" let bytes = "ab\"\\\x00\xff" let offset = ~1 end);

addFunction(gc "mk" mkType array of "n" end array of local("s" model.ref(tSlots)) local("t" model.ref(tTuple)) end
    array of
        i1(ops.localGet 0) model.i64Const(1) i(ops.i64Add) i(ops.i32WrapI64) i(ops.refI31)
        option instRefNull of model.Inst with let heap = option heapNone of model.HeapType end end
        i2(ops.arrayNewFixed tSlots 2) i1(ops.localSet 1)
        model.i32Const(0) i1(ops.localGet 1) i1(ops.structNew tTuple) i1(ops.localTee 2)
        i2(ops.structGet tTuple rt.field("tuple" "slots")) model.i32Const(0) i1(ops.localGet 2) i1(ops.arraySet tSlots)
        i1(ops.localGet 2) model.i32Const(7) i2(ops.structSet tTuple rt.field("tuple" "hash"))
        i1(ops.localGet 1) i(ops.arrayLen) i(ops.drop)
        i1(ops.localGet 2)
    end);

addFunction(gc "test" testType array of "v" end array of :model.Local end array of
    model.blockInst(result(model.refTo(false i31)) "isI31")
    model.blockInst(result(model.ref(tTuple)) "isTuple")
    i1(ops.localGet 0)
    option instBrOnCast of model.Inst with
        let fail = false let label = 0 let from = abstractRef(true eq) let to = refOf(false tTuple) end
    option instBrOnCast of model.Inst with
        let fail = false let label = 1 let from = abstractRef(true eq) let to = abstractRef(false i31) end
    i(ops.drop) model.i32Const(0) i(ops.returnOp)
    model.endInst
    i2(ops.structGet tTuple rt.field("tuple" "hash")) i(ops.returnOp)
    model.endInst
    i(ops.i31GetS)
end);

addFunction(gc "unbox" testType array of "v" end array of :model.Local end array of
    model.blockInst(result(model.eqref) "other")
    i1(ops.localGet 0)
    option instBrOnCast of model.Inst with
        let fail = true let label = 0 let from = abstractRef(true eq) let to = abstractRef(false i31) end
    i(ops.i31GetU) i(ops.returnOp)
    model.endInst
    option instRefTest of model.Inst with let type = refOf(false tBoxInt) end
    i1(ops.localGet 0)
    option instRefCast of model.Inst with let type = refOf(true tTuple) end
    i(ops.refIsNull) i(ops.i32Add)
    i1(ops.localGet 0)
    option instRefTest of model.Inst with let type = abstractRef(true eq) end
    i(ops.i32Add)
end);

addFunction(gc "data" gcVoid noNames array of local("a" model.ref(tSlots)) end array of
    model.i32Const(0) model.i32Const(3) i2(ops.arrayNewData tBytes 0) model.i32Const(1) i1(ops.arrayGetU tBytes)
    i(ops.drop)
    option instRefNull of model.Inst with let heap = eq end
    option instRefNull of model.Inst with let heap = heap(tSlots) end
    i(ops.refEq) i(ops.drop)
    model.i64Const(5) i1(ops.structNew tBoxInt) i2(ops.structGet tBoxInt 0) i(ops.drop)
    i1(ops.structNewDefault packed) i2(ops.structGetU packed 0) i(ops.drop)
    i1(ops.structNewDefault packed) i2(ops.structGetS packed 1) i(ops.drop)
    model.i32Const(4) i1(ops.arrayNewDefault tSlots) i1(ops.localTee 0)
    model.i32Const(0) i1(ops.localGet 0) model.i32Const(1) model.i32Const(2) i2(ops.arrayCopy tSlots tSlots)
    i1(ops.localGet 0) model.i32Const(0)
    option instRefNull of model.Inst with let heap = option heapNone of model.HeapType end end
    model.i32Const(4) i1(ops.arrayFill tSlots)
    i1(ops.localGet 0) model.i32Const(0) i1(ops.arrayGet tSlots) i(ops.drop)
    model.blockInst(empty "null")
    option instRefNull of model.Inst with let heap = eq end
    i1(ops.brOnNull 0) i(ops.drop)
    model.endInst
    option instRefNull of model.Inst with let heap = option heapNoExtern of model.HeapType end end
    i(ops.anyConvertExtern) i(ops.externConvertAny) i(ops.drop)
end);
show("module" gc "gc");

(* ======================================================================
 * control
 * ====================================================================== *)

let control = model.newModule("control");
let cVoid = funcType(control "v" noTypes noTypes);
let cTag = funcType(control "i" array of model.i64 end noTypes);
let cUnary = funcType(control "ii" array of model.i64 end array of model.i64 end);
let caughtRef = funcType(control "caughtRef" noTypes array of model.i64 exnref end);
addImport(control "host" "log" "log" option importFunc of model.ImportKind with let type = cTag end);
addImport(control "host" "memory" "mem" option importMemory of model.ImportKind with let min = 1 let max = 2 end);
addImport(control "host" "base" "base"
    option importGlobal of model.ImportKind with let type = model.i64 let mutable = false end);
addImport(control "host" "error" "hostError" option importTag of model.ImportKind with let type = cTag end);
vector.append(:model.Tag control.tags tuple let name = "e" let type = cTag end);
vector.append(:model.Global control.globals
    tuple let name = "counter" let type = model.i64 let mutable = true let init = array of model.i64Const(0) end end);
vector.append(:model.Data control.data tuple let name = "greeting" let bytes = "hi\n" let offset = 0 end);
vector.append(:model.Data control.data tuple let name = "passive" let bytes = "zz" let offset = ~1 end);

let init = addFunction(control "init" cVoid noNames array of :model.Local end array of
    i1(ops.globalGet 0) i1(ops.globalSet 1) i1(ops.globalGet 0) i1(ops.call 0)
end);
let double = addFunction(control "double" cUnary array of "x" end array of :model.Local end array of
    i1(ops.localGet 0) i1(ops.localGet 0) i(ops.i64Add)
end);
addFunction(control "twice" cUnary array of "x" end array of :model.Local end array of
    i1(ops.localGet 0) i1(ops.refFunc double) i1(ops.callRef cUnary) i1(ops.refFunc double)
    i1(ops.returnCallRef cUnary)
end);
let count = model.importedFunctions(control) + vector.length(:model.Function control.functions);
addFunction(control "count" cUnary array of "n" end array of :model.Local end array of
    i1(ops.globalGet 1) model.i64Const(1) i(ops.i64Add) i1(ops.globalSet 1)
    i1(ops.localGet 0) i(ops.i64Eqz)
    model.ifInst(result(model.i64) "") model.i64Const(0)
    model.elseInst i1(ops.localGet 0) model.i64Const(1) i(ops.i64Sub) i1(ops.returnCall count)
    model.endInst
end);
let catchOf(kind: model.CatchKind tag: Int label: Int): model.Catch =
    tuple let kind = kind let tag = tag let label = label end;
addFunction(control "catcher" cUnary array of "x" end array of :model.Local end array of
    model.blockInst(result(exnref) "caughtAllRef")
    model.blockInst(empty "caughtAll")
    model.blockInst(typed(caughtRef) "caughtRef")
    model.blockInst(result(model.i64) "caught")
    option instTryTable of model.Inst with let type = result(model.i64) let label = "" let catches = array of
        catchOf(option catchTag of model.CatchKind end 1 0)
        catchOf(option catchTagRef of model.CatchKind end 0 1)
        catchOf(option catchAll of model.CatchKind end 0 2)
        catchOf(option catchAllRef of model.CatchKind end 0 3)
    end end
    i1(ops.localGet 0) i1(ops.throw 1)
    model.endInst
    i(ops.returnOp)
    model.endInst
    i(ops.returnOp)
    model.endInst
    i(ops.throwRef)
    model.endInst
    model.i64Const(~1) i(ops.returnOp)
    model.endInst
    i(ops.throwRef)
end);
addFunction(control "memory" cUnary array of "x" end array of :model.Local end array of
    model.i32Const(16) i1(ops.localGet 0) i1(ops.i64Store 8)
    model.i32Const(16) i1(ops.i64Load 8)
    model.i32Const(0) i1(ops.i32Load8U 0) i(ops.i64ExtendI32U) i(ops.i64Add)
    model.i32Const(1) model.i32Const(255) i1(ops.i32Store8 0)
    i1(ops.memorySize 0) i(ops.drop) model.i32Const(1) i1(ops.memoryGrow 0) i(ops.drop)
    model.i32Const(0) model.i32Const(8) model.i32Const(4) i2(ops.memoryCopy 0 0)
    model.i32Const(0) model.i32Const(0) model.i32Const(4) i1(ops.memoryFill 0)
    i1(ops.dataDrop 1)
    model.i32Const(4) i1(ops.i32Load 4) i(ops.i64ExtendI32S) i(ops.i64Add)
end);
vector.append(:Int control.declared double);
control.start := init;
addExport(control "double" option exportFunc of model.ExportKind end double);
addExport(control "memory" option exportMemory of model.ExportKind end 0);
addExport(control "counter" option exportGlobal of model.ExportKind end 1);
addExport(control "e" option exportTag of model.ExportKind end 1);
show("module" control "control");

(* ======================================================================
 * indices
 * ====================================================================== *)

let indices = model.newModule("");
for k = 0 upto 129 do
    addType(indices "" option compStruct of model.Composite with let fields = array of
        tuple let name = "" let storage = option storageValue of model.Storage with let type = model.i64 end
            let mutable = false end
    end end)
end;
let wide = funcType(indices "" noTypes array of model.refNull(129) end);
let many = array of(200 local("" model.i32));
addFunction(indices "" wide noNames many array of
    model.blockInst(result(model.refNull(70)) "")
    option instRefNull of model.Inst with let heap = heap(70) end
    model.endInst
    i(ops.drop)
    model.i32Const(0) i1(ops.localSet 199)
    model.i64Const(1) i1(ops.structNew 129)
end);
show("module" indices "indices");

(* ======================================================================
 * run
 * ====================================================================== *)

let run = model.newModule("run");
vector.append(:model.RecGroup run.types rt.group);
let fdWrite = funcType(run "fdWrite" array of model.i32 model.i32 model.i32 model.i32 end array of model.i32 end);
let rVoid = funcType(run "void" noTypes noTypes);
let rTag = funcType(run "tag" array of model.i64 end noTypes);
let rSum = funcType(run "sum" array of model.i64 model.i64 end array of model.i64 end);
addImport(run "wasi_snapshot_preview1" "fd_write" "fdWrite"
    option importFunc of model.ImportKind with let type = fdWrite end);
vector.append(:model.Memory run.memories tuple let name = "memory" let min = 1 let max = ~1 end);
vector.append(:model.Tag run.tags tuple let name = "error" let type = rTag end);

(* Writes n, at least 0, in decimal and a newline, assembled down from byte
 * 96, through an iovec at 0 *)
let print = addFunction(run "print" rTag array of "n" end array of local("p" model.i32) end array of
    model.i32Const(96) i1(ops.localSet 1)
    i1(ops.localGet 1) model.i32Const(1) i(ops.i32Sub) i1(ops.localTee 1) model.i32Const(10) i1(ops.i32Store8 0)
    model.loopInst(empty "digit")
    i1(ops.localGet 1) model.i32Const(1) i(ops.i32Sub) i1(ops.localTee 1)
    i1(ops.localGet 0) model.i64Const(10) i(ops.i64RemU) i(ops.i32WrapI64) model.i32Const(48) i(ops.i32Add)
    i1(ops.i32Store8 0)
    i1(ops.localGet 0) model.i64Const(10) i(ops.i64DivU) i1(ops.localTee 0) model.i64Const(0) i(ops.i64Ne)
    i1(ops.brIf 0)
    model.endInst
    model.i32Const(0) i1(ops.localGet 1) i1(ops.i32Store 0)
    model.i32Const(4) model.i32Const(96) i1(ops.localGet 1) i(ops.i32Sub) i1(ops.i32Store 0)
    model.i32Const(1) model.i32Const(0) model.i32Const(1) model.i32Const(32) i1(ops.call 0) i(ops.drop)
end);
let sum = model.importedFunctions(run) + vector.length(:model.Function run.functions);
addFunction(run "sum" rSum array of "n" "acc" end array of :model.Local end array of
    i1(ops.localGet 0) i(ops.i64Eqz)
    model.ifInst(result(model.i64) "") i1(ops.localGet 1)
    model.elseInst
