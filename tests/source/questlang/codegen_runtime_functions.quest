(* Self-Hosted Quest Compiler: Test the Runtime's Functions
 *
 * Prints the table of questlang/codegen/runtimeFunctions as C assertions about runtime/quest_runtime.h: that each
 * function has the type of its prototype, and, as comments, each function's signature as the SSA writes it and its
 * effects. The golden holds them, and tests/python/test_runtime_layout.py compiles the golden against the header, so
 * the table and the header agree. *)
(* @skip-phase: tokenize, parse, typecheck, ir_core *)

import
    questlang/codegen/runtimeFunctions : questlang/codegen/RuntimeFunctions
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    util/strutil : util/Strutil
    writer : Writer
    conv : Conv
;

let emit(s: String): Ok = begin writer.putString(writer.output s) writer.putString(writer.output "\n") end;

let passedText(p: ssa.Passed): String =
    case p
        when passWord then "word" when passReal then "real" when passPair then "pair" when passPairRest then "rest"
        when passByte then "byte" when passInt32 then "int32"
        when passMemory with x then "memory " <> conv.int(x.bytes)
    end;

let all(ps: Array(ssa.Passed)): String =
    begin
        let texts = array of(extent ps "")
        for i = 0 upto {extent ps - 1} do texts[i] := passedText(ps[i]) end
        strutil.joinArray(", " texts)
    end;

let fs = runtimeFunctions.functions;
for i = 0 upto {extent fs - 1} do
    let f = fs[i]
    let params = if extent f.params is 0 then "void" else strutil.joinArray(", " f.params) end
    let s = runtimeFunctions.signature(f)
    let e = f.effects
    let memory = case e.memory
        when memoryNone then "none" when memoryReads then "reads" when memoryWrites then "writes"
    end
    emit("/* " <> f.name <> ": (" <> all(s.params) <> ") -> (" <> all(s.results) <> "); memory " <> memory
        <> if e.raises then ", raises" else "" end <> if e.allocates then ", allocates" else "" end
        <> if e.noReturn then ", no return" else "" end <> if runtimeFunctions.isPure(f) then ", pure" else "" end
        <> " */")
    emit("static_assert(__builtin_types_compatible_p(__typeof__(" <> f.name <> "), " <> f.result <> " (" <> params
        <> ")), "
        <> "runtime_function_" <> f.name <> ");")
end;
