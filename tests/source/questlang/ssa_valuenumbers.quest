(* Self-Hosted Quest Compiler: Test Value Numbering
 *
 * questlang/ssa/valueNumbers (docs/value-numbering.md section 3) on functions
 * of the SSA written as text and read by questlang/ssa/parser, each printed
 * before and after the pass and verified: pure values repeated in a block
 * and in a block their first dominates, with commuted arguments; values in
 * sibling blocks, which neither dominates, kept; invariant loads, one at a
 * pointer addition's address matching one at an offset, across a store and
 * a call; ordinary loads, which this step leaves alone; a comparison that
 * branches in two blocks, which stays in each, since arm64 fuses a
 * comparison into its block's branch; a copy; a block parameter every jump
 * binds to one value; and the instructions left without uses removed. *)
(* @skip-phase: tokenize, parse, typecheck, ir_core *)

import
    questlang/ssa/parser : questlang/ssa/Parser
    questlang/ssa/printer : questlang/ssa/Printer
    questlang/ssa/valueNumbers : questlang/ssa/ValueNumbers
    questlang/ssa/verify : questlang/ssa/Verify
    util/strutil : util/Strutil
    writer : Writer
;

let emit(s: String): Ok = writer.putString(writer.output s);

let show(title: String lines: Array(String)): Ok =
    begin
        emit("== " <> title <> "\n")
        let u = parser.readUnit(strutil.joinArray("\n" lines) <> "\n")
        emit(printer.formatUnit(u))
        valueNumbers.numberUnit(u)
        emit("-- after valueNumbers\n")
        emit(printer.formatUnit(u))
        try verify.checkUnit(u) when verify.verifyError with m then emit(m <> "\n") end
    end;

show("pure values in a block and below it, commuted" array of
    "function pure(%0: int, %1: int): int {"
    "b0(%0: int, %1: int):"
    "  %2: int = add %0, %1"
    "  %3: int = add %1, %0"
    "  %4: int = const 1"
    "  %5: int = sub %2, %4"
    "  jump b1()"
    "b1():"
    "  %6: int = const 1"
    "  %7: int = sub %3, %6"
    "  %8: int = xor %5, %7"
    "  return %8"
    "}"
end);

show("values in sibling blocks" array of
    "function siblings(%0: int, %1: int): int {"
    "b0(%0: int, %1: int):"
    "  branch %0, b1(), b2()"
    "b1():"
    "  %2: int = mul %1, %1"
    "  %3: int = add %2, %1"
    "  jump b3(%3)"
    "b2():"
    "  %4: int = mul %1, %1"
    "  %5: int = add %4, %1"
    "  jump b3(%5)"
    "b3(%6: int):"
    "  return %6"
    "}"
end);

show("invariant loads across a store and a call" array of
    "function invariant(%0: ptr, %1: ptr): int {"
    "b0(%0: ptr, %1: ptr):"
    "  %2: int = load8 %0 + 8 invariant"
    "  %3: int = const 8"
    "  %4: ptr = ptrAdd %0, %3"
    "  store8 %1 + 0, %2"
    "  %5: int = load8 %4 + 0 invariant"
    "  %6: int = call g(%1)"
    "  %7: int = load8 %0 + 8 invariant"
    "  %8: int = add %5, %7"
    "  %9: int = add %8, %6"
    "  return %9"
    "}"
end);

show("ordinary loads" array of
    "function ordinary(%0: ptr): int {"
    "b0(%0: ptr):"
    "  %1: int = load8 %0 + 0"
    "  %2: int = load8 %0 + 0"
    "  %3: int = add %1, %2"
    "  return %3"
    "}"
end);

show("a comparison that branches in two blocks" array of
    "function compared(%0: int, %1: int): int {"
    "b0(%0: int, %1: int):"
    "  %2: int = lt %0, %1"
    "  branch %2, b1(), b2()"
    "b1():"
    "  %3: int = lt %0, %1"
    "  branch %3, b2(), b3()"
    "b2():"
    "  return %0"
    "b3():"
    "  return %1"
    "}"
end);

show("a copy and a parameter bound to one value" array of
    "function joined(%0: int, %1: int): int {"
    "b0(%0: int, %1: int):"
    "  %2: int = copy %1"
    "  branch %0, b1(%1), b2()"
    "b1(%3: int):"
    "  jump b3(%3, %0)"
    "b2():"
    "  jump b3(%2, %1)"
    "b3(%4: int, %5: int):"
    "  %6: int = add %4, %5"
    "  return %6"
    "}"
end);

show("values left without uses" array of
    "function unused(%0: ptr, %1: int): int {"
    "b0(%0: ptr, %1: int):"
    "  %2: int = const 16"
    "  %3: ptr = ptrAdd %0, %2"
    "  %4: int = load8 %3 + 0"
    "  %5: int = mul %1, %1"
    "  %6: int = call h(%1)"
    "  return %1"
    "}"
end);
