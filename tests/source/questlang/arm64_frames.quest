(* Self-Hosted Quest Compiler: Test the arm64 Backend's Frame Slots and Maps
 *
 * codegen.frameSlots (docs/arm64.md section 3.13) on functions of the
 * SSA built by hand: each slot of a frame with its offset, its size, and its
 * class, the SSA type of a value in memory (a ptr, an int, a val, a QVal word
 * whose pointer-ness its descriptor says, or a real) or no type for a stack
 * slot's memory. More values live across a call than there are callee-saved
 * registers of their class are spilled, each to a slot of its type; a
 * constant, computed again, has none; a value kept in a register has none.
 * Then codegen.frameMaps: the frame as the unit's frame table gives it to
 * the collector, and what each call has live across it, in callee-saved
 * registers and in the frame's words: a ptr as a pointer, an int or a val
 * as an ambiguous word, a real not at all, and nothing that is dead. *)
(* @skip-phase: tokenize, parse, typecheck, ir_core *)

import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/codegen/arm64/codegen : questlang/codegen/arm64/Codegen
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    writer : Writer
    conv : Conv
;

let emit(s: String): Ok = begin writer.putString(writer.output s) writer.putString(writer.output "\n") end;
let none = array of :Int end;
let noTypes = array of :ssa.Type end;
let call(f: ssa.Function b: Int symbol: String args: Array(Int)): Array(Int) =
    ssa.call(f b symbol args ssa.signature(ssa.valueTypes(f args) noTypes none none) noTypes);

let show(title: String f: ssa.Function): Ok =
    begin
        emit("== " <> title)
        let slots = codegen.frameSlots(f)
        for k = 0 upto {extent slots - 1} do
            let s = slots[k]
            emit(conv.int(s.offset) <> ", " <> conv.int(s.bytes) <> " bytes: "
                <> if maybe.isSome(:ssa.Type s.type) then
                    ssa.typeName(maybe.unwrap(:ssa.Type s.type)) <> " %" <> conv.int(s.id)
                else "memory, slot " <> conv.int(s.id) end)
        end
        let maps = codegen.frameMaps(f)
        for k = 0 upto {extent maps - 1} do emit(maps[k]) end
    end;

(* 1. Twelve pointers, twelve integers, four QVal words, and ten reals live
 * across a call: ten x and eight d registers survive it, so the rest are
 * spilled, each to a slot of its type; the constant used after the call is
 * computed again, so it has no slot *)
let spills = ssa.newFunction("spills" false array of ssa.typePtr end array of ssa.typeInt end);
let p0 = vector.get(:Int ssa.block(spills 0).params 0);
let ptrs = array of(12 0);
let ints = array of(12 0);
let reals = array of(10 0);
let words = array of(4 0);
for k = 0 upto 11 do
    ptrs[k] := ssa.load(spills 0 p0 {8 * k} 8 false ssa.typePtr)
    ints[k] := ssa.load(spills 0 p0 {100 + {8 * k}} 8 false ssa.typeInt)
end;
for k = 0 upto 9 do reals[k] := ssa.load(spills 0 p0 {200 + {8 * k}} 8 false ssa.typeReal) end;
for k = 0 upto 3 do words[k] := ssa.load(spills 0 p0 {300 + {8 * k}} 8 false ssa.typeVal) end;
let seven = ssa.constant(spills 0 7);
let ignored = call(spills 0 "g" none);
let var total = seven;
for k = 0 upto 11 do
    total := ssa.binary(spills 0 ssa.opAdd total ssa.emit(spills 0 ssa.opPtrToInt array of ptrs[k] end ssa.typeInt))
    total := ssa.binary(spills 0 ssa.opAdd total ints[k])
end;
for k = 0 upto 3 do total := ssa.binary(spills 0 ssa.opAdd total ssa.fromVal(spills 0 words[k] ssa.typeInt)) end;
let var sum = reals[0];
for k = 1 upto 9 do sum := ssa.binary(spills 0 ssa.opFadd sum reals[k]) end;
total := ssa.binary(spills 0 ssa.opAdd total ssa.emit(spills 0 ssa.opRealBits array of sum end ssa.typeInt));
ssa.terminate(spills 0 option termReturn of ssa.Terminator with let values = array of total end end);
show("spills" spills);

(* 2. A stack slot whose address a call is passed: memory, whose words have
 * no class here; the parameter, live across the call in a callee-saved
 * register, has no slot *)
let held = ssa.newFunction("held" false array of ssa.typeInt end array of ssa.typeInt end);
let h0 = vector.get(:Int ssa.block(held 0).params 0);
let cell = ssa.newSlot(held 24 8);
let at = ssa.slotAddress(held 0 cell);
ssa.store(held 0 at 0 8 h0);
let ignored2 = call(held 0 "g" array of at end);
let back = ssa.load(held 0 at 0 8 false ssa.typeInt);
ssa.terminate(held 0 option termReturn of ssa.Terminator with
    let values = array of ssa.binary(held 0 ssa.opAdd back h0) end
end);
show("held" held);

(* 3. Slots shared by type: twelve pointers live across a first call, then
 * twelve integers across a second, then twelve pointers again across a third,
 * each group dead before the next is loaded. The integers do not take the
 * first pointers' slots, though those are free; the second pointers do *)
let typed = ssa.newFunction("typed" false array of ssa.typePtr end array of ssa.typeInt end);
let q0 = vector.get(:Int ssa.block(typed 0).params 0);
let across(base: Int type: ssa.Type into: Int): Int =
    begin
        let vs = array of(12 0)
        for k = 0 upto 11 do vs[k] := ssa.load(typed 0 q0 base + {8 * k} 8 false type) end
        let ignored = call(typed 0 "g" none)
        let var t = into
        for k = 0 upto 11 do
            let x = if type is ssa.typePtr then ssa.emit(typed 0 ssa.opPtrToInt array of vs[k] end ssa.typeInt)
                else vs[k] end
            t := ssa.binary(typed 0 ssa.opAdd t x)
        end
        t
    end;
let t1 = across(0 ssa.typePtr ssa.constant(typed 0 0));
let t2 = across(100 ssa.typeInt t1);
let t3 = across(200 ssa.typePtr t2);
ssa.terminate(typed 0 option termReturn of ssa.Terminator with let values = array of t3 end end);
show("typed" typed);
