(* Self-Hosted Quest Compiler: Test Switches Made Tables
 *
 * questlang/ssa/tables (docs/ssa.md section 4.1) on units of the SSA written
 * as text and read by questlang/ssa/parser, each printed before and after the
 * pass and verified. Made tables: integers from cases 0 to 4 with a default
 * that raises, strings (symbols' addresses) from cases starting at 3, cases
 * with gaps whose default passes a constant too, negative cases, arms that
 * pass through more than one block, and a join of two parameters, one passed
 * alike by every arm. Left: cases with gaps and a default that raises, sparse
 * cases, three cases, an arm with an addition, arms going to different
 * blocks, arms passing reals, and arms passing an argument alike but not a
 * constant where they differ. *)
(* @skip-phase: tokenize, parse, typecheck, ir_core *)

import
    questlang/ssa/parser : questlang/ssa/Parser
    questlang/ssa/printer : questlang/ssa/Printer
    questlang/ssa/tables : questlang/ssa/Tables
    questlang/ssa/verify : questlang/ssa/Verify
    util/strutil : util/Strutil
    writer : Writer
;

let emit(s: String): Ok = writer.putString(writer.output s);

let show(title: String lines: Array(String)): Ok =
    begin
        emit("== " <> title <> "\n")
        let u = parser.readUnit(strutil.joinArray("\n" lines) <> "\n")
        emit(printer.formatUnit(u))
        tables.tableUnit(u)
        emit("-- after tables\n")
        emit(printer.formatUnit(u))
        try verify.checkUnit(u) when verify.verifyError with m then emit(m <> "\n") end
    end;

show("integers, cases 0 to 4, a default that raises" array of
    "function index(%0: int): int {"
    "b0(%0: int):"
    "  switch %0 [0: b1(), 1: b2(), 2: b3(), 3: b4(), 4: b5()] default b6()"
    "b1():"
    "  %1: int = const 10"
    "  jump b7(%1)"
    "b2():"
    "  %2: int = const 11"
    "  jump b7(%2)"
    "b3():"
    "  %3: int = const 12"
    "  jump b7(%3)"
    "b4():"
    "  %4: int = const 13"
    "  jump b7(%4)"
    "b5():"
    "  %5: int = const 14"
    "  jump b7(%5)"
    "b6():"
    "  call quest_raise_variant_error()"
    "  unreachable"
    "b7(%6: int):"
    "  return %6"
    "}"
end);

show("strings, cases 3 to 6, in another order" array of
    "function name(%0: int): ptr {"
    "b0(%0: int):"
    "  switch %0 [5: b1(), 3: b2(), 6: b3(), 4: b4()] default b5()"
    "b1():"
    "  %1: ptr = symbol qs_1"
    "  jump b6(%1)"
    "b2():"
    "  %2: ptr = symbol qs_2"
    "  jump b6(%2)"
    "b3():"
    "  %3: ptr = symbol qs_3"
    "  jump b6(%3)"
    "b4():"
    "  %4: ptr = symbol qs_4 + 8"
    "  jump b6(%4)"
    "b5():"
    "  call quest_raise_variant_error()"
    "  unreachable"
    "b6(%5: ptr):"
    "  return %5"
    "}"
    "data qs_1 text \"one\""
    "data qs_2 text \"two\""
    "data qs_3 text \"three\""
    "data qs_4 text \"four\""
end);

show("gaps, filled by a default that passes a constant" array of
    "function gaps(%0: int): int {"
    "b0(%0: int):"
    "  %1: int = const 7"
    "  switch %0 [0: b1(), 2: b2(), 4: b3(), 6: b4()] default b5(%1)"
    "b1():"
    "  %2: int = const 1"
    "  jump b5(%2)"
    "b2():"
    "  %3: int = const 2"
    "  jump b5(%3)"
    "b3():"
    "  %4: int = const 3"
    "  jump b5(%4)"
    "b4():"
    "  %5: int = const 4"
    "  jump b5(%5)"
    "b5(%6: int):"
    "  return %6"
    "}"
end);

show("negative cases, arms through two blocks" array of
    "function signs(%0: int): int {"
    "b0(%0: int):"
    "  switch %0 [-2: b1(), -1: b2(), 0: b3(), 1: b4()] default b8()"
    "b1():"
    "  %1: int = const -20"
    "  jump b5()"
    "b5():"
    "  jump b9(%1)"
    "b2():"
    "  jump b6()"
    "b6():"
    "  %2: int = const -10"
    "  jump b9(%2)"
    "b3():"
    "  %3: int = const 0"
    "  jump b9(%3)"
    "b4():"
    "  jump b7()"
    "b7():"
    "  %4: int = const 10"
    "  jump b9(%4)"
    "b8():"
    "  call quest_raise_variant_error()"
    "  unreachable"
    "b9(%5: int):"
    "  return %5"
    "}"
end);

show("two parameters, one passed alike" array of
    "function pair(%0: int, %1: ptr): int {"
    "b0(%0: int, %1: ptr):"
    "  switch %0 [0: b1(), 1: b2(), 2: b3(), 3: b4()] default b5()"
    "b1():"
    "  %2: int = const 5"
    "  jump b6(%1, %2)"
    "b2():"
    "  %3: int = const 6"
    "  jump b6(%1, %3)"
    "b3():"
    "  %4: int = const 7"
    "  jump b6(%1, %4)"
    "b4():"
    "  %5: int = const 8"
    "  jump b6(%1, %5)"
    "b5():"
    "  call quest_raise_variant_error()"
    "  unreachable"
    "b6(%6: ptr, %7: int):"
    "  %8: int = load8 %6 + 0"
    "  %9: int = add %8, %7"
    "  return %9"
    "}"
end);

show("left: gaps and a default that raises" array of
    "function holes(%0: int): int {"
    "b0(%0: int):"
    "  switch %0 [0: b1(), 2: b2(), 4: b3(), 6: b4()] default b5()"
    "b1():"
    "  %1: int = const 1"
    "  jump b6(%1)"
    "b2():"
    "  %2: int = const 2"
    "  jump b6(%2)"
    "b3():"
    "  %3: int = const 3"
    "  jump b6(%3)"
    "b4():"
    "  %4: int = const 4"
    "  jump b6(%4)"
    "b5():"
    "  call quest_raise_variant_error()"
    "  unreachable"
    "b6(%5: int):"
    "  return %5"
    "}"
end);

show("left: sparse cases, three cases, and an arm with an addition" array of
    "function sparse(%0: int): int {"
    "b0(%0: int):"
    "  %1: int = const 0"
    "  switch %0 [0: b1(), 10: b2(), 20: b3(), 30: b4()] default b5(%1)"
    "b1():"
    "  %2: int = const 1"
    "  jump b5(%2)"
    "b2():"
    "  %3: int = const 2"
    "  jump b5(%3)"
    "b3():"
    "  %4: int = const 3"
    "  jump b5(%4)"
    "b4():"
    "  %5: int = const 4"
    "  jump b5(%5)"
    "b5(%6: int):"
    "  return %6"
    "}"
    "function three(%0: int): int {"
    "b0(%0: int):"
    "  %1: int = const 0"
    "  switch %0 [0: b1(), 1: b2(), 2: b3()] default b4(%1)"
    "b1():"
    "  %2: int = const 1"
    "  jump b4(%2)"
    "b2():"
    "  %3: int = const 2"
    "  jump b4(%3)"
    "b3():"
    "  %4: int = const 3"
    "  jump b4(%4)"
    "b4(%5: int):"
    "  return %5"
    "}"
    "function adds(%0: int): int {"
    "b0(%0: int):"
    "  %1: int = const 0"
    "  switch %0 [0: b1(), 1: b2(), 2: b3(), 3: b4()] default b5(%1)"
    "b1():"
    "  %2: int = const 1"
    "  jump b5(%2)"
    "b2():"
    "  %3: int = const 2"
    "  jump b5(%3)"
    "b3():"
    "  %4: int = add %0, %0"
    "  jump b5(%4)"
    "b4():"
    "  %5: int = const 4"
    "  jump b5(%5)"
    "b5(%6: int):"
    "  return %6"
    "}"
end);

show("left: different joins, reals, and a value not a constant" array of
    "function joins(%0: int): int {"
    "b0(%0: int):"
    "  %1: int = const 0"
    "  switch %0 [0: b1(), 1: b2(), 2: b3(), 3: b4()] default b5(%1)"
    "b1():"
    "  %2: int = const 1"
    "  jump b5(%2)"
    "b2():"
    "  %3: int = const 2"
    "  jump b5(%3)"
    "b3():"
    "  %4: int = const 3"
    "  jump b6(%4)"
    "b4():"
    "  %5: int = const 4"
    "  jump b5(%5)"
    "b5(%6: int):"
    "  return %6"
    "b6(%7: int):"
    "  %8: int = add %7, %7"
    "  return %8"
    "}"
    "function reals(%0: int): real {"
    "b0(%0: int):"
    "  %1: real = realConst 0"
    "  switch %0 [0: b1(), 1: b2(), 2: b3(), 3: b4()] default b5(%1)"
    "b1():"
    "  %2: real = realConst 4607182418800017408"
    "  jump b5(%2)"
    "b2():"
    "  %3: real = realConst 4611686018427387904"
    "  jump b5(%3)"
    "b3():"
    "  %4: real = realConst 4613937818241073152"
    "  jump b5(%4)"
    "b4():"
    "  %5: real = realConst 4616189618054758400"
    "  jump b5(%5)"
    "b5(%6: real):"
    "  return %6"
    "}"
    "function mixed(%0: int, %1: int): int {"
    "b0(%0: int, %1: int):"
    "  %2: int = const 0"
    "  switch %0 [0: b1(), 1: b2(), 2: b3(), 3: b4()] default b5(%2)"
    "b1():"
    "  %3: int = const 1"
    "  jump b5(%3)"
    "b2():"
    "  jump b5(%1)"
    "b3():"
    "  %4: int = const 3"
    "  jump b5(%4)"
    "b4():"
    "  %5: int = const 4"
    "  jump b5(%5)"
    "b5(%6: int):"
    "  return %6"
    "}"
end);
