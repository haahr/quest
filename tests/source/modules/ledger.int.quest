(* A module whose abstract type is a tuple with a var component, an immutable
 * one, and a closure, for abstract_tuple_fields *)

interface Ledger
export
    T::TYPE
    new(name: String start: Int): T
    name(l: T): String
    balance(l: T): Int
    add(l: T amount: Int): Ok
    describe(l: T): String
end;
