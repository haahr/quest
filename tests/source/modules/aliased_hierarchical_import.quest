(* An import names a hierarchical module and interface under aliases of its own: util/math, which imports its sibling
   util/offset by its bare name. Compiled to C, util/math's generated header does not hide the C library's <math.h>,
   though the build directory's util is on the include path. *)
(* @echo *)

import m : M = util/math : util/Math;
let res1: Int = m.add(10 20);
let res2: Int = m.addWithOffset(5);
res1 + res2;
m.square(7)
