module marks : Marks
export
    Let T = Record n: Int end
    let mark(n: Int): T = record n = n end
    let total(marks: Array(T)): Int =
        begin
            let var sum = 0
            for i = 0 upto {extent(marks) - 1} do sum := sum + marks[i].n end
            sum
        end
    let totaler(): All(marks: Array(T)) Int = total
    let fill(n: Int): Array(T) = array of(n mark(1))
    let setFirst(marks: Array(T) m: T): Ok = marks[0] := m
end;
