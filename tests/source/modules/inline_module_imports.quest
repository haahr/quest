(* A module declared in a program sees library modules only through its own imports.
   Compiled code cannot use a module declared in the program yet ("Fix C calls to functions of inline modules" in
   docs/tasklist.md), so this test is not run in C. *)
(* @echo *)
(* @skip-phase: run_c_compiled *)

interface Counter export get: Int end;
module counter: Counter
    import int: IntOp
export
    let get: Int = int.abs(~5);
end;
counter.get
