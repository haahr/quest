(* scaler and util/scaler implement different interfaces named Scaler, and each imports its own sibling helper: the
   top-level helper or util/helper. Every import names the right unit, whichever is imported first: here the
   top-level helper, then util/scaler, then scaler. *)

import helper : Helper;
import um : UScaler = util/scaler : util/Scaler;
import m = scaler : Scaler;
um.combine(6 7) + m.combine(100) + helper.bonus
