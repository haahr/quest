(* A string builder as an object: a recursive tuple whose components are
 * closures over a util/stringBuilder buffer, each append returning the object
 * so that calls chain: b.str("x = ").int(x).char('\n'). The standard library's
 * builder was this until its functions replaced it, as costlier than they are;
 * the style stays here as a test of the compiler (a recursive tuple type, a
 * let rec tuple whose components close over it, calls through components). *)
interface ChainBuilder
    import wordLib = word: Word
export
    Def Rec T = Tuple
        str(s: String): T
        strShared(s: String): T
        char(c: Char): T
        int(n: Int): T
        real(r: Real): T
        bool(b: Bool): T
        word(w: wordLib.T): T
        sub(s: String start: Int size: Int): T
        repeat(c: Char n: Int): T
        clear(): T
        length(): Int
        toString(): String
    end

    new(): T
end;
