(* A member of a recursive type group that does not refer to the group is its unfolding: a tuple built of it in
   another module than the one that declares it has the same representation (the C backend once gave the member a
   struct of its own). *)

import groupItems: GroupItems;
import itemBuilder: ItemBuilder;
import util/maybe : util/Maybe;
import writer: Writer;
import conv: Conv;

let n = groupItems.node(array of itemBuilder.item(3 "x") itemBuilder.item(4 "y") end);
writer.putString(writer.output conv.int(n.n) <> " " <> conv.int(n.items[1].offset) <> " " <>
    maybe.unwrapOr(:String n.items[0].tag "none") <> " " <> n.items[0].names[1] <> "\n");
