(* A module inlined into its importer (inlined_var_abstract.quest) with a var
 * parameter of an abstract type, which is laid out as a Real inside the
 * module and generically outside it *)
interface OpenedCounter
export
    T::TYPE
    make(x: Real): T
    (* c, 1.5 more *)
    bump(var c: T): Ok
    get(c: T): Real
end
