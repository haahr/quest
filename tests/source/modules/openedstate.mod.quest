module openedState : OpenedState
export
    let error: Exception = exception error: Ok end
    let label = "opened"
    let check(n: Int): Int = if n < 0 then raise error end else 2 * n end
    let isLabel(s: String): Bool = s is label
    let calls = tuple let var n = 0 end
    let bump(): Int = begin calls.n := calls.n + 1 calls.n end
    let counted(limit: Int): Int = if calls.n > limit then raise error end else calls.n end
    Let T = Fun(A::TYPE) Tuple get: All() A end
    let wrap(A::TYPE)(x: A): T(A) = tuple let get = fun(): A x end
    let apply(A::TYPE)(t: T(A)): A = t.get()
    let applyCounted(A::TYPE)(t: T(A)): A = begin bump() t.get() end
end
