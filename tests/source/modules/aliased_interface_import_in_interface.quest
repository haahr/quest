(* An interface that names a type through an aliased interface import
 * (import :PT = :PointType, then PT.P) keeps the alias in its .qi, so its
 * importers, which read the .qi, still find the type. *)
import : PT = : PointType
import aliasuse : AliasUse
let p: PT.P = tuple let x = 3 let y = 4 end
aliasuse.sum(p)
