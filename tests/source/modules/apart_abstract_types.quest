(* A whole program's module compiled apart (--apart) lays its abstract types out
 * opaquely in its own object, so the program must see them opaquely too: here
 * realbox.T is a boxed Real there, not an unboxed one. *)
(* @apart: tests/source/modules/realbox *)
import realbox : RealBox
let a = realbox.make(3.5)
let b = realbox.make(9.25)
realbox.get(a)
