(* An imported module's manifest record type with fields named long and
 * default: the C header of its interface spells the record's struct fields as
 * C names, so the program compiles and prints 3 + 4 *)
import conv : Conv
import keywordFields : KeywordFields
import writer : Writer

let r = keywordFields.make(3)
writer.putString(writer.output conv.int(r.long + r.default) <> "\n")
