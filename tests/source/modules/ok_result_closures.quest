(* A closure returning Ok, passed to a module's polymorphic function at Ok: compiled code adapts it to the generic
   result, which C represents as a value where the closure returns nothing. *)

import runner: Runner;
let show(n: Int): Ok = begin writer.putString(writer.output conv.int(n)) writer.putString(writer.output "\n") end;
let inScope(body: All() Ok): Ok = runner.run(:Ok fun(s: Int): Ok body());
inScope(fun(): Ok show(1));
runner.run(:Ok fun(s: Int): Ok show(s));
show(runner.run(:Int fun(s: Int): Int s + 1));
