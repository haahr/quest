module usepick : UsePick
import pick: Pick
export
    let var total = 50000;
    let combine(): Int =
        begin
            let var a = 1;
            let var b = 20;
            pick.swap(@a @b);
            pick.swap(@total @b);
            let p = pick.point(300 4000);
            pick.first(:Int a b) + total + p.x + p.y
        end;
end;
