(* An interface exports a type operator whose body is an option with payloads. Compiled separately, the operator
   is written to the .qi file and read back when the program is compiled. *)

import writer: Writer;
import conv: Conv;
import shapes: Shapes;

let c: shapes.Shape = option circle of shapes.Shape with let radius = 2 end;
let s: shapes.ShapeOf(Int) = option square of shapes.ShapeOf(Int) with let side = 3 end;
writer.putString(writer.output conv.int(shapes.area(c)) <> " " <> conv.int(shapes.area(s)) <> "\n");
