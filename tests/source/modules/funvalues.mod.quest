module funValues : FunValues export
    let apply(A::TYPE x: A g: All(a: A) String): String = g(x);
    let applyString(x: String g: All(a: String) String): String = g(x);
    let twice(s: String): String = s <> s;
    let shout(s: String): String = s <> "!";

    (* Module functions passed as values: to a polymorphic parameter, which needs an adapter, and directly *)
    let run(s: String): String = apply(:String s twice) <> " " <> applyString(s shout);
end;
