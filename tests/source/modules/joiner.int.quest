(* A module exporting a symbolic value and a symbolic type operator, for
 * symbolic_member_selection.quest *)
interface Joiner
export
    T::TYPE
    (* A pair: a type operator with a symbolic name *)
    Def # = Fun(A::TYPE B::TYPE) Tuple fst: A snd: B end
    text(s: String): T
    (* a's text, then b's *)
    <+>(a: T b: T): T
    show(t: T): String
end;
