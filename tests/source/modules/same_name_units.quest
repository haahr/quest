(* Units in different directories may have the same name: counter beside this program and util/counter implement
   different interfaces named Counter, and util/stepper's import of counter names its sibling util/counter. *)

import counter: Counter;
import c2 = util/counter : util/Counter;
import stepper = util/stepper : util/Stepper;
stepper.next(counter.get(counter.inc(counter.new(c2.step))))
