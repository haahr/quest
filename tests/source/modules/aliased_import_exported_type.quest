(* An interface's exported type names hierarchical libraries' abstract types
   through imports under aliases (aliasTally imports collections/vector as vec
   and util/path as pathLib): its .qi records them by their modules' own names
   (vector.T, path.T), which an importer that imports neither library still
   resolves. *)
import
    aliasTally : AliasTally
    writer : Writer
    conv : Conv
;
let t = aliasTally.make("a//b/./c");
aliasTally.add(t 3);
aliasTally.add(t 4);
writer.putString(writer.output "total " <> conv.int(aliasTally.total(t)) <> "\n")
