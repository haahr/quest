interface PolyTrees
export
    Def Rec List(A::TYPE) = Option nil cons with head: A tail: List(A) end end
    Def Rec Tree(A::TYPE) = Variant leaf: A node: Wood(A) end
    and Wood(A::TYPE) = Record trees: List(Tree(A)) end
    leaf(n: Int): Tree(Int)
    node(trees: List(Tree(Int))): Tree(Int)
    sum(t: Tree(Int)): Int
    sumWood(w: Wood(Int)): Int
    (* Polymorphic, so laid out generically, and not specialized for clients compiled separately *)
    cons(A::TYPE head: A tail: List(A)): List(A)
    nil(A::TYPE): List(A)
    leafOf(A::TYPE x: A): Tree(A)
    count(A::TYPE t: Tree(A)): Int
end;
