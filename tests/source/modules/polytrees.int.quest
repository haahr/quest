interface PolyTrees
export
    Def Rec List(A::TYPE) = Option nil cons with head: A tail: List(A) end end
    Def Rec Tree(A::TYPE) = Variant leaf: A node: Wood(A) end
    and Wood(A::TYPE) = Record trees: List(Tree(A)) end
    leaf(n: Int): Tree(Int)
    node(trees: List(Tree(Int))): Tree(Int)
    sum(t: Tree(Int)): Int
    sumWood(w: Wood(Int)): Int
end;
