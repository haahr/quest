(* Top-level lets whose values are ifs: each if's join point continues the
   initializer, so the members after it, the exports and the record are made in
   the join's continuation. *)
module ifvalues : IfValues
export
    let limit = if {3 > 0} andif {3 > 1} then 3 else 1000 end
    let scale =
        begin
            if limit > 2 then 100 else 1 end
        end
    let twice(n: Int): Int = n * 2
end
