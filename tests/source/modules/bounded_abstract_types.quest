(* A module's abstract type with a bound (T::POWER(B) in its interface) is usable as its bound outside the module,
   and its values keep their representation: a record viewed at its bound still has the fields the module gave it,
   and a variant keeps its case. Outside the module such a value is viewed at the bound, whose fields and cases may
   be numbered differently from the representation's, so compiled code converts it at the module's boundary.
   The interface is compiled separately, so its .qi records the bounds. *)
(* @echo *)

import small: Small = geom/small : geom/Small;
let three = small.n(3);
three + 1;
let p = small.p(4);
p.x;
small.y(p);
let asRecord: Record x: Int end = p;
asRecord.x;
let q = small.q(5);
q.y;
small.qx(q);
small.y(small.origin);
small.origin.x;
case small.b(false) when a with i then 0 - i when b with t then if t then 1 else 2 end end;
small.isTrue(small.b(true));
small.isTrue(small.yes);
case small.yes when a with i then 0 - i when b with t then if t then 1 else 2 end end
