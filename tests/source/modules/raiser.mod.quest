module raiser : Raiser
export
    let error: Exception = exception error: Ok end
    (* A generic helper that raises the module's own exception: inlined into
     * never, whose body becomes the raise alone, before never is inlined
     * outside the module *)
    let fail(A::TYPE): A = raise error end
    let quotient(i: Int d: Int): Int = if d is 0 then fail(:Int) else i / d end
    let never(): Int = fail(:Int)
end;
