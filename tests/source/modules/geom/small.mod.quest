module small : Small
export
    Let N = Int;
    Let P = Record x: Int y: Int end;
    Let Q = Record x: Int y: Int end;
    Let V = Variant b: Bool end;
    let n(i: Int): N = i;
    let p(i: Int): P = record x = i y = i + 1 end;
    let y(p: P): Int = p.y;
    let q(i: Int): Q = record x = i y = i * 10 end;
    let qx(q: Q): Int = q.x;
    let b(b: Bool): V = variant b of V with b end;
    let isTrue(v: V): Bool = case v when b with t then t end;
    let origin: P = record x = 0 y = 0 end;
    let yes: V = variant b of V with true end;
end;
