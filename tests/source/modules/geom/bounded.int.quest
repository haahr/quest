interface Bounded
export
    Def Small = Record a: Int end
    Def Sized = Record size: All() Int end
    getA(A <: Small x: A): Int
    keep(A <: Small x: A): A
    measure(A <: Sized x: A): Int
    measureInline(A <: Record size: All() Int end x: A): Int
    applied(F::ALL(X::TYPE) TYPE x: F(Int) f(y: F(Int)): Int): Int
end;
