module bounded : Bounded
export
    Let Small = Record a: Int end
    Let Sized = Record size: All() Int end
    let getA(A <: Small x: A): Int = x.a
    let keep(A <: Small x: A): A = x
    let measure(A <: Sized x: A): Int = x.size()
    let measureInline(A <: Record size: All() Int end x: A): Int = x.size() + 1
    let applied(F::ALL(X::TYPE) TYPE x: F(Int) f(y: F(Int)): Int): Int = f(x)
end;
