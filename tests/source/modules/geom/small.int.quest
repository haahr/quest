interface Small
export
    N::POWER(Int)
    P::POWER(Record x: Int end)
    Q::POWER(Record y: Int end)
    V::POWER(Variant a: Int b: Bool end)
    n(i: Int): N
    p(i: Int): P
    y(p: P): Int
    q(i: Int): Q
    qx(q: Q): Int
    b(b: Bool): V
    isTrue(v: V): Bool
    origin: P
    yes: V
end;
