module ring : Ring
import list: List
export
    Let T = Record label: String items: list.T(Int) end
    let make(label: String items: Array(Int)): T = record label = label items = list.enum(:Int items) end
    let label(r: T): String = r.label
    let rec sum(xs: list.T(Int)): Int = if list.null(:Int xs) then 0 else list.head(:Int xs) + sum(list.tail(:Int xs)) end
    let total(r: T): Int = sum(r.items)
end;
