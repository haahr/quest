(* Abstract types bounded by tuples and an option: S is its bound, W a wider
 * tuple, U a wider tuple whose record component has more fields and which has
 * a var component, and O an option whose case has more components *)
module held : Held
export
    Let S = Tuple a: Int end
    Let W = Tuple a: Int b: Int end
    Let U = Tuple a: Record x: Int y: Int end var n: Int b: Int end
    Let O = Option b with x: Int y: Int end end
    let s(i: Int): S = tuple let a = i end
    let w(i: Int): W = tuple let a = i let b = i + 1 end
    let wb(w: W): Int = w.b
    let u(i: Int): U = tuple let a = record x = i y = i * 10 end let var n = i + 1 let b = i + 2 end
    let uy(u: U): Int = u.a.y + u.n + u.b
    let o(i: Int): O = option b of O with let x = i let y = i + 1 end
    let oy(o: O): Int = case o when b with t then t.y end
end;
