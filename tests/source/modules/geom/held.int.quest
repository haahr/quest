interface Held
export
    S::POWER(Tuple a: Int end)
    W::POWER(Tuple a: Int end)
    U::POWER(Tuple a: Record x: Int end var n: Int end)
    O::POWER(Option a b with x: Int end end)
    s(i: Int): S
    w(i: Int): W
    wb(w: W): Int
    u(i: Int): U
    uy(u: U): Int
    o(i: Int): O
    oy(o: O): Int
end;
