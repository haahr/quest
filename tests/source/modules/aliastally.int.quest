(* An interface whose exported type names hierarchical libraries' abstract types
   through imports under aliases of its own (see aliased_import_exported_type) *)
interface AliasTally
import
    vec = collections/vector : collections/Vector
    pathLib = util/path : util/Path
export
    Def T = Tuple
        items: vec.T(Int)
        origin: pathLib.T
    end
    make(origin: String): T
    add(t: T n: Int): Ok
    total(t: T): Int
end
