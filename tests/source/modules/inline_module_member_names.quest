(* The members of a module declared in the program are the module's, not top-level declarations: the program may
   declare functions, values, and exceptions with the same names. *)
(* @echo *)

interface Small
export
    q(i: Int): Int
    v: Int
    oops: Exception(Int)
end;
module small : Small
export
    let q(i: Int): Int = i * 10;
    let v: Int = 7;
    let oops = exception oops: Int end;
end;
let q = small.q(5);
let v = small.v + 1;
let oops = exception oops: Int end;
let caught = try raise small.oops with 3 as Int end when oops with n then 0 - n when small.oops with n then n end;
q + v + caught
