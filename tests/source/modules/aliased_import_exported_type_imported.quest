(* As aliased_import_exported_type, with the importer importing the aliased
   libraries itself, under their own names and before aliasTally, and using the
   exported type's components through them. *)
import
    collections/vector : collections/Vector
    util/path : util/Path
    aliasTally : AliasTally
    writer : Writer
    conv : Conv
;
let t = aliasTally.make("a//b/./c");
aliasTally.add(t 5);
vector.append(:Int t.items 6);
writer.putString(writer.output "total " <> conv.int(aliasTally.total(t))
    <> ", items " <> conv.int(vector.length(:Int t.items)) <> ", origin " <> path.toString(t.origin) <> "\n")
