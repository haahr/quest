module aliasTally : AliasTally
import
    vec = collections/vector : collections/Vector
    pathLib = util/path : util/Path
export
    Let T = Tuple
        items: vec.T(Int)
        origin: pathLib.T
    end
    let make(origin: String): T =
        tuple let items = vec.new(:Int) let origin = pathLib.fromString(origin) end
    let add(t: T n: Int): Ok = vec.append(:Int t.items n)
    let total(t: T): Int =
        begin
            let var sum = 0
            for i = 0 upto {vec.length(:Int t.items) - 1} do sum := sum + vec.get(:Int t.items i) end
            sum
        end
end
