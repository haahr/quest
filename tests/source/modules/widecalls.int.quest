(* Functions whose arguments outrun the registers, called between units
 * (modules/wide_calls) *)
interface WideCalls
export
    Def Point = Record x: Int y: Int end
    Def Shape = Variant dot: Int box: Point end
    Def Wide = All(a: Int b: Int c: Int d: Int e: Int f: Int g: Int p: Point h: Int
        r1: Real r2: Real r3: Real r4: Real r5: Real r6: Real r7: Real r8: Real r9: Real
        yes: Bool letter: Char no: Bool name: String shape: Shape last: Char) String
    (* Every argument, in order, as text *)
    describe: Wide
    (* A point from many arguments, its fields the sums of the Ints and the floor
     * of the Reals' *)
    point(a: Int b: Int c: Int d: Int e: Int f: Int g: Int h: Int i: Int
        r1: Real r2: Real r3: Real r4: Real r5: Real r6: Real r7: Real r8: Real r9: Real r10: Real): Point
    (* f applied to fixed arguments, from this unit *)
    callBack(f: Wide): String
end;
