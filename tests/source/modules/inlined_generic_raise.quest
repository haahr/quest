(* A module's generic helper that raises the module's exception, inlined into
 * the module's functions and those inlined into the program: a whole
 * program's copy reads the exception as the module's member (docs/tasklist.md
 * had this as a whole-program build's variable out of its scope) *)

import raiser : Raiser;
import writer: Writer;
import conv: Conv;

let print(s: String): Ok = writer.putString(writer.output s <> "\n");
let shown(f: All() Int): String = try conv.int(f()) when raiser.error then "raiser.error" end;
print("never: " <> try conv.int(raiser.never()) when raiser.error then "raiser.error" end);
print("quotient 7 2: " <> shown(fun(): Int raiser.quotient(7 2)));
print("quotient 7 0: " <> shown(fun(): Int raiser.quotient(7 0)))
