(* A recursive type group with a member that does not refer to the group (nonrecursive_group_member) *)
interface GroupItems
import
    util/maybe : util/Maybe
export
    Def Rec Node = Tuple n: Int items: Array(Item) end
    and Item = Tuple offset: Int names: Array(String) tag: maybe.T(String) end
    node(items: Array(Item)): Node
end
