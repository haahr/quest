module handler : Handler
import
    list : List
export
    Let T = Fun(K::TYPE) Tuple f: All(k: K) K end
    Def Point = Record x: Int y: Int end
    let echo(K::TYPE): T(K) = tuple let f = fun(k: K): K list.head(:K list.cons(:K k list.nil(:K))) end
    let shifted(by: Real): T(Real) = tuple let f = fun(k: Real): Real k ++ by end
    let swapped(): T(Point) = tuple let f = fun(p: Point): Point record x = p.y y = p.x end end
    let run(K::TYPE)(h: T(K) k: K): K = h.f(k)
    let runReal(h: T(Real) k: Real): Real = h.f(k)
    let runPoint(h: T(Point) p: Point): Point = h.f(p)
end
