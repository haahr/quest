interface Handler
export
    (* A handler of values of K: a closure taking one, whose C signature changes with K *)
    T::ALL(K::TYPE) TYPE
    Def Point = Record x: Int y: Int end
    (* Made by generic code, and at Real and Point by the module's own *)
    echo: All(K::TYPE) T(K)
    shifted(by: Real): T(Real)
    swapped(): T(Point)
    (* Run by generic code, and at Real and Point by the module's own *)
    run(K::TYPE)(h: T(K) k: K): K
    runReal(h: T(Real) k: Real): Real
    runPoint(h: T(Point) p: Point): Point
end
