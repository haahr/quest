module shapes : Shapes export
    Let ShapeOf(N::TYPE) = Option
        circle with radius: N end
        square with side: N end
        point
    end;
    Let Shape = ShapeOf(Int);

    let area(s: Shape): Int =
        case s
            when circle with c then 3 * c.radius * c.radius
            when square with q then q.side * q.side
            when point then 0
        end;
end;
