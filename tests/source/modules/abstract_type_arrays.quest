(* A module's functions over arrays of its abstract type (a record), which hold its values as the module's own
   functions do. *)

import marks: Marks;
let a = array of marks.mark(1) marks.mark(2) marks.mark(3) end;
let b = marks.fill(4);
marks.setFirst(b marks.mark(10));
tuple marks.total(a) marks.totaler()(a) marks.total(b) end
