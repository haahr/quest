(* Module members whose values are ifs, in a module file (ifvalues) and in a
   module the program defines: the members bound after each if, and the module's
   record, are in scope after its join. *)

import ifvalues: IfValues;

interface Local
export
    small: Int
    big: Int
end;

module local : Local
export
    let small = if {2 < 1} orif {1 < 0} then 1 else 2 end
    let big = small * 10
end;

ifvalues.twice(ifvalues.limit) + local.big + ifvalues.scale
