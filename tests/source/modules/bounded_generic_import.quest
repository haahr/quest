(* A module's generic function whose type parameter is bounded (A <: Small), or
   is a type operator, is usable from another unit: its interface's .qi records
   the bound as the reader reads it (A::POWER(Small)), whatever the bound holds,
   functions among its fields. The calls pass a wider record, the bound's own,
   and a value ascribed to the bound. *)
(* @echo *)

import bounded : Bounded = geom/bounded : geom/Bounded
let wide = record c = 4 a = 3 end
bounded.getA(wide)
bounded.getA(record a = 10 end)
bounded.getA(:Bounded.Small record z = 1 a = 100 end)
bounded.keep(wide).c
bounded.measure(record size = fun(): Int 7 name = "seven" end)
bounded.measureInline(record size = fun(): Int 7 name = "seven" end)
bounded.applied(:Fun(X::TYPE) Array(X) array of 1 2 3 end fun(y: Array(Int)): Int extent y)
