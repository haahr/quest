(* T is manifest here, so in a whole program a ledger's tuple reaches this
 * module's functions through a copy at T from the program's ledger.T *)

module ledger : Ledger
import
    conv: Conv
export
    Let T = Tuple name: String var balance: Int describe: All() String end
    let new(name: String start: Int): T =
        begin
            let t = tuple let name = name let var balance = start let describe = fun(): String name end
            t
        end
    let name(l: T): String = l.name
    let balance(l: T): Int = l.balance
    let add(l: T amount: Int): Ok = l.balance := l.balance + amount
    let describe(l: T): String = l.describe() <> " has " <> conv.int(l.balance)
end;
