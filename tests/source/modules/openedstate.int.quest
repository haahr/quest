(* A module inlined into its importers (inlined_module_state.quest): its
 * state with identity, an exception, a string, and a variable, and an
 * abstract type of closures, whose layouts disagree at Real *)
interface OpenedState
export
    error: Exception
    label: String
    (* n doubled, or error raised if n is negative *)
    check(n: Int): Int
    (* Whether s is label itself *)
    isLabel(s: String): Bool
    (* The number of calls of bump so far, this one included *)
    bump(): Int
    (* bump's count, or error raised once it passes limit *)
    counted(limit: Int): Int
    T::ALL(A::TYPE) TYPE
    wrap(A::TYPE)(x: A): T(A)
    apply(A::TYPE)(t: T(A)): A
    (* t's value, after a bump *)
    applyCounted(A::TYPE)(t: T(A)): A
end
