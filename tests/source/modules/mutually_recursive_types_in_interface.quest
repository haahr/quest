(* An interface declares mutually recursive types, which its module and its clients share. *)

import forests: Forests;
let t = forests.node(array of forests.leaf(1) forests.leaf(2) end);
let direct: forests.Tree = variant node of forests.Tree with record trees = array of t forests.leaf(3) end end end;
let wood: forests.Wood = case direct when node with w then w else record trees = array of end end end;
forests.sum(direct) + forests.sum(wood.trees[1])
