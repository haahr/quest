(* A module's member with a symbolic name is selected as m.<+>, as
   Typeful Programming's grammar has it (Value "." ide, an ide alphanumeric
   or symbolic): bound to the same name, it is used infix (grouping to the
   right, as every operator does), and it is called prefix and passed as a
   value; a symbolic type operator is selected the same way, m.#. *)
import
    joiner : Joiner
    writer : Writer
;
let print(s: String): Ok = writer.putString(writer.output s <> "\n");
let <+> = joiner.<+>;
print(joiner.show(joiner.text("a") <+> joiner.text("b") <+> joiner.text("c")));
print(joiner.show(joiner.<+>(joiner.text("d") joiner.text("e"))));
let fold(parts: Array(joiner.T) join(a: joiner.T b: joiner.T): joiner.T): joiner.T =
    begin
        let var result = joiner.text("")
        for i = 0 upto extent(parts) - 1 do result := join(result parts[i]) end
        result
    end;
print(joiner.show(fold(array of joiner.text("f") joiner.text("g") joiner.text("h") end joiner.<+>)));
print(joiner.show(fold(array of joiner.text("i") joiner.text("j") end {<+>})));
let p: joiner.#(Int String) = tuple 1 "k" end;
print(p.snd);
