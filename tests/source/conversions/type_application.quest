print("Nest/Int argument: " <> conv.int(gN72(sN72)));
print("Nest/Int result: " <> conv.int(mN72(8).first.x));

let sN73: Nest(Bool) = tuple let first = tuple let x = true end let n = 2 end;
let gN73 = getNest(:Bool);
let mN73 = makeNest(:Bool);
print("Nest/Bool argument: " <> conv.bool(gN73(sN73)));
print("Nest/Bool result: " <> conv.bool(mN73(false).first.x));

let sN74: Nest(Real) = tuple let first = tuple let x = 2.5 end let n = 2 end;
let gN74 = getNest(:Real);
let mN74 = makeNest(:Real);
print("Nest/Real argument: " <> conv.real(gN74(sN74)));
print("Nest/Real result: " <> conv.real(mN74(3.5).first.x));

let sN75: Nest(Char) = tuple let first = tuple let x = 'q' end let n = 2 end;
let gN75 = getNest(:Char);
let mN75 = makeNest(:Char);
print("Nest/Char argument: " <> conv.char(gN75(sN75)));
print("Nest/Char result: " <> conv.char(mN75('r').first.x));

let sN76: Nest(String) = tuple let first = tuple let x = "s" end let n = 2 end;
let gN76 = getNest(:String);
let mN76 = makeNest(:String);
print("Nest/String argument: " <> gN76(sN76));
print("Nest/String result: " <> mN76("t").first.x);

let sN77: Nest(P) = tuple let first = tuple let x = record a = 4 end end let n = 2 end;
let gN77 = getNest(:P);
let mN77 = makeNest(:P);
print("Nest/P argument: " <> conv.int(gN77(sN77).a));
print("Nest/P result: " <> conv.int(mN77(record a = 9 end).first.x.a));

let sN78: Nest(V) = tuple let first = tuple let x = variant p of V with 5 end end let n = 2 end;
let gN78 = getNest(:V);
let mN78 = makeNest(:V);
print("Nest/V argument: " <> conv.int(case gN78(sN78) when p with k then k else 0 end));
print("Nest/V result: " <> conv.int(case mN78(variant p of V with 6 end).first.x when p with k then k else 0 end));

let sN79: Nest(B) = tuple let first = tuple let x = tuple let a = 6 end end let n = 2 end;
let gN79 = getNest(:B);
let mN79 = makeNest(:B);
print("Nest/B argument: " <> conv.int(gN79(sN79).a));
print("Nest/B result: " <> conv.int(mN79(tuple let a = 7 end).first.x.a));
