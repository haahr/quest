print("List/P as a type argument: " <> conv.int(id(:List(P) sN61)!cons.head.a));
print("List/P as a component: " <> conv.int(boxed(:List(P) sN61).x!cons.head.a));
print("List/P through a first-class value: " <> conv.int(idF(:List(P) sN61)!cons.head.a));

