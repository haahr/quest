print("Nest/P stored generically: " <> conv.int(aN66[0].first.x.a));

let aN67: Array(Nest(V)) = array of tuple let first = tuple let x = variant p of V with 5 end end let n = 2 end end;
print("Nest/V read generically: " <> conv.int(case firstNest(:V aN67) when p with k then k else 0 end));
putNest(:V aN67 tuple let first = tuple let x = variant p of V with 6 end end let n = 2 end);
print("Nest/V stored generically: " <> conv.int(case aN67[0].first.x when p with k then k else 0 end));

let aN68: Array(Nest(B)) = array of tuple let first = tuple let x = tuple let a = 6 end end let n = 2 end end;
print("Nest/B read generically: " <> conv.int(firstNest(:B aN68).a));
putNest(:B aN68 tuple let first = tuple let x = tuple let a = 7 end end let n = 2 end);
print("Nest/B stored generically: " <> conv.int(aN68[0].first.x.a));
