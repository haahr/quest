(* real.format's 'g' on exact ties, which round to even, in the exponent form
 * and the positional one: C's rule, %g dropping the fraction's trailing
 * zeros, on both targets (docs/wasm-plan.md step 32; Apple's snprintf kept
 * them, 9.80e+03 for 9805 at 3 digits) *)

import writer : Writer;

let show(r: Real digits: Int): Ok =
    writer.putString(writer.output real.format(r 'g' digits) <> "\n");

show(9805.0 3);
show(9815.0 3);
show(98050.0 3);
show(9850.0 2);
show(125.0 2);
show(2.5 1);
show(0.125 2);
show(1250000.0 2);
show(100.0 3);
show(0.000123 3)
