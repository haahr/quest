(* Standard library: Word masks that are logical immediates at every rotation
 *
 * and, or, and xor of values the compiler cannot fold with masks whose run of
 * ones starts above bit 0, runs off the top into bit 0, or repeats, and
 * constants that are such masks: the arm64 backend writes each as an
 * immediate, which the assembler and the JIT's encoder must encode alike. *)

import word: Word;
import conv: Conv;
import writer: Writer;

let show(n: Int): Ok = writer.putString(writer.output conv.int(n) <> "\n");

let andHigh(x: Int): Int = word.toInt(word.andBits(word.fromInt(x) word.fromInt(65280)));
let andWrapped(x: Int): Int = word.toInt(word.andBits(word.fromInt(x) word.fromInt(~9223372036854775807)));
let andTop(x: Int): Int = word.toInt(word.andBits(word.fromInt(x) word.fromInt(~16)));
let orMiddle(x: Int): Int = word.toInt(word.orBits(word.fromInt(x) word.fromInt(4080)));
let xorRepeated(x: Int): Int = word.toInt(word.xorBits(word.fromInt(x) word.fromInt(71777214294589695)));
let wrapped(x: Int): Int = if x > 0 then ~9223372036854775807 else ~3 end;
let repeated(x: Int): Int = if x > 0 then ~71777214294589696 else 4080 end;

let inputs = array of 0 1 ~1 255 65535 1311768467463790320 ~1311768467463790320 end;
for i = 0 upto {extent inputs - 1} do
    let x = inputs[i]
    show(andHigh(x))
    show(andWrapped(x))
    show(andTop(x))
    show(orMiddle(x))
    show(xorRepeated(x))
    show(wrapped(x))
    show(repeated(x))
end;
