(* Stdlib: an auto value built in generic code prints its witness with the type arguments in place of the type
   parameters, in compiled code (where the witness is a descriptor instantiated at run time) as in the interpreter *)
(* @echo *)
import dynamic: Dynamic;
let f(A::TYPE x: A): Dynamic = dynamic.new(:Tuple v: A w: Int end tuple x 1 end);
let g: All(A::TYPE x: A) Dynamic = f;
let pair(A::TYPE B::TYPE a: A b: B): Dynamic = dynamic.new(:Tuple first: A second: Record r: B end both: Tuple x: A y: B end end
    tuple a record r = b end tuple a b end end);
let h: All(A::TYPE B::TYPE a: A b: B) Dynamic = pair;
g(:String "hi");
h(:Int :Record r: Bool end 3 record r = true end);
h(:Array(Int) :Tuple :Int end array of 1 end tuple 2 end);
