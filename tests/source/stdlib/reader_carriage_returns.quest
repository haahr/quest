(* Standard library: files keep their carriage returns, written and read back character for character, as in C *)

import writer: Writer;
import reader: Reader;
import ascii: Ascii;
import conv: Conv;

let w = writer.file("carriage_returns.txt");
writer.putString(w "a\r\nb\rc\n");
writer.close(w);

let r = reader.file("carriage_returns.txt");
while reader.more(r) do
    writer.putString(writer.output conv.int(ascii.val(reader.getChar(r))) <> " ")
end;
reader.close(r);
writer.putString(writer.output "\n");
