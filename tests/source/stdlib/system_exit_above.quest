(* @exit: 200 *)
(* An exit status above 125, which wasmtime cannot give a program: the wasm
 * runtime ends it with 125 and a line naming the status, which the driver
 * gives back as the status (docs/wasm.md section 4.2). The one
 * string literal below is empty, so that the program's module has no data
 * segment, which once made it invalid (section 2.7) *)
import system: System;
import writer: Writer;
writer.putString(writer.output "");
system.sysexit(200);
