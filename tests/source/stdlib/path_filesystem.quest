(* os/path's file system functions, over path.T, in a directory the test
   makes (it runs in a fresh, empty directory of its own, docs/testing.md
   section 2.2). *)
import
    conv : Conv
    system : System
    writer : Writer

    collections/vector : collections/Vector
    os/fileStats : os/FileStats
    os/files : os/Files
    os/path : os/Path
    util/maybe : util/Maybe
    util/strutil : util/Strutil

let print(s: String): Ok = writer.putString(writer.output s <> "\n")
let at(s: String): path.T = path.fromString(s)
let tryOk(what: String f: All() Ok): Ok =
    print(what <> ": " <> try begin f() "ok" end when system.error then "system.error" end)

let root = at("work")
path.mkdir(root false)
print("isDir: " <> conv.bool(path.isDir(root)) <> ", isFile: " <> conv.bool(path.isFile(root)))
tryOk("mkdir again" fun(): Ok path.mkdir(root false))
tryOk("mkdir without parents" fun(): Ok path.mkdir(at("work/x/y") false))
tryOk("mkdir with parents" fun(): Ok path.mkdir(at("work/x/y") true))

let notes = path.child(root "notes.txt")
path.writeText(notes "first line\nsecond line\n")
print("exists: " <> conv.bool(path.exists(notes)) <> ", isFile: " <> conv.bool(path.isFile(notes)))
print("readText: [" <> path.readText(notes) <> "]")
print("size: " <> conv.int(path.stat(notes).size))
path.writeText(notes "replaced")
print("readText again: [" <> path.readText(notes) <> "]")
path.writeText(path.child(root "b.txt") "")

let show(entries: Array(path.T)): Ok =
    begin
        let var line = ""
        for i = 0 upto {extent entries - 1} do line := line <> " " <> path.toString(entries[i]) end
        print("iterDir:" <> line)
    end
show(path.iterDir(root))

path.rename(notes path.child(root "a.txt"))
show(path.iterDir(root))
path.unlink(path.child(root "b.txt"))
show(path.iterDir(root))
tryOk("unlink missing" fun(): Ok path.unlink(path.child(root "b.txt")))
print("find missing: " <> conv.bool(maybe.isNone(:fileStats.T path.find(path.child(root "b.txt")))))
print("exists missing: " <> conv.bool(path.exists(at("work/missing"))))

(* os/files' operations over path.T *)
let names(v: vector.T(path.T)): String =
    begin
        let var line = ""
        for i = 0 upto {vector.length(:path.T v) - 1} do
            line := line <> " " <> path.toString(vector.get(:path.T v i))
        end
        line
    end
path.copy(path.child(root "a.txt") path.child(root "x/y/c.txt"))
print("copy: [" <> path.readText(path.child(root "x/y/c.txt")) <> "]")
print("glob **/*.txt:" <> names(path.glob(root "**/*.txt")))
path.copyTree(at("work/x") at("work/z"))
path.move(at("work/z/y/c.txt") at("work/z/d.txt"))
path.walk(root fun(q: path.T stats: fileStats.T depth: Int): Bool
    begin
        print("walk " <> conv.int(depth) <> " " <> path.toString(q))
        true
    end)
path.removeTree(at("work/z"))
print("removeTree: " <> conv.bool(not(path.exists(at("work/z")))))
print("removeTree missing: " <> try begin path.removeTree(at("work/z")) "ok" end
when files.error with f then f.message end)
let kept = tuple let var dir = path.fromString(".") end
let made = path.withTempDirectory(:Bool "quest-path." fun(dir: path.T): Bool
    begin
        kept.dir := dir
        path.writeText(path.child(dir "t") "t")
        path.isAbsolute(dir) /\ strutil.startsWith(path.name(dir) "quest-path.")
    end)
print("withTempDirectory: " <> conv.bool(made) <> ", gone " <> conv.bool(not(path.exists(kept.dir))))
let t = path.makeTempFile("quest-path." ".txt")
print("makeTempFile: " <> conv.bool(path.isFile(t) /\ strutil.endsWith(path.toString(t) ".txt")))
path.unlink(t)
