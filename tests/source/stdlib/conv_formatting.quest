(* Standard library: Conv module formatting and Cardelli ~ tilde *)

import conv : Conv
import writer : Writer

writer.putString(writer.output conv.okay())
writer.putString(writer.output "\n")
writer.putString(writer.output conv.bool(true))
writer.putString(writer.output "\n")
writer.putString(writer.output conv.bool(false))
writer.putString(writer.output "\n")
writer.putString(writer.output conv.int(42))
writer.putString(writer.output "\n")
writer.putString(writer.output conv.int(~42))
writer.putString(writer.output "\n")
(* Every count of digits: 0, each power of ten and one less, and the greatest and least Int, each negated too *)
let showInt(n: Int): Ok = writer.putString(writer.output conv.int(n) <> " " <> conv.int(0 - n) <> "\n")
showInt(0)
let var power = 1
for k = 1 upto 18 do
    showInt({power * 10} - 1)
    power := power * 10
    showInt(power)
end
showInt(9223372036854775807)
writer.putString(writer.output conv.int(~9223372036854775807 - 1) <> "\n")
writer.putString(writer.output conv.real(3.14))
writer.putString(writer.output "\n")
writer.putString(writer.output conv.real(~2.5))
writer.putString(writer.output "\n")
writer.putString(writer.output conv.char('Z'))
writer.putString(writer.output "\n")
writer.putString(writer.output conv.string("text"))
writer.putString(writer.output "\n")
