{"tuple":[["x",47]]},
{"tuple":[["x",48]]},
{"tuple":[["x",49]]},
{"tuple":[["x",50]]},
{"tuple":[["x",51]]},
{"tuple":[["x",52]]},
{"tuple":[["x",53]]},
{"tuple":[["x",54]]},
{"tuple":[["x",55]]},
{"tuple":[["x",56]]},
{"tuple":[["x",57]]},
{"tuple":[["x",58]]},
{"tuple":[["x",59]]},
{"tuple":[["x",60]]},
{"tuple":[["x",61]]},
{"tuple":[["x",62]]},
{"tuple":[["x",63]]},
{"tuple":[["x",64]]},
{"tuple":[["x",65]]},
{"tuple":[["x",66]]},
