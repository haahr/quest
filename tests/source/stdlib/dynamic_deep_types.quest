{"tuple":[["x","Int"]]}],
"type":0,"value":
[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[42]]]]]]]]
]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]}
*)

import dynamic: Dynamic;
import reader: Reader;
import writer: Writer;
import conv: Conv;

Let Deep =
    Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x:
    Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x:
    Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x:
    Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x:
    Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x:
    Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x:
    Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x:
    Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x:
    Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Tuple x: Int
    end end end end end end end end end end end end end end end end end end end end
    end end end end end end end end end end end end end end end end end end end end
    end end end end end end end end end end end end end end end end end end end end
    end end end end end end end end end end;
let d = dynamic.be(:Deep dynamic.intern(reader.input));
let d10 = d.x.x.x.x.x.x.x.x.x.x;
let d20 = d10.x.x.x.x.x.x.x.x.x.x;
let d30 = d20.x.x.x.x.x.x.x.x.x.x;
let d40 = d30.x.x.x.x.x.x.x.x.x.x;
let d50 = d40.x.x.x.x.x.x.x.x.x.x;
let d60 = d50.x.x.x.x.x.x.x.x.x.x;
let d70 = d60.x.x.x.x.x.x.x.x.x.x;
writer.putString(writer.output conv.int(d70) <> "\n");
