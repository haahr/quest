(* A file written with writer and read back with reader, in the test's own directory. *)
(* @echo *)

import writer: Writer;
import reader: Reader;
import conv: Conv;

let w = writer.file("roundtrip.txt");
writer.putString(w "Hello from Quest Reader/Writer!\n");
writer.putChar(w 'X');
writer.putString(w "\n");
writer.flush(w);
writer.close(w);

let r = reader.file("roundtrip.txt");
reader.more(r);
reader.getString(r 32);
let ch = reader.getChar(r);
conv.char(ch);
reader.getChar(r);
reader.more(r);
reader.close(r)
