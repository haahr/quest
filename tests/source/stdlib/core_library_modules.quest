(* The conv, ascii, int, real, string, arrayOp, dynamic, writer, and reader library modules, an interface-only
   import, and several imports in one phrase. *)
(* @echo *)

import conv: Conv;
import ascii: Ascii int: IntOp;
import real: RealOp;
import string: StringOp;
import arrayOp: ArrayOp;
import dynamic: Dynamic;
import writer: Writer reader: Reader;
import : Ascii;

(* conv writes negative numbers with ~ *)
conv.int(42);
conv.int(~42);
conv.real(3.14);
conv.real(~2.5);
conv.bool(true);
conv.okay();

(* ascii *)
let c = ascii.char(65);
ascii.val(c);
try ascii.char(999) when ascii.error then '?' end;

(* int and real *)
int.abs(0 - 100);
int.min(5 10);
int.max(5 10);
int.max(ascii.val('Z') 100);
real.floor(3.9);
real.round(3.2);
real.abs(0.0 -- 5.5);
real.smaller(1.0 2.0);

(* string: setChar changes the string in place *)
let s = string.new(5 'x');
string.setSub(s 0 "hello" 0 5);
string.length(s);
string.getChar(s 1);
string.setChar(s 0 'H');
s;
string.getSub(s 0 2);
string.cat(s " world");

(* arrayOp *)
let a = arrayOp.new(4 10);
arrayOp.size(a);
arrayOp.set(a 2 99);
arrayOp.get(a 2);
try
    arrayOp.get(a 10)
when arrayOp.error then
    0 - 1
end;

(* dynamic *)
let d = dynamic.new(123);
let copied = dynamic.copy(d);
dynamic.be(:Int copied);

(* writer and reader: a file written in the test's own directory, then read back *)
let w = writer.file("io.txt");
writer.putString(w "Quest I/O\n");
writer.close(w);
let r = reader.file("io.txt");
reader.getString(r 9);
reader.close(r)
