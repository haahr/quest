(* io/display outside a Jupyter kernel: each form of a value shows as its
   text/plain form on standard output, after what was written before it, or as
   a line naming its forms when it has none (docs/new-libraries.md section
   3.2). The kernel's records are tested by tests/self-hosted/kernel_protocol.py. *)
import io/display : io/Display;
import writer: Writer;

writer.putString(writer.output "before\n");
display.inKernel();
display.html("<b>bold</b>");
display.markdown("# A heading");
display.svg("<svg/>");
display.png("\137PNG");
display.bundle(array of tuple let mimeType = "application/json" let data = "{}" end end);
display.bundle(array of tuple let mimeType = "text/plain" let data = "plain" end end);
writer.putString(writer.output "after\n");
