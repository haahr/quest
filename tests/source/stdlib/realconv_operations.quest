(* Standard library: util/realconv, against the runtime's own conversions:
 * conv.real (the shortest digits that read back), real.format with style 'e'
 * (printf's correctly rounded digits), and strutil.toReal (strtod). Each
 * section prints what it checks and a count of disagreements, and names any
 * value that disagrees. util/realconv is what a target without libc prints and
 * reads reals with (docs/wasm.md section 4.3); tests/realconv/stress.quest
 * runs the same checks on millions of values. *)
(* @timeout: 120.0 *)

import util/realconv : util/RealConv;
import util/strutil : util/Strutil;
import util/bignum : util/Bignum;
import stringOp = string : StringOp;
import conv : Conv;
import word : Word;
import writer : Writer;

let show(s: String): Ok =
    begin
        writer.putString(writer.output s)
        writer.putString(writer.output "\n")
    end;

let bits(r: Real): word.T = word.fromReal(r);
let fields(negative: Bool field: Int fraction: Int): Real = realconv.fromFields(negative field fraction);
let twoTo52 = 4503599627370496;

(* d as printf's %.{n - 1}e writes it, n being its digit count *)
let eText(d: realconv.Digits): String =
    begin
        let ds = d.digits
        let var s = conv.int(ds[0])
        if extent ds > 1 then
            s := s <> "."
            for i = 1 upto extent ds - 1 do s := s <> conv.int(ds[i]) end
        end
        let x = d.exponent
        let a = if x < 0 then 0 - x else x end
        s <> {if x < 0 then "e-" else "e+" end} <> {if a < 10 then "0" else "" end} <> conv.int(a)
    end;

(* The digit counts checked: the shortest, a middling one, 17, at which every
 * real's shortest digits are found, and longer. The interpreters' phases run
 * this test too, and each count costs them. *)
let lengths = array of 1 9 17 20 end;

(* Whether realconv.rounded agrees with real.format at each of lengths; r
 * finite, positive *)
let roundedAgree(r: Real): Bool =
    begin
        let var agree = true
        for i = 0 upto extent lengths - 1 do
            let p = lengths[i]
            if not(stringOp.equal(eText(realconv.rounded(r p)) real.format(r 'e' {p - 1}))) then agree := false end
        end
        agree
    end;

(* Whether r's text and its reading back agree with the runtime's; r finite *)
let formatAgrees(r: Real): Bool =
    stringOp.equal(realconv.toString(r) conv.real(r))
    andif {bits(realconv.toReal(conv.real(r))) is bits(r)};

let readAgrees(s: String): Bool = bits(realconv.toReal(s)) is bits(strutil.toReal(s));

(* A pseudo-random word: splitmix64 *)
let state = array of word.fromInt(20261113) end;
let random(): word.T =
    begin
        state[0] := word.add(state[0] word.fromInt(~7046029254386353131))
        let var z = state[0]
        z := word.mul(word.xorBits(z word.shift(z ~30)) word.fromInt(~4658895280553007687))
        z := word.mul(word.xorBits(z word.shift(z ~27)) word.fromInt(~7723592293110705685))
        word.xorBits(z word.shift(z ~31))
    end;

(* A random finite real, positive or negative, its bits uniform *)
let rec randomReal(): Real =
    begin
        let w = random()
        if word.toInt(word.extract(w 52 11)) is 2047 then randomReal() else word.toReal(w) end
    end;

(* ======================================================================
 * 1. Values chosen for their difficulty
 * ====================================================================== *)

let edges = array of
    0.0 fields(true 0 0) 1.0 0.1 0.2 0.3 {1.0 // 3.0} {2.0 // 3.0} 100.0 1.0e16 9999999999999998.0 1.0e15 123456.789
    0.0001 0.00012345 9.999e-5 1.0e-5 5.0e-324 fields(false 0 1) fields(false 0 2) fields(false 0 {twoTo52 - 1})
    fields(false 1 0) fields(false 1 1) fields(false 2 0) fields(false 2046 {twoTo52 - 1}) fields(false 2046 0)
    fields(false 2047 0) fields(true 2047 0) 1.0e22 1.0e23 5.0e-310 2.2250738585072014e-308 9007199254740993.0
    4.35e-5 1.7976931348623157e308 fields(false 1076 0) fields(false 1023 0) fields(false 1022 0) 0.5 1.5 2.5
    1.0e300 1.0e-300 {0.0 -- 123.456} {0.0 -- 0.0000001} 8.41e21 5.0e-324 3.0e10 299792458.0 6.02214076e23
end;

show("1. edges: text, digits, and reading back");
let var fails1 = 0;
for i = 0 upto extent edges - 1 do
    let r = edges[i]
    let field = word.toInt(word.extract(bits(r) 52 11))
    let finite = field isnot 2047
    let nonzero = {field isnot 0} orif {word.toInt(word.extract(bits(r) 0 52)) isnot 0}
    let magnitude = fields(false field word.toInt(word.extract(bits(r) 0 52)))
    let textOk = stringOp.equal(realconv.toString(r) conv.real(r))
    let readOk = if finite then bits(realconv.toReal(conv.real(r))) is bits(r) else true end
    let digitsOk = if finite andif nonzero then roundedAgree(magnitude) else true end
    if textOk andif readOk andif digitsOk then show("  " <> realconv.toString(r))
    else
        fails1 := fails1 + 1
        show("  " <> realconv.toString(r) <> " disagrees with " <> conv.real(r))
    end
end;
show("  disagreements: " <> conv.int(fails1));

(* ======================================================================
 * 2. Decimals to read
 * ====================================================================== *)

let decimals = array of
    "0" "~0" "-0.0" "+1" "1." ".5" "0.1" "00012.5000" "1e0" "1E+2" "1e~2" "123456789012345678901234567890"
    "0.000000000000000000000000000000000000001" "9007199254740993" "9007199254740992.5" "9007199254740993.0000001"
    "2.4703282292062327e-324" "2.4703282292062328e-324" "4.9406564584124654e-324" "7.4109846876186982e-324"
    "2.2250738585072011e-308" "2.2250738585072012e-308" "1.7976931348623157e308" "1.7976931348623158e308"
    "1.7976931348623159e308" "1e309" "1e-400" "~1e400" "1e99999999999999999999" "1e-99999999999999999999"
    "0e999999" "3.14159265358979323846264338327950288419716939937510" "1.00000000000000011102230246251565404"
    "1.000000000000000111022302462515654042363166809082031250000001" "0.30000000000000004" "8.41e21"
end;

show("2. decimals: reading");
let var fails2 = 0;
for i = 0 upto extent decimals - 1 do
    let s = decimals[i]
    if readAgrees(s) then show("  " <> s <> " = " <> realconv.toString(realconv.toReal(s)))
    else
        fails2 := fails2 + 1
        show("  " <> s <> " reads as " <> realconv.toString(realconv.toReal(s)) <> ", not "
             <> conv.real(strutil.toReal(s)))
    end
end;
show("  disagreements: " <> conv.int(fails2));

(* ======================================================================
 * 3. Random reals
 * ====================================================================== *)

show("3. random reals: text, reading back, and digits");
let var fails3 = 0;
for i = 1 upto 12 do
    let r = randomReal()
    let magnitude = fields(false word.toInt(word.extract(bits(r) 52 11)) word.toInt(word.extract(bits(r) 0 52)))
    let zero = bits(magnitude) is word.fromInt(0)
    if not(formatAgrees(r) andif {zero orif roundedAgree(magnitude)}) then
        fails3 := fails3 + 1
        show("  " <> conv.real(r) <> " disagrees")
    end
end;
show("  disagreements: " <> conv.int(fails3));

(* ======================================================================
 * 4. Midpoints between neighboring reals, and next to them
 * ====================================================================== *)

(* The exact decimal of the midpoint above a positive finite r, below 2^1024:
 * (2m + 1) * 2^(e - 1) for r = m * 2^e, with delta (~1, 0, or 1) added to its
 * last digit, so that it is just below, at, or just above the midpoint *)
let midpoint(r: Real delta: Int): String =
    begin
        let field = word.toInt(word.extract(bits(r) 52 11))
        let fraction = word.toInt(word.extract(bits(r) 0 52))
        let m = if field is 0 then fraction else fraction + twoTo52 end
        let e = if field is 0 then ~1074 else field - 1075 end
        let odd = bignum.fromInt({2 * m} + 1)
        if e >= 1 then bignum.toString(bignum.add(bignum.mul(odd bignum.pow(bignum.fromInt(2) {e - 1})) bignum.fromInt(delta)))
        else
            let digits = bignum.add(bignum.mul(odd bignum.pow(bignum.fromInt(5) {1 - e})) bignum.fromInt(delta))
            bignum.toString(digits) <> "e-" <> conv.int(1 - e)
        end
    end;

show("4. midpoints: reading");
let var fails4 = 0;
for i = 1 upto 8 do
    let r = randomReal()
    let magnitude = fields(false word.toInt(word.extract(bits(r) 52 11)) word.toInt(word.extract(bits(r) 0 52)))
    if bits(magnitude) isnot bits(fields(false 2046 {twoTo52 - 1})) then
        for delta = ~1 upto 1 do
            let s = midpoint(magnitude delta)
            if not(readAgrees(s)) then
                fails4 := fails4 + 1
                show("  the midpoint above " <> conv.real(magnitude) <> ", " <> conv.int(delta) <> ", disagrees")
            end
        end
    end
end;
show("  disagreements: " <> conv.int(fails4));
