(* Quest Self-Hosted Compiler: Layouts of Values Implementation *)

module layout : Layout
import
    questlang/types/model : questlang/types/Model
    questlang/types/canonical : questlang/types/Canonical
    questlang/modules/abstractTypes : questlang/modules/AbstractTypes
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/repr/syntax : questlang/repr/Syntax
    questlang/common/sha256 : questlang/common/Sha256
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    util/sort : util/Sort
    util/strutil : util/Strutil
    stringOp = string : StringOp
export
    Let Type = model.Type
    Let Shape = shapes.Shape

    let intEqual(a: Int b: Int): Bool = a is b
    let eq(a: String b: String): Bool = stringOp.equal(a b)

    let isOneOf(s: String items: Array(String)): Bool =
        begin
            let var found = false
            for i = 0 upto {extent items - 1} do if stringOp.equal(s items[i]) then found := true end end
            found
        end

    let startsWith(s: String prefix: String): Bool = strutil.startsWith(s prefix)
    let endsWith(s: String suffix: String): Bool = strutil.endsWith(s suffix)

    (* =========================================================================
     * Layouts of shapes
     *
     * A type's layout (its tag and representation) depends only on its shape,
     * and shapes are built once per canonical type, so each layout is computed
     * once per shape.
     * ====================================================================== *)

    (* What has been computed of a shape's layout, each part when it is first
     * asked for: its tag, representation, and slot representation (C
     * spellings), and whether its values may be proxies *)
    Let Layout = Tuple
        shape: Shape
        var tag: maybe.T(String)
        var representation: maybe.T(String)
        var slot: maybe.T(String)
        var proxied: maybe.T(Bool)
    end

    let layouts = hashMap.new(:Int :Layout intEqual hash.int)

    let layoutOf(s: Shape): Layout =
        begin
            let found = hashMap.get(:Int :Layout layouts s.id)
            if maybe.isSome(:Layout found) then
                maybe.unwrap(:Layout found)
            else
                let l = tuple
                    let shape = s
                    let var tag = maybe.none(:String)
                    let var representation = maybe.none(:String)
                    let var slot = maybe.none(:String)
                    let var proxied = maybe.none(:Bool)
                end
                hashMap.insert(:Int :Layout layouts s.id l)
                l
            end
        end

    (* Follows bounds until a shape that is not a bounded type variable or
     * abstract type; seen stops a cycle of bounds *)
    let resolvedShape(s0: Shape): Shape =
        begin
            let seen = hashMap.new(:Int :Bool intEqual hash.int)
            let var s = s0
            while {shapes.kindIs(s shapes.shapeTypevar) orif shapes.kindIs(s shapes.shapeAbstract)}
                andif maybe.isSome(:Shape s.bound)
                andif not(hashMap.contains(:Int :Bool seen s.id)) do
                hashMap.insert(:Int :Bool seen s.id true)
                s := maybe.unwrap(:Shape s.bound)
            end
            s
        end

    let heldAtBound(s: Shape): Bool =
        if maybe.isNone(:Shape s.bound) orif not({shapes.kindIs(s shapes.shapeTypevar)
            orif shapes.kindIs(s shapes.shapeAbstract)}) then
            false
        elsif shapes.kindIs(s shapes.shapeAbstract) then
            true
        else
            abstractTypes.isAbstractTypeSymbol(s.symbolId)
        end

    let ownView(s: Shape): Bool = shapes.kindIs(s shapes.shapeTypevar) andif maybe.isSome(:Shape s.bound)
        andif not(heldAtBound(s))

    let isWordType(t: Type): Bool = shapes.kindIs(shapes.shape(t) shapes.shapeWord)

    (* The slot representation of a value of a representation: a record or
     * variant (16 bytes) as a pointer to a box, a Bool or Char widened to a
     * word, and Ok, which has no value, as a QVal word *)
    let slotOf(representation: String): String =
        if eq(representation "QRecordVal") then "QRecordVal *"
        elsif eq(representation "QVariantVal") then "QVariantVal *"
        elsif eq(representation "QBool") then "QBoolSlot"
        elsif eq(representation "QChar") then "QCharSlot"
        elsif eq(representation "void") then "QVal"
        else representation
        end

    (* The kinds of shapes a recursive type of which is named by recursiveTag *)
    let isSelfNamed(s: Shape): Bool =
        case s.kind
            when shapeTuple, shapeRecord, shapeVariant, shapeOption, shapeArray, shapeCell, shapeOut, shapeAuto then
                true
            when shapeInt, shapeReal, shapeBool, shapeChar, shapeString, shapeOk, shapeWord, shapeBottom,
                shapeException, shapeFun, shapeAll, shapeTypevar, shapeAbstract, shapeExternal, shapeOperator,
                shapePending then false
        end
    let aggregateTagPrefixes = array of "QTuple_" "QRecord_" "QVariant_" "QOption_" "Auto_" end

    let withEmpty(prefix: String tags: vector.T(String)): String =
        prefix <> if vector.empty(:String tags) then "empty" else syntax.joined("_" tags) end

    let rec shapeTag(s: Shape): String =
        begin
            let l = layoutOf(s)
            if maybe.isSome(:String l.tag) then
                maybe.unwrap(:String l.tag)
            else
                let raw = rawTag(s)
                let tag = if stringOp.length(raw) > 64 then
                    stringOp.getSub(raw 0 24) <> "_" <> stringOp.getSub(sha256.hexDigest(raw) 0 16)
                else
                    raw
                end
                l.tag := maybe.some(:String tag)
                tag
            end
        end

    and typeTag(t: Type): String = shapeTag(shapes.shape(t))

    (* The tag of a recursive type whose unfolding's tag is built from its
     * parts' tags: its body, its variable replaced by a placeholder numbered by
     * nesting depth, so that the tag is finite and the same for
     * alpha-equivalent types *)
    and recursiveTag(s: Shape): String =
        begin
            let t = s.type
            let var level = 0
            for i = 0 upto {extent t.fv - 1} do if canonical.isRecSelfSymbol(t.fv[i]) then level := level + 1 end end
            case t.form
                when typeRec with x then
                    let body = model.substitute(x.body model.singleSubst(x.symbolId canonical.recSelfVar(level)))
                    "Rec" <> syntax.cInt(level) <> "_" <> typeTag(body)
                when typeRecGroup with x then
                    let subst = model.newSubst()
                    for i = 0 upto {extent x.bindings - 1} do
                        hashMap.insert(:Int :Type subst x.bindings[i].symbolId canonical.recSelfVar(level + i))
                    end
                    let tags = vector.new(:String)
                    for i = 0 upto {extent x.bindings - 1} do
                        vector.append(:String tags typeTag(model.substitute(x.bindings[i].body subst)))
                    end
                    "RecGroup" <> syntax.cInt(level) <> "_" <> syntax.cInt(x.activeIndex) <> "_" <> syntax.joined("_" tags)
                else rawTagOf(s)
            end
        end

    (* The tag of a component's shape inside another type's tag: an aggregate's
     * tag is closed with _end, so that tags of different nestings differ *)
    and elementTag(s: Shape): String =
        begin
            (* A component is named as its type is: a type containing recursion
             * by its own canonical form *)
            let tag = shapeTag(shapes.shape(s.type))
            let var aggregate = false
            for i = 0 upto {extent aggregateTagPrefixes - 1} do
                if startsWith(tag aggregateTagPrefixes[i]) then aggregate := true end
            end
            if aggregate andif not(endsWith(tag "_empty")) then tag <> "_end" else tag end
        end

    (* The tag of shape s0, before shapeTag shortens it: a C identifier made
     * from the structure of its type, which names the type's struct,
     * descriptor, and tables in C. A tag longer than 64 characters is
     * shortened to its first 24, an underscore, and 16 hex digits of its
     * SHA-256 digest.
     *
     * A tag depends only on the type, not on the unit or the order in which
     * types are met, so that separately compiled units name a type alike and
     * agree on its struct. Equal types have one tag: a type containing
     * recursion is named by its canonical form, and cases and record fields
     * are listed in the order of their names. For example (rawTagOf),
     *
     *     Tuple :Int :Int end               QTuple_Int_Int
     *     Tuple end                         QTuple_empty
     *     Record y: Bool x: Int end         QRecord_x_Int_y_Bool
     *     Variant red: Ok green: Int end    QVariant_green_Int_red_Ok
     *     Array(String)                     QArray_String
     *     All(x: Int) Int                   QClosure
     *     List(Int)
     *         Rec0_QOption_cons_QTuple_Int_Self0_end_nil
     *     Tuple :Tuple :Int :Bool end :String end
     *         QTuple_QTuple_Int_Bool_end_String
     *     Tuple :Tuple :Int end :Bool :String end
     *         QTuple_QTuple_Int_end_Bool_String
     *
     * A tuple's tag lists its components' tags but not their names, which do
     * not change its layout: Tuple x: Int y: Int end is QTuple_Int_Int too.
     * An aggregate's tag nested in another's ends with _end (elementTag), so
     * that the last two tuples above, which nest differently, have different
     * tags. A recursive tuple, record, variant, option, array, or auto type is
     * named by its body, with Self and its nesting depth for its recursion
     * variable (recursiveTag), so that its tag is finite. Every function type
     * is QClosure, since every closure has one representation, and a type it
     * does not otherwise name is QVal. *)
    and rawTag(s0: Shape): String =
        begin
            let s = resolvedShape(s0)
            let selfLevel = if shapes.kindIs(s shapes.shapeTypevar) then canonical.recSelfLevel(s.type)
                else maybe.none(:Int) end
            let canonicalShape = shapes.shape(s.type)
            if maybe.isSome(:Int selfLevel) then
                "Self" <> syntax.cInt(maybe.unwrap(:Int selfLevel))
            elsif not(shapes.same(canonicalShape s)) then
                (* Equal types share a tag: a type containing recursion is named
                 * by its canonical form *)
                shapeTag(canonicalShape)
            elsif shapes.isRecursive(s) andif isSelfNamed(s) then
                recursiveTag(s)
            else
                rawTagOf(s)
            end
        end

    and rawTagOf(s: Shape): String =
        case s.kind
            when shapeWord then "Word"
            when shapeInt then "Int"
            when shapeReal then "Real"
            when shapeBool then "Bool"
            when shapeChar then "Char"
            when shapeString then "String"
            when shapeOk then "Ok"
            when shapeExternal then
                case s.type.form
                    when typeExternal with x then
                        if stringOp.isEmpty(x.name) then
                            strutil.strip(strutil.replace(x.cType "*" ""))
                        else
                            strutil.replace(x.name "." "_")
                        end
                    else "QVal"
                end
            (* The writer and reader libraries' abstract types, which the
             * runtime implements as structs of its own *)
            when shapeTypevar then
                if isOneOf(s.name array of "Writer.T" "writer.T" end) then "QWriter"
                elsif isOneOf(s.name array of "Reader.T" "reader.T" end) then "QReader"
                else "QVal" end
            when shapeTuple then
                let tags = vector.new(:String)
                for i = 0 upto {extent s.components - 1} do
                    vector.append(:String tags elementTag(shapes.componentShape(s.components[i])))
                end
                withEmpty("QTuple_" tags)
            when shapeRecord then
                let sorted = shapes.sortedComponents(s)
                let tags = vector.new(:String)
                for i = 0 upto {extent sorted - 1} do
                    vector.append(:String tags maybe.unwrapOr(:String sorted[i].name "") <> "_"
                        <> elementTag(shapes.componentShape(sorted[i])))
                end
                withEmpty("QRecord_" tags)
            when shapeFun, shapeAll then "QClosure"
            when shapeCell, shapeOut then "Ref_" <> elementTag(shapes.element(s))
            when shapeArray then "QArray_" <> elementTag(shapes.element(s))
            when shapeVariant, shapeOption then
                let tags = vector.new(:String)
                for i = 0 upto {extent s.cases - 1} do
                    let c = s.cases[i]
                    let name = maybe.unwrapOr(:String c.name "")
                    vector.append(:String tags
                        if maybe.isSome(:Shape c.shape) then name <> "_" <> elementTag(maybe.unwrap(:Shape c.shape)) else name end)
                end
                withEmpty(if shapes.kindIs(s shapes.shapeVariant) then "QVariant_" else "QOption_" end tags)
            when shapeException then "QException"
            when shapeAuto then "Auto_" <> typeTag(model.autoPayloadType(s.structure maybe.none(:Type)))
            when shapeBottom, shapeAbstract, shapeOperator, shapePending then "QVal"
        end

    Def Representation = Option
        repVoid repInt repWord repBool repChar repReal repRecord repVariant repPointer repQVal
    end

    let isWriter(s: Shape): Bool = isOneOf(s.name array of "Writer.T" "writer.T" end)
    let isReader(s: Shape): Bool = isOneOf(s.name array of "Reader.T" "reader.T" end)

    let rec shapeRepresentationKind(s0: Shape): Representation =
        begin
            let s = resolvedShape(s0)
            case s.kind
                when shapeOk then option repVoid of Representation end
                when shapeInt then option repInt of Representation end
                when shapeWord then option repWord of Representation end
                when shapeBool then option repBool of Representation end
                when shapeChar then option repChar of Representation end
                when shapeReal then option repReal of Representation end
                when shapeRecord then option repRecord of Representation end
                when shapeVariant then option repVariant of Representation end
                when shapeTypevar then
                    if isWriter(s) orif isReader(s) then option repPointer of Representation end
                    else option repQVal of Representation end end
                when shapeString, shapeAuto, shapeExternal, shapeTuple, shapeOption, shapeFun, shapeAll, shapeArray,
                    shapeException, shapeCell, shapeOut then
                    option repPointer of Representation end
                when shapeBottom, shapeAbstract, shapeOperator, shapePending then option repQVal of Representation end
            end
        end

    (* Whether s is represented as a QVal *)
    and isQVal(s: Shape): Bool =
        case shapeRepresentationKind(s)
            when repQVal then true
            when repVoid, repInt, repWord, repBool, repChar, repReal, repRecord, repVariant, repPointer then false
        end

    let representationKind(t: Type): Representation = shapeRepresentationKind(shapes.shape(t))

    let rec shapeRepresentation(s: Shape): String =
        begin
            let l = layoutOf(s)
            if maybe.isSome(:String l.representation) then
                maybe.unwrap(:String l.representation)
            else
                let rep = rawRepresentation(s)
                l.representation := maybe.some(:String rep)
                rep
            end
        end

    and shapeLocationRepresentation(s: Shape): String =
        if isBoxedInSlots(s) then shapeSlotRepresentation(s) else shapeRepresentation(s) end

    and shapeSlotRepresentation(s: Shape): String =
        begin
            let l = layoutOf(s)
            if maybe.isSome(:String l.slot) then
                maybe.unwrap(:String l.slot)
            else
                let slot = slotOf(shapeRepresentation(s))
                l.slot := maybe.some(:String slot)
                slot
            end
        end

    and isBoxedInSlots(s: Shape): Bool =
        case shapeRepresentationKind(s)
            when repRecord, repVariant then true
            when repVoid, repInt, repWord, repBool, repChar, repReal, repPointer, repQVal then false
        end

    (* The C spelling of a representation, of shape s's *)
    and rawRepresentation(s0: Shape): String =
        begin
            let s = resolvedShape(s0)
            case shapeRepresentationKind(s)
                when repVoid then "void"
                when repInt then "QInt"
                when repWord then "uint64_t"
                when repBool then "QBool"
                when repChar then "QChar"
                when repReal then "QReal"
                when repRecord then "QRecordVal"
                when repVariant then "QVariantVal"
                when repQVal then "QVal"
                when repPointer then
                    case s.kind
                        when shapeString then "QString *"
                        (* An auto value (including a dynamic value): its type
                         * component's descriptor and its payload *)
                        when shapeAuto then "QAuto *"
                        when shapeExternal then s.name
                        when shapeTypevar then if isWriter(s) then "QWriter *" else "QReader *" end
                        when shapeTuple, shapeOption then shapeTag(s) <> " *"
                        when shapeFun, shapeAll then "QClosure *"
                        when shapeArray then "QArray *"
                        when shapeException then "const QException *"
                        when shapeCell, shapeOut then shapeLocationRepresentation(shapes.element(s)) <> " *"
                        when shapeInt, shapeReal, shapeBool, shapeChar, shapeOk, shapeWord, shapeBottom, shapeRecord,
                            shapeVariant, shapeAbstract, shapeOperator, shapePending then
                            "QVal"
                    end
            end
        end

    Def WordForm = Option
        wordItself
        wordOk
        wordRecordBox
        wordVariantBox
        wordBits
        wordInteger
        wordReal
        wordPointer
    end

    let wordForm(s0: Shape): WordForm =
        begin
            let s = resolvedShape(s0)
            if isQVal(s) then option wordItself of WordForm end
            else
                case s.kind
                    when shapeOk then option wordOk of WordForm end
                    when shapeRecord then option wordRecordBox of WordForm end
                    when shapeVariant then option wordVariantBox of WordForm end
                    when shapeWord then option wordBits of WordForm end
                    when shapeInt, shapeBool, shapeChar then option wordInteger of WordForm end
                    when shapeReal then option wordReal of WordForm end
                    when shapeString, shapeBottom, shapeTuple, shapeOption, shapeArray, shapeCell, shapeOut,
                    shapeException,
                        shapeFun, shapeAll, shapeAuto, shapeTypevar, shapeAbstract, shapeExternal, shapeOperator,
                        shapePending then
                        option wordPointer of WordForm end
                end
            end
        end

    let representation(t: Type): String = shapeRepresentation(shapes.shape(t))

    let slotsBytes(n: Int): Int = if n is 0 then 1 else 8 * n end

    let tupleBytes(t: Type): Int =
        case t.form when typeTuple with x then slotsBytes(extent model.tupleValueFields(x.fields)) else 8 end

    let recordFieldsOf(t: Type): Array(model.RecordField) =
        case t.form
            when typeRecord with r then r.fields
            else vector.toArray(:model.RecordField vector.new(:model.RecordField))
        end

    (* A header and the fields' slots, or with no field, a header and a char,
     * padded to the header's alignment *)
    let recordBytes(t: Type): Int = begin let n = extent recordFieldsOf(t) if n is 0 then 16 else 8 + 8 * n end end

    let recordFieldOffset(t: Type name: String): Int =
        begin
            let fields = recordFieldsOf(t)
            let var before = 0
            for i = 0 upto {extent fields - 1} do
                if sort.stringCompare(fields[i].name name) < 0 then before := before + 1 end
            end
            8 + 8 * before
        end

    (* The slots of a case's payload in its option's union: a tuple's or a
     * record's components, or the payload itself *)
    let caseSlots(payload: Type): Int =
        begin
            let s = shapes.shape(payload)
            if shapes.kindIs(s shapes.shapeTuple)
                orif shapes.kindIs(s shapes.shapeRecord) then extent s.components else 1 end
        end

    let optionBytes(t: Type): Int =
        case t.form
            when typeOption with o then
                let var most = 0
                let var anyPayload = false
                for i = 0 upto {extent o.options - 1} do
                    if maybe.isSome(:Type o.options[i].payload) then
                        anyPayload := true
                        let n = caseSlots(maybe.unwrap(:Type o.options[i].payload))
                        if n > most then most := n end
                    end
                end
                if anyPayload then 8 + 8 * most else 8 end
            else 8
        end

    let representationBytes(t: Type): Int =
        begin
            let r = representation(t)
            if eq(r "QRecordVal") orif eq(r "QVariantVal") then 16
            elsif eq(r "QBool") orif eq(r "QChar") then 1
            else 8
            end
        end
    let slotRepresentation(t: Type): String = shapeSlotRepresentation(shapes.shape(t))
    let locationRepresentation(t: Type): String = shapeLocationRepresentation(shapes.shape(t))
    let tupleStructName(t: Type): String = typeTag(t)
    let optionStructName(t: Type): String = typeTag(t)

    (* ======================================================================
     * Proxies
     *
     * Upcasting a tuple or an option to a supertype can change how one of its
     * components is represented (a record seen with fewer fields has another
     * offset table; an option or variant's cases are numbered anew). The value
     * is not copied, since it must stay the same object and share its var
     * components; instead the upcast value is a proxy, which converts each
     * component as it is read (docs/c-representation.md section 5.8). Code
     * that reads a component of a value that may be a proxy must check for
     * one, so this section decides which types' values may be.
     *
     * The walks below keep a seen set of shapes visited, so that a recursive
     * type ends; a shape met again adds nothing, and counts as false.
     * ====================================================================== *)

    Let Seen = hashMap.T(Int Bool)
    let newSeen(): Seen = hashMap.new(:Int :Bool intEqual hash.int)

    (* Whether a component of shape s may hold a proxy as a subtype's value,
     * though a value of s itself may not be a proxy: a tuple, or an option with
     * a payload *)
    let holdsProxies(s: Shape): Bool =
        case s.kind
            when shapeTuple then
                true
            when shapeOption then
                begin
                    let var found = false
                    for i = 0 upto {extent s.cases - 1} do
                        if maybe.isSome(:Shape s.cases[i].shape) then found := true end
                    end
                    found
                end
            when shapeInt, shapeReal, shapeBool, shapeChar, shapeString, shapeOk, shapeWord, shapeBottom, shapeRecord,
                shapeVariant, shapeArray, shapeCell, shapeOut, shapeException, shapeFun, shapeAll, shapeAuto,
                shapeTypevar, shapeAbstract, shapeExternal, shapeOperator, shapePending then
                false
        end

    (* Whether a component of shape s makes its tuple or option a possible
     * proxy: it may change view itself, or may hold a proxy that an upcast of
     * the container would have to convert *)
    let rec componentChangesView(s: Shape seen: Seen): Bool = holdsProxies(s) orif viewSensitive(s seen)

    (* Whether values of subtypes of s may be represented differently at s:
     * records and variants, options of several cases, tuples and options that
     * may be proxies, type variables, and functions whose signatures mention
     * any of these *)
    and viewSensitive(s: Shape seen: Seen): Bool =
        case s.kind
            when shapeRecord, shapeVariant, shapeTypevar, shapeAbstract, shapeAuto, shapeOperator then true
            when shapeTuple, shapeOption then proxiedIn(s seen)
            when shapeFun, shapeAll then
                if hashMap.contains(:Int :Bool seen s.id) then
                    false
                else
                    hashMap.insert(:Int :Bool seen s.id true)
                    if shapes.kindIs(s shapes.shapeAll) then
                        true
                    else
                        let var found = viewSensitive(shapes.result(s) seen)
                        for i = 0 upto {extent s.params - 1} do
                            if not(found) andif viewSensitive(s.params[i].shape seen) then found := true end
                        end
                        found
                    end
                end
            when shapeInt, shapeReal, shapeBool, shapeChar, shapeString, shapeOk, shapeWord, shapeBottom, shapeArray,
                shapeCell, shapeOut, shapeException, shapeExternal, shapePending then false
        end

    (* Whether a value of shape s, a tuple or option, may be a proxy: a tuple
     * with a component that changes view, an option with two or more cases
     * (whose numbering an upcast may change), or an option whose one case's
     * payload is a tuple with such a component *)
    and proxiedIn(s: Shape seen: Seen): Bool =
        if hashMap.contains(:Int :Bool seen s.id) then
            false
        else
            hashMap.insert(:Int :Bool seen s.id true)
            case s.kind
                when shapeTuple then
                    let var found = false
                    for i = 0 upto {extent s.components - 1} do
                        if not(found) andif componentChangesView(shapes.componentShape(s.components[i]) seen) then
                            found := true
                        end
                    end
                    found
                when shapeOption then
                    if extent s.cases >= 2 then
                        true
                    else
                        let var found = false
                        for i = 0 upto {extent s.cases - 1} do
                            let c = s.cases[i]
                            if maybe.isSome(:Shape c.shape)
                                andif shapes.kindIs(maybe.unwrap(:Shape c.shape) shapes.shapeTuple) then
                                let payload = maybe.unwrap(:Shape c.shape)
                                for j = 0 upto {extent payload.components - 1} do
                                    if not(found) andif
                                        componentChangesView(shapes.componentShape(payload.components[j]) seen) then
                                        found := true
                                    end
                                end
                            end
                        end
                        found
                    end
                when shapeInt, shapeReal, shapeBool, shapeChar, shapeString, shapeOk, shapeWord, shapeBottom,
                    shapeRecord, shapeVariant, shapeArray, shapeCell, shapeOut, shapeException, shapeFun, shapeAll,
                    shapeAuto, shapeTypevar, shapeAbstract, shapeExternal, shapeOperator, shapePending then
                    false
            end
        end

    let mayBeProxied(s: Shape): Bool =
        if not({shapes.kindIs(s shapes.shapeTuple) orif shapes.kindIs(s shapes.shapeOption)}) then
            false
        else
            let l = layoutOf(s)
            if maybe.isSome(:Bool l.proxied) then
                maybe.unwrap(:Bool l.proxied)
            else
                let proxied = proxiedIn(s newSeen())
                l.proxied := maybe.some(:Bool proxied)
                proxied
            end
        end

    let changesView(s: Shape): Bool = componentChangesView(s newSeen())

    let heldShape(t: Type kind: shapes.ShapeKind): maybe.T(Shape) =
        begin
            let h = resolvedShape(shapes.shape(t))
            if shapes.sameKind(h.kind kind) then maybe.some(:Shape h) else maybe.none(:Shape) end
        end
end
