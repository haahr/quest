(* Quest Self-Hosted Compiler: Object Layouts Interface
 *
 * Describes the word-level layouts of heap objects allocated by generated
 * code for every backend (docs/collector.md section 3.2). Each allocation
 * references a static QLayout struct that classifies every word of the
 * object as a pointer, a scalar, or ambiguous (a generic QVal whose runtime
 * kind is unknown at the allocation site), so a precise garbage collector
 * can scan live pointers and QUEST_GC_CHECK=layouts can verify compiler
 * output. Word kinds are derived from slot shapes (repr/layout) or, for
 * closure environment captures, from each captured value's representation.
 * A unit's layouts are collected in a table by tag and emitted as static
 * data (quest_layout_<tag>) by the C and SSA backends; common layouts
 * (adapt closures, adapter closures, and arrays) live in the runtime and are
 * referenced by symbol. The counterpart is
 * bootstrap/python/quest/repr/objectlayout.py. *)

interface ObjectLayout
import
    questlang/types/model : questlang/types/Model
    questlang/repr/shapes : questlang/repr/Shapes
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
export
    (* The kind of a word: a scalar, a pointer (an object's address, or into
     * one, or outside the heap), or ambiguous *)
    Def Kind = Option kindScalar kindPointer kindAmbiguous end
    (* A kind as the runtime numbers them (Q_WORD_SCALAR, ...) *)
    kindCode(k: Kind): Int
    (* A kind's letter, for a layout's tag *)
    kindLetter(k: Kind): String
    (* The kind of the word an aggregate slot holds a value of shape s in *)
    slotKind(s: shapes.Shape): Kind
    (* The kinds of the words of a value of shape s in its representation, as
     * a closure environment holds a capture: none for an Ok, a pointer and a
     * pointer for a record, a scalar and an ambiguous word for a variant (its
     * tag and its payload), and one word otherwise *)
    representationKinds(s: shapes.Shape): Array(Kind)
    (* The kinds of a QVariantVal or QRecordVal box embedded in an aggregate's
     * allocation (docs/c-representation.md section 5.1) *)
    boxKinds(s: shapes.Shape): Array(Kind)

    (* The forms of a layout: a fixed object, described word by word, or an
     * array, a header followed by elements counted by an int64_t in the
     * header *)
    Def Form = Option formFixed formArray end
    (* A heap object layout. Its C symbol is quest_layout_<tag>. For a fixed
     * object, words lists the kind of each word and bytes is the object's
     * size; for an array, words and bytes describe the header, element gives
     * the kinds of each element's words, and lengthOffset is the byte offset
     * of the element count. When the C backend declares a struct for the
     * object, cSize holds the sizeof expression so C and layout sizes agree
     * by construction. *)
    Def Layout = Tuple
        tag: String
        form: Form
        words: Array(Kind)
        element: Array(Kind)
        lengthOffset: Int
        bytes: Int
        cSize: String
    end
    symbol(l: Layout): String
    (* Whether a layout's objects hold no pointers (every word a scalar), so
     * that the collector never scans them (Q_LAYOUT_NOSCAN) *)
    noscan(l: Layout): Bool
    (* The runtime's layouts generated code names: a QAdaptClosure's, a
     * QFunAdapterClosure's, and a QArray's whose elements are of kind k *)
    adaptClosureSymbol: String
    adapterClosureSymbol: String
    arraySymbol(k: Kind): String

    (* A tuple of shape ts, whose struct C names `struct`, with the boxes of
     * the fields of shapes `boxes` embedded after it *)
    tupleLayout(ts: shapes.Shape struct: String boxes: Array(shapes.Shape)): Layout
    (* The first n components of a tuple of shape ts, as a copy of them is
     * laid out *)
    tuplePrefixLayout(ts: shapes.Shape n: Int): Layout
    (* A record made in its box (docs/c-representation.md section 5.1): the
     * QRecordVal, then the payload of record type t, whose struct C names
     * `struct`, then the embedded boxes *)
    recordLayout(t: model.Type struct: String boxes: Array(shapes.Shape)): Layout
    (* Layout for an option of shape os (whose C struct is named struct).
     * When tag is some, the layout describes that specific case; when tag is
     * none, each word takes the kind agreed on by all cases, or ambiguous
     * where cases disagree. *)
    optionLayout(os: shapes.Shape struct: String tag: maybe.T(String)): Layout
    (* Layout for a closure (struct QClosure_<code>): a scalar word for the
     * code pointer followed by kinds (type descriptors and captured values).
     * bytes includes the code pointer. *)
    closureLayout(code: String kinds: Array(Kind) bytes: Int cSize: String): Layout

    (* A unit's layouts, by tag and in the order first registered *)
    Def Table = Tuple byTag: hashMap.T(String Layout) order: vector.T(String) end
    newTable(): Table
    (* Register l and return its symbol. Raises mismatch if a different layout
     * is already registered under the same tag. *)
    mismatch: Exception(String)
    register(t: Table l: Layout): String
    layouts(t: Table): Array(Layout)
    (* kinds packed eight to a word, the first in the low byte, as a backend
     * that lays data out in words writes a layout's kinds *)
    packedKinds(kinds: Array(Kind)): Array(Int)
end
