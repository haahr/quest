(* Quest Self-Hosted Compiler: The Standard Library's Externals Interface
 *
 * This interface exposes the standard library's external C functions and
 * external types, generated into the compiler from lib/ by tools/externals
 * (docs/c-representation.md section 6.2). Each function entry gives a module's
 * path in lib/ (such as word or collections/vector), a member's name, and its
 * C symbol. A call to such a function from an importer compiles to a direct
 * call of the C function, and importers see an external type as its C type;
 * both apply only to imports that resolve to modules in lib/. *)

interface Externals export
    (* External functions: each is monomorphic, takes value parameters only,
     * and uses only scalar and external types *)
    functions: Array(Array(String))
    (* External types (such as Let T = external "uint64_t"): each entry gives
     * the module's path, the type's name, its global name (such as process.T,
     * combining the module's declared name and the type's name), and its C
     * type *)
    types: Array(Array(String))
end
