(* Quest Self-Hosted Compiler: The Standard Library's External Functions
 * Interface
 *
 * The rows of repr/externals' table of the standard library's external C
 * functions, typed, and the lookup the backends make of them: a call of such
 * a function from an importer compiles to a direct call of its C symbol
 * (docs/c-representation.md section 6.2). The table itself stays as
 * tools/externals generates it, since the ABI corpus records its text. *)

interface ExternalFunctions
import
    util/maybe : util/Maybe
export
    (* A function: its module's path in lib/ (such as word or
     * collections/vector), its member's name, and its C symbol *)
    Def Function = Tuple path: String member: String symbol: String end
    functions: Array(Function)
    (* The C symbol of the member of the library's module at path, if it is
     * one of the external functions *)
    symbolOf(path: String member: String): maybe.T(String)
end
