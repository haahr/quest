(* Quest Self-Hosted Compiler: Object Layouts Implementation *)

module objectLayout : ObjectLayout
import
    conv : Conv
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    sb = util/stringBuilder : util/StringBuilder

    questlang/common/maps : questlang/common/Maps
    questlang/repr/digests : questlang/repr/Digests
    questlang/repr/layout : questlang/repr/Layout
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/types/model : questlang/types/Model
export
    Def Kind = Option kindScalar kindPointer kindAmbiguous end
    Def Form = Option formFixed formArray end
    Def Layout = Tuple
        tag: String
        form: Form
        words: Array(Kind)
        element: Array(Kind)
        lengthOffset: Int
        bytes: Int
        cSize: String
    end
    Def Table = Tuple byTag: maps.StringMap(Layout) order: vector.T(String) end

    let mismatch: Exception(String) = exception mismatch: String end

    let eq(a: String b: String): Bool = stringOp.equal(a b)
    let scalar = option kindScalar of Kind end
    let pointer = option kindPointer of Kind end
    let ambiguous = option kindAmbiguous of Kind end

    let kindCode(k: Kind): Int = case k when kindScalar then 0 when kindPointer then 1 when kindAmbiguous then 2 end
    (* A kind's letter, for a layout's tag *)
    let kindLetter(k: Kind): String =
        case k when kindScalar then "s" when kindPointer then "p" when kindAmbiguous then "a" end
    let sameKind(a: Kind b: Kind): Bool = kindCode(a) is kindCode(b)

    let slotKind(s: shapes.Shape): Kind =
        case layout.wordForm(s)
            when wordItself then ambiguous
            when wordOk, wordBits, wordInteger, wordReal then scalar
            when wordRecordBox, wordVariantBox, wordPointer then pointer
        end

    let representationKinds(s: shapes.Shape): Array(Kind) =
        case layout.shapeRepresentationKind(s)
            when repVoid then array of :Kind end
            when repInt, repWord, repBool, repChar, repReal then array of scalar end
            when repQVal then array of ambiguous end
            when repRecord then array of pointer pointer end
            when repVariant then array of scalar ambiguous end
            when repPointer then array of pointer end
        end

    (* The kinds of a QVariantVal or QRecordVal box embedded in an aggregate's
     * allocation (docs/c-representation.md section 5.1): a box holds the
     * value's representation, two words *)
    let boxKinds(s: shapes.Shape): Array(Kind) =
        case layout.shapeRepresentationKind(s)
            when repVariant then array of scalar ambiguous end
            when repVoid, repInt, repWord, repBool, repChar, repReal, repQVal, repRecord, repPointer then
                array of pointer pointer end
        end

    let symbol(l: Layout): String = "quest_layout_" <> l.tag
    let adaptClosureSymbol = "quest_layout_adapt_closure"
    let adapterClosureSymbol = "quest_layout_adapter_closure"
    let arraySymbol(k: Kind): String =
        case k
            when kindScalar then "quest_layout_array_scalar"
            when kindPointer then "quest_layout_array_pointer"
            when kindAmbiguous then "quest_layout_array_ambiguous"
        end

    let componentShape(c: shapes.Component): shapes.Shape = maybe.unwrap(c.shape)

    (* Append each embedded box's word kinds to words and return the tag
     * suffix naming them (empty if boxes is empty). Each box contributes one
     * letter for its second word's kind, distinguishing a variant box (a)
     * from a record box (p). *)
    let withBoxes(words: vector.T(Kind) boxes: Array(shapes.Shape)): String =
        begin
            let suffix = sb.new()
            for i = 0 upto {extent boxes - 1} do
                let ks = boxKinds(boxes[i])
                for j = 0 upto {extent ks - 1} do vector.append(words ks[j]) end
                sb.strShared(suffix kindLetter(ks[1]))
            end
            if extent boxes is 0 then "" else "_b" <> sb.toString(suffix) end
        end

    let fixed(tag: String words: vector.T(Kind) bytes: Int cSize: String): Layout =
        tuple
            let tag = tag
            let form = option formFixed of Form end
            let words = vector.toArray(words)
            let element = array of :Kind end
            let lengthOffset = 0
            let bytes = bytes
            let cSize = cSize
        end

    (* A C size of a struct plus n boxes *)
    let cSizeOf(struct: String n: Int): String =
        if eq(struct "") then ""
        elsif n is 0 then "sizeof(" <> struct <> ")"
        else "sizeof(" <> struct <> ") + " <> conv.int(n) <> " * sizeof(QRecordVal)"
        end

    let tupleLayout(ts: shapes.Shape struct: String boxes: Array(shapes.Shape)): Layout =
        begin
            let words = vector.new(:Kind)
            let n = extent ts.components
            for i = 0 upto {n - 1} do vector.append(words slotKind(componentShape(ts.components[i]))) end
            (* A struct of no slots has a char of its own, one word's worth *)
            if n is 0 then vector.append(words scalar) end
            let suffix = withBoxes(words boxes)
            fixed(layout.shapeTag(ts) <> suffix words layout.slotsBytes(n) + 16 * extent boxes
                    cSizeOf(struct extent boxes))
        end

    let tuplePrefixLayout(ts: shapes.Shape n: Int): Layout =
        begin
            let words = vector.new(:Kind)
            for i = 0 upto {n - 1} do vector.append(words slotKind(componentShape(ts.components[i]))) end
            if n is 0 then vector.append(words scalar) end
            fixed(layout.shapeTag(ts) <> "_" <> conv.int(n) words layout.slotsBytes(n) "")
        end

    let recordLayout(t: model.Type struct: String boxes: Array(shapes.Shape)): Layout =
        begin
            let words = vector.new(:Kind)
            (* Three pointer words precede the fields: the box's payload
             * pointer and field-offset dictionary pointer, then the payload's
             * type descriptor pointer; fields follow sorted by name *)
            vector.append(words pointer)
            vector.append(words pointer)
            vector.append(words pointer)
            let rs = shapes.shape(t)
            let fields = shapes.sortedComponents(rs)
            for i = 0 upto {extent fields - 1} do vector.append(words slotKind(componentShape(fields[i]))) end
            (* A record of no fields has a word of padding after its header *)
            if extent fields is 0 then vector.append(words scalar) end
            let suffix = withBoxes(words boxes)
            let cSize = if eq(struct "") then "" else "sizeof(QRecordVal) + " <> cSizeOf(struct extent boxes) end
            (* Name the layout after the C struct when one is given (two
             * aliases of the same record type produce distinct structs with
             * their own sizeof), and fall back to the type otherwise *)
            let tag =
                if eq(struct "") then "record_" <> layout.typeTag(t) <> "_" <> digests.typeDigest(t) else struct end
            fixed(tag <> suffix words 16 + layout.recordBytes(t) + 16 * extent boxes cSize)
        end

    (* The kinds of the words of case c (its tag, then its components) *)
    let caseKinds(c: shapes.Component): vector.T(Kind) =
        begin
            let words = vector.new(:Kind)
            vector.append(words scalar)
            if maybe.isSome(c.shape) then
                let cs = maybe.unwrap(c.shape)
                if shapes.kindIs(cs shapes.shapeTuple) orif shapes.kindIs(cs shapes.shapeRecord) then
                    for i = 0 upto {extent cs.components - 1} do
                        vector.append(words slotKind(componentShape(cs.components[i])))
                    end
                else
                    vector.append(words slotKind(cs))
                end
            end
            words
        end

    let optionLayout(os: shapes.Shape struct: String tag: maybe.T(String)): Layout =
        begin
            let bytes = layout.optionBytes(os.structure)
            let n = {bytes + 7} / 8
            let words = vector.new(:Kind)
            for i = 0 upto {n - 1} do vector.append(words scalar) end
            let var suffix = "_any"
            if maybe.isSome(tag) then
                let name = maybe.unwrap(tag)
                let c = maybe.unwrap(shapes.caseOf(os name))
                let ks = caseKinds(c)
                for i = 0 upto {vector.length(ks) - 1} do
                    if i < n then vector.set(words i vector.get(ks i)) end
                end
                let var index = 0
                for i = 0 upto {extent os.cases - 1} do
                    if maybe.isSome(os.cases[i].name) andif eq(maybe.unwrap(os.cases[i].name) name) then
                        index := i
                    end
                end
                suffix := "_" <> conv.int(index)
            else
                (* Give each word the kind agreed on by all cases that use it,
                 * or ambiguous if cases disagree (cases that do not use a
                 * word leave it zero, which is valid for any kind) *)
                let set = array of(n false)
                for k = 0 upto {extent os.cases - 1} do
                    let ks = caseKinds(os.cases[k])
                    for i = 0 upto {vector.length(ks) - 1} do
                        if i < n then
                            let kind = vector.get(ks i)
                            if not(set[i]) then
                                set[i] := true
                                vector.set(words i kind)
                            elsif not(sameKind(vector.get(words i) kind)) then
                                vector.set(words i ambiguous)
                            end
                        end
                    end
                end
            end
            fixed(layout.shapeTag(os) <> suffix words bytes cSizeOf(struct 0))
        end

    let closureLayout(code: String kinds: Array(Kind) bytes: Int cSize: String): Layout =
        begin
            let words = vector.new(:Kind)
            vector.append(words scalar)
            for i = 0 upto {extent kinds - 1} do vector.append(words kinds[i]) end
            fixed("closure_" <> code words bytes cSize)
        end

    let newTable(): Table =
        tuple let byTag = maps.newStringMap() let order = vector.new() end

    let sameLayout(a: Layout b: Layout): Bool =
        begin
            let var same = {extent a.words is extent b.words} andif {extent a.element is extent b.element}
                andif {a.bytes is b.bytes} andif eq(a.cSize b.cSize)
            if same then
                for i = 0 upto {extent a.words - 1} do
                    if not(sameKind(a.words[i] b.words[i])) then same := false end
                end
                for i = 0 upto {extent a.element - 1} do
                    if not(sameKind(a.element[i] b.element[i])) then same := false end
                end
            end
            same
        end

    let noscan(l: Layout): Bool =
        begin
            let var all = true
            for i = 0 upto {extent l.words - 1} do
                case l.words[i] when kindScalar then ok when kindPointer, kindAmbiguous then all := false end
            end
            for i = 0 upto {extent l.element - 1} do
                case l.element[i] when kindScalar then ok when kindPointer, kindAmbiguous then all := false end
            end
            all
        end

    let register(t: Table l: Layout): String =
        begin
            let found = hashMap.get(t.byTag l.tag)
            if maybe.isSome(found) then
                if not(sameLayout(maybe.unwrap(found) l)) then
                    raise mismatch with "two layouts named " <> l.tag end
                end
            else
                hashMap.insert(t.byTag l.tag l)
                vector.append(t.order l.tag)
            end
            symbol(l)
        end

    let layouts(t: Table): Array(Layout) =
        begin
            let res = array of(vector.length(t.order) fixed("" vector.new() 0 ""))
            for i = 0 upto {vector.length(t.order) - 1} do
                res[i] := hashMap.find(t.byTag vector.get(t.order i))
            end
            res
        end

    let packedKinds(kinds: Array(Kind)): Array(Int) =
        begin
            let n = {extent kinds + 7} / 8
            let res = array of({if n is 0 then 1 else n end} 0)
            for i = 0 upto {extent kinds - 1} do
                let var shifted = kindCode(kinds[i])
                for j = 1 upto {i % 8} do shifted := shifted * 256 end
                res[i / 8] := res[i / 8] + shifted
            end
            res
        end
end
