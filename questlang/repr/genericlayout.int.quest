(* Quest Self-Hosted Compiler: Generic Layouts Interface
 *
 * Whether generic code's layout of a value agrees with the native one, which
 * decides where values are converted between them (docs/c-representation.md
 * section 6.4), and the layouts of module abstract types' applications, over
 * repr/layout. bootstrap/python/quest/repr/layout.py's generic layouts are
 * the counterpart. *)

interface GenericLayout
import
    questlang/types/model : questlang/types/Model
    util/maybe : util/Maybe
export
    (* Whether a value of t substituted by subst, laid out natively, is laid out
     * as generic code lays out t, where each variable in subst is a type
     * parameter of that code *)
    genericLayoutAgrees(t: model.Type subst: model.Subst): Bool
    (* Whether converting a value of t between the generic layout and the native
     * one at subst would copy mutable data whose layouts differ *)
    genericLayoutCopiesMutableData(t: model.Type subst: model.Subst): Bool
    (* An application of a module's abstract type operator whose representation
     * is known (the module was elaborated from its source): the
     * representation's body, generic in the operator's parameters, and the
     * arguments substituted for them. Outside the module, its values are laid
     * out as the body is by generic code (docs/c-representation.md section
     * 5.1) *)
    Def AbstractInstance = Tuple generic: model.Type subst: model.Subst end
    abstractInstance(t: model.Type): maybe.T(AbstractInstance)
    (* Whether a value of type t is or holds an application of an abstract type
     * operator laid out at its arguments otherwise than generically: the
     * module's code at those arguments and the code outside it lay it out
     * differently, as a closure whose C signature changes with them *)
    abstractLayoutsDiffer(t: model.Type): Bool
    (* The representation of a function type's calls (its result's and
     * parameters' representations and its number of type parameters), as a key:
     * closures of types with the same key are called alike *)
    signatureRepresentation(t: model.Type): String
    (* The human-readable name of a type for runtime diagnostics and printing *)
    qtypeToNameStr(t: model.Type): String
    (* Whether s and t are records, and s is a subtype of t by width alone: s
     * has each of t's fields, of an equal type *)
    isRecordSubtype(s: model.Type t: model.Type): Bool
end
