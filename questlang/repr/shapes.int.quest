(* Quest Self-Hosted Compiler: Shapes Interface
 *
 * Provides the backend's structural view of Quest types (docs/ir.md
 * section 4.1). A shape strips type aliases, reduces type operator
 * applications, and makes recursion explicit as a cycle in the shape graph.
 * shape(t) is computed from the canonical form of t and cached per canonical
 * type, so equal types share the same shape. Shapes are built once and never
 * modified afterwards.
 *
 * Each Shape is a node with a unique id whose populated fields depend on its
 * kind (see Shape below). The element, result, and body accessors unwrap the
 * corresponding optional fields (which are none for other kinds). The
 * counterpart is bootstrap/python/quest/repr/shapes.py. *)

interface Shapes
import
    util/maybe : util/Maybe

    questlang/types/model : questlang/types/Model
export
    (* The kinds of shapes: scalars (int through bottom) and compound or
     * opaque kinds; pending is a temporary placeholder while a recursive
     * shape is built *)
    Def ShapeKind = Option shapeInt shapeReal shapeBool shapeChar shapeString shapeOk shapeWord shapeBottom shapeTuple
        shapeRecord shapeVariant shapeOption shapeArray shapeCell shapeOut shapeException shapeFun shapeAll shapeAuto
        shapeTypevar shapeAbstract shapeExternal shapeOperator shapePending end
    shapeInt: ShapeKind
    shapeReal: ShapeKind
    shapeBool: ShapeKind
    shapeChar: ShapeKind
    shapeString: ShapeKind
    shapeOk: ShapeKind
    shapeWord: ShapeKind
    shapeBottom: ShapeKind
    shapeTuple: ShapeKind
    shapeRecord: ShapeKind
    shapeVariant: ShapeKind
    shapeOption: ShapeKind
    shapeArray: ShapeKind
    shapeCell: ShapeKind
    shapeOut: ShapeKind
    shapeException: ShapeKind
    shapeFun: ShapeKind
    shapeAll: ShapeKind
    shapeAuto: ShapeKind
    shapeTypevar: ShapeKind
    shapeAbstract: ShapeKind
    shapeExternal: ShapeKind
    shapeOperator: ShapeKind
    shapePending: ShapeKind
    (* A kind's name, as the bootstrap spells it *)
    kindName(k: ShapeKind): String

    (* The backend's structural view of a type, with fields populated by kind:
     * - components: tuple (value components), record (fields), auto
     *   (signature);
     * - cases: variant (a payload shape each, or none) and option (a tuple
     *   shape each, or none);
     * - elementShape: array, cell (Var), out (Out), exception (payload);
     * - params and resultShape: fun; typeParams and bodyShape: all;
     *   typeParams (one) and components: auto;
     * - symbolId, name, and bound: typevar (a type parameter or an abstract
     *   type of a module or interface); bound is the shape of its POWER
     *   (subtype) bound, if any;
     * - name: abstract (its short name) and external (its C type).
     * An operator shape represents a type operator passed for a higher-kinded
     * type parameter and is opaque. type is the canonical type the shape
     * describes, and structure is the type whose outermost constructor it
     * describes (the unfolding for a recursive type). *)
    Def Rec Shape = Tuple
        id: Int
        var kind: ShapeKind
        type: model.Type
        var structure: model.Type
        var components: Array(Component)
        var cases: Array(Component)
        var elementShape: maybe.T(Shape)
        var params: Array(Param)
        var resultShape: maybe.T(Shape)
        var typeParams: Array(TypeParam)
        var bodyShape: maybe.T(Shape)
        var symbolId: Int
        var bound: maybe.T(Shape)
        var name: String
    end
    (* A named component of a tuple, record, or auto value's signature, or a
     * case of a variant or option *)
    and Component = Tuple name: maybe.T(String) shape: maybe.T(Shape) isVar: Bool end
    (* A parameter of a function shape: its shape and mode *)
    and Param = Tuple name: String shape: Shape mode: ParamMode end
    (* How a parameter is passed: by value, or as a var or out parameter, a
     * location the callee reads and assigns or only assigns *)
    and ParamMode = Option modeValue modeVar modeOut end
    (* A type parameter of an all shape, or the type component of an auto shape;
     * bound is the shape of T for a parameter bounded by POWER(T) *)
    and TypeParam = Tuple name: String symbolId: Int kind: model.Kind bound: maybe.T(Shape) end

    (* repr's internal error: a type with no shape, or a fact asked of a
     * shape that has none of it (the bootstrap's ValueError) *)
    noShape: Exception(String)
    (* The shape of a type (which must not contain unsolved metavariables) *)
    shape(t: model.Type): Shape
    (* Control whether module abstract types with known representations (from
     * modules elaborated from source) expand to their representation shapes,
     * as in whole-program compilation (docs/ir.md section 4.1). Must be set
     * once before any shape is requested; otherwise abstract types keep opaque
     * shapes. *)
    setTransparentAbstractTypes(on: Bool): Ok
    transparentAbstractTypes(): Bool
    (* The runtime-descriptor shape of t, keeping module abstract types opaque
     * even when transparentAbstractTypes is enabled (used for descriptors and
     * echo; docs/ir.md section 4.1). When transparentAbstractTypes is false,
     * this is identical to shape(t). *)
    opaqueShape(t: model.Type): Shape

    element(s: Shape): Shape
    result(s: Shape): Shape
    body(s: Shape): Shape
    (* A component's shape, which a case without a payload has none of *)
    componentShape(c: Component): Shape

    same(a: Shape b: Shape): Bool
    (* Whether s is of kind k; whether two kinds are the same *)
    kindIs(s: Shape k: ShapeKind): Bool
    sameKind(a: ShapeKind b: ShapeKind): Bool
    (* Whether s is the shape of a recursive type (whose structure is its
     * unfolding's) *)
    isRecursive(s: Shape): Bool
    component(s: Shape name: String): maybe.T(Component)
    caseOf(s: Shape name: String): maybe.T(Component)
    (* The index of case tag of a variant or option shape s, as tags number
     * them (its cases are in name order, docs/c-representation.md section
     * 5.3), and the shape of the case's payload (none for a case without
     * one). A tag s has no case of is a compiler error: both raise. *)
    tagIndex(s: Shape tag: String): Int
    caseShape(s: Shape tag: String): maybe.T(Shape)
    (* A record's fields in name order (the order of its payload's layout) *)
    sortedComponents(s: Shape): Array(Component)
    (* The shapes s refers to directly *)
    children(s: Shape): Array(Shape)

    (* The kinds of shapes in whose representation a type parameter bounded by
     * one holds its values: records, variants, and options *)
    isViewedKind(kind: ShapeKind): Bool
    (* The quantifiers of a shape: how many type parameters they bind, nested
     * ones included (the descriptors a function of its type takes after its
     * environment), and the shape under them (a function's shape, or for a
     * type-only function its result's). A shape with no quantifiers has count
     * 0 and is its own body. *)
    Def Quantified = Tuple count: Int body: Shape end
    quantified(s: Shape): Quantified
    (* Whether values of type t are functions, polymorphic or not *)
    isFunction(t: model.Type): Bool
end
