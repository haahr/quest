(* Quest Self-Hosted Compiler: Type Descriptors' Type-Level Forms Interface
 *
 * This interface defines the type-level forms used by runtime type descriptors
 * across all backends (docs/c-representation.md section 6.4), mirroring
 * bootstrap/python/quest/repr/descriptors.py. It provides placeholders for
 * bound type parameters and descriptor template holes, and canonical forms of
 * function and auto types for descriptor comparison. *)

interface Descriptors
import
    util/maybe : util/Maybe

    questlang/types/model : questlang/types/Model
export
    (* The global name of a module's abstract type (docs/dynamic.md section
     * 2.3), if t is one *)
    moduleAbstractTypeName(t: model.Type): maybe.T(String)

    (* The placeholder for the bound type parameter at de Bruijn index index
     * (the number of enclosing binders to its binder, nearest 0), keeping
     * its bound *)
    boundVar(index: Int bound: maybe.T(model.Kind)): model.Type
    boundVarIndex(t: model.Type): maybe.T(Int)
    (* The placeholder for the index'th type parameter of a descriptor template
     * (a descriptor for a generic type whose type arguments are filled in at
     * run time), keeping the parameter's bound *)
    holeVar(index: Int bound: maybe.T(model.Kind)): model.Type
    holeIndex(t: model.Type): maybe.T(Int)

    (* The canonical form of a function type, which equal types share: value
     * parameters lose their names, and the type parameters of a polymorphic
     * function type are replaced by placeholders (de Bruijn indices) *)
    canonicalFunType(t: model.Type): model.Type
    (* The canonical form of an auto type: its type parameter is the placeholder
     * with de Bruijn index 0 *)
    canonicalAutoType(t: model.Type): model.Type
end
