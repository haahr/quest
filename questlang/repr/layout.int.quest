(* Quest Self-Hosted Compiler: Layouts of Values Interface
 *
 * This interface computes how values are laid out for every backend
 * (docs/c-representation.md), mirroring bootstrap/python/quest/repr/layout.py.
 * Layouts depend only on shapes and are cached per shape. They provide each
 * type's layout tag (which names its C struct and descriptor; repr/digests
 * distinguishes types that share a tag), its representation (the runtime C
 * type: a scalar, a QVal uniform 64-bit word, a 16-byte record or variant
 * value, or a pointer), and its slot representation (how an aggregate field
 * or QVal word stores it: a record or variant as a pointer to an immutable
 * box, and a Bool or Char widened to a full word). It also decides whether a
 * tuple or option value may be a proxy (a wrapper created when upcasting
 * changes how a component is viewed). Checking whether generic code's layout
 * agrees with the native layout belongs to repr/genericlayout. *)

interface Layout
import
    util/maybe : util/Maybe

    questlang/repr/shapes : questlang/repr/Shapes
    questlang/types/model : questlang/types/Model
export
    (* s, or for a type variable or abstract type bounded by POWER(T), the shape
     * its bounds resolve to *)
    resolvedShape(s: shapes.Shape): shapes.Shape
    (* Whether values of shape s, of a type with a bound, are held viewed at the
     * bound: a module's abstract type, an abstract type elaborated as such, or
     * a path type *)
    heldAtBound(s: shapes.Shape): Bool
    (* Whether s is a bounded type parameter's shape, whose values generic code
     * holds at their own view *)
    ownView(s: shapes.Shape): Bool
    (* Whether t is Word.T, which is laid out as 64 unsigned bits *)
    isWordShaped(t: model.Type): Bool

    (* How a value is represented, whatever its C type: nothing (Ok), a word
     * (an Int, a Word.T, or a QVal), a byte (a Bool or Char), a Real, a record
     * or a variant (two words each), or a pointer (or another C word) *)
    Def Representation = Option
        repVoid repInt repWord repBool repChar repReal repRecord repVariant repPointer repQVal
    end
    representationKind(t: model.Type): Representation
    shapeRepresentationKind(s: shapes.Shape): Representation
    (* Whether s is represented as a QVal *)
    isQVal(s: shapes.Shape): Bool
    (* Whether s is represented as a C pointer: a repPointer, but for an
     * external type whose C name is not a pointer's (uint64_t, say) *)
    isPointer(s: shapes.Shape): Bool
    (* Whether s's slot representation (shapeSlotRepresentation) is a QVal (a
     * QVal's or Ok's), and whether it is a pointer (a record's or variant's
     * box, or a pointer's) *)
    slotIsQVal(s: shapes.Shape): Bool
    slotIsPointer(s: shapes.Shape): Bool
    (* The representation of a value of t, named by the runtime's C type for
     * it *)
    representation(t: model.Type): String
    shapeRepresentation(s: shapes.Shape): String
    (* The C type of a value of t in an aggregate slot or a QVal word *)
    slotRepresentation(t: model.Type): String
    shapeSlotRepresentation(s: shapes.Shape): String
    (* The C type of the location a var or out parameter points to (or a Var
     * cell is) *)
    locationRepresentation(t: model.Type): String
    shapeLocationRepresentation(s: shapes.Shape): String

    (* Whether a value of shape s, a tuple or option, may be a proxy
     * (docs/c-representation.md section 5.8) *)
    mayBeProxied(s: shapes.Shape): Bool
    (* Whether a component of shape s may change view when its tuple or option
     * is upcast *)
    changesView(s: shapes.Shape): Bool
    (* Whether a slot holds values of shape s boxed: records and variants *)
    isBoxedInSlots(s: shapes.Shape): Bool

    (* How a value is held in a QVal word (as generic code holds a value of a
     * type parameter, and a slot holds one in its QVal form), which says how
     * every backend converts between the value and the word (docs/arm64.md
     * section 7.5) *)
    Def WordForm = Option
        (* already a QVal word: a value of a type parameter *)
        wordItself
        (* Ok, which has no value: the word 0 *)
        wordOk
        (* a record or a variant, 16 bytes: a pointer to an immutable box of
         * them *)
        wordRecordBox
        wordVariantBox
        (* a Word: its 64 bits *)
        wordBits
        (* an Int, Bool, or Char: the integer, extended to 64 bits (a Char
         * as a QChar, an unsigned byte) *)
        wordInteger
        (* a Real: its 64 bits *)
        wordReal
        (* any other value, which is a pointer *)
        wordPointer
    end
    (* The word form of values of shape s, as resolved to its bound *)
    wordForm(s: shapes.Shape): WordForm

    (* These functions give aggregate struct layouts in bytes on a 64-bit
     * target (docs/c-representation.md section 5) for backends that lay them
     * out themselves (docs/arm64.md section 3.3); the C backend asserts them.
     * Every slot is one 8-byte word. *)
    (* A struct of n slots, which C gives a char of its own when n is 0 *)
    slotsBytes(n: Int): Int
    (* A tuple type's struct: its value components, slot i at 8i *)
    tupleBytes(t: model.Type): Int
    (* A record type's struct: its header (the layout's descriptor), then
     * its fields in the order of their names, the k'th at 8 + 8k *)
    recordBytes(t: model.Type): Int
    recordFieldOffset(t: model.Type name: String): Int
    (* An option type's struct: its tag at 0, then the union of its cases'
     * payloads at 8, each a struct of its components' slots *)
    optionBytes(t: model.Type): Int
    (* The bytes of a value of t as a variable holds it (its representation) *)
    representationBytes(t: model.Type): Int

    (* A deterministic, valid C identifier component for a type, and for the
     * types of shape s *)
    typeTag(t: model.Type): String
    shapeTag(s: shapes.Shape): String
    tupleStructName(t: model.Type): String
    optionStructName(t: model.Type): String

    (* The shape a value of type t is held in, if it is of the given kind: t's
     * shape, or for a type parameter the shape its bound resolves to
     * (resolvedShape), since a value of a bounded type parameter is read
     * through its bound's structure *)
    heldShape(t: model.Type kind: shapes.ShapeKind): maybe.T(shapes.Shape)
end
