(* Quest Self-Hosted Compiler: Generic Layouts Implementation
 *
 * Generic code (a polymorphic function's body, or code outside a module
 * using its abstract types) holds a value of a type parameter T in a
 * generic 64-bit QVal word. It therefore lays out any type mentioning T
 * with a word wherever T appears: an Array(T) has QVal slots. Native code
 * with T = Int lays out Array(Int) with QInt slots, which agree because a
 * slot is one word either way; with T = a record type, native slots hold
 * heap-allocated boxes just as generic code expects. By contrast, a
 * function of type Fun(x: T): T is called with a QVal in generic code and
 * a QReal in native code when T = Real, so the layouts disagree and the
 * value must be adapted when crossing between them.
 *
 * Whether layouts agree depends on where T is held: in an aggregate slot
 * (a word), in a register (a parameter or result, where C's calling
 * conventions must match), or in a cell referenced by a var or out
 * parameter. *)

module genericLayout : GenericLayout
import
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    sb = util/stringBuilder : util/StringBuilder

    questlang/common/maps : questlang/common/Maps
    questlang/modules/abstractTypes : questlang/modules/AbstractTypes
    questlang/repr/layout : questlang/repr/Layout
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/repr/syntax : questlang/repr/Syntax
    questlang/types/model : questlang/types/Model
    questlang/types/subtyping : questlang/types/Subtyping
export
    Let Type = model.Type
    Let Shape = shapes.Shape
    let eq(a: String b: String): Bool = stringOp.equal(a b)
    Let Seen = maps.IntSet
    let newSeen(): Seen = maps.newIntSet()

    (* Whether values of a representation are scalars, which a slot holds in a
     * word of its own *)
    let wordScalar(r: layout.Representation): Bool =
        case r
            when repInt, repReal, repBool, repChar, repQVal, repVoid then true
            when repWord, repRecord, repVariant, repPointer then false
        end
    (* Whether native values of a representation are passed and returned as a
     * QVal is, in a 64-bit integer register: not a Real, in a floating-point
     * register, nor a Bool or Char, a byte *)
    let registerWord(r: layout.Representation): Bool =
        case r
            when repInt, repQVal then true
            when repVoid, repWord, repBool, repChar, repReal, repRecord, repVariant, repPointer then false
        end
    (* Whether a QVal cell holds native values of a representation in the same
     * eight bytes, or, for a record or variant, boxed, as a QVal does *)
    let cellWord(r: layout.Representation): Bool =
        case r
            when repInt, repReal, repQVal, repWord, repRecord, repVariant then true
            when repVoid, repBool, repChar, repPointer then false
        end
    (* Where a value is held: in an aggregate slot, in a register, or in a cell
     * a var or out parameter points to *)
    let slotPlace = "slot"
    let registerPlace = "register"
    let cellPlace = "cell"
    (* Whether the type of shape s mentions one of the type parameters in
     * subst *)
    let mentions(s: Shape subst: model.Subst): Bool =
        begin
            let var found = false
            for i = 0 upto {extent s.type.fv - 1} do
                if hashMap.contains(subst s.type.fv[i]) then found := true end
            end
            found
        end
    (* Whether a native value of arg agrees with a value of the type parameter
     * of shape v as generic code holds it in the place *)
    let storedValueAgrees(v: Shape arg: Type place: String): Bool =
        begin
            let argShape = shapes.shape(arg)
            let argRep = layout.shapeRepresentation(argShape)
            if maybe.isSome(v.bound) andif layout.ownView(v) then
                (* Held as arg's own value, in the representation of the
                 * bound *)
                let bound = maybe.unwrap(v.bound)
                layout.heldAlike(argShape bound) orif {layout.isPointer(argShape) andif layout.isPointer(bound)}
            elsif maybe.isSome(v.bound) then
                (* Held as a value of the bound, viewed at it, which agrees with
                 * one of arg only when both are the same scalar *)
                layout.heldAlike(argShape maybe.unwrap(v.bound)) andif wordScalar(argRep)
                    andif {not(eq(place registerPlace)) orif registerWord(argRep)}
            elsif eq(place registerPlace) then
                registerWord(argRep) orif layout.isPointer(argShape)
            elsif eq(place cellPlace) then
                cellWord(argRep) orif layout.isPointer(argShape)
            else
                true
            end
        end
    (* The symbol of the type variable s is the shape of, if it is one *)
    let typeParameter(s: Shape): maybe.T(Int) =
        case s.type.form
            when typeVariable with x then maybe.some(x.symbolId)
            else maybe.none()
        end
    (* Return whether a value of shape s laid out natively under subst agrees
     * with generic code's layout of s in the given place. A shape mentioning
     * no parameter in subst agrees; a type parameter agrees according to
     * storedValueAgrees; an aggregate agrees when each component does in a
     * slot. A recursive shape seen again is assumed to agree so the walk
     * terminates (coinductively). *)
    let rec agrees(s: Shape subst: model.Subst place: String seen: Seen): Bool =
        begin
            let symbol = typeParameter(s)
            if not(mentions(s subst)) then
                true
            elsif maybe.isSome(symbol) then
                let arg = hashMap.get(subst maybe.unwrap(symbol))
                if maybe.isSome(arg) then storedValueAgrees(s maybe.unwrap(arg) place) else true end
            elsif shapes.isRecursive(s) andif hashSet.contains(seen s.id) then
                true
            else
                if shapes.isRecursive(s) then hashSet.insert(seen s.id) end
                let slot = fun(component: Shape): Bool agrees(component subst slotPlace seen)
                case s.kind
                    (* An application of an abstract operator, whose values are
                     * opaque pointers *)
                    when shapeAbstract then s.type.form?typeApp
                    when shapeTuple, shapeRecord then
                        let var all = true
                        for i = 0 upto {extent s.components - 1} do
                            if all andif not(slot(shapes.componentShape(s.components[i]))) then all := false end
                        end
                        all
                    when shapeVariant, shapeOption then
                        let var all = true
                        for i = 0 upto {extent s.cases - 1} do
                            let c = s.cases[i].shape
                            if all andif maybe.isSome(c)
                                    andif not(slot(maybe.unwrap(c))) then all := false end
                        end
                        all
                    (* An exception's payload is raised in a QVal word, read as
                     * a slot *)
                    when shapeArray, shapeException then slot(shapes.element(s))
                    when shapeCell, shapeOut then agrees(shapes.element(s) subst cellPlace seen)
                    when shapeFun then
                        let var all = true
                        for i = 0 upto {extent s.params - 1} do
                            let p = s.params[i]
                            if all andif not(agrees(p.shape subst
                                    if p.mode?modeValue then registerPlace else cellPlace end seen)) then
                                all := false
                            end
                        end
                        all andif agrees(shapes.result(s) subst registerPlace seen)
                    when shapeAll then agrees(shapes.body(s) subst place seen)
                    (* Anything else that mentions a type parameter (auto types,
                     * path types) may differ *)
                    when shapeInt, shapeReal, shapeBool, shapeChar, shapeString, shapeOk, shapeWord, shapeBottom,
                            shapeAuto, shapeTypevar, shapeExternal, shapeOperator, shapePending then false
                end
            end
        end
    let genericLayoutAgrees(t: Type subst: model.Subst): Bool =
        hashMap.empty(subst) orif agrees(shapes.shape(t) subst slotPlace newSeen())
    let genericLayoutCopiesMutableData(t: Type subst: model.Subst): Bool =
        begin
            let seen = newSeen()
            let disagrees = fun(component: Shape place: String): Bool not(agrees(component subst place newSeen()))
            (* Return whether a value of shape s holds mutable data (an array
             * or cell element, or a var field or case) reachable without
             * passing through a closure whose generic and native layouts
             * disagree. Converting such a value would copy it, so writes to
             * the copy would not reach the original. *)
            let rec visit(s: Shape): Bool =
                if not(mentions(s subst)) then
                    false
                elsif shapes.isRecursive(s) andif hashSet.contains(seen s.id) then
                    false
                else
                    if shapes.isRecursive(s) then hashSet.insert(seen s.id) end
                    case s.kind
                        when shapeArray then disagrees(shapes.element(s) slotPlace) orif visit(shapes.element(s))
                        when shapeCell, shapeOut then disagrees(shapes.element(s) cellPlace)
                            orif visit(shapes.element(s))
                        (* A tuple is converted through a proxy, which reads and
                         * writes its original's components *)
                        when shapeTuple then
                            let var any = false
                            for i = 0 upto {extent s.components - 1} do
                                if not(any) andif visit(shapes.componentShape(s.components[i])) then any := true end
                            end
                            any
                        when shapeRecord then
                            let var any = false
                            for i = 0 upto {extent s.components - 1} do
                                let c = s.components[i]
                                let cs = shapes.componentShape(c)
                                if not(any) andif {{c.isVar andif disagrees(cs slotPlace)}
                                        orif visit(cs)} then any := true end
                            end
                            any
                        when shapeVariant then
                            let var any = false
                            for i = 0 upto {extent s.cases - 1} do
                                let c = s.cases[i]
                                if not(any) andif maybe.isSome(c.shape) then
                                    let cs = maybe.unwrap(c.shape)
                                    if {c.isVar andif disagrees(cs slotPlace)} orif visit(cs) then any := true end
                                end
                            end
                            any
                        when shapeOption then
                            let var any = false
                            for i = 0 upto {extent s.cases - 1} do
                                let c = s.cases[i]
                                if not(any) andif maybe.isSome(c.shape)
                                        andif visit(maybe.unwrap(c.shape)) then
                                    any := true
                                end
                            end
                            any
                        (* Closures are adapted rather than copied *)
                        when shapeInt, shapeReal, shapeBool, shapeChar, shapeString, shapeOk, shapeWord, shapeBottom,
                                shapeException, shapeFun, shapeAll, shapeAuto, shapeTypevar, shapeAbstract,
                                shapeExternal,
                                shapeOperator, shapePending then false
                    end
                end
            visit(shapes.shape(t))
        end
    Def AbstractInstance = Tuple generic: Type subst: model.Subst end
    let abstractInstance(t0: Type): maybe.T(AbstractInstance) =
        begin
            let none = maybe.none(:AbstractInstance)
            let t = model.prune(t0)
            case t.form
                when typeApp with x then
                    let symbol =
                        case model.prune(x.constructor).form
                            when typeVariable with v then v.symbolId
                            when typeAbstract with v then v.symbolId
                            else ~1
                        end
                    let entry =
                        if abstractTypes.isAbstractTypeSymbol(symbol) then
                            abstractTypes.abstractTypeBySymbol(symbol)
                        else
                            maybe.none(:abstractTypes.ModuleAbstractType)
                        end
                    (* A transparent one (in a whole program) is laid out as its
                     * representation is, everywhere *)
                    let transparent = shapes.transparentAbstractTypes()
                        andif maybe.isSome(entry)
                        andif abstractTypes.unbounded(maybe.unwrap(entry))
                    let written =
                        if maybe.isSome(entry) andif not(transparent) then
                            maybe.unwrap(entry).rep
                        else
                            maybe.none(:Type)
                        end
                    if maybe.isNone(written) then
                        none
                    else
                        let rep = shapes.shape(maybe.unwrap(written)).type
                        case rep.form
                            when typeOperator with op then
                                if extent op.params is extent x.arguments then
                                    let subst = model.newSubst()
                                    for i = 0 upto {extent op.params - 1} do
                                        hashMap.insert(subst op.params[i].symbolId x.arguments[i])
                                    end
                                    maybe.some(tuple let generic = op.body let subst = subst end)
                                else
                                    none
                                end
                            else none
                        end
                    end
                else none
            end
        end
    let abstractLayoutsDiffer(t: Type): Bool =
        begin
            let seen = newSeen()
            let rec visit(s: Shape): Bool =
                if hashSet.contains(seen s.id) then
                    false
                else
                    hashSet.insert(seen s.id)
                    (* An abstract application with a known representation
                     * differs when its generic and native layouts disagree;
                     * any other shape differs when one of its parts does *)
                    let any = fun(shapes0: Array(maybe.T(Shape))): Bool
                        begin
                            let var found = false
                            for i = 0 upto {extent shapes0 - 1} do
                                if not(found) andif maybe.isSome(shapes0[i])
                                        andif visit(maybe.unwrap(shapes0[i])) then found := true end
                            end
                            found
                        end
                    let inner = vector.new(:maybe.T(Shape))
                    for i = 0 upto {extent s.components - 1} do
                        vector.append(inner maybe.some(shapes.componentShape(s.components[i])))
                    end
                    for i = 0 upto {extent s.cases - 1} do vector.append(inner s.cases[i].shape) end
                    for i = 0 upto {extent s.params - 1} do
                        vector.append(inner maybe.some(s.params[i].shape))
                    end
                    vector.append(inner s.elementShape)
                    vector.append(inner s.resultShape)
                    vector.append(inner s.bodyShape)
                    let instance = if shapes.kindIs(s shapes.shapeAbstract) then abstractInstance(s.type)
                        else maybe.none(:AbstractInstance) end
                    if maybe.isSome(instance) then
                        let i = maybe.unwrap(instance)
                        not(genericLayoutAgrees(i.generic i.subst))
                    else
                        any(vector.toArray(inner))
                    end
                end
            visit(shapes.shape(t))
        end
    let abstractLayoutsDifferAt(t0: Type typeArgs: Array(Type)): Bool =
        begin
            let t = model.stripAliases(model.prune(t0))
            let applied =
                case t.form
                    when typeAll with x then
                        if extent x.quantifiers isnot extent typeArgs then
                            t
                        else
                            let subst = model.newSubst()
                            for i = 0 upto {extent typeArgs - 1} do
                                hashMap.insert(subst x.quantifiers[i].symbolId typeArgs[i])
                            end
                            model.substitute(x.body subst)
                        end
                    else t
                end
            abstractLayoutsDiffer(applied)
        end
    let signatureRepresentation(t: Type): String =
        begin
            let q = shapes.quantified(shapes.shape(t))
            let s = q.body
            let count = q.count
            let params = if shapes.kindIs(s shapes.shapeFun) then s.params else array of :shapes.Param end end
            let result = if shapes.kindIs(s shapes.shapeFun) then shapes.result(s) else s end
            let key = sb.new()
            sb.str(key layout.shapeCType(result))
            sb.char(key '|')
            sb.str(key syntax.cInt(count))
            for i = 0 upto {extent params - 1} do
                let p = params[i]
                sb.char(key '|')
                if not(p.mode?modeValue) then
                    sb.str(key layout.shapeLocationCType(p.shape) <> " *")
                (* An Ok parameter is passed as a QVal word, since C has no
                 * void parameter *)
                elsif shapes.kindIs(p.shape shapes.shapeOk) then
                    sb.str(key "QVal")
                else
                    sb.str(key layout.shapeCType(p.shape))
                end
            end
            sb.toString(key)
        end
    let qtypeToNameStr(t0: Type): String =
        begin
            let t = model.prune(t0)
            case t.form
                when typeAlias with x then x.name
                when typeExternal with x then
                    if layout.isWordShaped(t) then "word.T" elsif stringOp.isEmpty(x.name) then x.cType else x.name end
                else
                    if layout.isWordShaped(t) then "word.T"
                    elsif model.same(t model.intType) then "Int"
                    elsif model.same(t model.realType) then "Real"
                    elsif model.same(t model.boolType) then "Bool"
                    elsif model.same(t model.charType) then "Char"
                    elsif model.same(t model.stringType) then "String"
                    elsif model.same(t model.okType) then "Ok"
                    else model.show(t)
                    end
            end
        end
    let typeEqual(a: Type b: Type): Bool = model.same(a b) orif subtyping.isTypeEqual(a b maybe.none())
    let isRecordSubtype(s: Type t: Type): Bool =
        case s.form
            when typeRecord with x then
                case t.form
                    when typeRecord with y then
                        let var all = true
                        for i = 0 upto {extent y.fields - 1} do
                            let f = model.recordGetField(x.fields y.fields[i].name)
                            if maybe.isNone(f) then
                                all := false
                            elsif not(typeEqual(maybe.unwrap(f).type y.fields[i].type)) then
                                all := false
                            end
                        end
                        all
                    else false
                end
            else false
        end
end
