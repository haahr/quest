(* Quest Self-Hosted Compiler: Linked Symbols Interface
 *
 * Mangles Quest value, function, and module names into C identifiers for
 * linking (docs/name-mangling.md). Every backend uses these names so
 * separately compiled units link with one another and with the C runtime.
 * The counterpart is bootstrap/python/quest/repr/symbols.py. *)

interface Symbols
export
    (* An identifier with symbolic characters as a C identifier: qv_sym_ and
     * its parts, each character spelled by name, joined by underscores *)
    mangleSymbolicIdent(name: String): String
    (* A field's or interface member's name as a C identifier fragment, for
     * the names built from it (qf_<name>, offset_<name>,
     * quest_type_<i>_<name>): an alphanumeric name as it is, a symbolic one as
     * sym_ and its parts, as mangleSymbolicIdent spells them (<+> is
     * sym_lt_plus_gt) *)
    memberIdent(name: String): String
    (* A Quest identifier as a C identifier prefixed with qv_ *)
    mangleIdent(name: String): String
    (* A hierarchical module name as a C identifier: lowercase, with __ for
     * each slash and _ for each dot *)
    mangleModuleName(moduleName: String): String
    (* The C identifier of a module's record, from its mangled name: under its
     * own prefix, qm_, since under qv_ module m's record would be named as a
     * user identifier m is *)
    moduleRecordIdent(cleanMod: String): String
    (* The C identifier of a module unit's interface fingerprint, a C string
     * the JIT checks (docs/jit.md section 3.3): qh_ and its mangled name *)
    fingerprintIdent(cleanMod: String): String
    (* The C identifier of a module's initializer, from its mangled name:
     * qv_mod_<module>_init *)
    moduleInitIdent(cleanMod: String): String
    (* The C identifier of the flag a module's initializer sets when it first
     * runs, so later calls return at once: qv_mod_<module>_initialized *)
    moduleInitializedIdent(cleanMod: String): String
    (* Whether a symbol is a module's initializer, as moduleInitIdent names
     * it *)
    isModuleInitSymbol(symbol: String): Bool
    (* The name of the module whose initializer runs a REPL or JIT input's
     * phrases (docs/jit.md): qj_<number> *)
    phraseModuleName(number: Int): String
    (* Whether a module name is a phrase module's, as phraseModuleName names
     * it *)
    isPhraseModuleName(name: String): Bool
    (* The C identifier of a phrase module's entry, which the JIT calls: it
     * registers the unit's tables and runs its modules' initializers
     * (docs/jit.md section 3.2): <module>_entry *)
    phraseEntryIdent(phraseModule: String): String
    (* The C identifier of the string a phrase module's entry stores its echo
     * text in when it captures it: <module>_echo *)
    phraseEchoIdent(phraseModule: String): String
    (* The C identifier of a unit's frame table (docs/collector.md), which
     * the unit registers with the collector: qr_frames *)
    framesIdent: String
    (* A module-scoped identifier as a C identifier prefixed with
     * qv_<module>_ *)
    mangleModuleIdent(moduleName: String name: String): String
end
