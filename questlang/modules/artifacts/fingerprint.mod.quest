(* Quest Self-Hosted Compiler: Interface Fingerprints Implementation *)

module fingerprint : Fingerprint
import
    conv : Conv
    raised : Raised
    stringOp = string : StringOp
    system : System

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/sort : util/Sort
    util/strutil : util/Strutil

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/files : questlang/common/Files
    questlang/common/maps : questlang/common/Maps
    questlang/common/sha256 : questlang/common/SHA256
    questlang/config/abi : questlang/config/ABI
    questlang/modules/artifacts/interfaceCompiler : questlang/modules/artifacts/InterfaceCompiler
    questlang/modules/graph : questlang/modules/Graph
    questlang/modules/loader : questlang/modules/Loader
    questlang/types/env : questlang/types/Env
    values = questlang/values/model : questlang/values/Model
export
    Let Value = values.Value

    (* The interface path an import of a .qi names: what follows its last
     * colon (maybe=util/maybe:util/Maybe, :Word) *)
    let importedPath(imp: String): String =
        begin
            let at = strutil.rfind(imp ":")
            if at < 0 then imp else stringOp.getSub(imp {at + 1} {{stringOp.length(imp) - at} - 1}) end
        end

    (* The parsed metadata record stored in a .qi file *)
    let qiRecord(qi: String): Value = interfaceCompiler.qiRecord(qi "")

    let imports(r: Value): Array(String) =
        begin
            let items = interfaceCompiler.itemsOf(interfaceCompiler.fieldOf(r "imports"))
            let result = array of(extent items "")
            for i = 0 upto {extent items - 1} do
                result[i] := case items[i] when vString with x then x.s else "" end
            end
            result
        end

    let sorted(lines: vector.T(String)): String =
        begin
            sort.sortVector(lines sort.stringCompare)
            strutil.join("" lines)
        end

    (* Computes the hexadecimal SHA-256 fingerprint of an interface from its
     * canonical name (such as "util/Maybe"), its .qi file text, and a callback
     * returning the fingerprint of each imported interface by the path
     * recorded in the .qi file. The text digested, one line per item, each
     * group sorted:
     *
     *     abi 60
     *     interface util/Strutil
     *     import maybe=util/maybe:util/Maybe
     *     type T TYPE
     *     value join: All(...) String
     *     uses util/Maybe 3f... *)
    let ofQi(canonical: String qi: String imported: All(path: String) String): String =
        begin
            let r = qiRecord(qi)
            let imps = imports(r)
            let importLines = vector.new(:String)
            let useLines = vector.new(:String)
            for i = 0 upto {extent imps - 1} do
                vector.append(importLines "import " <> imps[i] <> "\n")
                let path = importedPath(imps[i])
                vector.append(useLines "uses " <> path <> " " <> imported(path) <> "\n")
            end
            let typeLines = vector.new(:String)
            let types = interfaceCompiler.itemsOf(interfaceCompiler.fieldOf(r "types"))
            for i = 0 upto {extent types - 1} do
                let t = types[i]
                let manifest =
                    if interfaceCompiler.boolOf(interfaceCompiler.fieldOf(t "isManifest")) then
                        " = " <> interfaceCompiler.stringOf(interfaceCompiler.fieldOf(t "manifestType"))
                    else
                        ""
                    end
                vector.append(typeLines
                        "type " <> interfaceCompiler.stringOf(interfaceCompiler.fieldOf(t "name")) <> " "
                    <> interfaceCompiler.stringOf(interfaceCompiler.fieldOf(t "kind")) <> manifest <> "\n")
            end
            let valueLines = vector.new(:String)
            let vals = interfaceCompiler.itemsOf(interfaceCompiler.fieldOf(r "values"))
            for i = 0 upto {extent vals - 1} do
                let v = vals[i]
                vector.append(valueLines
                        "value " <> interfaceCompiler.stringOf(interfaceCompiler.fieldOf(v "name")) <> ": "
                    <> interfaceCompiler.stringOf(interfaceCompiler.fieldOf(v "typeSig")) <> "\n")
            end
            sha256.hexDigest("abi " <> conv.int(abi.abiVersion) <> "\ninterface " <> canonical <> "\n"
                <> sorted(importLines) <> sorted(typeLines) <> sorted(valueLines) <> sorted(useLines))
        end

    (* The fingerprints computed in this process, by .qi, with the .qi's
     * modification time *)
    Let Known = Tuple mtime: Int fingerprint: String end
    let known = maps.newStringMap(:Known)

    let rec ofInterface(name: String e: env.T): String =
        begin
            let resolved = env.resolveInterface(e name)
            let canonical = graph.interfaceName(resolved)
            let root = loader.resolvedArtifactRoot(e resolved)
            let qi =
                if maybe.isSome(root) then
                    maybe.some(interfaceCompiler.ensureResolvedInterfaceArtifacts(resolved
                            maybe.unwrap(root) maybe.none(:interfaceCompiler.OnCompiled) e.units.resolver).qiFile)
                else
                    graph.freshInterfaceQi(resolved)
                end
            if maybe.isNone(qi) orif not(strutil.endsWith(maybe.unwrap(qi) ".qi"))
                    orif not(files.isFile(maybe.unwrap(qi))) then
                (* A builtin interface, which changes only with the ABI *)
                sha256.hexDigest("abi " <> conv.int(abi.abiVersion) <> "\ninterface " <> canonical <> "\nbuiltin\n")
            else
                let file = maybe.unwrap(qi)
                let mtime = files.modifiedNs(file)
                let cached = hashMap.get(known file)
                if maybe.isSome(cached) andif {maybe.unwrap(cached).mtime >= mtime} then
                    maybe.unwrap(cached).fingerprint
                else
                    let text = files.readText(file)
                    if maybe.isNone(text) then diagnostics.fail(:Ok "Error reading .qi file '" <> file <> "'" 0) end
                    (* Its imports are resolved from its own directory *)
                    let dir = files.parent(maybe.unwrapOr(resolved.source file))
                    let saved = e.currentDir
                    let importedFingerprint(path: String): String =
                        begin
                            e.currentDir := maybe.some(dir)
                            let result =
                                try ofInterface(path e) else with r then
                                    e.currentDir := saved
                                    raised.reraise(:String r)
                                end
                            e.currentDir := saved
                            result
                        end
                    let result = ofQi(canonical maybe.unwrap(text) importedFingerprint)
                    hashMap.insert(known file tuple let mtime = mtime let fingerprint = result end)
                    result
                end
            end
        end
end
