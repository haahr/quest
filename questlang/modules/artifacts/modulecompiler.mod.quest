(* Quest Self-Hosted Compiler: The Module Compiler Implementation *)

module moduleCompiler : ModuleCompiler
import
    raised : Raised
    stringOp = string : StringOp
    system : System
    writer : Writer

    collections/vector : collections/Vector
    os/fileStats : os/FileStats
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/build/compilerRunner : questlang/build/CompilerRunner
    questlang/build/headers : questlang/build/Headers
    cBackend = questlang/codegen/backend : questlang/codegen/Backend
    questlang/codegen/choice : questlang/codegen/Choice
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/files : questlang/common/Files
    questlang/common/location : questlang/common/Location
    questlang/ir/lower : questlang/ir/Lower
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/opened : questlang/ir/Opened
    questlang/modules/abstractTypes : questlang/modules/AbstractTypes
    questlang/modules/artifacts/fingerprint : questlang/modules/artifacts/Fingerprint
    questlang/modules/artifacts/interfaceCompiler : questlang/modules/artifacts/InterfaceCompiler
    questlang/modules/artifacts/manifest : questlang/modules/artifacts/Manifest
    questlang/modules/elaboration : questlang/modules/Elaboration
    questlang/modules/graph : questlang/modules/Graph
    questlang/modules/inlined : questlang/modules/Inlined
    questlang/modules/paths : questlang/modules/Paths
    questlang/modules/units : questlang/modules/Units
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/syntax/ast : questlang/syntax/AST
    questlang/typechecker/application : questlang/typechecker/Application
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
export
    Let ModuleCompileResult = Tuple c: String o: String qm: String end
    Let ModuleImport = Tuple name: String source: String offset: Int end
    Let ModuleUnit = Tuple unit: nodes.Unit sourceMap: location.SourceMap imports: Array(ModuleImport) end
    Let Settings = Tuple
        includePaths: Array(String)
        compiler: maybe.T(String)
        nogc: Bool
        extraFlags: Array(String)
        buildDir: maybe.T(String)
        programDir: maybe.T(String)
        backends: choice.T
        reportInferable: String
    end

    let eq(a: String b: String): Bool = stringOp.equal(a b)

    (* The directories a module file's C translation is compiled with, where its
     * interface's header is found *)
    let headerSearchDirs(outputDir: String e: env.T includePaths: Array(String)): vector.T(String) =
        begin
            let dirs = vector.new(:String)
            vector.append(dirs outputDir)
            if maybe.isSome(e.currentDir) then
                vector.append(dirs maybe.unwrap(e.currentDir))
            end
            for i = 0 upto {extent includePaths - 1} do vector.append(dirs includePaths[i]) end
            vector.append(dirs paths.libDir())
            vector.append(dirs paths.projectDir())
            dirs
        end

    (* The name a module file's C translation includes its interface's header
     * by: the interface path as written, if the C compiler finds a header by
     * that name on its include path, else the header C compilation brought up
     * to date, relative to the include path *)
    let findInterfaceHeader(interfaceName: String dirs: vector.T(String) header: maybe.T(String)): maybe.T(String) =
        begin
            let name = paths.lower(interfaceName) <> ".int.h"
            let var found = maybe.none(:String)
            for i = 0 upto {vector.length(dirs) - 1} do
                if maybe.isNone(found) andif system.isFile(files.join(vector.get(dirs i) name)) then
                    found := maybe.some(name)
                end
            end
            if maybe.isNone(found) andif maybe.isSome(header)
                    andif system.isFile(maybe.unwrap(header)) then
                let h = maybe.unwrap(header)
                for i = 0 upto {vector.length(dirs) - 1} do
                    if maybe.isNone(found) then found := files.relativeTo(h vector.get(dirs i)) end
                end
                if maybe.isNone(found) then found := maybe.some(files.baseName(h)) end
            end
            found
        end

    let interfaceRef(resolved: graph.Resolved path: String): manifest.ImportedInterfaceRef =
        begin
            let src = resolved.source
            let stats = if maybe.isSome(src) then fileStats.find(maybe.unwrap(src))
                else maybe.none(:fileStats.T) end
            let hasSource = maybe.isSome(stats) andif {maybe.unwrap(stats).kind?file}
            tuple
                let name = graph.interfaceName(resolved)
                let source = if maybe.isSome(src) then files.absolute(maybe.unwrap(src)) else "" end
                let mtime = if hasSource then maybe.unwrap(stats).modifiedTime else 0.0 end
                let path = path
                let dir = ""
            end
        end

    (* A module elaborated, as it is compiled: its typed module, named
     * canonically, the modules and interfaces it imports, as its manifest
     * records them, and its interface's canonical name *)
    Let Elaborated = Tuple
        typed: typedAst.Binding
        modules: vector.T(manifest.ImportedModuleRef)
        interfaces: vector.T(manifest.ImportedInterfaceRef)
        targetName: String
    end
    (* A module elaborated and lowered, for moduleFileUnit *)
    Let Lowered = Tuple x: Elaborated unit: nodes.Unit end

    (* Runs body while compiling a separately compiled module file. Other units
     * must see a module file's abstract types opaquely, even inside a
     * whole-program build (such as a prelinked library module that the program
     * imports). While body runs, abstract types are kept opaque in shapes and
     * any representations registered are marked as separately compiled so they
     * never become transparent. Both flags are restored when body returns or
     * raises, so later compilations in the same process are unaffected. *)
    let compilingApart(A::TYPE body: All() A): A =
        begin
            let wasTransparent = shapes.transparentAbstractTypes()
            let wasApart = abstractTypes.registeringApart()
            let restore(): Ok =
                begin
                    abstractTypes.setRegisteringApart(wasApart)
                    shapes.setTransparentAbstractTypes(wasTransparent)
                end
            shapes.setTransparentAbstractTypes(false)
            abstractTypes.setRegisteringApart(true)
            let result = try body() else with r then begin restore() raised.reraise(:A r) end end
            restore()
            result
        end

    (* Runs steps 1 to 3 of compiling decl to a module file in e, configuring e
     * for C compilation; callers must invoke this inside compilingApart *)
    let elaborate(decl: ast.ModuleDecl offset: Int e: env.T canonicalName: String buildDir: maybe.T(String)):
            Elaborated =
        begin
            (* Compiled to C: modules are known through their interfaces *)
            e.compilingC := true
            e.compilingUnit := true
            if maybe.isSome(buildDir) then
                e.buildDir := maybe.some(files.absolute(maybe.unwrap(buildDir)))
            end
            let modules = vector.new(:manifest.ImportedModuleRef)
            let interfaces = vector.new(:manifest.ImportedInterfaceRef)

            (* 1. The interface it implements (from its .qi or .int.quest) *)
            if maybe.isNone(env.lookupInterface(e decl.interfaceName)) then
                elaboration.loadInterface(decl.interfaceName e)
                ok
            end
            (* The manifest records each import as the unit graph resolved it
             * (docs/build-process.md sections 2.1 and 4.3) *)
            let target = env.resolveInterface(e decl.interfaceName)
            let targetName = graph.interfaceName(target)
            vector.append(interfaces interfaceRef(target decl.interfaceName))

            (* 2. The interfaces and modules it imports *)
            for i = 0 upto {vector.length(decl.imports) - 1} do
                let imp = vector.get(decl.imports i)
                let ifacePath = ast.effectiveInterfacePath(imp)
                (* Report any missing or unloadable interface at the import's
                 * offset, as elaboration does, rather than at the module's
                 * first line *)
                let imported = env.atImport(e imp.offset 1 fun(): graph.Resolved
                    begin
                        if maybe.isNone(env.lookupInterface(e ifacePath))
                                andif maybe.isNone(env.lookupInterface(e imp.interfaceName)) then
                            elaboration.loadInterface(ifacePath e)
                            ok
                        end
                        env.resolveInterface(e ifacePath)
                    end)
                let ref = interfaceRef(imported ifacePath)
                vector.append(interfaces ref)
                let modulePaths = ast.effectiveModulePaths(imp)
                for j = 0 upto {vector.length(imp.names) - 1} do
                    let modulePath =
                        if j < vector.length(modulePaths) then
                            vector.get(modulePaths j)
                        else
                            ""
                        end
                    let modRef =
                        if stringOp.length(modulePath) > 0 then
                            modulePath
                        else
                            vector.get(imp.names j)
                        end
                    let m = env.resolveModule(e modRef)
                    vector.append(modules tuple
                        let name = graph.canonicalName(m)
                        let interfaceName = ref.name
                        let source = maybe.unwrapOr(m.source "")
                        let path = modRef
                    end)
                end
            end

            (* 3. The module, elaborated *)
            let typed0 = elaboration.elaborateModule(decl offset e)
            let name = if stringOp.length(canonicalName) > 0 then canonicalName else decl.name end
            let typed =
                case typed0.form
                    when bindModule with x then
                        if eq(x.name name) then
                            typed0
                        else
                            tuple
                                let offset = typed0.offset
                                let form = option bindModule of typedAst.BindingForm with
                                    let name = name
                                    let interfaceName = x.interfaceName
                                    let bindings = x.bindings
                                    let scope = x.scope
                                    let isPrecompiled = x.isPrecompiled
                                    let symbolId = x.symbolId
                                end
                            end
                        end
                    else typed0
                end
            tuple
                let typed = typed
                let modules = modules
                let interfaces = interfaces
                let targetName = targetName
            end
        end

    let compileModule(decl: ast.ModuleDecl offset: Int e: env.T outputDir: String includePaths: Array(String)
            compiler: maybe.T(String) nogc: Bool extraFlags: Array(String) sourceMap: location.SourceMap stem: String
            canonicalName: String sourceFile: String buildDir: maybe.T(String)
            backends: choice.T): ModuleCompileResult =
        begin
            system.makeDirectory(outputDir)
            let x = elaborate(decl offset e canonicalName buildDir)
            application.reportInferable(e sourceMap)
            let typed = x.typed
            let name = if stringOp.length(canonicalName) > 0 then canonicalName else decl.name end

            (* 4. Its interface's header, which its C translation includes,
             * brought up to date and found *)
            let header = headers.ensureImportedInterfaceHeader(decl.interfaceName e)
            let dirs = headerSearchDirs(outputDir e includePaths)
            let interfaceHeader = findInterfaceHeader(decl.interfaceName dirs header)

            (* 5. Its C (exporting the interface's members), and 6. its
             * object *)
            let library = strutil.startsWith(files.absolute(sourceFile) files.join(paths.projectDir() "lib") <> "/")
            let backend = choice.forFile(backends name library)
            (* Turn backend and IR pass failures into compiler diagnostics *)
            let fp = fingerprint.ofInterface(decl.interfaceName e)
            let c =
                try cBackend.moduleFileToC(typed e maybe.some(sourceMap) interfaceHeader backend
                        fp)
                when cBackend.unsupported with m then diagnostics.fail(:String m 0)
                when nodes.irError with m then diagnostics.fail(:String m 0)
                end
            let base = if stringOp.length(stem) > 0 then stem else paths.lower(decl.name) end
            let cFile = choice.codeFile(files.join(outputDir base <> ".mod.c") backend)
            let oFile = files.join(outputDir base <> ".o")
            let w = writer.file(cFile)
            writer.putString(w c)
            writer.close(w)
            (* The directories without repetitions, in order *)
            let unique = vector.new(:String)
            for i = 0 upto {vector.length(dirs) - 1} do
                let d = vector.get(dirs i)
                let var seen = false
                for j = 0 upto {vector.length(unique) - 1} do if eq(vector.get(unique j) d) then
                    seen := true
                end end
                if not(seen) then vector.append(unique d) end
            end
            if choice.isWasm(backend) then
                (* A WebAssembly module serves as both its unit's generated
                 * code and its object file, with no C compiler or linker
                 * (docs/wasm.md section 5.1) *)
                let o = writer.file(oFile)
                writer.putString(o c)
                writer.close(o)
            else
                compilerRunner.compileCToObject(cFile oFile vector.toArray(unique) nogc compiler
                        vector.toArray(vector.concat(vector.fromArray(extraFlags)
                                vector.fromArray(cBackend.cFlags(backend)))))
            end

            (* 7. Its manifest *)
            let direct = vector.toArray(x.interfaces)
            let indirect =
                interfaceCompiler.indirectInterfaceRefs(direct vector.toArray(e.includePaths) e.programDir
                        e.units.resolver)
            let qmFile = files.join(outputDir base <> ".qm")
            manifest.writeQm(manifest.newManifest(name maybe.some(x.targetName) files.absolute(sourceFile)
                    files.absolute(oFile) vector.toArray(x.modules)
                    vector.toArray(vector.concat(x.interfaces
                            vector.fromArray(indirect))) backend inlined.names() opened.lastOpenedSources()) qmFile)
            tuple let c = cFile let o = oFile let qm = qmFile end
        end

    (* What a module file is compiled from: its declaration, at offset in its
     * source map sm, an environment whose imports resolve as the file's do,
     * with search paths searchPaths, its canonical name, and its file's stem
     * and absolute path *)
    Let ModuleFile = Tuple
        decl: ast.ModuleDecl
        offset: Int
        e: env.T
        sm: location.SourceMap
        searchPaths: Array(String)
        canon: String
        stem: String
        modPath: String
    end

    (* Parses file, prepares its ModuleFile environment as compileModuleFile
     * expects, and runs body on it *)
    let withModuleFile(A::TYPE file: String includePaths: Array(String) buildDir: maybe.T(String)
            programDir: maybe.T(String) res: maybe.T(graph.Resolver) body: All(m: ModuleFile) A): A =
        begin
            let modPath = files.absolute(file)
            if not(system.isFile(modPath)) then diagnostics.fail(:Ok "Module file not found: '" <> modPath <> "'" 0) end
            let sm = location.newSourceMap(files.displayName(modPath) maybe.unwrap(files.readText(modPath)))
            (* Where the driver finds the lines its errors are in *)
            diagnostics.registerSource(sm)
            let e = env.new()
            env.withUnitSource(e location.file(sm) fun(): A
                begin
                    let prog = units.parseUnit(sm)
                    let found =
                        case units.unitDeclaration(prog modPath)
                            when moduleDecl with d then d
                            else
                                diagnostics.internal(:Tuple decl: ast.ModuleDecl offset: Int end "not a module" 0)
                        end
                    let base = files.baseName(modPath)
                    (* A variant's artifacts are its module's *)
                    let stem = if strutil.endsWith(base ".mod.quest") then paths.stripUnitSuffix(base)
                        elsif strutil.endsWith(base ".quest") then stringOp.getSub(base 0 {stringOp.length(base) - 6})
                        else paths.stripUnitSuffix(base)
                        end
                    let resolver = if maybe.isSome(res) then maybe.unwrap(res)
                        else graph.newResolver()
                        end
                    e.units := graph.newGraphWith(resolver)
                    e.currentDir := maybe.some(files.parent(modPath))
                    for i = 0 upto {extent includePaths - 1} do
                        vector.append(e.includePaths includePaths[i])
                    end
                    e.programDir := programDir
                    if maybe.isSome(buildDir) then
                        env.searchFirst(e files.absolute(maybe.unwrap(buildDir)))
                    end
                    let searchPaths = vector.toArray(e.includePaths)
                    let canon =
                        graph.canonicalName(graph.resolveFile(resolver modPath graph.rootsOf(searchPaths programDir)))
                    body(tuple
                        let decl = found.decl
                        let offset = found.offset
                        let e = e
                        let sm = sm
                        let searchPaths = searchPaths
                        let canon = canon
                        let stem = stem
                        let modPath = modPath
                    end)
                end)
        end

    let compileModuleFile(file: String outputDir: maybe.T(String) s: Settings res: maybe.T(graph.Resolver))
            : ModuleCompileResult =
        withModuleFile(file s.includePaths s.buildDir s.programDir res fun(m: ModuleFile):
                ModuleCompileResult
            begin
                m.e.reportInferable := s.reportInferable
                let outDir =
                    if maybe.isSome(s.buildDir) andif maybe.isNone(outputDir) then
                        graph.unitArtifactDir(files.absolute(maybe.unwrap(s.buildDir)) m.canon)
                    elsif maybe.isNone(outputDir) then
                        files.parent(m.modPath)
                    else
                        files.absolute(maybe.unwrap(outputDir))
                    end
                compilingApart(fun(): ModuleCompileResult
                    compileModule(m.decl m.offset m.e outDir m.searchPaths s.compiler s.nogc s.extraFlags m.sm m.stem
                            m.canon m.modPath s.buildDir s.backends))
            end)

    let moduleFileUnit(file: String includePaths: Array(String) buildDir: maybe.T(String) programDir: maybe.T(String)
            res: maybe.T(graph.Resolver)): ModuleUnit =
        withModuleFile(file includePaths buildDir programDir res fun(m: ModuleFile): ModuleUnit
            begin
                let lowered = compilingApart(fun(): Lowered
                    begin
                        let x = elaborate(m.decl m.offset m.e m.canon buildDir)
                        let unit = lower.lowerModuleFile(x.typed m.e maybe.some(m.sm) 0)
                        tuple let x = x let unit = unit end
                    end)
                let x = lowered.x
                let unit = lowered.unit
                (* x.modules has an entry for each name of each import item,
                 * in order *)
                let imports = vector.new(:ModuleImport)
                let var k = 0
                for i = 0 upto {vector.length(m.decl.imports) - 1} do
                    let item = vector.get(m.decl.imports i)
                    for j = 0 upto {vector.length(item.names) - 1} do
                        let r = vector.get(x.modules k)
                        k := k + 1
                        if stringOp.length(r.source) > 0 then
                            vector.append(imports tuple
                                let name = r.name
                                let source = r.source
                                let offset = item.offset
                            end)
                        end
                    end
                end
                tuple
                    let unit = unit
                    let sourceMap = m.sm
                    let imports = vector.toArray(imports)
                end
            end)
end
