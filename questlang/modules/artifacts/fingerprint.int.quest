(* Quest Self-Hosted Compiler: Interface Fingerprints Interface
 *
 * Computes the fingerprint that JIT-compiled code checks against a unit linked
 * into its host (docs/jit.md section 3.3.1): a digest of the unit's interface
 * as recorded in its .qi file, the fingerprints of the interfaces it imports,
 * and the ABI version. Each module unit exports its interface's fingerprint as
 * the C string qh_<unit>, and the JIT compares that against the fingerprint of
 * the interface it compiles against. Comments, layout, declaration order,
 * absolute paths, the producer, and the module's implementation are
 * excluded. *)

interface Fingerprint
import
    questlang/types/env : questlang/types/Env
export
    (* Computes the fingerprint of interface name as imported from e's current
     * directory, updating its .qi file if needed as the loader does. A builtin
     * interface without a .qi file is fingerprinted from the ABI version and
     * its canonical name. *)
    ofInterface(name: String e: env.T): String
end
