(* Quest Self-Hosted Compiler: Interface, Module, and Import Elaboration
 * Implementation *)

module elaboration : Elaboration
import
    questlang/common/location : questlang/common/Location
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/diagbag : questlang/common/DiagBag
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/syntax/tokenizer : questlang/syntax/Tokenizer
    questlang/syntax/parser : questlang/syntax/Parser
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
    questlang/types/subtyping : questlang/types/Subtyping
    questlang/types/env : questlang/types/Env
    questlang/types/kinds : questlang/types/Kinds
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/typechecker/elaborateTypes : questlang/typechecker/ElaborateTypes
    questlang/typechecker/checks : questlang/typechecker/Checks
    questlang/modules/paths : questlang/modules/Paths
    questlang/common/files : questlang/common/Files
    questlang/repr/externals : questlang/repr/Externals
    questlang/modules/units : questlang/modules/Units
    questlang/modules/graph : questlang/modules/Graph
    questlang/modules/abstractTypes : questlang/modules/AbstractTypes
    collections/hashMap : collections/HashMap
    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/iter : util/Iter
    util/hash : util/Hash
    util/maybe : util/Maybe
    util/strutil : util/Strutil
    stringOp = string : StringOp
    raised : Raised
export
    Let Type = model.Type
    Let Scope = symbols.Scope

    Let Hooks = Tuple
        var loadInterface: All(name: String e: env.T) symbols.Scope
        var loadModule: All(name: String expectedInterface: String e: env.T) typedAst.Binding
        var elaborateBinding: All(b: ast.Decl e: env.T loopDepth: Int) maybe.T(typedAst.Binding)
    end

    let hooks: Hooks = tuple
        let var loadInterface = fun(name: String e: env.T): symbols.Scope
            diagnostics.fail("internal: no unit loader is installed" 0)
        let var loadModule = fun(name: String expectedInterface: String e: env.T): typedAst.Binding
            diagnostics.fail("internal: no unit loader is installed" 0)
        let var elaborateBinding = fun(b: ast.Decl e: env.T loopDepth: Int): maybe.T(typedAst.Binding)
            diagnostics.fail("internal: no binding elaborator is installed" 0)
    end

    let loadInterface(name: String e: env.T): Scope = hooks.loadInterface(name e)
    let loadModule(name: String expectedInterface: String e: env.T): typedAst.Binding =
        hooks.loadModule(name expectedInterface e)

    let moduleScope(m: typedAst.Binding): Scope =
        case m.form
            when bindModule with x then x.scope
            else diagnostics.fail("internal: not a typed module" m.offset)
        end

    (* A map's entries, in insertion order *)
    Let Pair(V::TYPE) = Tuple key: String value: V end
    let pairs(V::TYPE m: hashMap.T(String V)): Array(Pair(V)) =
        begin
            let entries = hashMap.entryIter(m)
            let result = vector.new(:Pair(V))
            while iter.more(entries) do
                let e = iter.next(entries)
                vector.append(result tuple let key = e.key let value = e.value end)
            end
            vector.toArray(result)
        end

    let lookupLocal(A::TYPE m: hashMap.T(String A) name: String): maybe.T(A) = hashMap.get(m name)

    let buildRecordTypeFromScope(scope: Scope provenance: maybe.T(String)): Type =
        begin
            let fields = vector.new(:model.RecordField)
            let entries = pairs(scope.values)
            for i = 0 upto {extent entries - 1} do
                let entry = entries[i]
                vector.append(fields tuple
                    let name = entry.key let type = entry.value.type let isVar = entry.value.isVar
                end)
            end
            model.recordType(vector.toArray(fields) provenance)
        end

    let importInterface(ifacePath: String localName: String e: env.T): Scope =
        begin
            let scope = loadInterface(ifacePath e)
            env.registerInterface(e localName scope)
            if not(stringOp.equal(ifacePath localName)) then env.registerInterface(e ifacePath scope) end
            scope
        end

    let stringArray(v: vector.T(String)): Array(String) = vector.toArray(v)

    (* Declares every type and kind of a scope in another *)
    let declareTypesAndKinds(from: Scope into: Scope): Ok =
        begin
            let types = hashMap.valueIter(from.types)
            while iter.more(types) do symbols.declareType(into iter.next(types)) end
            let kinds = hashMap.valueIter(from.kinds)
            while iter.more(kinds) do symbols.declareKind(into iter.next(kinds)) end
        end

    (* body with the current scope s, in an unsound module or not (where
     * 'external' may be used), both restored even if body raises an exception *)
    let inScope(A::TYPE e: env.T s: Scope isUnsound: Bool body: All() A): A =
        begin
            let saved = e.currentScope
            let savedUnsound = e.inUnsoundModule
            e.currentScope := s
            e.inUnsoundModule := isUnsound
            let result = try
                body()
            else with r then
                e.currentScope := saved
                e.inUnsoundModule := savedUnsound
                raised.reraise(:A r)
            end
            e.currentScope := saved
            e.inUnsoundModule := savedUnsound
            result
        end

    (* Refuses an import of an unsound interface by a sound module or by a
     * program, which is implicitly sound (docs/modules.md section 4.4). An
     * interface may import one, since only operations, not types, can
     * compromise soundness. *)
    let requireSoundImport(scope: Scope ifacePath: String importerIsUnsound: Bool): Ok =
        if scope.isUnsound andif not(importerIsUnsound) then
            diagnostics.fail(:Ok "The unsound interface '" <> ifacePath <> "' may be imported only by an unsound module" 0)
        end

    (* ======================================================================
     * Module export scopes
     * ====================================================================== *)

    (* Each abstract type T of the interface (one without a definition)
     * becomes an opaque type, a variable named moduleName.T whose symbol id is
     * the one abstractTypes keeps for canon.T, so that every scope made for
     * the module in the process agrees on it. An abstract type that
     * concreteDefs defines as an external type is that type instead, and is
     * not recorded as abstract. A manifest type keeps its definition, under a
     * fresh symbol. The values' types are rewritten from the interface's
     * abstract types to the opaque ones. *)
    let createModuleExportScope(
        moduleName: String canon: String interfaceScope: Scope e: env.T concreteDefs: maybe.T(hashMap.T(String Type))
    ): Scope =
        begin
            let exportScope = symbols.newScope(maybe.none() "module_export_" <> moduleName)
            exportScope.moduleName := maybe.some(moduleName)
            let subst = model.newSubst()
            let types = pairs(interfaceScope.types)
            for i = 0 upto {extent types - 1} do
                let entry = types[i]
                let typeName = entry.key
                let ifaceSym = entry.value
                if maybe.isNone(ifaceSym.definition) then
                    let exportId = abstractTypes.abstractTypeSymbolId(canon <> "." <> typeName)
                    let extDef = if maybe.isSome(concreteDefs) then
                        let def = lookupLocal(maybe.unwrap(concreteDefs) typeName)
                        if maybe.isSome(def) then
                            case maybe.unwrap(def).form when typeExternal then def else maybe.none(:Type) end
                        else
                            maybe.none(:Type)
                        end
                    else
                        maybe.none(:Type)
                    end
                    symbols.declareType(exportScope symbols.newTypeSymbol(typeName exportId ifaceSym.kind extDef))
                    let opaque = model.typeVariable(moduleName <> "." <> typeName exportId maybe.some(ifaceSym.kind))
                    hashMap.insert(subst ifaceSym.symbolId opaque)
                    if maybe.isNone(extDef) then
                        abstractTypes.registerExportedAbstractType(canon <> "." <> typeName opaque)
                    end
                else
                    symbols.declareType(exportScope
                        symbols.newTypeSymbol(typeName env.freshSymbolId(e) ifaceSym.kind ifaceSym.definition))
                    ok
                end
            end
            let values = pairs(interfaceScope.values)
            for i = 0 upto {extent values - 1} do
                let entry = values[i]
                let v = entry.value
                symbols.declareValue(exportScope symbols.newValueSymbol(entry.key model.substitute(v.type subst) v.isVar
                    v.isOut false 0 0))
            end
            exportScope
        end

    (* extractModuleExternalTypes's results by the text of the module it read,
     * so that a module that each of its importers asks about is parsed once *)
    let externalsByText = hashMap.new(:String :hashMap.T(String Type) stringOp.equal hash.string)

    (* The external types of the lib/ module at modulePath (os/process),
     * as the compiler has them built in (questlang/repr/externals) *)
    let libraryExternalTypes(modulePath: String): hashMap.T(String Type) =
        begin
            let defs = hashMap.new(:String :Type stringOp.equal hash.string)
            for i = 0 upto {extent externals.types - 1} do
                let entry = externals.types[i]
                if stringOp.equal(entry[0] modulePath) then
                    hashMap.insert(defs entry[1] model.externalType(entry[2] entry[3]))
                end
            end
            defs
        end

    (* The external type declarations (Let T = external "C type") of the
     * module in src, by type name, each a type named module.T. A module in
     * lib/ is not read, as the compiler has its external types built in.
     * Another is parsed, if its text mentions external, but not type checked;
     * one that cannot be read or parsed has none, as does no src *)
    let extractModuleExternalTypes(src: maybe.T(String)): hashMap.T(String Type) =
        if maybe.isSome(src) andif maybe.isSome(paths.libModulePath(maybe.unwrap(src))) then
            libraryExternalTypes(maybe.unwrap(paths.libModulePath(maybe.unwrap(src))))
        else
        begin
            let defs = hashMap.new(:String :Type stringOp.equal hash.string)
            let text = if maybe.isSome(src) then files.readText(maybe.unwrap(src)) else maybe.none(:String) end
            let known = if maybe.isSome(text) then
                hashMap.get(externalsByText maybe.unwrap(text))
            else
                maybe.none(:hashMap.T(String Type))
            end
            if maybe.isSome(known) then
                ok
            elsif maybe.isSome(text) andif strutil.contains(maybe.unwrap(text) "external") then
                try
                    let sm = location.newSourceMap(files.baseName(maybe.unwrap(src)) maybe.unwrap(text))
                    let bag = diagbag.new()
                    let prog = parser.parseProgram(tokenizer.tokenizeAll(tokenizer.new(sm bag)) sm bag)
                    if vector.length(prog.form.phrases) is 1 then
                        case vector.get(prog.form.phrases 0).form
                            when phraseModule with m then
                                for i = 0 upto {vector.length(m.modDecl.bindings) - 1} do
                                    case vector.get(m.modDecl.bindings i).form
                                        when declTypeBinding with b then
                                            case b.typeVal.form
                                                when typeExternal with x then
                                                    begin
                                                        hashMap.insert(defs b.name
                                                            model.externalType(m.modDecl.name <> "." <> b.name x.cType))
                                                        ok
                                                    end
                                                else ok
                                            end
                                        else ok
                                    end
                                end
                            else ok
                        end
                    end
                when diagbag.fatalError then
                    ok
                end
            end
            if maybe.isSome(known) then
                maybe.unwrap(known)
            else
                if maybe.isSome(text) then
                    hashMap.insert(externalsByText maybe.unwrap(text) defs)
                end
                defs
            end
        end
        end

    let separatelyCompiledModuleScope(modPath: String interfaceScope: Scope e: env.T): Scope =
        begin
            let resolved = env.resolveModule(e modPath)
            let canon = graph.canonicalName(resolved)
            let u = graph.unit(e.units option moduleUnit of units.UnitKind end canon)
            let existing = if maybe.isSome(u.typedModule) then
                maybe.some(moduleScope(maybe.unwrap(u.typedModule)))
            else
                u.exportScope
            end
            let scope = if maybe.isSome(existing) then
                maybe.unwrap(existing)
            else
                let concrete = extractModuleExternalTypes(resolved.source)
                let s = createModuleExportScope(paths.declaredModuleName(resolved.source modPath) canon interfaceScope e
                    maybe.some(concrete))
                u.exportScope := maybe.some(s)
                s
            end
            env.registerModule(e modPath scope)
            scope
        end

    (* Records the abstract types a module exports with their representations
     * (docs/dynamic.md section 2.3) *)
    let registerAbstractTypes(canon: String exportScope: Scope internalScope: Scope): Ok =
        begin
            let types = pairs(exportScope.types)
            for i = 0 upto {extent types - 1} do
                let entry = types[i]
                let exportSym = entry.value
                let internal = lookupLocal(internalScope.types entry.key)
                if maybe.isNone(exportSym.definition) andif maybe.isSome(internal) andif
                        maybe.isSome(maybe.unwrap(internal).definition) then
                    let typeVar = model.typeVariable(maybe.unwrapOr(exportScope.moduleName "") <> "." <> entry.key
                        exportSym.symbolId maybe.some(exportSym.kind))
                    abstractTypes.registerAbstractTypeRepresentation(canon <> "." <> entry.key typeVar
                        maybe.unwrap(maybe.unwrap(internal).definition))
                end
            end
        end

    (* ======================================================================
     * Interfaces
     * ====================================================================== *)

    (* Elaborates interface decl into a scope of its own, registered in e under
     * decl.name and returned in a bindInterface binding (whose signatures are
     * empty: the scope holds them).
     *
     * 1. Its imports go into an import scope just above the interface's, seen
     *    by its signatures but not exported. The exception is an import of an
     *    interface alone that does not rename it (import :Counter): its types
     *    and kinds are declared in the interface itself, which so inherits
     *    them. An imported module is loaded if its source or object can be
     *    found; otherwise, or if loading it fails with an error that is not
     *    fatal (reported through e.report), it is known by its interface
     *    alone (separatelyCompiledModuleScope).
     * 2. The signatures are elaborated in order into the interface's scope:
     *    an abstract type T::K becomes a type symbol without a definition.
     *    external is refused, as everywhere but in an unsound module
     *    (docs/modules.md §4.4).
     *
     * The bootstrap counterpart is elaborate_interface in
     * bootstrap/python/quest/modules/elaboration.py *)
    let elaborateInterface(decl: ast.InterfaceDecl offset: Int e: env.T): typedAst.Binding =
        begin
            let importScope = symbols.newScope(maybe.some(e.currentScope) "interface_imports_" <> decl.name)
            let interfaceScope = symbols.newScope(maybe.some(importScope) "interface_" <> decl.name)
            interfaceScope.moduleName := maybe.some(decl.name)
            interfaceScope.isUnsound := decl.isUnsound

            (* 1. Imports, into the import scope (available for signatures, not
             *    exported by the interface) *)
            for i = 0 upto {vector.length(decl.imports) - 1} do
                let imp = vector.get(decl.imports i)
                env.atImport(e imp.offset 1 fun(): Ok
                    begin
                        let ifacePath = ast.effectiveInterfacePath(imp)
                        let source = importInterface(ifacePath imp.interfaceName e)
                        if vector.empty(imp.names) then
                            (* An unaliased interface import: interface
                             * inheritance *)
                            let isAlias = maybe.isSome(imp.interfacePath) andif
                                not(stringOp.equal(imp.interfaceName ifacePath))
                            declareTypesAndKinds(source if isAlias then importScope else interfaceScope end)
                        else
                            let modPaths = ast.effectiveModulePaths(imp)
                            for j = 0 upto {vector.length(imp.names) - 1} do
                                let name = vector.get(imp.names j)
                                let modPath = vector.get(modPaths j)
                                let typeSym = lookupLocal(source.types name)
                                let valueSym = lookupLocal(source.values name)
                                let kindSym = lookupLocal(source.kinds name)
                                if maybe.isSome(typeSym) then
                                    symbols.declareType(interfaceScope maybe.unwrap(typeSym))
                                    ok
                                elsif maybe.isSome(valueSym) then
                                    symbols.declareValue(interfaceScope maybe.unwrap(valueSym))
                                    ok
                                elsif maybe.isSome(kindSym) then
                                    symbols.declareKind(interfaceScope maybe.unwrap(kindSym))
                                    ok
                                else
                                    let available = maybe.isSome(graph.typedModule(e.units modPath)) orif
                                        graph.isPrecompiled(e.units modPath) orif
                                        maybe.isSome(env.resolveModule(e modPath).source) orif
                                        maybe.isSome(paths.resolveObjectFile(modPath e.currentDir
                                            vector.toArray(e.includePaths)))
                                    let var modScope = maybe.none(:Scope)
                                    if available then
                                        try
                                            modScope := maybe.some(moduleScope(loadModule(modPath ifacePath e)))
                                        when diagnostics.compilerError with err then
                                            if err.isFatal then diagnostics.raiseError(:Ok err) end
                                            if maybe.isSome(e.report) andif
                                                    not(err.silent) then
                                                maybe.unwrap(e.report)(err)
                                            end
                                        end
                                    end
                                    let registered = if maybe.isSome(modScope) then
                                        maybe.unwrap(modScope)
                                    else
                                        separatelyCompiledModuleScope(modPath source e)
                                    end
                                    env.registerModule(e name registered)
                                    if not(stringOp.equal(modPath name)) then env.registerModule(e modPath registered) end
                                    symbols.declareValue(importScope symbols.valueSymbol(name
                                        buildRecordTypeFromScope(registered maybe.some(name))))
                                    ok
                                end
                            end
                        end
                    end)
            end

            (* 2. The signatures, in the interface's scope, where 'external' is
             *    refused, as it is everywhere but in an unsound module. A name
             *    may be declared once in each of the interface's namespaces
             *    (values, types, kinds); a module could not implement both of
             *    two members of one name, and C could not declare both *)
            let declaredValues = hashSet.new(:String stringOp.equal hash.string)
            let declaredTypes = hashSet.new(:String stringOp.equal hash.string)
            let declaredKinds = hashSet.new(:String stringOp.equal hash.string)
            let declareOnce(declared: hashSet.T(String) what: String name: String at: Int): Ok =
                if hashSet.contains(declared name) then
                    diagnostics.fail(:Ok
                        what <> "'" <> name <> "' is declared more than once in interface '" <> decl.name <> "'" at)
                else
                    begin hashSet.insert(declared name) ok end
                end
            inScope(e interfaceScope false fun(): Ok
                for i = 0 upto {vector.length(decl.signatures) - 1} do
                    case vector.get(decl.signatures i)
                        when sigType with x then
                            begin
                                declareOnce(declaredTypes "Type " x.val.name x.val.offset)
                                let bound = elaborateTypes.elaborateKind(x.val.bound e)
                                symbols.declareType(interfaceScope
                                    symbols.newTypeSymbol(x.val.name env.freshSymbolId(e) bound maybe.none(:Type)))
                                ok
                            end
                        when sigTypeBinding with x then
                            begin
                                declareOnce(declaredTypes "Type " x.val.name x.val.offset)
                                symbols.declareType(interfaceScope elaborateTypes.elaborateTypeBinding(x.val e))
                                ok
                            end
                        when sigTypeBindingGroup with x then
                            begin
                                for j = 0 upto {vector.length(x.val) - 1} do
                                    let member = vector.get(x.val j)
                                    declareOnce(declaredTypes "Type " member.name member.offset)
                                end
                                let syms = elaborateTypes.elaborateTypeBindingGroup(x.val e)
                                for j = 0 upto {extent syms - 1} do symbols.declareType(interfaceScope syms[j]) end
                            end
                        when sigValue with x then
                            if maybe.isSome(x.val.name) andif
                                    not(stringOp.equal(maybe.unwrap(x.val.name) "")) then
                                declareOnce(declaredValues "" maybe.unwrap(x.val.name) x.val.offset)
                                checks.checkBinder(maybe.unwrap(x.val.name) x.val.offset)
                                let t = elaborateTypes.elaborateType(maybe.unwrap(x.val.typeSig) e)
                                let isVar = case x.val.mode when modeVar then true else false end
                                let isOut = case x.val.mode when modeOut then true else false end
                                symbols.declareValue(interfaceScope
                                    symbols.newValueSymbol(maybe.unwrap(x.val.name) t isVar isOut false 0 0))
                                ok
                            end
                        when sigKindBinding with x then
                            begin
                                declareOnce(declaredKinds "Kind " x.val.name x.val.offset)
                                symbols.declareKind(interfaceScope
                                    elaborateTypes.elaborateKindBinding(x.val.name x.val.kindVal e))
                                ok
                            end
                    end
                end)

            env.registerInterface(e decl.name interfaceScope)
            typedAst.binding(offset option bindInterface of typedAst.BindingForm with
                let name = decl.name let signatures = array of :typedAst.Binding end let scope = interfaceScope
            end)
        end

    (* ======================================================================
     * Modules
     * ====================================================================== *)

    let typeOf(sym: symbols.TypeSymbol): Type =
        if maybe.isSome(sym.definition) then
            maybe.unwrap(sym.definition)
        else
            model.typeVariable(sym.name sym.symbolId maybe.some(sym.kind))
        end

    let importItem(
        imp: ast.ImportItem canonical: maybe.T(Array(String)) symbolIds: maybe.T(Array(maybe.T(Int)))
        modulePaths: maybe.T(Array(String))
    ): typedAst.ImportItem =
        tuple
            let offset = imp.offset let names = stringArray(imp.names) let interfaceName = imp.interfaceName
            let modulePaths = modulePaths let interfacePath = imp.interfacePath
            let canonicalModulePaths = canonical let symbolIds = symbolIds
        end

    let canonicalPaths(imp: ast.ImportItem e: env.T): Array(String) =
        begin
            let result = vector.new(:String)
            let modPaths = ast.effectiveModulePaths(imp)
            for i = 0 upto {vector.length(modPaths) - 1} do
                vector.append(result graph.canonicalName(env.resolveModule(e vector.get(modPaths i))))
            end
            vector.toArray(result)
        end

    let maybePaths(paths0: maybe.T(vector.T(String))): maybe.T(Array(String)) =
        if maybe.isSome(paths0) then
            maybe.some(stringArray(maybe.unwrap(paths0)))
        else
            maybe.none()
        end

    (* 3. A module's conformance to its interface *)
    let checkConformance(decl: ast.ModuleDecl offset: Int targetInterface: Scope internalScope: Scope e: env.T): Ok =
        begin
            let lookup = env.lookupOf(e)
            let subst = model.newSubst()
            let types = pairs(targetInterface.types)
            for i = 0 upto {extent types - 1} do
                let entry = types[i]
                let typeName = entry.key
                let ifaceSym = entry.value
                let found = lookupLocal(internalScope.types typeName)
                if maybe.isNone(found) then
                    diagnostics.fail(:Ok "Module '" <> decl.name <> "' does not implement required type '" <> typeName <>
                        "' from interface '" <> decl.interfaceName <> "'" offset)
                end
                let modSym = maybe.unwrap(found)
                if maybe.isSome(ifaceSym.definition) then
                    if not(subtyping.isTypeEqual(typeOf(modSym) maybe.unwrap(ifaceSym.definition) lookup)) then
                        diagnostics.fail(:Ok "Module '" <> decl.name <> "' defines manifest type '" <> typeName <>
                            "' incompatibly with interface '" <> decl.interfaceName <> "'" offset)
                    end
                end
                (* A defined type has the interface's kind if it is a member of
                 * it, whatever kind it was declared with; an undefined one must
                 * have been declared with a subkind *)
                let satisfies = if maybe.isSome(modSym.definition) then
                    try
                        kinds.checkKind(maybe.unwrap(modSym.definition) ifaceSym.kind maybe.some(e))
                        true
                    when diagnostics.compilerError with err then
                        if err.isFatal orif err.silent then diagnostics.raiseError(:Ok err) end
                        false
                    end
                else
                    subtyping.isSubkind(modSym.kind ifaceSym.kind lookup)
                end
                if not(satisfies) then
                    diagnostics.fail(:Ok "Type '" <> typeName <> "' in module '" <> decl.name <>
                        "' does not satisfy kind bound from interface '" <> decl.interfaceName <> "'" offset)
                end
                if maybe.isNone(ifaceSym.definition) then
                    hashMap.insert(subst ifaceSym.symbolId typeOf(modSym))
                end
            end
            let values = pairs(targetInterface.values)
            for i = 0 upto {extent values - 1} do
                let entry = values[i]
                let found = lookupLocal(internalScope.values entry.key)
                if maybe.isNone(found) then
                    diagnostics.fail(:Ok "Module '" <> decl.name <> "' does not implement required value '" <> entry.key <>
                        "' from interface '" <> decl.interfaceName <> "'" offset)
                end
                let modSym = maybe.unwrap(found)
                let expected = model.substitute(entry.value.type subst)
                if not(subtyping.isSubtype(modSym.type expected lookup)) then
                    diagnostics.fail(:Ok "Value '" <> entry.key <> "' in module '" <> decl.name <> "' has type '" <>
                        model.show(modSym.type) <> "', which is not a subtype of interface signature '" <>
                        model.show(expected) <> "'" offset)
                end
            end
        end

    (* Elaborates a module declaration, module m: I import ... bindings end,
     * checks it against its interface I, and declares m.
     *
     * A module is a set of bindings that the code outside sees only through
     * the module's interface. Its elaboration has four steps, numbered in the
     * code:
     *
     * 1. A module sees only what it imports. Its scope's parent is
     *    e.baseScope, which holds the built-in types and operators, rather
     *    than the scope it is declared in or the standard library's modules
     *    (Cardelli section 11.3), and its imports are declared into that
     *    scope.
     * 2. Its bindings are elaborated there, as any bindings are, by
     *    hooks.elaborateBinding (the type checker's, which typecheck
     *    registers, since this module is below the checker).
     * 3. The module must conform to its interface (checkConformance). It must
     *    define every type the interface names: a type the interface defines
     *    (T = ...) the same way, and a type the interface leaves abstract with
     *    a kind that fits its bound. It must define every value, with a type
     *    that is a subtype of the interface's, in which the interface's
     *    abstract types are replaced by the module's definitions, since inside
     *    the module they are known.
     * 4. What the outside sees is built from the interface, not from the
     *    module (createModuleExportScope). The export scope holds the
     *    interface's values and types, with each abstract type replaced by a
     *    new opaque type, m.T, whose definition is withheld (except for an
     *    external C type, which code generation needs). This is where
     *    information hiding happens: code outside cannot tell m.T from any
     *    other type, so it can use m.T's values only through m's operations.
     *    The opaque type's symbol is derived from m's canonical name (its name
     *    however an importer spells its path), so it is the same type in every
     *    unit that imports m, and the export scope is kept with m's unit
     *    (exportScope), so that they all share it.
     *
     * Finally m is declared as a value, a record of its exported values, from
     * which m.f selects. *)
    (* Declares localName in scope as the module modPath, which implements the
     * interface ifacePath (whose scope is ifaceScope), and returns its symbol,
     * of the module's record type. Its source is loaded first, unless the
     * unit is compiled to C, where the module is typed through its interface,
     * or it is typed already. It is registered by its path and its local
     * name *)
    let bindImportedModule(localName: String modPath: String ifacePath: String ifaceScope: Scope scope: Scope e: env.T):
        symbols.ValueSymbol =
        begin
            if not(e.compilingC) andif maybe.isNone(graph.typedModule(e.units modPath)) then
                loadModule(modPath ifacePath e)
                ok
            end
            let modScope = separatelyCompiledModuleScope(modPath ifaceScope e)
            let modType = buildRecordTypeFromScope(modScope maybe.some(localName))
            env.registerModule(e modPath modScope)
            if not(stringOp.equal(localName modPath)) then env.registerModule(e localName modScope) end
            let sym = symbols.valueSymbol(localName modType)
            symbols.declareValue(scope sym)
            sym
        end

    let elaborateModule(decl: ast.ModuleDecl offset: Int e: env.T): typedAst.Binding =
        begin
            let found = env.lookupInterface(e decl.interfaceName)
            let targetInterface = if maybe.isSome(found) then
                maybe.unwrap(found)
            else
                loadInterface(decl.interfaceName e)
            end
            if targetInterface.isUnsound andif not(decl.isUnsound) then
                diagnostics.fail(:Ok "The unsound interface '" <> decl.interfaceName <>
                    "' may be implemented only by an unsound module" offset)
            end
            let internalScope = symbols.newScope(maybe.some(e.baseScope) "module_internal_" <> decl.name)

            (* 1. Imports, into the module's internal scope *)
            let importSymbols = vector.new(:vector.T(maybe.T(symbols.ValueSymbol)))
            for i = 0 upto {vector.length(decl.imports) - 1} do
                let imp = vector.get(decl.imports i)
                let syms = vector.new(:maybe.T(symbols.ValueSymbol))
                vector.append(importSymbols syms)
                env.atImport(e imp.offset 1 fun(): Ok
                    begin
                        let ifacePath = ast.effectiveInterfacePath(imp)
                        let source = importInterface(ifacePath imp.interfaceName e)
                        requireSoundImport(source ifacePath decl.isUnsound)
                        if vector.empty(imp.names) then
                            declareTypesAndKinds(source internalScope)
                        else
                            let modPaths = ast.effectiveModulePaths(imp)
                            for j = 0 upto {vector.length(imp.names) - 1} do
                                let localName = vector.get(imp.names j)
                                let modPath = vector.get(modPaths j)
                                vector.append(syms maybe.none(:symbols.ValueSymbol))
                                let typeSym = lookupLocal(source.types localName)
                                let valueSym = lookupLocal(source.values localName)
                                let kindSym = lookupLocal(source.kinds localName)
                                let same = stringOp.equal(localName modPath)
                                if same andif maybe.isSome(typeSym) then
                                    symbols.declareType(internalScope maybe.unwrap(typeSym))
                                    ok
                                elsif same andif maybe.isSome(valueSym) then
                                    symbols.declareValue(internalScope maybe.unwrap(valueSym))
                                    ok
                                elsif same andif maybe.isSome(kindSym) then
                                    symbols.declareKind(internalScope maybe.unwrap(kindSym))
                                    ok
                                else
                                    let sym = bindImportedModule(localName modPath ifacePath source internalScope e)
                                    vector.set(syms {vector.length(syms) - 1}
                                        maybe.some(sym))
                                end
                            end
                        end
                    end)
            end

            (* 2. The module's bindings, each a recovery point *)
            let typedBindings = vector.new(:typedAst.Binding)
            if not(vector.empty(decl.imports)) then
                let items = vector.new(:typedAst.ImportItem)
                for i = 0 upto {vector.length(decl.imports) - 1} do
                    let imp = vector.get(decl.imports i)
                    let syms = vector.get(importSymbols i)
                    let ids = vector.new(:maybe.T(Int))
                    for j = 0 upto {vector.length(syms) - 1} do
                        let s = vector.get(syms j)
                        vector.append(ids
                            if maybe.isSome(s) then
                                maybe.some(maybe.unwrap(s).symbolId)
                            else
                                maybe.none(:Int)
                            end)
                    end
                    vector.append(items importItem(imp maybe.some(canonicalPaths(imp e))
                        maybe.some(vector.toArray(ids)) maybePaths(imp.modulePaths)))
                end
                vector.append(typedBindings typedAst.binding(offset option bindImport of typedAst.BindingForm with
                    let items = vector.toArray(items)
                end))
            end
            inScope(e internalScope decl.isUnsound fun(): Ok
                begin
                    let state = tuple let var failed = false end
                    for i = 0 upto {vector.length(decl.bindings) - 1} do
                        let typed = hooks.elaborateBinding(vector.get(decl.bindings i) e 0)
                        if maybe.isSome(typed) then
                            vector.append(typedBindings maybe.unwrap(typed))
                        else
                            state.failed := true
                        end
                    end
                    (* A member that failed was reported: the module fails
                     * without another error *)
                    if state.failed then diagnostics.raiseError(:Ok diagnostics.silentError) end
                    checkConformance(decl offset targetInterface internalScope e)
                end)

            (* 4. The exported scope, opaque for the interface's abstract
             *    types *)
            let canon = graph.canonicalName(env.resolveModule(e decl.name))
            let u = graph.unit(e.units option moduleUnit of units.UnitKind end canon)
            let exportScope = if maybe.isNone(u.exportScope) then
                let concrete = hashMap.new(:String :Type stringOp.equal hash.string)
                let types = pairs(internalScope.types)
                for i = 0 upto {extent types - 1} do
                    let entry = types[i]
                    if maybe.isSome(entry.value.definition) then
                        (* An external type is named as
                         * extractModuleExternalTypes names it, as the
                         * bootstrap's runs, which type modules with fresh
                         * artifacts through their interfaces, have it
                         * (module.T); in a unit file's compile, as its binding
                         * names it, as the bootstrap's elaborating the module's
                         * source does *)
                        let def = maybe.unwrap(entry.value.definition)
                        let named = case def.form
                            when typeExternal with x then
                                if not(e.compilingUnit) then
                                    model.externalType(decl.name <> "." <> entry.key x.cType) else def end
                            else def
                        end
                        hashMap.insert(concrete entry.key named)
                    end
                end
                let s = createModuleExportScope(decl.name canon targetInterface e maybe.some(concrete))
                u.exportScope := maybe.some(s)
                s
            else
                let s = maybe.unwrap(u.exportScope)
                let types = pairs(internalScope.types)
                for i = 0 upto {extent types - 1} do
                    let entry = types[i]
                    let exported = lookupLocal(s.types entry.key)
                    if maybe.isSome(exported) andif
                            maybe.isNone(maybe.unwrap(exported).definition) andif
                            maybe.isSome(entry.value.definition) then
                        case maybe.unwrap(entry.value.definition).form
                            when typeExternal then
                                symbols.defineType(maybe.unwrap(exported) maybe.unwrap(entry.value.definition))
                            else ok
                        end
                    end
                end
                s
            end
            registerAbstractTypes(canon exportScope internalScope)
            env.registerModule(e decl.name exportScope)

            let moduleSymbol = symbols.valueSymbol(decl.name buildRecordTypeFromScope(exportScope maybe.some(decl.name)))
            symbols.declareValue(e.currentScope moduleSymbol)
            typedAst.binding(offset option bindModule of typedAst.BindingForm with
                let name = decl.name let interfaceName = decl.interfaceName
                let bindings = vector.toArray(typedBindings) let scope = exportScope
                let isPrecompiled = false
                let symbolId = maybe.some(moduleSymbol.symbolId)
            end)
        end

    (* ======================================================================
     * Imports
     * ====================================================================== *)

    (* Elaborates a program's import phrase into e's current scope. Each
     * item's interface is loaded and bound to its local name; an unsound one
     * is refused, as the top level is sound (docs/modules.md §4.4). An
     * interface imported alone (import :Counter) declares its types and kinds
     * in the current scope. Each module is bound to its local name as a
     * record value whose type comes from its interface, through an export
     * scope that has the opaque types every importer shares
     * (separatelyCompiledModuleScope). Unless compiling to C, where the
     * module is built apart, its source is first loaded and elaborated, once
     * (loadModule), for the program to include its code. The result, a
     * bindImport, records each item's canonical paths and the symbol ids of
     * the values it declared *)
    let elaborateImport(phrase: ast.ImportPhrase offset: Int e: env.T): typedAst.Binding =
        begin
            let items = vector.new(:typedAst.ImportItem)
            for i = 0 upto {vector.length(phrase.items) - 1} do
                let item = vector.get(phrase.items i)
                env.atImport(e item.offset 1 fun(): Ok
                    begin
                        let ifacePath = ast.effectiveInterfacePath(item)
                        let ifaceScope = importInterface(ifacePath item.interfaceName e)
                        requireSoundImport(ifaceScope ifacePath false)
                        if vector.empty(item.names) then
                            (* import : Interface binds the interface's types
                             * and kinds *)
                            declareTypesAndKinds(ifaceScope e.currentScope)
                            vector.append(items importItem(item maybe.none(:Array(String))
                                maybe.none(:Array(maybe.T(Int))) maybe.some(array of :String end)))
                        else
                            let ids = vector.new(:maybe.T(Int))
                            let modPaths = ast.effectiveModulePaths(item)
                            for j = 0 upto {vector.length(item.names) - 1} do
                                let localName = vector.get(item.names j)
                                let modPath = vector.get(modPaths j)
                                let sym = bindImportedModule(localName modPath ifacePath ifaceScope e.currentScope e)
                                vector.append(ids maybe.some(sym.symbolId))
                            end
                            vector.append(items importItem(item
                                maybe.some(canonicalPaths(item e))
                                maybe.some(vector.toArray(ids)) maybePaths(item.modulePaths)))
                        end
                    end)
            end
            typedAst.binding(offset option bindImport of typedAst.BindingForm with
                let items = vector.toArray(items)
            end)
        end
end
