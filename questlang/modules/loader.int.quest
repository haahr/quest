(* Quest Self-Hosted Compiler: Unit Loader Interface
 *
 * Counterpart to bootstrap/python/quest/modules/loader.py. This unit loads
 * interfaces and modules from their files on the search path (or an interface
 * from a fresh .qi file), checks that each file contains one declaration
 * matching its name, detects import cycles, and shares loaded units among
 * importers by canonical name. install registers the loader with elaboration,
 * which calls it to load imported units. *)

interface Loader
import
    util/maybe : util/Maybe

    questlang/modules/resolution : questlang/modules/Resolution
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
    questlang/types/symbols : questlang/types/Symbols
export
    (* Returns the scope of interface name as imported from e's current
     * directory, reusing an already loaded scope or loading from a .qi file or
     * source (see loader.mod for the exact search order). Raises CompilerError
     * (diagnostics.fail) if no file is found, if the file declares another
     * name, or on a cycle of interface imports, and propagates any elaboration
     * error. *)
    loadInterface(name: String e: env.T): symbols.Scope
    (* Loads and returns the typed module name, which the importer expects to
     * implement expectedInterface, elaborating its source once per canonical
     * name and sharing the result with later importers. A precompiled module
     * (found only as a .o file, or a hierarchical module when compiling to C
     * whose object the build produces separately) receives a codeless binding
     * typed against its interface. Raises CompilerError if neither a source
     * nor an object is found, on a cycle of module imports, or if the file
     * does not hold a single module declaration whose name matches the file
     * and whose header names expectedInterface (or its last segment, as AST
     * for questlang/syntax/AST), and propagates any elaboration error. *)
    loadModule(name: String expectedInterface: String e: env.T): typedAst.Binding
    (* Sets elaboration.hooks to loadInterface and loadModule, which
     * elaboration cannot import, since this module imports it *)
    install(): Ok
    (* Where an interface's artifacts are written and read: the build
     * directory; when compiling C without one, beside its source; else none,
     * and the interface is elaborated from source *)
    resolvedArtifactRoot(e: env.T resolved: resolution.Resolved): maybe.T(String)
end
