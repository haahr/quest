(* Quest Self-Hosted Compiler: Unit Loader Interface
 *
 * bootstrap/python/quest/modules/loader.py, from source (artifacts are
 * Milestone 5's): loading interfaces and modules from their files on the search
 * path, checking that a file holds one declaration that matches its name,
 * detecting cycles, and sharing loaded units among importers by canonical name.
 * install registers the loader with elaboration, which calls it to load the
 * units imports name. *)

interface Loader
import
    questlang/types/symbols : questlang/types/Symbols
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/modules/graph : questlang/modules/Graph
    util/maybe : util/Maybe
export
    (* Loads, validates, and elaborates interface name, as imported from e's
     * current directory *)
    loadInterface(name: String e: env.T): symbols.Scope
    (* Loads, validates, and elaborates module name, which implements
     * expectedInterface *)
    loadModule(name: String expectedInterface: String e: env.T): typedAst.Binding
    install(): Ok
    (* Where an interface's artifacts are written and read: the build
     * directory; when compiling C without one, beside its source; else none,
     * and the interface is elaborated from source *)
    resolvedArtifactRoot(e: env.T resolved: graph.Resolved): maybe.T(String)
end
