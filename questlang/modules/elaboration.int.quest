(* Quest Self-Hosted Compiler: Interface, Module, and Import Elaboration
 * Interface
 *
 * bootstrap/python/quest/modules/elaboration.py: Cardelli's module system.
 * Interfaces declare type formals, manifest types, and value signatures; a
 * module is checked against its interface (type equality, subkinding,
 * subtyping), and its abstract types are hidden behind opaque type variables;
 * imports bind interfaces and modules.
 *
 * The loader and the checker are above this module: they load and check units
 * by elaborating them here, and it calls back to them through hooks, which they
 * fill (loader.install, typecheck.newChecker). A module's member is a recovery
 * point (docs/diagnostics.md section 4.5): the hook elaborates it, or reports
 * its error and gives none. *)

interface Elaboration
import
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    collections/hashMap : collections/HashMap
    util/maybe : util/Maybe
export
    Def Hooks = Tuple
        var loadInterface: All(name: String e: env.T) symbols.Scope
        var loadModule: All(name: String expectedInterface: String e: env.T) typedAst.Binding
        var elaborateBinding: All(b: ast.Decl e: env.T loopDepth: Int) maybe.T(typedAst.Binding)
    end
    hooks: Hooks

    loadInterface(name: String e: env.T): symbols.Scope
    loadModule(name: String expectedInterface: String e: env.T): typedAst.Binding
    (* A typed module's export scope *)
    moduleScope(m: typedAst.Binding): symbols.Scope

    (* The record type of the values a module or interface scope exposes *)
    buildRecordTypeFromScope(scope: symbols.Scope provenance: maybe.T(String)): model.Type
    (* The interface an import names, bound to localName (and the path) *)
    importInterface(ifacePath: String localName: String e: env.T): symbols.Scope

    elaborateInterface(decl: ast.InterfaceDecl offset: Int e: env.T): typedAst.Binding
    (* The export scope of a module known only through its interface: its own
     * opaque copies of the interface's abstract types *)
    separatelyCompiledModuleScope(modPath: String interfaceScope: symbols.Scope e: env.T): symbols.Scope
    (* The export scope of a module conforming to an interface; canon is its
     * canonical name *)
    createModuleExportScope(
        moduleName: String canon: String interfaceScope: symbols.Scope e: env.T
        concreteDefs: maybe.T(hashMap.T(String model.Type))
    ): symbols.Scope
    elaborateModule(decl: ast.ModuleDecl offset: Int e: env.T): typedAst.Binding
    elaborateImport(phrase: ast.ImportPhrase offset: Int e: env.T): typedAst.Binding
end
