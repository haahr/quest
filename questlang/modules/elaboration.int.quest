(* Quest Self-Hosted Compiler: Interface, Module, and Import Elaboration
 * Interface
 *
 * Counterpart to bootstrap/python/quest/modules/elaboration.py. This unit
 * implements Cardelli's module system: interfaces declare type formals,
 * manifest types, and value signatures; a module is checked against its
 * interface (type equality, subkinding, subtyping), and its abstract types are
 * hidden behind opaque type variables; imports bind interfaces and modules.
 *
 * The loader and the type checker sit above this module: they load and check
 * units by calling elaboration, and elaboration calls back to them through
 * hooks that they install (loader.install, typecheck.newChecker). Each module
 * member is an error recovery point (docs/diagnostics.md section 4.5): the
 * hook either returns the elaborated binding or reports its error and returns
 * none. *)

interface Elaboration
import
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    collections/hashMap : collections/HashMap
    util/maybe : util/Maybe
export
    (* The loader's and the type checker's functions, which elaboration calls
     * but cannot import, as they import it; loader.install and
     * typecheck.newChecker set them *)
    Def Hooks = Tuple
        var loadInterface: All(name: String e: env.T) symbols.Scope
        var loadModule: All(name: String expectedInterface: String e: env.T) typedAst.Binding
        var elaborateBinding: All(b: ast.Decl e: env.T loopDepth: Int) maybe.T(typedAst.Binding)
    end
    hooks: Hooks

    loadInterface(name: String e: env.T): symbols.Scope
    loadModule(name: String expectedInterface: String e: env.T): typedAst.Binding
    (* A typed module's export scope *)
    moduleScope(m: typedAst.Binding): symbols.Scope

    (* The record type of the values a module or interface scope exposes *)
    buildRecordTypeFromScope(scope: symbols.Scope provenance: maybe.T(String)): model.Type
    (* The interface an import names, bound to localName (and the path) *)
    importInterface(ifacePath: String localName: String e: env.T): symbols.Scope

    (* The interface decl, elaborated into its scope (a bindInterface) and
     * registered in e under its name *)
    elaborateInterface(decl: ast.InterfaceDecl offset: Int e: env.T): typedAst.Binding
    (* The export scope of a module known only through its interface: its own
     * opaque copies of the interface's abstract types *)
    separatelyCompiledModuleScope(modPath: String interfaceScope: symbols.Scope e: env.T): symbols.Scope
    (* The export scope of a module conforming to an interface; canon is its
     * canonical name *)
    createModuleExportScope(
        moduleName: String canon: String interfaceScope: symbols.Scope e: env.T
        concreteDefs: maybe.T(hashMap.T(String model.Type))
    ): symbols.Scope
    (* The external types (Let T = external "...") a module's source file
     * declares, by name, if src is one *)
    extractModuleExternalTypes(src: maybe.T(String)): hashMap.T(String model.Type)
    (* Elaborates decl in a scope that sees only its imports, checks it against
     * its interface, and declares it in e's current scope as a record of its
     * exports whose abstract types are opaque (returning a bindModule;
     * elaboration.mod explains the four steps). Raises CompilerError if the
     * module does not conform; members that fail are reported as they fail and
     * then trigger a silent CompilerError. *)
    elaborateModule(decl: ast.ModuleDecl offset: Int e: env.T): typedAst.Binding
    (* A program's import phrase, its interfaces and modules bound in e's
     * current scope under their local names (a bindImport) *)
    elaborateImport(phrase: ast.ImportPhrase offset: Int e: env.T): typedAst.Binding

    (* Declares every type and kind of a scope in another *)
    declareTypesAndKinds(from: symbols.Scope into: symbols.Scope): Ok
end
