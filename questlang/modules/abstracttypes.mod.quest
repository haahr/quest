(* Quest Self-Hosted Compiler: Modules' Abstract Types Implementation *)

module abstractTypes : AbstractTypes
import
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    util/sort : util/Sort
    util/strutil : util/Strutil
    stringOp = string : StringOp
export
    Let Instance = Tuple args: Array(model.Type) rep: model.Type end
    Let ModuleAbstractType = Tuple
        globalName: String
        typeVar: model.Type
        linked: Bool
        var rep: maybe.T(model.Type)
        instances: vector.T(Instance)
    end

    let intEqual(a: Int b: Int): Bool = a is b
    let symbolIds = hashMap.new(:String :Int stringOp.equal hash.string)
    let abstractSymbolIds = hashMap.new(:Int :Bool intEqual hash.int)
    let globalNames = hashMap.new(:Int :String intEqual hash.int)
    let bySymbol = hashMap.new(:Int :ModuleAbstractType intEqual hash.int)
    let byName = hashMap.new(:String :ModuleAbstractType stringOp.equal hash.string)

    let abstractTypeSymbolId(globalName: String): Int =
        begin
            let found = hashMap.get(symbolIds globalName)
            if maybe.isSome(found) then
                maybe.unwrap(found)
            else
                let symbolId = symbols.allocateSymbolId()
                hashMap.insert(symbolIds globalName symbolId)
                hashMap.insert(abstractSymbolIds symbolId true)
                hashMap.insert(globalNames symbolId globalName)
                symbolId
            end
        end

    let isAbstractTypeSymbol(symbolId: Int): Bool = hashMap.contains(abstractSymbolIds symbolId)

    let abstractTypeGlobalName(symbolId: Int): maybe.T(String) = hashMap.get(globalNames symbolId)

    let symbolOf(typeVar: model.Type): Int = case typeVar.form when typeVariable with v then v.symbolId else 0 end

    (* Returns the entry for globalName as typeVar (linked or unlinked),
     * reusing the existing entry if it has the same opaque type and linkage or
     * creating a new one that replaces it in byName. Either way, the entry is
     * also recorded under typeVar's symbol id in bySymbol so an older opaque
     * type's id still finds its own entry. *)
    let recordType(globalName: String typeVar: model.Type linked: Bool): ModuleAbstractType =
        begin
            let found = hashMap.get(byName globalName)
            let entry = if maybe.isSome(found) andif
                    model.same(maybe.unwrap(found).typeVar typeVar) andif
                    {maybe.unwrap(found).linked is linked} then
                maybe.unwrap(found)
            else
                (* Elaborating the module's interface again (for another
                 * importer) keeps the representation its source gave the same
                 * symbol *)
                let kept = if maybe.isSome(found)
                    andif {maybe.unwrap(found).linked is linked}
                    andif {symbolOf(maybe.unwrap(found).typeVar) is symbolOf(typeVar)} then
                    maybe.unwrap(found).rep
                else
                    maybe.none(:model.Type)
                end
                let e: ModuleAbstractType = tuple
                    let globalName = globalName let typeVar = typeVar let linked = linked
                    let var rep = kept
                    let instances = vector.new()
                end
                hashMap.insert(byName globalName e)
                e
            end
            let symbolId = symbolOf(typeVar)
            hashMap.insert(bySymbol symbolId entry)
            entry
        end

    let registerExportedAbstractType(globalName: String typeVar: model.Type): Ok =
        begin recordType(globalName typeVar true) ok end

    let represented = tuple let var count = 0 let var apart = false end
    let apartNames = hashMap.new(:String :Bool stringOp.equal hash.string)
    let setRegisteringApart(on: Bool): Ok = represented.apart := on
    let registeringApart(): Bool = represented.apart

    let registerAbstractTypeRepresentation(globalName: String typeVar: model.Type rep: model.Type): Ok =
        begin
            represented.count := represented.count + 1
            if represented.apart then begin hashMap.insert(apartNames globalName true) ok end end
            recordType(globalName typeVar true).rep := maybe.some(rep)
        end

    let representationCount(): Int = represented.count

    (* Only a POWER bound (A <: T, meaning a subtype upper bound) counts.
     * Outside its module a bounded type is seen as its bound, whose memory
     * layout (field and case numbering) may differ from its representation's,
     * so it is never laid out as its representation. *)
    let unbounded(e: ModuleAbstractType): Bool =
        case e.typeVar.form
            when typeVariable with v then
                not(maybe.isSome(v.bound) andif model.isPower(maybe.unwrap(v.bound)))
            else true
        end

    let representations(): model.Subst =
        begin
            let s = model.newSubst()
            hashMap.forEach(bySymbol fun(k: Int e: ModuleAbstractType): Ok
                if maybe.isSome(e.rep) andif unbounded(e)
                    andif not(hashMap.contains(apartNames e.globalName)) then
                    begin hashMap.insert(s k maybe.unwrap(e.rep)) ok end
                end)
            s
        end

    let registerUnlinkedAbstractType(globalName: String typeVar: model.Type): ModuleAbstractType =
        recordType(globalName typeVar false)

    let abstractTypeBySymbol(symbolId: Int): maybe.T(ModuleAbstractType) =
        hashMap.get(bySymbol symbolId)
    let abstractTypeByName(globalName: String): maybe.T(ModuleAbstractType) =
        hashMap.get(byName globalName)

    let moduleAbstractTypes(canon: String): Array(ModuleAbstractType) =
        begin
            let prefix = canon <> "."
            let found = vector.new(:ModuleAbstractType)
            hashMap.forEach(byName fun(name: String e: ModuleAbstractType): Ok
                if e.linked andif maybe.isSome(e.rep) andif strutil.startsWith(name prefix)
                    andif not(strutil.contains(stringOp.getSub(name stringOp.length(prefix) {stringOp.length(name) - stringOp.length(prefix)}) ".")) then
                    vector.append(found e)
                end)
            vector.toArray(sort.sortedVector(found
                fun(a: ModuleAbstractType b: ModuleAbstractType): Int sort.stringCompare(a.globalName b.globalName)))
        end
end
