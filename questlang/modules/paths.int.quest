(* Quest Self-Hosted Compiler: Unit File Paths Interface
 *
 * bootstrap/python/quest/modules/paths.py, from source: finding the files of
 * interfaces (<name>.int.quest), modules (<name>.mod.quest), and objects
 * (<name>.o) on the search path (the importing unit's directory, the include
 * paths, QUEST_LIB, lib/, and the project directory), and the canonical names
 * of units (docs/modules.md section 2.3).
 *
 * Paths are strings, and are made absolute and normalized lexically (. and ..
 * removed), not through the file system: the bootstrap's Path.resolve also
 * follows symbolic links. The project directory, which the bootstrap knows as
 * its own source tree, is QUEST_HOME, which the test runners set, or else the
 * current directory. *)

interface Paths
import
    util/maybe : util/Maybe
export
    (* ======================================================================
     * Paths
     * ====================================================================== *)

    (* s with its ASCII capitals made lower case *)
    lower(s: String): String
    (* a/b, unless b is absolute *)
    join(a: String b: String): String
    (* p without . and .. components or repeated separators *)
    normalize(p: String): String
    (* p, normalized, relative to the current directory unless absolute *)
    absolute(p: String): String
    parent(p: String): String
    baseName(p: String): String
    (* The components of a path: an absolute one's first is "/" *)
    parts(p: String): Array(String)
    (* p relative to root, if p is root or under it (both absolute and
     * normalized) *)
    relativeTo(p: String root: String): maybe.T(String)
    (* How diagnostics name a file the compiler found: relative to the current
     * directory if inside it *)
    displayName(p: String): String

    (* The text of a file; none if it cannot be read *)
    readText(file: String): maybe.T(String)

    projectDir(): String
    libDir(): String

    (* ======================================================================
     * Units
     * ====================================================================== *)

    (* filename without a unit suffix (.int.quest, .mod.quest, .qi, .o) *)
    stripUnitSuffix(filename: String): String
    (* The name module declares in file (the token after `module`), else the
     * last segment of canonName *)
    declaredModuleName(file: maybe.T(String) canonName: String): String

    (* <name.lower()>.int.quest (.mod.quest, .o) in currentDir, the include
     * paths, QUEST_LIB, lib/, or the project directory *)
    resolveInterfaceSourceFile(name: String currentDir: maybe.T(String) includePaths: Array(String)): maybe.T(String)
    resolveModuleFile(name: String currentDir: maybe.T(String) includePaths: Array(String)): maybe.T(String)
    resolveObjectFile(name: String currentDir: maybe.T(String) includePaths: Array(String)): maybe.T(String)
    (* Interface name on the search path: a fresh .qi if there is one (one that
     * records this compiler's ABI version and the source it was built from,
     * is at least as new as that source, and whose dependencies have not
     * changed), else its .int.quest. Without a source, the first .qi found,
     * whatever its ABI version. *)
    resolveInterfaceFile(name: String currentDir: maybe.T(String) includePaths: Array(String)): maybe.T(String)

    (* An interface that an interface imports, directly or through the
     * interfaces it imports: the path as written in the importing interface,
     * the importing interface's directory, and the .int.quest it resolved to,
     * or "" if none. A .qi records its interface's, so that it is stale when
     * one of them changes or would resolve elsewhere. *)
    Def InterfaceDependency = Tuple path: String dir: String source: String end
    (* Whether found, a resolved source or none, is the file recorded ("" for
     * none) *)
    sameSource(found: maybe.T(String) recorded: String): Bool
    (* The interface dependencies a .qi records, if it can be read and records
     * them *)
    recordedDependencies(qi: String): maybe.T(Array(InterfaceDependency))
    (* How an interface's recorded dependencies changed since an artifact built
     * from them, if they did: a path that would now resolve to another source
     * (by resolveSource, from the directory recorded with it, then the include
     * paths), or a source newer than the artifact *)
    dependencyChange(deps: Array(InterfaceDependency) includePaths: Array(String) artifactTime: Real
        resolveSource: All(path: String fromDir: maybe.T(String) includePaths: Array(String)) maybe.T(String))
        : maybe.T(String)
    (* The directories that are searched, in order, as error messages list
     * them *)
    searchedDirs(currentDir: maybe.T(String) includePaths: Array(String)): Array(String)

    (* The directories canonical names are relative to: the include roots,
     * deepest first, then the program's directory *)
    canonicalRoots(includePaths: Array(String) programDir: maybe.T(String)): Array(String)
    (* The canonical name of the unit in a file (util/path): its path, without
     * its suffix, relative to the first canonical root that contains it. Raises
     * diagnostics.compilerError if a component is not letters and digits. *)
    canonicalizeModulePath(file: String includePaths: Array(String) programDir: maybe.T(String)): String
    (* The module source whose canonical name is canonName, the inverse of
     * canonicalizeModulePath *)
    findCanonicalModuleSource(canonName: String includePaths: Array(String) programDir: maybe.T(String))
        : maybe.T(String)
    (* An interface's canonical name (util/Path) *)
    canonicalizeInterfaceName(
        file: maybe.T(String) includePaths: Array(String) declaredName: String programDir: maybe.T(String)
    ): String
    canonicalizeModuleName(
        file: maybe.T(String) includePaths: Array(String) rawName: String programDir: maybe.T(String)
    ): String
end
