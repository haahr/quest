(* Quest Self-Hosted Compiler: The Unit Graph Implementation *)

module graph : Graph
import
    conv : Conv
    system : System

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/iter : util/Iter
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/files : questlang/common/Files
    questlang/common/location : questlang/common/Location
    questlang/common/maps : questlang/common/Maps
    questlang/modules/paths : questlang/modules/Paths
    questlang/modules/units : questlang/modules/Units
    questlang/syntax/ast : questlang/syntax/AST
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/symbols : questlang/types/Symbols
export
    Let Roots = Tuple searchPaths: Array(String) programDir: maybe.T(String) questLib: String end

    let rootsOf(searchPaths: Array(String) programDir: maybe.T(String)): Roots =
        tuple let searchPaths = searchPaths let programDir = programDir let questLib = system.getEnv("QUEST_LIB") end

    Let Resolved = Tuple
        kind: units.UnitKind
        path: String
        fromDir: maybe.T(String)
        roots: Roots
        source: maybe.T(String)
        prebuilt: maybe.T(String)
        var canonical: maybe.T(String)
        var ifaceName: maybe.T(String)
    end

    let isInterface(k: units.UnitKind): Bool = case k when interfaceUnit then true else false end

    let canonicalName(r: Resolved): String =
        if maybe.isSome(r.canonical) then
            maybe.unwrap(r.canonical)
        else
            let name =
                if isInterface(r.kind) then
                    (* Its unit file: its source, else its prebuilt .qi *)
                    let file = if maybe.isSome(r.source) then r.source else r.prebuilt end
                    if maybe.isSome(file) then
                        paths.canonicalizeModulePath(maybe.unwrap(file) r.roots.searchPaths r.roots.programDir)
                    else
                        paths.lower(r.path)
                    end
                else
                    paths.canonicalizeModuleName(r.source r.roots.searchPaths r.path r.roots.programDir)
                end
            r.canonical := maybe.some(name)
            name
        end

    let interfaceName(r: Resolved): String =
        if maybe.isSome(r.ifaceName) then
            maybe.unwrap(r.ifaceName)
        else
            let name = paths.canonicalizeInterfaceName(r.source r.roots.searchPaths r.path r.roots.programDir)
            r.ifaceName := maybe.some(name)
            name
        end

    Let Resolver = Tuple memo: maps.StringMap(Resolved) var variantOf: All(unit: String) String end

    let newResolver(): Resolver =
        tuple
            let memo = maps.newStringMap()
            let var variantOf = fun(unit: String): String ""
        end

    (* The memo's key of a resolution *)
    let keyOf(kind: String path: String fromDir: maybe.T(String) roots: Roots): String =
        begin
            kind <> "\n" <> path <> "\n" <> maybe.unwrapOr(fromDir "") <> "\n"
                <> maybe.unwrapOr(roots.programDir "") <> "\n" <> roots.questLib
                <> if extent roots.searchPaths > 0 then "\n" <> strutil.joinArray("\n" roots.searchPaths) else "" end
        end

    let resolved(kind: units.UnitKind path: String fromDir: maybe.T(String) roots: Roots source: maybe.T(String)
            prebuilt: maybe.T(String)): Resolved =
        tuple
            let kind = kind
            let path = path
            let fromDir = fromDir
            let roots = roots
            let source = source
            let prebuilt = prebuilt
            let var canonical = maybe.none()
            let var ifaceName = maybe.none()
        end

    let memoized(res: Resolver key: String make: All() Resolved): Resolved =
        begin
            let found = hashMap.get(res.memo key)
            if maybe.isSome(found) then
                maybe.unwrap(found)
            else
                let r = make()
                hashMap.insert(res.memo key r)
                r
            end
        end

    let resolveInterface(res: Resolver path: String fromDir: maybe.T(String) roots: Roots): Resolved =
        memoized(res keyOf("interface" path fromDir roots) fun(): Resolved
            begin
                let source = paths.resolveInterfaceSourceFile(path fromDir roots.searchPaths)
                (* Without a source, the first .qi on the search path, whatever
                 * its ABI version (loading it reports an incompatible one) *)
                let prebuilt =
                    if maybe.isNone(source) then
                        paths.resolveInterfaceFile(path fromDir roots.searchPaths)
                    else
                        maybe.none(:String)
                    end
                resolved(option interfaceUnit of units.UnitKind end path fromDir roots source prebuilt)
            end)

    let resolveModule(res: Resolver path: String fromDir: maybe.T(String) roots: Roots): Resolved =
        memoized(res keyOf("module" path fromDir roots) fun(): Resolved
            begin
                let own = paths.resolveModuleFile(path fromDir roots.searchPaths)
                let r = resolved(option moduleUnit of units.UnitKind end path fromDir roots own maybe.none())
                (* Its variant's file has its canonical name *)
                if maybe.isSome(own) then
                    let chosen = paths.chooseVariant(maybe.unwrap(own) res.variantOf(canonicalName(r)))
                    resolved(option moduleUnit of units.UnitKind end path fromDir roots maybe.some(chosen)
                            maybe.none())
                else
                    r
                end
            end)

    let resolveFile(res: Resolver file: String roots: Roots): Resolved =
        memoized(res keyOf("file" file maybe.none() roots) fun(): Resolved
            resolved(units.unitKind(file) paths.stripUnitSuffix(files.baseName(file))
                    maybe.some(files.parent(file)) roots maybe.some(file) maybe.none()))

    let artifactName(r: Resolved): String =
        if maybe.isNone(r.source) then paths.lower(r.path)
        else paths.canonicalizeModulePath(maybe.unwrap(r.source) r.roots.searchPaths r.roots.programDir)
        end

    let freshInterfaceQi(r: Resolved): maybe.T(String) =
        if maybe.isNone(r.source) then r.prebuilt
        else paths.resolveInterfaceFile(r.path r.fromDir r.roots.searchPaths)
        end

    let interfaceSource(res: Resolver path: String fromDir: maybe.T(String) searchPaths: Array(String)):
            maybe.T(String) = resolveInterface(res path fromDir rootsOf(searchPaths maybe.none())).source

    (* The interface paths each interface source imports, by path and
     * modification time *)
    let importPathsMemo = maps.newStringMap(:Array(String))

    (* The import paths of the interface in source, which was modified at time
     * if it is a regular file *)
    let importPathsAt(source: String time: maybe.T(Int)): Array(String) =
        if maybe.isNone(time) then
            vector.toArray(vector.new(:String))
        else
            let key = files.absolute(source) <> "\n" <> conv.int(maybe.unwrap(time))
            let found = hashMap.get(importPathsMemo key)
            if maybe.isSome(found) then
                maybe.unwrap(found)
            else
                let result = vector.new(:String)
                (* A file that cannot be read or parsed imports nothing here;
                 * compiling it reports why *)
                try
                    let text = files.readText(source)
                    if maybe.isSome(text) then
                        let prog = units.parseUnit(location.newSourceMap(source maybe.unwrap(text)))
                        if vector.length(prog.form.phrases) is 1 then
                            case vector.get(prog.form.phrases 0).form
                                when phraseInterface with x then
                                    for i = 0 upto {vector.length(x.iface.imports) - 1} do
                                        let imp = vector.get(x.iface.imports i)
                                        vector.append(result
                                                maybe.unwrapOr(imp.interfacePath imp.interfaceName))
                                    end
                                else ok
                            end
                        end
                    end
                when diagnostics.compilerError then
                    ok
                end
                let imports = vector.toArray(result)
                hashMap.insert(importPathsMemo key imports)
                imports
            end
        end

    let interfaceImportPaths(source: String): Array(String) = importPathsAt(source files.fileTime(source))

    let interfaceDependencies(res: Resolver source: String searchPaths: Array(String)):
            Array(paths.InterfaceDependency) =
        begin
            let roots = rootsOf(searchPaths maybe.none())
            let deps = vector.new(:paths.InterfaceDependency)
            let seen = maps.newStringMap(:Bool)
            let visited = maps.newStringMap(:Bool)
            hashMap.insert(visited files.absolute(source) true)
            let rec visit(importer: String): Ok =
                begin
                    let importerDir = files.absolute(files.parent(importer))
                    let imported = interfaceImportPaths(importer)
                    for i = 0 upto {extent imported - 1} do
                        let path = imported[i]
                        let key = importerDir <> "\n" <> path
                        if not(hashMap.contains(seen key)) then
                            hashMap.insert(seen key true)
                            let depSource = resolveInterface(res path maybe.some(files.parent(importer)) roots).source
                            vector.append(deps tuple
                                let path = path
                                let dir = importerDir
                                let source = maybe.unwrapOr(depSource "")
                            end)
                            if maybe.isSome(depSource)
                                    andif not(hashMap.contains(visited
                                            files.absolute(maybe.unwrap(depSource)))) then
                                hashMap.insert(visited files.absolute(maybe.unwrap(depSource))
                                        true)
                                visit(maybe.unwrap(depSource))
                            end
                        end
                    end
                    ok
                end
            visit(source)
            vector.toArray(deps)
        end

    let unitArtifactDir(buildDir: String canonicalName: String): String =
        if strutil.contains(canonicalName "/") then files.join(buildDir files.parent(canonicalName)) else buildDir end

    let artifactStem(canonicalName: String): String = paths.lower(files.baseName(canonicalName))

    let interfaceQiFile(buildDir: String canonicalName: String): String =
        files.join(unitArtifactDir(buildDir canonicalName) artifactStem(canonicalName) <> ".qi")

    Let ModuleArtifacts = Tuple qm: String c: String o: String end

    let artifactsIn(directory: String stem: String): ModuleArtifacts =
        tuple
            let qm = files.join(directory stem <> ".qm")
            let c = files.join(directory stem <> ".mod.c")
            let o = files.join(directory stem <> ".o")
        end

    let moduleArtifacts(buildDir: String canonicalName: String): ModuleArtifacts =
        artifactsIn(unitArtifactDir(buildDir canonicalName) artifactStem(canonicalName))

    Let Unit = Tuple
        kind: units.UnitKind
        canonicalName: String
        var scope: maybe.T(symbols.Scope)
        var typedModule: maybe.T(typedAst.Binding)
        var exportScope: maybe.T(symbols.Scope)
        var precompiled: Bool
    end

    Let UnitGraph = Tuple resolver: Resolver units: maps.StringMap(Unit) end

    let newGraphWith(res: Resolver): UnitGraph = tuple let resolver = res let units = maps.newStringMap() end
    let newGraph(): UnitGraph = newGraphWith(newResolver())

    let kindName(k: units.UnitKind): String =
        case k when interfaceUnit then "interface" when moduleUnit then "module" when programUnit then "program" end

    let unitKey(kind: units.UnitKind name: String): String = kindName(kind) <> " " <> name

    let unit(g: UnitGraph kind: units.UnitKind canonicalName: String): Unit =
        begin
            let key = unitKey(kind canonicalName)
            let found = hashMap.get(g.units key)
            if maybe.isSome(found) then
                maybe.unwrap(found)
            else
                let u: Unit = tuple
                    let kind = kind
                    let canonicalName = canonicalName
                    let var scope = maybe.none()
                    let var typedModule = maybe.none()
                    let var exportScope = maybe.none()
                    let var precompiled = false
                end
                hashMap.insert(g.units key u)
                u
            end
        end

    let find(g: UnitGraph kind: units.UnitKind canonicalName: String): maybe.T(Unit) =
        hashMap.get(g.units unitKey(kind canonicalName))

    let interfaceScope(g: UnitGraph canonicalName: String): maybe.T(symbols.Scope) =
        begin
            let found = find(g option interfaceUnit of units.UnitKind end canonicalName)
            if maybe.isSome(found) then maybe.unwrap(found).scope else maybe.none() end
        end

    let typedModule(g: UnitGraph canonicalName: String): maybe.T(typedAst.Binding) =
        begin
            let found = find(g option moduleUnit of units.UnitKind end canonicalName)
            if maybe.isSome(found) then maybe.unwrap(found).typedModule else maybe.none() end
        end

    let isPrecompiled(g: UnitGraph name: String): Bool =
        begin
            let found = find(g option moduleUnit of units.UnitKind end name)
            maybe.isSome(found) andif maybe.unwrap(found).precompiled
        end

    Let NamedScope = Tuple name: String scope: symbols.Scope end

    let interfaceScopes(g: UnitGraph): Array(NamedScope) =
        begin
            let result = vector.new(:NamedScope)
            let all = hashMap.valueIter(g.units)
            while iter.more(all) do
                let u = iter.next(all)
                if isInterface(u.kind) andif maybe.isSome(u.scope) then
                    vector.append(result tuple
                        let name = u.canonicalName
                        let scope = maybe.unwrap(u.scope)
                    end)
                end
            end
            vector.toArray(result)
        end

    let exportScopes(g: UnitGraph): Array(NamedScope) =
        begin
            let result = vector.new(:NamedScope)
            let all = hashMap.valueIter(g.units)
            while iter.more(all) do
                let u = iter.next(all)
                let isModule = case u.kind when moduleUnit then true else false end
                if isModule andif maybe.isSome(u.exportScope) then
                    vector.append(result tuple
                        let name = u.canonicalName
                        let scope = maybe.unwrap(u.exportScope)
                    end)
                end
            end
            vector.toArray(result)
        end

    let adopt(g: UnitGraph interfaceScopes: Array(NamedScope) exportScopes: Array(NamedScope)): Ok =
        begin
            for i = 0 upto {extent interfaceScopes - 1} do
                let n = interfaceScopes[i]
                unit(g option interfaceUnit of units.UnitKind end n.name).scope := maybe.some(n.scope)
            end
            for i = 0 upto {extent exportScopes - 1} do
                let n = exportScopes[i]
                unit(g option moduleUnit of units.UnitKind end n.name).exportScope := maybe.some(n.scope)
            end
        end

    let newSession(g: UnitGraph): Ok = hashMap.clear(g.resolver.memo)

    Let Snapshot = Array(Unit)

    (* A unit with u's state *)
    let copyUnit(u: Unit): Unit =
        tuple
            let kind = u.kind
            let canonicalName = u.canonicalName
            let var scope = u.scope
            let var typedModule = u.typedModule
            let var exportScope = u.exportScope
            let var precompiled = u.precompiled
        end

    let snapshot(g: UnitGraph): Snapshot = vector.toArray(vector.map(hashMap.values(g.units) copyUnit))

    let restore(g: UnitGraph snap: Snapshot): Ok =
        begin
            hashMap.clear(g.units)
            (* Copies, so that the snapshot can be restored again *)
            for i = 0 upto {extent snap - 1} do
                hashMap.insert(g.units unitKey(snap[i].kind snap[i].canonicalName) copyUnit(snap[i]))
            end
        end
end
