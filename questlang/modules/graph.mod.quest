(* Quest Self-Hosted Compiler: The Unit Graph Implementation *)

module graph : Graph
import
    questlang/types/symbols : questlang/types/Symbols
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/modules/units : questlang/modules/Units
    questlang/modules/paths : questlang/modules/Paths
    questlang/common/location : questlang/common/Location
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/files : questlang/common/Files
    questlang/syntax/ast : questlang/syntax/Ast
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    util/strutil : util/Strutil
    stringOp = string : StringOp
    conv : Conv
    system : System
export
    Let Roots = Tuple searchPaths: Array(String) programDir: maybe.T(String) questLib: String end

    let rootsOf(searchPaths: Array(String) programDir: maybe.T(String)): Roots =
        tuple let searchPaths = searchPaths let programDir = programDir let questLib = system.getEnv("QUEST_LIB") end

    Let Resolved = Tuple
        kind: units.UnitKind
        path: String
        fromDir: maybe.T(String)
        roots: Roots
        source: maybe.T(String)
        prebuilt: maybe.T(String)
        var canonical: maybe.T(String)
        var ifaceName: maybe.T(String)
    end

    let isInterface(k: units.UnitKind): Bool = case k when interfaceUnit then true else false end

    let canonicalName(r: Resolved): String =
        if maybe.isSome(:String r.canonical) then
            maybe.unwrap(:String r.canonical)
        else
            let name = if isInterface(r.kind) then
                (* Its unit file: its source, else its prebuilt .qi *)
                let file = if maybe.isSome(:String r.source) then r.source else r.prebuilt end
                if maybe.isSome(:String file) then
                    paths.canonicalizeModulePath(maybe.unwrap(:String file) r.roots.searchPaths r.roots.programDir)
                else
                    paths.lower(r.path)
                end
            else
                paths.canonicalizeModuleName(r.source r.roots.searchPaths r.path r.roots.programDir)
            end
            r.canonical := maybe.some(:String name)
            name
        end

    let interfaceName(r: Resolved): String =
        if maybe.isSome(:String r.ifaceName) then
            maybe.unwrap(:String r.ifaceName)
        else
            let name = paths.canonicalizeInterfaceName(r.source r.roots.searchPaths r.path r.roots.programDir)
            r.ifaceName := maybe.some(:String name)
            name
        end

    Let Resolver = Tuple memo: hashMap.T(String Resolved) end

    let newResolver(): Resolver = tuple let memo = hashMap.new(:String :Resolved stringOp.equal hash.string) end

    (* The memo's key of a resolution *)
    let keyOf(kind: String path: String fromDir: maybe.T(String) roots: Roots): String =
        begin
            let var key = kind <> "\n" <> path <> "\n" <> maybe.unwrapOr(:String fromDir "") <> "\n" <>
                maybe.unwrapOr(:String roots.programDir "") <> "\n" <> roots.questLib
            for i = 0 upto {extent roots.searchPaths - 1} do key := key <> "\n" <> roots.searchPaths[i] end
            key
        end

    let resolved(kind: units.UnitKind path: String fromDir: maybe.T(String) roots: Roots source: maybe.T(String)
        prebuilt: maybe.T(String)): Resolved =
        tuple
            let kind = kind let path = path let fromDir = fromDir let roots = roots let source = source
            let prebuilt = prebuilt
            let var canonical = maybe.none(:String) let var ifaceName = maybe.none(:String)
        end

    let memoized(res: Resolver key: String make: All() Resolved): Resolved =
        begin
            let found = hashMap.get(:String :Resolved res.memo key)
            if maybe.isSome(:Resolved found) then
                maybe.unwrap(:Resolved found)
            else
                let r = make()
                hashMap.insert(:String :Resolved res.memo key r)
                r
            end
        end

    let resolveInterface(res: Resolver path: String fromDir: maybe.T(String) roots: Roots): Resolved =
        memoized(res keyOf("interface" path fromDir roots) fun(): Resolved
            begin
                let source = paths.resolveInterfaceSourceFile(path fromDir roots.searchPaths)
                (* Without a source, the first .qi on the search path, whatever
                 * its ABI version (loading it reports an incompatible one) *)
                let prebuilt = if maybe.isNone(:String source) then
                    paths.resolveInterfaceFile(path fromDir roots.searchPaths)
                    else maybe.none(:String)
                end
                resolved(option interfaceUnit of units.UnitKind end path fromDir roots source prebuilt)
            end)

    let resolveModule(res: Resolver path: String fromDir: maybe.T(String) roots: Roots): Resolved =
        memoized(res keyOf("module" path fromDir roots) fun(): Resolved
            resolved(option moduleUnit of units.UnitKind end path fromDir roots
                paths.resolveModuleFile(path fromDir roots.searchPaths) maybe.none(:String)))

    let resolveFile(res: Resolver file: String roots: Roots): Resolved =
        memoized(res keyOf("file" file maybe.none(:String) roots) fun(): Resolved
            resolved(units.unitKind(file) paths.stripUnitSuffix(paths.baseName(file))
                maybe.some(:String paths.parent(file)) roots maybe.some(:String file) maybe.none(:String)))

    let artifactName(r: Resolved): String =
        if maybe.isNone(:String r.source) then paths.lower(r.path)
        else paths.canonicalizeModulePath(maybe.unwrap(:String r.source) r.roots.searchPaths r.roots.programDir)
        end

    let freshInterfaceQi(r: Resolved): maybe.T(String) =
        if maybe.isNone(:String r.source) then r.prebuilt
        else paths.resolveInterfaceFile(r.path r.fromDir r.roots.searchPaths)
        end

    let interfaceSource(res: Resolver path: String fromDir: maybe.T(String) searchPaths: Array(String)):
        maybe.T(String) =
        resolveInterface(res path fromDir rootsOf(searchPaths maybe.none(:String))).source

    (* The interface paths each interface source imports, by path and
     * modification time *)
    let importPathsMemo = hashMap.new(:String :Array(String) stringOp.equal hash.string)

    (* The import paths of the interface in source, which was modified at time
     * if it is a regular file *)
    let importPathsAt(source: String time: maybe.T(Int)): Array(String) =
        if maybe.isNone(:Int time) then
            vector.toArray(:String vector.new(:String))
        else
            let key = paths.absolute(source) <> "\n" <> conv.int(maybe.unwrap(:Int time))
            let found = hashMap.get(:String :Array(String) importPathsMemo key)
            if maybe.isSome(:Array(String) found) then
                maybe.unwrap(:Array(String) found)
            else
                let result = vector.new(:String)
                (* A file that cannot be read or parsed imports nothing here;
                 * compiling it reports why *)
                try
                    let text = paths.readText(source)
                    if maybe.isSome(:String text) then
                        let prog = units.parseUnit(location.newSourceMap(source maybe.unwrap(:String text)))
                        if vector.length(:ast.Phrase prog.form.phrases) is 1 then
                            case vector.get(:ast.Phrase prog.form.phrases 0).form
                                when phraseInterface with x then
                                    for i = 0 upto {vector.length(:ast.ImportItem x.iface.imports) - 1} do
                                        let imp = vector.get(:ast.ImportItem x.iface.imports i)
                                        vector.append(:String result
                                            maybe.unwrapOr(:String imp.interfacePath imp.interfaceName))
                                    end
                                else ok
                            end
                        end
                    end
                when diagnostics.compilerError then
                    ok
                end
                let imports = vector.toArray(:String result)
                hashMap.insert(:String :Array(String) importPathsMemo key imports)
                imports
            end
        end

    let interfaceImportPaths(source: String): Array(String) = importPathsAt(source files.fileTime(source))

    let interfaceDependencies(res: Resolver source: String searchPaths: Array(String)):
        Array(paths.InterfaceDependency) =
        begin
            let roots = rootsOf(searchPaths maybe.none(:String))
            let deps = vector.new(:paths.InterfaceDependency)
            let seen = hashMap.new(:String :Bool stringOp.equal hash.string)
            let visited = hashMap.new(:String :Bool stringOp.equal hash.string)
            hashMap.insert(:String :Bool visited paths.absolute(source) true)
            let rec visit(importer: String): Ok =
                begin
                    let importerDir = paths.absolute(paths.parent(importer))
                    let imported = interfaceImportPaths(importer)
                    for i = 0 upto {extent imported - 1} do
                        let path = imported[i]
                        let key = importerDir <> "\n" <> path
                        if not(hashMap.contains(:String :Bool seen key)) then
                            hashMap.insert(:String :Bool seen key true)
                            let depSource =
                                resolveInterface(res path maybe.some(:String paths.parent(importer)) roots).source
                            vector.append(:paths.InterfaceDependency deps tuple
                                let path = path let dir = importerDir let source = maybe.unwrapOr(:String depSource "")
                            end)
                            if maybe.isSome(:String depSource)
                                andif
                                    not(hashMap.contains(:String :Bool visited
                                    paths.absolute(maybe.unwrap(:String depSource)))) then
                                hashMap.insert(:String :Bool visited paths.absolute(maybe.unwrap(:String depSource))
                                    true)
                                visit(maybe.unwrap(:String depSource))
                            end
                        end
                    end
                    ok
                end
            visit(source)
            vector.toArray(:paths.InterfaceDependency deps)
        end

    let unitArtifactDir(buildDir: String canonicalName: String): String =
        if strutil.contains(canonicalName "/") then paths.join(buildDir paths.parent(canonicalName)) else buildDir end

    let artifactStem(canonicalName: String): String = paths.lower(paths.baseName(canonicalName))

    let interfaceQiFile(buildDir: String canonicalName: String): String =
        paths.join(unitArtifactDir(buildDir canonicalName) artifactStem(canonicalName) <> ".qi")

    Let ModuleArtifacts = Tuple qm: String c: String o: String end

    let artifactsIn(directory: String stem: String): ModuleArtifacts =
        tuple
            let qm = paths.join(directory stem <> ".qm")
            let c = paths.join(directory stem <> ".mod.c")
            let o = paths.join(directory stem <> ".o")
        end

    let moduleArtifacts(buildDir: String canonicalName: String): ModuleArtifacts =
        artifactsIn(unitArtifactDir(buildDir canonicalName) artifactStem(canonicalName))

    Let Unit = Tuple
        kind: units.UnitKind
        canonicalName: String
        var scope: maybe.T(symbols.Scope)
        var typedModule: maybe.T(typedAst.Binding)
        var exportScope: maybe.T(symbols.Scope)
        var precompiled: Bool
    end

    Let UnitGraph = Tuple resolver: Resolver units: hashMap.T(String Unit) end

    let newGraphWith(res: Resolver): UnitGraph =
        tuple let resolver = res let units = hashMap.new(:String :Unit stringOp.equal hash.string) end
    let newGraph(): UnitGraph = newGraphWith(newResolver())

    let kindName(k: units.UnitKind): String =
        case k when interfaceUnit then "interface" when moduleUnit then "module" when programUnit then "program" end

    let unitKey(kind: units.UnitKind name: String): String = kindName(kind) <> " " <> name

    let unit(g: UnitGraph kind: units.UnitKind canonicalName: String): Unit =
        begin
            let key = unitKey(kind canonicalName)
            let found = hashMap.get(:String :Unit g.units key)
            if maybe.isSome(:Unit found) then
                maybe.unwrap(:Unit found)
            else
                let u: Unit = tuple
                    let kind = kind let canonicalName = canonicalName let var scope = maybe.none(:symbols.Scope)
                    let var typedModule = maybe.none(:typedAst.Binding) let var exportScope = maybe.none(:symbols.Scope)
                    let var precompiled = false
                end
                hashMap.insert(:String :Unit g.units key u)
                u
            end
        end

    let find(g: UnitGraph kind: units.UnitKind canonicalName: String): maybe.T(Unit) =
        hashMap.get(:String :Unit g.units unitKey(kind canonicalName))

    let interfaceScope(g: UnitGraph canonicalName: String): maybe.T(symbols.Scope) =
        begin
            let found = find(g option interfaceUnit of units.UnitKind end canonicalName)
            if maybe.isSome(:Unit found) then maybe.unwrap(:Unit found).scope else maybe.none(:symbols.Scope) end
        end

    let typedModule(g: UnitGraph canonicalName: String): maybe.T(typedAst.Binding) =
        begin
            let found = find(g option moduleUnit of units.UnitKind end canonicalName)
            if maybe.isSome(:Unit found) then maybe.unwrap(:Unit found).typedModule else maybe.none(:typedAst.Binding) end
        end

    let isPrecompiled(g: UnitGraph name: String): Bool =
        begin
            let found = find(g option moduleUnit of units.UnitKind end name)
            maybe.isSome(:Unit found) andif maybe.unwrap(:Unit found).precompiled
        end

    Let NamedScope = Tuple name: String scope: symbols.Scope end

    let interfaceScopes(g: UnitGraph): Array(NamedScope) =
        begin
            let result = vector.new(:NamedScope)
            let all = hashMap.values(:String :Unit g.units)
            for i = 0 upto {vector.length(:Unit all) - 1} do
                let u = vector.get(:Unit all i)
                if isInterface(u.kind) andif maybe.isSome(:symbols.Scope u.scope) then
                    vector.append(:NamedScope result tuple
                        let name = u.canonicalName let scope = maybe.unwrap(:symbols.Scope u.scope)
                    end)
                end
            end
            vector.toArray(:NamedScope result)
        end

    let exportScopes(g: UnitGraph): Array(NamedScope) =
        begin
            let result = vector.new(:NamedScope)
            let all = hashMap.values(:String :Unit g.units)
            for i = 0 upto {vector.length(:Unit all) - 1} do
                let u = vector.get(:Unit all i)
                let isModule = case u.kind when moduleUnit then true else false end
                if isModule andif maybe.isSome(:symbols.Scope u.exportScope) then
                    vector.append(:NamedScope result tuple
                        let name = u.canonicalName let scope = maybe.unwrap(:symbols.Scope u.exportScope)
                    end)
                end
            end
            vector.toArray(:NamedScope result)
        end

    let adopt(g: UnitGraph interfaceScopes: Array(NamedScope) exportScopes: Array(NamedScope)): Ok =
        begin
            for i = 0 upto {extent interfaceScopes - 1} do
                let n = interfaceScopes[i]
                unit(g option interfaceUnit of units.UnitKind end n.name).scope := maybe.some(:symbols.Scope n.scope)
            end
            for i = 0 upto {extent exportScopes - 1} do
                let n = exportScopes[i]
                unit(g option moduleUnit of units.UnitKind end n.name).exportScope := maybe.some(:symbols.Scope n.scope)
            end
        end

    let newSession(g: UnitGraph): Ok = hashMap.clear(:String :Resolved g.resolver.memo)

    Let Snapshot = Array(Unit)

    (* A unit with u's state *)
    let copyUnit(u: Unit): Unit =
        tuple
            let kind = u.kind let canonicalName = u.canonicalName let var scope = u.scope
            let var typedModule = u.typedModule let var exportScope = u.exportScope let var precompiled = u.precompiled
        end

    let snapshot(g: UnitGraph): Snapshot =
        vector.toArray(:Unit vector.map(:Unit :Unit hashMap.values(:String :Unit g.units) copyUnit))

    let restore(g: UnitGraph snap: Snapshot): Ok =
        begin
            hashMap.clear(:String :Unit g.units)
            (* Copies, so that the snapshot can be restored again *)
            for i = 0 upto {extent snap - 1} do
                hashMap.insert(:String :Unit g.units unitKey(snap[i].kind snap[i].canonicalName) copyUnit(snap[i]))
            end
        end
end
