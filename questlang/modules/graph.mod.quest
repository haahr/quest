(* Quest Self-Hosted Compiler: The Unit Graph Implementation *)

module graph : Graph
import
    collections/hashMap : collections/HashMap
    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/iter : util/Iter
    util/maybe : util/Maybe

    questlang/common/maps : questlang/common/Maps
    questlang/modules/resolution : questlang/modules/Resolution
    questlang/modules/units : questlang/modules/Units
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/symbols : questlang/types/Symbols
export
    let isInterface(k: units.UnitKind): Bool = case k when interfaceUnit then true else false end

    Let Unit = Tuple
        kind: units.UnitKind
        canonicalName: String
        var scope: maybe.T(symbols.Scope)
        var typedModule: maybe.T(typedAst.Binding)
        var exportScope: maybe.T(symbols.Scope)
        var precompiled: Bool
    end

    Let Declaration = Tuple file: String offset: Int end
    Let UnitGraph = Tuple
        resolver: resolution.Resolver
        units: maps.StringMap(Unit)
        declarations: maps.StringMap(Declaration)
        everDeclared: maps.StringSet
    end

    let newGraphWith(res: resolution.Resolver): UnitGraph =
        tuple
            let resolver = res
            let units = maps.newStringMap()
            let declarations = maps.newStringMap()
            let everDeclared = maps.newStringSet()
        end
    let newGraph(): UnitGraph = newGraphWith(resolution.newResolver())

    let kindName(k: units.UnitKind): String =
        case k when interfaceUnit then "interface" when moduleUnit then "module" when programUnit then "program" end

    let unitKey(kind: units.UnitKind name: String): String = kindName(kind) <> " " <> name

    let unit(g: UnitGraph kind: units.UnitKind canonicalName: String): Unit =
        begin
            let key = unitKey(kind canonicalName)
            let found = hashMap.get(g.units key)
            if maybe.isSome(found) then
                maybe.unwrap(found)
            else
                let u: Unit = tuple
                    let kind = kind
                    let canonicalName = canonicalName
                    let var scope = maybe.none()
                    let var typedModule = maybe.none()
                    let var exportScope = maybe.none()
                    let var precompiled = false
                end
                hashMap.insert(g.units key u)
                u
            end
        end

    let find(g: UnitGraph kind: units.UnitKind canonicalName: String): maybe.T(Unit) =
        hashMap.get(g.units unitKey(kind canonicalName))

    let interfaceScope(g: UnitGraph canonicalName: String): maybe.T(symbols.Scope) =
        begin
            let found = find(g option interfaceUnit of units.UnitKind end canonicalName)
            if maybe.isSome(found) then maybe.unwrap(found).scope else maybe.none() end
        end

    let typedModule(g: UnitGraph canonicalName: String): maybe.T(typedAst.Binding) =
        begin
            let found = find(g option moduleUnit of units.UnitKind end canonicalName)
            if maybe.isSome(found) then maybe.unwrap(found).typedModule else maybe.none() end
        end

    let isPrecompiled(g: UnitGraph name: String): Bool =
        begin
            let found = find(g option moduleUnit of units.UnitKind end name)
            maybe.isSome(found) andif maybe.unwrap(found).precompiled
        end

    let declaration(g: UnitGraph canonicalName: String): maybe.T(Declaration) =
        hashMap.get(g.declarations canonicalName)

    let declare(g: UnitGraph canonicalName: String d: Declaration): Ok =
        begin
            hashMap.insert(g.declarations canonicalName d)
            hashSet.insert(g.everDeclared canonicalName)
            ok
        end

    let everDeclared(g: UnitGraph canonicalName: String): Bool = hashSet.contains(g.everDeclared canonicalName)

    Let NamedScope = Tuple name: String scope: symbols.Scope end

    let interfaceScopes(g: UnitGraph): Array(NamedScope) =
        begin
            let result = vector.new(:NamedScope)
            let all = hashMap.valueIter(g.units)
            while iter.more(all) do
                let u = iter.next(all)
                if isInterface(u.kind) andif maybe.isSome(u.scope) then
                    vector.append(result tuple
                        let name = u.canonicalName
                        let scope = maybe.unwrap(u.scope)
                    end)
                end
            end
            vector.toArray(result)
        end

    let exportScopes(g: UnitGraph): Array(NamedScope) =
        begin
            let result = vector.new(:NamedScope)
            let all = hashMap.valueIter(g.units)
            while iter.more(all) do
                let u = iter.next(all)
                let isModule = case u.kind when moduleUnit then true else false end
                if isModule andif maybe.isSome(u.exportScope) then
                    vector.append(result tuple
                        let name = u.canonicalName
                        let scope = maybe.unwrap(u.exportScope)
                    end)
                end
            end
            vector.toArray(result)
        end

    let adopt(g: UnitGraph interfaceScopes: Array(NamedScope) exportScopes: Array(NamedScope)): Ok =
        begin
            for i = 0 upto {extent interfaceScopes - 1} do
                let n = interfaceScopes[i]
                unit(g option interfaceUnit of units.UnitKind end n.name).scope := maybe.some(n.scope)
            end
            for i = 0 upto {extent exportScopes - 1} do
                let n = exportScopes[i]
                unit(g option moduleUnit of units.UnitKind end n.name).exportScope := maybe.some(n.scope)
            end
        end

    let newSession(g: UnitGraph): Ok =
        begin
            hashMap.clear(g.resolver.memo)
            hashMap.clear(g.declarations)
        end

    Let Snapshot = Array(Unit)

    (* A unit with u's state *)
    let copyUnit(u: Unit): Unit =
        tuple
            let kind = u.kind
            let canonicalName = u.canonicalName
            let var scope = u.scope
            let var typedModule = u.typedModule
            let var exportScope = u.exportScope
            let var precompiled = u.precompiled
        end

    let snapshot(g: UnitGraph): Snapshot = vector.toArray(vector.map(hashMap.values(g.units) copyUnit))

    let restore(g: UnitGraph snap: Snapshot): Ok =
        begin
            hashMap.clear(g.units)
            (* Copies, so that the snapshot can be restored again *)
            for i = 0 upto {extent snap - 1} do
                hashMap.insert(g.units unitKey(snap[i].kind snap[i].canonicalName) copyUnit(snap[i]))
            end
        end
end
