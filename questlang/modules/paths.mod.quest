(* Quest Self-Hosted Compiler: Unit File Paths Implementation *)

module paths : Paths
import
    ascii : Ascii
    stringOp = string : StringOp
    system : System

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/json : util/JSON
    util/maybe : util/Maybe
    sb = util/stringBuilder : util/StringBuilder
    util/strutil : util/Strutil

    questlang/common/diagbag : questlang/common/DiagBag
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/files : questlang/common/Files
    questlang/common/jsonCache : questlang/common/JSONCache
    questlang/common/location : questlang/common/Location
    questlang/config/abi : questlang/config/ABI
    questlang/syntax/tokenizer : questlang/syntax/Tokenizer
    questlang/syntax/tokens : questlang/syntax/Tokens
export
    (* ======================================================================
     * Paths
     * ====================================================================== *)

    let lower(s: String): String =
        begin
            let b = sb.new()
            for i = 0 upto {stringOp.length(s) - 1} do
                let ch = stringOp.getChar(s i)
                let code = ascii.val(ch)
                sb.char(b if {code >= 65} andif {code <= 90} then ascii.char(code + 32) else ch end)
            end
            sb.toString(b)
        end

    let projectDir(): String =
        begin
            let home = system.getEnv("QUEST_HOME")
            files.absolute(if stringOp.length(home) > 0 then home else system.currentDirectory() end)
        end
    let libDir(): String = files.join(projectDir() "lib")
    let libModulePath(source: String): maybe.T(String) =
        begin
            let prefix = libDir() <> "/"
            let full = files.absolute(source)
            let suffix = ".mod.quest"
            let n = stringOp.length(full)
            let p = stringOp.length(prefix)
            let s = stringOp.length(suffix)
            let size = {n - p} - s
            if {size > 0} andif stringOp.equal(stringOp.getSub(full 0 p) prefix)
                    andif stringOp.equal(stringOp.getSub(full {n - s} s) suffix) then
                (* a variant's file, NAME.VARIANT.mod.quest, is NAME's *)
                let path = stringOp.getSub(full p size)
                let dot = strutil.rfind(path ".")
                maybe.some(if dot > strutil.rfind(path "/") then stringOp.getSub(path 0 dot) else path end)
            else
                maybe.none()
            end
        end

    (* ======================================================================
     * Units
     * ====================================================================== *)

    let unitSuffixes = array of ".int.quest" ".mod.quest" ".qi" ".o" end

    let stripUnitSuffix(filename: String): String =
        begin
            let var result = filename
            let var found = false
            for i = 0 upto {extent unitSuffixes - 1} do
                if not(found) andif strutil.endsWith(filename unitSuffixes[i]) then
                    result := stringOp.getSub(filename 0 {stringOp.length(filename) - stringOp.length(unitSuffixes[i])})
                    found := true
                    (* A variant's file, NAME.VARIANT.mod.quest *)
                    let dot = strutil.rfind(result ".")
                    if {i is 1} andif {dot > 0} then result := stringOp.getSub(result 0 dot) end
                end
            end
            result
        end

    let chooseVariant(moduleFile: String name: String): String =
        if not(strutil.endsWith(moduleFile ".mod.quest")) then
            moduleFile
        else
            let base = files.baseName(moduleFile)
            let dir = stringOp.getSub(moduleFile 0 {stringOp.length(moduleFile) - stringOp.length(base)})
            let own = dir <> stripUnitSuffix(base) <> ".mod.quest"
            let chosen = dir <> stripUnitSuffix(base) <> "." <> name <> ".mod.quest"
            if {stringOp.length(name) > 0} andif system.isFile(chosen) then chosen
            elsif system.isFile(own) then own
            else moduleFile
            end
        end

    let lastSegment(name: String): String =
        begin
            let cs = files.components(name)
            if vector.empty(cs) then name else vector.last(cs) end
        end

    (* The name each module source text declares *)
    let declaredNames = hashMap.new(:String :String stringOp.equal hash.string)

    let declaredModuleName(file: maybe.T(String) canonName: String): String =
        begin
            let fallback = lastSegment(canonName)
            let text = if maybe.isSome(file) then files.readText(maybe.unwrap(file)) else maybe.none(:String) end
            let known =
                if maybe.isSome(text) then
                    hashMap.get(declaredNames maybe.unwrap(text))
                else
                    maybe.none(:String)
                end
            if maybe.isNone(text) then
                fallback
            elsif maybe.isSome(known) then
                maybe.unwrap(known)
            else
                try
                    let sm = location.newSourceMap(maybe.unwrap(file) maybe.unwrap(text))
                    let toks = tokenizer.tokenizeAll(tokenizer.new(sm diagbag.new()))
                    let var name = fallback
                    let var found = false
                    for i = 0 upto {vector.length(toks) - 2} do
                        if not(found) then
                            case vector.get(toks i).kind
                                when kwModule then
                                    begin
                                        name := vector.get(toks {i + 1}).lexeme
                                        found := true
                                    end
                                else ok
                            end
                        end
                    end
                    hashMap.insert(declaredNames maybe.unwrap(text) name)
                    name
                when diagbag.fatalError then
                    fallback
                end
            end
        end

    (* The directories searched for a unit's file, in order *)
    let searchDirs(currentDir: maybe.T(String) includePaths: Array(String)): vector.T(String) =
        begin
            let dirs = vector.new(:String)
            if maybe.isSome(currentDir) then vector.append(dirs maybe.unwrap(currentDir)) end
            for i = 0 upto {extent includePaths - 1} do vector.append(dirs includePaths[i]) end
            let envLib = system.getEnv("QUEST_LIB")
            if stringOp.length(envLib) > 0 then vector.append(dirs envLib) end
            if system.isDirectory(libDir()) then vector.append(dirs libDir()) end
            vector.append(dirs projectDir())
            dirs
        end

    let findFile(filename: String currentDir: maybe.T(String) includePaths: Array(String)): maybe.T(String) =
        begin
            let dirs = searchDirs(currentDir includePaths)
            let var found = maybe.none(:String)
            for i = 0 upto {vector.length(dirs) - 1} do
                if maybe.isNone(found) then
                    let candidate = files.join(vector.get(dirs i) filename)
                    if system.isFile(candidate) then found := maybe.some(files.absolute(candidate)) end
                end
            end
            found
        end

    let resolveInterfaceSourceFile(name: String currentDir: maybe.T(String)
            includePaths: Array(String)): maybe.T(String) =
        findFile(lower(name) <> ".int.quest" currentDir includePaths)
    let resolveModuleFile(name: String currentDir: maybe.T(String) includePaths: Array(String)): maybe.T(String) =
        findFile(lower(name) <> ".mod.quest" currentDir includePaths)
    let resolveObjectFile(name: String currentDir: maybe.T(String) includePaths: Array(String)): maybe.T(String) =
        findFile(lower(name) <> ".o" currentDir includePaths)

    Let InterfaceDependency = Tuple path: String dir: String source: String end

    let sameSource(found: maybe.T(String) recorded: String): Bool =
        if maybe.isNone(found) orif {stringOp.length(recorded) is 0} then
            maybe.isNone(found) andif {stringOp.length(recorded) is 0}
        else
            stringOp.equal(files.absolute(maybe.unwrap(found)) files.absolute(recorded))
        end

    let recordedDependencies(qi: String): maybe.T(Array(InterfaceDependency)) =
        begin
            let none = maybe.none(:Array(InterfaceDependency))
            let text = files.readText(qi)
            if maybe.isNone(text) then
                none
            else
                let member(v: json.Value name: String): maybe.T(json.Value) = json.optional(v name)
                let str(v: maybe.T(json.Value)): maybe.T(String) =
                    if maybe.isNone(v) then maybe.none()
                    else case maybe.unwrap(v) when jString with x then maybe.some(x.s)
                        else maybe.none() end
                    end
                try
                    let value = member(jsonCache.parseShared(maybe.unwrap(text)) "value")
                    let deps = if maybe.isSome(value) then member(maybe.unwrap(value) "deps")
                        else maybe.none(:json.Value)
                        end
                    if maybe.isNone(deps) then
                        none
                    else
                        case maybe.unwrap(deps)
                            when jArray with x then
                                let result = vector.new(:InterfaceDependency)
                                let var valid = true
                                for i = 0 upto {vector.length(x.items) - 1} do
                                    let d = vector.get(x.items i)
                                    let path = str(member(d "path"))
                                    let dir = str(member(d "dir"))
                                    let source = str(member(d "source"))
                                    if maybe.isSome(path) andif maybe.isSome(dir)
                                            andif maybe.isSome(source) then
                                        vector.append(result tuple
                                            let path = maybe.unwrap(path)
                                            let dir = maybe.unwrap(dir)
                                            let source = maybe.unwrap(source)
                                        end)
                                    else
                                        valid := false
                                    end
                                end
                                if valid then
                                    maybe.some(vector.toArray(result))
                                else
                                    none
                                end
                            else none
                        end
                    end
                when json.error then
                    none
                end
            end
        end

    let dependencyChange(deps: Array(InterfaceDependency) includePaths: Array(String) artifactTime: Int
            resolveSource: All(path: String fromDir: maybe.T(String) includePaths: Array(String)) maybe.T(String))
            : maybe.T(String) =
        begin
            let var change = maybe.none(:String)
            for i = 0 upto {extent deps - 1} do
                if maybe.isNone(change) then
                    let dep = deps[i]
                    let fromDir =
                        if stringOp.length(dep.dir) > 0 then
                            maybe.some(dep.dir)
                        else
                            maybe.none(:String)
                        end
                    let src = resolveSource(dep.path fromDir includePaths)
                    let shown(s: String): String = if stringOp.length(s) > 0 then s else "no source" end
                    if not(sameSource(src dep.source)) then
                        change := maybe.some("interface '" <> dep.path <> "' now resolves to "
                            <> shown(maybe.unwrapOr(src "")) <> ", not " <> shown(dep.source))
                    elsif maybe.isSome(src)
                            andif {files.modifiedNs(maybe.unwrap(src)) > artifactTime} then
                        change := maybe.some("imported interface " <> maybe.unwrap(src) <> " is newer")
                    end
                end
            end
            change
        end

    (* Whether a .qi records its interface's dependencies and none has changed
     * since it was built *)
    let dependenciesUnchanged(qi: String includePaths: Array(String)): Bool =
        begin
            let deps = recordedDependencies(qi)
            maybe.isSome(deps)
                andif maybe.isNone(dependencyChange(maybe.unwrap(deps) includePaths
                        files.modifiedNs(qi) resolveInterfaceSourceFile))
        end

    let resolveInterfaceFile(name: String currentDir: maybe.T(String) includePaths: Array(String)): maybe.T(String) =
        begin
            let source = resolveInterfaceSourceFile(name currentDir includePaths)
            let dirs = searchDirs(currentDir includePaths)
            let var found = maybe.none(:String)
            for i = 0 upto {vector.length(dirs) - 1} do
                if maybe.isNone(found) then
                    let candidate = files.join(vector.get(dirs i) lower(name) <> ".qi")
                    if system.isFile(candidate) then
                        if maybe.isNone(source) then
                            found := maybe.some(files.absolute(candidate))
                        else
                            let src = maybe.unwrap(source)
                            if abi.hasCurrentAbi(candidate)
                                    andif {files.modifiedNs(candidate) >= files.modifiedNs(src)}
                                    andif abi.builtFrom(candidate src)
                                    andif dependenciesUnchanged(candidate includePaths) then
                                found := maybe.some(files.absolute(candidate))
                            end
                        end
                    end
                end
            end
            if maybe.isSome(found) then found else source end
        end

    let searchedDirs(currentDir: maybe.T(String) includePaths: Array(String)): Array(String) =
        vector.toArray(searchDirs(currentDir includePaths))

    let canonicalRoots(includePaths: Array(String) programDir: maybe.T(String)): Array(String) =
        begin
            let roots = vector.new(:String)
            let envLib = system.getEnv("QUEST_LIB")
            if stringOp.length(envLib) > 0 then vector.append(roots files.absolute(envLib)) end
            for i = 0 upto {extent includePaths - 1} do vector.append(roots files.absolute(includePaths[i])) end
            if system.isDirectory(libDir()) then vector.append(roots libDir()) end
            vector.append(roots projectDir())
            (* Deepest first; a stable sort, as Python's *)
            let n = vector.length(roots)
            for i = 1 upto {n - 1} do
                let var j = i
                while {j > 0}
                        andif {extent files.parts(vector.get(:String roots {j - 1}))
                                < extent files.parts(vector.get(:String roots j))} do
                    let t = vector.get(roots j)
                    vector.set(roots j vector.get(roots {j - 1}))
                    vector.set(roots {j - 1} t)
                    j := j - 1
                end
            end
            if maybe.isSome(programDir) then vector.append(roots files.absolute(maybe.unwrap(programDir))) end
            (* Without repetitions, in order *)
            let unique = vector.new(:String)
            for i = 0 upto {vector.length(roots) - 1} do
                let r = vector.get(roots i)
                let var seen = false
                for j = 0 upto {vector.length(unique) - 1} do
                    if stringOp.equal(vector.get(unique j) r) then seen := true end
                end
                if not(seen) then vector.append(unique r) end
            end
            vector.toArray(unique)
        end

    let isNameComponent(s: String): Bool =
        begin
            let var good = stringOp.length(s) > 0
            for i = 0 upto {stringOp.length(s) - 1} do
                let ch = stringOp.getChar(s i)
                if not(strutil.isDigit(ch) orif strutil.isAlpha(ch)) then good := false end
            end
            good
        end

    let canonicalizeModulePath(file: String includePaths: Array(String) programDir: maybe.T(String)): String =
        begin
            let resolved = files.absolute(file)
            let var components = vector.fromArray(array of files.baseName(resolved) end)
            let roots = canonicalRoots(includePaths programDir)
            let var found = false
            for i = 0 upto {extent roots - 1} do
                if not(found) then
                    let rel = files.relativeTo(resolved roots[i])
                    if maybe.isSome(rel) then
                        components := vector.fromArray(files.parts(maybe.unwrap(rel)))
                        found := true
                    end
                end
            end
            let n = vector.length(components)
            vector.set(components {n - 1} stripUnitSuffix(vector.get(components {n - 1})))
            let b = sb.new()
            let var bad = maybe.none(:String)
            for i = 0 upto {n - 1} do
                let c = vector.get(components i)
                if i > 0 then sb.char(b '/') end
                sb.str(b c)
                if maybe.isNone(bad) andif not(isNameComponent(c)) then bad := maybe.some(c) end
            end
            let name = sb.toString(b)
            if maybe.isSome(bad) then
                diagnostics.fail(:Ok "Invalid module path '" <> name <> "' for '" <> resolved <> "': '"
                    <> maybe.unwrap(bad) <> "' contains characters other than letters and digits, which are the "
                    <> "only ones allowed in the directory and file names of interfaces and modules" 0)
            end
            name
        end

    let canonicalizeInterfaceName(
            file: maybe.T(String) includePaths: Array(String) declaredName: String programDir: maybe.T(String)
            ): String =
        if maybe.isNone(file) then
            declaredName
        else
            let canonMod = canonicalizeModulePath(maybe.unwrap(file) includePaths programDir)
            let base = lastSegment(declaredName)
            if strutil.contains(canonMod "/") then
                files.parent(canonMod) <> "/" <> base
            elsif strutil.contains(declaredName "/") then
                declaredName
            else
                base
            end
        end

    let canonicalizeModuleName(
            file: maybe.T(String) includePaths: Array(String) rawName: String programDir: maybe.T(String)
            ): String =
        if maybe.isNone(file) then
            rawName
        else
            canonicalizeModulePath(maybe.unwrap(file) includePaths programDir)
        end

    let findCanonicalModuleSource(canonName: String includePaths: Array(String) programDir: maybe.T(String))
            : maybe.T(String) =
        begin
            let relative = lower(canonName) <> ".mod.quest"
            let roots = canonicalRoots(includePaths programDir)
            let var found = maybe.none(:String)
            for i = 0 upto {extent roots - 1} do
                let candidate = files.join(roots[i] relative)
                if maybe.isNone(found) andif system.isFile(candidate)
                        andif stringOp.equal(canonicalizeModulePath(candidate includePaths programDir) canonName) then
                    found := maybe.some(files.absolute(candidate))
                end
            end
            found
        end
end
