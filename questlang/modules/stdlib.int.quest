(* Quest Self-Hosted Compiler: The Standard Library's Units Interface
 *
 * bootstrap/python/quest/modules/stdlib.py: the standard library's modules and
 * interfaces as the type checker sees them, loaded on demand into an
 * environment (its registry) and cached for the process. install makes the
 * registry every new environment gets. *)

interface Stdlib
import
    questlang/types/env : questlang/types/Env
export
    registry: env.Registry
    install(): Ok
    (* The standard library's modules, each a pair of its name and its
     * interface's (STANDARD_LIBRARY_MODULES), which the interpreter loads when
     * a program uses one without importing it *)
    standardModules: Array(Array(String))
end
