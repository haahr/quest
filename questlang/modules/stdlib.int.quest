(* Quest Self-Hosted Compiler: The Standard Library's Units Interface
 *
 * Counterpart to bootstrap/python/quest/modules/stdlib.py. This unit exposes
 * the standard library's modules and interfaces to the type checker, loading
 * them on demand into an environment via its registry and caching them for
 * the process. install sets this registry as the default for every new
 * environment. *)

interface Stdlib
import
    questlang/types/env : questlang/types/Env
export
    (* The registry that loads the standard units on demand, when an
     * environment's lookup of an interface, module, or value name finds
     * nothing: string.length needs no import *)
    registry: env.Registry
    (* Makes registry the default, which env.new gives every environment *)
    install(): Ok
    (* The standard library's modules, each a pair of its name and its
     * interface's (STANDARD_LIBRARY_MODULES), which the interpreter loads when
     * a program uses one without importing it *)
    standardModules: Array(Array(String))
end
