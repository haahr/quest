(* Quest Self-Hosted Compiler: Inlined Modules Interface
 *
 * The modules whose importers, compiled separately, inline them as a whole
 * program would (docs/inlined-modules-plan.md): each importer elaborates the
 * module's source and merges a copy of its functions and constants into its
 * own unit, while the module's state (its exceptions, strings, and variables)
 * stays its compiled object's. The library's few are fixed here; a program's
 * own are added by --inline-module. The setting is the process's, made once
 * by the driver from its options; until then, the library's. *)

interface Inlined
export
    (* The library's inlined modules, by canonical name. A module joins when
     * its gain, measured by leaving it out of a whole program (benchmarks.md
     * section 37), is worth its costs: every importer elaborates its source
     * and holds copies of what it uses, and a change to its source rebuilds
     * every importer. So it is small, called often from other modules,
     * polymorphic, and stable *)
    library: Array(String)
    (* Sets the process's inlined modules: the library's, unless withLibrary
     * is false (--no-inline-library), and extra (--inline-module), by
     * canonical name *)
    setInlined(withLibrary: Bool extra: Array(String)): Ok
    (* The largest function an importer copies from the module of canonical
     * name canonical, by the inliner's measure of its body; noBound for any.
     * What a unit copies it compiles again, so a build's cost grows with the
     * bound, and most of the gain is in the smallest functions: at
     * defaultBound a build of the compiler costs 1.3 times one without
     * copies and its code retires 7% fewer instructions, and with no bound
     * 1.8 times and 10% (docs/benchmarks.md section 41). util/iter has none: its
     * stages (map, filter) are larger, few units use them, and a pipeline
     * runs in a third of the instructions with them copied *)
    defaultBound: Int
    noBound: Int
    copyBound(canonical: String): Int
    (* Whether the module of canonical name canonical is inlined into its
     * importers *)
    isInlined(canonical: String): Bool
    (* The process's inlined modules, by canonical name, in the order given *)
    names(): Array(String)
    (* Whether names holds name, in any case *)
    isIn(names: Array(String) name: String): Bool
end
