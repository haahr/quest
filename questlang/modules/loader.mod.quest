(* Quest Self-Hosted Compiler: Unit Loader Implementation *)

module loader : Loader
import
    conv : Conv
    raised : Raised
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/files : questlang/common/Files
    questlang/common/location : questlang/common/Location
    questlang/common/maps : questlang/common/Maps
    questlang/common/pyRepr : questlang/common/PyRepr
    questlang/modules/artifacts/interfaceCompiler : questlang/modules/artifacts/InterfaceCompiler
    questlang/modules/elaboration : questlang/modules/Elaboration
    questlang/modules/graph : questlang/modules/Graph
    questlang/modules/inlined : questlang/modules/Inlined
    questlang/modules/paths : questlang/modules/Paths
    questlang/modules/resolution : questlang/modules/Resolution
    questlang/modules/units : questlang/modules/Units
    questlang/syntax/ast : questlang/syntax/AST
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
    questlang/types/symbols : questlang/types/Symbols
export
    (* The scopes of the .qi files loaded in this process, with their
     * modification times: an interface is elaborated once for all the units
     * that import it *)
    Let LoadedQi = Tuple mtime: Int scope: symbols.Scope end
    let loadedQis = maps.newStringMap(:LoadedQi)

    Let Scope = symbols.Scope

    let chain(loading: vector.T(String) last: String): String =
        begin
            if vector.length(loading) is 0 then last
            else strutil.join(" -> " loading) <> " -> " <> last
            end
        end

    (* The text of a unit's file, with its source map registered for
     * diagnostics *)
    let readUnit(file: String what: String): location.SourceMap =
        begin
            let text = files.readText(file)
            if maybe.isNone(text) then
                diagnostics.fail(:Ok "Error reading " <> what <> " file '" <> file <> "'" 0)
            end
            let sm = location.newSourceMap(files.displayName(file) maybe.unwrap(text))
            diagnostics.registerSource(sm)
            sm
        end

    (* Runs body with e's current directory set to dir and name pushed onto
     * stack; restores both even if body raises an exception *)
    let loading(A::TYPE e: env.T dir: String stack: vector.T(String) name: String body: All() A): A =
        begin
            let savedDir = e.currentDir
            e.currentDir := maybe.some(dir)
            vector.append(stack name)
            let restore = fun(): Ok
                begin
                    vector.pop(stack)
                    e.currentDir := savedDir
                end
            let result =
                try
                    body()
                else with r then
                    restore()
                    raised.reraise(:A r)
                end
            restore()
            result
        end

    (* Where an interface's artifacts are written and read: the build
     * directory; or when compiling C without one, beside its source, under the
     * search root that gives it its canonical name (adding the source's own
     * directory as a root would change that name); else none, and the
     * interface is elaborated from source *)
    let resolvedArtifactRoot(e: env.T resolved: resolution.Resolved): maybe.T(String) =
        begin
            let ancestor(path: String levels: Int): String =
                begin
                    let var d = path
                    for i = 1 upto levels do d := files.parent(d) end
                    files.absolute(d)
                end
            if maybe.isSome(e.buildDir) then
                maybe.some(files.absolute(maybe.unwrap(e.buildDir)))
            elsif not(e.importsThroughInterfaces) then
                maybe.none()
            elsif maybe.isSome(resolved.source) then
                maybe.some(ancestor(maybe.unwrap(resolved.source)
                        extent files.parts(resolution.canonicalName(resolved))))
            elsif maybe.isSome(resolved.prebuilt) andif strutil.contains(resolved.path "/") then
                maybe.some(ancestor(maybe.unwrap(resolved.prebuilt)
                        extent files.parts(paths.lower(resolved.path))))
            else
                maybe.some(files.absolute(maybe.unwrapOr(e.currentDir ".")))
            end
        end

    (* The include paths an error lists as searched for a unit's source: all
     * but the build directory, which holds only artifacts *)
    let listedIncludePaths(e: env.T): Array(String) =
        begin
            let built = if maybe.isSome(e.buildDir) then files.absolute(maybe.unwrap(e.buildDir)) else "" end
            let listed = vector.new(:String)
            for i = 0 upto {vector.length(e.includePaths) - 1} do
                let p = vector.get(e.includePaths i)
                if not(stringOp.equal(files.absolute(p) built)) then vector.append(listed p) end
            end
            vector.toArray(listed)
        end

    (* The scope of the interface name, as an import in e names it, loaded
     * from the first of:
     *
     *   1. a scope already loaded: by its canonical name in e.units, shared by
     *      every unit that imports it, or for an interface with neither a
     *      source nor a .qi (a builtin, or one the program declares), e's own
     *      registration of name;
     *   2. with an artifact root (resolvedArtifactRoot: a build directory, or
     *      C compilation), its .qi there, which
     *      ensureResolvedInterfaceArtifacts rebuilds first if stale; the
     *      scope is cached in loadedQis until the file changes;
     *   3. a fresh .qi on the search path (resolution.freshInterfaceQi: current
     *      ABI, newer than its source, and built from it);
     *   4. its .int.quest source, parsed and elaborated, whose declared name
     *      must match the file name.
     *
     * Each loaded scope is registered (register) in e under name as written,
     * its last segment (AST for questlang/syntax/AST), and its canonical name,
     * and recorded on its unit in e.units for later lookups.
     *
     * Raises a CompilerError (diagnostics.fail) for an interface that cannot
     * be found, a mismatched name, or a cycle of interface imports, found
     * from the chain e.loadingInterfaces of interfaces being loaded. The
     * bootstrap counterpart is load_interface in
     * bootstrap/python/quest/modules/loader.py. *)
    let rec loadInterface(name: String e: env.T): Scope =
        begin
            let normName = paths.lower(name)
            let resolved = env.resolveInterface(e name)
            let intSource = resolved.source
            (* Its source, else its prebuilt .qi *)
            let unitFile = if maybe.isSome(resolved.source) then resolved.source else resolved.prebuilt end
            let canon = resolution.canonicalName(resolved)
            let register(scope: Scope): Scope =
                begin
                    env.registerInterface(e name scope)
                    let declName = paths.lastSegment(name)
                    if not(stringOp.equal(declName name)) then env.registerInterface(e declName scope) end
                    if not(stringOp.equal(canon name)) then env.registerInterface(e canon scope) end
                    if maybe.isSome(unitFile) then
                        graph.unit(e.units option interfaceUnit of units.UnitKind end canon).scope := maybe.some(scope)
                    end
                    scope
                end
            let existing =
                if maybe.isNone(unitFile) then
                    env.lookupInterface(e name)
                else
                    let loaded = graph.interfaceScope(e.units canon)
                    if maybe.isSome(loaded) then maybe.some(register(maybe.unwrap(loaded))) else loaded end
                end
            if maybe.isSome(existing) then
                maybe.unwrap(existing)
            else
                (* Cycle detection *)
                for i = 0 upto {vector.length(e.loadingInterfaces) - 1} do
                    if stringOp.equal(vector.get(e.loadingInterfaces i) canon) then
                        diagnostics.fail(:Ok "Cyclic dependency detected in interface imports: "
                            <> chain(e.loadingInterfaces canon) 0)
                    end
                end
                (* The .qi records the interface's imports as written in its
                 * source, so they are resolved from there *)
                let loadQi = fun(qi: String): Scope
                    loading(e files.parent(maybe.unwrapOr(intSource qi)) e.loadingInterfaces canon
                            fun(): Scope
                                env.withUnitNames(e fun(): Scope interfaceCompiler.loadInterfaceFromQiFile(qi e)))
                (* With a build directory, or in C compilation, the interface is
                 * loaded from its .qi, which is rebuilt first if stale
                 * (docs/build-process.md section 5) *)
                let root = resolvedArtifactRoot(e resolved)
                let var fromArtifacts = maybe.none(:Scope)
                if maybe.isSome(root) then
                    let outRoot = maybe.unwrap(root)
                    let qi = interfaceCompiler.ensureResolvedInterfaceArtifacts(resolved outRoot
                            maybe.none() e.units.resolver).qiFile
                    if files.isFile(qi) then
                        (* outRoot goes first among the search roots, so that
                         * later resolutions in e (this interface's own
                         * imports, written relative to the root that gives it
                         * its canonical name, and other units' .qi files and
                         * objects) look there before any other directory: a
                         * unit found both there and in another search root,
                         * as one built with quest -c beside its source, is
                         * taken from this build. The bootstrap does the same.
                         * The tests do not depend on the order: the module
                         * tests pass with outRoot last. *)
                        env.searchFirst(e outRoot)
                        let mtime = files.modifiedNs(qi)
                        let cached = hashMap.get(loadedQis qi)
                        let scope =
                            if maybe.isSome(cached)
                                    andif {maybe.unwrap(cached).mtime >= mtime} then
                                maybe.unwrap(cached).scope
                            else
                                let s = loadQi(qi)
                                hashMap.insert(loadedQis qi tuple let mtime = mtime let scope = s end)
                                s
                            end
                        fromArtifacts := maybe.some(register(scope))
                    end
                end
                (* A fresh .qi on the search path (from a standalone
                 * compilation), else the source *)
                let fresh =
                    if maybe.isSome(fromArtifacts) then
                        maybe.none(:String)
                    else
                        resolution.freshInterfaceQi(resolved)
                    end
                if maybe.isSome(fromArtifacts) then
                    maybe.unwrap(fromArtifacts)
                elsif maybe.isNone(fresh) then
                    diagnostics.fail("Undefined interface '" <> name <> "': cannot find interface file for '"
                        <> name
                        <> "' (looked for '" <> normName <> ".qi' or '" <> normName <> ".int.quest' in "
                        <> pyRepr.strList(paths.searchedDirs(e.currentDir listedIncludePaths(e))) <> ")" 0)
                elsif strutil.endsWith(maybe.unwrap(fresh) ".qi") then
                    register(loadQi(maybe.unwrap(fresh)))
                else
                    let file = maybe.unwrap(fresh)
                    let sm = readUnit(file "interface")
                    let scope = env.withUnitSource(e location.file(sm) fun(): Scope
                        begin
                            let prog = units.parseUnit(sm)
                            let decl =
                                case units.unitDeclaration(prog file)
                                    when interfaceDecl with d then d.decl
                                    else diagnostics.internal(:ast.InterfaceDecl "not an interface" 0)
                                end
                            if not(stringOp.equal(paths.lower(decl.name) paths.lastSegment(normName))) then
                                diagnostics.fail(:Ok "Interface declared in '" <> files.baseName(file)
                                    <> "' has name '"
                                    <> decl.name <> "', which does not match file name" 0)
                            end
                            let typed = loading(e files.parent(file) e.loadingInterfaces canon
                                    fun(): typedAst.Binding
                                        env.withUnitNames(e fun(): typedAst.Binding
                                            elaboration.elaborateInterface(decl 0 e)))
                            let s =
                                case typed.form
                                    when bindInterface with x then x.scope
                                    else diagnostics.internal(:Scope "not an interface" 0)
                                end
                            if not(stringOp.equal(decl.name name)) then env.registerInterface(e decl.name s) end
                            s
                        end)
                    register(scope)
                end
            end
        end

    and loadModule(name: String expectedInterface: String e: env.T): typedAst.Binding =
        begin
            let resolved = env.resolveModule(e name)
            let filePath = resolved.source
            let canon = resolution.canonicalName(resolved)
            let u = graph.unit(e.units option moduleUnit of units.UnitKind end canon)
            if maybe.isSome(u.typedModule) then
                maybe.unwrap(u.typedModule)
            else
                (* Cycle detection *)
                for i = 0 upto {vector.length(e.loadingModules) - 1} do
                    if stringOp.equal(paths.lower(vector.get(e.loadingModules i)) paths.lower(canon)) then
                        diagnostics.fail(:Ok "Cyclic dependency detected in module imports: "
                            <> chain(e.loadingModules canon) 0)
                    end
                end
                let synthesizePrecompiled(): typedAst.Binding =
                    begin
                        let found = env.lookupInterface(e expectedInterface)
                        let target =
                            if maybe.isSome(found) then
                                maybe.unwrap(found)
                            else
                                loadInterface(expectedInterface e)
                            end
                        (* All importers share one export scope. Its opaque
                         * types are named after the module's declared name,
                         * as elaborating its source does, and those the module
                         * defines as external types are those types, as
                         * separately compiled modules have them (raised.T must
                         * be the type of an else binder, docs/raised.md
                         * section 3.2), else os/code's value.T would differ
                         * from os/value's. *)
                        let exportScope =
                            if maybe.isSome(u.exportScope) then
                                maybe.unwrap(u.exportScope)
                            else
                                let externalTypes = elaboration.extractModuleExternalTypes(filePath)
                                let s =
                                    elaboration.createModuleExportScope(paths.declaredModuleName(filePath canon) canon
                                            target e maybe.some(externalTypes))
                                u.exportScope := maybe.some(s)
                                s
                            end
                        env.registerModule(e canon exportScope)
                        if not(stringOp.equal(name canon)) then env.registerModule(e name exportScope) end
                        let typed = typedAst.binding(0 option bindModule of typedAst.BindingForm with
                            let name = canon
                            let interfaceName = expectedInterface
                            let bindings = array of :typedAst.Binding end
                            let scope = exportScope
                            let isPrecompiled = true
                            let symbolId = maybe.none()
                        end)
                        u.typedModule := maybe.some(typed)
                        typed
                    end
                (* An inlined module with a source is elaborated from it when
                 * compiling to C, for importers to copy from (ir/opened),
                 * though its object is built apart, as the build has marked
                 * it *)
                let opened =
                    e.importsThroughInterfaces andif e.openInlined andif inlined.isInlined(canon)
                        andif maybe.isSome(filePath)
                if u.precompiled andif not(opened) then
                    synthesizePrecompiled()
                elsif e.importsThroughInterfaces andif {strutil.contains(canon "/") orif strutil.contains(name "/")}
                        andif maybe.isSome(filePath) andif not(opened) then
                    (* Separate compilation of hierarchical modules: importers
                     * are typed against the module's interface, and building
                     * its object is left to the build (docs/build-process.md
                     * section 7.3) *)
                    u.precompiled := true
                    synthesizePrecompiled()
                elsif maybe.isNone(filePath) then
                    (* Without a source, the module's canonical name is the name
                     * imported *)
                    let objFile = paths.resolveObjectFile(name e.currentDir vector.toArray(e.includePaths))
                    if maybe.isSome(objFile) then
                        u.precompiled := true
                        synthesizePrecompiled()
                    else
                        let normName = paths.lower(name)
                        diagnostics.fail("Undefined module '" <> name <> "': cannot find module file for '"
                            <> name <> "' (looked for '" <> normName <> ".mod.quest' or '" <> normName <> ".o' in "
                            <> pyRepr.strList(paths.searchedDirs(e.currentDir listedIncludePaths(e))) <> ")" 0)
                    end
                else
                    loadModuleSource(name expectedInterface e maybe.unwrap(filePath) canon u)
                end
            end
        end

    (* Elaborates the module in file (with unit u and canonical name canon) for
     * loadModule. The file must hold just one module declaration, named for
     * the file, implementing expectedInterface. The module's own interface is
     * loaded as its header names it, from the module's directory; if that name
     * finds no source there, the scope the importer knows as expectedInterface
     * stands in for it. The module is elaborated in a fresh scope above e's
     * base scope, so that it sees only the builtins and its own imports, and
     * e's current scope is restored after, even if elaboration raises. The
     * result is renamed to canon, the name C symbols use for it, and
     * registered in e under name and canon. *)
    and loadModuleSource(
            name: String expectedInterface: String e: env.T file: String canon: String u: graph.Unit
            ): typedAst.Binding =
        begin
            let sm = readUnit(file "module")
            let fileName = files.baseName(file)
            let typed = env.withUnitSource(e location.file(sm) fun(): typedAst.Binding
                begin
                    let prog = units.parseUnit(sm)
                    let phrases = prog.form.phrases
                    let n = vector.length(phrases)
                    if n isnot 1 then
                        diagnostics.fail(:Ok "Module file '" <> fileName
                            <> "' must contain only a single module definition, "
                            <> "but found " <> conv.int(n) <> " phrases" 0)
                    end
                    let p = vector.get(phrases 0)
                    let decl =
                        case p.form
                            when phraseModule with x then x.modDecl
                            else
                                diagnostics.fail(:ast.ModuleDecl "Expected module definition in '" <> fileName
                                    <> "', but found " <> units.phraseClassName(p) 0)
                        end
                    let normName = paths.lower(name)
                    let expectedBase = paths.lower(stringOp.getSub(fileName 0 strutil.find(fileName ".")))
                    if not(stringOp.equal(paths.lower(decl.name) expectedBase))
                            orif not(stringOp.equal(paths.lower(decl.name) paths.lastSegment(normName))) then
                        diagnostics.fail(:Ok "Module declared in '" <> fileName <> "' has name '" <> decl.name
                            <> "', which does not match file name" 0)
                    end
                    if not(stringOp.equal(decl.interfaceName expectedInterface))
                            andif not(stringOp.equal(paths.lastSegment(decl.interfaceName) expectedInterface))
                            andif not(stringOp.equal(decl.interfaceName paths.lastSegment(expectedInterface))) then
                        diagnostics.fail(:Ok "Module '" <> decl.name <> "' in '" <> fileName
                            <> "' implements interface '"
                            <> decl.interfaceName <> "', expected '" <> expectedInterface <> "'" 0)
                    end
                    (* The interface the importer expects, which the module's
                     * header names unless it cannot be resolved from the
                     * module's directory *)
                    let importerInterface = env.lookupInterface(e expectedInterface)
                    let savedScope = e.currentScope
                    let restoreScope = fun(): Ok e.currentScope := savedScope
                    let elaborated =
                        try
                            loading(e files.parent(file) e.loadingModules canon fun(): typedAst.Binding
                                env.withUnitNames(e fun(): typedAst.Binding
                                    begin
                                        if maybe.isSome(importerInterface)
                                                andif maybe.isNone(env.resolveInterface(e
                                                        decl.interfaceName).source) then
                                            env.registerInterface(e decl.interfaceName maybe.unwrap(importerInterface))
                                        elsif maybe.isNone(env.lookupInterface(e decl.interfaceName)) then
                                            loadInterface(decl.interfaceName e)
                                            ok
                                        end
                                        e.currentScope :=
                                                symbols.newScope(maybe.some(e.baseScope) "temp_load_" <> decl.name)
                                        elaboration.elaborateModule(decl p.span.startOffset e)
                                    end))
                        else with r then
                            begin
                                restoreScope()
                                raised.reraise(:typedAst.Binding r)
                            end
                        end
                    restoreScope()
                    elaborated
                end)
            (* The module is named in C symbols by its canonical name, as
             * importers refer to it *)
            let named =
                case typed.form
                    when bindModule with x then
                        if stringOp.equal(paths.lower(x.name) paths.lower(canon)) then
                            typed
                        else
                            typedAst.binding(typed.offset option bindModule of typedAst.BindingForm with
                                let name = canon
                                let interfaceName = x.interfaceName
                                let bindings = x.bindings
                                let scope = x.scope
                                let isPrecompiled = x.isPrecompiled
                                let symbolId = x.symbolId
                            end)
                        end
                    else typed
                end
            let scope = elaboration.moduleScope(named)
            env.registerModule(e name scope)
            if not(stringOp.equal(canon name)) then env.registerModule(e canon scope) end
            u.typedModule := maybe.some(named)
            named
        end

    let install(): Ok =
        begin
            elaboration.hooks.loadInterface := loadInterface
            elaboration.hooks.loadModule := loadModule
        end
end
