(* Quest Self-Hosted Compiler: Contractiveness of Recursive Types
 * Implementation *)

module contractiveness : Contractiveness
import
    conv : Conv

    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/maps : questlang/common/Maps
    questlang/types/env : questlang/types/Env
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
export
    Let Type = model.Type
    Let Ids = maps.IntSet

    let maxTypeExpansionDepth = 500

    let newIds(): Ids = maps.newIntSet()

    let plus(ids: Ids id: Int): Ids =
        begin
            let more = hashSet.copy(ids)
            hashSet.insert(more id)
            more
        end

    let union(a: Ids b: Ids): Ids =
        begin
            let both = hashSet.copy(a)
            hashSet.forEach(b fun(k: Int): Ok begin hashSet.insert(both k) ok end)
            both
        end

    let has(ids: Ids id: Int): Bool = hashSet.contains(ids id)

    (* Returns whether t is contractive in ids (Cardelli and Longo 1991,
     * section 2.4). Primitive types and type constructors are contractive; a
     * type variable is contractive in ids when its symbol id is not in ids;
     * All(X' :: K) B is contractive when B is; a type application is
     * contractive when its evaluated constructor is (evaluation has already
     * reduced applications of type operators); Rec(X') B is contractive when B
     * is contractive in both X' and ids; and a mutually recursive group binding
     * is contractive when its body is contractive in ids together with all
     * bindings in the group.
     *
     * When e is present, lazy evaluation follows type variables' definitions
     * through the global symbol table. depth counts nested calls against
     * maxTypeExpansionDepth. *)
    let rec contractive(t: Type ids: Ids e: maybe.T(env.T) depth: Int): Bool =
        begin
            if depth > maxTypeExpansionDepth then
                diagnostics.raiseError(:Ok tuple
                    let message = "Fatal compiler error: Type contractiveness check exceeded recursion depth of "
                        <> conv.int(maxTypeExpansionDepth)
                    let offset = 0
                    let length = 1
                    let isFatal = true
                    let help = maybe.none()
                    let notes = vector.fromArray(array of
                        "Compiler terminated to prevent infinite recursion during typechecking."
                    end)
                    let file = maybe.none()
                    let silent = false
                    let labels = vector.new()
                end)
            end
            let lookup = if maybe.isSome(e) then symbols.lookup else model.noLookup end
            let lazy = model.evaluateLazily(t lookup)
            case lazy.form
                (* Evaluation has followed the variable's definition, if it
                 * has one, so this variable has none *)
                when typeVariable with x then not(has(ids x.symbolId))
                (* An unsolved metavariable (an inference placeholder;
                 * evaluateLazily looks through solved ones) is not a recursive
                 * variable, so it is contractive *)
                when typeMeta then true
                when typeRec with x then
                    contractive(x.body plus(newIds() x.symbolId) e {depth + 1})
                        andif contractive(x.body ids e {depth + 1})
                when typeRecGroup with x then
                    begin
                        let groupIds = newIds()
                        for i = 0 upto {extent x.bindings - 1} do
                            hashSet.insert(groupIds x.bindings[i].symbolId)
                        end
                        contractive(x.bindings[x.activeIndex].body union(ids groupIds) e {depth + 1})
                    end
                when typeAll with x then contractive(x.body ids e {depth + 1})
                when typeApp with x then contractive(model.evaluateLazily(x.constructor lookup) ids e {depth + 1})
                else true
            end
        end

    let isTypeContractive(t: Type ids: Ids e: maybe.T(env.T)): Bool = contractive(t ids e 0)

    let checkTypeContractive(t: Type ids: Ids varName: String offset: Int e: maybe.T(env.T)): Ok =
        if not(isTypeContractive(t ids e)) then
            diagnostics.raiseError(:Ok tuple
                let message = "Recursive type '" <> varName <> "' is not contractive; "
                    <> "recursive type variable must be guarded by a constructor"
                let offset = offset
                let length = 1
                let isFatal = false
                let help =
                    maybe.some("ensure recursive variable appears inside a record, tuple, function, option, variant, or "
                        <> "array type")
                let notes = vector.fromArray(array of
                    "definition of '" <> varName <> "' refers directly to itself as a bare alias without a "
                        <> "guarding constructor"
                end)
                let file = maybe.none()
                let silent = false
                let labels = vector.new()
            end)
        end
end
