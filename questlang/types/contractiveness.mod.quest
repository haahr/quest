(* Quest Self-Hosted Compiler: Contractiveness of Recursive Types
 * Implementation *)

module contractiveness : Contractiveness
import
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
    questlang/types/env : questlang/types/Env
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    conv : Conv
export
    Let Type = model.Type
    Let Ids = hashMap.T(Int Bool)

    let maxTypeExpansionDepth = 500

    let intEqual(a: Int b: Int): Bool = a is b
    let newIds(): Ids = hashMap.new(intEqual hash.int)

    (* ids with one more *)
    let copy(ids: Ids): Ids = hashMap.filter(ids fun(k: Int v: Bool): Bool true)

    let plus(ids: Ids id: Int): Ids =
        begin
            let more = copy(ids)
            hashMap.insert(more id true)
            more
        end

    let union(a: Ids b: Ids): Ids =
        begin
            let both = copy(a)
            hashMap.forEach(b fun(k: Int v: Bool): Ok begin hashMap.insert(both k true) ok end)
            both
        end

    let has(ids: Ids id: Int): Bool = hashMap.contains(ids id)

    (* Whether t is contractive in ids (Cardelli and Longo, section 2.4):
     * primitive types and type constructors are contractive; a variable is
     * contractive in X iff it is not X; All(X' :: K) B iff B is; an
     * application iff its (opaque, since evaluation reduces applications of
     * type operators) constructor is; Rec(X') B iff B is in X' and in X.
     *
     * Given an environment, evaluation follows type variables' definitions
     * through it. depth counts the nested calls, against
     * maxTypeExpansionDepth. *)
    let rec contractive(t: Type ids: Ids e: maybe.T(env.T) depth: Int): Bool =
        begin
            if depth > maxTypeExpansionDepth then
                diagnostics.raiseError(:Ok tuple
                    let message = "Fatal compiler error: Type contractiveness check exceeded recursion depth of " <>
                        conv.int(maxTypeExpansionDepth)
                    let offset = 0
                    let length = 1
                    let isFatal = true
                    let help = maybe.none()
                    let notes = vector.fromArray(array of
                        "Compiler terminated to prevent infinite recursion during typechecking."
                    end)
                    let file = maybe.none()
                    let silent = false
                    let labels = vector.new()
                end)
            end
            let lookup = if maybe.isSome(e) then symbols.lookup else model.noLookup end
            let lazy = model.evaluateLazily(t lookup)
            case lazy.form
                (* Evaluation has followed the variable's definition, if it
                 * has one, so this variable has none *)
                when typeVariable with x then not(has(ids x.symbolId))
                (* An unsolved metavariable (evaluateLazily looks through a
                 * solved one) is not a recursive variable, so it is
                 * contractive *)
                when typeMeta then true
                when typeRec with x then
                    contractive(x.body plus(newIds() x.symbolId) e {depth + 1}) andif
                        contractive(x.body ids e {depth + 1})
                when typeRecGroup with x then
                    begin
                        let groupIds = newIds()
                        for i = 0 upto {extent x.bindings - 1} do
                            hashMap.insert(groupIds x.bindings[i].symbolId true)
                        end
                        contractive(x.bindings[x.activeIndex].body union(ids groupIds) e {depth + 1})
                    end
                when typeAll with x then contractive(x.body ids e {depth + 1})
                when typeApp with x then contractive(model.evaluateLazily(x.constructor lookup) ids e {depth + 1})
                else true
            end
        end

    let isTypeContractive(t: Type ids: Ids e: maybe.T(env.T)): Bool = contractive(t ids e 0)

    let checkTypeContractive(t: Type ids: Ids varName: String offset: Int e: maybe.T(env.T)): Ok =
        if not(isTypeContractive(t ids e)) then
            diagnostics.raiseError(:Ok tuple
                let message = "Recursive type '" <> varName <> "' is not contractive; " <>
                    "recursive type variable must be guarded by a constructor"
                let offset = offset
                let length = 1
                let isFatal = false
                let help = maybe.some("ensure recursive variable appears inside a record, tuple, function, option, variant, or " <>
                        "array type")
                let notes = vector.fromArray(array of
                    "definition of '" <> varName <> "' refers directly to itself as a bare alias without a " <>
                        "guarding constructor"
                end)
                let file = maybe.none()
                let silent = false
                let labels = vector.new()
            end)
        end
end
