(* Quest Self-Hosted Compiler: Symbols and Lexical Scopes Interface
 *
 * Defines symbols and lexical scopes, matching
 * bootstrap/python/quest/types/symbols.py. Symbols name values, types, and
 * kinds; a scope holds the symbols declared in it, in declaration order. Type
 * and kind symbol ids are unique for the life of the process
 * (allocateSymbolId), and every declared type and kind symbol is also found
 * globally by its id. Value symbol ids come from a separate counter
 * (newValueSymbol), so a value id can equal a type or kind id. This module
 * sits below subtyping and the unit graph, which need symbols and scopes
 * without depending on the type-checking environment (types/env).
 * docs/type-system.md §5 describes symbols and scopes, and §2.2 (Symbols
 * resolve globally) describes lookup by id. *)

interface Symbols
import
    questlang/types/model : questlang/types/Model
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
export
    (* Raised when a type symbol that has a definition is given another *)
    redefined: Exception(String)

    (* ======================================================================
     * 1. Symbols
     * ====================================================================== *)

    (* A value: x : Type. Its id, if not given, comes from a counter of value
     * symbols of its own. *)
    Def ValueSymbol = Tuple
        name: String
        type: model.Type
        isVar: Bool
        isOut: Bool
        (* isParam records whether this is a function parameter, and
         * functionDepth counts the functions enclosing its declaration (a
         * parameter counts its own function). Together they determine what a
         * function body may capture (docs/type-system.md §6.2.3): a closure
         * may not capture a var or out parameter of an enclosing function (it
         * holds the address of its caller's location), and no function may use
         * a top-level var directly (checker.checkCapturable). *)
        isParam: Bool
        functionDepth: Int
        symbolId: Int
    end

    (* A type: X :: Kind [= Definition]. A definition may be supplied after
     * declaration (defineType) but never replaced: a symbol id means one thing
     * for the life of the process. *)
    Def TypeSymbol = Tuple
        name: String
        symbolId: Int
        kind: model.Kind
        var definition: maybe.T(model.Type)
    end

    (* A kind: K = Kind *)
    Def KindSymbol = Tuple name: String symbolId: Int kind: model.Kind end

    Def Symbol = Option
        valueSymbol with sym: ValueSymbol end
        typeSymbol with sym: TypeSymbol end
        kindSymbol with sym: KindSymbol end
    end

    (* A value symbol with the counter's next id if symbolId is 0 *)
    newValueSymbol(
        name: String type: model.Type isVar: Bool isOut: Bool isParam: Bool functionDepth: Int symbolId: Int
    ): ValueSymbol
    (* A plain value symbol: not var, out, or a parameter, at function depth
     * 0 *)
    valueSymbol(name: String type: model.Type): ValueSymbol

    newTypeSymbol(name: String symbolId: Int kind: model.Kind definition: maybe.T(model.Type)): TypeSymbol
    (* Supplies a type symbol's definition (the bootstrap's assignment to
     * TypeSymbol.definition); raises redefined if it has another *)
    defineType(sym: TypeSymbol definition: model.Type): Ok
    isAbstract(sym: TypeSymbol): Bool

    newKindSymbol(name: String symbolId: Int kind: model.Kind): KindSymbol

    symbolName(s: Symbol): String

    (* ======================================================================
     * 2. Scopes
     * ====================================================================== *)

    (* One frame of a chain of lexical scopes: the symbols declared directly
     * in one block, function, interface, module, or other construct, and a
     * link to the frame around it (parent).
     *
     * Values, types, and kinds have namespaces of their own, so that
     * Let T = Int and let T: T = 1 may stand side by side. In a namespace, a
     * later declaration of a name hides an earlier one in the same frame, as
     * in
     *
     *     begin let x = 1 let x = x + 1 x end
     *
     * where the second x is a new symbol; declarations keeps both, in order.
     *
     * lookupValue, lookupType, and lookupKind search this frame and then each
     * enclosing one, out to the outermost (for a program's scopes, the
     * environment's base scope, which holds the builtins); the Local lookups
     * search this frame alone. Types and kinds are also found by symbol id
     * (lookupTypeById, lookupKindById), since the types that refer to them
     * hold ids (a typeVariable holds its symbolId), not names.
     *
     * Declaring a type or kind also records it by id in a table global to the
     * program. If that gives a meaning to an id that a lookup had found
     * without one, or changes the meaning an id had, the declaration calls
     * meaningsChanged, so that cached subtyping results, which may depend on
     * the old meaning, are not reused. *)
    Def Rec Scope = Tuple
        parent: maybe.T(Scope)
        name: String
        var moduleName: maybe.T(String)
        (* Whether this is an unsound interface's scope *)
        var isUnsound: Bool
        (* Whether the var variables it declares are local (env.localScoped),
         * not global: a block's, a function's, a tuple's, a branch's, a for
         * loop's *)
        var isLocal: Bool
        var declarations: vector.T(Symbol)
        var values: hashMap.T(String ValueSymbol)
        var types: hashMap.T(String TypeSymbol)
        var typesById: hashMap.T(Int TypeSymbol)
        var kinds: hashMap.T(String KindSymbol)
        var kindsById: hashMap.T(Int KindSymbol)
    end

    newScope(parent: maybe.T(Scope) name: String): Scope

    declareValue(s: Scope sym: ValueSymbol): ValueSymbol
    declareType(s: Scope sym: TypeSymbol): TypeSymbol
    declareTypeVariable(
        s: Scope name: String symbolId: Int kind: model.Kind definition: maybe.T(model.Type)
    ): TypeSymbol
    declareKind(s: Scope sym: KindSymbol): KindSymbol

    lookupValueLocal(s: Scope name: String): maybe.T(ValueSymbol)
    lookupTypeLocal(s: Scope name: String): maybe.T(TypeSymbol)
    lookupTypeByIdLocal(s: Scope symbolId: Int): maybe.T(TypeSymbol)
    lookupKindLocal(s: Scope name: String): maybe.T(KindSymbol)
    lookupKindByIdLocal(s: Scope symbolId: Int): maybe.T(KindSymbol)

    (* Through the scope and its parents *)
    lookupValue(s: Scope name: String): maybe.T(ValueSymbol)
    lookupType(s: Scope name: String): maybe.T(TypeSymbol)
    lookupTypeById(s: Scope symbolId: Int): maybe.T(TypeSymbol)
    lookupKind(s: Scope name: String): maybe.T(KindSymbol)
    lookupKindById(s: Scope symbolId: Int): maybe.T(KindSymbol)

    (* ======================================================================
     * 3. Symbol ids and meanings
     * ====================================================================== *)

    (* A globally unique positive symbol id *)
    allocateSymbolId(): Int

    (* Looks up any declared type or kind symbol globally by id. A lookup that
     * finds nothing, or finds a type without a definition, records the id as
     * seen undefined (the bootstrap's Environment.lookup_type_by_id and
     * lookup_kind_by_id). *)
    typeSymbolById(symbolId: Int): maybe.T(TypeSymbol)
    kindSymbolById(symbolId: Int): maybe.T(KindSymbol)

    (* The definitions and kinds of symbols by id, globally, for lazy
     * evaluation *)
    lookup: model.Lookup

    (* meaningGeneration returns the counter incremented by meaningsChanged
     * whenever a symbol id gains or changes a meaning after a lookup saw it
     * undefined; cached type judgments (the subtype cache) go stale only
     * then *)
    meaningsChanged(): Ok
    meaningGeneration(): Int

    (* =========================================================================
     * 4. Poisoned symbols
     *
     * Failed declarations bind their names to poisoned symbols so that later
     * uses fail without cascading errors (diagnostics.silentError;
     * docs/diagnostics.md §4.5). Value symbols are tracked by their own id
     * space, separately from type and kind symbols.
     * ====================================================================== *)

    poisonValue(symbolId: Int): Ok
    isPoisonedValue(symbolId: Int): Bool
    poison(symbolId: Int): Ok
    isPoisoned(symbolId: Int): Bool
end
