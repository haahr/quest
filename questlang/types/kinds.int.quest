(* Quest Self-Hosted Compiler: Kind Synthesis and Checking Interface
 *
 * Checks kind well-formedness, synthesizes and checks kinds of types, and
 * resolves types to the record, variant, option, or tuple types they are
 * bounded by (counterpart: bootstrap/python/quest/types/kinds.py). A kind is
 * the type of a type (TYPE, POWER(B), or ALL(X::K1) K2 for a type operator;
 * see model.Kind), and kind checking rejects malformed types such as Int(Bool)
 * or a type argument outside its parameter's bound. docs/type-system.md §3.1
 * specifies subkinding, and §2.2 describes the per-check kind memo. A kind
 * error raises diagnostics.compilerError at offset 0 (the bootstrap's
 * KindError). The environment is optional, as in the bootstrap: without one,
 * type variables are not resolved and binders are not declared. *)

interface Kinds
import
    questlang/types/model : questlang/types/Model
    questlang/types/env : questlang/types/Env
    util/maybe : util/Maybe
export
    Def Env = maybe.T(env.T)

    checkKindWellFormed(kind: model.Kind e: Env): Ok
    (* Checks that t has a kind that is a subkind of expected *)
    checkKind(t: model.Type expected: model.Kind e: Env): Ok
    (* The most specific kind of t; results are memoized for the duration of the
     * outermost call *)
    synthKind(t: model.Type e: Env): model.Kind

    (* One step of exposing the structure of t: unfolds a recursive type or
     * reduces a type operator application, and returns none otherwise *)
    unfoldHead(t: model.Type): maybe.T(model.Type)

    (* Resolves t (unfolding recursive types, reducing applications, and
     * following POWER bounds of type variables, abstract types, and path
     * types) to a record, variant, sum (variant or option), or tuple type, or
     * returns none if no such bound exists *)
    resolveRecordBound(t: model.Type e: Env): maybe.T(model.Type)
    resolveVariantBound(t: model.Type e: Env): maybe.T(model.Type)
    resolveSumBound(t: model.Type e: Env): maybe.T(model.Type)
    resolveTupleBound(t: model.Type e: Env): maybe.T(model.Type)
    (* An option type, through applications, recursive types, and bounds *)
    resolveOptionBound(t: model.Type e: Env): maybe.T(model.Type)
end
