(* Quest Self-Hosted Compiler: Kind Synthesis and Checking Interface
 *
 * The kinds of bootstrap/python/quest/types/kinds.py: well-formedness of kinds, kind synthesis and checking of
 * types, and the resolution of types to the record, variant, option, or tuple types they are bounded by. A kind error
 * raises diagnostics.compilerError, at offset 0 (the bootstrap's KindError). The environment is optional, as the
 * bootstrap's is: without one, type variables are not resolved and binders are not declared. *)

interface Kinds
import
    questlang/types/model : questlang/types/Model
    questlang/types/env : questlang/types/Env
    util/maybe : util/Maybe
export
    Def Env = maybe.T(env.T)

    checkKindWellFormed(kind: model.Kind e: Env): Ok
    (* Checks that t has a kind that is a subkind of expected *)
    checkKind(t: model.Type expected: model.Kind e: Env): Ok
    (* The most specific kind of t; results are memoized for the duration of the outermost call *)
    synthKind(t: model.Type e: Env): model.Kind

    (* One step of exposing the structure of t: a recursive type unfolded, or an application of a type operator
     * reduced; none for an application of anything else *)
    unfoldHead(t: model.Type): maybe.T(model.Type)

    (* t, or the upper bound of a type variable or path type (through bounds that are bounded variables), if a record
     * type (a variant, a variant or option, a tuple); recursive types are unfolded *)
    resolveRecordBound(t: model.Type e: Env): maybe.T(model.Type)
    resolveVariantBound(t: model.Type e: Env): maybe.T(model.Type)
    resolveSumBound(t: model.Type e: Env): maybe.T(model.Type)
    resolveTupleBound(t: model.Type e: Env): maybe.T(model.Type)
    (* An option type, through applications, recursive types, and bounds *)
    resolveOptionBound(t: model.Type e: Env): maybe.T(model.Type)
end
