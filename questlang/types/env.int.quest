(* Quest Self-Hosted Compiler: Type-Checking Environments Interface
 *
 * The type-checking environment of bootstrap/python/quest/types/env.py: the
 * active scope stack, with the builtins in a base scope and a global scope
 * above it, the interfaces and modules in scope, and the standard library's
 * registry, which loads its interfaces and modules on demand. (The units loaded
 * from files come with the module system, Milestone 2 step 6.) *)

interface Env
import
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
    questlang/types/subtyping : questlang/types/Subtyping
    questlang/modules/graph : questlang/modules/Graph
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
export
    (* The operand and result types of the built-in infix operators, which the
     * environment declares as functions (the bootstrap's INFIX_OPERATORS), in
     * the bootstrap's order *)
    Def InfixOperator = Tuple op: String left: model.Type right: model.Type result: model.Type end
    infixOperators: Array(InfixOperator)
    infixOperator(op: String): maybe.T(InfixOperator)

    Def Rec T = Tuple
        baseScope: symbols.Scope
        globalScope: symbols.Scope
        var currentScope: symbols.Scope
        (* The interfaces and modules named in the unit being elaborated: the
         * builtins and the unit's imports *)
        var interfaces: hashMap.T(String symbols.Scope)
        var modules: hashMap.T(String symbols.Scope)
        var builtinInterfaces: hashMap.T(String symbols.Scope)
        var builtinModules: hashMap.T(String symbols.Scope)
        includePaths: vector.T(String)
        var currentDir: maybe.T(String)
        (* The directory of the program being compiled, which names units under
         * no include root *)
        var programDir: maybe.T(String)
        (* The file of the unit being elaborated, where errors raised inside are
         * located *)
        var sourceFile: String
        loadingInterfaces: vector.T(String)
        loadingModules: vector.T(String)
        var registry: maybe.T(Registry)
        (* The units loaded, with the resolver of imports *)
        var units: graph.UnitGraph
        (* Where errors that do not stop elaboration are reported (the
         * bootstrap's sink) *)
        var report: maybe.T(All(err: diagnostics.CompilerError) Ok)
        (* The imports whose units are being loaded, outermost first *)
        importStack: vector.T(ImportSite)
        (* Where interfaces' artifacts are read and written (the bootstrap's
         * options.build_dir), and whether the unit is being compiled to C, in
         * which modules are known through their interfaces alone (the
         * bootstrap's is_c_compilation_mode) *)
        var buildDir: maybe.T(String)
        var compilingC: Bool
        (* Whether a unit file is being compiled alone (-c), in which an
         * imported module's external types are named as their bindings name
         * them *)
        var compilingUnit: Bool
    end
    (* An import, in the file that makes it *)
    and ImportSite = Tuple file: String offset: Int length: Int end
    (* The standard library's interfaces and modules, loaded on demand into an
     * environment (the bootstrap's BuiltinRegistry, which modules/stdlib
     * provides) *)
    and Registry = Tuple
        ensureInterface: All(name: String e: T) maybe.T(symbols.Scope)
        ensureModule: All(name: String e: T) maybe.T(symbols.Scope)
    end

    (* The registry an environment gets unless given one (the bootstrap's
     * set_default_builtin_registry) *)
    setDefaultRegistry(r: maybe.T(Registry)): Ok
    (* An environment with the default registry *)
    new(): T
    (* An environment with the given registry, or none *)
    newWith(registry: maybe.T(Registry)): T

    (* The lookups of symbols by id, globally, for subtyping and lazy
     * evaluation *)
    lookupOf(e: T): subtyping.Env
    freshSymbolId(e: T): Int

    pushScope(e: T name: String): symbols.Scope
    popScope(e: T): symbols.Scope
    (* body in a new child scope, which is popped even if body raises an error
     * (diagnostics.compilerError) *)
    scoped(A::TYPE e: T name: String body: All(s: symbols.Scope) A): A

    declareTypeVariable(
        e: T name: String symbolId: Int kind: model.Kind definition: maybe.T(model.Type)
    ): symbols.TypeSymbol

    (* A value, loading a standard library module of the name if there is none
     * in scope *)
    lookupValue(e: T name: String): maybe.T(symbols.ValueSymbol)
    lookupType(e: T name: String): maybe.T(symbols.TypeSymbol)
    lookupTypeById(e: T symbolId: Int): maybe.T(symbols.TypeSymbol)
    lookupKind(e: T name: String): maybe.T(symbols.KindSymbol)
    lookupKindById(e: T symbolId: Int): maybe.T(symbols.KindSymbol)

    registerInterface(e: T name: String scope: symbols.Scope): Ok
    lookupInterface(e: T name: String): maybe.T(symbols.Scope)
    registerModule(e: T name: String scope: symbols.Scope): Ok
    lookupModule(e: T name: String): maybe.T(symbols.Scope)

    (* body elaborating a unit of file: errors raised inside are located
     * there *)
    withUnitSource(A::TYPE e: T file: String body: All() A): A
    (* An interface or module path resolved as e imports it: from its current
     * directory, with its search paths and program directory *)
    (* body loading the unit the import at offset (in the file being elaborated)
     * names: an error that propagates out of it is located there
     * (diagnostics.atImport) *)
    atImport(A::TYPE e: T offset: Int length: Int body: All() A): A
    (* An error found while loading units, located as if it had propagated out
     * of them: in the unit being elaborated, with the imports that loaded it *)
    locate(e: T err: diagnostics.CompilerError): diagnostics.CompilerError

    resolveInterface(e: T name: String): graph.Resolved
    resolveModule(e: T name: String): graph.Resolved

    (* body with only the builtin interface and module names registered, so that
     * a unit loaded from a file resolves its imports from its own directory;
     * the importer's names are restored afterwards *)
    withUnitNames(A::TYPE e: T body: All() A): A

    (* The environment's state, for restore (the REPL rolls back an input that
     * failed): the interfaces and modules named, the units loaded, and the
     * current scope's declarations. Symbol ids are not reused: the bootstrap's
     * snapshot records its counter, but its ids come from a global allocator
     * that a restore leaves alone *)
    Def Snapshot = Tuple
        interfaces: hashMap.T(String symbols.Scope)
        modules: hashMap.T(String symbols.Scope)
        units: graph.Snapshot
        declarations: vector.T(symbols.Symbol)
        values: hashMap.T(String symbols.ValueSymbol)
        types: hashMap.T(String symbols.TypeSymbol)
        typesById: hashMap.T(Int symbols.TypeSymbol)
        kinds: hashMap.T(String symbols.KindSymbol)
        kindsById: hashMap.T(Int symbols.KindSymbol)
    end
    snapshot(e: T): Snapshot
    (* Puts the state back as snap found it; snap can be restored again *)
    restore(e: T snap: Snapshot): Ok
end
