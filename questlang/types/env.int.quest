(* Quest Self-Hosted Compiler: Type-Checking Environments Interface
 *
 * Defines the type-checking environment (the bootstrap's
 * bootstrap/python/quest/types/env.py). It holds the active lexical scope
 * stack (with built-ins in a base scope and a global scope above it), the
 * interfaces and modules in scope, and the standard library registry that loads
 * standard interfaces and modules on demand. Units loaded from files are
 * managed by questlang/modules; docs/type-system.md §5.1 describes the two root
 * scopes. *)

interface Env
import
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/maps : questlang/common/Maps
    questlang/modules/graph : questlang/modules/Graph
    questlang/modules/resolution : questlang/modules/Resolution
    questlang/types/model : questlang/types/Model
    questlang/types/subtyping : questlang/types/Subtyping
    questlang/types/symbols : questlang/types/Symbols
export
    (* The operand and result types of the built-in infix operators, which the
     * environment declares as functions (the bootstrap's INFIX_OPERATORS), in
     * the bootstrap's order *)
    Def InfixOperator = Tuple op: String left: model.Type right: model.Type result: model.Type end
    infixOperator(op: String): maybe.T(InfixOperator)

    Def Rec T = Tuple
        baseScope: symbols.Scope
        globalScope: symbols.Scope
        var currentScope: symbols.Scope
        (* The interfaces and modules named in the unit being elaborated: the
         * builtins and the unit's imports *)
        var interfaces: maps.StringMap(symbols.Scope)
        var modules: maps.StringMap(symbols.Scope)
        var builtinInterfaces: maps.StringMap(symbols.Scope)
        var builtinModules: maps.StringMap(symbols.Scope)
        includePaths: vector.T(String)
        var currentDir: maybe.T(String)
        (* The directory of the program being compiled, which names units under
         * no include root *)
        var programDir: maybe.T(String)
        (* The file of the unit being elaborated, where errors raised inside are
         * located *)
        var sourceFile: String
        (* The canonical names of the interfaces, and of the modules, being
         * loaded, outermost first: a unit already on its list when it is
         * loaded again is in an import cycle (modules/loader) *)
        loadingInterfaces: vector.T(String)
        loadingModules: vector.T(String)
        var registry: maybe.T(Registry)
        (* The units loaded, with the resolver of imports *)
        var units: graph.UnitGraph
        (* Where errors that do not stop elaboration are reported (the
         * bootstrap's sink) *)
        var report: maybe.T(All(err: diagnostics.CompilerError) Ok)
        (* The imports whose units are being loaded, outermost first *)
        importStack: vector.T(ImportSite)
        (* Where interfaces' artifacts are read and written (the bootstrap's
         * options.build_dir), and whether the unit is being compiled to C, in
         * which modules are known through their interfaces alone (the
         * bootstrap's is_c_compilation_mode) *)
        var buildDir: maybe.T(String)
        var compilingC: Bool
        (* Whether, compiling to C, an inlined module's source is elaborated
         * for its importers to copy from (modules/inlined): not while an
         * interface is, which is typed against interfaces alone *)
        var openInlined: Bool
        (* Whether a unit file is being compiled alone (-c), in which an
         * imported module's external types are named as their bindings name
         * them *)
        var compilingUnit: Bool
        (* Whether the bindings being elaborated are an unsound module's, the
         * only place 'external' may be used (docs/modules.md section 4.4) *)
        var inUnsoundModule: Bool
        (* interactive is true when elaborating interactive input (the REPL or
         * a file run with -i), where top-level lets create slots that a later
         * let of the same type can redefine (docs/repl.md section 6). slots
         * maps each such value symbol's id to its slot id, which is the id of
         * the first symbol bound to that slot. *)
        var interactive: Bool
        var slots: maps.IntMap(Int)
        (* reportInferable controls reporting of calls whose explicit type
         * arguments could have been inferred (the driver's --report-inferable):
         * "equal" reports calls where inference finds equal types, "exact"
         * requires the same type nodes spelled as written, and "" disables
         * reporting. inferableCalls collects those calls in check order
         * (typechecker/application). *)
        var reportInferable: String
        inferableCalls: vector.T(InferableCall)
    end
    (* An import, in the file that makes it *)
    and ImportSite = Tuple file: String offset: Int length: Int end
    (* A call at offset in file whose type arguments, the text from offset
     * from to offset to (where its first value argument starts, or its
     * closing parenthesis), inference finds; and whether it finds them from
     * the value arguments alone, without the call's expected type *)
    and InferableCall = Tuple file: String offset: Int from: Int to: Int fromArguments: Bool end
    (* The standard library's interfaces and modules, loaded on demand into an
     * environment (the bootstrap's BuiltinRegistry, which modules/stdlib
     * provides) *)
    and Registry = Tuple
        ensureInterface: All(name: String e: T) maybe.T(symbols.Scope)
        ensureModule: All(name: String e: T) maybe.T(symbols.Scope)
    end

    (* The registry an environment gets unless given one (the bootstrap's
     * set_default_builtin_registry) *)
    setDefaultRegistry(r: maybe.T(Registry)): Ok
    (* An environment with the default registry *)
    new(): T
    (* The environment a program in sourceFile is checked in: new()'s, with its
     * directory dir (the program's imports are resolved from it) as the
     * current and the program directory. The driver, the build engine, and
     * the language server make theirs with it. *)
    forProgram(sourceFile: String dir: String): T
    (* Checks e's imports through their interfaces with the artifacts in
     * buildDir, which is searched first: a compiled program's or the JIT's *)
    useArtifacts(e: T buildDir: String): Ok
    (* An environment with the given registry, or none *)
    newWith(registry: maybe.T(Registry)): T

    (* The lookups of symbols by id (symbols.lookup), which are global, not
     * an environment's, for subtyping and lazy evaluation *)
    symbolLookup: subtyping.MaybeLookup
    freshSymbolId(e: T): Int

    pushScope(e: T name: String): symbols.Scope
    (* Runs body in a new child scope, restoring the previous scope even if
     * body raises an exception *)
    scoped(A::TYPE e: T name: String body: All(s: symbols.Scope) A): A
    (* Like scoped, but marks the new scope local (isLocal) so functions may
     * refer to its var variables, unlike top-level globals *)
    localScoped(A::TYPE e: T name: String body: All(s: symbols.Scope) A): A

    declareTypeVariable(
            e: T name: String symbolId: Int kind: model.Kind definition: maybe.T(model.Type)
            ): symbols.TypeSymbol

    (* A value, loading a standard library module of the name if there is none
     * in scope *)
    lookupValue(e: T name: String): maybe.T(symbols.ValueSymbol)
    lookupType(e: T name: String): maybe.T(symbols.TypeSymbol)
    lookupTypeById(e: T symbolId: Int): maybe.T(symbols.TypeSymbol)
    lookupKind(e: T name: String): maybe.T(symbols.KindSymbol)
    lookupKindById(e: T symbolId: Int): maybe.T(symbols.KindSymbol)

    registerInterface(e: T name: String scope: symbols.Scope): Ok
    (* Puts dir first in e's include paths unless it is already listed, so
     * fresh artifacts in a build directory are found before other paths *)
    searchFirst(e: T dir: String): Ok
    lookupInterface(e: T name: String): maybe.T(symbols.Scope)
    (* Whether an interface is registered under name (builtin interfaces not
     * yet loaded are not) *)
    hasInterface(e: T name: String): Bool
    registerModule(e: T name: String scope: symbols.Scope): Ok
    (* Whether a module is registered under name (builtin modules not yet
     * loaded are not) *)
    hasModule(e: T name: String): Bool
    lookupModule(e: T name: String): maybe.T(symbols.Scope)

    (* Runs body while e.sourceFile is set to file, attributing any
     * diagnostics.compilerError raised inside to file and restoring the
     * previous sourceFile on exit *)
    withUnitSource(A::TYPE e: T file: String body: All() A): A
    (* Runs body with the import site at offset and length pushed onto
     * e.importStack, wrapping any diagnostics.compilerError that propagates
     * out with diagnostics.atImport and popping the site on exit *)
    atImport(A::TYPE e: T offset: Int length: Int body: All() A): A
    (* Attaches e.sourceFile and e.importStack to an error found while loading
     * imported units, as if it had propagated out of withUnitSource and
     * atImport *)
    locate(e: T err: diagnostics.CompilerError): diagnostics.CompilerError

    (* An interface or module path resolved as e imports it: from its current
     * directory, with its search paths and program directory *)
    resolveInterface(e: T name: String): resolution.Resolved
    resolveModule(e: T name: String): resolution.Resolved

    (* Runs body with only the built-in interface and module names registered,
     * so a unit loaded from a file does not inherit the importer's registered
     * names, and restores the importer's names on exit *)
    withUnitNames(A::TYPE e: T body: All() A): A

    (* A saved environment state for restore, used by the REPL to roll back a
     * failed input. It captures the registered interfaces and modules, loaded
     * units, current scope declarations, and interactive slots. Symbol ids are
     * not reused: the bootstrap's snapshot records its counter, but ids come
     * from a global allocator that restore leaves alone. *)
    Def Snapshot = Tuple
        interfaces: maps.StringMap(symbols.Scope)
        modules: maps.StringMap(symbols.Scope)
        units: graph.Snapshot
        declarations: vector.T(symbols.Symbol)
        values: maps.StringMap(symbols.ValueSymbol)
        types: maps.StringMap(symbols.TypeSymbol)
        typesById: maps.IntMap(symbols.TypeSymbol)
        kinds: maps.StringMap(symbols.KindSymbol)
        kindsById: maps.IntMap(symbols.KindSymbol)
        slots: maps.IntMap(Int)
    end
    snapshot(e: T): Snapshot
    (* Puts the state back as snap found it; snap can be restored again *)
    restore(e: T snap: Snapshot): Ok

    (* Whether a symbol's let redefines an earlier symbol's slot *)
    redefines(e: T sym: symbols.ValueSymbol): Bool
end
