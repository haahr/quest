(* Quest Self-Hosted Compiler: Type-Checking Environments Implementation *)

module env : Env
import
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
    questlang/types/subtyping : questlang/types/Subtyping
    questlang/modules/graph : questlang/modules/Graph
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    raised : Raised
    util/maybe : util/Maybe
    stringOp = string : StringOp
export
    Let Scope = symbols.Scope

    (* ======================================================================
     * 1. The built-in infix operators (Cardelli section 4.2)
     * ====================================================================== *)

    Let InfixOperator = Tuple op: String left: model.Type right: model.Type result: model.Type end

    let operator(op: String left: model.Type right: model.Type result: model.Type): InfixOperator =
        tuple let op = op let left = left let right = right let result = result end

    let infixOperators: Array(InfixOperator) =
        begin
            let i = model.intType
            let r = model.realType
            let b = model.boolType
            let s = model.stringType
            array of
                (* Integer arithmetic and relations *)
                operator("+" i i i) operator("-" i i i) operator("*" i i i) operator("/" i i i) operator("%" i i i)
                operator("mod" i i i)
                operator("<" i i b) operator("<=" i i b) operator(">" i i b) operator(">=" i i b)
                (* Real arithmetic and relations (doubled) *)
                operator("++" r r r) operator("--" r r r) operator("**" r r r) operator("//" r r r) operator("^^" r r r)
                operator("<<" r r b) operator("<<=" r r b) operator(">>" r r b) operator(">>=" r r b)
                (* String concatenation, and boolean eager operations *)
                operator("<>" s s s)
                operator("/\\" b b b) operator("\\/" b b b)
            end
        end

    let infixOperator(op: String): maybe.T(InfixOperator) =
        begin
            let var found = maybe.none(:InfixOperator)
            for k = 0 upto {extent infixOperators - 1} do
                if stringOp.equal(infixOperators[k].op op) then
                    found := maybe.some(:InfixOperator infixOperators[k])
                end
            end
            found
        end

    (* ======================================================================
     * 2. Environments
     * ====================================================================== *)

    Let Rec T = Tuple
        baseScope: symbols.Scope
        globalScope: symbols.Scope
        var currentScope: symbols.Scope
        var interfaces: hashMap.T(String symbols.Scope)
        var modules: hashMap.T(String symbols.Scope)
        var builtinInterfaces: hashMap.T(String symbols.Scope)
        var builtinModules: hashMap.T(String symbols.Scope)
        includePaths: vector.T(String)
        var currentDir: maybe.T(String)
        var programDir: maybe.T(String)
        var sourceFile: String
        loadingInterfaces: vector.T(String)
        loadingModules: vector.T(String)
        var registry: maybe.T(Registry)
        (* The units loaded, with the resolver of imports *)
        var units: graph.UnitGraph
        (* Where errors that do not stop elaboration are reported (the
         * bootstrap's sink) *)
        var report: maybe.T(All(err: diagnostics.CompilerError) Ok)
        (* The imports whose units are being loaded, outermost first *)
        importStack: vector.T(ImportSite)
        var buildDir: maybe.T(String)
        var compilingC: Bool
        var compilingUnit: Bool
    end
    (* An import, in the file that makes it *)
    and ImportSite = Tuple file: String offset: Int length: Int end
    and Registry = Tuple
        ensureInterface: All(name: String e: T) maybe.T(symbols.Scope)
        ensureModule: All(name: String e: T) maybe.T(symbols.Scope)
    end

    Let Defaults = Tuple var registry: maybe.T(Registry) end
    let defaults: Defaults = tuple let var registry = maybe.none(:Registry) end

    let setDefaultRegistry(r: maybe.T(Registry)): Ok = defaults.registry := r

    let newScopeMap(): hashMap.T(String symbols.Scope) = hashMap.new(:String :symbols.Scope stringOp.equal hash.string)

    let copyScopes(m: hashMap.T(String symbols.Scope)): hashMap.T(String symbols.Scope) =
        hashMap.filter(:String :symbols.Scope m fun(k: String v: symbols.Scope): Bool true)

    let freshSymbolId(e: T): Int = symbols.allocateSymbolId()

    let lookupOf(e: T): subtyping.Env = maybe.some(:model.Lookup symbols.lookup)

    (* The primitives and built-in operators in the base scope (the bootstrap's
     * Environment._init_builtins) *)
    let initBuiltins(e: T): Ok =
        begin
            let base = e.baseScope
            symbols.declareKind(base symbols.newKindSymbol("TYPE" freshSymbolId(e) model.typeKind))
            let primitives = array of
                tuple let name = "Int" let type = model.intType end
                tuple let name = "Real" let type = model.realType end
                tuple let name = "Bool" let type = model.boolType end
                tuple let name = "Char" let type = model.charType end
                tuple let name = "String" let type = model.stringType end
                tuple let name = "Ok" let type = model.okType end
                tuple let name = "Dynamic" let type = model.dynamicType end
                tuple let name = "Exception" let type = model.exceptionType end
            end
            for k = 0 upto {extent primitives - 1} do
                symbols.declareType(base symbols.newTypeSymbol(primitives[k].name freshSymbolId(e) model.typeKind
                    maybe.some(:model.Type primitives[k].type)))
            end
            symbols.declareValue(base symbols.valueSymbol("true" model.boolType))
            symbols.declareValue(base symbols.valueSymbol("false" model.boolType))
            symbols.declareValue(base symbols.valueSymbol("ok" model.okType))
            let param = fun(name: String type: model.Type): model.Param
                tuple let name = name let type = type let isVar = false let isOut = false end
            for k = 0 upto {extent infixOperators - 1} do
                let op = infixOperators[k]
                symbols.declareValue(base symbols.valueSymbol(op.op
                    model.funType(array of param("a" op.left) param("b" op.right) end op.result)))
            end
            (* The monadic operators not, extent, and ordinal (Cardelli sections
             * 4.2, 4.3, 4.5) *)
            let notType = model.funType(array of param("b" model.boolType) end model.boolType)
            symbols.declareValue(base symbols.valueSymbol("not" notType))
            (* All(A::TYPE) Fun(paramName: paramType(A)): Int *)
            let quantified = fun(name: String paramName: String paramType: All(a: model.Type) model.Type): Ok
                begin
                    let id = freshSymbolId(e)
                    let a = model.typeVariable("A" id maybe.none(:model.Kind))
                    let q: model.Quantifier = tuple let name = "A" let symbolId = id let bound = model.typeKind end
                    let f = model.funType(array of param(paramName paramType(a)) end model.intType)
                    symbols.declareValue(base symbols.valueSymbol(name model.allType(array of q end f)))
                    ok
                end
            quantified("extent" "a" model.arrayType)
            quantified("ordinal" "o" fun(a: model.Type): model.Type a)
        end

    let newWith(registry: maybe.T(Registry)): T =
        begin
            let base = symbols.newScope(maybe.none(:symbols.Scope) "base")
            let global = symbols.newScope(maybe.some(:symbols.Scope base) "global")
            let e: T = tuple
                let baseScope = base
                let globalScope = global
                let var currentScope = global
                let var interfaces = newScopeMap()
                let var modules = newScopeMap()
                let var builtinInterfaces = newScopeMap()
                let var builtinModules = newScopeMap()
                let includePaths = vector.new(:String)
                let var currentDir = maybe.none(:String)
                let var programDir = maybe.none(:String)
                let var sourceFile = "<string>"
                let loadingInterfaces = vector.new(:String)
                let loadingModules = vector.new(:String)
                let var registry = registry
                let var units = graph.newGraph()
                let var report = maybe.none(:All(err: diagnostics.CompilerError) Ok)
                let importStack = vector.new(:ImportSite)
                let var buildDir = maybe.none(:String)
                let var compilingC = false
                let var compilingUnit = false
            end
            initBuiltins(e)
            e.builtinInterfaces := copyScopes(e.interfaces)
            e.builtinModules := copyScopes(e.modules)
            e
        end

    let new(): T = newWith(defaults.registry)

    (* ======================================================================
     * 3. Scopes
     * ====================================================================== *)

    let pushScope(e: T name: String): symbols.Scope =
        begin
            e.currentScope := symbols.newScope(maybe.some(:symbols.Scope e.currentScope) name)
            e.currentScope
        end

    let popScope(e: T): symbols.Scope =
        begin
            let popped = e.currentScope
            if maybe.isNone(:symbols.Scope popped.parent) then
                diagnostics.fail(:Ok "internal: cannot pop root global scope from Environment" 0)
            end
            e.currentScope := maybe.unwrap(:symbols.Scope popped.parent)
            popped
        end

    let scoped(A::TYPE e: T name: String body: All(s: symbols.Scope) A): A =
        begin
            let saved = e.currentScope
            let s = pushScope(e name)
            let result = try
                body(s)
            else with r then
                e.currentScope := saved
                raised.reraise(:A r)
            end
            e.currentScope := saved
            result
        end

    let declareTypeVariable(
        e: T name: String symbolId: Int kind: model.Kind definition: maybe.T(model.Type)
    ): symbols.TypeSymbol =
        symbols.declareTypeVariable(e.currentScope name symbolId kind definition)

    (* ======================================================================
     * 4. Lookups
     * ====================================================================== *)

    let lookupValue(e: T name: String): maybe.T(symbols.ValueSymbol) =
        begin
            let found = symbols.lookupValue(e.currentScope name)
            if maybe.isNone(:symbols.ValueSymbol found) andif maybe.isSome(:Registry e.registry) andif
                maybe.isSome(:symbols.Scope maybe.unwrap(:Registry e.registry).ensureModule(name e)) then
                symbols.lookupValue(e.currentScope name)
            else
                found
            end
        end

    let lookupType(e: T name: String): maybe.T(symbols.TypeSymbol) = symbols.lookupType(e.currentScope name)
    let lookupTypeById(e: T symbolId: Int): maybe.T(symbols.TypeSymbol) = symbols.typeSymbolById(symbolId)
    let lookupKind(e: T name: String): maybe.T(symbols.KindSymbol) = symbols.lookupKind(e.currentScope name)
    let lookupKindById(e: T symbolId: Int): maybe.T(symbols.KindSymbol) = symbols.kindSymbolById(symbolId)

    let registerInterface(e: T name: String scope: symbols.Scope): Ok =
        begin hashMap.insert(:String :symbols.Scope e.interfaces name scope) ok end

    let lookupInterface(e: T name: String): maybe.T(symbols.Scope) =
        begin
            let found = hashMap.get(:String :symbols.Scope e.interfaces name)
            if maybe.isNone(:symbols.Scope found) andif maybe.isSome(:Registry e.registry) then
                maybe.unwrap(:Registry e.registry).ensureInterface(name e)
            else
                found
            end
        end

    let registerModule(e: T name: String scope: symbols.Scope): Ok =
        begin hashMap.insert(:String :symbols.Scope e.modules name scope) ok end

    let hasModule(e: T name: String): Bool = hashMap.contains(:String :symbols.Scope e.modules name)

    let lookupModule(e: T name: String): maybe.T(symbols.Scope) =
        begin
            let found = hashMap.get(:String :symbols.Scope e.modules name)
            if maybe.isNone(:symbols.Scope found) andif maybe.isSome(:Registry e.registry) then
                maybe.unwrap(:Registry e.registry).ensureModule(name e)
            else
                found
            end
        end

    (* ======================================================================
     * 5. Units
     * ====================================================================== *)

    let withUnitSource(A::TYPE e: T file: String body: All() A): A =
        begin
            let saved = e.sourceFile
            e.sourceFile := file
            let result = try
                body()
            when diagnostics.compilerError with err then
                begin
                    e.sourceFile := saved
                    diagnostics.raiseError(:A diagnostics.inFile(err file))
                end
            else with r then
                e.sourceFile := saved
                raised.reraise(:A r)
            end
            e.sourceFile := saved
            result
        end

    let atImport(A::TYPE e: T offset: Int length: Int body: All() A): A =
        begin
            let file = e.sourceFile
            vector.append(:ImportSite e.importStack tuple let file = file let offset = offset let length = length end)
            let result = try
                body()
            when diagnostics.compilerError with err then
                begin
                    vector.pop(:ImportSite e.importStack)
                    diagnostics.raiseError(:A diagnostics.atImport(err offset length file))
                end
            else with r then
                vector.pop(:ImportSite e.importStack)
                raised.reraise(:A r)
            end
            vector.pop(:ImportSite e.importStack)
            result
        end

    let locate(e: T err: diagnostics.CompilerError): diagnostics.CompilerError =
        begin
            let n = vector.length(:ImportSite e.importStack)
            let var located = if n > 0 then diagnostics.inFile(err e.sourceFile) else err end
            for i = {n - 1} downto 0 do
                let site = vector.get(:ImportSite e.importStack i)
                located := diagnostics.atImport(located site.offset site.length site.file)
            end
            located
        end

    let resolveInterface(e: T name: String): graph.Resolved =
        graph.resolveInterface(e.units.resolver name e.currentDir
            graph.rootsOf(vector.toArray(:String e.includePaths) e.programDir))

    let resolveModule(e: T name: String): graph.Resolved =
        graph.resolveModule(e.units.resolver name e.currentDir graph.rootsOf(vector.toArray(:String e.includePaths) e.programDir))

    let withUnitNames(A::TYPE e: T body: All() A): A =
        begin
            let savedInterfaces = e.interfaces
            let savedModules = e.modules
            e.interfaces := copyScopes(e.builtinInterfaces)
            e.modules := copyScopes(e.builtinModules)
            let restore = fun(): Ok
                begin
                    e.interfaces := savedInterfaces
                    e.modules := savedModules
                end
            let result = try
                body()
            else with r then
                restore()
                raised.reraise(:A r)
            end
            restore()
            result
        end

    (* A copy of m, with its equality and hash *)
    let copyMap(K::TYPE V::TYPE m: hashMap.T(K V)): hashMap.T(K V) =
        hashMap.filter(:K :V m fun(k: K v: V): Bool true)

    Let Snapshot = Tuple
        interfaces: hashMap.T(String symbols.Scope)
        modules: hashMap.T(String symbols.Scope)
        units: graph.Snapshot
        declarations: vector.T(symbols.Symbol)
        values: hashMap.T(String symbols.ValueSymbol)
        types: hashMap.T(String symbols.TypeSymbol)
        typesById: hashMap.T(Int symbols.TypeSymbol)
        kinds: hashMap.T(String symbols.KindSymbol)
        kindsById: hashMap.T(Int symbols.KindSymbol)
    end

    let snapshot(e: T): Snapshot =
        begin
            let s = e.currentScope
            tuple
                let interfaces = copyMap(:String :symbols.Scope e.interfaces)
                let modules = copyMap(:String :symbols.Scope e.modules)
                let units = graph.snapshot(e.units)
                let declarations = vector.copy(:symbols.Symbol s.declarations)
                let values = copyMap(:String :symbols.ValueSymbol s.values)
                let types = copyMap(:String :symbols.TypeSymbol s.types)
                let typesById = copyMap(:Int :symbols.TypeSymbol s.typesById)
                let kinds = copyMap(:String :symbols.KindSymbol s.kinds)
                let kindsById = copyMap(:Int :symbols.KindSymbol s.kindsById)
            end
        end

    let restore(e: T snap: Snapshot): Ok =
        begin
            e.interfaces := copyMap(:String :symbols.Scope snap.interfaces)
            e.modules := copyMap(:String :symbols.Scope snap.modules)
            graph.restore(e.units snap.units)
            let s = e.currentScope
            s.declarations := vector.copy(:symbols.Symbol snap.declarations)
            s.values := copyMap(:String :symbols.ValueSymbol snap.values)
            s.types := copyMap(:String :symbols.TypeSymbol snap.types)
            s.typesById := copyMap(:Int :symbols.TypeSymbol snap.typesById)
            s.kinds := copyMap(:String :symbols.KindSymbol snap.kinds)
            s.kindsById := copyMap(:Int :symbols.KindSymbol snap.kindsById)
        end
end
