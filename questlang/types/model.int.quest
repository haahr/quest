(* Quest Self-Hosted Compiler: Semantic Types and Kinds Interface
 *
 * The semantic types and kinds of bootstrap/python/quest/types/model.py: their
 * forms, hash-consing, free variables, substitution, lazy evaluation of
 * aliases, applications, and recursive types, and inference metavariables.
 *
 * A type or a kind is a node: its form, which holds its parts, and what the
 * bootstrap caches on its objects (the symbol ids a substitution could replace
 * inside it, and whether it contains a metavariable). Nodes are hash-consed as
 * the bootstrap's are: constructing a node gives the canonical node of its
 * structure, so two nodes are the same type (Python's `is`) when their ids are
 * equal (same). A node containing a metavariable is not hash-consed, since a
 * metavariable is mutable. The components of types (fields, parameters,
 * quantifiers, ...) are plain tuples; their identity is that of the types they
 * hold. docs/type-system.md §2 lists the forms, and §2.2 says how types are
 * shared and why the checker keeps them as written. *)

interface Model
import
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
export
    (* Raised on an internal error: a limit of the model reached *)
    internalError: Exception(String)

    (* =========================================================================
     * 1. Reserved symbol ids
     *
     * Symbol ids from the environment are positive, and inference metavariables
     * count down from -1. A few type variables are made outside any
     * environment; their ids are negative too: the negation of a prefix naming
     * their use, times 2**32, plus an index within that use.
     * ====================================================================== *)

    (* The uses of reserved ids, in prefix order (dynamicParam is prefix 1), so
     * ids of different uses never coincide; metavariables, below 2**32 in
     * magnitude, have prefix 0. What each use's index counts:
     *
     *   dynamicParam         Dynamic's type parameter (index 0 only)
     *   boundVar             a bound type parameter of a polymorphic function
     *                        type in a C descriptor, by de Bruijn index (how
     *                        many binders lie between it and its own)
     *   canonicalQuantifier  a quantifier of a polymorphic function type in
     *                        canonical form, by position
     *   recSelf              a recursion variable in the C tag of a recursive
     *                        type, by nesting depth (canonical.recSelfVar)
     *   canonicalRec         a recursion variable of a recursive type in
     *                        canonical form, by position
     *   canonicalBinder      a binder's type parameter in canonical form, by
     *                        the number of parameters enclosing it
     *   hole                 a type parameter of generic code in a C
     *                        descriptor template, by position among the
     *                        template's holes
     *
     * Fixed ids make these variables the same wherever they are made, so that
     * equal types in canonical form or in descriptors are equal nodes *)
    Def ReservedSymbolUse = Option
        dynamicParam
        boundVar
        canonicalQuantifier
        recSelf
        canonicalRec
        canonicalBinder
        hole
    end

    reservedSymbolId(use: ReservedSymbolUse index: Int): Int
    (* The use and index of a reserved symbol id, if it is one *)
    Def Decoded = Tuple use: ReservedSymbolUse index: Int end
    reservedSymbolUse(symbolId: Int): maybe.T(Decoded)

    (* ======================================================================
     * 2. Types, kinds, and their components
     * ====================================================================== *)

    (* A semantic Quest type: a type the checker reasons about, as opposed to
     * a type as written (ast.TypeExpr), which elaboration translates into
     * these.
     *
     * A type is an immutable structure of nodes, each with a form, one per
     * constructor (typeRecord, typeFun, ...) or kind of name (typeVariable and
     * its relatives, described in TypeForm), with every name resolved to its
     * symbol. Identical structures are one node (they are hash-consed; see
     * section 4 of model.mod.quest), so same(a b) decides structural
     * identity, and types are compared with subtyping.isSubtype and
     * subtyping.isTypeEqual. A recursive type, Rec(X) T, stands for an
     * infinite tree but is kept finite: unfolding it substitutes the Rec node
     * itself for X in T.
     *
     * evaluateLazily is the operation most code needs before looking at a
     * type. It returns a type whose outermost node is a constructor, or a name
     * that cannot be expanded: it looks through aliases, unfolds recursive
     * types, reduces applications of type operators, and, given a lookup,
     * expands a type variable whose symbol has a definition. It takes only the
     * outermost step, and the parts are left as written; that keeps alias
     * names for messages, and makes evaluating a recursive type terminate
     * (recursive types are contractive, so an unfolding's outermost node is a
     * constructor). Code that cases on a type's form must evaluate it first,
     * or it will meet an alias where it expects a record.
     *
     * substitute(t subst) replaces type variables, by symbol id, avoiding
     * capture: inside a binder (All, a type operator, a recursive type, a
     * tuple's type components), the binder's own variables are not replaced.
     * Each node records the ids a substitution could replace in it (fv) and
     * whether it contains a metavariable (hasMeta), so that substitute returns
     * a type untouched, without walking it, when nothing in it would change. A
     * new form must be given its free variables (formFree), its hash-consing
     * key (typeKey), its substitution, and its parts (typeParts), through which
     * the generic walkers reach them. *)
    Def Rec Type = Tuple
        (* The node's identity: hash-consed nodes of one structure have one
         * id *)
        id: Int
        form: TypeForm
        (* The symbol ids a substitution could replace inside the node,
         * sorted *)
        fv: Array(Int)
        hasMeta: Bool
        (* Caches, set on first use and not part of the node's structure: the
         * unfolding of a recursive type or of an alias of one (unfoldLazily),
         * and, for a typeRecGroup node, the nodes of every binding of its
         * group, one array shared by all of them (siblings). Sharing them
         * keeps repeated unfolding within one finite graph of nodes. Both are
         * empty until computed *)
        var unfolded: maybe.T(Type)
        var siblings: Array(Type)
    end
    and TypeForm = Option
        typeInt
        typeReal
        typeBool
        typeChar
        typeString
        typeOk
        typeBottom
        typeException with payload: Type end
        typeExternal with name: String cType: String end
        typeTuple with fields: Array(TupleComponent) end
        (* provenance names the module or interface a module's record type
         * comes from, so that it prints as Module 'name' rather than as all
         * its members (docs/type-system.md §2.1); none for other records *)
        typeRecord with fields: Array(RecordField) provenance: maybe.T(String) end
        typeVariant with variants: Array(VariantField) end
        typeOption with options: Array(OptionField) end
        typeFun with params: Array(Param) result: Type end
        typeVar with element: Type end
        typeArray with element: Type end
        typeOut with element: Type end
        typeAll with quantifiers: Array(Quantifier) body: Type end
        (* Auto A::K with S end: typeParam is A, symbolId A's symbol,
         * kindBound K, and signature S, the components an auto value has
         * besides its type (docs/type-system.md §6.12) *)
        typeAuto with typeParam: String symbolId: Int kindBound: Kind signature: Array(RecordField) end
        typeOperator with params: Array(TypeFormal) body: Type end
        typeApp with constructor: Type arguments: Array(Type) end
        typeRec with varName: String symbolId: Int bound: Kind body: Type end
        (* One type of a group declared together, Let Rec A = ... and B =
         * ...: bindings holds the whole group, in declaration order, and
         * activeIndex the binding this node stands for; a binding's body
         * refers to the others by their symbol ids (docs/type-system.md
         * §3.4) *)
        typeRecGroup with bindings: Array(RecBinding) activeIndex: Int end
        (* Five forms stand for a type by name rather than by structure. They
         * differ in where they come from and in what evaluateLazily, and so
         * subtyping, sees through:
         *
         * - typeVariable, a name referring to a type symbol: a type parameter
         *   (of a function, an All type, a type operator, or a recursive
         *   type), a type component of a tuple type, or an interface's
         *   abstract type. Two are the same type when they refer to the same
         *   symbol, and otherwise all that is known of one is its bound. Given
         *   a lookup in which its symbol has a definition, though,
         *   evaluateLazily expands it, so a type may compare differently with
         *   an environment and without (the subtype cache keeps the two
         *   apart).
         * - typeAbstract, a type known only by its bound, never expanded: an
         *   auto type's type parameter in the layout that stores auto values'
         *   payloads whatever their witnesses (autoPayloadType).
         * - typePath, x.A: the type component A of the value x, whose type
         *   hides it. It is identified by x's symbol and A, and never
         *   expanded.
         * - typeAlias, a reference to a type alias, kept to print the name
         *   written: always seen through, to its target.
         * - typeMeta, ?A: a placeholder for a type argument being inferred,
         *   solved by subtyping (subtyping's step). It is the only mutable
         *   type, and so is never shared by hash-consing. *)
        typeVariable with name: String symbolId: Int bound: maybe.T(Kind) end
        typeAbstract with name: String symbolId: Int bound: Kind end
        typePath with rootName: String rootSymbolId: Int fieldName: String bound: Kind end
        typeAlias with name: String symbolId: Int target: Type end
        typeMeta with meta: Meta end
    end
    (* A kind classifies types as a type classifies values: TYPE, the kind of
     * every proper type; POWER(B), the subtypes of B; ALL(X::K1) K2, a type
     * operator taking a type of kind K1 to one of kind K2; and a kind
     * variable. Kinds are nodes like types, hash-consed the same way *)
    and Kind = Tuple
        id: Int
        form: KindForm
        fv: Array(Int)
        hasMeta: Bool
    end
    and KindForm = Option
        kindType
        kindPower with bound: Type end
        kindAll with paramName: String paramId: Int paramKind: Kind resultKind: Kind end
        kindVar with name: String symbolId: Int end
    end
    (* A component of a tuple type, in order, since later components may
     * refer to earlier type components (docs/type-system.md §4.1):
     * - tupleField, a value component, named or not (x: T, or :T);
     * - tupleTypeFormal, an abstract type component A::K, known outside only
     *   by its bound, which makes the tuple an existential package;
     * - tupleTypeBinding, a manifest type component, Let A = T, transparent
     *   to code that selects it; a bound of none means TYPE *)
    and TupleComponent = Option
        tupleField with name: maybe.T(String) type: Type isVar: Bool end
        tupleTypeFormal with name: String symbolId: Int bound: Kind end
        tupleTypeBinding with name: String type: Type bound: maybe.T(Kind) end
    end
    and RecordField = Tuple name: String type: Type isVar: Bool end
    and VariantField = Tuple name: String type: maybe.T(Type) isVar: Bool end
    and OptionField = Tuple name: String payload: maybe.T(Type) end
    and Param = Tuple name: String type: Type isVar: Bool isOut: Bool end
    and Quantifier = Tuple name: String symbolId: Int bound: Kind end
    and TypeFormal = Tuple name: String symbolId: Int bound: Kind end
    and RecBinding = Tuple name: String symbolId: Int bound: Kind body: Type end
    (* An inference metavariable (?T1), which a solution instantiates *)
    and Meta = Tuple symbolId: Int bound: Kind name: String var instance: maybe.T(Type) end

    (* Whether two types, or two kinds, are the same node (the bootstrap's
     * `is`) *)
    same(a: Type b: Type): Bool
    sameKind(a: Kind b: Kind): Bool

    (* ======================================================================
     * 3. Constructors, which hash-cons
     * ====================================================================== *)

    typeKind: Kind
    powerKind(bound: Type): Kind
    allKind(paramName: String paramId: Int paramKind: Kind resultKind: Kind): Kind
    kindVar(name: String symbolId: Int): Kind

    intType: Type
    realType: Type
    boolType: Type
    charType: Type
    stringType: Type
    okType: Type
    bottomType: Type
    exceptionType: Type
    exceptionOf(payload: Type): Type
    externalType(name: String cType: String): Type
    (* raised.T, the type of a try's else binder (docs/raised.md section 3.2):
     * the external type lib/raised defines, which is an importer's raised.T
     * too *)
    raisedType: Type
    tupleType(fields: Array(TupleComponent)): Type
    recordType(fields: Array(RecordField) provenance: maybe.T(String)): Type
    variantType(variants: Array(VariantField)): Type
    optionType(options: Array(OptionField)): Type
    funType(params: Array(Param) result: Type): Type
    varType(element: Type): Type
    arrayType(element: Type): Type
    outType(element: Type): Type
    allType(quantifiers: Array(Quantifier) body: Type): Type
    autoType(typeParam: String symbolId: Int kindBound: Kind signature: Array(RecordField)): Type
    typeOperator(params: Array(TypeFormal) body: Type): Type
    typeApp(constructor: Type arguments: Array(Type)): Type
    recType(varName: String symbolId: Int bound: Kind body: Type): Type
    recGroupType(bindings: Array(RecBinding) activeIndex: Int): Type
    typeVariable(name: String symbolId: Int bound: maybe.T(Kind)): Type
    abstractType(name: String symbolId: Int bound: Kind): Type
    pathType(rootName: String rootSymbolId: Int fieldName: String bound: Kind): Type
    aliasType(name: String symbolId: Int target: Type): Type
    (* A new unsolved metavariable, of bound typeKind unless given *)
    newMeta(bound: Kind name: maybe.T(String)): Type
    (* Starts metavariable ids over (the bootstrap's QTypeMeta.reset_counter) *)
    resetMetaCounter(): Ok

    (* A tuple's value component *)
    tupleField(name: maybe.T(String) type: Type isVar: Bool): TupleComponent

    (* Cardelli's Dynamic: Auto A::TYPE with a: A end, its parameter's id
     * reserved *)
    dynamicType: Type

    (* ======================================================================
     * 4. Looking up symbols, and lazy evaluation
     * ====================================================================== *)

    (* What evaluation needs of an environment: the definition of a type symbol,
     * and the kind of a kind symbol, by id (the bootstrap's TypeLookupEnv and
     * KindLookupEnv) *)
    Def Lookup = Tuple
        typeDefinition: All(symbolId: Int) maybe.T(Type)
        kindOf: All(symbolId: Int) maybe.T(Kind)
    end
    (* The lookup that finds nothing, as evaluation without an environment
     * does *)
    noLookup: Lookup

    (* A type with its aliases, applications, and recursive types evaluated
     * until its outermost constructor shows *)
    evaluateLazily(t: Type env: Lookup): Type
    evaluateKindLazily(k: Kind env: Lookup): Kind
    (* One step of unfolding t, computed once and kept on t:
     * - Rec(X) T unfolds to T[Rec(X) T/X];
     * - a group binding to its body, with each binding's variable replaced by
     *   that binding's node (siblings);
     * - an alias of a recursive type through the alias: the recursive
     *   occurrences become the alias, so they keep its name, and for a group
     *   the other bindings become aliases qualified as this one is (m.Forest
     *   unfolds with m.Tree).
     * Any other type is itself *)
    unfoldLazily(t: Type): Type
    (* For a typeRecGroup node, the nodes of its group's bindings, in order,
     * made once and shared by all of them; empty for other types *)
    siblings(t: Type): Array(Type)

    (* ======================================================================
     * 5. Substitution
     * ====================================================================== *)

    Def Subst = hashMap.T(Int Type)
    Def KindSubst = hashMap.T(Int Kind)
    newSubst(): Subst
    newKindSubst(): KindSubst
    (* A substitution of one id *)
    singleSubst(symbolId: Int t: Type): Subst

    (* Capture-avoiding substitution by symbol id; t itself when nothing it
     * holds is substituted *)
    substitute(t: Type subst: Subst): Type
    substituteInKind(k: Kind subst: Subst): Kind
    substituteKinds(k: Kind subst: KindSubst): Kind
    (* A tuple component substituted (a type formal's bound, a field's or
     * binding's type) *)
    substituteComponent(c: TupleComponent subst: Subst): TupleComponent

    (* ======================================================================
     * 6. Components and queries
     * ====================================================================== *)

    (* A node's parts in the order of its fields (the bootstrap's type_fields):
     * its child types and kinds *)
    Def Part = Option
        partType with t: Type end
        partKind with k: Kind end
    end
    typeParts(t: Type): vector.T(Part)
    kindParts(k: Kind): vector.T(Part)

    (* A tuple's value components *)
    Def ValueField = Tuple name: maybe.T(String) type: Type isVar: Bool end
    tupleValueFields(fields: Array(TupleComponent)): Array(ValueField)
    (* The types of a tuple's value components and type bindings *)
    tupleElements(fields: Array(TupleComponent)): Array(Type)
    tupleTypeFormals(fields: Array(TupleComponent)): Array(TypeFormal)
    isExistential(fields: Array(TupleComponent)): Bool
    componentName(c: TupleComponent): maybe.T(String)
    (* The first component, field, or case of a name *)
    tupleGetField(fields: Array(TupleComponent) name: String): maybe.T(TupleComponent)
    recordGetField(fields: Array(RecordField) name: String): maybe.T(RecordField)
    variantGetField(variants: Array(VariantField) name: String): maybe.T(VariantField)
    optionGetField(options: Array(OptionField) name: String): maybe.T(OptionField)
    isPower(k: Kind): Bool
    (* A power kind's bound *)
    powerBound(k: Kind): Type

    (* Whether a value binding of name with type t is the module bound to that
     * name *)
    bindsModule(name: String t: Type): Bool
    (* The tuple type of an auto value's payload, at a witness, or at its
     * abstract type parameter *)
    autoPayloadType(t: Type witness: maybe.T(Type)): Type
    autoMatchesSubtypes(t: Type): Bool
    (* A reference to an alias: an alias node, but a builtin primitive's own
     * name is the primitive *)
    aliasReference(name: String symbolId: Int target: Type): Type
    unalias(t: Type): Type
    (* The path types occurring in t, in the order found *)
    findPathTypes(t: Type): Array(Type)
    typeMentionsSymbolIds(t: Type ids: hashMap.T(Int Bool)): Bool

    (* A type with every alias reference replaced by what replace gives, or kept
     * (none) *)
    mapAliases(t: Type replace: All(alias: Type) maybe.T(Type)): Type
    stripAliases(t: Type): Type

    (* ======================================================================
     * 7. Metavariables
     * ====================================================================== *)

    isSolved(m: Meta): Bool
    (* A metavariable's solution, its chains flattened, or the metavariable
     * itself if unsolved *)
    prune(t: Type): Type
    (* t, or if a metavariable, what it stands for *)
    pruned(t: Type): Type
    (* The unsolved metavariables in t, in order *)
    unsolvedMetas(t: Type): Array(Type)
    unsolvedMetasInKind(k: Kind): Array(Type)
    (* t with solved metavariables replaced by their solutions *)
    resolveMetas(t: Type): Type

    (* ======================================================================
     * 8. Printing, as the bootstrap's __str__ methods do
     * ====================================================================== *)

    show(t: Type): String
    showKind(k: Kind): String
    showQuantifier(q: Quantifier): String
    showComponent(c: TupleComponent): String
    showField(f: RecordField): String
end
