(* Quest Self-Hosted Compiler: Reduced Types Implementation
 *
 * Exposes a type's outermost constructor for the IR and the C backend:
 * betaReduceHead applies type operators to their arguments (Fun(A) T applied
 * to U becomes T with U for A), unfolding and unfoldRecursive* unfold
 * recursive types, normalizeType combines the two and caches the result, and
 * resolveTypeBound, optionCaseNames, optionIdentity, and variantCases look
 * through bounded variables and abstract types. The counterpart is
 * bootstrap/python/quest/types/reduce.py. *)

module reduce : Reduce
import
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/common/maps : questlang/common/Maps
    questlang/modules/abstractTypes : questlang/modules/AbstractTypes
    questlang/types/model : questlang/types/Model
export
    Let Type = model.Type

    (* An internal error: a type that is not an option where one must be (the
     * bootstrap's ValueError) *)
    let notAnOption: Exception(String) = exception notAnOption: String end
    let maxBetaSteps = 1000
    let isApp(t: Type): Bool = t.form?typeApp
    let isRecursive(t: Type): Bool = t.form?typeRec orif t.form?typeRecGroup
    (* Exception(T) is written as an application of the builtin Exception, an
     * exception type itself, and so reduces to the exception type of payload
     * T. An application of an application left as it is, F(A)(B), is F(A B);
     * an operator given fewer arguments than its parameters reduces to the
     * operator of the rest, and one given more to its body applied to the
     * rest (model.applyOperator). Anything else at the head is left as it
     * is. *)
    let rec betaReduceHead(t0: Type): Type =
        begin
            let var t = t0
            let var done = false
            let var steps = 0
            while not(done) andif {steps < maxBetaSteps} do
                steps := steps + 1
                t := model.prune(t)
                case t.form
                    when typeApp with app then
                        let ctor = betaReduceHead(app.constructor)
                        case ctor.form
                            when typeApp then t := model.typeApp(ctor app.arguments)
                            when typeException then
                                if extent app.arguments is 1 then
                                    t := model.exceptionOf(app.arguments[0])
                                end
                                done := true
                            when typeOperator with op then t := model.applyOperator(op.params op.body app.arguments)
                            else done := true
                        end
                    else done := true
                end
            end
            t
        end
    (* The unfolding of t, through recursive types and applications *)
    let unfolding(t0: Type): Type =
        begin
            let var t = if isApp(t0) then betaReduceHead(t0) else t0 end
            let var steps = 0
            while isRecursive(t) andif {steps < maxBetaSteps} do
                steps := steps + 1
                t := model.prune(model.unfoldLazily(t))
                if isApp(t) then t := betaReduceHead(t) end
            end
            t
        end
    let unfoldRecursiveAny(t: Type): maybe.T(Type) =
        begin
            let u = unfolding(t)
            if isRecursive(u) orif isApp(u) then maybe.none() else maybe.some(u) end
        end
    (* Whether a recursive type that unfolds to t is represented as t is:
     * true for the constructed types below (a tuple's values by a pointer to
     * its struct, a function's by a closure pointer), so that the two, being
     * equal, share a representation (the bootstrap's
     * _UNFOLDED_REPRESENTATION) *)
    let isUnfoldedRepresentation(t: Type): Bool =
        case t.form
            when typeTuple then true
            when typeRecord then true
            when typeVariant then true
            when typeOption then true
            when typeArray then true
            when typeVar then true
            when typeOut then true
            when typeAuto then true
            when typeFun then true
            when typeAll then true
            when typeException then true
            else false
        end
    let unfoldRecursive(t: Type): maybe.T(Type) =
        begin
            let u = unfolding(t)
            if isUnfoldedRepresentation(u) then maybe.some(u) else maybe.none() end
        end
    (* Reduced forms by the id of the type node *)
    let normalized = maps.newIntMap(:Type)
    (* Strips aliases from t0, then unfolds a recursive type until its
     * outermost node is neither recursive nor an application. An application
     * becomes its unfolding if that is a constructed type (unfoldRecursive),
     * else its beta-reduction if that has a non-recursive constructor at its
     * head, else its lazy evaluation if that yields a tuple or record type;
     * otherwise, as for an application of an abstract type operator (m.T(Int)),
     * it stays as it is. *)
    let normalizeUncached(t0: Type): Type =
        begin
            let t = model.stripAliases(t0)
            let var result = t
            let var found = false
            if isRecursive(t) then
                let unfolded = unfoldRecursiveAny(t)
                if maybe.isSome(unfolded) then
                    result := maybe.unwrap(unfolded)
                    found := true
                end
            end
            if not(found) andif isApp(t) then
                let unfolded = unfoldRecursive(t)
                if maybe.isSome(unfolded) then
                    result := maybe.unwrap(unfolded)
                else
                    let reduced = betaReduceHead(t)
                    if not(isApp(reduced) orif isRecursive(reduced)) then
                        result := reduced
                    else
                        let evaled = model.evaluateLazily(t model.noLookup)
                        if not(model.same(evaled t)) andif {evaled.form?typeTuple orif evaled.form?typeRecord} then
                            result := evaled
                        end
                    end
                end
            end
            result
        end
    let normalizeType(t0: Type): Type =
        begin
            let t = model.prune(t0)
            if t.hasMeta then
                normalizeUncached(t)
            else
                let found = hashMap.get(normalized t.id)
                if maybe.isSome(found) then
                    maybe.unwrap(found)
                else
                    let result = normalizeUncached(t)
                    hashMap.insert(normalized t.id result)
                    result
                end
            end
        end
    (* Whether two bounded types are one, as resolve_type_bound tells them
     * apart: a variable or abstract type by its symbol, a path type by
     * itself *)
    let sameNode(a: Type b: Type): Bool =
        case a.form
            when typeVariable with x then
                case b.form when typeVariable with y then x.symbolId is y.symbolId else false end
            when typeAbstract with x then
                case b.form when typeAbstract with y then x.symbolId is y.symbolId else false end
            else model.same(a b)
        end
    let resolveTypeBound(t: Type): Type =
        begin
            let var curr = model.stripAliases(model.prune(t))
            (* The nodes passed through: a variable or abstract type by its
             * symbol, a path type by itself *)
            let visited = vector.new(:Type)
            let var done = false
            while not(done) do
                let bound = model.powerBoundOf(curr)
                if maybe.isNone(bound) then
                    done := true
                else
                    let var seen = false
                    for i = 0 upto {vector.length(visited) - 1} do
                        let v = vector.get(visited i)
                        if sameNode(v curr) then seen := true end
                    end
                    if seen then
                        done := true
                    else
                        vector.append(visited curr)
                        curr := model.prune(maybe.unwrap(bound))
                    end
                end
            end
            curr
        end
    let optionCaseNames(t: Type): Array(String) =
        begin
            let var curr = normalizeType(t)
            while not(curr.form?typeOption) do
                let exposed = normalizeType(resolveTypeBound(curr))
                if model.same(exposed curr) then
                    raise notAnOption with model.show(t) <> " is not an option type" end
                end
                curr := exposed
            end
            case curr.form
                when typeOption with x then
                    let names = array of(extent x.options "")
                    for i = 0 upto {extent x.options - 1} do names[i] := x.options[i].name end
                    names
                else array of :String end
            end
        end
    Def OptionIdentity = Tuple empty: Array(String) end
    (* Normalizes t and looks through it until wanted holds or nothing changes.
     * Each round replaces free module abstract types with their
     * representations, or follows a POWER bound if no representation applies.
     * Because a representation may itself be bounded or mention another
     * abstract type, rounds repeat until a fixed point. *)
    let exposedType(t: Type wanted: All(u: Type) Bool): Type =
        begin
            let var curr = normalizeType(t)
            let var stuck = false
            while not(stuck) andif not(wanted(curr)) do
                let reps = model.newSubst()
                for i = 0 upto {extent curr.fv - 1} do
                    let e = abstractTypes.abstractTypeBySymbol(curr.fv[i])
                    if maybe.isSome(e)
                            andif maybe.isSome(maybe.unwrap(e).rep) then
                        hashMap.insert(reps curr.fv[i]
                                maybe.unwrap(maybe.unwrap(e).rep))
                    end
                end
                let var exposed =
                    if hashMap.size(reps) > 0 then
                        normalizeType(model.substitute(curr reps))
                    else
                        curr
                    end
                if model.same(exposed curr) then exposed := normalizeType(resolveTypeBound(curr)) end
                if model.same(exposed curr) then stuck := true else curr := exposed end
            end
            curr
        end

    let optionIdentity(t: Type): maybe.T(OptionIdentity) =
        case exposedType(t fun(u: Type): Bool u.form?typeOption).form
            when typeOption with x then
                let empty = vector.new(:String)
                for i = 0 upto {extent x.options - 1} do
                    let o = x.options[i]
                    let components =
                        if maybe.isSome(o.payload) then
                            case normalizeType(maybe.unwrap(o.payload)).form
                                when typeTuple with y then extent y.fields
                                else 0
                            end
                        else
                            0
                        end
                    if components is 0 then vector.append(empty o.name) end
                end
                maybe.some(tuple let empty = vector.toArray(empty) end)
            else maybe.none()
        end

    let variantCases(t: Type): maybe.T(Array(model.VariantField)) =
        case exposedType(t fun(u: Type): Bool u.form?typeVariant).form
            when typeVariant with x then maybe.some(x.variants)
            else maybe.none()
        end
    Def FunQuantifiers = Tuple quantifiers: Array(model.Quantifier) body: Type end
    let collectFunQuantifiers(funType: Type): FunQuantifiers =
        begin
            let quants = vector.new(:model.Quantifier)
            let var curr = normalizeType(funType)
            let var done = false
            while not(done) do
                case curr.form
                    when typeAll with x then
                        for i = 0 upto {extent x.quantifiers - 1} do
                            vector.append(quants x.quantifiers[i])
                        end
                        curr := normalizeType(x.body)
                    else done := true
                end
            end
            tuple let quantifiers = vector.toArray(quants) let body = curr end
        end
end
