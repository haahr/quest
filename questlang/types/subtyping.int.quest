(* Quest Self-Hosted Compiler: Equi-Recursive Subtyping Interface
 *
 * Implements subtyping, type equivalence, subkinding, and the proof-result
 * cache (the bootstrap's bootstrap/python/quest/types/subtyping.py), using
 * coinductive assumptions for recursive types and a step limit (fuel) for
 * bounded quantification. Equi-recursive means a recursive type equals its
 * unfolding with no explicit fold or unfold; a coinductive assumption is a
 * pair currently being proved that is accepted as true if it recurs, letting
 * proofs over infinite unfoldings terminate. docs/type-system.md §3.1 gives
 * the subkinding and quantifier rules, and §3.2 covers the proofs and cache. *)

interface Subtyping
import
    util/maybe : util/Maybe

    questlang/types/model : questlang/types/Model
export
    (* Environment lookups used to expand type variables' definitions and kind
     * variables; none compares types without environment lookups (the
     * bootstrap's env=None) *)
    Def Env = maybe.T(model.Lookup)

    (* Returns whether sub <: sup. A proof that runs out of steps raises a
     * fatal diagnostics.compilerError.
     *
     * Solves metavariables (inference placeholders) as a side effect: a goal
     * ?A <: T or T <: ?A with ?A unsolved sets ?A's instance to T and
     * succeeds. Solutions are kept even when the proof as a whole fails, so a
     * caller inferring type arguments may call isSubtype only for its
     * solutions and ignore the answer (inferredTypeApp in
     * typechecker/application does). Pairs involving a metavariable are never
     * cached. *)
    isSubtype(sub: model.Type sup: model.Type env: Env): Bool
    (* Both ways, as one proof *)
    isTypeEqual(a: model.Type b: model.Type env: Env): Bool
    isSubkind(sub: model.Kind sup: model.Kind env: Env): Bool
    isKindEqual(a: model.Kind b: model.Kind env: Env): Bool
end
