(* Quest Self-Hosted Compiler: Type Printers Interface
 *
 * The printers of bootstrap/python/quest/types/dump.py: the compact formatter
 * that error messages and the typed AST dump use, the canonical S-expression
 * dump, and the short names of runtime type descriptors. *)

interface Dump
import
    questlang/types/model : questlang/types/Model
export
    (* A type or a kind, compactly: aliases as written, recursion bounded *)
    formatCompact(t: model.Type): String
    formatKindCompact(k: model.Kind): String

    (* A type or a kind as a canonical 2-space indented S-expression
     * (qtype_dump) *)
    typeDump(t: model.Type indent: Int): String
    kindDump(k: model.Kind indent: Int): String

    (* A type as printed, cut off at 80 characters; a recursive type prints as
     * its variable *)
    shortTypeName(t: model.Type): String
end
