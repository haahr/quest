(* Quest Self-Hosted Compiler: Contractiveness of Recursive Types Interface
 *
 * Checks that a recursive type is contractive in its recursion variables (the
 * bootstrap's bootstrap/python/quest/types/contractiveness.py; C succ X in
 * Cardelli and Longo 1991): every recursive reference must be guarded by a
 * type constructor. Rec(L) Tuple head: Int tail: L end is contractive;
 * Rec(X) X and Let Rec A = B and B = A are not. A non-contractive type has no
 * unique meaning, and unfolding it never reaches a type constructor, which
 * model.evaluateLazily relies on. Recursive type elaboration calls this check;
 * docs/type-system.md §3.3 gives the rule. *)

interface Contractiveness
import
    collections/hashMap : collections/HashMap
    util/maybe : util/Maybe

    questlang/types/env : questlang/types/Env
    questlang/types/model : questlang/types/Model
export
    (* Returns whether t is contractive in ids, a set represented by the map's
     * keys. Raises a fatal diagnostics.compilerError past the expansion depth
     * limit. *)
    isTypeContractive(t: model.Type ids: hashMap.T(Int Bool) e: maybe.T(env.T)): Bool
    (* Raises a diagnostics error (not fatal) naming varName, at offset, if t
     * is not contractive in the ids; the bootstrap raises a KindError *)
    checkTypeContractive(t: model.Type ids: hashMap.T(Int Bool) varName: String offset: Int e: maybe.T(env.T)): Ok
end
