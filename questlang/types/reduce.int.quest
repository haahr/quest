(* Quest Self-Hosted Compiler: Reduced Types Interface
 *
 * Reduces type operator applications and unfolds recursive types at a type's
 * head, follows bounds of bounded types, and answers backend queries on option
 * and variant types (such as an option's cases in order and how is compares
 * values). The type checker keeps types as written (docs/type-system.md §2.2)
 * and uses only collectFunQuantifiers (in typechecker/bindings);
 * types/canonical builds canonical forms from these reduced types. The
 * counterpart is bootstrap/python/quest/types/reduce.py. *)

interface Reduce
import
    questlang/types/model : questlang/types/Model
    util/maybe : util/Maybe
export
    (* Several functions expose a type's outermost constructor (its head),
     * differing in what they look through:
     *
     * - model.evaluateLazily(t lookup): used by the checker. Looks through
     *   aliases, applications (tolerating an arity mismatch), recursion, and
     *   type variable definitions in the environment, but not bounds.
     * - normalizeType: used by the backends. Looks through aliases,
     *   recursion, and applications with no environment, cached by node id.
     * - betaReduceHead: reduces applications only, stopping at an arity
     *   mismatch; looks through neither aliases nor recursion.
     * - unfoldRecursive and unfoldRecursiveAny: unfolds recursion and reduces
     *   applications until neither is at the head.
     * - resolveTypeBound: strips aliases, then follows POWER bounds of type
     *   variables, abstract types, and path types to the end
     *   (model.powerBoundOf takes one step).
     * - kinds.unfoldHead: takes one step of recursion or application, or
     *   returns none. kinds' private resolveBound loops over it and over
     *   bounds until a predicate holds (for record, variant, sum, and tuple
     *   bounds); kinds.resolveOptionBound walks on its own.
     *
     * canonical's private canonicalStructure plays the same role as
     * normalizeType for canonical forms. *)

    (* How is compares options of an option type (docs/extensions.md,
     * Options as Values): its cases without components (empty) compare by
     * case, and its other options by identity *)
    Def OptionIdentity = Tuple empty: Array(String) end

    (* The universal quantifiers wrapping a function type (a recursive one,
     * through its unfolding), and the type they quantify, as written: with
     * their own symbols, not those of a canonical form *)
    Def FunQuantifiers = Tuple quantifiers: Array(model.Quantifier) body: model.Type end

    (* The most applications reduced or recursive types unfolded at a type's
     * head before the reduction gives up *)
    maxBetaSteps: Int
    (* An internal error: a type that is not an option where one must be (the
     * bootstrap's ValueError) *)
    notAnOption: Exception(String)
    (* Whether t's head is an application of a type operator, and whether a
     * recursive type or a member of a recursive group *)
    isApp(t: model.Type): Bool
    isRecursive(t: model.Type): Bool
    (* t with the type operator applications at its head beta-reduced, without
     * unfolding recursive types *)
    betaReduceHead(t: model.Type): model.Type
    (* t0 with its head's applications reduced and its recursive types
     * unfolded, until its head is not a recursive type (it may be an
     * application that does not reduce) or maxBetaSteps is reached *)
    unfolding(t0: model.Type): model.Type
    (* Unfolds recursive types and reduces type operator applications at the
     * head of t until the outermost node is neither. Returns none if that does
     * not happen (as for an application of an abstract type operator) or after
     * maxBetaSteps steps. A type whose head is already neither is returned
     * unchanged. *)
    unfoldRecursiveAny(t: model.Type): maybe.T(model.Type)
    (* That unfolding only when it is a type whose values are represented the
     * same as the recursive type's (a tuple, record, variant, option, array,
     * Var, Out, auto, function, All, or exception type); none for anything
     * else, such as Int or a type variable *)
    unfoldRecursive(t: model.Type): maybe.T(model.Type)
    (* t with its outermost constructor exposed: aliases stripped, a recursive
     * type unfolded, an application reduced *)
    normalizeType(t: model.Type): model.Type
    (* t, or for a variable, abstract type, or path type bounded by POWER(T),
     * the type its bounds resolve to *)
    resolveTypeBound(t: model.Type): model.Type
    (* The names of an option type's cases as written, in order (for a parameter
     * bounded by one, its bound's); notAnOption if t is not one *)
    optionCaseNames(t: model.Type): Array(String)
    (* t's option identity, or none if t is not an option type: for a module's
     * abstract type, its representation's, since is compares an abstract
     * type's values as their representation's; for a parameter bounded by an
     * option type, its bound's *)
    optionIdentity(t: model.Type): maybe.T(OptionIdentity)
    (* t's variant cases, or none if t is not a variant type, looked through as
     * optionIdentity looks: is compares two variants of a case by their
     * values at the case's type (docs/extensions.md, Variants as Values) *)
    variantCases(t: model.Type): maybe.T(Array(model.VariantField))
    collectFunQuantifiers(funType: model.Type): FunQuantifiers
end
