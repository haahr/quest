(* Quest Self-Hosted Compiler: Reduced Types Interface
 *
 * bootstrap/python/quest/types/canonical.py's first half: type operator
 * applications reduced and recursive types unfolded at a type's head, a
 * bounded type's bound followed, and the queries on option types the backends
 * make (an option's cases in order, how is compares its values). The checker
 * keeps types as written and uses none of these (docs/type-system.md §2.2);
 * types/canonical builds canonical forms on them. *)

interface Reduce
import
    questlang/types/model : questlang/types/Model
    util/maybe : util/Maybe
export
    (* Exposing a type's outermost constructor (its head). Several functions
     * do it, differing in what they look through; use the one whose
     * difference matters:
     *
     * - model.evaluateLazily(t lookup): the checker's. Aliases, applications
     *   (tolerating a mismatch in arity), and recursion, and a type variable
     *   replaced by its definition in the environment. Not bounds.
     * - normalizeType: the backends'. Aliases, recursion, and
     *   applications, with no environment; cached by node.
     * - betaReduceHead: applications only, stopping at a mismatch in
     *   arity; neither aliases nor recursion.
     * - unfoldRecursive and unfoldRecursiveAny: recursion and
     *   applications until neither is at the head.
     * - resolveTypeBound: aliases, then the POWER bounds of variables,
     *   abstract types, and path types, followed to the end; model.powerBoundOf
     *   takes one such step.
     * - kinds.unfoldHead: one step of recursion or application, or none;
     *   kinds.resolveBound loops over it and over bounds until a predicate
     *   holds, for the checker's record, variant, tuple, and option bounds.
     *
     * canonical's canonicalStructure, private to it, is normalizeType's for
     * canonical forms. *)

    (* How is compares options of an option type (docs/extensions.md,
     * Options as Values): its cases without components compare by case;
     * and if the type is single-word, its one case with components
     * (single) by its one component, of type component *)
    Def OptionIdentity = Tuple empty: Array(String) single: maybe.T(String) component: maybe.T(model.Type) end

    (* The universal quantifiers wrapping a function type (a recursive one,
     * through its unfolding), and the type they quantify, as written *)
    Def FunQuantifiers = Tuple quantifiers: Array(model.Quantifier) body: model.Type end

    (* The most applications reduced or recursive types unfolded at a type's
     * head before the reduction gives up *)
    maxBetaSteps: Int
    (* An internal error: a type that is not an option where one must be (the
     * bootstrap's ValueError) *)
    notAnOption: Exception(String)
    (* Whether t's head is an application of a type operator, and whether a
     * recursive type or a member of a recursive group *)
    isApp(t: model.Type): Bool
    isRecursive(t: model.Type): Bool
    (* t with the type operator applications at its head beta-reduced, without
     * unfolding recursive types *)
    betaReduceHead(t: model.Type): model.Type
    (* t with its head's applications reduced and its recursive types
     * unfolded, until it is neither *)
    unfolding(t0: model.Type): model.Type
    (* t with recursive types at its head unfolded, and type operator
     * applications there reduced, until its outermost node is neither; none
     * if that does not happen, as for an application of an abstract type
     * operator, or after a limit of 1000 steps. A type that is neither is
     * itself *)
    unfoldRecursiveAny(t: model.Type): maybe.T(model.Type)
    (* That unfolding only when it is a type whose values are represented the
     * same as the recursive type's (a tuple, record, variant, option, array,
     * Var, Out, auto, function, All, or exception type); none for anything
     * else, such as Int or a type variable *)
    unfoldRecursive(t: model.Type): maybe.T(model.Type)
    (* t with its outermost constructor exposed: aliases stripped, a recursive
     * type unfolded, an application reduced *)
    normalizeType(t: model.Type): model.Type
    (* t, or for a variable, abstract type, or path type bounded by POWER(T),
     * the type its bounds resolve to *)
    resolveTypeBound(t: model.Type): model.Type
    (* The names of an option type's cases as written, in order (for a parameter
     * bounded by one, its bound's); notAnOption if t is not one *)
    optionCaseNames(t: model.Type): Array(String)
    (* t's option identity, or none if t is not an option type: for a module's
     * abstract type, its representation's, since is compares an abstract
     * type's values as their representation's; for a parameter bounded by an
     * option type, its bound's *)
    optionIdentity(t: model.Type): maybe.T(OptionIdentity)
    collectFunQuantifiers(funType: model.Type): FunQuantifiers
end
