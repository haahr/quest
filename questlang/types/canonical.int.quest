(* Quest Self-Hosted Compiler: Canonical Forms of Types Interface
 *
 * Computes the canonical form of a recursive type by minimizing its graph, so
 * that equal recursive types share one representation however they are written
 * (which the IR uses to build runtime shapes). Canonicalization starts from
 * the reduced forms of types/reduce. The type checker keeps types as written
 * and does not use canonical forms (docs/type-system.md §2.2). The counterpart
 * is bootstrap/python/quest/types/canonical.py, and docs/c-representation.md
 * §5.7 describes the C side. *)

interface Canonical
import
    questlang/types/model : questlang/types/Model
    util/maybe : util/Maybe
export
    (* Returns the canonical form of t if t contains recursion and is not
     * already canonical, or none otherwise (including when t contains unsolved
     * type metavariables). Equal recursive types produce the same canonical
     * form. With QUEST_CHECK_CANONICAL=1, a result that is not equal to t or
     * is not a fixed point (canonicalizing it again changes it) raises
     * canonicalError; otherwise an unequal result prints a warning and returns
     * none. *)
    canonicalType(t: model.Type): maybe.T(model.Type)
    canonicalError: Exception(String)

    (* The placeholders a recursive type's variables are replaced by in its tag,
     * numbered by nesting depth *)
    isRecSelfSymbol(symbolId: Int): Bool
    recSelfVar(level: Int): model.Type
    recSelfLevel(t: model.Type): maybe.T(Int)
end
