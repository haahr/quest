(* Quest Self-Hosted Compiler: Reduced and Canonical Forms of Types Interface
 *
 * bootstrap/python/quest/types/canonical.py: type operator applications
 * reduced, recursive types unfolded, an option type's cases in order, and the
 * canonical form of a type containing recursion, its minimal graph, so that
 * equal types have one representation however they are written (which the IR's
 * shapes are built from). *)

interface Canonical
import
    questlang/types/model : questlang/types/Model
    util/maybe : util/Maybe
export
    (* t with the type operator applications at its head beta-reduced, without
     * unfolding recursive types *)
    betaReduceHead(t: model.Type): model.Type
    (* The unfolding of a recursive type (or an application reducing to one)
     * when it is neither recursive nor an application (unfold_recursive with
     * kinds None) *)
    unfoldRecursiveAny(t: model.Type): maybe.T(model.Type)
    (* The unfolding when it is a constructed type, as values are represented
     * (unfold_recursive's default kinds) *)
    unfoldRecursive(t: model.Type): maybe.T(model.Type)
    (* t with its outermost constructor exposed: aliases stripped, a recursive
     * type unfolded, an application reduced *)
    normalizeType(t: model.Type): model.Type
    (* t, or for a variable, abstract type, or path type bounded by POWER(T),
     * the type its bounds resolve to *)
    resolveTypeBound(t: model.Type): model.Type
    (* The names of an option type's cases as written, in order (for a parameter
     * bounded by one, its bound's); notAnOption if t is not one *)
    optionCaseNames(t: model.Type): Array(String)
    notAnOption: Exception(String)

    (* The universal quantifiers wrapping a function type (a recursive one,
     * through its unfolding), and the type they quantify, as written *)
    Def FunQuantifiers = Tuple quantifiers: Array(model.Quantifier) body: model.Type end
    collectFunQuantifiers(funType: model.Type): FunQuantifiers

    (* The canonical form of t if t contains recursion and is not in canonical
     * form. Equal types containing recursion have the same canonical form. With
     * QUEST_CHECK_CANONICAL=1, a canonical form that is not equal to its type,
     * or not a fixed point, raises canonicalError; otherwise the former is a
     * warning. *)
    canonicalType(t: model.Type): maybe.T(model.Type)
    canonicalError: Exception(String)

    (* The placeholders a recursive type's variables are replaced by in its tag,
     * numbered by nesting depth *)
    isRecSelfSymbol(symbolId: Int): Bool
    recSelfVar(level: Int): model.Type
    recSelfLevel(t: model.Type): maybe.T(Int)
end
