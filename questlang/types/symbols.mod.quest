(* Quest Self-Hosted Compiler: Symbols and Lexical Scopes Implementation *)

module symbols : Symbols
import
    collections/hashMap : collections/HashMap
    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/maps : questlang/common/Maps
    questlang/types/model : questlang/types/Model
export
    (* ======================================================================
     * 1. Symbols
     * ====================================================================== *)

    Let ValueSymbol = Tuple
        name: String
        type: model.Type
        isVar: Bool
        isOut: Bool
        isParam: Bool
        functionDepth: Int
        symbolId: Int
    end

    Let TypeSymbol = Tuple
        name: String
        symbolId: Int
        kind: model.Kind
        var definition: maybe.T(model.Type)
    end

    Let KindSymbol = Tuple name: String symbolId: Int kind: model.Kind end

    Let Symbol = Option
        valueSymbol with sym: ValueSymbol end
        typeSymbol with sym: TypeSymbol end
        kindSymbol with sym: KindSymbol end
    end

    Let Counters = Tuple var values: Int var symbols: Int var generation: Int end
    let counters: Counters = tuple let var values = 0 let var symbols = 0 let var generation = 0 end

    (* Global tables of every declared type and kind symbol by id, together with
     * the ids that a lookup saw undeclared (or, for types, without a
     * definition). Because meanings only become more defined, cached type
     * judgments go stale only when one of these ids gains a meaning. *)
    let typesById = maps.newIntMap(:TypeSymbol)
    let kindsById = maps.newIntMap(:KindSymbol)
    let typeIdsSeenUndefined = maps.newIntSet()
    let kindIdsSeenUndefined = maps.newIntSet()

    (* Increments the counter meaningGeneration returns, whenever a symbol id
     * gains or changes a meaning after a lookup saw it undefined *)
    let meaningsChanged(): Ok = counters.generation := counters.generation + 1

    (* The symbols failed declarations bound, by id: value ids have a counter of
     * their own *)
    let poisonedValues = maps.newIntSet()
    let poisonedTypes = maps.newIntSet()
    let poisonValue(symbolId: Int): Ok = begin hashSet.insert(poisonedValues symbolId) ok end
    let isPoisonedValue(symbolId: Int): Bool = hashSet.contains(poisonedValues symbolId)
    let poisonTypeOrKind(symbolId: Int): Ok = begin hashSet.insert(poisonedTypes symbolId) ok end
    let isPoisonedTypeOrKind(symbolId: Int): Bool = hashSet.contains(poisonedTypes symbolId)
    let meaningGeneration(): Int = counters.generation

    let newValueSymbol(
            name: String type: model.Type isVar: Bool isOut: Bool isParam: Bool functionDepth: Int symbolId: Int
            ): ValueSymbol =
        begin
            let id =
                if symbolId is 0 then
                    counters.values := counters.values + 1
                    counters.values
                else
                    symbolId
                end
            tuple
                let name = name
                let type = type
                let isVar = isVar
                let isOut = isOut
                let isParam = isParam
                let functionDepth = functionDepth
                let symbolId = id
            end
        end

    let valueSymbol(name: String type: model.Type): ValueSymbol = newValueSymbol(name type false false false 0 0)

    let newTypeSymbol(name: String symbolId: Int kind: model.Kind definition: maybe.T(model.Type)): TypeSymbol =
        tuple let name = name let symbolId = symbolId let kind = kind let var definition = definition end

    let defineType(sym: TypeSymbol definition: model.Type): Ok =
        if maybe.isSome(sym.definition) then
            if not(model.same(maybe.unwrap(sym.definition) definition)) then
                diagnostics.internal(:Ok "Type symbol '" <> sym.name <> "' is already defined" 0)
            end
        else
            if hashSet.contains(typeIdsSeenUndefined sym.symbolId) then meaningsChanged() end
            sym.definition := maybe.some(definition)
        end

    let isAbstract(sym: TypeSymbol): Bool = maybe.isNone(sym.definition)

    let newKindSymbol(name: String symbolId: Int kind: model.Kind): KindSymbol =
        tuple let name = name let symbolId = symbolId let kind = kind end

    (* ======================================================================
     * 2. Scopes
     * ====================================================================== *)

    Let Rec Scope = Tuple
        parent: maybe.T(Scope)
        name: String
        var moduleName: maybe.T(String)
        var isUnsound: Bool
        var isLocal: Bool
        var declarations: vector.T(Symbol)
        var values: maps.StringMap(ValueSymbol)
        var types: maps.StringMap(TypeSymbol)
        var typesById: maps.IntMap(TypeSymbol)
        var kinds: maps.StringMap(KindSymbol)
        var kindsById: maps.IntMap(KindSymbol)
    end

    let newScope(parent: maybe.T(Scope) name: String): Scope =
        tuple
            let parent = parent
            let name = name
            let var moduleName = maybe.none()
            let var isUnsound = false
            let var isLocal = false
            let var declarations = vector.new()
            let var values = maps.newStringMap()
            let var types = maps.newStringMap()
            let var typesById = maps.newIntMap()
            let var kinds = maps.newStringMap()
            let var kindsById = maps.newIntMap()
        end

    let declareValue(s: Scope sym: ValueSymbol): ValueSymbol =
        begin
            vector.append(s.declarations option valueSymbol of Symbol with let sym = sym end)
            hashMap.insert(s.values sym.name sym)
            sym
        end

    let sameDefinition(a: maybe.T(model.Type) b: maybe.T(model.Type)): Bool =
        if maybe.isSome(a) andif maybe.isSome(b) then
            model.same(maybe.unwrap(a) maybe.unwrap(b))
        else
            maybe.isNone(a) andif maybe.isNone(b)
        end

    let declareType(s: Scope sym: TypeSymbol): TypeSymbol =
        begin
            vector.append(s.declarations option typeSymbol of Symbol with let sym = sym end)
            hashMap.insert(s.types sym.name sym)
            hashMap.insert(s.typesById sym.symbolId sym)
            let previous = hashMap.get(typesById sym.symbolId)
            if maybe.isSome(sym.definition)
                    andif {hashSet.contains(typeIdsSeenUndefined sym.symbolId)
                            orif {maybe.isSome(previous)
                                    andif not(sameDefinition(maybe.unwrap(previous).definition sym.definition))}} then
                meaningsChanged()
            end
            hashMap.insert(typesById sym.symbolId sym)
            sym
        end

    let declareTypeVariable(
            s: Scope name: String symbolId: Int kind: model.Kind definition: maybe.T(model.Type)
            ): TypeSymbol = declareType(s newTypeSymbol(name symbolId kind definition))

    let declareKind(s: Scope sym: KindSymbol): KindSymbol =
        begin
            vector.append(s.declarations option kindSymbol of Symbol with let sym = sym end)
            hashMap.insert(s.kinds sym.name sym)
            hashMap.insert(s.kindsById sym.symbolId sym)
            let previous = hashMap.get(kindsById sym.symbolId)
            if hashSet.contains(kindIdsSeenUndefined sym.symbolId)
                    orif {maybe.isSome(previous)
                            andif not(model.sameKind(maybe.unwrap(previous).kind sym.kind))} then
                meaningsChanged()
            end
            hashMap.insert(kindsById sym.symbolId sym)
            sym
        end

    let lookupValueLocal(s: Scope name: String): maybe.T(ValueSymbol) = hashMap.get(s.values name)
    let lookupTypeLocal(s: Scope name: String): maybe.T(TypeSymbol) = hashMap.get(s.types name)
    let lookupTypeByIdLocal(s: Scope symbolId: Int): maybe.T(TypeSymbol) = hashMap.get(s.typesById symbolId)
    let lookupKindLocal(s: Scope name: String): maybe.T(KindSymbol) = hashMap.get(s.kinds name)
    let lookupKindByIdLocal(s: Scope symbolId: Int): maybe.T(KindSymbol) = hashMap.get(s.kindsById symbolId)

    (* A lookup through a scope and its parents *)
    let chain(A::TYPE K::TYPE)(local: All(s: Scope key: K) maybe.T(A)): All(s: Scope key: K) maybe.T(A) =
        begin
            let rec find(s: Scope key: K): maybe.T(A) =
                begin
                    let found = local(s key)
                    if maybe.isSome(found) orif maybe.isNone(s.parent) then found
                    else find(maybe.unwrap(s.parent) key)
                    end
                end
            find
        end

    let lookupValue(s: Scope name: String): maybe.T(ValueSymbol) = chain(:ValueSymbol :String)(lookupValueLocal)(s name)
    let lookupType(s: Scope name: String): maybe.T(TypeSymbol) = chain(:TypeSymbol :String)(lookupTypeLocal)(s name)
    let lookupTypeById(s: Scope symbolId: Int): maybe.T(TypeSymbol) =
        chain(:TypeSymbol :Int)(lookupTypeByIdLocal)(s symbolId)
    let lookupKind(s: Scope name: String): maybe.T(KindSymbol) = chain(:KindSymbol :String)(lookupKindLocal)(s name)
    let lookupKindById(s: Scope symbolId: Int): maybe.T(KindSymbol) =
        chain(:KindSymbol :Int)(lookupKindByIdLocal)(s symbolId)

    (* ======================================================================
     * 3. Symbol ids and meanings
     * ====================================================================== *)

    let allocateSymbolId(): Int =
        begin
            counters.symbols := counters.symbols + 1
            counters.symbols
        end

    let typeSymbolById(symbolId: Int): maybe.T(TypeSymbol) =
        begin
            let sym = hashMap.get(typesById symbolId)
            if maybe.isNone(sym) orif isAbstract(maybe.unwrap(sym)) then
                hashSet.insert(typeIdsSeenUndefined symbolId)
            end
            sym
        end

    let kindSymbolById(symbolId: Int): maybe.T(KindSymbol) =
        begin
            let sym = hashMap.get(kindsById symbolId)
            if maybe.isNone(sym) then hashSet.insert(kindIdsSeenUndefined symbolId) end
            sym
        end

    let lookup: model.Lookup =
        tuple
            let typeDefinition = fun(symbolId: Int): maybe.T(model.Type)
                begin
                    let sym = typeSymbolById(symbolId)
                    if maybe.isSome(sym) then
                        maybe.unwrap(sym).definition
                    else
                        maybe.none()
                    end
                end
            let kindOf = fun(symbolId: Int): maybe.T(model.Kind)
                begin
                    let sym = kindSymbolById(symbolId)
                    if maybe.isSome(sym) then
                        maybe.some(maybe.unwrap(sym).kind)
                    else
                        maybe.none()
                    end
                end
        end
end
