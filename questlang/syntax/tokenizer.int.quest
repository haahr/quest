(* Quest Self-Hosted Compiler: Lexical Analyzer Interface
 *
 * Splits a source file's text into tokens (tokens.Token: a kind, the lexeme,
 * the literal's value, and the span of characters it covers) for the parser,
 * skipping whitespace and nested (* ... *) comments. Callers usually take the
 * whole file at once with tokenizeAll and hand the vector to the parser.
 *
 * Errors: malformed input (an unterminated string, an unknown escape, an
 * out-of-range integer, an unexpected character) is reported to the
 * diagnostic bag given to new, and lexing goes on: the bad literal still
 * yields a token, with a placeholder value where none could be read, and an
 * unexpected character is skipped. The tokenizer does not raise; the caller
 * decides from the bag whether to stop. The bootstrap counterpart,
 * bootstrap/python/quest/syntax/tokenizer.py, instead raises TokenizerError
 * at the first error. docs/syntax.md §2 describes the lexical rules *)

interface Tokenizer
import
    questlang/common/location : questlang/common/Location
    questlang/common/diagbag : questlang/common/DiagBag
    questlang/syntax/tokens : questlang/syntax/Tokens
    collections/vector : collections/Vector
export
    (* Abstract tokenizer state type *)
    T::TYPE

    (* Create a new tokenizer for a given source map and diagnostic bag *)
    new(sm: location.SourceMap bag: diagbag.T): T

    (* Return the next token, advancing the stream *)
    nextToken(tok: T): tokens.Token

    (* Peek at the next token without advancing *)
    peekToken(tok: T): tokens.Token

    (* Tokenize the entire input stream into a vector of tokens ending with
     * EOF *)
    tokenizeAll(tok: T): vector.T(tokens.Token)

    (* The keywords, as they are spelled (the Jupyter kernel's completions) *)
    keywordNames(): Array(String)

    (* Format a list of tokens matching the canonical golden test output:
     * <line>:<col>\t<KIND_NAME>\t<lexeme>
     *)
    formatDump(tokensList: vector.T(tokens.Token) sm: location.SourceMap showValues: Bool): String
end
