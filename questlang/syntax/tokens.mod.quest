(* Quest Self-Hosted Compiler: Lexical Tokens Implementation *)

module tokens : Tokens
import
    stringOp = string : StringOp

    hashMap = collections/hashmap : collections/HashMap
    hash = util/hash : util/Hash
    util/maybe : util/Maybe

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/location : questlang/common/Location
export
    Let TokenKind = Option
        eof
        intLit
        realLit
        charLit
        stringLit
        ident
        symbolicInfix
        lparen
        rparen
        lbracket
        rbracket
        lbrace
        rbrace
        comma
        semicolon
        dot
        colon
        colonColon
        subtype
        assign
        equal
        question
        bang
        at
        underscore
        kwType
        kwPower
        kwAllKind
        kwDefKind
        kwAll
        kwArrayType
        kwAutoType
        kwDef
        kwExceptionType
        kwFunType
        kwLetType
        kwOptionType
        kwOutType
        kwRecType
        kwRecordType
        kwTupleType
        kwVarType
        kwVariantType
        kwAnd
        kwAndif
        kwArray
        kwAs
        kwAuto
        kwBegin
        kwCase
        kwDo
        kwDownto
        kwElse
        kwElsif
        kwEnd
        kwException
        kwExit
        kwExport
        kwExtent
        kwExternal
        kwFalse
        kwFor
        kwFun
        kwIf
        kwImport
        kwInspect
        kwInterface
        kwIs
        kwIsnot
        kwLet
        kwLoop
        kwModule
        kwNot
        kwOf
        kwOk
        kwOption
        kwOrdinal
        kwOrif
        kwOut
        kwRaise
        kwRec
        kwRecord
        kwThen
        kwTrue
        kwTry
        kwTuple
        kwUnsound
        kwUpto
        kwVar
        kwVariant
        kwWhen
        kwWhile
        kwWith
    end

    Let TokenValue = Option
        none
        intVal with val: Int end
        realVal with val: Real end
        charVal with val: Char end
        stringVal with val: String end
    end

    Let Token = Tuple
        kind: TokenKind
        lexeme: String
        value: TokenValue
        span: location.Span
    end

    let make(kind: TokenKind lexeme: String value: TokenValue span: location.Span): Token =
        tuple
            let kind = kind
            let lexeme = lexeme
            let value = value
            let span = span
        end

    let valNone(): TokenValue =
        option none of TokenValue end

    let valInt(n: Int): TokenValue = option intVal of TokenValue with let val = n end

    let valReal(r: Real): TokenValue = option realVal of TokenValue with let val = r end

    let valChar(c: Char): TokenValue = option charVal of TokenValue with let val = c end

    let valString(s: String): TokenValue = option stringVal of TokenValue with let val = s end

    let eofToken(file: String offset: Int): Token =
        make(option eof of TokenKind end "" valNone() location.pointSpan(file offset))

    (* ======================================================================
     * What each kind is
     * ====================================================================== *)

    Let TokenClass = Option
        endOfInput
        literal
        word
        delimiter
        punctuation
        keyword
    end

    Let Bracket = Option
        notBracket
        opening with partner: TokenKind end
        closing with partner: TokenKind end
    end

    Let KindInfo = Tuple
        kind: TokenKind
        name: String
        spelling: maybe.T(String)
        class: TokenClass
        bracket: Bracket
        closedByEnd: Bool
        startsDeclaration: Bool
    end

    Let K = TokenKind

    let row(k: K name: String spelling: maybe.T(String) class: TokenClass bracket: Bracket closedByEnd: Bool
            startsDeclaration: Bool): KindInfo =
        tuple
            let kind = k
            let name = name
            let spelling = spelling
            let class = class
            let bracket = bracket
            let closedByEnd = closedByEnd
            let startsDeclaration = startsDeclaration
        end

    let noBracket = option notBracket of Bracket end

    (* The rows of each class: the kinds without one spelling, the ones with
     * one, and the keywords by what they start *)
    let unspelled(k: K name: String class: TokenClass): KindInfo = row(k name maybe.none() class noBracket false false)
    let literalRow(k: K name: String): KindInfo = unspelled(k name option literal of TokenClass end)
    let wordRow(k: K name: String): KindInfo = unspelled(k name option word of TokenClass end)
    let bracketRow(k: K name: String s: String bracket: Bracket): KindInfo =
        row(k name maybe.some(s) option delimiter of TokenClass end bracket false false)
    let delimiterRow(k: K name: String s: String): KindInfo = bracketRow(k name s noBracket)
    let openingRow(k: K name: String s: String partner: K): KindInfo =
        bracketRow(k name s option opening of Bracket with let partner = partner end)
    let closingRow(k: K name: String s: String partner: K): KindInfo =
        bracketRow(k name s option closing of Bracket with let partner = partner end)
    let punctuationRow(k: K name: String s: String): KindInfo =
        row(k name maybe.some(s) option punctuation of TokenClass end noBracket false false)
    let keywordOf(k: K name: String s: String closedByEnd: Bool startsDeclaration: Bool): KindInfo =
        row(k name maybe.some(s) option keyword of TokenClass end noBracket closedByEnd startsDeclaration)
    let keywordRow(k: K name: String s: String): KindInfo = keywordOf(k name s false false)
    (* A keyword whose construct end closes *)
    let openerRow(k: K name: String s: String): KindInfo = keywordOf(k name s true false)
    (* A keyword that starts a declaration *)
    let declarationRow(k: K name: String s: String): KindInfo = keywordOf(k name s false true)

    let kindTable = array of
        unspelled(option eof of K end "EOF" option endOfInput of TokenClass end)
        literalRow(option intLit of K end "INT_LIT")
        literalRow(option realLit of K end "REAL_LIT")
        literalRow(option charLit of K end "CHAR_LIT")
        literalRow(option stringLit of K end "STRING_LIT")
        wordRow(option ident of K end "IDENT")
        wordRow(option symbolicInfix of K end "SYMBOLIC_INFIX")
        openingRow(option lparen of K end "LPAREN" "(" option rparen of K end)
        closingRow(option rparen of K end "RPAREN" ")" option lparen of K end)
        openingRow(option lbracket of K end "LBRACKET" "[" option rbracket of K end)
        closingRow(option rbracket of K end "RBRACKET" "]" option lbracket of K end)
        openingRow(option lbrace of K end "LBRACE" "{" option rbrace of K end)
        closingRow(option rbrace of K end "RBRACE" "}" option lbrace of K end)
        delimiterRow(option comma of K end "COMMA" ",")
        delimiterRow(option semicolon of K end "SEMICOLON" ";")
        punctuationRow(option dot of K end "DOT" ".")
        punctuationRow(option colon of K end "COLON" ":")
        punctuationRow(option colonColon of K end "COLON_COLON" "::")
        punctuationRow(option subtype of K end "SUBTYPE" "<:")
        punctuationRow(option assign of K end "ASSIGN" ":=")
        punctuationRow(option equal of K end "EQUAL" "=")
        punctuationRow(option question of K end "QUESTION" "?")
        punctuationRow(option bang of K end "BANG" "!")
        punctuationRow(option at of K end "AT" "@")
        punctuationRow(option underscore of K end "UNDERSCORE" "_")
        keywordRow(option kwType of K end "KW_TYPE" "TYPE")
        keywordRow(option kwPower of K end "KW_POWER" "POWER")
        keywordRow(option kwAllKind of K end "KW_ALL_KIND" "ALL")
        declarationRow(option kwDefKind of K end "KW_DEF_KIND" "DEF")
        keywordRow(option kwAll of K end "KW_ALL" "All")
        keywordRow(option kwArrayType of K end "KW_ARRAY_TYPE" "Array")
        openerRow(option kwAutoType of K end "KW_AUTO_TYPE" "Auto")
        declarationRow(option kwDef of K end "KW_DEF" "Def")
        keywordRow(option kwExceptionType of K end "KW_EXCEPTION_TYPE" "Exception")
        keywordRow(option kwFunType of K end "KW_FUN_TYPE" "Fun")
        declarationRow(option kwLetType of K end "KW_LET_TYPE" "Let")
        openerRow(option kwOptionType of K end "KW_OPTION_TYPE" "Option")
        keywordRow(option kwOutType of K end "KW_OUT_TYPE" "Out")
        keywordRow(option kwRecType of K end "KW_REC_TYPE" "Rec")
        openerRow(option kwRecordType of K end "KW_RECORD_TYPE" "Record")
        openerRow(option kwTupleType of K end "KW_TUPLE_TYPE" "Tuple")
        keywordRow(option kwVarType of K end "KW_VAR_TYPE" "Var")
        openerRow(option kwVariantType of K end "KW_VARIANT_TYPE" "Variant")
        keywordRow(option kwAnd of K end "KW_AND" "and")
        keywordRow(option kwAndif of K end "KW_ANDIF" "andif")
        keywordRow(option kwArray of K end "KW_ARRAY" "array")
        keywordRow(option kwAs of K end "KW_AS" "as")
        openerRow(option kwAuto of K end "KW_AUTO" "auto")
        openerRow(option kwBegin of K end "KW_BEGIN" "begin")
        openerRow(option kwCase of K end "KW_CASE" "case")
        keywordRow(option kwDo of K end "KW_DO" "do")
        keywordRow(option kwDownto of K end "KW_DOWNTO" "downto")
        keywordRow(option kwElse of K end "KW_ELSE" "else")
        keywordRow(option kwElsif of K end "KW_ELSIF" "elsif")
        keywordRow(option kwEnd of K end "KW_END" "end")
        openerRow(option kwException of K end "KW_EXCEPTION" "exception")
        keywordRow(option kwExit of K end "KW_EXIT" "exit")
        keywordRow(option kwExport of K end "KW_EXPORT" "export")
        keywordRow(option kwExtent of K end "KW_EXTENT" "extent")
        keywordRow(option kwExternal of K end "KW_EXTERNAL" "external")
        keywordRow(option kwFalse of K end "KW_FALSE" "false")
        openerRow(option kwFor of K end "KW_FOR" "for")
        keywordRow(option kwFun of K end "KW_FUN" "fun")
        openerRow(option kwIf of K end "KW_IF" "if")
        keywordRow(option kwImport of K end "KW_IMPORT" "import")
        openerRow(option kwInspect of K end "KW_INSPECT" "inspect")
        keywordOf(option kwInterface of K end "KW_INTERFACE" "interface" true true)
        keywordRow(option kwIs of K end "KW_IS" "is")
        keywordRow(option kwIsnot of K end "KW_ISNOT" "isnot")
        declarationRow(option kwLet of K end "KW_LET" "let")
        openerRow(option kwLoop of K end "KW_LOOP" "loop")
        keywordOf(option kwModule of K end "KW_MODULE" "module" true true)
        keywordRow(option kwNot of K end "KW_NOT" "not")
        keywordRow(option kwOf of K end "KW_OF" "of")
        keywordRow(option kwOk of K end "KW_OK" "ok")
        openerRow(option kwOption of K end "KW_OPTION" "option")
        keywordRow(option kwOrdinal of K end "KW_ORDINAL" "ordinal")
        keywordRow(option kwOrif of K end "KW_ORIF" "orif")
        keywordRow(option kwOut of K end "KW_OUT" "out")
        openerRow(option kwRaise of K end "KW_RAISE" "raise")
        keywordRow(option kwRec of K end "KW_REC" "rec")
        openerRow(option kwRecord of K end "KW_RECORD" "record")
        keywordRow(option kwThen of K end "KW_THEN" "then")
        keywordRow(option kwTrue of K end "KW_TRUE" "true")
        openerRow(option kwTry of K end "KW_TRY" "try")
        openerRow(option kwTuple of K end "KW_TUPLE" "tuple")
        declarationRow(option kwUnsound of K end "KW_UNSOUND" "unsound")
        keywordRow(option kwUpto of K end "KW_UPTO" "upto")
        keywordRow(option kwVar of K end "KW_VAR" "var")
        openerRow(option kwVariant of K end "KW_VARIANT" "variant")
        keywordRow(option kwWhen of K end "KW_WHEN" "when")
        openerRow(option kwWhile of K end "KW_WHILE" "while")
        keywordRow(option kwWith of K end "KW_WITH" "with")
    end

    (* Each row is at its kind's ordinal, which info relies on *)
    let checked =
        for i = 0 upto {extent kindTable - 1} do
            if ordinal(kindTable[i].kind) isnot i then
                diagnostics.internal(:Ok "tokens.kindTable: the row of " <> kindTable[i].name <> " is out of order" 0)
            end
        end

    let info(kind: TokenKind): KindInfo = kindTable[ordinal(kind)]

    let byName =
        begin
            let m = hashMap.new(:String :TokenKind stringOp.equal hash.string)
            for i = 0 upto {extent kindTable - 1} do hashMap.insert(m kindTable[i].name kindTable[i].kind) end
            m
        end

    let kindNamed(name: String): maybe.T(TokenKind) = hashMap.get(byName name)
    let tokenKindName(kind: TokenKind): String = info(kind).name
    let spelling(kind: TokenKind): maybe.T(String) = info(kind).spelling
    let sameKind(a: TokenKind b: TokenKind): Bool = ordinal(a) is ordinal(b)

    let isLiteral(kind: TokenKind): Bool = info(kind).class?literal
    let isDelimiter(kind: TokenKind): Bool = info(kind).class?delimiter
    let isPunctuation(kind: TokenKind): Bool = info(kind).class?punctuation
    let isKeyword(kind: TokenKind): Bool = info(kind).class?keyword
    let isOpening(kind: TokenKind): Bool = info(kind).bracket?opening
    let isClosing(kind: TokenKind): Bool = info(kind).bracket?closing
    let partner(kind: TokenKind): maybe.T(TokenKind) =
        case info(kind).bracket
            when opening with b then maybe.some(b.partner)
            when closing with b then maybe.some(b.partner)
            else maybe.none()
        end
    let closedByEnd(kind: TokenKind): Bool = info(kind).closedByEnd
    let startsDeclaration(kind: TokenKind): Bool = info(kind).startsDeclaration
end
