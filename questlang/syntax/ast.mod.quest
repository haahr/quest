(* Quest Self-Hosted Compiler: Abstract Syntax Tree Implementation *)

module ast : Ast
import
    questlang/common/location : questlang/common/Location
    collections/vector : collections/Vector
    util/maybe : util/Maybe
export
    (* =========================================================================
     * 1. Parameter Modes
     * ========================================================================= *)

    Let ParamMode = Option
        modeValue
        modeVar
        modeOut
    end;

    (* =========================================================================
     * 2. Parameterized Node Wrapper
     * ========================================================================= *)

    Let Node(Form::TYPE) = Tuple
        span: location.Span
        form: Form
    end;

    (* =========================================================================
     * 3. Level 1 & 2: Types and Kinds (TypeForm)
     *
     * The components of type and kind forms are written once, as operators over the type of the subterms
     * (T, a Node(TypeForm)), so that TypeForm can use them before it is defined; the named types below
     * apply them to TypeExpr.
     * ========================================================================= *)

    Let TypeFormalOf(T::TYPE) = Tuple name: String bound: T end;
    Let QuantifierOf(T::TYPE) = Tuple name: String bound: T mode: ParamMode isType: Bool end;
    Let FieldSigOf(T::TYPE) = Tuple name: maybe.T(String) typeSig: maybe.T(T) mode: ParamMode end;
    Let RecordFieldSigOf(T::TYPE) = Tuple name: String typeSig: T isVar: Bool end;
    Let OptionFieldSigOf(T::TYPE) = Tuple tag: String payloadSig: vector.T(FieldSigOf(T)) end;
    Let VariantFieldSigOf(T::TYPE) = Tuple tag: String typeSig: T isVar: Bool end;
    Let TypeBindingOf(T::TYPE) = Tuple
        name: String
        typeVal: T
        params: vector.T(TypeFormalOf(T))
        bound: maybe.T(T)
        isRec: Bool
        isDef: Bool
    end;
    (* A component of a signature, which a tuple type or an interface is: a value's signature, an abstract
     * type, a type binding (Let [Rec] or Def [Rec]), a group of type bindings joined by and, or a kind
     * binding (DEF) *)
    Let SignatureOf(T::TYPE) = Option
        sigValue with val: FieldSigOf(T) end
        sigType with val: TypeFormalOf(T) end
        sigTypeBinding with val: TypeBindingOf(T) end
        sigTypeBindingGroup with val: vector.T(TypeBindingOf(T)) end
        sigKindBinding with val: Tuple name: String kindVal: T end end
    end;

    Let Rec TypeForm = Option
        (* Level 2: Kinds *)
        kindType
        kindPower with bound: Node(TypeForm) end
        kindAll with paramName: String paramKind: Node(TypeForm) bodyKind: Node(TypeForm) end
        kindId with name: String end
        kindManifest with interfaceName: String kindName: String end

        (* Level 1: Types *)
        typePath with path: vector.T(String) end
        typeAll with quantifiers: vector.T(QuantifierOf(Node(TypeForm))) resultType: Node(TypeForm) end
        typeTuple with fields: vector.T(SignatureOf(Node(TypeForm))) end
        typeRecord with fields: vector.T(RecordFieldSigOf(Node(TypeForm))) end
        typeOption with variants: vector.T(OptionFieldSigOf(Node(TypeForm))) end
        typeVariant with fields: vector.T(VariantFieldSigOf(Node(TypeForm))) end
        typeAuto with
            typeParam: maybe.T(String)
            kindBound: Node(TypeForm)
            signature: vector.T(FieldSigOf(Node(TypeForm)))
        end
        typeFun with
            params: vector.T(TypeFormalOf(Node(TypeForm)))
            resultKind: maybe.T(Node(TypeForm))
            body: Node(TypeForm)
        end
        typeRec with varName: String bound: Node(TypeForm) body: Node(TypeForm) end
        typeApp with constructor: Node(TypeForm) arguments: vector.T(Node(TypeForm)) end
        typeInfix with left: Node(TypeForm) op: String right: Node(TypeForm) end
        typeArray with elementType: Node(TypeForm) end
        typeVar with elementType: Node(TypeForm) end
        typeOut with elementType: Node(TypeForm) end
        typeManifest with moduleName: String typeName: String end
        typeExternal with cType: String end
    end;

    Let TypeExpr = Node(TypeForm);
    Let KindExpr = Node(TypeForm);

    Let TypeFormal = TypeFormalOf(KindExpr);
    Let Quantifier = QuantifierOf(KindExpr);
    Let FieldSig = FieldSigOf(TypeExpr);
    Let RecordFieldSig = RecordFieldSigOf(TypeExpr);
    Let OptionFieldSig = OptionFieldSigOf(TypeExpr);
    Let VariantFieldSig = VariantFieldSigOf(TypeExpr);
    Let TypeBinding = TypeBindingOf(TypeExpr);
    Let Signature = SignatureOf(TypeExpr);

    Let FormalParam = Tuple
        name: String
        typeAnnot: maybe.T(TypeExpr)
        mode: ParamMode
    end;

    Let InspectBinder = Tuple
        name: String
        typeAnnot: maybe.T(TypeExpr)
    end;

    (* =========================================================================
     * 4. Level 0: Expressions and Declarations (ExprForm)
     *
     * As for types, the components of expression forms are operators over the type of the subterms (E, a
     * Node(ExprForm)), applied to Expr by the named types below.
     * ========================================================================= *)

    Let ElsifBranchOf(E::TYPE) = Tuple cond: E thenBranch: E end;
    Let TupleFieldBindingOf(E::TYPE) = Tuple
        name: maybe.T(String)
        value: E
        typeAnnot: maybe.T(TypeExpr)
        isVar: Bool
    end;
    (* A component of a tuple: a value, values joined by and (without rec), or a declaration (a type, a kind, or
     * recursive values) *)
    Let TupleFieldOf(E::TYPE) = Option
        fieldVal with val: TupleFieldBindingOf(E) end
        fieldGroup with val: vector.T(TupleFieldBindingOf(E)) end
        fieldDecl with val: E end
    end;
    Let RecordBindingOf(E::TYPE) = Tuple name: String value: E isVar: Bool end;
    Let CaseBranchOf(E::TYPE) = Tuple
        tags: vector.T(String)
        binder: maybe.T(String)
        binderType: maybe.T(TypeExpr)
        body: E
    end;
    Let InspectBranchOf(E::TYPE) = Tuple matchType: TypeExpr binders: vector.T(InspectBinder) body: E end;
    Let TryBranchOf(E::TYPE) = Tuple
        excPattern: E
        binder: maybe.T(String)
        binderType: maybe.T(TypeExpr)
        body: E
    end;

    Let Rec ExprForm = Option
        (* Literals *)
        exprInt with value: Int lexeme: String end
        exprReal with value: Real lexeme: String end
        exprChar with value: Char lexeme: String end
        exprString with value: String lexeme: String end
        exprBool with value: Bool end
        exprOk

        (* Identifiers & Arguments *)
        exprId with name: String end
        exprExternal with symbol: String end
        typeArg with typeVal: TypeExpr end
        kindArg with kindVal: KindExpr end

        (* Control Flow & Blocks *)
        exprBlock with bindings: vector.T(Node(ExprForm)) end
        exprIf with
            cond: Node(ExprForm)
            thenBranch: Node(ExprForm)
            elsifs: vector.T(ElsifBranchOf(Node(ExprForm)))
            elseBranch: maybe.T(Node(ExprForm))
        end
        exprWhile with cond: Node(ExprForm) body: Node(ExprForm) end
        exprLoop with body: Node(ExprForm) end
        exprExit
        exprFor with
            varName: String
            start: Node(ExprForm)
            isDownto: Bool
            stop: Node(ExprForm)
            body: Node(ExprForm)
        end

        (* Functions & Calls *)
        exprFun with
            params: vector.T(FormalParam)
            returnType: maybe.T(TypeExpr)
            body: Node(ExprForm)
            typeParams: vector.T(TypeFormal)
        end
        exprApp with func: Node(ExprForm) args: vector.T(Node(ExprForm)) end
        exprInfix with left: Node(ExprForm) op: String right: Node(ExprForm) end

        (* Aggregates *)
        exprTuple with fields: vector.T(TupleFieldOf(Node(ExprForm))) end
        exprRecord with fields: vector.T(RecordBindingOf(Node(ExprForm))) end
        exprArray with elements: vector.T(Node(ExprForm)) elementType: maybe.T(TypeExpr) end
        exprArrayRep with count: Node(ExprForm) initVal: Node(ExprForm) end
        exprOption with
            tag: maybe.T(String)
            optionType: TypeExpr
            payload: maybe.T(Node(ExprForm))
            ordinalExpr: maybe.T(Node(ExprForm))
        end
        exprVariant with tag: String variantType: TypeExpr isVar: Bool payload: maybe.T(Node(ExprForm)) end
        (* auto [let witnessName [witnessBound] =] :witnessType with payload end *)
        exprAuto with
            witnessType: TypeExpr
            payload: Node(ExprForm)
            witnessName: maybe.T(String)
            witnessBound: maybe.T(KindExpr)
        end

        (* Selection, Indexing, and References *)
        exprSelect with target: Node(ExprForm) field: String end
        exprIndex with target: Node(ExprForm) index: Node(ExprForm) end
        exprIndexAssign with target: Node(ExprForm) index: Node(ExprForm) value: Node(ExprForm) end
        exprVarCell with value: Node(ExprForm) end
        exprDerefCell with target: Node(ExprForm) end
        exprVariantCheck with target: Node(ExprForm) tag: String end
        exprVariantAssert with target: Node(ExprForm) tag: String end

        (* Pattern Matching & Exceptions *)
        exprCase with
            target: Node(ExprForm)
            branches: vector.T(CaseBranchOf(Node(ExprForm)))
            elseBranch: maybe.T(Node(ExprForm))
        end
        exprInspect with
            target: Node(ExprForm)
            branches: vector.T(InspectBranchOf(Node(ExprForm)))
            elseBranch: maybe.T(Node(ExprForm))
        end
        exprException with name: String typeAnnot: maybe.T(TypeExpr) end
        exprRaise with exc: Node(ExprForm) payload: maybe.T(Node(ExprForm)) asType: maybe.T(TypeExpr) end
        exprTry with
            body: Node(ExprForm)
            branches: vector.T(TryBranchOf(Node(ExprForm)))
            elseBranch: maybe.T(Node(ExprForm))
        end

        (* Declarations / Bindings inside Blocks, Tuples, and Modules *)
        declLetVal with
            name: String
            value: Node(ExprForm)
            params: vector.T(FormalParam)
            typeAnnot: maybe.T(TypeExpr)
            isRec: Bool
            isVar: Bool
        end
        (* let [rec] x = ... and y = ...: declLetVal members *)
        declLetValGroup with bindings: vector.T(Node(ExprForm)) end
        (* Let [Rec] T = Type, or Def [Rec] T = Type (isDef) *)
        declTypeBinding with
            name: String
            typeVal: TypeExpr
            params: vector.T(TypeFormal)
            bound: maybe.T(KindExpr)
            isRec: Bool
            isDef: Bool
        end
        (* Let [Rec] A = ... and B = ...: declTypeBinding members *)
        declTypeBindingGroup with bindings: vector.T(Node(ExprForm)) end
        declDefKind with name: String kindVal: KindExpr end
        declExprStmt with expr: Node(ExprForm) end
    end;

    (* Expr and Decl share one representation. Body fields (thenBranch, elseBranch, loop and
     * branch bodies) hold an expression, never a declExprStmt; a body that is a lone
     * declaration is a one-phrase exprBlock. *)
    Let Expr = Node(ExprForm);
    Let Decl = Node(ExprForm);

    Let ElsifBranch = ElsifBranchOf(Expr);
    Let TupleFieldBinding = TupleFieldBindingOf(Expr);
    Let TupleField = TupleFieldOf(Expr);
    Let RecordBinding = RecordBindingOf(Expr);
    Let CaseBranch = CaseBranchOf(Expr);
    Let InspectBranch = InspectBranchOf(Expr);
    Let TryBranch = TryBranchOf(Expr);

    Let ImportItem = Tuple
        names: vector.T(String)
        interfaceName: String
        modulePaths: maybe.T(vector.T(String))
        interfacePath: maybe.T(String)
    end;

    Let ImportPhrase = Tuple
        items: vector.T(ImportItem)
    end;

    Let InterfaceDecl = Tuple
        name: String
        signatures: vector.T(Signature)
        imports: vector.T(ImportItem)
        isUnsound: Bool
    end;

    Let ModuleDecl = Tuple
        name: String
        interfaceName: String
        bindings: vector.T(Decl)
        imports: vector.T(ImportItem)
        isUnsound: Bool
    end;

    Let PhraseForm = Option
        phraseImport with phrase: ImportPhrase end
        phraseInterface with iface: InterfaceDecl end
        phraseModule with modDecl: ModuleDecl end
        phraseDecl with decl: Decl end
        phraseExpr with expr: Expr end
    end;

    Let Phrase = Node(PhraseForm);

    Let ProgramForm = Tuple
        phrases: vector.T(Phrase)
    end;

    Let Program = Node(ProgramForm);

    (* =========================================================================
     * Node Constructors
     * ========================================================================= *)

    let makeType(span: location.Span form: TypeForm): TypeExpr =
        tuple let span = span let form = form end;

    let makeKind(span: location.Span form: TypeForm): KindExpr =
        tuple let span = span let form = form end;

    let makeExpr(span: location.Span form: ExprForm): Expr =
        tuple let span = span let form = form end;

    let makeDecl(span: location.Span form: ExprForm): Decl =
        tuple let span = span let form = form end;

    let makePhrase(span: location.Span form: PhraseForm): Phrase =
        tuple let span = span let form = form end;

    let makeProgram(span: location.Span phrases: vector.T(Phrase)): Program =
        tuple
            let span = span
            let form = tuple let phrases = phrases end
        end;

    (* =========================================================================
     * Expression Helpers
     * ========================================================================= *)

    let exprInt(span: location.Span value: Int lexeme: String): Expr =
        makeExpr(span option exprInt of ExprForm with let value = value let lexeme = lexeme end);

    let exprReal(span: location.Span value: Real lexeme: String): Expr =
        makeExpr(span option exprReal of ExprForm with let value = value let lexeme = lexeme end);

    let exprChar(span: location.Span value: Char lexeme: String): Expr =
        makeExpr(span option exprChar of ExprForm with let value = value let lexeme = lexeme end);

    let exprString(span: location.Span value: String lexeme: String): Expr =
        makeExpr(span option exprString of ExprForm with let value = value let lexeme = lexeme end);

    let exprBool(span: location.Span value: Bool): Expr =
        makeExpr(span option exprBool of ExprForm with let value = value end);

    let exprOk(span: location.Span): Expr =
        makeExpr(span option exprOk of ExprForm end);

    let exprId(span: location.Span name: String): Expr =
        makeExpr(span option exprId of ExprForm with let name = name end);

    let exprInfix(span: location.Span left: Expr op: String right: Expr): Expr =
        makeExpr(span option exprInfix of ExprForm with let left = left let op = op let right = right end);

    let exprApp(span: location.Span func: Expr args: vector.T(Expr)): Expr =
        makeExpr(span option exprApp of ExprForm with let func = func let args = args end);

    let exprSelect(span: location.Span target: Expr field: String): Expr =
        makeExpr(span option exprSelect of ExprForm with let target = target let field = field end);

    (* =========================================================================
     * Type Helpers
     * ========================================================================= *)

    let typePath(span: location.Span path: vector.T(String)): TypeExpr =
        makeType(span option typePath of TypeForm with let path = path end);

    let typePathSimple(span: location.Span name: String): TypeExpr =
        begin
            let p = vector.new(:String);
            vector.append(:String p name);
            typePath(span p)
        end;

    let typeTuple(span: location.Span fields: vector.T(Signature)): TypeExpr =
        makeType(span option typeTuple of TypeForm with let fields = fields end);

    (* =========================================================================
     * Declaration Helpers
     * ========================================================================= *)

    let declLetVal(span: location.Span name: String value: Expr typeAnnot: maybe.T(TypeExpr)): Decl =
        makeDecl(span option declLetVal of ExprForm with
            let name = name
            let value = value
            let params = vector.new(:FormalParam)
            let typeAnnot = typeAnnot
            let isRec = false
            let isVar = false
        end);

    let declTypeBinding(span: location.Span name: String typeVal: TypeExpr isDef: Bool): Decl =
        makeDecl(span option declTypeBinding of ExprForm with
            let name = name
            let typeVal = typeVal
            let params = vector.new(:TypeFormal)
            let bound = maybe.none(:KindExpr)
            let isRec = false
            let isDef = isDef
        end);

    let declExprStmt(span: location.Span expr: Expr): Decl =
        makeDecl(span option declExprStmt of ExprForm with let expr = expr end);

    (* =========================================================================
     * Auxiliary Helpers
     * ========================================================================= *)

    let formalParam(name: String typeAnnot: maybe.T(TypeExpr) mode: ParamMode): FormalParam =
        tuple
            let name = name
            let typeAnnot = typeAnnot
            let mode = mode
        end;

    let fieldSig(name: maybe.T(String) typeSig: maybe.T(TypeExpr) mode: ParamMode): FieldSig =
        tuple
            let name = name
            let typeSig = typeSig
            let mode = mode
        end;

    let tupleBinding(
        name: maybe.T(String)
        value: Expr
        typeAnnot: maybe.T(TypeExpr)
        isVar: Bool
    ): TupleFieldBinding =
        tuple
            let name = name
            let value = value
            let typeAnnot = typeAnnot
            let isVar = isVar
        end;

    let importItem(
        names: vector.T(String)
        interfaceName: String
        modulePaths: maybe.T(vector.T(String))
        interfacePath: maybe.T(String)
    ): ImportItem =
        tuple
            let names = names
            let interfaceName = interfaceName
            let modulePaths = modulePaths
            let interfacePath = interfacePath
        end;
end;
