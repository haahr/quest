(* Quest Self-Hosted Compiler: Lexical Tokens Interface
 *
 * The tokens the tokenizer produces and the parser consumes. A token is its
 * kind, its lexeme (the exact source text: "a\n" with its quotes and
 * backslash, ~3 with its tilde), a literal's value (the two characters a and
 * newline; the Int -3), and its span in the file.
 * The kinds' names (tokenKindName) are those of the bootstrap's TokenKind,
 * bootstrap/python/quest/syntax/tokens.py, because the tokenize phase's golden
 * output and the parser's error messages print them, and both compilers must
 * print the same text. docs/syntax.md §2 gives the lexical rules *)

interface Tokens
import
    questlang/common/location : questlang/common/Location
    util/maybe : util/Maybe
export
    (* Exhaustive enumeration of all lexical token kinds in Quest *)
    Def TokenKind = Option
        (* End of Stream *)
        eof

        (* Literals *)
        intLit
        realLit
        charLit
        stringLit

        (* Identifiers & Symbolic Infix Operators *)
        ident
        symbolicInfix

        (* Delimiters *)
        lparen
        rparen
        lbracket
        rbracket
        lbrace
        rbrace
        comma
        semicolon

        (* Punctuation *)
        dot
        colon
        colonColon
        subtype
        assign
        equal
        question
        bang
        at
        underscore

        (* Kind-Level Keywords (ALL CAPS) *)
        kwType
        kwPower
        kwAllKind
        kwDefKind

        (* Type-Level Keywords (Initial Capital) *)
        kwAll
        kwArrayType
        kwAutoType
        kwDef
        kwExceptionType
        kwFunType
        kwLetType
        kwOptionType
        kwOutType
        kwRecType
        kwRecordType
        kwTupleType
        kwVarType
        kwVariantType

        (* Value-Level Keywords (Lowercase) *)
        kwAnd
        kwAndif
        kwArray
        kwAs
        kwAuto
        kwBegin
        kwCase
        kwDo
        kwDownto
        kwElse
        kwElsif
        kwEnd
        kwException
        kwExit
        kwExport
        kwExtent
        kwExternal
        kwFalse
        kwFor
        kwFun
        kwIf
        kwImport
        kwInspect
        kwInterface
        kwIs
        kwIsnot
        kwLet
        kwLoop
        kwModule
        kwNot
        kwOf
        kwOk
        kwOption
        kwOrdinal
        kwOrif
        kwOut
        kwRaise
        kwRec
        kwRecord
        kwThen
        kwTrue
        kwTry
        kwTuple
        kwUnsound
        kwUpto
        kwVar
        kwVariant
        kwWhen
        kwWhile
        kwWith
    end

    (* The value of a literal token, with its escapes decoded and its sign
     * applied; none for every other kind *)
    Def TokenValue = Option
        none
        intVal with val: Int end
        realVal with val: Real end
        charVal with val: Char end
        stringVal with val: String end
    end

    (* A token: lexeme is the source text the span covers *)
    Def Token = Tuple
        kind: TokenKind
        lexeme: String
        value: TokenValue
        span: location.Span
    end

    (* Construct a token *)
    make(kind: TokenKind lexeme: String value: TokenValue span: location.Span): Token

    (* TokenValue constructors *)
    valNone(): TokenValue
    valInt(n: Int): TokenValue
    valReal(r: Real): TokenValue
    valChar(c: Char): TokenValue
    valString(s: String): TokenValue

    (* The end-of-input token: an empty lexeme at offset in file *)
    eofToken(file: String offset: Int): Token

    (* The kind's name as the bootstrap's TokenKind spells it (KW_LET for
     * kwLet), for golden output and error messages *)
    tokenKindName(kind: TokenKind): String

    (* The groups of kinds the comments in TokenKind name. isDelimiter is the
     * brackets, comma, and semicolon; dot counts as punctuation, though the
     * tokenizer, like the delimiters, never lexes it as part of an operator *)
    isKeyword(kind: TokenKind): Bool
    isLiteral(kind: TokenKind): Bool
    isDelimiter(kind: TokenKind): Bool
    isPunctuation(kind: TokenKind): Bool
end
