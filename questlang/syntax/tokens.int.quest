(* Quest Self-Hosted Compiler: Lexical Tokens Interface
 *
 * This interface defines the tokens that the tokenizer produces and the parser
 * consumes. Each token holds its kind, its lexeme (the exact source text, such
 * as "a\n" with quotes and backslash or ~3 with its tilde), a decoded literal
 * value (the two characters a and newline; the Int -3), and its span in the
 * file. The kind names (tokenKindName) match the bootstrap's TokenKind in
 * bootstrap/python/quest/syntax/tokens.py, because the tokenize phase's golden
 * output and the parser's error messages print them, and both compilers must
 * produce identical text. docs/syntax.md §2 gives the lexical rules. *)

interface Tokens
import
    util/maybe : util/Maybe

    questlang/common/location : questlang/common/Location
export
    (* Exhaustive enumeration of all lexical token kinds in Quest *)
    Def TokenKind = Option
        (* End of Stream *)
        eof

        (* Literals *)
        intLit
        realLit
        charLit
        stringLit

        (* Identifiers & Symbolic Infix Operators *)
        ident
        symbolicInfix

        (* Delimiters *)
        lparen
        rparen
        lbracket
        rbracket
        lbrace
        rbrace
        comma
        semicolon

        (* Punctuation *)
        dot
        colon
        colonColon
        subtype
        assign
        equal
        question
        bang
        at
        underscore

        (* Kind-Level Keywords (ALL CAPS) *)
        kwType
        kwPower
        kwAllKind
        kwDefKind

        (* Type-Level Keywords (Initial Capital) *)
        kwAll
        kwArrayType
        kwAutoType
        kwDef
        kwExceptionType
        kwFunType
        kwLetType
        kwOptionType
        kwOutType
        kwRecType
        kwRecordType
        kwTupleType
        kwVarType
        kwVariantType

        (* Value-Level Keywords (Lowercase) *)
        kwAnd
        kwAndif
        kwArray
        kwAs
        kwAuto
        kwBegin
        kwCase
        kwDo
        kwDownto
        kwElse
        kwElsif
        kwEnd
        kwException
        kwExit
        kwExport
        kwExtent
        kwExternal
        kwFalse
        kwFor
        kwFun
        kwIf
        kwImport
        kwInspect
        kwInterface
        kwIs
        kwIsnot
        kwLet
        kwLoop
        kwModule
        kwNot
        kwOf
        kwOk
        kwOption
        kwOrdinal
        kwOrif
        kwOut
        kwRaise
        kwRec
        kwRecord
        kwThen
        kwTrue
        kwTry
        kwTuple
        kwUnsound
        kwUpto
        kwVar
        kwVariant
        kwWhen
        kwWhile
        kwWith
    end

    (* The value of a literal token, with its escapes decoded and its sign
     * applied; none for every other kind *)
    Def TokenValue = Option
        none
        intVal with val: Int end
        realVal with val: Real end
        charVal with val: Char end
        stringVal with val: String end
    end

    (* A token: lexeme is the source text the span covers *)
    Def Token = Tuple
        kind: TokenKind
        lexeme: String
        value: TokenValue
        span: location.Span
    end

    (* Construct a token *)
    make(kind: TokenKind lexeme: String value: TokenValue span: location.Span): Token

    (* TokenValue constructors *)
    valNone(): TokenValue
    valInt(n: Int): TokenValue
    valReal(r: Real): TokenValue
    valChar(c: Char): TokenValue
    valString(s: String): TokenValue

    (* The end-of-input token: an empty lexeme at offset in file *)
    eofToken(file: String offset: Int): Token

    (* ======================================================================
     * What each kind is
     *
     * One table, kindTable, says of every kind its name, its spelling, its
     * class, a bracket's partner, and whether a keyword opens a construct that
     * end closes or starts a declaration. The functions below read it, and so
     * do the tokenizer's tables of keywords and punctuation, a syntax error's
     * account of what was expected and of what was left open
     * (questlang/syntax/parser/expected and unclosed), and the formatter, so
     * that each kind is spelled and classified in one place. Code that asks
     * about a particular kind tests its tag (kind?kwEnd), not its name.
     * ====================================================================== *)

    (* The groups named in TokenKind. A delimiter is a bracket, comma, or
     * semicolon; dot is punctuation, though like the delimiters the tokenizer
     * never lexes it as part of an operator. A word is a name or a symbolic
     * operator, whose text is its own. *)
    Def TokenClass = Option
        endOfInput
        literal
        word
        delimiter
        punctuation
        keyword
    end

    (* Whether a kind is a bracket, which side, and the kind of the other *)
    Def Bracket = Option
        notBracket
        opening with partner: TokenKind end
        closing with partner: TokenKind end
    end

    Def KindInfo = Tuple
        kind: TokenKind
        (* As the bootstrap's TokenKind spells it (KW_LET for kwLet) *)
        name: String
        (* How a token of the kind is written, for the kinds with one way:
         * the keywords, the delimiters, and the punctuation *)
        spelling: maybe.T(String)
        class: TokenClass
        bracket: Bracket
        (* A keyword whose construct end closes (if, begin, Tuple, ...). Of
         * and with, which open such a construct only in context, are not. *)
        closedByEnd: Bool
        (* A keyword that starts a declaration (let, Let, Def, DEF, unsound,
         * interface, module) *)
        startsDeclaration: Bool
    end

    (* Every kind's row, at the kind's ordinal *)
    kindTable: Array(KindInfo)
    info(kind: TokenKind): KindInfo

    (* The kind's name (info(kind).name), for golden output and the parser's
     * record of what it expected *)
    tokenKindName(kind: TokenKind): String
    (* The kind with this name, if any *)
    kindNamed(name: String): maybe.T(TokenKind)
    spelling(kind: TokenKind): maybe.T(String)
    sameKind(a: TokenKind b: TokenKind): Bool

    (* The kind's class and bracket, and its flags *)
    isKeyword(kind: TokenKind): Bool
    isLiteral(kind: TokenKind): Bool
    isDelimiter(kind: TokenKind): Bool
    isPunctuation(kind: TokenKind): Bool
    isOpening(kind: TokenKind): Bool
    isClosing(kind: TokenKind): Bool
    (* A bracket's partner; none for other kinds *)
    partner(kind: TokenKind): maybe.T(TokenKind)
    closedByEnd(kind: TokenKind): Bool
    startsDeclaration(kind: TokenKind): Bool
end
