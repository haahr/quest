(* Quest Self-Hosted Compiler: Abstract Syntax Tree Interface
 *
 * The syntax tree the parser builds. The same types serve every phase that
 * works on source syntax: desugar rewrites a tree into one of the same types
 * without the syntactic sugar, and the type checker and the module loader
 * read it; there is no separate tree per phase.
 *
 * Every node is a Node(Form): the span of source it covers, for error
 * messages, and a form, an option whose tag says what construct it is
 * (exprIf, typeTuple, ...). The forms follow Quest's levels, the paper's term
 * for values, the types that classify values, and the kinds that classify
 * types:
 *
 *   Level 0  ExprForm   expressions, and declarations (Expr = Decl)
 *   Level 1  TypeForm   types
 *   Level 2  TypeForm   kinds, in the same form (TypeExpr = KindExpr)
 *
 * with PhraseForm and Program for the top level of a file. Parts of a node
 * that are not themselves nodes (a formal parameter, a field of a signature)
 * carry only the start offset the bootstrap gives them, not a span.
 *
 * The tree mirrors bootstrap/python/quest/syntax/ast.py node for node, so
 * that astprint prints it in the bootstrap's form and the two parsers can be
 * compared on every Quest file (docs/testing.md §2.3).
 * docs/compiler-organization.md §3 explains the design, and docs/syntax.md §4
 * lists the bootstrap's nodes *)

interface Ast
import
    questlang/common/location : questlang/common/Location
    collections/vector : collections/Vector
    util/maybe : util/Maybe
export
    (* ======================================================================
     * 1. Parameter Modes
     * ====================================================================== *)

    Def ParamMode = Option
        modeValue
        modeVar
        modeOut
    end

    (* ======================================================================
     * 2. Parameterized Node Wrapper
     * ====================================================================== *)

    Def Node(Form::TYPE) = Tuple
        span: location.Span
        form: Form
    end

    (* =========================================================================
     * 3. Level 1 & 2: Types and Kinds (TypeForm)
     *
     * The components of type and kind forms are written once, as operators over
     * the type of the subterms (T, a Node(TypeForm)), so that TypeForm can use
     * them before it is defined; the named types below apply them to TypeExpr.
     * ====================================================================== *)

    (* Components have the offset the bootstrap gives the corresponding node *)

    (* A type parameter, X::K or X <: B; bound is always a kind, so X <: B is
     * stored as X::POWER(B). An anonymous one (::K) is named _ *)
    Def TypeFormalOf(T::TYPE) = Tuple offset: Int name: String bound: T end
    (* One parameter of All(...): a type parameter (isType) bounded as in
     * TypeFormalOf, or a value parameter [var | out] x: T, bounded by POWER(T)
     * and named _ if anonymous. So All(A::TYPE x: A) A has two quantifiers *)
    Def QuantifierOf(T::TYPE) = Tuple offset: Int name: String bound: T mode: ParamMode isType: Bool end
    (* A value field of a tuple type, an interface, or an Auto type's
     * signature: [var | out] x: T, or the anonymous :T (name none). The
     * parser always gives typeSig; it is a maybe as in the bootstrap *)
    Def FieldSigOf(T::TYPE) = Tuple offset: Int name: maybe.T(String) typeSig: maybe.T(T) mode: ParamMode end
    Def RecordFieldSigOf(T::TYPE) = Tuple offset: Int name: String typeSig: T isVar: Bool end
    Def VariantFieldSigOf(T::TYPE) = Tuple offset: Int tag: String typeSig: T isVar: Bool end
    Def TypeBindingOf(T::TYPE) = Tuple
        offset: Int
        name: String
        typeVal: T
        params: vector.T(TypeFormalOf(T))
        bound: maybe.T(T)
        isRec: Bool
        isDef: Bool
    end
    (* A component of a signature, which a tuple type or an interface is: a
     * value's signature, an abstract type, a type binding (Let [Rec] or Def
     * [Rec]), a group of type bindings joined by and, or a kind binding
     * (DEF) *)
    Def SignatureOf(T::TYPE) = Option
        sigValue with val: FieldSigOf(T) end
        sigType with val: TypeFormalOf(T) end
        sigTypeBinding with val: TypeBindingOf(T) end
        sigTypeBindingGroup with offset: Int val: vector.T(TypeBindingOf(T)) end
        sigKindBinding with val: Tuple offset: Int name: String kindVal: T end end
    end
    (* An option's case: its tag and its payload's signature, which is a tuple
     * type's *)
    Def OptionFieldSigOf(T::TYPE) = Tuple offset: Int tag: String payloadSig: vector.T(SignatureOf(T)) end

    Def Rec TypeForm = Option
        (* Level 2: Kinds *)
        (* TYPE, the kind of every type *)
        kindType
        (* POWER(B), the kind of the subtypes of B *)
        kindPower with bound: Node(TypeForm) end
        (* ALL(X::K) K', the kind of a type operator; the parser curries
         * ALL(X::K Y::K) into one parameter per kindAll *)
        kindAll with paramName: String paramKind: Node(TypeForm) bodyKind: Node(TypeForm) end
        (* A kind named by a DEF *)
        kindId with name: String end
        (* I_K: the kind K of the interface imported as I *)
        kindManifest with interfaceName: String kindName: String end

        (* Level 1: Types *)
        (* A named type, possibly qualified: Int is [Int], m.T is [m, T] *)
        typePath with path: vector.T(String) end
        (* All(quantifiers) resultType: a function type, or a polymorphic one
         * if a quantifier is a type. f(x: Int)(y: Int): Int has the type
         * All(x: Int) All(y: Int) Int, one typeAll per parameter group *)
        typeAll with quantifiers: vector.T(QuantifierOf(Node(TypeForm))) resultType: Node(TypeForm) end
        typeTuple with fields: vector.T(SignatureOf(Node(TypeForm))) end
        typeRecord with fields: vector.T(RecordFieldSigOf(Node(TypeForm))) end
        typeOption with variants: vector.T(OptionFieldSigOf(Node(TypeForm))) end
        typeVariant with fields: vector.T(VariantFieldSigOf(Node(TypeForm))) end
        (* Auto [A] HasKind with signature end, the type of an auto value (an
         * existential: a hidden type component and values that use it,
         * docs/syntax.md §3.9); typeParam is A, none if unnamed *)
        typeAuto with
            typeParam: maybe.T(String)
            kindBound: Node(TypeForm)
            signature: vector.T(FieldSigOf(Node(TypeForm)))
        end
        (* Fun(X::K ...) [::K'] body, a type operator *)
        typeFun with
            params: vector.T(TypeFormalOf(Node(TypeForm)))
            resultKind: maybe.T(Node(TypeForm))
            body: Node(TypeForm)
        end
        (* Rec(X HasKind) body, the recursive type body in which X stands for
         * the whole *)
        typeRec with varName: String bound: Node(TypeForm) body: Node(TypeForm) end
        (* T(A B), a type operator applied to arguments *)
        typeApp with constructor: Node(TypeForm) arguments: vector.T(Node(TypeForm)) end
        (* left op right; the type checker accepts only -> (a one-parameter
         * function type) and rejects any other operator *)
        typeInfix with left: Node(TypeForm) op: String right: Node(TypeForm) end
        typeArray with elementType: Node(TypeForm) end
        (* Var(T), a mutable cell of T, and Out(T), a cell that may only be
         * written (docs/type-system.md §6.5) *)
        typeVar with elementType: Node(TypeForm) end
        typeOut with elementType: Node(TypeForm) end
        (* M_T: the type T of the interface or module imported as M (Counter_T
         * after import counter : Counter) *)
        typeManifest with moduleName: String typeName: String end
        (* external "C type", an opaque C type, allowed only in an unsound
         * module (docs/syntax.md §3.8) *)
        typeExternal with cType: String end
    end

    Def TypeExpr = Node(TypeForm)
    Def KindExpr = Node(TypeForm)

    Def TypeFormal = TypeFormalOf(KindExpr)
    Def Quantifier = QuantifierOf(KindExpr)
    Def FieldSig = FieldSigOf(TypeExpr)
    Def RecordFieldSig = RecordFieldSigOf(TypeExpr)
    Def OptionFieldSig = OptionFieldSigOf(TypeExpr)
    Def VariantFieldSig = VariantFieldSigOf(TypeExpr)
    Def TypeBinding = TypeBindingOf(TypeExpr)
    Def Signature = SignatureOf(TypeExpr)

    (* A function's value parameter, [var | out] x: T; the parser always gives
     * typeAnnot *)
    Def FormalParam = Tuple
        offset: Int
        name: String
        typeAnnot: maybe.T(TypeExpr)
        mode: ParamMode
    end

    (* A name an inspect branch binds to a component of the auto value, with
     * the supertype given for it, if any *)
    Def InspectBinder = Tuple
        name: String
        typeAnnot: maybe.T(TypeExpr)
    end

    (* An import, which a program holds at its top level, and which the
     * bootstrap's parser also accepts as a declaration anywhere else (a block,
     * a tuple, an argument, a module body), for its type checker to reject.
     *
     * names are the local names of the modules imported (empty for an
     * interface alone) and interfaceName the local name of the interface.
     * modulePaths and interfacePath are the files' paths, or none, meaning
     * the path is the local name itself (as for ascii : Ascii). For example
     *
     *     cnt : Cnt = util/counter : util/Counter
     *
     * has names [cnt], interfaceName Cnt, modulePaths [util/counter], and
     * interfacePath util/Counter; docs/modules.md §4.3 lists the forms *)
    Def ImportItem = Tuple
        offset: Int
        names: vector.T(String)
        interfaceName: String
        modulePaths: maybe.T(vector.T(String))
        interfacePath: maybe.T(String)
    end

    Def ImportPhrase = Tuple
        items: vector.T(ImportItem)
    end

    (* =========================================================================
     * 4. Level 0: Expressions and Declarations (ExprForm)
     *
     * As for types, the components of expression forms are operators over the
     * type of the subterms (E, a Node(ExprForm)), applied to Expr by the named
     * types below.
     * ====================================================================== *)

    Def ElsifBranchOf(E::TYPE) = Tuple cond: E thenBranch: E end
    Def TupleFieldBindingOf(E::TYPE) = Tuple
        offset: Int
        name: maybe.T(String)
        value: E
        typeAnnot: maybe.T(TypeExpr)
        isVar: Bool
    end
    (* A component of a tuple: a value, values joined by and (without rec), or a
     * declaration (a type, a kind, or recursive values) *)
    Def TupleFieldOf(E::TYPE) = Option
        fieldVal with val: TupleFieldBindingOf(E) end
        fieldGroup with offset: Int val: vector.T(TupleFieldBindingOf(E)) end
        fieldDecl with val: E end
    end
    Def RecordBindingOf(E::TYPE) = Tuple offset: Int name: String value: E isVar: Bool end
    (* when tags [with binder [: T]] then body, a branch for one or more
     * tags; binder names the payload *)
    Def CaseBranchOf(E::TYPE) = Tuple
        offset: Int
        tags: vector.T(String)
        binder: maybe.T(String)
        binderType: maybe.T(TypeExpr)
        body: E
    end
    Def InspectBranchOf(E::TYPE) = Tuple offset: Int matchType: TypeExpr binders: vector.T(InspectBinder) body: E end
    (* when exc [with binder [: T]] then body: excPattern is an expression
     * for the exception caught, binder names its payload *)
    Def TryBranchOf(E::TYPE) = Tuple
        offset: Int
        excPattern: E
        binder: maybe.T(String)
        binderType: maybe.T(TypeExpr)
        body: E
    end

    Def Rec ExprForm = Option
        (* Literals, each with its value and its source text (~3 for -3) *)
        exprInt with value: Int lexeme: String end
        exprReal with value: Real lexeme: String end
        exprChar with value: Char lexeme: String end
        exprString with value: String lexeme: String end
        exprBool with value: Bool end
        exprOk

        (* Identifiers & Arguments *)
        exprId with name: String end
        (* external "symbol", a C symbol's value, in an unsound module
         * (docs/syntax.md §3.8) *)
        exprExternal with symbol: String end
        (* :T and ::K, a type or kind argument among a call's arguments (as in
         * f(:Int x)) or a tuple's components *)
        typeArg with typeVal: TypeExpr end
        kindArg with kindVal: KindExpr end

        (* Control Flow & Blocks *)
        (* begin ... end: declarations and statements (declExprStmt) in order.
         * Its value is the last phrase's if that is a statement, else ok *)
        exprBlock with bindings: vector.T(Node(ExprForm)) end
        exprIf with
            cond: Node(ExprForm)
            thenBranch: Node(ExprForm)
            elsifs: vector.T(ElsifBranchOf(Node(ExprForm)))
            elseBranch: maybe.T(Node(ExprForm))
            (* A conditional desugared from andif or orif (syntax/desugar),
             * whose operands are checked against Bool *)
            shortCircuit: Bool
        end
        exprWhile with cond: Node(ExprForm) body: Node(ExprForm) end
        exprLoop with body: Node(ExprForm) end
        exprExit
        exprFor with
            varName: String
            start: Node(ExprForm)
            isDownto: Bool
            stop: Node(ExprForm)
            body: Node(ExprForm)
        end

        (* Functions & Calls *)
        (* fun(...) [: T] body, for one parenthesized parameter group, which
         * may hold type parameters (typeParams) as well as value parameters; a
         * curried fun(x: Int)(y: Int) is nested exprFuns, the return type on
         * the innermost *)
        exprFun with
            params: vector.T(FormalParam)
            returnType: maybe.T(TypeExpr)
            body: Node(ExprForm)
            typeParams: vector.T(TypeFormal)
        end
        exprApp with func: Node(ExprForm) args: vector.T(Node(ExprForm)) end
        (* left op right, for any infix operator (+, :=, andif, or one a
         * program defines); desugar turns andif and orif into exprIf,
         * a[i] := v into exprIndexAssign, and an operator that is not built in
         * into a call of the function the operator names *)
        exprInfix with left: Node(ExprForm) op: String right: Node(ExprForm) end

        (* Aggregates *)
        exprTuple with fields: vector.T(TupleFieldOf(Node(ExprForm))) end
        exprRecord with fields: vector.T(RecordBindingOf(Node(ExprForm))) end
        exprArray with elements: vector.T(Node(ExprForm)) elementType: maybe.T(TypeExpr) end
        (* array of(count initVal), count copies of initVal *)
        exprArrayRep with count: Node(ExprForm) initVal: Node(ExprForm) end
        (* option tag of T [with payload] end, or with ordinal(e) in place of
         * the tag: exactly one of tag and ordinalExpr is given *)
        exprOption with
            tag: maybe.T(String)
            optionType: TypeExpr
            payload: maybe.T(Node(ExprForm))
            ordinalExpr: maybe.T(Node(ExprForm))
        end
        exprVariant with tag: String variantType: TypeExpr isVar: Bool payload: maybe.T(Node(ExprForm)) end
        (* auto [let witnessName [witnessBound] =] :witnessType with payload
         * end *)
        exprAuto with
            witnessType: TypeExpr
            payload: Node(ExprForm)
            witnessName: maybe.T(String)
            witnessBound: maybe.T(KindExpr)
        end

        (* Selection, Indexing, and References *)
        exprSelect with target: Node(ExprForm) field: String end
        exprIndex with target: Node(ExprForm) index: Node(ExprForm) end
        (* target[index] := value; only desugar builds it *)
        exprIndexAssign with target: Node(ExprForm) index: Node(ExprForm) value: Node(ExprForm) end
        (* The two arguments a var or out parameter accepts
         * (docs/type-system.md §6.5): var(value), a new cell holding value,
         * and @target, the mutable location target names (@x, @r.field).
         * exprDerefCell takes the location, it does not read the cell *)
        exprVarCell with value: Node(ExprForm) end
        exprDerefCell with target: Node(ExprForm) end
        (* target?tag, whether target has the tag, and target!tag, its payload
         * (docs/syntax.md §3.7) *)
        exprVariantCheck with target: Node(ExprForm) tag: String end
        exprVariantAssert with target: Node(ExprForm) tag: String end

        (* Pattern Matching & Exceptions *)
        exprCase with
            target: Node(ExprForm)
            branches: vector.T(CaseBranchOf(Node(ExprForm)))
            elseBranch: maybe.T(Node(ExprForm))
        end
        exprInspect with
            target: Node(ExprForm)
            branches: vector.T(InspectBranchOf(Node(ExprForm)))
            elseBranch: maybe.T(Node(ExprForm))
        end
        (* exception name [: T] end, a new exception whose payload is a T (Ok
         * without one) *)
        exprException with name: String typeAnnot: maybe.T(TypeExpr) end
        (* raise exc [with payload] [as T] end; raise does not return, so as T
         * gives it a type where no expected type does (Ok otherwise) *)
        exprRaise with exc: Node(ExprForm) payload: maybe.T(Node(ExprForm)) asType: maybe.T(TypeExpr) end
        exprTry with
            body: Node(ExprForm)
            branches: vector.T(TryBranchOf(Node(ExprForm)))
            elseBranch: maybe.T(Node(ExprForm))
            (* The else branch's name for the exception it caught (else with e
             * then), and its annotation (docs/raised.md) *)
            elseBinder: maybe.T(String)
            elseBinderType: maybe.T(TypeExpr)
        end

        (* Declarations / Bindings inside Blocks, Tuples, and Modules *)
        declLetVal with
            name: String
            value: Node(ExprForm)
            params: vector.T(FormalParam)
            typeAnnot: maybe.T(TypeExpr)
            isRec: Bool
            isVar: Bool
        end
        (* let [rec] x = ... and y = ...: declLetVal members *)
        declLetValGroup with bindings: vector.T(Node(ExprForm)) end
        (* Let [Rec] T = Type, or Def [Rec] T = Type (isDef) *)
        declTypeBinding with
            name: String
            typeVal: TypeExpr
            params: vector.T(TypeFormal)
            bound: maybe.T(KindExpr)
            isRec: Bool
            isDef: Bool
        end
        (* Let [Rec] A = ... and B = ...: declTypeBinding members *)
        declTypeBindingGroup with bindings: vector.T(Node(ExprForm)) end
        declDefKind with name: String kindVal: KindExpr end
        declExprStmt with expr: Node(ExprForm) end
        (* An import other than at the top level *)
        declImport with phrase: ImportPhrase end
    end

    (* Expr and Decl share one representation. Body fields (thenBranch,
     * elseBranch, loop and branch bodies) hold an expression, never a
     * declExprStmt; a body that is a lone declaration is a one-phrase
     * exprBlock. *)
    Def Expr = Node(ExprForm)
    Def Decl = Node(ExprForm)

    Def ElsifBranch = ElsifBranchOf(Expr)
    Def TupleFieldBinding = TupleFieldBindingOf(Expr)
    Def TupleField = TupleFieldOf(Expr)
    Def RecordBinding = RecordBindingOf(Expr)
    Def CaseBranch = CaseBranchOf(Expr)
    Def InspectBranch = InspectBranchOf(Expr)
    Def TryBranch = TryBranchOf(Expr)

    (* ======================================================================
     * 5. Module & Interface Declarations
     * ====================================================================== *)

    Def InterfaceDecl = Tuple
        name: String
        signatures: vector.T(Signature)
        imports: vector.T(ImportItem)
        isUnsound: Bool
    end

    Def ModuleDecl = Tuple
        name: String
        interfaceName: String
        bindings: vector.T(Decl)
        imports: vector.T(ImportItem)
        isUnsound: Bool
    end

    (* ======================================================================
     * 6. Top-Level Phrases & Program
     * ====================================================================== *)

    Def PhraseForm = Option
        phraseImport with phrase: ImportPhrase end
        phraseInterface with iface: InterfaceDecl end
        phraseModule with modDecl: ModuleDecl end
        phraseDecl with decl: Decl end
        phraseExpr with expr: Expr end
    end

    Def Phrase = Node(PhraseForm)

    Def ProgramForm = Tuple
        phrases: vector.T(Phrase)
    end

    Def Program = Node(ProgramForm)

    (* ======================================================================
     * 7. Constructors and Helper Functions
     * ====================================================================== *)

    makeType(span: location.Span form: TypeForm): TypeExpr
    makeKind(span: location.Span form: TypeForm): KindExpr
    makeExpr(span: location.Span form: ExprForm): Expr
    makeDecl(span: location.Span form: ExprForm): Decl
    makePhrase(span: location.Span form: PhraseForm): Phrase
    makeProgram(span: location.Span phrases: vector.T(Phrase)): Program

    (* Helper constructors for common expressions *)
    exprInt(span: location.Span value: Int lexeme: String): Expr
    exprReal(span: location.Span value: Real lexeme: String): Expr
    exprChar(span: location.Span value: Char lexeme: String): Expr
    exprString(span: location.Span value: String lexeme: String): Expr
    exprBool(span: location.Span value: Bool): Expr
    exprOk(span: location.Span): Expr
    exprId(span: location.Span name: String): Expr
    exprInfix(span: location.Span left: Expr op: String right: Expr): Expr
    exprApp(span: location.Span func: Expr args: vector.T(Expr)): Expr
    exprSelect(span: location.Span target: Expr field: String): Expr

    (* Helper constructors for common types *)
    typePath(span: location.Span path: vector.T(String)): TypeExpr
    typePathSimple(span: location.Span name: String): TypeExpr
    typeTuple(span: location.Span fields: vector.T(Signature)): TypeExpr

    (* Helper constructors for declarations *)
    declLetVal(span: location.Span name: String value: Expr typeAnnot: maybe.T(TypeExpr)): Decl
    declTypeBinding(span: location.Span name: String typeVal: TypeExpr isDef: Bool): Decl
    declExprStmt(span: location.Span expr: Expr): Decl

    (* Auxiliary constructors *)
    formalParam(offset: Int name: String typeAnnot: maybe.T(TypeExpr) mode: ParamMode): FormalParam
    fieldSig(offset: Int name: maybe.T(String) typeSig: maybe.T(TypeExpr) mode: ParamMode): FieldSig
    tupleBinding(offset: Int name: maybe.T(String) value: Expr typeAnnot: maybe.T(TypeExpr) isVar: Bool): TupleFieldBinding
    importItem(
        offset: Int
        names: vector.T(String)
        interfaceName: String
        modulePaths: maybe.T(vector.T(String))
        interfacePath: maybe.T(String)
    ): ImportItem

    (* The paths of an import's modules and interface: modulePaths and
     * interfacePath where the import writes them, else the local names
     * (names, interfaceName) *)
    effectiveModulePaths(item: ImportItem): vector.T(String)
    effectiveInterfacePath(item: ImportItem): String
end
