                            b.str(dumpExpr(f.start {indent + 1} showOffsets));
                            b.str("
");
                            if f.isDownto then
                                b.str(cpad);
                                b.str(":is_downto True
");
                            end;
                            b.str(cpad);
                            b.str(":stop ");
                            b.str(dumpExpr(f.stop {indent + 1} showOffsets));
                            b.str("
");
