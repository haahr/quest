                        begin
                            let b = stringBuilder.new();
                            b.str("(ExprInspect
");
                            b.str(cpad);
                            b.str(":target ");
                            b.str(dumpExpr(i.target {indent + 1} showOffsets));
                            b.str("
");
                            b.str(cpad);
                            b.str(":branches (
");
                            let nBr = vector.length(:ast.InspectBranch i.branches);
                            for k = 0 upto {nBr - 1} do
                                b.str(makePadding({indent + 2}));
                                b.str(dumpInspectBranch(vector.get(:ast.InspectBranch i.branches k)
                                    {indent + 2} showOffsets));
                                b.str("
");
                            end;
                            b.str(cpad);
                            b.str(")
");
                            if maybe.isSome(:ast.Expr i.elseBranch) then
                                b.str(cpad);
                                b.str(":else_branch ");
                                b.str(dumpExpr(maybe.unwrap(:ast.Expr i.elseBranch)
                                    {indent + 1} showOffsets));
                                b.str("
");
                            end;
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when exprException with e then
                        begin
                            let b = stringBuilder.new();
                            b.str("(ExprException
");
                            b.str(cpad);
                            b.str(":name ");
                            b.str(pyRepr(e.name));
                            b.str("
");
                            if maybe.isSome(:ast.TypeExpr e.typeAnnot) then
                                b.str(cpad);
                                b.str(":type_annot ");
                                b.str(dumpTypeExpr(maybe.unwrap(:ast.TypeExpr e.typeAnnot)
                                    {indent + 1} showOffsets));
                                b.str("
");
                            end;
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when exprRaise with r then
                        begin
                            let b = stringBuilder.new();
                            b.str("(ExprRaise
");
                            b.str(cpad);
                            b.str(":exc ");
                            b.str(dumpExpr(r.exc {indent + 1} showOffsets));
                            b.str("
");
                            if maybe.isSome(:ast.Expr r.payload) then
                                b.str(cpad);
                                b.str(":payload ");
                                b.str(dumpExpr(maybe.unwrap(:ast.Expr r.payload)
                                    {indent + 1} showOffsets));
                                b.str("
");
                            end;
                            if maybe.isSome(:ast.TypeExpr r.asType) then
                                b.str(cpad);
                                b.str(":as_type ");
                                b.str(dumpTypeExpr(maybe.unwrap(:ast.TypeExpr r.asType)
                                    {indent + 1} showOffsets));
                                b.str("
");
                            end;
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when exprTry with t then
                        begin
                            let b = stringBuilder.new();
                            b.str("(ExprTry
");
                            b.str(cpad);
                            b.str(":body ");
                            b.str(dumpExpr(t.body {indent + 1} showOffsets));
                            b.str("
");
                            b.str(cpad);
                            b.str(":branches (
");
                            let nBr = vector.length(:ast.TryBranch t.branches);
                            for i = 0 upto {nBr - 1} do
                                b.str(makePadding({indent + 2}));
                                b.str(dumpTryBranch(vector.get(:ast.TryBranch t.branches i)
                                    {indent + 2} showOffsets));
                                b.str("
");
                            end;
                            b.str(cpad);
                            b.str(")
");
                            if maybe.isSome(:ast.Expr t.elseBranch) then
                                b.str(cpad);
                                b.str(":else_branch ");
                                b.str(dumpExpr(maybe.unwrap(:ast.Expr t.elseBranch)
                                    {indent + 1} showOffsets));
                                b.str("
");
                            end;
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when declLetVal with v then
                        begin
                            let b = stringBuilder.new();
                            b.str("(LetValueBinding
");
                            b.str(cpad);
                            b.str(":name ");
                            b.str(pyRepr(v.name));
                            b.str("
");
                            b.str(cpad);
                            b.str(":value ");
                            b.str(dumpExpr(v.value {indent + 1} showOffsets));
                            b.str("
");
                            let nP = vector.length(:ast.FormalParam v.params);
                            if nP > 0 then
                                b.str(cpad);
                                b.str(":params (
");
                                for i = 0 upto {nP - 1} do
                                    b.str(makePadding({indent + 2}));
                                    b.str(dumpFormalParam(vector.get(:ast.FormalParam v.params i)
                                        {indent + 2} showOffsets));
                                    b.str("
");
                                end;
                                b.str(cpad);
                                b.str(")
");
                            end;
                            if maybe.isSome(:ast.TypeExpr v.typeAnnot) then
                                b.str(cpad);
                                b.str(":type_annot ");
                                b.str(dumpTypeExpr(maybe.unwrap(:ast.TypeExpr v.typeAnnot)
                                    {indent + 1} showOffsets));
                                b.str("
");
                            end;
                            if v.isRec then
                                b.str(cpad);
                                b.str(":is_rec True
");
                            end;
                            if v.isVar then
                                b.str(cpad);
                                b.str(":is_var True
");
                            end;
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when declTypeBinding with t then
                        begin
                            let b = stringBuilder.new();
                            b.str("(TypeBinding
");
                            b.str(cpad);
                            b.str(":name ");
                            b.str(pyRepr(t.name));
                            b.str("
");
                            b.str(cpad);
                            b.str(":type_val ");
                            b.str(dumpTypeExpr(t.typeVal {indent + 1} showOffsets));
                            b.str("
");
                            let nP = vector.length(:ast.TypeFormal t.params);
                            if nP > 0 then
                                b.str(cpad);
                                b.str(":params (
");
                                for i = 0 upto {nP - 1} do
                                    b.str(makePadding({indent + 2}));
                                    b.str(dumpTypeFormal(vector.get(:ast.TypeFormal t.params i)
                                        {indent + 2} showOffsets));
                                    b.str("
");
                                end;
                                b.str(cpad);
                                b.str(")
");
                            end;
                            if maybe.isSome(:ast.KindExpr t.bound) then
                                b.str(cpad);
                                b.str(":bound ");
                                b.str(dumpTypeExpr(maybe.unwrap(:ast.KindExpr t.bound)
                                    {indent + 1} showOffsets));
                                b.str("
");
                            end;
                            if t.isRec then
                                b.str(cpad);
                                b.str(":is_rec True
");
                            end;
                            if t.isDef then
                                b.str(cpad);
                                b.str(":is_def True
");
                            end;
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when declDefKind with k then
                        begin
                            let b = stringBuilder.new();
                            b.str("(DefKindBinding
");
                            b.str(cpad);
                            b.str(":name ");
                            b.str(pyRepr(k.name));
                            b.str("
");
                            b.str(cpad);
                            b.str(":kind_val ");
                            b.str(dumpTypeExpr(k.kindVal {indent + 1} showOffsets));
                            b.str("
");
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when declExprStmt with e then
                        begin
                            let b = stringBuilder.new();
                            b.str("(ExprStmt
");
                            b.str(cpad);
                            b.str(":expr ");
                            b.str(dumpExpr(e.expr {indent + 1} showOffsets));
                            b.str("
");
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                end
            end;
        dumpExprForm(node.span node.form indent showOffsets)
    end;
    let dumpDecl(node: ast.Decl indent: Int showOffsets: Bool): String =
        dumpExpr(node indent showOffsets);
    let dumpImportItem(item: ast.ImportItem indent: Int showOffsets: Bool): String =
        begin
            let b = stringBuilder.new();
            b.str("(ImportItem ");
            b.str(dumpStringTuple(item.names));
            b.str(" ");
            b.str(pyRepr(item.interfaceName));
            if maybe.isSome(:vector.T(String) item.modulePaths) then
                b.str(" ");
                b.str(dumpStringTuple(maybe.unwrap(:vector.T(String) item.modulePaths)));
            end;
            if maybe.isSome(:String item.interfacePath) then
                b.str(" ");
                b.str(pyRepr(maybe.unwrap(:String item.interfacePath)));
            end;
            b.str(")");
            b.toString()
        end;

    let dumpImportPhrase(phrase: ast.ImportPhrase indent: Int showOffsets: Bool): String =
        begin
            let nI = vector.length(:ast.ImportItem phrase.items);
            if nI is 0 then
                "(ImportPhrase ())"
            else
                let pad = makePadding(indent);
                let cpad = makePadding({indent + 1});
                let b = stringBuilder.new();
                b.str("(ImportPhrase
");
                b.str(cpad);
                b.str(":items (
");
                for i = 0 upto {nI - 1} do
                    b.str(makePadding({indent + 2}));
                    b.str(dumpImportItem(vector.get(:ast.ImportItem phrase.items i)
                        {indent + 2} showOffsets));
                    b.str("
");
                end;
                b.str(cpad);
                b.str(")
");
                b.str(pad);
                b.str(")");
                b.toString()
            end
        end;

    let dumpInterfaceDecl(iface: ast.InterfaceDecl indent: Int showOffsets: Bool): String =
        begin
            let pad = makePadding(indent);
            let cpad = makePadding({indent + 1});
            let b = stringBuilder.new();
            b.str("(InterfaceDecl
");
            b.str(cpad);
            b.str(":name ");
            b.str(pyRepr(iface.name));
            b.str("
");
            b.str(cpad);
            b.str(":signatures (
");
            let nS = vector.length(:ast.Decl iface.signatures);
            for i = 0 upto {nS - 1} do
                b.str(makePadding({indent + 2}));
                b.str(dumpDecl(vector.get(:ast.Decl iface.signatures i)
                    {indent + 2} showOffsets));
                b.str("
");
            end;
            b.str(cpad);
            b.str(")
");
            let nImp = vector.length(:ast.ImportItem iface.imports);
            if nImp > 0 then
                b.str(cpad);
                b.str(":imports (
");
                for i = 0 upto {nImp - 1} do
                    b.str(makePadding({indent + 2}));
                    b.str(dumpImportItem(vector.get(:ast.ImportItem iface.imports i)
                        {indent + 2} showOffsets));
                    b.str("
");
                end;
                b.str(cpad);
                b.str(")
");
            end;
            if iface.isUnsound then
                b.str(cpad);
                b.str(":is_unsound True
");
            end;
            b.str(pad);
            b.str(")");
            b.toString()
        end;

    let dumpModuleDecl(modDecl: ast.ModuleDecl indent: Int showOffsets: Bool): String =
        begin
            let pad = makePadding(indent);
            let cpad = makePadding({indent + 1});
            let b = stringBuilder.new();
            b.str("(ModuleDecl
");
            b.str(cpad);
            b.str(":name ");
            b.str(pyRepr(modDecl.name));
            b.str("
");
            b.str(cpad);
            b.str(":interface_name ");
            b.str(pyRepr(modDecl.interfaceName));
            b.str("
");
            b.str(cpad);
            b.str(":bindings (
");
            let nB = vector.length(:ast.Decl modDecl.bindings);
            for i = 0 upto {nB - 1} do
                b.str(makePadding({indent + 2}));
                b.str(dumpDecl(vector.get(:ast.Decl modDecl.bindings i)
                    {indent + 2} showOffsets));
                b.str("
");
            end;
            b.str(cpad);
            b.str(")
");
            let nImp = vector.length(:ast.ImportItem modDecl.imports);
            if nImp > 0 then
                b.str(cpad);
                b.str(":imports (
");
                for i = 0 upto {nImp - 1} do
                    b.str(makePadding({indent + 2}));
                    b.str(dumpImportItem(vector.get(:ast.ImportItem modDecl.imports i)
                        {indent + 2} showOffsets));
                    b.str("
");
                end;
                b.str(cpad);
                b.str(")
");
            end;
            if modDecl.isUnsound then
                b.str(cpad);
                b.str(":is_unsound True
");
            end;
            b.str(pad);
            b.str(")");
            b.toString()
        end;

    let dumpPhrase(node: ast.Phrase indent: Int showOffsets: Bool): String =
        case node.form
            when phraseImport with p then
                dumpImportPhrase(p.phrase indent showOffsets)
            when phraseInterface with i then
                dumpInterfaceDecl(i.iface indent showOffsets)
            when phraseModule with m then
                dumpModuleDecl(m.modDecl indent showOffsets)
            when phraseDecl with d then
                dumpDecl(d.decl indent showOffsets)
            when phraseExpr with e then
                dumpExpr(e.expr indent showOffsets)
        end;
    let dumpProgram(node: ast.Program indent: Int showOffsets: Bool): String =
        begin
            let nP = vector.length(:ast.Phrase node.form.phrases);
            if nP is 0 then
                "(Program ())"
            else
                let pad = makePadding(indent);
                let cpad = makePadding({indent + 1});
                let b = stringBuilder.new();
                b.str("(Program
");
                b.str(cpad);
                b.str(":phrases (
");
                for i = 0 upto {nP - 1} do
                    b.str(makePadding({indent + 2}));
                    b.str(dumpPhrase(vector.get(:ast.Phrase node.form.phrases i)
                        {indent + 2} showOffsets));
                    b.str("
");
                end;
                b.str(cpad);
                b.str(")
");
                b.str(pad);
                b.str(")");
                b.toString()
            end
        end;
    let dump(node: ast.Program): String =
        dumpProgram(node 0 false);

    let dumpWithOptions(node: ast.Program showOffsets: Bool): String =
        dumpProgram(node 0 showOffsets);
end;