(* Quest Self-Hosted Compiler: Canonical AST Pretty-Printer Implementation
 *
 * An AST is printed in two steps: each node is converted to a generic S-expression (S) that has the shape of
 * the corresponding Python AST node, field for field, and a single renderer prints S-expressions with the
 * same layout rules as ast_dump in bootstrap/python/quest/ast.py. *)

module astprint : AstPrint
import
    questlang/syntax/ast : questlang/syntax/Ast
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/stringBuilder : util/StringBuilder
    stringOp = string : StringOp
    ascii : Ascii
    conv : Conv
export
    (* =========================================================================
     * 1. S-Expressions
     * ========================================================================= *)

    (* A value in ast_dump's output: Python's None; a bool; a leaf already rendered (an int, a real, an enum
     * member, or a quoted string); a tuple of strings; a tuple of other values; or a node with named fields *)
    Let Rec S = Option
        nil
        flag with value: Bool end
        atom with text: String end
        strs with items: vector.T(String) end
        seq with items: Array(S) end
        node with name: String fields: Array(Tuple name: String value: S end) end
    end;

    Let Field = Tuple name: String value: S end;

    let hexDigit(n: Int): Char = stringOp.getChar("0123456789abcdef" n);

    (* Python's repr of a string: single quotes unless the string holds a single quote and no double quote *)
    let pyRepr(s: String): String =
        begin
            let size = stringOp.length(s);
            let var hasSingle = false;
            let var hasDouble = false;
            for i = 0 upto {size - 1} do
                let c = stringOp.getChar(s i);
                if c is '\'' then hasSingle := true elsif c is '"' then hasDouble := true end;
            end;
            let quote = if hasSingle andif not(hasDouble) then '"' else '\'' end;
            let b = stringBuilder.new();
            b.char(quote);
            for i = 0 upto {size - 1} do
                let c = stringOp.getChar(s i);
                let code = ascii.val(c);
                if c is '\\' then b.str("\\\\")
                elsif c is quote then b.char('\\').char(quote)
                elsif code is 10 then b.str("\\n")
                elsif code is 13 then b.str("\\r")
                elsif code is 9 then b.str("\\t")
                elsif {code < 32} orif {code is 127} then
                    b.str("\\x").char(hexDigit(code / 16)).char(hexDigit(code % 16))
                else b.char(c)
                end;
            end;
            b.char(quote).toString()
        end;

    (* Python writes negative numbers with -, Quest with ~ *)
    let pyNumber(s: String): String =
        if {stringOp.length(s) > 0} andif {stringOp.getChar(s 0) is '~'} then
            "-" <> stringOp.getSub(s 1 {stringOp.length(s) - 1})
        else
            s
        end;

    let none: S = option nil of S end;
    let flag(value: Bool): S = option flag of S with let value = value end;
    let atom(text: String): S = option atom of S with let text = text end;
    let str(s: String): S = atom(pyRepr(s));
    let int(n: Int): S = atom(pyNumber(conv.int(n)));
    let real(r: Real): S = atom(pyNumber(conv.real(r)));
    let strs(items: vector.T(String)): S = option strs of S with let items = items end;
    let seq(items: Array(S)): S = option seq of S with let items = items end;
    let node(name: String fields: Array(Field)): S =
        option node of S with let name = name let fields = fields end;
    let leaf(name: String): S = node(name array of :Field end);
    let f(name: String value: S): Field = tuple let name = name let value = value end;

    let optional(A::TYPE m: maybe.T(A) dumpA: All(a: A) S): S =
        if maybe.isSome(:A m) then dumpA(maybe.unwrap(:A m)) else none end;
    let optStr(m: maybe.T(String)): S = optional(:String m str);
    let each(A::TYPE v: vector.T(A) dumpA: All(a: A) S): S = seq(vector.toArray(:S vector.map(:A :S v dumpA)));

    let mode(m: ast.ParamMode): S =
        atom(case m when modeValue then "VALUE" when modeVar then "VAR" when modeOut then "OUT" end);

    (* =========================================================================
     * 2. Types and Kinds
     * ========================================================================= *)

    let rec ty(t: ast.TypeExpr): S =
        case t.form
            when kindType then leaf("KindType")
            when kindPower with k then node("KindPower" array of f("bound" ty(k.bound)) end)
            when kindAll with k then
                node("KindAll" array of
                    f("param_name" str(k.paramName)) f("param_kind" ty(k.paramKind)) f("body_kind" ty(k.bodyKind))
                end)
            when kindId with k then node("KindId" array of f("name" str(k.name)) end)
            when kindManifest with k then
                node("KindManifest" array of
                    f("interface_name" str(k.interfaceName)) f("kind_name" str(k.kindName))
                end)
            when typePath with p then node("TypePath" array of f("path" strs(p.path)) end)
            when typeAll with a then
                node("TypeAll" array of
                    f("quantifiers" each(:ast.Quantifier a.quantifiers quantifier)) f("result_type" ty(a.resultType))
                end)
            when typeTuple with x then node("TypeTuple" array of f("fields" each(:ast.Signature x.fields signature)) end)
            when typeRecord with x then
                node("TypeRecord" array of f("fields" each(:ast.RecordFieldSig x.fields recordFieldSig)) end)
            when typeOption with x then
                node("TypeOption" array of f("variants" each(:ast.OptionFieldSig x.variants optionFieldSig)) end)
            when typeVariant with x then
                node("TypeVariant" array of f("fields" each(:ast.VariantFieldSig x.fields variantFieldSig)) end)
            when typeAuto with x then
                node("TypeAuto" array of
                    f("type_param" optStr(x.typeParam)) f("kind_bound" ty(x.kindBound))
                    f("signature" each(:ast.FieldSig x.signature fieldSig))
                end)
            when typeFun with x then
                node("TypeFun" array of
                    f("params" each(:ast.TypeFormal x.params typeFormal))
                    f("result_kind" optional(:ast.KindExpr x.resultKind ty)) f("body" ty(x.body))
                end)
            when typeRec with x then
                node("TypeRec" array of f("var_name" str(x.varName)) f("bound" ty(x.bound)) f("body" ty(x.body)) end)
            when typeApp with x then
                node("TypeApp" array of
                    f("constructor" ty(x.constructor)) f("arguments" each(:ast.TypeExpr x.arguments ty))
                end)
            when typeInfix with x then
                node("TypeInfix" array of f("left" ty(x.left)) f("op" str(x.op)) f("right" ty(x.right)) end)
            when typeArray with x then node("TypeArray" array of f("element_type" ty(x.elementType)) end)
            when typeVar with x then node("TypeVar" array of f("element_type" ty(x.elementType)) end)
            when typeOut with x then node("TypeOut" array of f("element_type" ty(x.elementType)) end)
            when typeManifest with x then
                node("TypeManifest" array of f("module_name" str(x.moduleName)) f("type_name" str(x.typeName)) end)
            when typeExternal with x then node("TypeExternal" array of f("c_type" str(x.cType)) end)
        end
    and quantifier(q: ast.Quantifier): S =
        node("Quantifier" array of
            f("name" str(q.name)) f("bound" ty(q.bound)) f("mode" mode(q.mode)) f("is_type" flag(q.isType))
        end)
    and fieldSig(s: ast.FieldSig): S =
        node("FieldSig" array of
            f("name" optStr(s.name)) f("type_sig" optional(:ast.TypeExpr s.typeSig ty)) f("mode" mode(s.mode))
        end)
    and recordFieldSig(s: ast.RecordFieldSig): S =
        node("RecordFieldSig" array of f("name" str(s.name)) f("type_sig" ty(s.typeSig)) f("is_var" flag(s.isVar)) end)
    and optionFieldSig(s: ast.OptionFieldSig): S =
        node("OptionFieldSig" array of
            f("tag" str(s.tag)) f("payload_sig" each(:ast.FieldSig s.payloadSig fieldSig))
        end)
    and variantFieldSig(s: ast.VariantFieldSig): S =
        node("VariantFieldSig" array of f("tag" str(s.tag)) f("type_sig" ty(s.typeSig)) f("is_var" flag(s.isVar)) end)
    and typeFormal(p: ast.TypeFormal): S =
        node("TypeFormal" array of f("name" str(p.name)) f("bound" ty(p.bound)) end)
    and typeBinding(b: ast.TypeBinding): S =
        node("TypeBinding" array of
            f("name" str(b.name)) f("type_val" ty(b.typeVal)) f("params" each(:ast.TypeFormal b.params typeFormal))
            f("bound" optional(:ast.KindExpr b.bound ty)) f("is_rec" flag(b.isRec)) f("is_def" flag(b.isDef))
        end)
    and signature(s: ast.Signature): S =
        case s
            when sigValue with x then fieldSig(x.val)
            when sigType with x then typeFormal(x.val)
            when sigTypeBinding with x then typeBinding(x.val)
            when sigTypeBindingGroup with x then
                node("TypeBindingGroup" array of f("bindings" each(:ast.TypeBinding x.val typeBinding)) end)
            when sigKindBinding with x then
                node("DefKindBinding" array of f("name" str(x.val.name)) f("kind_val" ty(x.val.kindVal)) end)
        end;

    let formalParam(p: ast.FormalParam): S =
        node("FormalParam" array of
            f("name" str(p.name)) f("type_annot" optional(:ast.TypeExpr p.typeAnnot ty)) f("mode" mode(p.mode))
        end);

    let optTy(m: maybe.T(ast.TypeExpr)): S = optional(:ast.TypeExpr m ty);

    (* =========================================================================
     * 3. Expressions and Declarations
     * ========================================================================= *)

    let rec ex(e: ast.Expr): S =
        case e.form
            when exprInt with x then node("ExprInt" array of f("value" int(x.value)) f("lexeme" str(x.lexeme)) end)
            when exprReal with x then node("ExprReal" array of f("value" real(x.value)) f("lexeme" str(x.lexeme)) end)
            when exprChar with x then
                node("ExprChar" array of f("value" str(stringOp.new(1 x.value))) f("lexeme" str(x.lexeme)) end)
            when exprString with x then
                node("ExprString" array of f("value" str(x.value)) f("lexeme" str(x.lexeme)) end)
            when exprBool with x then node("ExprBool" array of f("value" flag(x.value)) end)
            when exprOk then leaf("ExprOk")
            when exprId with x then node("ExprId" array of f("name" str(x.name)) end)
            when exprExternal with x then node("ExprExternal" array of f("symbol" str(x.symbol)) end)
            when typeArg with x then node("TypeArgument" array of f("type_val" ty(x.typeVal)) end)
            when kindArg with x then node("KindArgument" array of f("kind_val" ty(x.kindVal)) end)
            when exprBlock with x then node("ExprBlock" array of f("bindings" each(:ast.Expr x.bindings ex)) end)
            when exprIf with x then
                node("ExprIf" array of
                    f("cond" ex(x.cond)) f("then_branch" ex(x.thenBranch))
                    f("elsifs" each(:ast.ElsifBranch x.elsifs elsifBranch)) f("else_branch" optEx(x.elseBranch))
                end)
            when exprWhile with x then node("ExprWhile" array of f("cond" ex(x.cond)) f("body" ex(x.body)) end)
            when exprLoop with x then node("ExprLoop" array of f("body" ex(x.body)) end)
            when exprExit then leaf("ExprExit")
            when exprFor with x then
                node("ExprFor" array of
                    f("var_name" str(x.varName)) f("start" ex(x.start)) f("is_downto" flag(x.isDownto))
                    f("stop" ex(x.stop)) f("body" ex(x.body))
                end)
            when exprFun with x then
                node("ExprFun" array of
                    f("params" each(:ast.FormalParam x.params formalParam)) f("return_type" optTy(x.returnType))
                    f("body" ex(x.body)) f("type_params" each(:ast.TypeFormal x.typeParams typeFormal))
                end)
            when exprApp with x then
                node("ExprApp" array of f("func" ex(x.func)) f("args" each(:ast.Expr x.args ex)) end)
            when exprInfix with x then
                node("ExprInfix" array of f("left" ex(x.left)) f("op" str(x.op)) f("right" ex(x.right)) end)
            when exprTuple with x then node("ExprTuple" array of f("fields" each(:ast.TupleField x.fields tupleField)) end)
            when exprRecord with x then
                node("ExprRecord" array of f("fields" each(:ast.RecordBinding x.fields recordBinding)) end)
            when exprArray with x then
                node("ExprArray" array of
                    f("elements" each(:ast.Expr x.elements ex)) f("element_type" optTy(x.elementType))
                end)
            when exprArrayRep with x then
                node("ExprArrayRep" array of f("count" ex(x.count)) f("init_val" ex(x.initVal)) end)
            when exprOption with x then
                node("ExprOption" array of
                    f("tag" optStr(x.tag)) f("option_type" ty(x.optionType)) f("payload" optEx(x.payload))
                    f("ordinal_expr" optEx(x.ordinalExpr))
                end)
            when exprVariant with x then
                node("ExprVariant" array of
                    f("tag" str(x.tag)) f("variant_type" ty(x.variantType)) f("is_var" flag(x.isVar))
                    f("payload" optEx(x.payload))
                end)
            when exprAuto with x then
                node("ExprAuto" array of
                    f("witness_type" ty(x.witnessType)) f("payload" ex(x.payload))
                    f("witness_name" optStr(x.witnessName)) f("witness_bound" optTy(x.witnessBound))
                end)
            when exprSelect with x then node("ExprSelect" array of f("target" ex(x.target)) f("field" str(x.field)) end)
            when exprIndex with x then node("ExprIndex" array of f("target" ex(x.target)) f("index" ex(x.index)) end)
            when exprIndexAssign with x then
                node("ExprIndexAssign" array of
                    f("target" ex(x.target)) f("index" ex(x.index)) f("value" ex(x.value))
                end)
            when exprVarCell with x then node("ExprVarCell" array of f("value" ex(x.value)) end)
            when exprDerefCell with x then node("ExprDerefCell" array of f("target" ex(x.target)) end)
            when exprVariantCheck with x then
                node("ExprVariantCheck" array of f("target" ex(x.target)) f("tag" str(x.tag)) end)
            when exprVariantAssert with x then
                node("ExprVariantAssert" array of f("target" ex(x.target)) f("tag" str(x.tag)) end)
            when exprCase with x then
                node("ExprCase" array of
                    f("target" ex(x.target)) f("branches" each(:ast.CaseBranch x.branches caseBranch))
                    f("else_branch" optEx(x.elseBranch))
                end)
            when exprInspect with x then
                node("ExprInspect" array of
                    f("target" ex(x.target)) f("branches" each(:ast.InspectBranch x.branches inspectBranch))
                    f("else_branch" optEx(x.elseBranch))
                end)
            when exprException with x then
                node("ExprException" array of f("name" str(x.name)) f("type_annot" optTy(x.typeAnnot)) end)
            when exprRaise with x then
                node("ExprRaise" array of
                    f("exc" ex(x.exc)) f("payload" optEx(x.payload)) f("as_type" optTy(x.asType))
                end)
            when exprTry with x then
                node("ExprTry" array of
                    f("body" ex(x.body)) f("branches" each(:ast.TryBranch x.branches tryBranch))
                    f("else_branch" optEx(x.elseBranch))
                end)
            when declLetVal with x then
                node("LetValueBinding" array of
                    f("name" str(x.name)) f("value" ex(x.value)) f("params" each(:ast.FormalParam x.params formalParam))
                    f("type_annot" optTy(x.typeAnnot)) f("is_rec" flag(x.isRec)) f("is_var" flag(x.isVar))
                end)
            when declLetValGroup with x then
                node("LetValueBindingGroup" array of f("bindings" each(:ast.Decl x.bindings ex)) end)
            when declTypeBinding with x then
                typeBinding(tuple
                    let name = x.name let typeVal = x.typeVal let params = x.params let bound = x.bound
                    let isRec = x.isRec let isDef = x.isDef
                end)
            when declTypeBindingGroup with x then
                node("TypeBindingGroup" array of f("bindings" each(:ast.Decl x.bindings ex)) end)
            when declDefKind with x then
                node("DefKindBinding" array of f("name" str(x.name)) f("kind_val" ty(x.kindVal)) end)
            when declExprStmt with x then node("ExprStmt" array of f("expr" ex(x.expr)) end)
        end
    and optEx(m: maybe.T(ast.Expr)): S = optional(:ast.Expr m ex)
    (* Python holds an elsif as a plain (cond, then) tuple *)
    and elsifBranch(b: ast.ElsifBranch): S = seq(array of ex(b.cond) ex(b.thenBranch) end)
    and tupleField(t: ast.TupleField): S =
        case t
            when fieldVal with v then tupleBinding(v.val)
            when fieldGroup with g then
                node("TupleBindingGroup" array of f("bindings" each(:ast.TupleFieldBinding g.val tupleBinding)) end)
            when fieldDecl with d then ex(d.val)
        end
    and tupleBinding(b: ast.TupleFieldBinding): S =
        node("TupleBinding" array of
            f("name" optStr(b.name)) f("value" ex(b.value)) f("type_annot" optTy(b.typeAnnot)) f("is_var" flag(b.isVar))
        end)
    and recordBinding(r: ast.RecordBinding): S =
        node("RecordBinding" array of f("name" str(r.name)) f("value" ex(r.value)) f("is_var" flag(r.isVar)) end)
    and caseBranch(c: ast.CaseBranch): S =
        node("CaseBranch" array of
            f("tags" strs(c.tags)) f("binder" optStr(c.binder)) f("binder_type" optTy(c.binderType))
            f("body" ex(c.body))
        end)
    (* Python holds an inspect binder as a plain (name, type) tuple *)
    and inspectBranch(i: ast.InspectBranch): S =
        node("InspectBranch" array of
            f("match_type" ty(i.matchType))
            f("binders" each(:ast.InspectBinder i.binders
                fun(x: ast.InspectBinder): S seq(array of str(x.name) optTy(x.typeAnnot) end)))
            f("body" ex(i.body))
        end)
    and tryBranch(t: ast.TryBranch): S =
        node("TryBranch" array of
            f("exc_pattern" ex(t.excPattern)) f("binder" optStr(t.binder)) f("binder_type" optTy(t.binderType))
            f("body" ex(t.body))
        end);

    (* =========================================================================
     * 4. Phrases and Programs
     * ========================================================================= *)

    let importItem(i: ast.ImportItem): S =
        node("ImportItem" array of
            f("names" strs(i.names)) f("interface_name" str(i.interfaceName))
            f("module_paths" optional(:vector.T(String) i.modulePaths strs)) f("interface_path" optStr(i.interfacePath))
        end);

    let phrase(p: ast.Phrase): S =
        case p.form
            when phraseImport with x then
                node("ImportPhrase" array of f("items" each(:ast.ImportItem x.phrase.items importItem)) end)
            when phraseInterface with x then
                node("InterfaceDecl" array of
                    f("name" str(x.iface.name)) f("signatures" each(:ast.Signature x.iface.signatures signature))
                    f("imports" each(:ast.ImportItem x.iface.imports importItem)) f("is_unsound" flag(x.iface.isUnsound))
                end)
            when phraseModule with x then
                node("ModuleDecl" array of
                    f("name" str(x.modDecl.name)) f("interface_name" str(x.modDecl.interfaceName))
                    f("bindings" each(:ast.Decl x.modDecl.bindings ex))
                    f("imports" each(:ast.ImportItem x.modDecl.imports importItem))
                    f("is_unsound" flag(x.modDecl.isUnsound))
                end)
            when phraseDecl with x then ex(x.decl)
            when phraseExpr with x then ex(x.expr)
        end;

    let program(p: ast.Program): S = node("Program" array of f("phrases" each(:ast.Phrase p.form.phrases phrase)) end);

    (* =========================================================================
     * 5. Rendering, with ast_dump's layout rules
     * ========================================================================= *)

    (* A simple value is printed on its owner's line: everything but nodes and nonempty tuples of non-strings *)
    let isSimple(v: S): Bool =
        case v
            when seq with x then extent x.items is 0
            when node then false
            else true
        end;

    (* A field that a multi-line node leaves out: None, False, or an empty tuple *)
    let isOmitted(v: S): Bool =
        case v
            when nil then true
            when flag with x then not(x.value)
            when strs with x then vector.length(:String x.items) is 0
            when seq with x then extent x.items is 0
            else false
        end;

    let pad(b: stringBuilder.T indent: Int): stringBuilder.T = b.repeat(' ' {2 * indent});

    let flagText(value: Bool): String = if value then "True" else "False" end;

    (* The items of a tuple of strings, quoted and separated by sep *)
    let quoted(b: stringBuilder.T items: vector.T(String) sep: String): stringBuilder.T =
        begin
            for i = 0 upto {vector.length(:String items) - 1} do
                if i > 0 then b.str(sep) end;
                b.str(pyRepr(vector.get(:String items i)));
            end;
            b
        end;

    (* A simple value as a field of a node *)
    let simpleField(b: stringBuilder.T v: S): stringBuilder.T =
        case v
            when flag with x then b.str(flagText(x.value))
            when atom with x then b.str(x.text)
            when strs with x then quoted(b.char('(') x.items " ").char(')')
            else b.str("()")
        end;

    (* A simple value as an item of a tuple, as Python's str prints it *)
    let simpleItem(b: stringBuilder.T v: S): stringBuilder.T =
        case v
            when nil then b.str("None")
            when strs with x then
                begin
                    quoted(b.char('(') x.items ", ");
                    if vector.length(:String x.items) is 1 then b.char(',') end;
                    b.char(')')
                end
            else simpleField(b v)
        end;

    let rec render(b: stringBuilder.T v: S indent: Int): stringBuilder.T =
        case v
            when nil then b.str("nil")
            when seq with x then
                begin
                    let count = extent x.items;
                    let var allSimple = true;
                    for i = 0 upto {count - 1} do
                        if not(isSimple(x.items[i])) then allSimple := false end;
                    end;
                    if count is 0 then
                        b.str("()")
                    elsif allSimple then
                        b.char('(');
                        for i = 0 upto {count - 1} do
                            if i > 0 then b.char(' ') end;
                            simpleItem(b x.items[i]);
                        end;
                        b.char(')')
                    else
                        b.char('(');
                        for i = 0 upto {count - 1} do
                            render(pad(b.char('\n') {indent + 1}) x.items[i] {indent + 1});
                        end;
                        pad(b.char('\n') indent).char(')')
                    end
                end
            when node with x then renderNode(b x.name x.fields indent)
            else simpleField(b v)
        end
    and renderNode(b: stringBuilder.T name: String fields: Array(Field) indent: Int): stringBuilder.T =
        begin
            let count = extent fields;
            let var allSimple = true;
            for i = 0 upto {count - 1} do
                if not(isSimple(fields[i].value)) then allSimple := false end;
            end;
            b.char('(').str(name);
            if allSimple then
                for i = 0 upto {count - 1} do
                    let v = fields[i].value;
                    case v when nil then ok else simpleField(b.char(' ') v); ok end;
                end;
                b.char(')')
            else
                for i = 0 upto {count - 1} do
                    let v = fields[i].value;
                    if not(isOmitted(v)) then
                        pad(b.char('\n') {indent + 1}).char(':').str(fields[i].name).char(' ');
                        case v
                            when seq with x then
                                begin
                                    let itemCount = extent x.items;
                                    b.char('(');
                                    for k = 0 upto {itemCount - 1} do
                                        render(pad(b.char('\n') {indent + 2}) x.items[k] {indent + 2});
                                    end;
                                    pad(b.char('\n') {indent + 1}).char(')')
                                end
                            when node then render(b v {indent + 1})
                            else simpleField(b v)
                        end;
                    end;
                end;
                pad(b.char('\n') indent).char(')')
            end
        end;

    let show(v: S): String = render(stringBuilder.new() v 0).toString();

    let dump(node: ast.Program): String = show(program(node));
    let dumpPhrase(node: ast.Phrase): String = show(phrase(node));
    let dumpExpr(node: ast.Expr): String = show(ex(node));
    let dumpTypeExpr(node: ast.TypeExpr): String = show(ty(node));
end;
