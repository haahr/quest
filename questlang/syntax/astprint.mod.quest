(* Quest Self-Hosted Compiler: Canonical AST Pretty-Printer Implementation *)

module astprint : AstPrint
import
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/common/location : questlang/common/Location
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/stringBuilder : util/StringBuilder
    stringOp = string : StringOp
    ascii : Ascii
    conv : Conv
export
    let makePadding(indent: Int): String =
        begin
            let b = stringBuilder.new();
            for i = 1 upto indent do
                b.str("  ");
            end;
            b.toString()
        end;

    let pyRepr(s: String): String =
        begin
            let sLen = stringOp.length(s);
            let var hasSingle = false;
            let var hasDouble = false;
            for i = 0 upto {sLen - 1} do
                let v = ascii.val(stringOp.getChar(s i));
                if v is 39 then
                    hasSingle := true;
                elsif v is 34 then
                    hasDouble := true;
                end;
            end;
            let quoteChar = if hasSingle andif not(hasDouble) then ascii.char(34) else ascii.char(39) end;
            let b = stringBuilder.new();
            b.char(quoteChar);
            for i = 0 upto {sLen - 1} do
                let c = stringOp.getChar(s i);
                let v = ascii.val(c);
                if v is 92 then
                    b.char(ascii.char(92));
                elsif v is 10 then
                    b.str("\n");
                elsif v is 13 then
                    b.str("\r");
                elsif v is 9 then
                    b.str("\t");
                elsif c is quoteChar then
                    b.char(ascii.char(92));
                    b.char(quoteChar);
                else
                    b.char(c);
                end;
            end;
            b.char(quoteChar);
            b.toString()
        end;
    let paramModeName(mode: ast.ParamMode): String =
        case mode
            when modeValue then "VALUE"
            when modeVar then "VAR"
            when modeOut then "OUT"
        end;

    let dumpStringTuple(items: vector.T(String)): String =
        begin
            let n = vector.length(:String items);
            if n is 0 then
                "()"
            else
                let b = stringBuilder.new();
                b.str("(");
                for i = 0 upto {n - 1} do
                    if i > 0 then
                        b.str(" ");
                    end;
                    b.str(pyRepr(vector.get(:String items i)));
                end;
                b.str(")");
                b.toString()
            end
        end;

    let rec dumpTypeExpr(node: ast.TypeExpr indent: Int showOffsets: Bool): String =
        begin
        let dumpQuantifier(q: ast.Quantifier indent: Int showOffsets: Bool): String =
            begin
                let pad = makePadding(indent);
                let cpad = makePadding({indent + 1});
                let b = stringBuilder.new();
                b.str("(Quantifier
");
                b.str(cpad);
                b.str(":name ");
                b.str(pyRepr(q.name));
                b.str("
");
                b.str(cpad);
                b.str(":bound ");
                b.str(dumpTypeExpr(q.bound {indent + 1} showOffsets));
                b.str("
");
                b.str(cpad);
                b.str(":mode ");
                b.str(paramModeName(q.mode));
                b.str("
");
                if q.isType then
                    b.str(cpad);
                    b.str(":is_type True
");
                end;
                b.str(pad);
                b.str(")");
                b.toString()
            end;

        let dumpFieldSig(f: ast.FieldSig indent: Int showOffsets: Bool): String =
            begin
                let pad = makePadding(indent);
                let cpad = makePadding({indent + 1});
                let b = stringBuilder.new();
                b.str("(FieldSig
");
                if maybe.isSome(:String f.name) then
                    b.str(cpad);
                    b.str(":name ");
                    b.str(pyRepr(maybe.unwrap(:String f.name)));
                    b.str("
");
                end;
                if maybe.isSome(:ast.TypeExpr f.typeSig) then
                    b.str(cpad);
                    b.str(":type_sig ");
                    b.str(dumpTypeExpr(maybe.unwrap(:ast.TypeExpr f.typeSig)
                        {indent + 1} showOffsets));
                    b.str("
");
                end;
                b.str(cpad);
                b.str(":mode ");
                b.str(paramModeName(f.mode));
                b.str("
");
                b.str(pad);
                b.str(")");
                b.toString()
            end;

        let dumpRecordFieldSig(r: ast.RecordFieldSig indent: Int showOffsets: Bool): String =
            begin
                let pad = makePadding(indent);
                let cpad = makePadding({indent + 1});
                let b = stringBuilder.new();
                b.str("(RecordFieldSig
");
                b.str(cpad);
                b.str(":name ");
                b.str(pyRepr(r.name));
                b.str("
");
                b.str(cpad);
                b.str(":type_sig ");
                b.str(dumpTypeExpr(r.typeSig {indent + 1} showOffsets));
                b.str("
");
                if r.isVar then
                    b.str(cpad);
                    b.str(":is_var True
");
                end;
                b.str(pad);
                b.str(")");
                b.toString()
            end;

        let dumpOptionFieldSig(o: ast.OptionFieldSig indent: Int showOffsets: Bool): String =
            begin
                let nP = vector.length(:ast.FieldSig o.payloadSig);
                if nP is 0 then
                    stringOp.cat("(OptionFieldSig " stringOp.cat(pyRepr(o.tag) " ())"))
                else
                    let pad = makePadding(indent);
                    let cpad = makePadding({indent + 1});
                    let b = stringBuilder.new();
                    b.str("(OptionFieldSig
");
                    b.str(cpad);
                    b.str(":tag ");
                    b.str(pyRepr(o.tag));
                    b.str("
");
                    b.str(cpad);
                    b.str(":payload_sig (
");
                    for i = 0 upto {nP - 1} do
                        b.str(makePadding({indent + 2}));
                        b.str(dumpFieldSig(vector.get(:ast.FieldSig o.payloadSig i)
                            {indent + 2} showOffsets));
                        b.str("
");
                    end;
                    b.str(cpad);
                    b.str(")
");
                    b.str(pad);
                    b.str(")");
                    b.toString()
                end
            end;

        let dumpVariantFieldSig(v: ast.VariantFieldSig indent: Int showOffsets: Bool): String =
            begin
                let pad = makePadding(indent);
                let cpad = makePadding({indent + 1});
                let b = stringBuilder.new();
                b.str("(VariantFieldSig
");
                b.str(cpad);
                b.str(":tag ");
                b.str(pyRepr(v.tag));
                b.str("
");
                b.str(cpad);
                b.str(":type_sig ");
                b.str(dumpTypeExpr(v.typeSig {indent + 1} showOffsets));
                b.str("
");
                if v.isVar then
                    b.str(cpad);
                    b.str(":is_var True
");
                end;
                b.str(pad);
                b.str(")");
                b.toString()
            end;

        let dumpTypeFormal(t: ast.TypeFormal indent: Int showOffsets: Bool): String =
            begin
                let pad = makePadding(indent);
                let cpad = makePadding({indent + 1});
                let b = stringBuilder.new();
                b.str("(TypeFormal
");
                b.str(cpad);
                b.str(":name ");
                b.str(pyRepr(t.name));
                b.str("
");
                b.str(cpad);
                b.str(":bound ");
                b.str(dumpTypeExpr(t.bound {indent + 1} showOffsets));
                b.str("
");
                b.str(pad);
                b.str(")");
                b.toString()
            end;
        let dumpTypeForm(span: location.Span form: ast.TypeForm indent: Int showOffsets: Bool): String =
            begin
                let pad = makePadding(indent);
                let cpad = makePadding({indent + 1});
                case form
                when kindType then
                        "(KindType)"
                when kindPower with p then
                        begin
                            let b = stringBuilder.new();
                            b.str("(KindPower
");
                            b.str(cpad);
                            b.str(":bound ");
                            b.str(dumpTypeExpr(p.bound {indent + 1} showOffsets));
                            b.str("
");
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when kindAll with a then
                        begin
                            let b = stringBuilder.new();
                            b.str("(KindAll
");
                            b.str(cpad);
                            b.str(":param_name ");
                            b.str(pyRepr(a.paramName));
                            b.str("
");
                            b.str(cpad);
                            b.str(":param_kind ");
                            b.str(dumpTypeExpr(a.paramKind {indent + 1} showOffsets));
                            b.str("
");
                            b.str(cpad);
                            b.str(":body_kind ");
                            b.str(dumpTypeExpr(a.bodyKind {indent + 1} showOffsets));
                            b.str("
");
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when kindId with k then
                        stringOp.cat("(KindId " stringOp.cat(pyRepr(k.name) ")"))
                when kindManifest with m then
                        stringOp.cat("(KindManifest " stringOp.cat(pyRepr(m.interfaceName)
                            stringOp.cat(" " stringOp.cat(pyRepr(m.kindName) ")"))))
                when typePath with p then
                        stringOp.cat("(TypePath " stringOp.cat(dumpStringTuple(p.path) ")"))
                when typeAll with a then
                        begin
                            let b = stringBuilder.new();
                            b.str("(TypeAll
");
                            b.str(cpad);
                            b.str(":quantifiers (
");
                            let nQ = vector.length(:ast.Quantifier a.quantifiers);
                            for i = 0 upto {nQ - 1} do
                                b.str(makePadding({indent + 2}));
                                b.str(dumpQuantifier(vector.get(:ast.Quantifier a.quantifiers i)
                                    {indent + 2} showOffsets));
                                b.str("
");
                            end;
                            b.str(cpad);
                            b.str(")
");
                            b.str(cpad);
                            b.str(":result_type ");
                            b.str(dumpTypeExpr(a.resultType {indent + 1} showOffsets));
                            b.str("
");
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when typeTuple with t then
                        begin
                            let nF = vector.length(:ast.FieldSig t.fields);
                            if nF is 0 then
                                "(TypeTuple ())"
                            else
                                let b = stringBuilder.new();
                                b.str("(TypeTuple
");
                                b.str(cpad);
                                b.str(":fields (
");
                                for i = 0 upto {nF - 1} do
                                    b.str(makePadding({indent + 2}));
                                    b.str(dumpFieldSig(vector.get(:ast.FieldSig t.fields i)
                                        {indent + 2} showOffsets));
                                    b.str("
");
                                end;
                                b.str(cpad);
                                b.str(")
");
                                b.str(pad);
                                b.str(")");
                                b.toString()
                            end
                        end
                when typeRecord with r then
                        begin
                            let nF = vector.length(:ast.RecordFieldSig r.fields);
                            if nF is 0 then
                                "(TypeRecord ())"
                            else
                                let b = stringBuilder.new();
                                b.str("(TypeRecord
");
                                b.str(cpad);
                                b.str(":fields (
");
                                for i = 0 upto {nF - 1} do
                                    b.str(makePadding({indent + 2}));
                                    b.str(dumpRecordFieldSig(vector.get(:ast.RecordFieldSig r.fields i)
                                        {indent + 2} showOffsets));
                                    b.str("
");
                                end;
                                b.str(cpad);
                                b.str(")
");
                                b.str(pad);
                                b.str(")");
                                b.toString()
                            end
                        end
                when typeOption with o then
                        begin
                            let nV = vector.length(:ast.OptionFieldSig o.variants);
                            if nV is 0 then
                                "(TypeOption ())"
                            else
                                let b = stringBuilder.new();
                                b.str("(TypeOption
");
                                b.str(cpad);
                                b.str(":variants (
");
                                for i = 0 upto {nV - 1} do
                                    b.str(makePadding({indent + 2}));
                                    let variantSig = vector.get(:ast.OptionFieldSig o.variants i);
                                    b.str(dumpOptionFieldSig(variantSig {indent + 2} showOffsets));
                                    b.str("
");
                                end;
                                b.str(cpad);
                                b.str(")
");
                                b.str(pad);
                                b.str(")");
                                b.toString()
                            end
                        end
                when typeVariant with v then
                        begin
                            let nF = vector.length(:ast.VariantFieldSig v.fields);
                            if nF is 0 then
                                "(TypeVariant ())"
                            else
                                let b = stringBuilder.new();
                                b.str("(TypeVariant
");
                                b.str(cpad);
                                b.str(":fields (
");
                                for i = 0 upto {nF - 1} do
                                    b.str(makePadding({indent + 2}));
                                    let fieldSig = vector.get(:ast.VariantFieldSig v.fields i);
                                    b.str(dumpVariantFieldSig(fieldSig {indent + 2} showOffsets));
                                    b.str("
");
                                end;
                                b.str(cpad);
                                b.str(")
");
                                b.str(pad);
                                b.str(")");
                                b.toString()
                            end
                        end
                when typeAuto with a then
                        begin
                            let b = stringBuilder.new();
                            b.str("(TypeAuto
");
                            if maybe.isSome(:String a.typeParam) then
                                b.str(cpad);
                                b.str(":type_param ");
                                b.str(pyRepr(maybe.unwrap(:String a.typeParam)));
                                b.str("
");
                            end;
                            b.str(cpad);
                            b.str(":kind_bound ");
                            b.str(dumpTypeExpr(a.kindBound {indent + 1} showOffsets));
                            b.str("
");
                            b.str(cpad);
                            b.str(":signature (
");
                            let nS = vector.length(:ast.FieldSig a.signature);
                            for i = 0 upto {nS - 1} do
                                b.str(makePadding({indent + 2}));
                                b.str(dumpFieldSig(vector.get(:ast.FieldSig a.signature i)
                                    {indent + 2} showOffsets));
                                b.str("
");
                            end;
                            b.str(cpad);
                            b.str(")
");
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when typeFun with f then
                        begin
                            let b = stringBuilder.new();
                            b.str("(TypeFun
");
                            b.str(cpad);
                            b.str(":params (
");
                            let nP = vector.length(:ast.TypeFormal f.params);
                            for i = 0 upto {nP - 1} do
                                b.str(makePadding({indent + 2}));
                                b.str(dumpTypeFormal(vector.get(:ast.TypeFormal f.params i)
                                    {indent + 2} showOffsets));
                                b.str("
");
                            end;
                            b.str(cpad);
                            b.str(")
");
                            if maybe.isSome(:ast.KindExpr f.resultKind) then
                                b.str(cpad);
                                b.str(":result_kind ");
                                b.str(dumpTypeExpr(maybe.unwrap(:ast.KindExpr f.resultKind)
                                    {indent + 1} showOffsets));
                                b.str("
");
                            end;
                            b.str(cpad);
                            b.str(":body ");
                            b.str(dumpTypeExpr(f.body {indent + 1} showOffsets));
                            b.str("
");
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when typeRec with r then
                        begin
                            let b = stringBuilder.new();
                            b.str("(TypeRec
");
                            b.str(cpad);
                            b.str(":var_name ");
                            b.str(pyRepr(r.varName));
                            b.str("
");
                            b.str(cpad);
                            b.str(":bound ");
                            b.str(dumpTypeExpr(r.bound {indent + 1} showOffsets));
                            b.str("
");
                            b.str(cpad);
                            b.str(":body ");
                            b.str(dumpTypeExpr(r.body {indent + 1} showOffsets));
                            b.str("
");
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when typeApp with a then
                        begin
                            let b = stringBuilder.new();
                            b.str("(TypeApp
");
                            b.str(cpad);
                            b.str(":constructor ");
                            b.str(dumpTypeExpr(a.constructor {indent + 1} showOffsets));
                            b.str("
");
                            b.str(cpad);
                            b.str(":arguments (
");
                            let nA = vector.length(:ast.TypeExpr a.arguments);
                            for i = 0 upto {nA - 1} do
                                b.str(makePadding({indent + 2}));
                                b.str(dumpTypeExpr(vector.get(:ast.TypeExpr a.arguments i)
                                    {indent + 2} showOffsets));
                                b.str("
");
                            end;
                            b.str(cpad);
                            b.str(")
");
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when typeInfix with i then
                        begin
                            let b = stringBuilder.new();
                            b.str("(TypeInfix
");
                            b.str(cpad);
                            b.str(":left ");
                            b.str(dumpTypeExpr(i.left {indent + 1} showOffsets));
                            b.str("
");
                            b.str(cpad);
                            b.str(":op ");
                            b.str(pyRepr(i.op));
                            b.str("
");
                            b.str(cpad);
                            b.str(":right ");
                            b.str(dumpTypeExpr(i.right {indent + 1} showOffsets));
                            b.str("
");
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when typeArray with a then
                        begin
                            let b = stringBuilder.new();
                            b.str("(TypeArray
");
                            b.str(cpad);
                            b.str(":element_type ");
                            b.str(dumpTypeExpr(a.elementType {indent + 1} showOffsets));
                            b.str("
");
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when typeVar with v then
                        begin
                            let b = stringBuilder.new();
                            b.str("(TypeVar
");
                            b.str(cpad);
                            b.str(":element_type ");
                            b.str(dumpTypeExpr(v.elementType {indent + 1} showOffsets));
                            b.str("
");
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when typeOut with o then
                        begin
                            let b = stringBuilder.new();
                            b.str("(TypeOut
");
                            b.str(cpad);
                            b.str(":element_type ");
                            b.str(dumpTypeExpr(o.elementType {indent + 1} showOffsets));
                            b.str("
");
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when typeManifest with m then
                        stringOp.cat("(TypeManifest " stringOp.cat(pyRepr(m.moduleName)
                            stringOp.cat(" " stringOp.cat(pyRepr(m.typeName) ")"))))
                when typeExternal with e then
                        stringOp.cat("(TypeExternal " stringOp.cat(pyRepr(e.cType) ")"))
                end
            end;
        dumpTypeForm(node.span node.form indent showOffsets)
    end;
    let dumpFormalParam(p: ast.FormalParam indent: Int showOffsets: Bool): String =
        begin
            let pad = makePadding(indent);
            let cpad = makePadding({indent + 1});
            let b = stringBuilder.new();
            b.str("(FormalParam
");
            b.str(cpad);
            b.str(":name ");
            b.str(pyRepr(p.name));
            b.str("
");
            if maybe.isSome(:ast.TypeExpr p.typeAnnot) then
                b.str(cpad);
                b.str(":type_annot ");
                b.str(dumpTypeExpr(maybe.unwrap(:ast.TypeExpr p.typeAnnot)
                    {indent + 1} showOffsets));
                b.str("
");
            end;
            b.str(cpad);
            b.str(":mode ");
            b.str(paramModeName(p.mode));
            b.str("
");
            b.str(pad);
            b.str(")");
            b.toString()
        end;


    let dumpTypeFormal(t: ast.TypeFormal indent: Int showOffsets: Bool): String =
        begin
            let pad = makePadding(indent);
            let cpad = makePadding({indent + 1});
            let b = stringBuilder.new();
            b.str("(TypeFormal
");
            b.str(cpad);
            b.str(":name ");
            b.str(pyRepr(t.name));
            b.str("
");
            b.str(cpad);
            b.str(":bound ");
            b.str(dumpTypeExpr(t.bound {indent + 1} showOffsets));
            b.str("
");
            b.str(pad);
            b.str(")");
            b.toString()
        end;

    let rec dumpExpr(node: ast.Expr indent: Int showOffsets: Bool): String =
        begin
        let dumpDecl(node: ast.Decl indent: Int showOffsets: Bool): String =
            dumpExpr(node indent showOffsets);
        let dumpTupleBinding(bnd: ast.TupleFieldBinding indent: Int showOffsets: Bool): String =
            begin
                let pad = makePadding(indent);
                let cpad = makePadding({indent + 1});
                let b = stringBuilder.new();
                b.str("(TupleBinding
");
                if maybe.isSome(:String bnd.name) then
                    b.str(cpad);
                    b.str(":name ");
                    b.str(pyRepr(maybe.unwrap(:String bnd.name)));
                    b.str("
");
                end;
                b.str(cpad);
                b.str(":value ");
                b.str(dumpExpr(bnd.value {indent + 1} showOffsets));
                b.str("
");
                if maybe.isSome(:ast.TypeExpr bnd.typeAnnot) then
                    b.str(cpad);
                    b.str(":type_annot ");
                    b.str(dumpTypeExpr(maybe.unwrap(:ast.TypeExpr bnd.typeAnnot)
                        {indent + 1} showOffsets));
                    b.str("
");
                end;
                if bnd.isVar then
                    b.str(cpad);
                    b.str(":is_var True
");
                end;
                b.str(pad);
                b.str(")");
                b.toString()
            end;

        let dumpTupleField(field: ast.TupleField indent: Int showOffsets: Bool): String =
            case field
                when fieldVal with v then
                    dumpTupleBinding(v.val indent showOffsets)
                when fieldDecl with d then
                    dumpDecl(d.val indent showOffsets)
            end;

        let dumpRecordBinding(bnd: ast.RecordBinding indent: Int showOffsets: Bool): String =
            begin
                let pad = makePadding(indent);
                let cpad = makePadding({indent + 1});
                let b = stringBuilder.new();
                b.str("(RecordBinding
");
                b.str(cpad);
                b.str(":name ");
                b.str(pyRepr(bnd.name));
                b.str("
");
                b.str(cpad);
                b.str(":value ");
                b.str(dumpExpr(bnd.value {indent + 1} showOffsets));
                b.str("
");
                if bnd.isVar then
                    b.str(cpad);
                    b.str(":is_var True
");
                end;
                b.str(pad);
                b.str(")");
                b.toString()
            end;

        let dumpCaseBranch(br: ast.CaseBranch indent: Int showOffsets: Bool): String =
            begin
                let pad = makePadding(indent);
                let cpad = makePadding({indent + 1});
                let b = stringBuilder.new();
                b.str("(CaseBranch
");
                b.str(cpad);
                b.str(":tags ");
                b.str(dumpStringTuple(br.tags));
                b.str("
");
                if maybe.isSome(:String br.binder) then
                    b.str(cpad);
                    b.str(":binder ");
                    b.str(pyRepr(maybe.unwrap(:String br.binder)));
                    b.str("
");
                end;
                if maybe.isSome(:ast.TypeExpr br.binderType) then
                    b.str(cpad);
                    b.str(":binder_type ");
                    b.str(dumpTypeExpr(maybe.unwrap(:ast.TypeExpr br.binderType)
                        {indent + 1} showOffsets));
                    b.str("
");
                end;
                b.str(cpad);
                b.str(":body ");
                b.str(dumpExpr(br.body {indent + 1} showOffsets));
                b.str("
");
                b.str(pad);
                b.str(")");
                b.toString()
            end;

        let dumpInspectBranch(br: ast.InspectBranch indent: Int showOffsets: Bool): String =
            begin
                let pad = makePadding(indent);
                let cpad = makePadding({indent + 1});
                let b = stringBuilder.new();
                b.str("(InspectBranch
");
                b.str(cpad);
                b.str(":match_type ");
                b.str(dumpTypeExpr(br.matchType {indent + 1} showOffsets));
                b.str("
");
                b.str(cpad);
                b.str(":binders (
");
                let nB = vector.length(:ast.InspectBinder br.binders);
                for i = 0 upto {nB - 1} do
                    let binder = vector.get(:ast.InspectBinder br.binders i);
                    if maybe.isSome(:ast.TypeExpr binder.typeAnnot) then
                        b.str(makePadding({indent + 2}));
                        b.str("(
");
                        b.str(makePadding({indent + 3}));
                        b.str(pyRepr(binder.name));
                        b.str("
");
                        b.str(makePadding({indent + 3}));
                        b.str(dumpTypeExpr(maybe.unwrap(:ast.TypeExpr binder.typeAnnot)
                            {indent + 3} showOffsets));
                        b.str("
");
                        b.str(makePadding({indent + 2}));
                        b.str(")
");
                    else
                        b.str(makePadding({indent + 2}));
                        b.str("(");
                        b.str(pyRepr(binder.name));
                        b.str(" None)
");
                    end;
                end;
                b.str(cpad);
                b.str(")
");
                b.str(cpad);
                b.str(":body ");
                b.str(dumpExpr(br.body {indent + 1} showOffsets));
                b.str("
");
                b.str(pad);
                b.str(")");
                b.toString()
            end;

        let dumpTryBranch(br: ast.TryBranch indent: Int showOffsets: Bool): String =
            begin
                let pad = makePadding(indent);
                let cpad = makePadding({indent + 1});
                let b = stringBuilder.new();
                b.str("(TryBranch
");
                b.str(cpad);
                b.str(":exc_pattern ");
                b.str(dumpExpr(br.excPattern {indent + 1} showOffsets));
                b.str("
");
                if maybe.isSome(:String br.binder) then
                    b.str(cpad);
                    b.str(":binder ");
                    b.str(pyRepr(maybe.unwrap(:String br.binder)));
                    b.str("
");
                end;
                if maybe.isSome(:ast.TypeExpr br.binderType) then
                    b.str(cpad);
                    b.str(":binder_type ");
                    b.str(dumpTypeExpr(maybe.unwrap(:ast.TypeExpr br.binderType)
                        {indent + 1} showOffsets));
                    b.str("
");
                end;
                b.str(cpad);
                b.str(":body ");
                b.str(dumpExpr(br.body {indent + 1} showOffsets));
                b.str("
");
                b.str(pad);
                b.str(")");
                b.toString()
            end;

        let dumpExprForm(span: location.Span form: ast.ExprForm indent: Int showOffsets: Bool): String =
            begin
                let pad = makePadding(indent);
                let cpad = makePadding({indent + 1});
                case form
                when exprInt with i then
                        stringOp.cat("(ExprInt " stringOp.cat(conv.int(i.value)
                            stringOp.cat(" " stringOp.cat(pyRepr(i.lexeme) ")"))))
                when exprReal with r then
                        stringOp.cat("(ExprReal " stringOp.cat(conv.real(r.value)
                            stringOp.cat(" " stringOp.cat(pyRepr(r.lexeme) ")"))))
                when exprChar with c then
                        stringOp.cat("(ExprChar " stringOp.cat(pyRepr(conv.char(c.value))
                            stringOp.cat(" " stringOp.cat(pyRepr(c.lexeme) ")"))))
                when exprString with s then
                        stringOp.cat("(ExprString " stringOp.cat(pyRepr(s.value)
                            stringOp.cat(" " stringOp.cat(pyRepr(s.lexeme) ")"))))
                when exprBool with b then
                        stringOp.cat("(ExprBool " stringOp.cat(if b.value then "True" else "False" end ")"))
                when exprOk then
                        "(ExprOk)"
                when exprId with i then
                        stringOp.cat("(ExprId " stringOp.cat(pyRepr(i.name) ")"))
                when exprExternal with e then
                        stringOp.cat("(ExprExternal " stringOp.cat(pyRepr(e.symbol) ")"))
                when typeArg with t then
                        begin
                            let b = stringBuilder.new();
                            b.str("(TypeArgument
");
                            b.str(cpad);
                            b.str(":type_val ");
                            b.str(dumpTypeExpr(t.typeVal {indent + 1} showOffsets));
                            b.str("
");
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when kindArg with k then
                        begin
                            let b = stringBuilder.new();
                            b.str("(KindArgument
");
                            b.str(cpad);
                            b.str(":kind_val ");
                            b.str(dumpTypeExpr(k.kindVal {indent + 1} showOffsets));
                            b.str("
");
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when exprBlock with b then
                        begin
                            let nB = vector.length(:ast.Decl b.bindings);
                            if nB is 0 then
                                "(ExprBlock ())"
                            else
                                let sb = stringBuilder.new();
                                sb.str("(ExprBlock
");
                                sb.str(cpad);
                                sb.str(":bindings (
");
                                for i = 0 upto {nB - 1} do
                                    sb.str(makePadding({indent + 2}));
                                    sb.str(dumpDecl(vector.get(:ast.Decl b.bindings i)
                                        {indent + 2} showOffsets));
                                    sb.str("
");
                                end;
                                sb.str(cpad);
                                sb.str(")
");
                                sb.str(pad);
                                sb.str(")");
                                sb.toString()
                            end
                        end
                when exprIf with i then
                        begin
                            let b = stringBuilder.new();
                            b.str("(ExprIf
");
                            b.str(cpad);
                            b.str(":cond ");
                            b.str(dumpExpr(i.cond {indent + 1} showOffsets));
                            b.str("
");
                            b.str(cpad);
                            b.str(":then_branch ");
                            b.str(dumpExpr(i.thenBranch {indent + 1} showOffsets));
                            b.str("
");
                            let nEls = vector.length(:ast.ElsifBranch i.elsifs);
                            if nEls > 0 then
                                b.str(cpad);
                                b.str(":elsifs (
");
                                for k = 0 upto {nEls - 1} do
                                    let eb = vector.get(:ast.ElsifBranch i.elsifs k);
                                    b.str(makePadding({indent + 2}));
                                    b.str("(
");
                                    b.str(makePadding({indent + 3}));
                                    b.str(dumpExpr(eb.cond {indent + 3} showOffsets));
                                    b.str("
");
                                    b.str(makePadding({indent + 3}));
                                    b.str(dumpExpr(eb.thenBranch {indent + 3} showOffsets));
                                    b.str("
");
                                    b.str(makePadding({indent + 2}));
                                    b.str(")
");
                                end;
                                b.str(cpad);
                                b.str(")
");
                            end;
                            if maybe.isSome(:ast.Expr i.elseBranch) then
                                b.str(cpad);
                                b.str(":else_branch ");
                                b.str(dumpExpr(maybe.unwrap(:ast.Expr i.elseBranch)
                                    {indent + 1} showOffsets));
                                b.str("
");
                            end;
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when exprWhile with w then
                        begin
                            let b = stringBuilder.new();
                            b.str("(ExprWhile
");
                            b.str(cpad);
                            b.str(":cond ");
                            b.str(dumpExpr(w.cond {indent + 1} showOffsets));
                            b.str("
");
                            b.str(cpad);
                            b.str(":body ");
                            b.str(dumpExpr(w.body {indent + 1} showOffsets));
                            b.str("
");
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when exprLoop with l then
                        begin
                            let b = stringBuilder.new();
                            b.str("(ExprLoop
");
                            b.str(cpad);
                            b.str(":body ");
                            b.str(dumpExpr(l.body {indent + 1} showOffsets));
                            b.str("
");
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when exprExit then
                        "(ExprExit)"
                when exprFor with f then
                        begin
                            let b = stringBuilder.new();
                            b.str("(ExprFor
");
                            b.str(cpad);
                            b.str(":var_name ");
                            b.str(pyRepr(f.varName));
                            b.str("
");
                            b.str(cpad);
