");
                            end;
                            b.str(cpad);
                            b.str(":body ");
                            b.str(dumpExpr(f.body {indent + 1} showOffsets));
                            b.str("
");
                            let nTP = vector.length(:ast.TypeFormal f.typeParams);
                            if nTP > 0 then
                                b.str(cpad);
                                b.str(":type_params (
");
                                for i = 0 upto {nTP - 1} do
                                    b.str(makePadding({indent + 2}));
                                    b.str(dumpTypeFormal(vector.get(:ast.TypeFormal f.typeParams i)
                                        {indent + 2} showOffsets));
                                    b.str("
");
                                end;
                                b.str(cpad);
                                b.str(")
");
                            end;
                            b.str(pad);
                            b.str(")");
                            b.toString()
                        end
                when exprApp with a then
                        begin
                            let b = stringBuilder.new();
                            b.str("(ExprApp
");
                            b.str(cpad);
                            b.str(":func ");
                            b.str(dumpExpr(a.func {indent + 1} showOffsets));
                            b.str("
");
                            let nA = vector.length(:ast.Expr a.args);
