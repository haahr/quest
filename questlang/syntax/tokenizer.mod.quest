(* Quest Self-Hosted Compiler: Lexical Analyzer Implementation *)

module tokenizer : Tokenizer
import
    location = questlang/common/location : questlang/common/Location
    diagbag = questlang/common/diagbag : questlang/common/DiagBag
    tokens = questlang/syntax/tokens : questlang/syntax/Tokens
    vector = collections/vector : collections/Vector
    hashmap = collections/hashmap : collections/HashMap
    hash = util/hash : util/Hash
    maybe = util/maybe : util/Maybe
    strutil = util/strutil : util/Strutil
    stringBuilder = util/stringbuilder : util/StringBuilder
    stringOp = string : StringOp
    ascii : Ascii
    conv : Conv
export
    Let K = tokens.TokenKind
    Let Table = hashmap.T(String K)

    Let T = Tuple
        sm: location.SourceMap
        bag: diagbag.T
        file: String
        text: String
        textLen: Int
        var cursor: Int
        var peeked: maybe.T(tokens.Token)
        keywords: Table
        reservedPunc: Table
        delimiters: Table
    end

    (* ======================================================================
     * Tables
     * ====================================================================== *)

    let newTable(): Table = hashmap.new(:String :K stringOp.equal hash.string)
    let add(m: Table s: String k: K): Ok = begin hashmap.insert(:String :K m s k) ok end
    let lookup(m: Table s: String): maybe.T(K) = hashmap.get(:String :K m s)

    let initKeywords(): Table =
        begin
            let m = newTable()
            (* Kind level *)
            add(m "TYPE" option kwType of K end) add(m "POWER" option kwPower of K end)
            add(m "ALL" option kwAllKind of K end) add(m "DEF" option kwDefKind of K end)
            (* Type level *)
            add(m "All" option kwAll of K end) add(m "Array" option kwArrayType of K end)
            add(m "Auto" option kwAutoType of K end) add(m "Def" option kwDef of K end)
            add(m "Exception" option kwExceptionType of K end) add(m "Fun" option kwFunType of K end)
            add(m "Let" option kwLetType of K end) add(m "Option" option kwOptionType of K end)
            add(m "Out" option kwOutType of K end) add(m "Rec" option kwRecType of K end)
            add(m "Record" option kwRecordType of K end) add(m "Tuple" option kwTupleType of K end)
            add(m "Var" option kwVarType of K end) add(m "Variant" option kwVariantType of K end)
            (* Value level *)
            add(m "and" option kwAnd of K end) add(m "andif" option kwAndif of K end)
            add(m "array" option kwArray of K end) add(m "as" option kwAs of K end)
            add(m "auto" option kwAuto of K end) add(m "begin" option kwBegin of K end)
            add(m "case" option kwCase of K end) add(m "do" option kwDo of K end)
            add(m "downto" option kwDownto of K end) add(m "else" option kwElse of K end)
            add(m "elsif" option kwElsif of K end) add(m "end" option kwEnd of K end)
            add(m "exception" option kwException of K end) add(m "exit" option kwExit of K end)
            add(m "export" option kwExport of K end) add(m "extent" option kwExtent of K end)
            add(m "external" option kwExternal of K end) add(m "false" option kwFalse of K end)
            add(m "for" option kwFor of K end) add(m "fun" option kwFun of K end)
            add(m "if" option kwIf of K end) add(m "import" option kwImport of K end)
            add(m "inspect" option kwInspect of K end) add(m "interface" option kwInterface of K end)
            add(m "is" option kwIs of K end) add(m "isnot" option kwIsnot of K end)
            add(m "let" option kwLet of K end) add(m "loop" option kwLoop of K end)
            add(m "module" option kwModule of K end) add(m "not" option kwNot of K end)
            add(m "of" option kwOf of K end) add(m "ok" option kwOk of K end)
            add(m "option" option kwOption of K end) add(m "ordinal" option kwOrdinal of K end)
            add(m "orif" option kwOrif of K end) add(m "out" option kwOut of K end)
            add(m "raise" option kwRaise of K end) add(m "rec" option kwRec of K end)
            add(m "record" option kwRecord of K end) add(m "then" option kwThen of K end)
            add(m "true" option kwTrue of K end) add(m "try" option kwTry of K end)
            add(m "tuple" option kwTuple of K end) add(m "unsound" option kwUnsound of K end)
            add(m "upto" option kwUpto of K end) add(m "var" option kwVar of K end)
            add(m "variant" option kwVariant of K end) add(m "when" option kwWhen of K end)
            add(m "while" option kwWhile of K end) add(m "with" option kwWith of K end)
            m
        end

    (* Symbolic operators that are reserved punctuation *)
    let initReservedPunctuation(): Table =
        begin
            let m = newTable()
            add(m ":=" option assign of K end) add(m "::" option colonColon of K end)
            add(m "<:" option subtype of K end) add(m "=" option equal of K end)
            add(m ":" option colon of K end) add(m "?" option question of K end)
            add(m "!" option bang of K end) add(m "@" option at of K end)
            add(m "_" option underscore of K end)
            m
        end

    (* Single-character tokens, which are never part of a symbolic operator *)
    let initDelimiters(): Table =
        begin
            let m = newTable()
            add(m "(" option lparen of K end) add(m ")" option rparen of K end)
            add(m "[" option lbracket of K end) add(m "]" option rbracket of K end)
            add(m "{" option lbrace of K end) add(m "}" option rbrace of K end)
            add(m "," option comma of K end) add(m ";" option semicolon of K end)
            add(m "." option dot of K end)
            m
        end

    let new(sm: location.SourceMap bag: diagbag.T): T =
        begin
            let txt = location.text(sm)
            tuple
                let sm = sm
                let bag = bag
                let file = location.file(sm)
                let text = txt
                let textLen = stringOp.length(txt)
                var cursor = 0
                var peeked = maybe.none(:tokens.Token)
                let keywords = initKeywords()
                let reservedPunc = initReservedPunctuation()
                let delimiters = initDelimiters()
            end
        end

    (* ======================================================================
     * Characters
     * ====================================================================== *)

    let isSymbolicChar(c: Char): Bool = strutil.contains("!#$%&*+-/:<=>?@\\^_`|~" stringOp.new(1 c))

    (* The value of a hexadecimal digit, or ~1 *)
    let hexVal(c: Char): Int =
        begin
            let code = ascii.val(c)
            if {code >= 48} andif {code <= 57} then code - 48
            elsif {code >= 65} andif {code <= 70} then code - 55
            elsif {code >= 97} andif {code <= 102} then code - 87
            else ~1
            end
        end

    (* The character at the cursor plus offset; NUL past the end of the input,
     * which no character test below accepts, so a loop over such a test stops
     * at the end without checking the cursor *)
    let peekChar(tok: T offset: Int): Char =
        if {tok.cursor + offset} < tok.textLen then stringOp.getChar(tok.text {tok.cursor + offset}) else ascii.char(0) end

    let currentChar(tok: T): Char = peekChar(tok 0)

    let advanceChar(tok: T): Char =
        begin
            let c = currentChar(tok)
            if tok.cursor < tok.textLen then tok.cursor := tok.cursor + 1 end
            c
        end

    let skipWhile(tok: T test: All(c: Char) Bool): Ok =
        while test(currentChar(tok)) do tok.cursor := tok.cursor + 1 end

    let atEnd(tok: T): Bool = tok.cursor >= tok.textLen

    let atCommentStart(tok: T): Bool = {currentChar(tok) is '('} andif {peekChar(tok 1) is '*'}

    (* Python's repr of a character, as the bootstrap tokenizer's messages show
     * it *)
    let charRepr(c: Char): String =
        begin
            let code = ascii.val(c)
            let b = stringBuilder.new().char('\'')
            if {code < 32} orif {code >= 127} then
                b.str("\\x").char(stringOp.getChar("0123456789abcdef" {code / 16}))
                    .char(stringOp.getChar("0123456789abcdef" {code % 16}))
            else
                b.char(c)
            end
            b.char('\'').toString()
        end

    (* ======================================================================
     * Tokens
     * ====================================================================== *)

    let error(tok: T start: Int message: String): Ok =
        diagbag.addError(tok.bag location.span(tok.file start tok.cursor) message)

    (* The token from start to the cursor *)
    let finish(tok: T kind: K start: Int value: tokens.TokenValue): tokens.Token =
        tokens.make(
            kind stringOp.getSub(tok.text start {tok.cursor - start}) value location.span(tok.file start tok.cursor)
        )

    let skipWhitespaceAndComments(tok: T): Ok =
        loop
            if strutil.isSpace(currentChar(tok)) orif {currentChar(tok) is ascii.char(11)} orif
                {currentChar(tok) is ascii.char(12)} then
                tok.cursor := tok.cursor + 1
            elsif atCommentStart(tok) then
                (* Nested comments (* ... *) *)
                let start = tok.cursor
                tok.cursor := tok.cursor + 2
                let var depth = 1
                while {depth > 0} andif not(atEnd(tok)) do
                    if atCommentStart(tok) then
                        tok.cursor := tok.cursor + 2
                        depth := depth + 1
                    elsif {currentChar(tok) is '*'} andif {peekChar(tok 1) is ')'} then
                        tok.cursor := tok.cursor + 2
                        depth := depth - 1
                    else
                        tok.cursor := tok.cursor + 1
                    end
                end
                if depth > 0 then
                    error(tok start "Unclosed comment")
                    exit
                end
            else
                exit
            end
        end

    (* The character an escape sequence denotes; the backslash is already
     * consumed *)
    let lexEscapeSequence(tok: T): Char =
        begin
            let start = tok.cursor - 1
            if atEnd(tok) then
                error(tok start "Unterminated escape sequence")
                ascii.char(0)
            else
                let c = advanceChar(tok)
                if c is 'n' then ascii.char(10)
                elsif c is 't' then ascii.char(9)
                elsif c is 'r' then ascii.char(13)
                elsif c is 'b' then ascii.char(8)
                elsif c is 'f' then ascii.char(12)
                elsif {c is '\\'} orif {c is '\''} orif {c is '"'} then c
                elsif c is 'x' then
                    (* \xh or \xhh *)
                    let var digits = 0
                    let var code = 0
                    while {digits < 2} andif {hexVal(currentChar(tok)) >= 0} do
                        code := {code * 16} + hexVal(advanceChar(tok))
                        digits := digits + 1
                    end
                    if digits is 0 then
                        error(tok start "Invalid hexadecimal escape sequence")
                        ascii.char(0)
                    else
                        ascii.char(code)
                    end
                elsif strutil.isDigit(c) then
                    (* \d, \dd, or \ddd *)
                    let var digits = 1
                    let var code = ascii.val(c) - 48
                    while {digits < 3} andif strutil.isDigit(currentChar(tok)) do
                        code := {code * 10} + {ascii.val(advanceChar(tok)) - 48}
                        digits := digits + 1
                    end
                    if code > 255 then
                        error(tok start "Character code " <> conv.int(code) <> " out of byte range")
                        ascii.char(0)
                    else
                        ascii.char(code)
                    end
                else
                    error(tok start "Unknown escape sequence '\\" <> stringOp.new(1 c) <> "'")
                    c
                end
            end
        end

    let lexNumber(tok: T): tokens.Token =
        begin
            let start = tok.cursor
            if currentChar(tok) is '~' then tok.cursor := tok.cursor + 1 end
            skipWhile(tok strutil.isDigit)
            (* A real has a decimal point followed by a digit, and an optional
             * exponent *)
            let isReal = {currentChar(tok) is '.'} andif strutil.isDigit(peekChar(tok 1))
            if isReal then
                tok.cursor := tok.cursor + 1
                skipWhile(tok strutil.isDigit)
                if {currentChar(tok) is 'e'} orif {currentChar(tok) is 'E'} then
                    let expStart = tok.cursor
                    tok.cursor := tok.cursor + 1
                    if {currentChar(tok) is '+'} orif {currentChar(tok) is '-'} orif {currentChar(tok) is '~'} then
                        tok.cursor := tok.cursor + 1
                    end
                    if not(strutil.isDigit(currentChar(tok))) then error(tok expStart "Malformed real exponent") end
                    skipWhile(tok strutil.isDigit)
                end
            end
            let lexeme = stringOp.getSub(tok.text start {tok.cursor - start})
            let norm = strutil.replace(lexeme "~" "-")
            if isReal then
                let r = strutil.tryToReal(norm)
                if maybe.isNone(:Real r) then error(tok start "Invalid real literal '" <> lexeme <> "'") end
                finish(tok option realLit of K end start tokens.valReal(maybe.unwrapOr(:Real r 0.0)))
            else
                let n = strutil.tryToInt(norm)
                (* The lexeme is digits, so it is not an Int only if it is out
                 * of range *)
                if maybe.isNone(:Int n) then error(tok start "Integer literal '" <> lexeme <> "' out of range") end
                finish(tok option intLit of K end start tokens.valInt(maybe.unwrapOr(:Int n 0)))
            end
        end

    let lexChar(tok: T): tokens.Token =
        begin
            let start = tok.cursor
            tok.cursor := tok.cursor + 1 (* Opening quote *)
            if atEnd(tok) orif {currentChar(tok) is '\''} then
                error(tok start "Empty character literal")
                if currentChar(tok) is '\'' then tok.cursor := tok.cursor + 1 end
                finish(tok option charLit of K end start tokens.valChar(ascii.char(0)))
            else
                let value = if currentChar(tok) is '\\' then
                    tok.cursor := tok.cursor + 1
                    lexEscapeSequence(tok)
                else
                    advanceChar(tok)
                end
                if atEnd(tok) orif {currentChar(tok) isnot '\''} then
                    error(tok start "Unterminated character literal")
                else
                    tok.cursor := tok.cursor + 1 (* Closing quote *)
                end
                finish(tok option charLit of K end start tokens.valChar(value))
            end
        end

    let lexString(tok: T): tokens.Token =
        begin
            let start = tok.cursor
            tok.cursor := tok.cursor + 1 (* Opening quote *)
            let b = stringBuilder.new()
            while not(atEnd(tok)) andif {currentChar(tok) isnot '"'} do
                if currentChar(tok) is '\\' then
                    tok.cursor := tok.cursor + 1
                    b.char(lexEscapeSequence(tok))
                else
                    b.char(advanceChar(tok))
                end
            end
            if atEnd(tok) then
                error(tok start "Unterminated string literal")
            else
                tok.cursor := tok.cursor + 1 (* Closing quote *)
            end
            finish(tok option stringLit of K end start tokens.valString(b.toString()))
        end

    (* An identifier, keyword, symbolic operator, or reserved punctuation: the
     * longest run of characters that pass test, looked up in table *)
    let lexWord(tok: T test: All(c: Char) Bool table: Table otherwise: K): tokens.Token =
        begin
            let start = tok.cursor
            skipWhile(tok test)
            let lexeme = stringOp.getSub(tok.text start {tok.cursor - start})
            finish(tok maybe.unwrapOr(:K lookup(table lexeme) otherwise) start tokens.valNone())
        end

    (* A symbolic operator stops before ~ followed by a digit, which starts a
     * negative number *)
    let isOperatorChar(tok: T): All(c: Char) Bool =
        fun(c: Char): Bool isSymbolicChar(c) andif not({c is '~'} andif strutil.isDigit(peekChar(tok 1)))

    let rec readNextToken(tok: T): tokens.Token =
        begin
            skipWhitespaceAndComments(tok)
            if atEnd(tok) then
                tokens.eofToken(tok.file tok.cursor)
            else
                let start = tok.cursor
                let c = currentChar(tok)
                let delimiter = lookup(tok.delimiters stringOp.new(1 c))
                if maybe.isSome(:K delimiter) then
                    tok.cursor := tok.cursor + 1
                    finish(tok maybe.unwrap(:K delimiter) start tokens.valNone())
                elsif strutil.isDigit(c) orif {{c is '~'} andif strutil.isDigit(peekChar(tok 1))} then
                    lexNumber(tok)
                elsif c is '\'' then
                    lexChar(tok)
                elsif c is '"' then
                    lexString(tok)
                elsif strutil.isAlpha(c) then
                    lexWord(tok strutil.isAlnum tok.keywords option ident of K end)
                elsif isSymbolicChar(c) then
                    lexWord(tok isOperatorChar(tok) tok.reservedPunc option symbolicInfix of K end)
                else
                    tok.cursor := tok.cursor + 1
                    error(tok start "Unexpected character " <> charRepr(c))
                    readNextToken(tok)
                end
            end
        end

    (* ======================================================================
     * Streams
     * ====================================================================== *)

    let nextToken(tok: T): tokens.Token =
        if maybe.isSome(:tokens.Token tok.peeked) then
            let t = maybe.unwrap(:tokens.Token tok.peeked)
            tok.peeked := maybe.none(:tokens.Token)
            t
        else
            readNextToken(tok)
        end

    let peekToken(tok: T): tokens.Token =
        begin
            if maybe.isNone(:tokens.Token tok.peeked) then
                tok.peeked := maybe.some(:tokens.Token readNextToken(tok))
            end
            maybe.unwrap(:tokens.Token tok.peeked)
        end

    let tokenizeAll(tok: T): vector.T(tokens.Token) =
        begin
            let v = vector.new(:tokens.Token)
            loop
                let t = nextToken(tok)
                vector.append(:tokens.Token v t)
                case t.kind when eof then exit else ok end
            end
            v
        end

    let formatDump(tokensList: vector.T(tokens.Token) sm: location.SourceMap showValues: Bool): String =
        begin
            let b = stringBuilder.new()
            for i = 0 upto {vector.length(:tokens.Token tokensList) - 1} do
                let t = vector.get(:tokens.Token tokensList i)
                let loc = location.locate(sm t.span.startOffset)
                if i > 0 then b.char('\n') end
                b.int(loc.line).char(':').int(loc.col).char('\t')
                case t.kind
                    when eof then b.str("EOF")
                    else b.str(tokens.tokenKindName(t.kind)).char('\t').str(t.lexeme)
                end
            end
            b.toString()
        end
end
