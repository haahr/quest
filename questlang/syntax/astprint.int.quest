(* Quest Self-Hosted Compiler: Canonical AST Pretty-Printer Interface *)

interface AstPrint
import
    questlang/syntax/ast : questlang/syntax/Ast
export
    (* Format an AST as a canonical 2-space indented S-expression, the same text as the bootstrap compiler's
     * ast_dump (without offsets) prints for the corresponding Python AST *)
    dump(node: ast.Program): String
    dumpPhrase(node: ast.Phrase): String
    dumpExpr(node: ast.Expr): String
    dumpTypeExpr(node: ast.TypeExpr): String
end
