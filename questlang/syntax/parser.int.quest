(* Quest Self-Hosted Compiler: Parser Interface
 *
 * Parses tokens (as tokenizer.tokenizeAll returns them) from a source into the AST, with the grammar of
 * parser/grammar evaluated by parser/engine. A syntax error adds a fatal diagnostic to the bag, worded as the
 * bootstrap words it, and raises diagbag.fatalError. *)

interface Parser
import
    questlang/common/location : questlang/common/Location
    questlang/common/diagbag : questlang/common/DiagBag
    questlang/syntax/tokens : questlang/syntax/Tokens
    questlang/syntax/ast : questlang/syntax/Ast
    collections/vector : collections/Vector
export
    (* A whole program *)
    parseProgram(toks: vector.T(tokens.Token) sm: location.SourceMap bag: diagbag.T): ast.Program

    (* A type, a kind, or a value (an expression) by itself *)
    parseType(toks: vector.T(tokens.Token) sm: location.SourceMap bag: diagbag.T): ast.TypeExpr
    parseKind(toks: vector.T(tokens.Token) sm: location.SourceMap bag: diagbag.T): ast.KindExpr
    parseValue(toks: vector.T(tokens.Token) sm: location.SourceMap bag: diagbag.T): ast.Expr
end
