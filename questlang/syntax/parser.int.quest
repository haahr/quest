(* Quest Self-Hosted Compiler: Parser Interface
 *
 * Parses tokens (as tokenizer.tokenizeAll returns them) from a source into the
 * AST, with the grammar of parser/grammar evaluated by parser/engine. A syntax
 * error adds an error to the bag, worded as the bootstrap words it, and raises
 * diagbag.fatalError. The bootstrap counterpart is parse_quest_program in
 * bootstrap/python/quest/syntax/grammar.py. *)

interface Parser
import
    collections/vector : collections/Vector

    questlang/common/diagbag : questlang/common/DiagBag
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/location : questlang/common/Location
    questlang/syntax/ast : questlang/syntax/AST
    questlang/syntax/tokens : questlang/syntax/Tokens
export
    (* The program sm holds, tokenized and parsed. A tokenizer error stops it
     * before the parse: the error is in the bag, and fatalError is raised
     * with it, as a syntax error is. *)
    parseSource(sm: location.SourceMap bag: diagbag.T): ast.Program
    (* A whole program *)
    parseProgram(toks: vector.T(tokens.Token) sm: location.SourceMap bag: diagbag.T): ast.Program

    (* A type, a kind, or a value (an expression) by itself *)
    parseType(toks: vector.T(tokens.Token) sm: location.SourceMap bag: diagbag.T): ast.TypeExpr
    parseKind(toks: vector.T(tokens.Token) sm: location.SourceMap bag: diagbag.T): ast.KindExpr
    parseValue(toks: vector.T(tokens.Token) sm: location.SourceMap bag: diagbag.T): ast.Expr

    (* Where the parse that reported the syntax error d stopped (engine's
     * stoppedAt): where d is, unless d is located at a construct left open;
     * endOffset is the offset of the input's EOF token *)
    stoppedAt(d: diagnostics.Diagnostic endOffset: Int): Int
end
