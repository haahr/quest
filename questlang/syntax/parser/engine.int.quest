(* Quest Self-Hosted Compiler: PEG / Packrat Parser Engine Interface
 *
 * This interface provides the parsing expression grammar (PEG) engine,
 * mirroring bootstrap/python/quest/syntax/parser.py: grammar constructs,
 * syntax targets and their rules, and a packrat (memoized backtracking)
 * parser that evaluates them over a token stream. The grammar itself is in
 * parser/grammar, and its semantic actions are in parser/actions. *)

interface Engine
import
    collections/vector : collections/Vector

    questlang/common/diagbag : questlang/common/DiagBag
    questlang/common/location : questlang/common/Location
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/syntax/tokens : questlang/syntax/Tokens
export
    (* ======================================================================
     * 1. Semantic Values
     * ====================================================================== *)

    (* Val is the semantic value produced when a construct matches, which rule
     * actions receive and return: absent for an unmatched optional (Python's
     * None); a token; a string; a list for a repetition, separated list, or
     * multi-item sequence; or an AST value. A signature item carries its span,
     * which ast.Signature omits; a postfix operator is a function from its
     * operand to the resulting AST node. *)
    Def Rec Val = Option
        absent
        tok with val: tokens.Token end
        str with val: String end
        list with items: Array(Val) end
        typeExpr with val: ast.TypeExpr end
        expr with val: ast.Expr end
        phrase with val: ast.Phrase end
        program with val: ast.Program end
        sig with val: ast.Signature span: location.Span end
        recordFieldSig with val: ast.RecordFieldSig end
        optionFieldSig with val: ast.OptionFieldSig end
        recordBinding with val: ast.RecordBinding end
        importItem with val: ast.ImportItem end
        caseBranch with val: ast.CaseBranch end
        inspectBranch with val: ast.InspectBranch end
        tryBranch with val: ast.TryBranch end
        typeOp with apply: All(operand: ast.TypeExpr) ast.TypeExpr end
        exprOp with apply: All(operand: ast.Expr) ast.Expr end
    end

    (* Raised by an action given a value of the wrong kind, which is a bug in
     * the grammar *)
    error: Exception(String)

    (* Where a rule matched: from the start of its first token to the end of its
     * last (stop is start if it matched no tokens), and the bag for the errors
     * its action finds *)
    Def Ctx = Tuple file: String start: Int stop: Int bag: diagbag.T end

    (* A rule's action: from the rule's non-silent results to its value *)
    Def Action = All(ctx: Ctx args: Array(Val)) Val

    (* ======================================================================
     * 2. Grammar Constructs
     * ====================================================================== *)

    (* A grammar construct. A silent construct must match, but its result is not
     * passed to the enclosing rule's action or included in the enclosing
     * sequence's result. *)
    Construct::TYPE

    (* The syntax targets of one grammar, which numbers them for the parser's
     * memo *)
    Grammar::TYPE
    newGrammar(): Grammar

    (* A new syntax target (non-terminal) of the grammar, without rules *)
    target(g: Grammar name: String): Construct

    (* rule(t action) of items end adds a rule to target t: the sequence of
     * items and the action applied to their non-silent results. A target tries
     * its rules in order. *)
    rule(t: Construct action: Action): All(items: Array(Construct)) Ok

    (* A token of a kind, optionally with a lexeme; p and pLex are their silent
     * versions (punctuation) *)
    t(kind: tokens.TokenKind): Construct
    tLex(kind: tokens.TokenKind lexeme: String): Construct
    p(kind: tokens.TokenKind): Construct
    pLex(kind: tokens.TokenKind lexeme: String): Construct

    (* Matches [items], yielding their value or absent if they do not match;
     * silent if all items are silent. The value of several items, here and in
     * rep, is the sole non-silent item's value if there is only one, or a list
     * of the non-silent items' values otherwise. *)
    opt(items: Array(Construct)): Construct

    (* {items}: a list of the items' values, for as long as they match; silent
     * if the items are *)
    rep(items: Array(Construct)): Construct

    (* item {separator item}: a list of the items' values (one or more); a
     * trailing separator is not consumed *)
    sepBy(item: Construct separator: Construct): Construct

    (* ======================================================================
     * 3. Parser
     * ====================================================================== *)

    Parser::TYPE

    (* A parser for tokens (as tokenizer.tokenizeAll returns them) from a
     * source, reporting errors to bag *)
    newParser(g: Grammar toks: vector.T(tokens.Token) sm: location.SourceMap bag: diagbag.T): Parser

    (* Parses all tokens using start and returns its semantic value. If parsing
     * fails or tokens remain, adds an error to the bag at the farthest token
     * where any construct failed, naming what was expected there, and raises
     * diagbag.fatalError. *)
    parse(p: Parser start: Construct): Val
end
