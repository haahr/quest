(* Quest Self-Hosted Compiler: What Was Left Open Where a Parse Failed *)

module unclosed : Unclosed
import
    conv : Conv

    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/common/location : questlang/common/Location
    questlang/syntax/tokens : questlang/syntax/Tokens
export
    Let Finding = Tuple tok: tokens.Token message: String note: maybe.T(String) closesNothing: Bool end

    (* An opening bracket's closer, or end for a keyword *)
    let closer(tok: tokens.Token): String =
        if tokens.isOpening(tok.kind) then
            maybe.unwrap(tokens.spelling(maybe.unwrap(tokens.partner(tok.kind))))
        else
            "end"
        end

    let isBracket(tok: tokens.Token): Bool = tokens.isOpening(tok.kind)

    (* An open construct: its opener, the column of the first token of the
     * opener's line, and for option and variant, whether their of is still to
     * come *)
    Let Open = Tuple tok: tokens.Token indent: Int var awaitingOf: Bool end

    let notClosed(e: Open note: maybe.T(String)): maybe.T(Finding) =
        maybe.some(tuple
            let tok = e.tok
            let message = "'" <> e.tok.lexeme <> "' has no matching '" <> closer(e.tok) <> "'"
            let note = note
            let closesNothing = false
        end)

    let nothingToClose(tok: tokens.Token): maybe.T(Finding) =
        maybe.some(tuple
            let tok = tok
            let message = "'" <> tok.lexeme <> "' closes nothing"
            let note = maybe.none(:String)
            let closesNothing = true
        end)

    let find(toks: Array(tokens.Token) sm: location.SourceMap): maybe.T(Finding) =
        begin
            let at = fun(tok: tokens.Token): String
                begin
                    let p = location.locate(sm tok.span.startOffset)
                    conv.int(p.line) <> ":" <> conv.int(p.col)
                end
            let described = fun(tok: tokens.Token): String "the '" <> tok.lexeme <> "' at " <> at(tok)
            let stack = vector.new(:Open)
            let top = fun(): Open vector.last(stack)
            (* The innermost open keyword (not bracket), or the innermost open
             * bracket of a kind, if there is one *)
            let innermost = fun(pred: All(e: Open) Bool): maybe.T(Open)
                begin
                    let var found = maybe.none(:Open)
                    let var i = vector.length(stack) - 1
                    while maybe.isNone(found) andif {i >= 0} do
                        if pred(vector.get(stack i)) then found := maybe.some(vector.get(stack i)) end
                        i := i - 1
                    end
                    found
                end
            let isKeyword = fun(e: Open): Bool not(isBracket(e.tok))
            let var result = maybe.none(:Finding)
            let var indent = 1
            let var previousLine = 0
            (* The tokens walked: all but an EOF token at the end *)
            let n = if {extent toks > 0} andif toks[extent toks - 1].kind?eof then extent toks - 1 else extent toks end
            let var i = 0
            while maybe.isNone(result) andif {i < n} do
                let tok = toks[i]
                let k = tok.kind
                let p = location.locate(sm tok.span.startOffset)
                let startsLine = p.line > previousLine
                previousLine := p.line
                if startsLine then indent := p.col end
                if startsLine andif tokens.startsDeclaration(k) andif not(vector.empty(stack))
                        andif {p.col <= top().indent} then
                    result := notClosed(top() maybe.some(described(tok) <> " starts another declaration"))
                elsif k?kwEnd then
                    let opener = innermost(isKeyword)
                    if maybe.isNone(opener) then
                        result := nothingToClose(tok)
                    elsif isBracket(top().tok) then
                        result := notClosed(top()
                                maybe.some(described(tok) <> " closes " <> described(maybe.unwrap(opener).tok)))
                    else
                        if startsLine andif {p.col isnot top().indent} then
                            let var j = vector.length(stack) - 2
                            while maybe.isNone(result) andif {j >= 0} do
                                let e = vector.get(stack j)
                                if isKeyword(e) andif {e.indent is p.col} then
                                    result := notClosed(top()
                                            maybe.some(described(tok) <> " lines up with " <> described(e.tok)))
                                end
                                j := j - 1
                            end
                        end
                        if maybe.isNone(result) then
                            vector.pop(stack)
                            ok
                        end
                    end
                elsif tokens.isClosing(k) then
                    let opening = maybe.unwrap(tokens.partner(k))
                    let opener = innermost(fun(e: Open): Bool tokens.sameKind(e.tok.kind opening))
                    if maybe.isNone(opener) then
                        result := nothingToClose(tok)
                    elsif not(tokens.sameKind(top().tok.kind opening)) then
                        result := notClosed(top()
                                maybe.some(described(tok) <> " closes " <> described(maybe.unwrap(opener).tok)))
                    else
                        vector.pop(stack)
                        ok
                    end
                elsif isBracket(tok) then
                    vector.append(stack tuple let tok = tok let indent = indent var awaitingOf = false end)
                elsif k?kwOf then
                    if not(vector.empty(stack)) andif top().awaitingOf then
                        top().awaitingOf := false
                    elsif {{i + 1} >= n} orif not(toks[i + 1].kind?lparen) then
                        vector.append(stack tuple let tok = tok let indent = indent var awaitingOf = false end)
                    end
                elsif k?kwWith then
                    if not(vector.empty(stack)) andif top().tok.kind?kwOptionType then
                        vector.append(stack tuple let tok = tok let indent = indent var awaitingOf = false end)
                    end
                elsif tokens.closedByEnd(k) then
                    let awaiting = k?kwOption orif k?kwVariant
                    vector.append(stack tuple let tok = tok let indent = indent var awaitingOf = awaiting end)
                end
                i := i + 1
            end
            if maybe.isNone(result) andif not(vector.empty(stack)) then notClosed(top() maybe.none()) else result end
        end
end
