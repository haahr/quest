(* Quest Self-Hosted Compiler: What Was Left Open Where a Parse Failed *)

module unclosed : Unclosed
import
    conv : Conv
    stringOp = string : StringOp

    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/common/location : questlang/common/Location
    questlang/common/maps : questlang/common/Maps
    questlang/syntax/tokens : questlang/syntax/Tokens
export
    Let Finding = Tuple tok: tokens.Token message: String note: maybe.T(String) closesNothing: Bool end

    Let Set = maps.StringSet

    let setOf(names: String): Set =
        begin
            let s = maps.newStringSet()
            let v = strutil.split(names " ")
            for i = 0 upto {vector.length(v) - 1} do hashSet.insert(s vector.get(v i)) end
            s
        end

    (* The keywords whose construct end closes *)
    let openers = setOf("KW_INTERFACE KW_MODULE KW_TUPLE_TYPE KW_OPTION_TYPE KW_AUTO_TYPE KW_RECORD_TYPE"
        <> " KW_VARIANT_TYPE KW_IF KW_BEGIN KW_LOOP KW_WHILE KW_FOR KW_TUPLE KW_AUTO KW_OPTION KW_RECORD KW_VARIANT"
        <> " KW_CASE KW_INSPECT KW_EXCEPTION KW_RAISE KW_TRY")

    (* The keywords that start a declaration, which cannot continue a
     * construct begun on a line no further left *)
    let declarations = setOf("KW_LET KW_LET_TYPE KW_DEF KW_DEF_KIND KW_INTERFACE KW_MODULE KW_UNSOUND")

    let nameOf(tok: tokens.Token): String = tokens.tokenKindName(tok.kind)
    let isKind(tok: tokens.Token name: String): Bool = stringOp.equal(nameOf(tok) name)

    (* The closing bracket of an opening one, or none for other tokens *)
    let closingOf(name: String): maybe.T(String) =
        if stringOp.equal(name "LPAREN") then maybe.some(")")
        elsif stringOp.equal(name "LBRACKET") then maybe.some("]")
        elsif stringOp.equal(name "LBRACE") then maybe.some("}")
        else maybe.none()
        end

    (* The opening bracket's kind name of a closing one, or none *)
    let openingOf(name: String): maybe.T(String) =
        if stringOp.equal(name "RPAREN") then maybe.some("LPAREN")
        elsif stringOp.equal(name "RBRACKET") then maybe.some("LBRACKET")
        elsif stringOp.equal(name "RBRACE") then maybe.some("LBRACE")
        else maybe.none()
        end

    let isBracket(tok: tokens.Token): Bool = maybe.isSome(closingOf(nameOf(tok)))

    (* An open construct: its opener, the column of the first token of the
     * opener's line, and for option and variant, whether their of is still to
     * come *)
    Let Open = Tuple tok: tokens.Token indent: Int var awaitingOf: Bool end

    let closer(tok: tokens.Token): String = maybe.unwrapOr(closingOf(nameOf(tok)) "end")

    let notClosed(e: Open note: maybe.T(String)): maybe.T(Finding) =
        maybe.some(tuple
            let tok = e.tok
            let message = "'" <> e.tok.lexeme <> "' has no matching '" <> closer(e.tok) <> "'"
            let note = note
            let closesNothing = false
        end)

    let nothingToClose(tok: tokens.Token): maybe.T(Finding) =
        maybe.some(tuple
            let tok = tok
            let message = "'" <> tok.lexeme <> "' closes nothing"
            let note = maybe.none(:String)
            let closesNothing = true
        end)

    let find(toks: Array(tokens.Token) sm: location.SourceMap): maybe.T(Finding) =
        begin
            let at = fun(tok: tokens.Token): String
                begin
                    let p = location.locate(sm tok.span.startOffset)
                    conv.int(p.line) <> ":" <> conv.int(p.col)
                end
            let described = fun(tok: tokens.Token): String "the '" <> tok.lexeme <> "' at " <> at(tok)
            let stack = vector.new(:Open)
            let top = fun(): Open vector.last(stack)
            (* The innermost open keyword (not bracket), or the innermost open
             * bracket of kind name, if there is one *)
            let innermost = fun(pred: All(e: Open) Bool): maybe.T(Open)
                begin
                    let var found = maybe.none(:Open)
                    let var i = vector.length(stack) - 1
                    while maybe.isNone(found) andif {i >= 0} do
                        if pred(vector.get(stack i)) then found := maybe.some(vector.get(stack i)) end
                        i := i - 1
                    end
                    found
                end
            let isKeyword = fun(e: Open): Bool not(isBracket(e.tok))
            let var result = maybe.none(:Finding)
            let var indent = 1
            let var previousLine = 0
            (* The tokens walked: all but an EOF token at the end *)
            let n =
                if {extent toks > 0} andif isKind(toks[extent toks - 1] "EOF") then extent toks - 1 else extent toks end
            let var i = 0
            while maybe.isNone(result) andif {i < n} do
                let tok = toks[i]
                let name = nameOf(tok)
                let p = location.locate(sm tok.span.startOffset)
                let startsLine = p.line > previousLine
                previousLine := p.line
                if startsLine then indent := p.col end
                if startsLine andif hashSet.contains(declarations name) andif not(vector.empty(stack))
                        andif {p.col <= top().indent} then
                    result := notClosed(top() maybe.some(described(tok) <> " starts another declaration"))
                elsif stringOp.equal(name "KW_END") then
                    let opener = innermost(isKeyword)
                    if maybe.isNone(opener) then
                        result := nothingToClose(tok)
                    elsif isBracket(top().tok) then
                        result := notClosed(top()
                                maybe.some(described(tok) <> " closes " <> described(maybe.unwrap(opener).tok)))
                    else
                        if startsLine andif {p.col isnot top().indent} then
                            let var j = vector.length(stack) - 2
                            while maybe.isNone(result) andif {j >= 0} do
                                let e = vector.get(stack j)
                                if isKeyword(e) andif {e.indent is p.col} then
                                    result := notClosed(top()
                                            maybe.some(described(tok) <> " lines up with " <> described(e.tok)))
                                end
                                j := j - 1
                            end
                        end
                        if maybe.isNone(result) then
                            vector.pop(stack)
                            ok
                        end
                    end
                elsif maybe.isSome(openingOf(name)) then
                    let opening = maybe.unwrap(openingOf(name))
                    let opener = innermost(fun(e: Open): Bool isKind(e.tok opening))
                    if maybe.isNone(opener) then
                        result := nothingToClose(tok)
                    elsif not(isKind(top().tok opening)) then
                        result := notClosed(top()
                                maybe.some(described(tok) <> " closes " <> described(maybe.unwrap(opener).tok)))
                    else
                        vector.pop(stack)
                        ok
                    end
                elsif isBracket(tok) then
                    vector.append(stack tuple let tok = tok let indent = indent var awaitingOf = false end)
                elsif stringOp.equal(name "KW_OF") then
                    if not(vector.empty(stack)) andif top().awaitingOf then
                        top().awaitingOf := false
                    elsif {{i + 1} >= n} orif not(isKind(toks[i + 1] "LPAREN")) then
                        vector.append(stack tuple let tok = tok let indent = indent var awaitingOf = false end)
                    end
                elsif stringOp.equal(name "KW_WITH") then
                    if not(vector.empty(stack)) andif isKind(top().tok "KW_OPTION_TYPE") then
                        vector.append(stack tuple let tok = tok let indent = indent var awaitingOf = false end)
                    end
                elsif hashSet.contains(openers name) then
                    let awaiting = stringOp.equal(name "KW_OPTION") orif stringOp.equal(name "KW_VARIANT")
                    vector.append(stack tuple let tok = tok let indent = indent var awaitingOf = awaiting end)
                end
                i := i + 1
            end
            if maybe.isNone(result) andif not(vector.empty(stack)) then notClosed(top() maybe.none()) else result end
        end
end
