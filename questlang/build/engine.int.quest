(* Quest Self-Hosted Compiler: The Build Engine Interface
 *
 * Builds a program by separate compilation (docs/build-process.md); the
 * bootstrap counterpart is bootstrap/python/quest/build/engine.py. Each unit
 * (the main program, or a module it imports directly or transitively) is
 * compiled on its own to C and an object file against the interfaces of the
 * modules it imports, and only units with stale artifacts are recompiled.
 * buildMain compiles the main program, reads the manifest (.qm) it writes to
 * learn which modules it imports, and calls buildModules to bring them up to
 * date via a FIFO queue, queueing the modules each manifest lists. It then
 * verifies that every module implements the interface each importer expects,
 * checks that the module import graph has no cycles, and links the object
 * files in order: extra objects, the main program, and the modules in queue
 * order. Each step is logged (build/logger) to build.log in the build
 * directory, and to standard error when verbose is enabled. *)

interface Engine
import
    pathLib = os/path : os/Path
    util/maybe : util/Maybe

    questlang/build/logger : questlang/build/Logger
    questlang/codegen/choice : questlang/codegen/Choice
    passes = questlang/ir/pipeline : questlang/ir/Pipeline
    questlang/modules/artifacts/manifest : questlang/modules/artifacts/Manifest
    questlang/modules/resolution : questlang/modules/Resolution
export
    (* A build that failed: a cycle, an interface that does not conform, a
     * missing module, or a file that is not a program, with the bootstrap's
     * message *)
    buildError: Exception(String)

    (* Its directories and files are absolute *)
    Def T = Tuple
        buildDir: pathLib.T
        (* Resolves the imports of every unit the build compiles or checks,
         * each once (docs/build-process.md section 2.1) *)
        resolver: resolution.Resolver
        includePaths: Array(pathLib.T)
        extraObjects: Array(pathLib.T)
        logger: logger.T
        nogc: Bool
        (* Maximum number of modules to compile concurrently. When greater than
         * one, each batch runs in a child process of driver, the compiler
         * driver executable (docs/build-process.md section 7.4). *)
        jobs: Int
        driver: String
        (* Selects the backend for each unit. Each manifest records the backend
         * that compiled it, so switching backends marks a unit stale. *)
        backends: choice.T
        (* The driver's --report-inferable mode, or empty when disabled. When
         * non-empty, every unit is recompiled so type checking can find and
         * report inferable type arguments to standard error. *)
        reportInferable: String
    end
    (* What an engine is made from: the driver's options for the build *)
    Def Settings = Tuple
        (* The build directory (.build if none), which new makes *)
        buildDir: maybe.T(String)
        includePaths: Array(String)
        (* Each step is logged to standard error too, not only to build.log *)
        verbose: Bool
        nogc: Bool
        extraObjects: Array(String)
        (* The resolver of the units the build compiles (a new one if none) *)
        resolver: maybe.T(resolution.Resolver)
        (* T's jobs and driver: up to jobs modules compiled at once, in child
         * processes of driver *)
        jobs: Int
        driver: String
        (* The backend of each unit, which also selects each module's variant
         * (the resolver's variantOf is set from it) *)
        backends: choice.T
        reportInferable: String
    end
    (* An engine building with s, its paths made absolute *)
    new(s: Settings): T

    (* A program's import item: its interface path and module paths, as written
     * or else its names and interface name, and its names *)
    Def ImportRef = Tuple interfacePath: String names: Array(String) modulePaths: Array(String) end
    (* The modules a compiled C unit links against, with the interfaces it
     * expects of them: the modules it imports, then those it uses without
     * importing them (implicit, by canonical name and interface name), each
     * resolved from currentDir by the resolver *)
    unitModuleRefs(imports: Array(ImportRef) implicit: Array(passes.ImplicitImport)
            currentDir: maybe.T(String) includePaths: Array(String) programDir: maybe.T(String)
            res: resolution.Resolver)
            : Array(manifest.ImportedModuleRef)

    (* The objects that link the modules importer imports (roots, with the
     * interfaces it expects of them) and the modules they import, after
     * compiling those that are stale: the engine's extra objects first, then
     * one per module in queue order *)
    buildModules(eng: T roots: Array(manifest.ImportedModuleRef) importer: String programDir: maybe.T(String))
            : Array(String)
    (* Builds the program in mainFile and links it to output (else to its
     * artifacts' base in the build directory) *)
    buildMain(eng: T mainFile: String output: maybe.T(String)): Ok
    (* Compiles the program in mainFile into its .main.qm, .main.c, and .main.o
     * in the build directory, without building its modules or linking *)
    compileMain(eng: T mainFile: String): Ok
end
