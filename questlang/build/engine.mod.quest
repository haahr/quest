(* Quest Self-Hosted Compiler: The Build Engine Implementation *)

module engine : Engine
import
    conv : Conv
    raised : Raised
    stringOp = string : StringOp
    system : System
    writer : Writer

    collections/hashMap : collections/HashMap
    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    pathLib = os/path : os/Path
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/build/compilerRunner : questlang/build/CompilerRunner
    questlang/build/logger : questlang/build/Logger
    questlang/build/workers : questlang/build/Workers
    cBackend = questlang/codegen/backend : questlang/codegen/Backend
    questlang/codegen/choice : questlang/codegen/Choice
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/files : questlang/common/Files
    questlang/common/location : questlang/common/Location
    questlang/common/maps : questlang/common/Maps
    questlang/config/abi : questlang/config/ABI
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/opened : questlang/ir/Opened
    passes = questlang/ir/pipeline : questlang/ir/Pipeline
    questlang/modules/artifacts/interfaceCompiler : questlang/modules/artifacts/InterfaceCompiler
    questlang/modules/artifacts/manifest : questlang/modules/artifacts/Manifest
    questlang/modules/artifacts/moduleCompiler : questlang/modules/artifacts/ModuleCompiler
    questlang/modules/elaboration : questlang/modules/Elaboration
    questlang/modules/graph : questlang/modules/Graph
    questlang/modules/inlined : questlang/modules/Inlined
    questlang/modules/paths : questlang/modules/Paths
    questlang/modules/stdlib : questlang/modules/Stdlib
    questlang/modules/units : questlang/modules/Units
    questlang/syntax/ast : questlang/syntax/AST
    questlang/typechecker/application : questlang/typechecker/Application
    questlang/typechecker/typecheck : questlang/typechecker/Typecheck
    questlang/types/env : questlang/types/Env
export
    let buildError: Exception(String) = exception buildError: String end

    (* An engine that builds a program by separate compilation: each unit (a
     * source file: the main program, or a module it imports, directly or
     * through other modules) is compiled on its own to C and to an object
     * file, and only the units whose artifacts are stale are compiled again
     * (docs/build-process.md).
     *
     * A unit is compiled against the interfaces of the modules it imports,
     * not their implementations. So buildMain compiles the main program first
     * (compileMainUnit), and only then learns which modules to build, from
     * the manifest (.qm) that its compilation writes, a record of what it was
     * compiled from and against. buildModules takes them from a FIFO queue: it
     * compiles each module it pops if it is stale, and queues the modules that
     * its manifest lists, each once. For a main.quest that imports
     * counter: Counter, building with -v logs, in part,
     *
     *     POP QUEUE: 'main' (kind=main)
     *     EVAL STALENESS: 'main' -> STALE (missing artifacts in .../build)
     *     COMPILE MAIN: 'main'
     *     ENQUEUE MODULE: 'counter' (from main import)
     *     POP QUEUE: 'counter' (kind=module)
     *     COMPILE MODULE: 'counter'
     *     VERIFY INTERFACE: 'counter' implements 'Counter', satisfies ...
     *     HOST LINK: linking 2 objects into .../main
     *
     * and leaves in the build directory main.main.qm, main.main.c, and
     * main.main.o; counter.qm, counter.mod.c, and counter.o; and the
     * interface's counter.qi and counter.int.h.
     *
     * A unit is stale (unitStaleness) if an artifact is missing or older than
     * the source, if its artifacts were made for another ABI version (another
     * layout of data and calls, which this compiler's code cannot be linked
     * with), if an interface it was compiled against has changed since, or if
     * one of its imports would now find another file
     * (importResolutionChange). Since each module is compiled alone, two
     * checks are made over the whole program: every module's interface
     * conforms to the interface each of its importers expects of it (VERIFY
     * INTERFACE), and no modules import one another in a cycle
     * (detectModuleCycle). Then the objects are linked: the engine's extra
     * objects, the main program's, and the modules', in the order they were
     * queued. *)
    Let T = Tuple
        buildDir: pathLib.T
        resolver: graph.Resolver
        includePaths: Array(pathLib.T)
        extraObjects: Array(pathLib.T)
        logger: logger.T
        nogc: Bool
        compiler: maybe.T(String)
        extraCFlags: Array(String)
        jobs: Int
        driver: String
        backends: choice.T
        reportInferable: String
    end
    Let ImportRef = Tuple interfacePath: String names: Array(String) modulePaths: Array(String) end

    let eq(a: String b: String): Bool = stringOp.equal(a b)
    let fail(A::TYPE message: String): A = raise buildError with message end
    let quoted(s: String): String = "'" <> s <> "'"
    let str(p: pathLib.T): String = pathLib.toString(p)
    let strs(ps: Array(pathLib.T)): Array(String) =
        begin
            let xs = array of(extent ps "")
            for i = 0 upto {extent ps - 1} do xs[i] := str(ps[i]) end
            xs
        end
    (* An absolute path.T for p *)
    let absolutePath(p: String): pathLib.T = pathLib.resolve(pathLib.fromString(p))
    (* Paths as Python prints a list of them *)
    let pyList(xs: Array(String)): String =
        begin
            let parts = vector.new(:String)
            for i = 0 upto {extent xs - 1} do vector.append(parts "PosixPath('" <> xs[i] <> "')") end
            "[" <> strutil.join(", " parts) <> "]"
        end

    let contains(xs: vector.T(String) x: String): Bool =
        begin
            let var found = false
            for i = 0 upto {vector.length(xs) - 1} do if eq(vector.get(xs i) x) then
                found := true
            end end
            found
        end

    let new(buildDir: maybe.T(String) includePaths: Array(String) verbose: Bool nogc: Bool extraObjects: Array(String)
            resolver: maybe.T(graph.Resolver)): T =
        begin
            let dir = absolutePath(maybe.unwrapOr(buildDir ".build"))
            let includes = array of(extent includePaths dir)
            for i = 0 upto {extent includePaths - 1} do includes[i] := absolutePath(includePaths[i]) end
            let objects = array of(extent extraObjects dir)
            for i = 0 upto {extent extraObjects - 1} do objects[i] := absolutePath(extraObjects[i]) end
            let l = logger.new(maybe.some(str(pathLib.child(dir "build.log"))) verbose)
            system.makeDirectory(str(dir))
            tuple
                let buildDir = dir
                let resolver = maybe.unwrapOr(resolver graph.newResolver())
                let includePaths = includes
                let extraObjects = objects
                let logger = l
                let nogc = nogc
                let compiler = maybe.none()
                let extraCFlags = array of :String end
                let jobs = 1
                let driver = ""
                let backends = choice.standard
                let reportInferable = ""
            end
        end

    (* eng with the fields withBackends, parallel, and reportingInferable
     * change replaced *)
    let changed(eng: T jobs: Int driver: String backends: choice.T reportInferable: String): T =
        tuple
            let buildDir = eng.buildDir
            let resolver = eng.resolver
            let includePaths = eng.includePaths
            let extraObjects = eng.extraObjects
            let logger = eng.logger
            let nogc = eng.nogc
            let compiler = eng.compiler
            let extraCFlags = eng.extraCFlags
            let jobs = jobs
            let driver = driver
            let backends = backends
            let reportInferable = reportInferable
        end
    (* Updates eng.resolver to select each module's variant from backends *)
    let withBackends(eng: T backends: choice.T): T =
        begin
            eng.resolver.variantOf := fun(unit: String): String choice.variantFor(backends unit)
            changed(eng eng.jobs eng.driver backends eng.reportInferable)
        end
    let parallel(eng: T jobs: Int driver: String): T = changed(eng jobs driver eng.backends eng.reportInferable)
    let reportingInferable(eng: T mode: String): T = changed(eng eng.jobs eng.driver eng.backends mode)

    let log(eng: T tag: String message: String): Ok = logger.log(eng.logger tag message)

    (* What compiling each of the program's modules depends on, here or in a
     * worker: search is searchPaths(eng), and programDir names the units under
     * no include root *)
    let settings(eng: T search: Array(String) programDir: maybe.T(String)): moduleCompiler.Settings =
        tuple
            let includePaths = search
            let compiler = eng.compiler
            let nogc = eng.nogc
            let extraFlags = eng.extraCFlags
            let buildDir = maybe.some(str(eng.buildDir))
            let programDir = programDir
            let backends = eng.backends
            let reportInferable = eng.reportInferable
        end

    (* The include paths of the units the engine compiles: the build directory,
     * the extra objects' directories, the include paths, lib/, and the project
     * directory. The program's directory is not one of them: it is searched
     * only from the main routine, and names only units under no include root
     * (docs/modules.md section 2.3). *)
    let searchPaths(eng: T): Array(String) =
        begin
            let dirs = vector.new(:String)
            let add = fun(d: String): Ok if not(contains(dirs d)) then vector.append(dirs d) end
            add(str(eng.buildDir))
            for i = 0 upto {extent eng.extraObjects - 1} do add(str(pathLib.parent(eng.extraObjects[i]))) end
            for i = 0 upto {extent eng.includePaths - 1} do add(str(eng.includePaths[i])) end
            if system.isDirectory(paths.libDir()) then add(files.absolute(paths.libDir())) end
            if system.isDirectory(paths.projectDir()) then add(files.absolute(paths.projectDir())) end
            vector.toArray(dirs)
        end

    (* Where a main routine's artifacts go: build/<dir>/<stem>, <dir> being its
     * directory relative to the current directory, if it is inside it
     * (docs/build-process.md section 3.2) *)
    let mainArtifactBase(eng: T mainFile: String): String =
        begin
            let main = absolutePath(mainFile)
            let rel = files.relativeTo(str(pathLib.parent(main)) files.absolute(system.currentDirectory()))
            let dir =
                if maybe.isSome(rel) andif {stringOp.length(maybe.unwrap(rel)) > 0} then
                    pathLib.child(eng.buildDir maybe.unwrap(rel))
                else
                    eng.buildDir
                end
            str(pathLib.child(dir files.stem(str(main))))
        end

    (* A main routine's .main.qm, .main.c, and .main.o: the .main suffix keeps
     * them apart from a module's with the same canonical name *)
    let mainArtifacts(eng: T mainFile: String): graph.ModuleArtifacts =
        begin
            let base = mainArtifactBase(eng mainFile)
            tuple let qm = base <> ".main.qm" let c = base <> ".main.c" let o = base <> ".main.o" end
        end

    let unitModuleRefs(imports: Array(ImportRef) implicit: Array(passes.ImplicitImport) currentDir: maybe.T(String)
            includePaths: Array(String) programDir: maybe.T(String) res: graph.Resolver):
            Array(manifest.ImportedModuleRef) =
        begin
            let roots = graph.rootsOf(includePaths programDir)
            let refs = vector.new(:manifest.ImportedModuleRef)
            let seen = vector.new(:String)
            let add = fun(name: String interfaceName: String source: maybe.T(String) path: String): Ok
                if not(contains(seen name)) then
                    vector.append(seen name)
                    vector.append(refs tuple
                        let name = name
                        let interfaceName = interfaceName
                        let source = maybe.unwrapOr(source "")
                        let path = path
                    end)
                end
            for i = 0 upto {extent imports - 1} do
                let it = imports[i]
                let iface = graph.interfaceName(graph.resolveInterface(res it.interfacePath currentDir roots))
                let n = if extent it.names < extent it.modulePaths then extent it.names else extent it.modulePaths end
                for j = 0 upto {n - 1} do
                    let modRef = if stringOp.length(it.modulePaths[j]) > 0 then it.modulePaths[j] else it.names[j] end
                    let m = graph.resolveModule(res modRef currentDir roots)
                    add(graph.canonicalName(m) iface m.source modRef)
                end
            end
            for i = 0 upto {extent implicit - 1} do
                let m = graph.resolveModule(res implicit[i].canonicalPath currentDir roots)
                let iface =
                    if stringOp.length(implicit[i].interfacePath) > 0 then
                        graph.interfaceName(graph.resolveInterface(res implicit[i].interfacePath currentDir roots))
                    else
                        ""
                    end
                add(graph.canonicalName(m) iface m.source implicit[i].canonicalPath)
            end
            vector.toArray(refs)
        end

    let orNoSource(s: String): String = if stringOp.length(s) > 0 then s else "no source" end

    (* Returns a description of the first recorded import in m that now
     * resolves to a different source file or canonical name, or none if all
     * still match. Transitive interface imports are re-resolved from the
     * importing interface's recorded directory. *)
    let importResolutionChange(m: manifest.ModuleManifest currentDir: maybe.T(String) includePaths: Array(String)
            programDir: maybe.T(String) res: graph.Resolver): maybe.T(String) =
        begin
            let roots = graph.rootsOf(includePaths programDir)
            let var change = maybe.none(:String)
            for i = 0 upto {extent m.importedInterfaces - 1} do
                let iface = m.importedInterfaces[i]
                if maybe.isNone(change) andif {stringOp.length(iface.path) > 0} then
                    let from = if stringOp.length(iface.dir) > 0 then maybe.some(iface.dir) else currentDir end
                    let found = graph.resolveInterface(res iface.path from roots)
                    if not(paths.sameSource(found.source iface.source)) then
                        change := maybe.some("interface " <> quoted(iface.path) <> " now resolves to "
                            <> orNoSource(maybe.unwrapOr(found.source "")) <> ", not "
                            <> orNoSource(iface.source))
                    elsif not(eq(graph.interfaceName(found) iface.name)) then
                        change := maybe.some("interface " <> quoted(iface.path) <> " is now named "
                            <> quoted(graph.interfaceName(found)) <> ", not " <> quoted(iface.name))
                    end
                end
            end
            for i = 0 upto {extent m.importedModules - 1} do
                let mod = m.importedModules[i]
                if maybe.isNone(change) andif {stringOp.length(mod.path) > 0} then
                    let found = graph.resolveModule(res mod.path currentDir roots)
                    if not(paths.sameSource(found.source mod.source)) then
                        change := maybe.some("module " <> quoted(mod.path) <> " now resolves to "
                            <> orNoSource(maybe.unwrapOr(found.source "")) <> ", not "
                            <> orNoSource(mod.source))
                    elsif not(eq(graph.canonicalName(found) mod.name)) then
                        change := maybe.some("module " <> quoted(mod.path) <> " is now named "
                            <> quoted(graph.canonicalName(found)) <> ", not " <> quoted(mod.name))
                    end
                end
            end
            change
        end

    (* Returns why a unit with a source file is stale, or none if up to date
     * (docs/build-process.md section 7.1). Checks artifact freshness, backend
     * match, WebAssembly runtime compatibility, and whether imports still
     * resolve to the same files. *)
    let artifactStaleness(eng: T source: String a: graph.ModuleArtifacts programDir: maybe.T(String)): maybe.T(String) =
        begin
            let search = searchPaths(eng)
            (* Checks for backend, WebAssembly runtime, or import-resolution
             * changes *)
            let changed = fun(m: manifest.ModuleManifest): maybe.T(String)
                begin
                    let name = if eq(m.name "<main>") then choice.programUnit else m.name end
                    let library = strutil.startsWith(files.absolute(source) files.join(paths.projectDir() "lib") <> "/")
                    if not(eq(m.backend choice.forFile(eng.backends name library))) then
                        maybe.some("compiled by the " <> m.backend <> " backend")
                    elsif choice.isWasm(m.backend) andif system.isFile(choice.codeFile(a.c m.backend))
                            andif not(eq(cBackend.objectRuntimeStamp(maybe.unwrapOr(files.readText(choice.codeFile(a.c
                                    m.backend))
                                    ""))
                                    cBackend.runtimeStamp())) then
                        (* Reject a WebAssembly object built against a
                         * different runtime's types, which instantiation would
                         * fail on *)
                        maybe.some("built against another wasm runtime")
                    else
                        importResolutionChange(m maybe.some(files.parent(source)) search programDir eng.resolver)
                    end
                end
            (* Its code file is the one its recorded backend wrote *)
            let recorded =
                if system.isFile(a.qm) then manifest.readQm(a.qm) else maybe.none(:manifest.ModuleManifest) end
            let code =
                if maybe.isSome(recorded) then
                    choice.codeFile(a.c maybe.unwrap(recorded).backend)
                else
                    a.c
                end
            manifest.unitStaleness(source a.qm code a.o
                    maybe.some(changed))
        end

    (* Why a unit is stale: artifactStaleness's reason, or, when the build
     * reports inferable type arguments, which only checking the unit finds,
     * that *)
    let unitStaleness(eng: T source: String a: graph.ModuleArtifacts programDir: maybe.T(String)): maybe.T(String) =
        if stringOp.length(eng.reportInferable) > 0 then maybe.some("reporting inferable type arguments")
        else artifactStaleness(eng source a programDir)
        end

    (* Compiles a main routine into its .main.qm, .main.c, and .main.o,
     * returning the modules it imports *)
    let compileMainUnit(eng: T mainFile: String): Array(manifest.ImportedModuleRef) =
        begin
            let a = mainArtifacts(eng mainFile)
            system.makeDirectory(files.parent(a.c))
            let text = maybe.unwrapOr(files.readText(mainFile) "")
            let sm = location.newSourceMap(files.displayName(mainFile) text)
            (* Install the module system's callbacks before loading the
             * program's interfaces *)
            stdlib.install()
            typecheck.install()
            let e = env.forProgram(location.file(sm) files.parent(mainFile))
            e.reportInferable := eng.reportInferable
            env.withUnitSource(e location.file(sm) fun():
                    Array(manifest.ImportedModuleRef)
                begin
                    let prog = units.parseUnit(sm)
                    for i = 0 upto {vector.length(prog.form.phrases) - 1} do
                        case vector.get(prog.form.phrases i).form
                            when phraseModule, phraseInterface then fail(:Ok "File " <> quoted(mainFile)
                                <> " contains a module/interface declaration; use module compiler for libraries.")
                            else ok
                        end
                    end
                    let search = searchPaths(eng)
                    e.units := graph.newGraphWith(eng.resolver)
                    for i = 0 upto {extent search - 1} do vector.append(e.includePaths search[i]) end
                    (* Compiled to C, with the build directory's artifacts *)
                    e.compilingC := true
                    e.buildDir := maybe.some(str(eng.buildDir))

                    let interfaces = vector.new(:manifest.ImportedInterfaceRef)
                    let imports = vector.new(:ImportRef)
                    for i = 0 upto {vector.length(prog.form.phrases) - 1} do
                        case vector.get(prog.form.phrases i).form
                            when phraseImport with x then
                                for j = 0 upto {vector.length(x.phrase.items) - 1} do
                                    let it = vector.get(x.phrase.items j)
                                    let ifacePath = maybe.unwrapOr(it.interfacePath it.interfaceName)
                                    log(eng "RESOLVE INTERFACE" quoted(ifacePath))
                                    if maybe.isNone(env.lookupInterface(e ifacePath))
                                            andif maybe.isNone(env.lookupInterface(e it.interfaceName)) then
                                        elaboration.loadInterface(ifacePath e)
                                        ok
                                    end
                                    vector.append(interfaces
                                            moduleCompiler.interfaceRef(env.resolveInterface(e ifacePath) ifacePath))
                                    vector.append(imports tuple
                                        let interfacePath = ifacePath
                                        let names = vector.toArray(it.names)
                                        let modulePaths = vector.toArray(ast.effectiveModulePaths(it))
                                    end)
                                end
                            else ok
                        end
                    end

                    let result = typecheck.elaborateProgram(prog e)
                    application.reportInferable(e sm)
                    (* The first error, as the bootstrap raises it *)
                    if extent result.errors > 0 then diagnostics.raiseError(:Ok result.errors[0]) end
                    let typed = maybe.unwrap(result.program)
                    let backend = choice.forUnit(eng.backends choice.programUnit)
                    (* The backend's and the IR passes' failures become the
                     * unit's error, as moduleCompiler makes them *)
                    let translated =
                        try cBackend.programToC(typed e maybe.some(sm) false false backend)
                        when cBackend.unsupported with m then
                            diagnostics.fail(:Tuple c: String unit: nodes.Unit end m 0)
                        when nodes.irError with m then diagnostics.fail(:Tuple c: String unit: nodes.Unit end m 0)
                        end
                    let modules = unitModuleRefs(vector.toArray(imports)
                            passes.implicitImports(translated.unit typed) e.currentDir
                            vector.toArray(e.includePaths)
                            e.programDir eng.resolver)

                    let code = choice.codeFile(a.c backend)
                    log(eng "EMIT C" code)
                    let w = writer.file(code)
                    writer.putString(w translated.c)
                    writer.close(w)
                    log(eng "HOST COMPILE" "clang -c " <> code <> " -o " <> a.o)
                    compilerRunner.compileCToObject(code a.o search eng.nogc eng.compiler
                            vector.toArray(vector.concat(vector.fromArray(eng.extraCFlags)
                                    vector.fromArray(cBackend.cFlags(backend)))))

                    let direct = vector.toArray(interfaces)
                    let indirect = interfaceCompiler.indirectInterfaceRefs(direct vector.toArray(e.includePaths)
                            e.programDir eng.resolver)
                    log(eng "WRITE QM" a.qm)
                    manifest.writeQm(manifest.newManifest("<main>" maybe.none(:String) files.absolute(mainFile)
                            files.absolute(a.o) modules
                            vector.toArray(vector.concat(interfaces vector.fromArray(indirect))) backend inlined.names()
                            opened.lastOpenedSources()) a.qm)
                    modules
                end)
        end

    (* The canonical module name a .qm records, if it can be read *)
    let manifestName(qm: String): maybe.T(String) =
        begin
            let m = manifest.readQm(qm)
            if maybe.isSome(m) then
                maybe.some(maybe.unwrap(m).name)
            else
                maybe.none()
            end
        end

    (* An importer's expectation of a module's interface *)
    Let Expected = Tuple importer: String interfaceName: String end
    Let Edges = Tuple node: String neighbors: Array(String) end

    let conformanceError(importer: String name: String expected: String actual: String): String =
        "Type error: " <> quoted(importer) <> " imports module " <> quoted(name) <> " as interface " <> quoted(expected)
            <> ", but module " <> quoted(name) <> " implements interface " <> quoted(actual)

    (* A cycle in the modules' import graph, if there is one, found by
     * depth-first search: the path from the module that starts it back to
     * that module. A node listed twice has its last list of neighbors. *)
    let detectModuleCycle(g: vector.T(Edges)): maybe.T(Array(String)) =
        begin
            let visited = maps.newStringSet()
            let stack = vector.new(:String)
            let onStack = maps.newStringSet()
            let edges = maps.newStringMap(:Array(String))
            for i = 0 upto {vector.length(g) - 1} do
                hashMap.insert(edges vector.get(g i).node vector.get(g i).neighbors)
            end
            let neighbors = fun(node: String): Array(String)
                maybe.unwrapOr(hashMap.get(edges node) array of :String end)
            let rec dfs(node: String): maybe.T(Array(String)) =
                begin
                    hashSet.insert(visited node)
                    vector.append(stack node)
                    hashSet.insert(onStack node)
                    let var cycle = maybe.none(:Array(String))
                    let next = neighbors(node)
                    for i = 0 upto {extent next - 1} do
                        if maybe.isNone(cycle) then
                            if not(hashSet.contains(visited next[i])) then
                                cycle := dfs(next[i])
                            elsif hashSet.contains(onStack next[i]) then
                                let path = vector.new(:String)
                                let var on = false
                                for j = 0 upto {vector.length(stack) - 1} do
                                    if eq(vector.get(stack j) next[i]) then on := true end
                                    if on then vector.append(path vector.get(stack j)) end
                                end
                                vector.append(path next[i])
                                cycle := maybe.some(vector.toArray(path))
                            end
                        end
                    end
                    if maybe.isNone(cycle) then
                        hashSet.delete(onStack vector.pop(stack))
                        ok
                    end
                    cycle
                end
            let var cycle = maybe.none(:Array(String))
            for i = 0 upto {vector.length(g) - 1} do
                let node = vector.get(g i).node
                if maybe.isNone(cycle) andif not(hashSet.contains(visited node)) then cycle := dfs(node) end
            end
            cycle
        end

    (* A module a wave of the queue popped (unflushedBuildModules), with the
     * log entries popping it made *)
    Let Note = Tuple tag: String message: String end
    Let Popped = Tuple
        item: String
        src: maybe.T(String)
        targetDir: String
        a: graph.ModuleArtifacts
        stale: Bool
        notes: vector.T(Note)
        failure: maybe.T(All() Ok)
    end

    (* Compiles the stale modules in wave concurrently using child processes of
     * eng.driver when eng.jobs > 1 and at least two modules are stale. Returns
     * an outcome at each compiled module's index and none for the rest, which
     * the parent compiles in-process when their turn arrives. *)
    let compileWave(eng: T wave: Array(Popped) search: Array(String) programDir: maybe.T(String))
            : Array(maybe.T(workers.Outcome)) =
        begin
            let outcomes = array of(extent wave maybe.none(:workers.Outcome))
            let indexes = vector.new(:Int)
            for i = 0 upto {extent wave - 1} do
                if wave[i].stale andif maybe.isNone(wave[i].failure) then vector.append(indexes i) end
            end
            let n = vector.length(indexes)
            if {eng.jobs > 1} andif {n > 1} then
                let shared = settings(eng search programDir)
                let jobOf = fun(p: Popped): workers.Job
                    tuple let source = maybe.unwrap(p.src) let targetDir = p.targetDir let settings = shared end
                let jobs = array of(n jobOf(wave[vector.get(indexes 0)]))
                for k = 1 upto {n - 1} do jobs[k] := jobOf(wave[vector.get(indexes k)]) end
                let results = workers.compileAll(jobs eng.jobs eng.driver)
                for k = 0 upto {n - 1} do
                    outcomes[vector.get(indexes k)] := maybe.some(results[k])
                end
            end
            outcomes
        end

    (* Brings up to date every module that the unit importer imports, directly
     * (roots, each with the interface importer expects of it) or
     * transitively, and returns the object files to link: eng.extraObjects
     * first, then each module's .o in the order the queue reached it.
     * programDir is the program's directory, which names modules under no
     * search root. The bootstrap counterpart is BuildEngine.build_modules in
     * bootstrap/python/quest/build/engine.py (docs/build-process.md section
     * 7.1).
     *
     * It goes in phases:
     *
     *   1. Queue roots. A FIFO queue holds module names, each queued once.
     *   2. In waves, pop the queued modules (pop): find each one's source and
     *      artifacts, and decide whether they are stale. With eng.jobs > 1 a
     *      wave also pops the modules those are predicted to import, and
     *      compiles its stale modules in parallel child processes
     *      (compileWave, section 7.4).
     *   3. Follow the queue in order, as a serial build would: write each
     *      module's log entries, compile it here if it is stale and no child
     *      did, read its manifest (.qm), check the interface it implements
     *      against what its importers expect (section 6.3), and queue its
     *      imports.
     *   4. When the queue is empty, check every expected interface again,
     *      across all modules, and look for a cycle among the modules' imports
     *      (section 8.2).
     *
     * Raises buildError (or the error a compilation raised) for a module that
     * cannot be found, fails to compile, implements the wrong interface, or
     * is part of a cycle. Unflushed: the build log's entries are batched in
     * eng.logger and not written here; buildModules and buildMain call this
     * through flushingLog, which writes them out even if it raises. *)
    let unflushedBuildModules(eng: T roots: Array(manifest.ImportedModuleRef) importer: String
            programDir: maybe.T(String)): Array(String) =
        begin
            (* The queue and what the build has learned: the modules
             * discovered (by name and lowercased name), the sources importers
             * recorded for them, the objects to link, the import graph, the
             * interfaces importers expect, and the manifests read *)
            let search = searchPaths(eng)
            let queue = vector.new(:String)
            let var head = 0
            let discovered = maps.newStringSet()
            let isDiscovered(name: String): Bool = hashSet.contains(discovered name)
            let discover(name: String): Ok = begin hashSet.insert(discovered name) ok end
            (* The first source an importer recorded for each module *)
            let sources = maps.newStringMap(:String)
            let recordSource(name: String file: String): Ok =
                if not(hashMap.contains(sources name)) then
                    begin hashMap.insert(sources name file) ok end
                end
            let linked = vector.fromArray(strs(eng.extraObjects))
            let isLinked = maps.newStringSet()
            for i = 0 upto {vector.length(linked) - 1} do hashSet.insert(isLinked vector.get(linked i)) end
            for i = 0 upto {extent eng.extraObjects - 1} do
                discover(files.stem(str(eng.extraObjects[i])))
                discover(paths.lower(files.stem(str(eng.extraObjects[i]))))
            end
            let moduleGraph = vector.new(:Edges)
            (* The interfaces expected of each module, and the modules in the
             * order first expected, which they are checked again in *)
            let expected = maps.newStringMap(:vector.T(Expected))
            let expectedNames = vector.new(:String)
            let manifests = maps.newStringMap(:manifest.ModuleManifest)

            let manifestOf = fun(name: String): maybe.T(manifest.ModuleManifest)
                hashMap.get(manifests name)
            let setManifest = fun(name: String m: manifest.ModuleManifest): Ok
                begin hashMap.insert(manifests name m) ok end
            let expectedOf = fun(name: String): vector.T(Expected)
                begin
                    let found = hashMap.get(expected name)
                    if maybe.isSome(found) then
                        maybe.unwrap(found)
                    else
                        let fresh = vector.new(:Expected)
                        hashMap.insert(expected name fresh)
                        vector.append(expectedNames name)
                        fresh
                    end
                end

            let recordExpectedInterface = fun(importer: String name: String iface: String): Ok
                if stringOp.length(iface) > 0 then
                    (* Modules are keyed by their canonical names, ignoring case
                     * as mangling does (docs/modules.md section 2.3) *)
                    let norm = paths.lower(name)
                    vector.append(expectedOf(norm) tuple
                        let importer = importer
                        let interfaceName = iface
                    end)
                    let existing = manifestOf(norm)
                    if maybe.isSome(existing)
                            andif maybe.isSome(maybe.unwrap(existing).interfaceName) then
                        let actual = maybe.unwrap(maybe.unwrap(existing).interfaceName)
                        if not(eq(actual iface)) then fail(:Ok conformanceError(importer name iface actual)) end
                        log(eng "VERIFY INTERFACE" quoted(name) <> " implements " <> quoted(actual) <> ", satisfies "
                            <> quoted(iface) <> " (from " <> importer <> ")")
                    end
                end
            let verifyModuleInterface = fun(key: String actual: maybe.T(String)): Ok
                if maybe.isSome(actual) andif {stringOp.length(maybe.unwrap(actual)) > 0} then
                    let iface = maybe.unwrap(actual)
                    let reqs = expectedOf(key)
                    for i = 0 upto {vector.length(reqs) - 1} do
                        let r = vector.get(reqs i)
                        if not(eq(iface r.interfaceName)) then
                            fail(:Ok conformanceError(r.importer key r.interfaceName iface))
                        end
                        log(eng "VERIFY INTERFACE" quoted(key) <> " implements " <> quoted(iface) <> ", satisfies "
                            <> quoted(r.interfaceName) <> " (from " <> r.importer <> ")")
                    end
                end
            let enqueueImports = fun(name: String imported: Array(manifest.ImportedModuleRef)): Ok
                for i = 0 upto {extent imported - 1} do
                    let dep = imported[i]
                    recordExpectedInterface(name dep.name dep.interfaceName)
                    let norm = paths.lower(dep.name)
                    if not(isDiscovered(dep.name)) andif not(isDiscovered(norm)) then
                        if stringOp.length(dep.source) > 0 then recordSource(dep.name dep.source) end
                        discover(dep.name)
                        discover(norm)
                        log(eng "ENQUEUE MODULE" quoted(dep.name) <> " (from " <> name <> " import)")
                        vector.append(queue dep.name)
                    end
                end
            let recordedSource = fun(name: String): maybe.T(String) hashMap.get(sources name)

            enqueueImports(importer roots)

            (* Pops item, as a serial build does: where its artifacts are,
             * and whether they are stale. What it logs is kept with it, and
             * an error it raises is kept to be raised again (failure), for
             * when its turn comes (below). *)
            let pop = fun(item: String notes: vector.T(Note)): Popped
                begin
                    let note = fun(tag: String message: String): Ok
                        vector.append(notes tuple let tag = tag let message = message end)
                    note("POP QUEUE" quoted(item) <> " (kind=module)")

                    (* The importer records the source it found; a manifest
                     * without one names its modules only by their canonical
                     * names *)
                    let recorded = recordedSource(item)
                    let found =
                        if maybe.isSome(recorded)
                                andif system.isFile(maybe.unwrap(recorded)) then
                            recorded
                        else
                            paths.findCanonicalModuleSource(item search programDir)
                        end
                    let canon =
                        if maybe.isSome(found) then
                            graph.canonicalName(graph.resolveFile(eng.resolver maybe.unwrap(found)
                                    graph.rootsOf(search programDir)))
                        else
                            paths.lower(item)
                        end
                    (* Resolve the active build variant for this module
                     * (docs/build-process.md section 6.4), overriding whatever
                     * file path the importer recorded *)
                    let src =
                        if maybe.isSome(found) then
                            maybe.some(paths.chooseVariant(maybe.unwrap(found) eng.resolver.variantOf(canon)))
                        else
                            found
                        end
                    let targetDir = graph.unitArtifactDir(str(eng.buildDir) canon)
                    system.makeDirectory(targetDir)
                    let artifactStem = graph.artifactStem(canon)
                    let var a = graph.moduleArtifacts(str(eng.buildDir) canon)
                    let var reason = maybe.none(:String)
                    if maybe.isNone(src) then
                        (* A binary distribution: a prebuilt object (and .qm)
                         * without source is up to date *)
                        let var foundObject = maybe.none(:String)
                        for i = 0 upto {extent eng.extraObjects - 1} do
                            let s = paths.lower(files.stem(str(eng.extraObjects[i])))
                            if maybe.isNone(foundObject)
                                    andif {eq(s artifactStem) orif eq(s paths.lower(item))} then
                                foundObject := maybe.some(str(eng.extraObjects[i]))
                            end
                        end
                        if maybe.isNone(foundObject) then
                            foundObject := paths.resolveObjectFile(item programDir search)
                        end
                        if maybe.isSome(foundObject) andif system.isFile(maybe.unwrap(foundObject)) then
                            let o = maybe.unwrap(foundObject)
                            let dir = stringOp.getSub(o 0 {stringOp.length(o) - stringOp.length(files.baseName(o))})
                            let qmCandidate = dir <> files.stem(o) <> ".qm"
                            a := tuple
                                let qm = if system.isFile(qmCandidate) then qmCandidate else a.qm end
                                let c = a.c
                                let o = o
                            end
                            if system.isFile(qmCandidate) andif not(abi.hasCurrentAbi(qmCandidate)) then
                                fail(:Ok abi.incompatibleArtifactMessage(qmCandidate))
                            end
                        elsif not(system.isFile(a.qm) andif system.isFile(a.o)) then
                            fail(:Ok "Undefined module " <> quoted(item)
                                <> ": cannot find source file or precompiled object in "
                                <> pyList(search))
                        end
                    else
                        reason := unitStaleness(eng maybe.unwrap(src) a programDir)
                        if maybe.isSome(reason) then
                            (* Fresh artifacts next to the source (from a
                             * standalone compilation) are used like those in
                             * the build directory (docs/build-process.md
                             * section 5.2) *)
                            let beside = graph.artifactsIn(files.parent(maybe.unwrap(src)) artifactStem)
                            if not(eq(beside.qm a.qm))
                                    andif maybe.isNone(unitStaleness(eng maybe.unwrap(src) beside programDir))
                                    andif eq(maybe.unwrapOr(manifestName(beside.qm) "") canon)
                                    andif maybe.isSome(manifestName(beside.qm)) then
                                a := beside
                                reason := maybe.none()
                            end
                        end
                    end

                    if maybe.isSome(reason) then
                        note("EVAL STALENESS" quoted(item) <> " -> STALE (" <> maybe.unwrap(reason) <> ")")
                        note("COMPILE MODULE" quoted(item))
                    else
                        note("EVAL STALENESS" quoted(item) <> " -> UP TO DATE")
                    end
                    tuple
                        let item = item
                        let src = src
                        let targetDir = targetDir
                        let a = a
                        let stale = maybe.isSome(reason)
                        let notes = notes
                        let failure = maybe.none()
                    end
                end
            let popped = fun(item: String): Popped
                begin
                    let notes = vector.new(:Note)
                    let failed = fun(failure: All() Ok): Popped
                        tuple
                            let item = item
                            let src = maybe.none()
                            let targetDir = ""
                            let a = tuple let qm = "" let c = "" let o = "" end
                            let stale = false
                            let notes = notes
                            let failure = maybe.some(failure)
                        end
                    try
                        pop(item notes)
                    when buildError with m then
                        failed(fun(): Ok fail(m))
                    when diagnostics.compilerError with err then
                        failed(fun(): Ok diagnostics.raiseError(err))
                    end
                end

            (* The queue is taken a wave at a time (docs/build-process.md
             * section 7.4). A wave pops the modules queued and not yet
             * popped, and, with eng.jobs above 1, those it predicts they will
             * queue: the modules each one's source (or, if it is up to date,
             * its manifest) imports, which their manifests will list. It
             * compiles the stale ones, in up to eng.jobs child processes at
             * once. Then the queue is followed as a serial build follows it,
             * each module in turn writing the log entries popping it made,
             * reading its manifest, and queueing what it imports, until it
             * reaches a module the wave did not pop. The queue grows in a
             * serial build's order, and the log has its entries in its
             * order. *)
            let prepared = vector.new(:Popped)
            let outcomes = vector.new(:maybe.T(workers.Outcome))
            (* Each module's index in prepared, where it is popped once *)
            let preparedAt = maps.newStringMap(:Int)
            let preparedIndex = fun(item: String): Int maybe.unwrapOr(hashMap.get(preparedAt item) ~1)
            let preparedOf = fun(item: String): maybe.T(Popped)
                begin
                    let i = preparedIndex(item)
                    if i < 0 then maybe.none() else maybe.some(vector.get(prepared i)) end
                end
            let outcomeOf = fun(item: String): maybe.T(workers.Outcome)
                vector.get(outcomes preparedIndex(item))
            let roots = graph.rootsOf(search programDir)
            (* Predicts the modules a popped module's manifest will list before
             * it is compiled, using its existing manifest if up to date or
             * parsing its top-level imports if stale. Implicit imports added
             * during code generation are discovered when its turn comes. *)
            let predictedImports = fun(p: Popped): Array(manifest.ImportedModuleRef)
                if maybe.isSome(p.failure) orif maybe.isNone(p.src) then
                    array of :manifest.ImportedModuleRef end
                elsif not(p.stale) then
                    let m = if system.isFile(p.a.qm) then manifest.readQm(p.a.qm)
                        else maybe.none(:manifest.ModuleManifest) end
                    if maybe.isSome(m) then
                        maybe.unwrap(m).importedModules
                    else
                        array of :manifest.ImportedModuleRef end
                    end
                else
                    let src = maybe.unwrap(p.src)
                    let found = vector.new(:manifest.ImportedModuleRef)
                    try
                        let text = files.readText(src)
                        if maybe.isSome(text) then
                            case units.unitDeclaration(units.parseUnit(location.newSourceMap(src
                                    maybe.unwrap(text))) src)
                                when moduleDecl with d then
                                    for i = 0 upto {vector.length(d.decl.imports) - 1} do
                                        let it = vector.get(d.decl.imports i)
                                        let modulePaths = ast.effectiveModulePaths(it)
                                        for j = 0 upto {vector.length(it.names) - 1} do
                                            let path =
                                                if {j < vector.length(modulePaths)}
                                                        andif {stringOp.length(vector.get(modulePaths j)) > 0} then
                                                    vector.get(modulePaths j)
                                                else
                                                    vector.get(it.names j)
                                                end
                                            let m = graph.resolveModule(eng.resolver path
                                                    maybe.some(files.parent(src)) roots)
                                            vector.append(found tuple
                                                let name = graph.canonicalName(m)
                                                let interfaceName = ""
                                                let source = maybe.unwrapOr(m.source "")
                                                let path = path
                                            end)
                                        end
                                    end
                                else ok
                            end
                        end
                    when diagnostics.compilerError then
                        (* Its compilation reports why *)
                        ok
                    when buildError then
                        ok
                    end
                    vector.toArray(found)
                end

            while head < vector.length(queue) do
                (* Pop the modules queued and not yet popped, and those they are
                 * predicted to queue *)
                let wave = vector.new(:Popped)
                let add = fun(p: Popped): Ok
                    begin
                        vector.append(wave p)
                        if not(hashMap.contains(preparedAt p.item)) then
                            hashMap.insert(preparedAt p.item vector.length(prepared))
                        end
                        vector.append(prepared p)
                        vector.append(outcomes maybe.none(:workers.Outcome))
                    end
                for i = head upto {vector.length(queue) - 1} do
                    let item = vector.get(queue i)
                    if preparedIndex(item) < 0 then add(popped(item)) end
                end
                if eng.jobs > 1 then
                    let var next = 0
                    while next < vector.length(wave) do
                        let imports = predictedImports(vector.get(wave next))
                        next := next + 1
                        for i = 0 upto {extent imports - 1} do
                            let dep = imports[i]
                            if not(isDiscovered(dep.name)) andif not(isDiscovered(paths.lower(dep.name)))
                                    andif {preparedIndex(dep.name) < 0} then
                                (* Where its importer's manifest will say it is *)
                                if stringOp.length(dep.source) > 0 then recordSource(dep.name dep.source) end
                                add(popped(dep.name))
                            end
                        end
                    end
                end
                let compiled = compileWave(eng vector.toArray(wave) search programDir)
                let base = vector.length(prepared) - vector.length(wave)
                for i = 0 upto {extent compiled - 1} do
                    vector.set(outcomes {base + i} compiled[i])
                end

                (* Follow the queue through the modules popped *)
                while {head < vector.length(queue)}
                        andif {preparedIndex(vector.get(queue head)) >= 0} do
                    let item = vector.get(queue head)
                    head := head + 1
                    let p = maybe.unwrap(preparedOf(item))
                    for i = 0 upto {vector.length(p.notes) - 1} do
                        let n = vector.get(p.notes i)
                        log(eng n.tag n.message)
                    end
                    if maybe.isSome(p.failure) then
                        let raiseAgain = maybe.unwrap(p.failure)
                        raiseAgain()
                    end
                    let m =
                        if p.stale then
                            if maybe.isSome(outcomeOf(item)) then
                                let o = maybe.unwrap(outcomeOf(item))
                                writer.putString(writer.err o.stderr)
                                workers.raiseFailure(o)
                            else
                                typecheck.install()
                                moduleCompiler.compileModuleFile(maybe.unwrap(p.src) maybe.some(p.targetDir)
                                        settings(eng search programDir) maybe.some(eng.resolver))
                                ok
                            end
                            manifest.readQm(p.a.qm)
                        else
                            if system.isFile(p.a.qm) then manifest.readQm(p.a.qm)
                            else maybe.none(:manifest.ModuleManifest)
                            end
                        end

                    if maybe.isSome(m) then
                        let mf = maybe.unwrap(m)
                        setManifest(paths.lower(p.item) mf)
                        verifyModuleInterface(paths.lower(p.item) mf.interfaceName)
                        if {stringOp.length(mf.name) > 0} andif not(eq(paths.lower(mf.name) paths.lower(p.item))) then
                            setManifest(paths.lower(mf.name) mf)
                            verifyModuleInterface(paths.lower(mf.name) mf.interfaceName)
                        end
                    end
                    let imported =
                        if maybe.isSome(m) then
                            maybe.unwrap(m).importedModules
                        else
                            array of :manifest.ImportedModuleRef end
                        end
                    if hashSet.insert(isLinked p.a.o) then vector.append(linked p.a.o) end
                    let deps = array of(extent imported "")
                    for i = 0 upto {extent imported - 1} do deps[i] := imported[i].name end
                    vector.append(moduleGraph tuple let node = p.item let neighbors = deps end)
                    enqueueImports(p.item imported)
                end
            end

            log(eng "QUEUE EMPTY" "transitive closure verified (" <> conv.int(vector.length(linked))
                <> " units)")

            (* Every expected interface, across the transitive closure *)
            for i = 0 upto {vector.length(expectedNames) - 1} do
                let name = vector.get(expectedNames i)
                let entry = tuple let name = name let expected = hashMap.find(expected name) end
                let mf = manifestOf(entry.name)
                if maybe.isSome(mf)
                        andif maybe.isSome(maybe.unwrap(mf).interfaceName) then
                    let actual = maybe.unwrap(maybe.unwrap(mf).interfaceName)
                    for j = 0 upto {vector.length(entry.expected) - 1} do
                        let r = vector.get(entry.expected j)
                        if not(eq(actual r.interfaceName)) then
                            fail(:Ok conformanceError(r.importer entry.name r.interfaceName actual))
                        end
                    end
                end
            end

            (* Modules must form an acyclic graph to be initialized in order
             * (docs/build-process.md section 8.2) *)
            let cycle = detectModuleCycle(moduleGraph)
            if maybe.isSome(cycle) then
                fail(:Ok "Cyclic module dependency detected: " <> strutil.join(" -> "
                        vector.fromArray(maybe.unwrap(cycle))))
            end
            vector.toArray(linked)
        end

    (* Builds the program in mainFile into a binary at output, else at its
     * artifacts' base in the build directory (buildMain, which writes the log
     * this leaves unflushed). The main unit is compiled first if stale, since
     * its manifest lists the modules it imports, which unflushedBuildModules
     * then brings up to date. The objects are linked in the order
     * eng.extraObjects, the main unit's .o, then the modules' .o files in
     * queue order. Raises buildError if mainFile does not exist, and passes
     * on the errors of compiling and linking. *)
    let unflushedBuildMain(eng: T mainFile: String output: maybe.T(String)): Ok =
        begin
            let main = files.absolute(mainFile)
            if not(system.isFile(main)) then fail(:Ok "Main routine file not found: " <> main) end
            let target = if maybe.isSome(output) then files.absolute(maybe.unwrap(output))
                else mainArtifactBase(eng main) end
            log(eng "BUILD START" "target=" <> main <> " mode=separate build_dir=" <> str(eng.buildDir))
            let item = files.stem(main)
            log(eng "QUEUE INIT" "enqueued main routine " <> quoted(item))
            log(eng "POP QUEUE" quoted(item) <> " (kind=main)")
            let a = mainArtifacts(eng main)
            let reason = unitStaleness(eng main a maybe.some(files.parent(main)))
            let imported =
                if maybe.isSome(reason) then
                    log(eng "EVAL STALENESS" quoted(item) <> " -> STALE (" <> maybe.unwrap(reason) <> ")")
                    log(eng "COMPILE MAIN" quoted(item))
                    compileMainUnit(eng main)
                else
                    log(eng "EVAL STALENESS" quoted(item) <> " -> UP TO DATE")
                    maybe.unwrap(manifest.readQm(a.qm)).importedModules
                end
            let objects = unflushedBuildModules(eng imported item maybe.some(files.parent(main)))
            let n = extent eng.extraObjects
            let linked = vector.new(:String)
            for i = 0 upto {n - 1} do vector.append(linked objects[i]) end
            vector.append(linked a.o)
            for i = n upto {extent objects - 1} do vector.append(linked objects[i]) end
            log(eng "HOST LINK" "linking " <> conv.int(vector.length(linked)) <> " objects into " <> target)
            compilerRunner.linkObjects(vector.toArray(linked) target eng.nogc eng.compiler eng.extraCFlags)
            log(eng "BUILD COMPLETE" "exit_code=0 binary=" <> target)
        end

    (* body, with the log's batched entries appended to its file when it
     * returns or raises an exception *)
    let flushingLog(A::TYPE eng: T body: All() A): A =
        begin
            let result =
                try
                    body()
                else with r then
                    logger.flush(eng.logger)
                    raised.reraise(:A r)
                end
            logger.flush(eng.logger)
            result
        end

    let buildModules(eng: T roots: Array(manifest.ImportedModuleRef) importer: String programDir: maybe.T(String))
            : Array(String) = flushingLog(eng fun(): Array(String) unflushedBuildModules(eng roots importer programDir))

    let buildMain(eng: T mainFile: String output: maybe.T(String)): Ok =
        flushingLog(eng fun(): Ok unflushedBuildMain(eng mainFile output))

    let compileMain(eng: T mainFile: String): Ok =
        flushingLog(eng fun(): Ok
            begin
                let main = files.absolute(mainFile)
                if not(system.isFile(main)) then fail(:Ok "Main routine file not found: " <> main) end
                compileMainUnit(eng main)
                ok
            end)
end
