(* Quest Self-Hosted Compiler: The Build Workers Implementation *)

module workers : Workers
import
    conv : Conv
    stringOp = string : StringOp
    system : System
    writer : Writer

    collections/vector : collections/Vector
    os/process : os/Process
    util/json : util/JSON
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/build/compilerRunner : questlang/build/CompilerRunner
    questlang/build/moduleCompiler : questlang/build/ModuleCompiler
    questlang/codegen/choice : questlang/codegen/Choice
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/files : questlang/common/Files
    questlang/common/location : questlang/common/Location
    questlang/modules/inlined : questlang/modules/Inlined
    questlang/modules/resolution : questlang/modules/Resolution
    questlang/modules/stdlib : questlang/modules/Stdlib
    questlang/typechecker/typecheck : questlang/typechecker/Typecheck
export
    Let Job = Tuple source: String targetDir: String settings: moduleCompiler.Settings end

    Let Outcome = Tuple source: String stderr: String failure: maybe.T(String) end

    let eq(a: String b: String): Bool = stringOp.equal(a b)

    (* ======================================================================
     * 1. Errors as JSON
     * ====================================================================== *)

    let maybeText(s: maybe.T(String)): json.Value =
        if maybe.isSome(s) then json.string(maybe.unwrap(s)) else json.null end

    let encodeError(e: diagnostics.CompilerError): String =
        begin
            let o = json.newObject()
            json.put(o "kind" json.string("compiler"))
            json.put(o "message" json.string(e.message))
            json.put(o "offset" json.int(e.offset))
            json.put(o "length" json.int(e.length))
            json.put(o "isFatal" json.bool(e.isFatal))
            json.put(o "help" maybeText(e.help))
            let notes = vector.new(:json.Value)
            for i = 0 upto {vector.length(e.notes) - 1} do
                vector.append(notes json.string(vector.get(e.notes i)))
            end
            json.put(o "notes" json.arrayValue(notes))
            json.put(o "file" maybeText(e.file))
            json.put(o "silent" json.bool(e.silent))
            let labels = vector.new(:json.Value)
            for i = 0 upto {vector.length(e.labels) - 1} do
                let l = vector.get(e.labels i)
                let lo = json.newObject()
                json.put(lo "file" json.string(l.sp.file))
                json.put(lo "start" json.int(l.sp.startOffset))
                json.put(lo "end" json.int(l.sp.endOffset))
                json.put(lo "message" json.string(l.message))
                json.put(lo "isPrimary" json.bool(l.isPrimary))
                vector.append(labels json.object(lo))
            end
            json.put(o "labels" json.arrayValue(labels))
            json.dump(json.object(o))
        end

    let encodeMessage(kind: String message: String): String =
        begin
            let o = json.newObject()
            json.put(o "kind" json.string(kind))
            json.put(o "message" json.string(message))
            json.dump(json.object(o))
        end

    let member(o: json.Object name: String): json.Value = maybe.unwrapOr(json.get(o name) json.null)
    let text(v: json.Value): String = case v when jString with x then x.s else "" end
    let maybeString(v: json.Value): maybe.T(String) =
        case v when jString with x then maybe.some(x.s) else maybe.none() end
    let number(v: json.Value): Int = case v when jNumber with x then strutil.toInt(x.text) else 0 end
    let flag(v: json.Value): Bool = case v when jBool with x then x.b else false end
    let items(v: json.Value): vector.T(json.Value) = case v when jArray with x then x.items else vector.new() end

    (* Registers file's source map so the driver can display error lines from
     * it *)
    let register(file: String): Ok =
        if {stringOp.length(file) > 0} andif system.isFile(file) then
            let text = files.readText(file)
            if maybe.isSome(text) then
                diagnostics.registerSource(location.newSourceMap(file maybe.unwrap(text)))
            end
        end

    let decodeError(o: json.Object): diagnostics.CompilerError =
        begin
            let notes = vector.new(:String)
            let noteItems = items(member(o "notes"))
            for i = 0 upto {vector.length(noteItems) - 1} do
                vector.append(notes text(vector.get(noteItems i)))
            end
            let labels = vector.new(:diagnostics.Label)
            let labelItems = items(member(o "labels"))
            for i = 0 upto {vector.length(labelItems) - 1} do
                case vector.get(labelItems i)
                    when jObject with x then
                        let file = text(member(x.o "file"))
                        register(file)
                        vector.append(labels tuple
                            let sp = location.span(file number(member(x.o "start")) number(member(x.o "end")))
                            let message = text(member(x.o "message"))
                            let isPrimary = flag(member(x.o "isPrimary"))
                        end)
                    else ok
                end
            end
            let file = maybeString(member(o "file"))
            if maybe.isSome(file) then register(maybe.unwrap(file)) end
            diagnostics.errorOf(text(member(o "message")) number(member(o "offset")) number(member(o "length"))
                    flag(member(o "isFatal")) maybeString(member(o "help")) notes file flag(member(o "silent")) labels)
        end

    let raiseFailure(o: Outcome): Ok =
        if maybe.isSome(o.failure) then
            let failure = maybe.unwrap(o.failure)
            let decoded =
                try maybe.some(json.parse(failure))
                when json.error then maybe.none(:json.Value)
                end
            let obj =
                if maybe.isSome(decoded) then
                    case maybe.unwrap(decoded) when jObject with x then maybe.some(x.o)
                        else maybe.none(:json.Object)
                    end
                else
                    maybe.none(:json.Object)
                end
            if maybe.isNone(obj) then
                raise compilerRunner.failure with failure end
            else
                let fields = maybe.unwrap(obj)
                if eq(text(member(fields "kind")) "compiler") then
                    diagnostics.raiseError(:Ok decodeError(fields))
                else
                    raise compilerRunner.failure with text(member(fields "message")) end
                end
            end
        end

    (* ======================================================================
     * 2. The parent: children compiling jobs
     * ====================================================================== *)

    (* The arguments that run driver in unit mode on a batch of jobs, which
     * share all but their sources and target directories. parseCommand, in
     * section 3, reads them back, so an option added here is added there. *)
    let command(driver: String batch: Array(Job) worker: Int): Array(String) =
        begin
            let args = vector.new(:String)
            let add = fun(s: String): Ok vector.append(args s)
            let job = batch[0].settings
            add(driver)
            for b = 0 upto {extent batch - 1} do
                add("--unit-module")
                add(batch[b].source)
                add("--target-dir")
                add(batch[b].targetDir)
            end
            add("--worker")
            add(conv.int(worker))
            for i = 0 upto {extent job.includePaths - 1} do
                add("-I")
                add(job.includePaths[i])
            end
            if maybe.isSome(job.buildDir) then
                add("--build-dir")
                add(maybe.unwrap(job.buildDir))
            end
            if maybe.isSome(job.programDir) then
                add("--program-dir")
                add(maybe.unwrap(job.programDir))
            end
            if job.nogc then add("--nogc") end
            let backendArgs = choice.arguments(job.backends)
            for i = 0 upto {extent backendArgs - 1} do add(backendArgs[i]) end
            if stringOp.length(job.reportInferable) > 0 then
                add("--report-inferable")
                add(job.reportInferable)
            end
            (* The process's inlined modules, every one named, so that a worker
             * opens the modules its parent does (modules/inlined) *)
            add("--inline-library")
            add("no")
            let names = inlined.names()
            for i = 0 upto {extent names - 1} do
                add("--inline-module")
                add(names[i])
            end
            vector.toArray(args)
        end

    (* Builds each job's outcome from its child process's exit result. A child
     * that fails writes the failing job's batch index on the first line of
     * stdout, followed by the encoded error, and skips remaining jobs in the
     * batch. A non-zero exit without that index means the child crashed,
     * failing every job in the batch. *)
    let batchOutcomes(batch: Array(Job) r: process.Result): Array(Outcome) =
        begin
            let outcome = fun(b: Int failure: maybe.T(String)): Outcome
                tuple
                    let source = batch[b].source
                    (* Its standard error goes with the batch's first job *)
                    let stderr = if b is 0 then r.stderr else "" end
                    let failure = failure
                end
            let outcomes = array of(extent batch outcome(0 maybe.none()))
            for b = 1 upto {extent batch - 1} do outcomes[b] := outcome(b maybe.none()) end
            if r.code isnot 0 then
                let newline = strutil.find(r.stdout "\n")
                let failed = if newline > 0 then strutil.tryToInt(stringOp.getSub(r.stdout 0 newline))
                    else maybe.none(:Int) end
                if maybe.isSome(failed) then
                    let f = maybe.unwrap(failed)
                    let error = stringOp.getSub(r.stdout {newline + 1} {{stringOp.length(r.stdout) - newline} - 1})
                    outcomes[f] := outcome(f maybe.some(error))
                    for b = {f + 1} upto {extent batch - 1} do
                        outcomes[b] := outcome(b maybe.some(encodeMessage("skipped" "the compilation of "
                            <> batch[b].source <> " was skipped after " <> batch[f].source <> " failed")))
                    end
                else
                    let crash = encodeMessage("crash" "the compilation of " <> batch[0].source <> " and "
                        <> conv.int(extent batch - 1) <> " more stopped with " <> conv.int(r.code) <> ": " <> r.stderr)
                    for b = 0 upto {extent batch - 1} do outcomes[b] := outcome(b maybe.some(crash)) end
                end
            end
            outcomes
        end

    (* The jobs are dealt into at most n batches, round robin, and each batch is
     * compiled by one child, in order, so that it loads the interfaces its
     * modules share once, as a serial build does *)
    let compileAll(jobs: Array(Job) n: Int driver: String): Array(Outcome) =
        begin
            let none = tuple let source = "" let stderr = "" let failure = maybe.none(:String) end
            let outcomes = array of(extent jobs none)
            let count = if n < extent jobs then n else extent jobs end
            let batchOf = fun(indexes: Array(Int)): Array(Job)
                begin
                    let batch = array of(extent indexes jobs[indexes[0]])
                    for b = 1 upto {extent indexes - 1} do batch[b] := jobs[indexes[b]] end
                    batch
                end
            let children = vector.new(:process.T)
            let batches = vector.new(:Array(Int))
            for c = 0 upto {count - 1} do
                let members = vector.new(:Int)
                let var j = c
                while j < extent jobs do
                    vector.append(members j)
                    j := j + count
                end
                let indexes = vector.toArray(members)
                vector.append(children process.spawn(command(driver batchOf(indexes) {c + 1})))
                vector.append(batches indexes)
            end
            for c = 0 upto {count - 1} do
                let indexes = vector.get(batches c)
                let results = batchOutcomes(batchOf(indexes) process.wait(vector.get(children c)))
                for b = 0 upto {extent indexes - 1} do outcomes[indexes[b]] := results[b] end
            end
            outcomes
        end

    (* ======================================================================
     * 3. The child: a batch of modules in unit mode
     * ====================================================================== *)

    let isUnitMode(args: Array(String)): Bool = {extent args > 1} andif eq(args[1] "--unit-module")

    (* What a child's command line says: the modules to compile and where, its
     * tag, the settings they share, and the process's inlined modules *)
    Let Batch = Tuple
        sources: Array(String)
        targetDirs: Array(String)
        worker: String
        settings: moduleCompiler.Settings
        inlineLibrary: Bool
        inlinedNames: Array(String)
    end

    (* Reads back the arguments command writes *)
    let parseCommand(args: Array(String)): Batch =
        begin
            let sources = vector.new(:String)
            let targetDirs = vector.new(:String)
            let var worker = ""
            let searchPaths = vector.new(:String)
            let var buildDir = maybe.none(:String)
            let var programDir = maybe.none(:String)
            let var nogc = false
            let var reportInferable = ""
            let var backend = "c"
            let overrides = vector.new(:choice.Override)
            let variants = vector.new(:choice.Alternative)
            let var inlineLibrary = true
            let inlinedNames = vector.new(:String)
            let var i = 1
            (* Each option but --nogc takes a value *)
            while i < extent args do
                let arg = args[i]
                let value = if {i + 1} < extent args then args[i + 1] else "" end
                if eq(arg "--nogc") then
                    nogc := true
                elsif eq(arg "--unit-module") then
                    vector.append(sources value)
                elsif eq(arg "--target-dir") then
                    vector.append(targetDirs value)
                elsif eq(arg "--worker") then
                    worker := value
                elsif eq(arg "-I") then
                    vector.append(searchPaths value)
                elsif eq(arg "--build-dir") then
                    buildDir := maybe.some(value)
                elsif eq(arg "--program-dir") then
                    programDir := maybe.some(value)
                elsif eq(arg "--backend") then
                    backend := value
                elsif eq(arg "--report-inferable") then
                    reportInferable := value
                elsif eq(arg "--inline-library") then
                    inlineLibrary := not(eq(value "no"))
                elsif eq(arg "--inline-module") then
                    vector.append(inlinedNames value)
                elsif eq(arg "--unit-backend") then
                    let o = choice.parseOverride(value)
                    if maybe.isSome(o) then vector.append(overrides maybe.unwrap(o)) end
                elsif eq(arg "--variant") then
                    let v = choice.parseVariant(value)
                    if maybe.isSome(v) then
                        vector.append(variants maybe.unwrap(v))
                    end
                end
                let step = if eq(arg "--nogc") then 1 else 2 end
                i := i + step
            end
            tuple
                let sources = vector.toArray(sources)
                let targetDirs = vector.toArray(targetDirs)
                let worker = worker
                let settings = tuple
                    let includePaths = vector.toArray(searchPaths)
                    let nogc = nogc
                    let buildDir = buildDir
                    let programDir = programDir
                    let backends = tuple
                        let default = backend
                        let overrides = vector.toArray(overrides)
                        let variants = vector.toArray(variants)
                    end
                    let reportInferable = reportInferable
                end
                let inlineLibrary = inlineLibrary
                let inlinedNames = vector.toArray(inlinedNames)
            end
        end

    let unitMain(args: Array(String)): Ok =
        begin
            let batch = parseCommand(args)
            inlined.setInlined(batch.inlineLibrary batch.inlinedNames)
            (* Give this worker a distinct tag for files.writeAtomically temp
             * files *)
            files.setWorkerTag("." <> batch.worker)
            stdlib.install()
            (* One resolver for the batch, as a serial build has one for all *)
            let resolver = resolution.newResolver()
            resolver.variantOf := fun(unit: String): String choice.variantFor(batch.settings.backends unit)
            let var failed = maybe.none(:String)
            for b = 0 upto {extent batch.sources - 1} do
                if maybe.isNone(failed) then
                    let failure =
                        try
                            begin
                                typecheck.install()
                                moduleCompiler.compileModuleFile(batch.sources[b] maybe.some(batch.targetDirs[b])
                                        batch.settings maybe.some(resolver))
                                maybe.none(:String)
                            end
                        when diagnostics.compilerError with err then
                            maybe.some(encodeError(err))
                        when compilerRunner.failure with m then
                            maybe.some(encodeMessage("runner" m))
                        end
                    if maybe.isSome(failure) then
                        failed := maybe.some(conv.int(b) <> "\n" <> maybe.unwrap(failure))
                    end
                end
            end
            if maybe.isSome(failed) then
                writer.putString(writer.output maybe.unwrap(failed))
                writer.flush(writer.output)
                writer.flush(writer.err)
                system.sysexit(1)
            end
        end
end
