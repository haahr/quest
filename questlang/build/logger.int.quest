(* Quest Self-Hosted Compiler: The Build Logger Interface
 *
 * bootstrap/python/quest/build/logger.py: the build engine's record of what it
 * does, one timestamped, tagged line per event, appended to a log file and,
 * when verbose, written to standard error. *)

interface Logger
import
    util/maybe : util/Maybe
export
    Def T = Tuple logFile: maybe.T(String) verbose: Bool end
    (* A logger appending to logFile (whose directory it makes), if one is
     * given *)
    new(logFile: maybe.T(String) verbose: Bool): T
    (* Logs "[YYYY-MM-DDTHH:MM:SS] TAG: message", in local time. When not
     * verbose, entries reach the log file in batches, stamped with the time
     * of their batch *)
    log(l: T tag: String message: String): Ok
    (* Appends the entries not yet in the log file *)
    flush(l: T): Ok
end
