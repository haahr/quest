(* Quest Self-Hosted Compiler: The C Compiler Runner Interface
 *
 * Invokes the host C compiler (clang, or gcc if clang is absent on PATH) to
 * compile generated C or assembly files and link executables against the Quest
 * runtime. This interface chooses the compiler flags every C unit receives,
 * including the runtime directory, garbage collector and line-editor options,
 * and warning and optimization settings. Its bootstrap counterpart is
 * bootstrap/python/quest/build/compiler_runner.py. *)

interface CompilerRunner
import
    util/maybe : util/Maybe
export
    (* A C compilation or link that failed, or a missing tool, with the
     * bootstrap's message *)
    failure: Exception(String)

    (* Compiles a C file to an object file *)
    compileCToObject(c: String o: String includePaths: Array(String) nogc: Bool compiler: maybe.T(String)
            extraFlags: Array(String)): Ok
    (* Compiles a program's C (or with assembly, its assembly), with the runtime
     * and extraObjects, to the executable output *)
    compileCSource(source: String output: String nogc: Bool compiler: maybe.T(String)
            extraObjects: Array(String) extraFlags: Array(String) assembly: Bool): Ok
    (* Links object files and the runtime's into the executable output *)
    linkObjects(objects: Array(String) output: String nogc: Bool compiler: maybe.T(String)
            extraFlags: Array(String)): Ok
    (* A new empty file in the temporary directory, for an executable *)
    temporaryBinary(): String
    (* Runs an executable with arguments, in this process's environment and
     * standard input: its exit status and output *)
    runBinary(binary: String args: Array(String)): Tuple code: Int stdout: String stderr: String end
end
