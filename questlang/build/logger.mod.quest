(* Quest Self-Hosted Compiler: The Build Logger Implementation *)

module logger : Logger
import
    stringOp = string : StringOp
    system : System
    writer : Writer

    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/common/files : questlang/common/Files
export
    Let T = Tuple logFile: maybe.T(String) verbose: Bool end

    let new(logFile: maybe.T(String) verbose: Bool): T =
        begin
            if maybe.isSome(logFile) then system.makeDirectory(files.parent(maybe.unwrap(logFile))) end
            tuple let logFile = logFile let verbose = verbose end
        end

    (* A Quest writer cannot append to a file, nor can a Quest program read the
     * clock, so a shell does both: it formats the entry with date's time,
     * appends it to the log file ($0), and prints it *)
    let appendScript = "entry=$(printf '[%s] %s' \"$(date +%Y-%m-%dT%H:%M:%S)\" \"$1\"); "
        <> "if [ -n \"$0\" ]; then printf '%s\\n' \"$entry\" >> \"$0\"; fi; printf '%s' \"$entry\""

    (* Where no shell can run (a WebAssembly build, docs/wasm.md section
     * 4.2), no entry is appended to the log file; a verbose entry is still
     * printed, without its time *)
    let shell(args: Array(String) otherwise: String): String =
        try system.run(args).stdout when system.error then otherwise end

    (* Entries not yet appended to the log file. Spawning a shell per entry is
     * slow, so non-verbose builds flush entries in batches, stamping every
     * entry in a batch with that batch's timestamp. *)
    let pending = vector.new(:String)
    let batchScript = "t=$(date +%Y-%m-%dT%H:%M:%S); f=$0; "
        <> "for e in \"$@\"; do printf '[%s] %s\\n' \"$t\" \"$e\" >> \"$f\"; done"
    let batchSize = 64

    let flushTo(file: String): Ok =
        if not(vector.empty(pending)) then
            let args = vector.new(:String)
            vector.append(args "sh")
            vector.append(args "-c")
            vector.append(args batchScript)
            vector.append(args file)
            for i = 0 upto {vector.length(pending) - 1} do
                vector.append(args vector.get(pending i))
            end
            shell(vector.toArray(args) "")
            vector.clear(pending)
        end

    let log(l: T tag: String message: String): Ok =
        begin
            let file = maybe.unwrapOr(l.logFile "")
            if l.verbose orif stringOp.isEmpty(file) then
                if not(stringOp.isEmpty(file)) then flushTo(file) end
                let entry = shell(array of "sh" "-c" appendScript file tag <> ": " <> message end
                        tag <> ": " <> message)
                if l.verbose then
                    writer.putString(writer.err entry <> "\n")
                    writer.flush(writer.err)
                end
            else
                vector.append(pending tag <> ": " <> message)
                if vector.length(pending) >= batchSize then flushTo(file) end
            end
        end

    let flush(l: T): Ok = if maybe.isSome(l.logFile) then flushTo(maybe.unwrap(l.logFile)) end
end
