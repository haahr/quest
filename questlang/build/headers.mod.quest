(* Quest Self-Hosted Compiler: Interface Headers in the Build Implementation *)

module headers : Headers
import
    stringOp = string : StringOp
    system : System

    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/codegen/c/headers : questlang/codegen/c/Headers
    questlang/common/files : questlang/common/Files
    questlang/modules/artifacts/interfaceCompiler : questlang/modules/artifacts/InterfaceCompiler
    questlang/modules/loader : questlang/modules/Loader
    questlang/modules/paths : questlang/modules/Paths
    questlang/modules/resolution : questlang/modules/Resolution
    questlang/types/env : questlang/types/Env
export
    (* The header beside an interface's .qi (util/path.qi and
     * util/path.int.h) *)
    let interfaceHeaderFile(qi: String): String =
        begin
            let base = files.baseName(qi)
            files.join(files.parent(qi) stringOp.getSub(base 0 {stringOp.length(base) - 3}) <> ".int.h")
        end
    (* Whether a header was written at or after its .qi *)
    let headerIsCurrent(qi: String header: String): Bool =
        begin
            let headerTime = files.fileTime(header)
            let qiTime = files.fileTime(qi)
            maybe.isSome(headerTime) andif maybe.isSome(qiTime)
                andif {maybe.unwrap(headerTime) >= maybe.unwrap(qiTime)}
        end
    let writeText(file: String text: String): Ok = files.writeAtomically(file text)
    Let Artifacts = Tuple header: String qi: String end
    (* Writes a compiled interface's header beside its .qi, and returns it; with
     * a build directory, the headers of the interfaces it imports are brought
     * up to date there first *)
    let rec writeInterfaceHeader(compiled: interfaceCompiler.CompiledInterface buildDir: maybe.T(String)
            programDir: maybe.T(String) res: resolution.Resolver): String =
        begin
            if maybe.isSome(buildDir) then
                let buildRoot = files.absolute(maybe.unwrap(buildDir))
                let roots = resolution.rootsOf(compiled.includePaths programDir)
                for i = 0 upto {vector.length(compiled.decl.imports) - 1} do
                    let imp = vector.get(compiled.decl.imports i)
                    ensureResolvedInterfaceHeader(resolution.resolveInterface(res
                            maybe.unwrapOr(imp.interfacePath imp.interfaceName)
                            maybe.some(files.parent(compiled.source)) roots) buildRoot res)
                end
            end
            let header = interfaceHeaderFile(compiled.qiFile)
            let canonicalName =
                paths.canonicalizeInterfaceName(maybe.some(compiled.source) compiled.includePaths
                        compiled.decl.name maybe.none())
            writeText(header headers.compileInterfaceToHeader(compiled.decl compiled.scope canonicalName))
            header
        end
    (* Brings a resolved interface's .qi and C header under buildDir up to date,
     * with the headers it includes *)
    and ensureResolvedInterfaceHeader(resolved: resolution.Resolved buildDir: String
            res: resolution.Resolver): Artifacts =
        begin
            let programDir = resolved.roots.programDir
            let write = fun(c: interfaceCompiler.CompiledInterface): Ok
                begin
                    writeInterfaceHeader(c maybe.some(buildDir) programDir res)
                    ok
                end
            let artifacts = interfaceCompiler.ensureResolvedInterfaceArtifacts(resolved buildDir
                    maybe.some(write) res)
            let header = interfaceHeaderFile(artifacts.qiFile)
            if maybe.isNone(artifacts.source) orif headerIsCurrent(artifacts.qiFile header) then
                tuple let header = header let qi = artifacts.qiFile end
            else
                (* When the header is missing or older than a fresh .qi in the
                 * build directory, regenerate the header without rewriting the
                 * .qi; if the .qi lives outside the build directory, rebuild
                 * both into the build directory *)
                let inBuildDir =
                    stringOp.equal(files.absolute(files.parent(artifacts.qiFile)) files.absolute(artifacts.targetDir))
                system.makeDirectory(artifacts.targetDir)
                let known = if inBuildDir then interfaceCompiler.compiledInterface(artifacts.qiFile)
                    else maybe.none(:interfaceCompiler.CompiledInterface) end
                let compiled =
                    if maybe.isSome(known) then
                        maybe.unwrap(known)
                    else
                        interfaceCompiler.compileInterfaceFile(maybe.unwrap(artifacts.source)
                                maybe.some(artifacts.targetDir) artifacts.searchPaths maybe.some(buildDir)
                                programDir
                                not(inBuildDir) maybe.none() res)
                    end
                tuple
                    let header = writeInterfaceHeader(compiled maybe.some(buildDir) programDir res)
                    let qi = compiled.qiFile
                end
            end
        end
    let ensureImportedInterfaceHeader(name: String e: env.T): maybe.T(String) =
        begin
            let resolved = env.resolveInterface(e name)
            let root = loader.resolvedArtifactRoot(e resolved)
            if maybe.isNone(root) then maybe.none()
            else maybe.some(ensureResolvedInterfaceHeader(resolved maybe.unwrap(root) e.units.resolver).header)
            end
        end
    let compileInterfaceWithHeader(file: String outputDir: maybe.T(String) includePaths: Array(String)
            buildDir: maybe.T(String) programDir: maybe.T(String)): Artifacts =
        begin
            let res = resolution.newResolver()
            let write = fun(c: interfaceCompiler.CompiledInterface): Ok
                begin
                    writeInterfaceHeader(c buildDir programDir res)
                    ok
                end
            let compiled = interfaceCompiler.compileInterfaceFile(file outputDir includePaths buildDir programDir true
                    maybe.some(write) res)
            tuple let header = interfaceHeaderFile(compiled.qiFile) let qi = compiled.qiFile end
        end
end
