(* Quest Self-Hosted Compiler: Parsed JSON Documents, Shared
 *
 * A build reads each artifact's text many times (.qi files, .qm manifests),
 * so it parses each text once. The library does not cache (docs/json.md
 * rule 8): a tree is mutable, and only the compiler knows that nothing
 * changes these. *)

interface JSONCache
import
    util/json : util/JSON
export
    (* json.parse(text), shared with every earlier parseShared of the same
     * text; a caller must not change the tree *)
    parseShared(text: String): json.Value
end
