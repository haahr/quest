(* Quest Self-Hosted Compiler: Diagnostics Interface
 *
 * The compiler's two forms of error, and how they are printed.
 *
 * A Diagnostic is what the user sees: a severity, a message, the span of
 * source it points at, and any further labels, notes, and help. Diagnostics
 * are collected in a diagnostic bag (questlang/common/diagbag) as a
 * compilation goes, and rendered at the end by format and render, which print
 * the location, the message, and the source line with a caret under the span.
 *
 * A CompilerError is how code deep in the compiler (the type checker, the
 * module loader) reports an error: it is raised as compilerError where it is
 * found, which stops the work it was part of, and carries only an offset in
 * the unit being checked, not a file, since the raiser often does not know
 * which file that is. As it propagates, inFile and atImport record the file
 * and the imports that led to it; the code that catches it turns it into a
 * Diagnostic with errorDiagnostic and adds that to a bag. The tokenizer and
 * parser, which know their file, add Diagnostics to a bag directly.
 *
 * The bootstrap counterpart is bootstrap/python/quest/diagnostics.py
 * (Diagnostic, and QuestCompilerError with its subclasses).
 * docs/diagnostics.md §2 describes both forms, §3 how they are reported, and
 * §5 the rendering *)

interface Diagnostics
import
    questlang/common/location : questlang/common/Location
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    writer : Writer
export
    Def Severity = Option
        fatal
        error
        warning
        info
    end

    Def Label = Tuple
        sp: location.Span
        message: String
        isPrimary: Bool
    end

    Diagnostic::TYPE

    (* ======================================================================
     * Constructors & Factories
     * ====================================================================== *)

    make(sev: Severity msg: String sp: location.Span): Diagnostic
    fatal(msg: String sp: location.Span): Diagnostic
    error(msg: String sp: location.Span): Diagnostic
    warning(msg: String sp: location.Span): Diagnostic
    info(msg: String sp: location.Span): Diagnostic

    (* ======================================================================
     * Accessors
     * ====================================================================== *)

    severity(d: Diagnostic): Severity
    message(d: Diagnostic): String
    span(d: Diagnostic): location.Span
    labels(d: Diagnostic): vector.T(Label)
    notes(d: Diagnostic): vector.T(String)
    help(d: Diagnostic): maybe.T(String)
    code(d: Diagnostic): maybe.T(String)

    (* ======================================================================
     * Mutators / Builders
     * ====================================================================== *)

    addLabel(d: Diagnostic sp: location.Span msg: String isPrimary: Bool): Ok
    addNote(d: Diagnostic note: String): Ok
    setHelp(d: Diagnostic h: String): Ok
    setCode(d: Diagnostic c: String): Ok
    (* For an uncaught exception, the frames running where it was raised, most
     * recent first, rendered after the source line and any notes
     * (docs/exceptions.md section 2.1) *)
    setTrace(d: Diagnostic frames: Array(String)): Ok

    (* ======================================================================
     * Formatting & Rendering
     * ====================================================================== *)

    severityString(sev: Severity): String
    (* The source maps of the files diagnostics may be in, besides the one
     * format is given (units the program imports), by file name *)
    registerSource(sm: location.SourceMap): Ok
    (* d as the user sees it, in lines that each end with a newline: its
     * location, severity, and message; the source line with carets under its
     * span (at least one, and none past the end of the line); each secondary
     * label, as ::: file:line:col, its line, and dashes under it; the notes,
     * the help, and an uncaught exception's frames. For example
     *
     *     two.quest:1:14: error: Type mismatch: ...
     *         let x: Int = "a"
     *                      ^
     *
     * The source comes from the map registered for d's file, else sm. A
     * diagnostic without a location (no file, or a negative offset) has
     * neither the location nor the source line. The code (setCode) is not
     * printed. docs/diagnostics.md §5 describes the layout *)
    format(d: Diagnostic sm: location.SourceMap): String
    (* Writes format(d sm) to w *)
    render(d: Diagnostic sm: location.SourceMap w: writer.T): Ok

    (* =========================================================================
     * Errors raised where they are found
     *
     * As the bootstrap's QuestCompilerError and its subclasses (KindError,
     * QuestTypeError, ...), an error is raised where it is found, located by an
     * offset in the unit being checked (0 where the raiser does not know
     * where), and the code that reports it makes a diagnostic of it in that
     * unit's file.
     * ====================================================================== *)

    Def CompilerError = Tuple
        message: String
        offset: Int
        length: Int
        isFatal: Bool
        help: maybe.T(String)
        notes: vector.T(String)
        (* The file of the unit the error was raised in, once it propagates out
         * of it (the bootstrap's in_unit) *)
        file: maybe.T(String)
        (* An error that is not reported: a use of a symbol a failed declaration
         * poisoned, which fails the binding that uses it without another error
         * (docs/diagnostics.md section 4.5) *)
        silent: Bool
        (* Secondary labels: the imports that loaded the unit the error was
         * raised in *)
        labels: vector.T(Label)
    end

    compilerError: Exception(CompilerError)

    (* An error, of length 1 and without help or notes *)
    errorAt(message: String offset: Int): CompilerError
    (* A silent error *)
    silentError: CompilerError
    (* Raises an error (of any type, as raise has) *)
    raiseError(A::TYPE e: CompilerError): A
    (* Raises errorAt(message offset) *)
    fail(A::TYPE message: String offset: Int): A
    (* An error located in file, unless it already is (the bootstrap's
     * in_unit) *)
    inFile(e: CompilerError file: String): CompilerError
    (* An error propagating out of the import at offset in file (the bootstrap's
     * at_import): one not yet located in a file is located at the import, and
     * one in another file gets an "imported here" label *)
    atImport(e: CompilerError offset: Int length: Int file: String): CompilerError
    (* The diagnostic of an error, in its file, or else in file *)
    errorDiagnostic(e: CompilerError file: String): Diagnostic
    (* A warning the type checker recorded, located as errorDiagnostic locates
     * an error *)
    warningDiagnostic(e: CompilerError file: String): Diagnostic

    (* ======================================================================
     * The frames of tracebacks (docs/exceptions.md section 2.3)
     * ====================================================================== *)

    (* The program's phrases *)
    mainFrame: String
    (* A module's initializer *)
    initFrame(moduleName: String): String
    (* The name of a function bound to binder (none if it is not let-bound) by
     * code running in the frame enclosing: the binder, or <anon>, qualified by
     * the module's name in a module's initializer, by the enclosing function's
     * name in a function, and not at all in the program's phrases *)
    frameName(enclosing: String binder: maybe.T(String)): String
end
