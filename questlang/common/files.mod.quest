(* Quest Self-Hosted Compiler: File Operations Implementation *)

module files : Files
import
    stringOp = string : StringOp
    system : System
    writer : Writer

    collections/vector : collections/Vector
    os/fileStats : os/FileStats
    filePath = os/path : os/Path
    util/maybe : util/Maybe
    pathLib = util/path : util/Path
    sb = util/stringBuilder : util/StringBuilder

    questlang/common/memoryFiles : questlang/common/MemoryFiles
    questlang/common/overlays : questlang/common/Overlays
export
    let isAbsolute(p: String): Bool = pathLib.isAbsolute(p)
    let join(a: String b: String): String = pathLib.join(a b)
    let normalize(p: String): String = pathLib.normalize(p)
    let absolute(p: String): String = pathLib.resolve(p)
    (* The components between separators, without empty ones: util/path's
     * parts without an absolute path's root *)
    let components(p: String): vector.T(String) =
        begin
            let result = pathLib.parts(p)
            if isAbsolute(p) then vector.delete(result 0) end
            result
        end
    (* Not util/path's dirName, which keeps repeated separators before the
     * last component (a//b for a//b/c, where this gives a/b, as Python's
     * Path.parent does): callers pass paths as the command line and imports
     * spell them, unnormalized, and name directories by the result *)
    let parent(p: String): String =
        begin
            let cs = components(p)
            if vector.length(cs) <= 1 then
                if isAbsolute(p) then "/" else "." end
            else
                vector.pop(cs)
                let b = sb.new()
                if isAbsolute(p) then sb.char(b '/') end
                for i = 0 upto {vector.length(cs) - 1} do
                    if i > 0 then sb.char(b '/') end
                    sb.str(b vector.get(cs i))
                end
                sb.toString(b)
            end
        end
    (* The root has no name here, as in Python's Path.name, where util/path's
     * baseName gives "/" *)
    let baseName(p: String): String =
        begin
            let name = pathLib.baseName(p)
            if stringOp.equal(name "/") then "" else name end
        end
    let parts(p: String): Array(String) = vector.toArray(pathLib.parts(p))
    (* Not util/path's relativeTo, which climbs out of root with .. and
     * raises path.error for an absolute and a relative path: a path outside
     * root has none here *)
    let relativeTo(p: String root: String): maybe.T(String) =
        begin
            let ps = parts(p)
            let rs = parts(root)
            let var under = extent rs <= extent ps
            if under then
                for i = 0 upto {extent rs - 1} do
                    if not(stringOp.equal(ps[i] rs[i])) then under := false end
                end
            end
            if under then
                let b = sb.new()
                for i = extent rs upto {extent ps - 1} do
                    if i > extent rs then sb.char(b '/') end
                    sb.str(b ps[i])
                end
                let s = sb.toString(b)
                maybe.some(if stringOp.length(s) is 0 then "." else s end)
            else
                maybe.none()
            end
        end
    let displayName(p: String): String =
        begin
            let rel = relativeTo(absolute(p) absolute(system.currentDirectory()))
            maybe.unwrapOr(rel p)
        end
    (* The overlay standing for file, if any; with none, as in a build, the
     * path is not looked up *)
    let overlay(file: String): maybe.T(overlays.Overlay) =
        if overlays.isEmpty() then maybe.none() else overlays.get(absolute(file)) end

    let readText(file: String): maybe.T(String) =
        begin
            let o = overlay(file)
            if maybe.isSome(o) then
                maybe.some(maybe.unwrap(o).text)
            elsif memoryFiles.isMemory(file) then
                memoryFiles.read(file)
            elsif not(system.isFile(file)) then
                maybe.none()
            else
                try
                    maybe.some(filePath.readText(filePath.fromString(file)))
                when system.error then
                    maybe.none()
                end
            end
        end
    let fileTime(file: String): maybe.T(Int) =
        begin
            let o = overlay(file)
            if maybe.isSome(o) then
                maybe.some(maybe.unwrap(o).stamp)
            else
                let s = fileStats.find(file)
                if maybe.isSome(s) andif {maybe.unwrap(s).kind?file} then
                    maybe.some(maybe.unwrap(s).modifiedNs)
                else
                    maybe.none()
                end
            end
        end
    (* A file in memory is newer than every file; an overlay is as new as its
     * stamp *)
    let modifiedNs(p: String): Int =
        begin
            let o = overlay(p)
            if maybe.isSome(o) then maybe.unwrap(o).stamp
            elsif memoryFiles.isMemory(p) then 9223372036854775807
            else fileStats.stat(p).modifiedNs
            end
        end
    let isFile(p: String): Bool =
        if maybe.isSome(overlay(p)) then true
        elsif memoryFiles.isMemory(p) then maybe.isSome(memoryFiles.read(p))
        else system.isFile(p)
        end
    let isSourceFile(p: String): Bool = maybe.isSome(overlay(p)) orif system.isFile(p)
    (* Suffix appended to temporary file names; only parallel build workers
     * set a non-empty tag (build/workers) *)
    let worker = tuple let var tag = "" end
    let setWorkerTag(tag: String): Ok = worker.tag := tag
    let writeAtomically(file: String text: String): Ok =
        if memoryFiles.isMemory(file) then
            memoryFiles.write(file text)
        else
            system.makeDirectory(parent(file))
            let temporary = file <> ".tmp" <> worker.tag
            let w = writer.file(temporary)
            writer.putString(w text)
            writer.close(w)
            system.renameFile(temporary file)
        end
    (* Of baseName's name, so that the root's stem is "" as its name is *)
    let stem(file: String): String = pathLib.stem(baseName(file))
end
