(* Quest Self-Hosted Compiler: Files in Memory Interface
 *
 * Stores compiler artifacts in memory rather than on disk (docs/jit.md
 * section 3.4.1). The JIT uses root, a synthetic path that never exists on
 * disk, as its build directory, and files under it live as strings in this
 * process. common/files intercepts reads and writes under root so callers
 * such as modules/paths and config/abi need not special-case them. A file in
 * memory is never stale: once a unit is loaded in a process, it stays
 * loaded. *)

interface MemoryFiles
import
    util/maybe : util/Maybe
export
    (* The directory the files in memory are under *)
    root: String
    (* Whether path names a file in memory, under root *)
    isMemory(path: String): Bool
    (* The text of the file in memory path, if it has been written *)
    read(path: String): maybe.T(String)
    write(path: String text: String): Ok
end
