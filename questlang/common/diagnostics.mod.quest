(* Quest Self-Hosted Compiler: Diagnostics Implementation *)

module diagnostics : Diagnostics
import
    ascii : Ascii
    stringOp = string : StringOp
    writer : Writer

    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/stringBuilder : util/StringBuilder

    questlang/common/location : questlang/common/Location
export
    Let Severity = Option
        fatal
        error
        warning
        info
    end

    Let Label = Tuple
        sp: location.Span
        message: String
        isPrimary: Bool
    end

    Let Diagnostic = Tuple
        severity: Severity
        message: String
        sp: location.Span
        labels: vector.T(Label)
        notes: vector.T(String)
        var help: maybe.T(String)
        var code: maybe.T(String)
        var trace: Array(String)
    end

    let make(sev: Severity msg: String sp: location.Span): Diagnostic =
        tuple
            let severity = sev
            let message = msg
            let sp = sp
            let labels = vector.new()
            let notes = vector.new()
            let var help = maybe.none()
            let var code = maybe.none()
            let var trace = array of :String end
        end

    let fatal(msg: String sp: location.Span): Diagnostic = make(option fatal of Severity end msg sp)

    let error(msg: String sp: location.Span): Diagnostic = make(option error of Severity end msg sp)

    let warning(msg: String sp: location.Span): Diagnostic = make(option warning of Severity end msg sp)

    let severity(d: Diagnostic): Severity = d.severity
    let message(d: Diagnostic): String = d.message
    let span(d: Diagnostic): location.Span = d.sp
    let labels(d: Diagnostic): vector.T(Label) = d.labels
    let notes(d: Diagnostic): vector.T(String) = d.notes
    let help(d: Diagnostic): maybe.T(String) = d.help
    let code(d: Diagnostic): maybe.T(String) = d.code

    let addLabel(d: Diagnostic sp: location.Span msg: String isPrimary: Bool): Ok =
        begin
            let l: Label = tuple
                let sp = sp
                let message = msg
                let isPrimary = isPrimary
            end
            vector.append(d.labels l)
        end

    let addNote(d: Diagnostic note: String): Ok = vector.append(d.notes note)

    let setHelp(d: Diagnostic h: String): Ok =
        begin
            d.help := maybe.some(h)
            ok
        end

    let setCode(d: Diagnostic c: String): Ok =
        begin
            d.code := maybe.some(c)
            ok
        end

    let setTrace(d: Diagnostic frames: Array(String)): Ok = d.trace := frames

    (* Appends traceback frame lines to sb, collapsing consecutive duplicate
     * frames into a repeat count *)
    let traceLines(sb: stringBuilder.T frames: Array(String)): Ok =
        begin
            let var i = 0
            while i < extent frames do
                let var j = i
                while {j < extent frames} andif stringOp.equal(frames[j] frames[i]) do j := j + 1 end
                stringBuilder.str(sb "  in ")
                stringBuilder.str(sb frames[i])
                stringBuilder.char(sb '\n')
                if {j - i} > 1 then
                    stringBuilder.str(sb "  ... ")
                    stringBuilder.str(sb frames[i])
                    stringBuilder.str(sb " repeated ")
                    stringBuilder.int(sb {j - i} - 1)
                    stringBuilder.str(sb " more times\n")
                end
                i := j
            end
        end

    let sources = tuple let maps = vector.new(:location.SourceMap) end

    (* A file registered again (each unit of a build that reads it) replaces its
     * earlier map *)
    let registerSource(sm: location.SourceMap): Ok =
        begin
            let var replaced = false
            for i = 0 upto {vector.length(sources.maps) - 1} do
                if stringOp.equal(location.file(vector.get(sources.maps i)) location.file(sm)) then
                    vector.set(sources.maps i sm)
                    replaced := true
                end
            end
            if not(replaced) then vector.append(sources.maps sm) end
        end

    (* The source map of a file, if registered, else sm *)
    let sourceOf(file: String sm: location.SourceMap): location.SourceMap =
        begin
            let var found = sm
            for i = 0 upto {vector.length(sources.maps) - 1} do
                let m = vector.get(sources.maps i)
                if stringOp.equal(location.file(m) file) then found := m end
            end
            found
        end

    let severityString(sev: Severity): String =
        case sev
            when fatal then "fatal error"
            when error then "error"
            when warning then "warning"
            when info then "info"
        end

    let format(d: Diagnostic sm0: location.SourceMap): String =
        begin
            let sb = stringBuilder.new()
            let sevStr = severityString(d.severity)
            let sp = d.sp
            let sm = sourceOf(sp.file sm0)
            let located = {stringOp.length(sp.file) > 0} andif {sp.startOffset >= 0}
            let pos = location.locate(sm if located then sp.startOffset else 0 end)
            if located then
                stringBuilder.str(sb sp.file)
                stringBuilder.char(sb ':')
                stringBuilder.int(sb pos.line)
                stringBuilder.char(sb ':')
                stringBuilder.int(sb pos.col)
                stringBuilder.str(sb ": ")
            end
            stringBuilder.str(sb sevStr)
            stringBuilder.str(sb ": ")
            stringBuilder.str(sb d.message)
            stringBuilder.char(sb '\n')

            let lineStr = if located then location.getLine(sm pos.line) else "" end
            let lineLen = stringOp.length(lineStr)
            if lineLen > 0 then
                stringBuilder.str(sb "    ")
                stringBuilder.str(sb lineStr)
                stringBuilder.char(sb '\n')

                let padCount = if pos.col > 1 then pos.col - 1 else 0 end
                let var spanLen = sp.endOffset - sp.startOffset
                if spanLen < 1 then spanLen := 1 end
                let maxLen = {lineLen - padCount}
                if {maxLen > 0} andif {spanLen > maxLen} then
                    spanLen := maxLen
                end
                stringBuilder.str(sb "    ")
                stringBuilder.repeat(sb ' ' padCount)
                stringBuilder.repeat(sb '^' spanLen)
                stringBuilder.char(sb '\n')
            end

            (* Format each secondary label using its own file's registered
             * source map, falling back to sm0 (the caller's map, not the
             * primary error's) if unregistered *)
            for i = 0 upto {vector.length(d.labels) - 1} do
                let label = vector.get(d.labels i)
                if not(label.isPrimary) then
                    let lsm = sourceOf(label.sp.file sm0)
                    let lpos = location.locate(lsm label.sp.startOffset)
                    let lline = location.getLine(lsm lpos.line)
                    if {lpos.line >= 1} andif {lpos.line <= location.lineCount(lsm)} then
                        let var dashes = label.sp.endOffset - label.sp.startOffset
                        if dashes < 1 then dashes := 1 end
                        stringBuilder.str(sb "  ::: ")
                        stringBuilder.str(sb label.sp.file)
                        stringBuilder.char(sb ':')
                        stringBuilder.int(sb lpos.line)
                        stringBuilder.char(sb ':')
                        stringBuilder.int(sb lpos.col)
                        stringBuilder.char(sb '\n')
                        stringBuilder.str(sb "    ")
                        stringBuilder.str(sb lline)
                        stringBuilder.char(sb '\n')
                        stringBuilder.str(sb "    ")
                        stringBuilder.repeat(sb ' ' if lpos.col > 1 then lpos.col - 1 else 0 end)
                        stringBuilder.repeat(sb '-' dashes)
                        if stringOp.length(label.message) > 0 then
                            stringBuilder.str(sb " note: ")
                            stringBuilder.str(sb label.message)
                        end
                        stringBuilder.char(sb '\n')
                    end
                end
            end

            (* A note's lines after its first are indented under it *)
            let noteCount = vector.length(d.notes)
            if noteCount > 0 then
                for i = 0 upto {noteCount - 1} do
                    let note = vector.get(d.notes i)
                    stringBuilder.str(sb "  = note: ")
                    for j = 0 upto {stringOp.length(note) - 1} do
                        let c = stringOp.getChar(note j)
                        if ascii.val(c) is 10 then stringBuilder.str(sb "\n          ")
                        else stringBuilder.char(sb c)
                        end
                    end
                    stringBuilder.char(sb '\n')
                end
            end

            if maybe.isSome(d.help) then
                stringBuilder.str(sb "  = help: ")
                stringBuilder.str(sb maybe.unwrap(d.help))
                stringBuilder.char(sb '\n')
            end
            traceLines(sb d.trace)

            stringBuilder.toString(sb)
        end

    let render(d: Diagnostic sm: location.SourceMap w: writer.T): Ok = writer.putString(w format(d sm))

    (* ======================================================================
     * Errors raised where they are found
     * ====================================================================== *)

    Let CompilerError = Tuple
        message: String
        offset: Int
        length: Int
        isFatal: Bool
        help: maybe.T(String)
        notes: vector.T(String)
        (* The file of the unit the error was raised in, once it propagates out
         * of it (the bootstrap's in_unit) *)
        file: maybe.T(String)
        silent: Bool
        labels: vector.T(Label)
    end

    let compilerError: Exception(CompilerError) = exception compilerError: CompilerError end

    (* The one place a CompilerError is built, so that a new field touches
     * only this function and the build workers' encoding of errors *)
    let errorOf(message: String offset: Int length: Int isFatal: Bool help: maybe.T(String) notes: vector.T(String)
            file: maybe.T(String) silent: Bool labels: vector.T(Label)): CompilerError =
        tuple
            let message = message
            let offset = offset
            let length = length
            let isFatal = isFatal
            let help = help
            let notes = notes
            let file = file
            let silent = silent
            let labels = labels
        end

    let errorAt(message: String offset: Int): CompilerError =
        errorOf(message offset 1 false maybe.none() vector.new() maybe.none() false vector.new())

    let fatalAt(message: String offset: Int): CompilerError =
        errorOf(message offset 1 true maybe.none() vector.new() maybe.none() false vector.new())

    let silentError: CompilerError = errorOf("" 0 1 false maybe.none() vector.new() maybe.none() true vector.new())

    let withHelp(e: CompilerError help: maybe.T(String)): CompilerError =
        errorOf(e.message e.offset e.length e.isFatal help e.notes e.file e.silent e.labels)

    let withNotes(e: CompilerError notes: Array(String)): CompilerError =
        errorOf(e.message e.offset e.length e.isFatal e.help vector.fromArray(notes) e.file e.silent e.labels)

    let locatedAt(e: CompilerError offset: Int length: Int file: maybe.T(String)): CompilerError =
        errorOf(e.message offset length e.isFatal e.help e.notes file e.silent e.labels)

    let inFile(e: CompilerError file: String): CompilerError =
        if maybe.isSome(e.file) then e else locatedAt(e e.offset e.length maybe.some(file)) end

    let atImport(e: CompilerError offset: Int length: Int file: String): CompilerError =
        if maybe.isNone(e.file) then
            (* Raised before the unit was read: located at the import *)
            if e.offset is 0 then
                locatedAt(e offset length maybe.some(file))
            else
                locatedAt(e e.offset e.length maybe.some(file))
            end
        elsif stringOp.equal(maybe.unwrap(e.file) file) then
            e
        else
            begin
                vector.append(e.labels tuple
                    let sp = location.span(file offset {offset + length})
                    let message = "imported here"
                    let isPrimary = false
                end)
                e
            end
        end

    let raiseError(A::TYPE e: CompilerError): A = raise compilerError with e end

    let fail(A::TYPE message: String offset: Int): A = raise compilerError with errorAt(message offset) end
    let failWithHelp(A::TYPE message: String offset: Int help: maybe.T(String)): A =
        raise compilerError with withHelp(errorAt(message offset) help) end

    let mainFrame = "<main>"
    let initFrameSuffix = ".<init>"
    let initFrame(moduleName: String): String = moduleName <> initFrameSuffix

    let frameName(enclosing: String binder: maybe.T(String)): String =
        begin
            let local = maybe.unwrapOr(binder "<anon>")
            let n = stringOp.length(enclosing)
            let k = stringOp.length(initFrameSuffix)
            if stringOp.equal(enclosing mainFrame) then
                local
            elsif {n >= k} andif stringOp.equal(stringOp.getSub(enclosing {n - k} k) initFrameSuffix) then
                stringOp.getSub(enclosing 0 {n - k}) <> "." <> local
            else
                enclosing <> "." <> local
            end
        end

    let errorDiagnostic(e: CompilerError file: String): Diagnostic =
        begin
            let sp = location.span(maybe.unwrapOr(e.file file) e.offset {e.offset + e.length})
            let d = if e.isFatal then fatal(e.message sp) else error(e.message sp) end
            if maybe.isSome(e.help) then setHelp(d maybe.unwrap(e.help)) end
            for i = 0 upto {vector.length(e.notes) - 1} do addNote(d vector.get(e.notes i)) end
            for i = 0 upto {vector.length(e.labels) - 1} do vector.append(d.labels vector.get(e.labels i)) end
            d
        end

    let warningDiagnostic(e: CompilerError file: String): Diagnostic =
        warning(e.message location.span(maybe.unwrapOr(e.file file) e.offset {e.offset + e.length}))
end
