(* Self-Hosted Quest Compiler: Diagnostic Model and Rendering *)

module diagnostics : Diagnostics
import
    questlang/common/location : questlang/common/Location
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/stringBuilder : util/StringBuilder
    writer : Writer
    stringOp = string : StringOp
    ascii : Ascii
export
    Let Severity = Option
        fatal
        error
        warning
        info
    end

    Let Label = Tuple
        sp: location.Span
        message: String
        isPrimary: Bool
    end

    Let Diagnostic = Tuple
        severity: Severity
        message: String
        sp: location.Span
        labels: vector.T(Label)
        notes: vector.T(String)
        var help: maybe.T(String)
        var code: maybe.T(String)
    end

    let make(sev: Severity msg: String sp: location.Span): Diagnostic =
        tuple
            let severity = sev
            let message = msg
            let sp = sp
            let labels = vector.new(:Label)
            let notes = vector.new(:String)
            let var help = maybe.none(:String)
            let var code = maybe.none(:String)
        end

    let fatal(msg: String sp: location.Span): Diagnostic =
        make(option fatal of Severity end msg sp)

    let error(msg: String sp: location.Span): Diagnostic =
        make(option error of Severity end msg sp)

    let warning(msg: String sp: location.Span): Diagnostic =
        make(option warning of Severity end msg sp)

    let info(msg: String sp: location.Span): Diagnostic =
        make(option info of Severity end msg sp)

    let severity(d: Diagnostic): Severity = d.severity
    let message(d: Diagnostic): String = d.message
    let span(d: Diagnostic): location.Span = d.sp
    let labels(d: Diagnostic): vector.T(Label) = d.labels
    let notes(d: Diagnostic): vector.T(String) = d.notes
    let help(d: Diagnostic): maybe.T(String) = d.help
    let code(d: Diagnostic): maybe.T(String) = d.code

    let addLabel(d: Diagnostic sp: location.Span msg: String isPrimary: Bool): Ok =
        begin
            let l: Label = tuple
                let sp = sp
                let message = msg
                let isPrimary = isPrimary
            end
            vector.append(:Label d.labels l)
        end

    let addNote(d: Diagnostic note: String): Ok =
        vector.append(:String d.notes note)

    let setHelp(d: Diagnostic h: String): Ok =
        begin
            d.help := maybe.some(:String h)
            ok
        end

    let setCode(d: Diagnostic c: String): Ok =
        begin
            d.code := maybe.some(:String c)
            ok
        end

    let sources = tuple let maps = vector.new(:location.SourceMap) end

    let registerSource(sm: location.SourceMap): Ok = vector.append(:location.SourceMap sources.maps sm)

    (* The source map of a file, if registered, else sm *)
    let sourceOf(file: String sm: location.SourceMap): location.SourceMap =
        begin
            let var found = sm
            for i = 0 upto {vector.length(:location.SourceMap sources.maps) - 1} do
                let m = vector.get(:location.SourceMap sources.maps i)
                if stringOp.equal(location.file(m) file) then found := m end
            end
            found
        end

    let severityString(sev: Severity): String =
        case sev
            when fatal then "fatal error"
            when error then "error"
            when warning then "warning"
            when info then "info"
        end

    let format(d: Diagnostic sm0: location.SourceMap): String =
        begin
            let sb = stringBuilder.new()
            let sevStr = severityString(d.severity)
            let sp = d.sp
            let sm = sourceOf(sp.file sm0)
            let located = {stringOp.length(sp.file) > 0} andif {sp.startOffset >= 0}
            let pos = location.locate(sm if located then sp.startOffset else 0 end)
            if located then
                sb.str(sp.file).char(':').int(pos.line).char(':').int(pos.col).str(": ")
            end
            sb.str(sevStr).str(": ").str(d.message).char('\n')

            let lineStr = if located then location.getLine(sm pos.line) else "" end
            let lineLen = stringOp.length(lineStr)
            if lineLen > 0 then
                sb.str("    ").str(lineStr).char('\n')

                let padCount = if pos.col > 1 then pos.col - 1 else 0 end
                let var spanLen = sp.endOffset - sp.startOffset
                if spanLen < 1 then spanLen := 1 end
                let maxLen = {lineLen - padCount}
                if {maxLen > 0} andif {spanLen > maxLen} then
                    spanLen := maxLen
                end
                sb.str("    ").repeat(' ' padCount).repeat('^' spanLen).char('\n')
            end

            (* Secondary labels, each in its own file (an import in the main file, say) *)
            for i = 0 upto {vector.length(:Label d.labels) - 1} do
                let label = vector.get(:Label d.labels i)
                if not(label.isPrimary) then
                    let lsm = sourceOf(label.sp.file sm)
                    let lpos = location.locate(lsm label.sp.startOffset)
                    let lline = location.getLine(lsm lpos.line)
                    if {lpos.line >= 1} andif {lpos.line <= location.lineCount(lsm)} then
                        let var dashes = label.sp.endOffset - label.sp.startOffset
                        if dashes < 1 then dashes := 1 end
                        sb.str("  ::: ").str(label.sp.file).char(':').int(lpos.line).char(':').int(lpos.col).char('\n')
                        sb.str("    ").str(lline).char('\n')
                        sb.str("    ").repeat(' ' if lpos.col > 1 then lpos.col - 1 else 0 end).repeat('-' dashes)
                        if stringOp.length(label.message) > 0 then sb.str(" note: ").str(label.message) end
                        sb.char('\n')
                    end
                end
            end

            (* A note's lines after its first are indented under it *)
            let noteCount = vector.length(:String d.notes)
            if noteCount > 0 then
                for i = 0 upto {noteCount - 1} do
                    let note = vector.get(:String d.notes i)
                    sb.str("  = note: ")
                    for j = 0 upto {stringOp.length(note) - 1} do
                        let c = stringOp.getChar(note j)
                        if ascii.val(c) is 10 then sb.str("\n          ") else sb.char(c) end
                    end
                    sb.char('\n')
                end
            end

            if maybe.isSome(:String d.help) then
                sb.str("  = help: ").str(maybe.unwrap(:String d.help)).char('\n')
            end

            sb.toString()
        end

    let render(d: Diagnostic sm: location.SourceMap w: writer.T): Ok =
        writer.putString(w format(d sm))

    (* =========================================================================
     * Quoting
     * ========================================================================= *)

    let hexDigit(n: Int): Char = stringOp.getChar("0123456789abcdef" n)

    (* Python's repr of a string: single quotes unless the string holds a single quote and no double quote *)
    (* =========================================================================
     * Errors raised where they are found
     * ========================================================================= *)

    Let CompilerError = Tuple
        message: String
        offset: Int
        length: Int
        isFatal: Bool
        help: maybe.T(String)
        notes: vector.T(String)
        (* The file of the unit the error was raised in, once it propagates out of it (the bootstrap's in_unit) *)
        file: maybe.T(String)
        silent: Bool
        labels: vector.T(Label)
    end

    let compilerError: Exception(CompilerError) = exception compilerError: CompilerError end

    let errorAt(message: String offset: Int): CompilerError =
        tuple
            let message = message
            let offset = offset
            let length = 1
            let isFatal = false
            let help = maybe.none(:String)
            let notes = vector.new(:String)
            let file = maybe.none(:String)
            let silent = false
            let labels = vector.new(:Label)
        end

    let silentError: CompilerError =
        tuple
            let message = ""
            let offset = 0
            let length = 1
            let isFatal = false
            let help = maybe.none(:String)
            let notes = vector.new(:String)
            let file = maybe.none(:String)
            let silent = true
            let labels = vector.new(:Label)
        end

    let inFile(e: CompilerError file: String): CompilerError =
        if maybe.isSome(:String e.file) then
            e
        else
            tuple
                let message = e.message
                let offset = e.offset
                let length = e.length
                let isFatal = e.isFatal
                let help = e.help
                let notes = e.notes
                let file = maybe.some(:String file)
                let silent = e.silent
                let labels = e.labels
            end
        end

    let atImport(e: CompilerError offset: Int length: Int file: String): CompilerError =
        if maybe.isNone(:String e.file) then
            (* Raised before the unit was read: located at the import *)
            let located = if e.offset is 0 then offset else e.offset end
            tuple
                let message = e.message
                let offset = located
                let length = if e.offset is 0 then length else e.length end
                let isFatal = e.isFatal
                let help = e.help
                let notes = e.notes
                let file = maybe.some(:String file)
                let silent = e.silent
                let labels = e.labels
            end
        elsif stringOp.equal(maybe.unwrap(:String e.file) file) then
            e
        else
            begin
                vector.append(:Label e.labels tuple
                    let sp = location.span(file offset {offset + length}) let message = "imported here"
                    let isPrimary = false
                end)
                e
            end
        end

    let raiseError(A::TYPE e: CompilerError): A = raise compilerError with e end

    let fail(A::TYPE message: String offset: Int): A = raise compilerError with errorAt(message offset) end

    let errorDiagnostic(e: CompilerError file: String): Diagnostic =
        begin
            let sp = location.span(maybe.unwrapOr(:String e.file file) e.offset {e.offset + e.length})
            let d = if e.isFatal then fatal(e.message sp) else error(e.message sp) end
            if maybe.isSome(:String e.help) then setHelp(d maybe.unwrap(:String e.help)) end
            for i = 0 upto {vector.length(:String e.notes) - 1} do addNote(d vector.get(:String e.notes i)) end
            for i = 0 upto {vector.length(:Label e.labels) - 1} do vector.append(:Label d.labels vector.get(:Label e.labels i)) end
            d
        end

    let pyRepr(s: String): String =
        begin
            let size = stringOp.length(s)
            let var hasSingle = false
            let var hasDouble = false
            for i = 0 upto {size - 1} do
                let c = stringOp.getChar(s i)
                if c is '\'' then hasSingle := true elsif c is '"' then hasDouble := true end
            end
            let quote = if hasSingle andif not(hasDouble) then '"' else '\'' end
            let b = stringBuilder.new()
            b.char(quote)
            for i = 0 upto {size - 1} do
                let c = stringOp.getChar(s i)
                let code = ascii.val(c)
                if c is '\\' then b.str("\\\\")
                elsif c is quote then b.char('\\').char(quote)
                elsif code is 10 then b.str("\\n")
                elsif code is 13 then b.str("\\r")
                elsif code is 9 then b.str("\\t")
                elsif {code < 32} orif {{code >= 127} andif {code <= 160}} orif {code is 173} then
                    (* Python's repr escapes the bytes that are not printable Latin-1 characters *)
                    b.str("\\x").char(hexDigit(code / 16)).char(hexDigit(code % 16))
                else b.char(c)
                end
            end
            b.char(quote).toString()
        end
end
