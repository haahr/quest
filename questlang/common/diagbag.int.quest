(* Quest Self-Hosted Compiler: Diagnostic Bag Interface
 *
 * A diagnostic bag collects the diagnostics of one compilation, in the order
 * they are found, so that a phase can report several errors and go on, and
 * the driver can print them all at the end (renderAll). It counts errors
 * (fatal ones included) and warnings; the driver runs each phase only while
 * the bag has no errors (hasErrors).
 *
 * An error after which a phase cannot go on (a syntax error, a fatal error
 * such as an internal one) is added and then raised as fatalError
 * (addStoppingError, addFatal); the caller that started the phase catches it,
 * and the diagnostic is already in the bag. The bootstrap counterpart is
 * DiagnosticSink in bootstrap/python/quest/diagnostics.py; docs/diagnostics.md
 * §3 compares the two *)

interface DiagBag
import
    questlang/common/location : questlang/common/Location
    questlang/common/diagnostics : questlang/common/Diagnostics
    collections/vector : collections/Vector
    writer : Writer
export
    (* Exception raised on unrecoverable fatal compiler errors *)
    fatalError: Exception(diagnostics.Diagnostic)

    (* Abstract diagnostic bag accumulator type *)
    T::TYPE

    (* Create a new empty diagnostic bag *)
    new(): T

    (* Add an existing diagnostic to the bag *)
    add(bag: T d: diagnostics.Diagnostic): Ok

    (* Construct and append an error diagnostic *)
    addError(bag: T sp: location.Span msg: String): Ok

    (* Construct and append a warning diagnostic *)
    addWarning(bag: T sp: location.Span msg: String): Ok

    (* Construct, append, and immediately raise a fatal error diagnostic *)
    addFatal(bag: T sp: location.Span msg: String): Ok

    (* Construct and append an error diagnostic, and raise fatalError with it:
     * an error after which the phase cannot go on, such as a syntax error *)
    addStoppingError(bag: T sp: location.Span msg: String): Ok

    (* True if any error or fatal diagnostic has been recorded *)
    hasErrors(bag: T): Bool

    (* Number of error and fatal diagnostics recorded *)
    errorCount(bag: T): Int

    (* Number of warning diagnostics recorded *)
    warningCount(bag: T): Int

    (* Total number of diagnostics recorded *)
    count(bag: T): Int

    (* Retrieve diagnostic by 0-indexed position *)
    get(bag: T idx: Int): diagnostics.Diagnostic

    (* Retrieve backing vector of all recorded diagnostics *)
    getAll(bag: T): vector.T(diagnostics.Diagnostic)

    (* Render all diagnostics in order to the given character writer *)
    renderAll(bag: T sm: location.SourceMap w: writer.T): Ok
end
