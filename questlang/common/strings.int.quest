(* Quest Self-Hosted Compiler: String Helpers Interface
 *
 * Provides string helpers needed by the compiler beyond lib/util/strutil.
 * They live here rather than in lib/ because the release compiler, which
 * builds stage 1 of this compiler, compiles against its own lib/. *)

interface Strings
export
    (* Whether s is one of xs *)
    isOneOf(s: String xs: Array(String)): Bool
    (* Whether c may be in a Quest name: a letter, a digit, or '_' *)
    isNameChar(c: Char): Bool
    (* Where the name that ends at offset in text begins: offset itself if no
     * name ends there (the kernel's and the language server's completions) *)
    nameStart(text: String offset: Int): Int
end
