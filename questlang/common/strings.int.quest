(* Quest Self-Hosted Compiler: String Helpers Interface
 *
 * What the compiler's modules ask of strings beyond lib/util/strutil's. They
 * are here rather than in lib/, since the release compiler, which builds this
 * compiler's first stage, compiles it against its own lib/. *)

interface Strings
export
    (* Whether s is one of xs *)
    isOneOf(s: String xs: Array(String)): Bool
end
