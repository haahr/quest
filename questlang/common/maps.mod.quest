(* Quest Self-Hosted Compiler: Keyed Maps and Sets Implementation *)

module maps : Maps
import
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/hashSet : collections/HashSet
    util/hash : util/Hash
export
    Def IntMap = Fun(V::TYPE) hashMap.T(Int V)
    Def StringMap = Fun(V::TYPE) hashMap.T(String V)
    Def IntSet = hashSet.T(Int)
    Def StringSet = hashSet.T(String)

    let intEqual(a: Int b: Int): Bool = a is b

    let newIntMap(V::TYPE): IntMap(V) = hashMap.new(:Int :V intEqual hash.int)
    let newStringMap(V::TYPE): StringMap(V) = hashMap.new(:String :V stringOp.equal hash.string)
    let newIntSet(): IntSet = hashSet.new(:Int intEqual hash.int)
    let newStringSet(): StringSet = hashSet.new(:String stringOp.equal hash.string)
end
