(* Quest Self-Hosted Compiler: SHA-256 Implementation
 *
 * Computes SHA-256 via util/digest (docs/libraries.md section 1.12), matching
 * the bootstrap's UTF-8 encoding. Characters in 128..255 are fed as their
 * two-byte UTF-8 sequences, while runs of ASCII characters below 128 are
 * added directly as substrings. *)

module sha256 : Sha256
import
    util/digest : util/Digest
    stringOp = string : StringOp
    ascii : Ascii
export
    let hexDigest(text: String): String =
        begin
            let d = digest.sha256()
            let length = stringOp.length(text)
            (* The characters from start up to i are below 128 and not yet
             * added *)
            let var start = 0
            for i = 0 upto {length - 1} do
                let c = ascii.val(stringOp.getChar(text i))
                if c >= 128 then
                    digest.addSub(d text start i - start)
                    digest.addChar(d ascii.char(192 + {c / 64}))
                    digest.addChar(d ascii.char(128 + {c % 64}))
                    start := i + 1
                end
            end
            digest.addSub(d text start length - start)
            digest.hex(digest.finish(d))
        end
end
