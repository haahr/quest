(* Quest Self-Hosted Compiler: File Paths Interface
 *
 * Paths as strings, and files' text: what modules/paths, which finds units,
 * and config/abi, which reads artifacts' records, share. (The bootstrap has
 * Python's pathlib.) *)

interface Files
import
    collections/vector : collections/Vector
    util/maybe : util/Maybe
export
    (* Whether a path begins at the root *)
    isAbsolute(p: String): Bool
    (* b relative to a (b itself if it is absolute) *)
    join(a: String b: String): String
    (* A path's components between separators, without empty ones *)
    components(p: String): vector.T(String)
    (* A path without . components, and with .. components cancelling the
     * ones before them *)
    normalize(p: String): String
    (* A path made absolute against the current directory, normalized *)
    absolute(p: String): String
    (* A file's text, if it is a file and can be read *)
    readText(file: String): maybe.T(String)
end
