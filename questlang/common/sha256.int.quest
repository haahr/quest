(* Quest Self-Hosted Compiler: SHA-256 Interface
 *
 * Computes the lowercase hexadecimal SHA-256 digest of a string, matching
 * Python's hashlib.sha256(text.encode("utf-8")).hexdigest() as used by
 * bootstrap/python/quest/repr/layout.py. Because Quest strings store one byte
 * per character (Latin-1 code points 0..255), bytes above 127 are
 * UTF-8-encoded as two bytes before hashing to match Python's behavior. *)

interface SHA256
export
    hexDigest(text: String): String
end
