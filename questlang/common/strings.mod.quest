(* Quest Self-Hosted Compiler: String Helpers Implementation *)

module strings : Strings
import
    stringOp = string : StringOp

    util/strutil : util/Strutil
export
    let isNameChar(c: Char): Bool = strutil.isAlnum(c) orif {c is '_'}

    let nameStart(text: String offset: Int): Int =
        begin
            let var start = offset
            while {start > 0} andif isNameChar(stringOp.getChar(text start - 1)) do start := start - 1 end
            start
        end

    let isOneOf(s: String xs: Array(String)): Bool =
        begin
            let var found = false
            for i = 0 upto {extent xs - 1} do if stringOp.equal(s xs[i]) then found := true end end
            found
        end
end
