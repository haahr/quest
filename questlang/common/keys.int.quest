(* Quest Self-Hosted Compiler: Integer Keys Interface
 *
 * Interns integer-sequence keys, assigning each distinct sequence a dense
 * integer ID (0, 1, 2, ...) in order of first insertion. Callers write a key
 * into the table's reusable buffer (start, then int, bool, and str) before
 * calling find or intern, so lookups allocate nothing. Strings are interned
 * to their own integer IDs so equal strings write equal integers. Because a
 * key does not tag which of int, bool, or str wrote each integer (the first
 * interned string writes 0, just like int(0) and bool(false)), callers must
 * encode enough structure before each value to disambiguate it, such as a tag
 * before an optional field. The bootstrap keys its tables by Python tuples;
 * building string keys instead is several times slower in the self-hosted
 * compiler. *)

interface Keys
import
    util/maybe : util/Maybe
export
    T::TYPE
    new(): T
    (* Starts a new key in the buffer *)
    start(k: T): Ok
    int(k: T n: Int): Ok
    bool(k: T v: Bool): Ok
    str(k: T s: String): Ok
    (* The number of the buffer's key, if it is interned *)
    find(k: T): maybe.T(Int)
    (* The number of the buffer's key, interning it if it is new *)
    intern(k: T): Int
    (* The number of keys interned *)
    size(k: T): Int
end
