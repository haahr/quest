(* Quest Self-Hosted Compiler: Diagnostic Bag Implementation *)

module diagbag : DiagBag
import
    writer : Writer

    collections/vector : collections/Vector

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/location : questlang/common/Location
export
    let fatalError: Exception(diagnostics.Diagnostic) = exception fatalError: diagnostics.Diagnostic end

    Let T = Tuple
        items: vector.T(diagnostics.Diagnostic)
        var errors: Int
        var warnings: Int
    end

    let new(): T =
        tuple
            let items = vector.new()
            let var errors = 0
            let var warnings = 0
        end

    let add(bag: T d: diagnostics.Diagnostic): Ok =
        begin
            vector.append(bag.items d)
            case diagnostics.severity(d)
                when fatal then
                    bag.errors := bag.errors + 1
                when error then
                    bag.errors := bag.errors + 1
                when warning then
                    bag.warnings := bag.warnings + 1
                else
                    ok
            end
            ok
        end

    let addError(bag: T sp: location.Span msg: String): Ok = add(bag diagnostics.error(msg sp))

    let addWarning(bag: T sp: location.Span msg: String): Ok = add(bag diagnostics.warning(msg sp))

    let addFatal(A::TYPE bag: T sp: location.Span msg: String): A =
        begin
            let d = diagnostics.fatal(msg sp)
            add(bag d)
            raise fatalError with d end
        end

    let addStoppingError(A::TYPE bag: T sp: location.Span msg: String): A =
        begin
            let d = diagnostics.error(msg sp)
            add(bag d)
            raise fatalError with d end
        end

    let addChecked(bag: T errors: Array(diagnostics.CompilerError) warnings: Array(diagnostics.CompilerError)
            file: String): Ok =
        begin
            for i = 0 upto {extent errors - 1} do add(bag diagnostics.errorDiagnostic(errors[i] file)) end
            for i = 0 upto {extent warnings - 1} do add(bag diagnostics.warningDiagnostic(warnings[i] file)) end
        end

    let hasErrors(bag: T): Bool = bag.errors > 0

    let errorCount(bag: T): Int = bag.errors

    let warningCount(bag: T): Int = bag.warnings

    let count(bag: T): Int = vector.length(bag.items)

    let get(bag: T idx: Int): diagnostics.Diagnostic = vector.get(bag.items idx)

    let renderAll(bag: T sm: location.SourceMap w: writer.T): Ok =
        begin
            let n = count(bag)
            if n > 0 then
                for i = 0 upto {n - 1} do
                    diagnostics.render(get(bag i) sm w)
                end
            end
            ok
        end

    let report(bag: T sm: location.SourceMap): Ok =
        begin
            writer.flush(writer.output)
            renderAll(bag sm writer.err)
            writer.flush(writer.err)
        end
end
