(* Quest Self-Hosted Compiler: Python Repr Interface
 *
 * Python's repr of strings, lists, and tuples, which the bootstrap's messages,
 * dumps, and layout keys print and this compiler must print the same: a parse
 * dump, a diagnostic naming the files searched, a static datum's key. *)

interface PyRepr
import
    collections/vector : collections/Vector
export
    (* A string as Python's repr writes it: in single quotes, or in double
     * quotes when it has a single quote and no double quote, with backslash
     * escapes for the quote, the backslash, and the characters Python does not
     * print (\n, \r, \t, else \xNN for a byte that decodes to an unprintable
     * Latin-1 character) *)
    str(s: String): String
    (* A list of strings, each written by str: ['a', 'b'] *)
    strList(xs: Array(String)): String
    (* A tuple and a list of items already written: (a, b), or (a,) for one
     * item; [a, b] *)
    tupleOf(items: vector.T(String)): String
    listOf(items: vector.T(String)): String
    (* A tuple or list of integers, open and close its brackets: (1, 2) or
     * [1, 2], and (1,) for a tuple of one *)
    ints(xs: Array(Int) open: String close: String): String
end
