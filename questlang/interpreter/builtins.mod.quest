(* Quest Self-Hosted Compiler: The Interpreter's Externals Implementation *)

module builtins : Builtins
import
    arrayOp : ArrayOp
    ascii : Ascii
    conv : Conv
    intOp = int : IntOp
    reader : Reader
    realOp = real : RealOp
    stringOp = string : StringOp
    system : System
    word : Word
    writer : Writer

    collections/hashMap : collections/HashMap
    io/readline : io/Readline
    os/fileStats : os/FileStats
    os/process : os/Process
    os/time : os/Time
    util/hash : util/Hash
    util/json : util/JSON
    util/maybe : util/Maybe
    util/stringBuilder : util/StringBuilder
    util/strutil : util/Strutil

    questlang/interpreter/fileCalls : questlang/interpreter/FileCalls
    questlang/interpreter/literals : questlang/interpreter/Literals
    questlang/interpreter/primitives : questlang/interpreter/Primitives
    tm = questlang/types/model : questlang/types/Model
    questlang/types/reduce : questlang/types/Reduce
    questlang/values/dynamicReader : questlang/values/DynamicReader
    questlang/values/dynamicWriter : questlang/values/DynamicWriter
    questlang/values/model : questlang/values/Model
export
    Let Value = model.Value
    Let Args = Array(Value)

    (* ======================================================================
     * 1. Arguments and results
     * ====================================================================== *)

    (* Raises an internal error for an argument v that is not of the runtime
     * type named what (QString, QInt, ...): a builtin called with a value of
     * the wrong type, which a checked program never does *)
    let wrong(A::TYPE what: String v: Value): A =
        model.internalError("Expected argument of type " <> what <> ", got " <> model.typeName(v) maybe.none())

    let str(v: Value): String = case v when vString with x then x.s else wrong("QString" v) end
    let int(v: Value): Int = case v when vInt with x then x.n else wrong("QInt" v) end
    let chr(v: Value): Char = case v when vChar with x then x.c else wrong("QChar" v) end
    let rl(v: Value): Real = case v when vReal with x then x.r else wrong("QReal" v) end
    let bool(v: Value): Bool = case v when vBool with x then x.b else wrong("QBool" v) end
    let wd(v: Value): word.T = case v when vWord with x then x.w else wrong("QWord" v) end
    let wr(v: Value): writer.T = case v when vWriter with x then x.w else wrong("QWriter" v) end
    let rd(v: Value): reader.T = case v when vReader with x then x.rd else wrong("QReader" v) end
    let sb(v: Value): stringBuilder.T = case v when vStringBuilder with x then x.sb else wrong("QStringBuilder" v) end
    let proc(v: Value): process.T = case v when vProcess with x then x.p else wrong("QProcess" v) end
    let arr(v: Value): Array(Value) = case v when vArray with x then x.a else wrong("QArray" v) end

    let unit = model.okValue
    let vString(s: String): Value = model.stringValue(s)
    let vInt(n: Int): Value = model.intValue(n)
    let vChar(c: Char): Value = model.charValue(c)
    let vReal(r: Real): Value = model.realValue(r)
    let vBool(b: Bool): Value = model.boolValue(b)
    let vWord(w: word.T): Value = option vWord of Value with let w = w end
    let vWriter(w: writer.T): Value = option vWriter of Value with let w = w end
    let vReader(r: reader.T): Value = option vReader of Value with let rd = r end
    let vException(e: model.ExceptionValue): Value = option vException of Value with let e = e end
    let vProcess(p: process.T): Value = option vProcess of Value with let p = p end
    let raisedError(v: Value): model.RunError = case v when vRaised with x then x.e else wrong("QRaised" v) end

    let strings(xs: Array(String)): Value =
        begin
            let a = array of(extent xs unit)
            for i = 0 upto {extent xs - 1} do a[i] := vString(xs[i]) end
            option vArray of Value with let a = a end
        end

    (* What system.run and process.wait give, as the interpreted tuple *)
    let waited(r: process.Result): Value =
        begin
            let label(name: String): maybe.T(String) = maybe.some(name)
            model.tupleValue(array of vInt(r.code) vString(r.stdout) vString(r.stderr) end
                    maybe.some(array of label("code") label("stdout") label("stderr") end))
        end

    let texts(xs: Array(Value)): Array(String) =
        begin
            let args = array of(extent xs "")
            for i = 0 upto {extent xs - 1} do args[i] := str(xs[i]) end
            args
        end

    let ran(xs: Array(Value)): Value = waited(system.run(texts(xs)))

    (* What quest_filestats_stat gives, as the interpreted tuple: the kind as a
     * number, -1 when the path names nothing *)
    let statted(path: String follow: Bool): Value =
        begin
            let found = if follow then fileStats.find(path) else fileStats.lfind(path) end
            let label(name: String): maybe.T(String) = maybe.some(name)
            let labels = maybe.some(array of label("kind") label("size") label("mode")
                label("accessTime") label("modifiedTime") label("changeTime") label("accessNs") label("modifiedNs")
                label("changeNs")
            end)
            if maybe.isNone(found) then
                model.tupleValue(array of vInt(~1) vInt(0) vInt(0) vReal(0.0) vReal(0.0) vReal(0.0) vInt(0) vInt(0)
                    vInt(0)
                end labels)
            else
                let s = maybe.unwrap(found)
                let kind = if s.kind?file then 0 elsif s.kind?directory then 1 elsif s.kind?symlink then 2 else 3 end
                model.tupleValue(array of vInt(kind) vInt(s.size) vInt(s.mode) vReal(s.accessTime)
                    vReal(s.modifiedTime) vReal(s.changeTime) vInt(s.accessNs) vInt(s.modifiedNs) vInt(s.changeNs)
                end labels)
            end
        end

    let processes(xs: Array(Value)): Array(process.T) =
        if extent xs is 0 then
            array of :process.T end
        else
            let ps = array of(extent xs proc(xs[0]))
            for i = 1 upto {extent xs - 1} do ps[i] := proc(xs[i]) end
            ps
        end

    (* fn, with the library's native errors raised as the interpreted ones *)
    let guarded(fn: All(args: Args) Value): All(args: Args) Value =
        fun(args: Args): Value
            try
                fn(args)
            when stringOp.error then model.raiseException(primitives.stringError maybe.none())
            when writer.error then model.raiseException(primitives.writerError maybe.none())
            when reader.error then model.raiseException(primitives.readerError maybe.none())
            when ascii.error then model.raiseException(primitives.asciiError maybe.none())
            when intOp.error then model.raiseException(primitives.intError maybe.none())
            when realOp.error then model.raiseException(primitives.realError maybe.none())
            when word.error then model.raiseException(primitives.wordError maybe.none())
            when arrayOp.error then model.raiseException(primitives.arrayOpError maybe.none())
            when system.error then model.raiseException(primitives.systemError maybe.none())
            when readline.error then model.raiseException(primitives.readlineError maybe.none())
            when readline.endOfInput then model.raiseException(primitives.readlineEndOfInput maybe.none())
            when readline.interrupted then model.raiseException(primitives.readlineInterrupted maybe.none())
            end

    (* ======================================================================
     * 2. The table
     * ====================================================================== *)

    let table = model.newFields()
    let fn(symbol: String f: All(args: Args) Value): Ok =
        begin hashMap.insert(table symbol model.builtinValue(symbol guarded(f))) ok end
    let value(symbol: String v: Value): Ok = begin hashMap.insert(table symbol v) ok end
    (* An exception, under its symbol and the symbol's name ((&quest_exc_x) and
     * quest_exc_x) *)
    let exc(name: String e: model.ExceptionValue): Ok =
        begin value("(&" <> name <> ")" vException(e)) value(name vException(e)) end

    (* The type of t's variant case tag, if t is known to be a variant type
     * with that case and the case has a value *)
    let variantCaseType(t: maybe.T(tm.Type) tag: String): maybe.T(tm.Type) =
        if maybe.isNone(t) then
            maybe.none()
        else
            let cases = reduce.variantCases(maybe.unwrap(t))
            if maybe.isNone(cases) then
                maybe.none()
            else
                let f = tm.variantGetField(maybe.unwrap(cases) tag)
                if maybe.isSome(f) then maybe.unwrap(f).type
                else maybe.none()
                end
            end
        end

    (* Returns the identity hash of what `is` compares at type t (the resolved
     * type argument of util/hash's identityHash), if known: a scalar's value,
     * or the object identity a value holds. Options and variants follow
     * primitives.sameAt, so that values it finds the same hash alike: an option
     * of a case without components hashes by its case name, and a variant
     * hashes by its case name and its value at the case's type
     * (docs/extensions.md, Options as Values, Variants as Values). Any other
     * option or variant, or one whose type is not known, hashes by its object
     * identity, never by components that could change after it is stored (a
     * var component). *)
    let rec identityHash(t: maybe.T(tm.Type) v: Value): word.T =
        case v
            when vInt with x then hash.identityHash(x.n)
            when vWord with x then hash.identityHash(x.w)
            when vBool with x then hash.identityHash(x.b)
            when vChar with x then hash.identityHash(x.c)
            when vReal with x then hash.identityHash(x.r ++ 0.0)
            when vOk then hash.identityHash(0)
            when vString with x then hash.identityHash(x.s)
            when vRecord with x then hash.identityHash(x.r)
            when vTuple with x then hash.identityHash(x.t)
            when vArray with x then hash.identityHash(x.a)
            when vVariant with x then
                if maybe.isNone(x.v.payload) then
                    hash.string(x.v.tag)
                else
                    let caseType = variantCaseType(t x.v.tag)
                    if maybe.isNone(caseType) then hash.identityHash(x.v)
                    else hash.combine(hash.string(x.v.tag) identityHash(caseType maybe.unwrap(x.v.payload)))
                    end
                end
            when vOption with x then
                let rule = if maybe.isNone(t) then maybe.none(:reduce.OptionIdentity)
                    else reduce.optionIdentity(maybe.unwrap(t)) end
                if maybe.isNone(rule) then
                    hash.identityHash(x.v)
                else
                    let r = maybe.unwrap(rule)
                    let var empty = false
                    for i = 0 upto {extent r.empty - 1} do
                        if stringOp.equal(r.empty[i] x.v.tag) then empty := true end
                    end
                    if empty then
                        hash.string(x.v.tag)
                    else
                        hash.identityHash(x.v)
                    end
                end
            when vClosure with x then hash.identityHash(x.c)
            when vBuiltin with x then hash.identityHash(x.b)
            when vRef with x then hash.identityHash(x.r)
            when vAuto with x then hash.identityHash(x.a)
            when vException with x then hash.identityHash(x.e)
            when vWriter with x then hash.identityHash(x.w)
            when vReader with x then hash.identityHash(x.rd)
            when vStringBuilder with x then hash.identityHash(x.sb)
            when vProcess with x then hash.identityHash(x.p)
            when vRaised with x then hash.identityHash(x.e)
            when vTypeValue with x then hash.identityHash(x.t)
        end

    let systemArgs = tuple let var args = array of :String end end
    let setSystemArgs(args: Array(String)): Ok = systemArgs.args := args

    let dynamicFailure(A::TYPE): A = model.raiseException(model.dynamicError maybe.none())

    (* A dynamic value's copy: a new auto value of the same components *)
    let dynamicCopy(v: Value): Value =
        case v
            when vAuto with x then
                case x.a.value
                    when vTuple with t then
                        let elements = array of(extent t.t.elements unit)
                        for i = 0 upto {extent elements - 1} do elements[i] := t.t.elements[i] end
                        option vAuto of Value with
                            let a = tuple let value = model.tupleValue(elements t.t.labels) let type = x.a.type end
                        end
                    else dynamicFailure()
                end
            else dynamicFailure()
        end

    let dynamicExtern(w: writer.T d: Value): Value =
        begin
            let text = dynamicWriter.encode(d)
            try writer.putString(w text) when writer.error then dynamicFailure(:Ok) end
            unit
        end

    (* Implements dynamic.intern(r): reads one dynamic value from r (as
     * dynamic.extern writes it) and no further (via json.read, since a reader
     * may hold several documents in a row), then decodes it via
     * dynamicReader.decodeDocument (which handles @id and @ref for shared
     * objects). Raises dynamic.error for a closed reader, truncated or
     * non-JSON input, a failed read, or a document that does not decode. *)
    let dynamicIntern(r: reader.T): Value =
        dynamicReader.decodeDocument(
                try json.read(r json.parsingDynamic)
                when reader.error then dynamicFailure()
                when json.error then dynamicFailure()
                end)

    (* Populates table during module initialization with the externals the
     * interpreter provides, keyed by C symbol (all except quest_system_args,
     * which resolveExternal constructs on demand). The binding itself is never
     * read. *)
    let filled =
        begin
            (* Writer *)
            exc("quest_exc_writer_error" primitives.writerError)
            value("quest_writer_output" vWriter(writer.output))
            value("quest_writer_err" vWriter(writer.err))
            fn("quest_writer_file" fun(a: Args): Value vWriter(writer.file(str(a[0]))))
            fn("quest_writer_put_string" fun(a: Args): Value begin writer.putString(wr(a[0]) str(a[1])) unit end)
            fn("quest_writer_put_char" fun(a: Args): Value begin writer.putChar(wr(a[0]) chr(a[1])) unit end)
            fn("quest_writer_put_substring" fun(a: Args): Value
                begin writer.putSubString(wr(a[0]) str(a[1]) int(a[2]) int(a[3])) unit end)
            fn("quest_writer_flush" fun(a: Args): Value begin writer.flush(wr(a[0])) unit end)
            fn("quest_writer_close" fun(a: Args): Value begin writer.close(wr(a[0])) unit end)

            (* Reader *)
            exc("quest_exc_reader_error" primitives.readerError)
            value("quest_reader_input" vReader(reader.input))
            fn("quest_reader_file" fun(a: Args): Value vReader(reader.file(str(a[0]))))
            fn("quest_reader_more" fun(a: Args): Value vBool(reader.more(rd(a[0]))))
            fn("quest_reader_ready" fun(a: Args): Value vInt(reader.ready(rd(a[0]))))
            fn("quest_reader_get_char" fun(a: Args): Value vChar(reader.getChar(rd(a[0]))))
            fn("quest_reader_get_string" fun(a: Args): Value vString(reader.getString(rd(a[0]) int(a[1]))))
            fn("quest_reader_get_substring" fun(a: Args): Value
                begin reader.getSubString(rd(a[0]) str(a[1]) int(a[2]) int(a[3])) unit end)
            fn("quest_reader_close" fun(a: Args): Value begin reader.close(rd(a[0])) unit end)

            (* Conv and Ascii *)
            exc("quest_exc_ascii_error" primitives.asciiError)
            fn("quest_ascii_char" fun(a: Args): Value vChar(ascii.char(int(a[0]))))
            fn("quest_ascii_val" fun(a: Args): Value vInt(ascii.val(chr(a[0]))))

            (* IntOp and RealOp *)
            exc("quest_exc_int_error" primitives.intError)
            value("QUEST_INT_MIN" vInt(intOp.minInt))
            value("QUEST_INT_MAX" vInt(intOp.maxInt))
            exc("quest_exc_real_error" primitives.realError)
            value("QUEST_REAL_MIN" vReal(realOp.minReal))
            value("QUEST_REAL_MAX" vReal(realOp.maxReal))
            value("QUEST_REAL_POS_EPSILON" vReal(realOp.posEpsilon))
            value("QUEST_REAL_NEG_EPSILON" vReal(realOp.negEpsilon))
            value("QUEST_REAL_E" vReal(realOp.e))
            value("QUEST_REAL_PI" vReal(realOp.pi))
            value("QUEST_REAL_INFINITY" vReal(realOp.infinity))
            fn("quest_real_from_int" fun(a: Args): Value vReal(realOp.int(int(a[0]))))
            fn("quest_real_floor" fun(a: Args): Value vInt(realOp.floor(rl(a[0]))))
            fn("quest_real_round" fun(a: Args): Value vInt(realOp.round(rl(a[0]))))
            fn("quest_real_log" fun(a: Args): Value vReal(realOp.log(rl(a[0]))))
            fn("quest_real_div" fun(a: Args): Value vReal(realOp.div(rl(a[0]) rl(a[1]))))
            fn("quest_real_exp" fun(a: Args): Value vReal(realOp.exp(rl(a[0]) rl(a[1]))))
            fn("quest_real_sqrt" fun(a: Args): Value vReal(realOp.sqrt(rl(a[0]))))
            fn("quest_real_sin" fun(a: Args): Value vReal(realOp.sin(rl(a[0]))))
            fn("quest_real_cos" fun(a: Args): Value vReal(realOp.cos(rl(a[0]))))
            fn("quest_real_tan" fun(a: Args): Value vReal(realOp.tan(rl(a[0]))))
            fn("quest_real_asin" fun(a: Args): Value vReal(realOp.asin(rl(a[0]))))
            fn("quest_real_acos" fun(a: Args): Value vReal(realOp.acos(rl(a[0]))))
            fn("quest_real_atan" fun(a: Args): Value vReal(realOp.atan(rl(a[0]))))
            fn("quest_real_atan2" fun(a: Args): Value vReal(realOp.atan2(rl(a[0]) rl(a[1]))))
            fn("quest_real_exponential" fun(a: Args): Value vReal(realOp.exponential(rl(a[0]))))
            fn("quest_real_sinh" fun(a: Args): Value vReal(realOp.sinh(rl(a[0]))))
            fn("quest_real_cosh" fun(a: Args): Value vReal(realOp.cosh(rl(a[0]))))
            fn("quest_real_tanh" fun(a: Args): Value vReal(realOp.tanh(rl(a[0]))))
            fn("quest_real_ceil" fun(a: Args): Value vInt(realOp.ceil(rl(a[0]))))
            fn("quest_real_trunc" fun(a: Args): Value vInt(realOp.trunc(rl(a[0]))))
            fn("quest_real_format" fun(a: Args): Value vString(realOp.format(rl(a[0]) chr(a[1]) int(a[2]))))

            (* StringOp *)
            exc("quest_exc_string_error" primitives.stringError)
            fn("quest_string_alloc" fun(a: Args): Value vString(stringOp.new(int(a[0]) chr(a[1]))))
            fn("quest_string_length" fun(a: Args): Value vInt(stringOp.length(str(a[0]))))
            fn("quest_string_get_char" fun(a: Args): Value vChar(stringOp.getChar(str(a[0]) int(a[1]))))
            fn("quest_string_set_char" fun(a: Args): Value
                begin stringOp.setChar(str(a[0]) int(a[1]) chr(a[2])) unit end)
            fn("quest_string_freeze" fun(a: Args): Value begin literals.freeze(str(a[0])) unit end)
            fn("quest_string_get_sub" fun(a: Args): Value vString(stringOp.getSub(str(a[0]) int(a[1]) int(a[2]))))
            fn("quest_string_set_sub" fun(a: Args): Value
                begin stringOp.setSub(str(a[0]) int(a[1]) str(a[2]) int(a[3]) int(a[4])) unit end)
            fn("quest_string_concat" fun(a: Args): Value vString(stringOp.cat(str(a[0]) str(a[1]))))
            fn("quest_string_cat_sub" fun(a: Args): Value
                vString(stringOp.catSub(str(a[0]) int(a[1]) int(a[2]) str(a[3]) int(a[4]) int(a[5]))))
            fn("quest_string_conc" fun(a: Args): Value
                begin
                    let parts = arr(a[0])
                    let ss = array of(extent parts "")
                    for i = 0 upto {extent parts - 1} do ss[i] := str(parts[i]) end
                    vString(stringOp.conc(ss))
                end)
            fn("quest_string_equal" fun(a: Args): Value vBool(stringOp.equal(str(a[0]) str(a[1]))))
            fn("quest_string_equal_sub" fun(a: Args): Value
                vBool(stringOp.equalSub(str(a[0]) int(a[1]) int(a[2]) str(a[3]) int(a[4]) int(a[5]))))
            fn("quest_string_precedes" fun(a: Args): Value vBool(stringOp.precedes(str(a[0]) str(a[1]))))
            fn("quest_string_precedes_sub" fun(a: Args): Value
                vBool(stringOp.precedesSub(str(a[0]) int(a[1]) int(a[2]) str(a[3]) int(a[4]) int(a[5]))))
            (* strutil.tryToReal has checked the syntax, as nativeToReal's
             * callers do *)
            fn("quest_strutil_to_real" fun(a: Args): Value vReal(maybe.unwrap(strutil.tryToReal(str(a[0])))))

            (* StringBuilder: an interpreted builder is one of the host's,
             * whose functions are the natives' *)
            fn("quest_sb_new" fun(a: Args): Value option vStringBuilder of Value with let sb = stringBuilder.new() end)
            fn("quest_sb_append_string" fun(a: Args): Value begin stringBuilder.str(sb(a[0]) str(a[1])) unit end)
            fn("quest_sb_append_string_shared" fun(a: Args): Value
                begin stringBuilder.strShared(sb(a[0]) str(a[1])) unit end)
            fn("quest_sb_append_char" fun(a: Args): Value begin stringBuilder.char(sb(a[0]) chr(a[1])) unit end)
            fn("quest_sb_append_int" fun(a: Args): Value begin stringBuilder.int(sb(a[0]) int(a[1])) unit end)
            fn("quest_sb_append_sub" fun(a: Args): Value
                begin stringBuilder.sub(sb(a[0]) str(a[1]) int(a[2]) int(a[3])) unit end)
            fn("quest_sb_append_repeat" fun(a: Args): Value
                begin stringBuilder.repeat(sb(a[0]) chr(a[1]) int(a[2])) unit end)
            fn("quest_sb_clear" fun(a: Args): Value begin stringBuilder.clear(sb(a[0])) unit end)
            fn("quest_sb_length" fun(a: Args): Value vInt(stringBuilder.length(sb(a[0]))))
            fn("quest_sb_to_string" fun(a: Args): Value vString(stringBuilder.toString(sb(a[0]))))

            (* ArrayOp *)
            exc("quest_exc_arrayOp_error" primitives.arrayOpError)
            fn("quest_array_size" fun(a: Args): Value vInt(extent arr(a[0])))

            (* Word and Hash *)
            exc("quest_exc_word_error" primitives.wordError)
            fn("quest_word_not_bits" fun(a: Args): Value vWord(word.notBits(wd(a[0]))))
            fn("quest_word_and_bits" fun(a: Args): Value vWord(word.andBits(wd(a[0]) wd(a[1]))))
            fn("quest_word_or_bits" fun(a: Args): Value vWord(word.orBits(wd(a[0]) wd(a[1]))))
            fn("quest_word_xor_bits" fun(a: Args): Value vWord(word.xorBits(wd(a[0]) wd(a[1]))))
            fn("quest_word_shift_val" fun(a: Args): Value vWord(word.shift(wd(a[0]) int(a[1]))))
            fn("quest_word_rotate_val" fun(a: Args): Value vWord(word.rotate(wd(a[0]) int(a[1]))))
            fn("quest_word_pop_count_val" fun(a: Args): Value vInt(word.popCount(wd(a[0]))))
            fn("quest_word_count_leading_zeros_val" fun(a: Args): Value vInt(word.countLeadingZeros(wd(a[0]))))
            fn("quest_word_count_trailing_zeros_val" fun(a: Args): Value vInt(word.countTrailingZeros(wd(a[0]))))
            fn("quest_word_add" fun(a: Args): Value vWord(word.add(wd(a[0]) wd(a[1]))))
            fn("quest_word_sub" fun(a: Args): Value vWord(word.sub(wd(a[0]) wd(a[1]))))
            fn("quest_word_mul" fun(a: Args): Value vWord(word.mul(wd(a[0]) wd(a[1]))))
            fn("quest_word_mul_hi" fun(a: Args): Value vWord(word.mulHi(wd(a[0]) wd(a[1]))))
            fn("quest_word_div_val" fun(a: Args): Value vWord(word.div(wd(a[0]) wd(a[1]))))
            fn("quest_word_mod_val" fun(a: Args): Value vWord(word.mod(wd(a[0]) wd(a[1]))))
            fn("quest_word_to_int" fun(a: Args): Value vInt(word.toInt(wd(a[0]))))
            fn("quest_word_from_int" fun(a: Args): Value vWord(word.fromInt(int(a[0]))))
            fn("quest_word_lt" fun(a: Args): Value vBool(word.lt(wd(a[0]) wd(a[1]))))
            fn("quest_word_le" fun(a: Args): Value vBool(word.le(wd(a[0]) wd(a[1]))))
            fn("quest_word_gt" fun(a: Args): Value vBool(word.gt(wd(a[0]) wd(a[1]))))
            fn("quest_word_ge" fun(a: Args): Value vBool(word.ge(wd(a[0]) wd(a[1]))))
            fn("quest_word_to_real_val" fun(a: Args): Value vReal(word.toReal(wd(a[0]))))
            fn("quest_word_from_real_val" fun(a: Args): Value vWord(word.fromReal(rl(a[0]))))
            fn("quest_identity_hash" fun(a: Args): Value vWord(identityHash(maybe.none() a[0])))

            (* System *)
            exc("quest_exc_system_error" primitives.systemError)
            fn("quest_system_exit" fun(a: Args): Value begin system.sysexit(int(a[0])) unit end)
            fn("quest_system_getenv" fun(a: Args): Value vString(system.getEnv(str(a[0]))))
            fn("quest_system_file_exists" fun(a: Args): Value vBool(system.fileExists(str(a[0]))))
            fn("quest_system_is_file" fun(a: Args): Value vBool(system.isFile(str(a[0]))))
            fn("quest_system_is_directory" fun(a: Args): Value vBool(system.isDirectory(str(a[0]))))
            fn("quest_system_make_directory" fun(a: Args): Value begin system.makeDirectory(str(a[0])) unit end)
            fn("quest_system_remove_file" fun(a: Args): Value begin system.removeFile(str(a[0])) unit end)
            fn("quest_system_remove_directory" fun(a: Args): Value begin system.removeDirectory(str(a[0])) unit end)
            fn("quest_system_rename_file" fun(a: Args): Value begin system.renameFile(str(a[0]) str(a[1])) unit end)
            fn("quest_system_current_directory" fun(a: Args): Value vString(system.currentDirectory()))
            fn("quest_system_change_directory" fun(a: Args): Value begin system.changeDirectory(str(a[0])) unit end)
            fn("quest_system_list_directory" fun(a: Args): Value strings(system.listDirectory(str(a[0]))))
            fn("quest_system_run" fun(a: Args): Value ran(arr(a[0])))
            fn("quest_system_is_terminal" fun(a: Args): Value vBool(system.isTerminal(int(a[0]))))
            (* os/fileStats *)
            fn("quest_filestats_stat" fun(a: Args): Value statted(str(a[0]) bool(a[1])))
            (* os/files *)
            fn("quest_files_remove" fun(a: Args): Value vInt(fileCalls.remove(str(a[0]))))
            fn("quest_files_remove_directory" fun(a: Args): Value vInt(fileCalls.removeDirectory(str(a[0]))))
            fn("quest_files_rename" fun(a: Args): Value vInt(fileCalls.rename(str(a[0]) str(a[1]))))
            fn("quest_files_make_directory" fun(a: Args): Value vInt(fileCalls.makeDirectory(str(a[0]) int(a[1]))))
            fn("quest_files_create_new" fun(a: Args): Value vInt(fileCalls.createNew(str(a[0]) int(a[1]))))
            fn("quest_files_list" fun(a: Args): Value strings(fileCalls.list(str(a[0]))))
            fn("quest_files_symlink" fun(a: Args): Value vInt(fileCalls.symlink(str(a[0]) str(a[1]))))
            fn("quest_files_read_link" fun(a: Args): Value vString(fileCalls.readLink(str(a[0]))))
            fn("quest_files_set_mode" fun(a: Args): Value vInt(fileCalls.setMode(str(a[0]) int(a[1]))))
            fn("quest_files_set_times" fun(a: Args): Value
                vInt(fileCalls.setTimes(str(a[0]) int(a[1]) int(a[2]))))
            fn("quest_files_last_status" fun(a: Args): Value vInt(fileCalls.lastStatus()))
            (* os/time *)
            fn("quest_time_now_ns" fun(a: Args): Value vInt(time.nowInNanoseconds()))
            fn("quest_time_ticks_ns" fun(a: Args): Value vInt(time.ticks()))
            fn("quest_time_cpu_ns" fun(a: Args): Value vInt(time.cpuTimeInNanoseconds()))
            fn("quest_time_sleep_ns" fun(a: Args): Value begin time.sleepNanoseconds(int(a[0])) unit end)
            fn("quest_time_local_offset" fun(a: Args): Value vInt(time.localOffsetInSeconds(int(a[0]))))
            (* os/process *)
            fn("quest_process_spawn" fun(a: Args): Value vProcess(process.spawn(texts(arr(a[0])))))
            fn("quest_process_spawn_in" fun(a: Args): Value vProcess(process.spawnIn(texts(arr(a[0])) str(a[1]))))
            fn("quest_process_pid" fun(a: Args): Value vInt(process.pid(proc(a[0]))))
            fn("quest_process_is_done" fun(a: Args): Value vBool(process.isDone(proc(a[0]))))
            fn("quest_process_wait" fun(a: Args): Value waited(process.wait(proc(a[0]))))
            fn("quest_process_wait_any" fun(a: Args): Value vInt(process.waitAny(processes(arr(a[0])))))
            fn("quest_process_kill" fun(a: Args): Value begin process.kill(proc(a[0]) int(a[1])) unit end)

            (* raised *)
            fn("quest_raised_reraise" fun(a: Args): Value raise model.runError with raisedError(a[0]) end)

            (* io/readline *)
            exc("quest_exc_readline_error" primitives.readlineError)
            exc("quest_exc_readline_end_of_input" primitives.readlineEndOfInput)
            exc("quest_exc_readline_interrupted" primitives.readlineInterrupted)
            fn("quest_readline_editing" fun(a: Args): Value vBool(readline.editing()))
            fn("quest_readline_read_line" fun(a: Args): Value vString(readline.readLine(str(a[0]))))
            fn("quest_readline_add_history" fun(a: Args): Value begin readline.addHistory(str(a[0])) unit end)
            fn("quest_readline_read_history" fun(a: Args): Value begin readline.readHistory(str(a[0])) unit end)
            fn("quest_readline_write_history" fun(a: Args): Value
                begin readline.writeHistory(str(a[0]) int(a[1])) unit end)

            (* Dynamic *)
            exc("quest_exc_dynamic_error" model.dynamicError)
            fn("quest_dynamic_copy" fun(a: Args): Value dynamicCopy(a[0]))
            fn("quest_dynamic_intern" fun(a: Args): Value dynamicIntern(rd(a[0])))
            fn("quest_dynamic_extern" fun(a: Args): Value dynamicExtern(wr(a[0]) a[1]))
            ok
        end

    let resolveExternal(symbol: String): Value =
        if stringOp.equal(symbol "quest_system_args") then
            strings(systemArgs.args)
        else
            let found = hashMap.get(table symbol)
            if maybe.isNone(found) then
                model.internalError(:Value "Undefined external symbol '" <> symbol <> "' in interpreter" maybe.none())
            end
            maybe.unwrap(found)
        end
    let callExternal(symbol: String types: Array(tm.Type) args: Args): Value =
        if stringOp.equal(symbol "quest_identity_hash") andif extent types is 1 then
            vWord(identityHash(maybe.some(types[0]) args[0]))
        else
            case resolveExternal(symbol)
                when vBuiltin with b then b.b.fn(args)
                else resolveExternal(symbol)
            end
        end
end
