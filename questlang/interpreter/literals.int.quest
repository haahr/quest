(* Quest Self-Hosted Compiler: The Interpreters' String Literals Interface
 *
 * A string literal is one read-only string, the same object at every
 * evaluation (docs/strings-plan.md section 5). Compiled code's literals are
 * static and marked so; the interpreters' are the strings the program's text
 * holds, which they mark as they first evaluate them. *)

interface Literals
export
    (* Marks s read-only, as compiled code's literals are: string.setChar and
     * string.setSub then raise string.error on it *)
    freeze(s: String): Ok
end
