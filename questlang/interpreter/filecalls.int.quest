(* Quest Self-Hosted Compiler: The Interpreters' os/files Calls Interface
 *
 * os/files' primitives, which its module keeps private, called directly as
 * the runtime gives them (docs/files-plan.md section 4), so that the
 * interpreters' builtins give the interpreted module what the compiled one
 * gets: 0 or a negative status from each, and the status kept by list and
 * readLink. *)

interface FileCalls
export
    remove(path: String): Int
    removeDirectory(path: String): Int
    rename(from: String to: String): Int
    makeDirectory(path: String mode: Int): Int
    createNew(path: String mode: Int): Int
    list(path: String): Array(String)
    symlink(target: String path: String): Int
    readLink(path: String): String
    setMode(path: String mode: Int): Int
    setTimes(path: String accessNs: Int modifiedNs: Int): Int
    lastStatus(): Int
end
