(* Quest Self-Hosted Compiler: The Interpreter's Primitive Operations
 * Implementation *)

module primitives : Primitives
import
    questlang/values/model : questlang/values/Model
    tm = questlang/types/model : questlang/types/Model
    questlang/types/canonical : questlang/types/Canonical
    util/maybe : util/Maybe
    stringOp = string : StringOp
    intOp = int : IntOp
    realOp = real : RealOp
export
    let arrayOpError = model.exceptionValue("arrayOp.error")
    let writerError = model.exceptionValue("writer.error")
    let readerError = model.exceptionValue("reader.error")
    let asciiError = model.exceptionValue("ascii.error")
    let intError = model.exceptionValue("int.error")
    let realError = model.exceptionValue("real.error")
    let wordError = model.exceptionValue("word.error")
    let stringError = model.exceptionValue("string.error")
    let systemError = model.exceptionValue("system.error")
    let readlineError = model.exceptionValue("readline.error")
    let readlineEndOfInput = model.exceptionValue("readline.endOfInput")
    let readlineInterrupted = model.exceptionValue("readline.interrupted")
    let variantError = model.exceptionValue("variant.tagMismatch")
    let stackOverflow = model.exceptionValue("stack.overflow")
    let maxCallDepth = 1000

    let intArithmetic(op: String a: Int b: Int offset: maybe.T(Int)): Int =
        try
            if stringOp.equal(op "+") then a + b
            elsif stringOp.equal(op "-") then a - b
            elsif stringOp.equal(op "*") then a * b
            elsif stringOp.equal(op "/") then a / b
            elsif stringOp.equal(op "mod") orif stringOp.equal(op "%") then a % b
            else model.internalError(:Int "Unknown integer arithmetic operator '" <> op <> "'" offset)
            end
        when intOp.error then
            model.raiseException(:Int intError offset)
        end

    let intRelational(op: String a: Int b: Int offset: maybe.T(Int)): Bool =
        if stringOp.equal(op "<") then a < b
        elsif stringOp.equal(op "<=") then a <= b
        elsif stringOp.equal(op ">") then a > b
        elsif stringOp.equal(op ">=") then a >= b
        else model.internalError(:Bool "Unknown integer relational operator '" <> op <> "'" offset)
        end

    let realArithmetic(op: String a: Real b: Real offset: maybe.T(Int)): Real =
        try
            if stringOp.equal(op "++") then a ++ b
            elsif stringOp.equal(op "--") then a -- b
            elsif stringOp.equal(op "**") then a ** b
            elsif stringOp.equal(op "//") then a // b
            elsif stringOp.equal(op "^^") then a ^^ b
            else model.internalError(:Real "Unknown real arithmetic operator '" <> op <> "'" offset)
            end
        when realOp.error then
            model.raiseException(:Real realError offset)
        end

    let realRelational(op: String a: Real b: Real offset: maybe.T(Int)): Bool =
        if stringOp.equal(op "<<") then a << b
        elsif stringOp.equal(op "<<=") then a <<= b
        elsif stringOp.equal(op ">>") then a >> b
        elsif stringOp.equal(op ">>=") then a >>= b
        else model.internalError(:Bool "Unknown real relational operator '" <> op <> "'" offset)
        end

    let rec sameAt(t: tm.Type v1: model.Value v2: model.Value): Bool =
        model.same(v1 v2) orif case v1
            when vOption with x then
                case v2
                    when vOption with y then
                        if stringOp.equal(x.v.tag y.v.tag) then
                            let rule = canonical.optionIdentity(t)
                            if maybe.isNone(:canonical.OptionIdentity rule) then
                                false
                            else
                                let r = maybe.unwrap(:canonical.OptionIdentity rule)
                                let var empty = false
                                for i = 0 upto {extent r.empty - 1} do
                                    if stringOp.equal(r.empty[i] x.v.tag) then empty := true end
                                end
                                if empty then
                                    true
                                elsif maybe.isSome(:String r.single) andif stringOp.equal(maybe.unwrap(:String r.single) x.v.tag)
                                    andif maybe.isSome(:model.Value x.v.payload) andif maybe.isSome(:model.Value y.v.payload) then
                                    case maybe.unwrap(:model.Value x.v.payload)
                                        when vTuple with a then
                                            case maybe.unwrap(:model.Value y.v.payload)
                                                when vTuple with b then
                                                    sameAt(maybe.unwrap(:tm.Type r.component) a.t.elements[0] b.t.elements[0])
                                                else false
                                            end
                                        else false
                                    end
                                else
                                    false
                                end
                            end
                        else
                            false
                        end
                    else false
                end
            else false
        end
end
