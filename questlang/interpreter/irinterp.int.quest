(* Quest Self-Hosted Compiler: The IR Interpreter Interface
 *
 * Interprets the compiler's intermediate representation (IR) as a test oracle
 * for lowering and optimization passes, so the test runner can compare its
 * output against the tree-walking interpreter's (docs/testing.md section 2.3,
 * the run_ir phases). The counterpart is
 * bootstrap/python/quest/interpreter/ir_interp.py.
 *
 * Values use the tree-walking interpreter's representation
 * (questlang/values/model), and imported modules are loaded and run by the
 * tree-walker; functions from either interpreter can call the other because an
 * IR closure is wrapped as a builtin for the tree-walker. Once the describe
 * pass has attached run-time type descriptors to IR operations, the
 * interpreter evaluates each descriptor and checks that it matches the type it
 * stands for. *)

interface IrInterp
import
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/values/model : questlang/values/Model
export
    (* IR the interpreter cannot run (a malformed unit, not an error in the
     * program) *)
    irInterpreterError: Exception(String)

    (* Runs a unit, in the tree-walker's frame f: its imports, its modules'
     * initializers, then its main body *)
    runUnit(unit: nodes.Unit f: model.Frame): Ok
end
