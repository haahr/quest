(* Quest Self-Hosted Compiler: The Interpreter's Primitive Operations Interface
 *
 * Provides the standard library's error exceptions and integer and real
 * arithmetic and comparisons with the same semantics as compiled code,
 * matching bootstrap/python/quest/interpreter/primitives.py. Because this
 * interpreter is itself compiled Quest, it delegates to the host's native
 * operations and converts native library exceptions (intOp.error,
 * realOp.error) into their interpreted counterparts. *)

interface Primitives
import
    util/maybe : util/Maybe

    tm = questlang/types/model : questlang/types/Model
    questlang/values/model : questlang/values/Model
export
    (* The standard library's exceptions, which its interpreted modules' error
     * values are (builtins) *)
    arrayOpError: model.ExceptionValue
    writerError: model.ExceptionValue
    readerError: model.ExceptionValue
    asciiError: model.ExceptionValue
    intError: model.ExceptionValue
    realError: model.ExceptionValue
    wordError: model.ExceptionValue
    stringError: model.ExceptionValue
    systemError: model.ExceptionValue
    readlineError: model.ExceptionValue
    readlineEndOfInput: model.ExceptionValue
    readlineInterrupted: model.ExceptionValue
    variantError: model.ExceptionValue
    (* Raised by a call that would make more than maxCallDepth calls active, as
     * the bootstrap's interpreters raise it (STACK_OVERFLOW_EXC); the limit is
     * 1,000, or QUEST_CALL_LIMIT when the environment sets it *)
    stackOverflow: model.ExceptionValue
    maxCallDepth: Int

    (* The arithmetic and comparison operators, which the tree-walking
     * interpreter finds by their spellings (infixOf) and the IR interpreter
     * from its primitives: Int has no pow and Real no rem *)
    Def Arithmetic = Option add sub mul div rem pow end
    Def Comparison = Option lt le gt ge end
    add: Arithmetic
    sub: Arithmetic
    mul: Arithmetic
    div: Arithmetic
    rem: Arithmetic
    pow: Arithmetic
    lt: Comparison
    le: Comparison
    gt: Comparison
    ge: Comparison

    (* An operator spelled infix, and the type of its operands *)
    Def Infix = Option
        infixInt with op: Arithmetic end
        infixIntCompare with c: Comparison end
        infixReal with op: Arithmetic end
        infixRealCompare with c: Comparison end
    end

    (* The infix operator a spelling names: +, -, *, /, mod, and % (Int's
     * arithmetic); <, <=, >, and >= (Int's comparisons); ++, --, **, //, and
     * ^^ (Real's arithmetic); and <<, <<=, >>, and >>= (Real's comparisons) *)
    infixOf(spelling: String): maybe.T(Infix)

    (* Int's arithmetic, raising int.error for a zero divisor *)
    intArithmetic(op: Arithmetic a: Int b: Int offset: maybe.T(Int)): Int
    intRelational(c: Comparison a: Int b: Int): Bool
    (* Real's arithmetic, raising real.error for a NaN result, a zero divisor,
     * or a pole *)
    realArithmetic(op: Arithmetic a: Real b: Real offset: maybe.T(Int)): Real
    realRelational(c: Comparison a: Real b: Real): Bool

    (* What opt!tag gives for an option whose case is its static type's
     * caseIndex-th: a new tuple of that ordinal followed by the payload's
     * components (its var components copies of the payload's, which a case's
     * binder shares) *)
    optionComponents(caseIndex: Int payload: maybe.T(model.Value)): model.Value

    (* Whether i indexes a, as an index, an indexed store, or an element's
     * address must, else raising arrayOp.error *)
    inBounds(a: Array(model.Value) i: Int): Bool
    (* Implements `is` at static type t (with run-time type arguments
     * substituted): behaves like model.same, except that empty option cases
     * compare by tag and variant values of the same tag compare their payloads
     * at the case's type (docs/extensions.md, Options as Values, Variants as
     * Values) *)
    sameAt(t: tm.Type v1: model.Value v2: model.Value): Bool
end
