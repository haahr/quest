(* Quest Self-Hosted Compiler: The Tree-Walking Interpreter Implementation *)

module treewalk : Treewalk
import
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/files : questlang/common/Files
    questlang/common/location : questlang/common/Location
    questlang/interpreter/builtins : questlang/interpreter/Builtins
    questlang/interpreter/literals : questlang/interpreter/Literals
    questlang/interpreter/primitives : questlang/interpreter/Primitives
    questlang/modules/elaboration : questlang/modules/Elaboration
    questlang/modules/graph : questlang/modules/Graph
    questlang/modules/paths : questlang/modules/Paths
    questlang/modules/stdlib : questlang/modules/Stdlib
    questlang/modules/units : questlang/modules/Units
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
    tm = questlang/types/model : questlang/types/Model
    questlang/types/reduce : questlang/types/Reduce
    questlang/types/subtyping : questlang/types/Subtyping
    questlang/types/symbols : questlang/types/Symbols
    questlang/values/model : questlang/values/Model
export
    Let Value = model.Value
    Let Frame = model.Frame
    Let Expr = typedAst.Expr
    Let Binding = typedAst.Binding
    Let Scoped = Tuple value: model.Value frame: model.Frame end
    Let PhraseResult = Tuple phrase: typedAst.Binding value: model.Value end

    let none = maybe.none(:Int)
    let at(offset: Int): maybe.T(Int) = maybe.some(offset)
    let intEqual(a: Int b: Int): Bool = a is b

    (* The loop exit (the bootstrap's _LoopExit) *)
    let loopExit: Exception = exception loopExit end

    let interrupts = tuple let var polling = false let var poll = fun(): Bool false end
    let setInterruptPoll(poll: All() Bool): Ok =
        begin
            interrupts.polling := true
            interrupts.poll := poll
        end
    let interrupted = model.exceptionValue("interrupted")
    (* Raises `interrupted` at offset if one is pending *)
    let checkInterrupt(offset: maybe.T(Int)): Ok =
        if interrupts.polling andif interrupts.poll() then model.raiseException(:Ok interrupted offset) end

    (* Raises an error again, at any type *)
    let rethrow(A::TYPE e: model.RunError): A = raise model.runError with e end

    (* ======================================================================
     * 1. Frames
     * ====================================================================== *)

    let newFrame(parent: maybe.T(Frame) currentDir: maybe.T(String) sourceMap: maybe.T(location.SourceMap)
            root: model.Root): Frame =
        tuple
            let parent = parent
            let var bindings = model.newFields()
            let typeBindings = hashMap.new(intEqual hash.int)
            let var currentDir = currentDir
            let var sourceMap = sourceMap
            let root = root
        end

    let pushScope(f: Frame): Frame = newFrame(maybe.some(f) f.currentDir f.sourceMap f.root)

    let define(f: Frame name: String v: Value): Ok = begin hashMap.insert(f.bindings name v) ok end

    let bindTypes(f: Frame bindings: hashMap.T(Int tm.Type)): Ok =
        begin
            let ids = hashMap.keys(bindings)
            for i = 0 upto {vector.length(ids) - 1} do
                let id = vector.get(ids i)
                hashMap.insert(f.typeBindings id hashMap.find(bindings id))
            end
        end

    let rec lookupType(f: Frame symbolId: Int): maybe.T(tm.Type) =
        begin
            let found = hashMap.get(f.typeBindings symbolId)
            if maybe.isSome(found) orif maybe.isNone(f.parent) then
                found
            else
                lookupType(maybe.unwrap(f.parent) symbolId)
            end
        end

    (* t with the run-time type arguments of the type parameters it mentions
     * substituted *)
    let resolveType(f: Frame t: tm.Type): tm.Type =
        begin
            let subst = tm.newSubst()
            for i = 0 upto {extent t.fv - 1} do
                let bound = lookupType(f t.fv[i])
                if maybe.isSome(bound) then
                    hashMap.insert(subst t.fv[i] maybe.unwrap(bound))
                end
            end
            if hashMap.empty(subst) then t else tm.substitute(t subst) end
        end

    (* The standard library module named name (or named so but for case), which
     * a program may use without importing it *)
    let standardModule(name: String): maybe.T(Array(String)) =
        begin
            let var found = maybe.none(:Array(String))
            for i = 0 upto {extent stdlib.standardModules - 1} do
                if stringOp.equal(stdlib.standardModules[i][0] name) then
                    found := maybe.some(stdlib.standardModules[i])
                end
            end
            if maybe.isNone(found) then
                for i = 0 upto {extent stdlib.standardModules - 1} do
                    if maybe.isNone(found)
                            andif stringOp.equal(paths.lower(stdlib.standardModules[i][0]) paths.lower(name)) then
                        found := maybe.some(stdlib.standardModules[i])
                    end
                end
            end
            found
        end

    (* Set by section 4: loads and runs a module
     * (load_module_for_interpreter) *)
    let hooks = tuple
        let var loadModule = fun(name: String expectedInterface: String f: Frame canonicalName: maybe.T(String)): Value
            model.okValue
    end

    let rec lookup(f: Frame name: String offset: maybe.T(Int)): Value =
        begin
            let found = hashMap.get(f.bindings name)
            if maybe.isSome(found) then
                maybe.unwrap(found)
            elsif maybe.isSome(f.parent) then
                lookup(maybe.unwrap(f.parent) name offset)
            else
                let std = standardModule(name)
                if maybe.isNone(std) then
                    model.internalError(:Value "Undefined runtime symbol '" <> name <> "'" offset)
                end
                let normName = maybe.unwrap(std)[0]
                let modVal = hooks.loadModule(normName maybe.unwrap(std)[1] f maybe.none())
                define(f normName modVal)
                if not(stringOp.equal(name normName)) then define(f name modVal) end
                modVal
            end
        end

    let rec assignName(f: Frame name: String v: Value offset: maybe.T(Int)): Ok =
        begin
            let found = hashMap.get(f.bindings name)
            if maybe.isSome(found) then
                case maybe.unwrap(found)
                    when vRef with r then model.assign(r.r v)
                    else define(f name v)
                end
            elsif maybe.isSome(f.parent) then
                assignName(maybe.unwrap(f.parent) name v offset)
            else
                model.internalError("Cannot assign to undefined symbol '" <> name <> "'" offset)
            end
        end

    (* The Int of v, an operand of op whose other operand is w, or an internal
     * error naming both operands' types; realOperand likewise for a Real *)
    let intOperand(op: String v: Value w: Value offset: maybe.T(Int)): Int =
        case v
            when vInt with x then x.n
            else model.internalError("Operator '" <> op <> "' requires Int operands, got " <> model.typeName(v)
                <> " and " <> model.typeName(w) offset)
        end

    let realOperand(op: String v: Value w: Value offset: maybe.T(Int)): Real =
        case v
            when vReal with x then x.r
            else model.internalError("Operator '" <> op <> "' requires Real operands, got " <> model.typeName(v)
                <> " and " <> model.typeName(w) offset)
        end

    (* An operator applied to the values of its operands *)
    let infix(op: String left: Value right: Value offset: maybe.T(Int)): Value =
        begin
            let arithmetic = primitives.infixOf(op)
            if maybe.isSome(arithmetic) then
                case maybe.unwrap(arithmetic)
                    when infixInt with x then
                        let a = intOperand(op left right offset)
                        let b = intOperand(op right left offset)
                        model.intValue(primitives.intArithmetic(x.op a b offset))
                    when infixIntCompare with x then
                        let a = intOperand(op left right offset)
                        let b = intOperand(op right left offset)
                        model.boolValue(primitives.intRelational(x.c a b))
                    when infixReal with x then
                        let a = realOperand(op left right offset)
                        let b = realOperand(op right left offset)
                        model.realValue(primitives.realArithmetic(x.op a b offset))
                    when infixRealCompare with x then
                        let a = realOperand(op left right offset)
                        let b = realOperand(op right left offset)
                        model.boolValue(primitives.realRelational(x.c a b))
                end
            elsif stringOp.equal(op "<>") then
                case left
                    when vString with x then
                        case right
                            when vString with y then model.stringValue(x.s <> y.s)
                            else model.internalError("Operator '<>' requires String operands, got "
                                <> model.typeName(left) <> " and " <> model.typeName(right) offset)
                        end
                    else model.internalError("Operator '<>' requires String operands, got "
                        <> model.typeName(left) <> " and " <> model.typeName(right) offset)
                end
            elsif stringOp.equal(op "/\\") orif stringOp.equal(op "\\/") then
                case left
                    when vBool with x then
                        case right
                            when vBool with y then
                                model.boolValue(if stringOp.equal(op "/\\") then x.b andif y.b else x.b orif y.b end)
                            else model.internalError("Operator '" <> op <> "' requires Bool operands, got "
                                <> model.typeName(left) <> " and " <> model.typeName(right) offset)
                        end
                    else model.internalError("Operator '" <> op <> "' requires Bool operands, got "
                        <> model.typeName(left) <> " and " <> model.typeName(right) offset)
                end
            elsif stringOp.equal(op "is") then
                model.boolValue(model.same(left right))
            elsif stringOp.equal(op "isnot") then
                model.boolValue(not(model.same(left right)))
            else
                model.internalError("Unsupported infix operator '" <> op <> "'" offset)
            end
        end

    (* An operator as a function of two values; its errors are located at the
     * start of the file, as the bootstrap's are (offset 0) *)
    let operatorFunction(op: String): Value =
        model.builtinValue(op fun(args: Array(Value)): Value infix(op args[0] args[1] at(0)))

    let builtinEqual(a: model.Builtin b: model.Builtin): Bool = a is b
    let builtinHash(b: model.Builtin) = hash.identityHash(b)

    let newRoot(units: graph.UnitGraph): Frame =
        begin
            let root: model.Root = tuple
                let var includePaths = array of :String end
                let var programDir = maybe.none()
                let var units = units
                let moduleValues = model.newFields()
                let callStack = vector.new()
                let var pendingCall = maybe.none()
                let tailCallables = hashMap.new(builtinEqual builtinHash)
            end
            let f = newFrame(maybe.none() maybe.none() maybe.none() root)
            define(f "true" model.trueValue)
            define(f "false" model.falseValue)
            define(f "ok" model.okValue)
            let ops = array of
                "+" "-" "*" "/" "mod" "%" "<" "<=" ">" ">=" "++" "--" "**" "//" "^^" "<<" "<<=" ">>" ">>=" "<>"
                "/\\" "\\/"
            end
            for i = 0 upto {extent ops - 1} do define(f ops[i] operatorFunction(ops[i])) end
            define(f "not" model.builtinValue("not" fun(args: Array(Value)): Value
                case args[0] when vBool with x then model.boolValue(not(x.b)) else model.falseValue end))
            define(f "extent" model.builtinValue("extent" fun(args: Array(Value)): Value
                case args[0] when vArray with x then model.intValue(extent x.a) else model.intValue(0) end))
            (* ordinal counts in its operand's static type, so its applications
             * are evaluated as such (exprApp) *)
            define(f "ordinal" model.builtinValue("ordinal" fun(args: Array(Value)): Value
                model.internalError("ordinal needs its operand's static type" none)))
            f
        end

    (* ======================================================================
     * 2. Closures and frames of the call stack
     * ====================================================================== *)

    let makeClosure(fun0: Expr f: Frame binder: maybe.T(String) name: maybe.T(String)): Value =
        case fun0.form
            when exprFun with x then
                begin
                    let stack = f.root.callStack
                    let enclosing = if vector.empty(stack) then diagnostics.mainFrame
                        else vector.get(stack {vector.length(stack) - 1}) end
                    let params = array of(extent x.params "")
                    for i = 0 upto {extent x.params - 1} do params[i] := x.params[i].name end
                    option vClosure of Value with
                        let c = tuple
                            let params = params
                            let body = x.body
                            let env = f
                            let name = name
                            let typeParamIds = x.typeParamIds
                            let typeBindings = hashMap.new(intEqual hash.int)
                            let typeOnly = x.typeOnly
                            let traceName = diagnostics.frameName(enclosing binder)
                        end
                    end
                end
            else model.internalError("A closure of a non-function" at(fun0.offset))
        end

    let bindTypesInto(into: hashMap.T(Int tm.Type) from: hashMap.T(Int tm.Type)): Ok =
        begin
            let ids = hashMap.keys(from)
            for i = 0 upto {vector.length(ids) - 1} do
                let id = vector.get(ids i)
                hashMap.insert(into id hashMap.find(from id))
            end
        end

    (* The closure with its next unbound type parameters bound to typeArgs (a
     * type application) *)
    let instantiate(c: model.Closure typeArgs: Array(tm.Type)): model.Closure =
        begin
            let bindings = hashMap.new(:Int :tm.Type intEqual hash.int)
            bindTypesInto(bindings c.typeBindings)
            let var next = 0
            for i = 0 upto {extent c.typeParamIds - 1} do
                let id = c.typeParamIds[i]
                if not(hashMap.contains(c.typeBindings id)) andif {next < extent typeArgs} then
                    hashMap.insert(bindings id typeArgs[next])
                    next := next + 1
                end
            end
            tuple
                let params = c.params
                let body = c.body
                let env = c.env
                let name = c.name
                let typeParamIds = c.typeParamIds
                let typeBindings = bindings
                let typeOnly = c.typeOnly
                let traceName = c.traceName
            end
        end

    (* Whether applying the closure to types runs it: when its type parameters
     * are its only parameters, and all of them are bound *)
    let runsWhenApplied(c: model.Closure): Bool =
        begin
            let var all = c.typeOnly
            for i = 0 upto {extent c.typeParamIds - 1} do
                if not(hashMap.contains(c.typeBindings c.typeParamIds[i])) then all := false end
            end
            all
        end

    let reversedStack(f: Frame): Array(String) =
        begin
            let n = vector.length(f.root.callStack)
            let frames = array of(n "")
            for i = 0 upto {n - 1} do frames[i] := vector.get(f.root.callStack {{n - 1} - i}) end
            frames
        end

    let noteFrames(e: model.RunError f: Frame): Ok =
        if maybe.isNone(e.frames) then e.frames := maybe.some(reversedStack(f)) end

    (* An error leaving code that ran in f: located in f's file unless code it
     * called located it already, with the frames running *)
    let leaving(e: model.RunError f: Frame): Ok =
        begin
            if maybe.isNone(e.sourceMap) then e.sourceMap := f.sourceMap end
            noteFrames(e f)
        end

    let popStack(f: Frame): Ok = begin vector.pop(f.root.callStack) ok end
    let popFrame(stack: vector.T(String)): Ok = begin vector.pop(stack) ok end

    (* ======================================================================
     * 3. Expressions
     * ====================================================================== *)

    let rec unwrapRefs(v: Value): Value = case v when vRef with r then unwrapRefs(model.deref(r.r)) else v end

    (* The position of an option's case among its type's cases *)
    let position(names: Array(String) tag: String): Int =
        begin
            let var found = ~1
            for i = 0 upto {extent names - 1} do
                if {found < 0} andif stringOp.equal(names[i] tag) then found := i end
            end
            if found < 0 then model.internalError(:Ok "'" <> tag <> "' is not a case" none) end
            found
        end

    let hasTag(tags: Array(String) tag: String): Bool =
        begin
            let var found = false
            for i = 0 upto {extent tags - 1} do if stringOp.equal(tags[i] tag) then found := true end end
            found
        end

    (* Returns some(e) if e is an option extraction o!tag, so a field selection
     * used as a mutable location can look through to the option's own payload
     * (docs/type-system.md section 6.8). A variant extraction already yields
     * its payload directly. *)
    let optionExtraction(e: Expr): maybe.T(Expr) =
        case e.form
            when exprVariantAssert with x then
                try begin reduce.optionCaseNames(x.target.type) maybe.some(e) end
                when reduce.notAnOption then maybe.none()
                end
            else maybe.none()
        end

    (* Returns option o's underlying payload tuple for extraction e (o!tag),
     * matching what a case binder receives rather than the copy o!tag makes.
     * Raises variant.tagMismatch if o has a different tag. *)
    let ownPayload(o: Value e: Expr): model.TupleValue =
        case e.form
            when exprVariantAssert with x then
                case o
                    when vOption with v then
                        if not(stringOp.equal(v.v.tag x.tag)) then
                            model.raiseException(:Ok primitives.variantError at(e.offset))
                        end
                        case maybe.unwrapOr(v.v.payload model.okValue)
                            when vTuple with t then t.t
                            else model.internalError("An option's payload with components must be a tuple" at(e.offset))
                        end
                    else
                        model.internalError("Variant assert target must be Option, got "
                            <> model.typeName(o) at(e.offset))
                end
            else model.internalError("not an extraction" at(e.offset))
        end

    (* The target of e, an extraction o!tag *)
    let extracted(e: Expr): Expr = case e.form when exprVariantAssert with x then x.target else e end

    (* The labels of a tuple's components, its types' included, if its type is a
     * tuple type *)
    let tupleLabels(t: tm.Type): maybe.T(Array(maybe.T(String))) =
        case t.form
            when typeTuple with x then
                let labels = array of(extent x.fields maybe.none(:String))
                for i = 0 upto {extent x.fields - 1} do labels[i] := tm.componentName(x.fields[i]) end
                maybe.some(labels)
            else maybe.none()
        end

    (* The simultaneous group starting at component index, if one does *)
    let groupAt(groups: Array(Array(Int)) index: Int): maybe.T(Array(Int)) =
        begin
            let var found = maybe.none(:Array(Int))
            for i = 0 upto {extent groups - 1} do
                if {extent groups[i] > 0} andif {groups[i][0] is index} then found := maybe.some(groups[i]) end
            end
            found
        end

    (* Whether a binding is a let that redefines an interactive slot, which
     * rebinds nothing: it stores to the slot (bindLet) *)
    let redefines(b: Binding): Bool = case b.form when bindLetValue with x then x.value.redefines else false end

    (* Binds a value let's name to its value in f's frame, or, if the let
     * redefines an interactive slot (docs/repl.md section 6), stores
     * the value where the name is bound, as an assignment does: in the frame
     * that holds it, or into its cell if it is a var *)
    let bindLet(v: typedAst.LetValue val: Value f: Frame): Ok =
        if v.redefines then assignName(f v.name val maybe.none())
        else define(f v.name if v.symbol.isVar then model.cellValue(val) else val end)
        end

    (* Whether binding b (or a member of its group) declares a name already
     * bound in f's own frame, other than by redefining an interactive slot *)
    let declaresName(b: Binding f: Frame): Bool =
        begin
            let members = typedAst.bindingMembers(b)
            let var found = false
            for i = 0 upto {extent members - 1} do
                let name = typedAst.declaredName(members[i])
                if maybe.isSome(name)
                        andif hashMap.contains(f.bindings maybe.unwrap(name))
                        andif not(redefines(members[i])) then
                    found := true
                end
            end
            found
        end

    (* Evaluates a typed expression in f and returns its value.
     *
     * This interpreter is the most direct reading of the typed AST: each node
     * is evaluated by the case for its form, recursively, with the
     * interpreter's own stack serving as the program's. Values are
     * model.Values (values/model): an Int is a vInt, a record a vRecord of
     * named fields, and a function a vClosure holding its parameters' names,
     * its body, and the frame it was made in. A Frame is a chain of frames
     * mapping names to values. Names suffice, without symbols, because the
     * checker has already resolved every name, and a binding that rebinds a
     * name of its frame gets a frame of its own (evalScopedBinding), so that
     * closures made before it keep what they captured. A mutable variable is
     * bound to a vRef, a cell, which an explicit dereference (exprDerefCell)
     * reads, and which a var argument passes in place of its contents.
     *
     * Control flow beyond expressions uses Quest's exceptions: exit raises
     * loopExit, which the nearest loop catches, and a Quest raise raises
     * model.runError with the cause raised, which the nearest try with a
     * branch for that exception catches. One that nothing catches propagates
     * out of the interpreter, to be reported as an error.
     *
     * Types are mostly unneeded at run time, but a few operations use them:
     * inspect, auto values, and dynamic values. So a polymorphic function's
     * type arguments are carried at run time. A type application
     * (exprTypeApp) binds them in a copy of the closure (instantiate), the
     * body runs with them bound (the frame's typeBindings), and resolveType
     * replaces a type's parameters by their bindings. A polymorphic constant,
     * such as list.nil, is a closure whose type parameters are its only
     * parameters, so instantiating it, as list.nil() does, also runs it;
     * instantiating a curried f(A::TYPE)() does not.
     *
     * In tail position (tail), a call of a closure, of either interpreter,
     * sets the root's pendingCall and returns ok instead, for the call running
     * to make (runCall). *)
    let rec evalExpr(e: Expr f: Frame): Value = evalIn(e f false)

    and evalIn(e: Expr f: Frame tail: Bool): Value =
        begin
            let offset = at(e.offset)
            case e.form
                when exprInt with x then model.intValue(x.value)
                when exprReal with x then model.realValue(x.value)
                when exprBool with x then model.boolValue(x.value)
                when exprChar with x then model.charValue(x.value)
                when exprString with x then
                    literals.freeze(x.value)
                    model.stringValue(x.value)
                when exprOk then model.okValue
                when exprExternal with x then builtins.resolveExternal(x.symbol)
                when exprVar with x then lookup(f x.name offset)
                when exprVarCell with x then model.cellValue(evalExpr(x.value f))
                when exprDerefCell with x then
                    (* Evaluated once: the target may have effects *)
                    let v = evalExpr(x.target f)
                    case v when vRef with r then model.deref(r.r) else v end
                when exprSelectRef with x then
                    case unwrapRefs(evalExpr(x.target f))
                        when vRecord with r then
                            let cell = hashMap.find(r.r.fields x.field)
                            if cell?vRef then cell
                            else model.internalError("Field '" <> x.field <> "' is not mutable" offset)
                            end
                        else model.internalError("Field selection target must be Record" offset)
                    end
                when exprIndexRef with x then
                    let target = unwrapRefs(evalExpr(x.target f))
                    case target
                        when vArray with a then
                            let i = indexOf(evalExpr(x.index f) offset)
                            if not(primitives.inBounds(a.a i)) then
                                model.raiseException(:Ok primitives.arrayOpError offset)
                            end
                            option vRef of Value with
                                let r = tuple
                                    let form = option arrayElement of model.RefForm with
                                        let arr = a.a
                                        let index = i
                                    end
                                end
                            end
                        else model.internalError("Index target must be Array, got " <> model.typeName(target) offset)
                    end
                when exprTupleSelectRef with x then
                    (* @o!tag.f is the option's own component f, which has no
                     * ordinal before it *)
                    let through = optionExtraction(x.target)
                    let target =
                        if maybe.isSome(through) then
                            option vTuple of Value with
                                let t = ownPayload(unwrapRefs(evalExpr(extracted(x.target) f)) x.target)
                            end
                        else
                            unwrapRefs(evalExpr(x.target f))
                        end
                    case target
                        when vTuple with t then
                            let var idx =
                                if maybe.isSome(through) andif {x.index >= 0} then x.index - 1 else x.index end
                            if {idx < 0} andif maybe.isSome(x.field) then
                                idx := maybe.unwrapOr(hashMap.get(t.t.nameToIndex maybe.unwrap(x.field)) ~1)
                            end
                            if {idx < 0} orif {idx >= extent t.t.elements} then
                                model.internalError(:Ok "Tuple component out of bounds" offset)
                            end
                            let elem = t.t.elements[idx]
                            if elem?vRef then
                                elem
                            else
                                option vRef of Value with
                                    let r = tuple
                                        let form = option tupleElement of model.RefForm with
                                            let tup = t.t
                                            let index = idx
                                        end
                                    end
                                end
                            end
                        else
                            model.internalError("Tuple select target must be Tuple, got "
                                <> model.typeName(target) offset)
                    end
                when exprAssign with x then
                    let through =
                        case x.target.form
                            when exprSelect with s then optionExtraction(s.target)
                            else maybe.none(:Expr)
                        end
                    if maybe.isSome(through) then
                        (* For o!tag.f := v, write directly into the option's
                         * own component f (matching a case binder). Evaluate o
                         * and check its tag before evaluating v. *)
                        let ex = maybe.unwrap(through)
                        let payload = ownPayload(unwrapRefs(evalExpr(extracted(ex) f)) ex)
                        let rhs = evalExpr(x.value f)
                        case x.target.form
                            when exprSelect with s then model.tupleSetByName(payload s.field rhs)
                            else ok
                        end
                    else
                        (* The target is evaluated before the value, as
                         * compiled code does *)
                        case x.target.form
                            when exprVar with v then
                                let rhs = evalExpr(x.value f)
                                case lookup(f v.name offset)
                                    when vRef with r then model.assign(r.r rhs)
                                    else assignName(f v.name rhs offset)
                                end
                            when exprSelect with s then
                                let target = unwrapRefs(evalExpr(s.target f))
                                let rhs = evalExpr(x.value f)
                                case target
                                    when vRecord with r then
                                        case hashMap.find(r.r.fields s.field)
                                            when vRef with cell then model.assign(cell.r rhs)
                                            else begin hashMap.insert(r.r.fields s.field rhs) ok end
                                        end
                                    when vTuple with t then model.tupleSetByName(t.t s.field rhs)
                                    else
                                        model.internalError(:Ok "Field assignment target must be Record or Tuple"
                                                offset)
                                end
                            else model.internalError(:Ok "Unsupported assignment target in interpreter" offset)
                        end
                    end
                    model.okValue

                (* Functions and application *)
                when exprFun then makeClosure(e f maybe.none() maybe.none())
                when exprTypeApp with x then
                    let var callee = evalExpr(x.func f)
                    let typeArgs = array of(extent x.typeArgs tm.okType)
                    for i = 0 upto {extent x.typeArgs - 1} do typeArgs[i] := resolveType(f x.typeArgs[i]) end
                    case callee
                        when vClosure with c then
                            if extent c.c.typeParamIds > 0 then
                                callee := option vClosure of Value with let c = instantiate(c.c typeArgs) end
                            end
                        else ok
                    end
                    case callee
                        when vClosure with c then
                            if runsWhenApplied(c.c) then runClosure(c.c array of :Value end offset) else callee end
                        else callee
                    end
                when exprApp with x then
                    let callee = evalExpr(x.func f)
                    let args = array of(extent x.args model.okValue)
                    for i = 0 upto {extent x.args - 1} do args[i] := evalExpr(x.args[i] f) end
                    case callee
                        when vBuiltin with b then
                            if stringOp.equal(b.b.name "ordinal") then
                                case args[0]
                                    when vOption with o then
                                        model.intValue(position(reduce.optionCaseNames(x.args[0].type) o.v.tag))
                                    else
                                        model.internalError("ordinal expects Option, got "
                                            <> model.typeName(args[0]) offset)
                                end
                            elsif tail andif hashMap.contains(f.root.tailCallables b.b) then
                                pend(f callee args offset)
                            else
                                b.b.fn(args)
                            end
                        when vClosure with c then
                            if tail then pend(f callee args offset) else runClosure(c.c args offset) end
                        else model.internalError("Cannot call non-function of type " <> model.typeName(callee) offset)
                    end
                when exprInfix with x then
                    let left = evalExpr(x.left f)
                    let right = evalExpr(x.right f)
                    if stringOp.equal(x.op "is") orif stringOp.equal(x.op "isnot") then
                        (* At the left operand's type (docs/extensions.md,
                         * Options as Values) *)
                        model.boolValue(primitives.sameAt(resolveType(f x.left.type) left right)
                            is stringOp.equal(x.op "is"))
                    else
                        infix(x.op left right offset)
                    end

                (* Control *)
                when exprIf with x then
                    case evalExpr(x.cond f)
                        when vBool with b then
                            if b.b then evalIn(x.thenBranch f tail) else evalIn(x.elseBranch f tail) end
                        else model.internalError("Conditional expression must evaluate to Bool" offset)
                    end
                when exprBlock with x then
                    let var g = pushScope(f)
                    for i = 0 upto {extent x.bindings - 1} do g := evalScopedBinding(x.bindings[i] g).frame end
                    evalIn(x.result g tail)
                when exprLoop with x then
                    try begin loop checkInterrupt(offset) evalExpr(x.body f) end ok end when loopExit then ok end
                    model.okValue
                when exprWhile with x then
                    let var going = true
                    while going do
                        checkInterrupt(offset)
                        case evalExpr(x.cond f)
                            when vBool with b then
                                if b.b then
                                    try begin evalExpr(x.body f) ok end when loopExit then going := false end
                                else
                                    going := false
                                end
                            else model.internalError(:Ok "While loop condition must evaluate to Bool" offset)
                        end
                    end
                    model.okValue
                when exprFor with x then
                    let startVal = evalExpr(x.start f)
                    let stopVal = evalExpr(x.stop f)
                    case startVal
                        when vInt with s then
                            case stopVal
                                when vInt with t then
                                    let var cur = s.n
                                    let var going = true
                                    while going andif {if x.isDownto then cur >= t.n else cur <= t.n end} do
                                        checkInterrupt(offset)
                                        (* Give each iteration its own scope so
                                         * closures created in the body capture
                                         * that iteration's loop variable, as
                                         * lowering's let does *)
                                        let loopEnv = pushScope(f)
                                        define(loopEnv x.varName model.intValue(cur))
                                        try begin evalExpr(x.body loopEnv) ok end when loopExit then going := false end
                                        (* Stop at the bound: a step past
                                         * maxInt or minInt would wrap *)
                                        if cur is t.n then
                                            going := false
                                        else
                                            cur := if x.isDownto then cur - 1 else cur + 1 end
                                        end
                                    end
                                    model.okValue
                                else model.internalError("For loop bounds must evaluate to Int" offset)
                            end
                        else model.internalError("For loop bounds must evaluate to Int" offset)
                    end
                when exprExit then raise loopExit end

                (* Aggregates *)
                when exprRecord with x then
                    let fields = model.newFields()
                    for i = 0 upto {extent x.fields - 1} do
                        let v = evalExpr(x.fields[i].value f)
                        hashMap.insert(fields x.fields[i].name if x.fields[i].isVar then model.cellValue(v) else v end)
                    end
                    model.recordValue(fields)
                when exprTypeWitness with x then
                    option vTypeValue of Value with
                        let t = tuple let type = x.witnessType let bound = x.bound let name = maybe.some(x.name) end
                    end
                when exprTuple with x then evalTuple(e.type x.elements x.simultaneousGroups f)
                when exprSelect with x then
                    let target = unwrapRefs(evalExpr(x.target f))
                    case target
                        when vRecord with r then
                            case hashMap.find(r.r.fields x.field)
                                when vRef with cell then model.deref(cell.r)
                                else hashMap.find(r.r.fields x.field)
                            end
                        when vTuple with t then model.tupleGet(t.t x.field)
                        else
                            model.internalError("Cannot select field '" <> x.field <> "' from "
                                <> model.typeName(target) offset)
                    end
                when exprArray with x then
                    let a = array of(extent x.elements model.okValue)
                    for i = 0 upto {extent x.elements - 1} do a[i] := evalExpr(x.elements[i] f) end
                    option vArray of Value with let a = a end
                when exprArrayRep with x then
                    case evalExpr(x.count f)
                        when vInt with c then
                            if c.n < 0 then model.raiseException(:Ok primitives.arrayOpError offset) end
                            let init = evalExpr(x.initVal f)
                            option vArray of Value with let a = array of(c.n init) end
                        else model.internalError("Array count must evaluate to Int" offset)
                    end
                when exprIndex with x then
                    let target = evalExpr(x.target f)
                    let idx = evalExpr(x.index f)
                    case target
                        when vArray with a then
                            let i = indexOf(idx offset)
                            if not(primitives.inBounds(a.a i)) then
                                model.raiseException(:Ok primitives.arrayOpError offset)
                            end
                            a.a[i]
                        else model.internalError("Index target must be Array, got " <> model.typeName(target) offset)
                    end
                when exprIndexAssign with x then
                    let target = evalExpr(x.target f)
                    let idx = evalExpr(x.index f)
                    let rhs = evalExpr(x.value f)
                    case target
                        when vArray with a then
                            let i = indexOf(idx offset)
                            if not(primitives.inBounds(a.a i)) then
                                model.raiseException(:Ok primitives.arrayOpError offset)
                            end
                            a.a[i] := rhs
                            model.okValue
                        else model.internalError("Index target must be Array, got " <> model.typeName(target) offset)
                    end

                (* Variants, options, and auto values *)
                when exprVariant with x then model.variantValue(x.tag evalMaybe(x.payload f))
                when exprAuto with x then
                    option vAuto of Value with
                        let a = tuple let value = evalExpr(x.payload f) let type = resolveType(f x.witnessType) end
                    end
                when exprOption with x then
                    let payload = evalMaybe(x.payload f)
                    if maybe.isSome(x.ordinalExpr) then
                        case evalExpr(maybe.unwrap(x.ordinalExpr) f)
                            when vInt with n then
                                let optType = tm.evaluateLazily(e.type tm.noLookup)
                                case optType.form
                                    when typeOption with o then
                                        if {n.n < 0} orif {n.n >= extent o.options} then
                                            model.internalError(:Ok "Option ordinal "
                                                <> model.toString(model.intValue(n.n))
                                                <> " out of bounds (0 <= ordinal < "
                                                <> model.toString(model.intValue(extent o.options)) <> ")" offset)
                                        end
                                        model.optionValue(o.options[n.n].name payload)
                                    else model.internalError("Expected Option type, got " <> tm.show(optType) offset)
                                end
                            else model.internalError("Option ordinal must evaluate to Int, got "
                                <> model.typeName(evalExpr(maybe.unwrap(x.ordinalExpr) f)) offset)
                        end
                    else
                        model.optionValue(maybe.unwrapOr(x.tag "") payload)
                    end
                when exprVariantCheck with x then
                    let target = evalExpr(x.target f)
                    case target
                        when vVariant with v then model.boolValue(stringOp.equal(v.v.tag x.tag))
                        when vOption with v then model.boolValue(stringOp.equal(v.v.tag x.tag))
                        else model.internalError("Variant query target must be Variant or Option, got "
                            <> model.typeName(target) offset)
                    end
                when exprVariantAssert with x then
                    let target = evalExpr(x.target f)
                    case target
                        when vVariant with v then
                            if not(stringOp.equal(v.v.tag x.tag)) then
                                model.raiseException(:Ok primitives.variantError offset)
                            end
                            maybe.unwrapOr(v.v.payload model.okValue)
                        when vOption with v then
                            if not(stringOp.equal(v.v.tag x.tag)) then
                                model.raiseException(:Ok primitives.variantError offset)
                            end
                            primitives.optionComponents(position(reduce.optionCaseNames(x.target.type) x.tag)
                                    v.v.payload)
                        else model.internalError("Variant assert target must be Variant or Option, got "
                            <> model.typeName(target) offset)
                    end
                when exprCase with x then
                    let target = evalExpr(x.target f)
                    let tagged =
                        case target
                            when vVariant with v then v.v
                            when vOption with v then v.v
                            else model.internalError(:model.Tagged "Case target must be Variant or Option, got "
                                <> model.typeName(target) offset)
                        end
                    let var branch = ~1
                    for i = 0 upto {extent x.branches - 1} do
                        if {branch < 0} andif hasTag(x.branches[i].tags tagged.tag) then branch := i end
                    end
                    if branch >= 0 then
                        let b = x.branches[branch]
                        if maybe.isSome(b.binder) then
                            let child = pushScope(f)
                            define(child maybe.unwrap(b.binder).name
                                    maybe.unwrapOr(tagged.payload model.okValue))
                            evalIn(b.body child tail)
                        else
                            evalIn(b.body f tail)
                        end
                    elsif maybe.isSome(x.elseBranch) then
                        evalIn(maybe.unwrap(x.elseBranch) f tail)
                    else
                        model.internalError("Unhandled case tag '" <> tagged.tag <> "'" offset)
                    end

                (* Exceptions *)
                when exprException with x then
                    let excVal = option vException of Value with let e = model.exceptionValue(x.name) end
                    (* Only an exception phrase binds its name (§6.15) *)
                    if maybe.isSome(x.symbol) then define(f x.name excVal) end
                    excVal
                when exprRaise with x then
                    case evalExpr(x.exc f)
                        when vException with exc then
                            let payload = evalMaybe(x.payload f)
                            let payloadType =
                                if maybe.isSome(x.payload) then
                                    maybe.some(maybe.unwrap(x.payload).type)
                                else
                                    maybe.none(:tm.Type)
                                end
                            raise model.runError with
                                tuple
                                    let cause = option raised of model.Cause with
                                        let exc = exc.e
                                        let payload = payload
                                        let payloadType = payloadType
                                    end
                                    let var offset = offset
                                    let var sourceMap = maybe.none()
                                    let var frames = maybe.none()
                                end
                            end
                        else model.internalError("Target of raise must be Exception, got "
                            <> model.typeName(evalExpr(x.exc f)) offset)
                    end
                when exprTry with x then
                    try
                        evalExpr(x.body f)
                    when model.runError with err then
                        case err.cause
                            when raised with r then
                                let var handled = maybe.none(:Value)
                                let var i = 0
                                while maybe.isNone(handled) andif {i < extent x.branches} do
                                    let b = x.branches[i]
                                    case evalExpr(b.excPattern f)
                                        when vException with p then
                                            if p.e is r.exc then
                                                handled := maybe.some(if maybe.isSome(b.binder) then
                                                    let child = pushScope(f)
                                                    define(child maybe.unwrap(b.binder).name
                                                            maybe.unwrapOr(r.payload model.okValue))
                                                    evalExpr(b.body child)
                                                else
                                                    evalExpr(b.body f)
                                                end)
                                            end
                                        else ok
                                    end
                                    i := i + 1
                                end
                                if maybe.isSome(handled) then
                                    maybe.unwrap(handled)
                                elsif maybe.isSome(x.elseBranch) then
                                    if maybe.isSome(x.elseBinder) then
                                        (* Bind the else branch's name to the
                                         * RunError itself so raised.reraise
                                         * can re-raise it (docs/raised.md
                                         * section 5), recording its source
                                         * location and active frames as if it
                                         * had left this frame *)
                                        leaving(err f)
                                        let child = pushScope(f)
                                        define(child maybe.unwrap(x.elseBinder).name
                                                option vRaised of Value with let e = err end)
                                        evalExpr(maybe.unwrap(x.elseBranch) child)
                                    else
                                        evalExpr(maybe.unwrap(x.elseBranch) f)
                                    end
                                else
                                    rethrow(err)
                                end
                            else rethrow(err)
                        end
                    end

                (* Auto values' types *)
                when exprInspect with x then
                    case evalExpr(x.target f)
                        when vAuto with a then
                            let var result = maybe.none(:Value)
                            let var i = 0
                            while maybe.isNone(result) andif {i < extent x.branches} do
                                let b = x.branches[i]
                                let matchType = resolveType(f b.matchType)
                                let matches =
                                    if b.exact then
                                        subtyping.isTypeEqual(a.a.type matchType maybe.none())
                                    else
                                        subtyping.isSubtype(a.a.type matchType maybe.none())
                                    end
                                if matches then
                                    result := maybe.some(if extent b.binders > 0 then
                                        let child = pushScope(f)
                                        for j = 0 upto {extent b.binders - 1} do
                                            define(child b.binders[j].name a.a.value)
                                        end
                                        evalIn(b.body child tail)
                                    else
                                        evalIn(b.body f tail)
                                    end)
                                end
                                i := i + 1
                            end
                            if maybe.isSome(result) then
                                maybe.unwrap(result)
                            elsif maybe.isSome(x.elseBranch) then
                                evalIn(maybe.unwrap(x.elseBranch) f tail)
                            else
                                model.raiseException(model.dynamicError offset)
                            end
                        else model.internalError("Inspect target must be an auto value, got "
                            <> model.typeName(evalExpr(x.target f)) offset)
                    end
            end
        end

    and evalMaybe(e: maybe.T(Expr) f: Frame): maybe.T(Value) =
        if maybe.isSome(e) then maybe.some(evalExpr(maybe.unwrap(e) f)) else maybe.none() end

    and indexOf(v: Value offset: maybe.T(Int)): Int =
        case v
            when vInt with x then x.n
            else model.internalError("Array index must be Int, got " <> model.typeName(v) offset)
        end

    (* A tuple: each component's label is bound for the components after it; a
     * simultaneous declaration's labels are bound, in a frame of their own,
     * once all of its members' values are computed *)
    and evalTuple(type: tm.Type elements: Array(Expr) groups: Array(Array(Int)) f: Frame): Value =
        begin
            let labels = tupleLabels(type)
            let elems = array of(extent elements model.okValue)
            let var tupEnv = pushScope(f)
            let var idx = 0
            while idx < extent elements do
                let found = groupAt(groups idx)
                let group = maybe.unwrapOr(found array of idx end)
                let values = array of(extent group model.okValue)
                for i = 0 upto {extent group - 1} do values[i] := evalExpr(elements[group[i]] tupEnv) end
                if {extent group > 1} orif maybe.isSome(found) then tupEnv := pushScope(tupEnv) end
                for i = 0 upto {extent group - 1} do
                    let j = group[i]
                    elems[j] := values[i]
                    if maybe.isSome(labels) andif {j < extent maybe.unwrap(:Array(maybe.T(String)) labels)} then
                        let label = maybe.unwrap(labels)[j]
                        if maybe.isSome(label) then define(tupEnv maybe.unwrap(label) values[i]) end
                    end
                end
                idx := idx + extent group
            end
            model.tupleValue(elems labels)
        end

    (* A call in tail position, which the call running makes in its place *)
    and pend(f: Frame callee: Value args: Array(Value) offset: maybe.T(Int)): Value =
        begin
            f.root.pendingCall := maybe.some(tuple let callee = callee let args = args let offset = offset end)
            model.okValue
        end

    and runClosure(c: model.Closure args: Array(Value) offset: maybe.T(Int)): Value =
        runCall(c.env.root closureCallable(c) args offset)

    (* A closure run by runCall: one call of it, its body in tail position *)
    and closureCallable(c: model.Closure): model.TailCallable =
        tuple
            let traceName = maybe.some(c.traceName)
            let run = fun(args: Array(Value)): Value activate(c args)
        end

    (* Runs a function (callee), of either interpreter, in its frame, and then
     * each call its body makes in tail position (root.pendingCall), in that
     * frame renamed, so that the calls run in a loop and add no active call
     * (docs/interpreter.md section 3.3). A call that would make more than
     * maxCallDepth calls active raises stack.overflow at offset, the call's,
     * which the caller locates in its file. *)
    and runCall(root: model.Root callee: model.TailCallable args: Array(Value) offset: maybe.T(Int)): Value =
        begin
            let stack = root.callStack
            if vector.length(stack) >= primitives.maxCallDepth then
                model.raiseException(:Ok primitives.stackOverflow offset)
            end
            checkInterrupt(offset)
            let var name = callee.traceName
            if maybe.isSome(name) then vector.append(stack maybe.unwrap(name)) end
            let var current = callee
            let var currentArgs = args
            let var result = model.okValue
            let var going = true
            try
                while going do
                    result := current.run(currentArgs)
                    if maybe.isSome(root.pendingCall) then
                        let p = maybe.unwrap(root.pendingCall)
                        root.pendingCall := maybe.none()
                        checkInterrupt(p.offset)
                        current := callableOf(root p.callee)
                        currentArgs := p.args
                        (* The frame running becomes the callee's (an IR
                         * function the passes made has none) *)
                        let renamed = current.traceName
                        if maybe.isSome(name) andif maybe.isSome(renamed) then
                            vector.set(stack {vector.length(stack) - 1} maybe.unwrap(renamed))
                        elsif maybe.isSome(name) then
                            vector.pop(stack)
                            ok
                        elsif maybe.isSome(renamed) then
                            if vector.length(stack) >= primitives.maxCallDepth then
                                model.raiseException(:Ok primitives.stackOverflow p.offset)
                            end
                            vector.append(stack maybe.unwrap(renamed))
                        end
                        name := renamed
                    else
                        going := false
                    end
                end
            when model.runError with err then
                if maybe.isSome(name) then popFrame(stack) end
                rethrow(:Ok err)
            end
            if maybe.isSome(name) then popFrame(stack) end
            result
        end

    (* What runCall runs for a function value: a closure's body, or an IR
     * closure's (root.tailCallables) *)
    and callableOf(root: model.Root v: Value): model.TailCallable =
        case v
            when vClosure with c then closureCallable(c.c)
            when vBuiltin with b then maybe.unwrap(hashMap.get(root.tailCallables b.b))
            else model.internalError("Cannot call non-function of type " <> model.typeName(v) none)
        end

    (* One call of a closure, in the frame runCall has pushed: an external's
     * built-in implementation, or the closure's body, in tail position. An
     * error raised inside is located in the file the closure was made in,
     * unless code it called located it already, and records the frames
     * running (docs/exceptions.md sections 3.2 and 4). *)
    and activate(c: model.Closure args: Array(Value)): Value =
        begin
            let env = c.env
            try
                case c.body.form
                    when exprExternal with x then
                        (* The type parameters' types, which the type
                         * applications bound, resolved *)
                        let types = vector.new(:tm.Type)
                        for i = 0 upto {extent c.typeParamIds - 1} do
                            let t = hashMap.get(c.typeBindings c.typeParamIds[i])
                            if maybe.isSome(t) then vector.append(types maybe.unwrap(t)) end
                        end
                        builtins.callExternal(x.symbol vector.toArray(types) args)
                    else
                        let callEnv = pushScope(env)
                        bindTypes(callEnv c.typeBindings)
                        for i = 0 upto {extent c.params - 1} do
                            if i < extent args then define(callEnv c.params[i] args[i]) end
                        end
                        evalIn(c.body callEnv true)
                end
            when model.runError with err then
                leaving(err env)
                rethrow(:Value err)
            end
        end

    (* ======================================================================
     * 4. Bindings and programs
     * ====================================================================== *)

    (* The value of a let binding of name: a function's closure is bound to the
     * name *)
    and evalBoundValue(name: String value: Expr f: Frame): Value =
        if value.form?exprFun then makeClosure(value f maybe.some(name) maybe.none())
        else evalExpr(value f)
        end

    and defineMembers(members: Array(typedAst.LetValue) values: Array(Value) f: Frame): Ok =
        for i = 0 upto {extent members - 1} do bindLet(members[i] values[i] f) end

    and memberNames(members: Array(typedAst.LetValue)): maybe.T(Array(maybe.T(String))) =
        begin
            let names = array of(extent members maybe.none(:String))
            for i = 0 upto {extent members - 1} do names[i] := maybe.some(members[i].name) end
            maybe.some(names)
        end

    and evalLetValue(v: typedAst.LetValue f: Frame): Value =
        if v.isRec andif v.value.form?exprFun then
            let closure = makeClosure(v.value f maybe.some(v.name) maybe.some(v.name))
            bindLet(v closure f)
            closure
        else
            let val = evalBoundValue(v.name v.value f)
            bindLet(v val f)
            val
        end

    and runModuleInit(name: String bindings: Array(Binding) modEnv: Frame): Frame =
        begin
            vector.append(modEnv.root.callStack diagnostics.initFrame(name))
            let var g = modEnv
            try
                for i = 0 upto {extent bindings - 1} do g := evalScopedBinding(bindings[i] g).frame end
            when model.runError with err then
                leaving(err modEnv)
                popStack(modEnv)
                rethrow(:Ok err)
            end
            popStack(modEnv)
            g
        end

    and exportsOf(scope: symbols.Scope modEnv: Frame): Value =
        begin
            let fields = model.newFields()
            let names = hashMap.keys(scope.values)
            for i = 0 upto {vector.length(names) - 1} do
                let n = vector.get(names i)
                hashMap.insert(fields n lookup(modEnv n none))
            end
            model.recordValue(fields)
        end

    and evalBinding(b: Binding f: Frame): Value =
        case b.form
            when bindLetValue with x then evalLetValue(x.value f)
            when bindLetValueGroup with x then
                let values = array of(extent x.members model.okValue)
                if {extent x.members > 0} andif x.members[0].isRec then
                    (* Each member's closure captures f, where the others are
                     * defined before any is called *)
                    for i = 0 upto {extent x.members - 1} do values[i] := evalLetValue(x.members[i] f) end
                else
                    for i = 0 upto {extent x.members - 1} do
                        values[i] := evalBoundValue(x.members[i].name x.members[i].value f)
                    end
                    defineMembers(x.members values f)
                end
                model.tupleValue(values memberNames(x.members))
            when bindLetType then model.okValue
            when bindLetTypeGroup then model.okValue
            when bindDefKind then model.okValue
            when bindInterface then model.okValue
            when bindModule with x then
                let modEnv = runModuleInit(x.name x.bindings pushScope(f))
                let exported = exportsOf(x.scope modEnv)
                define(f x.name exported)
                exported
            when bindImport with x then
                for i = 0 upto {extent x.items - 1} do
                    let item = x.items[i]
                    let modPaths = typedAst.effectiveModulePaths(item)
                    let canonicals = typedAst.effectiveCanonicalModulePaths(item)
                    for j = 0 upto {extent item.names - 1} do
                        let modVal = hooks.loadModule(modPaths[j] typedAst.effectiveInterfacePath(item) f
                                maybe.some(canonicals[j]))
                        define(f item.names[j] modVal)
                    end
                end
                model.okValue
            when bindExprStmt with x then evalExpr(x.expr f)
        end

    (* Evaluates binding b, of a program, a module, or a block, in f0, and
     * returns its value and the frame the bindings after it run in. Frames
     * are mutable maps that closures capture by reference, so defining a name
     * again in the frame a closure captured would change what that closure
     * sees: in
     *
     *   let x = 1  let g() = x  let x = 2
     *
     * g() must still give 1. So a binding that declares a name already in
     * the frame (declaresName) gets a new frame, a child of the current one,
     * and the old binding stays where g finds it. A non-rec group (let x =
     * ... and y = ...) computes all its values in the current frame first,
     * since no member's value sees the others (let x = y and y = x swaps
     * them), and then binds them in a new frame, always, for the same
     * reason. A rec group binds its members in the frame it evaluates them
     * in, so that each closure sees the others. *)
    and evalScopedBinding(b: Binding f0: Frame): Scoped =
        begin
            let var f = f0
            case b.form
                when bindLetValueGroup with x then
                    if {extent x.members > 0} andif not(x.members[0].isRec) then
                        let values = array of(extent x.members model.okValue)
                        for i = 0 upto {extent x.members - 1} do
                            values[i] := evalBoundValue(x.members[i].name x.members[i].value f)
                        end
                        let g = pushScope(f)
                        defineMembers(x.members values g)
                        tuple let value = model.tupleValue(values memberNames(x.members)) let frame = g end
                    else
                        if declaresName(b f) then f := pushScope(f) end
                        tuple let value = evalBinding(b f) let frame = f end
                    end
                else
                    if declaresName(b f) then f := pushScope(f) end
                    tuple let value = evalBinding(b f) let frame = f end
            end
        end

    (* Whether a module is one of the library's that neither interpreter runs:
     * the JIT's unsound primitives, which read and write native memory
     * (docs/jit.md section 3.11), refused by name since there are no builtins
     * for them *)
    let uninterpreted(canon: String): Bool = stringOp.equal(canon "os/value") orif stringOp.equal(canon "os/code")

    (* Loads and runs module name as imported from f's directory
     * (load_module_for_interpreter). It resolves the import in f's unit graph
     * and runs its typed module, elaborating it in a fresh type environment if
     * the type checker did not already do so (for a standard module used
     * without an explicit import). The resulting record is cached by canonical
     * name so each module runs only once. *)
    let loadModuleForInterpreter(name: String expectedInterface: String f: Frame
            canonicalName: maybe.T(String)): Value =
        begin
            let root = f.root
            let known =
                if maybe.isSome(canonicalName) then
                    hashMap.get(root.moduleValues maybe.unwrap(canonicalName))
                else
                    maybe.none(:Value)
                end
            if maybe.isSome(known) then
                maybe.unwrap(known)
            else
                let g = root.units
                let resolved =
                    graph.resolveModule(g.resolver name f.currentDir graph.rootsOf(root.includePaths root.programDir))
                let canon = graph.canonicalName(resolved)
                let loaded = hashMap.get(root.moduleValues canon)
                if maybe.isSome(loaded) then
                    maybe.unwrap(loaded)
                elsif uninterpreted(canon) then
                    model.internalError("'" <> canon <> "' cannot be interpreted: compile the program instead"
                            maybe.none())
                else
                    let var typedMod = graph.typedModule(g canon)
                    if maybe.isNone(typedMod) then
                        let typeEnv = env.new()
                        typeEnv.units := graph.newGraphWith(g.resolver)
                        for i = 0 upto {extent root.includePaths - 1} do
                            vector.append(typeEnv.includePaths root.includePaths[i])
                        end
                        typeEnv.currentDir := f.currentDir
                        typeEnv.programDir := root.programDir
                        typedMod := maybe.some(elaboration.loadModule(name expectedInterface typeEnv))
                        graph.unit(g option moduleUnit of units.UnitKind end canon).typedModule := typedMod
                    end
                    let modEnv = pushScope(f)
                    if maybe.isSome(resolved.source) then
                        let file = maybe.unwrap(resolved.source)
                        modEnv.currentDir := maybe.some(files.parent(file))
                        let sm = location.newSourceMap(files.displayName(file)
                                maybe.unwrapOr(files.readText(file) ""))
                        diagnostics.registerSource(sm)
                        modEnv.sourceMap := maybe.some(sm)
                    end
                    case maybe.unwrap(typedMod).form
                        when bindModule with m then
                            let exported = exportsOf(m.scope runModuleInit(m.name m.bindings modEnv))
                            hashMap.insert(root.moduleValues canon exported)
                            exported
                        else model.internalError("Not a module: " <> name none)
                    end
                end
            end
        end

    (* Fills in hooks.loadModule when this module initializes; the name is
     * never read. lookup (section 1) loads a standard module the first time
     * its name is used, and loading it runs the module's bindings, which call
     * lookup again. Rather than make sections 1 to 4 one recursive group, the
     * early code calls the loader through the mutable hooks.loadModule,
     * assigned here once loadModuleForInterpreter exists. *)
    let installed = begin hooks.loadModule := loadModuleForInterpreter ok end

    Let Evaluated = Tuple results: Array(PhraseResult) frame: Frame end

    let evalProgramPhrasesIn(p: typedAst.Program f0: Frame on: All(r: PhraseResult) Ok): Evaluated =
        begin
            let results = vector.new(:PhraseResult)
            let var f = f0
            for i = 0 upto {extent p.phrases - 1} do
                let s = evalScopedBinding(p.phrases[i] f)
                f := s.frame
                let r: PhraseResult = tuple let phrase = p.phrases[i] let value = s.value end
                vector.append(results r)
                on(r)
            end
            tuple let results = vector.toArray(results) let frame = f end
        end

    let evalProgramPhrases(p: typedAst.Program f: Frame on: All(r: PhraseResult) Ok): Array(PhraseResult) =
        evalProgramPhrasesIn(p f on).results

    Let Snapshot = Tuple bindings: hashMap.T(String Value) moduleValues: hashMap.T(String Value) end

    (* A copy of m, with its equality and hash *)
    let copyValues(m: hashMap.T(String Value)): hashMap.T(String Value) =
        hashMap.filter(m fun(k: String v: Value): Bool true)

    let snapshot(f: Frame): Snapshot =
        tuple let bindings = copyValues(f.bindings) let moduleValues = copyValues(f.root.moduleValues) end

    let restore(f: Frame snap: Snapshot): Ok =
        begin
            f.bindings := copyValues(snap.bindings)
            hashMap.clear(f.root.moduleValues)
            hashMap.forEach(snap.moduleValues fun(k: String v: Value): Ok
                begin hashMap.insert(f.root.moduleValues k v) ok end)
        end
end
