(* Quest Self-Hosted Compiler: The IR Interpreter Implementation
 *
 * Variables are looked up by identity in frames: a frame per function
 * activation, its parent the frame its closure was made in, and a frame per
 * loop iteration, so that a closure made in one iteration keeps that
 * iteration's values. A mutable variable holds a cell, which addr x yields and
 * a var or out parameter receives. Statements give no signal when they fall
 * through, or the terminator's (return, jump, break, continue); a raise is
 * model.runError, as in the tree-walking interpreter. A handler's exception
 * variable holds the exception raised; its frame keeps the error, for its
 * payload and for raising it again.
 *
 * The interpreter is an oracle for the IR's passes, so it tells the IR's
 * mistakes apart from the program's. Malformed IR (a value of the wrong kind,
 * a variable bound nowhere, a case without its tag) raises fail, an
 * irInterpreterError, which the driver reports as an internal error; it never
 * coerces such a value to a default. Only the program's own errors raise
 * model's errors: an exception it raises, an index out of bounds, an ordinal
 * out of range, or a let rec's variable read before its value is computed. *)

module irInterp : IRInterp
import
    conv : Conv
    stringOp = string : StringOp
    word : Word
    writer : Writer

    collections/hashMap : collections/HashMap
    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/location : questlang/common/Location
    questlang/common/maps : questlang/common/Maps
    questlang/common/strings : questlang/common/Strings
    questlang/interpreter/builtins : questlang/interpreter/Builtins
    questlang/interpreter/formatting : questlang/interpreter/Formatting
    questlang/interpreter/literals : questlang/interpreter/Literals
    questlang/interpreter/primitives : questlang/interpreter/Primitives
    questlang/interpreter/treewalk : questlang/interpreter/Treewalk
    questlang/ir/nodes : questlang/ir/Nodes
    tm = questlang/types/model : questlang/types/Model
    questlang/types/subtyping : questlang/types/Subtyping
    questlang/values/model : questlang/values/Model
export
    Let Type = tm.Type
    Let Value = model.Value
    Let Variable = nodes.Variable
    Let Atom = nodes.Atom
    Let Body = nodes.Body
    Let Stmt = nodes.Stmt
    Let Op = nodes.Op

    let irInterpreterError: Exception(String) = exception irInterpreterError: String end

    let fail(A::TYPE message: String): A = raise irInterpreterError with message end
    let rethrow(A::TYPE e: model.RunError): A = raise model.runError with e end

    (* What a value of a scalar type or an array holds; a value of another
     * type is malformed IR *)
    let intOf(v: Value): Int = case v when vInt with x then x.n else fail("not an Int: " <> model.typeName(v)) end
    let realOf(v: Value): Real = case v when vReal with x then x.r else fail("not a Real: " <> model.typeName(v)) end
    let boolOf(v: Value): Bool = case v when vBool with x then x.b else fail("not a Bool: " <> model.typeName(v)) end
    let stringOf(v: Value): String =
        case v when vString with x then x.s else fail("not a String: " <> model.typeName(v)) end
    let arrayOf(v: Value): Array(Value) =
        case v when vArray with x then x.a else fail("not an array: " <> model.typeName(v)) end

    let eq(a: String b: String): Bool = stringOp.equal(a b)
    let none = maybe.none(:Int)

    (* ======================================================================
     * Frames
     * ====================================================================== *)

    Let Rec Frame = Tuple
        parent: maybe.T(Frame)
        (* A variable's value by its id; none for a let rec's variable before
         * its value is computed *)
        values: maps.IntMap(maybe.T(Value))
        (* The type arguments of the type parameters (by symbol id) of the
         * functions being run *)
        types: maps.IntMap(Type)
        (* The errors raised that handlers' exception variables (by id) hold *)
        raised: maps.IntMap(model.RunError)
        (* The frame of the top level this frame runs in (none: this one), the
         * parent of lifted functions' frames *)
        top: maybe.T(Frame)
    end

    let newFrame(parent: maybe.T(Frame) types: maps.IntMap(Type)): Frame =
        tuple
            let parent = parent
            let values = maps.newIntMap()
            let types = types
            let raised = maps.newIntMap()
            let top =
                if maybe.isSome(parent) then
                    let p = maybe.unwrap(parent)
                    if maybe.isSome(p.top) then p.top else parent end
                else
                    maybe.none()
                end
        end

    let newTypes(): maps.IntMap(Type) = maps.newIntMap()
    let childFrame(parent: Frame): Frame = newFrame(maybe.some(parent) newTypes())
    let topOf(f: Frame): Frame = maybe.unwrapOr(f.top f)

    let setValue(f: Frame v: Variable value: Value): Ok = begin hashMap.insert(f.values v.id maybe.some(value)) ok end

    (* The slot of a variable, outward from f *)
    let rec slot(f: Frame v: Variable): maybe.T(Value) =
        begin
            let found = hashMap.get(f.values v.id)
            if maybe.isSome(found) then
                maybe.unwrap(found)
            elsif maybe.isSome(f.parent) then
                slot(maybe.unwrap(f.parent) v)
            else
                fail("variable '" <> v.hint <> "' is not bound")
            end
        end

    let isUnbound(f: Frame v: Variable): Bool = maybe.isNone(slot(f v))

    let lookup(f: Frame v: Variable): Value =
        begin
            let s = slot(f v)
            if maybe.isNone(s) then model.internalError("Undefined runtime symbol '" <> v.hint <> "'" none)
            else maybe.unwrap(s)
            end
        end

    (* Binds a declared variable in the frame that declared it *)
    let rec bindDeclared(f: Frame v: Variable value: Value): Ok =
        begin
            let found = hashMap.get(f.values v.id)
            if maybe.isSome(found) andif maybe.isNone(maybe.unwrap(found)) then
                setValue(f v value)
            elsif maybe.isSome(f.parent) then
                bindDeclared(maybe.unwrap(f.parent) v value)
            else
                fail("declared variable '" <> v.hint <> "' is bound outside its scope")
            end
        end

    let rec raisedError(f: Frame v: Variable): maybe.T(model.RunError) =
        begin
            let found = hashMap.get(f.raised v.id)
            if maybe.isSome(found) orif maybe.isNone(f.parent) then found
            else raisedError(maybe.unwrap(f.parent) v)
            end
        end

    let rec lookupType(f: Frame symbolId: Int): maybe.T(Type) =
        begin
            let found = hashMap.get(f.types symbolId)
            if maybe.isSome(found) orif maybe.isNone(f.parent) then found
            else lookupType(maybe.unwrap(f.parent) symbolId)
            end
        end

    (* t with the type arguments of the type parameters it mentions
     * substituted *)
    let resolve(f: Frame t: Type): Type =
        begin
            let subst = tm.newSubst()
            for i = 0 upto {extent t.fv - 1} do
                let bound = lookupType(f t.fv[i])
                if maybe.isSome(bound) then hashMap.insert(subst t.fv[i] maybe.unwrap(bound)) end
            end
            if hashMap.empty(subst) then t else tm.substitute(t subst) end
        end

    let resolveAll(f: Frame types: Array(Type)): Array(Type) =
        begin
            let result = array of(extent types tm.okType)
            for i = 0 upto {extent types - 1} do result[i] := resolve(f types[i]) end
            result
        end

    (* ======================================================================
     * The interpreter
     * ====================================================================== *)

    (* An IR function value: its function, the frame its calls run in, and the
     * types bound to its type parameters. After closure conversion, the frame
     * binds the function's environment variable to the values it captured
     * (closureFrame), as model.Closure's frame holds a tree-walker closure's.
     * It is a builtin to the tree-walking interpreter, so that library
     * functions written in Quest can call it. *)
    Let IrClosure = Tuple
        function: nodes.Function
        frame: Frame
        typeBindings: maps.IntMap(Type)
    end

    Let Signal = Option
        sigReturn with value: Value end
        sigJump with label: String args: Array(Value) end
        sigBreak with label: String end
        sigContinue with label: String end
    end
    Let Signals = maybe.T(Signal)
    let noSignal: Signals = maybe.none()
    let signal(s: Signal): Signals = maybe.some(s)

    (* A capture of a closure made in a let rec of a variable it has yet to
     * bind *)
    Let Fixup = Tuple values: Array(Value) index: Int v: Variable frame: Frame end

    let builtinEqual(a: model.Builtin b: model.Builtin): Bool = a is b
    let builtinHash(b: model.Builtin): word.T = hash.identityHash(b)

    (* Interpreter holds the state of running one IR unit at any pipeline
     * stage, sharing the tree-walking interpreter's runtime frame (renv): its
     * values, its call stack, and the modules it has loaded.
     *
     * runUnit runs the unit's imports (by the tree-walking interpreter), then
     * each of its modules' initializers, in a frame of its own whose variables
     * become the module's members, and then its main body.
     *
     * Control flow inside a function is by signals, not Quest exceptions: a
     * statement gives noSignal to fall through, or the terminator it reached,
     * sigReturn with its value, sigJump with its label and values, sigBreak,
     * or sigContinue with its label, which each enclosing statement passes up
     * until one that handles it. The abs function in the comment on
     * lower.Lowerer,
     *
     *     join k1(r: Int) { return r }
     *     in { ... if %1 { ... jump k1(%2) } else { jump k1(n) } }
     *
     * runs the join's body (after in), whose jump signal reaches the join; the
     * join binds r and runs its continuation, whose return signal ends the
     * call. A raise is a Quest exception (model.runError), which a try
     * catches.
     *
     * After closure conversion (the pass that makes each local function code
     * of its own, with the values it uses from around it passed in as
     * captures), a closure is made by a closure operation, which copies the
     * values it captures (makeClosure). A let rec's closures may capture
     * variables it has yet to bind, so makeClosure records each such capture
     * in fixups, and the let rec fills them in once its body has bound the
     * variables. *)
    Let Interpreter = Tuple
        (* The tree-walking interpreter's frame, whose root has the call stack,
         * runs imported modules, and binds the builtins (opBuiltin): true,
         * false, ok, and the operators as functions *)
        renv: model.Frame
        (* The unit's modules and those it imports (by id), as records of their
         * members *)
        modules: maps.IntMap(Value)
        (* The variables (by id) a let rec has declared, each set when its
         * let rec starts and never removed. The let rec makes an empty slot
         * for each in its own frame; the let in its body that computes the
         * value may run in a nested frame (a loop body's), so statement binds
         * these variables with bindDeclared, which fills the slot where the
         * let rec and its fixups look, rather than in the current frame. *)
        declared: maps.IntSet
        fixups: vector.T(vector.T(Fixup))
        var sourceMap: maybe.T(location.SourceMap)
        (* The symbols of the type parameters the unit's functions' descriptor
         * variables describe (by variable) *)
        descriptorSymbols: maps.IntMap(Int)
        (* The IR closures, by their builtin values *)
        closures: hashMap.T(model.Builtin IrClosure)
        (* The calls in tail position (by their result variables' ids) of the
         * functions analyzed so far (by id), found by findTailCalls *)
        tailCalls: maps.IntSet
        analyzed: maps.IntSet
    end

    let stack(it: Interpreter): vector.T(String) = it.renv.root.callStack

    (* e, raised by an operation at offset in the unit, located there unless it
     * already is *)
    let located(it: Interpreter e: model.RunError offset: maybe.T(Int)): model.RunError =
        begin
            if maybe.isNone(e.offset) andif maybe.isNone(e.sourceMap) andif maybe.isSome(offset) then
                e.offset := offset
                e.sourceMap := it.sourceMap
            end
            e
        end

    (* Runs f, locating the errors it raises at offset *)
    let at(A::TYPE it: Interpreter offset: maybe.T(Int) f: All() A): A =
        try f() when model.runError with e then rethrow(located(it e offset)) end

    let raising(A::TYPE it: Interpreter exc: model.ExceptionValue offset: maybe.T(Int)): A =
        at(it offset fun(): A model.raiseException(:A exc maybe.none(:Int)))

    (* Raises arrayOp.error at offset unless i indexes a *)
    let checkIndex(it: Interpreter a: Array(Value) i: Int offset: maybe.T(Int)): Ok =
        if not(primitives.inBounds(a i)) then raising(:Ok it primitives.arrayOpError offset) end

    (* What a variable declared without a value holds until it is assigned:
     * a string no program can make, told apart by identity (opIsSet) *)
    let unsetText = "<unset>"
    let unsetValue: Value = model.stringValue(unsetText)
    let isUnset(v: Value): Bool = case v when vString with x then x.s is unsetText else false end

    let moduleValue(it: Interpreter r: nodes.ModuleRef): Value =
        begin
            let id = case r when refModule with x then x.m.id when refImport with x then x.i.id end
            let found = hashMap.get(it.modules id)
            if maybe.isNone(found) then fail(:Value "module '" <> nodes.moduleRefName(r) <> "' is not loaded") end
            maybe.unwrap(found)
        end

    let member(it: Interpreter r: nodes.ModuleRef name: String): Value =
        case moduleValue(it r)
            when vRecord with x then
                let found = model.fieldGet(x.r name)
                if maybe.isNone(found) then
                    fail(:Value "module '" <> nodes.moduleRefName(r) <> "' has no member " <> name)
                end
                maybe.unwrap(found)
            else fail("module '" <> nodes.moduleRefName(r) <> "' is a " <> model.typeName(moduleValue(it r)))
        end

    (* Atoms *)

    let atom(it: Interpreter a: Atom f: Frame): Value =
        case a
            when atomVar with x then
                let value = lookup(f x.v)
                (* A mutable variable holds a cell; a use reads it *)
                if x.v.isMutable then
                    case value when vRef with r then model.deref(r.r) else value end
                else
                    value
                end
            when atomConst with x then
                case x.c.value
                    when constOk then model.okValue
                    when constBool with y then model.boolValue(y.b)
                    when constInt with y then model.intValue(y.n)
                    when constReal with y then model.realValue(y.r)
                    when constChar with y then model.charValue(y.c)
                    when constString with y then
                        literals.freeze(y.s)
                        model.stringValue(y.s)
                end
        end

    let atoms(it: Interpreter items: Array(Atom) f: Frame): Array(Value) =
        begin
            let values = array of(extent items model.okValue)
            for i = 0 upto {extent items - 1} do values[i] := atom(it items[i] f) end
            values
        end

    (* The element of a tuple holding its index'th value component (its type
     * components are elements too) *)
    let elementIndex(t: model.TupleValue index: Int): Int =
        begin
            let var n = ~1
            let var found = ~1
            for i = 0 upto {extent t.elements - 1} do
                if not(t.elements[i]?vTypeValue) then
                    n := n + 1
                    if {n is index} andif {found < 0} then found := i end
                end
            end
            if found < 0 then fail(:Ok "tuple has no value component " <> conv.int(index)) end
            found
        end

    let tupleOf(v: Value): model.TupleValue =
        case model.unwrapRefs(v)
            when vTuple with x then x.t
            else fail("not a tuple: " <> model.typeName(v))
        end

    let tagOf(v: Value): String =
        case v
            when vVariant with x then x.v.tag
            when vOption with x then x.v.tag
            else fail("not a variant or option: " <> model.typeName(v))
        end

    (* A variant's payload, or an option's components (its ordinal in its
     * static type first) as a new tuple (its var components copies of the
     * payload's, which a case's binder shares) *)
    let payloadOf(v: Value tag: String ordinalIndex: maybe.T(Int)): Value =
        begin
            if not(eq(tagOf(v) tag)) then model.raiseException(:Ok primitives.variantError none) end
            case v
                when vOption with x then
                    if maybe.isNone(ordinalIndex) then
                        fail(:Ok "the payload of option case " <> tag <> " without its ordinal")
                    end
                    primitives.optionComponents(maybe.unwrap(ordinalIndex) x.v.payload)
                when vVariant with x then maybe.unwrapOr(x.v.payload model.okValue)
                else model.okValue
            end
        end

    (* Whether a polymorphic function, applied to all its types, is a
     * function *)
    let isFunctionType(f: nodes.Function): Bool =
        begin
            let var t = formatting.exposedType(f.v.type)
            let var more = true
            while more do
                case t.form
                    when typeAll with x then t := formatting.exposedType(x.body)
                    else more := false
                end
            end
            t.form?typeFun
        end

    let typeParamIds(fn: nodes.Function): Array(Int) =
        begin
            let ids = array of(extent fn.typeParams 0)
            for i = 0 upto {extent fn.typeParams - 1} do ids[i] := fn.typeParams[i].symbolId end
            ids
        end

    let instantiate(c: IrClosure typeArgs: Array(Type)): IrClosure =
        tuple
            let function = c.function
            let frame = c.frame
            let typeBindings = model.bindTypeArguments(c.typeBindings typeParamIds(c.function) typeArgs)
        end

    (* The frame code's closures run their calls in: parent, with code's
     * environment variable, if it has one, bound to the values captured *)
    let closureFrame(code: nodes.Function captures: Array(Value) parent: Frame): Frame =
        if maybe.isSome(code.env) then
            let f = childFrame(parent)
            setValue(f maybe.unwrap(code.env) option vArray of Value with let a = captures end)
            f
        else
            parent
        end

    let holeUse = option hole of tm.ReservedSymbolUse end

    (* Whether a is the variable v *)
    let isVariable(a: Atom v: Variable): Bool = case a when atomVar with x then x.v.id is v.id else false end

    (* Whether statements, from the i-th on, return v: through Converts of it,
     * to a return of it or a jump with it to a join that returns it (one of
     * returning, by label) *)
    let returns(statements: vector.T(Stmt) i: Int v: Variable returning: Array(String)): Bool =
        begin
            let var at = i
            let var value = v
            let var answer = maybe.none(:Bool)
            while maybe.isNone(answer) do
                if at >= vector.length(statements) then
                    answer := maybe.some(false)
                else
                    case vector.get(statements at)
                        when sLet with x then
                            case x.value
                                when opConvert with c then
                                    if isVariable(c.value value) then
                                        value := x.v
                                        at := at + 1
                                    else
                                        answer := maybe.some(false)
                                    end
                                else answer := maybe.some(false)
                            end
                        when sReturn with x then answer := maybe.some(isVariable(x.value value))
                        when sJump with x then
                            answer := maybe.some(strings.isOneOf(x.label returning) andif {extent x.args is 1}
                                andif isVariable(x.args[0] value))
                        else answer := maybe.some(false)
                    end
                end
            end
            maybe.unwrap(answer)
        end

    (* Adds to found the calls in tail position in b (docs/interpreter.md section
     * 3.3), by their result variables' ids: a call whose result the function
     * returns, directly or through Converts and jumps to joins (returning, by
     * label) that return their parameter. A call in a try's body or handler
     * is not one, nor one in another function's body. *)
    let rec findTailCalls(b: Body returning: Array(String) found: maps.IntSet): Ok =
        for i = 0 upto {vector.length(b.statements) - 1} do
            case vector.get(b.statements i)
                when sLet with x then
                    if x.value?opCall andif returns(b.statements {i + 1} x.v returning) then
                        hashSet.insert(found x.v.id)
                    end
                when sIf with x then
                    findTailCalls(x.thenBody returning found)
                    findTailCalls(x.elseBody returning found)
                when sSwitch with x then
                    for j = 0 upto {extent x.cases - 1} do findTailCalls(x.cases[j].body returning found) end
                    if maybe.isSome(x.elseBody) then findTailCalls(maybe.unwrap(x.elseBody) returning found) end
                when sInspect with x then
                    for j = 0 upto {extent x.cases - 1} do findTailCalls(x.cases[j].body returning found) end
                    if maybe.isSome(x.elseBody) then findTailCalls(maybe.unwrap(x.elseBody) returning found) end
                when sLoop with x then findTailCalls(x.body returning found)
                when sLetRec with x then findTailCalls(x.body returning found)
                when sJoin with x then
                    findTailCalls(x.continuation returning found)
                    if {extent x.params is 1} andif returns(x.continuation.statements 0 x.params[0] returning) then
                        let inner = array of(extent returning + 1 x.label)
                        for j = 0 upto {extent returning - 1} do inner[j] := returning[j] end
                        findTailCalls(x.body inner found)
                    else
                        findTailCalls(x.body returning found)
                    end
                else ok
            end
        end

    (* An IR closure's value: a builtin to the tree-walking interpreter, which
     * treewalk.runCall runs (root.tailCallables), so that tail calls between
     * the two interpreters add no active call either *)
    let rec closureValue(it: Interpreter c: IrClosure): Value =
        begin
            let root = it.renv.root
            let callable: model.TailCallable = tuple
                let traceName = c.function.traceName
                let run = fun(args: Array(Value)): Value activate(it c args)
            end
            let b: model.Builtin = tuple
                let name = c.function.v.hint
                (* IR calls have no offsets, so stack.overflow is not located *)
                let fn = fun(args: Array(Value)): Value treewalk.runCall(root callable args none)
            end
            hashMap.insert(it.closures b c)
            hashMap.insert(root.tailCallables b callable)
            option vBuiltin of Value with let b = b end
        end

    and irClosureOf(it: Interpreter v: Value): maybe.T(IrClosure) =
        case v
            when vBuiltin with x then hashMap.get(it.closures x.b)
            else maybe.none()
        end

    and inFrame(it: Interpreter name: String b: Body f: Frame): Signals =
        begin
            vector.append(stack(it) name)
            let result =
                try
                    runBody(it b f)
                when model.runError with e then
                    treewalk.noteFrames(e it.renv)
                    vector.pop(stack(it))
                    rethrow(:Signals e)
                end
            vector.pop(stack(it))
            result
        end

    (* One call of an IR closure, in the frame treewalk.runCall has pushed: its
     * value, or ok, with the root's pendingCall set, if its body ended with a
     * call in tail position *)
    and activate(it: Interpreter c: IrClosure args: Array(Value)): Value =
        begin
            let types = newTypes()
            hashMap.forEach(c.typeBindings fun(k: Int t: Type): Ok begin hashMap.insert(types k t) ok end)
            let f = newFrame(maybe.some(c.frame) types)
            let fn = c.function
            for i = 0 upto {extent fn.params - 1} do if i < extent args then setValue(f fn.params[i].v args[i]) end end
            if not(hashSet.contains(it.analyzed fn.id)) then
                hashSet.insert(it.analyzed fn.id)
                findTailCalls(fn.body array of :String end it.tailCalls)
            end
            let s =
                try
                    runBody(it fn.body f)
                when model.runError with e then
                    if maybe.isSome(fn.traceName) then treewalk.noteFrames(e it.renv) end
                    rethrow(:Signals e)
                end
            case maybe.unwrapOr(s option sigBreak of Signal with let label = "" end)
                when sigReturn with x then x.value
                else fail("function '" <> fn.v.hint <> "' ends without returning")
            end
        end

    and apply(it: Interpreter callee: Value args: Array(Value)): Value =
        case callee
            when vBuiltin with x then x.b.fn(args)
            when vClosure with x then treewalk.runClosure(x.c args none)
            else fail("Cannot call non-function of type " <> model.typeName(callee))
        end

    (* A polymorphic value applied to types: its instance (the value, for a
     * polymorphic function with no value parameters) *)
    and typeApply(it: Interpreter callee: Value typeArgs: Array(Type)): Value =
        begin
            let irc = irClosureOf(it callee)
            if maybe.isSome(irc) then
                let c = maybe.unwrap(irc)
                let inst = instantiate(c typeArgs)
                let instValue = closureValue(it inst)
                (* A function whose type parameters are its only parameters: it
                 * has no value parameters, and its type, applied to all its
                 * types, is not a function's *)
                let typeOnly = {extent c.function.params is 0} andif not(isFunctionType(c.function))
                if model.runsWhenApplied(typeOnly typeParamIds(c.function) inst.typeBindings) then
                    apply(it instValue array of :Value end)
                else
                    instValue
                end
            else
                case callee
                    when vClosure with x then
                        let inst = if extent x.c.typeParamIds > 0 then treewalk.instantiate(x.c typeArgs) else x.c end
                        if model.runsWhenApplied(inst.typeOnly inst.typeParamIds inst.typeBindings) then
                            treewalk.runClosure(inst array of :Value end none)
                        else
                            option vClosure of Value with let c = inst end
                        end
                    else callee
                end
            end
        end

    and calleeValue(it: Interpreter v: maybe.T(Variable) r: maybe.T(nodes.ModuleRef) name: maybe.T(String)
            f: Frame): Value =
        if maybe.isSome(v) then atom(it nodes.atomOfVar(maybe.unwrap(v)) f)
        else member(it maybe.unwrap(r) maybe.unwrapOr(name ""))
        end

    (* The type a descriptor operand describes in the frame *)
    and described(it: Interpreter d: nodes.Descriptor f: Frame): Type =
        case d
            when descVar with x then
                let t = lookupType(f maybe.unwrapOr(hashMap.get(it.descriptorSymbols x.v.id) ~1))
                if maybe.isNone(t) then fail(:Ok "descriptor variable '" <> x.v.hint <> "' describes no type here") end
                maybe.unwrap(t)
            when descStatic with x then resolve(f x.d.type)
            when descInstantiate with x then
                let args = tm.newSubst()
                for i = 0 upto {extent x.args - 1} do
                    hashMap.insert(args tm.reservedSymbolId(holeUse i) described(it x.args[i] f))
                end
                tm.substitute(resolve(f x.template) args)
        end

    (* Checks that descriptor operands describe the types they stand for (after
     * the describe pass) *)
    and checkDescriptors(it: Interpreter ds: Array(nodes.Descriptor) types: Array(Type) f: Frame): Ok =
        for i = 0 upto {extent ds - 1} do
            if i < extent types then
                let d = described(it ds[i] f)
                let t = resolve(f types[i])
                if not(subtyping.isTypeEqual(d t maybe.none())) then
                    fail(:Ok "a descriptor of " <> tm.show(d) <> " stands for " <> tm.show(t))
                end
            end
        end

    (* A closure of a lifted function, whose frames see only the globals of the
     * top level that makes it *)
    and makeClosure(it: Interpreter code: nodes.Function captures: Array(Atom) typeArgs: Array(Type) f: Frame): Value =
        begin
            let values = array of(extent captures model.okValue)
            for i = 0 upto {extent captures - 1} do
                let pending =
                    case captures[i]
                        when atomVar with x then isUnbound(f x.v) andif not(vector.empty(it.fixups))
                        else false
                    end
                if pending then
                    (* A variable of an enclosing let rec, bound once its body
                     * has run *)
                    case captures[i]
                        when atomVar with x then
                            vector.append(vector.last(it.fixups)
                                    tuple let values = values let index = i let v = x.v let frame = f end)
                        else ok
                    end
                else
                    values[i] := atom(it captures[i] f)
                end
            end
            let bindings = newTypes()
            for i = 0 upto {extent code.typeParams - 1} do
                if i < extent typeArgs then
                    hashMap.insert(bindings code.typeParams[i].symbolId resolve(f typeArgs[i]))
                end
            end
            closureValue(it tuple
                let function = code
                let frame = closureFrame(code values topOf(f))
                let typeBindings = bindings
            end)
        end

    (* A tuple laid out as the tree-walking interpreter lays it out: its type
     * components are elements too *)
    and makeTuple(it: Interpreter values: Array(Value) typeComponents: Array(nodes.TypeComponent)
            result: maybe.T(Variable)
            f: Frame): Value =
        begin
            let t = formatting.exposedType(maybe.unwrap(result).type)
            case t.form
                when typeTuple with x then
                    if extent typeComponents is 0 then
                        let labels = array of(extent x.fields maybe.none(:String))
                        for i = 0 upto {extent x.fields - 1} do labels[i] := tm.componentName(x.fields[i]) end
                        model.tupleValue(values if extent labels is extent values then maybe.some(labels)
                            else maybe.none() end)
                    else
                        let elements = vector.new(:Value)
                        let labels = array of(extent x.fields maybe.none(:String))
                        let var nextWitness = 0
                        let var nextValue = 0
                        let witness = fun(index: Int bound: maybe.T(tm.Kind)): Value
                            begin
                                let w = typeComponents[index]
                                option vTypeValue of Value with
                                    let t =
                                        tuple
                                            let type = resolve(f w.type)
                                            let bound = bound
                                            let name = maybe.some(w.name)
                                        end
                                end
                            end
                        for i = 0 upto {extent x.fields - 1} do
                            labels[i] := tm.componentName(x.fields[i])
                            case x.fields[i]
                                when tupleTypeFormal with c then
                                    vector.append(elements witness(nextWitness maybe.some(c.bound)))
                                    nextWitness := nextWitness + 1
                                when tupleTypeBinding with c then
                                    vector.append(elements witness(nextWitness c.bound))
                                    nextWitness := nextWitness + 1
                                when tupleField then
                                    vector.append(elements values[nextValue])
                                    nextValue := nextValue + 1
                            end
                        end
                        model.tupleValue(vector.toArray(elements) maybe.some(labels))
                    end
                else model.tupleValue(values maybe.none())
            end
        end

    and address(it: Interpreter o: Op f: Frame): Value =
        case o
            when opAddrVar with x then lookup(f x.v)
            when opAddrCell with x then model.cellValue(atom(it x.init f))
            when opAddrField with x then
                case model.unwrapRefs(atom(it x.base f))
                    when vRecord with r then
                        let cell = hashMap.get(r.r.fields x.name)
                        if maybe.isSome(cell) andif maybe.unwrap(cell)?vRef then maybe.unwrap(cell)
                        else fail("Field '" <> x.name <> "' is not mutable")
                        end
                    else fail("Field '" <> x.name <> "' is not mutable")
                end
            when opAddrComponent with x then
                let base = tupleOf(atom(it x.base f))
                let i = elementIndex(base x.index)
                let element = base.elements[i]
                if element?vRef then
                    element
                else
                    option vRef of Value with
                        let r =
                            tuple
                                let form = option tupleElement of model.RefForm with let tup = base let index = i end
                            end
                    end
                end
            when opAddrElement with x then
                case model.unwrapRefs(atom(it x.base f))
                    when vArray with a then
                        let idx = intOf(atom(it x.index f))
                        checkIndex(it a.a idx x.offset)
                        option vRef of Value with
                            let r =
                                tuple
                                    let form =
                                        option arrayElement of model.RefForm with let arr = a.a let index = idx end
                                end
                        end
                    else fail("not an array")
                end
            else fail("not an address")
        end

    and prim(it: Interpreter op: nodes.Prim args: Array(Value)): Value =
        begin
            let ints = fun(o: primitives.Arithmetic): Value
                model.intValue(primitives.intArithmetic(o intOf(args[0]) intOf(args[1]) none))
            let intsCompared =
                fun(c: primitives.Comparison): Value
                    model.boolValue(primitives.intRelational(c intOf(args[0]) intOf(args[1])))
            let reals = fun(o: primitives.Arithmetic): Value
                model.realValue(primitives.realArithmetic(o realOf(args[0]) realOf(args[1]) none))
            let realsCompared = fun(c: primitives.Comparison): Value
                model.boolValue(primitives.realRelational(c realOf(args[0]) realOf(args[1])))
            case op
                when primIs then model.boolValue(model.same(args[0] args[1]))
                when primIsnot then model.boolValue(not(model.same(args[0] args[1])))
                when primNot then model.boolValue(not(boolOf(args[0])))
                when primExtent then model.intValue(extent arrayOf(args[0]))
                when primAdd then ints(primitives.add)
                when primSub then ints(primitives.sub)
                when primMul then ints(primitives.mul)
                when primDiv then ints(primitives.div)
                when primMod, primRem then ints(primitives.rem)
                when primLt then intsCompared(primitives.lt)
                when primLe then intsCompared(primitives.le)
                when primGt then intsCompared(primitives.gt)
                when primGe then intsCompared(primitives.ge)
                when primRealAdd then reals(primitives.add)
                when primRealSub then reals(primitives.sub)
                when primRealMul then reals(primitives.mul)
                when primRealDiv then reals(primitives.div)
                when primRealPow then reals(primitives.pow)
                when primRealLt then realsCompared(primitives.lt)
                when primRealLe then realsCompared(primitives.le)
                when primRealGt then realsCompared(primitives.gt)
                when primRealGe then realsCompared(primitives.ge)
                when primConcat then model.stringValue(stringOf(args[0]) <> stringOf(args[1]))
                when primAnd then model.boolValue(boolOf(args[0]) andif boolOf(args[1]))
                when primOr then model.boolValue(boolOf(args[0]) orif boolOf(args[1]))
            end
        end

    and operation(it: Interpreter o: Op f: Frame result: maybe.T(Variable)): Value =
        case o
            when opAtom with x then atom(it x.atom f)
            when opPrim with x then
                let values = atoms(it x.args f)
                (* is compares at its first operand's type (docs/extensions.md,
                 * Options as Values) *)
                if {x.op?primIs orif x.op?primIsnot} andif {extent x.args > 0} then
                    model.boolValue(primitives.sameAt(resolve(f nodes.atomType(x.args[0])) values[0] values[1])
                        is x.op?primIs)
                else
                    at(it x.offset fun(): Value prim(it x.op values))
                end
            when opCall with x then
                checkDescriptors(it x.descriptors x.typeArgs f)
                let var callee = calleeValue(it x.callee x.moduleRef x.member f)
                if extent x.typeArgs > 0 then callee := typeApply(it callee resolveAll(f x.typeArgs)) end
                apply(it callee atoms(it x.args f))
            when opTypeApp with x then
                checkDescriptors(it x.descriptors x.typeArgs f)
                typeApply(it calleeValue(it x.callee x.moduleRef x.member f) resolveAll(f x.typeArgs))
            when opModuleMember with x then
                if maybe.isNone(x.member) then moduleValue(it x.moduleRef)
                else member(it x.moduleRef maybe.unwrap(x.member))
                end
            when opBuiltin with x then treewalk.lookup(it.renv x.name none)
            when opMakeClosure with x then
                checkDescriptors(it x.descriptors x.typeArgs f)
                makeClosure(it x.code x.captures x.typeArgs f)
            when opEnvField with x then
                case atom(it x.env f)
                    when vArray with a then a.a[x.index]
                    else fail("env_field of a value other than an environment")
                end
            (* A change of representation, which values here do not have *)
            when opConvert with x then atom(it x.value f)
            when opExternal with x then builtins.resolveExternal(x.symbol)
            when opCallExternal with x then
                let types = array of(extent x.typeArgs tm.okType)
                for i = 0 upto {extent x.typeArgs - 1} do types[i] := resolve(f x.typeArgs[i]) end
                builtins.callExternal(x.symbol types atoms(it x.args f))
            when opMakeTuple with x then makeTuple(it atoms(it x.args f) x.typeComponents result f)
            when opTupleField with x then
                let t = tupleOf(atom(it x.tup f))
                t.elements[elementIndex(t x.index)]
            when opMakeRecord with x then
                let fields = model.newFields()
                for i = 0 upto {extent x.fields - 1} do
                    let fa = x.fields[i]
                    let v = atom(it fa.atom f)
                    hashMap.insert(fields fa.name if fa.isVar then model.cellValue(v) else v end)
                end
                model.recordValue(fields)
            when opRecordField with x then
                case model.unwrapRefs(atom(it x.recordAtom f))
                    when vTuple with t then
                        let found = model.tupleGet(t.t x.name)
                        if maybe.isNone(found) then fail(:Value "no component " <> x.name) end
                        maybe.unwrap(found)
                    when vRecord with r then
                        let found = hashMap.get(r.r.fields x.name)
                        if maybe.isNone(found) then fail(:Value "no field " <> x.name) end
                        model.unwrapRefs(maybe.unwrap(found))
                    else fail("not a record")
                end
            when opMakeVariant with x then
                model.variantValue(x.tag if maybe.isSome(x.payload) then maybe.some(atom(it maybe.unwrap(x.payload) f))
                    else maybe.none() end)
            when opMakeOption with x then
                let p =
                    if maybe.isSome(x.payload) then
                        maybe.some(atom(it maybe.unwrap(x.payload) f))
                    else
                        maybe.none(:Value)
                    end
                if maybe.isSome(x.ordinalAtom) then
                    let n = intOf(atom(it maybe.unwrap(x.ordinalAtom) f))
                    if {n < 0} orif {n >= extent x.cases} then
                        at(it x.offset fun(): Ok
                            model.internalError(:Ok "Option ordinal " <> model.toString(model.intValue(n))
                                <> " out of bounds (0 <= ordinal < " <> conv.int(extent x.cases) <> ")" none))
                    end
                    model.optionValue(x.cases[n] p)
                else
                    model.optionValue(maybe.unwrapOr(x.tag "") p)
                end
            when opIsTag with x then model.boolValue(eq(tagOf(atom(it x.value f)) x.tag))
            when opPayload with x then
                let v = atom(it x.value f)
                at(it x.offset fun(): Value payloadOf(v x.tag x.ordinalIndex))
            when opOrdinal with x then
                case atom(it x.value f)
                    when vOption with y then
                        let var index = ~1
                        for i = {extent x.cases - 1} downto 0 do if eq(x.cases[i] y.v.tag) then index := i end end
                        if index < 0 then fail(:Ok "no case " <> y.v.tag) end
                        model.intValue(index)
                    else fail("ordinal expects Option, got " <> model.typeName(atom(it x.value f)))
                end
            when opMakeArray with x then option vArray of Value with let a = atoms(it x.args f) end
            when opArrayRep with x then
                let n = intOf(atom(it x.count f))
                if n < 0 then raising(:Ok it primitives.arrayOpError x.offset) end
                let v = atom(it x.init f)
                option vArray of Value with let a = array of(n v) end
            when opIndex with x then
                case atom(it x.arr f)
                    when vArray with a then
                        let idx = intOf(atom(it x.index f))
                        checkIndex(it a.a idx x.offset)
                        a.a[idx]
                    else fail("not an array")
                end
            when opMakeAuto with x then
                if maybe.isSome(x.descriptor) then
                    checkDescriptors(it array of maybe.unwrap(x.descriptor) end array of x.witness end f)
                end
                option vAuto of Value with
                    let a = tuple let value = atom(it x.payload f) let type = resolve(f x.witness) end
                end
            when opMakeException with x then option vException of Value with let e = model.exceptionValue(x.name) end
            when opExceptionPayload with x then
                let e =
                    case x.exc
                        when atomVar with y then raisedError(f y.v)
                        else maybe.none(:model.RunError)
                    end
                if maybe.isNone(e) then fail(:Ok "exception_payload of a value other than a handler's exception") end
                case maybe.unwrap(e).cause
                    when raised with y then maybe.unwrapOr(y.payload model.okValue)
                    else model.okValue
                end
            when opCaughtException with x then
                let e =
                    case x.exc
                        when atomVar with y then raisedError(f y.v)
                        else maybe.none(:model.RunError)
                    end
                if maybe.isNone(e) then fail(:Ok "caught_exception of a value other than a handler's exception") end
                (* Record the active call frames as if the error had left this
                 * frame, in case it was raised here (docs/raised.md section
                 * 5) *)
                treewalk.noteFrames(maybe.unwrap(e) it.renv)
                option vRaised of Value with let e = maybe.unwrap(e) end
            when opAddrVar then address(it o f)
            (* A cell declared without a value holds the unset value until
             * assigned (sVarDecl) *)
            when opIsSet with x then
                case lookup(f x.v)
                    when vRef with r then model.boolValue(not(isUnset(model.deref(r.r))))
                    else fail(:Value "is_set of a variable that is not mutable")
                end
            when opAddrCell then address(it o f)
            when opAddrField then address(it o f)
            when opAddrComponent then address(it o f)
            when opAddrElement then address(it o f)
            when opLoad with x then model.unwrapRefs(atom(it x.address f))
        end

    and store(it: Interpreter s: Stmt f: Frame): Ok =
        case s
            when sStoreAt with x then
                let value = atom(it x.value f)
                case atom(it x.address f)
                    when vRef with r then model.assign(r.r value)
                    else fail("a store through a value that is not an address")
                end
            when sStoreField with x then
                let value = atom(it x.value f)
                case model.unwrapRefs(atom(it x.base f))
                    when vRecord with r then model.fieldSet(r.r x.name value)
                    else fail("a field store into a value that is not a record")
                end
            when sStoreComponent with x then
                let value = atom(it x.value f)
                let base = tupleOf(atom(it x.base f))
                let i = elementIndex(base x.index)
                case base.elements[i]
                    when vRef with c then model.assign(c.r value)
                    else base.elements[i] := value
                end
            when sStoreElement with x then
                let value = atom(it x.value f)
                case model.unwrapRefs(atom(it x.base f))
                    when vArray with a then
                        let idx = intOf(atom(it x.index f))
                        checkIndex(it a.a idx x.offset)
                        a.a[idx] := value
                    else fail("not an array")
                end
            else ok
        end

    (* Statements *)

    (* A call in tail position (findTailCalls), whose result v would be: its
     * callee and arguments, as the root's pendingCall for treewalk.runCall to
     * make, if the callee is a function of either interpreter; any other is
     * called here *)
    and tailCall(it: Interpreter v: Variable o: Op f: Frame): Signals =
        case o
            when opCall with x then
                checkDescriptors(it x.descriptors x.typeArgs f)
                let var callee = calleeValue(it x.callee x.moduleRef x.member f)
                if extent x.typeArgs > 0 then callee := typeApply(it callee resolveAll(f x.typeArgs)) end
                let args = atoms(it x.args f)
                let root = it.renv.root
                let pends =
                    case callee
                        when vClosure then true
                        when vBuiltin with b then hashMap.contains(root.tailCallables b.b)
                        else false
                    end
                if pends then
                    root.pendingCall := maybe.some(tuple let callee = callee let args = args let offset = none end)
                    signal(option sigReturn of Signal with let value = model.okValue end)
                else
                    setValue(f v apply(it callee args))
                    noSignal
                end
            else fail("a tail call of an operation that is not a call")
        end

    and runBody(it: Interpreter b: Body f: Frame): Signals =
        begin
            let var result = noSignal
            let var i = 0
            let n = vector.length(b.statements)
            while maybe.isNone(result) andif {i < n} do
                result := statement(it vector.get(b.statements i) f)
                i := i + 1
            end
            result
        end

    and statement(it: Interpreter s: Stmt f: Frame): Signals =
        case s
            when sLet with x then
                if hashSet.contains(it.tailCalls x.v.id) andif not(hashSet.contains(it.declared x.v.id)) then
                    tailCall(it x.v x.value f)
                else
                    let v = operation(it x.value f maybe.some(x.v))
                    if hashSet.contains(it.declared x.v.id) then bindDeclared(f x.v v) else setValue(f x.v v) end
                    noSignal
                end
            when sVarDecl with x then
                setValue(f x.v
                        model.cellValue(if maybe.isSome(x.init) then
                            atom(it maybe.unwrap(x.init) f)
                        else
                            unsetValue
                        end))
                noSignal
            when sAssign with x then
                case lookup(f x.v)
                    when vRef with r then model.assign(r.r atom(it x.value f))
                    else fail(:Ok "an assignment to a variable that is not mutable")
                end
                noSignal
            when sStoreAt then begin store(it s f) noSignal end
            when sStoreField then begin store(it s f) noSignal end
            when sStoreComponent then begin store(it s f) noSignal end
            when sStoreElement then begin store(it s f) noSignal end
            when sDo with x then begin operation(it x.value f maybe.none()) noSignal end
            when sFuns with x then
                for i = 0 upto {extent x.functions - 1} do
                    let fn = x.functions[i]
                    setValue(f fn.v
                            closureValue(it tuple
                                let function = fn
                                let frame = closureFrame(fn array of :Value end f)
                                let typeBindings = newTypes()
                            end))
                end
                noSignal
            when sLetRec with x then
                for i = 0 upto {extent x.vars - 1} do
                    hashSet.insert(it.declared x.vars[i].id)
                    hashMap.insert(f.values x.vars[i].id maybe.none(:Value))
                end
                vector.append(it.fixups vector.new(:Fixup))
                let result =
                    try
                        runBody(it x.body f)
                    when model.runError with e then
                        vector.pop(it.fixups)
                        rethrow(:Signals e)
                    end
                let fixups = vector.pop(it.fixups)
                for i = 0 upto {vector.length(fixups) - 1} do
                    let fx = vector.get(fixups i)
                    if isUnbound(fx.frame fx.v) andif not(vector.empty(it.fixups)) then
                        (* A variable of an enclosing let rec *)
                        vector.append(vector.last(it.fixups) fx)
                    else
                        fx.values[fx.index] := lookup(fx.frame fx.v)
                    end
                end
                result
            when sIf with x then
                case atom(it x.cond f)
                    when vBool with b then runBody(it if b.b then x.thenBody else x.elseBody end f)
                    else fail("a condition that is not a Bool")
                end
            when sSwitch with x then
                let v = atom(it x.value f)
                let tag = tagOf(v)
                let var chosen = maybe.none(:nodes.Case)
                for i = 0 upto {extent x.cases - 1} do
                    if maybe.isNone(chosen) then
                        let c = x.cases[i]
                        for j = 0 upto {extent c.tags - 1} do if eq(c.tags[j] tag) then chosen := maybe.some(c) end end
                    end
                end
                if maybe.isSome(chosen) then
                    let c = maybe.unwrap(chosen)
                    if maybe.isSome(c.binder) then
                        let payload =
                            case v
                                when vVariant with y then y.v.payload
                                when vOption with y then y.v.payload
                                else maybe.none(:Value)
                            end
                        setValue(f maybe.unwrap(c.binder) maybe.unwrapOr(payload model.okValue))
                    end
                    runBody(it c.body f)
                elsif maybe.isSome(x.elseBody) then
                    runBody(it maybe.unwrap(x.elseBody) f)
                else
                    fail("Unhandled case tag '" <> tag <> "'")
                end
            when sInspect with x then
                case atom(it x.value f)
                    when vAuto with a then
                        let var chosen = maybe.none(:nodes.InspectCase)
                        for i = 0 upto {extent x.cases - 1} do
                            if maybe.isNone(chosen) then
                                let c = x.cases[i]
                                if maybe.isSome(c.descriptor) then
                                    checkDescriptors(it
                                            array of maybe.unwrap(c.descriptor) end array of c.matchType end f)
                                end
                                let matchType = resolve(f c.matchType)
                                if primitives.inspectMatches(a.a.type matchType c.exact) then
                                    chosen := maybe.some(c)
                                end
                            end
                        end
                        if maybe.isSome(chosen) then
                            let c = maybe.unwrap(chosen)
                            for j = 0 upto {extent c.binders - 1} do setValue(f c.binders[j] a.a.value) end
                            runBody(it c.body f)
                        elsif maybe.isSome(x.elseBody) then
                            runBody(it maybe.unwrap(x.elseBody) f)
                        else
                            raising(it model.dynamicError x.offset)
                        end
                    else
                        fail("Inspect target must be an auto value, got "
                            <> model.typeName(atom(it x.value f)))
                end
            when sLoop with x then
                let var result = noSignal
                let var running = true
                while running do
                    let s2 = runBody(it x.body childFrame(f))
                    case maybe.unwrapOr(s2 option sigContinue of Signal with let label = x.label end)
                        when sigContinue with y then
                            if not(eq(y.label x.label)) then
                                result := s2
                                running := false
                            end
                        when sigBreak with y then
                            if not(eq(y.label x.label)) then result := s2 end
                            running := false
                        else
                            result := s2
                            running := false
                    end
                end
                result
            when sTry with x then
                try
                    runBody(it x.body f)
                when model.runError with e then
                    case e.cause
                        when raised with y then
                            setValue(f x.exc option vException of Value with let e = y.exc end)
                            hashMap.insert(f.raised x.exc.id e)
                            runBody(it x.handler f)
                        else rethrow(e)
                    end
                end
            when sJoin with x then
                let s2 = runBody(it x.body f)
                case maybe.unwrapOr(s2 option sigBreak of Signal with let label = "" end)
                    when sigJump with y then
                        if eq(y.label x.label) andif maybe.isSome(s2) then
                            for i = 0 upto {extent x.params - 1} do setValue(f x.params[i] y.args[i]) end
                            runBody(it x.continuation f)
                        else
                            s2
                        end
                    else s2
                end
            when sEcho with x then
                let v = atom(it x.value f)
                if stringOp.length(x.prefix) > 0 then
                    writer.putString(writer.output x.prefix <> formatting.formatValueWithType(v x.type) <> "\n")
                elsif not(v?vOk) then
                    writer.putString(writer.output formatting.formatValueWithType(v x.type) <> " : " <> tm.show(x.type)
                        <> "\n")
                end
                noSignal
            when sEchoText with x then begin writer.putString(writer.output x.text <> "\n") noSignal end
            when sReturn with x then signal(option sigReturn of Signal with let value = atom(it x.value f) end)
            when sJump with x then
                signal(option sigJump of Signal with let label = x.label let args = atoms(it x.args f) end)
            when sBreak with x then signal(option sigBreak of Signal with let label = x.label end)
            when sContinue with x then signal(option sigContinue of Signal with let label = x.label end)
            when sRaise with x then
                let exc = atom(it x.exc f)
                let payload =
                    if maybe.isSome(x.payload) then
                        maybe.some(atom(it maybe.unwrap(x.payload) f))
                    else
                        maybe.none(:Value)
                    end
                let payloadType =
                    if maybe.isSome(x.payload) then
                        case maybe.unwrap(x.payload)
                            when atomVar with y then maybe.some(y.v.type)
                            else maybe.none(:Type)
                        end
                    else
                        maybe.none(:Type)
                    end
                case exc
                    when vException with y then
                        rethrow(located(it model.raisedError(y.e payload payloadType maybe.none()) x.offset))
                    else fail("Target of raise must be Exception, got " <> model.typeName(exc))
                end
            when sReraise with x then
                let e = raisedError(f x.exc)
                if maybe.isNone(e) then fail(:Ok "reraise of a value other than a handler's exception") end
                rethrow(maybe.unwrap(e))
            when sUnreachable then fail("reached unreachable code")
        end

    (* Units *)

    let runTopLevel(it: Interpreter b: Body f: Frame frameName: maybe.T(String)): Ok =
        begin
            let s = if maybe.isNone(frameName) then runBody(it b f) else inFrame(it maybe.unwrap(frameName) b f) end
            if maybe.isSome(s) then fail(:Ok "a top level ends with a terminator") end
        end

    let runUnit(unit: nodes.Unit renv: model.Frame): Ok =
        begin
            let symbols = maps.newIntMap(:Int)
            for i = 0 upto {vector.length(unit.functions) - 1} do
                let fn = vector.get(unit.functions i)
                for j = 0 upto {extent fn.descriptorParams - 1} do
                    let p = fn.descriptorParams[j]
                    if extent p.symbols > 0 then hashMap.insert(symbols p.v.id p.symbols[0]) end
                end
            end
            let it: Interpreter = tuple
                let renv = renv
                let modules = maps.newIntMap()
                let declared = maps.newIntSet()
                let fixups = vector.new()
                let var sourceMap = unit.sourceMap
                let descriptorSymbols = symbols
                let closures = hashMap.new(builtinEqual builtinHash)
                let tailCalls = maps.newIntSet()
                let analyzed = maps.newIntSet()
            end
            (* Everything runs in the program's frame, imported modules'
             * initializers included *)
            vector.append(stack(it) diagnostics.mainFrame)
            try
                for i = 0 upto {extent unit.imports - 1} do
                    let imp = unit.imports[i]
                    (* Each imported module runs once per program and is cached
                     * for this unit *)
                    let value =
                        treewalk.loadModuleForInterpreter(imp.modulePath imp.interfacePath renv
                                maybe.some(imp.canonicalPath))
                    hashMap.insert(it.modules imp.id value)
                end
                for i = 0 upto {vector.length(unit.modules) - 1} do
                    let m = vector.get(unit.modules i)
                    let f = newFrame(maybe.none() newTypes())
                    runTopLevel(it m.init f maybe.some(diagnostics.initFrame(m.name)))
                    let fields = model.newFields()
                    for j = 0 upto {vector.length(m.members.names) - 1} do
                        let n = vector.get(m.members.names j)
                        hashMap.insert(fields n lookup(f hashMap.find(m.members.vars n)))
                    end
                    hashMap.insert(it.modules m.id model.recordValue(fields))
                end
                runTopLevel(it unit.main newFrame(maybe.none() newTypes()) maybe.none())
            when model.runError with e then
                treewalk.noteFrames(e renv)
                vector.pop(stack(it))
                rethrow(:Ok e)
            end
            vector.pop(stack(it))
            ok
        end
end
