(* Quest Self-Hosted Compiler: The Interpreter's Externals Interface
 *
 * Resolves each `external "symbol"` declaration in lib/ to a value, function,
 * or exception (resolveExternal), matching
 * bootstrap/python/quest/interpreter/builtins.py. While the bootstrap
 * implements each external in Python, the self-hosted interpreter calls the
 * corresponding host library function directly (docs/interpreter.md section 1):
 * an interpreted string, word, reader, writer, or string builder is the native
 * Quest value, and any native library exception (such as stringOp.error) is
 * re-raised as its interpreted counterpart (primitives.stringError). Only the
 * symbols used by lib/ are included here; the bootstrap's table also has math
 * functions under bare names (sin, cos, ...) that no library module binds. *)

interface Builtins
import
    tm = questlang/types/model : questlang/types/Model
    questlang/values/model : questlang/values/Model
export
    (* The value of an external symbol, a builtin function for a function *)
    resolveExternal(symbol: String): model.Value
    (* Calls the external function symbol with its type arguments, resolved,
     * and its arguments, as a function defined as `external "symbol"` calls
     * it. Most externals ignore the types; quest_identity_hash hashes at its
     * type, as the runtime's does with its descriptor. A symbol bound to a
     * value is that value. *)
    callExternal(symbol: String types: Array(tm.Type) args: Array(model.Value)): model.Value
    (* Sets system.args: the program's name and its arguments *)
    setSystemArgs(args: Array(String)): Ok
end
