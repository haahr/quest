(* Quest Self-Hosted Compiler: The Interpreter's Externals Interface
 *
 * bootstrap/python/quest/interpreter/builtins.py: each `external "symbol"` of
 * lib/ resolves to a value, a function or an exception (resolveExternal). The
 * bootstrap implements each in Python; here each calls the library function
 * that the symbol is (docs/interpreter.md section 1): an interpreted string,
 * word, reader, writer, or string builder is the native value, and an error the
 * library raises (stringOp.error) is raised as the interpreted one
 * (primitives.stringError). Only the symbols lib/ uses are here: the
 * bootstrap's table also has math functions under bare names (sin, cos, ...)
 * that no library module binds. *)

interface Builtins
import
    questlang/values/model : questlang/values/Model
    tm = questlang/types/model : questlang/types/Model
export
    (* The value of an external symbol, a builtin function for a function *)
    resolveExternal(symbol: String): model.Value
    (* Calls the external function symbol with its type arguments, resolved,
     * and its arguments, as a function defined as `external "symbol"` calls
     * it. Most externals ignore the types; quest_identity_hash hashes at its
     * type, as the runtime's does with its descriptor. A symbol bound to a
     * value is that value. *)
    callExternal(symbol: String types: Array(tm.Type) args: Array(model.Value)): model.Value
    (* Sets system.args: the program's name and its arguments *)
    setSystemArgs(args: Array(String)): Ok
end
