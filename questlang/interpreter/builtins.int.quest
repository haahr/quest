(* Quest Self-Hosted Compiler: The Standard Library's Externals Interface
 *
 * bootstrap/python/quest/interpreter/builtins.py: each `external "symbol"` of lib/ resolves to a value, a function
 * or an exception (resolveExternal). The bootstrap implements each in Python; here each calls the library function
 * that the symbol is (docs/milestone-3.md section 2): an interpreted string, word, reader, writer, or string builder
 * is the native value, and an error the library raises (stringOp.error) is raised as the interpreted one
 * (primitives.stringError). Only the symbols lib/ uses are here: the bootstrap's table also has math functions (sin,
 * cos, ...) and list operations that no library module binds. *)

interface Builtins
import
    questlang/values/model : questlang/values/Model
export
    (* The value of an external symbol, a builtin function for a function *)
    resolveExternal(symbol: String): model.Value
    (* Sets system.args: the program's name and its arguments *)
    setSystemArgs(args: Array(String)): Ok
end
