(* Quest Self-Hosted Compiler: The Interpreters' os/files Calls
 * Implementation *)

unsound module fileCalls : FileCalls
export
    let remove(path: String): Int = external "quest_files_remove"
    let removeDirectory(path: String): Int = external "quest_files_remove_directory"
    let rename(from: String to: String): Int = external "quest_files_rename"
    let makeDirectory(path: String mode: Int): Int = external "quest_files_make_directory"
    let createNew(path: String mode: Int): Int = external "quest_files_create_new"
    let list(path: String): Array(String) = external "quest_files_list"
    let symlink(target: String path: String): Int = external "quest_files_symlink"
    let readLink(path: String): String = external "quest_files_read_link"
    let setMode(path: String mode: Int): Int = external "quest_files_set_mode"
    let setTimes(path: String accessNs: Int modifiedNs: Int): Int = external "quest_files_set_times"
    let lastStatus(): Int = external "quest_files_last_status"
end
