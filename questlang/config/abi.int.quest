(* Quest Self-Hosted Compiler: The Artifact Contract Interface
 *
 * Defines the artifact contract (ABI) version recorded in every .qi, .qm, and
 * generated C header; bootstrap/python/quest/config/abi.py is the bootstrap
 * counterpart. Artifacts are reused only when they match both the running
 * compiler's ABI version (docs/build-process.md section 5.2) and its producer
 * tag. The version number is shared with the bootstrap and verified by
 * tests/python. *)

interface Abi
import
    util/maybe : util/Maybe
export
    abiVersion: Int
    (* This compiler, as the artifacts it writes record it; it uses only
     * artifacts it wrote itself *)
    producer: String
    (* The first line of every generated interface header *)
    headerStamp: String

    (* The ABI version a .qi or .qm file records, if it records one and can be
     * read *)
    recordedAbi(artifact: String): maybe.T(Int)
    (* Reports whether this compiler can reuse a .qi or .qm file, requiring
     * both a matching producer tag and the current ABI version. The bootstrap
     * shares the ABI version, but its artifacts have a different producer
     * (docs/testing.md section 2.8), so each compiler rebuilds the other's. *)
    hasCurrentAbi(artifact: String): Bool
    (* Whether a .qi or .qm file records source as the file it was built
     * from *)
    builtFrom(artifact: String source: String): Bool
    (* Why an artifact of another ABI version or producer cannot be used *)
    incompatibleArtifactMessage(artifact: String): String
end
