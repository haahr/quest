(* Quest Self-Hosted Compiler: The Artifact Contract Implementation *)

module abi : Abi
import
    conv : Conv
    stringOp = string : StringOp

    util/json : util/Json
    util/maybe : util/Maybe
    pathLib = util/path : util/Path
    util/strutil : util/Strutil

    questlang/common/files : questlang/common/Files
    questlang/common/jsonCache : questlang/common/JsonCache
export
    let abiVersion = 90

    let producer = "questlang 0.1"

    let headerStamp = "/* quest abi " <> conv.int(abiVersion) <> " producer " <> producer <> " */"

    (* Reads a top-level JSON field from a .qi or .qm file, unwrapping a .qi
     * file's outer "value" object when present *)
    let recordedField(artifact: String key: String): maybe.T(json.Value) =
        begin
            let text = files.readText(artifact)
            if maybe.isNone(text) then
                maybe.none()
            else
                try
                    let top = jsonCache.parseShared(maybe.unwrap(text))
                    let data =
                        case top
                            when jObject with x then
                                let value = json.get(x.o "value")
                                let isObject = maybe.isSome(value)
                                    andif case maybe.unwrap(value) when jObject then true else false end
                                if isObject then maybe.unwrap(value) else top end
                            else top
                        end
                    case data
                        when jObject with x then json.get(x.o key)
                        else maybe.none()
                    end
                when json.error then
                    maybe.none()
                end
            end
        end

    let recordedAbi(artifact: String): maybe.T(Int) =
        begin
            let field = recordedField(artifact "abi")
            if maybe.isNone(field) then
                maybe.none()
            else
                case maybe.unwrap(field)
                    when jNumber with x then if x.isInteger then strutil.tryToInt(x.text) else maybe.none() end
                    else maybe.none()
                end
            end
        end

    let recordedProducer(artifact: String): maybe.T(String) =
        begin
            let field = recordedField(artifact "producer")
            if maybe.isNone(field) then
                maybe.none()
            else
                case maybe.unwrap(field)
                    when jString with x then maybe.some(x.s)
                    else maybe.none()
                end
            end
        end

    let hasCurrentAbi(artifact: String): Bool =
        begin
            let found = recordedAbi(artifact)
            let by = recordedProducer(artifact)
            maybe.isSome(found) andif {maybe.unwrap(found) is abiVersion}
                andif maybe.isSome(by) andif stringOp.equal(maybe.unwrap(by) producer)
        end

    let builtFrom(artifact: String source: String): Bool =
        begin
            let field = recordedField(artifact "source")
            if maybe.isNone(field) then
                false
            else
                case maybe.unwrap(field)
                    when jString with x then
                        {stringOp.length(x.s) > 0}
                            andif stringOp.equal(pathLib.resolve(x.s) pathLib.resolve(source))
                    else false
                end
            end
        end

    let incompatibleArtifactMessage(artifact: String): String =
        begin
            let found = recordedAbi(artifact)
            let by = recordedProducer(artifact)
            if maybe.isSome(found) andif {maybe.unwrap(found) is abiVersion} then
                let byText = if maybe.isSome(by) then "producer '" <> maybe.unwrap(by) <> "'"
                    else "no producer"
                    end
                "Precompiled artifact '" <> artifact <> "' records " <> byText <> ", but this compiler is '"
                    <> producer <> "', and its source is not available to rebuild it"
            else
                let foundText = if maybe.isSome(found) then "ABI version " <> conv.int(maybe.unwrap(found))
                    else "no ABI version"
                    end
                "Precompiled artifact '" <> artifact <> "' records " <> foundText
                    <> ", but this compiler requires ABI version " <> conv.int(abiVersion)
                    <> ", and its source is not available to rebuild it"
            end
        end
end
