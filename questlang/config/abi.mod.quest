(* Quest Self-Hosted Compiler: The Artifact Contract Implementation *)

module abi : Abi
import
    pathLib = util/path : util/Path
    system : System
    questlang/values/json : questlang/values/Json
    util/maybe : util/Maybe
    util/strutil : util/Strutil
    stringOp = string : StringOp
    conv : Conv
export
    let abiVersion = 54

    let producer = "questlang 0.1"

    let headerStamp = "/* quest abi " <> conv.int(abiVersion) <> " producer " <> producer <> " */"

    (* A top-level field of a .qi or .qm file (a .qi's is its serialized
     * dynamic value's), if it has one and the file can be read *)
    let recordedField(artifact: String key: String): maybe.T(json.Value) =
        begin
            let text = if not(system.isFile(artifact)) then
                    maybe.none(:String)
                else
                    try
                        maybe.some(:String pathLib.readText(pathLib.fromString(artifact)))
                    when system.error then
                        maybe.none(:String)
                    end
                end
            if maybe.isNone(:String text) then
                maybe.none(:json.Value)
            else
                try
                    let top = json.parseShared(maybe.unwrap(:String text))
                    let data = case top
                        when jObject with x then
                            let value = json.get(x.o "value")
                            let isObject = maybe.isSome(:json.Value value)
                                andif case maybe.unwrap(:json.Value value) when jObject then true else false end
                            if isObject then maybe.unwrap(:json.Value value) else top end
                        else top
                    end
                    case data
                        when jObject with x then json.get(x.o key)
                        else maybe.none(:json.Value)
                    end
                when json.error then
                    maybe.none(:json.Value)
                end
            end
        end

    let recordedAbi(artifact: String): maybe.T(Int) =
        begin
            let field = recordedField(artifact "abi")
            if maybe.isNone(:json.Value field) then
                maybe.none(:Int)
            else
                case maybe.unwrap(:json.Value field)
                    when jNumber with x then if x.isInteger then strutil.tryToInt(x.text) else maybe.none(:Int) end
                    else maybe.none(:Int)
                end
            end
        end

    let recordedProducer(artifact: String): maybe.T(String) =
        begin
            let field = recordedField(artifact "producer")
            if maybe.isNone(:json.Value field) then
                maybe.none(:String)
            else
                case maybe.unwrap(:json.Value field)
                    when jString with x then maybe.some(:String x.s)
                    else maybe.none(:String)
                end
            end
        end

    let hasCurrentAbi(artifact: String): Bool =
        begin
            let found = recordedAbi(artifact)
            let by = recordedProducer(artifact)
            maybe.isSome(:Int found) andif {maybe.unwrap(:Int found) is abiVersion}
                andif maybe.isSome(:String by) andif stringOp.equal(maybe.unwrap(:String by) producer)
        end

    let builtFrom(artifact: String source: String): Bool =
        begin
            let field = recordedField(artifact "source")
            if maybe.isNone(:json.Value field) then
                false
            else
                case maybe.unwrap(:json.Value field)
                    when jString with x then
                        {stringOp.length(x.s) > 0}
                            andif stringOp.equal(pathLib.resolve(x.s) pathLib.resolve(source))
                    else false
                end
            end
        end

    let incompatibleArtifactMessage(artifact: String): String =
        begin
            let found = recordedAbi(artifact)
            let by = recordedProducer(artifact)
            if maybe.isSome(:Int found) andif {maybe.unwrap(:Int found) is abiVersion} then
                let byText = if maybe.isSome(:String by) then "producer '" <> maybe.unwrap(:String by) <> "'"
                    else "no producer"
                end
                "Precompiled artifact '" <> artifact <> "' records " <> byText <> ", but this compiler is '"
                    <> producer <> "', and its source is not available to rebuild it"
            else
                let foundText = if maybe.isSome(:Int found) then "ABI version " <> conv.int(maybe.unwrap(:Int found))
                    else "no ABI version"
                end
                "Precompiled artifact '" <> artifact <> "' records " <> foundText
                    <> ", but this compiler requires ABI version " <> conv.int(abiVersion)
                    <> ", and its source is not available to rebuild it"
            end
        end
end
