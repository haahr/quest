(* Quest Self-Hosted Compiler: Type and Kind Elaboration Interface
 *
 * This interface elaborates types and kinds, mirroring
 * bootstrap/python/quest/typechecker/elaborate_types.py. Syntactic types and
 * kinds become semantic ones (questlang/types/model), and type and kind
 * declarations become symbols in the environment's current scope. Any error
 * raises diagnostics.compilerError at the offset of the offending syntax. *)

interface ElaborateTypes
import
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/syntax/ast : questlang/syntax/AST
    questlang/types/env : questlang/types/Env
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
export
    (* Refuses 'external' outside an unsound module: it gives a C entity
     * whatever type it is declared with, which nothing checks (docs/modules.md
     * section 4.4) *)
    requireUnsoundModule(e: env.T offset: Int): Ok

    elaborateKind(k: ast.KindExpr e: env.T): model.Kind
    elaborateType(t: ast.TypeExpr e: env.T): model.Type

    (* DEF K = Kind, declared in the current scope *)
    elaborateKindBinding(name: String kindVal: ast.KindExpr e: env.T): symbols.KindSymbol

    (* The type bindings one component of a tuple or tuple type declares: a
     * binding, or a group's members (isGroup), whose names must differ *)
    tupleTypeBindingMembers(members: vector.T(ast.TypeBinding) isGroup: Bool): vector.T(ast.TypeBinding)

    (* A type binding a tuple component declares, with its symbol and its
     * declared bound, if any *)
    Def TupleTypeBinding = Tuple member: ast.TypeBinding sym: symbols.TypeSymbol bound: maybe.T(model.Kind) end
    (* Elaborates the type bindings of one component of a tuple or tuple type,
     * without declaring them in the tuple's scope. Non-recursive group members
     * are elaborated simultaneously, while recursive bindings (alone or in a
     * group) are elaborated in a scope of their own, as anywhere else. *)
    elaborateTupleTypeBindings(members: vector.T(ast.TypeBinding) isGroup: Bool e: env.T): Array(TupleTypeBinding)

    (* Recursive type operators (Let Rec T(A::K) = ...), alone or as a group
     * sharing their parameters, elaborated into their symbols, which are not
     * declared *)
    elaborateRecTypeOperators(members: vector.T(ast.TypeBinding) e: env.T): Array(symbols.TypeSymbol)

    (* Elaborates a group of type bindings (Let [Rec] T1 = ... and T2 = ..., or
     * the same with Def) and declares them in the current scope. Without Rec,
     * the members do not see one another; with Rec, they are mutually
     * recursive. *)
    elaborateTypeBindingGroup(members: vector.T(ast.TypeBinding) e: env.T): Array(symbols.TypeSymbol)
    (* Let T = Type or Def T = Type, declared in the current scope *)
    elaborateTypeBinding(b: ast.TypeBinding e: env.T): symbols.TypeSymbol
    (* Let Rec T1 = ... and T2 = ..., without parameters, declared in the
     * current scope *)
    elaborateMutualRecTypeGroup(members: vector.T(ast.TypeBinding) e: env.T): Array(symbols.TypeSymbol)
end
