(* Quest Self-Hosted Compiler: Metavariable Resolution over Typed ASTs Implementation *)

module metas : Metas
import
    questlang/types/model : questlang/types/Model
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
export
    let resolveTypedMetas(e: typedAst.Expr): typedAst.Expr = typedAst.mapTypes(e model.resolveMetas)
end
