(* Quest Self-Hosted Compiler: Control Flow Interface
 *
 * This interface provides type-checking for the control-flow construct family
 * (matching bootstrap/python/quest/typechecker/control.py): case expressions,
 * built-in infix operators (including assignment), conditionals, for loops,
 * and blocks. Desugaring has already turned short-circuit operators and elsif
 * chains into conditionals, other infix operators into calls, and array-element
 * assignments into index assignments. Each function takes an expression of its
 * form.
 *
 * A block is an error-recovery point (docs/diagnostics.md section 4.5): any
 * binding in it that fails is reported, and the block then fails silently
 * without emitting a second error. *)

interface Control
import
    util/maybe : util/Maybe

    questlang/syntax/ast : questlang/syntax/AST
    questlang/typechecker/checker : questlang/typechecker/Checker
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
    questlang/types/model : questlang/types/Model
export
    elaborateCase(c: checker.T expr: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr
    synthInfix(c: checker.T expr: ast.Expr e: env.T loopDepth: Int): typedAst.Expr
    elaborateIf(c: checker.T expr: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr
    synthFor(c: checker.T expr: ast.Expr e: env.T loopDepth: Int): typedAst.Expr
    elaborateBlock(c: checker.T expr: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr
end
