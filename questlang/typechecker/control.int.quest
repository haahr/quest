(* Quest Self-Hosted Compiler: Control Flow Interface
 *
 * The construct family of bootstrap/python/quest/typechecker/control.py: case,
 * the built-in infix operators (including assignment), conditionals, for loops,
 * and blocks. Desugaring has made conditionals of short-circuit operators and
 * elsif chains, calls of other infix operators, and index assignments of
 * assignments to array elements. Each function takes an expression of its form.
 *
 * A block is a recovery point (docs/milestone-2.md section 2): a binding of it
 * that fails is reported, and the block then fails without another error. *)

interface Control
import
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/types/model : questlang/types/Model
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/typechecker/checker : questlang/typechecker/Checker
    util/maybe : util/Maybe
export
    elaborateCase(c: checker.T expr: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr
    synthInfix(c: checker.T expr: ast.Expr e: env.T loopDepth: Int): typedAst.Expr
    elaborateIf(c: checker.T expr: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr
    synthFor(c: checker.T expr: ast.Expr e: env.T loopDepth: Int): typedAst.Expr
    elaborateBlock(c: checker.T expr: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr
end
