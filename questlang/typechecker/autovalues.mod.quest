(* Quest Self-Hosted Compiler: Auto Values Implementation *)

module autoValues : AutoValues
import
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/syntax/ast : questlang/syntax/AST
    questlang/typechecker/checker : questlang/typechecker/Checker
    questlang/typechecker/checks : questlang/typechecker/Checks
    questlang/typechecker/elaborateTypes : questlang/typechecker/ElaborateTypes
    questlang/typechecker/escape : questlang/typechecker/Escape
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
    questlang/types/kinds : questlang/types/Kinds
    questlang/types/model : questlang/types/Model
    questlang/types/subtyping : questlang/types/Subtyping
    questlang/types/symbols : questlang/types/Symbols
export
    Let Type = model.Type

    (* The auto type of an inspect target *)
    let inspectedAutoType(target: typedAst.Expr): maybe.T(model.Type) =
        begin
            let t = model.evaluateLazily(target.type symbols.lookup)
            case t.form when typeAuto then maybe.some(t) else maybe.none() end
        end

    (* Whether t, stripped of aliases, is an auto type *)
    let isAutoType(t: model.Type): Bool = case model.unalias(t).form when typeAuto then true else false end

    let checkDynamicTypeArgs(
            allType: model.Type typeArgs: Array(model.Type) offset: Int
            check: All(t: model.Type what: String offset: Int) Ok
            ): Ok =
        case allType.form
            when typeAll with a then
                case a.body.form
                    when typeFun with f then
                        if {extent a.quantifiers is 1} andif {extent f.params is 1} andif {extent typeArgs > 0} then
                            let aId = a.quantifiers[0].symbolId
                            let isA(t: model.Type): Bool =
                                case model.unalias(t).form
                                    when typeVariable with v then v.symbolId is aId
                                    else false
                                end
                            let paramT = f.params[0].type
                            if {isA(paramT) andif isAutoType(f.result)}
                                    orif {isAutoType(paramT) andif isA(f.result)} then
                                check(typeArgs[0] "The type of a dynamic value" offset)
                            end
                        end
                    else ok
                end
            else ok
        end

    let checkClosedType(t: Type what: String offset: Int): Ok = escape.checkNoPackageTypes(t what offset)

    let elaborateInspect(c: checker.T expr: ast.Expr expected: maybe.T(Type) e: env.T loopDepth: Int): typedAst.Expr =
        case expr.form
            when exprInspect with x then
                begin
                    let targetTyped = checker.synthExpr(c x.target e loopDepth)
                    let autoType = model.evaluateLazily(targetTyped.type symbols.lookup)
                    if not(isAutoType(autoType)) then
                        diagnostics.fail(:Ok "Target of inspect must have an Auto type (such as Dynamic), got '"
                            <> model.show(autoType) <> "'" x.target.span.startOffset)
                    end
                    (* A branch matches a supertype of the value's type
                     * component only when the signature's type parameter is
                     * the whole type of immutable components (fst,snd: A);
                     * otherwise viewing the components at the supertype is
                     * unsound, and the branch's type must be equal
                     * (docs/type-system.md §6.12, matching rule) *)
                    let exact = not(model.autoMatchesSubtypes(autoType))
                    let branches = vector.new(:typedAst.InspectBranch)
                    let bodies = vector.new(:typedAst.Expr)
                    for i = 0 upto {vector.length(x.branches) - 1} do
                        let branch = vector.get(x.branches i)
                        let matchT = elaborateTypes.elaborateType(branch.matchType e)
                        checkClosedType(matchT "The type in an inspect when clause" branch.matchType.span.startOffset)
                        (* In the branch for type T, of Auto A with S end, the
                         * binders denote the auto value's components, of type
                         * Tuple S[T/A] end *)
                        let armType = model.autoPayloadType(autoType maybe.some(matchT))
                        Let Arm = Tuple binders: Array(symbols.ValueSymbol) body: typedAst.Expr end
                        let arm = env.localScoped(e "inspect_branch" fun(s: symbols.Scope): Arm
                            begin
                                let syms = vector.new(:symbols.ValueSymbol)
                                for j = 0 upto {vector.length(branch.binders) - 1} do
                                    let binder = vector.get(branch.binders j)
                                    let bType =
                                        if maybe.isSome(binder.typeAnnot) then
                                            let annot = maybe.unwrap(binder.typeAnnot)
                                            let t = elaborateTypes.elaborateType(annot e)
                                            if not(subtyping.isSubtype(armType t env.lookupOf(e))) then
                                                diagnostics.fail(:Ok "Inspect binder '" <> binder.name
                                                    <> "' has components of type '" <> model.show(armType)
                                                    <> "', which is not a subtype of the declared type '"
                                                    <> model.show(t)
                                                    <> "'" annot.span.startOffset)
                                            end
                                            t
                                        else
                                            armType
                                        end
                                    let sym =
                                        symbols.newValueSymbol(binder.name bType false false false c.functionDepth 0)
                                    symbols.declareValue(e.currentScope sym)
                                    vector.append(syms sym)
                                end
                                tuple
                                    let binders = vector.toArray(syms)
                                    let body = checker.elaborateSubexpr(c branch.body expected e loopDepth)
                                end
                            end)
                        vector.append(branches tuple
                            let offset = branch.offset
                            let matchType = matchT
                            let binders = arm.binders
                            let body = arm.body
                            let exact = exact
                        end)
                        vector.append(bodies arm.body)
                    end
                    let elseTyped = checker.elaborateOptionalBranch(c x.elseBranch expected e loopDepth)
                    let joined: checker.JoinedBodies =
                        if maybe.isSome(expected) then
                            tuple
                                let type = maybe.unwrap(expected)
                                let initial = maybe.none()
                                let bodies = vector.toArray(bodies)
                                let elseBranch = elseTyped
                            end
                        else
                            checker.joinBodies(maybe.none() vector.toArray(bodies) elseTyped e expr.span.startOffset
                                    "Cannot find common supertype join for inspect branch types '{t1}' and '{t2}'")
                        end
                    let typedBranches = vector.toArray(branches)
                    let joinedBranches = vector.new(:typedAst.InspectBranch)
                    for i = 0 upto {extent typedBranches - 1} do
                        let b = typedBranches[i]
                        vector.append(joinedBranches tuple
                            let offset = b.offset
                            let matchType = b.matchType
                            let binders = b.binders
                            let body = joined.bodies[i]
                            let exact = b.exact
                        end)
                    end
                    typedAst.expr(expr.span.startOffset joined.type option exprInspect of typedAst.ExprForm with
                        let target = targetTyped
                        let branches = vector.toArray(joinedBranches)
                        let elseBranch = joined.elseBranch
                        let autoType = inspectedAutoType(targetTyped)
                    end)
                end
            else checks.unexpected("an inspect" expr.span.startOffset)
        end

    (* Checks that witness has the kind, else fails with message *)
    let checkWitnessKind(witness: Type kind: model.Kind e: env.T message: String offset: Int): Ok =
        try
            kinds.checkKind(witness kind maybe.some(e))
        when diagnostics.compilerError with err then
            if err.isFatal orif err.silent then diagnostics.raiseError(:Ok err) end
            diagnostics.fail(message offset)
        end

    let elaborateAuto(c: checker.T expr: ast.Expr expected: maybe.T(Type) e: env.T loopDepth: Int): typedAst.Expr =
        case expr.form
            when exprAuto with x then
                begin
                    if maybe.isNone(expected) then
                        diagnostics.fail(:Ok "Cannot infer the type of an auto value; give it an expected Auto type "
                            <> "(e.g. let p:Auto A::TYPE with a:A end = auto :Int with 3 end)" expr.span.startOffset)
                    end
                    let expectedType = maybe.unwrap(expected)
                    let autoType = model.evaluateLazily(expectedType symbols.lookup)
                    let kindBound =
                        case autoType.form
                            when typeAuto with a then a.kindBound
                            else
                                diagnostics.fail(:model.Kind "Auto value used where a value of type '"
                                    <> model.show(expectedType) <> "' is expected; auto values have Auto types"
                                        expr.span.startOffset)
                        end
                    let witness = elaborateTypes.elaborateType(x.witnessType e)
                    let witnessOffset = x.witnessType.span.startOffset
                    checkClosedType(witness "The type component of an auto value" witnessOffset)
                    checkWitnessKind(witness kindBound e "Type component '" <> model.show(witness)
                        <> "' of the auto value does not have kind '" <> checks.describeKind(kindBound)
                        <> "' required by '" <> model.show(expectedType) <> "'" witnessOffset)
                    let payloadType = model.autoPayloadType(autoType maybe.some(witness))
                    let payloadTyped = env.localScoped(e "auto_value" fun(s: symbols.Scope): typedAst.Expr
                        begin
                            if maybe.isSome(x.witnessName) then
                                let name = maybe.unwrap(x.witnessName)
                                let localBound =
                                    if maybe.isSome(x.witnessBound) then
                                        elaborateTypes.elaborateKind(maybe.unwrap(x.witnessBound) e)
                                    else
                                        model.typeKind
                                    end
                                checkWitnessKind(witness localBound e "Type component '" <> model.show(witness)
                                    <> "' of the auto value does not have the declared kind '"
                                    <> checks.describeKind(localBound) <> "' of '" <> name <> "'" witnessOffset)
                                symbols.declareType(e.currentScope
                                        symbols.newTypeSymbol(name env.freshSymbolId(e) localBound maybe.some(witness)))
                                ok
                            end
                            checker.checkExpr(c x.payload payloadType e loopDepth)
                        end)
                    typedAst.expr(expr.span.startOffset expectedType option exprAuto of typedAst.ExprForm with
                        let witnessType = witness
                        let autoType = autoType
                        let payload = payloadTyped
                    end)
                end
            else checks.unexpected("an auto value" expr.span.startOffset)
        end
end
