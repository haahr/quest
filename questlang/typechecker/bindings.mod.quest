(* Quest Self-Hosted Compiler: Functions and Bindings Implementation *)

module bindings : Bindings
import
    conv : Conv

    collections/hashMap : collections/HashMap
    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/iter : util/Iter
    util/maybe : util/Maybe

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/maps : questlang/common/Maps
    questlang/syntax/ast : questlang/syntax/AST
    questlang/typechecker/checker : questlang/typechecker/Checker
    questlang/typechecker/checks : questlang/typechecker/Checks
    questlang/typechecker/elaborateTypes : questlang/typechecker/ElaborateTypes
    questlang/typechecker/escape : questlang/typechecker/Escape
    questlang/typechecker/exceptions : questlang/typechecker/Exceptions
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
    questlang/types/model : questlang/types/Model
    questlang/types/reduce : questlang/types/Reduce
    questlang/types/subtyping : questlang/types/Subtyping
    questlang/types/symbols : questlang/types/Symbols
export
    Let Type = model.Type

    let isVarMode(m: ast.ParamMode): Bool = case m when modeVar then true else false end
    let isOutMode(m: ast.ParamMode): Bool = case m when modeOut then true else false end

    (* A parameter mode, for error messages *)
    let paramMode(isVar: Bool isOut: Bool): String =
        if isVar then "var" elsif isOut then "out" else "a value parameter" end

    let showParam(p: model.Param): String =
        {if p.isVar then "var " elsif p.isOut then "out " else "" end} <> p.name <> ": " <> model.show(p.type)

    let newIds(): maps.IntSet = maps.newIntSet()

    (* The ids of the values declared in a scope *)
    let valueIds(s: symbols.Scope): maps.IntSet =
        begin
            let ids = newIds()
            let values = hashMap.valueIter(s.values)
            while iter.more(values) do hashSet.insert(ids iter.next(values).symbolId) end
            ids
        end

    let typeBindingOf(d: ast.Decl): ast.TypeBinding =
        case d.form
            when declTypeBinding with x then
                tuple
                    let offset = d.span.startOffset
                    let name = x.name
                    let typeVal = x.typeVal
                    let params = x.params
                    let bound = x.bound
                    let isRec = x.isRec
                    let isDef = x.isDef
                end
            else checks.unexpected("a type binding" d.span.startOffset)
        end

    let valueMembers(d: ast.Decl): vector.T(ast.Decl) =
        case d.form
            when declLetValGroup with g then g.bindings
            else vector.fromArray(array of d end)
        end

    (* The name and offset of a let declaration, for
     * checks.checkDistinctNames *)
    let named(d: ast.Decl): checks.Named =
        case d.form
            when declLetVal with x then tuple let name = x.name let offset = d.span.startOffset end
            else tuple let name = "" let offset = d.span.startOffset end
        end

    (* Requires the type a parameter is written with to fit the expected
     * parameter of the same mode, as subtyping of function types does: a value
     * parameter's written type must include the expected type (contravariance),
     * a var parameter's must equal it, and an out parameter's must be included
     * in it *)
    let requireParamType(p: ast.FormalParam written: Type expected: model.Param e: env.T): Ok =
        begin
            let lookup = env.symbolLookup
            let good =
                if expected.isVar then
                    subtyping.isTypeEqual(written expected.type lookup)
                elsif expected.isOut then
                    subtyping.isSubtype(written expected.type lookup)
                else
                    subtyping.isSubtype(expected.type written lookup)
                end
            let relation =
                if expected.isVar then "equal to" elsif expected.isOut then "a subtype of" else "a supertype of" end
            if not(good) then
                diagnostics.fail(:Ok "Parameter '" <> p.name <> "' declared type '" <> model.show(written)
                    <> "' is not "
                    <> relation <> " expected parameter type '" <> model.show(expected.type) <> "'"
                        maybe.unwrap(p.typeAnnot).span.startOffset)
            end
        end

    Let Params = Tuple typed: Array(typedAst.Param) formals: Array(model.Param) end

    (* Declares function parameters in the current scope *)
    let declareFunParams(
            c: checker.T params: vector.T(ast.FormalParam) expectedParams: maybe.T(Array(model.Param))
            ): Params =
        begin
            let typed = vector.new(:typedAst.Param)
            let formals = vector.new(:model.Param)
            for i = 0 upto {vector.length(params) - 1} do
                let p = vector.get(params i)
                let isVar = isVarMode(p.mode)
                let isOut = isOutMode(p.mode)
                let expectedParam =
                    if maybe.isSome(expectedParams) then
                        maybe.some(maybe.unwrap(expectedParams)[i])
                    else
                        maybe.none(:model.Param)
                    end
                if maybe.isSome(expectedParam) then
                    let ep = maybe.unwrap(expectedParam)
                    if {isVar isnot ep.isVar} orif {isOut isnot ep.isOut} then
                        diagnostics.fail(:Ok "Parameter '" <> p.name <> "' is declared " <> paramMode(isVar isOut)
                            <> ", but the expected parameter '" <> showParam(ep) <> "' is "
                            <> paramMode(ep.isVar ep.isOut)
                                p.offset)
                    end
                end
                let pType =
                    if maybe.isSome(p.typeAnnot) then
                        let t = elaborateTypes.elaborateType(maybe.unwrap(p.typeAnnot) c.env)
                        if maybe.isSome(expectedParam) then
                            requireParamType(p t maybe.unwrap(expectedParam) c.env)
                        end
                        t
                    elsif maybe.isSome(expectedParam) then
                        maybe.unwrap(expectedParam).type
                    else
                        diagnostics.fail(:Type "Parameter '" <> p.name
                            <> "' requires a type annotation in synthesis mode"
                                p.offset)
                    end
                checks.checkBinder(p.name p.offset)
                let sym = symbols.newValueSymbol(p.name pType isVar isOut true {c.functionDepth + 1} 0)
                symbols.declareValue(c.env.currentScope sym)
                vector.append(typed tuple
                    let offset = p.offset
                    let name = p.name
                    let symbol = sym
                    let type = pType
                    let isVar = isVar
                    let isOut = isOut
                end)
                vector.append(formals tuple
                    let name = p.name
                    let type = pType
                    let isVar = isVar
                    let isOut = isOut
                end)
            end
            tuple
                let typed = vector.toArray(typed)
                let formals = vector.toArray(formals)
            end
        end

    let typeParamIds(quants: Array(model.Quantifier)): Array(Int) =
        begin
            let ids = vector.new(:Int)
            for i = 0 upto {extent quants - 1} do vector.append(ids quants[i].symbolId) end
            vector.toArray(ids)
        end

    let funForm(
            params: Array(typedAst.Param) body: typedAst.Expr quants: Array(model.Quantifier) typeOnly: Bool
            ): typedAst.ExprForm =
        option exprFun of typedAst.ExprForm with
            let params = params
            let body = body
            let typeParamIds = typeParamIds(quants)
            let typeOnly = typeOnly
        end

    (* Rewrites a type-only function whose result is a function or polymorphic
     * value, fun(A::TYPE) e where e has type All(B::TYPE x: B) R, into a
     * single function taking all those parameters, fun(A::TYPE B::TYPE x: B)
     * e(:B x), which evaluates e when called and applies it. Both forms have
     * the same type, so callers pass all arguments at once and any side
     * effects of e happen on each call (docs/type-system.md section 6.4). The
     * result's type parameters are given fresh symbols because they move from
     * the result type into the function's own quantifiers. *)
    let mergeTypeOnlyFun(c: checker.T fun0: typedAst.Expr): typedAst.Expr =
        case fun0.form
            when exprFun with x then
                case fun0.type.form
                    when typeAll with all then
                        begin
                            let collected = reduce.collectFunQuantifiers(all.body)
                            let rest = collected.quantifiers
                            if {extent rest is 0} andif not(collected.body.form?typeFun) then
                                fun0
                            else
                                let subst = model.newSubst()
                                let quants = vector.fromArray(all.quantifiers)
                                let typeArgs = vector.new(:Type)
                                for i = 0 upto {extent rest - 1} do
                                    let q = rest[i]
                                    let id = env.freshSymbolId(c.env)
                                    let bound = model.substituteInKind(q.bound subst)
                                    let v = model.typeVariable(q.name id maybe.some(bound))
                                    hashMap.insert(subst q.symbolId v)
                                    vector.append(quants tuple
                                        let name = q.name
                                        let symbolId = id
                                        let bound = bound
                                    end)
                                    vector.append(typeArgs v)
                                end
                                let inner =
                                    if extent rest > 0 then
                                        model.substitute(collected.body subst)
                                    else
                                        collected.body
                                    end
                                let var body = x.body
                                if extent rest > 0 then
                                    body := typedAst.expr(fun0.offset inner option exprTypeApp of typedAst.ExprForm with
                                        let func = body
                                        let typeArgs = vector.toArray(typeArgs)
                                    end)
                                end
                                let params = vector.new(:typedAst.Param)
                                let isFun =
                                    case inner.form
                                        when typeFun with f then
                                            let args = vector.new(:typedAst.Expr)
                                            for i = 0 upto {extent f.params - 1} do
                                                let p = f.params[i]
                                                let sym =
                                                    symbols.newValueSymbol(p.name p.type p.isVar p.isOut
                                                            true {c.functionDepth + 1} 0)
                                                vector.append(params tuple
                                                    let offset = fun0.offset
                                                    let name = p.name
                                                    let symbol = sym
                                                    let type = p.type
                                                    let isVar = p.isVar
                                                    let isOut = p.isOut
                                                end)
                                                (* A var or out parameter is
                                                 * forwarded as a location,
                                                 * typed as an argument @p
                                                 * is *)
                                                let argType =
                                                    if p.isVar then
                                                        model.varType(p.type)
                                                    elsif p.isOut then
                                                        model.outType(p.type)
                                                    else
                                                        p.type
                                                    end
                                                vector.append(args typedAst.expr(fun0.offset argType
                                                        option exprVar of typedAst.ExprForm with
                                                            let name = p.name
                                                            let symbol = sym
                                                        end))
                                            end
                                            body :=
                                                    typedAst.expr(fun0.offset f.result
                                                            option exprApp of typedAst.ExprForm with
                                                                let func = body
                                                                let args = vector.toArray(args)
                                                            end)
                                            true
                                        else false
                                    end
                                let quantArray = vector.toArray(quants)
                                typedAst.expr(fun0.offset model.allType(quantArray inner)
                                        funForm(vector.toArray(params) body quantArray not(isFun)))
                            end
                        end
                    else fun0
                end
            else fun0
        end

    (* Checks a function against an expected polymorphic type, All(B::K) T.
     *
     * The function is made polymorphic in the expected type parameters, under
     * its own names. Checking fun(A::TYPE x: A): A x against
     * All(B::TYPE x: B) B declares A, with a fresh symbol and B's bound, and
     * checks the rest of the function against Fun(x: A): A. A function that
     * writes no type parameters, fun(x: B) x, takes the expected ones, names
     * and all. The symbols are fresh because the expected type's own may
     * already be in scope. A bound the function writes may be weaker than the
     * expected one, as subtyping of polymorphic types allows (Cardelli's
     * [TIncl Pi]), and the body is checked under the expected, stronger bound.
     * The function's type is the renamed one, All(A::TYPE) Fun(x: A): A, so
     * that its parameters and body refer to its own type parameters. *)
    let rec checkPolymorphicFun(
            c: checker.T expr: ast.Expr expectedType: Type expectedLazy: Type
            ): typedAst.Expr =
        case expr.form
            when exprFun with x then
                case expectedLazy.form
                    when typeAll with all then
                        begin
                            let written = x.typeParams
                            let nWritten = vector.length(written)
                            if {nWritten > 0} andif {nWritten isnot extent all.quantifiers} then
                                diagnostics.fail(:Ok "Function has " <> conv.int(nWritten)
                                    <> " type parameters, but its expected type '" <> model.show(expectedType)
                                    <> "' has "
                                    <> conv.int(extent all.quantifiers) expr.span.startOffset)
                            end
                            env.localScoped(c.env "poly_fun" fun(s: symbols.Scope): typedAst.Expr
                                begin
                                    let renaming = model.newSubst()
                                    let quants = vector.new(:model.Quantifier)
                                    for idx = 0 upto {extent all.quantifiers - 1} do
                                        let q = all.quantifiers[idx]
                                        let bound = model.substituteInKind(q.bound renaming)
                                        let name = if nWritten > 0 then vector.get(written idx).name else q.name end
                                        if nWritten > 0 then
                                            let w = vector.get(written idx)
                                            let writtenBound = elaborateTypes.elaborateKind(w.bound c.env)
                                            if not(subtyping.isSubkind(bound writtenBound env.symbolLookup)) then
                                                diagnostics.fail(:Ok "Type parameter '" <> name <> "' is declared '"
                                                    <> model.showQuantifier(tuple
                                                        let name = name
                                                        let symbolId = 0
                                                        let bound = writtenBound
                                                    end)
                                                    <> "', which does not include the expected '"
                                                    <> model.showQuantifier(tuple
                                                        let name = name
                                                        let symbolId = 0
                                                        let bound = bound
                                                    end)
                                                    <> "'"
                                                        w.offset)
                                            end
                                        end
                                        let symId = env.freshSymbolId(c.env)
                                        symbols.declareType(c.env.currentScope
                                                symbols.newTypeSymbol(name symId bound maybe.none(:Type)))
                                        hashMap.insert(renaming q.symbolId
                                                model.typeVariable(name symId maybe.some(bound)))
                                        vector.append(quants tuple
                                            let name = name
                                            let symbolId = symId
                                            let bound = bound
                                        end)
                                    end
                                    let innerExp = model.substitute(all.body renaming)
                                    let hasParams = not(vector.empty(x.params))
                                    let innerExpr =
                                        if nWritten > 0 then
                                            if hasParams then
                                                ast.makeExpr(expr.span option exprFun of ast.ExprForm with
                                                    let params = x.params
                                                    let returnType = x.returnType
                                                    let body = x.body
                                                    let typeParams = vector.new(:ast.TypeFormal)
                                                end)
                                            else
                                                x.body
                                            end
                                        else
                                            expr
                                        end
                                    let var bodyExp = innerExp
                                    if {nWritten > 0} andif not(hasParams) andif maybe.isSome(x.returnType) then
                                        (* Without value parameters, the body is
                                         * checked against the result type
                                         * annotation, which must be a subtype
                                         * of the expected result type *)
                                        let rt = maybe.unwrap(x.returnType)
                                        bodyExp := elaborateTypes.elaborateType(rt c.env)
                                        if not(subtyping.isSubtype(bodyExp innerExp env.symbolLookup)) then
                                            diagnostics.fail(:Ok "Function declared result type '"
                                                <> model.show(bodyExp)
                                                <> "' is not a subtype of expected result type '"
                                                <> model.show(innerExp) <> "'"
                                                    rt.span.startOffset)
                                        end
                                    end
                                    let innerTyped = checker.checkExpr(c innerExpr bodyExp)
                                    let quantArray = vector.toArray(quants)
                                    (* Keep the value parameters the function
                                     * writes, or for a type-only function
                                     * whose body is a monomorphic function
                                     * (such as fun(A::TYPE) fun() e, from a
                                     * curried definition f(A::TYPE)()), adopt
                                     * the body's value parameters. Otherwise,
                                     * the function has only type parameters
                                     * and mergeTypeOnlyFun wraps any returned
                                     * function. *)
                                    let typeOnly(): typedAst.Expr =
                                        mergeTypeOnlyFun(c
                                                typedAst.expr(expr.span.startOffset model.allType(quantArray innerExp)
                                                        funForm(array of :typedAst.Param end innerTyped quantArray
                                                                true)))
                                    case innerTyped.form
                                        when exprFun with f then
                                            if hasParams orif {extent f.typeParamIds is 0} then
                                                let t = model.allType(quantArray innerTyped.type)
                                                typedAst.expr(expr.span.startOffset t
                                                        funForm(f.params f.body quantArray false))
                                            else
                                                typeOnly()
                                            end
                                        else typeOnly()
                                    end
                                end)
                        end
                    else checks.unexpected("a polymorphic type" expr.span.startOffset)
                end
            else checks.unexpected("a function" expr.span.startOffset)
        end

    (* Elaborates a function, fun[(type params)](params)[: R] body, into a
     * typed function (exprFun).
     *
     * The function opens a scope, declares its type parameters and parameters
     * in it, and elaborates its body inside checker.inFunction, so that an
     * exit cannot leave the function and the body's uses of enclosing mutable
     * variables count as captures (see checker.T). Its type is assembled from
     * what it declares: Fun(params): R, under All(type params) if it has any
     * (elaborateFunBody). The typed function's typeParamIds records which type
     * symbols are the function's own, and a type mentioning one of them may
     * occur only inside the function (the scoping module checks this).
     * Likewise, the result type may not mention a path type rooted at a
     * parameter, the type of one of a parameter's hidden type components.
     *
     * Checked against an expected function type, the function lets the
     * expected type supply what it leaves unwritten: passed where the type
     * All(x: Int) Int is expected, fun(x: Int) x + 1 needs no result
     * annotation, because its body is checked against Int, and the function
     * has the expected result type. What the function does write is held to
     * what subsumption would require (docs/type-system.md section 6.1): its
     * parameters' modes must match, and its annotations must fit the expected
     * types (requireParamType). A parameter without an annotation would take
     * its expected type, but the grammar requires one. Against an expected
     * polymorphic type, see checkPolymorphicFun. A function with type
     * parameters checked against a plain function type, or any function
     * checked against a type of another form, is synthesized and must be a
     * subtype (checker.checkSubsumption). Synthesized, the body is checked
     * against the result annotation if there is one. *)
    and elaborateFun(c: checker.T expr: ast.Expr expected: maybe.T(Type)): typedAst.Expr =
        case expr.form
            when exprFun with x then
                begin
                    let hasTypeParams = not(vector.empty(x.typeParams))
                    let var expectedFun = maybe.none(:Type)
                    let var early = maybe.none(:typedAst.Expr)
                    if maybe.isSome(expected) then
                        let expectedType = maybe.unwrap(expected)
                        let expectedLazy = model.evaluateLazily(expectedType symbols.lookup)
                        case expectedLazy.form
                            when typeAll then
                                early := maybe.some(checkPolymorphicFun(c expr expectedType expectedLazy))
                            when typeFun with f then
                                (* A function with type parameters is
                                 * polymorphic, so it is checked against a
                                 * function type as it would be against any
                                 * other type of another form *)
                                if hasTypeParams then
                                    early :=
                                            maybe.some(checker.checkSubsumption(c expr expectedType
                                                    maybe.some("Function")))
                                else
                                    let n = vector.length(x.params)
                                    if n isnot extent f.params then
                                        diagnostics.fail(:Ok "Function arity mismatch: expected "
                                            <> conv.int(extent f.params)
                                            <> " parameters, got " <> conv.int(n) expr.span.startOffset)
                                    end
                                    expectedFun := maybe.some(expectedLazy)
                                end
                            else
                                early := maybe.some(checker.checkSubsumption(c expr expectedType
                                        maybe.some("Function")))
                        end
                    end
                    if maybe.isSome(early) then
                        maybe.unwrap(early)
                    else
                        elaborateFunBody(c expr x.params x.returnType x.body x.typeParams expectedFun)
                    end
                end
            else checks.unexpected("a function" expr.span.startOffset)
        end

    and elaborateFunBody(
            c: checker.T expr: ast.Expr params: vector.T(ast.FormalParam) returnType: maybe.T(ast.TypeExpr)
            body: ast.Expr typeParams: vector.T(ast.TypeFormal) expectedFun: maybe.T(Type)
            ): typedAst.Expr =
        begin
            let expectedParams = maybe.none(:Array(model.Param))
            let expectedResult = maybe.none(:Type)
            let fParams =
                if maybe.isSome(expectedFun) then
                    case maybe.unwrap(expectedFun).form
                        when typeFun with f then maybe.some(f.params)
                        else expectedParams
                    end
                else
                    expectedParams
                end
            let fResult =
                if maybe.isSome(expectedFun) then
                    case maybe.unwrap(expectedFun).form
                        when typeFun with f then maybe.some(f.result)
                        else expectedResult
                    end
                else
                    expectedResult
                end
            env.localScoped(c.env "fun" fun(s: symbols.Scope): typedAst.Expr
                begin
                    let quants = vector.new(:model.Quantifier)
                    for i = 0 upto {vector.length(typeParams) - 1} do
                        let tp = vector.get(typeParams i)
                        let bound = elaborateTypes.elaborateKind(tp.bound c.env)
                        let symId = env.freshSymbolId(c.env)
                        symbols.declareType(c.env.currentScope
                                symbols.newTypeSymbol(tp.name symId bound maybe.none(:Type)))
                        vector.append(quants tuple let name = tp.name let symbolId = symId let bound = bound end)
                    end
                    let declared = declareFunParams(c params fParams)
                    Let Body = Tuple typed: typedAst.Expr expected: maybe.T(Type) ret: Type end
                    let b = checker.inFunction(c fun(): Body
                        begin
                            (* The type the body is checked against: the result
                             * type annotation, or else the expected result
                             * type *)
                            let bodyExpected =
                                if maybe.isSome(returnType) then
                                    let rt = maybe.unwrap(returnType)
                                    let t = elaborateTypes.elaborateType(rt c.env)
                                    if maybe.isSome(fResult)
                                            andif not(subtyping.isSubtype(t maybe.unwrap(fResult)
                                                    env.symbolLookup)) then
                                        diagnostics.fail(:Ok "Function declared result type '" <> model.show(t)
                                            <> "' is not a subtype of expected result type '"
                                            <> model.show(maybe.unwrap(fResult)) <> "'" rt.span.startOffset)
                                    end
                                    maybe.some(t)
                                else
                                    fResult
                                end
                            let typed = checker.elaborateSubexpr(c body bodyExpected)
                            let ret =
                                if maybe.isSome(fResult) then
                                    maybe.unwrap(fResult)
                                else
                                    maybe.unwrapOr(bodyExpected typed.type)
                                end
                            tuple let typed = typed let expected = bodyExpected let ret = ret end
                        end)
                    (* The result type may not mention the function's
                     * parameters *)
                    escape.checkNoEscapingPathTypes(maybe.unwrapOr(b.expected b.ret) valueIds(c.env.currentScope)
                            "function scope" expr.span.startOffset)
                    let quantArray = vector.toArray(quants)
                    let funType =
                        if extent quantArray > 0 then
                            if extent declared.formals > 0 then
                                model.allType(quantArray model.funType(declared.formals b.ret))
                            else
                                model.allType(quantArray b.ret)
                            end
                        else
                            model.funType(declared.formals b.ret)
                        end
                    let typeOnly = {extent quantArray > 0} andif {extent declared.formals is 0}
                    let typedFun =
                        typedAst.expr(expr.span.startOffset funType funForm(declared.typed b.typed quantArray typeOnly))
                    if typeOnly then mergeTypeOnlyFun(c typedFun) else typedFun end
                end)
        end

    (* The parameters' types of a declaration with parameters, which must be
     * annotated *)
    let annotatedParams(params: vector.T(ast.FormalParam) e: env.T): Array(model.Param) =
        begin
            let formals = vector.new(:model.Param)
            for i = 0 upto {vector.length(params) - 1} do
                let p = vector.get(params i)
                vector.append(formals tuple
                    let name = p.name
                    let type = elaborateTypes.elaborateType(maybe.unwrap(p.typeAnnot) e)
                    let isVar = isVarMode(p.mode)
                    let isOut = isOutMode(p.mode)
                end)
            end
            vector.toArray(formals)
        end

    (* Declares the symbol of a value let in e's current scope. At an
     * interactive input's top level (e.interactive, outside any function or
     * block), the symbol is a slot (docs/repl.md section 6): the slot
     * of the name's earlier symbol, which it redefines, if that is a slot of an
     * equal type and the same var-ness, and otherwise a new one, which shadows
     * the earlier symbol, with a warning if that was a slot. *)
    let declareLet(c: checker.T sym: symbols.ValueSymbol offset: Int): symbols.ValueSymbol =
        begin
            checks.checkBinder(sym.name offset)
            if c.env.interactive andif {c.functionDepth is 0} andif {c.env.currentScope is c.env.globalScope} then
                let var slot = sym.symbolId
                let earlier = symbols.lookupValueLocal(c.env.currentScope sym.name)
                if maybe.isSome(earlier)
                        andif hashMap.contains(c.env.slots maybe.unwrap(earlier).symbolId) then
                    let old = maybe.unwrap(earlier)
                    if {old.isVar is sym.isVar} andif subtyping.isTypeEqual(old.type sym.type env.symbolLookup) then
                        slot := maybe.unwrap(hashMap.get(c.env.slots old.symbolId))
                    else
                        vector.append(c.warnings diagnostics.errorAt("'" <> sym.name
                            <> "' now has a different type; functions defined earlier keep the earlier '" <> sym.name
                            <> "'" offset))
                    end
                end
                hashMap.insert(c.env.slots sym.symbolId slot)
            end
            symbols.declareValue(c.env.currentScope sym)
        end

    (* Declares the symbol of a recursive value declaration (let rec) before
     * its value is checked, so that the value, and the other members of its
     * group, can refer to it:
     *
     *     let rec even(n: Int): Bool = if n is 0 then true else odd(n - 1) end
     *     and odd(n: Int): Bool = if n is 0 then false else even(n - 1) end;
     *
     * Every member's type must be known before any body is checked, since
     * each body may use the others, and a type cannot be taken from a body
     * that has not been checked yet. So it is taken from the annotations
     * alone (annotatedParams):
     *
     * - A function, as even, needs a type on each parameter and a result
     *   type, from which its type is built: Fun(n: Int): Bool.
     * - Any other value needs a type for the whole:
     *   let rec ones: Tuple head: Int tail: All() Int end = tuple ... end.
     *
     * So let rec fact(n: Int) = ... is rejected for want of a result type,
     * though without rec its result type would be synthesized from its body.
     * checkRecValue then checks each value against its declared type. *)
    let declareRecValue(c: checker.T b: ast.Decl): symbols.ValueSymbol =
        case b.form
            when declLetVal with x then
                begin
                    let offset = b.span.startOffset
                    let sym =
                        if not(vector.empty(x.params)) then
                            if maybe.isNone(x.typeAnnot) then
                                diagnostics.fail(:Ok "Recursive function '" <> x.name
                                    <> "' requires an explicit return type annotation"
                                        offset)
                            end
                            for i = 0 upto {vector.length(x.params) - 1} do
                                let p = vector.get(x.params i)
                                if maybe.isNone(p.typeAnnot) then
                                    diagnostics.fail(:Ok "Parameter '" <> p.name <> "' in recursive function '"
                                        <> x.name
                                        <> "' requires an explicit type annotation" p.offset)
                                end
                            end
                            let formals = annotatedParams(x.params c.env)
                            let recType = model.funType(formals
                                    elaborateTypes.elaborateType(maybe.unwrap(x.typeAnnot) c.env))
                            symbols.newValueSymbol(x.name recType false false false c.functionDepth 0)
                        else
                            if maybe.isNone(x.typeAnnot) then
                                diagnostics.fail(:Ok "Recursive definition '" <> x.name
                                    <> "' requires an explicit type annotation"
                                        offset)
                            end
                            symbols.newValueSymbol(x.name elaborateTypes.elaborateType(maybe.unwrap(x.typeAnnot) c.env)
                                    x.isVar false false c.functionDepth 0)
                        end
                    declareLet(c sym offset)
                end
            else checks.unexpected("a let declaration" b.span.startOffset)
        end

    let checkRecValue(c: checker.T b: ast.Decl sym: symbols.ValueSymbol): typedAst.LetValue =
        case b.form
            when declLetVal with x then
                begin
                    let typedVal =
                        if not(vector.empty(x.params)) then
                            let fnExpr = ast.makeExpr(b.span option exprFun of ast.ExprForm with
                                let params = x.params
                                let returnType = x.typeAnnot
                                let body = x.value
                                let typeParams = vector.new()
                            end)
                            checker.checkExpr(c fnExpr sym.type)
                        else
                            checker.checkExpr(c x.value sym.type)
                        end
                    tuple
                        let offset = b.span.startOffset
                        let name = x.name
                        let value = typedVal
                        let symbol = sym
                        let isRec = true
                        let redefines = env.redefines(c.env sym)
                    end
                end
            else checks.unexpected("a let declaration" b.span.startOffset)
        end

    let letValueBinding(v: typedAst.LetValue): typedAst.Binding =
        typedAst.binding(v.offset option bindLetValue of typedAst.BindingForm with let value = v end)

    let exprStmt(offset: Int t: typedAst.Expr): typedAst.Binding =
        typedAst.binding(offset option bindExprStmt of typedAst.BindingForm with let expr = t end)

    (* Elaborates one binding and declares the names it binds in e's current
     * scope, so that the bindings after it can use them.
     *
     * A block, a module, and a program are each a sequence of bindings,
     * Cardelli's term for both declarations (let x = e) and statements (an
     * expression evaluated for its effect, which declares nothing). They are
     * elaborated in order, so each binding sees exactly the names declared
     * before it.
     *
     * For a value declaration, the question is whether its own name is in
     * scope in its value. An ordinary let checks the value first and declares
     * the name afterward, so a use of the name inside the value refers to an
     * earlier binding:
     *
     *     let x = 1
     *     let x = x + 1        (the second x is the first one; x is now 2)
     *
     * A let rec declares the name first (declareRecValue), so that the value
     * can refer to itself, as a recursive function must:
     *
     *     let rec fact(n: Int): Int =
     *         if n is 0 then 1 else n * fact(n - 1) end
     *
     * Since the name is used before its value has been checked, its type must
     * come from the annotations alone, so a recursive function annotates
     * every parameter and its result.
     *
     * Otherwise the name's type is its annotation, if it has one, and the
     * value's synthesized type if not. An annotation may be less specific
     * than the value, and it is what the name gets, so that here r.q is an
     * error:
     *
     *     let r: Record p: Int end = record p = 1 q = 2 end
     *
     * Declarations joined by and (let x = ... and y = ...) are declared
     * together: after all their values, or, with rec, before any, so that
     * they can refer to one another (elaborateValueGroup). An external
     * function is implemented in C, so its annotations are its type
     * (elaborateExternal). Type and kind declarations are elaborated by the
     * elaborateTypes module, to which this function passes them. *)
    let rec elaborateBinding(c: checker.T b: ast.Decl): typedAst.Binding =
        begin
            let offset = b.span.startOffset
            case b.form
                when exprException then exprStmt(offset exceptions.synthException(c b true))
                when declExprStmt with x then
                    case x.expr.form
                        when exprException then
                            exprStmt(offset exceptions.synthException(c x.expr true))
                        else exprStmt(offset checker.synthExpr(c x.expr))
                    end
                when declLetVal with x then
                    begin
                        let hasParams = not(vector.empty(x.params))
                        let isExternal = case x.value.form when exprExternal then true else false end
                        if hasParams andif isExternal then
                            elaborateExternal(c b)
                        elsif x.isRec then
                            let recSym = declareRecValue(c b)
                            letValueBinding(checkRecValue(c b recSym))
                        elsif hasParams then
                            checks.notDesugared("LetValueBinding" offset)
                        else
                            Let Valued = Tuple typed: typedAst.Expr type: Type end
                            let valued: Valued =
                                if maybe.isSome(x.typeAnnot) then
                                    let expected = elaborateTypes.elaborateType(maybe.unwrap(x.typeAnnot) c.env)
                                    tuple
                                        let typed = checker.checkExpr(c x.value expected)
                                        let type = expected
                                    end
                                else
                                    let typed = checker.synthExpr(c x.value)
                                    tuple let typed = typed let type = typed.type end
                                end
                            let sym = symbols.newValueSymbol(x.name valued.type x.isVar false false c.functionDepth 0)
                            declareLet(c sym offset)
                            letValueBinding(tuple
                                let offset = offset
                                let name = x.name
                                let value = valued.typed
                                let symbol = sym
                                let isRec = x.isRec
                                let redefines = env.redefines(c.env sym)
                            end)
                        end
                    end
                when declLetValGroup with g then elaborateValueGroup(c b g.bindings)
                when declTypeBinding with x then
                    begin
                        let sym = elaborateTypes.elaborateTypeBinding(typeBindingOf(b) c.env)
                        typedAst.binding(offset option bindLetType of typedAst.BindingForm with
                            let value = tuple let offset = offset let name = x.name let symbol = sym end
                        end)
                    end
                when declTypeBindingGroup with g then
                    begin
                        let members = vector.map(g.bindings typeBindingOf)
                        let syms = elaborateTypes.elaborateTypeBindingGroup(members c.env)
                        let typed = vector.new(:typedAst.LetType)
                        for i = 0 upto {extent syms - 1} do
                            vector.append(typed tuple
                                let offset = vector.get(members i).offset
                                let name = syms[i].name
                                let symbol = syms[i]
                            end)
                        end
                        typedAst.binding(offset option bindLetTypeGroup of typedAst.BindingForm with
                            let members = vector.toArray(typed)
                        end)
                    end
                when declDefKind with x then
                    begin
                        let sym = elaborateTypes.elaborateKindBinding(x.name x.kindVal c.env)
                        typedAst.binding(offset option bindDefKind of typedAst.BindingForm with
                            let name = x.name
                            let symbol = sym
                        end)
                    end
                else diagnostics.fail("Unsupported binding" offset)
            end
        end

    (* An external function: its parameters and result annotation declare its
     * type *)
    and elaborateExternal(c: checker.T b: ast.Decl): typedAst.Binding =
        case b.form
            when declLetVal with x then
                begin
                    let offset = b.span.startOffset
                    elaborateTypes.requireUnsoundModule(c.env x.value.span.startOffset)
                    if maybe.isNone(x.typeAnnot) then
                        diagnostics.fail(:Ok "External function '" <> x.name
                            <> "' requires an explicit return type annotation"
                                offset)
                    end
                    for i = 0 upto {vector.length(x.params) - 1} do
                        let p = vector.get(x.params i)
                        if maybe.isNone(p.typeAnnot) then
                            diagnostics.fail(:Ok "Parameter '" <> p.name <> "' in external function '" <> x.name
                                <> "' requires an explicit type annotation" p.offset)
                        end
                    end
                    let formals = annotatedParams(x.params c.env)
                    let fnType = model.funType(formals elaborateTypes.elaborateType(maybe.unwrap(x.typeAnnot) c.env))
                    let sym = symbols.newValueSymbol(x.name fnType x.isVar false false c.functionDepth 0)
                    declareLet(c sym offset)
                    let symbol = case x.value.form when exprExternal with v then v.symbol else "" end
                    let typedExt =
                        typedAst.expr(x.value.span.startOffset fnType option exprExternal of typedAst.ExprForm with
                            let symbol = symbol
                        end)
                    letValueBinding(tuple
                        let offset = offset
                        let name = x.name
                        let value = typedExt
                        let symbol = sym
                        let isRec = false
                        let redefines = env.redefines(c.env sym)
                    end)
                end
            else checks.unexpected("a let declaration" b.span.startOffset)
        end

    (* let [rec] x = ... and y = ...: with rec, every member is declared before
     * any value is checked; without, each member is elaborated in a scope of
     * its own, and all are declared once every member has been elaborated *)
    and elaborateValueGroup(c: checker.T b: ast.Decl members: vector.T(ast.Decl)
            ): typedAst.Binding =
        begin
            checks.checkDistinctNames(vector.toArray(vector.map(members named)))
            let n = vector.length(members)
            let isRec = case vector.get(members 0).form when declLetVal with x then x.isRec else false end
            let typed = vector.new(:typedAst.LetValue)
            if not(isRec) then
                for i = 0 upto {n - 1} do
                    let member = vector.get(members i)
                    let t = env.scoped(c.env "simultaneous" fun(s: symbols.Scope): typedAst.Binding
                        elaborateBinding(c member))
                    case t.form
                        when bindLetValue with v then vector.append(typed v.value)
                        else checks.unexpected(:Ok "a let declaration" member.span.startOffset)
                    end
                end
                for i = 0 upto {n - 1} do
                    let v = vector.get(typed i)
                    declareLet(c v.symbol v.offset)
                    vector.set(typed i tuple
                        let offset = v.offset
                        let name = v.name
                        let value = v.value
                        let symbol = v.symbol
                        let isRec = v.isRec
                        let redefines = env.redefines(c.env v.symbol)
                    end)
                end
            else
                let syms = vector.new(:symbols.ValueSymbol)
                for i = 0 upto {n - 1} do vector.append(syms declareRecValue(c vector.get(members i))) end
                for i = 0 upto {n - 1} do
                    vector.append(typed
                            checkRecValue(c vector.get(members i) vector.get(syms i)))
                end
            end
            typedAst.binding(b.span.startOffset option bindLetValueGroup of typedAst.BindingForm with
                let members = vector.toArray(typed)
            end)
        end

    (* ======================================================================
     * Recovery
     * ====================================================================== *)

    (* The type a let declaration declares, if it declares one that elaborates:
     * its annotation, or a function's whose parameters and result are
     * annotated *)
    let declaredType(b: ast.Decl e: env.T): maybe.T(Type) =
        case b.form
            when declLetVal with x then
                try
                    let hasParams = not(vector.empty(x.params))
                    if hasParams then
                        let var annotated = maybe.isSome(x.typeAnnot)
                        for i = 0 upto {vector.length(x.params) - 1} do
                            if maybe.isNone(vector.get(x.params i).typeAnnot) then
                                annotated := false
                            end
                        end
                        if annotated then
                            maybe.some(model.funType(annotatedParams(x.params e)
                                    elaborateTypes.elaborateType(maybe.unwrap(x.typeAnnot) e)))
                        else
                            maybe.none()
                        end
                    elsif maybe.isSome(x.typeAnnot) then
                        maybe.some(elaborateTypes.elaborateType(maybe.unwrap(x.typeAnnot) e))
                    else
                        case x.value.form
                            when exprFun with f then
                                begin
                                    let var annotated = vector.empty(f.typeParams)
                                        andif maybe.isSome(f.returnType)
                                    for i = 0 upto {vector.length(f.params) - 1} do
                                        if maybe.isNone(vector.get(f.params i).typeAnnot) then
                                            annotated := false
                                        end
                                    end
                                    if annotated then
                                        maybe.some(model.funType(annotatedParams(f.params e)
                                                elaborateTypes.elaborateType(maybe.unwrap(f.returnType) e)))
                                    else
                                        maybe.none()
                                    end
                                end
                            else maybe.none()
                        end
                    end
                when diagnostics.compilerError with err then
                    if err.isFatal then diagnostics.raiseError(:Ok err) end
                    maybe.none()
                end
            else maybe.none()
        end

    let poisonValue(c: checker.T name: String b: ast.Decl): Ok =
        checker.poisonValue(c name declaredType(b c.env)
                case b.form when declLetVal with x then x.isVar else false end)

    let poisonType(name: String e: env.T): Ok =
        begin
            let sym = symbols.newTypeSymbol(name env.freshSymbolId(e) model.typeKind maybe.none())
            symbols.poisonTypeOrKind(sym.symbolId)
            symbols.declareType(e.currentScope sym)
            ok
        end

    (* Binds the names a failed binding declares to poisoned symbols *)
    let poisonDeclared(c: checker.T b: ast.Decl): Ok =
        case b.form
            when declLetVal with x then poisonValue(c x.name b)
            when declLetValGroup with g then
                for i = 0 upto {vector.length(g.bindings) - 1} do
                    let m = vector.get(g.bindings i)
                    case m.form when declLetVal with x then poisonValue(c x.name m) else ok end
                end
            when declTypeBinding with x then poisonType(x.name c.env)
            when declTypeBindingGroup with g then
                for i = 0 upto {vector.length(g.bindings) - 1} do
                    case vector.get(g.bindings i).form
                        when declTypeBinding with x then poisonType(x.name c.env)
                        else ok
                    end
                end
            when declDefKind with x then
                begin
                    let sym = symbols.newKindSymbol(x.name env.freshSymbolId(c.env) model.typeKind)
                    symbols.poisonTypeOrKind(sym.symbolId)
                    symbols.declareKind(c.env.currentScope sym)
                    ok
                end
            when exprException with x then poisonValue(c x.name b)
            when declExprStmt with s then
                case s.expr.form when exprException with x then poisonValue(c x.name b) else ok end
            else ok
        end

    let elaborateRecovering(c: checker.T b: ast.Decl): maybe.T(typedAst.Binding) =
        checker.recovering(c fun(): typedAst.Binding elaborateBinding(c b) fun(): Ok poisonDeclared(c b))
end
