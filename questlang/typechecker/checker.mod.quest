(* Quest Self-Hosted Compiler: The Checker's State and Shared Helpers
 * Implementation *)

module checker : Checker
import
    conv : Conv
    raised : Raised
    stringOp = string : StringOp
    system : System

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/syntax/ast : questlang/syntax/AST
    questlang/typechecker/checks : questlang/typechecker/Checks
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
export
    Let PendingTypeArg = Tuple meta: model.Type quantifier: model.Quantifier offset: Int end

    Let Rec T = Tuple
        env: env.T
        var loopDepth: Int
        var functionDepth: Int
        var pendingTypeArgs: maybe.T(vector.T(PendingTypeArg))
        errors: vector.T(diagnostics.CompilerError)
        warnings: vector.T(diagnostics.CompilerError)
        checksState: Bool
        var checkHook: All(c: T expr: ast.Expr expected: model.Type e: env.T loopDepth: Int) typedAst.Expr
        var synthHook: All(c: T expr: ast.Expr e: env.T loopDepth: Int isCallee: Bool) typedAst.Expr
    end

    let new(e: env.T loopDepth: Int): T =
        tuple
            let env = e
            let var loopDepth = loopDepth
            let var functionDepth = 0
            let var pendingTypeArgs = maybe.none()
            let errors = vector.new()
            let warnings = vector.new()
            let checksState = stringOp.equal(system.getEnv("QUEST_CHECK_SCOPES") "1")
            let var checkHook = fun(c: T expr: ast.Expr expected: model.Type e: env.T loopDepth: Int): typedAst.Expr
                diagnostics.internal("the checker has no dispatch" expr.span.startOffset)
            let var synthHook = fun(c: T expr: ast.Expr e: env.T loopDepth: Int isCallee: Bool): typedAst.Expr
                diagnostics.internal("the checker has no dispatch" expr.span.startOffset)
        end

    let agree(c: T e: env.T loopDepth: Int): Ok =
        if c.checksState then
            if not(e is c.env) then diagnostics.internal(:Ok "the environment passed is not the checker's" 0) end
            if loopDepth isnot c.loopDepth then
                diagnostics.internal(:Ok "the loop depth passed (" <> conv.int(loopDepth)
                    <> ") is not the checker's (" <> conv.int(c.loopDepth) <> ")" 0)
            end
        end

    let forBinding(A::TYPE c: T e: env.T loopDepth: Int body: All(c: T) A): A =
        if e is c.env then
            let saved = c.loopDepth
            c.loopDepth := loopDepth
            let result =
                try
                    body(c)
                else with r then
                    c.loopDepth := saved
                    raised.reraise(:A r)
                end
            c.loopDepth := saved
            result
        else
            body(tuple
                let env = e
                let var loopDepth = loopDepth
                let var functionDepth = c.functionDepth
                let var pendingTypeArgs = c.pendingTypeArgs
                let errors = c.errors
                let warnings = c.warnings
                let checksState = c.checksState
                let var checkHook = c.checkHook
                let var synthHook = c.synthHook
            end)
        end

    let checkExpr(c: T expr: ast.Expr expected: model.Type e: env.T loopDepth: Int): typedAst.Expr =
        begin
            agree(c e loopDepth)
            c.checkHook(c expr expected e loopDepth)
        end
    let synthExpr(c: T expr: ast.Expr e: env.T loopDepth: Int): typedAst.Expr =
        begin
            agree(c e loopDepth)
            c.synthHook(c expr e loopDepth false)
        end
    let synthCallee(c: T expr: ast.Expr e: env.T loopDepth: Int): typedAst.Expr =
        begin
            agree(c e loopDepth)
            c.synthHook(c expr e loopDepth true)
        end

    let inLoop(A::TYPE c: T body: All() A): A =
        begin
            c.loopDepth := c.loopDepth + 1
            let result =
                try
                    body()
                else with r then
                    c.loopDepth := c.loopDepth - 1
                    raised.reraise(:A r)
                end
            c.loopDepth := c.loopDepth - 1
            result
        end

    let inFunction(A::TYPE c: T body: All() A): A =
        begin
            let savedDepth = c.loopDepth
            c.loopDepth := 0
            c.functionDepth := c.functionDepth + 1
            let result =
                try
                    body()
                else with r then
                    c.loopDepth := savedDepth
                    c.functionDepth := c.functionDepth - 1
                    raised.reraise(:A r)
                end
            c.loopDepth := savedDepth
            c.functionDepth := c.functionDepth - 1
            result
        end

    let elaborateSubexpr(c: T expr: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr =
        if maybe.isSome(expected) then
            checkExpr(c expr maybe.unwrap(expected) e loopDepth)
        else
            synthExpr(c expr e loopDepth)
        end

    let elaborateOptionalBranch(
            c: T expr: maybe.T(ast.Expr) expected: maybe.T(model.Type) e: env.T loopDepth: Int
            ): maybe.T(typedAst.Expr) =
        if maybe.isSome(expr) then
            maybe.some(elaborateSubexpr(c maybe.unwrap(expr) expected e loopDepth))
        else
            maybe.none()
        end

    Let JoinedBodies = Tuple
        type: model.Type
        initial: maybe.T(typedAst.Expr)
        bodies: Array(typedAst.Expr)
        elseBranch: maybe.T(typedAst.Expr)
    end

    let joinBodies(initial: maybe.T(typedAst.Expr) bodies: Array(typedAst.Expr) elseBranch: maybe.T(typedAst.Expr)
            e: env.T offset: Int errorMessage: String): JoinedBodies =
        begin
            let parts = vector.new(:typedAst.Expr)
            if maybe.isSome(initial) then vector.append(parts maybe.unwrap(initial)) end
            for i = 0 upto {extent bodies - 1} do vector.append(parts bodies[i]) end
            if maybe.isSome(elseBranch) then vector.append(parts maybe.unwrap(elseBranch)) end
            let partArray = vector.toArray(parts)
            if extent partArray is 0 then
                tuple
                    let type = model.okType
                    let initial = initial
                    let bodies = bodies
                    let elseBranch = elseBranch
                end
            else
                let joined = checks.joinBranches(partArray e offset maybe.some(errorMessage))
                let first = if maybe.isSome(initial) then 1 else 0 end
                let newBodies = vector.new(:typedAst.Expr)
                for i = 0 upto {extent bodies - 1} do vector.append(newBodies joined.parts[first + i]) end
                tuple
                    let type = joined.type
                    let initial = if maybe.isSome(initial) then maybe.some(joined.parts[0]) else initial end
                    let bodies = vector.toArray(newBodies)
                    let elseBranch =
                        if maybe.isSome(elseBranch) then
                            maybe.some(joined.parts[extent partArray - 1])
                        else
                            elseBranch
                        end
                end
            end
        end

    let checkSubsumption(
            c: T expr: ast.Expr expected: model.Type e: env.T loopDepth: Int typeDesc: maybe.T(String)
            ): typedAst.Expr =
        checks.requireSubtype(expr.span.startOffset synthExpr(c expr e loopDepth) expected e typeDesc)

    (* Reports whether sym is a global var variable, which functions may not
     * refer to directly (Typeful Programming section 4.8). A global var is one
     * declared at a unit's or module's top level, outside any local scope
     * (env.localScoped: a block, function, tuple, branch, or for loop). Its
     * declaring scope is the innermost enclosing scope that binds sym. *)
    let isGlobalVar(c: T sym: symbols.ValueSymbol): Bool =
        if not(sym.isVar) orif sym.isParam orif sym.isOut orif {sym.functionDepth > 0} then
            false
        else
            let var scope = maybe.some(c.env.currentScope)
            let var searching = true
            while searching andif maybe.isSome(scope) do
                let s = maybe.unwrap(scope)
                let found = hashMap.get(s.values sym.name)
                if maybe.isSome(found) andif {maybe.unwrap(found).symbolId is sym.symbolId} then
                    searching := false
                else
                    scope := s.parent
                end
            end
            let var isGlobal = true
            while isGlobal andif maybe.isSome(scope) do
                let s = maybe.unwrap(scope)
                if s.isLocal then isGlobal := false end
                scope := s.parent
            end
            isGlobal
        end

    (* Rejects a closure's use of a var or out parameter of an enclosing
     * function, because such a parameter is the address of its caller's
     * location and may not outlive the call. It also rejects any function's
     * direct use of a global var variable (isGlobalVar). A closure may capture
     * a local var variable, which lowering then holds in a heap-allocated box
     * shared by the frame and the closure (capturedMutables in
     * questlang/ir/lower). *)
    let checkCapturable(c: T sym: symbols.ValueSymbol offset: Int): Ok =
        if {sym.isOut orif sym.isVar} andif sym.isParam andif {sym.functionDepth > 0}
                andif {c.functionDepth > sym.functionDepth} then
            let kindStr = if sym.isOut then "'out' parameter" else "'var' parameter" end
            diagnostics.fail("Cannot capture " <> kindStr <> " '" <> sym.name <> "' in closure" offset)
        elsif {c.functionDepth > 0} andif isGlobalVar(c sym) then
            diagnostics.fail("A function may not refer directly to the global 'var' variable '" <> sym.name
                <> "': pass it as a 'var' parameter, or hold it in a data structure" offset)
        end

    let checkPoisoned(sym: symbols.ValueSymbol): Ok =
        if symbols.isPoisonedValue(sym.symbolId) then diagnostics.raiseError(:Ok diagnostics.silentError) end

    let lookupValue(c: T e: env.T name: String): maybe.T(symbols.ValueSymbol) =
        begin
            agree(c e c.loopDepth)
            let sym = env.lookupValue(e name)
            if maybe.isSome(sym) then checkPoisoned(maybe.unwrap(sym)) end
            sym
        end

    let maxErrors = 20

    let recordError(c: T err: diagnostics.CompilerError): Ok =
        begin
            vector.append(c.errors err)
            if vector.length(c.errors) >= maxErrors then
                let stop = diagnostics.fatalAt("Too many errors (" <> conv.int(maxErrors) <> "); stopping" err.offset)
                diagnostics.raiseError(:Ok diagnostics.locatedAt(stop err.offset err.length err.file))
            end
        end

    let report(c: T err: diagnostics.CompilerError): Ok = recordError(c env.locate(c.env err))

    let attempt(A::TYPE c: T body: All() A): maybe.T(A) =
        try
            maybe.some(body())
        when diagnostics.compilerError with err then
            if err.isFatal then diagnostics.raiseError(:Ok err) end
            if not(err.silent) then report(c err) end
            maybe.none()
        end
end
