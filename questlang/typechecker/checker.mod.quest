(* Quest Self-Hosted Compiler: The Checker's State and Shared Helpers
 * Implementation *)

module checker : Checker
import
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/typechecker/checks : questlang/typechecker/Checks
    collections/vector : collections/Vector
    collections/hashMap : collections/HashMap
    util/maybe : util/Maybe
    stringOp = string : StringOp
    conv : Conv
export
    Let PendingTypeArg = Tuple meta: model.Type quantifier: model.Quantifier offset: Int end

    Let Rec T = Tuple
        env: env.T
        var loopDepth: Int
        var functionDepth: Int
        var pendingTypeArgs: maybe.T(vector.T(PendingTypeArg))
        errors: vector.T(diagnostics.CompilerError)
        var checkHook: All(c: T expr: ast.Expr expected: model.Type e: env.T loopDepth: Int) typedAst.Expr
        var synthHook: All(c: T expr: ast.Expr e: env.T loopDepth: Int isCallee: Bool) typedAst.Expr
    end

    let new(e: env.T loopDepth: Int): T =
        tuple
            let env = e
            let var loopDepth = loopDepth
            let var functionDepth = 0
            let var pendingTypeArgs = maybe.none(:vector.T(PendingTypeArg))
            let errors = vector.new(:diagnostics.CompilerError)
            let var checkHook = fun(c: T expr: ast.Expr expected: model.Type e: env.T loopDepth: Int): typedAst.Expr
                diagnostics.fail(:typedAst.Expr "internal: the checker has no dispatch" expr.span.startOffset)
            let var synthHook = fun(c: T expr: ast.Expr e: env.T loopDepth: Int isCallee: Bool): typedAst.Expr
                diagnostics.fail(:typedAst.Expr "internal: the checker has no dispatch" expr.span.startOffset)
        end

    let checkExpr(c: T expr: ast.Expr expected: model.Type e: env.T loopDepth: Int): typedAst.Expr =
        c.checkHook(c expr expected e loopDepth)
    let synthExpr(c: T expr: ast.Expr e: env.T loopDepth: Int): typedAst.Expr = c.synthHook(c expr e loopDepth false)
    let synthCallee(c: T expr: ast.Expr e: env.T loopDepth: Int): typedAst.Expr = c.synthHook(c expr e loopDepth true)

    let inLoop(A::TYPE c: T body: All() A): A =
        begin
            c.loopDepth := c.loopDepth + 1
            let result =
                try
                    body()
                when diagnostics.compilerError with err then
                    c.loopDepth := c.loopDepth - 1
                    diagnostics.raiseError(:A err)
                end
            c.loopDepth := c.loopDepth - 1
            result
        end

    let inFunction(A::TYPE c: T body: All() A): A =
        begin
            let savedDepth = c.loopDepth
            c.loopDepth := 0
            c.functionDepth := c.functionDepth + 1
            let result =
                try
                    body()
                when diagnostics.compilerError with err then
                    c.loopDepth := savedDepth
                    c.functionDepth := c.functionDepth - 1
                    diagnostics.raiseError(:A err)
                end
            c.loopDepth := savedDepth
            c.functionDepth := c.functionDepth - 1
            result
        end

    let elaborateSubexpr(c: T expr: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr =
        if maybe.isSome(:model.Type expected) then
            checkExpr(c expr maybe.unwrap(:model.Type expected) e loopDepth)
        else
            synthExpr(c expr e loopDepth)
        end

    let elaborateOptionalBranch(
        c: T expr: maybe.T(ast.Expr) expected: maybe.T(model.Type) e: env.T loopDepth: Int
    ): maybe.T(typedAst.Expr) =
        if maybe.isSome(:ast.Expr expr) then
            maybe.some(:typedAst.Expr elaborateSubexpr(c maybe.unwrap(:ast.Expr expr) expected e loopDepth))
        else
            maybe.none(:typedAst.Expr)
        end

    let branchTypes(
        initial: maybe.T(model.Type) bodies: Array(typedAst.Expr) elseBranch: maybe.T(typedAst.Expr)
    ): Array(model.Type) =
        begin
            let types = vector.new(:model.Type)
            if maybe.isSome(:model.Type initial) then vector.append(:model.Type types maybe.unwrap(:model.Type initial)) end
            for i = 0 upto {extent bodies - 1} do vector.append(:model.Type types bodies[i].type) end
            if maybe.isSome(:typedAst.Expr elseBranch) then
                vector.append(:model.Type types maybe.unwrap(:typedAst.Expr elseBranch).type)
            end
            vector.toArray(:model.Type types)
        end

    let checkSubsumption(
        c: T expr: ast.Expr expected: model.Type e: env.T loopDepth: Int typeDesc: maybe.T(String)
    ): typedAst.Expr =
        checks.requireSubtype(expr.span.startOffset synthExpr(c expr e loopDepth) expected e typeDesc)

    (* Whether a scope's var variables are local to it: a block's, a function's,
     * a tuple's, an inspect, case, or try branch's, a for loop's *)
    let localScope(name: String): Bool =
        begin
            let prefixed(p: String): Bool =
                {stringOp.length(name) >= stringOp.length(p)} andif stringOp.equal(stringOp.getSub(name 0 stringOp.length(p)) p)
            stringOp.equal(name "block") orif stringOp.equal(name "fun") orif stringOp.equal(name "poly_fun")
                orif stringOp.equal(name "tuple_check") orif stringOp.equal(name "tuple_synth")
                orif stringOp.equal(name "inspect_branch") orif stringOp.equal(name "auto_value")
                orif prefixed("case_") orif prefixed("try_") orif prefixed("for_")
        end

    (* Whether sym is a global var variable, which functions may not refer to
     * directly (Typeful Programming section 4.8): one a unit's or a module's
     * top level declares, outside any block, function, or tuple. The scope that
     * declares it is the first one, out from the current scope, that has its
     * name, since it was just looked up by its name. *)
    let isGlobalVar(c: T sym: symbols.ValueSymbol): Bool =
        if not(sym.isVar) orif sym.isParam orif sym.isOut orif {sym.functionDepth > 0} then
            false
        else
            let var scope = maybe.some(:symbols.Scope c.env.currentScope)
            let var searching = true
            while searching andif maybe.isSome(:symbols.Scope scope) do
                let s = maybe.unwrap(:symbols.Scope scope)
                let found = hashMap.get(:String :symbols.ValueSymbol s.values sym.name)
                if maybe.isSome(:symbols.ValueSymbol found) andif {maybe.unwrap(:symbols.ValueSymbol found).symbolId is sym.symbolId} then
                    searching := false
                else
                    scope := s.parent
                end
            end
            let var isGlobal = true
            while isGlobal andif maybe.isSome(:symbols.Scope scope) do
                let s = maybe.unwrap(:symbols.Scope scope)
                if localScope(s.name) then isGlobal := false end
                scope := s.parent
            end
            isGlobal
        end

    (* Rejects a use, from a closure, of a var or out parameter of an enclosing
     * function: such a parameter is the address of its caller's location,
     * which may not outlive the call. A closure may capture a local var
     * variable, which the lowering then holds in a box the frame and the
     * closure share (capturedMutables in questlang/ir/lower). *)
    let checkCapturable(c: T sym: symbols.ValueSymbol offset: Int): Ok =
        if {sym.isOut orif sym.isVar} andif sym.isParam andif {sym.functionDepth > 0}
            andif {c.functionDepth > sym.functionDepth} then
            let kindStr = if sym.isOut then "'out' parameter" else "'var' parameter" end
            diagnostics.fail(:Ok "Cannot capture " <> kindStr <> " '" <> sym.name <> "' in closure" offset)
        elsif {c.functionDepth > 0} andif isGlobalVar(c sym) then
            diagnostics.fail(:Ok "A function may not refer directly to the global 'var' variable '" <> sym.name <>
                "': pass it as a 'var' parameter, or hold it in a data structure" offset)
        end

    let checkPoisoned(sym: symbols.ValueSymbol): Ok =
        if symbols.isPoisonedValue(sym.symbolId) then diagnostics.raiseError(:Ok diagnostics.silentError) end

    let lookupValue(c: T e: env.T name: String): maybe.T(symbols.ValueSymbol) =
        begin
            let sym = env.lookupValue(e name)
            if maybe.isSome(:symbols.ValueSymbol sym) then checkPoisoned(maybe.unwrap(:symbols.ValueSymbol sym)) end
            sym
        end

    let maxErrors = 20

    let recordError(c: T err: diagnostics.CompilerError): Ok =
        begin
            vector.append(:diagnostics.CompilerError c.errors err)
            if vector.length(:diagnostics.CompilerError c.errors) >= maxErrors then
                diagnostics.raiseError(:Ok tuple
                    let message = "Too many errors (" <> conv.int(maxErrors) <> "); stopping"
                    let offset = err.offset
                    let length = err.length
                    let isFatal = true
                    let help = maybe.none(:String)
                    let notes = vector.new(:String)
                    let file = err.file
                    let silent = false
                    let labels = vector.new(:diagnostics.Label)
                end)
            end
        end

    let report(c: T err: diagnostics.CompilerError): Ok = recordError(c env.locate(c.env err))

    let attempt(A::TYPE c: T body: All() A): maybe.T(A) =
        try
            maybe.some(:A body())
        when diagnostics.compilerError with err then
            if err.isFatal then diagnostics.raiseError(:Ok err) end
            if not(err.silent) then report(c err) end
            maybe.none(:A)
        end
end
