(* Quest Self-Hosted Compiler: Path-Type Escape Analysis and Closedness
 * Implementation *)

module escape : Escape
import
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/types/model : questlang/types/Model
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/sort : util/Sort
    stringOp = string : StringOp
export
    let pathName(p: model.Type): String =
        case p.form when typePath with x then x.rootName <> "." <> x.fieldName else "" end

    let checkNoPackageTypes(t: model.Type what: String offset: Int): Ok =
        begin
            let paths = model.findPathTypes(model.stripAliases(t))
            if extent paths > 0 then
                let seen = hashMap.new(:String :Bool stringOp.equal hash.string)
                let names = vector.new(:String)
                for i = 0 upto {extent paths - 1} do
                    let name = pathName(paths[i])
                    if hashMap.insert(:String :Bool seen name true) then vector.append(:String names name) end
                end
                sort.sortVector(:String names sort.stringCompare)
                let var joined = ""
                for i = 0 upto {vector.length(:String names) - 1} do
                    joined := if i is 0 then vector.get(:String names i) else joined <> ", " <> vector.get(:String names i) end
                end
                diagnostics.fail(:Ok what <> " cannot mention " <> joined <> ", an abstract type of a package value, " <>
                    "because its identity is not known at run time" offset)
            end
        end

    let checkNoEscapingPathTypes(t: model.Type localSymbolIds: hashMap.T(Int Bool) contextDesc: String offset: Int): Ok =
        begin
            let paths = model.findPathTypes(t)
            for i = 0 upto {extent paths - 1} do
                case paths[i].form
                    when typePath with p then
                        if hashMap.contains(:Int :Bool localSymbolIds p.rootSymbolId) then
                            diagnostics.fail(:Ok "Abstract type '" <> p.rootName <> "." <> p.fieldName <>
                                "' cannot escape " <> contextDesc <> " in type '" <> model.show(t) <> "'" offset)
                        end
                    else ok
                end
            end
        end
end
