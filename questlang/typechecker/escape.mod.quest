(* Quest Self-Hosted Compiler: Path-Type Escape Analysis and Closedness
 * Implementation *)

module escape : Escape
import
    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/sort : util/Sort

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/maps : questlang/common/Maps
    questlang/types/model : questlang/types/Model
export
    let pathName(p: model.Type): String =
        case p.form when typePath with x then x.rootName <> "." <> x.fieldName else "" end

    let checkNoPackageTypes(t: model.Type what: String offset: Int): Ok =
        begin
            let paths = model.findPathTypes(model.stripAliases(t))
            if extent paths > 0 then
                let seen = maps.newStringSet()
                let names = vector.new(:String)
                for i = 0 upto {extent paths - 1} do
                    let name = pathName(paths[i])
                    if hashSet.insert(seen name) then vector.append(names name) end
                end
                sort.sortVector(names sort.stringCompare)
                let var joined = ""
                for i = 0 upto {vector.length(names) - 1} do
                    joined := if i is 0 then vector.get(names i) else joined <> ", " <> vector.get(names i) end
                end
                diagnostics.fail(:Ok what <> " cannot mention " <> joined <> ", an abstract type of a package value, "
                    <> "because its identity is not known at run time" offset)
            end
        end

    let checkNoEscapingPathTypes(t: model.Type localSymbolIds: maps.IntSet contextDesc: String
            offset: Int): Ok =
        begin
            (* An expected type that was a metavariable is checked, and shown,
             * as its solution *)
            let solved = model.prune(t)
            let paths = model.findPathTypes(solved)
            for i = 0 upto {extent paths - 1} do
                case paths[i].form
                    when typePath with p then
                        if hashSet.contains(localSymbolIds p.rootSymbolId) then
                            diagnostics.fail(:Ok "Abstract type '" <> p.rootName <> "." <> p.fieldName
                                <> "' cannot escape " <> contextDesc <> " in type '" <> model.show(solved) <> "'"
                                    offset)
                        end
                    else ok
                end
            end
        end
end
