(* Quest Self-Hosted Compiler: Bidirectional Type Checker Interface
 *
 * This interface provides bidirectional expression checking (Gamma |- e <= T)
 * and type synthesis (Gamma |- e => T), along with phrase and program
 * elaboration into the typed AST (matching
 * bootstrap/python/quest/typechecker/typecheck.py). Literals, variables,
 * dereference, and while/loop expressions are handled inline; other constructs
 * are delegated to their construct-family modules (bindings, application,
 * aggregates, tuples, control, exceptions, and autoValues).
 *
 * Checking a program reports every error it can (docs/diagnostics.md section
 * 4.5): each phrase that fails is reported, and checking continues with the
 * next phrase, until 20 errors or a fatal error occurs. *)

interface Typecheck
import
    util/maybe : util/Maybe

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/syntax/ast : questlang/syntax/AST
    questlang/typechecker/checker : questlang/typechecker/Checker
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
    questlang/types/model : questlang/types/Model
export
    (* A checker of the environment, with its dispatch *)
    newChecker(e: env.T loopDepth: Int): checker.T

    checkExpr(c: checker.T expr: ast.Expr expected: model.Type e: env.T loopDepth: Int): typedAst.Expr
    synthExpr(c: checker.T expr: ast.Expr e: env.T loopDepth: Int isCallee: Bool): typedAst.Expr

    (* The typed program, if there were no errors; the errors found, in order;
     * the warnings; and the phrases that checked, whether or not others
     * failed (the language server's, docs/lsp.md) *)
    Def Result = Tuple
        program: maybe.T(typedAst.Program) errors: Array(diagnostics.CompilerError)
        warnings: Array(diagnostics.CompilerError)
        partial: typedAst.Program
    end
    elaborateProgram(program: ast.Program e: env.T): Result
    (* Installs the module system's callbacks for compiling a unit alone (the
     * bootstrap's registrations at import): the unit loader, and a binding
     * elaborator checking each module member in a checker of its own, which
     * fails with the member's first error, as the bootstrap's does, even one
     * a block recovered from. elaborateProgram installs its own. *)
    install(): Ok
end
