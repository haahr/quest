(* Quest Self-Hosted Compiler: Tuples Implementation *)

module tuples : Tuples
import
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
    questlang/types/subtyping : questlang/types/Subtyping
    questlang/types/env : questlang/types/Env
    questlang/types/kinds : questlang/types/Kinds
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/typechecker/checker : questlang/typechecker/Checker
    questlang/typechecker/checks : questlang/typechecker/Checks
    questlang/typechecker/elaborateTypes : questlang/typechecker/ElaborateTypes
    questlang/typechecker/bindings : questlang/typechecker/Bindings
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    stringOp = string : StringOp
    conv : Conv
export
    Let Type = model.Type
    Let Kind = model.Kind

    let some(e: env.T): kinds.Env = maybe.some(:env.T e)
    let evaluate(t: Type): Type = model.evaluateLazily(t symbols.lookup)
    let isSubtype(a: Type b: Type e: env.T): Bool = subtyping.isSubtype(a b env.lookupOf(e))
    let isTypeEqual(a: Type b: Type e: env.T): Bool = subtyping.isTypeEqual(a b env.lookupOf(e))
    let expr(offset: Int t: Type form: typedAst.ExprForm): typedAst.Expr = typedAst.expr(offset t form)
    let internal(A::TYPE what: String x: ast.Expr): A = diagnostics.fail(:A "internal: not " <> what x.span.startOffset)
    let newIntMap(V::TYPE): hashMap.T(Int V) = hashMap.new(:Int :V fun(a: Int b: Int): Bool a is b hash.int)

    (* A component of a tuple, its declarations' members flattened: a type
     * binding of a type declaration (its index in typeGroups), a member of a
     * recursive value declaration (in recGroups), or a value component, perhaps
     * of a simultaneous declaration (in simGroups); pos is its position among
     * its declaration's members *)
    Let Item = Option
        typeItem with b: ast.TypeBinding group: Int pos: Int end
        recItem with decl: ast.Decl group: Int pos: Int end
        valItem with b: ast.TupleFieldBinding group: maybe.T(Int) pos: Int end
    end
    Let TypeGroup = Tuple members: vector.T(ast.TypeBinding) isGroup: Bool end
    Let RecGroup = Tuple decl: ast.Decl members: vector.T(ast.Decl) end
    Let KindDecl = Tuple name: String kindVal: ast.KindExpr end
    let nameOf(name: maybe.T(String)): String = maybe.unwrapOr(:String name "None")
    let namedTupleBinding(b: ast.TupleFieldBinding): checks.Named =
        tuple let name = nameOf(b.name) let offset = b.offset end
    let namedDecl(d: ast.Decl): checks.Named =
        case d.form
            when declLetVal with x then tuple let name = x.name let offset = d.span.startOffset end
            else tuple let name = "" let offset = d.span.startOffset end
        end
    (* The name a declaration that cannot be a tuple's component has in the
     * error that says so *)
    let declClassName(d: ast.Decl): String =
        case d.form
            when declExprStmt then "ExprStmt"
            when declImport then "an import"
            else "Expr"
        end
    let synthTupleComponent(c: checker.T b: ast.TupleFieldBinding e: env.T loopDepth: Int): typedAst.Expr =
        if maybe.isSome(:ast.TypeExpr b.typeAnnot) then
            checker.checkExpr(c b.value elaborateTypes.elaborateType(maybe.unwrap(:ast.TypeExpr b.typeAnnot) e) e loopDepth)
        else
            checker.synthExpr(c b.value e loopDepth)
        end
    let newLabel(c: checker.T name: String t: Type isVar: Bool): symbols.ValueSymbol =
        symbols.newValueSymbol(name t isVar false false c.functionDepth 0)
    (* Steps 2 and 3 of elaborateTupleComponents, run in the scope it opens
     * for the tuple: the typed tuple of items, step 1's flattened components,
     * elaborated in order. typeGroups, recGroupsAst, simGroups, and
     * kindsBefore are step 1's too. Checking, expectedTuple holds the
     * expected type's components, which items match one for one, and the
     * tuple has that type, expectedTupleType. Synthesizing, both are none, and
     * the tuple's type is built from its components' (a type component
     * becomes a manifest one, Let A = T). Raises diagnostics errors on a
     * mismatch *)
    let tupleScope(
        c: checker.T x0: ast.Expr items: vector.T(Item) typeGroups: vector.T(TypeGroup) recGroupsAst: vector.T(RecGroup)
        simGroups: vector.T(vector.T(ast.TupleFieldBinding)) kindsBefore: hashMap.T(Int vector.T(KindDecl))
        expectedTuple: maybe.T(Array(model.TupleComponent)) expectedTupleType: maybe.T(Type) e: env.T loopDepth: Int
    ): typedAst.Expr =
        begin
            let checking = maybe.isSome(:Array(model.TupleComponent) expectedTuple)
            let expFields = maybe.unwrapOr(:Array(model.TupleComponent) expectedTuple array of :model.TupleComponent end)
            let n = vector.length(:Item items)
            let witnessSubst = model.newSubst()
            let elems = vector.new(:typedAst.Expr)
            (* The components of a synthesized tuple's type *)
            let qFields = vector.new(:model.TupleComponent)
            let witnesses = newIntMap(:Array(elaborateTypes.TupleTypeBinding))
            (* The symbols of recursive value members, declared once the first
             * member of their declaration is reached (checking), or their typed
             * declarations, elaborated then (synthesizing), by group *)
            let recSymbols = newIntMap(:vector.T(symbols.ValueSymbol))
            let recTyped = newIntMap(:Array(typedAst.Binding))
            let recGroups = vector.new(:Array(Int))
            let simultaneousGroups = vector.new(:Array(Int))
            Let Pending = Tuple index: Int name: String type: Type isVar: Bool label: maybe.T(symbols.ValueSymbol) end
            let pendingLabels = vector.new(:Pending)
            (* The symbol of each labeled element's label, by element index *)
            let labels = newIntMap(:symbols.ValueSymbol)
            let groupIndices = vector.new(:Int)

            let declareKinds(index: Int): Ok =
                begin
                    let found = hashMap.get(:Int :vector.T(KindDecl) kindsBefore index)
                    if maybe.isSome(:vector.T(KindDecl) found) then
                        let ks = maybe.unwrap(:vector.T(KindDecl) found)
                        for i = 0 upto {vector.length(:KindDecl ks) - 1} do
                            let k = vector.get(:KindDecl ks i)
                            elaborateTypes.elaborateKindBinding(k.name k.kindVal e)
                        end
                    end
                end

            (* A type binding's witness, with its declared bound if any; the
             * members of a group are elaborated together, before any of them is
             * declared *)
            let witnessOf(group: Int pos: Int): elaborateTypes.TupleTypeBinding =
                begin
                    if not(hashMap.contains(:Int :Array(elaborateTypes.TupleTypeBinding) witnesses group)) then
                        let g = vector.get(:TypeGroup typeGroups group)
                        hashMap.insert(:Int :Array(elaborateTypes.TupleTypeBinding) witnesses group
                            elaborateTypes.elaborateTupleTypeBindings(g.members g.isGroup e))
                    end
                    hashMap.find(:Int :Array(elaborateTypes.TupleTypeBinding) witnesses group)[pos]
                end

            let witnessExpr(offset: Int name: String t: Type bound: maybe.T(Kind)): typedAst.Expr =
                expr(offset model.okType option exprTypeWitness of typedAst.ExprForm with
                    let name = name let witnessType = t let bound = bound
                end)

            (* 2. Elaborate the components in order, in a scope of their own,
             *    so that each type component and each label (a value
             *    component's name) is in scope for the components after it.
             *    Each component falls into one of four cases, chosen by what
             *    the expected type says of it (expKind, checking) or what it
             *    is (synthesizing). *)
            for index = 0 upto {n - 1} do
                declareKinds(index)
                let item = vector.get(:Item items index)
                let expF = if checking then maybe.some(:model.TupleComponent expFields[index]) else maybe.none(:model.TupleComponent) end
                let itemOffset = case item
                    when typeItem with t then t.b.offset
                    when recItem with r then r.decl.span.startOffset
                    when valItem with v then v.b.offset
                end
                let isTypeItem = case item when typeItem then true else false end
                let expKind = if maybe.isSome(:model.TupleComponent expF) then
                    case maybe.unwrap(:model.TupleComponent expF)
                        when tupleTypeFormal then 1
                        when tupleTypeBinding then 2
                        when tupleField then 3
                    end
                else
                    0
                end
                if expKind is 1 then
                    (* A type formal of the expected type, A::K: the component
                     * is A's witness, the type hidden behind A. It must have
                     * A's bound. A is declared under the formal's own symbol
                     * with the witness as its definition, so that the later
                     * components see through it, while the tuple's type, the
                     * expected one, keeps A abstract; witnessSubst carries the
                     * witness into the later expected fields. *)
                    case maybe.unwrap(:model.TupleComponent expF)
                        when tupleTypeFormal with f then
                            case item
                                when typeItem with t then
                                    begin
                                        if not(stringOp.equal(t.b.name f.name)) then
                                            diagnostics.fail(:Ok "Tuple type formal name mismatch: expected '" <> f.name <>
                                                "', got '" <> t.b.name <> "'" t.b.offset)
                                        end
                                        let witnessType = maybe.unwrap(:Type witnessOf(t.group t.pos).sym.definition)
                                        let expectedBound = model.substituteInKind(f.bound witnessSubst)
                                        kinds.checkKind(witnessType expectedBound some(e))
                                        hashMap.insert(:Int :Type witnessSubst f.symbolId witnessType)
                                        symbols.declareType(e.currentScope
                                            symbols.newTypeSymbol(f.name f.symbolId expectedBound maybe.some(:Type witnessType)))
                                        vector.append(:typedAst.Expr elems
                                            witnessExpr(t.b.offset f.name witnessType maybe.some(:Kind expectedBound)))
                                    end
                                else
                                    diagnostics.fail(:Ok "Expected type witness for type formal '" <> f.name <>
                                        "', got value component" itemOffset)
                            end
                        else ok
                    end
                elsif expKind is 2 then
                    (* A type defined by the expected type, A = T: the
                     * component must define A as T *)
                    case maybe.unwrap(:model.TupleComponent expF)
                        when tupleTypeBinding with f then
                            case item
                                when typeItem with t then
                                    begin
                                        if not(stringOp.equal(t.b.name f.name)) then
                                            diagnostics.fail(:Ok "Tuple type binding name mismatch: expected '" <> f.name <>
                                                "', got '" <> t.b.name <> "'" t.b.offset)
                                        end
                                        let witnessType = maybe.unwrap(:Type witnessOf(t.group t.pos).sym.definition)
                                        let expectedTypeVal = model.substitute(f.type witnessSubst)
                                        if not(isTypeEqual(witnessType expectedTypeVal e)) then
                                            diagnostics.fail(:Ok "Type binding '" <> f.name <> "' must match manifest type '" <>
                                                model.show(expectedTypeVal) <> "', got '" <> model.show(witnessType) <> "'"
                                                t.b.offset)
                                        end
                                        symbols.declareType(e.currentScope symbols.newTypeSymbol(f.name env.freshSymbolId(e)
                                            maybe.unwrapOr(:Kind f.bound model.typeKind) maybe.some(:Type witnessType)))
                                        vector.append(:typedAst.Expr elems witnessExpr(t.b.offset f.name witnessType f.bound))
                                    end
                                else
                                    diagnostics.fail(:Ok "Expected type binding for '" <> f.name <> "', got value component"
                                        itemOffset)
                            end
                        else ok
                    end
                elsif isTypeItem then
                    (* Synthesizing, a type component: it is declared for the
                     * components after it, and is a defined type component of
                     * the tuple's type (against an expected value field, an
                     * error) *)
                    case item
                        when typeItem with t then
                            begin
                                if maybe.isSome(:model.TupleComponent expF) then
                                    let fname = maybe.unwrapOr(:String model.componentName(maybe.unwrap(:model.TupleComponent expF))
                                        "None")
                                    diagnostics.fail(:Ok "Unexpected type binding '" <> t.b.name <> "' for value field '" <>
                                        fname <> "'" t.b.offset)
                                end
                                let w = witnessOf(t.group t.pos)
                                let kBound = maybe.unwrapOr(:Kind w.bound model.typeKind)
                                symbols.declareType(e.currentScope w.sym)
                                let def = maybe.unwrap(:Type w.sym.definition)
                                vector.append(:typedAst.Expr elems witnessExpr(t.b.offset t.b.name def maybe.some(:Kind kBound)))
                                vector.append(:model.TupleComponent qFields option tupleTypeBinding of model.TupleComponent with
                                    let name = t.b.name let type = def let bound = maybe.some(:Kind kBound)
                                end)
                            end
                        else ok
                    end
                else
                    (* A value component. The members of a let rec are all
                     * declared when the first is reached, so that each can
                     * refer to the others; those of a let ... and ... have
                     * their labels declared after the last. *)
                    let expFieldType =if maybe.isSome(:model.TupleComponent expF) then
                        case maybe.unwrap(:model.TupleComponent expF)
                            when tupleField with f then
                                begin
                                    let bname = case item
                                        when recItem with r then maybe.some(:String namedDecl(r.decl).name)
                                        when valItem with v then v.b.name
                                        else maybe.none(:String)
                                    end
                                    if maybe.isSome(:String f.name) andif maybe.isSome(:String bname) andif
                                            not(stringOp.equal(maybe.unwrap(:String f.name) maybe.unwrap(:String bname))) then
                                        diagnostics.fail(:Ok "Tuple field name mismatch: expected '" <>
                                            maybe.unwrap(:String f.name) <> "', got '" <> maybe.unwrap(:String bname) <> "'"
                                            itemOffset)
                                    end
                                    maybe.some(:Type model.substitute(f.type witnessSubst))
                                end
                            else maybe.none(:Type)
                        end
                    else
                        maybe.none(:Type)
                    end
                    let expIsVar = if maybe.isSome(:model.TupleComponent expF) then
                        case maybe.unwrap(:model.TupleComponent expF) when tupleField with f then f.isVar else false end
                    else
                        false
                    end
                    let expName = if maybe.isSome(:model.TupleComponent expF) then
                        case maybe.unwrap(:model.TupleComponent expF) when tupleField with f then f.name else maybe.none(:String) end
                    else
                        maybe.none(:String)
                    end
                    case item
                        when recItem with r then
                            begin
                                let g = vector.get(:RecGroup recGroupsAst r.group)
                                let last = vector.length(:ast.Decl g.members) - 1
                                if r.pos is 0 then
                                    vector.clear(:Int groupIndices)
                                    if maybe.isNone(:model.TupleComponent expF) then
                                        let typed = bindings.elaborateBinding(c g.decl e loopDepth)
                                        hashMap.insert(:Int :Array(typedAst.Binding) recTyped r.group typedAst.bindingMembers(typed))
                                    else
                                        let syms = vector.new(:symbols.ValueSymbol)
                                        for i = 0 upto last do
                                            vector.append(:symbols.ValueSymbol syms
                                                bindings.declareRecValue(c vector.get(:ast.Decl g.members i) e))
                                        end
                                        hashMap.insert(:Int :vector.T(symbols.ValueSymbol) recSymbols r.group syms)
                                    end
                                end
                                Let Member = Tuple value: typedAst.Expr sym: symbols.ValueSymbol end
                                let member: Member = if maybe.isNone(:model.TupleComponent expF) then
                                    let typedMember = hashMap.find(:Int :Array(typedAst.Binding) recTyped r.group)[r.pos]
                                    case typedMember.form
                                        when bindLetValue with v then
                                            begin
                                                vector.append(:model.TupleComponent qFields model.tupleField(
                                                    maybe.some(:String v.value.name) v.value.symbol.type v.value.symbol.isVar))
                                                tuple let value = v.value.value let sym = v.value.symbol end
                                            end
                                        else diagnostics.fail(:Member "internal: not a let declaration" itemOffset)
                                    end
                                else
                                    let recSym = vector.get(:symbols.ValueSymbol
                                        hashMap.find(:Int :vector.T(symbols.ValueSymbol) recSymbols r.group) r.pos)
                                    if expIsVar then
                                        diagnostics.fail(:Ok "Tuple field '" <> maybe.unwrapOr(:String expName "") <>
                                            "' must be declared mutable (var)" itemOffset)
                                    end
                                    let eft = maybe.unwrap(:Type expFieldType)
                                    if not(isSubtype(recSym.type eft e)) then
                                        diagnostics.fail(:Ok "Tuple field '" <> namedDecl(r.decl).name <> "' declared type '" <>
                                            model.show(recSym.type) <> "' is not a subtype of expected field type '" <>
                                            model.show(eft) <> "'" itemOffset)
                                    end
                                    let typedMember = bindings.checkRecValue(c r.decl recSym e loopDepth)
                                    tuple let value = typedMember.value let sym = recSym end
                                end
                                vector.append(:Int groupIndices vector.length(:typedAst.Expr elems))
                                hashMap.insert(:Int :symbols.ValueSymbol labels vector.length(:typedAst.Expr elems) member.sym)
                                vector.append(:typedAst.Expr elems member.value)
                                if r.pos is last then
                                    vector.append(:Array(Int) recGroups vector.toArray(:Int vector.copy(:Int groupIndices)))
                                end
                            end
                        when valItem with v then
                            begin
                                let b = v.b
                                if not(checking) andif maybe.isSome(:Int v.group) andif {v.pos is 0} then
                                    let members = vector.get(:vector.T(ast.TupleFieldBinding) simGroups maybe.unwrap(:Int v.group))
                                    checks.checkDistinctNames(vector.toArray(:checks.Named
                                        vector.map(:ast.TupleFieldBinding :checks.Named members namedTupleBinding)))
                                end
                                Let Labeled = Tuple value: typedAst.Expr name: maybe.T(String) type: Type isVar: Bool end
                                let labeled: Labeled = if maybe.isNone(:model.TupleComponent expF) then
                                    let valTyped = synthTupleComponent(c b e loopDepth)
                                    vector.append(:model.TupleComponent qFields model.tupleField(b.name valTyped.type b.isVar))
                                    tuple let value = valTyped let name = b.name let type = valTyped.type let isVar = b.isVar end
                                else
                                    let eft = maybe.unwrap(:Type expFieldType)
                                    let valTyped = if expIsVar then
                                        if not(b.isVar) then
                                            diagnostics.fail(:Ok "Tuple field '" <> maybe.unwrapOr(:String expName "") <>
                                                "' must be declared mutable (var)" b.offset)
                                        end
                                        let t = checker.checkExpr(c b.value eft e loopDepth)
                                        if not(isTypeEqual(t.type eft e)) then
                                            diagnostics.fail(:Ok "Mutable tuple field '" <> maybe.unwrapOr(:String expName "") <>
                                                "' is invariant; expected '" <> model.show(eft) <> "', got '" <>
                                                model.show(t.type) <> "'" b.offset)
                                        end
                                        t
                                    elsif maybe.isSome(:ast.TypeExpr b.typeAnnot) then
                                        let annotType = elaborateTypes.elaborateType(maybe.unwrap(:ast.TypeExpr b.typeAnnot) e)
                                        if not(isSubtype(annotType eft e)) then
                                            diagnostics.fail(:Ok "Tuple field '" <> nameOf(b.name) <> "' declared type '" <>
                                                model.show(annotType) <> "' is not a subtype of expected field type '" <>
                                                model.show(eft) <> "'" b.offset)
                                        end
                                        checker.checkExpr(c b.value annotType e loopDepth)
                                    else
                                        checker.checkExpr(c b.value eft e loopDepth)
                                    end
                                    tuple let value = valTyped let name = expName let type = eft let isVar = expIsVar end
                                end
                                let elementIndex = vector.length(:typedAst.Expr elems)
                                vector.append(:typedAst.Expr elems labeled.value)
                                if maybe.isSome(:Int v.group) then
                                    let members = vector.get(:vector.T(ast.TupleFieldBinding) simGroups maybe.unwrap(:Int v.group))
                                    if v.pos is 0 then vector.clear(:Int groupIndices) end
                                    vector.append(:Int groupIndices elementIndex)
                                    if maybe.isSome(:String labeled.name) then
                                        let label = if checking then
                                            maybe.some(:symbols.ValueSymbol
                                                newLabel(c maybe.unwrap(:String labeled.name) labeled.type labeled.isVar))
                                        else
                                            maybe.none(:symbols.ValueSymbol)
                                        end
                                        vector.append(:Pending pendingLabels tuple
                                            let index = elementIndex let name = maybe.unwrap(:String labeled.name)
                                            let type = labeled.type let isVar = labeled.isVar let label = label
                                        end)
                                    end
                                    if v.pos is {vector.length(:ast.TupleFieldBinding members) - 1} then
                                        vector.append(:Array(Int) simultaneousGroups
                                            vector.toArray(:Int vector.copy(:Int groupIndices)))
                                        for i = 0 upto {vector.length(:Pending pendingLabels) - 1} do
                                            let p = vector.get(:Pending pendingLabels i)
                                            let label = if maybe.isSome(:symbols.ValueSymbol p.label) then
                                                maybe.unwrap(:symbols.ValueSymbol p.label)
                                            else
                                                newLabel(c p.name p.type p.isVar)
                                            end
                                            hashMap.insert(:Int :symbols.ValueSymbol labels p.index
                                                symbols.declareValue(e.currentScope label))
                                        end
                                        vector.clear(:Pending pendingLabels)
                                    end
                                elsif maybe.isSome(:String labeled.name) then
                                    hashMap.insert(:Int :symbols.ValueSymbol labels elementIndex symbols.declareValue(
                                        e.currentScope newLabel(c maybe.unwrap(:String labeled.name) labeled.type labeled.isVar)))
                                    ok
                                end
                            end
                        else ok
                    end
                end
            end
            (* Trailing manifest kinds name nothing, but are still checked *)
            declareKinds(n)

            let elements = vector.toArray(:typedAst.Expr elems)
            let labelArray = vector.new(:maybe.T(symbols.ValueSymbol))
            for i = 0 upto {extent elements - 1} do
                vector.append(:maybe.T(symbols.ValueSymbol) labelArray hashMap.get(:Int :symbols.ValueSymbol labels i))
            end
            (* 3. Checking, the tuple has the expected type; synthesizing, the
             *    type made of its components' types *)
            let tupleType = if maybe.isSome(:Type expectedTupleType) then
                maybe.unwrap(:Type expectedTupleType)
            else
                model.tupleType(vector.toArray(:model.TupleComponent qFields))
            end
            expr(x0.span.startOffset tupleType option exprTuple of typedAst.ExprForm with
                let elements = elements
                let recGroups = vector.toArray(:Array(Int) recGroups)
                let simultaneousGroups = vector.toArray(:Array(Int) simultaneousGroups)
                let labels = vector.toArray(:maybe.T(symbols.ValueSymbol) labelArray)
            end)
        end
    let elaborateTupleComponents(
        c: checker.T x0: ast.Expr components: vector.T(ast.TupleField) expectedTuple: maybe.T(Array(model.TupleComponent))
        expectedTupleType: maybe.T(Type) e: env.T loopDepth: Int
    ): typedAst.Expr =
        begin
            let checking = maybe.isSome(:Array(model.TupleComponent) expectedTuple)
            (* 1. Flatten the components. A group (let ... and ..., or a group
             *    of type bindings) contributes each of its members, so that
             *    items[i] lines up with the expected type's i-th field; the
             *    groups (typeGroups, recGroupsAst, simGroups) remember the
             *    group each member came from, since a group's members are
             *    declared together. Then the count is checked.
             *
             * The manifest kinds declared just before a component are kept in
             * kindsBefore, under the index of the component that follows them.
             * Against an expected type, the names in groups are checked here,
             * before the arity; synthesized, as each group is reached. *)
            let items = vector.new(:Item)
            let typeGroups = vector.new(:TypeGroup)
            let recGroupsAst = vector.new(:RecGroup)
            let simGroups = vector.new(:vector.T(ast.TupleFieldBinding))
            let kindsBefore = newIntMap(:vector.T(KindDecl))
            let addKind(k: KindDecl): Ok =
                begin
                    let index = vector.length(:Item items)
                    if not(hashMap.contains(:Int :vector.T(KindDecl) kindsBefore index)) then
                        hashMap.insert(:Int :vector.T(KindDecl) kindsBefore index vector.new(:KindDecl))
                    end
                    vector.append(:KindDecl hashMap.find(:Int :vector.T(KindDecl) kindsBefore index) k)
                end
            let addTypes(members: vector.T(ast.TypeBinding) isGroup: Bool): Ok =
                begin
                    let ms = if checking then elaborateTypes.tupleTypeBindingMembers(members isGroup) else members end
                    let group = vector.length(:TypeGroup typeGroups)
                    vector.append(:TypeGroup typeGroups tuple let members = ms let isGroup = isGroup end)
                    for i = 0 upto {vector.length(:ast.TypeBinding ms) - 1} do
                        vector.append(:Item items option typeItem of Item with
                            let b = vector.get(:ast.TypeBinding ms i) let group = group let pos = i
                        end)
                    end
                end
            let addRec(d: ast.Decl): Ok =
                begin
                    let members = bindings.valueMembers(d)
                    if checking then
                        checks.checkDistinctNames(vector.toArray(:checks.Named vector.map(:ast.Decl :checks.Named members namedDecl)))
                    end
                    let group = vector.length(:RecGroup recGroupsAst)
                    vector.append(:RecGroup recGroupsAst tuple let decl = d let members = members end)
                    for i = 0 upto {vector.length(:ast.Decl members) - 1} do
                        vector.append(:Item items option recItem of Item with
                            let decl = vector.get(:ast.Decl members i) let group = group let pos = i
                        end)
                    end
                end
            for i = 0 upto {vector.length(:ast.TupleField components) - 1} do
                case vector.get(:ast.TupleField components i)
                    when fieldVal with v then
                        vector.append(:Item items option valItem of Item with
                            let b = v.val let group = maybe.none(:Int) let pos = 0
                        end)
                    when fieldGroup with g then
                        begin
                            if checking then
                                checks.checkDistinctNames(vector.toArray(:checks.Named
                                    vector.map(:ast.TupleFieldBinding :checks.Named g.val namedTupleBinding)))
                            end
                            let group = vector.length(:vector.T(ast.TupleFieldBinding) simGroups)
                            vector.append(:vector.T(ast.TupleFieldBinding) simGroups g.val)
                            for j = 0 upto {vector.length(:ast.TupleFieldBinding g.val) - 1} do
                                vector.append(:Item items option valItem of Item with
                                    let b = vector.get(:ast.TupleFieldBinding g.val j) let group = maybe.some(:Int group)
                                    let pos = j
                                end)
                            end
                        end
                    when fieldDecl with d then
                        case d.val.form
                            when declDefKind with k then addKind(tuple let name = k.name let kindVal = k.kindVal end)
                            when declTypeBinding then
                                addTypes(vector.fromArray(:ast.TypeBinding array of bindings.typeBindingOf(d.val) end) false)
                            when declTypeBindingGroup with g then
                                addTypes(vector.map(:ast.Decl :ast.TypeBinding g.bindings bindings.typeBindingOf) true)
                            when declLetVal then addRec(d.val)
                            when declLetValGroup then addRec(d.val)
                            else
                                (* Phrases a tuple cannot hold, rejected before
                                 * the arity is checked *)
                                diagnostics.fail(:Ok "Unsupported tuple component: " <> declClassName(d.val)
                                    d.val.span.startOffset)
                        end
                end
            end
            let n = vector.length(:Item items)
            let expFields = maybe.unwrapOr(:Array(model.TupleComponent) expectedTuple array of :model.TupleComponent end)
            if checking andif {n isnot extent expFields} then
                diagnostics.fail(:Ok "Tuple arity mismatch: expected " <> conv.int(extent expFields) <> " components, got " <>
                    conv.int(n) x0.span.startOffset)
            end
            env.scoped(:typedAst.Expr e if checking then "tuple_check" else "tuple_synth" end fun(s: symbols.Scope): typedAst.Expr
                tupleScope(c x0 items typeGroups recGroupsAst simGroups kindsBefore expectedTuple expectedTupleType e loopDepth))
        end
    (* Each member of a group is a component of its own, and a manifest kind is
     * not a component: it names a kind for the components after it. Components
     * are elaborated in order, and each value component's label is declared for
     * the ones after it; a simultaneous declaration's labels are declared after
     * its last member, and a recursive declaration's members before any of
     * their values. Against an expected tuple type, the components must match
     * its fields one for one. *)
    let elaborateTuple(c: checker.T x0: ast.Expr expected: maybe.T(Type) e: env.T loopDepth: Int): typedAst.Expr =
        case x0.form
            when exprTuple with x then
                begin
                    let var expectedTuple = maybe.none(:Array(model.TupleComponent))
                    let var expectedTupleType = maybe.none(:Type)
                    let var early = maybe.none(:typedAst.Expr)
                    if maybe.isSome(:Type expected) then
                        let expectedLazy = evaluate(maybe.unwrap(:Type expected))
                        case expectedLazy.form
                            when typeTuple with t then
                                expectedTuple := maybe.some(:Array(model.TupleComponent) t.fields)
                                expectedTupleType := maybe.some(:Type expectedLazy)
                            else
                                early := maybe.some(:typedAst.Expr checker.checkSubsumption(c x0 maybe.unwrap(:Type expected)
                                    e loopDepth maybe.some(:String "Tuple")))
                        end
                    end
                    if maybe.isSome(:typedAst.Expr early) then
                        maybe.unwrap(:typedAst.Expr early)
                    else
                        elaborateTupleComponents(c x0 x.fields expectedTuple expectedTupleType e loopDepth)
                    end
                end
            else internal(:typedAst.Expr "a tuple" x0)
        end
end
