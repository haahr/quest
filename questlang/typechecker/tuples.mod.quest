(* Quest Self-Hosted Compiler: Tuples Implementation *)

module tuples : Tuples
import
    conv : Conv
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/maps : questlang/common/Maps
    questlang/syntax/ast : questlang/syntax/AST
    questlang/typechecker/bindings : questlang/typechecker/Bindings
    questlang/typechecker/checker : questlang/typechecker/Checker
    questlang/typechecker/checks : questlang/typechecker/Checks
    questlang/typechecker/elaborateTypes : questlang/typechecker/ElaborateTypes
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
    questlang/types/kinds : questlang/types/Kinds
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
export
    Let Type = model.Type
    Let Kind = model.Kind

    (* A component of a tuple after flattening declarations' members: a type
     * binding of a type declaration (its index in typeGroups), a member of a
     * recursive value declaration (in recGroupsAst), or a value component,
     * optionally from a simultaneous declaration (in simGroups); pos is its
     * position among its declaration's members *)
    Let Item = Option
        typeItem with b: ast.TypeBinding group: Int pos: Int end
        recItem with decl: ast.Decl group: Int pos: Int end
        valItem with b: ast.TupleFieldBinding group: maybe.T(Int) pos: Int end
    end
    Let TypeGroup = Tuple members: vector.T(ast.TypeBinding) isGroup: Bool end
    Let RecGroup = Tuple decl: ast.Decl members: vector.T(ast.Decl) end
    Let KindDecl = Tuple name: String kindVal: ast.KindExpr end
    let nameOf(name: maybe.T(String)): String = maybe.unwrapOr(name "None")
    let namedTupleBinding(b: ast.TupleFieldBinding): checks.Named =
        tuple let name = nameOf(b.name) let offset = b.offset end
    let namedDecl(d: ast.Decl): checks.Named =
        case d.form
            when declLetVal with x then tuple let name = x.name let offset = d.span.startOffset end
            else tuple let name = "" let offset = d.span.startOffset end
        end
    (* The name a declaration that cannot be a tuple's component has in the
     * error that says so *)
    let declClassName(d: ast.Decl): String =
        case d.form
            when declExprStmt then "ExprStmt"
            when declImport then "an import"
            else "Expr"
        end
    let synthTupleComponent(c: checker.T b: ast.TupleFieldBinding): typedAst.Expr =
        if maybe.isSome(b.typeAnnot) then
            checker.checkExpr(c b.value elaborateTypes.elaborateType(maybe.unwrap(b.typeAnnot) c.env))
        else
            checker.synthExpr(c b.value)
        end
    let newLabel(c: checker.T name: String t: Type isVar: Bool): symbols.ValueSymbol =
        symbols.newValueSymbol(name t isVar false false c.functionDepth 0)
    (* A label of a member of a simultaneous declaration (let ... and ...),
     * declared once its last member is elaborated: the element's index, the
     * label's name, type, and mutability, and, when checking, its symbol,
     * made when the member is *)
    Let PendingLabel = Tuple index: Int name: String type: Type isVar: Bool label: maybe.T(symbols.ValueSymbol) end

    (* The state of tupleScope's walk over a tuple's components: step 1's
     * collections (items, typeGroups, recGroupsAst, simGroups, kindsBefore),
     * and what the walk builds *)
    Let Scope = Tuple
        c: checker.T
        items: vector.T(Item)
        typeGroups: vector.T(TypeGroup)
        recGroupsAst: vector.T(RecGroup)
        simGroups: vector.T(vector.T(ast.TupleFieldBinding))
        kindsBefore: maps.IntMap(vector.T(KindDecl))
        (* Whether there is an expected type (checking), not synthesizing *)
        checking: Bool
        (* The witnesses of the expected type's formals so far, for the
         * expected fields after them *)
        witnessSubst: model.Subst
        (* The typed elements so far *)
        elems: vector.T(typedAst.Expr)
        (* The components of a synthesized tuple's type *)
        qFields: vector.T(model.TupleComponent)
        (* The witnesses of each group of type bindings, elaborated when its
         * first member is reached *)
        witnesses: maps.IntMap(Array(elaborateTypes.TupleTypeBinding))
        (* The symbols of recursive value members, declared once the first
         * member of their declaration is reached (checking), or their typed
         * declarations, elaborated then (synthesizing), by group *)
        recSymbols: maps.IntMap(vector.T(symbols.ValueSymbol))
        recTyped: maps.IntMap(Array(typedAst.Binding))
        (* The element indices of each recursive group and each simultaneous
         * declaration, once its last member is elaborated *)
        recGroups: vector.T(Array(Int))
        simultaneousGroups: vector.T(Array(Int))
        pendingLabels: vector.T(PendingLabel)
        (* The symbol of each labeled element's label, by element index *)
        labels: maps.IntMap(symbols.ValueSymbol)
        (* The element indices of the group being elaborated *)
        groupIndices: vector.T(Int)
    end

    (* Declares the manifest kinds written before the component at index *)
    let declareKinds(s: Scope index: Int): Ok =
        begin
            let found = hashMap.get(s.kindsBefore index)
            if maybe.isSome(found) then
                let ks = maybe.unwrap(found)
                for i = 0 upto {vector.length(ks) - 1} do
                    let k = vector.get(ks i)
                    elaborateTypes.elaborateKindBinding(k.name k.kindVal s.c.env)
                end
            end
        end

    (* A type binding's witness, with its declared bound if any; the members
     * of a group are elaborated together, before any of them is declared *)
    let witnessOf(s: Scope group: Int pos: Int): elaborateTypes.TupleTypeBinding =
        begin
            if not(hashMap.contains(s.witnesses group)) then
                let g = vector.get(s.typeGroups group)
                hashMap.insert(s.witnesses group elaborateTypes.elaborateTupleTypeBindings(g.members g.isGroup s.c.env))
            end
            hashMap.find(s.witnesses group)[pos]
        end

    let witnessExpr(offset: Int name: String t: Type bound: maybe.T(Kind)): typedAst.Expr =
        typedAst.expr(offset model.okType option exprTypeWitness of typedAst.ExprForm with
            let name = name
            let witnessType = t
            let bound = bound
        end)

    (* A component against a type formal of the expected type, A::K: the
     * component is A's witness, the type hidden behind A. It must have A's
     * bound. A is declared under the formal's own symbol with the witness as
     * its definition, so that the later components see through it, while the
     * tuple's type, the expected one, keeps A abstract; witnessSubst carries
     * the witness into the later expected fields. *)
    let formalComponent(s: Scope item: Item expF: model.TupleComponent itemOffset: Int): Ok =
        case expF
            when tupleTypeFormal with f then
                case item
                    when typeItem with t then
                        begin
                            if not(stringOp.equal(t.b.name f.name)) then
                                diagnostics.fail(:Ok "Tuple type formal name mismatch: expected '" <> f.name
                                    <> "', got '" <> t.b.name <> "'" t.b.offset)
                            end
                            let witnessType = maybe.unwrap(witnessOf(s t.group t.pos).sym.definition)
                            let expectedBound = model.substituteInKind(f.bound s.witnessSubst)
                            kinds.checkKind(witnessType expectedBound maybe.some(s.c.env))
                            hashMap.insert(s.witnessSubst f.symbolId witnessType)
                            symbols.declareType(s.c.env.currentScope
                                    symbols.newTypeSymbol(f.name f.symbolId expectedBound maybe.some(witnessType)))
                            vector.append(s.elems witnessExpr(t.b.offset f.name witnessType maybe.some(expectedBound)))
                        end
                    else
                        diagnostics.fail(:Ok "Expected type witness for type formal '" <> f.name
                            <> "', got value component" itemOffset)
                end
            else ok
        end

    (* A component against a type defined by the expected type, A = T: the
     * component must define A as T *)
    let bindingComponent(s: Scope item: Item expF: model.TupleComponent itemOffset: Int): Ok =
        case expF
            when tupleTypeBinding with f then
                case item
                    when typeItem with t then
                        begin
                            if not(stringOp.equal(t.b.name f.name)) then
                                diagnostics.fail(:Ok "Tuple type binding name mismatch: expected '"
                                    <> f.name
                                    <> "', got '" <> t.b.name <> "'" t.b.offset)
                            end
                            let witnessType = maybe.unwrap(witnessOf(s t.group t.pos).sym.definition)
                            let expectedTypeVal = model.substitute(f.type s.witnessSubst)
                            if not(checks.isTypeEqual(witnessType expectedTypeVal)) then
                                diagnostics.fail(:Ok "Type binding '" <> f.name
                                    <> "' must match manifest type '"
                                    <> model.show(expectedTypeVal) <> "', got '" <> model.show(witnessType)
                                    <> "'"
                                        t.b.offset)
                            end
                            symbols.declareType(s.c.env.currentScope
                                    symbols.newTypeSymbol(f.name env.freshSymbolId(s.c.env)
                                            maybe.unwrapOr(f.bound model.typeKind) maybe.some(witnessType)))
                            vector.append(s.elems witnessExpr(t.b.offset f.name witnessType f.bound))
                        end
                    else
                        diagnostics.fail(:Ok "Expected type binding for '" <> f.name
                            <> "', got value component"
                                itemOffset)
                end
            else ok
        end

    (* Synthesizing, a type component: it is declared for the components after
     * it, and is a defined type component of the tuple's type (against an
     * expected value field, an error) *)
    let typeComponent(s: Scope item: Item expF: maybe.T(model.TupleComponent)): Ok =
        case item
            when typeItem with t then
                begin
                    if maybe.isSome(expF) then
                        let fname = maybe.unwrapOr(model.componentName(maybe.unwrap(expF)) "None")
                        diagnostics.fail(:Ok "Unexpected type binding '" <> t.b.name
                            <> "' for value field '"
                            <> fname <> "'" t.b.offset)
                    end
                    let w = witnessOf(s t.group t.pos)
                    let kBound = maybe.unwrapOr(w.bound model.typeKind)
                    symbols.declareType(s.c.env.currentScope w.sym)
                    let def = maybe.unwrap(w.sym.definition)
                    vector.append(s.elems witnessExpr(t.b.offset t.b.name def maybe.some(kBound)))
                    vector.append(s.qFields option tupleTypeBinding of model.TupleComponent with
                        let name = t.b.name
                        let type = def
                        let bound = maybe.some(kBound)
                    end)
                end
            else ok
        end

    (* What an expected value field says of the component against it: its
     * type (with the witnesses so far substituted), whether it is var, and
     * its name; the type is none when there is no expected field *)
    Let ExpectedField = Tuple type: maybe.T(Type) isVar: Bool name: maybe.T(String) end

    (* A member of a let rec: the members are all declared when the first is
     * reached, so that each can refer to the others *)
    let recComponent(s: Scope r: Tuple decl: ast.Decl group: Int pos: Int end expected: ExpectedField itemOffset: Int
            ): Ok =
        begin
            let c = s.c
            let g = vector.get(s.recGroupsAst r.group)
            let last = vector.length(g.members) - 1
            if r.pos is 0 then
                vector.clear(s.groupIndices)
                if maybe.isNone(expected.type) then
                    let typed = bindings.elaborateBinding(c g.decl)
                    hashMap.insert(s.recTyped r.group typedAst.bindingMembers(typed))
                else
                    let syms = vector.new(:symbols.ValueSymbol)
                    for i = 0 upto last do vector.append(syms bindings.declareRecValue(c vector.get(g.members i))) end
                    hashMap.insert(s.recSymbols r.group syms)
                end
            end
            Let Member = Tuple value: typedAst.Expr sym: symbols.ValueSymbol end
            let member: Member =
                if maybe.isNone(expected.type) then
                    let typedMember = hashMap.find(s.recTyped r.group)[r.pos]
                    case typedMember.form
                        when bindLetValue with v then
                            begin
                                vector.append(s.qFields model.tupleField(
                                        maybe.some(v.value.name) v.value.symbol.type v.value.symbol.isVar))
                                tuple let value = v.value.value let sym = v.value.symbol end
                            end
                        else checks.unexpected("a let declaration" itemOffset)
                    end
                else
                    let recSym = vector.get(hashMap.find(s.recSymbols r.group) r.pos)
                    if expected.isVar then
                        diagnostics.fail(:Ok "Tuple field '" <> maybe.unwrapOr(expected.name "")
                            <> "' must be declared mutable (var)" itemOffset)
                    end
                    let eft = maybe.unwrap(expected.type)
                    if not(checks.isSubtype(recSym.type eft)) then
                        diagnostics.fail(:Ok "Tuple field '" <> namedDecl(r.decl).name
                            <> "' declared type '"
                            <> model.show(recSym.type)
                            <> "' is not a subtype of expected field type '"
                            <> model.show(eft) <> "'" itemOffset)
                    end
                    let typedMember = bindings.checkRecValue(c r.decl recSym)
                    tuple let value = typedMember.value let sym = recSym end
                end
            vector.append(s.groupIndices vector.length(s.elems))
            hashMap.insert(s.labels vector.length(s.elems) member.sym)
            vector.append(s.elems member.value)
            if r.pos is last then vector.append(s.recGroups vector.toArray(vector.copy(s.groupIndices))) end
        end

    (* A value component, labeled or not; the labels of the members of a
     * let ... and ... are declared after the last *)
    let valueComponent(s: Scope v: Tuple b: ast.TupleFieldBinding group: maybe.T(Int) pos: Int end
            expected: ExpectedField): Ok =
        begin
            let c = s.c
            let b = v.b
            if not(s.checking) andif maybe.isSome(v.group) andif {v.pos is 0} then
                let members = vector.get(s.simGroups maybe.unwrap(v.group))
                checks.checkDistinctNames(vector.toArray(vector.map(members namedTupleBinding)))
            end
            if maybe.isSome(b.name) then checks.checkBinder(maybe.unwrap(b.name) b.offset) end
            Let Labeled = Tuple value: typedAst.Expr name: maybe.T(String) type: Type isVar: Bool end
            let labeled: Labeled =
                if maybe.isNone(expected.type) then
                    let valTyped = synthTupleComponent(c b)
                    vector.append(s.qFields model.tupleField(b.name valTyped.type b.isVar))
                    tuple
                        let value = valTyped
                        let name = b.name
                        let type = valTyped.type
                        let isVar = b.isVar
                    end
                else
                    let eft = maybe.unwrap(expected.type)
                    let valTyped =
                        if expected.isVar then
                            if not(b.isVar) then
                                diagnostics.fail(:Ok "Tuple field '" <> maybe.unwrapOr(expected.name "")
                                    <> "' must be declared mutable (var)" b.offset)
                            end
                            let t = checker.checkExpr(c b.value eft)
                            if not(checks.isTypeEqual(t.type eft)) then
                                diagnostics.fail(:Ok "Mutable tuple field '"
                                    <> maybe.unwrapOr(expected.name "")
                                    <> "' is invariant; expected '" <> model.show(eft) <> "', got '"
                                    <> model.show(t.type) <> "'" b.offset)
                            end
                            t
                        elsif maybe.isSome(b.typeAnnot) then
                            let annotType = elaborateTypes.elaborateType(maybe.unwrap(b.typeAnnot) c.env)
                            if not(checks.isSubtype(annotType eft)) then
                                diagnostics.fail(:Ok "Tuple field '" <> nameOf(b.name)
                                    <> "' declared type '"
                                    <> model.show(annotType)
                                    <> "' is not a subtype of expected field type '"
                                    <> model.show(eft) <> "'" b.offset)
                            end
                            checker.checkExpr(c b.value annotType)
                        else
                            checker.checkExpr(c b.value eft)
                        end
                    tuple
                        let value = valTyped
                        let name = expected.name
                        let type = eft
                        let isVar = expected.isVar
                    end
                end
            let elementIndex = vector.length(s.elems)
            vector.append(s.elems labeled.value)
            if maybe.isSome(v.group) then
                let members = vector.get(s.simGroups maybe.unwrap(v.group))
                if v.pos is 0 then vector.clear(s.groupIndices) end
                vector.append(s.groupIndices elementIndex)
                if maybe.isSome(labeled.name) then
                    let label =
                        if s.checking then
                            maybe.some(newLabel(c maybe.unwrap(labeled.name) labeled.type labeled.isVar))
                        else
                            maybe.none(:symbols.ValueSymbol)
                        end
                    vector.append(s.pendingLabels tuple
                        let index = elementIndex
                        let name = maybe.unwrap(labeled.name)
                        let type = labeled.type
                        let isVar = labeled.isVar
                        let label = label
                    end)
                end
                if v.pos is {vector.length(members) - 1} then
                    vector.append(s.simultaneousGroups vector.toArray(vector.copy(s.groupIndices)))
                    for i = 0 upto {vector.length(s.pendingLabels) - 1} do
                        let p = vector.get(s.pendingLabels i)
                        let label =
                            if maybe.isSome(p.label) then
                                maybe.unwrap(p.label)
                            else
                                newLabel(c p.name p.type p.isVar)
                            end
                        hashMap.insert(s.labels p.index symbols.declareValue(c.env.currentScope label))
                    end
                    vector.clear(s.pendingLabels)
                end
            elsif maybe.isSome(labeled.name) then
                hashMap.insert(s.labels elementIndex symbols.declareValue(
                        c.env.currentScope
                        newLabel(c maybe.unwrap(labeled.name) labeled.type labeled.isVar)))
                ok
            end
        end

    (* A value component (a member of a let rec, or a value): its expected
     * field, if any, whose name must be the component's *)
    let valueOrRecComponent(s: Scope item: Item expF: maybe.T(model.TupleComponent) itemOffset: Int): Ok =
        begin
            let expFieldType =
                if maybe.isSome(expF) then
                    case maybe.unwrap(expF)
                        when tupleField with f then
                            begin
                                let bname =
                                    case item
                                        when recItem with r then maybe.some(namedDecl(r.decl).name)
                                        when valItem with v then v.b.name
                                        else maybe.none(:String)
                                    end
                                if maybe.isSome(f.name) andif maybe.isSome(bname)
                                        andif not(stringOp.equal(maybe.unwrap(f.name) maybe.unwrap(bname))) then
                                    diagnostics.fail(:Ok "Tuple field name mismatch: expected '"
                                        <> maybe.unwrap(f.name) <> "', got '" <> maybe.unwrap(bname) <> "'"
                                            itemOffset)
                                end
                                maybe.some(model.substitute(f.type s.witnessSubst))
                            end
                        else maybe.none(:Type)
                    end
                else
                    maybe.none(:Type)
                end
            let expected: ExpectedField = tuple
                let type = expFieldType
                let isVar =
                    if maybe.isSome(expF) then
                        case maybe.unwrap(expF) when tupleField with f then f.isVar else false end
                    else
                        false
                    end
                let name =
                    if maybe.isSome(expF) then
                        case maybe.unwrap(expF) when tupleField with f then f.name else maybe.none(:String) end
                    else
                        maybe.none(:String)
                    end
            end
            case item
                when recItem with r then recComponent(s r expected itemOffset)
                when valItem with v then valueComponent(s v expected)
                else ok
            end
        end

    (* Runs steps 2 and 3 of elaborateTupleComponents in the tuple's scope,
     * elaborating step 1's flattened items in order and returning the typed
     * tuple. The typeGroups, recGroupsAst, simGroups, and kindsBefore
     * collections also come from step 1. In checking mode, expectedTuple holds
     * the expected type's components, which items match one for one, and the
     * tuple gets expectedTupleType. In synthesis mode, both are none, and the
     * tuple's type is built from its components (each type component becomes a
     * manifest binding, Let A = T). Raises diagnostics.compilerError on a
     * mismatch. *)
    let tupleScope(
            c: checker.T x0: ast.Expr items: vector.T(Item) typeGroups: vector.T(TypeGroup)
            recGroupsAst: vector.T(RecGroup)
            simGroups: vector.T(vector.T(ast.TupleFieldBinding)) kindsBefore: maps.IntMap(vector.T(KindDecl))
            expectedTuple: maybe.T(Array(model.TupleComponent)) expectedTupleType: maybe.T(Type)
            ): typedAst.Expr =
        begin
            let expFields = maybe.unwrapOr(expectedTuple array of :model.TupleComponent end)
            let n = vector.length(items)
            let s: Scope = tuple
                let c = c
                let items = items
                let typeGroups = typeGroups
                let recGroupsAst = recGroupsAst
                let simGroups = simGroups
                let kindsBefore = kindsBefore
                let checking = maybe.isSome(expectedTuple)
                let witnessSubst = model.newSubst()
                let elems = vector.new(:typedAst.Expr)
                let qFields = vector.new(:model.TupleComponent)
                let witnesses = maps.newIntMap(:Array(elaborateTypes.TupleTypeBinding))
                let recSymbols = maps.newIntMap(:vector.T(symbols.ValueSymbol))
                let recTyped = maps.newIntMap(:Array(typedAst.Binding))
                let recGroups = vector.new(:Array(Int))
                let simultaneousGroups = vector.new(:Array(Int))
                let pendingLabels = vector.new(:PendingLabel)
                let labels = maps.newIntMap(:symbols.ValueSymbol)
                let groupIndices = vector.new(:Int)
            end

            (* 2. Elaborate the components in order, in a scope of their own,
             *    so that each type component and each label (a value
             *    component's name) is in scope for the components after it.
             *    Each component falls into one of four cases, chosen by what
             *    the expected type says of it (a type formal, a type
             *    binding) or what it is (a type component, synthesizing; a
             *    value). *)
            for index = 0 upto {n - 1} do
                declareKinds(s index)
                let item = vector.get(items index)
                let expF = if s.checking then maybe.some(expFields[index]) else maybe.none(:model.TupleComponent) end
                let itemOffset =
                    case item
                        when typeItem with t then t.b.offset
                        when recItem with r then r.decl.span.startOffset
                        when valItem with v then v.b.offset
                    end
                if maybe.isSome(expF) andif maybe.unwrap(expF)?tupleTypeFormal then
                    formalComponent(s item maybe.unwrap(expF) itemOffset)
                elsif maybe.isSome(expF) andif maybe.unwrap(expF)?tupleTypeBinding then
                    bindingComponent(s item maybe.unwrap(expF) itemOffset)
                elsif item?typeItem then
                    typeComponent(s item expF)
                else
                    valueOrRecComponent(s item expF itemOffset)
                end
            end
            (* Trailing manifest kinds name nothing, but are still checked *)
            declareKinds(s n)

            let elements = vector.toArray(s.elems)
            let labelArray = vector.new(:maybe.T(symbols.ValueSymbol))
            for i = 0 upto {extent elements - 1} do
                vector.append(labelArray hashMap.get(s.labels i))
            end
            (* 3. Checking, the tuple has the expected type; synthesizing, the
             *    type made of its components' types *)
            let tupleType =
                if maybe.isSome(expectedTupleType) then
                    maybe.unwrap(expectedTupleType)
                else
                    model.tupleType(vector.toArray(s.qFields))
                end
            typedAst.expr(x0.span.startOffset tupleType option exprTuple of typedAst.ExprForm with
                let elements = elements
                let recGroups = vector.toArray(s.recGroups)
                let simultaneousGroups = vector.toArray(s.simultaneousGroups)
                let labels = vector.toArray(labelArray)
            end)
        end
    let elaborateTupleComponents(
            c: checker.T x0: ast.Expr components: vector.T(ast.TupleField)
            expectedTuple: maybe.T(Array(model.TupleComponent))
            expectedTupleType: maybe.T(Type)
            ): typedAst.Expr =
        begin
            let checking = maybe.isSome(expectedTuple)
            (* 1. Flatten the components. A group (let ... and ..., or a group
             *    of type bindings) contributes each of its members, so that
             *    items[i] lines up with the expected type's i-th field; the
             *    groups (typeGroups, recGroupsAst, simGroups) remember the
             *    group each member came from, since a group's members are
             *    declared together. Then the count is checked.
             *
             * The manifest kinds declared just before a component are kept in
             * kindsBefore, under the index of the component that follows them.
             * Against an expected type, the names in groups are checked here,
             * before the arity; synthesized, as each group is reached. *)
            let items = vector.new(:Item)
            let typeGroups = vector.new(:TypeGroup)
            let recGroupsAst = vector.new(:RecGroup)
            let simGroups = vector.new(:vector.T(ast.TupleFieldBinding))
            let kindsBefore = maps.newIntMap(:vector.T(KindDecl))
            let addKind(k: KindDecl): Ok =
                begin
                    let index = vector.length(items)
                    if not(hashMap.contains(kindsBefore index)) then
                        hashMap.insert(kindsBefore index vector.new(:KindDecl))
                    end
                    vector.append(hashMap.find(kindsBefore index) k)
                end
            let addTypes(members: vector.T(ast.TypeBinding) isGroup: Bool): Ok =
                begin
                    let ms = if checking then elaborateTypes.tupleTypeBindingMembers(members isGroup) else members end
                    let group = vector.length(typeGroups)
                    vector.append(typeGroups tuple let members = ms let isGroup = isGroup end)
                    for i = 0 upto {vector.length(ms) - 1} do
                        vector.append(items option typeItem of Item with
                            let b = vector.get(ms i)
                            let group = group
                            let pos = i
                        end)
                    end
                end
            let addRec(d: ast.Decl): Ok =
                begin
                    let members = bindings.valueMembers(d)
                    if checking then
                        checks.checkDistinctNames(vector.toArray(vector.map(members namedDecl)))
                    end
                    let group = vector.length(recGroupsAst)
                    vector.append(recGroupsAst tuple let decl = d let members = members end)
                    for i = 0 upto {vector.length(members) - 1} do
                        vector.append(items option recItem of Item with
                            let decl = vector.get(members i)
                            let group = group
                            let pos = i
                        end)
                    end
                end
            for i = 0 upto {vector.length(components) - 1} do
                case vector.get(components i)
                    when fieldVal with v then
                        vector.append(items option valItem of Item with
                            let b = v.val
                            let group = maybe.none(:Int)
                            let pos = 0
                        end)
                    when fieldGroup with g then
                        begin
                            if checking then
                                checks.checkDistinctNames(vector.toArray(vector.map(g.val namedTupleBinding)))
                            end
                            let group = vector.length(simGroups)
                            vector.append(simGroups g.val)
                            for j = 0 upto {vector.length(g.val) - 1} do
                                vector.append(items option valItem of Item with
                                    let b = vector.get(g.val j)
                                    let group = maybe.some(group)
                                    let pos = j
                                end)
                            end
                        end
                    when fieldDecl with d then
                        case d.val.form
                            when declDefKind with k then addKind(tuple let name = k.name let kindVal = k.kindVal end)
                            when declTypeBinding then
                                addTypes(vector.fromArray(array of bindings.typeBindingOf(d.val) end) false)
                            when declTypeBindingGroup with g then
                                addTypes(vector.map(g.bindings bindings.typeBindingOf) true)
                            when declLetVal then addRec(d.val)
                            when declLetValGroup then addRec(d.val)
                            else
                                (* Phrases a tuple cannot hold, rejected before
                                 * the arity is checked *)
                                diagnostics.fail(:Ok "Unsupported tuple component: " <> declClassName(d.val)
                                        d.val.span.startOffset)
                        end
                end
            end
            let n = vector.length(items)
            let expFields = maybe.unwrapOr(expectedTuple array of :model.TupleComponent end)
            if checking andif {n isnot extent expFields} then
                diagnostics.fail(:Ok "Tuple arity mismatch: expected " <> conv.int(extent expFields)
                    <> " components, got "
                    <> conv.int(n) x0.span.startOffset)
            end
            env.localScoped(c.env if checking then
                "tuple_check"
            else
                "tuple_synth"
            end fun(s: symbols.Scope): typedAst.Expr
                tupleScope(c x0 items typeGroups recGroupsAst simGroups kindsBefore expectedTuple expectedTupleType))
        end
    (* Each member of a group is a component of its own, and a manifest kind is
     * not a component: it names a kind for the components after it. Components
     * are elaborated in order, and each value component's label is declared for
     * the ones after it; a simultaneous declaration's labels are declared after
     * its last member, and a recursive declaration's members before any of
     * their values. Against an expected tuple type, the components must match
     * its fields one for one. *)
    let elaborateTuple(c: checker.T x0: ast.Expr expected: maybe.T(Type)): typedAst.Expr =
        case x0.form
            when exprTuple with x then
                begin
                    let var expectedTuple = maybe.none(:Array(model.TupleComponent))
                    let var expectedTupleType = maybe.none(:Type)
                    let var early = maybe.none(:typedAst.Expr)
                    if maybe.isSome(expected) then
                        let expectedLazy = checks.evaluate(maybe.unwrap(expected))
                        case expectedLazy.form
                            when typeTuple with t then
                                expectedTuple := maybe.some(t.fields)
                                expectedTupleType := maybe.some(expectedLazy)
                            else
                                early :=
                                        maybe.some(checker.checkSubsumption(c x0 maybe.unwrap(expected)
                                                maybe.some("Tuple")))
                        end
                    end
                    if maybe.isSome(early) then
                        maybe.unwrap(early)
                    else
                        elaborateTupleComponents(c x0 x.fields expectedTuple expectedTupleType)
                    end
                end
            else checks.unexpected("a tuple" x0.span.startOffset)
        end
end
