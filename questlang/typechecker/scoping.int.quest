(* Quest Self-Hosted Compiler: Well-Scopedness Check Interface
 *
 * This interface verifies that a typed program is well scoped (matching
 * bootstrap/python/quest/typechecker/scoping.py): every locally bound variable
 * (a parameter, a block's let, a for variable, or a case, try, or inspect
 * binder) is used only within its binder's scope, a polymorphic function's
 * type parameter ids match the quantifiers of its own type, and any type
 * mentioning a function's type parameter occurs only inside that function.
 * Symbols, not names, identify binders, so this check catches mismatches that
 * printed variable names hide. It runs after type checking when
 * QUEST_CHECK_SCOPES=1, which the test runners set. *)

interface Scoping
import
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
export
    (* Whether QUEST_CHECK_SCOPES is 1 *)
    scopeChecksEnabled(): Bool
    (* The scoping problems of a typed program (none when it is well scoped) *)
    checkWellScoped(p: typedAst.Program): Array(String)
end
