(* Quest Self-Hosted Compiler: Well-Scopedness Check Interface
 *
 * The check of bootstrap/python/quest/typechecker/scoping.py that a typed program is well scoped: every variable bound
 * locally (a parameter, a block's let, a for variable, a case, try, or inspect binder) is used only within its
 * binder's scope, a polymorphic function's type parameter ids are the quantifiers of its own type, and a type
 * mentioning a function's type parameter occurs only inside that function. Symbols, not names, identify binders, so
 * this finds what the typed AST does not show. It runs after type checking when QUEST_CHECK_SCOPES=1, which the test
 * runners set. *)

interface Scoping
import
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
export
    scopeChecksEnabled(): Bool
    (* The scoping problems of a typed program (none when it is well scoped) *)
    checkWellScoped(p: typedAst.Program): Array(String)
end
