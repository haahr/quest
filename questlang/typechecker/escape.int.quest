(* Quest Self-Hosted Compiler: Path-Type Escape Analysis and Closedness
 * Interface
 *
 * The checks of bootstrap/python/quest/typechecker/escape.py: that abstract
 * path types rooted at local variables do not escape their scope, and that
 * types used at run time do not mention package values' abstract types.
 *
 * A path type x.A names the hidden type component A of a value x (a
 * package). It means something only where x is in scope: the result of
 * let f(p: Pkg) = p.origin would have type p.Point outside f, where no p
 * exists, so such a type is rejected where it would leave the scope of its
 * root (docs/type-system.md §4.5). And x.A has no identity at run time,
 * since what it hides is known only to the code that made x, so it cannot be
 * the type of a dynamic value or of an inspect branch (the section Dynamic
 * Typing and Narrowing, under Types at run time). *)

interface Escape
import
    questlang/types/model : questlang/types/Model
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    collections/hashMap : collections/HashMap
    util/maybe : util/Maybe
export
    (* The auto type of an inspect target *)
    inspectedAutoType(target: typedAst.Expr e: env.T): maybe.T(model.Type)
    (* Whether t, stripped of aliases, is an auto type *)
    isAutoType(t: model.Type): Bool

    (* Checks with check (the closedness check) the type argument of a function
     * shaped like dynamic.new (A::TYPE a:A): T or dynamic.be (A::TYPE d:T): A
     * for an auto type T *)
    checkDynamicTypeArgs(
        allType: model.Type typeArgs: Array(model.Type) offset: Int check: All(t: model.Type what: String offset: Int) Ok
    ): Ok

    (* Rejects a type that mentions an abstract type projected from a package
     * value (t.A) *)
    checkNoPackageTypes(t: model.Type what: String offset: Int): Ok

    (* Rejects an abstract path type rooted at one of the local symbols (a set:
     * the map's keys) in t *)
    checkNoEscapingPathTypes(t: model.Type localSymbolIds: hashMap.T(Int Bool) contextDesc: String offset: Int): Ok
end
