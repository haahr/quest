(* Quest Self-Hosted Compiler: Path-Type Escape Analysis and Closedness Interface
 *
 * The checks of bootstrap/python/quest/typechecker/escape.py: that abstract path types rooted at local variables do
 * not escape their scope, and that types used at run time do not mention package values' abstract types. *)

interface Escape
import
    questlang/types/model : questlang/types/Model
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    collections/hashMap : collections/HashMap
    util/maybe : util/Maybe
export
    (* The auto type of an inspect target *)
    inspectedAutoType(target: typedAst.Expr e: env.T): maybe.T(model.Type)
    (* Whether t, stripped of aliases, is an auto type *)
    isAutoType(t: model.Type): Bool

    (* Checks with check (the closedness check) the type argument of a function shaped like dynamic.new
     * (A::TYPE a:A): T or dynamic.be (A::TYPE d:T): A for an auto type T *)
    checkDynamicTypeArgs(
        allType: model.Type typeArgs: Array(model.Type) offset: Int check: All(t: model.Type what: String offset: Int) Ok
    ): Ok

    (* Rejects a type that mentions an abstract type projected from a package value (t.A) *)
    checkNoPackageTypes(t: model.Type what: String offset: Int): Ok

    (* Rejects an abstract path type rooted at one of the local symbols (a set: the map's keys) in t *)
    checkNoEscapingPathTypes(t: model.Type localSymbolIds: hashMap.T(Int Bool) contextDesc: String offset: Int): Ok
end
