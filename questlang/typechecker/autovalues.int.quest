(* Quest Self-Hosted Compiler: Auto Values Interface
 *
 * This interface provides type-checking for auto values (Cardelli's dynamic
 * types, The Quest Language and System section 4.6), inspect expressions, and
 * the closedness check on types used at run time, matching
 * bootstrap/python/quest/typechecker/auto_values.py. Each elaboration function
 * takes an expression of its form. See docs/type-system.md §6.12 for the
 * rules. *)

interface AutoValues
import
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/types/model : questlang/types/Model
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/typechecker/checker : questlang/typechecker/Checker
    util/maybe : util/Maybe
export
    (* Elaborates an inspect expression on an auto value, checking its branches
     * against expected if one is given and joining their types otherwise *)
    elaborateInspect(c: checker.T expr: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr
    (* Checks a type that is used at run time: it may not mention a package
     * value's abstract type *)
    checkClosedType(t: model.Type what: String offset: Int): Ok
    (* Elaborates an auto value (auto [let A [HasKind] =] :W with Binding end),
     * which requires an expected Auto type *)
    elaborateAuto(c: checker.T expr: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr

    (* Checks with check (the closedness check) the type argument of a function
     * shaped like dynamic.new (A::TYPE a:A): T or dynamic.be (A::TYPE d:T): A
     * for an auto type T *)
    checkDynamicTypeArgs(
        allType: model.Type typeArgs: Array(model.Type) offset: Int check: All(t: model.Type what: String offset: Int) Ok
    ): Ok
end
