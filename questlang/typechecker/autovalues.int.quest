(* Quest Self-Hosted Compiler: Auto Values Interface
 *
 * The construct family of bootstrap/python/quest/typechecker/auto_values.py: auto values (Cardelli's dynamic types,
 * The Quest Language and System section 4.6), inspect, and the closedness check on types used at run time. Each
 * elaboration takes an expression of its form. *)

interface AutoValues
import
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/types/model : questlang/types/Model
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/typechecker/checker : questlang/typechecker/Checker
    util/maybe : util/Maybe
export
    (* inspect on an auto value: its branches are checked against the expected type if there is one, else joined *)
    elaborateInspect(c: checker.T expr: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr
    (* Checks a type that is used at run time: it may not mention a package value's abstract type *)
    checkClosedType(t: model.Type what: String offset: Int): Ok
    (* auto [let A [HasKind] =] :W with Binding end, against an expected Auto type, which it needs *)
    elaborateAuto(c: checker.T expr: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr
end
