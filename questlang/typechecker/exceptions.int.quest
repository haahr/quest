(* Quest Self-Hosted Compiler: Exceptions Interface
 *
 * This interface elaborates exception declarations, raise, and try expressions,
 * mirroring bootstrap/python/quest/typechecker/exceptions.py. Each function
 * expects an expression of its corresponding form. *)

interface Exceptions
import
    util/maybe : util/Maybe

    questlang/syntax/ast : questlang/syntax/AST
    questlang/typechecker/checker : questlang/typechecker/Checker
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
    questlang/types/model : questlang/types/Model
export
    (* exception Name [: PayloadType] end, which declares Name in the current
     * scope *)
    synthException(c: checker.T expr: ast.Expr declares: Bool): typedAst.Expr
    (* raise Exc [with Payload] [as Type] end: it diverges, so it has any
     * expected type *)
    elaborateRaise(c: checker.T expr: ast.Expr expected: maybe.T(model.Type)): typedAst.Expr
    (* try: its body and branches are checked against the expected type if there
     * is one, else joined *)
    elaborateTry(c: checker.T expr: ast.Expr expected: maybe.T(model.Type)): typedAst.Expr
end
