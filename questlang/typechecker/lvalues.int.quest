(* Quest Self-Hosted Compiler: L-Value and Reference Parameter Validation
 * Interface
 *
 * The check of bootstrap/python/quest/typechecker/lvalues.py on the destination
 * of a var or out argument: @x, @r.f, @a[i], or var(e), the location a
 * reference parameter reads and writes. Var(T) is invariant, since the
 * callee both reads and writes T there; Out(T) only writes, so any location
 * holding a supertype of T will do (docs/type-system.md §6.2.2, §6.5). *)

interface Lvalues
import
    questlang/types/model : questlang/types/Model
    questlang/types/env : questlang/types/Env
export
    (* The destination's type, unwrapped of a reference cell: exactly paramType
     * for a var parameter (invariance), and a supertype of it for an out
     * parameter (covariance) *)
    checkLvalueModeType(
        paramType: model.Type destRawType: model.Type isOut: Bool targetDesc: String offset: Int e: env.T
    ): model.Type
end
