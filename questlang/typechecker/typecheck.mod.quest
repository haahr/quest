(* Quest Self-Hosted Compiler: Bidirectional Type Checker Implementation
 *
 * The type checker elaborates a parsed syntax tree into a typed AST, or
 * reports the type errors it finds.
 *
 * Elaborating means more than checking: the checker builds a new tree in which
 * what the source leaves implicit is explicit. Every expression carries its
 * type. Every variable carries its symbol, the record of the declaration it
 * refers to: names can be shadowed, so two variables with one name may be
 * different variables, and lowering identifies them by symbol. Reading a
 * mutable variable becomes an explicit dereference, and a call of a
 * polymorphic function gets its type arguments, written or inferred. Given
 *
 *     let var n = 1
 *     let id(A::TYPE x: A): A = x
 *     id(n + 1)
 *
 * the call elaborates to (as `./questc --stop-after typecheck` prints it)
 *
 *     (TypedApp :type Int
 *       :func (TypedTypeApp [Int] :type Fun(x: Int): Int
 *         :func (TypedVar 'id' :type All(A :: TYPE) Fun(x: A): A))
 *       :args (
 *         (TypedInfix '+' :type Int
 *           :left (TypedDerefCell :type Int
 *             :target (TypedVar 'n' :type Var(Int)))
 *           :right (TypedInt 1 :type Int))
 *       ))
 *
 * The tree has two readers: the interpreter, which evaluates it, and
 * lowering, which translates it into the compiler's intermediate
 * representation, from which C is printed. Neither looks at the syntax again
 * or checks types, so whatever they need to know about types, the checker
 * must write into the tree. docs/walkthrough.md section 6 follows one program
 * through this phase.
 *
 * Checking is bidirectional (docs/type-system.md section 6.1). checkExpr(c x
 * T ...) requires x to have type T and pushes T down into x, so that context
 * can supply what x leaves unwritten, such as the type argument of list.nil()
 * when it is checked against list.T(Int). synthExpr works out x's type from x
 * alone, bottom up. Most forms are synthesized even when checked, and then
 * accepted by subsumption: a value of a subtype of T is accepted where T is
 * expected (checker.checkSubsumption). The forms that an expected type can
 * inform each have one function, elaborateX in the module of its family of
 * constructs (control.elaborateIf, aggregates.elaborateTuple, ...), which
 * checkExpr calls with the expected type and synthExpr with none. The families
 * (bindings, application, aggregates, control, exceptions, autoValues) reach
 * checkExpr and synthExpr through the hooks of checker.T, which this module
 * fills when it makes a checker.
 *
 * The checker's state is its env.T, holding a stack of scopes, each holding
 * the symbols declared in it. Bindings are declared into the current scope as
 * they are elaborated, so elaboration order is scoping order. A checker.T
 * lives for one program, but the environment persists across a program's
 * phrases (and, in the REPL, across the phrases typed). Alongside it, two
 * counters in checker.T track how many loops and functions enclose the code
 * being checked, so that exit and closures that capture mutable variables
 * can be checked.
 *
 * Things to know when changing or debugging it:
 *
 * - Types are immutable and shared (types/model). Compare types with
 *   subtyping.isSubtype and subtyping.isTypeEqual, not model.same: equal
 *   types may be distinct nodes (an alias and its target, a recursive type
 *   and its unfolding). A type may be an alias or a recursive type, so call
 *   model.evaluateLazily to expose its outermost constructor before casing on
 *   its form; that holds for readers of the typed AST too.
 * - Subsumption leaves no trace in the tree. An expression accepted where T
 *   is expected keeps its own type, so a node's type may be more specific than
 *   its context requires; only a construct that propagated T into its parts
 *   has type T. Changes of representation that subsumption implies are
 *   inserted much later, in the IR.
 * - Errors are raised with diagnostics.fail at the offending syntax's offset.
 *   An error ends the elaboration of the phrase it is in; elaborateProgram
 *   records it and goes on with the next phrase, until 20 errors or a fatal
 *   one (docs/milestone-2.md section 2). A broken internal invariant is an
 *   error whose message starts "internal:". *)

module typecheck : Typecheck
import
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/typechecker/checker : questlang/typechecker/Checker
    questlang/typechecker/checks : questlang/typechecker/Checks
    questlang/typechecker/bindings : questlang/typechecker/Bindings
    questlang/typechecker/application : questlang/typechecker/Application
    questlang/typechecker/aggregates : questlang/typechecker/Aggregates
    questlang/typechecker/control : questlang/typechecker/Control
    questlang/typechecker/exceptions : questlang/typechecker/Exceptions
    questlang/typechecker/autoValues : questlang/typechecker/AutoValues
    questlang/typechecker/scoping : questlang/typechecker/Scoping
    questlang/modules/elaboration : questlang/modules/Elaboration
    questlang/modules/loader : questlang/modules/Loader
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    stringOp = string : StringOp
export
    Let Type = model.Type
    Let Result = Tuple program: maybe.T(typedAst.Program) errors: Array(diagnostics.CompilerError) end

    let expr(offset: Int t: Type form: typedAst.ExprForm): typedAst.Expr = typedAst.expr(offset t form)

    let rec checkExpr(c: checker.T x0: ast.Expr expected: Type e: env.T loopDepth: Int): typedAst.Expr =
        begin
            let exp = maybe.some(:Type expected)
            case x0.form
                (* Conditionals with an else branch: both branches are checked
                 * against the expected type (a short-circuit operator is Bool,
                 * and is checked by subsumption) *)
                when exprIf with x then
                    if maybe.isSome(:ast.Expr x.elseBranch) andif not(x.shortCircuit) then
                        control.elaborateIf(c x0 exp e loopDepth)
                    else
                        checker.checkSubsumption(c x0 expected e loopDepth maybe.none(:String))
                    end
                when exprBlock then control.elaborateBlock(c x0 exp e loopDepth)
                when exprFun then bindings.elaborateFun(c x0 exp e loopDepth)
                when exprRecord then aggregates.elaborateRecord(c x0 exp e loopDepth)
                when exprTuple then aggregates.elaborateTuple(c x0 exp e loopDepth)
                when exprCase then control.elaborateCase(c x0 exp e loopDepth)
                when exprArray then aggregates.elaborateArray(c x0 exp e loopDepth)
                when exprArrayRep then aggregates.elaborateArrayRep(c x0 exp e loopDepth)
                when exprRaise then exceptions.elaborateRaise(c x0 exp e loopDepth)
                when exprTry then exceptions.elaborateTry(c x0 exp e loopDepth)
                when exprInspect then autoValues.elaborateInspect(c x0 exp e loopDepth)
                when exprAuto then autoValues.elaborateAuto(c x0 exp e loopDepth)
                (* An external C symbol's binding *)
                when exprExternal with x then
                    expr(x0.span.startOffset expected option exprExternal of typedAst.ExprForm with let symbol = x.symbol end)
                (* An application: the type required by the context can
                 * determine implicit type arguments (Cardelli, The Quest
                 * Language and System section 4: cons(3 nil())) *)
                when exprApp then
                    checks.requireSubtype(x0.span.startOffset application.elaborateApp(c x0 exp e loopDepth) expected e
                        maybe.none(:String))
                (* Subsumption: the minimal type is synthesized and must be a
                 * subtype *)
                else checker.checkSubsumption(c x0 expected e loopDepth maybe.none(:String))
            end
        end

    (* Synthesizes the type of x0 from x0 alone, bottom up, and returns its
     * elaborated node (Gamma |- e => T).
     *
     * The type synthesized is the most specific one the checker can
     * determine, which subsumption may then widen. The cases fall into two
     * groups. A form that checkExpr also handles delegates to its elaborateX
     * function with no expected type, so that each construct has one
     * elaboration whichever mode reaches it. Every other form is synthesized
     * only: the simplest inline here, the rest by synthX functions in the
     * families' modules. Variables show what inline elaboration involves: the
     * name is looked up in e to find its symbol, and a mutable variable, which
     * in a value position stands for its contents, is wrapped in an explicit
     * dereference.
     *
     * isCallee is true only for the function of a call. The monadic operators
     * not, extent, and ordinal are names that may be called but are not
     * values, so anywhere else they are rejected.
     *
     * A form with no case here falls to the last one, which reports it as
     * unsupported. A new expression form needs a case here, and one in
     * checkExpr too if an expected type should flow into it; a typed node in
     * typedAst, with its dump (typedAstPrint); and its evaluation
     * (interpreter/treewalk) and lowering (ir/lower), since those read only
     * the typed AST. *)
    and synthExpr(c: checker.T x0: ast.Expr e: env.T loopDepth: Int isCallee: Bool): typedAst.Expr =
        begin
            let offset = x0.span.startOffset
            let none = maybe.none(:Type)
            case x0.form
                (* Literals *)
                when exprInt with x then expr(offset model.intType option exprInt of typedAst.ExprForm with let value = x.value end)
                when exprReal with x then
                    expr(offset model.realType option exprReal of typedAst.ExprForm with let value = x.value end)
                when exprBool with x then
                    expr(offset model.boolType option exprBool of typedAst.ExprForm with let value = x.value end)
                when exprChar with x then
                    expr(offset model.charType option exprChar of typedAst.ExprForm with let value = x.value end)
                when exprString with x then
                    expr(offset model.stringType option exprString of typedAst.ExprForm with let value = x.value end)
                when exprOk then expr(offset model.okType option exprOk of typedAst.ExprForm end)
                when exprExit then
                    begin
                        if loopDepth <= 0 then diagnostics.fail(:Ok "Exit statement outside of any loop" offset) end
                        expr(offset model.okType option exprExit of typedAst.ExprForm end)
                    end
                when exprExternal with x then
                    diagnostics.fail(:typedAst.Expr "External binding '" <> x.symbol <> "' requires an explicit type annotation"
                        offset)

                (* Variables *)
                when exprId with x then
                    begin
                        let name = x.name
                        if not(isCallee) andif {stringOp.equal(name "not") orif stringOp.equal(name "extent") orif
                                stringOp.equal(name "ordinal")} then
                            diagnostics.fail(:Ok "Monadic operator '" <> name <> "' cannot be used as a value without an operand"
                                offset)
                        end
                        let found = checker.lookupValue(c e name)
                        if maybe.isNone(:symbols.ValueSymbol found) then
                            diagnostics.fail(:Ok "Undefined variable '" <> name <> "'" offset)
                        end
                        let sym = maybe.unwrap(:symbols.ValueSymbol found)
                        (* Closures may not capture out or var parameters or
                         * mutable local variables *)
                        checker.checkCapturable(c sym offset)
                        (* Out parameters are write-only *)
                        if sym.isOut then
                            diagnostics.fail(:Ok "Cannot read from write-only 'out' parameter '" <> sym.name <> "'" offset)
                        end
                        let varForm = option exprVar of typedAst.ExprForm with let name = sym.name let symbol = sym end
                        (* A mutable variable in a value position is
                         * dereferenced *)
                        if sym.isVar then
                            let varNode = expr(offset model.varType(sym.type) varForm)
                            expr(offset sym.type option exprDerefCell of typedAst.ExprForm with let target = varNode end)
                        else
                            expr(offset sym.type varForm)
                        end
                    end

                (* Explicit dereference (@e or !e) *)
                when exprDerefCell with x then
                    case x.target.form
                        when exprId with id then
                            begin
                                let targetOffset = x.target.span.startOffset
                                let found = checker.lookupValue(c e id.name)
                                if maybe.isNone(:symbols.ValueSymbol found) then
                                    diagnostics.fail(:Ok "Undefined variable '" <> id.name <> "'" targetOffset)
                                end
                                let sym = maybe.unwrap(:symbols.ValueSymbol found)
                                let element = case sym.type.form when typeVar with v then maybe.some(:Type v.element) else none end
                                if not(sym.isVar) andif maybe.isNone(:Type element) then
                                    diagnostics.fail(:Ok "Cannot dereference non-variable symbol '" <> id.name <> "'" targetOffset)
                                end
                                let varType = if sym.isVar then model.varType(sym.type) else sym.type end
                                let elemType = if sym.isVar then sym.type else maybe.unwrap(:Type element) end
                                let varNode = expr(targetOffset varType option exprVar of typedAst.ExprForm with
                                    let name = sym.name let symbol = sym
                                end)
                                expr(offset elemType option exprDerefCell of typedAst.ExprForm with let target = varNode end)
                            end
                        else
                            begin
                                let targetTyped = synthExpr(c x.target e loopDepth false)
                                case targetTyped.type.form
                                    when typeVar with v then
                                        expr(offset v.element option exprDerefCell of typedAst.ExprForm with
                                            let target = targetTyped
                                        end)
                                    else
                                        diagnostics.fail(:typedAst.Expr "Cannot dereference non-variable type '" <>
                                            model.show(targetTyped.type) <> "'" offset)
                                end
                            end
                    end

                (* Reference cell allocation (var e) *)
                when exprVarCell with x then
                    begin
                        let valTyped = synthExpr(c x.value e loopDepth false)
                        expr(offset model.varType(valTyped.type) option exprVarCell of typedAst.ExprForm with
                            let value = valTyped
                        end)
                    end

                when exprInfix then control.synthInfix(c x0 e loopDepth)
                when exprIf then control.elaborateIf(c x0 none e loopDepth)

                (* Loops *)
                when exprWhile with x then
                    begin
                        let condTyped = checkExpr(c x.cond model.boolType e loopDepth)
                        c.loopDepth := loopDepth
                        let bodyTyped = checker.inLoop(:typedAst.Expr c fun(): typedAst.Expr
                            synthExpr(c x.body e c.loopDepth false))
                        expr(offset model.okType option exprWhile of typedAst.ExprForm with
                            let cond = condTyped let body = bodyTyped
                        end)
                    end
                when exprLoop with x then
                    begin
                        c.loopDepth := loopDepth
                        let bodyTyped = checker.inLoop(:typedAst.Expr c fun(): typedAst.Expr
                            synthExpr(c x.body e c.loopDepth false))
                        expr(offset model.okType option exprLoop of typedAst.ExprForm with let body = bodyTyped end)
                    end
                when exprFor then control.synthFor(c x0 e loopDepth)

                when exprBlock then control.elaborateBlock(c x0 none e loopDepth)
                when exprFun then bindings.elaborateFun(c x0 none e loopDepth)
                when exprApp then application.elaborateApp(c x0 none e loopDepth)

                (* Aggregates *)
                when exprRecord then aggregates.elaborateRecord(c x0 none e loopDepth)
                when exprTuple then aggregates.elaborateTuple(c x0 none e loopDepth)
                when exprSelect then aggregates.synthSelect(c x0 e loopDepth)
                when exprOption then aggregates.synthOption(c x0 e loopDepth)
                when exprVariant then aggregates.synthVariant(c x0 e loopDepth)
                when exprVariantCheck then aggregates.synthVariantCheck(c x0 e loopDepth)
                when exprVariantAssert then aggregates.synthVariantAssert(c x0 e loopDepth)
                when exprCase then control.elaborateCase(c x0 none e loopDepth)
                when exprArray then aggregates.elaborateArray(c x0 none e loopDepth)
                when exprArrayRep then aggregates.elaborateArrayRep(c x0 none e loopDepth)
                when exprIndex then aggregates.synthIndex(c x0 e loopDepth)
                when exprIndexAssign then aggregates.synthIndexAssign(c x0 e loopDepth)

                (* Exceptions and auto values *)
                when exprException then exceptions.synthException(c x0 e loopDepth)
                when exprRaise then exceptions.elaborateRaise(c x0 none e loopDepth)
                when exprTry then exceptions.elaborateTry(c x0 none e loopDepth)
                when exprInspect then autoValues.elaborateInspect(c x0 none e loopDepth)
                when exprAuto then autoValues.elaborateAuto(c x0 none e loopDepth)

                else diagnostics.fail(:typedAst.Expr "Unsupported AST expression" offset)
            end
        end

    let newChecker(e: env.T loopDepth: Int): checker.T =
        begin
            let c = checker.new(e loopDepth)
            c.checkHook := checkExpr
            c.synthHook := synthExpr
            c
        end

    (* Binds a name a failed import or module declaration would have bound to a
     * poisoned value *)
    let poisonValue(c: checker.T name: String e: env.T): Ok =
        begin
            let sym = symbols.newValueSymbol(name model.okType false false false c.functionDepth 0)
            symbols.poisonValue(sym.symbolId)
            symbols.declareValue(e.currentScope sym)
            ok
        end

    (* body, or none if it fails, when the names are poisoned *)
    let recovering(c: checker.T names: Array(String) e: env.T body: All() typedAst.Binding): maybe.T(typedAst.Binding) =
        begin
            let result = checker.attempt(:typedAst.Binding c body)
            if maybe.isNone(:typedAst.Binding result) then
                for i = 0 upto {extent names - 1} do poisonValue(c names[i] e) end
            end
            result
        end

    (* The module names an import binds *)
    let importedNames(phrase: ast.ImportPhrase): Array(String) =
        begin
            let names = vector.new(:String)
            for i = 0 upto {vector.length(:ast.ImportItem phrase.items) - 1} do
                let item = vector.get(:ast.ImportItem phrase.items i)
                for j = 0 upto {vector.length(:String item.names) - 1} do vector.append(:String names vector.get(:String item.names j)) end
            end
            vector.toArray(:String names)
        end

    (* A top-level phrase (an import, interface, module, binding, or
     * expression), or none if it fails *)
    let elaboratePhrase(c: checker.T p: ast.Phrase e: env.T): maybe.T(typedAst.Binding) =
        case p.form
            when phraseDecl with x then bindings.elaborateRecovering(c x.decl e 0)
            when phraseImport with x then
                recovering(c importedNames(x.phrase) e fun(): typedAst.Binding
                    elaboration.elaborateImport(x.phrase p.span.startOffset e))
            when phraseInterface with x then
                recovering(c array of :String end e fun(): typedAst.Binding
                    elaboration.elaborateInterface(x.iface p.span.startOffset e))
            when phraseModule with x then
                recovering(c array of x.modDecl.name end e fun(): typedAst.Binding
                    elaboration.elaborateModule(x.modDecl p.span.startOffset e))
            when phraseExpr with x then
                checker.attempt(:typedAst.Binding c fun(): typedAst.Binding
                    typedAst.binding(p.span.startOffset option bindExprStmt of typedAst.BindingForm with
                        let expr = synthExpr(c x.expr e 0 false)
                    end))
        end

    let install(): Ok =
        begin
            loader.install()
            elaboration.hooks.elaborateBinding := fun(b: ast.Decl en: env.T loopDepth: Int): maybe.T(typedAst.Binding)
                begin
                    let c = newChecker(en loopDepth)
                    (* A block recovers from its members' errors, recording
                     * them and failing silently: the member fails with the
                     * first one *)
                    let firstRecorded(): Ok =
                        if not(vector.empty(:diagnostics.CompilerError c.errors)) then
                            diagnostics.raiseError(:Ok vector.get(:diagnostics.CompilerError c.errors 0))
                        end
                    let typed = try
                        bindings.elaborateBinding(c b en loopDepth)
                    when diagnostics.compilerError with err then
                        begin
                            firstRecorded()
                            diagnostics.raiseError(:typedAst.Binding err)
                        end
                    end
                    firstRecorded()
                    maybe.some(:typedAst.Binding typed)
                end
            ok
        end

    (* Elaborates a top-level Quest program unit (imports, interfaces,
     * modules, declarations, statements), phrase by phrase.
     *
     * Each elaboration declares fresh symbols, so elaborating the same syntax
     * twice gives trees whose references do not resolve in each other. Under
     * QUEST_CHECK_SCOPES=1, which the test runners set, a result without
     * errors is checked to be well scoped (every variable refers to a binder
     * in scope; see scoping.checkWellScoped), which catches such a mix. *)
    let elaborateProgram(program: ast.Program e: env.T): Result =
        begin
            let c = newChecker(e 0)
            (* The module system calls back to load units and to check modules'
             * members *)
            loader.install()
            elaboration.hooks.elaborateBinding := fun(b: ast.Decl en: env.T loopDepth: Int): maybe.T(typedAst.Binding)
                bindings.elaborateRecovering(c b en loopDepth)
            e.report := maybe.some(:All(err: diagnostics.CompilerError) Ok fun(err: diagnostics.CompilerError): Ok
                checker.recordError(c err))
            let phrases = vector.new(:typedAst.Binding)
            try
                for i = 0 upto {vector.length(:ast.Phrase program.form.phrases) - 1} do
                    let typed = elaboratePhrase(c vector.get(:ast.Phrase program.form.phrases i) e)
                    if maybe.isSome(:typedAst.Binding typed) then
                        vector.append(:typedAst.Binding phrases maybe.unwrap(:typedAst.Binding typed))
                    end
                end
            when diagnostics.compilerError with err then
                (* A fatal error, or the limit of errors, stops the check *)
                vector.append(:diagnostics.CompilerError c.errors err)
            end
            let typed: typedAst.Program = tuple
                let offset = program.span.startOffset let phrases = vector.toArray(:typedAst.Binding phrases)
            end
            if vector.empty(:diagnostics.CompilerError c.errors) andif scoping.scopeChecksEnabled() then
                let problems = scoping.checkWellScoped(typed)
                if extent problems > 0 then
                    let var message = "internal: the typed program is not well scoped:"
                    for i = 0 upto {if extent problems < 20 then extent problems - 1 else 19 end} do
                        message := message <> "\n  " <> problems[i]
                    end
                    vector.append(:diagnostics.CompilerError c.errors diagnostics.errorAt(message 0))
                end
            end
            let errors = vector.toArray(:diagnostics.CompilerError c.errors)
            let result = if extent errors is 0 then maybe.some(:typedAst.Program typed) else maybe.none(:typedAst.Program) end
            tuple let program = result let errors = errors end
        end
end
