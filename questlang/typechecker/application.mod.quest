(* Quest Self-Hosted Compiler: Function Application Implementation *)

module application : Application
import
    conv : Conv
    stringOp = string : StringOp
    writer : Writer

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/files : questlang/common/Files
    questlang/common/location : questlang/common/Location
    questlang/common/maps : questlang/common/Maps
    questlang/syntax/ast : questlang/syntax/AST
    questlang/typechecker/autoValues : questlang/typechecker/AutoValues
    questlang/typechecker/checker : questlang/typechecker/Checker
    questlang/typechecker/checks : questlang/typechecker/Checks
    questlang/typechecker/elaborateTypes : questlang/typechecker/ElaborateTypes
    questlang/typechecker/nearMiss : questlang/typechecker/NearMiss
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
    questlang/types/kinds : questlang/types/Kinds
    questlang/types/model : questlang/types/Model
    questlang/types/subtyping : questlang/types/Subtyping
export
    Let Type = model.Type

    let varType(t: Type): Type = model.varType(t)
    let isRefType(t: Type): Bool = case t.form when typeVar then true when typeOut then true else false end
    let isVarType(t: Type): Bool = case t.form when typeVar then true else false end

    (* Validates the destination type of a var or out argument (@x, @r.f,
     * @a[i], or var(e)) and returns it unwrapped of any Var or Out reference
     * cell. For a var parameter, the destination type must equal paramType
     * because the callee both reads and writes the location (invariance). For
     * an out parameter, the callee only writes, so any supertype of paramType
     * is accepted (docs/type-system.md §6.2.1, §6.5). *)
    let checkLvalueModeType(
            paramType: model.Type destRawType: model.Type isOut: Bool targetDesc: String offset: Int e: env.T
            ): model.Type =
        begin
            let destType =
                case destRawType.form
                    when typeVar with x then x.element
                    when typeOut with x then x.element
                    else destRawType
                end
            let lookup = env.lookupOf(e)
            if isOut then
                if not(subtyping.isSubtype(paramType destType lookup)) then
                    diagnostics.fail(:Ok "Type mismatch on out parameter: parameter type '" <> model.show(paramType)
                        <> "' is not a subtype of destination " <> targetDesc <> " type '" <> model.show(destType)
                        <> "'"
                            offset)
                end
            elsif not(subtyping.isSubtype(paramType destType lookup)
                    andif subtyping.isSubtype(destType paramType lookup)) then
                diagnostics.fail(:Ok "Type mismatch on var parameter: expected exactly '" <> model.show(paramType)
                    <> "', but got " <> targetDesc <> " of type '" <> model.show(destType)
                    <> "' (var parameters are invariant)" offset)
            end
            destType
        end

    (* e with its solved metavariables replaced by their solutions, so that
     * later phases never meet one *)
    let resolveTypedMetas(e: typedAst.Expr): typedAst.Expr = typedAst.mapTypes(e model.resolveMetas)

    let digits(s: String): Bool =
        begin
            let var all = stringOp.length(s) > 0
            for i = 0 upto {stringOp.length(s) - 1} do
                if not(strutil.isDigit(stringOp.getChar(s i))) then all := false end
            end
            all
        end

    (* Validates arity and elaborates call arguments against formal parameter
     * modes *)
    let rec checkCallArgs(
            c: checker.T args: Array(ast.Expr) params: Array(model.Param) offset: Int
            ): Array(typedAst.Expr) =
        begin
            if extent args isnot extent params then
                diagnostics.fail(:Ok "Function expects " <> conv.int(extent params) <> " arguments, but got "
                    <> conv.int(extent args) offset)
            end
            let typed = vector.new(:typedAst.Expr)
            for i = 0 upto {extent args - 1} do
                let param = params[i]
                vector.append(typed
                        if param.isVar orif param.isOut then
                            checkLvalueArg(c args[i] param.type param.isOut)
                        else
                            checker.checkExpr(c args[i] param.type)
                        end)
            end
            vector.toArray(typed)
        end

    (* Validates that arg is a mutable location for a var or out parameter:
     * @target, or var(initial value) *)
    and checkLvalueArg(c: checker.T arg: ast.Expr paramType: Type isOut: Bool): typedAst.Expr =
        case arg.form
            when exprDerefCell with x then
                checkLvalueTarget(c x.target paramType isOut arg.span.startOffset)
            when exprVarCell with x then
                typedAst.expr(arg.span.startOffset varType(paramType) option exprVarCell of typedAst.ExprForm with
                    let value = checker.checkExpr(c x.value paramType)
                end)
            else
                diagnostics.fail("Argument to '" <> {if isOut then "out" else "var" end}
                    <> "' parameter must be passed with '@' or 'var(...)'" arg.span.startOffset)
        end

    (* Elaborates the target of an argument @target passed to a var or out
     * parameter, as a reference to it.
     *
     * A var or out parameter receives a location rather than a value: one the
     * callee may read and assign (var) or only assign (out). The caller passes
     * @x, @r.f, @t.f, or @a[i], or var(e) for a fresh location
     * (checkLvalueArg); @y forwards a var or out parameter y, passing on the
     * location it already holds. This function finds the location and returns
     * a node of type Var(T) for it (exprVar for a variable, exprSelectRef,
     * exprTupleSelectRef, or exprIndexRef), so that later phases pass its
     * address rather than its contents. T is the location's own type, which
     * for out may differ from the parameter's.
     *
     * The location must be mutable: a variable or field declared var, or an
     * array element (arrays are always mutable). Mutability shows in two ways,
     * and the conditions below test both: a declaration marks its symbol or
     * field isVar, while a cell made by var(e) and bound by an ordinary let is
     * mutable through its type, Var(T). Its type must then fit the parameter's
     * mode (checkLvalueModeType). For var it must be exactly the
     * parameter's type: passing @x, where x is a Record p: Int q: Int end, to
     * var r: Record p: Int end would let the callee store a record without q
     * into x. For out, which the callee only assigns, any supertype of the
     * parameter's type will do. As with any use of a variable, @y is rejected
     * from a closure if y is a var or out parameter of an enclosing function,
     * and from any function if y is a global var variable
     * (checker.checkCapturable). *)
    and checkLvalueTarget(
            c: checker.T target: ast.Expr paramType: Type isOut: Bool offset: Int
            ): typedAst.Expr =
        begin
            let modeName = if isOut then "out" else "var" end
            case target.form
                when exprId with x then
                    begin
                        let found = checker.lookupValue(c x.name)
                        if maybe.isNone(found) then
                            diagnostics.failWithHelp(:Ok "Undefined variable '" <> x.name <> "'" offset
                                    nearMiss.valueHelp(c.env x.name))
                        end
                        let sym = maybe.unwrap(found)
                        checker.checkCapturable(c sym offset)
                        if isOut then
                            if not(sym.isVar) andif not(sym.isOut) andif not(isRefType(sym.type)) then
                                diagnostics.fail(:Ok "Argument to 'out' parameter '" <> x.name
                                    <> "' must be a mutable variable or out parameter" offset)
                            end
                        elsif not(sym.isVar) andif not(isVarType(sym.type)) then
                            diagnostics.fail(:Ok "Argument to 'var' parameter '" <> x.name
                                <> "' must be a mutable variable"
                                    offset)
                        end
                        let destType = checkLvalueModeType(paramType sym.type isOut "variable" offset c.env)
                        typedAst.expr(offset varType(destType) option exprVar of typedAst.ExprForm with
                            let name = sym.name
                            let symbol = sym
                        end)
                    end
                when exprSelect with x then
                    begin
                        let recTyped = checker.synthExpr(c x.target)
                        let var recType = checks.evaluate(recTyped.type)
                        let isTuple = case recType.form when typeTuple then true else false end
                        if not(isTuple) andif maybe.isNone(kinds.resolveRecordBound(recType maybe.some(c.env))) then
                            (* A type parameter bounded by a tuple type: its
                             * components are its bound's *)
                            recType := maybe.unwrapOr(kinds.resolveTupleBound(recType maybe.some(c.env)) recType)
                        end
                        case recType.form
                            when typeTuple with t then
                                begin
                                    (* A mutable tuple component: @t.f or
                                     * @t.1 *)
                                    let fields = model.tupleValueFields(t.fields)
                                    let var index = ~1
                                    for i = {extent fields - 1} downto 0 do
                                        let f = fields[i]
                                        let named = maybe.isSome(f.name)
                                            andif stringOp.equal(maybe.unwrap(f.name) x.field)
                                        if named orif stringOp.equal(conv.int(i) x.field) then index := i end
                                    end
                                    if index < 0 then
                                        diagnostics.fail(:Ok "Tuple type '" <> model.show(recType)
                                            <> "' has no component matching '" <> x.field <> "'" offset)
                                    end
                                    let f = fields[index]
                                    if not(f.isVar orif isRefType(f.type)) then
                                        diagnostics.fail(:Ok "Tuple component '" <> x.field
                                            <> "' is not mutable" offset)
                                    end
                                    let destType = checkLvalueModeType(paramType f.type isOut "tuple component"
                                            offset c.env)
                                    let fieldName =
                                        if digits(x.field) then maybe.none(:String) else maybe.some(x.field) end
                                    typedAst.expr(offset varType(destType)
                                            option exprTupleSelectRef of typedAst.ExprForm with
                                                let target = recTyped
                                                let index = index
                                                let field = fieldName
                                            end)
                                end
                            else
                                begin
                                    let recBound = kinds.resolveRecordBound(recType maybe.some(c.env))
                                    if maybe.isNone(recBound) then
                                        diagnostics.fail(:Ok "Target of field selection in '" <> modeName
                                            <> "' argument must be a Record or Tuple, got '" <> model.show(recType)
                                            <> "'"
                                                offset)
                                    end
                                    let fields =
                                        case maybe.unwrap(recBound).form
                                            when typeRecord with r then r.fields
                                            else array of :model.RecordField end
                                        end
                                    let field = model.recordGetField(fields x.field)
                                    if maybe.isNone(field) then
                                        diagnostics.fail(:Ok "Record type '" <> model.show(recType)
                                            <> "' has no field '"
                                            <> x.field <> "'" offset)
                                    end
                                    let f = maybe.unwrap(field)
                                    if not(f.isVar) andif not(isRefType(f.type)) then
                                        diagnostics.fail(:Ok "Record field '" <> x.field <> "' is not mutable" offset)
                                    end
                                    let fieldType = checkLvalueModeType(paramType f.type isOut "field" offset c.env)
                                    typedAst.expr(offset varType(fieldType)
                                            option exprSelectRef of typedAst.ExprForm with
                                                let target = recTyped
                                                let field = x.field
                                            end)
                                end
                        end
                    end
                when exprIndex with x then
                    begin
                        let arrTyped = checker.synthExpr(c x.target)
                        let arrType = checks.evaluate(arrTyped.type)
                        let element =
                            case arrType.form
                                when typeArray with a then a.element
                                else
                                    diagnostics.fail(:Type "Target of array indexing in '" <> modeName
                                        <> "' argument must be an Array, got '" <> model.show(arrType) <> "'" offset)
                            end
                        let idxTyped = checker.checkExpr(c x.index model.intType)
                        let destType = checkLvalueModeType(paramType element isOut "array element" offset c.env)
                        typedAst.expr(offset varType(destType) option exprIndexRef of typedAst.ExprForm with
                            let target = arrTyped
                            let index = idxTyped
                        end)
                    end
                else
                    diagnostics.fail("Argument to '" <> modeName
                        <> "' parameter must be a mutable variable, field, or array element" offset)
            end
        end

    let synthMonomorphicApp(
            c: checker.T offset: Int funcTyped: typedAst.Expr args: Array(ast.Expr) fnType: Type
            ): typedAst.Expr =
        case fnType.form
            when typeFun with f then
                typedAst.expr(offset f.result option exprApp of typedAst.ExprForm with
                    let func = funcTyped
                    let args = checkCallArgs(c args f.params offset)
                end)
            else diagnostics.internal("not a function type" offset)
        end

    let isTypeOrKindArg(a: ast.Expr): Bool = case a.form when typeArg then true when kindArg then true else false end

    (* Whether metavariable m is solved: prune gives m itself only while it is
     * unsolved *)
    let isSolved(m: Type): Bool = not(model.same(model.prune(m) m))

    let reportInferable(e: env.T sm: location.SourceMap): Ok =
        begin
            let maps = maps.newStringMap(:location.SourceMap)
            for i = 0 upto {vector.length(e.inferableCalls) - 1} do
                let call = vector.get(e.inferableCalls i)
                (* A call in another file than sm's (a module loaded while this
                 * unit was checked) is located in that file's text *)
                let inOther = {stringOp.length(call.file) > 0} andif not(stringOp.equal(call.file location.file(sm)))
                let map =
                    if not(inOther) then
                        sm
                    else
                        let known = hashMap.get(maps call.file)
                        if maybe.isSome(known) then
                            maybe.unwrap(known)
                        else
                            let made = location.newSourceMap(call.file maybe.unwrapOr(files.readText(call.file) ""))
                            hashMap.insert(maps call.file made)
                            made
                        end
                    end
                let p = location.locate(map call.offset)
                writer.putString(writer.err location.file(map) <> ":" <> conv.int(p.line) <> ":" <> conv.int(p.col)
                    <> ": type arguments can be inferred " <> {if call.fromArguments then
                        "from the arguments"
                    else
                        "with the expected type"
                    end} <> " [" <> conv.int(call.from) <> " " <> conv.int(call.to) <> "]\n")
            end
            vector.clear(e.inferableCalls)
            ok
        end

    (* The type arguments of a call or instantiation elaborated by
     * inferredTypeApp *)
    let typeArgsOf(typed: typedAst.Expr): Array(Type) =
        case typed.form
            when exprTypeApp with t then t.typeArgs
            when exprApp with a then
                case a.func.form when exprTypeApp with t then t.typeArgs else array of :Type end end
            else array of :Type end
        end

    (* Elaborates a call f(args) of a polymorphic function,
     * f: All(A::K) Fun(x: A): R, finding its type arguments.
     *
     * Type arguments may be written, as in f(:Int 42). They are substituted
     * for f's type parameters, and the rest of the call is elaborated as an
     * ordinary call (explicitTypeApp); written ones may cover only the first
     * type parameters, and the rest are then inferred. Omitted, they are
     * inferred (inferredTypeApp), following Cardelli (The Quest Language and
     * System section 4). Each type parameter is replaced by a metavariable, a
     * placeholder for the unknown type, and checking the arguments against
     * the parameter types fills the placeholders in. If some remain unsolved,
     * the type the context requires of the result (expected) is tried, as
     * when list.nil() is checked against list.T(Int). Each solution is then
     * checked against its type parameter's bound, which solving ignores.
     *
     * Inference is local and greedy: subtyping.isSubtype solves a
     * metavariable with the first type it is compared with, and nothing is
     * backtracked, so the order of the comparisons can matter. For f(a b) with
     * f: All(A) Fun(x: A y: A), if a's type is a proper subtype of b's, A
     * becomes a's type and b is rejected, though the reverse order would
     * succeed. A type argument that cannot be inferred is an error, except in
     * a call nested in another's arguments whose expected type still mentions
     * the outer call's unsolved metavariables, as nil() in cons(nil() tail):
     * it hands its unsolved ones to the outer call (c.pendingTypeArgs), which
     * solves them, and rewrites the nested call's node with the solutions
     * (resolveTypedMetas), when it finishes.
     *
     * An empty application of a polymorphic constant (list.nil(), for
     * nil: All(A::TYPE) T(A)) instantiates it. *)
    let rec synthPolymorphicApp(
            c: checker.T offset: Int args: Array(ast.Expr) funcTyped: typedAst.Expr allType: Type
            expected: maybe.T(Type)
            ): typedAst.Expr =
        case allType.form
            when typeAll with all then
                begin
                    (* 1. Explicit type and kind arguments (f(:Int 42),
                     *    id(:Int)) *)
                    let var numTargs = 0
                    while {numTargs < extent args} andif isTypeOrKindArg(args[numTargs]) do numTargs := numTargs + 1 end
                    if numTargs > 0 then
                        explicitTypeApp(c offset args numTargs funcTyped allType all.quantifiers all.body
                                expected)
                    else
                        inferredTypeApp(c offset args funcTyped allType all.quantifiers all.body expected)
                    end
                end
            else diagnostics.internal("not a polymorphic type" offset)
        end

    and explicitTypeApp(
            c: checker.T offset: Int args: Array(ast.Expr) numTargs: Int funcTyped: typedAst.Expr allType: Type
            quantifiers: Array(model.Quantifier) body: Type expected: maybe.T(Type)
            ): typedAst.Expr =
        begin
            if numTargs > extent quantifiers then
                diagnostics.fail(:Ok "Too many type arguments: expected at most " <> conv.int(extent quantifiers)
                    <> ", got " <> conv.int(numTargs) offset)
            end
            let subst = model.newSubst()
            let resolved = vector.new(:Type)
            for i = 0 upto {numTargs - 1} do
                let q = quantifiers[i]
                let targ = args[i]
                case targ.form
                    when typeArg with x then
                        begin
                            let targVal = elaborateTypes.elaborateType(x.typeVal c.env)
                            checks.checkTypeArgKind("Type argument" targVal model.substituteInKind(q.bound subst) c.env
                                    targ.span.startOffset)
                            hashMap.insert(subst q.symbolId targVal)
                            vector.append(resolved targVal)
                        end
                    else
                        diagnostics.fail(:Ok "Explicit kind arguments are not supported in runtime calls"
                                targ.span.startOffset)
                end
            end
            let instantiated =
                if numTargs < extent quantifiers then
                    let remaining = vector.new(:model.Quantifier)
                    for i = numTargs upto {extent quantifiers - 1} do
                        let q = quantifiers[i]
                        vector.append(remaining tuple
                            let name = q.name
                            let symbolId = q.symbolId
                            let bound = model.substituteInKind(q.bound subst)
                        end)
                    end
                    model.allType(vector.toArray(remaining) model.substitute(body subst))
                else
                    model.substitute(body subst)
                end
            let resolvedTargs = vector.toArray(resolved)
            autoValues.checkDynamicTypeArgs(allType resolvedTargs offset autoValues.checkClosedType)
            if {stringOp.length(c.env.reportInferable) > 0} andif {numTargs is extent quantifiers} then
                let restVector = vector.new(:ast.Expr)
                for i = numTargs upto {extent args - 1} do vector.append(restVector args[i]) end
                let rest = vector.toArray(restVector)
                (* Try inferring from the value arguments alone first; if that
                 * fails, also include the expected type *)
                let exact = stringOp.equal(c.env.reportInferable "exact")
                let fromArguments = probeInference(c offset rest funcTyped allType quantifiers body
                        maybe.none() resolvedTargs exact)
                if fromArguments
                        orif probeInference(c offset rest funcTyped allType quantifiers body expected
                                resolvedTargs exact) then
                    let to =
                        if numTargs < extent args then
                            args[numTargs].span.startOffset
                        else
                            args[numTargs - 1].span.endOffset
                        end
                    vector.append(c.env.inferableCalls tuple
                        let file = c.env.sourceFile
                        let offset = offset
                        let from = args[0].span.startOffset
                        let to = to
                        let fromArguments = fromArguments
                    end)
                end
            end
            let typedTypeApp = typedAst.expr(offset instantiated option exprTypeApp of typedAst.ExprForm with
                let func = funcTyped
                let typeArgs = resolvedTargs
            end)
            if numTargs is extent args then
                typedTypeApp
            else
                let remainingArgs = vector.new(:ast.Expr)
                for i = numTargs upto {extent args - 1} do vector.append(remainingArgs args[i]) end
                let rest = vector.toArray(remainingArgs)
                let instLazy = checks.evaluate(instantiated)
                case instLazy.form
                    when typeAll then synthPolymorphicApp(c offset rest typedTypeApp instLazy expected)
                    when typeFun then synthMonomorphicApp(c offset typedTypeApp rest instLazy)
                    else
                        diagnostics.fail("Cannot invoke non-function type '" <> model.show(instLazy) <> "'"
                                offset)
                end
            end
        end

    (* Reports whether inferredTypeApp, given the call's value arguments (args)
     * and expected type, infers the same type arguments as written. Each
     * inferred argument must be an equal type, or if exact is true, the same
     * type node spelled the same way (an alias rather than the type it names),
     * because later passes that compare types by identity distinguish the two.
     * The trial's result and any errors or warnings it records are discarded.
     * A call whose expected type still holds an enclosing call's unsolved
     * metavariables, or that appears as an argument of an enclosing call with
     * inferred type arguments, is not tried, because the trial could solve or
     * defer to the enclosing call's metavariables. *)
    and probeInference(
            c: checker.T offset: Int args: Array(ast.Expr) funcTyped: typedAst.Expr allType: Type
            quantifiers: Array(model.Quantifier) body: Type expected: maybe.T(Type)
            written: Array(Type) exact: Bool
            ): Bool =
        if maybe.isSome(c.pendingTypeArgs)
                orif {maybe.isSome(expected) andif {extent model.unsolvedMetas(maybe.unwrap(:Type expected)) > 0}} then
            false
        else
            let errorCount = vector.length(c.errors)
            let warningCount = vector.length(c.warnings)
            let same =
                try
                    begin
                        let found =
                            typeArgsOf(inferredTypeApp(c offset args funcTyped allType quantifiers body expected))
                        let var equal = extent found is extent written
                        if equal then
                            for i = 0 upto {extent found - 1} do
                                let alike = model.same(found[i] written[i])
                                    orif {not(exact)
                                        andif subtyping.isTypeEqual(found[i] written[i] env.lookupOf(c.env))}
                                if not(alike) then equal := false end
                            end
                        end
                        equal
                    end
                when diagnostics.compilerError then false
                end
            c.pendingTypeArgs := maybe.none()
            let truncate = fun(found: vector.T(diagnostics.CompilerError) count: Int): Ok
                while vector.length(found) > count do vector.delete(found vector.length(found) - 1) end
            truncate(c.errors errorCount)
            truncate(c.warnings warningCount)
            same
        end

    (* Infers implicit type arguments using metavariables. The metavariables
     * (typeMeta, printed ?A) exist only while the call is elaborated: they
     * are replaced by their solutions before the outermost call's node is
     * returned, and an internal error is reported if any remain. *)
    and inferredTypeApp(
            c: checker.T offset: Int args: Array(ast.Expr) funcTyped: typedAst.Expr allType: Type
            quantifiers: Array(model.Quantifier) body: Type expected: maybe.T(Type)
            ): typedAst.Expr =
        begin
            let fnBody = checks.evaluate(body)
            (* An empty application of a polymorphic constant instantiates it
             * (Cardelli: nil()) *)
            let isInstantiation = case fnBody.form when typeFun then false else true end
            if isInstantiation andif {extent args > 0} then
                diagnostics.fail(:Ok "Polymorphic body is '" <> model.show(fnBody) <> "', not a function type" offset)
            end
            let metaMap = model.newSubst()
            for i = 0 upto {extent quantifiers - 1} do
                let q = quantifiers[i]
                hashMap.insert(metaMap q.symbolId model.newMeta(model.typeKind maybe.some("?" <> q.name)))
            end
            let instantiatedFn = model.substitute(fnBody metaMap)
            let resultType =
                case instantiatedFn.form
                    when typeFun with f then if isInstantiation then instantiatedFn else f.result end
                    else instantiatedFn
                end
            (* This call's type arguments, plus any that calls nested in its
             * arguments defer to it *)
            let typeArgs = vector.new(:checker.PendingTypeArg)
            for i = 0 upto {extent quantifiers - 1} do
                let q = quantifiers[i]
                vector.append(typeArgs tuple
                    let meta = hashMap.find(metaMap q.symbolId)
                    let quantifier = q
                    let offset = offset
                end)
            end
            let enclosing = c.pendingTypeArgs
            c.pendingTypeArgs := maybe.some(typeArgs)
            let var typedArgs =
                try
                    case instantiatedFn.form
                        when typeFun with f then
                            if isInstantiation then
                                array of :typedAst.Expr end
                            else
                                checkCallArgs(c args f.params offset)
                            end
                        else array of :typedAst.Expr end
                    end
                when diagnostics.compilerError with err then
                    c.pendingTypeArgs := enclosing
                    diagnostics.raiseError(:Array(typedAst.Expr) err)
                end
            c.pendingTypeArgs := enclosing

            let anyUnsolved(): Bool =
                begin
                    let var found = false
                    for i = 0 upto {vector.length(typeArgs) - 1} do
                        if not(isSolved(vector.get(typeArgs i).meta)) then found := true end
                    end
                    found
                end
            if maybe.isSome(expected) andif anyUnsolved() then
                (* Infer remaining metavariables from the expected type; a
                 * failed match is reported by the caller *)
                subtyping.isSubtype(resultType maybe.unwrap(expected) env.lookupOf(c.env))
                ok
            end

            let unsolved = vector.filter(typeArgs
                    fun(p: checker.PendingTypeArg): Bool not(isSolved(p.meta)))
            if not(vector.empty(unsolved)) then
                let defers = maybe.isSome(enclosing)
                    andif maybe.isSome(expected) andif {extent model.unsolvedMetas(maybe.unwrap(:Type expected)) > 0}
                if defers then
                    let outer = maybe.unwrap(enclosing)
                    for i = 0 upto {vector.length(unsolved) - 1} do
                        vector.append(outer vector.get(unsolved i))
                    end
                else
                    let n = vector.length(unsolved)
                    let var names = ""
                    for i = 0 upto {n - 1} do
                        let name = "'" <> vector.get(unsolved i).quantifier.name <> "'"
                        names := if i is 0 then name else names <> ", " <> name end
                    end
                    let plural = n > 1
                    diagnostics.fail(:Ok "Cannot infer type argument" <> {if plural then "s" else "" end} <> " "
                        <> names
                        <> " from the arguments or the expected type; supply " <> {if plural then "them" else "it" end}
                        <> " explicitly" vector.get(unsolved 0).offset)
                end
            end

            for i = 0 upto {vector.length(typeArgs) - 1} do
                let p = vector.get(typeArgs i)
                let solved = model.prune(p.meta)
                if not(model.same(solved p.meta)) then
                    (* Substituting prunes the solved metavariables *)
                    let bound =
                        model.substituteInKind(model.substituteInKind(p.quantifier.bound metaMap) model.newSubst())
                    checks.checkTypeArgKind("Inferred type argument" model.resolveMetas(solved) bound c.env p.offset)
                end
            end

            let resolved = vector.new(:Type)
            for i = 0 upto {extent quantifiers - 1} do
                vector.append(resolved model.resolveMetas(hashMap.find(metaMap quantifiers[i].symbolId)))
            end
            let resolvedTargs = vector.toArray(resolved)
            let finalFn = model.resolveMetas(instantiatedFn)
            if maybe.isNone(c.pendingTypeArgs) then
                (* Arguments elaborated in check mode and nested calls that
                 * deferred to this one still refer to the now-solved
                 * metavariables *)
                let resolvedArgs = vector.new(:typedAst.Expr)
                for i = 0 upto {extent typedArgs - 1} do
                    vector.append(resolvedArgs resolveTypedMetas(typedArgs[i]))
                end
                typedArgs := vector.toArray(resolvedArgs)
                let var leaked = extent model.unsolvedMetas(finalFn) > 0
                for i = 0 upto {extent resolvedTargs - 1} do
                    if extent model.unsolvedMetas(resolvedTargs[i]) > 0 then leaked := true end
                end
                if leaked then
                    diagnostics.internal(:Ok "metavariables escaped polymorphic call inference" offset)
                end
            end

            autoValues.checkDynamicTypeArgs(allType resolvedTargs offset autoValues.checkClosedType)
            let typedTypeApp = typedAst.expr(offset finalFn option exprTypeApp of typedAst.ExprForm with
                let func = funcTyped
                let typeArgs = resolvedTargs
            end)
            if isInstantiation then
                typedTypeApp
            else
                case finalFn.form
                    when typeFun with f then
                        typedAst.expr(offset f.result option exprApp of typedAst.ExprForm with
                            let func = typedTypeApp
                            let args = typedArgs
                        end)
                    else diagnostics.internal("not a function type" offset)
                end
            end
        end

    let elaborateApp(c: checker.T x0: ast.Expr expected: maybe.T(Type)): typedAst.Expr =
        case x0.form
            when exprApp with x then
                begin
                    let offset = x0.span.startOffset
                    let args = vector.toArray(x.args)
                    let isOrdinal =
                        case x.func.form when exprId with f then stringOp.equal(f.name "ordinal") else false end
                    if isOrdinal then
                        (* The built-in monadic operator ordinal (Cardelli
                         * section 4.5) *)
                        if extent args isnot 1 then diagnostics.fail(:Ok "ordinal expects 1 argument" offset) end
                        let argTyped = checker.synthExpr(c args[0])
                        let argLazy = checks.evaluate(argTyped.type)
                        let isOption = case argLazy.form when typeOption then true else false end
                        if not(isOption) andif maybe.isNone(kinds.resolveOptionBound(argLazy maybe.none(:env.T))) then
                            diagnostics.fail(:Ok "ordinal requires an Option type, got '" <> model.show(argTyped.type)
                                <> "'"
                                    args[0].span.startOffset)
                        end
                        let funcTyped = checker.synthCallee(c x.func)
                        typedAst.expr(offset model.intType option exprApp of typedAst.ExprForm with
                            let func = funcTyped
                            let args = array of argTyped end
                        end)
                    else
                        let funcTyped = checker.synthCallee(c x.func)
                        let fnType = checks.evaluate(funcTyped.type)
                        case fnType.form
                            when typeAll then synthPolymorphicApp(c offset args funcTyped fnType expected)
                            when typeFun then synthMonomorphicApp(c offset funcTyped args fnType)
                            else
                                diagnostics.failWithHelp("Cannot invoke non-function type '" <> model.show(fnType)
                                    <> "'" x.func.span.startOffset
                                        case x.func.form
                                            when exprId with id then nearMiss.callHelp(c.env id.name)
                                            else maybe.none()
                                        end)
                        end
                    end
                end
            else diagnostics.internal("not an application" x0.span.startOffset)
        end
end
