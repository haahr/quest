(* Quest Self-Hosted Compiler: Aggregates Interface
 *
 * The construct family of bootstrap/python/quest/typechecker/aggregates.py: records, tuples (with their type
 * components and labels), member selection, options, variants and their tag queries and assertions, arrays, and
 * indexing. Each function takes an expression of its form; the elaborate ones check against an expected type if
 * there is one, and synthesize otherwise. *)

interface Aggregates
import
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/types/model : questlang/types/Model
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/typechecker/checker : questlang/typechecker/Checker
    util/maybe : util/Maybe
export
    elaborateRecord(c: checker.T expr: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr
    elaborateTuple(c: checker.T expr: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr
    synthSelect(c: checker.T expr: ast.Expr e: env.T loopDepth: Int): typedAst.Expr
    synthOption(c: checker.T expr: ast.Expr e: env.T loopDepth: Int): typedAst.Expr
    synthVariant(c: checker.T expr: ast.Expr e: env.T loopDepth: Int): typedAst.Expr
    synthVariantCheck(c: checker.T expr: ast.Expr e: env.T loopDepth: Int): typedAst.Expr
    synthVariantAssert(c: checker.T expr: ast.Expr e: env.T loopDepth: Int): typedAst.Expr
    elaborateArray(c: checker.T expr: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr
    elaborateArrayRep(c: checker.T expr: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr
    synthIndex(c: checker.T expr: ast.Expr e: env.T loopDepth: Int): typedAst.Expr
    synthIndexAssign(c: checker.T expr: ast.Expr e: env.T loopDepth: Int): typedAst.Expr
end
