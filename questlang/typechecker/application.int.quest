(* Quest Self-Hosted Compiler: Function Application Interface
 *
 * The construct family of bootstrap/python/quest/typechecker/application.py:
 * monomorphic calls, polymorphic calls with explicit or inferred type
 * arguments, and the lvalue arguments of var and out parameters. *)

interface Application
import
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/types/model : questlang/types/Model
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/typechecker/checker : questlang/typechecker/Checker
    util/maybe : util/Maybe
export
    (* An application (of the form exprApp). The expected type, if there is one,
     * can determine the implicit type arguments of a polymorphic call; the
     * application's type is still synthesized. *)
    elaborateApp(c: checker.T expr: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr
end
