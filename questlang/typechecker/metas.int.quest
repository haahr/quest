(* Quest Self-Hosted Compiler: Metavariable Resolution over Typed ASTs Interface
 *
 * bootstrap/python/quest/typechecker/metas.py: a typed AST with its solved metavariables replaced by their solutions. *)

interface Metas
import
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
export
    resolveTypedMetas(e: typedAst.Expr): typedAst.Expr
end
