(* Quest Self-Hosted Compiler: The Checker's State and Shared Helpers Interface
 *
 * This interface defines the state of one type check and the helpers shared by
 * its construct families, matching Checker in
 * bootstrap/python/quest/typechecker/checker.py. The families (bindings,
 * application, aggregates, control, exceptions, autovalues) reach the
 * expression dispatch (checkExpr, synthExpr) defined in typecheck through
 * function fields in T that typecheck fills when creating a checker; a family
 * calls lower-level families directly.
 *
 * The checker also records the errors it finds (docs/diagnostics.md section
 * 4.5): a binding that fails reports its error and checking continues with the
 * next binding, up to 20 errors. *)

interface Checker
import
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/types/env : questlang/types/Env
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
export
    (* An implicit type argument of a polymorphic call whose arguments are being
     * checked: its metavariable (a placeholder type solved by unification), its
     * quantifier, and the call's offset *)
    Def PendingTypeArg = Tuple meta: model.Type quantifier: model.Quantifier offset: Int end

    Def Rec T = Tuple
        env: env.T
        (* The number of loops enclosing the code being checked, for checking
         * exit. The loopDepth argument threaded through the elaboration
         * functions is authoritative; this field is only the counter that
         * inLoop and inFunction adjust, set from the argument just before
         * (see the while case of synthExpr in typecheck). *)
        var loopDepth: Int
        (* The number of functions enclosing the code being checked; one more
         * inside each function body (inFunction). A symbol records the depth
         * it was declared at, and a use from a deeper function is a capture
         * (checkCapturable). *)
        var functionDepth: Int
        (* The type arguments of the polymorphic call whose arguments are being
         * checked, to which nested calls may defer theirs *)
        var pendingTypeArgs: maybe.T(vector.T(PendingTypeArg))
        (* The errors found, in order *)
        errors: vector.T(diagnostics.CompilerError)
        (* The warnings found, in order, which do not stop elaboration *)
        warnings: vector.T(diagnostics.CompilerError)
        (* The dispatch, which typecheck defines *)
        var checkHook: All(c: T expr: ast.Expr expected: model.Type e: env.T loopDepth: Int) typedAst.Expr
        var synthHook: All(c: T expr: ast.Expr e: env.T loopDepth: Int isCallee: Bool) typedAst.Expr
    end

    (* A checker of the environment, without its dispatch *)
    new(e: env.T loopDepth: Int): T

    (* Checks expr against expected (Gamma |- e <= T) *)
    checkExpr(c: T expr: ast.Expr expected: model.Type e: env.T loopDepth: Int): typedAst.Expr
    (* Synthesizes the type of expr (Gamma |- e => T) *)
    synthExpr(c: T expr: ast.Expr e: env.T loopDepth: Int): typedAst.Expr
    (* Synthesizes the type of a callee: a monadic operator's name may stand
     * alone there *)
    synthCallee(c: T expr: ast.Expr e: env.T loopDepth: Int): typedAst.Expr

    (* Runs body one loop deeper (inLoop) or inside a function body (inFunction,
     * where loops cannot exit outer loops), restoring the depths if body raises
     * an error *)
    inLoop(A::TYPE c: T body: All() A): A
    inFunction(A::TYPE c: T body: All() A): A

    (* Checks expr against expected if there is one, else synthesizes it *)
    elaborateSubexpr(c: T expr: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr
    elaborateOptionalBranch(
            c: T expr: maybe.T(ast.Expr) expected: maybe.T(model.Type) e: env.T loopDepth: Int
            ): maybe.T(typedAst.Expr)
    (* The types of branch bodies and an else branch, after initial if there is
     * one *)
    branchTypes(initial: maybe.T(model.Type) bodies: Array(typedAst.Expr)
            elseBranch: maybe.T(typedAst.Expr)): Array(model.Type)
    (* Synthesizes expr and requires its type to be a subtype of expected *)
    checkSubsumption(
            c: T expr: ast.Expr expected: model.Type e: env.T loopDepth: Int typeDesc: maybe.T(String)
            ): typedAst.Expr
    (* Rejects a use of sym, the symbol of a name just looked up, from a closure
     * if it is a var or out parameter of an enclosing function, and from any
     * function if it is a global var variable (docs/type-system.md §6.2.3).
     * A closure may capture a local var variable. *)
    checkCapturable(c: T sym: symbols.ValueSymbol offset: Int): Ok

    (* Looks up a value in scope; fails silently if the symbol was poisoned by
     * an earlier failed declaration, avoiding cascading errors *)
    lookupValue(c: T e: env.T name: String): maybe.T(symbols.ValueSymbol)
    (* Fails silently if sym was poisoned *)
    checkPoisoned(sym: symbols.ValueSymbol): Ok

    (* Records an error; the 20th stops the check, with a fatal error *)
    maxErrors: Int
    recordError(c: T err: diagnostics.CompilerError): Ok
    (* Records an error caught where it was raised, located as if it had
     * propagated out of the units being loaded *)
    report(c: T err: diagnostics.CompilerError): Ok
    (* Runs body and returns its result, or none if it raises a non-fatal error;
     * non-silent errors are reported, and fatal errors propagate *)
    attempt(A::TYPE c: T body: All() A): maybe.T(A)
end
