(* Quest Self-Hosted Compiler: Typed AST Printer Interface
 *
 * Prints a typed AST as the bootstrap's TypedNode.dump
 * (bootstrap/python/quest/typechecker/typed_ast.py) does: a canonical 2-space
 * indented S-expression, with each expression's type, which the typecheck
 * goldens hold. *)

interface TypedAstPrint
import
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
export
    dumpProgram(p: typedAst.Program): String
    dumpBinding(b: typedAst.Binding indent: Int): String
    dumpExpr(e: typedAst.Expr indent: Int): String
end
