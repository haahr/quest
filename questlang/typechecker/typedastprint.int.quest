(* Quest Self-Hosted Compiler: Typed AST Printer Interface
 *
 * This interface formats a typed AST into a canonical 2-space indented
 * S-expression with each expression's type, matching the bootstrap's
 * TypedNode.dump (bootstrap/python/quest/typechecker/typed_ast.py). The
 * typecheck golden tests compare against this format. *)

interface TypedASTPrint
import
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
export
    dumpProgram(p: typedAst.Program): String
    dumpExpr(e: typedAst.Expr indent: Int): String
end
