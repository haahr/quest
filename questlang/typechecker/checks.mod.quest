(* Quest Self-Hosted Compiler: Shared Checks Implementation *)

module checks : Checks
import
    stringOp = string : StringOp

    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/maps : questlang/common/Maps
    questlang/syntax/desugar : questlang/syntax/Desugar
    questlang/typechecker/nearMiss : questlang/typechecker/NearMiss
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
    questlang/types/kinds : questlang/types/Kinds
    questlang/types/model : questlang/types/Model
    questlang/types/subtyping : questlang/types/Subtyping
export
    Let Named = Tuple name: String offset: Int end

    let checkBinder(name: String offset: Int): Ok =
        (* mod, on the list but never infix, is a function's name (word.mod,
         * bignum.mod) *)
        if desugar.isBuiltinInfix(name) andif not(stringOp.equal(name "mod")) then
            diagnostics.fail(:Ok "'" <> name
                <> "' is a built-in operator and cannot be bound; give the operator a name "
                <> "of its own, such as <+>" offset)
        end

    let checkDistinctNames(members: Array(Named)): Ok =
        begin
            let seen = maps.newStringSet()
            for i = 0 upto {extent members - 1} do
                let m = members[i]
                if hashSet.contains(seen m.name) then
                    diagnostics.fail(:Ok "'" <> m.name
                        <> "' is declared more than once in one simultaneous declaration" m.offset)
                end
                hashSet.insert(seen m.name)
            end
        end

    let describeKind(k: model.Kind): String =
        if model.isPower(k) then "<: " <> model.show(model.powerBound(k)) else ":: " <> model.showKind(k) end

    let checkTypeArgKind(what: String targ: model.Type bound: model.Kind e: env.T offset: Int): Ok =
        begin
            let b = model.evaluateKindLazily(bound maybe.unwrap(env.lookupOf(e)))
            if model.isPower(b) then
                if not(subtyping.isSubtype(targ model.powerBound(b) env.lookupOf(e))) then
                    diagnostics.fail(:Ok what <> " '" <> model.show(targ) <> "' is not a subtype of bound '"
                        <> model.show(model.powerBound(b)) <> "'" offset)
                end
            else
                let kind = kinds.synthKind(targ maybe.some(e))
                if not(subtyping.isSubkind(kind b env.lookupOf(e))) then
                    diagnostics.fail(:Ok what <> " '" <> model.show(targ) <> "' has kind '" <> model.showKind(kind)
                        <> "', which is not a subkind of '" <> model.showKind(b) <> "'" offset)
                end
            end
        end

    let joinTypes(types: Array(model.Type) e: env.T offset: Int errorMessage: maybe.T(String)): model.Type =
        if extent types is 0 then
            model.okType
        else
            let var join = types[0]
            for i = 1 upto {extent types - 1} do
                let bt = types[i]
                if subtyping.isSubtype(join bt env.lookupOf(e)) then
                    join := bt
                elsif not(subtyping.isSubtype(bt join env.lookupOf(e))) then
                    let message =
                        if maybe.isSome(errorMessage) then
                            strutil.replace(strutil.replace(maybe.unwrap(errorMessage) "{t1}" model.show(join))
                                    "{t2}" model.show(bt))
                        else
                            "Cannot find common supertype join for branch types '" <> model.show(join) <> "' and '"
                                <> model.show(bt) <> "'"
                        end
                    diagnostics.fail(:Ok message offset)
                end
            end
            join
        end

    Let Joined = Tuple type: model.Type parts: Array(typedAst.Expr) end

    let mapArray(A::TYPE xs: Array(A) g: All(x: A) A): Array(A) =
        begin
            let result = vector.new(:A)
            for i = 0 upto {extent xs - 1} do vector.append(result g(xs[i])) end
            vector.toArray(result)
        end

    let rec isDivergent(x: typedAst.Expr): Bool =
        case x.form
            when exprRaise, exprExit then true
            when exprBlock with b then isDivergent(b.result)
            when exprIf with i then isDivergent(i.thenBranch) andif isDivergent(i.elseBranch)
            when exprCase with k then
                begin
                    let var every = {{extent k.branches} > 0} orif maybe.isSome(k.elseBranch)
                    for i = 0 upto {extent k.branches - 1} do
                        if not(isDivergent(k.branches[i].body)) then every := false end
                    end
                    every andif maybeDivergent(k.elseBranch)
                end
            when exprInspect with k then
                begin
                    let var every = {{extent k.branches} > 0} orif maybe.isSome(k.elseBranch)
                    for i = 0 upto {extent k.branches - 1} do
                        if not(isDivergent(k.branches[i].body)) then every := false end
                    end
                    every andif maybeDivergent(k.elseBranch)
                end
            when exprTry with t then
                begin
                    let var every = isDivergent(t.body)
                    for i = 0 upto {extent t.branches - 1} do
                        if not(isDivergent(t.branches[i].body)) then every := false end
                    end
                    every andif maybeDivergent(t.elseBranch)
                end
            else false
        end

    (* Whether an optional branch is absent or divergent *)
    and maybeDivergent(x: maybe.T(typedAst.Expr)): Bool = maybe.isNone(x) orif isDivergent(maybe.unwrap(x))

    let rec retypeDivergent(x: typedAst.Expr t: model.Type): typedAst.Expr =
        begin
            let r(y: typedAst.Expr): typedAst.Expr = retypeDivergent(y t)
            let rm(y: maybe.T(typedAst.Expr)): maybe.T(typedAst.Expr) =
                if maybe.isSome(y) then maybe.some(r(maybe.unwrap(y))) else y end
            let form =
                case x.form
                    when exprRaise, exprExit then x.form
                    when exprBlock with b then
                        option exprBlock of typedAst.ExprForm with
                            let bindings = b.bindings
                            let result = r(b.result)
                        end
                    when exprIf with i then
                        option exprIf of typedAst.ExprForm with
                            let cond = i.cond
                            let thenBranch = r(i.thenBranch)
                            let elseBranch = r(i.elseBranch)
                        end
                    when exprCase with k then
                        option exprCase of typedAst.ExprForm with
                            let target = k.target
                            let branches = mapArray(k.branches fun(b: typedAst.CaseBranch): typedAst.CaseBranch
                                tuple
                                    let offset = b.offset
                                    let tags = b.tags
                                    let body = r(b.body)
                                    let binder = b.binder
                                end)
                            let elseBranch = rm(k.elseBranch)
                        end
                    when exprInspect with k then
                        option exprInspect of typedAst.ExprForm with
                            let target = k.target
                            let branches = mapArray(k.branches fun(b: typedAst.InspectBranch): typedAst.InspectBranch
                                tuple
                                    let offset = b.offset
                                    let matchType = b.matchType
                                    let binders = b.binders
                                    let body = r(b.body)
                                    let exact = b.exact
                                end)
                            let elseBranch = rm(k.elseBranch)
                            let autoType = k.autoType
                        end
                    when exprTry with k then
                        option exprTry of typedAst.ExprForm with
                            let body = r(k.body)
                            let branches = mapArray(k.branches fun(b: typedAst.TryBranch): typedAst.TryBranch
                                tuple
                                    let offset = b.offset
                                    let excPattern = b.excPattern
                                    let body = r(b.body)
                                    let binder = b.binder
                                end)
                            let elseBranch = rm(k.elseBranch)
                            let elseBinder = k.elseBinder
                        end
                    else diagnostics.fail(:typedAst.ExprForm "internal: retyping an expression that is not divergent"
                            x.offset)
                end
            typedAst.expr(x.offset t form)
        end

    let joinBranches(parts: Array(typedAst.Expr) e: env.T offset: Int errorMessage: maybe.T(String)): Joined =
        begin
            let all = vector.new(:model.Type)
            let live = vector.new(:model.Type)
            for i = 0 upto {extent parts - 1} do
                vector.append(all parts[i].type)
                if not(isDivergent(parts[i])) then vector.append(live parts[i].type) end
            end
            let liveTypes = vector.toArray(live)
            if extent liveTypes is 0 then
                tuple let type = joinTypes(vector.toArray(all) e offset errorMessage) let parts = parts end
            else
                let t = joinTypes(liveTypes e offset errorMessage)
                let retyped = mapArray(parts fun(p: typedAst.Expr): typedAst.Expr
                    if isDivergent(p) then retypeDivergent(p t) else p end)
                tuple let type = t let parts = retyped end
            end
        end

    let requireSubtype(offset: Int typed: typedAst.Expr expected: model.Type e: env.T
            typeDesc: maybe.T(String)): typedAst.Expr =
        if subtyping.isSubtype(typed.type expected env.lookupOf(e)) then
            typed
        else
            let prefix = maybe.unwrapOr(typeDesc "Type mismatch: synthesized")
            diagnostics.failWithHelp(prefix <> " type '" <> model.show(typed.type)
                <> "' is not a subtype of expected type '" <> model.show(expected) <> "'" offset
                    nearMiss.mismatchHelp(typed.type expected))
        end

    let notDesugared(className: String offset: Int): diagnostics.CompilerError =
        diagnostics.errorAt("internal: " <> className <> " reached the type checker without desugaring" offset)
end
