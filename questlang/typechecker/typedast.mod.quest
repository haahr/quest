(* Quest Self-Hosted Compiler: Typed AST Implementation *)

module typedAst : TypedAst
import
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    stringOp = string : StringOp
export
    Let Rec Expr = Tuple
        offset: Int
        type: model.Type
        form: ExprForm
    end
    and ExprForm = Option
        exprInt with value: Int end
        exprReal with value: Real end
        exprBool with value: Bool end
        exprChar with value: Char end
        exprString with value: String end
        exprOk
        exprExternal with symbol: String end
        exprVar with name: String symbol: symbols.ValueSymbol end
        exprFun with params: Array(Param) body: Expr typeParamIds: Array(Int) typeOnly: Bool end
        exprApp with func: Expr args: Array(Expr) end
        exprTypeApp with func: Expr typeArgs: Array(model.Type) end
        exprInfix with left: Expr op: String right: Expr end
        exprRecord with fields: Array(RecordField) end
        exprTypeWitness with name: String witnessType: model.Type bound: maybe.T(model.Kind) end
        exprTuple with
            elements: Array(Expr)
            recGroups: Array(Array(Int))
            simultaneousGroups: Array(Array(Int))
            labels: Array(maybe.T(symbols.ValueSymbol))
        end
        exprSelect with target: Expr field: String end
        exprIndex with target: Expr index: Expr end
        exprIndexAssign with target: Expr index: Expr value: Expr end
        exprArray with elements: Array(Expr) end
        exprArrayRep with count: Expr initVal: Expr end
        exprVarCell with value: Expr end
        exprDerefCell with target: Expr end
        exprSelectRef with target: Expr field: String end
        exprIndexRef with target: Expr index: Expr end
        exprTupleSelectRef with target: Expr index: Int field: maybe.T(String) end
        exprAssign with target: Expr value: Expr end
        exprVariant with tag: String payload: maybe.T(Expr) end
        exprOption with tag: maybe.T(String) payload: maybe.T(Expr) ordinalExpr: maybe.T(Expr) end
        exprAuto with witnessType: model.Type autoType: model.Type payload: Expr end
        exprVariantCheck with target: Expr tag: String end
        exprVariantAssert with target: Expr tag: String end
        exprCase with target: Expr branches: Array(CaseBranch) elseBranch: maybe.T(Expr) end
        exprInspect with
            target: Expr
            branches: Array(InspectBranch)
            elseBranch: maybe.T(Expr)
            autoType: maybe.T(model.Type)
        end
        exprBlock with bindings: Array(Binding) result: Expr end
        exprIf with cond: Expr thenBranch: Expr elseBranch: Expr end
        exprWhile with cond: Expr body: Expr end
        exprLoop with body: Expr end
        exprFor with varName: String symbol: symbols.ValueSymbol start: Expr isDownto: Bool stop: Expr body: Expr end
        exprExit
        exprException with name: String payloadType: maybe.T(model.Type) symbol: maybe.T(symbols.ValueSymbol) end
        exprRaise with exc: Expr payload: maybe.T(Expr) end
        exprTry with
            body: Expr branches: Array(TryBranch) elseBranch: maybe.T(Expr) elseBinder: maybe.T(symbols.ValueSymbol)
        end
    end
    and Param = Tuple
        offset: Int
        name: String
        symbol: symbols.ValueSymbol
        type: model.Type
        isVar: Bool
        isOut: Bool
    end
    and RecordField = Tuple offset: Int name: String value: Expr isVar: Bool end
    and CaseBranch = Tuple offset: Int tags: Array(String) body: Expr binder: maybe.T(symbols.ValueSymbol) end
    and InspectBranch = Tuple
        offset: Int
        matchType: model.Type
        binders: Array(symbols.ValueSymbol)
        body: Expr
        exact: Bool
    end
    and TryBranch = Tuple offset: Int excPattern: Expr body: Expr binder: maybe.T(symbols.ValueSymbol) end
    and Binding = Tuple offset: Int form: BindingForm end
    and BindingForm = Option
        bindLetValue with value: LetValue end
        bindLetValueGroup with members: Array(LetValue) end
        bindLetType with value: LetType end
        bindLetTypeGroup with members: Array(LetType) end
        bindDefKind with name: String symbol: symbols.KindSymbol end
        bindExprStmt with expr: Expr end
        bindInterface with name: String signatures: Array(Binding) scope: symbols.Scope end
        bindModule with
            name: String
            interfaceName: String
            bindings: Array(Binding)
            scope: symbols.Scope
            isPrecompiled: Bool
            symbolId: maybe.T(Int)
        end
        bindImport with items: Array(ImportItem) end
    end
    (* redefines: whether the let redefines an interactive slot in place
     * (docs/repl.md section 6) *)
    and LetValue = Tuple
        offset: Int name: String value: Expr symbol: symbols.ValueSymbol isRec: Bool redefines: Bool
    end
    and LetType = Tuple offset: Int name: String symbol: symbols.TypeSymbol end
    and ImportItem = Tuple
        offset: Int
        names: Array(String)
        interfaceName: String
        modulePaths: maybe.T(Array(String))
        interfacePath: maybe.T(String)
        canonicalModulePaths: maybe.T(Array(String))
        symbolIds: maybe.T(Array(maybe.T(Int)))
    end

    Let Program = Tuple offset: Int phrases: Array(Binding) end

    let expr(offset: Int type: model.Type form: ExprForm): Expr =
        tuple let offset = offset let type = type let form = form end

    let binding(offset: Int form: BindingForm): Binding = tuple let offset = offset let form = form end

    let effectiveModulePaths(item: ImportItem): Array(String) = maybe.unwrapOr(:Array(String) item.modulePaths item.names)
    let effectiveInterfacePath(item: ImportItem): String = maybe.unwrapOr(:String item.interfacePath item.interfaceName)
    let effectiveCanonicalModulePaths(item: ImportItem): Array(String) =
        maybe.unwrapOr(:Array(String) item.canonicalModulePaths effectiveModulePaths(item))

    let bindingMembers(b: Binding): Array(Binding) =
        case b.form
            when bindLetValueGroup with g then
                begin
                    let members = vector.new(:Binding)
                    for i = 0 upto {extent g.members - 1} do
                        let m = g.members[i]
                        vector.append(:Binding members binding(m.offset option bindLetValue of BindingForm with let value = m end))
                    end
                    vector.toArray(:Binding members)
                end
            else array of b end
        end

    let declaredName(b: Binding): maybe.T(String) =
        case b.form
            when bindLetValue with x then maybe.some(:String x.value.name)
            when bindLetType with x then maybe.some(:String x.value.name)
            when bindDefKind with x then maybe.some(:String x.name)
            when bindInterface with x then maybe.some(:String x.name)
            when bindModule with x then maybe.some(:String x.name)
            else maybe.none(:String)
        end

    (* ======================================================================
     * Mapping types
     * ====================================================================== *)

    let mapArray(A::TYPE xs: Array(A) g: All(x: A) A): Array(A) =
        begin
            let result = vector.new(:A)
            for i = 0 upto {extent xs - 1} do vector.append(:A result g(xs[i])) end
            vector.toArray(:A result)
        end

    let mapMaybe(A::TYPE x: maybe.T(A) g: All(x: A) A): maybe.T(A) =
        if maybe.isSome(:A x) then maybe.some(:A g(maybe.unwrap(:A x))) else x end

    let rec mapTypes(e: Expr f: All(t: model.Type) model.Type): Expr =
        begin
            let m(x: Expr): Expr = mapTypes(x f)
            let ms(xs: Array(Expr)): Array(Expr) = mapArray(:Expr xs m)
            let mm(x: maybe.T(Expr)): maybe.T(Expr) = mapMaybe(:Expr x m)
            let form = case e.form
                when exprFun with x then
                    option exprFun of ExprForm with
                        let params = mapArray(:Param x.params fun(p: Param): Param
                            tuple
                                let offset = p.offset let name = p.name let symbol = p.symbol let type = f(p.type)
                                let isVar = p.isVar let isOut = p.isOut
                            end)
                        let body = m(x.body)
                        let typeParamIds = x.typeParamIds
                        let typeOnly = x.typeOnly
                    end
                when exprApp with x then option exprApp of ExprForm with let func = m(x.func) let args = ms(x.args) end
                when exprTypeApp with x then
                    option exprTypeApp of ExprForm with
                        let func = m(x.func) let typeArgs = mapArray(:model.Type x.typeArgs f)
                    end
                when exprInfix with x then
                    option exprInfix of ExprForm with let left = m(x.left) let op = x.op let right = m(x.right) end
                when exprRecord with x then
                    option exprRecord of ExprForm with
                        let fields = mapArray(:RecordField x.fields fun(r: RecordField): RecordField
                            tuple let offset = r.offset let name = r.name let value = m(r.value) let isVar = r.isVar end)
                    end
                when exprTypeWitness with x then
                    option exprTypeWitness of ExprForm with
                        let name = x.name let witnessType = f(x.witnessType) let bound = x.bound
                    end
                when exprTuple with x then
                    option exprTuple of ExprForm with
                        let elements = ms(x.elements) let recGroups = x.recGroups
                        let simultaneousGroups = x.simultaneousGroups let labels = x.labels
                    end
                when exprSelect with x then option exprSelect of ExprForm with let target = m(x.target) let field = x.field end
                when exprIndex with x then option exprIndex of ExprForm with let target = m(x.target) let index = m(x.index) end
                when exprIndexAssign with x then
                    option exprIndexAssign of ExprForm with
                        let target = m(x.target) let index = m(x.index) let value = m(x.value)
                    end
                when exprArray with x then option exprArray of ExprForm with let elements = ms(x.elements) end
                when exprArrayRep with x then
                    option exprArrayRep of ExprForm with let count = m(x.count) let initVal = m(x.initVal) end
                when exprVarCell with x then option exprVarCell of ExprForm with let value = m(x.value) end
                when exprDerefCell with x then option exprDerefCell of ExprForm with let target = m(x.target) end
                when exprSelectRef with x then
                    option exprSelectRef of ExprForm with let target = m(x.target) let field = x.field end
                when exprIndexRef with x then
                    option exprIndexRef of ExprForm with let target = m(x.target) let index = m(x.index) end
                when exprTupleSelectRef with x then
                    option exprTupleSelectRef of ExprForm with let target = m(x.target) let index = x.index let field = x.field end
                when exprAssign with x then option exprAssign of ExprForm with let target = m(x.target) let value = m(x.value) end
                when exprVariant with x then option exprVariant of ExprForm with let tag = x.tag let payload = mm(x.payload) end
                when exprOption with x then
                    option exprOption of ExprForm with
                        let tag = x.tag let payload = mm(x.payload) let ordinalExpr = mm(x.ordinalExpr)
                    end
                when exprAuto with x then
                    option exprAuto of ExprForm with
                        let witnessType = f(x.witnessType) let autoType = f(x.autoType) let payload = m(x.payload)
                    end
                when exprVariantCheck with x then
                    option exprVariantCheck of ExprForm with let target = m(x.target) let tag = x.tag end
                when exprVariantAssert with x then
                    option exprVariantAssert of ExprForm with let target = m(x.target) let tag = x.tag end
                when exprCase with x then
                    option exprCase of ExprForm with
                        let target = m(x.target)
                        let branches = mapArray(:CaseBranch x.branches fun(b: CaseBranch): CaseBranch
                            tuple let offset = b.offset let tags = b.tags let body = m(b.body) let binder = b.binder end)
                        let elseBranch = mm(x.elseBranch)
                    end
                when exprInspect with x then
                    option exprInspect of ExprForm with
                        let target = m(x.target)
                        let branches = mapArray(:InspectBranch x.branches fun(b: InspectBranch): InspectBranch
                            tuple
                                let offset = b.offset let matchType = f(b.matchType) let binders = b.binders
                                let body = m(b.body) let exact = b.exact
                            end)
                        let elseBranch = mm(x.elseBranch)
                        let autoType = mapMaybe(:model.Type x.autoType f)
                    end
                when exprBlock with x then
                    option exprBlock of ExprForm with
                        let bindings = mapArray(:Binding x.bindings fun(b: Binding): Binding mapBindingTypes(b f))
                        let result = m(x.result)
                    end
                when exprIf with x then
                    option exprIf of ExprForm with
                        let cond = m(x.cond) let thenBranch = m(x.thenBranch) let elseBranch = m(x.elseBranch)
                    end
                when exprWhile with x then option exprWhile of ExprForm with let cond = m(x.cond) let body = m(x.body) end
                when exprLoop with x then option exprLoop of ExprForm with let body = m(x.body) end
                when exprFor with x then
                    option exprFor of ExprForm with
                        let varName = x.varName let symbol = x.symbol let start = m(x.start) let isDownto = x.isDownto
                        let stop = m(x.stop) let body = m(x.body)
                    end
                when exprException with x then
                    option exprException of ExprForm with
                        let name = x.name let payloadType = mapMaybe(:model.Type x.payloadType f) let symbol = x.symbol
                    end
                when exprRaise with x then option exprRaise of ExprForm with let exc = m(x.exc) let payload = mm(x.payload) end
                when exprTry with x then
                    option exprTry of ExprForm with
                        let body = m(x.body)
                        let branches = mapArray(:TryBranch x.branches fun(b: TryBranch): TryBranch
                            tuple
                                let offset = b.offset let excPattern = m(b.excPattern) let body = m(b.body)
                                let binder = b.binder
                            end)
                        let elseBranch = mm(x.elseBranch)
                        let elseBinder = x.elseBinder
                    end
                else e.form
            end
            expr(e.offset f(e.type) form)
        end
    and mapBindingTypes(b: Binding f: All(t: model.Type) model.Type): Binding =
        begin
            let letValue(v: LetValue): LetValue =
                tuple
                    let offset = v.offset let name = v.name let value = mapTypes(v.value f) let symbol = v.symbol
                    let isRec = v.isRec let redefines = v.redefines
                end
            let bs(xs: Array(Binding)): Array(Binding) = mapArray(:Binding xs fun(x: Binding): Binding mapBindingTypes(x f))
            let form = case b.form
                when bindLetValue with x then option bindLetValue of BindingForm with let value = letValue(x.value) end
                when bindLetValueGroup with x then
                    option bindLetValueGroup of BindingForm with let members = mapArray(:LetValue x.members letValue) end
                when bindExprStmt with x then option bindExprStmt of BindingForm with let expr = mapTypes(x.expr f) end
                when bindInterface with x then
                    option bindInterface of BindingForm with
                        let name = x.name let signatures = bs(x.signatures) let scope = x.scope
                    end
                when bindModule with x then
                    option bindModule of BindingForm with
                        let name = x.name let interfaceName = x.interfaceName let bindings = bs(x.bindings)
                        let scope = x.scope let isPrecompiled = x.isPrecompiled
                        let symbolId = x.symbolId
                    end
                else b.form
            end
            binding(b.offset form)
        end

    (* ======================================================================
     * Named exceptions
     * ====================================================================== *)

    (* The named exceptions made in a node whose names bind in its scope
     * (named_exceptions_in): not inside functions or blocks, which are scopes
     * of their own *)
    Let Found = vector.T(Expr)

    let rec scanExpr(e: Expr found: Found): Ok =
        begin
            let s(x: Expr): Ok = scanExpr(x found)
            let ss(xs: Array(Expr)): Ok = for i = 0 upto {extent xs - 1} do s(xs[i]) end
            let sm(x: maybe.T(Expr)): Ok = if maybe.isSome(:Expr x) then s(maybe.unwrap(:Expr x)) end
            case e.form
                when exprFun then ok
                when exprBlock then ok
                when exprException with x then
                    if stringOp.length(x.name) > 0 then vector.append(:Expr found e) end
                when exprApp with x then begin s(x.func) ss(x.args) end
                when exprTypeApp with x then s(x.func)
                when exprInfix with x then begin s(x.left) s(x.right) end
                when exprRecord with x then for i = 0 upto {extent x.fields - 1} do s(x.fields[i].value) end
                when exprTuple with x then ss(x.elements)
                when exprSelect with x then s(x.target)
                when exprIndex with x then begin s(x.target) s(x.index) end
                when exprIndexAssign with x then begin s(x.target) s(x.index) s(x.value) end
                when exprArray with x then ss(x.elements)
                when exprArrayRep with x then begin s(x.count) s(x.initVal) end
                when exprVarCell with x then s(x.value)
                when exprDerefCell with x then s(x.target)
                when exprSelectRef with x then s(x.target)
                when exprIndexRef with x then begin s(x.target) s(x.index) end
                when exprTupleSelectRef with x then s(x.target)
                when exprAssign with x then begin s(x.target) s(x.value) end
                when exprVariant with x then sm(x.payload)
                when exprOption with x then begin sm(x.payload) sm(x.ordinalExpr) end
                when exprAuto with x then s(x.payload)
                when exprVariantCheck with x then s(x.target)
                when exprVariantAssert with x then s(x.target)
                when exprCase with x then
                    begin
                        s(x.target)
                        for i = 0 upto {extent x.branches - 1} do s(x.branches[i].body) end
                        sm(x.elseBranch)
                    end
                when exprInspect with x then
                    begin
                        s(x.target)
                        for i = 0 upto {extent x.branches - 1} do s(x.branches[i].body) end
                        sm(x.elseBranch)
                    end
                when exprIf with x then begin s(x.cond) s(x.thenBranch) s(x.elseBranch) end
                when exprWhile with x then begin s(x.cond) s(x.body) end
                when exprLoop with x then s(x.body)
                when exprFor with x then begin s(x.start) s(x.stop) s(x.body) end
                when exprRaise with x then begin s(x.exc) sm(x.payload) end
                when exprTry with x then
                    begin
                        s(x.body)
                        for i = 0 upto {extent x.branches - 1} do
                            s(x.branches[i].excPattern)
                            s(x.branches[i].body)
                        end
                        sm(x.elseBranch)
                    end
                else ok
            end
        end

    let rec scanBinding(b: Binding found: Found): Ok =
        case b.form
            when bindLetValue with x then scanExpr(x.value.value found)
            when bindLetValueGroup with x then for i = 0 upto {extent x.members - 1} do scanExpr(x.members[i].value found) end
            when bindExprStmt with x then scanExpr(x.expr found)
            when bindModule with x then for i = 0 upto {extent x.bindings - 1} do scanBinding(x.bindings[i] found) end
            else ok
        end

    (* The exceptions found but the direct one, which a node makes as it runs,
     * and those without symbols *)
    let withoutDirect(found: Found direct: maybe.T(Expr)): Array(Expr) =
        begin
            let result = vector.new(:Expr)
            for i = 0 upto {vector.length(:Expr found) - 1} do
                let exc = vector.get(:Expr found i)
                let isDirect = maybe.isSome(:Expr direct) andif {exc is maybe.unwrap(:Expr direct)}
                let hasSymbol = case exc.form
                    when exprException with x then maybe.isSome(:symbols.ValueSymbol x.symbol)
                    else false
                end
                if not(isDirect) andif hasSymbol then vector.append(:Expr result exc) end
            end
            vector.toArray(:Expr result)
        end

    let scopeExceptions(b: Binding): Array(Expr) =
        begin
            let found = vector.new(:Expr)
            scanBinding(b found)
            let direct = case b.form
                when bindExprStmt with x then maybe.some(:Expr x.expr)
                when bindLetValue with x then maybe.some(:Expr x.value.value)
                else maybe.none(:Expr)
            end
            withoutDirect(found direct)
        end

    let namedExceptionsIn(b: Binding): Array(Expr) =
        begin
            let found = vector.new(:Expr)
            scanBinding(b found)
            vector.toArray(:Expr found)
        end

    let exprScopeExceptions(e: Expr): Array(Expr) =
        begin
            let found = vector.new(:Expr)
            scanExpr(e found)
            withoutDirect(found maybe.some(:Expr e))
        end

    (* A child of a node: an expression or a binding, in the order of the node's
     * fields *)
    Let Child = Option
        childExpr with e: Expr end
        childBinding with b: Binding end
    end

    let ex(e: Expr): Child = option childExpr of Child with let e = e end
    let opt(e: maybe.T(Expr)): Array(Child) =
        if maybe.isSome(:Expr e) then
            array of ex(maybe.unwrap(:Expr e)) end
        else
            array of :Child end
        end
    let exs(es: Array(Expr)): Array(Child) =
        begin
            let children = vector.new(:Child)
            for i = 0 upto {extent es - 1} do vector.append(:Child children ex(es[i])) end
            vector.toArray(:Child children)
        end
    let concat(parts: Array(Array(Child))): Array(Child) =
        begin
            let children = vector.new(:Child)
            for i = 0 upto {extent parts - 1} do
                for j = 0 upto {extent parts[i] - 1} do vector.append(:Child children parts[i][j]) end
            end
            vector.toArray(:Child children)
        end

    let children(e: Expr): Array(Child) =
        case e.form
            when exprFun with x then array of ex(x.body) end
            when exprApp with x then concat(array of array of ex(x.func) end exs(x.args) end)
            when exprTypeApp with x then array of ex(x.func) end
            when exprInfix with x then array of ex(x.left) ex(x.right) end
            when exprRecord with x then
                begin
                    let values = vector.new(:Expr)
                    for i = 0 upto {extent x.fields - 1} do vector.append(:Expr values x.fields[i].value) end
                    exs(vector.toArray(:Expr values))
                end
            when exprTuple with x then exs(x.elements)
            when exprSelect with x then array of ex(x.target) end
            when exprIndex with x then array of ex(x.target) ex(x.index) end
            when exprIndexAssign with x then array of ex(x.target) ex(x.index) ex(x.value) end
            when exprArray with x then exs(x.elements)
            when exprArrayRep with x then array of ex(x.count) ex(x.initVal) end
            when exprVarCell with x then array of ex(x.value) end
            when exprDerefCell with x then array of ex(x.target) end
            when exprSelectRef with x then array of ex(x.target) end
            when exprIndexRef with x then array of ex(x.target) ex(x.index) end
            when exprTupleSelectRef with x then array of ex(x.target) end
            when exprAssign with x then array of ex(x.target) ex(x.value) end
            when exprVariant with x then opt(x.payload)
            when exprOption with x then concat(array of opt(x.payload) opt(x.ordinalExpr) end)
            when exprAuto with x then array of ex(x.payload) end
            when exprVariantCheck with x then array of ex(x.target) end
            when exprVariantAssert with x then array of ex(x.target) end
            when exprCase with x then
                begin
                    let bodies = vector.new(:Expr)
                    for i = 0 upto {extent x.branches - 1} do vector.append(:Expr bodies x.branches[i].body) end
                    concat(array of array of ex(x.target) end exs(vector.toArray(:Expr bodies)) opt(x.elseBranch) end)
                end
            when exprInspect with x then
                begin
                    let bodies = vector.new(:Expr)
                    for i = 0 upto {extent x.branches - 1} do vector.append(:Expr bodies x.branches[i].body) end
                    concat(array of array of ex(x.target) end exs(vector.toArray(:Expr bodies)) opt(x.elseBranch) end)
                end
            when exprBlock with x then
                begin
                    let children = vector.new(:Child)
                    for i = 0 upto {extent x.bindings - 1} do
                        vector.append(:Child children option childBinding of Child with let b = x.bindings[i] end)
                    end
                    vector.append(:Child children ex(x.result))
                    vector.toArray(:Child children)
                end
            when exprIf with x then array of ex(x.cond) ex(x.thenBranch) ex(x.elseBranch) end
            when exprWhile with x then array of ex(x.cond) ex(x.body) end
            when exprLoop with x then array of ex(x.body) end
            when exprFor with x then array of ex(x.start) ex(x.stop) ex(x.body) end
            when exprRaise with x then concat(array of array of ex(x.exc) end opt(x.payload) end)
            when exprTry with x then
                begin
                    let parts = vector.new(:Expr)
                    for i = 0 upto {extent x.branches - 1} do
                        vector.append(:Expr parts x.branches[i].excPattern)
                        vector.append(:Expr parts x.branches[i].body)
                    end
                    concat(array of array of ex(x.body) end exs(vector.toArray(:Expr parts)) opt(x.elseBranch) end)
                end
            else array of :Child end
        end

    let bindingChildren(b: Binding): Array(Child) =
        case b.form
            when bindLetValue with x then array of ex(x.value.value) end
            when bindLetValueGroup with x then
                begin
                    let values = vector.new(:Expr)
                    for i = 0 upto {extent x.members - 1} do vector.append(:Expr values x.members[i].value) end
                    exs(vector.toArray(:Expr values))
                end
            when bindExprStmt with x then array of ex(x.expr) end
            when bindInterface with x then
                begin
                    let children = vector.new(:Child)
                    for i = 0 upto {extent x.signatures - 1} do
                        vector.append(:Child children option childBinding of Child with let b = x.signatures[i] end)
                    end
                    vector.toArray(:Child children)
                end
            when bindModule with x then
                begin
                    let children = vector.new(:Child)
                    for i = 0 upto {extent x.bindings - 1} do
                        vector.append(:Child children option childBinding of Child with let b = x.bindings[i] end)
                    end
                    vector.toArray(:Child children)
                end
            else array of :Child end
        end

    (* The let declarations of a binding *)
    let letValues(b: Binding): Array(LetValue) =
        case b.form
            when bindLetValue with x then array of x.value end
            when bindLetValueGroup with x then x.members
            else array of :LetValue end
        end
end
