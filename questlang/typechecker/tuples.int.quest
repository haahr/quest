(* Quest Self-Hosted Compiler: Tuples Interface
 *
 * The construct of bootstrap/python/quest/typechecker/tuples.py: tuple
 * expressions, whose components may be values, types (Let A = T, the
 * witnesses of a package's abstract types), and the members of declarations
 * a block could hold (let rec, let ... and ..., type groups), with manifest
 * kinds (DEF K = Kind) between them, which are not components. Each
 * component's name is in scope for the components after it (a let ... and
 * ... group's names after its last member). Checked against an expected
 * tuple type, the components must match its fields one for one, and a type
 * component that matches a type formal A::K is hidden behind A; synthesized,
 * the tuple's type shows every type component's definition.
 * docs/type-system.md §4.1 and §4.3 give the rules. *)

interface Tuples
import
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/types/model : questlang/types/Model
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/typechecker/checker : questlang/typechecker/Checker
    util/maybe : util/Maybe
export
    elaborateTuple(c: checker.T x0: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr
end
