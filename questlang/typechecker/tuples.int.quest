(* Quest Self-Hosted Compiler: Tuples Interface
 *
 * This interface elaborates tuple expressions, mirroring
 * bootstrap/python/quest/typechecker/tuples.py. A tuple's components may be
 * values, types (Let A = T, the witnesses of a package's abstract types), and
 * the members of block-style declarations (let rec, let ... and ..., type
 * groups), with manifest kinds (DEF K = Kind) allowed between them without
 * counting as components. Each component's name is in scope for later
 * components (a let ... and ... group's names come into scope after its last
 * member). When checked against an expected tuple type, the components must
 * match its fields one for one, and a type component matching a type formal
 * A::K is hidden behind A; when synthesized, the tuple's type exposes every
 * type component's definition. See docs/type-system.md §4.1 and §4.3. *)

interface Tuples
import
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/types/model : questlang/types/Model
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/typechecker/checker : questlang/typechecker/Checker
    util/maybe : util/Maybe
export
    elaborateTuple(c: checker.T x0: ast.Expr expected: maybe.T(model.Type) e: env.T loopDepth: Int): typedAst.Expr
end
