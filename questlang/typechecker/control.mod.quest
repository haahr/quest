(* Quest Self-Hosted Compiler: Control Flow Implementation *)

module control : Control
import
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
    questlang/types/subtyping : questlang/types/Subtyping
    questlang/types/env : questlang/types/Env
    questlang/types/kinds : questlang/types/Kinds
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/typechecker/checker : questlang/typechecker/Checker
    questlang/typechecker/checks : questlang/typechecker/Checks
    questlang/typechecker/escape : questlang/typechecker/Escape
    questlang/typechecker/elaborateTypes : questlang/typechecker/ElaborateTypes
    questlang/typechecker/bindings : questlang/typechecker/Bindings
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    util/sort : util/Sort
    stringOp = string : StringOp
    conv : Conv
export
    Let Type = model.Type

    let some(e: env.T): kinds.Env = maybe.some(:env.T e)
    let evaluate(t: Type): Type = model.evaluateLazily(t symbols.lookup)
    let isSubtype(a: Type b: Type e: env.T): Bool = subtyping.isSubtype(a b env.lookupOf(e))
    let expr(offset: Int t: Type form: typedAst.ExprForm): typedAst.Expr = typedAst.expr(offset t form)
    let internal(A::TYPE what: String x: ast.Expr): A = diagnostics.fail(:A "internal: not " <> what x.span.startOffset)
    let okExpr(offset: Int): typedAst.Expr = expr(offset model.okType option exprOk of typedAst.ExprForm end)
    let notDesugared(A::TYPE className: String x: ast.Expr): A =
        diagnostics.raiseError(:A checks.notDesugared(className x.span.startOffset))
    let newIds(): hashMap.T(Int Bool) = hashMap.new(:Int :Bool fun(a: Int b: Int): Bool a is b hash.int)

    (* =========================================================================
     * Case
     * ========================================================================= *)

    Let Tag = Tuple name: String payload: maybe.T(Type) end

    let optionTags(options: Array(model.OptionField)): Array(Tag) =
        begin
            let tags = vector.new(:Tag)
            for i = 0 upto {extent options - 1} do
                vector.append(:Tag tags tuple let name = options[i].name let payload = options[i].payload end)
            end
            vector.toArray(:Tag tags)
        end

    let variantTags(variants: Array(model.VariantField)): Array(Tag) =
        begin
            let tags = vector.new(:Tag)
            for i = 0 upto {extent variants - 1} do
                vector.append(:Tag tags tuple let name = variants[i].name let payload = variants[i].type end)
            end
            vector.toArray(:Tag tags)
        end

    (* Validates tags, binders, and exhaustiveness, and elaborates the branches *)
    let elaborateCaseBranches(
        c: checker.T x0: ast.Expr target: ast.Expr branches: vector.T(ast.CaseBranch) elseBranch: maybe.T(ast.Expr)
        targetType: Type expected: maybe.T(Type) e: env.T loopDepth: Int
    ): Array(typedAst.CaseBranch) =
        begin
            let failed(): Array(Tag) =
                diagnostics.fail(:Array(Tag) "Case target must have Option or Variant type, got '" <> model.show(targetType) <>
                    "'" target.span.startOffset)
            let tags = case targetType.form
                when typeOption with o then optionTags(o.options)
                when typeVariant with v then variantTags(v.variants)
                else
                    begin
                        let bound = kinds.resolveSumBound(targetType some(e))
                        if maybe.isSome(:Type bound) then
                            case maybe.unwrap(:Type bound).form
                                when typeVariant with v then variantTags(v.variants)
                                when typeOption with o then optionTags(o.options)
                                else failed()
                            end
                        else
                            failed()
                        end
                    end
            end
            let available = hashMap.new(:String :Tag stringOp.equal hash.string)
            for i = 0 upto {extent tags - 1} do hashMap.insert(:String :Tag available tags[i].name tags[i]) end
            let covered = hashMap.new(:String :Bool stringOp.equal hash.string)
            let typed = vector.new(:typedAst.CaseBranch)
            for i = 0 upto {vector.length(:ast.CaseBranch branches) - 1} do
                let branch = vector.get(:ast.CaseBranch branches i)
                for j = 0 upto {vector.length(:String branch.tags) - 1} do
                    let tag = vector.get(:String branch.tags j)
                    if not(hashMap.contains(:String :Tag available tag)) then
                        diagnostics.fail(:Ok "Tag '" <> tag <> "' is not a valid variant of type '" <> model.show(targetType) <>
                            "'" branch.offset)
                    end
                    hashMap.insert(:String :Bool covered tag true)
                end
                Let Arm = Tuple body: typedAst.Expr binder: maybe.T(symbols.ValueSymbol) end
                let arm: Arm = if maybe.isSome(:String branch.binder) then
                    let binder = maybe.unwrap(:String branch.binder)
                    let firstTag = vector.get(:String branch.tags 0)
                    let firstPayload = hashMap.find(:String :Tag available firstTag).payload
                    if maybe.isNone(:Type firstPayload) then
                        diagnostics.fail(:Ok "Tag '" <> firstTag <> "' has no payload to bind to '" <> binder <> "'" branch.offset)
                    end
                    let payload = maybe.unwrap(:Type firstPayload)
                    let binderT = if maybe.isSome(:ast.TypeExpr branch.binderType) then
                        let t = elaborateTypes.elaborateType(maybe.unwrap(:ast.TypeExpr branch.binderType) e)
                        if not(isSubtype(payload t e)) then
                            diagnostics.fail(:Ok "Binder '" <> binder <> "' type '" <> model.show(t) <>
                                "' is not compatible with payload '" <> model.show(payload) <> "'" branch.offset)
                        end
                        t
                    else
                        payload
                    end
                    env.scoped(:Arm e "case_" <> binder fun(s: symbols.Scope): Arm
                        begin
                            let sym = symbols.newValueSymbol(binder binderT false false false c.functionDepth 0)
                            symbols.declareValue(e.currentScope sym)
                            let body = checker.elaborateSubexpr(c branch.body expected e loopDepth)
                            if maybe.isNone(:Type expected) then
                                let ids = newIds()
                                hashMap.insert(:Int :Bool ids sym.symbolId true)
                                escape.checkNoEscapingPathTypes(body.type ids "case branch scope" branch.body.span.startOffset)
                            end
                            tuple let body = body let binder = maybe.some(:symbols.ValueSymbol sym) end
                        end)
                else
                    tuple
                        let body = checker.elaborateSubexpr(c branch.body expected e loopDepth)
                        let binder = maybe.none(:symbols.ValueSymbol)
                    end
                end
                vector.append(:typedAst.CaseBranch typed tuple
                    let offset = branch.offset let tags = vector.toArray(:String branch.tags) let body = arm.body
                    let binder = arm.binder
                end)
            end
            if maybe.isNone(:ast.Expr elseBranch) then
                let missing = vector.new(:String)
                for i = 0 upto {extent tags - 1} do
                    if not(hashMap.contains(:String :Bool covered tags[i].name)) then
                        vector.append(:String missing tags[i].name)
                    end
                end
                if not(vector.empty(:String missing)) then
                    sort.sortVector(:String missing sort.stringCompare)
                    let var joined = ""
                    for i = 0 upto {vector.length(:String missing) - 1} do
                        joined := if i is 0 then vector.get(:String missing i) else joined <> ", " <> vector.get(:String missing i) end
                    end
                    diagnostics.fail(:Ok "Non-exhaustive case expression missing tags: " <> joined x0.span.startOffset)
                end
            end
            vector.toArray(:typedAst.CaseBranch typed)
        end

    let elaborateCase(c: checker.T x0: ast.Expr expected: maybe.T(Type) e: env.T loopDepth: Int): typedAst.Expr =
        case x0.form
            when exprCase with x then
                begin
                    let targetTyped = checker.synthExpr(c x.target e loopDepth)
                    let targetType = evaluate(targetTyped.type)
                    let branches = elaborateCaseBranches(c x0 x.target x.branches x.elseBranch targetType expected e loopDepth)
                    let elseTyped = checker.elaborateOptionalBranch(c x.elseBranch expected e loopDepth)
                    let bodies = vector.new(:typedAst.Expr)
                    for i = 0 upto {extent branches - 1} do vector.append(:typedAst.Expr bodies branches[i].body) end
                    let types = checker.branchTypes(maybe.none(:Type) vector.toArray(:typedAst.Expr bodies) elseTyped)
                    let resultType = if maybe.isSome(:Type expected) then
                        maybe.unwrap(:Type expected)
                    elsif extent types > 0 then
                        checks.joinTypes(types e x0.span.startOffset
                            maybe.some(:String "Cannot find common supertype join for case branch types '{t1}' and '{t2}'"))
                    else
                        model.okType
                    end
                    expr(x0.span.startOffset resultType option exprCase of typedAst.ExprForm with
                        let target = targetTyped let branches = branches let elseBranch = elseTyped
                    end)
                end
            else internal(:typedAst.Expr "a case" x0)
        end

    (* =========================================================================
     * Infix operators and assignment
     * ========================================================================= *)

    let infixForm(left: typedAst.Expr op: String right: typedAst.Expr): typedAst.ExprForm =
        option exprInfix of typedAst.ExprForm with let left = left let op = op let right = right end

    let assignForm(target: typedAst.Expr value: typedAst.Expr): typedAst.ExprForm =
        option exprAssign of typedAst.ExprForm with let target = target let value = value end

    let synthAssignment(c: checker.T x0: ast.Expr left: ast.Expr right: ast.Expr e: env.T loopDepth: Int): typedAst.Expr =
        begin
            let offset = x0.span.startOffset
            case left.form
                (* Target 1: a variable *)
                when exprId with id then
                    begin
                        let idOff = left.span.startOffset
                        let found = checker.lookupValue(c e id.name)
                        if maybe.isNone(:symbols.ValueSymbol found) then
                            diagnostics.fail(:Ok "Undefined variable '" <> id.name <> "'" idOff)
                        end
                        let sym = maybe.unwrap(:symbols.ValueSymbol found)
                        checker.checkCapturable(c sym idOff)
                        if not(sym.isVar) andif not(sym.isOut) then
                            diagnostics.fail(:Ok "Cannot assign to immutable variable '" <> id.name <> "'" idOff)
                        end
                        let targetNode = expr(idOff model.varType(sym.type) option exprVar of typedAst.ExprForm with
                            let name = sym.name let symbol = sym
                        end)
                        let rhsTyped = checker.checkExpr(c right sym.type e loopDepth)
                        expr(offset model.okType assignForm(targetNode rhsTyped))
                    end
                (* Target 2: a record or tuple field (r.field := rhs, t.field := rhs) *)
                when exprSelect with sel then
                    begin
                        let selOff = left.span.startOffset
                        let field = sel.field
                        let targetTyped = checker.synthExpr(c sel.target e loopDepth)
                        let var targetType = evaluate(targetTyped.type)
                        let isTuple = case targetType.form when typeTuple then true else false end
                        if not(isTuple) andif maybe.isNone(:Type kinds.resolveRecordBound(targetType some(e))) then
                            (* A type parameter bounded by a tuple type: assigned through as its bound *)
                            targetType := maybe.unwrapOr(:Type kinds.resolveTupleBound(targetType some(e)) targetType)
                        end
                        case targetType.form
                            when typeTuple with t then
                                begin
                                    let fields = model.tupleValueFields(t.fields)
                                    let var index = ~1
                                    for i = {extent fields - 1} downto 0 do
                                        let f = fields[i]
                                        let istr = conv.int(i)
                                        let named = maybe.isSome(:String f.name) andif stringOp.equal(maybe.unwrap(:String f.name) field)
                                        let underscored = {stringOp.length(field) > 1} andif
                                            stringOp.equal(stringOp.getSub(field 0 1) "_") andif
                                            stringOp.equal(stringOp.getSub(field 1 {stringOp.length(field) - 1}) istr)
                                        if named orif stringOp.equal(istr field) orif underscored then index := i end
                                    end
                                    if index < 0 then
                                        diagnostics.fail(:Ok "Tuple type '" <> model.show(targetType) <> "' has no field named '" <>
                                            field <> "'" selOff)
                                    end
                                    let f = fields[index]
                                    if not(f.isVar) then
                                        diagnostics.fail(:Ok "Cannot assign to immutable tuple field '" <> field <> "'" selOff)
                                    end
                                    let rhsTyped = checker.checkExpr(c right f.type e loopDepth)
                                    let targetSelect = expr(selOff f.type option exprSelect of typedAst.ExprForm with
                                        let target = targetTyped let field = field
                                    end)
                                    expr(offset model.okType assignForm(targetSelect rhsTyped))
                                end
                            else
                                begin
                                    let recBound = kinds.resolveRecordBound(targetType some(e))
                                    if maybe.isNone(:Type recBound) then
                                        diagnostics.fail(:Ok "Cannot mutate field of non-record type '" <> model.show(targetType) <>
                                            "'" selOff)
                                    end
                                    let fields = case maybe.unwrap(:Type recBound).form
                                        when typeRecord with r then r.fields
                                        else array of :model.RecordField end
                                    end
                                    let found = model.recordGetField(fields field)
                                    if maybe.isNone(:model.RecordField found) then
                                        diagnostics.fail(:Ok "Record has no field '" <> field <> "'" selOff)
                                    end
                                    let f = maybe.unwrap(:model.RecordField found)
                                    if not(f.isVar) then
                                        diagnostics.fail(:Ok "Cannot assign to immutable record field '" <> field <> "'" selOff)
                                    end
                                    let rhsTyped = checker.checkExpr(c right f.type e loopDepth)
                                    let targetSelect = expr(selOff f.type option exprSelect of typedAst.ExprForm with
                                        let target = targetTyped let field = field
                                    end)
                                    expr(offset model.okType assignForm(targetSelect rhsTyped))
                                end
                        end
                    end
                (* Desugaring has made an assignment to an array element an index assignment *)
                when exprIndex then notDesugared(:typedAst.Expr "ExprInfix" x0)
                else
                    diagnostics.fail(:typedAst.Expr "Assignment target must be a mutable variable or field" left.span.startOffset)
            end
        end

    let synthInfix(c: checker.T x0: ast.Expr e: env.T loopDepth: Int): typedAst.Expr =
        case x0.form
            when exprInfix with x then
                begin
                    let offset = x0.span.startOffset
                    let op = x.op
                    let infix = env.infixOperator(op)
                    if stringOp.equal(op ":=") then
                        synthAssignment(c x0 x.left x.right e loopDepth)
                    elsif stringOp.equal(op "andif") orif stringOp.equal(op "orif") then
                        notDesugared(:typedAst.Expr "ExprInfix" x0)
                    elsif maybe.isSome(:env.InfixOperator infix) then
                        let o = maybe.unwrap(:env.InfixOperator infix)
                        let leftTyped = checker.checkExpr(c x.left o.left e loopDepth)
                        let rightTyped = checker.checkExpr(c x.right o.right e loopDepth)
                        expr(offset o.result infixForm(leftTyped op rightTyped))
                    elsif stringOp.equal(op "is") orif stringOp.equal(op "isnot") then
                        let leftTyped = checker.synthExpr(c x.left e loopDepth)
                        let rightTyped = checker.synthExpr(c x.right e loopDepth)
                        if isSubtype(leftTyped.type rightTyped.type e) orif isSubtype(rightTyped.type leftTyped.type e) then
                            expr(offset model.boolType infixForm(leftTyped op rightTyped))
                        else
                            diagnostics.fail(:typedAst.Expr "Equality operator '" <> op <>
                                "' requires operands of compatible types, got '" <> model.show(leftTyped.type) <> "' and '" <>
                                model.show(rightTyped.type) <> "'" offset)
                        end
                    elsif stringOp.equal(op "==") orif stringOp.equal(op "!=") then
                        let suggest = if stringOp.equal(op "==") then "is" else "isnot" end
                        diagnostics.fail(:typedAst.Expr "Operator '" <> op <> "' is not supported; use '" <> suggest <>
                            "' instead" offset)
                    else
                        (* Other infix operators are desugared into calls: a op b is op(a, b) *)
                        notDesugared(:typedAst.Expr "ExprInfix" x0)
                    end
                end
            else internal(:typedAst.Expr "an infix expression" x0)
        end

    (* =========================================================================
     * Conditionals and loops
     * ========================================================================= *)

    let elaborateIf(c: checker.T x0: ast.Expr expected0: maybe.T(Type) e: env.T loopDepth: Int): typedAst.Expr =
        case x0.form
            when exprIf with x then
                begin
                    let offset = x0.span.startOffset
                    if not(vector.empty(:ast.ElsifBranch x.elsifs)) then notDesugared(:Ok "ExprIf" x0) end
                    let expected = if x.shortCircuit then maybe.some(:Type model.boolType) else expected0 end
                    let condTyped = checker.checkExpr(c x.cond model.boolType e loopDepth)
                    let ifForm(thenBranch: typedAst.Expr elseBranch: typedAst.Expr): typedAst.ExprForm =
                        option exprIf of typedAst.ExprForm with
                            let cond = condTyped let thenBranch = thenBranch let elseBranch = elseBranch
                        end
                    if maybe.isNone(:Type expected) andif maybe.isNone(:ast.Expr x.elseBranch) then
                        let thenTyped = checker.synthExpr(c x.thenBranch e loopDepth)
                        let thenOffset = thenTyped.offset
                        let stmt = typedAst.binding(thenOffset option bindExprStmt of typedAst.BindingForm with
                            let expr = thenTyped
                        end)
                        let thenBody = expr(thenOffset model.okType option exprBlock of typedAst.ExprForm with
                            let bindings = array of stmt end let result = okExpr(thenOffset)
                        end)
                        expr(offset model.okType ifForm(thenBody okExpr(offset)))
                    else
                        let thenTyped = checker.elaborateSubexpr(c x.thenBranch expected e loopDepth)
                        let elseTyped = checker.elaborateSubexpr(c maybe.unwrap(:ast.Expr x.elseBranch) expected e loopDepth)
                        let resultType = if maybe.isSome(:Type expected) then
                            maybe.unwrap(:Type expected)
                        else
                            checks.joinTypes(array of thenTyped.type elseTyped.type end e offset
                                maybe.some(:String "Cannot find common supertype for conditional branches '{t1}' and '{t2}'"))
                        end
                        expr(offset resultType ifForm(thenTyped elseTyped))
                    end
                end
            else internal(:typedAst.Expr "a conditional" x0)
        end

    let synthFor(c: checker.T x0: ast.Expr e: env.T loopDepth: Int): typedAst.Expr =
        case x0.form
            when exprFor with x then
                begin
                    let startTyped = checker.checkExpr(c x.start model.intType e loopDepth)
                    let stopTyped = checker.checkExpr(c x.stop model.intType e loopDepth)
                    Let Loop = Tuple sym: symbols.ValueSymbol body: typedAst.Expr end
                    let looped = env.scoped(:Loop e "for_" <> x.varName fun(s: symbols.Scope): Loop
                        begin
                            let sym = symbols.newValueSymbol(x.varName model.intType false false false c.functionDepth 0)
                            symbols.declareValue(e.currentScope sym)
                            c.loopDepth := loopDepth
                            let body = checker.inLoop(:typedAst.Expr c fun(): typedAst.Expr
                                checker.synthExpr(c x.body e c.loopDepth))
                            tuple let sym = sym let body = body end
                        end)
                    expr(x0.span.startOffset model.okType option exprFor of typedAst.ExprForm with
                        let varName = x.varName let symbol = looped.sym let start = startTyped let isDownto = x.isDownto
                        let stop = stopTyped let body = looped.body
                    end)
                end
            else internal(:typedAst.Expr "a for loop" x0)
        end

    (* =========================================================================
     * Blocks
     * ========================================================================= *)

    (* A block ending with an expression statement has that expression's value, which is checked against the expected
     * type if there is one; otherwise the block's type is Ok, which must then be a subtype of the expected type. A
     * synthesized type may not mention the block's own bindings. *)
    let elaborateBlock(c: checker.T x0: ast.Expr expected: maybe.T(Type) e: env.T loopDepth: Int): typedAst.Expr =
        case x0.form
            when exprBlock with x then
                env.scoped(:typedAst.Expr e "block" fun(blockScope: symbols.Scope): typedAst.Expr
                    begin
                        let offset = x0.span.startOffset
                        let n = vector.length(:ast.Decl x.bindings)
                        let typed = vector.new(:typedAst.Binding)
                        let state = tuple let var failed = false end
                        let add(b: maybe.T(typedAst.Binding)): Ok =
                            if maybe.isSome(:typedAst.Binding b) then
                                vector.append(:typedAst.Binding typed maybe.unwrap(:typedAst.Binding b))
                            else
                                state.failed := true
                            end
                        for i = 0 upto {n - 2} do
                            add(bindings.elaborateRecovering(c vector.get(:ast.Decl x.bindings i) e loopDepth))
                        end
                        let var result = maybe.none(:typedAst.Expr)
                        if n > 0 then
                            let last = vector.get(:ast.Decl x.bindings {n - 1})
                            case last.form
                                when declExprStmt with s then
                                    begin
                                        result := checker.attempt(:typedAst.Expr c fun(): typedAst.Expr
                                            checker.elaborateSubexpr(c s.expr expected e loopDepth))
                                        if maybe.isNone(:typedAst.Expr result) then state.failed := true end
                                    end
                                else
                                    begin
                                        add(bindings.elaborateRecovering(c last e loopDepth))
                                        (* Synthesized, a block also has the value of an exception declaration it ends with *)
                                        if not(state.failed) andif maybe.isNone(:Type expected) then
                                            case vector.last(:typedAst.Binding typed).form
                                                when bindExprStmt with s then
                                                    begin
                                                        vector.pop(:typedAst.Binding typed)
                                                        result := maybe.some(:typedAst.Expr s.expr)
                                                    end
                                                else ok
                                            end
                                        end
                                    end
                            end
                        end
                        (* A binding that failed was reported: the block fails without another error *)
                        if state.failed then diagnostics.raiseError(:Ok diagnostics.silentError) end
                        if maybe.isNone(:typedAst.Expr result) then
                            if maybe.isSome(:Type expected) andif not(isSubtype(model.okType maybe.unwrap(:Type expected) e)) then
                                let what = if n > 0 then "Block ending with declaration" else "Empty block" end
                                diagnostics.fail(:Ok what <> " has type Ok, not expected type '" <>
                                    model.show(maybe.unwrap(:Type expected)) <> "'" offset)
                            end
                            result := maybe.some(:typedAst.Expr okExpr(offset))
                        end
                        let resultExpr = maybe.unwrap(:typedAst.Expr result)
                        let resultType = if maybe.isSome(:Type expected) then
                            maybe.unwrap(:Type expected)
                        else
                            let ids = newIds()
                            let values = hashMap.values(:String :symbols.ValueSymbol blockScope.values)
                            for i = 0 upto {vector.length(:symbols.ValueSymbol values) - 1} do
                                hashMap.insert(:Int :Bool ids vector.get(:symbols.ValueSymbol values i).symbolId true)
                            end
                            escape.checkNoEscapingPathTypes(resultExpr.type ids "its scope" resultExpr.offset)
                            resultExpr.type
                        end
                        expr(offset resultType option exprBlock of typedAst.ExprForm with
                            let bindings = vector.toArray(:typedAst.Binding typed) let result = resultExpr
                        end)
                    end)
            else internal(:typedAst.Expr "a block" x0)
        end
end
