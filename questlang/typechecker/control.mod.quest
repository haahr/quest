(* Quest Self-Hosted Compiler: Control Flow Implementation *)

module control : Control
import
    conv : Conv
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/iter : util/Iter
    util/maybe : util/Maybe
    util/sort : util/Sort

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/maps : questlang/common/Maps
    questlang/syntax/ast : questlang/syntax/AST
    questlang/typechecker/bindings : questlang/typechecker/Bindings
    questlang/typechecker/checker : questlang/typechecker/Checker
    questlang/typechecker/checks : questlang/typechecker/Checks
    questlang/typechecker/elaborateTypes : questlang/typechecker/ElaborateTypes
    questlang/typechecker/escape : questlang/typechecker/Escape
    questlang/typechecker/nearMiss : questlang/typechecker/NearMiss
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
    questlang/types/kinds : questlang/types/Kinds
    questlang/types/model : questlang/types/Model
    questlang/types/subtyping : questlang/types/Subtyping
    questlang/types/symbols : questlang/types/Symbols
export
    Let Type = model.Type

    let okExpr(offset: Int): typedAst.Expr = typedAst.expr(offset model.okType option exprOk of typedAst.ExprForm end)
    let newIds(): maps.IntSet = maps.newIntSet()

    (* ======================================================================
     * Case
     * ====================================================================== *)

    Let Tag = Tuple name: String payload: maybe.T(Type) end

    let optionTags(options: Array(model.OptionField)): Array(Tag) =
        begin
            let tags = vector.new(:Tag)
            for i = 0 upto {extent options - 1} do
                vector.append(tags tuple let name = options[i].name let payload = options[i].payload end)
            end
            vector.toArray(tags)
        end

    let variantTags(variants: Array(model.VariantField)): Array(Tag) =
        begin
            let tags = vector.new(:Tag)
            for i = 0 upto {extent variants - 1} do
                vector.append(tags tuple let name = variants[i].name let payload = variants[i].type end)
            end
            vector.toArray(tags)
        end

    (* Checks a case expression's branches against the cases of its target's
     * type, and elaborates each branch's body.
     *
     * A case expression chooses a branch by the tag of an option or variant
     * value, and a branch may bind the tag's payload to a name, its binder:
     *
     *     Let Shape = Option
     *         circle with r: Int end
     *         rect with w: Int h: Int end
     *         point
     *     end;
     *     let area(s: Shape): Int =
     *         case s
     *             when circle with c then 3 * c.r * c.r
     *             when rect with b: Tuple w: Int end then b.w * b.w
     *             else 0
     *         end;
     *
     * The target's type must be an option or variant type, or have one as its
     * bound (kinds.resolveSumBound: an abstract type A <: Shape, say). Then:
     *
     * - Every tag a branch names must be one of the type's cases; a branch may
     *   name several (when circle, rect then ...).
     * - A binder is typed by its tag's payload, the tuple circle carries, or
     *   by the type it is declared with, which must be a supertype of the
     *   payload: b sees only rect's w. The paper reads a branch naming several
     *   tags as one branch per tag, its binder getting the same type in each
     *   (docs/TypefulProgramming.md section 4.5). So a declared type must be a
     *   supertype of every tag's payload, and without one the payloads must
     *   all be equal types.
     * - Each body is checked against the expected type if there is one, and
     *   otherwise synthesized, its caller joining the branches' types. A
     *   synthesized type must not mention a type component of the binder (as
     *   c.T for a payload Tuple T::TYPE x: T end), which means nothing outside
     *   the branch (escape.checkNoEscapingPathTypes).
     * - Without an else branch, every case must be covered: here, point's
     *   branch could be left out only because of the else. *)
    let elaborateCaseBranches(
            c: checker.T x0: ast.Expr target: ast.Expr branches: vector.T(ast.CaseBranch) elseBranch: maybe.T(ast.Expr)
            targetType: Type expected: maybe.T(Type)
            ): Array(typedAst.CaseBranch) =
        begin
            let failed(): Array(Tag) =
                diagnostics.fail("Case target must have Option or Variant type, got '" <> model.show(targetType)
                    <> "'" target.span.startOffset)
            let tags =
                case targetType.form
                    when typeOption with o then optionTags(o.options)
                    when typeVariant with v then variantTags(v.variants)
                    else
                        begin
                            let bound = kinds.resolveSumBound(targetType maybe.some(c.env))
                            if maybe.isSome(bound) then
                                case maybe.unwrap(bound).form
                                    when typeVariant with v then variantTags(v.variants)
                                    when typeOption with o then optionTags(o.options)
                                    else failed()
                                end
                            else
                                failed()
                            end
                        end
                end
            let available = maps.newStringMap(:Tag)
            for i = 0 upto {extent tags - 1} do hashMap.insert(available tags[i].name tags[i]) end
            let covered = maps.newStringSet()
            let typed = vector.new(:typedAst.CaseBranch)
            for i = 0 upto {vector.length(branches) - 1} do
                let branch = vector.get(branches i)
                for j = 0 upto {vector.length(branch.tags) - 1} do
                    let tag = vector.get(branch.tags j)
                    if not(hashMap.contains(available tag)) then
                        diagnostics.fail(:Ok "Tag '" <> tag <> "' is not a valid variant of type '"
                            <> model.show(targetType)
                            <> "'" branch.offset)
                    end
                    hashSet.insert(covered tag)
                end
                Let Arm = Tuple body: typedAst.Expr binder: maybe.T(symbols.ValueSymbol) end
                let arm: Arm =
                    if maybe.isSome(branch.binder) then
                        let binder = maybe.unwrap(branch.binder)
                        let tagCount = vector.length(branch.tags)
                        let payloads = vector.new(:Type)
                        for j = 0 upto {tagCount - 1} do
                            let tag = vector.get(branch.tags j)
                            let payload = hashMap.find(available tag).payload
                            if maybe.isNone(payload) then
                                diagnostics.fail(:Ok "Tag '" <> tag <> "' has no payload to bind to '" <> binder
                                    <> "'" branch.offset)
                            end
                            vector.append(payloads maybe.unwrap(payload))
                        end
                        let binderT =
                            if maybe.isSome(branch.binderType) then
                                let t = elaborateTypes.elaborateType(maybe.unwrap(branch.binderType) c.env)
                                for j = 0 upto {tagCount - 1} do
                                    let payload = vector.get(payloads j)
                                    if not(checks.isSubtype(payload t)) then
                                        diagnostics.fail(:Ok "Binder '" <> binder <> "' type '" <> model.show(t)
                                            <> "' is not compatible with payload '" <> model.show(payload)
                                            <> "'" branch.offset)
                                    end
                                end
                                t
                            else
                                let first = vector.get(payloads 0)
                                for j = 1 upto {tagCount - 1} do
                                    let payload = vector.get(payloads j)
                                    if not(subtyping.isTypeEqual(first payload env.symbolLookup)) then
                                        diagnostics.fail(:Ok "Binder '" <> binder <> "' would have payload type '"
                                            <> model.show(first)
                                            <> "' for tag '" <> vector.get(branch.tags 0) <> "' but '"
                                            <> model.show(payload)
                                            <> "' for tag '" <> vector.get(branch.tags j) <> "'; declare a type for it"
                                                branch.offset)
                                    end
                                end
                                first
                            end
                        env.localScoped(c.env "case_" <> binder fun(s: symbols.Scope): Arm
                            begin
                                let sym = symbols.newValueSymbol(binder binderT false false false c.functionDepth 0)
                                symbols.declareValue(c.env.currentScope sym)
                                let body = checker.elaborateSubexpr(c branch.body expected)
                                if maybe.isNone(expected) then
                                    let ids = newIds()
                                    hashSet.insert(ids sym.symbolId)
                                    escape.checkNoEscapingPathTypes(body.type ids "case branch scope"
                                            branch.body.span.startOffset)
                                end
                                tuple let body = body let binder = maybe.some(sym) end
                            end)
                    else
                        tuple
                            let body = checker.elaborateSubexpr(c branch.body expected)
                            let binder = maybe.none()
                        end
                    end
                vector.append(typed tuple
                    let offset = branch.offset
                    let tags = vector.toArray(branch.tags)
                    let body = arm.body
                    let binder = arm.binder
                end)
            end
            if maybe.isNone(elseBranch) then
                let missing = vector.new(:String)
                for i = 0 upto {extent tags - 1} do
                    if not(hashSet.contains(covered tags[i].name)) then
                        vector.append(missing tags[i].name)
                    end
                end
                if not(vector.empty(missing)) then
                    sort.sortVector(missing sort.stringCompare)
                    let var joined = ""
                    for i = 0 upto {vector.length(missing) - 1} do
                        joined := if i is 0 then vector.get(missing i) else joined <> ", " <> vector.get(missing i) end
                    end
                    diagnostics.fail(:Ok "Non-exhaustive case expression missing tags: " <> joined x0.span.startOffset)
                end
            end
            vector.toArray(typed)
        end

    let elaborateCase(c: checker.T x0: ast.Expr expected: maybe.T(Type)): typedAst.Expr =
        case x0.form
            when exprCase with x then
                begin
                    let targetTyped = checker.synthExpr(c x.target)
                    let targetType = checks.evaluate(targetTyped.type)
                    let branches = elaborateCaseBranches(c x0 x.target x.branches x.elseBranch targetType expected)
                    let elseTyped = checker.elaborateOptionalBranch(c x.elseBranch expected)
                    let bodies = vector.new(:typedAst.Expr)
                    for i = 0 upto {extent branches - 1} do vector.append(bodies branches[i].body) end
                    let joined: checker.JoinedBodies =
                        if maybe.isSome(expected) then
                            tuple
                                let type = maybe.unwrap(expected)
                                let initial = maybe.none()
                                let bodies = vector.toArray(bodies)
                                let elseBranch = elseTyped
                            end
                        else
                            checker.joinBodies(maybe.none() vector.toArray(bodies) elseTyped c.env x0.span.startOffset
                                    "Cannot find common supertype join for case branch types '{t1}' and '{t2}'")
                        end
                    let joinedBranches = vector.new(:typedAst.CaseBranch)
                    for i = 0 upto {extent branches - 1} do
                        let b = branches[i]
                        vector.append(joinedBranches tuple
                            let offset = b.offset
                            let tags = b.tags
                            let body = joined.bodies[i]
                            let binder = b.binder
                        end)
                    end
                    typedAst.expr(x0.span.startOffset joined.type option exprCase of typedAst.ExprForm with
                        let target = targetTyped
                        let branches = vector.toArray(joinedBranches)
                        let elseBranch = joined.elseBranch
                    end)
                end
            else checks.unexpected("a case" x0.span.startOffset)
        end

    (* ======================================================================
     * Infix operators and assignment
     * ====================================================================== *)

    let infixForm(left: typedAst.Expr op: String right: typedAst.Expr): typedAst.ExprForm =
        option exprInfix of typedAst.ExprForm with let left = left let op = op let right = right end

    let assignForm(target: typedAst.Expr value: typedAst.Expr): typedAst.ExprForm =
        option exprAssign of typedAst.ExprForm with let target = target let value = value end

    (* Synthesizes an assignment, target := value, whose type is Ok.
     *
     * Only a mutable location can be assigned, and there are two kinds of
     * target:
     *
     *     let var n = 0;
     *     let p = tuple let var x = 1 let y = 2 end;
     *     n := 1;          (* a variable declared var, or an out parameter *)
     *     p.x := n + 1;    (* a component of a tuple or record declared var *)
     *
     * In each case the value is checked against the location's type, which is
     * the variable's type, not the type Var(Int) the target has as a location
     * (the exprVar node built below). A component is found in the target's
     * type: a tuple type, a record type, or a type bounded by one, so that a
     * function over A <: Record var count: Int end can assign a.count.
     *
     * The target variable must be one the code may refer to
     * (checker.checkCapturable): a closure may not assign a var or out
     * parameter of an enclosing function, which is the address of its
     * caller's location, and no function may assign a global var variable
     * directly. A closure may assign a local var variable of an enclosing
     * function, which the lowering boxes so that both share it:
     *
     *     let h(): Ok = begin let var m = 0 let g(): Ok = m := 2 g() end;
     *
     * Assignments to array elements, a[i] := v, never reach here: desugaring
     * made them exprIndexAssign nodes. *)
    let synthAssignment(c: checker.T x0: ast.Expr left: ast.Expr right: ast.Expr
            ): typedAst.Expr =
        begin
            let offset = x0.span.startOffset
            case left.form
                (* Target 1: a variable *)
                when exprId with id then
                    begin
                        let idOff = left.span.startOffset
                        let found = checker.lookupValue(c id.name)
                        if maybe.isNone(found) then
                            diagnostics.failWithHelp(:Ok "Undefined variable '" <> id.name <> "'" idOff
                                    nearMiss.valueHelp(c.env id.name))
                        end
                        let sym = maybe.unwrap(found)
                        checker.checkCapturable(c sym idOff)
                        if not(sym.isVar) andif not(sym.isOut) then
                            diagnostics.fail(:Ok "Cannot assign to immutable variable '" <> id.name <> "'" idOff)
                        end
                        let targetNode =
                            typedAst.expr(idOff model.varType(sym.type) option exprVar of typedAst.ExprForm with
                                let name = sym.name
                                let symbol = sym
                            end)
                        let rhsTyped = checker.checkExpr(c right sym.type)
                        typedAst.expr(offset model.okType assignForm(targetNode rhsTyped))
                    end
                (* Target 2: a record or tuple field (r.field := rhs, t.field :=
                 * rhs) *)
                when exprSelect with sel then
                    begin
                        let selOff = left.span.startOffset
                        let field = sel.field
                        let targetTyped = checker.synthExpr(c sel.target)
                        let var targetType = checks.evaluate(targetTyped.type)
                        let isTuple = case targetType.form when typeTuple then true else false end
                        if not(isTuple) andif maybe.isNone(kinds.resolveRecordBound(targetType maybe.some(c.env))) then
                            (* A type parameter bounded by a tuple type is
                             * assigned through its bound *)
                            targetType :=
                                    maybe.unwrapOr(kinds.resolveTupleBound(targetType maybe.some(c.env)) targetType)
                        end
                        case targetType.form
                            when typeTuple with t then
                                begin
                                    (* field names a value component by its
                                     * label, by its position among the value
                                     * components (p.1), or by _ and that
                                     * position (p._1). The scan runs down, so
                                     * the first component that matches
                                     * wins. *)
                                    let fields = model.tupleValueFields(t.fields)
                                    let var index = ~1
                                    for i = {extent fields - 1} downto 0 do
                                        let f = fields[i]
                                        let istr = conv.int(i)
                                        let named =
                                            maybe.isSome(f.name) andif stringOp.equal(maybe.unwrap(f.name) field)
                                        let underscored = {stringOp.length(field) > 1}
                                            andif stringOp.equal(stringOp.getSub(field 0 1) "_")
                                            andif stringOp.equal(stringOp.getSub(field 1 {stringOp.length(field) - 1})
                                                    istr)
                                        if named orif stringOp.equal(istr field) orif underscored then index := i end
                                    end
                                    if index < 0 then
                                        diagnostics.fail(:Ok "Tuple type '" <> model.show(targetType)
                                            <> "' has no field named '"
                                            <> field <> "'" selOff)
                                    end
                                    let f = fields[index]
                                    if not(f.isVar) then
                                        diagnostics.fail(:Ok "Cannot assign to immutable tuple field '" <> field
                                            <> "'" selOff)
                                    end
                                    let rhsTyped = checker.checkExpr(c right f.type)
                                    let targetSelect =
                                        typedAst.expr(selOff f.type option exprSelect of typedAst.ExprForm with
                                            let target = targetTyped
                                            let field = field
                                        end)
                                    typedAst.expr(offset model.okType assignForm(targetSelect rhsTyped))
                                end
                            else
                                begin
                                    let recBound = kinds.resolveRecordBound(targetType maybe.some(c.env))
                                    if maybe.isNone(recBound) then
                                        diagnostics.fail(:Ok "Cannot mutate field of non-record type '"
                                            <> model.show(targetType)
                                            <> "'" selOff)
                                    end
                                    let fields =
                                        case maybe.unwrap(recBound).form
                                            when typeRecord with r then r.fields
                                            else array of :model.RecordField end
                                        end
                                    let found = model.recordGetField(fields field)
                                    if maybe.isNone(found) then
                                        diagnostics.fail(:Ok "Record has no field '" <> field <> "'" selOff)
                                    end
                                    let f = maybe.unwrap(found)
                                    if not(f.isVar) then
                                        diagnostics.fail(:Ok "Cannot assign to immutable record field '" <> field
                                            <> "'" selOff)
                                    end
                                    let rhsTyped = checker.checkExpr(c right f.type)
                                    let targetSelect =
                                        typedAst.expr(selOff f.type option exprSelect of typedAst.ExprForm with
                                            let target = targetTyped
                                            let field = field
                                        end)
                                    typedAst.expr(offset model.okType assignForm(targetSelect rhsTyped))
                                end
                        end
                    end
                (* Desugaring has made an assignment to an array element an
                 * index assignment *)
                when exprIndex then checks.notDesugared("ExprInfix" x0.span.startOffset)
                else
                    diagnostics.fail("Assignment target must be a mutable variable or field" left.span.startOffset)
            end
        end

    let synthInfix(c: checker.T x0: ast.Expr): typedAst.Expr =
        case x0.form
            when exprInfix with x then
                begin
                    let offset = x0.span.startOffset
                    let op = x.op
                    let infix = env.infixOperator(op)
                    if stringOp.equal(op ":=") then
                        synthAssignment(c x0 x.left x.right)
                    elsif stringOp.equal(op "andif") orif stringOp.equal(op "orif") then
                        checks.notDesugared("ExprInfix" x0.span.startOffset)
                    elsif maybe.isSome(infix) then
                        let o = maybe.unwrap(infix)
                        let leftTyped = checker.checkExpr(c x.left o.left)
                        let rightTyped = checker.checkExpr(c x.right o.right)
                        typedAst.expr(offset o.result infixForm(leftTyped op rightTyped))
                    elsif stringOp.equal(op "is") orif stringOp.equal(op "isnot") then
                        let leftTyped = checker.synthExpr(c x.left)
                        let rightTyped = checker.synthExpr(c x.right)
                        if checks.isSubtype(leftTyped.type rightTyped.type)
                                orif checks.isSubtype(rightTyped.type leftTyped.type) then
                            typedAst.expr(offset model.boolType infixForm(leftTyped op rightTyped))
                        else
                            diagnostics.fail("Equality operator '" <> op
                                <> "' requires operands of compatible types, got '" <> model.show(leftTyped.type)
                                <> "' and '"
                                <> model.show(rightTyped.type) <> "'" offset)
                        end
                    elsif stringOp.equal(op "==") orif stringOp.equal(op "!=") then
                        let suggest = if stringOp.equal(op "==") then "is" else "isnot" end
                        diagnostics.fail("Operator '" <> op <> "' is not supported; use '" <> suggest
                            <> "' instead" offset)
                    else
                        (* Other infix operators are desugared into calls: a op
                         * b is op(a, b) *)
                        checks.notDesugared("ExprInfix" x0.span.startOffset)
                    end
                end
            else checks.unexpected("an infix expression" x0.span.startOffset)
        end

    (* ======================================================================
     * Conditionals and loops
     * ====================================================================== *)

    let elaborateIf(c: checker.T x0: ast.Expr expected0: maybe.T(Type)): typedAst.Expr =
        case x0.form
            when exprIf with x then
                begin
                    let offset = x0.span.startOffset
                    if not(vector.empty(x.elsifs)) then checks.notDesugared(:Ok "ExprIf" x0.span.startOffset) end
                    let expected = if x.shortCircuit then maybe.some(model.boolType) else expected0 end
                    let condTyped = checker.checkExpr(c x.cond model.boolType)
                    let ifForm(thenBranch: typedAst.Expr elseBranch: typedAst.Expr): typedAst.ExprForm =
                        option exprIf of typedAst.ExprForm with
                            let cond = condTyped
                            let thenBranch = thenBranch
                            let elseBranch = elseBranch
                        end
                    if maybe.isNone(expected) andif maybe.isNone(x.elseBranch) then
                        let thenTyped = checker.synthExpr(c x.thenBranch)
                        let thenOffset = thenTyped.offset
                        let stmt = typedAst.binding(thenOffset option bindExprStmt of typedAst.BindingForm with
                            let expr = thenTyped
                        end)
                        let thenBody = typedAst.expr(thenOffset model.okType option exprBlock of typedAst.ExprForm with
                            let bindings = array of stmt end
                            let result = okExpr(thenOffset)
                        end)
                        typedAst.expr(offset model.okType ifForm(thenBody okExpr(offset)))
                    else
                        let thenTyped = checker.elaborateSubexpr(c x.thenBranch expected)
                        let elseTyped = checker.elaborateSubexpr(c maybe.unwrap(x.elseBranch) expected)
                        if maybe.isSome(expected) then
                            typedAst.expr(offset maybe.unwrap(expected) ifForm(thenTyped elseTyped))
                        else
                            let joined = checks.joinBranches(array of thenTyped elseTyped end c.env offset
                                    maybe.some("Cannot find common supertype for conditional branches '{t1}' and '{t2}'"))
                            typedAst.expr(offset joined.type ifForm(joined.parts[0] joined.parts[1]))
                        end
                    end
                end
            else checks.unexpected("a conditional" x0.span.startOffset)
        end

    let synthFor(c: checker.T x0: ast.Expr): typedAst.Expr =
        case x0.form
            when exprFor with x then
                begin
                    let startTyped = checker.checkExpr(c x.start model.intType)
                    let stopTyped = checker.checkExpr(c x.stop model.intType)
                    Let Loop = Tuple sym: symbols.ValueSymbol body: typedAst.Expr end
                    let looped = env.localScoped(c.env "for_" <> x.varName fun(s: symbols.Scope): Loop
                        begin
                            let sym =
                                symbols.newValueSymbol(x.varName model.intType false false false c.functionDepth 0)
                            symbols.declareValue(c.env.currentScope sym)
                            let body = checker.inLoop(c fun(): typedAst.Expr
                                checker.synthExpr(c x.body))
                            tuple let sym = sym let body = body end
                        end)
                    typedAst.expr(x0.span.startOffset model.okType option exprFor of typedAst.ExprForm with
                        let varName = x.varName
                        let symbol = looped.sym
                        let start = startTyped
                        let isDownto = x.isDownto
                        let stop = stopTyped
                        let body = looped.body
                    end)
                end
            else checks.unexpected("a for loop" x0.span.startOffset)
        end

    (* ======================================================================
     * Blocks
     * ====================================================================== *)

    (* A block ending with an expression statement has that expression's value,
     * which is checked against the expected type if there is one; otherwise the
     * block's type is Ok, which must then be a subtype of the expected type. A
     * synthesized type may not mention the block's own bindings. *)
    let elaborateBlock(c: checker.T x0: ast.Expr expected: maybe.T(Type)): typedAst.Expr =
        case x0.form
            when exprBlock with x then
                env.localScoped(c.env "block" fun(blockScope: symbols.Scope): typedAst.Expr
                    begin
                        let offset = x0.span.startOffset
                        let n = vector.length(x.bindings)
                        let typed = vector.new(:typedAst.Binding)
                        let state = tuple let var failed = false end
                        let add(b: maybe.T(typedAst.Binding)): Ok =
                            if maybe.isSome(b) then
                                vector.append(typed maybe.unwrap(b))
                            else
                                state.failed := true
                            end
                        for i = 0 upto {n - 2} do
                            add(bindings.elaborateRecovering(c vector.get(x.bindings i)))
                        end
                        let var result = maybe.none(:typedAst.Expr)
                        if n > 0 then
                            let last = vector.get(x.bindings {n - 1})
                            case last.form
                                when declExprStmt with s then
                                    begin
                                        result := checker.attempt(c fun(): typedAst.Expr
                                            checker.elaborateSubexpr(c s.expr expected))
                                        if maybe.isNone(result) then state.failed := true end
                                    end
                                else
                                    begin
                                        add(bindings.elaborateRecovering(c last))
                                        (* When synthesized, a block ending
                                         * with an exception declaration also
                                         * evaluates to that declaration's
                                         * value *)
                                        if not(state.failed) andif maybe.isNone(expected) then
                                            case vector.last(typed).form
                                                when bindExprStmt with s then
                                                    begin
                                                        vector.pop(typed)
                                                        result := maybe.some(s.expr)
                                                    end
                                                else ok
                                            end
                                        end
                                    end
                            end
                        end
                        (* A binding that failed was reported: the block fails
                         * without another error *)
                        if state.failed then diagnostics.raiseError(:Ok diagnostics.silentError) end
                        if maybe.isNone(result) then
                            if maybe.isSome(expected)
                                    andif not(checks.isSubtype(model.okType maybe.unwrap(expected))) then
                                let what = if n > 0 then "Block ending with declaration" else "Empty block" end
                                diagnostics.fail(:Ok what <> " has type Ok, not expected type '"
                                    <> model.show(maybe.unwrap(expected)) <> "'" offset)
                            end
                            result := maybe.some(okExpr(offset))
                        end
                        let resultExpr = maybe.unwrap(result)
                        let resultType =
                            if maybe.isSome(expected) then
                                maybe.unwrap(expected)
                            else
                                let ids = newIds()
                                let values = hashMap.valueIter(blockScope.values)
                                while iter.more(values) do hashSet.insert(ids iter.next(values).symbolId) end
                                escape.checkNoEscapingPathTypes(resultExpr.type ids "its scope" resultExpr.offset)
                                resultExpr.type
                            end
                        typedAst.expr(offset resultType option exprBlock of typedAst.ExprForm with
                            let bindings = vector.toArray(typed)
                            let result = resultExpr
                        end)
                    end)
            else checks.unexpected("a block" x0.span.startOffset)
        end
end
