(* Quest Language Server: The Server Implementation *)

module server : Server
import
    reader : Reader
    stringOp = string : StringOp
    system : System
    writer : Writer

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    os/files : os/Files
    os/time : os/Time
    util/hash : util/Hash
    util/json : util/Json
    util/maybe : util/Maybe
    util/strutil : util/Strutil
    util/uri : util/URI

    commonFiles = questlang/common/files : questlang/common/Files
    questlang/common/overlays : questlang/common/Overlays
    questlang/format/format : questlang/format/Format
    questlang/lsp/analysis : questlang/lsp/Analysis
    questlang/lsp/navigation : questlang/lsp/Navigation
    questlang/lsp/outline : questlang/lsp/Outline
    questlang/lsp/positions : questlang/lsp/Positions
    questlang/lsp/protocol : questlang/lsp/Protocol
export
    (* ======================================================================
     * State
     * ====================================================================== *)

    (* An open document: the URI the client names it by, its text, whether
     * it must be checked again, its last check and index, and the last index
     * of a check that typed anything, which completion falls back on while
     * the text does not parse; others are the other files its last
     * diagnostics were published to *)
    Let Document = Tuple
        uri: String
        path: String
        var text: String
        var version: Int
        var stale: Bool
        var checked: maybe.T(analysis.T)
        var index: maybe.T(navigation.T)
        var lastGood: maybe.T(navigation.T)
        var others: Array(String)
    end

    let state = tuple
        let var initialized = false
        let var shutdown = false
        let var utf16 = true
        let var settings: analysis.Settings = tuple
            let buildDir = ""
            let includePaths = array of :String end
        end
        let documents = hashMap.new(:String :Document stringOp.equal hash.string)
    end

    let log(message: String): Ok =
        begin writer.putString(writer.err "quest-lsp: " <> message <> "\n") writer.flush(writer.err) end

    let send(v: json.Value): Ok = protocol.writeMessage(writer.output v)

    (* ======================================================================
     * JSON
     * ====================================================================== *)

    let obj = protocol.objectOf
    let str = json.string
    let int = json.int

    (* A member of v by a path of names; raises json.error if one is missing *)
    let at(v: json.Value names: Array(String)): json.Value =
        begin
            let var x = v
            for i = 0 upto {extent names - 1} do x := json.member(x names[i]) end
            x
        end

    let optionalAt(v: json.Value names: Array(String)): maybe.T(json.Value) =
        begin
            let var x = maybe.some(v)
            for i = 0 upto {extent names - 1} do
                if maybe.isSome(x) then x := json.optional(maybe.unwrap(x) names[i]) end
            end
            x
        end

    let isNull(v: json.Value): Bool = case v when jNull then true else false end

    (* ======================================================================
     * Positions
     * ====================================================================== *)

    let positionJson(p: positions.Position): json.Value =
        obj(array of "line" "character" end array of int(p.line) int(p.character) end)

    let rangeJson(t: positions.T start: Int finish: Int): json.Value =
        obj(array of "start" "end" end
                array of
                    positionJson(positions.toPosition(t start state.utf16))
                    positionJson(positions.toPosition(t finish state.utf16))
                end)

    (* The text of a file other than an open document's, for its positions *)
    let fileText(path: String): String = maybe.unwrapOr(commonFiles.readText(path) "")

    (* The URI of a path: an open document's, as its client wrote it *)
    let uriOf(path: String): String =
        begin
            let d = hashMap.get(state.documents path)
            if maybe.isSome(d) then maybe.unwrap(d).uri else uri.fromPath(path) end
        end

    let textOf(path: String): String =
        begin
            let d = hashMap.get(state.documents path)
            if maybe.isSome(d) then maybe.unwrap(d).text else fileText(path) end
        end

    let locationJson(p: analysis.Place): json.Value =
        obj(array of "uri" "range" end
                array of str(uriOf(p.file)) rangeJson(positions.new(textOf(p.file)) p.start p.finish) end)

    (* The byte offset of a request's position in its document *)
    let offsetOf(d: Document params: json.Value): Int =
        positions.toOffset(positions.new(d.text) json.toInt(at(params array of "position" "line" end))
                json.toInt(at(params array of "position" "character" end)) state.utf16)

    (* ======================================================================
     * Checking and diagnostics
     * ====================================================================== *)

    Let Diagnostic = Tuple
        start: Int finish: Int message: String isWarning: Bool
        related: Array(Tuple place: analysis.Place message: String end)
    end

    let diagnosticJson(t: positions.T d: Diagnostic): json.Value =
        begin
            let related = vector.new(:json.Value)
            for i = 0 upto {extent d.related - 1} do
                let r = d.related[i]
                vector.append(related obj(array of "location" "message" end
                        array of locationJson(r.place)
                            str(if stringOp.length(r.message) is 0 then "here" else r.message end)
                        end))
            end
            obj(array of "range" "severity" "source" "message" "relatedInformation" end
                    array of
                        rangeJson(t d.start if d.finish > d.start then d.finish else d.start + 1 end)
                        int(if d.isWarning then 2 else 1 end)
                        str("quest")
                        str(d.message)
                        json.arrayValue(related)
                    end)
        end

    let publish(fileUri: String text: String version: maybe.T(Int) ds: vector.T(Diagnostic)): Ok =
        begin
            let t = positions.new(text)
            let items = vector.new(:json.Value)
            for i = 0 upto {vector.length(ds) - 1} do vector.append(items diagnosticJson(t vector.get(ds i))) end
            let names = vector.new(:String)
            let values = vector.new(:json.Value)
            vector.append(names "uri")
            vector.append(values str(fileUri))
            if maybe.isSome(version) then
                vector.append(names "version")
                vector.append(values int(maybe.unwrap(version)))
            end
            vector.append(names "diagnostics")
            vector.append(values json.arrayValue(items))
            send(protocol.notification("textDocument/publishDiagnostics"
                    obj(vector.toArray(names) vector.toArray(values))))
        end

    let check(d: Document): Ok =
        begin
            let a = analysis.check(d.path d.text state.settings)
            let ix = navigation.index(a)
            d.checked := maybe.some(a)
            d.index := maybe.some(ix)
            if extent a.typed > 0 then d.lastGood := maybe.some(ix) end
            d.stale := false
            (* The document's own problems, and each other file's, with a
             * problem in another file also shown at the document's place it
             * names (the import that led there) *)
            let own = vector.new(:Diagnostic)
            let byFile = hashMap.new(:String :vector.T(Diagnostic) stringOp.equal hash.string)
            for i = 0 upto {extent a.problems - 1} do
                let p = a.problems[i]
                let diag: Diagnostic = tuple
                    let start = p.place.start
                    let finish = p.place.finish
                    let message = p.message
                    let isWarning = p.isWarning
                    let related = p.related
                end
                if stringOp.equal(p.place.file d.path) then
                    vector.append(own diag)
                else
                    if not(hashMap.contains(byFile p.place.file)) then
                        hashMap.insert(byFile p.place.file vector.new(:Diagnostic))
                    end
                    vector.append(maybe.unwrap(hashMap.get(byFile p.place.file)) diag)
                    let var shown = false
                    for j = 0 upto {extent p.related - 1} do
                        let r = p.related[j]
                        if not(shown) andif stringOp.equal(r.place.file d.path) then
                            vector.append(own tuple
                                let start = r.place.start
                                let finish = r.place.finish
                                let message = "in " <> commonFiles.displayName(p.place.file) <> ": " <> p.message
                                let isWarning = p.isWarning
                                let related = array of tuple let place = p.place let message = p.message end end
                            end)
                            shown := true
                        end
                    end
                    if not(shown) then
                        vector.append(own tuple
                            let start = 0
                            let finish = 0
                            let message = "in " <> commonFiles.displayName(p.place.file) <> ": " <> p.message
                            let isWarning = p.isWarning
                            let related = array of tuple let place = p.place let message = p.message end end
                        end)
                    end
                end
            end
            publish(d.uri d.text maybe.some(d.version) own)
            let others = hashMap.keys(byFile)
            for i = 0 upto {vector.length(others) - 1} do
                let file = vector.get(others i)
                if not(hashMap.contains(state.documents file)) then
                    publish(uri.fromPath(file) fileText(file) maybe.none() maybe.unwrap(hashMap.get(byFile file)))
                end
            end
            (* Files that had problems and have none now are cleared *)
            for i = 0 upto {extent d.others - 1} do
                if not(hashMap.contains(byFile d.others[i]))
                        andif not(hashMap.contains(state.documents d.others[i])) then
                    publish(uri.fromPath(d.others[i]) "" maybe.none() vector.new(:Diagnostic))
                end
            end
            d.others := vector.toArray(others)
        end

    (* The document a request names, checked if stale *)
    let documentOf(params: json.Value): maybe.T(Document) =
        begin
            let path = uri.toPath(json.toString(at(params array of "textDocument" "uri" end)))
            let d = hashMap.get(state.documents path)
            if maybe.isSome(d) andif maybe.unwrap(d).stale then check(maybe.unwrap(d)) end
            d
        end

    let checkStale(): Ok =
        begin
            let ds = hashMap.values(state.documents)
            for i = 0 upto {vector.length(ds) - 1} do
                (* Stop as soon as a message is waiting: it may change the
                 * text again *)
                if vector.get(ds i).stale andif {reader.ready(reader.input) is 0} then check(vector.get(ds i)) end
            end
        end

    let markAllStale(): Ok =
        begin
            let ds = hashMap.values(state.documents)
            for i = 0 upto {vector.length(ds) - 1} do vector.get(ds i).stale := true end
        end

    (* ======================================================================
     * Requests
     * ====================================================================== *)

    let cacheDir(): String =
        begin
            let xdg = system.getEnv("XDG_CACHE_HOME")
            let home = system.getEnv("HOME")
            if stringOp.length(xdg) > 0 then commonFiles.join(xdg "quest-lsp")
            elsif system.isDirectory(commonFiles.join(home "Library/Caches")) then
                commonFiles.join(home "Library/Caches/quest-lsp")
            else commonFiles.join(home ".cache/quest-lsp")
            end
        end

    (* The build directory of a workspace: one per root, named by its path *)
    let buildDirFor(root: String): String =
        commonFiles.join(cacheDir() strutil.replace(strutil.replace(root "/" "_") " " "_"))

    let initialize(params: json.Value): json.Value =
        begin
            let encodings = optionalAt(params array of "capabilities" "general" "positionEncodings" end)
            if maybe.isSome(encodings) then
                let list = json.toArray(maybe.unwrap(encodings))
                for i = 0 upto {vector.length(list) - 1} do
                    if stringOp.equal(json.toString(vector.get(list i)) "utf-8") then state.utf16 := false end
                end
            end
            let rootUri = optionalAt(params array of "rootUri" end)
            let root =
                if maybe.isSome(rootUri) andif not(isNull(maybe.unwrap(rootUri))) then
                    try uri.toPath(json.toString(maybe.unwrap(rootUri)))
                    when uri.error then system.currentDirectory()
                    end
                else
                    system.currentDirectory()
                end
            let options = optionalAt(params array of "initializationOptions" end)
            let buildDir = if maybe.isSome(options) then optionalAt(maybe.unwrap(options) array of "buildDir" end)
                else maybe.none(:json.Value) end
            let includes = vector.new(:String)
            if maybe.isSome(options) then
                let given = optionalAt(maybe.unwrap(options) array of "includePaths" end)
                if maybe.isSome(given) then
                    let list = json.toArray(maybe.unwrap(given))
                    for i = 0 upto {vector.length(list) - 1} do
                        vector.append(includes commonFiles.join(root json.toString(vector.get(list i))))
                    end
                end
            end
            state.settings := tuple
                let buildDir =
                    if maybe.isSome(buildDir) then json.toString(maybe.unwrap(buildDir)) else buildDirFor(root) end
                let includePaths = vector.toArray(includes)
            end
            state.initialized := true
            log("serving " <> root <> ", artifacts in " <> state.settings.buildDir)
            obj(array of "capabilities" "serverInfo" end
                    array of
                        obj(array of
                            "positionEncoding" "textDocumentSync" "hoverProvider" "definitionProvider"
                            "referencesProvider" "documentHighlightProvider" "documentSymbolProvider"
                            "documentFormattingProvider" "completionProvider"
                        end
                                array of
                                    str(if state.utf16 then "utf-16" else "utf-8" end)
                                    obj(array of "openClose" "change" "save" end
                                            array of json.bool(true) int(1) json.bool(false) end)
                                    json.bool(true)
                                    json.bool(true)
                                    json.bool(true)
                                    json.bool(true)
                                    json.bool(true)
                                    json.bool(true)
                                    obj(array of "triggerCharacters" end
                                            array of json.arrayValue(vector.fromArray(array of str(".") end)) end)
                                end)
                        obj(array of "name" end array of str("quest-lsp") end)
                    end)
        end

    let didOpen(params: json.Value): Ok =
        begin
            let docUri = json.toString(at(params array of "textDocument" "uri" end))
            let path = uri.toPath(docUri)
            let text = json.toString(at(params array of "textDocument" "text" end))
            let version = json.toInt(at(params array of "textDocument" "version" end))
            overlays.set(path text time.nowInNanoseconds())
            hashMap.insert(state.documents path tuple
                let uri = docUri
                let path = path
                let var text = text
                let var version = version
                let var stale = true
                let var checked = maybe.none(:analysis.T)
                let var index = maybe.none(:navigation.T)
                let var lastGood = maybe.none(:navigation.T)
                let var others = array of :String end
            end)
            markAllStale()
        end

    let didChange(params: json.Value): Ok =
        begin
            let path = uri.toPath(json.toString(at(params array of "textDocument" "uri" end)))
            let d = hashMap.get(state.documents path)
            if maybe.isSome(d) then
                let doc = maybe.unwrap(d)
                let changes = json.toArray(at(params array of "contentChanges" end))
                if not(vector.empty(changes)) then
                    doc.text := json.toString(json.member(vector.last(changes) "text"))
                end
                doc.version := json.toInt(at(params array of "textDocument" "version" end))
                overlays.set(path doc.text time.nowInNanoseconds())
                markAllStale()
            end
        end

    let didClose(params: json.Value): Ok =
        begin
            let path = uri.toPath(json.toString(at(params array of "textDocument" "uri" end)))
            let d = hashMap.get(state.documents path)
            if maybe.isSome(d) then
                let doc = maybe.unwrap(d)
                overlays.remove(path)
                hashMap.delete(state.documents path)
                (* Artifacts built from a text the disk does not hold would
                 * look fresh, so the build directory starts over *)
                let onDisk = commonFiles.readText(path)
                if maybe.isNone(onDisk) orif not(stringOp.equal(maybe.unwrap(onDisk) doc.text)) then
                    try files.removeTree(state.settings.buildDir) else ok end
                end
                publish(doc.uri "" maybe.none() vector.new(:Diagnostic))
                markAllStale()
            end
        end

    let placesJson(places: Array(analysis.Place)): json.Value =
        begin
            let items = vector.new(:json.Value)
            for i = 0 upto {extent places - 1} do vector.append(items locationJson(places[i])) end
            json.arrayValue(items)
        end

    let hover(params: json.Value): json.Value =
        begin
            let d = documentOf(params)
            if maybe.isNone(d) orif maybe.isNone(maybe.unwrap(d).index) then
                json.null
            else
                let doc = maybe.unwrap(d)
                let shown = navigation.hover(maybe.unwrap(doc.index) offsetOf(doc params))
                if maybe.isNone(shown) then
                    json.null
                else
                    obj(array of "contents" end
                            array of obj(array of "kind"
                                "value"
                            end array of str("markdown") str(maybe.unwrap(shown)) end) end)
                end
            end
        end

    let definition(params: json.Value): json.Value =
        begin
            let d = documentOf(params)
            if maybe.isNone(d) orif maybe.isNone(maybe.unwrap(d).index) then
                json.arrayValue(vector.new(:json.Value))
            else
                let doc = maybe.unwrap(d)
                placesJson(navigation.definition(maybe.unwrap(doc.index) offsetOf(doc params)))
            end
        end

    let references(params: json.Value): json.Value =
        begin
            let d = documentOf(params)
            if maybe.isNone(d) orif maybe.isNone(maybe.unwrap(d).index) then
                json.arrayValue(vector.new(:json.Value))
            else
                let doc = maybe.unwrap(d)
                let withDeclaration = maybe.isSome(optionalAt(params array of "context" "includeDeclaration" end))
                    andif json.toBool(at(params array of "context" "includeDeclaration" end))
                placesJson(navigation.references(maybe.unwrap(doc.index) offsetOf(doc params) withDeclaration))
            end
        end

    let highlight(params: json.Value): json.Value =
        begin
            let d = documentOf(params)
            let items = vector.new(:json.Value)
            if maybe.isSome(d) andif maybe.isSome(maybe.unwrap(d).index) then
                let doc = maybe.unwrap(d)
                let t = positions.new(doc.text)
                let places = navigation.highlights(maybe.unwrap(doc.index) offsetOf(doc params))
                for i = 0 upto {extent places - 1} do
                    vector.append(items obj(array of "range" "kind" end
                            array of rangeJson(t places[i].start places[i].finish) int(1) end))
                end
            end
            json.arrayValue(items)
        end

    let rec symbolJson(t: positions.T s: outline.Symbol): json.Value =
        begin
            let children = vector.new(:json.Value)
            for i = 0 upto {extent s.children - 1} do vector.append(children symbolJson(t s.children[i])) end
            obj(array of "name" "detail" "kind" "range" "selectionRange" "children" end
                    array of
                        str(s.name)
                        str(s.detail)
                        int(s.kind)
                        rangeJson(t s.start s.finish)
                        rangeJson(t s.nameStart s.nameFinish)
                        json.arrayValue(children)
                    end)
        end

    let documentSymbols(params: json.Value): json.Value =
        begin
            let d = documentOf(params)
            let items = vector.new(:json.Value)
            if maybe.isSome(d) andif maybe.isSome(maybe.unwrap(d).checked) then
                let doc = maybe.unwrap(d)
                let a = maybe.unwrap(doc.checked)
                if maybe.isSome(a.syntax) andif maybe.isSome(a.tokens) then
                    let t = positions.new(doc.text)
                    let symbols = outline.symbols(maybe.unwrap(a.syntax) maybe.unwrap(a.tokens))
                    for i = 0 upto {extent symbols - 1} do vector.append(items symbolJson(t symbols[i])) end
                end
            end
            json.arrayValue(items)
        end

    let formatting(params: json.Value): json.Value =
        begin
            let path = uri.toPath(json.toString(at(params array of "textDocument" "uri" end)))
            let d = hashMap.get(state.documents path)
            let edits = vector.new(:json.Value)
            if maybe.isSome(d) then
                let doc = maybe.unwrap(d)
                case format.source(path doc.text)
                    when formatted with x then
                        if not(stringOp.equal(x.text doc.text)) then
                            let t = positions.new(doc.text)
                            vector.append(edits obj(array of "range" "newText" end
                                    array of rangeJson(t 0 stringOp.length(doc.text)) str(x.text) end))
                        end
                    when invalid then ok
                    when failed with x then log("the formatter failed on " <> path <> ": " <> x.message)
                end
            end
            json.arrayValue(edits)
        end

    let completion(params: json.Value): json.Value =
        begin
            let d = documentOf(params)
            let items = vector.new(:json.Value)
            if maybe.isSome(d) then
                let doc = maybe.unwrap(d)
                let ix = if maybe.isSome(doc.lastGood) then doc.lastGood else doc.index end
                if maybe.isSome(ix) then
                    let found = navigation.completions(maybe.unwrap(ix) doc.text offsetOf(doc params))
                    for i = 0 upto {extent found.items - 1} do
                        let c = found.items[i]
                        vector.append(items obj(array of "label" "kind" "detail" end
                                array of str(c.label) int(c.kind) str(c.detail) end))
                    end
                end
            end
            obj(array of "isIncomplete" "items" end array of json.bool(false) json.arrayValue(items) end)
        end

    (* ======================================================================
     * The loop
     * ====================================================================== *)

    let exitStatus = tuple let var code = ~1 end

    (* Answers a request, or acts on a notification *)
    let handle(message: json.Value): Ok =
        begin
            let id = json.optional(message "id")
            let methodValue = json.optional(message "method")
            let method = if maybe.isSome(methodValue) then json.toString(maybe.unwrap(methodValue)) else "" end
            let params = maybe.unwrapOr(json.optional(message "params") json.null)
            let isRequest = maybe.isSome(id) andif maybe.isSome(methodValue)
            let reply =
                fun(result: json.Value): Ok if isRequest then send(protocol.response(maybe.unwrap(id) result)) end
            let refuse = fun(code: Int text: String): Ok
                if isRequest then send(protocol.errorResponse(maybe.unwrap(id) code text)) end
            try
                if stringOp.equal(method "initialize") then
                    reply(initialize(params))
                elsif stringOp.equal(method "exit") then
                    exitStatus.code := if state.shutdown then 0 else 1 end
                elsif not(state.initialized) then
                    refuse(protocol.serverNotInitializedCode "the server is not initialized")
                elsif stringOp.equal(method "initialized") then
                    ok
                elsif stringOp.equal(method "shutdown") then
                    state.shutdown := true
                    reply(json.null)
                elsif stringOp.equal(method "textDocument/didOpen") then
                    didOpen(params)
                elsif stringOp.equal(method "textDocument/didChange") then
                    didChange(params)
                elsif stringOp.equal(method "textDocument/didClose") then
                    didClose(params)
                elsif stringOp.equal(method "textDocument/hover") then
                    reply(hover(params))
                elsif stringOp.equal(method "textDocument/definition") then
                    reply(definition(params))
                elsif stringOp.equal(method "textDocument/references") then
                    reply(references(params))
                elsif stringOp.equal(method "textDocument/documentHighlight") then
                    reply(highlight(params))
                elsif stringOp.equal(method "textDocument/documentSymbol") then
                    reply(documentSymbols(params))
                elsif stringOp.equal(method "textDocument/formatting") then
                    reply(formatting(params))
                elsif stringOp.equal(method "textDocument/completion") then
                    reply(completion(params))
                elsif isRequest then
                    refuse(protocol.methodNotFoundCode "no method " <> method)
                end
            when json.error with f then
                refuse(protocol.invalidParamsCode "invalid parameters: " <> f.message)
            when uri.error with m then
                refuse(protocol.invalidParamsCode m)
            else
                log("internal error handling " <> method)
                refuse(protocol.internalErrorCode "internal error handling " <> method)
            end
        end

    let run(): Int =
        begin
            let var going = true
            while going do
                let message =
                    try protocol.readMessage(reader.input)
                    when protocol.error with m then
                        log(m)
                        send(protocol.errorResponse(json.null protocol.parseErrorCode m))
                        maybe.some(json.null)
                    end
                if maybe.isNone(message) then
                    going := false
                else
                    if not(isNull(maybe.unwrap(message))) then handle(maybe.unwrap(message)) end
                    if exitStatus.code >= 0 then
                        going := false
                    elsif reader.ready(reader.input) is 0 then
                        checkStale()
                    end
                end
            end
            if exitStatus.code >= 0 then exitStatus.code elsif state.shutdown then 0 else 1 end
        end
end
