(* Quest Language Server: Checking a Document Implementation *)

module analysis : Analysis
import
    stringOp = string : StringOp

    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/common/diagbag : questlang/common/DiagBag
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/files : questlang/common/Files
    questlang/common/location : questlang/common/Location
    questlang/modules/elaboration : questlang/modules/Elaboration
    questlang/modules/stdlib : questlang/modules/Stdlib
    questlang/syntax/ast : questlang/syntax/AST
    questlang/syntax/desugar : questlang/syntax/Desugar
    questlang/syntax/parser : questlang/syntax/Parser
    questlang/syntax/tokenizer : questlang/syntax/Tokenizer
    questlang/syntax/tokens : questlang/syntax/Tokens
    questlang/typechecker/typecheck : questlang/typechecker/Typecheck
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
    questlang/types/symbols : questlang/types/Symbols
export
    Let Settings = Tuple buildDir: String includePaths: Array(String) end
    Let Place = Tuple file: String start: Int finish: Int end
    Let Problem = Tuple
        place: Place
        message: String
        isWarning: Bool
        related: Array(Tuple place: Place message: String end)
    end
    Let T = Tuple
        path: String
        text: String
        sm: location.SourceMap
        problems: Array(Problem)
        tokens: maybe.T(vector.T(tokens.Token))
        comments: vector.T(location.Span)
        syntax: maybe.T(ast.Program)
        typed: Array(typedAst.Binding)
        loose: Array(typedAst.Expr)
        scope: maybe.T(symbols.Scope)
        env: maybe.T(env.T)
    end

    let installed = tuple let var done = false end

    (* The registry of the standard library, once for the process *)
    let install(): Ok =
        if not(installed.done) then
            stdlib.install()
            installed.done := true
        end

    (* A span's file as an absolute path: diagnostics name a unit's file as
     * the user is shown it, relative to the current directory *)
    let placeOf(sp: location.Span path: String): Place =
        tuple
            let file = if stringOp.length(sp.file) is 0 then path else files.absolute(sp.file) end
            let start = if sp.startOffset < 0 then 0 else sp.startOffset end
            let finish = if sp.endOffset < sp.startOffset then sp.startOffset else sp.endOffset end
        end

    (* A diagnostic as a problem: its message followed by its help and notes *)
    let problemOf(d: diagnostics.Diagnostic path: String): Problem =
        begin
            let var message = diagnostics.message(d)
            let help = diagnostics.help(d)
            if maybe.isSome(help) then message := message <> "\nhelp: " <> maybe.unwrap(help) end
            let notes = diagnostics.notes(d)
            for i = 0 upto {vector.length(notes) - 1} do message := message <> "\nnote: " <> vector.get(notes i) end
            let related = vector.new(:Tuple place: Place message: String end)
            let labels = diagnostics.labels(d)
            for i = 0 upto {vector.length(labels) - 1} do
                let l = vector.get(labels i)
                if not(l.isPrimary) then
                    vector.append(related tuple let place = placeOf(l.sp path) let message = l.message end)
                end
            end
            let isWarning = case diagnostics.severity(d) when warning then true when info then true else false end
            tuple
                let place = placeOf(diagnostics.span(d) path)
                let message = message
                let isWarning = isWarning
                let related = vector.toArray(related)
            end
        end

    (* The environment a document is checked in, as the driver makes one to
     * compile a program: imports through their interfaces, with artifacts in
     * the build directory, which is searched first *)
    let newEnv(path: String settings: Settings): env.T =
        begin
            let e = env.new()
            let dir = files.parent(path)
            e.currentDir := maybe.some(dir)
            e.programDir := maybe.some(dir)
            e.sourceFile := path
            e.compilingC := true
            e.buildDir := maybe.some(settings.buildDir)
            vector.append(e.includePaths settings.buildDir)
            for i = 0 upto {extent settings.includePaths - 1} do
                vector.append(e.includePaths settings.includePaths[i])
            end
            e
        end

    (* The name of the module a program declares, if it declares one *)
    let declaredModule(program: ast.Program): maybe.T(String) =
        begin
            let var found = maybe.none(:String)
            for i = 0 upto {vector.length(program.form.phrases) - 1} do
                case vector.get(program.form.phrases i).form
                    when phraseModule with x then found := maybe.some(x.modDecl.name)
                    else ok
                end
            end
            found
        end

    (* ======================================================================
     * Recovering from syntax errors (docs/lsp.md section 8)
     *
     * The parser stops at a syntax error. A token keeps its offset in the
     * text, so the declaration the error is in can be cut out of the token
     * vector and the rest parsed again, until it parses or the cuts give
     * out; each error is reported as the parser words it, and the parser is
     * unchanged. A declaration is a line that starts at a unit's members'
     * column (an interface's or module's, 5) or a program's (1), with the
     * lines after it, until the next that starts at that column or left of
     * it. A let or a type binding cut out is replaced by a stub that fails to
     * check, so that its name is poisoned as a failed binding's is and its
     * uses fail silently, not as undefined names; the stub's own error is
     * not reported.
     * ====================================================================== *)

    (* The name a stub uses, which no document's names will meet *)
    let brokenValue: String = "questLspBroken"
    let brokenType: String = "QuestLspBroken"

    let isStubError(message: String): Bool =
        strutil.contains(message brokenValue) orif strutil.contains(message brokenType)

    let lexemeIs(t: tokens.Token names: Array(String)): Bool =
        begin
            let var found = false
            for i = 0 upto {extent names - 1} do if stringOp.equal(t.lexeme names[i]) then found := true end end
            found
        end

    (* The tokens of a stub declaring what the declaration at toks[s]
     * declares, all at its place; none for a declaration that declares
     * nothing to stub *)
    let stubFor(toks: vector.T(tokens.Token) s: Int path: String): vector.T(tokens.Token) =
        begin
            let first = vector.get(toks s)
            let var k = s + 1
            let isValue = stringOp.equal(first.lexeme "let")
            let isType = lexemeIs(first array of "Let" "Def" end)
            while {k < vector.length(toks)} andif lexemeIs(vector.get(toks k) array of "rec" "var" "Rec" end) do
                k := k + 1
            end
            let result = vector.new(:tokens.Token)
            if {isValue orif isType} andif {k < vector.length(toks)} then
                let name = vector.get(toks k)
                let isName = case name.kind when ident then true else false end
                if isName then
                    let text = if isValue then "let " <> name.lexeme <> " = " <> brokenValue
                        else "Let " <> name.lexeme <> " = " <> brokenType end
                    let made = tokenizer.tokenizeAll(tokenizer.new(location.newSourceMap(path text) diagbag.new()))
                    for i = 0 upto {vector.length(made) - 1} do
                        let t = vector.get(made i)
                        let isEnd = case t.kind when eof then true else false end
                        if not(isEnd) then vector.append(result tokens.make(t.kind t.lexeme t.value first.span)) end
                    end
                end
            end
            result
        end

    (* toks with the declaration holding offset cut out (and stubbed), if it
     * can be found *)
    let cutAt(toks: vector.T(tokens.Token) sm: location.SourceMap offset: Int
            path: String): maybe.T(vector.T(tokens.Token)) =
        begin
            let n = vector.length(toks)
            let line = fun(i: Int): Int location.locate(sm vector.get(toks i).span.startOffset).line
            let column = fun(i: Int): Int location.locate(sm vector.get(toks i).span.startOffset).col
            let startsLine = fun(i: Int): Bool {i is 0} orif {line(i - 1) < line(i)}
            let isUnit = {n > 0} andif lexemeIs(vector.get(toks 0) array of "module" "interface" "unsound" end)
            let limit = if isUnit then 5 else 1 end
            (* The error's token *)
            let var at = 0
            while {at < {n - 1}} andif {vector.get(toks at).span.startOffset < offset} do at := at + 1 end
            (* The declaration's first token. An error at the first token of a
             * declaration is the end of the one before it, which is
             * incomplete *)
            let var s = if {at > 0} andif startsLine(at) andif {column(at) <= limit} then at - 1 else at end
            while {s > 0} andif not(startsLine(s) andif {column(s) <= limit}) do s := s - 1 end
            let refused = array of "end" "else" "elsif" "when" "then" "do" "export" "module" "interface" "unsound" end
            let header = isUnit andif stringOp.equal(vector.get(toks s).lexeme "import") andif {column(s) is 1}
            if {n is 0} orif lexemeIs(vector.get(toks s) refused) orif header then
                maybe.none()
            else
                let c = column(s)
                let var e = s + 1
                while {e < {n - 1}} andif not(startsLine(e) andif {column(e) <= c}) do e := e + 1 end
                let result = vector.new(:tokens.Token)
                for i = 0 upto {s - 1} do vector.append(result vector.get(toks i)) end
                let stub = stubFor(toks s path)
                for i = 0 upto {vector.length(stub) - 1} do vector.append(result vector.get(stub i)) end
                for i = e upto {n - 1} do vector.append(result vector.get(toks i)) end
                maybe.some(result)
            end
        end

    (* The program the tokens parse to, cutting out declarations with syntax
     * errors, each reported in bag; none if no cut helps *)
    let parseRecovering(toks: vector.T(tokens.Token) sm: location.SourceMap bag: diagbag.T
            path: String): maybe.T(ast.Program) =
        begin
            let var current = toks
            let var result = maybe.none(:ast.Program)
            let var going = true
            let var cuts = 0
            (* Each cut must move the error on, or it did not help *)
            let var lastError = ~1
            while going do
                let b = diagbag.new()
                try
                    result := maybe.some(parser.parseProgram(current sm b))
                    going := false
                when diagbag.fatalError then
                    for i = 0 upto {diagbag.count(b) - 1} do diagbag.add(bag diagbag.get(b i)) end
                    cuts := cuts + 1
                    (* Where the parse stopped, which is where the error is
                     * unless it is located at a construct left open *)
                    let endOffset = if vector.empty(current) then 0 else vector.last(current).span.startOffset end
                    let at = if diagbag.count(b) > 0 then parser.stoppedAt(diagbag.get(b 0) endOffset) else ~1 end
                    if {at <= lastError} orif {cuts > 20} then
                        going := false
                    else
                        lastError := at
                        let next = cutAt(current sm at path)
                        if maybe.isNone(next) then going := false else current := maybe.unwrap(next) end
                    end
                end
            end
            result
        end

    let check(path: String text: String settings: Settings): T =
        begin
            install()
            let sm = location.newSourceMap(path text)
            diagnostics.registerSource(sm)
            let bag = diagbag.new()
            let problems = vector.new(:Problem)
            let typed = vector.new(:typedAst.Binding)
            let state = tuple
                let var tokens = maybe.none(:vector.T(tokens.Token))
                let var comments = vector.new(:location.Span)
                let var syntax = maybe.none(:ast.Program)
                let var scope = maybe.none(:symbols.Scope)
                let var env = maybe.none(:env.T)
                let var loose = array of :typedAst.Expr end
            end
            let kept = tuple
                let var members = maybe.none(:Array(typedAst.Binding))
                let var scope = maybe.none(:symbols.Scope)
            end
            let saved = elaboration.hooks.keepMembers
            try
                let tz = tokenizer.new(sm bag)
                let toks = tokenizer.tokenizeAll(tz)
                state.comments := tokenizer.comments(tz)
                if not(diagbag.hasErrors(bag)) then
                    state.tokens := maybe.some(toks)
                    let parsed = parseRecovering(toks sm bag path)
                    if maybe.isNone(parsed) then raise diagbag.fatalError with diagbag.get(bag 0) end end
                    let program = maybe.unwrap(parsed)
                    state.syntax := maybe.some(program)
                    let moduleName = declaredModule(program)
                    let e = newEnv(path settings)
                    state.env := maybe.some(e)
                    elaboration.hooks.keepMembers := fun(name: String members: Array(typedAst.Binding)
                            scope: symbols.Scope): Ok
                        if maybe.isSome(moduleName) andif stringOp.equal(name maybe.unwrap(moduleName))
                                andif maybe.isNone(kept.members) then
                            kept.members := maybe.some(members)
                            kept.scope := maybe.some(scope)
                        end
                    typedAst.startRecording()
                    let result = typecheck.elaborateProgram(desugar.program(program) e)
                    let made = typedAst.stopRecording()
                    if extent result.errors > 0 then state.loose := made end
                    for i = 0 upto {extent result.errors - 1} do
                        diagbag.add(bag diagnostics.errorDiagnostic(result.errors[i] path))
                    end
                    for i = 0 upto {extent result.warnings - 1} do
                        diagbag.add(bag diagnostics.warningDiagnostic(result.warnings[i] path))
                    end
                    let phrases = result.partial.phrases
                    let var moduleChecked = false
                    for i = 0 upto {extent phrases - 1} do
                        vector.append(typed phrases[i])
                        case phrases[i].form
                            when bindModule then moduleChecked := true
                            when bindInterface with x then state.scope := maybe.some(x.scope)
                            else ok
                        end
                    end
                    (* A module that failed gives its members that checked *)
                    if not(moduleChecked) andif maybe.isSome(kept.members) then
                        let members = maybe.unwrap(kept.members)
                        for i = 0 upto {extent members - 1} do vector.append(typed members[i]) end
                    end
                    if maybe.isSome(kept.scope) then
                        state.scope := kept.scope
                    elsif maybe.isNone(state.scope) then
                        state.scope := maybe.some(e.currentScope)
                    end
                end
            when diagbag.fatalError then
                ok
            when diagnostics.compilerError with err then
                diagbag.add(bag diagnostics.errorDiagnostic(err path))
            else
                diagbag.add(bag diagnostics.error("internal error in the language server's check"
                        location.span(path 0 0)))
            end
            elaboration.hooks.keepMembers := saved
            typedAst.stopRecording()
            for i = 0 upto {diagbag.count(bag) - 1} do
                let d = diagbag.get(bag i)
                if not(isStubError(diagnostics.message(d))) then vector.append(problems problemOf(d path)) end
            end
            tuple
                let path = path
                let text = text
                let sm = sm
                let problems = vector.toArray(problems)
                let tokens = state.tokens
                let comments = state.comments
                let syntax = state.syntax
                let typed = vector.toArray(typed)
                let loose = state.loose
                let scope = state.scope
                let env = state.env
            end
        end
end
