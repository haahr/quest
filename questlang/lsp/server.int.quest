(* Quest Language Server: The Server
 *
 * Serves the Language Server Protocol on standard input and output
 * (docs/lsp.md): one message at a time, in one thread. An edit marks its
 * document to be checked; a document is checked when no message is waiting
 * (reader.ready), so a burst of edits costs one check, or when a request
 * needs it. Standard output carries only the protocol's messages; anything
 * else goes to standard error, which an editor shows as the server's log. *)

interface Server
export
    (* Serves until the client sends exit, or standard input ends; returns the
     * exit status: 0 after shutdown, else 1 *)
    run(): Int
end
