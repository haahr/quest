(* Quest Language Server: the program (docs/lsp-plan.md). tools/lsp/quest-lsp
 * builds it with ./quest and runs it, with QUEST_HOME set to the checkout so
 * that the standard library and questlang/ are found. It is a program of its
 * own, not a mode of the driver, so the release does not compile it and it
 * may use library functions newer than the release's. *)

import
    system : System

    questlang/lsp/server : questlang/lsp/Server

system.sysexit(server.run())
