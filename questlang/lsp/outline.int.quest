(* Quest Language Server: A Document's Outline
 *
 * The protocol's document symbols, from the syntax tree alone, so that a
 * document that does not type-check still has one (docs/lsp-plan.md step 4):
 * an interface and its members, a module and its bindings, and a program's
 * bindings, each with its whole span and its name's. *)

interface Outline
import
    collections/vector : collections/Vector

    questlang/syntax/ast : questlang/syntax/Ast
    questlang/syntax/tokens : questlang/syntax/Tokens
export
    (* kind is the protocol's SymbolKind *)
    Def Rec Symbol = Tuple
        name: String
        kind: Int
        detail: String
        start: Int
        finish: Int
        nameStart: Int
        nameFinish: Int
        children: Array(Symbol)
    end

    symbols(program: ast.Program toks: vector.T(tokens.Token)): Array(Symbol)
end
