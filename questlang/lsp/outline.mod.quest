(* Quest Language Server: A Document's Outline Implementation *)

module outline : Outline
import
    stringOp = string : StringOp

    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/syntax/ast : questlang/syntax/AST
    questlang/syntax/tokens : questlang/syntax/Tokens
export
    Let Rec Symbol = Tuple
        name: String
        kind: Int
        detail: String
        start: Int
        finish: Int
        nameStart: Int
        nameFinish: Int
        children: Array(Symbol)
    end

    (* The protocol's SymbolKind *)
    let symbolKindModule: Int = 2
    let symbolKindClass: Int = 5
    let symbolKindField: Int = 8
    let symbolKindInterface: Int = 11
    let symbolKindFunction: Int = 12
    let symbolKindVariable: Int = 13
    let symbolKindTypeParameter: Int = 26

    let noSymbols = array of :Symbol end

    (* The name (an identifier or operator) nearest offset, as [start, finish),
     * else the offset itself: with back, the last at most 128 tokens before
     * offset (a signature's offset may be its type's, past its name and
     * parameters), else the first at or after it (a declaration's offset is
     * its keyword's, and a search back could find an earlier use) *)
    let nameSpan(toks: vector.T(tokens.Token) offset: Int name: String back: Bool): Tuple start: Int finish: Int end =
        begin
            let var lo = 0
            let var hi = vector.length(toks)
            while lo < hi do
                let mid = {lo + hi} / 2
                if vector.get(toks mid).span.startOffset < offset then lo := mid + 1 else hi := mid end
            end
            let var found = maybe.none(:tokens.Token)
            let var j = if lo < vector.length(toks) then lo else vector.length(toks) - 1 end
            while back andif maybe.isNone(found) andif {j >= 0} andif {j > lo - 128} do
                let t = vector.get(toks j)
                if not(tokens.isLiteral(t.kind)) andif stringOp.equal(t.lexeme name) then found := maybe.some(t) end
                j := j - 1
            end
            let var i = lo
            while maybe.isNone(found) andif {i < vector.length(toks)} andif {i < lo + 400} do
                let t = vector.get(toks i)
                if not(tokens.isLiteral(t.kind)) andif stringOp.equal(t.lexeme name) then found := maybe.some(t) end
                i := i + 1
            end
            if maybe.isSome(found) then
                tuple
                    let start = maybe.unwrap(found).span.startOffset
                    let finish = maybe.unwrap(found).span.endOffset
                end
            else
                tuple let start = offset let finish = offset end
            end
        end

    (* A symbol whose span [start, finish) is widened to hold its name, as
     * the protocol requires: a signature's span is only its offset, which may
     * lie past its name (back, as for nameSpan) *)
    let symbol(toks: vector.T(tokens.Token) name: String kind: Int detail: String start: Int finish: Int back: Bool
            children: Array(Symbol)): Symbol =
        begin
            let n = nameSpan(toks start name back)
            tuple
                let name = name
                let kind = kind
                let detail = detail
                let start = if n.start < start then n.start else start end
                let finish = if finish < n.finish then n.finish else finish end
                let nameStart = n.start
                let nameFinish = n.finish
                let children = children
            end
        end

    (* A declaration's symbols: a let's, a group's members', a type's *)
    let rec declSymbols(toks: vector.T(tokens.Token) d: ast.Decl acc: vector.T(Symbol)): Ok =
        case d.form
            when declLetVal with x then
                let isFunction =
                    {
                    vector.length(x.params) > 0} orif case x.value.form when exprFun then true else false end
                vector.append(acc
                        symbol(toks x.name if isFunction then symbolKindFunction else symbolKindVariable end ""
                                d.span.startOffset d.span.endOffset false noSymbols))
            when declLetValGroup with x then
                for i = 0 upto {vector.length(x.bindings) - 1} do declSymbols(toks vector.get(x.bindings i) acc) end
            when declTypeBinding with x then
                vector.append(acc
                        symbol(toks x.name symbolKindClass "" d.span.startOffset d.span.endOffset false noSymbols))
            when declTypeBindingGroup with x then
                for i = 0 upto {vector.length(x.bindings) - 1} do declSymbols(toks vector.get(x.bindings i) acc) end
            when declDefKind with x then
                vector.append(acc
                        symbol(toks x.name symbolKindTypeParameter "" d.span.startOffset d.span.endOffset
                                false noSymbols))
            else ok
        end

    let signatureSymbols(toks: vector.T(tokens.Token) sig: ast.Signature acc: vector.T(Symbol)): Ok =
        case sig
            when sigValue with x then
                if maybe.isSome(x.val.name) then
                    let isFunction =
                        if maybe.isSome(x.val.typeSig) then
                            case maybe.unwrap(x.val.typeSig).form when typeFun then true else false end
                        else
                            false
                        end
                    vector.append(acc
                            symbol(toks maybe.unwrap(x.val.name) if isFunction then
                                symbolKindFunction
                            else
                                symbolKindField
                            end
                                    "" x.val.offset x.val.offset true noSymbols))
                end
            when sigType with x then
                vector.append(acc symbol(toks x.val.name symbolKindClass "" x.val.offset x.val.offset true noSymbols))
            when sigTypeBinding with x then
                vector.append(acc symbol(toks x.val.name symbolKindClass "" x.val.offset x.val.offset true noSymbols))
            when sigTypeBindingGroup with x then
                for i = 0 upto {vector.length(x.val) - 1} do
                    let b = vector.get(x.val i)
                    vector.append(acc symbol(toks b.name symbolKindClass "" b.offset b.offset true noSymbols))
                end
            when sigKindBinding with x then
                vector.append(acc
                        symbol(toks x.val.name symbolKindTypeParameter "" x.val.offset x.val.offset true noSymbols))
        end

    let symbols(program: ast.Program toks: vector.T(tokens.Token)): Array(Symbol) =
        begin
            let acc = vector.new(:Symbol)
            for i = 0 upto {vector.length(program.form.phrases) - 1} do
                let p = vector.get(program.form.phrases i)
                case p.form
                    when phraseInterface with x then
                        let members = vector.new(:Symbol)
                        for j = 0 upto {vector.length(x.iface.signatures) - 1} do
                            signatureSymbols(toks vector.get(x.iface.signatures j) members)
                        end
                        vector.append(acc
                                symbol(toks x.iface.name symbolKindInterface "" p.span.startOffset p.span.endOffset
                                        false vector.toArray(members)))
                    when phraseModule with x then
                        let members = vector.new(:Symbol)
                        for j = 0 upto {vector.length(x.modDecl.bindings) - 1} do
                            declSymbols(toks vector.get(x.modDecl.bindings j) members)
                        end
                        vector.append(acc
                                symbol(toks x.modDecl.name symbolKindModule x.modDecl.interfaceName p.span.startOffset
                                        p.span.endOffset false vector.toArray(members)))
                    when phraseDecl with x then declSymbols(toks x.decl acc)
                    else ok
                end
            end
            vector.toArray(acc)
        end
end
