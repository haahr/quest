(* Quest Self-Hosted Compiler: WebAssembly Operations Implementation *)

module ops : Ops
import
    questlang/wasm/model : questlang/wasm/Model
export
    (* The immediates' kinds, as the table below writes them *)
    let xType = option immType of model.Imm end
    let xFunc = option immFunc of model.Imm end
    let xLocal = option immLocal of model.Imm end
    let xGlobal = option immGlobal of model.Imm end
    let xTag = option immTag of model.Imm end
    let xData = option immData of model.Imm end
    let xMemory = option immMemory of model.Imm end
    let xLabel = option immLabel of model.Imm end
    let xField = option immField of model.Imm end
    let xCount = option immCount of model.Imm end
    let xI32 = option immI32 of model.Imm end
    let xI64 = option immI64 of model.Imm end
    let xOffset = option immOffset of model.Imm end
    let none = array of :model.Imm end
    let op(name: String prefix: Int code: Int imms: Array(model.Imm) align: Int): model.Op =
        tuple let name = name let prefix = prefix let code = code let imms = imms let align = align end

    (* Control: a branch takes a depth, a call a function or its type *)
    let unreachable: model.Op = op("unreachable" 0 0x00 none 0)
    let nop: model.Op = op("nop" 0 0x01 none 0)
    let br: model.Op = op("br" 0 0x0C array of xLabel end 0)
    let brIf: model.Op = op("br_if" 0 0x0D array of xLabel end 0)
    let returnOp: model.Op = op("return" 0 0x0F none 0)
    let call: model.Op = op("call" 0 0x10 array of xFunc end 0)
    let returnCall: model.Op = op("return_call" 0 0x12 array of xFunc end 0)
    let callRef: model.Op = op("call_ref" 0 0x14 array of xType end 0)
    let returnCallRef: model.Op = op("return_call_ref" 0 0x15 array of xType end 0)
    let throw: model.Op = op("throw" 0 0x08 array of xTag end 0)
    let throwRef: model.Op = op("throw_ref" 0 0x0A none 0)
    let drop: model.Op = op("drop" 0 0x1A none 0)
    let brOnNull: model.Op = op("br_on_null" 0 0xD5 array of xLabel end 0)
    let brOnNonNull: model.Op = op("br_on_non_null" 0 0xD6 array of xLabel end 0)

    (* Variables *)
    let localGet: model.Op = op("local.get" 0 0x20 array of xLocal end 0)
    let localSet: model.Op = op("local.set" 0 0x21 array of xLocal end 0)
    let localTee: model.Op = op("local.tee" 0 0x22 array of xLocal end 0)
    let globalGet: model.Op = op("global.get" 0 0x23 array of xGlobal end 0)
    let globalSet: model.Op = op("global.set" 0 0x24 array of xGlobal end 0)

    (* The memory, which holds bytes on their way to and from the host *)
    let i32Load: model.Op = op("i32.load" 0 0x28 array of xOffset end 2)
    let i64Load: model.Op = op("i64.load" 0 0x29 array of xOffset end 3)
    let i32Load8S: model.Op = op("i32.load8_s" 0 0x2C array of xOffset end 0)
    let i32Load8U: model.Op = op("i32.load8_u" 0 0x2D array of xOffset end 0)
    let i32Store: model.Op = op("i32.store" 0 0x36 array of xOffset end 2)
    let i64Store: model.Op = op("i64.store" 0 0x37 array of xOffset end 3)
    let i32Store8: model.Op = op("i32.store8" 0 0x3A array of xOffset end 0)
    let memorySize: model.Op = op("memory.size" 0 0x3F array of xMemory end 0)
    let memoryGrow: model.Op = op("memory.grow" 0 0x40 array of xMemory end 0)
    let memoryCopy: model.Op = op("memory.copy" 0xFC 0x0A array of xMemory xMemory end 0)
    let memoryFill: model.Op = op("memory.fill" 0xFC 0x0B array of xMemory end 0)
    let dataDrop: model.Op = op("data.drop" 0xFC 0x09 array of xData end 0)

    (* Constants of 32 and 64 bits (f64.const is model.f64Const) *)
    let i32Const: model.Op = model.i32ConstOp
    let i64Const: model.Op = model.i64ConstOp

    (* i32 *)
    let i32Eqz: model.Op = op("i32.eqz" 0 0x45 none 0)
    let i32Eq: model.Op = op("i32.eq" 0 0x46 none 0)
    let i32Ne: model.Op = op("i32.ne" 0 0x47 none 0)
    let i32LtS: model.Op = op("i32.lt_s" 0 0x48 none 0)
    let i32LtU: model.Op = op("i32.lt_u" 0 0x49 none 0)
    let i32GtS: model.Op = op("i32.gt_s" 0 0x4A none 0)
    let i32GtU: model.Op = op("i32.gt_u" 0 0x4B none 0)
    let i32LeS: model.Op = op("i32.le_s" 0 0x4C none 0)
    let i32LeU: model.Op = op("i32.le_u" 0 0x4D none 0)
    let i32GeS: model.Op = op("i32.ge_s" 0 0x4E none 0)
    let i32GeU: model.Op = op("i32.ge_u" 0 0x4F none 0)
    let i32Clz: model.Op = op("i32.clz" 0 0x67 none 0)
    let i32Ctz: model.Op = op("i32.ctz" 0 0x68 none 0)
    let i32Popcnt: model.Op = op("i32.popcnt" 0 0x69 none 0)
    let i32Add: model.Op = op("i32.add" 0 0x6A none 0)
    let i32Sub: model.Op = op("i32.sub" 0 0x6B none 0)
    let i32Mul: model.Op = op("i32.mul" 0 0x6C none 0)
    let i32DivS: model.Op = op("i32.div_s" 0 0x6D none 0)
    let i32DivU: model.Op = op("i32.div_u" 0 0x6E none 0)
    let i32RemS: model.Op = op("i32.rem_s" 0 0x6F none 0)
    let i32RemU: model.Op = op("i32.rem_u" 0 0x70 none 0)
    let i32And: model.Op = op("i32.and" 0 0x71 none 0)
    let i32Or: model.Op = op("i32.or" 0 0x72 none 0)
    let i32Xor: model.Op = op("i32.xor" 0 0x73 none 0)
    let i32Shl: model.Op = op("i32.shl" 0 0x74 none 0)
    let i32ShrS: model.Op = op("i32.shr_s" 0 0x75 none 0)
    let i32ShrU: model.Op = op("i32.shr_u" 0 0x76 none 0)
    let i32Rotl: model.Op = op("i32.rotl" 0 0x77 none 0)
    let i32Rotr: model.Op = op("i32.rotr" 0 0x78 none 0)

    (* i64 *)
    let i64Eqz: model.Op = op("i64.eqz" 0 0x50 none 0)
    let i64Eq: model.Op = op("i64.eq" 0 0x51 none 0)
    let i64Ne: model.Op = op("i64.ne" 0 0x52 none 0)
    let i64LtS: model.Op = op("i64.lt_s" 0 0x53 none 0)
    let i64LtU: model.Op = op("i64.lt_u" 0 0x54 none 0)
    let i64GtS: model.Op = op("i64.gt_s" 0 0x55 none 0)
    let i64GtU: model.Op = op("i64.gt_u" 0 0x56 none 0)
    let i64LeS: model.Op = op("i64.le_s" 0 0x57 none 0)
    let i64LeU: model.Op = op("i64.le_u" 0 0x58 none 0)
    let i64GeS: model.Op = op("i64.ge_s" 0 0x59 none 0)
    let i64GeU: model.Op = op("i64.ge_u" 0 0x5A none 0)
    let i64Clz: model.Op = op("i64.clz" 0 0x79 none 0)
    let i64Ctz: model.Op = op("i64.ctz" 0 0x7A none 0)
    let i64Popcnt: model.Op = op("i64.popcnt" 0 0x7B none 0)
    let i64Add: model.Op = op("i64.add" 0 0x7C none 0)
    let i64Sub: model.Op = op("i64.sub" 0 0x7D none 0)
    let i64Mul: model.Op = op("i64.mul" 0 0x7E none 0)
    let i64DivS: model.Op = op("i64.div_s" 0 0x7F none 0)
    let i64DivU: model.Op = op("i64.div_u" 0 0x80 none 0)
    let i64RemS: model.Op = op("i64.rem_s" 0 0x81 none 0)
    let i64RemU: model.Op = op("i64.rem_u" 0 0x82 none 0)
    let i64And: model.Op = op("i64.and" 0 0x83 none 0)
    let i64Or: model.Op = op("i64.or" 0 0x84 none 0)
    let i64Xor: model.Op = op("i64.xor" 0 0x85 none 0)
    let i64Shl: model.Op = op("i64.shl" 0 0x86 none 0)
    let i64ShrS: model.Op = op("i64.shr_s" 0 0x87 none 0)
    let i64ShrU: model.Op = op("i64.shr_u" 0 0x88 none 0)
    let i64Rotl: model.Op = op("i64.rotl" 0 0x89 none 0)
    let i64Rotr: model.Op = op("i64.rotr" 0 0x8A none 0)

    (* f64 *)
    let f64Eq: model.Op = op("f64.eq" 0 0x61 none 0)
    let f64Ne: model.Op = op("f64.ne" 0 0x62 none 0)
    let f64Lt: model.Op = op("f64.lt" 0 0x63 none 0)
    let f64Gt: model.Op = op("f64.gt" 0 0x64 none 0)
    let f64Le: model.Op = op("f64.le" 0 0x65 none 0)
    let f64Ge: model.Op = op("f64.ge" 0 0x66 none 0)
    let f64Abs: model.Op = op("f64.abs" 0 0x99 none 0)
    let f64Neg: model.Op = op("f64.neg" 0 0x9A none 0)
    let f64Ceil: model.Op = op("f64.ceil" 0 0x9B none 0)
    let f64Floor: model.Op = op("f64.floor" 0 0x9C none 0)
    let f64Trunc: model.Op = op("f64.trunc" 0 0x9D none 0)
    let f64Nearest: model.Op = op("f64.nearest" 0 0x9E none 0)
    let f64Sqrt: model.Op = op("f64.sqrt" 0 0x9F none 0)
    let f64Add: model.Op = op("f64.add" 0 0xA0 none 0)
    let f64Sub: model.Op = op("f64.sub" 0 0xA1 none 0)
    let f64Mul: model.Op = op("f64.mul" 0 0xA2 none 0)
    let f64Div: model.Op = op("f64.div" 0 0xA3 none 0)
    let f64Min: model.Op = op("f64.min" 0 0xA4 none 0)
    let f64Max: model.Op = op("f64.max" 0 0xA5 none 0)
    let f64Copysign: model.Op = op("f64.copysign" 0 0xA6 none 0)

    (* Conversions; the saturating truncations do not trap *)
    let i32WrapI64: model.Op = op("i32.wrap_i64" 0 0xA7 none 0)
    let i64ExtendI32S: model.Op = op("i64.extend_i32_s" 0 0xAC none 0)
    let i64ExtendI32U: model.Op = op("i64.extend_i32_u" 0 0xAD none 0)
    let f64ConvertI32S: model.Op = op("f64.convert_i32_s" 0 0xB7 none 0)
    let f64ConvertI64S: model.Op = op("f64.convert_i64_s" 0 0xB9 none 0)
    let f64ConvertI64U: model.Op = op("f64.convert_i64_u" 0 0xBA none 0)
    let i64ReinterpretF64: model.Op = op("i64.reinterpret_f64" 0 0xBD none 0)
    let f64ReinterpretI64: model.Op = op("f64.reinterpret_i64" 0 0xBF none 0)
    let i32Extend8S: model.Op = op("i32.extend8_s" 0 0xC0 none 0)
    let i32Extend16S: model.Op = op("i32.extend16_s" 0 0xC1 none 0)
    let i64Extend8S: model.Op = op("i64.extend8_s" 0 0xC2 none 0)
    let i64Extend16S: model.Op = op("i64.extend16_s" 0 0xC3 none 0)
    let i64Extend32S: model.Op = op("i64.extend32_s" 0 0xC4 none 0)
    let i32TruncSatF64S: model.Op = op("i32.trunc_sat_f64_s" 0xFC 0x02 none 0)
    let i32TruncSatF64U: model.Op = op("i32.trunc_sat_f64_u" 0xFC 0x03 none 0)
    let i64TruncSatF64S: model.Op = op("i64.trunc_sat_f64_s" 0xFC 0x06 none 0)
    let i64TruncSatF64U: model.Op = op("i64.trunc_sat_f64_u" 0xFC 0x07 none 0)

    (* References; ref.null, ref.test, and ref.cast are model.Insts *)
    let refIsNull: model.Op = op("ref.is_null" 0 0xD1 none 0)
    let refFunc: model.Op = op("ref.func" 0 0xD2 array of xFunc end 0)
    let refEq: model.Op = op("ref.eq" 0 0xD3 none 0)
    let refAsNonNull: model.Op = op("ref.as_non_null" 0 0xD4 none 0)
    let refI31: model.Op = op("ref.i31" 0xFB 0x1C none 0)
    let i31GetS: model.Op = op("i31.get_s" 0xFB 0x1D none 0)
    let i31GetU: model.Op = op("i31.get_u" 0xFB 0x1E none 0)
    let anyConvertExtern: model.Op = op("any.convert_extern" 0xFB 0x1A none 0)
    let externConvertAny: model.Op = op("extern.convert_any" 0xFB 0x1B none 0)

    (* Structs: a type, and for an access its field *)
    let structNew: model.Op = op("struct.new" 0xFB 0x00 array of xType end 0)
    let structNewDefault: model.Op = op("struct.new_default" 0xFB 0x01 array of xType end 0)
    let structGet: model.Op = op("struct.get" 0xFB 0x02 array of xType xField end 0)
    let structGetS: model.Op = op("struct.get_s" 0xFB 0x03 array of xType xField end 0)
    let structGetU: model.Op = op("struct.get_u" 0xFB 0x04 array of xType xField end 0)
    let structSet: model.Op = op("struct.set" 0xFB 0x05 array of xType xField end 0)

    (* Arrays: a type, and for array.copy the destination's and the source's *)
    let arrayNew: model.Op = op("array.new" 0xFB 0x06 array of xType end 0)
    let arrayNewDefault: model.Op = op("array.new_default" 0xFB 0x07 array of xType end 0)
    let arrayNewFixed: model.Op = op("array.new_fixed" 0xFB 0x08 array of xType xCount end 0)
    let arrayNewData: model.Op = op("array.new_data" 0xFB 0x09 array of xType xData end 0)
    let arrayGet: model.Op = op("array.get" 0xFB 0x0B array of xType end 0)
    let arrayGetS: model.Op = op("array.get_s" 0xFB 0x0C array of xType end 0)
    let arrayGetU: model.Op = op("array.get_u" 0xFB 0x0D array of xType end 0)
    let arraySet: model.Op = op("array.set" 0xFB 0x0E array of xType end 0)
    let arrayLen: model.Op = op("array.len" 0xFB 0x0F none 0)
    let arrayFill: model.Op = op("array.fill" 0xFB 0x10 array of xType end 0)
    let arrayCopy: model.Op = op("array.copy" 0xFB 0x11 array of xType xType end 0)
    let arrayInitData: model.Op = op("array.init_data" 0xFB 0x12 array of xType xData end 0)
end
