(* Quest Self-Hosted Compiler: The wasm Code Generator Implementation
 *
 * Implements Codegen, compiling described IR into WasmGC modules according
 * to docs/wasm.md: value representation (section 2), closures (section 3),
 * and one module per unit (section 5.1). The sections below cover module and
 * function state, closure types, values, aggregates, descriptors, library
 * externals, statements, and unit assembly. *)

module codegen : Codegen
import
    ascii : Ascii
    conv : Conv
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    sb = util/stringBuilder : util/StringBuilder
    util/strutil : util/Strutil

    questlang/common/maps : questlang/common/Maps
    questlang/common/strings : questlang/common/Strings
    questlang/ir/describe : questlang/ir/Describe
    ir = questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/walk : questlang/ir/Walk
    questlang/repr/externals : questlang/repr/Externals
    questlang/repr/genericLayout : questlang/repr/GenericLayout
    questlang/repr/layout : questlang/repr/Layout
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/repr/staticdata : questlang/repr/StaticData
    reuse = questlang/wasm/locals : questlang/wasm/Locals
    questlang/wasm/model : questlang/wasm/Model
    questlang/wasm/ops : questlang/wasm/Ops
    questlang/wasm/printer : questlang/wasm/Printer
    questlang/wasm/runtime : questlang/wasm/Runtime
    rt = questlang/wasm/runtimeTypes : questlang/wasm/RuntimeTypes
export
    Let Inst = model.Inst
    Let ValType = model.ValType

    let unsupported: Exception(String) = exception unsupported: String end
    let fail(what: String): Ok = raise unsupported with what end

    let noArgs = array of :Int end
    let noTypes = array of :ValType end
    let i(o: model.Op): Inst = model.op(o noArgs)
    let i1(o: model.Op a: Int): Inst = model.op(o array of a end)
    let i2(o: model.Op a: Int b: Int): Inst = model.op(o array of a b end)
    let empty = option blockEmpty of model.BlockType end

    (* ======================================================================
     * The module's state
     * ====================================================================== *)

    (* Shared state while compiling a unit: the output module, the unit's
     * global variable ids (walk.globalVariables) and their WebAssembly global
     * indices, function indices by Function.id, known closures
     * (walk.knownClosures) by variable id, imported runtime functions by
     * field, interned function types by signature text, the string-literal
     * data buffer, fresh-name counters, and record field-offset tables (dict)
     * keyed by view and layout shape ids *)
    Def G = Tuple
        unit: ir.Unit
        m: model.Module
        globalIds: maps.IntSet
        globals: maps.IntMap(Int)
        functions: maps.IntMap(Int)
        known: maps.IntMap(ir.OpMakeClosure)
        runtimeFunctions: maps.StringMap(Int)
        funcTypes: maps.StringMap(Int)
        strings: sb.T
        (* The globals holding the unit's string literals, by text: each the
         * one string its literal denotes, made when first evaluated *)
        literalGlobals: maps.StringMap(Int)
        names: maps.StringMap(Int)
        dicts: maps.StringMap(Int)
        (* Closures (section 3.1): the closure types by signature, each
         * function's own closure type, static closure, and uniform entry,
         * by its id; the types each function captures; the functions by
         * id; the functions declared for ref.func; the global of the closure
         * passed to a direct call of a function that captures nothing; and
         * the static closures of built-in operators used as values
         * (builtinClosure), by operator *)
        closTypes: maps.StringMap(Int)
        ownTypes: maps.IntMap(Int)
        staticClosures: maps.IntMap(Int)
        uniforms: maps.IntMap(Int)
        (* The native entries that trap, for the closures of functions whose
         * results ir/unbox unboxed, by function id (trapNative) *)
        trapNatives: maps.IntMap(Int)
        captureTypes: maps.IntMap(Array(ir.Type))
        byId: maps.IntMap(ir.Function)
        declaredFns: maps.IntSet
        noClosure: Int
        builtins: maps.StringMap(Int)
        (* Other units (section 5.1): the functions imported from each, by
         * "unit.member", each one's init, and the first of its record's two
         * globals, by its canonical name *)
        importFunctions: maps.StringMap(Int)
        importInits: maps.StringMap(Int)
        importRecords: maps.StringMap(Int)
        (* The runtime's units (section 4.5): the functions imported from
         * wasm/core and wasm/print, by "unit.member"; and the globals that
         * hold the unit's descriptors, by their symbol (staticdata) *)
        runtimeUnits: maps.StringMap(Int)
        descGlobals: maps.StringMap(Int)
        (* Whether the unit is one of the runtime's (section 4.5), and whether
         * it is the core, which uses the library only through the members
         * the backend compiles itself *)
        isRuntime: Bool
        isCore: Bool
        (* Whether the unit is a phrase unit, a JIT's input (docs/jit.md
         * section 3.2), whose echoes are written with print's echoText, so
         * that they can be captured (docs/wasm.md section 6.1) *)
        isPhrase: Bool
        (* The variables held in a location (section 2.6): var and out
         * parameters, given their location, and the variables whose address
         * is taken, each held in a slot array of its own from its
         * declaration; by id (locatedVariables) *)
        located: maps.IntSet
        (* The names of record types' descriptors, as the C backend gives
         * them: each ends with a digest of the record's shape, so that two
         * records whose fields lay out alike are not one descriptor *)
        naming: staticdata.RecordNaming
        (* How many times each variable is used, by id, and the variables
         * named from outside the bodies (walk.countUses), for joining chains
         * of <> (concatSite) *)
        uses: maps.IntMap(Int)
        pinned: maps.IntSet
    end

    (* A name not given before among names: base, or base.k *)
    let fresh(names: maps.StringMap(Int) base: String): String =
        begin
            let root = if stringOp.isEmpty(base) then "v" else base end
            let n = maybe.unwrapOr(hashMap.get(names root) 0)
            hashMap.insert(names root n + 1)
            if n is 0 then root else root <> "." <> conv.int(n) end
        end

    let typeCount(m: model.Module): Int =
        begin
            let var n = 0
            for k = 0 upto vector.length(m.types) - 1 do
                n := n + extent vector.get(:model.RecGroup m.types k)
            end
            n
        end

    (* The index of the function type of params and results, made once *)
    let funcType(g: G params: Array(ValType) results: Array(ValType)): Int =
        begin
            let key = sb.new()
            for k = 0 upto extent params - 1 do sb.str(key printer.valType(g.m params[k]) <> " ") end
            sb.str(key "->")
            for k = 0 upto extent results - 1 do sb.str(key " " <> printer.valType(g.m results[k])) end
            (* toString empties the builder, so the key is taken once *)
            let text = sb.toString(key)
            let known = hashMap.get(g.funcTypes text)
            if maybe.isSome(known) then
                maybe.unwrap(known)
            else
                let n = typeCount(g.m)
                vector.append(g.m.types array of
                    tuple
                        let name = ""
                        let final = true
                        let supers = array of :Int end
                        let composite = option compFunc of model.Composite with
                            let params = params
                            let results = results
                        end
                    end
                end)
                hashMap.insert(g.funcTypes text n)
                n
            end
        end

    (* A value's representation in a local, a parameter, or a result (section
     * 3.2), from its type's *)
    let valType(t: ir.Type): ValType =
        case layout.representationKind(t)
            when repInt, repWord then model.i64
            when repBool, repChar then model.i32
            when repVoid, repPointer, repQVal then model.eqref
            when repReal then model.f64
            when repRecord then model.eqref
            when repVariant then
                fail("a variant as one value")
                model.eqref
        end

    let isRecord(t: ir.Type): Bool = layout.representationKind(t)?repRecord
    let isVariant(t: ir.Type): Bool = layout.representationKind(t)?repVariant
    let locationParts = array of model.refNull(rt.index("slots")) model.i32 end
    (* Whether t is the type of a location (section 2.6): a cell's, or an
     * out parameter's *)
    let isLocation(t: ir.Type): Bool =
        begin
            let s = layout.resolvedShape(shapes.shape(t))
            shapes.kindIs(s shapes.shapeCell) orif shapes.kindIs(s shapes.shapeOut)
        end
    (* The values a value of type t is held as: two for a record, its payload
     * and its view's table, and two for a variant, its tag and its payload
     * (section 2.5); two for a location, a slot array and an index in it
     * (section 2.6); else one *)
    let parts(t: ir.Type): Array(ValType) =
        if isRecord(t) then array of model.eqref model.eqref end
        elsif isVariant(t) then array of model.i32 model.eqref end
        elsif isLocation(t) then locationParts
        else array of valType(t) end
        end

    let sameType(a: ValType b: ValType): Bool =
        case a
            when valI32 then b?valI32 when valI64 then b?valI64 when valF32 then b?valF32 when valF64 then b?valF64
            when valRef then b?valRef
        end
    let sameTypes(a: Array(ValType) b: Array(ValType)): Bool =
        begin
            let var same = {extent a} is {extent b}
            if same then for k = 0 upto extent a - 1 do if not(sameType(a[k] b[k])) then same := false end end end
            same
        end

    (* ======================================================================
     * A function's state
     * ====================================================================== *)

    (* An open WebAssembly structured instruction: an IR loop's exit block or
     * loop header, a join point's block or outer after-block, an if, or a
     * try_table body (labelTry, inside which tail calls are disallowed because
     * a tail call would leave the handler; see insideTry) *)
    Def LabelKind = Option labelExit labelRepeat labelJoin labelAfter labelIf labelTry end
    Def Label = Tuple name: String kind: LabelKind end

    (* A capture to fill in: the closure, in local holder, of own type own,
     * the fields from field on that hold its parts (two for a record or a
     * variant), and the atom it captures *)
    Def Patch = Tuple holder: Int own: Int field: Int parts: Array(ValType) atom: ir.Atom end

    (* What compiling one function keeps: its code, its locals by variable
     * id, its locals after its parameters, their names, the labels open,
     * innermost last, its results, the join points whose continuations
     * only return their one parameter, and each join point's parameters *)
    Def F = Tuple
        g: G
        code: vector.T(Inst)
        locals: maps.IntMap(Int)
        declared: vector.T(model.Local)
        nparams: Int
        names: maps.StringMap(Int)
        labels: vector.T(Label)
        results: Array(ValType)
        returning: maps.StringMap(Bool)
        joins: maps.StringMap(Array(ir.Variable))
        (* The function compiled (~1 for the top level), the variables a
         * recursive value's body is binding, and the captures of theirs to
         * fill in once it has (sLetRec) *)
        fnId: Int
        deferred: maps.IntSet
        patches: vector.T(Patch)
        (* Whether a call of the function itself in tail position branched
         * to the loop around its code (selfLabel) *)
        var selfTail: Bool
        (* The statement that runs when the body being compiled falls off its
         * end, if it is known: the one after the if, switch, or join it is
         * part of, so that a call there can be a tail call; none in a loop's
         * body, which repeats, or a try's *)
        var after: maybe.T(ir.Stmt)
        (* An accumulating recursion's (accumulation): the operation its
         * results combine with, 0 for none, 1 for +, 2 for times, and its
         * accumulator's local *)
        var accOp: Int
        var accLocal: Int
    end

    (* The label of the loop around a function's code, which no IR label is
     * named *)
    let selfLabel = "<self>"

    let newF(g: G params: Array(String) results: Array(ValType) fnId: Int): F =
        begin
            let names = maps.newStringMap(:Int)
            tuple
                let g = g
                let code = vector.new()
                let locals = maps.newIntMap()
                let declared = vector.new()
                let nparams = extent params
                let names = names
                let labels = vector.new()
                let results = results
                let returning = maps.newStringMap()
                let joins = maps.newStringMap()
                let fnId = fnId
                let deferred = maps.newIntSet()
                let patches = vector.new()
                let var selfTail = false
                let var after = maybe.none()
                let var accOp = 0
                let var accLocal = ~1
            end
        end

    let emit(f: F x: Inst): Ok = vector.append(f.code x)

    let sameKind(a: LabelKind b: LabelKind): Bool =
        case a
            when labelExit then b?labelExit when labelRepeat then b?labelRepeat when labelJoin then b?labelJoin
            when labelAfter then b?labelAfter when labelIf then b?labelIf when labelTry then b?labelTry
        end

    let open(f: F name: String kind: LabelKind): Ok = vector.append(f.labels tuple let name = name let kind = kind end)
    let close(f: F): Ok =
        begin
            vector.pop(f.labels)
            emit(f model.endInst)
        end

    (* Whether a label named name is open *)
    let hasLabel(f: F name: String): Bool =
        begin
            let var found = false
            for k = 0 upto vector.length(f.labels) - 1 do
                if stringOp.equal(vector.get(f.labels k).name name) then found := true end
            end
            found
        end

    (* The depth of a branch to the label named name of kind kind *)
    let depth(f: F name: String kind: LabelKind): Int =
        begin
            let n = vector.length(f.labels)
            let var found = ~1
            for k = 0 upto n - 1 do
                let l = vector.get(f.labels k)
                if stringOp.equal(l.name name) andif sameKind(l.kind kind) then found := {n - 1} - k end
            end
            if found < 0 then fail("a branch to " <> name <> ", which is not open") end
            found
        end

    let isGlobal(f: F v: ir.Variable): Bool = hashSet.contains(f.g.globalIds v.id)

    (* The shape of a value of type t, through its bound, if it has one *)
    let shapeOf(t: ir.Type): shapes.Shape = layout.resolvedShape(shapes.shape(t))
    let componentType(s: shapes.Shape i: Int): ir.Type = shapes.componentShape(s.components[i]).type

    (* The representations of an unboxed tuple's components (ir/unbox): each
     * is its parts, never allocated *)
    let componentTypes(t: ir.Type): Array(ValType) =
        begin
            let s = shapeOf(t)
            let ts = vector.new(:ValType)
            for k = 0 upto extent s.components - 1 do
                let ps = parts(componentType(s k))
                for j = 0 upto extent ps - 1 do vector.append(ts ps[j]) end
            end
            vector.toArray(ts)
        end
    (* Where an unboxed tuple's component index begins among its values *)
    let componentOffset(s: shapes.Shape index: Int): Int =
        begin
            let var at = 0
            for k = 0 upto index - 1 do at := at + extent parts(componentType(s k)) end
            at
        end

    (* The values variable v is held as: a located variable's location, an
     * unboxed tuple's components, a boxed record's box, or its type's
     * parts *)
    let varParts(g: G v: ir.Variable): Array(ValType) =
        if hashSet.contains(g.located v.id) then locationParts
        elsif v.unboxed then componentTypes(v.type)
        elsif v.boxed then array of model.eqref end
        else parts(v.type)
        end

    (* v's globals, made the first time it is named: the first of one for
     * each of its parts *)
    let global(f: F v: ir.Variable): Int =
        if hashMap.contains(f.g.globals v.id) then
            hashMap.find(f.g.globals v.id)
        else
            let ts = varParts(f.g v)
            let n = model.importedGlobals(f.g.m) + vector.length(f.g.m.globals)
            for k = 0 upto extent ts - 1 do
                let init =
                    case ts[k]
                        when valI64 then model.i64Const(0)
                        when valI32 then model.i32Const(0)
                        when valF64 then model.f64Const(0.0)
                        else option instRefNull of Inst with let heap = option heapNone of model.HeapType end end
                    end
                vector.append(f.g.m.globals tuple
                    let name = fresh(f.g.names v.hint)
                    let type = ts[k]
                    let mutable = true
                    let init = array of init end
                end)
            end
            hashMap.insert(f.g.globals v.id n)
            n
        end

    (* A new local of type t, for the code's own use *)
    let scratch(f: F t: ValType): Int =
        begin
            let n = f.nparams + vector.length(f.declared)
            vector.append(f.declared tuple let name = fresh(f.names "t") let type = t end)
            n
        end

    (* ======================================================================
     * Closures' types (section 3)
     * ====================================================================== *)

    (* A block's type, of the values types it gives *)
    let blockOf(f: F types: Array(ValType)): model.BlockType =
        if extent types is 0 then empty
        elsif extent types is 1 then option blockValue of model.BlockType with let type = types[0] end
        else option blockIndex of model.BlockType with let index = funcType(f.g noTypes types) end
        end

    (* A function's parameters' and results' representations *)
    Def Signature = Tuple params: Array(ValType) results: Array(ValType) end
    let tClos = rt.index("clos")
    let addType(g: G sub: model.SubType): Int =
        begin
            let n = typeCount(g.m)
            vector.append(g.m.types array of sub end)
            n
        end
    let fieldOf(name: String t: ValType mutable: Bool): model.Field =
        tuple
            let name = name
            let storage = option storageValue of model.Storage with let type = t end
            let mutable = mutable
        end
    let hashField = fieldOf("hash" model.i32 true)
    let structSub(name: String final: Bool super: Int fields: Array(model.Field)): model.SubType =
        tuple
            let name = name
            let final = final
            let supers = array of super end
            let composite = option compStruct of model.Composite with let fields = fields end
        end

    (* A function type's quantifiers' type parameters, how many, and its
     * body, a function's shape or, for a type-only function, its result's *)
    Def Quantified = Tuple count: Int body: shapes.Shape end
    let quantified(t: ir.Type): Quantified =
        begin
            let var s = shapeOf(t)
            let var count = 0
            while shapes.kindIs(s shapes.shapeAll) do
                count := count + extent s.typeParams
                s := shapes.body(s)
            end
            tuple let count = count let body = s end
        end

    (* A type-only function's closure signature: a descriptor for each type
     * parameter, and its result's parts *)
    let typeOnlySig(q: Quantified): Signature =
        tuple let params = array of(q.count model.eqref) let results = parts(q.body.type) end

    (* A function type's closure signature (section 3.2): a descriptor for
     * each of its quantifiers' type parameters, then each parameter's parts
     * (a location's for a var or out parameter), and its result's parts; the
     * closure itself, which comes first, is not among them (withClosure) *)
    let closureSig(t: ir.Type): Signature =
        begin
            let q = quantified(t)
            let s = q.body
            if {q.count > 0} andif not(shapes.kindIs(s shapes.shapeFun)) then
                typeOnlySig(q)
            else
                if not(shapes.kindIs(s shapes.shapeFun)) then fail("a call of a value of no function type") end
                (* each quantifier's descriptors first (section 3.2) *)
                let ps = vector.new(:ValType)
                for k = 0 upto q.count - 1 do vector.append(ps model.eqref) end
                for k = 0 upto extent s.params - 1 do
                    let pp = if stringOp.equal(s.params[k].mode "value") then parts(s.params[k].shape.type)
                        else locationParts
                        end
                    for j = 0 upto extent pp - 1 do vector.append(ps pp[j]) end
                end
                tuple let params = vector.toArray(ps) let results = parts(shapes.result(s).type) end
            end
        end
    (* How many parameters a function type has, its descriptors among them *)
    let arity(t: ir.Type): Int =
        begin
            let q = quantified(t)
            q.count + if shapes.kindIs(q.body shapes.shapeFun) then extent q.body.params else 0 end
        end
    (* Whether a function is an adapter (ir/thunks): its environment is the
     * closure it adapts, of that closure's type, where a lifted function's
     * has the placeholder type Ok *)
    let isAdapter(fn: ir.Function): Bool =
        maybe.isSome(fn.env) andif not(layout.representationKind(maybe.unwrap(fn.env).type)?repVoid)

    (* How many of a function's type parameters its closure supplies, as
     * captures, rather than its callers (the rest) *)
    let capturedDescriptors(fn: ir.Function): Int = extent fn.typeParams - quantified(fn.v.type).count

    let withClosure(ts: Array(ValType)): Array(ValType) =
        begin
            let all = array of(extent ts + 1 model.ref(tClos))
            for k = 0 upto extent ts - 1 do all[k + 1] := ts[k] end
            all
        end
    let eqrefs(n: Int): Array(ValType) = array of(n model.eqref)

    (* The uniform entry's type for n parameters, and a native entry's *)
    let uniformType(g: G n: Int): Int = funcType(g withClosure(eqrefs(n)) array of model.eqref end)
    let nativeType(g: G sig: Signature): Int = funcType(g withClosure(sig.params) sig.results)

    (* Whether a signature is the uniform one, so that one function is both
     * entries *)
    let isUniform(sig: Signature n: Int): Bool =
        begin
            let var all = {extent sig.params is n} andif {extent sig.results is 1} andif sig.results[0]?valRef
            for k = 0 upto extent sig.params - 1 do if not(sig.params[k]?valRef) then all := false end end
            all
        end

    (* $closU(n), a subtype of $clos with the uniform entry; $closS, of that
     * with the native entry, for signature sig (section 3.1) *)
    let closU(g: G n: Int): Int =
        begin
            let key = "U" <> conv.int(n)
            if hashMap.contains(g.closTypes key) then
                hashMap.find(g.closTypes key)
            else
                let t = addType(g structSub("closU" <> conv.int(n) false tClos
                        array of hashField fieldOf("uniform" model.ref(uniformType(g n)) false) end))
                hashMap.insert(g.closTypes key t)
                t
            end
        end
    let sigText(g: G sig: Signature): String =
        begin
            let b = sb.new()
            for k = 0 upto extent sig.params - 1 do sb.str(b printer.valType(g.m sig.params[k]) <> " ") end
            sb.str(b "->")
            for k = 0 upto extent sig.results - 1 do sb.str(b " " <> printer.valType(g.m sig.results[k])) end
            sb.toString(b)
        end
    let closS(g: G sig: Signature n: Int): Int =
        begin
            let key = "S" <> conv.int(n) <> ":" <> sigText(g sig)
            if hashMap.contains(g.closTypes key) then
                hashMap.find(g.closTypes key)
            else
                let u = closU(g n)
                let t = addType(g structSub("" false u array of
                    hashField fieldOf("uniform" model.ref(uniformType(g n)) false)
                    fieldOf("native" model.ref(nativeType(g sig)) false)
                end))
                hashMap.insert(g.closTypes key t)
                t
            end
        end

    (* A function's own closure type, final, which adds its captures, each of
     * its parts a mutable field (so that a recursive value's can be filled
     * in) *)
    let ownType(g: G fn: ir.Function): Int =
        if hashMap.contains(g.ownTypes fn.id) then
            hashMap.find(g.ownTypes fn.id)
        else
            let sig = closureSig(fn.v.type)
            let n = arity(fn.v.type)
            let fields = vector.new(:model.Field)
            vector.append(fields hashField)
            vector.append(fields fieldOf("uniform" model.ref(uniformType(g n)) false))
            vector.append(fields fieldOf("native" model.ref(nativeType(g sig)) false))
            for k = 0 upto capturedDescriptors(fn) - 1 do
                vector.append(fields fieldOf("d" <> conv.int(k) model.eqref true))
            end
            let captures = maybe.unwrapOr(hashMap.get(g.captureTypes fn.id)
                    array of :ir.Type end)
            for k = 0 upto extent captures - 1 do
                let ps = parts(captures[k])
                for j = 0 upto extent ps - 1 do
                    let suffix = if j > 0 then "." <> conv.int(j) else "" end
                    vector.append(fields fieldOf("c" <> conv.int(k) <> suffix ps[j] true))
                end
            end
            let t = addType(g structSub(fresh(g.names fn.v.hint <> ".closure") true closS(g sig n)
                    vector.toArray(fields)))
            hashMap.insert(g.ownTypes fn.id t)
            t
        end

    (* The field of a function's own closure type that holds the first part of
     * its capture index *)
    let captureField(g: G fn: ir.Function index: Int): Int =
        begin
            let captures = maybe.unwrapOr(hashMap.get(g.captureTypes fn.id)
                    array of :ir.Type end)
            let var at = 3 + capturedDescriptors(fn)
            for k = 0 upto index - 1 do at := at + extent parts(captures[k]) end
            at
        end

    (* Declares the function index for ref.func, once: WebAssembly lets a
     * function's code take a reference only to a function the module
     * declares (model.Module.declared) *)
    let declare(g: G index: Int): Ok =
        if not(hashSet.contains(g.declaredFns index)) then
            hashSet.insert(g.declaredFns index)
            vector.append(g.m.declared index)
        end

    (* v's local, made the first time it is bound; an unboxed tuple's first,
     * of one for each of its components *)
    let local(f: F v: ir.Variable): Int =
        if hashMap.contains(f.locals v.id) then
            hashMap.find(f.locals v.id)
        else
            let n = f.nparams + vector.length(f.declared)
            let ts = varParts(f.g v)
            for k = 0 upto extent ts - 1 do
                vector.append(f.declared tuple let name = fresh(f.names v.hint) let type = ts[k] end)
            end
            hashMap.insert(f.locals v.id n)
            n
        end

    let isLocated(f: F v: ir.Variable): Bool = hashSet.contains(f.g.located v.id)

    (* Stores the values on the stack in v's own parts: a located variable's
     * location itself *)
    let setParts(f: F v: ir.Variable): Ok =
        begin
            let n = extent varParts(f.g v)
            if isGlobal(f v) then
                let first = global(f v)
                for k = n - 1 downto 0 do emit(f i1(ops.globalSet first + k)) end
            else
                let first = local(f v)
                for k = n - 1 downto 0 do emit(f i1(ops.localSet first + k)) end
            end
        end

    (* Pushes v's own parts: a located variable's location itself *)
    let getParts(f: F v: ir.Variable): Ok =
        begin
            let n = extent varParts(f.g v)
            if isGlobal(f v) then
                let first = global(f v)
                for k = 0 upto n - 1 do emit(f i1(ops.globalGet first + k)) end
            elsif not(hashMap.contains(f.locals v.id)) then
                fail("the variable " <> v.hint <> ", which has no value here")
            else
                let first = hashMap.find(f.locals v.id)
                for k = 0 upto n - 1 do emit(f i1(ops.localGet first + k)) end
            end
        end

    (* ======================================================================
     * Values
     * ====================================================================== *)

    (* A new mutable global of the unit, null to begin with *)
    let newGlobal(g: G name: String): Int =
        begin
            let n = model.importedGlobals(g.m) + vector.length(g.m.globals)
            vector.append(g.m.globals tuple
                let name = fresh(g.names name)
                let type = model.eqref
                let mutable = true
                let init =
                    array of option instRefNull of Inst with let heap = option heapNone of model.HeapType end end end
            end)
            n
        end

    (* A new string of s's bytes, from the data segment, its hash word hash:
     * 0, or readOnly's bit *)
    let stringOf(f: F s: String hash: Int): Ok =
        begin
            let offset = sb.length(f.g.strings)
            sb.str(f.g.strings s)
            let n = stringOp.length(s)
            emit(f model.i32Const(hash))
            emit(f model.i32Const(n))
            if n is 0 then
                (* none from the segment, which a unit whose literals are all
                 * empty lacks (section 2.7) *)
                emit(f model.i32Const(0))
                emit(f i1(ops.arrayNewDefault rt.index("bytes")))
            else
                emit(f model.i32Const(offset))
                emit(f model.i32Const(n))
                emit(f i2(ops.arrayNewData rt.index("bytes") 0))
            end
            emit(f i1(ops.structNew rt.index("string")))
        end

    (* A new string of the backend's own text s, which no program names *)
    let literal(f: F s: String): Ok = stringOf(f s 0)

    (* The bit of a string's hash word that marks it read-only, as a native
     * string's header bit does (Q_HEADER_READONLY): objects' hashes are below
     * it (runtime/wasm/core's objectHash) *)
    let readOnly = 1073741824

    (* Emits the string denoted by a Quest string literal: one read-only
     * instance per distinct text in the unit, identical across evaluations, so
     * setChar and setSub raise string.error on it (docs/extensions.md, String
     * Literals). Each literal is allocated lazily on first evaluation and
     * cached in a global, avoiding the startup cost of allocating thousands of
     * literals at unit init. *)
    let questLiteral(f: F s: String): Ok =
        begin
            if not(hashMap.contains(f.g.literalGlobals s)) then
                hashMap.insert(f.g.literalGlobals s newGlobal(f.g "literal"))
            end
            let held = hashMap.find(f.g.literalGlobals s)
            emit(f i1(ops.globalGet held))
            emit(f i(ops.refIsNull))
            emit(f model.ifInst(empty ""))
            stringOf(f s readOnly)
            emit(f i1(ops.globalSet held))
            emit(f model.endInst)
            emit(f i1(ops.globalGet held))
        end

    let constant(f: F c: ir.Const): Ok =
        case c.value
            when constInt with x then emit(f model.i64Const(x.n))
            when constBool with x then emit(f model.i32Const(if x.b then 1 else 0 end))
            when constChar with x then emit(f model.i32Const(ascii.val(x.c)))
            when constString with x then questLiteral(f x.s)
            when constOk then
                emit(f model.i32Const(0))
                emit(f i(ops.refI31))
            when constReal with x then emit(f model.f64Const(x.r))
        end

    (* The atom's own parts: a located variable's location, not its value
     * (atom reads that) *)
    let atomParts(f: F a: ir.Atom): Ok =
        case a
            when atomVar with x then getParts(f x.v)
            when atomConst with x then constant(f x.c)
        end

    let atomType(a: ir.Atom): ValType = valType(ir.atomType(a))

    (* Returns the function index of this unit's local copy of boxInt or
     * unboxInt (storing 31-bit signed Ints in unallocated i31refs and larger
     * Ints in $boxInt structs), creating it on first use. Calling the runtime
     * module's exports crosses an instance boundary that V8 cannot inline, and
     * Int boxing accounts for roughly a tenth of self-compilation time
     * (benchmarks.md section 25). *)
    let intBoxing(g: G field: String): Int =
        begin
            let key = "own." <> field
            if hashMap.contains(g.runtimeFunctions key) then
                hashMap.find(g.runtimeFunctions key)
            else
                let tBoxInt = rt.index("boxInt")
                let i31 = option heapI31 of model.HeapType end
                let boxing = stringOp.equal(field "boxInt")
                let results = array of if boxing then model.eqref else model.i64 end end
                let f = newF(g array of if boxing then "n" else "e" end end results ~1)
                if boxing then
                    (* n fits in 31 bits when n + 2^30, read as unsigned, is
                     * below 2^31 *)
                    emit(f i1(ops.localGet 0))
                    emit(f model.i64Const(0x40000000))
                    emit(f i(ops.i64Add))
                    emit(f model.i64Const(0x80000000))
                    emit(f i(ops.i64LtU))
                    emit(f model.ifInst(option blockValue of model.BlockType with let type = model.eqref end ""))
                    emit(f i1(ops.localGet 0))
                    emit(f i(ops.i32WrapI64))
                    emit(f i(ops.refI31))
                    emit(f model.elseInst)
                    emit(f i1(ops.localGet 0))
                    emit(f i1(ops.structNew tBoxInt))
                    emit(f model.endInst)
                else
                    (* an i31 branches out of the block to be sign-extended;
                     * anything else is a $boxInt, whose i64 it returns *)
                    emit(f model.blockInst(option blockValue of model.BlockType with
                        let type = model.refTo(false i31)
                    end "small"))
                    emit(f i1(ops.localGet 0))
                    emit(f option instBrOnCast of Inst with
                        let fail = false
                        let label = 0
                        let from = tuple let nullable = true let heap = option heapEq of model.HeapType end end
                        let to = tuple let nullable = false let heap = i31 end
                    end)
                    emit(f option instRefCast of Inst with
                        let type = tuple
                            let nullable = false
                            let heap = option heapIndex of model.HeapType with let index = tBoxInt end
                        end
                    end)
                    emit(f i2(ops.structGet tBoxInt 0))
                    emit(f i(ops.returnOp))
                    emit(f model.endInst)
                    emit(f i(ops.i31GetS))
                    emit(f i(ops.i64ExtendI32S))
                end
                let index = model.importedFunctions(g.m) + vector.length(g.m.functions)
                vector.append(g.m.functions tuple
                    let name = fresh(g.names field)
                    let type = funcType(g array of if boxing then model.i64 else model.eqref end end results)
                    let params = array of if boxing then "n" else "e" end end
                    let locals = f.declared
                    let body = f.code
                end)
                hashMap.insert(g.runtimeFunctions key index)
                index
            end
        end

    (* A call of the runtime's function field (boxInt and unboxInt the
     * unit's own copies); unsupported if the runtime has none *)
    let runtimeCall(f: F field: String): Ok =
        if stringOp.equal(field "boxInt") orif stringOp.equal(field "unboxInt") then
            emit(f i1(ops.call intBoxing(f.g field)))
        elsif hashMap.contains(f.g.runtimeFunctions field) then
            emit(f i1(ops.call hashMap.find(f.g.runtimeFunctions field)))
        else
            fail("the runtime's " <> field)
        end

    (* A built-in exception's global, imported from the runtime first *)
    let builtinException(name: String): Int =
        begin
            let var found = ~1
            for k = 0 upto extent runtime.builtinExceptions - 1 do
                if stringOp.equal(runtime.builtinExceptions[k] name) then found := k end
            end
            if found < 0 then fail("the built-in exception " <> name) end
            found
        end

    (* The site of an offset, as an uncaught report writes it *)
    let siteText(f: F offset: maybe.T(Int)): String =
        if maybe.isNone(offset) then ""
        else maybe.unwrapOr(ir.site(f.g.unit maybe.unwrap(offset)) "")
        end

    (* Raises the built-in exception named name, with payload Ok, at the
     * site of offset, through the runtime's raise; nothing follows it *)
    let raiseAt(f: F name: String offset: maybe.T(Int)): Ok =
        begin
            emit(f i1(ops.globalGet builtinException(name)))
            emit(f model.i32Const(0))
            emit(f i(ops.refI31))
            literal(f siteText(f offset))
            literal(f "")
            emit(f model.i32Const(0))
            emit(f option instRefNull of Inst with let heap = option heapNone of model.HeapType end end)
            runtimeCall(f "raise")
            emit(f i(ops.unreachable))
        end

    (* The f64 on the stack, raising real.error at offset if it is a NaN *)
    let notNaN(f: F offset: maybe.T(Int)): Ok =
        begin
            let r = scratch(f model.f64)
            (* a NaN is the one value not equal to itself *)
            emit(f i1(ops.localTee r))
            emit(f i1(ops.localGet r))
            emit(f i(ops.f64Ne))
            emit(f model.ifInst(empty ""))
            raiseAt(f "real.error" offset)
            emit(f model.endInst)
            emit(f i1(ops.localGet r))
        end

    (* The f64 on the stack as an Int, raising real.error outside an i64's
     * range or for a NaN (quest_real_to_int, section 2.10) *)
    let realToInt(f: F): Ok =
        begin
            let r = scratch(f model.f64)
            emit(f i1(ops.localTee r))
            emit(f model.f64Const(~9223372036854775808.0))
            emit(f i(ops.f64Ge))
            emit(f i1(ops.localGet r))
            emit(f model.f64Const(9223372036854775808.0))
            emit(f i(ops.f64Lt))
            emit(f i(ops.i32And))
            emit(f i(ops.i32Eqz))
            emit(f model.ifInst(empty ""))
            raiseAt(f "real.error" maybe.none())
            emit(f model.endInst)
            emit(f i1(ops.localGet r))
            emit(f i(ops.i64TruncSatF64S))
        end

    (* How the uncaught report writes a payload of type t: the kind the
     * runtime's show and raise take, 1 to 8 for a value echo writes with no
     * descriptor (Int, Bool, Char, String, Ok, Word, a function, an abstract
     * type's value, in that order), 9 for one that needs a descriptor *)
    let payloadKind(t: ir.Type): Int =
        begin
            let kind = describe.echoValueKind(t)
            let named = fun(k: String): Bool stringOp.equal(kind k)
            if named("Int") then 1
            elsif named("Bool") then 2
            elsif named("Char") then 3
            elsif named("String") then 4
            elsif named("Ok") then 5
            elsif named("Word") orif named("Word.T") orif named("word.T") then 6
            elsif named("fun") then 7
            elsif named("hidden") then 8
            else 9
            end
        end

    (* ======================================================================
     * Aggregates (section 2)
     * ====================================================================== *)

    let heapOf(t: Int): model.HeapType = option heapIndex of model.HeapType with let index = t end
    let castTo(f: F t: Int): Ok =
        emit(f option instRefCast of Inst with let type = tuple let nullable = false let heap = heapOf(t) end end)
    let castI31(f: F): Ok =
        emit(f option instRefCast of Inst with
            let type = tuple let nullable = false let heap = option heapI31 of model.HeapType end end
        end)
    let tSlots = rt.index("slots")
    let tTuple = rt.index("tuple")
    let tOption = rt.index("option")
    let tArray = rt.index("array")
    let fSlots = rt.field("tuple" "slots")
    let fTag = rt.field("option" "tag")
    let fElems = rt.field("array" "elems")

    (* ======================================================================
     * Descriptors (section 4.5)
     * ====================================================================== *)

    (* Whether the unit named name is one of the runtime's, which import no
     * runtime unit but the core *)
    let isRuntimeUnit(name: String): Bool = stringOp.equal(name "wasm/core") orif stringOp.equal(name "wasm/print")

    (* Emits a call to the runtime unit function named by key (for example,
     * "wasm/core.member"). Because a Quest function's native entry takes its
     * closure first, the caller pushes noClosure before the arguments; host
     * functions (quest.host) take no closure. *)
    let runtimeUnitCall(f: F key: String): Ok =
        if hashMap.contains(f.g.runtimeUnits key) then
            emit(f i1(ops.call hashMap.find(f.g.runtimeUnits key)))
        else
            fail("the runtime's " <> key)
        end

    (* A descriptor's kind, as wasm/core numbers them, from its form's
     * QTypeKind constant *)
    let kindOf(constant: String): Int =
        begin
            let names = array of
                "" "INT" "REAL" "BOOL" "CHAR" "STRING" "OK" "WORD" "FUN" "TUPLE" "RECORD" "OPTION" "VARIANT" "ARRAY"
                "EXCEPTION" "OPAQUE" "AUTO" "BOUND_VAR" "HOLE" "STORED"
            end
            let var found = ~1
            for k = 1 upto extent names - 1 do
                if stringOp.equal(constant "QTYPE_KIND_" <> names[k]) then found := k end
            end
            if found < 0 then fail("the descriptor kind " <> constant) end
            found
        end
    (* The C runtime's descriptors, which staticdata names by symbol, and
     * their kinds (kindOf's numbers); quest_type_bound_vars is the bound
     * variable of index 0, the others made by the core's boundVar *)
    let baseSymbols = array of
        "quest_type_Int" "quest_type_Real" "quest_type_Bool" "quest_type_Char" "quest_type_String" "quest_type_Ok"
        "quest_type_Word" "quest_type_EmptyTuple" "quest_type_bound_vars"
    end
    let baseKinds = array of 1 2 3 4 5 6 7 9 17 end

    (* The descriptors the unit's static data needs, the base ones and those
     * collected (staticdata), each a global, which makeDescriptors fills
     * in: the forms of the latter, in their order *)
    let descriptorGlobals(g: G): vector.T(staticdata.DescriptorForm) =
        begin
            let data = maybe.unwrap(g.unit.staticData)
            for k = 0 upto extent baseSymbols - 1 do
                hashMap.insert(g.descGlobals baseSymbols[k] newGlobal(g baseSymbols[k]))
            end
            let plain = vector.new(:ir.Type)
            let echoed = vector.new(:ir.Type)
            for k = 0 upto vector.length(data.descriptors) - 1 do
                let d = vector.get(data.descriptors k)
                vector.append(if d.echo then echoed else plain end d.type)
            end
            (* and the representations of its modules' abstract types, which it
             * registers *)
            for k = 0 upto vector.length(g.unit.modules) - 1 do
                let entries = vector.get(g.unit.modules k).abstractTypes
                for j = 0 upto extent entries - 1 do vector.append(plain entries[j].descriptor.type) end
            end
            let collected =
                try
                    staticdata.collectDescriptors(plain echoed maybe.some(g.naming)
                            maps.newStringSet())
                when staticdata.missingDescriptor with msg then
                    fail("a descriptor: " <> msg)
                    staticdata.collectDescriptors(vector.new() vector.new()
                            maybe.some(g.naming) maps.newStringSet())
                end
            let forms = vector.new(:staticdata.DescriptorForm)
            for k = 0 upto extent staticdata.descriptorKinds - 1 do
                let fs = staticdata.formsOf(collected staticdata.descriptorKinds[k])
                for j = 0 upto vector.length(fs) - 1 do
                    let form = vector.get(fs j)
                    if not(hashMap.contains(g.descGlobals form.symbol)) then
                        hashMap.insert(g.descGlobals form.symbol newGlobal(g form.tag))
                        vector.append(forms form)
                    end
                end
            end
            forms
        end

    (* The global of the descriptor a symbol names *)
    let descGlobal(f: F symbol: String): Int =
        if hashMap.contains(f.g.descGlobals symbol) then hashMap.find(f.g.descGlobals symbol)
        else raise unsupported with "the descriptor " <> symbol <> ", which the unit does not make" end
        end

    (* The form of static descriptor d: its echo form when d is echoed and has
     * one, else its plain form; unsupported if staticdata cannot describe
     * it *)
    let formOf(g: G d: ir.StaticDescriptor): staticdata.DescriptorForm =
        try
            let naming = maybe.some(g.naming)
            let echo = if d.echo then staticdata.echoDescriptorForm(d.type naming)
                else maybe.none(:staticdata.DescriptorForm)
                end
            if maybe.isSome(echo) then maybe.unwrap(echo)
            else staticdata.descriptorForm(d.type naming)
            end
        when staticdata.missingDescriptor with msg then raise unsupported with "a descriptor: " <> msg end
        end

    (* A descriptor operand's value, an eqref: a static one's global (a bound
     * variable's past index 0 from the core's boundVar); a descriptor
     * variable's value; or an instantiation, its template's descriptor with
     * the arguments filling its holes (the core's instantiate) *)
    let rec descriptor(f: F d: ir.Descriptor): Ok =
        case d
            when descStatic with x then
                let form = formOf(f.g x.d)
                if stringOp.equal(form.symbol "quest_type_bound_vars") andif {form.index > 0} then
                    emit(f i1(ops.globalGet f.g.noClosure))
                    emit(f model.i64Const(form.index))
                    runtimeUnitCall(f "wasm/core.boundVar")
                else
                    emit(f i1(ops.globalGet descGlobal(f form.symbol)))
                end
            when descVar with x then atomParts(f ir.atomOfVar(x.v))
            when descInstantiate with x then
                let form =
                    try staticdata.descriptorForm(x.template maybe.some(f.g.naming))
                    when staticdata.missingDescriptor with msg then
                        fail("a descriptor: " <> msg)
                        staticdata.descriptorForm(x.template maybe.some(f.g.naming))
                    end
                if stringOp.equal(form.kind "base") then
                    emit(f i1(ops.globalGet descGlobal(f form.symbol)))
                else
                    emit(f i1(ops.globalGet f.g.noClosure))
                    emit(f i1(ops.globalGet descGlobal(f form.symbol)))
                    emit(f model.i32Const(0))
                    for k = 0 upto extent x.args - 1 do descriptor(f x.args[k]) end
                    emit(f i2(ops.arrayNewFixed tSlots extent x.args))
                    emit(f i1(ops.structNew tArray))
                    runtimeUnitCall(f "wasm/core.instantiate")
                end
        end

    (* Descriptor operands, each an eqref, in order *)
    and descriptors(f: F ds: Array(ir.Descriptor)): Ok = for k = 0 upto extent ds - 1 do descriptor(f ds[k]) end

    (* A part of a descriptor: its label, the descriptor it refers to, and its
     * flags, as wasm/core reads them (1 var, 2 out, 4 a function's result, 8
     * a quantifier's bound, 32 an auto type's bound) *)
    Def Part = Tuple label: String ref: staticdata.Ref flags: Int end

    (* Descriptor d's parts, in the order wasm/core numbers them: a tuple's
     * elements, a record's fields, an option's or variant's cases by tag, an
     * array's element, an exception's payload, and the rest as below; none
     * for any other kind *)
    let partsOf(d: staticdata.Descriptor): Array(Part) =
        begin
            let flagged = fun(label: maybe.T(String) r: staticdata.Ref flags: Int): Part
                tuple let label = maybe.unwrapOr(label "") let ref = r let flags = flags end
            let part = fun(label: maybe.T(String) r: staticdata.Ref): Part flagged(label r 0)
            let components = fun(cs: Array(staticdata.Component)): Array(Part)
                begin
                    let ps = array of(extent cs part(maybe.none() staticdata.nullRef))
                    for j = 0 upto extent cs - 1 do
                        ps[j] := flagged(cs[j].name cs[j].type if cs[j].isVar then 1 else 0 end)
                    end
                    ps
                end
            let cases = fun(cs: Array(staticdata.Case)): Array(Part)
                begin
                    let ps = array of(extent cs part(maybe.none() staticdata.nullRef))
                    for j = 0 upto extent cs - 1 do
                        ps[cs[j].tagIndex] := flagged(maybe.some(cs[j].name) cs[j].payload
                                if cs[j].isVar then 1 else 0 end)
                    end
                    ps
                end
            (* a function type's parameters, each flagged by its mode, then
             * its result, then its quantifiers' bounds *)
            let function =
                fun(params: Array(staticdata.FunParam) result: staticdata.Ref bs: Array(staticdata.Ref)): Array(Part)
                    begin
                        let n = extent params
                        let ps = array of({n + 1} + extent bs flagged(maybe.none() result 4))
                        for j = 0 upto n - 1 do
                            let mode = if params[j].isVar then 1 elsif params[j].isOut then 2 else 0 end
                            ps[j] := flagged(maybe.none() params[j].type mode)
                        end
                        for j = 0 upto extent bs - 1 do ps[{n + 1} + j] := flagged(maybe.none() bs[j] 8) end
                        ps
                    end
            case d.payload
                when payloadTuple with x then components(x.elements)
                when payloadRecord with x then components(x.fields)
                when payloadOption with x then cases(x.cases)
                when payloadVariant with x then cases(x.cases)
                when payloadArray with x then array of part(maybe.none() x.element) end
                when payloadException with x then array of part(maybe.none() x.payloadType) end
                when payloadAuto with x then
                    (* its components, then its bound if it has one *)
                    let cs = components(x.components)
                    if stringOp.isEmpty(x.bound.symbol) then
                        cs
                    else
                        let ps = array of(extent cs + 1 flagged(maybe.none() x.bound 32))
                        for j = 0 upto extent cs - 1 do ps[j] := cs[j] end
                        ps
                    end
                when payloadFun with x then function(x.params x.result x.bounds)
                (* a module's bounded abstract type held as a value of its
                 * bound: its type, an opaque descriptor of its name, which
                 * makeDescriptors makes, and its storage, the bound *)
                when payloadStored with x then
                    array of
                        part(maybe.some("type") staticdata.nullRef)
                        part(maybe.some("storage") x.storage)
                    end
                when payloadOpaque with x then
                    (* an abstract type operator's application: its
                     * arguments *)
                    let ps = array of(extent x.args part(maybe.none() staticdata.nullRef))
                    for j = 0 upto extent x.args - 1 do ps[j] := part(maybe.none() x.args[j]) end
                    ps
                else array of :Part end
            end
        end

    (* A tuple descriptor's texts for its type components, each with its
     * position; none for any other descriptor *)
    let textsOf(d: staticdata.Descriptor): Array(staticdata.TypeComponentText) =
        case d.payload
            when payloadTuple with x then x.typeComponents
            else array of :staticdata.TypeComponentText end
        end

    (* The code that makes the unit's descriptors, in its initializer: the
     * base ones the core's, then each collected one made with its parts
     * unset, then its parts set, so that cycles close *)
    let makeDescriptors(f: F forms: vector.T(staticdata.DescriptorForm)): Ok =
        begin
            let callCore = fun(field: String): Ok runtimeUnitCall(f "wasm/core." <> field)
            let noClosure = fun(): Ok emit(f i1(ops.globalGet f.g.noClosure))
            for k = 0 upto extent baseSymbols - 1 do
                noClosure()
                emit(f model.i64Const(baseKinds[k]))
                callCore("base")
                emit(f i1(ops.globalSet descGlobal(f baseSymbols[k])))
            end
            let partOf = fun(t: ir.Type): staticdata.DescriptorForm
                staticdata.descriptorForm(t maybe.some(f.g.naming))
            let described = vector.new(:staticdata.Descriptor)
            for k = 0 upto vector.length(forms) - 1 do
                let form = vector.get(forms k)
                vector.append(described
                        staticdata.describeDescriptor(form maybe.some(f.g.naming) partOf))
            end
            for k = 0 upto vector.length(described) - 1 do
                let d = vector.get(described k)
                noClosure()
                emit(f model.i64Const(kindOf(d.kindConstant)))
                literal(f d.name)
                emit(f model.i64Const(extent partsOf(d)))
                emit(f model.i64Const(extent textsOf(d)))
                callCore("newDesc")
                emit(f i1(ops.globalSet descGlobal(f d.form.symbol)))
            end
            for k = 0 upto vector.length(described) - 1 do
                let d = vector.get(described k)
                let at = descGlobal(f d.form.symbol)
                let ps = partsOf(d)
                for j = 0 upto extent ps - 1 do
                    noClosure()
                    emit(f i1(ops.globalGet at))
                    emit(f model.i64Const(j))
                    if {j is 0} andif stringOp.equal(ps[j].label "type") andif {d.payload?payloadStored} then
                        noClosure()
                        emit(f model.i64Const(kindOf("QTYPE_KIND_OPAQUE")))
                        literal(f d.name)
                        emit(f model.i64Const(0))
                        emit(f model.i64Const(0))
                        callCore("newDesc")
                    elsif stringOp.isEmpty(ps[j].ref.symbol) then
                        (* no descriptor: the core's of kind none *)
                        noClosure()
                        emit(f model.i64Const(0))
                        callCore("base")
                    elsif stringOp.equal(ps[j].ref.symbol "quest_type_bound_vars") andif {ps[j].ref.index > 0} then
                        noClosure()
                        emit(f model.i64Const(ps[j].ref.index))
                        callCore("boundVar")
                    else
                        emit(f i1(ops.globalGet descGlobal(f ps[j].ref.symbol)))
                    end
                    literal(f ps[j].label)
                    callCore("setPart")
                    emit(f i(ops.drop))
                    if ps[j].flags isnot 0 then
                        noClosure()
                        emit(f i1(ops.globalGet at))
                        emit(f model.i64Const(j))
                        emit(f model.i64Const(ps[j].flags))
                        callCore("setFlags")
                        emit(f i(ops.drop))
                    end
                end
                let ts = textsOf(d)
                for j = 0 upto extent ts - 1 do
                    noClosure()
                    emit(f i1(ops.globalGet at))
                    emit(f model.i64Const(j))
                    emit(f model.i64Const(ts[j].position))
                    literal(f ts[j].text)
                    callCore("setText")
                    emit(f i(ops.drop))
                end
            end
        end

    let tRecord = rt.index("record")
    let tDict = rt.index("dict")
    let tRecBox = rt.index("recBox")
    let tVarBox = rt.index("varBox")
    (* The value on the stack, of type t, as a slot holds it (sections 2.1
     * and 4.1): an Int or Word an i31 or a $boxInt, a Real a $boxReal, a Bool
     * or Char an i31, a record's two parts a $recBox and a variant's a
     * $varBox, a reference itself *)
    let box(f: F t: ir.Type): Ok =
        if isVariant(t) then emit(f i1(ops.structNew tVarBox))
        elsif isRecord(t) then
            (* the pair, in its box *)
            let dict = scratch(f model.eqref)
            emit(f i1(ops.localSet dict))
            castTo(f tRecord)
            emit(f i1(ops.localGet dict))
            castTo(f tDict)
            emit(f i1(ops.structNew tRecBox))
        else
            case valType(t)
                when valI64 then runtimeCall(f "boxInt")
                when valI32 then emit(f i(ops.refI31))
                when valF64 then emit(f i1(ops.structNew rt.index("boxReal")))
                else ok
            end
        end
    (* The slot's eqref on the stack as a value of type t, box's inverse *)
    let unbox(f: F t: ir.Type): Ok =
        if isVariant(t) then
            let b = scratch(f model.refNull(tVarBox))
            castTo(f tVarBox)
            emit(f i1(ops.localTee b))
            emit(f i2(ops.structGet tVarBox 0))
            emit(f i1(ops.localGet b))
            emit(f i2(ops.structGet tVarBox 1))
        elsif isRecord(t) then
            let b = scratch(f model.refNull(tRecBox))
            castTo(f tRecBox)
            emit(f i1(ops.localTee b))
            emit(f i2(ops.structGet tRecBox 0))
            emit(f i1(ops.localGet b))
            emit(f i2(ops.structGet tRecBox 1))
        else
            case valType(t)
                when valI64 then runtimeCall(f "unboxInt")
                when valI32 then
                    castI31(f)
                    emit(f i(ops.i31GetU))
                when valF64 then
                    castTo(f rt.index("boxReal"))
                    emit(f i2(ops.structGet rt.index("boxReal") 0))
                else ok
            end
        end
    (* Whether the atom is a variable held boxed (a record in its box) *)
    let isBoxedVar(a: ir.Atom): Bool = case a when atomVar with x then x.v.boxed else false end
    (* A slot's value, read as the variable target holds it: unboxed unless
     * target is held boxed *)
    let unboxFor(f: F t: ir.Type target: maybe.T(ir.Variable)): Ok =
        if maybe.isSome(target) andif maybe.unwrap(target).boxed then ok else unbox(f t) end
    (* The atom's value: a located variable's read through its location *)
    let atom(f: F a: ir.Atom): Ok =
        begin
            atomParts(f a)
            case a
                when atomVar with x then
                    if isLocated(f x.v) then
                        emit(f i1(ops.arrayGet tSlots))
                        unboxFor(f x.v.type maybe.some(x.v))
                    end
                else ok
            end
        end
    let atoms(f: F args: Array(ir.Atom)): Ok = for k = 0 upto extent args - 1 do atom(f args[k]) end
    (* The atom, as a slot holds it: boxed unless it is a box already *)
    let boxedAtom(f: F a: ir.Atom): Ok =
        begin
            atom(f a)
            if not(isBoxedVar(a)) then box(f ir.atomType(a)) end
        end

    (* Stores the value on the stack in v: a located variable's written
     * through its location, as a slot holds it *)
    let store(f: F v: ir.Variable): Ok =
        if isLocated(f v) then
            if not(v.boxed) then box(f v.type) end
            let value = scratch(f model.eqref)
            emit(f i1(ops.localSet value))
            getParts(f v)
            emit(f i1(ops.localGet value))
            emit(f i1(ops.arraySet tSlots))
        else
            setParts(f v)
        end

    (* A located variable's location at its declaration: a slot array of its
     * own, holding the value on the stack, and index 0 (section 2.6) *)
    let declareLocated(f: F v: ir.Variable): Ok =
        begin
            if not(v.boxed) then box(f v.type) end
            emit(f i2(ops.arrayNewFixed tSlots 1))
            emit(f model.i32Const(0))
            setParts(f v)
        end
    (* A variant atom's two parts, its tag and its payload, its box unboxed
     * if it is one *)
    let variantAtom(f: F a: ir.Atom): Ok =
        begin
            atom(f a)
            if isBoxedVar(a) then unbox(f ir.atomType(a)) end
        end
    (* A record atom's two parts, its box unboxed if it is one *)
    let recordAtom(f: F a: ir.Atom): Ok =
        begin
            atom(f a)
            if isBoxedVar(a) then unbox(f ir.atomType(a)) end
        end
    (* The atom's value as a variable held boxed or not, as boxed says: a
     * record or variant held boxed (a var parameter, a local whose address
     * is taken) is one eqref, its box, where the value's own form is its two
     * parts (section 2.5) *)
    let atomAs(f: F a: ir.Atom boxed: Bool): Ok =
        begin
            atom(f a)
            if isBoxedVar(a) andif not(boxed) then unbox(f ir.atomType(a))
            elsif boxed andif not(isBoxedVar(a)) then box(f ir.atomType(a))
            end
        end
    let atomFor(f: F a: ir.Atom v: ir.Variable): Ok = atomAs(f a v.boxed)

    (* Ends the program, through the runtime's fatal with status 1, saying
     * that this backend does not run what yet: a proxy in the runtime's own
     * units, a library external the target lacks, a module's function it
     * could not compile *)
    let pending(f: F what: String): Ok =
        begin
            literal(f "wasm: " <> what <> ", which this backend does not yet run\n")
            emit(f model.i32Const(1))
            runtimeCall(f "fatal")
            emit(f i(ops.unreachable))
        end

    (* The eqref on the stack as a reference to the struct t, which access
     * says may be a proxy: a cast, or a test that, finding a proxy, takes
     * its original (the core's unproxy); in the runtime's own units, which
     * meet no proxy, it fails as pending *)
    let accessAs(f: F t: Int access: ir.Access): Ok =
        case access
            when direct then castTo(f t)
            when original, proxy then
                (* the value is the block's parameter *)
                emit(f model.blockInst(option blockIndex of model.BlockType with
                    let index = funcType(f.g array of model.eqref end array of model.ref(t) end)
                end ""))
                emit(f option instBrOnCast of Inst with
                    let fail = false
                    let label = 0
                    let from = tuple let nullable = true let heap = option heapEq of model.HeapType end end
                    let to = tuple let nullable = false let heap = heapOf(t) end
                end)
                if f.g.isRuntime then
                    emit(f i(ops.drop))
                    pending(f "a proxy")
                else
                    let v = scratch(f model.eqref)
                    emit(f i1(ops.localSet v))
                    emit(f i1(ops.globalGet f.g.noClosure))
                    emit(f i1(ops.localGet v))
                    runtimeUnitCall(f "wasm/core.unproxy")
                    castTo(f t)
                end
                emit(f model.endInst)
        end

    (* A tuple or option read through a view map (for a bounded type parameter
     * whose type argument is a supertype) may be a proxy, matching
     * quest_view_tuple_slot and its siblings (section 2.3). Reads go through
     * the proxy, while writes and address-of operations unwrap to the
     * underlying original. *)
    let viewedRead(access: ir.Access m: maybe.T(ir.Variable)): ir.Access =
        if maybe.isSome(m) then ir.proxy else access end
    let viewedSlot(access: ir.Access m: maybe.T(ir.Variable)): ir.Access =
        if maybe.isSome(m) andif access?direct then ir.original else access end

    (* An i32 on the stack mapped through table, as a br_table to constants;
     * nothing when table is the identity *)
    let mapI32(f: F table: Array(Int)): Ok =
        begin
            let var identity = true
            for k = 0 upto extent table - 1 do if table[k] isnot k then identity := false end end
            if not(identity) then
                let n = extent table
                let v = scratch(f model.i32)
                emit(f i1(ops.localSet v))
                emit(f model.blockInst(option blockValue of model.BlockType with let type = model.i32 end ""))
                for k = 0 upto n - 1 do emit(f model.blockInst(empty "")) end
                emit(f i1(ops.localGet v))
                let targets = array of(n 0)
                for k = 0 upto n - 1 do targets[k] := k end
                emit(f option instBrTable of Inst with let labels = targets let default = n - 1 end)
                for k = 0 upto n - 1 do
                    emit(f model.endInst)
                    emit(f model.i32Const(table[k]))
                    emit(f i1(ops.br {n - 1} - k))
                end
                emit(f model.endInst)
            end
        end

    (* --- Tuples --- *)

    (* A new tuple of the atoms, each boxed as its slot holds it; at most
     * 10,000, array.new_fixed's limit of operands (section 2.11) *)
    let newTuple(f: F args: Array(ir.Atom)): Ok =
        begin
            if extent args > 10000 then fail("a tuple of more than 10,000 components") end
            emit(f model.i32Const(0))
            for k = 0 upto extent args - 1 do boxedAtom(f args[k]) end
            emit(f i2(ops.arrayNewFixed tSlots extent args))
            emit(f i1(ops.structNew tTuple))
        end

    (* The eqref on the stack, which may be a proxy, read: when it is a t,
     * its field (an i32, the tag) or, if index >= 0, element index of its
     * slots (an eqref); else, a proxy, the same read through the core's
     * function through *)
    let proxyAware(f: F t: Int field: Int index: Int through: String): Ok =
        begin
            let v = scratch(f model.eqref)
            let result = if index >= 0 then model.eqref else model.i32 end
            emit(f i1(ops.localTee v))
            emit(f option instRefTest of Inst with let type = tuple let nullable = false let heap = heapOf(t) end end)
            emit(f model.ifInst(option blockValue of model.BlockType with let type = result end ""))
            emit(f i1(ops.localGet v))
            castTo(f t)
            if index >= 0 then
                emit(f i2(ops.structGet t fSlots))
                emit(f model.i32Const(index))
                emit(f i1(ops.arrayGet tSlots))
            else
                emit(f i2(ops.structGet t field))
            end
            emit(f model.elseInst)
            emit(f i1(ops.globalGet f.g.noClosure))
            emit(f i1(ops.localGet v))
            if index >= 0 then emit(f model.i64Const(index)) end
            runtimeUnitCall(f through)
            if index < 0 then emit(f i(ops.i32WrapI64)) end
            emit(f model.endInst)
        end

    (* The value of view map m's variable, the argument after the closure of
     * the core's functions that read through a view map (quest_view_map) *)
    let viewMapOf(f: F m: maybe.T(ir.Variable)): Ok = atomParts(f ir.atomOfVar(maybe.unwrap(m)))

    (* The value on the stack, part i of a value read through a view map,
     * converted to the bound's type for it *)
    let viewPartOnStack(f: F m: maybe.T(ir.Variable) i: Int): Ok =
        begin
            let v = scratch(f model.eqref)
            emit(f i1(ops.localSet v))
            emit(f i1(ops.globalGet f.g.noClosure))
            viewMapOf(f m)
            emit(f model.i64Const(i))
            emit(f i1(ops.localGet v))
            runtimeUnitCall(f "wasm/core.viewPart")
        end

    (* Component x.index of a tuple: an unboxed tuple's from its locals;
     * else read from its slots, through a proxy or the view map when it may
     * be read through one, and unboxed unless target is held boxed *)
    let tupleField(f: F x: ir.OpTupleField target: maybe.T(ir.Variable)): Ok =
        begin
            let s = shapeOf(ir.atomType(x.tup))
            let held = ir.atomVarOf(x.tup)
            if maybe.isSome(held) andif maybe.unwrap(held).unboxed then
                let first = local(f maybe.unwrap(held)) + componentOffset(s x.index)
                for j = 0 upto extent parts(componentType(s x.index)) - 1 do emit(f i1(ops.localGet first + j)) end
            else
                atom(f x.tup)
                if viewedRead(x.access x.viewMap)?proxy andif not(f.g.isRuntime) then
                    proxyAware(f tTuple fSlots x.index "wasm/core.proxyElement")
                else
                    accessAs(f tTuple x.access)
                    emit(f i2(ops.structGet tTuple fSlots))
                    emit(f model.i32Const(x.index))
                    emit(f i1(ops.arrayGet tSlots))
                end
                if maybe.isSome(x.viewMap) then viewPartOnStack(f x.viewMap x.index) end
                unboxFor(f componentType(s x.index) target)
            end
        end

    (* --- Options --- *)

    let optionShape(t: ir.Type): shapes.Shape =
        begin
            let s = shapeOf(t)
            if shapes.kindIs(s shapes.shapeVariant) then fail("an option's operation on a variant") end
            if not(shapes.kindIs(s shapes.shapeOption)) then fail("a tag of a value of no option type") end
            s
        end
    let isVariantShape(t: ir.Type): Bool = shapes.kindIs(shapeOf(t) shapes.shapeVariant)

    (* A case's tag: its index among the shape's cases, which are in name
     * order (docs/c-representation.md section 5.3) *)
    let tagIndex(s: shapes.Shape tag: String): Int =
        begin
            let var index = ~1
            for k = 0 upto extent s.cases - 1 do
                if stringOp.equal(maybe.unwrapOr(s.cases[k].name "") tag) then index := k end
            end
            if index < 0 then fail("an option or variant of no case " <> tag) end
            index
        end

    (* How many components case tag has, and whether they are a tuple's,
     * which a case binder is; one that is not a tuple is one value *)
    Def CaseForm = Tuple count: Int isTuple: Bool end
    let caseForm(s: shapes.Shape tag: String): CaseForm =
        begin
            let c = s.cases[tagIndex(s tag)]
            if maybe.isNone(c.shape) then
                tuple let count = 0 let isTuple = true end
            else
                let cs = maybe.unwrap(c.shape)
                if shapes.kindIs(cs shapes.shapeTuple) then
                    tuple let count = extent cs.components let isTuple = true end
                else
                    tuple let count = 1 let isTuple = false end
                end
            end
        end

    let anyProxy(access: Array(ir.Access)): Bool =
        begin
            let var a = false
            for k = 0 upto extent access - 1 do if access[k]?proxy then a := true end end
            a
        end

    (* The access of a read of several components at once: original if any
     * of theirs is not direct (each a proxy's original), else direct *)
    let anyIndirect(access: Array(ir.Access)): ir.Access =
        begin
            let var a = ir.direct
            for k = 0 upto extent access - 1 do if not(access[k]?direct) then a := ir.original end end
            a
        end

    (* A fatal error for an option made by an ordinal out of its type's cases
     * (quest_option_ordinal_error_at), the ordinal an Int atom *)
    let ordinalError(f: F value: ir.Atom count: Int offset: maybe.T(Int)): Ok =
        begin
            literal(f "Option ordinal ")
            atom(f value)
            runtimeCall(f "decimal")
            runtimeCall(f "concat")
            let site = if maybe.isNone(offset) then ""
                else maybe.unwrapOr(ir.site(f.g.unit maybe.unwrap(offset)) "")
                end
            literal(f " out of bounds (0 <= ordinal < " <> conv.int(count) <> ")\n"
                <> {if stringOp.isEmpty(site) then "" else "  at " <> site <> "\n" end})
            runtimeCall(f "concat")
            emit(f model.i32Const(1))
            runtimeCall(f "fatal")
            emit(f i(ops.unreachable))
        end

    (* An option's slots: its payload's components, copied, laid out as case
     * tag has them *)
    let payloadSlots(f: F x: ir.OpMakeOption s: shapes.Shape tag: String): Ok =
        begin
            let form = caseForm(s tag)
            if maybe.isNone(x.payload) orif {form.count is 0} then
                emit(f i2(ops.arrayNewFixed tSlots 0))
            elsif form.isTuple then
                (* The payload tuple's components, copied *)
                let slots = scratch(f model.refNull(tSlots))
                emit(f model.i32Const(form.count))
                emit(f i1(ops.arrayNewDefault tSlots))
                emit(f i1(ops.localTee slots))
                emit(f model.i32Const(0))
                atom(f maybe.unwrap(x.payload))
                accessAs(f tTuple anyIndirect(x.access))
                emit(f i2(ops.structGet tTuple fSlots))
                emit(f model.i32Const(0))
                emit(f model.i32Const(form.count))
                emit(f i2(ops.arrayCopy tSlots tSlots))
                emit(f i1(ops.localGet slots))
                emit(f i(ops.refAsNonNull))
            else
                boxedAtom(f maybe.unwrap(x.payload))
                emit(f i2(ops.arrayNewFixed tSlots 1))
            end
        end

    (* A new option of type t: of case x.tag, or, from an ordinal, of the
     * case x.cases[ordinal], after a test that the ordinal is in range; the
     * ordinal maps to the case's tag, its index in name order *)
    let makeOption(f: F x: ir.OpMakeOption t: ir.Type): Ok =
        begin
            let s = optionShape(t)
            emit(f model.i32Const(0))
            if maybe.isSome(x.ordinalAtom) then
                let index = maybe.unwrap(x.ordinalAtom)
                atom(f index)
                emit(f model.i64Const(extent s.cases))
                emit(f i(ops.i64LtU))
                emit(f i(ops.i32Eqz))
                emit(f model.ifInst(empty ""))
                ordinalError(f index extent s.cases x.offset)
                emit(f model.endInst)
                (* A payload is laid out as the case a constant ordinal names,
                 * else as the first's, as the SSA's builder lays it out *)
                let n =
                    case index
                        when atomConst with c then case c.c.value when constInt with y then y.n else ~1 end
                        else ~1
                    end
                let laidOut = if {n >= 0} andif {n < extent x.cases} then x.cases[n]
                    else maybe.unwrapOr(s.cases[0].name "")
                    end
                payloadSlots(f x s laidOut)
                atom(f index)
                emit(f i(ops.i32WrapI64))
                let tags = array of(extent x.cases 0)
                for k = 0 upto extent x.cases - 1 do tags[k] := tagIndex(s x.cases[k]) end
                mapI32(f tags)
            else
                let tag = maybe.unwrapOr(x.tag "")
                payloadSlots(f x s tag)
                emit(f model.i32Const(tagIndex(s tag)))
            end
            emit(f i1(ops.structNew tOption))
        end

    let tagOf(f: F value: ir.Atom access: ir.Access): Ok =
        begin
            atom(f value)
            if access?proxy andif not(f.g.isRuntime) then
                proxyAware(f tOption fTag ~1 "wasm/core.proxyTag")
            else
                accessAs(f tOption access)
                emit(f i2(ops.structGet tOption fTag))
            end
        end

    (* The tag of a value of a bounded type parameter, held at its type
     * argument's view, in its bound's numbering: through the view map *)
    let viewTag(f: F value: ir.Atom m: maybe.T(ir.Variable)): Ok =
        begin
            let tag = scratch(f model.i32)
            if isVariantShape(ir.atomType(value)) then
                variantAtom(f value)
                emit(f i(ops.drop))
            else
                (* a proxy's tag in its own numbering, the view map's
                 * actual's *)
                tagOf(f value ir.proxy)
            end
            emit(f i1(ops.localSet tag))
            emit(f i1(ops.globalGet f.g.noClosure))
            viewMapOf(f m)
            emit(f i1(ops.localGet tag))
            emit(f i(ops.i64ExtendI32U))
            runtimeUnitCall(f "wasm/core.viewIndex")
            emit(f i(ops.i32WrapI64))
        end

    (* Component j of the payload of the bound's case b of an option, read
     * through a view map, converted to the bound's type for it *)
    let viewOptionComponent(f: F opt: Int m: maybe.T(ir.Variable) b: Int j: Int): Ok =
        begin
            emit(f i1(ops.globalGet f.g.noClosure))
            emit(f i1(ops.localGet opt))
            viewMapOf(f m)
            emit(f model.i64Const(b))
            emit(f model.i64Const(j))
            runtimeUnitCall(f "wasm/core.viewOptionComponent")
        end

    (* v!tag on a variant: its payload, after a test of the tag that raises
     * variant.tagMismatch *)
    let variantPayload(f: F x: ir.OpPayload t: ir.Type target: maybe.T(ir.Variable)): Ok =
        begin
            let s = shapeOf(ir.atomType(x.value))
            let held = scratch(f model.eqref)
            let viewed = maybe.isSome(x.viewMap)
            (* A decided payload's tag is known, and not tested *)
            if x.decided then
                variantAtom(f x.value)
                emit(f i1(ops.localSet held))
                emit(f i(ops.drop))
            else
                if viewed then
                    variantAtom(f x.value)
                    emit(f i1(ops.localSet held))
                    emit(f i(ops.drop))
                    viewTag(f x.value x.viewMap)
                else
                    variantAtom(f x.value)
                    emit(f i1(ops.localSet held))
                end
                emit(f model.i32Const(tagIndex(s x.tag)))
                emit(f i(ops.i32Ne))
                emit(f model.ifInst(empty ""))
                raiseAt(f "variant.tagMismatch" x.offset)
                emit(f model.endInst)
            end
            emit(f i1(ops.localGet held))
            if viewed then viewPartOnStack(f x.viewMap tagIndex(s x.tag)) end
            unboxFor(f t target)
        end

    (* opt!tag: a new tuple of the case's ordinal and then its components,
     * after a test of the tag that raises variant.tagMismatch; the
     * components copied, never shared with the option *)
    let payload(f: F x: ir.OpPayload t: ir.Type): Ok =
        begin
            let s = optionShape(ir.atomType(x.value))
            let viewed = maybe.isSome(x.viewMap)
            (* A decided payload's tag is known, and not tested *)
            if not(x.decided) then
                if viewed then viewTag(f x.value x.viewMap) else tagOf(f x.value x.access) end
                emit(f model.i32Const(tagIndex(s x.tag)))
                emit(f i(ops.i32Ne))
                emit(f model.ifInst(empty ""))
                raiseAt(f "variant.tagMismatch" x.offset)
                emit(f model.endInst)
            end
            let n = extent shapeOf(t).components
            let form = caseForm(s x.tag)
            let slots = scratch(f model.refNull(tSlots))
            emit(f model.i32Const(0))
            emit(f model.i32Const(n))
            emit(f i1(ops.arrayNewDefault tSlots))
            emit(f i1(ops.localSet slots))
            emit(f i1(ops.localGet slots))
            emit(f model.i32Const(0))
            emit(f model.i32Const(maybe.unwrapOr(x.ordinalIndex 0)))
            emit(f i(ops.refI31))
            emit(f i1(ops.arraySet tSlots))
            let count = if form.count < {n - 1} then form.count else n - 1 end
            if viewed then
                (* each component through the view map *)
                let opt = scratch(f model.eqref)
                atom(f x.value)
                emit(f i1(ops.localSet opt))
                for j = 0 upto count - 1 do
                    emit(f i1(ops.localGet slots))
                    emit(f model.i32Const(j + 1))
                    viewOptionComponent(f opt x.viewMap tagIndex(s x.tag) j)
                    emit(f i1(ops.arraySet tSlots))
                end
            elsif {count > 0} andif anyProxy(x.components) andif not(f.g.isRuntime) then
                (* each component through the proxy, if it is one *)
                let opt = scratch(f model.eqref)
                atom(f x.value)
                emit(f i1(ops.localSet opt))
                for j = 0 upto count - 1 do
                    emit(f i1(ops.localGet slots))
                    emit(f model.i32Const(j + 1))
                    emit(f i1(ops.localGet opt))
                    proxyAware(f tOption fSlots j "wasm/core.proxyOptionElement")
                    emit(f i1(ops.arraySet tSlots))
                end
            elsif count > 0 then
                emit(f i1(ops.localGet slots))
                emit(f model.i32Const(1))
                atom(f x.value)
                accessAs(f tOption anyIndirect(x.components))
                emit(f i2(ops.structGet tOption fSlots))
                emit(f model.i32Const(0))
                emit(f model.i32Const(count))
                emit(f i2(ops.arrayCopy tSlots tSlots))
            end
            emit(f i1(ops.localGet slots))
            emit(f i(ops.refAsNonNull))
            emit(f i1(ops.structNew tTuple))
        end

    (* is at an option type (docs/extensions.md, Options as Values): the same
     * object, or the same case, which has no components *)
    let optionIs(f: F s: shapes.Shape a: Int b: Int): Ok =
        begin
            let empties = array of(extent s.cases 0)
            for k = 0 upto extent s.cases - 1 do
                if caseForm(s maybe.unwrapOr(s.cases[k].name "")).count is 0 then empties[k] := 1 end
            end
            let ta = scratch(f model.i32)
            emit(f i1(ops.localGet a))
            emit(f i1(ops.localGet b))
            emit(f i(ops.refEq))
            emit(f model.ifInst(option blockValue of model.BlockType with let type = model.i32 end ""))
            emit(f model.i32Const(1))
            emit(f model.elseInst)
            emit(f i1(ops.localGet a))
            castTo(f tOption)
            emit(f i2(ops.structGet tOption fTag))
            emit(f i1(ops.localTee ta))
            emit(f i1(ops.localGet b))
            castTo(f tOption)
            emit(f i2(ops.structGet tOption fTag))
            emit(f i(ops.i32Eq))
            emit(f model.ifInst(option blockValue of model.BlockType with let type = model.i32 end ""))
            emit(f i1(ops.localGet ta))
            mapI32(f empties)
            emit(f model.elseInst)
            emit(f model.i32Const(0))
            emit(f model.endInst)
            emit(f model.endInst)
        end

    (* --- Arrays --- *)

    let elementType(t: ir.Type): ir.Type = shapes.element(shapeOf(t)).type

    (* The most elements an array may have here, V8's (section 2.10) *)
    let maxElements = 134217720

    (* Raises arrayOp.error at offset unless index is within arr's bounds;
     * unsigned comparison rejects negative indices in the same test *)
    let checkIndex(f: F arr: ir.Atom index: ir.Atom offset: maybe.T(Int)): Ok =
        begin
            atom(f index)
            atom(f arr)
            castTo(f tArray)
            emit(f i2(ops.structGet tArray fElems))
            emit(f i(ops.arrayLen))
            emit(f i(ops.i64ExtendI32U))
            emit(f i(ops.i64LtU))
            emit(f i(ops.i32Eqz))
            emit(f model.ifInst(empty ""))
            raiseAt(f "arrayOp.error" offset)
            emit(f model.endInst)
        end

    (* The slots of arr and index as an i32, for array.get or array.set *)
    let elements(f: F arr: ir.Atom index: ir.Atom): Ok =
        begin
            atom(f arr)
            castTo(f tArray)
            emit(f i2(ops.structGet tArray fElems))
            atom(f index)
            emit(f i(ops.i32WrapI64))
        end

    (* A new array of the atoms, each boxed; at most 10,000, as for a
     * tuple *)
    let makeArray(f: F args: Array(ir.Atom) t: ir.Type): Ok =
        begin
            if extent args > 10000 then fail("an array of more than 10,000 elements written out") end
            let e = elementType(t)
            emit(f model.i32Const(0))
            for k = 0 upto extent args - 1 do boxedAtom(f args[k]) end
            emit(f i2(ops.arrayNewFixed tSlots extent args))
            emit(f i1(ops.structNew tArray))
        end

    (* An array of count copies of init: a negative count raises
     * arrayOp.error, and one over the most there may be is out of memory,
     * before array.new would trap *)
    let arrayRep(f: F x: ir.OpArrayRep t: ir.Type): Ok =
        begin
            atom(f x.count)
            emit(f model.i64Const(0))
            emit(f i(ops.i64LtS))
            emit(f model.ifInst(empty ""))
            raiseAt(f "arrayOp.error" x.offset)
            emit(f model.endInst)
            atom(f x.count)
            emit(f model.i64Const(maxElements))
            emit(f i(ops.i64GtS))
            emit(f model.ifInst(empty ""))
            literal(f "quest: out of memory: an array of more than " <> conv.int(maxElements) <> " elements\n")
            emit(f model.i32Const(70))
            runtimeCall(f "fatal")
            emit(f i(ops.unreachable))
            emit(f model.endInst)
            emit(f model.i32Const(0))
            boxedAtom(f x.init)
            atom(f x.count)
            emit(f i(ops.i32WrapI64))
            emit(f i1(ops.arrayNew tSlots))
            emit(f i1(ops.structNew tArray))
        end

    let index(f: F x: ir.OpIndex target: maybe.T(ir.Variable)): Ok =
        begin
            checkIndex(f x.arr x.index x.offset)
            elements(f x.arr x.index)
            emit(f i1(ops.arrayGet tSlots))
            unboxFor(f elementType(ir.atomType(x.arr)) target)
        end

    (* Emits signed integer division or remainder. A zero divisor raises
     * int.error, and a divisor of -1 is handled directly (wrapping negation
     * for quotient, 0 for remainder) so INT64_MIN / -1 does not trap. *)
    let divide(f: F x: ir.OpPrim remainder: Bool): Ok =
        begin
            let a = x.args[0]
            let b = x.args[1]
            atom(f b)
            emit(f i(ops.i64Eqz))
            emit(f model.ifInst(empty ""))
            raiseAt(f "int.error" x.offset)
            emit(f model.endInst)
            atom(f b)
            emit(f model.i64Const(~1))
            emit(f i(ops.i64Eq))
            emit(f model.ifInst(option blockValue of model.BlockType with let type = model.i64 end ""))
            if remainder then
                emit(f model.i64Const(0))
            else
                emit(f model.i64Const(0))
                atom(f a)
                emit(f i(ops.i64Sub))
            end
            emit(f model.elseInst)
            atom(f a)
            atom(f b)
            emit(f i(if remainder then ops.i64RemS else ops.i64DivS end))
            emit(f model.endInst)
        end

    (* A comparison of two Ints (signed) or two Chars or Bools (unsigned) *)
    let compare(f: F x: ir.OpPrim int: model.Op small: model.Op): Ok =
        begin
            atoms(f x.args)
            case atomType(x.args[0])
                when valI64 then emit(f i(int))
                when valI32 then emit(f i(small))
                else fail("an ordering of references")
            end
        end

    let prim(f: F x: ir.OpPrim): Ok =
        case x.op
            when primAdd then
                atoms(f x.args)
                emit(f i(ops.i64Add))
            when primSub then
                atoms(f x.args)
                emit(f i(ops.i64Sub))
            when primMul then
                atoms(f x.args)
                emit(f i(ops.i64Mul))
            when primDiv then divide(f x false)
            when primRem, primMod then divide(f x true)
            when primLt then compare(f x ops.i64LtS ops.i32LtU)
            when primLe then compare(f x ops.i64LeS ops.i32LeU)
            when primGt then compare(f x ops.i64GtS ops.i32GtU)
            when primGe then compare(f x ops.i64GeS ops.i32GeU)
            when primIs, primIsnot then
                if shapes.kindIs(shapeOf(ir.atomType(x.args[0])) shapes.shapeException) then
                    (* the same exception, either one perhaps a handler's
                     * state that holds it *)
                    for k = 0 upto 1 do
                        atom(f x.args[k])
                        runtimeCall(f "exceptionOf")
                    end
                    emit(f i(ops.refEq))
                    if x.op?primIsnot then emit(f i(ops.i32Eqz)) end
                elsif shapes.kindIs(shapeOf(ir.atomType(x.args[0])) shapes.shapeOption) then
                    let a = scratch(f model.eqref)
                    let b = scratch(f model.eqref)
                    (* options that may be proxies: the same original, or by
                     * their tags and components through the proxies, as the
                     * core's valIs compares them (quest_option_is) *)
                    let proxied = not(x.access?direct) andif not(f.g.isRuntime)
                    if proxied andif maybe.isSome(x.descriptor)
                            andif hashMap.contains(f.g.runtimeUnits "wasm/core.valIs") then
                        emit(f i1(ops.globalGet f.g.noClosure))
                        descriptor(f maybe.unwrap(x.descriptor))
                        atom(f x.args[0])
                        atom(f x.args[1])
                        runtimeUnitCall(f "wasm/core.valIs")
                    else
                        atom(f x.args[0])
                        if proxied then accessAs(f tOption ir.original) end
                        emit(f i1(ops.localSet a))
                        atom(f x.args[1])
                        if proxied then accessAs(f tOption ir.original) end
                        emit(f i1(ops.localSet b))
                        optionIs(f shapeOf(ir.atomType(x.args[0])) a b)
                    end
                    if x.op?primIsnot then emit(f i(ops.i32Eqz)) end
                elsif isVariant(ir.atomType(x.args[0])) then
                    (* by case and value, the core's valIs at the variant's
                     * descriptor (quest_variant_is; docs/extensions.md,
                     * Variants as Values) *)
                    if maybe.isNone(x.descriptor)
                            orif not(hashMap.contains(f.g.runtimeUnits "wasm/core.valIs")) then
                        fail("is on variants without their descriptor")
                    end
                    emit(f i1(ops.globalGet f.g.noClosure))
                    descriptor(f maybe.unwrap(x.descriptor))
                    boxedAtom(f x.args[0])
                    boxedAtom(f x.args[1])
                    runtimeUnitCall(f "wasm/core.valIs")
                    if x.op?primIsnot then emit(f i(ops.i32Eqz)) end
                elsif isRecord(ir.atomType(x.args[0])) then
                    (* the same payload, whatever the views: a boxed
                     * record's from its box, else its first part *)
                    for k = 0 upto 1 do
                        atom(f x.args[k])
                        if isBoxedVar(x.args[k]) then
                            castTo(f tRecBox)
                            emit(f i2(ops.structGet tRecBox 0))
                        else
                            emit(f i(ops.drop))
                        end
                    end
                    emit(f i(ops.refEq))
                    if x.op?primIsnot then emit(f i(ops.i32Eqz)) end
                else
                    if maybe.isSome(x.descriptor) andif atomType(x.args[0])?valRef then
                        (* a type parameter's values, as slots hold them: the same
                         * reference, or two boxed Ints of one value *)
                        let tBox = rt.index("boxInt")
                        let a = scratch(f model.eqref)
                        let b = scratch(f model.eqref)
                        atom(f x.args[0])
                        emit(f i1(ops.localTee a))
                        atom(f x.args[1])
                        emit(f i1(ops.localTee b))
                        emit(f i(ops.refEq))
                        emit(f model.ifInst(option blockValue of model.BlockType with let type = model.i32 end ""))
                        emit(f model.i32Const(1))
                        emit(f model.elseInst)
                        if hashMap.contains(f.g.runtimeUnits "wasm/core.valIs") then
                            (* by the descriptor, which may be an abstract type's
                             * whose representation compares otherwise *)
                            emit(f i1(ops.globalGet f.g.noClosure))
                            descriptor(f maybe.unwrap(x.descriptor))
                            emit(f i1(ops.localGet a))
                            emit(f i1(ops.localGet b))
                            runtimeUnitCall(f "wasm/core.valIs")
                        else
                            for k = 0 upto 1 do
                                emit(f i1(ops.localGet if k is 0 then a else b end))
                                emit(f option instRefTest of Inst with
                                    let type = tuple
                                        let nullable = false
                                        let heap = heapOf(tBox)
                                    end
                                end)
                            end
                            emit(f i(ops.i32And))
                            emit(f model.ifInst(option blockValue of model.BlockType with let type = model.i32 end ""))
                            for k = 0 upto 1 do
                                emit(f i1(ops.localGet if k is 0 then a else b end))
                                castTo(f tBox)
                                emit(f i2(ops.structGet tBox 0))
                            end
                            emit(f i(ops.i64Eq))
                            emit(f model.elseInst)
                            emit(f model.i32Const(0))
                            emit(f model.endInst)
                        end
                        emit(f model.endInst)
                    elsif x.access?original andif not(f.g.isRuntime) then
                        (* tuples or options that may be proxies: their
                         * originals *)
                        for k = 0 upto 1 do
                            atom(f x.args[k])
                            accessAs(f tTuple ir.original)
                        end
                        emit(f i(ops.refEq))
                    else
                        atoms(f x.args)
                        case atomType(x.args[0])
                            when valI64 then emit(f i(ops.i64Eq))
                            when valI32 then emit(f i(ops.i32Eq))
                            when valRef then emit(f i(ops.refEq))
                            when valF64 then emit(f i(ops.f64Eq))
                            else fail("is on a value of no kind")
                        end
                    end
                    if x.op?primIsnot then emit(f i(ops.i32Eqz)) end
                end
            when primAnd then
                atoms(f x.args)
                emit(f i(ops.i32And))
            when primOr then
                atoms(f x.args)
                emit(f i(ops.i32Or))
            when primNot then
                atoms(f x.args)
                emit(f i(ops.i32Eqz))
            when primConcat then
                atoms(f x.args)
                runtimeCall(f "concat")
            when primRealAdd, primRealSub, primRealMul, primRealDiv then
                (* real.error for a zero divisor, and for a NaN result
                 * (quest_real_result_at) *)
                if x.op?primRealDiv then
                    atom(f x.args[1])
                    emit(f model.f64Const(0.0))
                    emit(f i(ops.f64Eq))
                    emit(f model.ifInst(empty ""))
                    raiseAt(f "real.error" x.offset)
                    emit(f model.endInst)
                end
                atoms(f x.args)
                emit(f i(case x.op
                    when primRealAdd then ops.f64Add when primRealSub then ops.f64Sub when primRealMul then ops.f64Mul
                    else ops.f64Div
                end))
                notNaN(f x.offset)
            when primRealLt then
                atoms(f x.args)
                emit(f i(ops.f64Lt))
            when primRealLe then
                atoms(f x.args)
                emit(f i(ops.f64Le))
            when primRealGt then
                atoms(f x.args)
                emit(f i(ops.f64Gt))
            when primRealGe then
                atoms(f x.args)
                emit(f i(ops.f64Ge))
            when primRealPow then
                (* util/realmath's, which raises real.error for a zero base
                 * and a negative exponent, and for a NaN result
                 * (quest_real_pow_at) *)
                emit(f i1(ops.globalGet f.g.noClosure))
                atoms(f x.args)
                runtimeUnitCall(f "util/realmath.pow")
            when primExtent then
                atoms(f x.args)
                castTo(f rt.index("array"))
                emit(f i2(ops.structGet rt.index("array") rt.field("array" "elems")))
                emit(f i(ops.arrayLen))
                emit(f i(ops.i64ExtendI32U))
        end

    (* ======================================================================
     * The library's externals (section 4.2)
     * ====================================================================== *)

    (* The C symbol of the library's member path.member, if it is an external
     * function (repr/externals), which a call compiles to in place *)
    let externalSymbol(path: String member: String): maybe.T(String) =
        begin
            let var found = maybe.none(:String)
            for k = 0 upto extent externals.functions - 1 do
                let e = externals.functions[k]
                if stringOp.equal(e[0] path) andif stringOp.equal(e[1] member) then found := maybe.some(e[2]) end
            end
            found
        end

    (* The externals that are functions of wasm/core, in Quest: each symbol,
     * the core's function, and its parameters' and result's representations
     * (e an eqref, n an i64, b an i32) *)
    let coreExternals = array of
        array of "quest_string_cat_sub" "catSub" "ennenn" "e" end
        array of "quest_string_conc" "conc" "e" "e" end
        array of "quest_dynamic_copy" "dynamicCopy" "e" "e" end
        array of "quest_string_equal_sub" "equalSub" "ennenn" "b" end
        array of "quest_string_precedes" "precedes" "ee" "b" end
        array of "quest_string_precedes_sub" "precedesSub" "ennenn" "b" end
        array of "quest_identity_hash" "identityHash" "ee" "n" end
        array of "quest_string_freeze" "stringFreeze" "e" "e" end
        array of "quest_sb_new" "sbNew" "" "e" end
        array of "quest_sb_append_string" "sbAppendString" "ee" "e" end
        (* Sharing a string is copying it here, which keeps its promise *)
        array of "quest_sb_append_string_shared" "sbAppendString" "ee" "e" end
        array of "quest_sb_append_char" "sbAppendChar" "eb" "e" end
        array of "quest_sb_append_int" "sbAppendInt" "en" "e" end
        array of "quest_sb_append_sub" "sbAppendSub" "eenn" "e" end
        array of "quest_sb_append_repeat" "sbAppendRepeat" "ebn" "e" end
        array of "quest_sb_clear" "sbClear" "e" "e" end
        array of "quest_sb_length" "sbLength" "e" "n" end
        array of "quest_sb_to_string" "sbToString" "e" "e" end
        array of "quest_system_args" "systemArgs" "" "e" end
        array of "quest_system_getenv" "getEnv" "e" "e" end
        array of "quest_system_file_exists" "fileExists" "e" "b" end
        array of "quest_system_is_file" "isFile" "e" "b" end
        array of "quest_system_is_directory" "isDirectory" "e" "b" end
        array of "quest_system_make_directory" "makeDirectory" "e" "e" end
        array of "quest_system_remove_file" "removeFile" "e" "e" end
        array of "quest_system_remove_directory" "removeDirectory" "e" "e" end
        array of "quest_system_rename_file" "renameFile" "ee" "e" end
        array of "quest_system_current_directory" "currentDirectory" "" "e" end
        array of "quest_system_change_directory" "changeDirectory" "e" "e" end
        array of "quest_system_list_directory" "listDirectory" "e" "e" end
        array of "quest_filestats_stat" "fileStat" "eb" "e" end
        array of "quest_files_remove" "filesRemove" "e" "n" end
        array of "quest_files_remove_directory" "filesRemoveDirectory" "e" "n" end
        array of "quest_files_rename" "filesRename" "ee" "n" end
        array of "quest_files_make_directory" "filesMakeDirectory" "en" "n" end
        array of "quest_files_create_new" "filesCreateNew" "en" "n" end
        array of "quest_files_list" "filesList" "e" "e" end
        array of "quest_files_symlink" "filesSymlink" "ee" "n" end
        array of "quest_files_read_link" "filesReadLink" "e" "e" end
        array of "quest_files_set_mode" "filesSetMode" "en" "n" end
        array of "quest_files_set_times" "filesSetTimes" "enn" "n" end
        array of "quest_files_last_status" "filesLastStatus" "" "n" end
        array of "quest_time_now_ns" "timeNow" "" "n" end
        array of "quest_time_ticks_ns" "timeTicks" "" "n" end
        array of "quest_time_cpu_ns" "timeCpu" "" "n" end
        array of "quest_time_sleep_ns" "timeSleep" "n" "e" end
        array of "quest_time_local_offset" "timeLocalOffset" "n" "n" end
        array of "quest_writer_file" "writerFile" "e" "e" end
        array of "quest_writer_close" "writerClose" "e" "e" end
        array of "quest_writer_put_string" "writerPutString" "ee" "e" end
        array of "quest_writer_put_char" "writerPutChar" "eb" "e" end
        array of "quest_writer_put_substring" "writerPutSubString" "eenn" "e" end
        array of "quest_writer_flush" "writerFlush" "e" "e" end
        array of "quest_reader_input" "readerInput" "" "e" end
        array of "quest_reader_file" "readerFile" "e" "e" end
        array of "quest_reader_more" "readerMore" "e" "b" end
        array of "quest_reader_ready" "readerMore" "e" "b" end
        array of "quest_reader_get_char" "readerGetChar" "e" "b" end
        array of "quest_reader_get_string" "readerGetString" "en" "e" end
        array of "quest_reader_get_substring" "readerGetSubString" "eenn" "e" end
        array of "quest_reader_close" "readerClose" "e" "e" end
    end
    let coreExternal(symbol: String): maybe.T(Array(String)) =
        begin
            let var found = maybe.none(:Array(String))
            for k = 0 upto extent coreExternals - 1 do
                if stringOp.equal(coreExternals[k][0] symbol) then found := maybe.some(coreExternals[k]) end
            end
            found
        end
    (* The externals that are functions of util/realconv, Quest that both
     * targets compile (section 4.3), each with the function it calls *)
    let realconvExternals = array of
        array of "quest_strutil_to_real" "toReal" end
        array of "quest_real_format" "format" end
    end
    let realconvFunction(symbol: String): maybe.T(String) =
        begin
            let var found = maybe.none(:String)
            for k = 0 upto extent realconvExternals - 1 do
                if stringOp.equal(realconvExternals[k][0] symbol) then
                    found := maybe.some(realconvExternals[k][1])
                end
            end
            found
        end
    (* The externals that are functions of util/realmath, libm's functions in
     * Quest (section 4.3), each with the function it calls and its arity;
     * each raises real.error itself where the C runtime's wrapper would *)
    let realmathExternals = array of
        array of "quest_real_sin" "sin" "1" end array of "quest_real_cos" "cos" "1" end
        array of "quest_real_tan" "tan" "1" end array of "quest_real_asin" "asin" "1" end
        array of "quest_real_acos" "acos" "1" end array of "quest_real_atan" "atan" "1" end
        array of "quest_real_atan2" "atan2" "2" end array of "quest_real_exponential" "exponential" "1" end
        array of "quest_real_log" "log" "1" end array of "quest_real_sinh" "sinh" "1" end
        array of "quest_real_cosh" "cosh" "1" end array of "quest_real_tanh" "tanh" "1" end
        array of "quest_real_exp" "pow" "2" end
    end
    let realmathFunction(symbol: String): maybe.T(Array(String)) =
        begin
            let var found = maybe.none(:Array(String))
            for k = 0 upto extent realmathExternals - 1 do
                if stringOp.equal(realmathExternals[k][0] symbol) then
                    found := maybe.some(realmathExternals[k])
                end
            end
            found
        end
    (* A Real as echo writes it (quest_put_real): its magnitude, as conv.real
     * writes it, after - when its sign bit is set *)
    let realText(f: F a: ir.Atom): Ok =
        begin
            atom(f a)
            emit(f i(ops.i64ReinterpretF64))
            emit(f model.i64Const(0))
            emit(f i(ops.i64LtS))
            emit(f model.ifInst(option blockValue of model.BlockType with let type = model.eqref end ""))
            literal(f "-")
            emit(f model.elseInst)
            literal(f "")
            emit(f model.endInst)
            emit(f i1(ops.globalGet f.g.noClosure))
            atom(f a)
            runtimeUnitCall(f "util/realconv.magnitude")
            runtimeCall(f "concat")
        end

    (* The representations codes names, as coreExternals codes them *)
    let repTypes(codes: String): Array(ValType) =
        begin
            let ts = array of(stringOp.length(codes) model.eqref)
            for k = 0 upto stringOp.length(codes) - 1 do
                let c = stringOp.getChar(codes k)
                ts[k] := if c is 'n' then model.i64 elsif c is 'b' then model.i32 else model.eqref end
            end
            ts
        end

    (* SplitMix64's finalizer (quest_hash_mix64) of the i64 on the stack *)
    let hashMix(f: F): Ok =
        begin
            let z = scratch(f model.i64)
            let step = fun(shift: Int multiplier: Int): Ok
                begin
                    emit(f i1(ops.localTee z))
                    emit(f i1(ops.localGet z))
                    emit(f model.i64Const(shift))
                    emit(f i(ops.i64ShrU))
                    emit(f i(ops.i64Xor))
                    if multiplier isnot 0 then
                        emit(f model.i64Const(multiplier))
                        emit(f i(ops.i64Mul))
                    end
                end
            step(30 ~4658895280553007687)
            step(27 ~7723592293110705685)
            step(31 0)
        end

    (* Compiles a call to the library external symbol (section 4.2): as a call
     * to the base runtime (runtimeCall), a call to a Quest runtime unit
     * (wasm/core, util/realconv, or util/realmath), or inline instructions.
     * Externals unavailable on this target compile to a stub that fails if
     * called. *)
    let externalCall(f: F symbol: String args: Array(ir.Atom) descs: Array(ir.Descriptor)
            target: maybe.T(ir.Variable)): Ok =
        begin
            let named = fun(n: String): Bool stringOp.equal(symbol n)
            let through = fun(field: String): Ok begin atoms(f args) runtimeCall(f field) end
            let okValue = fun(): Ok begin emit(f model.i32Const(0)) emit(f i(ops.refI31)) end
            let binary = fun(o: model.Op): Ok begin atoms(f args) emit(f i(o)) end
            let core = coreExternal(symbol)
            let realconv = realconvFunction(symbol)
            let realmath = realmathFunction(symbol)
            if maybe.isSome(realconv) then
                emit(f i1(ops.globalGet f.g.noClosure))
                atoms(f args)
                runtimeUnitCall(f "util/realconv." <> maybe.unwrap(realconv))
            elsif maybe.isSome(realmath) then
                emit(f i1(ops.globalGet f.g.noClosure))
                atoms(f args)
                runtimeUnitCall(f "util/realmath." <> maybe.unwrap(realmath)[1])
            elsif {named("quest_writer_put_string") orif named("quest_writer_put_char")} andif not(f.g.isCore) then
                (* a standard stream's writer, an i31ref, written by the
                 * runtime at once; a file's by the core, which buffers *)
                let w = scratch(f model.eqref)
                atom(f args[0])
                emit(f i1(ops.localTee w))
                emit(f option instRefTest of Inst with
                    let type = tuple let nullable = false let heap = option heapI31 of model.HeapType end end
                end)
                emit(f model.ifInst(option blockValue of model.BlockType with let type = model.eqref end ""))
                emit(f i1(ops.localGet w))
                atom(f args[1])
                runtimeCall(f if named("quest_writer_put_string") then "putString" else "putChar" end)
                emit(f model.elseInst)
                emit(f i1(ops.globalGet f.g.noClosure))
                emit(f i1(ops.localGet w))
                atom(f args[1])
                runtimeUnitCall(f "wasm/core." <> maybe.unwrap(core)[1])
                emit(f model.endInst)
            elsif maybe.isSome(core) then
                emit(f i1(ops.globalGet f.g.noClosure))
                descriptors(f descs)
                if named("quest_identity_hash") then boxedAtom(f args[0]) else atoms(f args) end
                runtimeUnitCall(f "wasm/core." <> maybe.unwrap(core)[1])
                if named("quest_reader_ready") then emit(f i(ops.i64ExtendI32U)) end
            (* string *)
            elsif named("quest_string_alloc") then
                through("stringNew")
            elsif named("quest_string_get_char") then
                through("stringGetChar")
            elsif named("quest_string_set_char") then
                through("stringSetChar")
            elsif named("quest_string_get_sub") then
                through("stringGetSub")
            elsif named("quest_string_set_sub") then
                through("stringSetSub")
            elsif named("quest_string_concat") then
                through("concat")
            elsif named("quest_string_equal") then
                through("stringEqual")
            elsif named("quest_string_length") then
                atoms(f args)
                castTo(f rt.index("string"))
                emit(f i2(ops.structGet rt.index("string") rt.field("string" "length")))
                emit(f i(ops.i64ExtendI32U))
            (* conv *)
            (* writer: the core's (coreExternals) *)
            (* ascii, arrayOp, raised, system *)
            elsif named("quest_ascii_char") then
                atom(f args[0])
                emit(f model.i64Const(256))
                emit(f i(ops.i64GeU))
                emit(f model.ifInst(empty ""))
                raiseAt(f "ascii.error" maybe.none())
                emit(f model.endInst)
                atom(f args[0])
                emit(f i(ops.i32WrapI64))
            elsif named("quest_ascii_val") then
                atom(f args[0])
                emit(f i(ops.i64ExtendI32U))
            elsif named("quest_array_size") then
                atom(f args[0])
                castTo(f tArray)
                emit(f i2(ops.structGet tArray fElems))
                emit(f i(ops.arrayLen))
                emit(f i(ops.i64ExtendI32U))
            elsif named("quest_raised_reraise") then
                atom(f args[0])
                castTo(f rt.index("raised"))
                emit(f i1(ops.throw 0))
            elsif named("quest_system_exit") then
                (* the files' writers flushed first, as C's exit does; then
                 * fatal, with no message, ends the run at the status *)
                if hashMap.contains(f.g.runtimeUnits "wasm/core.flushWriters") then
                    emit(f i1(ops.globalGet f.g.noClosure))
                    runtimeUnitCall(f "wasm/core.flushWriters")
                    emit(f i(ops.drop))
                end
                literal(f "")
                if hashMap.contains(f.g.runtimeUnits "wasm/core.exitStatus") then
                    emit(f i1(ops.globalGet f.g.noClosure))
                    atom(f args[0])
                    runtimeUnitCall(f "wasm/core.exitStatus")
                else
                    atom(f args[0])
                end
                emit(f i(ops.i32WrapI64))
                runtimeCall(f "fatal")
                okValue()
            elsif named("quest_system_is_terminal") then
                emit(f model.i32Const(0))
            (* Library externals with no WebAssembly equivalent raise their
             * module's error (section 4.2): no subprocesses, JIT code
             * generation, raw address inspection, or line editing. os/code's
             * symbol lookup returns null (matching a missing native symbol)
             * because the driver queries it at top level. *)
            elsif named("quest_system_run") orif strutil.startsWith(symbol "quest_process_") then
                raiseAt(f "system.error" maybe.none())
            elsif named("quest_code_symbol") then
                emit(f option instRefNull of Inst with let heap = option heapNone of model.HeapType end end)
            elsif named("quest_code_is_null") then
                atoms(f args)
                emit(f i(ops.refIsNull))
            elsif strutil.startsWith(symbol "quest_code_") orif strutil.startsWith(symbol "quest_value_") then
                raiseAt(f "value.error" maybe.none())
            elsif named("quest_readline_editing") then
                emit(f model.i32Const(0))
            elsif strutil.startsWith(symbol "quest_readline_") then
                raiseAt(f "readline.error" maybe.none())
            (* word *)
            elsif named("quest_word_not_bits") then
                atoms(f args)
                emit(f model.i64Const(~1))
                emit(f i(ops.i64Xor))
            elsif named("quest_word_and_bits") then
                binary(ops.i64And)
            elsif named("quest_word_or_bits") then
                binary(ops.i64Or)
            elsif named("quest_word_xor_bits") then
                binary(ops.i64Xor)
            elsif named("quest_word_add") then
                binary(ops.i64Add)
            elsif named("quest_word_sub") then
                binary(ops.i64Sub)
            elsif named("quest_word_mul") then
                binary(ops.i64Mul)
            elsif named("quest_word_lt") then
                binary(ops.i64LtU)
            elsif named("quest_word_le") then
                binary(ops.i64LeU)
            elsif named("quest_word_gt") then
                binary(ops.i64GtU)
            elsif named("quest_word_ge") then
                binary(ops.i64GeU)
            elsif named("quest_word_to_int") orif named("quest_word_from_int") then
                atoms(f args)
            elsif named("quest_word_pop_count_val") then
                atoms(f args)
                emit(f i(ops.i64Popcnt))
            elsif named("quest_word_count_leading_zeros_val") then
                atoms(f args)
                emit(f i(ops.i64Clz))
            elsif named("quest_word_count_trailing_zeros_val") then
                atoms(f args)
                emit(f i(ops.i64Ctz))
            elsif named("quest_word_rotate_val") then
                binary(ops.i64Rotl)
            elsif named("quest_word_div_val") orif named("quest_word_mod_val") then
                atom(f args[1])
                emit(f i(ops.i64Eqz))
                emit(f model.ifInst(empty ""))
                raiseAt(f "word.error" maybe.none())
                emit(f model.endInst)
                binary(if named("quest_word_div_val") then ops.i64DivU else ops.i64RemU end)
            elsif named("quest_word_shift_val") then
                (* 0 when |count| >= 64; left for a positive count, right with
                 * zeros for a negative *)
                let i64Result = option blockValue of model.BlockType with let type = model.i64 end
                atom(f args[1])
                emit(f model.i64Const(63))
                emit(f i(ops.i64GtS))
                atom(f args[1])
                emit(f model.i64Const(~63))
                emit(f i(ops.i64LtS))
                emit(f i(ops.i32Or))
                emit(f model.ifInst(i64Result ""))
                emit(f model.i64Const(0))
                emit(f model.elseInst)
                atom(f args[1])
                emit(f model.i64Const(0))
                emit(f i(ops.i64GeS))
                emit(f model.ifInst(i64Result ""))
                atom(f args[0])
                atom(f args[1])
                emit(f i(ops.i64Shl))
                emit(f model.elseInst)
                atom(f args[0])
                emit(f model.i64Const(0))
                atom(f args[1])
                emit(f i(ops.i64Sub))
                emit(f i(ops.i64ShrU))
                emit(f model.endInst)
                emit(f model.endInst)
            elsif named("quest_word_mul_hi") then
                (* the high 64 bits of the product, from 32-bit halves *)
                let half = fun(a: ir.Atom high: Bool): Ok
                    begin
                        atom(f a)
                        if high then
                            emit(f model.i64Const(32))
                            emit(f i(ops.i64ShrU))
                        else
                            emit(f model.i64Const(4294967295))
                            emit(f i(ops.i64And))
                        end
                    end
                let p1 = scratch(f model.i64)
                let p2 = scratch(f model.i64)
                half(args[0] false)
                half(args[1] true)
                emit(f i(ops.i64Mul))
                emit(f i1(ops.localSet p1))
                half(args[0] true)
                half(args[1] false)
                emit(f i(ops.i64Mul))
                emit(f i1(ops.localSet p2))
                (* p3 + (p1 >> 32) + (p2 >> 32) + carry, the carry the middle
                 * sum's high half *)
                half(args[0] true)
                half(args[1] true)
                emit(f i(ops.i64Mul))
                emit(f i1(ops.localGet p1))
                emit(f model.i64Const(32))
                emit(f i(ops.i64ShrU))
                emit(f i(ops.i64Add))
                emit(f i1(ops.localGet p2))
                emit(f model.i64Const(32))
                emit(f i(ops.i64ShrU))
                emit(f i(ops.i64Add))
                half(args[0] false)
                half(args[1] false)
                emit(f i(ops.i64Mul))
                emit(f model.i64Const(32))
                emit(f i(ops.i64ShrU))
                emit(f i1(ops.localGet p1))
                emit(f model.i64Const(4294967295))
                emit(f i(ops.i64And))
                emit(f i(ops.i64Add))
                emit(f i1(ops.localGet p2))
                emit(f model.i64Const(4294967295))
                emit(f i(ops.i64And))
                emit(f i(ops.i64Add))
                emit(f model.i64Const(32))
                emit(f i(ops.i64ShrU))
                emit(f i(ops.i64Add))
            (* real *)
            elsif named("quest_real_from_int") then
                atoms(f args)
                emit(f i(ops.f64ConvertI64S))
            elsif named("quest_real_floor") orif named("quest_real_ceil") orif named("quest_real_trunc") then
                atoms(f args)
                emit(f i(if named("quest_real_floor") then ops.f64Floor
                    elsif named("quest_real_ceil") then ops.f64Ceil
                    else ops.f64Trunc end))
                realToInt(f)
            elsif named("quest_real_round") then
                (* half away from zero, as C's round: the truncation, and one
                 * more away from zero when what it drops is at least a half *)
                let t = scratch(f model.f64)
                atoms(f args)
                emit(f i(ops.f64Trunc))
                emit(f i1(ops.localTee t))
                atoms(f args)
                emit(f i1(ops.localGet t))
                emit(f i(ops.f64Sub))
                emit(f i(ops.f64Abs))
                emit(f model.f64Const(0.5))
                emit(f i(ops.f64Ge))
                emit(f model.ifInst(option blockValue of model.BlockType with let type = model.f64 end ""))
                emit(f model.f64Const(1.0))
                atoms(f args)
                emit(f i(ops.f64Copysign))
                emit(f model.elseInst)
                emit(f model.f64Const(0.0))
                emit(f model.endInst)
                emit(f i(ops.f64Add))
                realToInt(f)
            elsif named("quest_real_sqrt") then
                atoms(f args)
                emit(f i(ops.f64Sqrt))
                notNaN(f maybe.none())
            elsif named("quest_real_div") then
                atom(f args[1])
                emit(f model.f64Const(0.0))
                emit(f i(ops.f64Eq))
                emit(f model.ifInst(empty ""))
                raiseAt(f "real.error" maybe.none())
                emit(f model.endInst)
                binary(ops.f64Div)
                notNaN(f maybe.none())
            elsif named("quest_word_to_real_val") then
                (* word.error for a NaN's bits, which are no Real's *)
                let r = scratch(f model.f64)
                atoms(f args)
                emit(f i(ops.f64ReinterpretI64))
                emit(f i1(ops.localTee r))
                emit(f i1(ops.localGet r))
                emit(f i(ops.f64Ne))
                emit(f model.ifInst(empty ""))
                raiseAt(f "word.error" maybe.none())
                emit(f model.endInst)
                emit(f i1(ops.localGet r))
            elsif named("quest_word_from_real_val") then
                atoms(f args)
                emit(f i(ops.i64ReinterpretF64))
            else
                pending(f "the library's external " <> symbol <> ", which this target lacks for now")
            end
        end

    (* An external value of the library: an exception the base defines, a
     * constant, or a stream *)
    let externalValue(f: F symbol: String): Ok =
        begin
            let named = fun(n: String): Bool stringOp.equal(symbol n)
            let core = coreExternal(symbol)
            let prefix = "(&quest_exc_"
            if strutil.startsWith(symbol prefix) andif strutil.endsWith(symbol ")") then
                (* the module's name, then the exception's, after its first _ *)
                let inner = stringOp.getSub(symbol stringOp.length(prefix) {{stringOp.length(symbol)
                    - stringOp.length(prefix)} - 1})
                let var at = ~1
                for k = 0 upto stringOp.length(inner) - 1 do
                    if {at < 0} andif {stringOp.getChar(inner k) is '_'} then at := k end
                end
                let name = if at < 0 then inner
                    else stringOp.getSub(inner 0 at) <> "." <> stringOp.getSub(inner {at + 1}
                            {{stringOp.length(inner) - at} - 1})
                    end
                if strings.isOneOf(name runtime.builtinExceptions) then
                    emit(f i1(ops.globalGet builtinException(name)))
                else
                    (* one the base does not define: made here, once, as the
                     * unit's initializer evaluates it, its name the C
                     * runtime's, the part after the module's in camel case
                     * (readline.endOfInput) *)
                    let b = sb.new()
                    let var upper = false
                    for k = 0 upto stringOp.length(name) - 1 do
                        let c = stringOp.getChar(name k)
                        if {c is '_'} andif {k > at} then
                            upper := true
                        else
                            sb.char(b if upper andif {ascii.val(c) >= 97} then ascii.char(ascii.val(c) - 32) else c end)
                            upper := false
                        end
                    end
                    emit(f model.i32Const(0))
                    literal(f sb.toString(b))
                    emit(f i1(ops.structNew rt.index("exception")))
                end
            elsif named("QUEST_REAL_MAX") then
                emit(f model.f64Const(1.7976931348623157e+308))
            elsif named("QUEST_REAL_MIN") then
                emit(f model.f64Const(~1.7976931348623157e+308))
            elsif named("QUEST_REAL_POS_EPSILON") then
                emit(f model.f64Const(2.220446049250313e-16))
            elsif named("QUEST_REAL_NEG_EPSILON") then
                emit(f model.f64Const(~2.220446049250313e-16))
            elsif named("QUEST_REAL_E") then
                emit(f model.f64Const(2.718281828459045))
            elsif named("QUEST_REAL_PI") then
                emit(f model.f64Const(3.141592653589793))
            elsif named("QUEST_REAL_INFINITY") then
                emit(f model.f64Const(1.0))
                emit(f model.f64Const(0.0))
                emit(f i(ops.f64Div))
            elsif named("QUEST_INT_MAX") then
                emit(f model.i64Const(9223372036854775807))
            elsif named("QUEST_INT_MIN") then
                emit(f model.i64Const(~9223372036854775807 - 1))
            elsif named("quest_writer_output") then
                emit(f model.i32Const(1))
                emit(f i(ops.refI31))
            elsif named("quest_writer_err") then
                emit(f model.i32Const(2))
                emit(f i(ops.refI31))
            elsif maybe.isSome(core) then
                emit(f i1(ops.globalGet f.g.noClosure))
                runtimeUnitCall(f "wasm/core." <> maybe.unwrap(core)[1])
            else
                pending(f "the library's external " <> symbol <> ", which this target lacks for now")
            end
        end

    (* The function a call names directly, if it does: a known closure's code
     * (walk.knownClosures), with no type arguments *)
    let directCallee(f: F x: ir.OpCall): maybe.T(Int) =
        if maybe.isNone(x.callee) then
            maybe.none()
        else
            let c = maybe.unwrap(x.callee)
            if not(hashMap.contains(f.g.known c.id)) then
                maybe.none()
            else
                let k = hashMap.find(f.g.known c.id)
                if {extent x.typeArgs is 0} andif {extent k.typeArgs is 0} then
                    hashMap.get(f.g.functions k.code.id)
                else
                    maybe.none()
                end
            end
        end

    (* The closure a direct call passes: the known closure's, if its function
     * captures anything, else any closure, which it does not read *)
    let closureArg(f: F x: ir.OpCall): Ok =
        begin
            let c = maybe.unwrap(x.callee)
            let k = hashMap.find(f.g.known c.id)
            if extent k.captures > 0 then
                atom(f ir.atomOfVar(c))
                castTo(f tClos)
            else
                emit(f i1(ops.globalGet f.g.noClosure))
            end
        end

    (* A location through a uniform entry, whose parameters are each one
     * eqref: its slot array and its index, an i31, in a slot array of two;
     * and the location again from that *)
    let packLocation(f: F): Ok =
        begin
            emit(f i(ops.refI31))
            emit(f i2(ops.arrayNewFixed tSlots 2))
        end
    let unpackLocation(f: F): Ok =
        begin
            let packed = scratch(f model.refNull(tSlots))
            castTo(f tSlots)
            emit(f i1(ops.localTee packed))
            emit(f model.i32Const(0))
            emit(f i1(ops.arrayGet tSlots))
            castTo(f tSlots)
            emit(f i1(ops.localGet packed))
            emit(f model.i32Const(1))
            emit(f i1(ops.arrayGet tSlots))
            castI31(f)
            emit(f i(ops.i31GetU))
        end
    (* Whether parameter k of function shape s takes a location: a var or
     * out parameter, or one whose type is a location's *)
    let isLocatedParam(s: shapes.Shape k: Int): Bool =
        shapes.kindIs(s shapes.shapeFun)
            andif {not(stringOp.equal(s.params[k].mode "value")) orif isLocation(s.params[k].shape.type)}

    (* A call through a closure (section 3.1): the native entry, if the
     * closure is of the callee type's signature, else the uniform entry,
     * the arguments boxed and the result unboxed; as a tail call, when tail *)
    let closureCall(f: F x: ir.OpCall tail: Bool): Ok =
        begin
            let c = maybe.unwrap(x.callee)
            let sig = closureSig(c.type)
            let n = arity(c.type)
            let s = closS(f.g sig n)
            let u = closU(f.g n)
            let held = scratch(f model.eqref)
            atom(f ir.atomOfVar(c))
            emit(f i1(ops.localSet held))
            emit(f i1(ops.localGet held))
            emit(f option instRefTest of Inst with let type = tuple let nullable = false let heap = heapOf(s) end end)
            (* as a tail call, neither branch falls out of the if *)
            emit(f model.ifInst(blockOf(f if tail then noTypes else sig.results end) ""))
            emit(f i1(ops.localGet held))
            castTo(f tClos)
            descriptors(f x.descriptors)
            atoms(f x.args)
            emit(f i1(ops.localGet held))
            castTo(f s)
            emit(f i2(ops.structGet s 2))
            emit(f i1(if tail then ops.returnCallRef else ops.callRef end nativeType(f.g sig)))
            emit(f model.elseInst)
            emit(f i1(ops.localGet held))
            castTo(f tClos)
            descriptors(f x.descriptors)
            let body = quantified(c.type).body
            for k = 0 upto extent x.args - 1 do
                if isLocatedParam(body k) then
                    atom(f x.args[k])
                    packLocation(f)
                else
                    boxedAtom(f x.args[k])
                end
            end
            emit(f i1(ops.localGet held))
            castTo(f u)
            emit(f i2(ops.structGet u 1))
            (* a result that is one eqref needs no unboxing, so a tail call
             * can return the uniform entry's result itself *)
            let q = quantified(c.type)
            let result = if shapes.kindIs(q.body shapes.shapeFun) then shapes.result(q.body).type else q.body.type end
            let plain = {extent sig.results is 1} andif sig.results[0]?valRef andif not(isRecord(result))
            if tail andif plain then
                emit(f i1(ops.returnCallRef uniformType(f.g n)))
            else
                emit(f i1(ops.callRef uniformType(f.g n)))
                unbox(f result)
                if tail then emit(f i(ops.returnOp)) end
            end
            emit(f model.endInst)
        end

    (* A call, not in tail position: a direct call of a function of the unit
     * or, by name, of another unit; a library external, compiled in place;
     * or a call through the callee's closure *)
    let call(f: F x: ir.OpCall): Ok =
        begin
            let direct = directCallee(f x)
            if maybe.isSome(direct) then
                closureArg(f x)
                descriptors(f x.descriptors)
                atoms(f x.args)
                emit(f i1(ops.call maybe.unwrap(direct)))
            elsif maybe.isSome(x.callee) then
                closureCall(f x false)
            elsif maybe.isNone(x.moduleRef) then
                fail("a call of no function")
            else
                case maybe.unwrap(x.moduleRef)
                    when refImport with imp then
                        let member = maybe.unwrapOr(x.member "")
                        let symbol =
                            if maybe.isSome(imp.i.libPath) then
                                externalSymbol(maybe.unwrap(imp.i.libPath) member)
                            else
                                maybe.none(:String)
                            end
                        if maybe.isSome(symbol) then
                            (* an external of the library, compiled in place *)
                            externalCall(f maybe.unwrap(symbol) x.args x.descriptors maybe.none())
                        elsif f.g.isCore andif maybe.isSome(imp.i.libPath) then
                            fail("the runtime's call of the library's " <> imp.i.canonicalPath <> "." <> member
                                <> ", which the backend does not compile itself")
                        else
                            (* the function the unit exports by name (section
                             * 5.1), at its interface type's signature *)
                            let key = imp.i.canonicalPath <> "." <> member
                            if not(hashMap.contains(f.g.importFunctions key)) then
                                fail("a call of the unit " <> imp.i.canonicalPath <> "'s " <> member)
                            end
                            emit(f i1(ops.globalGet f.g.noClosure))
                            descriptors(f x.descriptors)
                            atoms(f x.args)
                            emit(f i1(ops.call hashMap.find(f.g.importFunctions key)))
                        end
                    when refModule with r then
                        (* the member's variable, a global of the unit *)
                        let member = maybe.unwrapOr(x.member "")
                        let v = ir.member(r.m.members member)
                        if maybe.isNone(v) then fail("a call of no member " <> member) end
                        let y = tuple
                            let var callee = v
                            let var typeArgs = x.typeArgs
                            let var args = x.args
                            let var moduleRef = maybe.none(:ir.ModuleRef)
                            let var member = maybe.none(:String)
                            let var calleeType = x.calleeType
                            let var descriptors = x.descriptors
                        end
                        let direct = directCallee(f y)
                        if maybe.isSome(direct) then
                            closureArg(f y)
                            descriptors(f y.descriptors)
                            atoms(f y.args)
                            emit(f i1(ops.call maybe.unwrap(direct)))
                        else
                            closureCall(f y false)
                        end
                end
            end
        end

    (* A type application (opTypeApp): a type-only function, or a module's
     * member that is one, called with its type arguments' descriptors
     * alone, its result then converted as its plan says, where a box, an
     * unbox, or a cast does *)
    let typeApp(f: F x: ir.OpTypeApp target: maybe.T(ir.Variable)): Ok =
        begin
            if maybe.isSome(x.thunkParams) then
                fail("a type application whose instance is a function, not its thunk's closure")
            end
            let asCall = fun(callee: maybe.T(ir.Variable) moduleRef: maybe.T(ir.ModuleRef)): ir.OpCall
                tuple
                    let var callee = callee
                    let var typeArgs = x.typeArgs
                    let var args = array of :ir.Atom end
                    let var moduleRef = moduleRef
                    let var member = x.member
                    let var calleeType = x.calleeType
                    let var descriptors = x.descriptors
                end
            if maybe.isSome(x.callee) then closureCall(f asCall(x.callee maybe.none()) false)
            elsif maybe.isNone(x.moduleRef) then fail("a type application of no function")
            else call(f asCall(maybe.none() x.moduleRef))
            end
            if {extent x.plans > 0} andif maybe.isSome(x.plans[0]) then
                let plan = maybe.unwrap(x.plans[0])
                case plan.kind
                    when planBox, planSlotBox then box(f plan.source)
                    when planUnbox, planSlotUnbox then unboxFor(f plan.target target)
                    when planCast then ok
                    else fail("a type application's conversion " <> ir.planKindName(plan.kind))
                end
            end
        end

    (* The built-in exception a library module's error member is, the member
     * named by its module's library path (arrayop.error is arrayOp.error) *)
    let libraryException(name: String): maybe.T(String) =
        begin
            let pairs = array of
                "int.error" "int.error" "real.error" "real.error" "word.error" "word.error" "string.error"
                "string.error" "arrayop.error" "arrayOp.error" "ascii.error" "ascii.error" "dynamic.error"
                "dynamic.error" "writer.error" "writer.error" "reader.error" "reader.error" "system.error"
                "system.error"
            end
            let var found = maybe.none(:String)
            for k = 0 upto {extent pairs / 2} - 1 do
                if stringOp.equal(pairs[2 * k] name) then found := maybe.some(pairs[{2 * k} + 1]) end
            end
            found
        end

    (* The slot of field name of the record on the stack (its payload and its
     * table), of type view, through the table: the payload's slots and the
     * slot's index *)
    let fieldSlotOnStack(f: F view: ir.Type name: String): Ok =
        begin
            let vs = shapeOf(view)
            if not(shapes.kindIs(vs shapes.shapeRecord)) then fail("a field of a value of no record type") end
            let fields = shapes.sortedComponents(vs)
            let var k = ~1
            for j = 0 upto extent fields - 1 do
                if stringOp.equal(maybe.unwrapOr(fields[j].name "") name) then k := j end
            end
            if k < 0 then fail("a record type without the field " <> name) end
            let d = scratch(f model.eqref)
            emit(f i1(ops.localSet d))
            castTo(f rt.index("record"))
            emit(f i2(ops.structGet rt.index("record") rt.field("record" "slots")))
            emit(f i1(ops.localGet d))
            castTo(f rt.index("dict"))
            emit(f i2(ops.structGet rt.index("dict") 0))
            emit(f model.i32Const(k))
            emit(f i1(ops.arrayGet rt.index("i32s")))
        end

    (* Whether x is a library member the backend makes itself, not read from
     * its unit's record: writer's standard streams, the i31s 1 and 2 that the
     * base writes to at once, and the error members that are built-in
     * exceptions *)
    let knownLibraryMember(f: F x: ir.OpModuleMember): Bool =
        begin
            let name =
                case x.moduleRef
                    when refImport with imp then maybe.unwrapOr(imp.i.libPath "") <> "."
                        <> maybe.unwrapOr(x.member "")
                    when refModule then ""
                end
            stringOp.equal(name "writer.output") orif stringOp.equal(name "writer.err")
                orif maybe.isSome(libraryException(name))
        end

    let libraryMember(f: F x: ir.OpModuleMember): Ok =
        begin
            let name =
                case x.moduleRef
                    when refImport with imp then maybe.unwrapOr(imp.i.libPath "") <> "."
                        <> maybe.unwrapOr(x.member "")
                    when refModule then ""
                end
            if stringOp.equal(name "writer.output") then
                emit(f model.i32Const(1))
                emit(f i(ops.refI31))
            elsif stringOp.equal(name "writer.err") then
                emit(f model.i32Const(2))
                emit(f i(ops.refI31))
            elsif maybe.isSome(libraryException(name)) then
                emit(f i1(ops.globalGet builtinException(maybe.unwrap(libraryException(name)))))
            else
                fail("the module member " <> name)
            end
        end

    (* A module member as a value: another unit's, read from its record,
     * whose two globals it exports (section 5.1), or the record itself; a
     * library member the backend makes itself (knownLibraryMember, and any
     * in the core, which imports no library unit); the unit's own, its
     * variable *)
    let member(f: F x: ir.OpModuleMember target: maybe.T(ir.Variable)): Ok =
        case x.moduleRef
            when refImport with imp then
                if maybe.isSome(imp.i.libPath) andif {f.g.isCore orif knownLibraryMember(f x)} then
                    libraryMember(f x)
                elsif maybe.isNone(x.member) then
                    (* the unit itself, its record *)
                    if not(hashMap.contains(f.g.importRecords imp.i.canonicalPath)) then
                        fail("the unit " <> imp.i.canonicalPath <> "'s record")
                    end
                    let first = hashMap.find(f.g.importRecords imp.i.canonicalPath)
                    emit(f i1(ops.globalGet first))
                    emit(f i1(ops.globalGet first + 1))
                    if maybe.isSome(target) andif maybe.unwrap(target).boxed then
                        box(f maybe.unwrap(target).type)
                    end
                else
                    let m = maybe.unwrapOr(x.member "")
                    if not(hashMap.contains(f.g.importRecords imp.i.canonicalPath))
                            orif maybe.isNone(imp.i.recordType) then
                        fail("the unit " <> imp.i.canonicalPath <> "'s record")
                    end
                    let first = hashMap.find(f.g.importRecords imp.i.canonicalPath)
                    let recordType = maybe.unwrap(imp.i.recordType)
                    emit(f i1(ops.globalGet first))
                    emit(f i1(ops.globalGet first + 1))
                    fieldSlotOnStack(f recordType m)
                    emit(f i1(ops.arrayGet rt.index("slots")))
                    let c = maybe.unwrap(shapes.component(shapeOf(recordType) m))
                    unboxFor(f shapes.componentShape(c).type target)
                end
            when refModule with r then
                if maybe.isNone(x.member) then
                    (* the module itself, its record *)
                    if maybe.isNone(r.m.recordVar) then fail("a module without its record") end
                    let rv = maybe.unwrap(r.m.recordVar)
                    atom(f ir.atomOfVar(rv))
                    let boxedTarget = maybe.isSome(target) andif maybe.unwrap(target).boxed
                    if boxedTarget andif not(rv.boxed) then
                        box(f maybe.unwrap(target).type)
                    end
                else
                    let v = ir.member(r.m.members maybe.unwrapOr(x.member ""))
                    if maybe.isNone(v) then fail("no member " <> maybe.unwrapOr(x.member "")) end
                    atom(f ir.atomOfVar(maybe.unwrap(v)))
                end
        end

    (* --- Records --- *)

    (* The table of the view's fields in a record laid out as layout: for
     * each of view's fields, in name order, its slot in the payload, whose
     * fields are in name order; an immutable global, made once for each pair *)
    let dict(f: F view: ir.Type layout: ir.Type): Int =
        begin
            let vs = shapes.sortedComponents(shapeOf(view))
            let ls = shapes.sortedComponents(shapeOf(layout))
            let key = conv.int(shapeOf(view).id) <> ":" <> conv.int(shapeOf(layout).id)
            if hashMap.contains(f.g.dicts key) then
                hashMap.find(f.g.dicts key)
            else
                let init = vector.new(:Inst)
                for k = 0 upto extent vs - 1 do
                    let name = maybe.unwrapOr(vs[k].name "")
                    let var at = ~1
                    for j = 0 upto extent ls - 1 do
                        if stringOp.equal(maybe.unwrapOr(ls[j].name "") name) then at := j end
                    end
                    if at < 0 then fail("a view's field " <> name <> " that the record does not have") end
                    vector.append(init model.i32Const(at))
                end
                vector.append(init i2(ops.arrayNewFixed rt.index("i32s") extent vs))
                (* no field stored at another type: only the core's tables,
                 * made from descriptors, say otherwise *)
                vector.append(init option instRefNull of Inst with let heap = option heapNone of model.HeapType end end)
                vector.append(init i1(ops.structNew tDict))
                let n = model.importedGlobals(f.g.m) + vector.length(f.g.m.globals)
                vector.append(f.g.m.globals tuple
                    let name = fresh(f.g.names "dict")
                    let type = model.ref(tDict)
                    let mutable = false
                    let init = vector.toArray(init)
                end)
                hashMap.insert(f.g.dicts key n)
                n
            end
        end

    (* A new record: its payload, its fields in name order, and its view's
     * table; boxed if target is held boxed *)
    let makeRecord(f: F x: ir.OpMakeRecord target: maybe.T(ir.Variable)): Ok =
        begin
            let runtime = x.runtimeOffsets orif maybe.isNone(x.offsets)
            if runtime andif {maybe.isNone(x.viewDescriptor) orif maybe.isNone(x.descriptor)} then
                fail("a record whose table is known only at run time, without its descriptors")
            end
            (* its fields in name order: its layout's *)
            let names = array of(extent x.fields "")
            for k = 0 upto extent x.fields - 1 do names[k] := x.fields[k].name end
            for k = 0 upto extent names - 1 do
                for j = 0 upto {extent names - 2} - k do
                    if stringOp.precedes(names[j + 1] names[j]) then
                        let held = names[j]
                        names[j] := names[j + 1]
                        names[j + 1] := held
                    end
                end
            end
            emit(f model.i32Const(0))
            (* the descriptor of its own type, its layout, which its tables
             * are made for (quest_record_layout) *)
            let made =
                if maybe.isNone(x.descriptor) then
                    false
                else
                    case maybe.unwrap(x.descriptor)
                        when descStatic with d then hashMap.contains(f.g.descGlobals formOf(f.g d.d).symbol)
                        else true
                    end
                end
            (* none where the unit makes no descriptor for it, a record no
             * view needs (a closure's captures) *)
            if made then descriptor(f maybe.unwrap(x.descriptor))
            else emit(f option instRefNull of Inst with let heap = option heapNone of model.HeapType end end)
            end
            for k = 0 upto extent names - 1 do
                let name = names[k]
                let var found = false
                for j = 0 upto extent x.fields - 1 do
                    if stringOp.equal(x.fields[j].name name) then
                        boxedAtom(f x.fields[j].atom)
                        found := true
                    end
                end
                if not(found) then fail("a record without its layout's field " <> name) end
            end
            emit(f i2(ops.arrayNewFixed tSlots extent names))
            emit(f i1(ops.structNew tRecord))
            if runtime then
                let payload = scratch(f model.eqref)
                emit(f i1(ops.localTee payload))
                emit(f i1(ops.globalGet f.g.noClosure))
                emit(f i1(ops.localGet payload))
                descriptor(f maybe.unwrap(x.viewDescriptor))
                runtimeUnitCall(f "wasm/core.viewDict")
            else
                let table = maybe.unwrap(x.offsets)
                emit(f i1(ops.globalGet dict(f table.view table.layout)))
            end
            if maybe.isSome(target) andif maybe.unwrap(target).boxed then
                box(f maybe.unwrap(target).type)
            end
        end

    (* The index of field name among the record type's, in name order *)
    let fieldIndex(vs: shapes.Shape name: String): Int =
        begin
            let fields = shapes.sortedComponents(vs)
            let var k = ~1
            for j = 0 upto extent fields - 1 do
                if stringOp.equal(maybe.unwrapOr(fields[j].name "") name) then k := j end
            end
            k
        end

    (* The payload's slots and the slot of field name of the record base,
     * through its view's table *)
    let fieldSlot(f: F base: ir.Atom name: String): Ok =
        begin
            recordAtom(f base)
            fieldSlotOnStack(f ir.atomType(base) name)
        end

    (* The payload's slots and the slot of the bound's field name, of a
     * record held at its type argument's view, through the view map *)
    let viewFieldSlot(f: F base: ir.Atom name: String m: maybe.T(ir.Variable)): Ok =
        begin
            let dict = scratch(f model.eqref)
            recordAtom(f base)
            emit(f i1(ops.localSet dict))
            castTo(f rt.index("record"))
            emit(f i2(ops.structGet rt.index("record") rt.field("record" "slots")))
            emit(f i1(ops.globalGet f.g.noClosure))
            emit(f i1(ops.localGet dict))
            viewMapOf(f m)
            emit(f model.i64Const(fieldIndex(shapeOf(ir.atomType(base)) name)))
            runtimeUnitCall(f "wasm/core.viewRecordSlot")
            emit(f i(ops.i32WrapI64))
        end

    (* Field x.name of a record, unboxed unless target is held boxed: read
     * through the view map for a bounded type parameter's value; through
     * the core's storedField for a field a subtype's record may hold at
     * another type (x.stored, docs/c-representation.md section 5.2); else
     * from its slot, through its view's table *)
    let recordField(f: F x: ir.OpRecordField target: maybe.T(ir.Variable)): Ok =
        begin
            let c = maybe.unwrap(shapes.component(shapeOf(ir.atomType(x.recordAtom)) x.name))
            if maybe.isSome(x.viewMap) then
                (* the bound's field, through the map of the type argument's
                 * fields, converted from the type it is stored at *)
                let payload = scratch(f model.eqref)
                let dict = scratch(f model.eqref)
                recordAtom(f x.recordAtom)
                emit(f i1(ops.localSet dict))
                emit(f i1(ops.localSet payload))
                emit(f i1(ops.globalGet f.g.noClosure))
                emit(f i1(ops.localGet payload))
                emit(f i1(ops.localGet dict))
                viewMapOf(f x.viewMap)
                emit(f model.i64Const(fieldIndex(shapeOf(ir.atomType(x.recordAtom)) x.name)))
                runtimeUnitCall(f "wasm/core.viewRecordField")
            elsif x.stored then
                if maybe.isNone(x.descriptor) then fail("a stored field without its descriptor") end
                let dict = scratch(f model.eqref)
                let value = scratch(f model.eqref)
                recordAtom(f x.recordAtom)
                emit(f i1(ops.localTee dict))
                fieldSlotOnStack(f ir.atomType(x.recordAtom) x.name)
                emit(f i1(ops.arrayGet tSlots))
                emit(f i1(ops.localSet value))
                emit(f i1(ops.globalGet f.g.noClosure))
                emit(f i1(ops.localGet value))
                emit(f i1(ops.localGet dict))
                emit(f model.i64Const(fieldIndex(shapeOf(ir.atomType(x.recordAtom)) x.name)))
                descriptor(f maybe.unwrap(x.descriptor))
                runtimeUnitCall(f "wasm/core.storedField")
            else
                fieldSlot(f x.recordAtom x.name)
                emit(f i1(ops.arrayGet tSlots))
            end
            unboxFor(f shapes.componentShape(c).type target)
        end

    (* --- Closures --- *)

    (* A function's uniform entry (section 3.1): its native entry itself when
     * its signature is the uniform one, else a function that unboxes the
     * arguments, calls it, and boxes the result *)
    let uniformEntry(g: G fn: ir.Function): Int =
        if hashMap.contains(g.uniforms fn.id) then
            hashMap.find(g.uniforms fn.id)
        else
            let native = hashMap.find(g.functions fn.id)
            let sig = closureSig(fn.v.type)
            let n = arity(fn.v.type)
            let index =
                if isUniform(sig n) then
                    native
                else
                    let q = quantified(fn.v.type)
                    let s = q.body
                    let names = array of(n + 1 "")
                    let f = newF(g names array of model.eqref end ~1)
                    names[0] := "closure"
                    for k = 1 upto n do names[k] := "a" <> conv.int(k - 1) end
                    (* A function whose result ir/unbox unboxed is only ever
                     * called directly, so its closure, which it has when it
                     * captures (makeClosure), is never called through: its
                     * uniform entry, which could not box its components as
                     * its result, traps *)
                    if fn.unboxedResult then
                        emit(f i(ops.unreachable))
                    else
                        emit(f i1(ops.localGet 0))
                        (* descriptors pass as they are *)
                        for k = 0 upto n - 1 do
                            emit(f i1(ops.localGet k + 1))
                            if k >= q.count then
                                if isLocatedParam(s k - q.count) then unpackLocation(f)
                                else unbox(f s.params[k - q.count].shape.type)
                                end
                            end
                        end
                        let result = if shapes.kindIs(s shapes.shapeFun) then shapes.result(s).type else s.type end
                        let plain = {extent sig.results is 1} andif sig.results[0]?valRef
                            andif not(isRecord(result))
                        if plain then
                            emit(f i1(ops.returnCall native))
                        else
                            emit(f i1(ops.call native))
                            box(f result)
                        end
                    end
                    let at = model.importedFunctions(g.m) + vector.length(g.m.functions)
                    vector.append(g.m.functions tuple
                        let name = fresh(g.names fn.v.hint <> ".uniform")
                        let type = uniformType(g n)
                        let params = names
                        let locals = f.declared
                        let body = f.code
                    end)
                    at
                end
            hashMap.insert(g.uniforms fn.id index)
            index
        end

    (* The native entry of the closure of fn, whose result ir/unbox unboxed: a
     * function of the closure type's native signature that traps, since fn is
     * only ever called directly, by its own function, which returns the
     * result's components and so has another type; the closure is there for
     * fn's captures, which a direct call reads from it *)
    let trapNative(g: G fn: ir.Function): Int =
        if hashMap.contains(g.trapNatives fn.id) then
            hashMap.find(g.trapNatives fn.id)
        else
            let sig = closureSig(fn.v.type)
            let names = array of({extent sig.params + 1} "")
            names[0] := "closure"
            for k = 1 upto extent sig.params do names[k] := "a" <> conv.int(k - 1) end
            let f = newF(g names sig.results ~1)
            emit(f i(ops.unreachable))
            let at = model.importedFunctions(g.m) + vector.length(g.m.functions)
            vector.append(g.m.functions tuple
                let name = fresh(g.names fn.v.hint <> ".native")
                let type = nativeType(g sig)
                let params = names
                let locals = f.declared
                let body = f.code
            end)
            hashMap.insert(g.trapNatives fn.id at)
            at
        end

    (* A function's static closure, which captures nothing: an immutable
     * global, made once *)
    let staticClosure(g: G fn: ir.Function): Int =
        if hashMap.contains(g.staticClosures fn.id) then
            hashMap.find(g.staticClosures fn.id)
        else
            let own = ownType(g fn)
            let u = uniformEntry(g fn)
            let native = hashMap.find(g.functions fn.id)
            declare(g u)
            declare(g native)
            let n = model.importedGlobals(g.m) + vector.length(g.m.globals)
            vector.append(g.m.globals tuple
                let name = fresh(g.names fn.v.hint <> ".static")
                let type = model.ref(own)
                let mutable = false
                let init = array of model.i32Const(0) i1(ops.refFunc u) i1(ops.refFunc native) i1(ops.structNew own) end
            end)
            hashMap.insert(g.staticClosures fn.id n)
            n
        end

    (* The value on the stack, as a slot holds it, converted by plan to the
     * target's slot form: by descriptors in the core (view, runtime); a
     * record's box seen at the target's type, its table the core's; a
     * variant's box with its tag in the target's numbering; a copy of a
     * tuple, each component converted by its own plan; a closure wrapped in
     * an adapter's; a proxy's original; and nothing for the plans that only
     * change a value's representation outside a slot (box, unbox, cast) *)
    let rec slotConvert(f: F plan: ir.Plan): Ok =
        case plan.kind
            when planView, planRuntime then
                if extent plan.descriptors < 2 then fail("a conversion by descriptors without them") end
                let v = scratch(f model.eqref)
                emit(f i1(ops.localSet v))
                emit(f i1(ops.globalGet f.g.noClosure))
                emit(f i1(ops.localGet v))
                descriptor(f plan.descriptors[0])
                descriptor(f plan.descriptors[1])
                runtimeUnitCall(f "wasm/core.convert")
            when planRecordView then
                if extent plan.descriptors < 1 then fail("a record view without its descriptor") end
                let payload = scratch(f model.eqref)
                castTo(f tRecBox)
                emit(f i2(ops.structGet tRecBox 0))
                emit(f i1(ops.localSet payload))
                (* The new box's payload, back from the eqref scratch *)
                emit(f i1(ops.localGet payload))
                castTo(f tRecord)
                emit(f i1(ops.globalGet f.g.noClosure))
                emit(f i1(ops.localGet payload))
                descriptor(f plan.descriptors[0])
                runtimeUnitCall(f "wasm/core.viewDict")
                castTo(f tDict)
                emit(f i1(ops.structNew tRecBox))
            when planVariantTags then
                let table = maybe.unwrap(plan.tagMap)
                let sourceS = shapeOf(table.source)
                let targetS = shapeOf(table.target)
                let tags = array of(extent sourceS.cases 0)
                for k = 0 upto extent sourceS.cases - 1 do
                    tags[k] := tagIndex(targetS maybe.unwrapOr(sourceS.cases[k].name ""))
                end
                let held = scratch(f model.eqref)
                unbox(f plan.source)
                emit(f i1(ops.localSet held))
                mapI32(f tags)
                emit(f i1(ops.localGet held))
                box(f plan.target)
            when planCopy then copyTuple(f plan)
            when planAdapt then
                if maybe.isNone(plan.thunk) then fail("an adapt plan without its adapter") end
                let fn = maybe.unwrap(plan.thunk)
                if capturedDescriptors(fn) > 0 then fail("an adapter whose closure supplies descriptors") end
                let own = ownType(f.g fn)
                let u = uniformEntry(f.g fn)
                let native = hashMap.find(f.g.functions fn.id)
                declare(f.g u)
                declare(f.g native)
                let v = scratch(f model.eqref)
                emit(f i1(ops.localSet v))
                emit(f model.i32Const(0))
                emit(f i1(ops.refFunc u))
                emit(f i1(ops.refFunc native))
                emit(f i1(ops.localGet v))
                emit(f i1(ops.structNew own))
            when planUnproxy then if not(f.g.isRuntime) then accessAs(f tTuple ir.original) end
            when planBox, planUnbox, planSlotBox, planSlotUnbox, planCast then ok
        end

    (* A new tuple of the tuple on the stack's components, each converted by
     * plan's field for it, or as it is (a copy plan, quest_convert's
     * copy where a proxy is not wanted) *)
    and copyTuple(f: F plan: ir.Plan): Ok =
        begin
            let targetS = shapeOf(plan.target)
            let n = if extent targetS.components < extent plan.fields then extent targetS.components
                else extent plan.fields
                end
            let slots = scratch(f model.refNull(tSlots))
            accessAs(f tTuple anyIndirect(plan.access))
            emit(f i2(ops.structGet tTuple fSlots))
            emit(f i1(ops.localSet slots))
            emit(f model.i32Const(0))
            for i = 0 upto n - 1 do
                emit(f i1(ops.localGet slots))
                emit(f model.i32Const(i))
                emit(f i1(ops.arrayGet tSlots))
                if maybe.isSome(plan.fields[i]) then slotConvert(f maybe.unwrap(plan.fields[i])) end
            end
            emit(f i2(ops.arrayNewFixed tSlots n))
            emit(f i1(ops.structNew tTuple))
        end

    (* A value converted as its plan says (docs/ir.md section 8.3): to and
     * from a slot's form, which for a record is its box; a cast between
     * references changes nothing here *)
    let convert(f: F x: ir.OpConvert target: maybe.T(ir.Variable)): Ok =
        case x.plan.kind
            when planBox, planSlotBox then boxedAtom(f x.value)
            when planUnbox, planSlotUnbox then
                atom(f x.value)
                unboxFor(f x.plan.target target)
            when planCast then atom(f x.value)
            when planAdapt then
                (* a closure of the adapter (ir/thunks), which captures the
                 * closure it adapts *)
                if maybe.isNone(x.plan.thunk) then fail("an adapt plan without its adapter") end
                let fn = maybe.unwrap(x.plan.thunk)
                if capturedDescriptors(fn) > 0 then fail("an adapter whose closure supplies descriptors") end
                let own = ownType(f.g fn)
                let u = uniformEntry(f.g fn)
                let native = hashMap.find(f.g.functions fn.id)
                declare(f.g u)
                declare(f.g native)
                emit(f model.i32Const(0))
                emit(f i1(ops.refFunc u))
                emit(f i1(ops.refFunc native))
                atom(f x.value)
                emit(f i1(ops.structNew own))
            (* a tuple or option that may be a proxy, as its original *)
            when planUnproxy then
                atom(f x.value)
                if not(f.g.isRuntime) then accessAs(f tTuple ir.original) end
            when planVariantTags then
                let table = maybe.unwrap(x.plan.tagMap)
                let sourceS = shapeOf(table.source)
                let targetS = shapeOf(table.target)
                let tags = array of(extent sourceS.cases 0)
                for k = 0 upto extent sourceS.cases - 1 do
                    tags[k] := tagIndex(targetS maybe.unwrapOr(sourceS.cases[k].name ""))
                end
                let held = scratch(f model.eqref)
                variantAtom(f x.value)
                emit(f i1(ops.localSet held))
                mapI32(f tags)
                emit(f i1(ops.localGet held))
                if maybe.isSome(target) andif maybe.unwrap(target).boxed then
                    box(f x.plan.target)
                end
            when planRecordView then
                if extent x.plan.descriptors < 1 then fail("a record view without its descriptor") end
                let payload = scratch(f model.eqref)
                let dict = scratch(f model.eqref)
                recordAtom(f x.value)
                emit(f i(ops.drop))
                emit(f i1(ops.localSet payload))
                emit(f i1(ops.globalGet f.g.noClosure))
                emit(f i1(ops.localGet payload))
                descriptor(f x.plan.descriptors[0])
                runtimeUnitCall(f "wasm/core.viewDict")
                emit(f i1(ops.localSet dict))
                emit(f i1(ops.localGet payload))
                emit(f i1(ops.localGet dict))
                if maybe.isSome(target) andif maybe.unwrap(target).boxed then
                    box(f x.plan.target)
                end
            when planView, planRuntime, planCopy then
                (* in the slot form, converted there, and back *)
                boxedAtom(f x.value)
                slotConvert(f x.plan)
                unboxFor(f x.plan.target target)
        end

    (* Returns the global index of the static closure for built-in operator
     * name (opBuiltin, matching the C runtime's trampolines such as
     * qv_sym_plus_closure), building it on first use. Its $closS struct holds
     * a native entry for the operator and a uniform entry that unboxes and
     * boxes around it. Covers Int arithmetic and comparisons (raising
     * int.error with no site on zero division), Real operators (raising
     * real.error as usual, with ^^ calling util/realmath), String <>, and
     * eager Bool /\ and \/. *)
    let builtinClosure(g: G name: String): Int =
        if hashMap.contains(g.builtins name) then
            hashMap.find(g.builtins name)
        else
            let named = fun(n: String): Bool stringOp.equal(name n)
            let isOneOf = fun(ns: Array(String)): Bool strings.isOneOf(name ns)
            let intCompares = isOneOf(array of "<" "<=" ">" ">=" end)
            let intArithmetic = isOneOf(array of "+" "-" "*" "/" "%" "mod" end)
            let realCompares = isOneOf(array of "<<" "<<=" ">>" ">>=" end)
            let realArithmetic = isOneOf(array of "++" "--" "**" "//" "^^" end)
            let logical = isOneOf(array of "/\\" "\\/" end)
            let concat = named("<>")
            if not(intCompares orif intArithmetic orif realCompares orif realArithmetic orif logical orif concat) then
                fail("the built-in " <> name <> " as a value")
            end
            let operand = if intCompares orif intArithmetic then model.i64
                elsif realCompares orif realArithmetic then model.f64
                elsif logical then model.i32
                else model.eqref
                end
            let result = if intCompares orif realCompares orif logical then model.i32
                elsif intArithmetic then model.i64
                elsif realArithmetic then model.f64
                else model.eqref
                end
            let sig = tuple let params = array of operand operand end let results = array of result end end
            let s = closS(g sig 2)
            (* The native entry *)
            let nf = newF(g array of "closure" "a" "b" end sig.results ~1)
            if named("/") orif named("%") orif named("mod") then
                emit(nf i1(ops.localGet 2))
                emit(nf i(ops.i64Eqz))
                emit(nf model.ifInst(empty ""))
                raiseAt(nf "int.error" maybe.none())
                emit(nf model.endInst)
                emit(nf i1(ops.localGet 2))
                emit(nf model.i64Const(~1))
                emit(nf i(ops.i64Eq))
                emit(nf model.ifInst(empty ""))
                if named("/") then
                    emit(nf model.i64Const(0))
                    emit(nf i1(ops.localGet 1))
                    emit(nf i(ops.i64Sub))
                else
                    emit(nf model.i64Const(0))
                end
                emit(nf i(ops.returnOp))
                emit(nf model.endInst)
            end
            if named("//") then
                emit(nf i1(ops.localGet 2))
                emit(nf model.f64Const(0.0))
                emit(nf i(ops.f64Eq))
                emit(nf model.ifInst(empty ""))
                raiseAt(nf "real.error" maybe.none())
                emit(nf model.endInst)
            end
            if named("^^") then emit(nf i1(ops.globalGet g.noClosure)) end
            emit(nf i1(ops.localGet 1))
            emit(nf i1(ops.localGet 2))
            if named("^^") then runtimeUnitCall(nf "util/realmath.pow")
            elsif concat then runtimeCall(nf "concat")
            else
                emit(nf i(if named("+") then ops.i64Add
                    elsif named("-") then ops.i64Sub
                    elsif named("*") then ops.i64Mul
                    elsif named("/") then ops.i64DivS
                    elsif named("%") orif named("mod") then ops.i64RemS
                    elsif named("<") then ops.i64LtS
                    elsif named("<=") then ops.i64LeS
                    elsif named(">") then ops.i64GtS
                    elsif named(">=") then ops.i64GeS
                    elsif named("++") then ops.f64Add
                    elsif named("--") then ops.f64Sub
                    elsif named("**") then ops.f64Mul
                    elsif named("//") then ops.f64Div
                    elsif named("<<") then ops.f64Lt
                    elsif named("<<=") then ops.f64Le
                    elsif named(">>") then ops.f64Gt
                    elsif named(">>=") then ops.f64Ge
                    elsif named("/\\") then ops.i32And
                    else ops.i32Or end))
                if realArithmetic then notNaN(nf maybe.none()) end
            end
            let native = model.importedFunctions(g.m) + vector.length(g.m.functions)
            vector.append(g.m.functions tuple
                let name = fresh(g.names "builtin" <> name)
                let type = nativeType(g sig)
                let params = array of "closure" "a" "b" end
                let locals = nf.declared
                let body = nf.code
            end)
            (* The uniform entry *)
            let uf = newF(g array of "closure" "a" "b" end array of model.eqref end ~1)
            emit(uf i1(ops.localGet 0))
            for k = 1 upto 2 do
                emit(uf i1(ops.localGet k))
                case operand
                    when valI64 then runtimeCall(uf "unboxInt")
                    when valF64 then
                        castTo(uf rt.index("boxReal"))
                        emit(uf i2(ops.structGet rt.index("boxReal") 0))
                    when valI32 then
                        castI31(uf)
                        emit(uf i(ops.i31GetU))
                    else ok
                end
            end
            emit(uf i1(ops.call native))
            case result
                when valI64 then runtimeCall(uf "boxInt")
                when valF64 then emit(uf i1(ops.structNew rt.index("boxReal")))
                when valI32 then emit(uf i(ops.refI31))
                else ok
            end
            let uniform = model.importedFunctions(g.m) + vector.length(g.m.functions)
            vector.append(g.m.functions tuple
                let name = fresh(g.names "builtin" <> name <> ".uniform")
                let type = uniformType(g 2)
                let params = array of "closure" "a" "b" end
                let locals = uf.declared
                let body = uf.code
            end)
            declare(g native)
            declare(g uniform)
            let n = model.importedGlobals(g.m) + vector.length(g.m.globals)
            vector.append(g.m.globals tuple
                let name = fresh(g.names "builtin" <> name <> ".static")
                let type = model.ref(s)
                let mutable = false
                let init = array of
                    model.i32Const(0) i1(ops.refFunc uniform) i1(ops.refFunc native) i1(ops.structNew s)
                end
            end)
            hashMap.insert(g.builtins name n)
            n
        end

    (* Builds a closure adapter for uniform arity n when viewing a function at
     * a supertype (used by wasm/core.convert, matching quest_convert's
     * meta->adapt). Creates a $adaptN subtype of $closU(n) holding the wrapped
     * closure and source/target type descriptors, along with a uniform entry
     * that converts each argument via adaptArg, calls the wrapped closure's
     * uniform entry, and converts the result via adaptResult. Returns the
     * struct type index and entry function index. *)
    Def Adapter = Tuple type: Int entry: Int end
    let adapterOf(g: G n: Int adaptArg: Int adaptResult: Int): Adapter =
        begin
            let t = addType(g structSub("adapt" <> conv.int(n) true closU(g n) array of
                hashField fieldOf("uniform" model.ref(uniformType(g n)) false)
                fieldOf("orig" model.eqref false) fieldOf("from" model.eqref false) fieldOf("to" model.eqref false)
            end))
            let names = array of(n + 1 "")
            names[0] := "closure"
            for k = 1 upto n do names[k] := "a" <> conv.int(k - 1) end
            let f = newF(g names array of model.eqref end ~1)
            let state = scratch(f model.refNull(t))
            let result = scratch(f model.eqref)
            emit(f i1(ops.localGet 0))
            castTo(f t)
            emit(f i1(ops.localSet state))
            (* the closure adapted, then each argument converted *)
            emit(f i1(ops.localGet state))
            emit(f i2(ops.structGet t 2))
            castTo(f tClos)
            for k = 0 upto n - 1 do
                emit(f i1(ops.globalGet g.noClosure))
                emit(f i1(ops.localGet state))
                emit(f i2(ops.structGet t 3))
                emit(f i1(ops.localGet state))
                emit(f i2(ops.structGet t 4))
                emit(f model.i64Const(k))
                emit(f i1(ops.localGet k + 1))
                emit(f i1(ops.call adaptArg))
            end
            emit(f i1(ops.localGet state))
            emit(f i2(ops.structGet t 2))
            castTo(f closU(g n))
            emit(f i2(ops.structGet closU(g n) 1))
            emit(f i1(ops.callRef uniformType(g n)))
            emit(f i1(ops.localSet result))
            emit(f i1(ops.globalGet g.noClosure))
            emit(f i1(ops.localGet state))
            emit(f i2(ops.structGet t 3))
            emit(f i1(ops.localGet state))
            emit(f i2(ops.structGet t 4))
            emit(f i1(ops.localGet result))
            emit(f i1(ops.call adaptResult))
            let at = model.importedFunctions(g.m) + vector.length(g.m.functions)
            vector.append(g.m.functions tuple
                let name = fresh(g.names "adapt" <> conv.int(n) <> ".uniform")
                let type = uniformType(g n)
                let params = names
                let locals = f.declared
                let body = f.code
            end)
            declare(g at)
            tuple let type = t let entry = at end
        end

    (* Builds wasm/core's adaptClosure dispatcher on first use and returns its
     * function index. Handles uniform arities up to maxAdapted directly, and
     * for larger arities looks up a unit-registered maker via adapterFor (see
     * adaptersPast). *)
    let maxAdapted = 8
    let adapters(g: G): Int =
        if hashMap.contains(g.runtimeFunctions "adaptClosure") then
            hashMap.find(g.runtimeFunctions "adaptClosure")
        else
            let helper = fun(name: String): Int
                begin
                    let var found = ~1
                    for k = 0 upto vector.length(g.unit.functions) - 1 do
                        let fn = vector.get(g.unit.functions k)
                        if {found < 0} andif stringOp.equal(fn.v.hint name) then
                            found := hashMap.find(g.functions fn.id)
                        end
                    end
                    if found < 0 then fail("the core's " <> name) end
                    found
                end
            let adaptArg = helper("adaptArg")
            let adaptResult = helper("adaptResult")
            let adapterFor = helper("adapterFor")
            let made = array of(maxAdapted + 1 tuple let type = 0 let entry = 0 end)
            for n = 0 upto maxAdapted do made[n] := adapterOf(g n adaptArg adaptResult) end
            (* adaptClosure(v from to n): an adapter of arity n *)
            let names = array of "v" "from" "to" "n" end
            let f = newF(g names array of model.eqref end ~1)
            for n = 0 upto maxAdapted do
                emit(f i1(ops.localGet 3))
                emit(f model.i64Const(n))
                emit(f i(ops.i64Eq))
                emit(f model.ifInst(empty ""))
                emit(f model.i32Const(0))
                emit(f i1(ops.refFunc made[n].entry))
                emit(f i1(ops.localGet 0))
                emit(f i1(ops.localGet 1))
                emit(f i1(ops.localGet 2))
                emit(f i1(ops.structNew made[n].type))
                emit(f i(ops.returnOp))
                emit(f model.endInst)
            end
            (* past them, the maker a unit registered, a closure of three
             * parameters, called with the closure and the two types *)
            let maker = scratch(f model.eqref)
            emit(f i1(ops.globalGet g.noClosure))
            emit(f i1(ops.localGet 0))
            emit(f i1(ops.localGet 3))
            emit(f i1(ops.call adapterFor))
            emit(f i1(ops.localTee maker))
            castTo(f tClos)
            emit(f i1(ops.localGet 0))
            emit(f i1(ops.localGet 1))
            emit(f i1(ops.localGet 2))
            emit(f i1(ops.localGet maker))
            castTo(f closU(g 3))
            emit(f i2(ops.structGet closU(g 3) 1))
            emit(f i1(ops.callRef uniformType(g 3)))
            let index = model.importedFunctions(g.m) + vector.length(g.m.functions)
            vector.append(g.m.functions tuple
                let name = fresh(g.names "adaptClosure")
                let type =
                    funcType(g array of model.eqref model.eqref model.eqref model.i64 end array of model.eqref end)
                let params = names
                let locals = f.declared
                let body = f.code
            end)
            hashMap.insert(g.runtimeFunctions "adaptClosure" index)
            index
        end

    (* The arities past maxAdapted at which a unit's code may call a closure
     * through its uniform entry (closureCall), in order, each once *)
    let arityPast(g: G unit: ir.Unit): Array(Int) =
        begin
            let found = vector.new(:Int)
            let bodies = walk.unitBodies(unit)
            for b = 0 upto extent bodies - 1 do
                let ss = walk.walkStatements(bodies[b] true)
                for k = 0 upto vector.length(ss) - 1 do
                    let op =
                        case vector.get(ss k)
                            when sLet with x then maybe.some(x.value)
                            when sDo with x then maybe.some(x.value)
                            else maybe.none(:ir.Op)
                        end
                    if maybe.isSome(op) then
                        case maybe.unwrap(op)
                            when opCall with x then
                                if maybe.isSome(x.callee) then
                                    let n = arity(maybe.unwrap(x.callee).type)
                                    let var seen = n <= maxAdapted
                                    for j = 0 upto vector.length(found) - 1 do
                                        if vector.get(found j) is n then seen := true end
                                    end
                                    if not(seen) then vector.append(found n) end
                                end
                            else ok
                        end
                    end
                end
            end
            vector.toArray(found)
        end

    (* The adapters of the arities past the core's that the unit calls
     * closures at, each with a maker, a closure of three parameters (the
     * closure, the two types) that makes one; registered with the core as
     * the unit starts, so that the core's adaptClosure finds them (natively
     * the adapters have no limit; section 3.2) *)
    let adaptersPast(f: F arities: Array(Int)): Ok =
        for k = 0 upto extent arities - 1 do
            let g = f.g
            let n = arities[k]
            let a = adapterOf(g n hashMap.find(g.runtimeUnits "wasm/core.adaptArg")
                    hashMap.find(g.runtimeUnits "wasm/core.adaptResult"))
            let mf = newF(g array of "maker" "v" "from" "to" end array of model.eqref end ~1)
            emit(mf model.i32Const(0))
            emit(mf i1(ops.refFunc a.entry))
            emit(mf i1(ops.localGet 1))
            emit(mf i1(ops.localGet 2))
            emit(mf i1(ops.localGet 3))
            emit(mf i1(ops.structNew a.type))
            let maker = model.importedFunctions(g.m) + vector.length(g.m.functions)
            vector.append(g.m.functions tuple
                let name = fresh(g.names "adapt" <> conv.int(n) <> ".maker")
                let type = uniformType(g 3)
                let params = array of "maker" "v" "from" "to" end
                let locals = mf.declared
                let body = mf.code
            end)
            declare(g maker)
            emit(f i1(ops.globalGet g.noClosure))
            emit(f model.i64Const(n))
            emit(f model.i32Const(0))
            emit(f i1(ops.refFunc maker))
            emit(f i1(ops.structNew closU(g 3)))
            runtimeUnitCall(f "wasm/core.registerAdapter")
            emit(f i(ops.drop))
        end

    (* A closure of x.code with its captures: its static closure if it has
     * none; inside a recursive value's body, a capture of a value not yet
     * bound is left to fill in (sLetRec) *)
    let makeClosure(f: F x: ir.OpMakeClosure): Ok =
        begin
            let fn = x.code
            if fn.unboxedResult andif {extent x.captures is 0} andif {extent x.descriptors is 0} then
                (* only ever called directly (ir/unbox), never through it, and
                 * with nothing to carry; one that captures needs its closure
                 * for its captures, as a direct call reads them from it *)
                emit(f i1(ops.globalGet f.g.noClosure))
            elsif {extent x.captures is 0} andif {extent x.descriptors is 0} then
                emit(f i1(ops.globalGet staticClosure(f.g fn)))
            else
                let own = ownType(f.g fn)
                let u = uniformEntry(f.g fn)
                let native = if fn.unboxedResult then trapNative(f.g fn)
                    else hashMap.find(f.g.functions fn.id) end
                declare(f.g u)
                declare(f.g native)
                emit(f model.i32Const(0))
                emit(f i1(ops.refFunc u))
                emit(f i1(ops.refFunc native))
                (* the type arguments' descriptors it supplies *)
                for k = 0 upto extent x.descriptors - 1 do descriptor(f x.descriptors[k]) end
                let later = vector.new(:Patch)
                for k = 0 upto extent x.captures - 1 do
                    let a = x.captures[k]
                    let pending =
                        case a
                            when atomVar with v then hashSet.contains(f.deferred v.v.id)
                            else false
                        end
                    if pending then
                        (* a placeholder for each part, its field set once
                         * the value is bound (f.patches, filled by sLetRec) *)
                        let ps = parts(ir.atomType(a))
                        for j = 0 upto extent ps - 1 do
                            case ps[j]
                                when valI64 then emit(f model.i64Const(0))
                                when valI32 then emit(f model.i32Const(0))
                                when valF64 then emit(f model.f64Const(0.0))
                                else
                                    emit(f option instRefNull of Inst with
                                        let heap = option heapNone of model.HeapType end
                                    end)
                            end
                        end
                        vector.append(later tuple
                            let holder = 0
                            let own = own
                            let field = captureField(f.g fn k)
                            let parts = ps
                            let atom = a
                        end)
                    else
                        atom(f a)
                    end
                end
                emit(f i1(ops.structNew own))
                if not(vector.empty(later)) then
                    let holder = scratch(f model.eqref)
                    emit(f i1(ops.localTee holder))
                    for k = 0 upto vector.length(later) - 1 do
                        let pt = vector.get(later k)
                        vector.append(f.patches
                                tuple
                                    let holder = holder
                                    let own = pt.own
                                    let field = pt.field
                                    let parts = pt.parts
                                    let atom = pt.atom
                                end)
                    end
                end
            end
        end

    (* An intrinsic (section 4.5): an external named wasm.NAME, which an
     * unsound module the backend compiles, the runtime's core above all,
     * declares at the types it uses it at; compiled in place, its value
     * that of its function's result type, target's *)
    let intrinsic(f: F x: ir.OpCallExternal target: maybe.T(ir.Variable)): Ok =
        begin
            let name = x.symbol
            let args = x.args
            let named = fun(n: String): Bool stringOp.equal(name "wasm." <> n)
            let indexArg = fun(): Ok
                begin
                    atom(f args[1])
                    emit(f i(ops.i32WrapI64))
                end
            let okValue = fun(): Ok
                begin
                    emit(f model.i32Const(0))
                    emit(f i(ops.refI31))
                end
            let tRecBox = rt.index("recBox")
            let tException = rt.index("exception")
            if strutil.startsWith(name "wasm.base.") then
                (* a function of the base's, by its export's name; Ok when it
                 * gives nothing *)
                let field = stringOp.getSub(name 10 {stringOp.length(name) - 10})
                atoms(f args)
                runtimeCall(f field)
                let var results = 1
                for k = 0 upto extent runtime.exports - 1 do
                    if stringOp.equal(runtime.exports[k].field field) then
                        results := extent runtime.exports[k].results
                    end
                end
                if results is 0 then okValue() end
            elsif strutil.startsWith(name "wasm.host.") then
                (* the host's function, its Ints as i32s *)
                for k = 0 upto extent args - 1 do
                    atom(f args[k])
                    emit(f i(ops.i32WrapI64))
                end
                runtimeUnitCall(f "quest.host." <> stringOp.getSub(name 10 {stringOp.length(name) - 10}))
                emit(f i(ops.i64ExtendI32S))
            elsif named("print.capture") orif named("print.captured") then
                emit(f i1(ops.globalGet f.g.noClosure))
                runtimeUnitCall(f "wasm/print." <> stringOp.getSub(name 11 {stringOp.length(name) - 11}))
            elsif named("raisedName") then
                (* a raised exception's text, as the uncaught report writes
                 * it: its name, and its payload, by its descriptor if it has
                 * one (print's show), with its type *)
                let tRaised = rt.index("raised")
                let state = scratch(f model.eqref)
                atom(f args[0])
                emit(f i1(ops.localTee state))
                emit(f i1(ops.localGet state))
                castTo(f tRaised)
                emit(f i2(ops.structGet tRaised rt.field("raised" "desc")))
                emit(f i(ops.refIsNull))
                emit(f model.ifInst(option blockValue of model.BlockType with let type = model.eqref end ""))
                emit(f option instRefNull of Inst with let heap = option heapNone of model.HeapType end end)
                emit(f model.elseInst)
                emit(f i1(ops.globalGet f.g.noClosure))
                emit(f i1(ops.localGet state))
                castTo(f tRaised)
                emit(f i2(ops.structGet tRaised rt.field("raised" "payload")))
                emit(f i1(ops.localGet state))
                castTo(f tRaised)
                emit(f i2(ops.structGet tRaised rt.field("raised" "desc")))
                runtimeUnitCall(f "wasm/print.show")
                emit(f model.endInst)
                runtimeCall(f "raisedText")
            elsif named("raisedSite") then
                (* a raise's site, "" if none *)
                let tRaised = rt.index("raised")
                atom(f args[0])
                castTo(f tRaised)
                emit(f i2(ops.structGet tRaised rt.field("raised" "site")))
                let site = scratch(f model.eqref)
                emit(f i1(ops.localTee site))
                emit(f i(ops.refIsNull))
                emit(f model.ifInst(option blockValue of model.BlockType with let type = model.eqref end ""))
                literal(f "")
                emit(f model.elseInst)
                emit(f i1(ops.localGet site))
                emit(f model.endInst)
            elsif named("fatalReport") then
                (* the report of the fatal error the runtime kept while it held
                 * them (holdFatal), "" if none *)
                runtimeCall(f "fatalReport")
                let report = scratch(f model.eqref)
                emit(f i1(ops.localTee report))
                emit(f i(ops.refIsNull))
                emit(f model.ifInst(option blockValue of model.BlockType with let type = model.eqref end ""))
                literal(f "")
                emit(f model.elseInst)
                emit(f i1(ops.localGet report))
                emit(f model.endInst)
            elsif named("importedRecord") then
                (* the payload of the record of a unit this one imports, named
                 * by a constant *)
                let unitName =
                    case args[0]
                        when atomConst with c then
                            case c.c.value when constString with s then s.s else "" end
                        else ""
                    end
                if not(hashMap.contains(f.g.importRecords unitName)) then
                    fail("importedRecord of a unit not imported: " <> unitName)
                end
                emit(f i1(ops.globalGet hashMap.find(f.g.importRecords unitName)))
            elsif named("recordSet") then
                (* a record's field, by its index in name order, set *)
                let tRecord = rt.index("record")
                atom(f args[0])
                castTo(f tRecord)
                emit(f i2(ops.structGet tRecord rt.field("record" "slots")))
                indexArg()
                boxedAtom(f args[2])
                emit(f i1(ops.arraySet tSlots))
                okValue()
            elsif named("toAny") then
                boxedAtom(f args[0])
            elsif named("fromAny") then
                atom(f args[0])
                if maybe.isSome(target) then
                    unboxFor(f maybe.unwrap(target).type target)
                end
            elsif named("same") then
                atoms(f args)
                emit(f i(ops.refEq))
            elsif named("tupleCount") orif named("arrayCount") then
                let isArray = named("arrayCount")
                atom(f args[0])
                castTo(f if isArray then tArray else tTuple end)
                emit(f i2(ops.structGet if isArray then tArray else tTuple end if isArray then fElems else fSlots end))
                emit(f i(ops.arrayLen))
                emit(f i(ops.i64ExtendI32U))
            elsif named("tupleSlot") orif named("arraySlot") then
                let isArray = named("arraySlot")
                atom(f args[0])
                castTo(f if isArray then tArray else tTuple end)
                emit(f i2(ops.structGet if isArray then tArray else tTuple end if isArray then fElems else fSlots end))
                indexArg()
                emit(f i1(ops.arrayGet tSlots))
            elsif named("recordField") then
                (* the payload's slot that the view's table gives field i *)
                let b = scratch(f model.refNull(tRecBox))
                atom(f args[0])
                castTo(f tRecBox)
                emit(f i1(ops.localTee b))
                emit(f i2(ops.structGet tRecBox 0))
                emit(f i2(ops.structGet tRecord rt.field("record" "slots")))
                emit(f i1(ops.localGet b))
                emit(f i2(ops.structGet tRecBox 1))
                emit(f i2(ops.structGet tDict 0))
                indexArg()
                emit(f i1(ops.arrayGet rt.index("i32s")))
                emit(f i1(ops.arrayGet tSlots))
            elsif named("optionTag") then
                atom(f args[0])
                castTo(f tOption)
                emit(f i2(ops.structGet tOption fTag))
                emit(f i(ops.i64ExtendI32U))
            elsif named("variantTag") then
                atom(f args[0])
                castTo(f tVarBox)
                emit(f i2(ops.structGet tVarBox 0))
                emit(f i(ops.i64ExtendI32U))
            elsif named("variantPayload") then
                atom(f args[0])
                castTo(f tVarBox)
                emit(f i2(ops.structGet tVarBox 1))
            elsif named("exceptionName") then
                atom(f args[0])
                castTo(f tException)
                emit(f i2(ops.structGet tException rt.field("exception" "name")))
            elsif named("decimal") then
                atoms(f args)
                runtimeCall(f "decimal")
            elsif named("hex") then
                atoms(f args)
                runtimeCall(f "hex")
            elsif named("escaped") then
                atoms(f args)
                runtimeCall(f "escaped")
            elsif named("charString") then
                atoms(f args)
                runtimeCall(f "convChar")
            elsif named("put") then
                emit(f model.i32Const(1))
                emit(f i(ops.refI31))
                atoms(f args)
                runtimeCall(f "putString")
            elsif named("putTo") orif named("putCharTo") then
                (* to a standard stream's writer, the i31 of its file
                 * descriptor *)
                atoms(f args)
                runtimeCall(f if named("putTo") then "putString" else "putChar" end)
            elsif named("convInt") then
                atoms(f args)
                runtimeCall(f "convInt")
            elsif named("realBits") then
                atoms(f args)
                emit(f i(ops.i64ReinterpretF64))
            elsif named("signBit") then
                atoms(f args)
                emit(f i(ops.i64ReinterpretF64))
                emit(f model.i64Const(0))
                emit(f i(ops.i64LtS))
            elsif named("charCode") then
                atoms(f args)
                emit(f i(ops.i64ExtendI32U))
            elsif named("shrU") then
                atoms(f args)
                emit(f i(ops.i64ShrU))
            elsif named("xor") then
                atoms(f args)
                emit(f i(ops.i64Xor))
            elsif named("hashMix") then
                atoms(f args)
                hashMix(f)
            elsif named("isSmall") orif named("isBoxedInt") orif named("isRecBox") orif named("isObject") then
                atom(f args[0])
                let heap = if named("isSmall") then option heapI31 of model.HeapType end
                    else heapOf(rt.index(if named("isBoxedInt") then "boxInt"
                        elsif named("isRecBox") then "recBox"
                        else "obj" end))
                    end
                emit(f option instRefTest of Inst with let type = tuple let nullable = false let heap = heap end end)
            elsif named("smallValue") then
                atom(f args[0])
                castI31(f)
                emit(f i(ops.i31GetS))
                emit(f i(ops.i64ExtendI32S))
            elsif named("boxedInt") then
                atom(f args[0])
                castTo(f rt.index("boxInt"))
                emit(f i2(ops.structGet rt.index("boxInt") 0))
            elsif named("recPayload") then
                atom(f args[0])
                castTo(f tRecBox)
                emit(f i2(ops.structGet tRecBox 0))
            elsif named("recDict") then
                atom(f args[0])
                castTo(f tRecBox)
                emit(f i2(ops.structGet tRecBox 1))
            elsif named("newRecBox") then
                atom(f args[0])
                castTo(f tRecord)
                atom(f args[1])
                castTo(f tDict)
                emit(f i1(ops.structNew tRecBox))
            elsif named("recordLayout") then
                atom(f args[0])
                castTo(f tRecord)
                emit(f i2(ops.structGet tRecord rt.field("record" "layout")))
            elsif named("newVarBox") then
                atom(f args[0])
                emit(f i(ops.i32WrapI64))
                atom(f args[1])
                emit(f i1(ops.structNew tVarBox))
            elsif named("isNull") then
                atom(f args[0])
                emit(f i(ops.refIsNull))
            elsif named("nullAny") then
                emit(f option instRefNull of Inst with let heap = option heapNone of model.HeapType end end)
            elsif named("newI32s") then
                atom(f args[0])
                emit(f i(ops.i32WrapI64))
                emit(f i1(ops.arrayNewDefault rt.index("i32s")))
            elsif named("setI32") then
                atom(f args[0])
                castTo(f rt.index("i32s"))
                atom(f args[1])
                emit(f i(ops.i32WrapI64))
                atom(f args[2])
                emit(f i(ops.i32WrapI64))
                emit(f i1(ops.arraySet rt.index("i32s")))
                okValue()
            elsif named("newDict") then
                atom(f args[0])
                castTo(f rt.index("i32s"))
                atom(f args[1])
                emit(f i1(ops.structNew tDict))
            elsif named("dictIndex") then
                atom(f args[0])
                castTo(f tDict)
                emit(f i2(ops.structGet tDict 0))
                atom(f args[1])
                emit(f i(ops.i32WrapI64))
                emit(f i1(ops.arrayGet rt.index("i32s")))
                emit(f i(ops.i64ExtendI32U))
            elsif named("recordSlot") then
                atom(f args[0])
                castTo(f tRecord)
                emit(f i2(ops.structGet tRecord rt.field("record" "slots")))
                atom(f args[1])
                emit(f i(ops.i32WrapI64))
                emit(f i1(ops.arrayGet tSlots))
            elsif named("isProxy") then
                atom(f args[0])
                emit(f option instRefTest of Inst with
                    let type = tuple
                        let nullable = false
                        let heap = heapOf(rt.index("proxy"))
                    end
                end)
            elsif named("newProxy") then
                emit(f model.i32Const(0))
                atom(f args[0])
                emit(f i1(ops.structNew rt.index("proxy")))
            elsif named("proxyState") then
                atom(f args[0])
                castTo(f rt.index("proxy"))
                emit(f i2(ops.structGet rt.index("proxy") 1))
            elsif named("newTuple") then
                emit(f model.i32Const(0))
                atom(f args[0])
                castTo(f tArray)
                emit(f i2(ops.structGet tArray fElems))
                emit(f i1(ops.structNew tTuple))
            elsif named("newOption") then
                emit(f model.i32Const(0))
                atom(f args[1])
                castTo(f tArray)
                emit(f i2(ops.structGet tArray fElems))
                atom(f args[0])
                emit(f i(ops.i32WrapI64))
                emit(f i1(ops.structNew tOption))
            elsif named("autoDesc") orif named("autoPayload") then
                atom(f args[0])
                castTo(f rt.index("auto"))
                emit(f i2(ops.structGet rt.index("auto") if named("autoDesc") then 1 else 2 end))
            elsif named("newAuto") then
                emit(f model.i32Const(0))
                atoms(f args)
                emit(f i1(ops.structNew rt.index("auto")))
            elsif named("adaptClosure") then
                atoms(f args)
                emit(f i1(ops.call adapters(f.g)))
            elsif named("addWrap") orif named("mulWrap") then
                atoms(f args)
                emit(f i(if named("addWrap") then ops.i64Add else ops.i64Mul end))
            elsif named("newRecordPayload") then
                (* a record's payload, its layout's descriptor and its slots *)
                emit(f model.i32Const(0))
                atom(f args[0])
                atom(f args[1])
                castTo(f tArray)
                emit(f i2(ops.structGet tArray fElems))
                emit(f i1(ops.structNew tRecord))
            elsif named("realEq") then
                atoms(f args)
                emit(f i(ops.f64Eq))
            elsif named("isBoxedReal") then
                atom(f args[0])
                emit(f option instRefTest of Inst with
                    let type = tuple
                        let nullable = false
                        let heap = heapOf(rt.index("boxReal"))
                    end
                end)
            elsif named("dictStored") then
                atom(f args[0])
                castTo(f tDict)
                emit(f i2(ops.structGet tDict 1))
            elsif named("dynamicError") then
                raiseAt(f "dynamic.error" maybe.none())
            elsif named("hashOf") then
                atom(f args[0])
                castTo(f rt.index("obj"))
                emit(f i2(ops.structGet rt.index("obj") 0))
                emit(f i(ops.i64ExtendI32U))
            elsif named("setHash") then
                atom(f args[0])
                castTo(f rt.index("obj"))
                atom(f args[1])
                emit(f i(ops.i32WrapI64))
                emit(f i2(ops.structSet rt.index("obj") 0))
                okValue()
            else
                fail("the external " <> name <> ", which is no intrinsic")
            end
            ok
        end

    (* The operation's value, on the stack *)
    let operation(f: F o: ir.Op target: maybe.T(ir.Variable)): Ok =
        begin
            let targetType = fun(): ir.Type
                if maybe.isSome(target) then maybe.unwrap(target).type
                else raise unsupported with "an aggregate made and not bound" end
                end
            case o
                when opAtom with x then
                    atom(f x.atom)
                    (* a record or variant copied between a variable that holds it
                     * boxed (a var parameter's, whose slot holds it so) and one
                     * that does not *)
                    if maybe.isSome(target) then
                        let v = maybe.unwrap(target)
                        let boxedHere = isBoxedVar(x.atom)
                        if {isRecord(v.type) orif isVariant(v.type)} andif {boxedHere isnot v.boxed} then
                            if boxedHere then unbox(f v.type) else box(f v.type) end
                        end
                    end
                when opPrim with x then prim(f x)
                when opCall with x then call(f x)
                when opModuleMember with x then member(f x target)
                when opMakeClosure with x then makeClosure(f x)
                when opEnvField with x then
                    (* capture x.index, from the fields of the function's own
                     * closure type that hold its parts *)
                    let fn = hashMap.find(f.g.byId f.fnId)
                    let own = ownType(f.g fn)
                    let at = captureField(f.g fn x.index)
                    let captures = hashMap.find(f.g.captureTypes fn.id)
                    for j = 0 upto extent parts(captures[x.index]) - 1 do
                        atom(f x.env)
                        castTo(f own)
                        emit(f i2(ops.structGet own at + j))
                    end
                when opMakeTuple with x then
                    if maybe.isSome(target) andif maybe.unwrap(target).unboxed then
                        atoms(f x.args)
                    else
                        newTuple(f x.args)
                    end
                when opTupleField with x then tupleField(f x target)
                when opMakeOption with x then makeOption(f x targetType())
                when opIsTag with x then
                    if maybe.isSome(x.viewMap) then
                        viewTag(f x.value x.viewMap)
                        emit(f model.i32Const(tagIndex(shapeOf(ir.atomType(x.value)) x.tag)))
                    elsif isVariantShape(ir.atomType(x.value)) then
                        variantAtom(f x.value)
                        emit(f i(ops.drop))
                        emit(f model.i32Const(tagIndex(shapeOf(ir.atomType(x.value)) x.tag)))
                    else
                        let s = optionShape(ir.atomType(x.value))
                        tagOf(f x.value x.access)
                        emit(f model.i32Const(tagIndex(s x.tag)))
                    end
                    emit(f i(ops.i32Eq))
                when opPayload with x then
                    if isVariantShape(ir.atomType(x.value)) then variantPayload(f x targetType() target)
                    else payload(f x targetType())
                    end
                when opOrdinal with x then
                    let s = optionShape(ir.atomType(x.value))
                    if maybe.isSome(x.viewMap) then viewTag(f x.value x.viewMap)
                    else tagOf(f x.value x.access)
                    end
                    (* The tag numbers the shape's cases, by name; the ordinal
                     * counts the static type's, as written *)
                    let ordinals = array of(extent s.cases 0)
                    for k = 0 upto extent s.cases - 1 do
                        let name = maybe.unwrapOr(s.cases[k].name "")
                        for j = 0 upto extent x.cases - 1 do
                            if stringOp.equal(x.cases[j] name) then ordinals[k] := j end
                        end
                    end
                    mapI32(f ordinals)
                    emit(f i(ops.i64ExtendI32U))
                when opMakeArray with x then makeArray(f x.args targetType())
                when opArrayRep with x then arrayRep(f x targetType())
                when opIndex with x then index(f x target)
                when opMakeRecord with x then makeRecord(f x target)
                when opRecordField with x then recordField(f x target)
                when opConvert with x then convert(f x target)
                when opTypeApp with x then typeApp(f x target)
                when opBuiltin with x then emit(f i1(ops.globalGet builtinClosure(f.g x.name)))
                when opCallExternal with x then
                    if strutil.startsWith(x.symbol "wasm.") then intrinsic(f x target)
                    else externalCall(f x.symbol x.args x.descriptors target)
                    end
                when opExternal with x then externalValue(f x.symbol)
                when opMakeException with x then
                    emit(f model.i32Const(0))
                    literal(f x.name)
                    emit(f i1(ops.structNew rt.index("exception")))
                when opExceptionPayload with x then
                    atom(f x.exc)
                    runtimeCall(f "payloadOf")
                    if maybe.isSome(target) then unboxFor(f maybe.unwrap(target).type target) end
                (* the handler's state, a $raised, which raised.reraise throws *)
                when opCaughtException with x then atom(f x.exc)
                when opMakeVariant with x then
                    (* its tag, in its type's numbering, and its payload as a
                     * slot holds it; a case with none holds ok *)
                    emit(f model.i32Const(tagIndex(shapeOf(targetType()) x.tag)))
                    if maybe.isSome(x.payload) then
                        boxedAtom(f maybe.unwrap(x.payload))
                    else
                        emit(f model.i32Const(0))
                        emit(f i(ops.refI31))
                    end
                    if maybe.unwrap(target).boxed then box(f targetType()) end
                when opMakeAuto with x then
                    (* its witness's descriptor and its other components' tuple *)
                    if maybe.isNone(x.descriptor) then fail("an auto value without its witness") end
                    emit(f model.i32Const(0))
                    descriptor(f maybe.unwrap(x.descriptor))
                    boxedAtom(f x.payload)
                    emit(f i1(ops.structNew rt.index("auto")))
                (* Locations (section 2.6): a slot array and an index *)
                when opAddrVar with x then
                    if not(isLocated(f x.v)) then fail("the address of " <> x.v.hint <> ", which is not located") end
                    getParts(f x.v)
                (* A cell declared without a value holds null until assigned
                 * (sVarDecl): its slot, read without unboxing *)
                when opIsSet with x then
                    if not(isLocated(f x.v)) then fail("is_set of " <> x.v.hint <> ", which is not located") end
                    getParts(f x.v)
                    emit(f i1(ops.arrayGet tSlots))
                    emit(f i(ops.refIsNull))
                    emit(f i(ops.i32Eqz))
                when opAddrCell with x then
                    boxedAtom(f x.init)
                    emit(f i2(ops.arrayNewFixed tSlots 1))
                    emit(f model.i32Const(0))
                when opAddrField with x then
                    if maybe.isSome(x.viewMap) then viewFieldSlot(f x.base x.name x.viewMap)
                    else fieldSlot(f x.base x.name)
                    end
                when opAddrComponent with x then
                    atom(f x.base)
                    accessAs(f tTuple viewedSlot(x.access x.viewMap))
                    emit(f i2(ops.structGet tTuple fSlots))
                    emit(f model.i32Const(x.index))
                when opAddrElement with x then
                    checkIndex(f x.base x.index x.offset)
                    elements(f x.base x.index)
                when opLoad with x then
                    atom(f x.address)
                    emit(f i1(ops.arrayGet tSlots))
                    unboxFor(f shapes.element(shapeOf(ir.atomType(x.address))).type target)
            end
        end

    (* Writes text to standard output, through the runtime *)
    let output(f: F text: All() Ok): Ok =
        if f.g.isPhrase then
            emit(f i1(ops.globalGet f.g.noClosure))
            text()
            runtimeUnitCall(f "wasm/print.echoText")
            emit(f i(ops.drop))
        else
            emit(f model.i32Const(1))
            emit(f i(ops.refI31))
            text()
            runtimeCall(f "putString")
            emit(f i(ops.drop))
        end

    (* A phrase's value as the driver's echo writes it (quest_print_value):
     * after prefix, and for an expression with its type; by its type's kind,
     * a base type's or a function's or an abstract type's, whose values need
     * no descriptor to be written *)
    let echo(f: F x: ir.StmtEcho): Ok =
        begin
            let kind = describe.echoValueKind(x.type)
            let suffix = if stringOp.isEmpty(x.prefix) then " : " <> genericLayout.qtypeToNameStr(x.type) else "" end
            if stringOp.isEmpty(kind) andif maybe.isSome(x.descriptor) then
                (* written by its descriptor, by print's echo *)
                emit(f i1(ops.globalGet f.g.noClosure))
                literal(f x.prefix)
                boxedAtom(f x.value)
                descriptor(f maybe.unwrap(x.descriptor))
                literal(f suffix)
                runtimeUnitCall(f "wasm/print.echo")
                emit(f i(ops.drop))
            else
                let kindIs = fun(k: String): Bool stringOp.equal(kind k)
                let quoted = fun(quote: Char): Ok
                    begin
                        emit(f model.i32Const(ascii.val(quote)))
                        runtimeCall(f "escaped")
                        runtimeCall(f "concat")
                        literal(f stringOp.new(1 quote))
                        runtimeCall(f "concat")
                    end
                let value = fun(): Ok
                    begin
                        literal(f x.prefix)
                        if kindIs("Int") then
                            atom(f x.value)
                            runtimeCall(f "decimal")
                        elsif kindIs("Bool") then
                            atom(f x.value)
                            runtimeCall(f "convBool")
                        elsif kindIs("Char") then
                            literal(f "'")
                            atom(f x.value)
                            runtimeCall(f "convChar")
                            quoted('\'')
                        elsif kindIs("String") then
                            literal(f "\"")
                            atom(f x.value)
                            quoted('"')
                        elsif kindIs("Ok") then
                            literal(f "ok")
                        elsif kindIs("Real") then
                            realText(f x.value)
                        elsif kindIs("Word") orif kindIs("Word.T") orif kindIs("word.T") then
                            literal(f "16#")
                            atom(f x.value)
                            runtimeCall(f "hex")
                            runtimeCall(f "concat")
                            literal(f "#")
                            runtimeCall(f "concat")
                        elsif kindIs("fun") then
                            literal(f "<fun>")
                        elsif kindIs("hidden") then
                            literal(f "<hidden>")
                        elsif stringOp.isEmpty(kind) then
                            fail("echo of a value its descriptor writes, without one")
                        else
                            literal(f "<val>")
                        end
                        runtimeCall(f "concat")
                        literal(f suffix <> "\n")
                        runtimeCall(f "concat")
                    end
                output(f value)
            end
        end

    (* ======================================================================
     * Statements
     * ====================================================================== *)

    (* Whether the atom is the variable v *)
    let isVar(a: ir.Atom v: ir.Variable): Bool = case a when atomVar with x then x.v.id is v.id else false end

    (* Whether a join point's continuation only returns its one parameter,
     * or passes it to one that does: a jump to it then returns what it
     * passes *)
    let returnsParam(f: F s: ir.StmtJoin): Bool =
        if {extent s.params} isnot 1 then
            false
        else
            let ss = s.continuation.statements
            if vector.length(ss) isnot 1 then
                false
            else
                case vector.get(ss 0)
                    when sReturn with r then isVar(r.value s.params[0])
                    when sJump with j then
                        {extent j.args is 1} andif isVar(j.args[0] s.params[0])
                            andif maybe.unwrapOr(hashMap.get(f.returning j.label) false)
                    else false
                end
            end
        end

    (* Whether statement next, after a call bound to v (or done, v none),
     * returns its result: a return of it (of ok, for a call done), or a jump
     * that passes it to a join point that returns it *)
    let returnsResult(f: F v: maybe.T(ir.Variable) next: ir.Stmt): Bool =
        case next
            when sReturn with r then
                if maybe.isSome(v) then isVar(r.value maybe.unwrap(v))
                else case r.value when atomConst with c then c.c.value?constOk else false end
                end
            when sJump with j then
                maybe.isSome(v) andif {extent j.args is 1}
                    andif isVar(j.args[0] maybe.unwrap(v))
                    andif maybe.unwrapOr(hashMap.get(f.returning j.label) false)
            else false
        end

    (* The call a statement makes, and the variable it binds (none for do), if
     * it is a direct call *)
    Def Found = Tuple call: ir.OpCall v: maybe.T(ir.Variable) end
    let callIn(f: F s: ir.Stmt): maybe.T(Found) =
        begin
            case s
                when sLet with x then
                    case x.value
                        when opCall with c then
                            if isGlobal(f x.v) then maybe.none()
                            else maybe.some(tuple let call = c let v = maybe.some(x.v) end)
                            end
                        else maybe.none()
                    end
                when sDo with x then
                    case x.value
                        when opCall with c then
                            maybe.some(tuple let call = c let v = maybe.none(:ir.Variable) end)
                        else maybe.none()
                    end
                else maybe.none()
            end
        end

    (* Whether the code is inside a try's body, which a tail call would
     * leave, and with it the handler *)
    let insideTry(f: F): Bool =
        begin
            let var inside = false
            for k = 0 upto vector.length(f.labels) - 1 do
                if vector.get(f.labels k).kind?labelTry then inside := true end
            end
            inside
        end

    (* The index of the function being compiled, ~1 for the top level *)
    let selfIndex(f: F): Int = if f.fnId < 0 then ~1 else maybe.unwrapOr(hashMap.get(f.g.functions f.fnId) ~1) end
    (* If s binds a direct call of the function itself: its variable and the
     * call *)
    let isSelfCall(f: F s: ir.Stmt): maybe.T(Tuple v: ir.Variable call: ir.OpCall end) =
        case s
            when sLet with x then
                case x.value
                    when opCall with c then
                        let d = directCallee(f c)
                        if maybe.isSome(d) andif {maybe.unwrap(d) is selfIndex(f)} andif {selfIndex(f) >= 0} then
                            maybe.some(tuple let v = x.v let call = c end)
                        else
                            maybe.none()
                        end
                    else maybe.none()
                end
            else maybe.none()
        end
    (* Whether s combines v with another value by op (1 for +, 2 for times,
     * 0 for either): that value, and the variable s binds *)
    let combining(s: ir.Stmt v: ir.Variable op: Int): maybe.T(Tuple other: ir.Atom result: ir.Variable end) =
        case s
            when sLet with x then
                case x.value
                    when opPrim with p then
                        let thisOp = if p.op?primAdd then 1 elsif p.op?primMul then 2 else 0 end
                        if {thisOp is 0} orif {{op > 0} andif {thisOp isnot op}} orif {extent p.args isnot 2} then
                            maybe.none()
                        elsif isVar(p.args[0] v) andif not(isVar(p.args[1] v)) then
                            maybe.some(tuple let other = p.args[1] let result = x.v end)
                        elsif isVar(p.args[1] v) andif not(isVar(p.args[0] v)) then
                            maybe.some(tuple let other = p.args[0] let result = x.v end)
                        else
                            maybe.none()
                        end
                    else maybe.none()
                end
            else maybe.none()
        end
    (* Detects accumulating recursion (matching the SSA accumulate pass,
     * section 3.3). When an Int-returning function returns a recursive call to
     * itself added to or multiplied by another value, the function compiles
     * as a loop with an accumulator initialized to the operation's identity:
     * each recursive site folds the other operand into the accumulator and
     * branches back to the loop header, and every other return combines its
     * value with the accumulator. Tail calls to other functions are disabled
     * because they would bypass the accumulator, and functions containing try
     * are excluded because a handler could observe partial accumulation.
     * Returns 1 for addition, 2 for multiplication, or 0 for none. *)
    let accumulation(f: F fn: ir.Function): Int =
        if {extent f.results isnot 1} orif not(f.results[0]?valI64) orif fn.unboxedResult then
            0
        else
            let ss = walk.walkStatements(fn.body true)
            let var op = 0
            let var tried = false
            for k = 0 upto vector.length(ss) - 1 do
                case vector.get(ss k) when sTry then tried := true else ok end
                if {op is 0} andif {{k + 1} < vector.length(ss)} then
                    let call = isSelfCall(f vector.get(ss k))
                    if maybe.isSome(call) then
                        let v = maybe.unwrap(call).v
                        let next = vector.get(ss k + 1)
                        for candidate = 1 upto 2 do
                            if {op is 0} andif maybe.isSome(combining(next v candidate)) then op := candidate end
                        end
                    end
                end
            end
            if tried then 0 else op end
        end
    let combine(f: F): Ok = emit(f i(if f.accOp is 1 then ops.i64Add else ops.i64Mul end))
    (* If ss[k] starts an accumulating self-call site (self-call, combine with
     * f.accOp, and return of the combined result), emits the accumulator
     * update and back-branch to the function loop. Returns the number of
     * statements consumed from ss (2 or 3), or 0 if not a site. *)
    let accumulateSite(f: F ss: Array(ir.Stmt) k: Int after: maybe.T(ir.Stmt)): Int =
        if {f.accOp is 0} orif {{k + 1} >= extent ss} then
            0
        else
            let call = isSelfCall(f ss[k])
            if maybe.isNone(call) then
                0
            else
                let site = maybe.unwrap(call)
                let c = combining(ss[k + 1] site.v f.accOp)
                let next = if {k + 2} < extent ss then maybe.some(ss[k + 2]) else after end
                if maybe.isNone(c) orif maybe.isNone(next)
                        orif not(returnsResult(f
                                maybe.some(maybe.unwrap(c).result)
                                maybe.unwrap(next))) then
                    0
                else
                    emit(f i1(ops.localGet f.accLocal))
                    atomAs(f maybe.unwrap(c).other false)
                    combine(f)
                    emit(f i1(ops.localSet f.accLocal))
                    closureArg(f site.call)
                    atoms(f site.call.args)
                    for j = 0 upto f.nparams - 1 do emit(f i1(ops.localSet {f.nparams - 1} - j)) end
                    emit(f i1(ops.br depth(f selfLabel option labelRepeat of LabelKind end)))
                    f.selfTail := true
                    if {k + 2} < extent ss then 3 else 2 end
                end
            end
        end

    (* Compiles s and next as a tail call when s's call result is returned by
     * next, the callee's result types match the current function's, and code
     * is not inside a try (in an accumulating recursion, only self-calls
     * qualify). Self-calls branch to the function's loop (selfLabel), other
     * direct calls emit return_call, and closure calls emit return_call_ref
     * (or call_ref + unbox + return when the uniform entry must be unboxed).
     * Returns true if a tail call was emitted. *)
    let tailCall(f: F s: ir.Stmt next: ir.Stmt): Bool =
        begin
            let found = callIn(f s)
            if maybe.isNone(found) orif insideTry(f) then false
            elsif {f.accOp > 0} andif maybe.isNone(isSelfCall(f s)) then
                (* in an accumulating recursion, which combines what it
                 * returns, only itself *)
                false
            else
                let c = maybe.unwrap(found).call
                let direct = directCallee(f c)
                if maybe.isNone(direct) then
                    if maybe.isSome(c.callee) andif returnsResult(f maybe.unwrap(found).v next)
                            andif sameTypes(closureSig(maybe.unwrap(c.callee).type).results f.results) then
                        closureCall(f c true)
                        true
                    else
                        false
                    end
                else
                    let d = maybe.unwrap(direct)
                    let callee = model.typeAt(f.g.m model.functionType(f.g.m d))
                    let results = case callee.composite when compFunc with t then t.results else noTypes end
                    if returnsResult(f maybe.unwrap(found).v next) andif sameTypes(results f.results) then
                        closureArg(f c)
                        atoms(f c.args)
                        if {f.fnId >= 0} andif hasLabel(f selfLabel)
                                andif {maybe.unwrapOr(hashMap.get(f.g.functions f.fnId) ~1) is d} then
                            (* itself: its parameters set, last first, and a
                             * branch to the loop around its code *)
                            for k = 0 upto f.nparams - 1 do emit(f i1(ops.localSet {f.nparams - 1} - k)) end
                            emit(f i1(ops.br depth(f selfLabel option labelRepeat of LabelKind end)))
                            f.selfTail := true
                        else
                            emit(f i1(ops.returnCall d))
                        end
                        true
                    else
                        false
                    end
                end
            end
        end

    (* How many values an operation done for its effect leaves: a direct
     * call's results, else one *)
    let resultCount(f: F o: ir.Op): Int =
        case o
            when opCall with x then
                let direct = directCallee(f x)
                if maybe.isSome(direct) then
                    case model.typeAt(f.g.m model.functionType(f.g.m maybe.unwrap(direct))).composite
                        when compFunc with t then extent t.results
                        else 1
                    end
                else
                    1
                end
            else 1
        end

    (* The variable s binds and the operands, when it binds a <> *)
    let concatOf(s: ir.Stmt): maybe.T(Tuple v: ir.Variable args: Array(ir.Atom) end) =
        case s
            when sLet with x then
                case x.value
                    when opPrim with p then
                        if p.op?primConcat andif {extent p.args is 2} then
                            maybe.some(tuple let v = x.v let args = p.args end)
                        else
                            maybe.none()
                        end
                    else maybe.none()
                end
            else maybe.none()
        end
    (* Folds a chain of adjacent <> concatenations starting at ss[k] into
     * calls to the runtime's concatN (docs/ssa.md section 4.1, matching the
     * native SSA concats pass). Each intermediate result must be used only by
     * the next concatenation; adjacency guarantees no side effects intervene.
     * Parts are joined seven at a time (carrying each batch's result into the
     * next) and stored in the final variable. Returns the number of
     * statements consumed, or 0 if ss[k] does not start a multi-step chain. *)
    let concatSite(f: F ss: Array(ir.Stmt) k: Int): Int =
        begin
            let first = concatOf(ss[k])
            if maybe.isNone(first) then
                0
            else
                let once = fun(v: ir.Variable): Bool
                    {maybe.unwrapOr(hashMap.get(f.g.uses v.id) 0) is 1} andif not(isLocated(f v))
                        andif not(hashSet.contains(f.g.pinned v.id))
                        andif not(hashSet.contains(f.g.globalIds v.id))
                let start = maybe.unwrap(first)
                let var parts = vector.fromArray(start.args)
                let var last = start.v
                let var j = k + 1
                let var going = true
                while going andif {j < extent ss} do
                    let c = concatOf(ss[j])
                    if maybe.isNone(c) orif not(once(last)) then
                        going := false
                    else
                        let next = maybe.unwrap(c)
                        if isVar(next.args[0] last) andif not(isVar(next.args[1] last)) then
                            vector.append(parts next.args[1])
                        elsif isVar(next.args[1] last) andif not(isVar(next.args[0] last)) then
                            let joined = vector.new(:ir.Atom)
                            vector.append(joined next.args[0])
                            for p = 0 upto vector.length(parts) - 1 do
                                vector.append(joined vector.get(parts p))
                            end
                            parts := joined
                        else
                            going := false
                        end
                        if going then
                            last := next.v
                            j := j + 1
                        end
                    end
                end
                if j is k + 1 then
                    0
                else
                    let n = vector.length(parts)
                    let var at = 0
                    let var held = false
                    while at < n do
                        let room = if held then 6 else 7 end
                        let take = if {n - at} < room then n - at else room end
                        for p = at upto {at + take} - 1 do atom(f vector.get(parts p)) end
                        for p = take + {if held then 1 else 0 end} upto 6 do
                            emit(f option instRefNull of Inst with let heap = option heapEq of model.HeapType end end)
                        end
                        runtimeCall(f "concatN")
                        at := at + take
                        held := true
                    end
                    store(f last)
                    j - k
                end
            end
        end

    (* The statements of b: an accumulation site, a chain of <>s joined
     * (concatSite), or a tail call where one starts, else each statement
     * with f.after set to the one after it (for the last, the statement
     * after b's) *)
    let rec body(f: F b: ir.Body): Ok =
        begin
            let ss = vector.toArray(b.statements)
            let outer = f.after
            let var k = 0
            while k < extent ss do
                let last = {k + 1} >= extent ss
                let next = if last then outer else maybe.some(ss[k + 1]) end
                let taken = accumulateSite(f ss k outer)
                let chained = if taken > 0 then 0 else concatSite(f ss k) end
                if taken > 0 then k := k + taken
                elsif chained > 0 then k := k + chained
                elsif maybe.isSome(next) andif tailCall(f ss[k] maybe.unwrap(next)) then
                    k := k + if last then 1 else 2 end
                else
                    f.after := next
                    statement(f ss[k])
                    f.after := outer
                    k := k + 1
                end
            end
        end

    and statement(f: F s: ir.Stmt): Ok =
        case s
            when sLet with x then
                operation(f x.value maybe.some(x.v))
                store(f x.v)
            when sDo with x then
                operation(f x.value maybe.none())
                for k = 1 upto resultCount(f x.value) do emit(f i(ops.drop)) end
            when sStoreComponent with x then
                atom(f x.base)
                accessAs(f tTuple viewedSlot(x.access x.viewMap))
                emit(f i2(ops.structGet tTuple fSlots))
                emit(f model.i32Const(x.index))
                boxedAtom(f x.value)
                emit(f i1(ops.arraySet tSlots))
            when sStoreElement with x then
                checkIndex(f x.base x.index x.offset)
                elements(f x.base x.index)
                boxedAtom(f x.value)
                emit(f i1(ops.arraySet tSlots))
            when sSwitch with x then switch(f x)
            when sVarDecl with x then
                if isLocated(f x.v) then
                    if maybe.isSome(x.init) then
                        atomFor(f maybe.unwrap(x.init) x.v)
                    else
                        (* no value until it is assigned: a slot that holds
                         * none, which its box would have been *)
                        emit(f option instRefNull of Inst with let heap = option heapNone of model.HeapType end end)
                        if not(x.v.boxed) then unbox(f x.v.type) end
                    end
                    declareLocated(f x.v)
                elsif maybe.isSome(x.init) then
                    atomFor(f maybe.unwrap(x.init) x.v)
                    store(f x.v)
                elsif not(isGlobal(f x.v)) then
                    local(f x.v)
                    ok
                end
            when sAssign with x then
                atomFor(f x.value x.v)
                store(f x.v)
            when sIf with x then
                atom(f x.cond)
                emit(f model.ifInst(empty ""))
                open(f "" option labelIf of LabelKind end)
                body(f x.thenBody)
                emit(f model.elseInst)
                body(f x.elseBody)
                close(f)
            when sLoop with x then
                emit(f model.blockInst(empty x.label <> ".exit"))
                open(f x.label option labelExit of LabelKind end)
                emit(f model.loopInst(empty x.label))
                open(f x.label option labelRepeat of LabelKind end)
                f.after := maybe.none()
                body(f x.body)
                if not(ir.terminated(x.body)) then emit(f i1(ops.br 0)) end
                close(f)
                close(f)
            when sBreak with x then emit(f i1(ops.br depth(f x.label option labelExit of LabelKind end)))
            when sContinue with x then emit(f i1(ops.br depth(f x.label option labelRepeat of LabelKind end)))
            when sJoin with x then
                hashMap.insert(f.returning x.label returnsParam(f x))
                hashMap.insert(f.joins x.label x.params)
                let joined = vector.new(:ValType)
                for k = 0 upto extent x.params - 1 do
                    let ps = varParts(f.g x.params[k])
                    for j = 0 upto extent ps - 1 do vector.append(joined ps[j]) end
                end
                let types = vector.toArray(joined)
                emit(f model.blockInst(empty x.label <> ".after"))
                open(f x.label option labelAfter of LabelKind end)
                emit(f model.blockInst(blockOf(f types) x.label))
                open(f x.label option labelJoin of LabelKind end)
                body(f x.body)
                if not(ir.terminated(x.body)) then
                    emit(f i1(ops.br depth(f x.label option labelAfter of LabelKind end)))
                end
                close(f)
                for k = extent x.params - 1 downto 0 do store(f x.params[k]) end
                body(f x.continuation)
                close(f)
            when sJump with x then
                let params = maybe.unwrap(hashMap.get(f.joins x.label))
                for k = 0 upto extent x.args - 1 do atomFor(f x.args[k] params[k]) end
                emit(f i1(ops.br depth(f x.label option labelJoin of LabelKind end)))
            when sReturn with x then
                if extent f.results > 0 then atomAs(f x.value false) end
                if f.accOp > 0 then
                    emit(f i1(ops.localGet f.accLocal))
                    combine(f)
                end
                emit(f i(ops.returnOp))
            when sUnreachable then emit(f i(ops.unreachable))
            when sRaise with x then
                atom(f x.exc)
                let var kind = 0
                if maybe.isSome(x.payload) then
                    let pl = maybe.unwrap(x.payload)
                    boxedAtom(f pl)
                    if not(stringOp.isEmpty(x.payloadText)) then kind := payloadKind(ir.atomType(pl)) end
                else
                    emit(f model.i32Const(0))
                    emit(f i(ops.refI31))
                end
                literal(f siteText(f x.offset))
                literal(f x.payloadText)
                emit(f model.i32Const(kind))
                (* a payload written by its descriptor, the report's *)
                if {kind is 9} andif maybe.isSome(x.descriptor) then
                    descriptor(f maybe.unwrap(x.descriptor))
                else
                    emit(f option instRefNull of Inst with let heap = option heapNone of model.HeapType end end)
                end
                runtimeCall(f "raise")
                emit(f i(ops.unreachable))
            when sReraise with x then
                (* the state again, with its site *)
                atom(f ir.atomOfVar(x.exc))
                emit(f i1(ops.throw 0))
            when sTry with x then
                (* A try_table that catches the one tag (section 2.9); its
                 * handler binds the state, tests it, and raises it again if
                 * nothing it names matches *)
                let base = "try" <> conv.int(vector.length(f.code))
                emit(f model.blockInst(empty ""))
                open(f base <> ".after" option labelIf of LabelKind end)
                emit(f model.blockInst(option blockValue of model.BlockType with let type = model.eqref end ""))
                open(f base <> ".handler" option labelIf of LabelKind end)
                emit(f option instTryTable of Inst with
                    let type = empty
                    let label = ""
                    let catches = array of
                        tuple let kind = option catchTag of model.CatchKind end let tag = 0 let label = 0 end
                    end
                end)
                open(f base <> ".body" option labelTry of LabelKind end)
                f.after := maybe.none()
                body(f x.body)
                if not(ir.terminated(x.body)) then
                    emit(f i1(ops.br depth(f base <> ".after" option labelIf of LabelKind end)))
                end
                close(f)
                emit(f i(ops.unreachable))
                close(f)
                store(f x.exc)
                f.after := maybe.none()
                body(f x.handler)
                close(f)
            when sEcho with x then echo(f x)
            when sEchoText with x then output(f fun(): Ok literal(f x.text <> "\n"))
            when sStoreAt with x then
                atom(f x.address)
                boxedAtom(f x.value)
                emit(f i1(ops.arraySet tSlots))
            when sStoreField with x then
                if maybe.isSome(x.viewMap) then viewFieldSlot(f x.base x.name x.viewMap)
                else fieldSlot(f x.base x.name)
                end
                boxedAtom(f x.value)
                emit(f i1(ops.arraySet tSlots))
            when sLetRec with x then
                (* The body makes the values, whose closures' captures of them
                 * are filled in once it has *)
                let first = vector.length(f.patches)
                for k = 0 upto extent x.vars - 1 do hashSet.insert(f.deferred x.vars[k].id) end
                f.after := maybe.none()
                body(f x.body)
                for k = 0 upto extent x.vars - 1 do hashSet.delete(f.deferred x.vars[k].id) end
                while vector.length(f.patches) > first do
                    let pt = vector.pop(f.patches)
                    let n = extent pt.parts
                    if n is 1 then
                        emit(f i1(ops.localGet pt.holder))
                        castTo(f pt.own)
                        atom(f pt.atom)
                        emit(f i2(ops.structSet pt.own pt.field))
                    else
                        (* each part from a local of its own, set in its
                         * field *)
                        let held = array of(n 0)
                        for j = 0 upto n - 1 do held[j] := scratch(f pt.parts[j]) end
                        atom(f pt.atom)
                        for j = 0 upto n - 1 do emit(f i1(ops.localSet held[{n - 1} - j])) end
                        for j = 0 upto n - 1 do
                            emit(f i1(ops.localGet pt.holder))
                            castTo(f pt.own)
                            emit(f i1(ops.localGet held[j]))
                            emit(f i2(ops.structSet pt.own pt.field + j))
                        end
                    end
                end
            when sFuns then fail("a function not closure-converted")
            when sInspect with x then inspectAuto(f x)
        end

    (* Compiles inspect, which tests an auto (existential) value's witness
     * type (docs/ir.md section 5). A case matches when wasm/core.isSubtype
     * holds from the witness to the case type (or both directions for an exact
     * case). Exact-case binders reuse the stored payload or convert it with
     * one plan; non-exact cases build a new tuple converting each component by
     * its descriptor pair. Raises dynamic.error if no case matches and there
     * is no else branch. *)
    and inspectAuto(f: F x: ir.StmtInspect): Ok =
        begin
            let value = scratch(f model.refNull(rt.index("auto")))
            let witness = scratch(f model.eqref)
            let stored = scratch(f model.eqref)
            atom(f x.value)
            castTo(f rt.index("auto"))
            emit(f i1(ops.localTee value))
            emit(f i2(ops.structGet rt.index("auto") 1))
            emit(f i1(ops.localSet witness))
            emit(f i1(ops.localGet value))
            emit(f i2(ops.structGet rt.index("auto") 2))
            emit(f i1(ops.localSet stored))
            if maybe.isSome(x.witness) then
                emit(f i1(ops.localGet witness))
                emit(f i1(ops.localSet local(f maybe.unwrap(x.witness).v)))
            end
            emit(f model.blockInst(empty ""))
            open(f "inspect.after" option labelIf of LabelKind end)
            for ci = 0 upto extent x.cases - 1 do
                let c = x.cases[ci]
                if maybe.isNone(c.descriptor) then fail("an inspect case without its descriptor") end
                let match = maybe.unwrap(c.descriptor)
                emit(f i1(ops.globalGet f.g.noClosure))
                emit(f i1(ops.localGet witness))
                descriptor(f match)
                runtimeUnitCall(f "wasm/core.isSubtype")
                if c.exact then
                    emit(f i1(ops.globalGet f.g.noClosure))
                    descriptor(f match)
                    emit(f i1(ops.localGet witness))
                    runtimeUnitCall(f "wasm/core.isSubtype")
                    emit(f i(ops.i32And))
                end
                emit(f model.ifInst(empty ""))
                open(f "" option labelIf of LabelKind end)
                if extent c.binders > 0 then
                    let arm = maybe.unwrap(c.arm)
                    if arm.exact then
                        emit(f i1(ops.localGet stored))
                        if not(arm.shared) andif maybe.isSome(arm.plan) then
                            slotConvert(f maybe.unwrap(arm.plan))
                        end
                    else
                        (* a new tuple of the components, each converted *)
                        let slots = scratch(f model.refNull(tSlots))
                        emit(f i1(ops.localGet stored))
                        castTo(f tTuple)
                        emit(f i2(ops.structGet tTuple fSlots))
                        emit(f i1(ops.localSet slots))
                        emit(f model.i32Const(0))
                        let n = extent arm.descriptors
                        for j = 0 upto n - 1 do
                            if maybe.isSome(arm.descriptors[j]) then
                                let pr = maybe.unwrap(arm.descriptors[j])
                                emit(f i1(ops.globalGet f.g.noClosure))
                                emit(f i1(ops.localGet slots))
                                emit(f model.i32Const(j))
                                emit(f i1(ops.arrayGet tSlots))
                                descriptor(f pr.source)
                                descriptor(f pr.target)
                                runtimeUnitCall(f "wasm/core.convert")
                            else
                                emit(f i1(ops.localGet slots))
                                emit(f model.i32Const(j))
                                emit(f i1(ops.arrayGet tSlots))
                            end
                        end
                        emit(f i2(ops.arrayNewFixed tSlots n))
                        emit(f i1(ops.structNew tTuple))
                    end
                    let a = scratch(f model.eqref)
                    emit(f i1(ops.localSet a))
                    for j = 0 upto extent c.binders - 1 do
                        emit(f i1(ops.localGet a))
                        if not(c.binders[j].boxed) then unbox(f c.binders[j].type) end
                        store(f c.binders[j])
                    end
                end
                body(f c.body)
                if not(ir.terminated(c.body)) then
                    emit(f i1(ops.br depth(f "inspect.after" option labelIf of LabelKind end)))
                end
                close(f)
            end
            if maybe.isSome(x.elseBody) then body(f maybe.unwrap(x.elseBody))
            else raiseAt(f "dynamic.error" x.offset)
            end
            close(f)
        end

    (* Compiles a switch on an option or variant tag as nested blocks (one per
     * case inside an else block and an after block) dispatched by br_table on
     * the tag (read through a view map or proxy when needed). An option case
     * binds either the option itself (sharing its slots) or its single
     * component; a variant case binds its payload. Raises variant.tagMismatch
     * if no case matches and there is no else branch. *)
    and switch(f: F x: ir.StmtSwitch): Ok =
        begin
            let viewed = maybe.isSome(x.viewMap)
            let isV = isVariantShape(ir.atomType(x.value))
            let s = if isV then shapeOf(ir.atomType(x.value)) else optionShape(ir.atomType(x.value)) end
            let opt = scratch(f model.refNull(tOption))
            (* a variant's tag and payload *)
            let vTag = if isV then scratch(f model.i32) else 0 end
            let vPayload = if isV then scratch(f model.eqref) else 0 end
            (* the value itself, which may be a proxy *)
            let raw = scratch(f model.eqref)
            let proxied = x.access?proxy andif not(isV) andif not(f.g.isRuntime)
            if isV then
                variantAtom(f x.value)
                emit(f i1(ops.localSet vPayload))
                emit(f i1(ops.localSet vTag))
            else
                atom(f x.value)
                if not(f.g.isRuntime) then emit(f i1(ops.localTee raw)) end
                accessAs(f tOption x.access)
                emit(f i1(ops.localSet opt))
            end
            let base = "switch" <> conv.int(vector.length(f.code))
            let m = extent x.cases
            emit(f model.blockInst(empty ""))
            open(f base <> ".after" option labelIf of LabelKind end)
            emit(f model.blockInst(empty ""))
            open(f base <> ".else" option labelIf of LabelKind end)
            for k = m - 1 downto 0 do
                emit(f model.blockInst(empty ""))
                open(f base <> "." <> conv.int(k) option labelIf of LabelKind end)
            end
            let targets = array of(extent s.cases m)
            for k = 0 upto m - 1 do
                for j = 0 upto extent x.cases[k].tags - 1 do targets[tagIndex(s x.cases[k].tags[j])] := k end
            end
            (* A decided switch's tag is its one case's, not read *)
            if x.decided then emit(f model.i32Const(tagIndex(s x.cases[0].tags[0])))
            elsif viewed then viewTag(f x.value x.viewMap)
            elsif isV then emit(f i1(ops.localGet vTag))
            elsif proxied then
                emit(f i1(ops.localGet raw))
                proxyAware(f tOption fTag ~1 "wasm/core.proxyTag")
            else
                emit(f i1(ops.localGet opt))
                emit(f i2(ops.structGet tOption fTag))
            end
            emit(f option instBrTable of Inst with let labels = targets let default = m end)
            for k = 0 upto m - 1 do
                close(f)
                let c = x.cases[k]
                if maybe.isSome(c.binder) then
                    let binder = maybe.unwrap(c.binder)
                    let b = tagIndex(s c.tags[0])
                    if isV then
                        (* the variant's payload, whatever its type *)
                        emit(f i1(ops.localGet vPayload))
                        if viewed then viewPartOnStack(f x.viewMap b) end
                        unboxFor(f binder.type maybe.some(binder))
                        store(f binder)
                    elsif viewed andif not(shapes.kindIs(shapes.shape(binder.type) shapes.shapeOk)) then
                        (* the case's payload through the map, itself, or a
                         * proxy of it where its components change view, so
                         * that its var components are shared; or its one
                         * component *)
                        if shapes.kindIs(shapes.shape(binder.type) shapes.shapeTuple) then
                            emit(f i1(ops.globalGet f.g.noClosure))
                            emit(f i1(ops.localGet if f.g.isRuntime then opt else raw end))
                            viewMapOf(f x.viewMap)
                            runtimeUnitCall(f "wasm/core.viewOptionPayload")
                        else
                            viewOptionComponent(f opt x.viewMap b 0)
                            if not(binder.boxed) then unbox(f binder.type) end
                        end
                        store(f binder)
                    elsif proxied andif anyProxy(c.components)
                            andif not(shapes.kindIs(shapes.shape(binder.type) shapes.shapeOk)) then
                        (* through a proxy, the original's payload seen at the
                         * case's type: a proxy of it, or its one component *)
                        if shapes.kindIs(shapes.shape(binder.type) shapes.shapeTuple) then
                            emit(f i1(ops.localGet raw))
                            emit(f option instRefTest of Inst with
                                let type = tuple
                                    let nullable = false
                                    let heap = heapOf(tOption)
                                end
                            end)
                            emit(f
                                    model.ifInst(option blockValue of model.BlockType with
                                        let type = model.eqref
                                    end ""))
                            emit(f i1(ops.localGet opt))
                            emit(f model.elseInst)
                            emit(f i1(ops.globalGet f.g.noClosure))
                            emit(f i1(ops.localGet raw))
                            runtimeUnitCall(f "wasm/core.proxyOptionPayload")
                            emit(f model.endInst)
                        else
                            emit(f i1(ops.localGet raw))
                            proxyAware(f tOption fSlots 0 "wasm/core.proxyOptionElement")
                            if not(binder.boxed) then unbox(f binder.type) end
                        end
                        store(f binder)
                    elsif not(shapes.kindIs(shapes.shape(binder.type) shapes.shapeOk)) then
                        emit(f i1(ops.localGet opt))
                        if not(shapes.kindIs(shapes.shape(binder.type) shapes.shapeTuple)) then
                            emit(f i2(ops.structGet tOption fSlots))
                            emit(f model.i32Const(0))
                            emit(f i1(ops.arrayGet tSlots))
                            if not(binder.boxed) then unbox(f binder.type) end
                        end
                        store(f binder)
                    end
                end
                body(f c.body)
                if not(ir.terminated(c.body)) then
                    emit(f i1(ops.br depth(f base <> ".after" option labelIf of LabelKind end)))
                end
            end
            close(f)
            if maybe.isSome(x.elseBody) then body(f maybe.unwrap(x.elseBody))
            else raiseAt(f "variant.tagMismatch" maybe.none())
            end
            close(f)
        end

    (* ======================================================================
     * Functions and the unit
     * ====================================================================== *)

    (* Fills in the function at index, which has no parameters *)
    let fill(f: F index: Int name: String type: Int): Ok =
        vector.set(f.g.m.functions {index - model.importedFunctions(f.g.m)} tuple
            let name = name
            let type = type
            let params = array of :String end
            let locals = f.declared
            let body = f.code
        end)

    (* Parameter k's parts: its variable's, or a location's where the
     * function's type gives the parameter a location's type (o: Out(Int)),
     * as its callers see it *)
    let paramParts(g: G fn: ir.Function k: Int): Array(ValType) =
        begin
            let body = quantified(fn.v.type).body
            if shapes.kindIs(body shapes.shapeFun) andif {k < extent body.params}
                    andif isLocation(body.params[k].shape.type) then locationParts
            else varParts(g fn.params[k].v)
            end
        end

    (* A function's parameters' and result's representations, its signature
     * (section 3.2); unsupported for a value parameter held
     * boxed *)
    let signature(g: G fn: ir.Function): Signature =
        begin
            (* The closure first (section 3.1), then the descriptors of the
             * type parameters its callers supply, then each parameter's
             * parts *)
            let params = vector.new(:ValType)
            vector.append(params model.ref(tClos))
            for k = 0 upto quantified(fn.v.type).count - 1 do vector.append(params model.eqref) end
            for k = 0 upto extent fn.params - 1 do
                let located = not(stringOp.equal(fn.params[k].mode "value"))
                if fn.params[k].v.boxed andif not(located) then fail("a parameter held boxed") end
                let ps = paramParts(g fn k)
                for j = 0 upto extent ps - 1 do vector.append(params ps[j]) end
            end
            let results = if fn.unboxedResult then componentTypes(fn.resultType) else parts(fn.resultType) end
            tuple let params = vector.toArray(params) let results = results end
        end

    (* A function of the unit, whose index and type are already given *)
    let function(g: G fn: ir.Function): Ok =
        begin
            let sig = signature(g fn)
            let names = array of(extent sig.params "")
            let f = newF(g names sig.results fn.id)
            names[0] := fresh(f.names "closure")
            (* Wrap the body in a loop so self tail calls update parameters and
             * branch back rather than using return_call: V8 checks for worker
             * termination at loop back-edges, not at tail calls, allowing the
             * host to interrupt endless self-recursion (section 3.3; mutual
             * tail recursion still cannot be interrupted there, section 6.4).
             * The loop is stripped afterwards if no self tail call is emitted.
             * It starts after the prologue below, while an accumulating
             * recursion initializes its accumulator here before the loop. *)
            f.accOp := accumulation(f fn)
            if f.accOp > 0 then
                f.accLocal := scratch(f model.i64)
                emit(f model.i64Const(if f.accOp is 1 then 0 else 1 end))
                emit(f i1(ops.localSet f.accLocal))
                f.selfTail := true
            end
            if maybe.isSome(fn.env) andif not(isAdapter(fn)) then
                hashMap.insert(f.locals maybe.unwrap(fn.env).id 0)
            end
            let var at = 1
            let captured = capturedDescriptors(fn)
            for k = captured upto extent fn.descriptorParams - 1 do
                hashMap.insert(f.locals fn.descriptorParams[k].v.id at)
                names[at] := fresh(f.names fn.descriptorParams[k].v.hint)
                at := at + 1
            end
            (* an adapter's environment, the closure it adapts, from its
             * closure *)
            if isAdapter(fn) then
                let own = ownType(g fn)
                emit(f i1(ops.localGet 0))
                castTo(f own)
                emit(f i2(ops.structGet own captureField(g fn 0)))
                emit(f i1(ops.localSet local(f maybe.unwrap(fn.env))))
            end
            (* the descriptors its closure supplies, from the closure *)
            for k = 0 upto captured - 1 do
                let own = ownType(g fn)
                emit(f i1(ops.localGet 0))
                castTo(f own)
                emit(f i2(ops.structGet own 3 + k))
                emit(f i1(ops.localSet local(f fn.descriptorParams[k].v)))
            end
            for k = 0 upto extent fn.params - 1 do
                hashMap.insert(f.locals fn.params[k].v.id at)
                for j = 0 upto extent paramParts(g fn k) - 1 do
                    names[at] := fresh(f.names fn.params[k].v.hint)
                    at := at + 1
                end
            end
            (* A module's function that uses what the backend cannot yet
             * compile fails when it is called, not when its unit is
             * compiled, so that the rest of the unit, a library's above all,
             * runs (section 4.1); a program's, and the runtime's, fail here *)
            let lenient = not(g.unit.isProgram) andif not(g.isRuntime)
            let compiled =
                try
                    begin
                        (* its view maps, one for each bounded type parameter
                         * whose values it reads through the bound *)
                        for k = 0 upto extent fn.viewMaps - 1 do
                            let m = fn.viewMaps[k]
                            emit(f i1(ops.globalGet g.noClosure))
                            atomParts(f ir.atomOfVar(m.descriptor))
                            descriptor(f m.bound)
                            runtimeUnitCall(f "wasm/core.viewMap")
                            emit(f i1(ops.localSet local(f m.v)))
                        end
                        (* the loop, after the prologue, so that a self tail
                         * call does not read the closure's captures and make
                         * the view maps again (section 3.3) *)
                        let loopAt = vector.length(f.code)
                        emit(f model.loopInst(empty selfLabel))
                        open(f selfLabel option labelRepeat of LabelKind end)
                        body(f fn.body)
                        close(f)
                        emit(f i(ops.unreachable))
                        if not(f.selfTail) then
                            (* no call branches to the loop: its instruction,
                             * at loopAt, and its end, the last but the
                             * unreachable, dropped *)
                            let n = vector.length(f.code)
                            let kept = vector.new(:Inst)
                            for k = 0 upto n - 1 do
                                if {k isnot loopAt} andif {k isnot {n - 2}} then
                                    vector.append(kept vector.get(f.code k))
                                end
                            end
                            vector.clear(f.code)
                            for k = 0 upto vector.length(kept) - 1 do
                                vector.append(f.code vector.get(kept k))
                            end
                        end
                        f
                    end
                when unsupported with m then
                    if not(lenient) then raise unsupported with m end end
                    let pf = newF(g names sig.results fn.id)
                    pending(pf fn.v.hint <> ": " <> m)
                    pf
                end
            let at = maybe.unwrap(hashMap.get(g.functions fn.id)) - model.importedFunctions(g.m)
            let given = vector.get(g.m.functions at)
            vector.set(g.m.functions at tuple
                let name = given.name
                let type = given.type
                let params = names
                let locals = compiled.declared
                let body = compiled.code
            end)
        end

    (* The name of the unit an import names, as its module is named: a
     * library unit's by its path in lib/, which an implicit import's
     * canonical name (arrayOp) may not be *)
    let unitName(i: ir.Import): String = maybe.unwrapOr(i.libPath i.canonicalPath)

    (* Whether the unit moduleName's import i is of a unit's module, its
     * record and its init: not the core's of the library's units, whose
     * members it takes only as externals; nor util/realconv's and
     * util/realmath's of real, which they take only as externals too, and
     * whose module's functions call theirs *)
    let isUnitImport(moduleName: String i: ir.Import): Bool =
        if stringOp.equal(moduleName "wasm/core") then maybe.isNone(i.libPath)
        elsif stringOp.equal(moduleName "util/realconv") orif stringOp.equal(moduleName "util/realmath") then
            not(stringOp.equal(i.canonicalPath "real"))
        else true
        end

    (* A representation converted to another at an exported function's
     * boundary (section 5.1): an Int or a Bool boxed or unboxed, as an
     * abstract type's value whose representation is one crosses *)
    let convertRep(f: F from: ValType to: ValType): Ok =
        if sameType(from to) then
            ok
        else
            case from
                when valRef then
                    case to
                        when valI64 then runtimeCall(f "unboxInt")
                        when valI32 then
                            castI31(f)
                            emit(f i(ops.i31GetU))
                        else fail("a conversion at a unit's boundary")
                    end
                when valI64 then runtimeCall(f "boxInt")
                when valI32 then emit(f i(ops.refI31))
                else fail("a conversion at a unit's boundary")
            end
        end

    (* The unit's variables held in a location (section 2.6): each var and
     * out parameter, and each variable whose address is taken (@x) *)
    let locatedVariables(unit: ir.Unit): maps.IntSet =
        begin
            let found = maps.newIntSet()
            for k = 0 upto vector.length(unit.functions) - 1 do
                let fn = vector.get(unit.functions k)
                for j = 0 upto extent fn.params - 1 do
                    if not(stringOp.equal(fn.params[j].mode "value")) then
                        hashSet.insert(found fn.params[j].v.id)
                    end
                end
            end
            let bodies = walk.unitBodies(unit)
            for b = 0 upto extent bodies - 1 do
                let ss = walk.walkStatements(bodies[b] true)
                for k = 0 upto vector.length(ss) - 1 do
                    case vector.get(ss k)
                        when sLet with x then
                            case x.value
                                when opAddrVar with y then
                                    hashSet.insert(found y.v.id)
                                    ok
                                else ok
                            end
                        else ok
                    end
                end
            end
            found
        end

    (* A module's abstract types registered with their representations
     * (docs/dynamic.md section 2.3), as the describe pass listed them; one
     * whose representation's descriptor the unit does not make is not *)
    let registerAbstracts(f: F m: ir.Module): Ok =
        for k = 0 upto extent m.abstractTypes - 1 do
            let e = m.abstractTypes[k]
            let naming = maybe.some(f.g.naming)
            let symbol =
                try staticdata.descriptorForm(e.descriptor.type naming).symbol
                when staticdata.missingDescriptor then ""
                end
            if not(stringOp.isEmpty(symbol)) andif hashMap.contains(f.g.descGlobals symbol) then
                emit(f i1(ops.globalGet f.g.noClosure))
                literal(f e.name)
                emit(f model.i64Const(e.arity))
                emit(f i1(ops.globalGet hashMap.find(f.g.descGlobals symbol)))
                runtimeUnitCall(f "wasm/core.registerAbstract")
                emit(f i(ops.drop))
            end
        end

    let unitModule(unit: ir.Unit): model.Module =
        begin
            (* A module file's module is its unit's last, after any it
             * defines inline *)
            let nmodules = vector.length(unit.modules)
            (* A phrase unit, though a program's, is compiled as a module's,
             * its init the input's entry, which the JIT's host calls
             * (section 5.1) *)
            let asProgram = unit.isProgram andif maybe.isNone(unit.phrase)
            let moduleName = if asProgram orif {nmodules is 0} then "main"
                else vector.get(unit.modules {nmodules - 1}).name
                end
            let m = model.newModule(moduleName)
            vector.append(m.types rt.group)
            (* The built-in exceptions, the first globals *)
            for k = 0 upto extent runtime.builtinExceptions - 1 do
                vector.append(m.imports tuple
                    let moduleName = runtime.name
                    let field = runtime.exceptionField(runtime.builtinExceptions[k])
                    let name = runtime.builtinExceptions[k]
                    let kind = option importGlobal of model.ImportKind with
                        let type = model.ref(rt.index("exception"))
                        let mutable = false
                    end
                end)
            end
            (* Each unit imported, its record's two globals, which its init
             * sets *)
            let records = maps.newStringMap(:Int)
            for k = 0 upto extent unit.imports - 1 do
                let i = unit.imports[k]
                if isUnitImport(moduleName i) andif not(hashMap.contains(records i.canonicalPath)) then
                    hashMap.insert(records i.canonicalPath model.importedGlobals(m))
                    for j = 0 upto 1 do
                        vector.append(m.imports tuple
                            let moduleName = unitName(i)
                            let field = if j is 0 then "record.payload" else "record.dict" end
                            let name = ""
                            let kind = option importGlobal of model.ImportKind with
                                let type = model.eqref
                                let mutable = true
                            end
                        end)
                    end
                end
            end
            (* The closure a direct call of a function that captures nothing
             * passes, which it never reads *)
            let noClosure = model.importedGlobals(m) + vector.length(m.globals)
            vector.append(m.globals tuple
                let name = "noClosure"
                let type = model.ref(rt.index("clos"))
                let mutable = false
                let init = array of model.i32Const(0) model.op(ops.structNew array of rt.index("clos") end) end
            end)
            let g = tuple
                let unit = unit
                let m = m
                let globalIds = walk.globalVariables(unit)
                let globals = maps.newIntMap(:Int)
                let functions = maps.newIntMap(:Int)
                let known = walk.knownClosures(unit)
                let runtimeFunctions = maps.newStringMap(:Int)
                let funcTypes = maps.newStringMap(:Int)
                let strings = sb.new()
                let literalGlobals = maps.newStringMap(:Int)
                let names = maps.newStringMap(:Int)
                let dicts = maps.newStringMap(:Int)
                let closTypes = maps.newStringMap(:Int)
                let ownTypes = maps.newIntMap(:Int)
                let staticClosures = maps.newIntMap(:Int)
                let uniforms = maps.newIntMap(:Int)
                let trapNatives = maps.newIntMap(:Int)
                let captureTypes = maps.newIntMap(:Array(ir.Type))
                let byId = maps.newIntMap(:ir.Function)
                let declaredFns = maps.newIntSet()
                let noClosure = noClosure
                let builtins = maps.newStringMap(:Int)
                let importFunctions = maps.newStringMap(:Int)
                let importInits = maps.newStringMap(:Int)
                let importRecords = records
                let runtimeUnits = maps.newStringMap(:Int)
                let descGlobals = maps.newStringMap(:Int)
                let isRuntime = isRuntimeUnit(moduleName)
                let isCore = stringOp.equal(moduleName "wasm/core")
                let isPhrase = maybe.isSome(unit.phrase)
                let located = locatedVariables(unit)
                let naming = staticdata.newRecordNaming()
                let uses = maps.newIntMap(:Int)
                let pinned = maps.newIntSet()
            end
            walk.countUses(unit g.uses g.pinned)
            (* Each function, and the types of what its closures capture: an
             * adapter's (ir/thunks), whose environment is the closure it
             * adapts, of that closure's type, captures that closure *)
            for k = 0 upto vector.length(unit.functions) - 1 do
                let fn = vector.get(unit.functions k)
                hashMap.insert(g.byId fn.id fn)
                if isAdapter(fn) then
                    hashMap.insert(g.captureTypes fn.id
                            array of maybe.unwrap(fn.env).type end)
                end
            end
            let bodies = walk.unitBodies(unit)
            for b = 0 upto extent bodies - 1 do
                let ss = walk.walkStatements(bodies[b] false)
                for k = 0 upto vector.length(ss) - 1 do
                    case vector.get(ss k)
                        when sLet with x then
                            case x.value
                                when opMakeClosure with c then
                                    if not(hashMap.contains(g.captureTypes c.code.id)) then
                                        let ts = vector.new(:ir.Type)
                                        for j = 0 upto extent c.captures - 1 do
                                            vector.append(ts ir.atomType(c.captures[j]))
                                        end
                                        hashMap.insert(g.captureTypes c.code.id
                                                vector.toArray(ts))
                                    end
                                else ok
                            end
                        else ok
                    end
                end
            end
            (* The runtime's functions and tag, imported first *)
            for k = 0 upto extent runtime.exports - 1 do
                let e = runtime.exports[k]
                vector.append(m.imports tuple
                    let moduleName = runtime.name
                    let field = e.field
                    let name = fresh(g.names e.field)
                    let kind = option importFunc of model.ImportKind with let type = funcType(g e.params e.results) end
                end)
                hashMap.insert(g.runtimeFunctions e.field k)
            end
            vector.append(m.imports tuple
                let moduleName = runtime.name
                let field = runtime.tagField
                let name = fresh(g.names "error")
                let kind = option importTag of model.ImportKind with
                    let type = funcType(g array of model.eqref end noTypes)
                end
            end)
            (* Each unit imported, its init and the functions this unit calls
             * of it, each at its interface type's closure signature *)
            let importFunction = fun(unitName: String field: String type: Int): Int
                begin
                    let index = model.importedFunctions(m)
                    vector.append(m.imports tuple
                        let moduleName = unitName
                        let field = field
                        let name = fresh(g.names unitName <> "." <> field)
                        let kind = option importFunc of model.ImportKind with let type = type end
                    end)
                    index
                end
            for k = 0 upto extent unit.imports - 1 do
                let i = unit.imports[k]
                if isUnitImport(moduleName i)
                        andif not(hashMap.contains(g.importInits i.canonicalPath)) then
                    hashMap.insert(g.importInits i.canonicalPath
                            importFunction(unitName(i) "init" funcType(g noTypes noTypes)))
                end
            end
            (* Import functions from the Quest runtime units at their interface
             * closure signatures: wasm/core's descriptor, proxy, and adapter
             * helpers, plus wasm/print's echo. A unit whose modules declare
             * abstract types also needs descriptors to register their
             * representations (registerAbstracts). *)
            let var abstracts = false
            for k = 0 upto vector.length(unit.modules) - 1 do
                if extent vector.get(:ir.Module unit.modules k).abstractTypes > 0 then abstracts := true end
            end
            let described = not(isRuntimeUnit(moduleName)) andif maybe.isSome(unit.staticData)
                andif {abstracts orif {vector.length(maybe.unwrap(unit.staticData).descriptors) > 0}}
            let runtimeImport = fun(unitName: String field: String params: Array(ValType)
                    results: Array(ValType)): Bool
                hashMap.insert(g.runtimeUnits unitName <> "." <> field
                        importFunction(unitName field funcType(g withClosure(params) results)))
            let e = model.eqref
            let n = model.i64
            (* Import wasm/print when a unit echoes descriptor-formatted values
             * or when a program needs wasm/print.show to format uncaught
             * exception payloads. Other units avoid importing wasm/print
             * because it depends on the standard library. *)
            let var echoes = false
            let echoBodies = walk.unitBodies(unit)
            for b = 0 upto extent echoBodies - 1 do
                let ss = walk.walkStatements(echoBodies[b] true)
                for k = 0 upto vector.length(ss) - 1 do
                    case vector.get(ss k)
                        when sEcho with x then
                            if stringOp.isEmpty(describe.echoValueKind(x.type))
                                    andif maybe.isSome(x.descriptor) then echoes := true end
                        else ok
                    end
                end
            end
            let printed = {described andif echoes} orif {asProgram andif not(isRuntimeUnit(moduleName))}
            if printed then
                hashMap.insert(g.runtimeUnits "wasm/print.init"
                        importFunction("wasm/print" "init" funcType(g noTypes noTypes)))
                runtimeImport("wasm/print" "show" array of e e end array of e end)
            end
            if g.isPhrase then
                if not(hashMap.contains(g.runtimeUnits "wasm/print.init")) then
                    hashMap.insert(g.runtimeUnits "wasm/print.init"
                            importFunction("wasm/print" "init" funcType(g noTypes noTypes)))
                end
                runtimeImport("wasm/print" "echoText" array of e end array of e end)
            end
            (* the core's proxies, which an access that may meet one calls *)
            if not(isRuntimeUnit(moduleName)) then
                runtimeImport("wasm/core" "unproxy" array of e end array of e end)
                runtimeImport("wasm/core" "proxyTag" array of e end array of n end)
                runtimeImport("wasm/core" "proxyElement" array of e n end array of e end)
                runtimeImport("wasm/core" "proxyOptionElement" array of e n end array of e end)
                runtimeImport("wasm/core" "proxyOptionPayload" array of e end array of e end)
            end
            let pastArities = if isRuntimeUnit(moduleName) then array of :Int end else arityPast(g unit) end
            if extent pastArities > 0 then
                runtimeImport("wasm/core" "adaptArg" array of e e n e end array of e end)
                runtimeImport("wasm/core" "adaptResult" array of e e e end array of e end)
                runtimeImport("wasm/core" "registerAdapter" array of n e end array of e end)
            end
            if described then
                hashMap.insert(g.runtimeUnits "wasm/core.init"
                        importFunction("wasm/core" "init" funcType(g noTypes noTypes)))
                runtimeImport("wasm/core" "base" array of n end array of e end)
                runtimeImport("wasm/core" "newDesc" array of n e n n end array of e end)
                runtimeImport("wasm/core" "setPart" array of e n e e end array of e end)
                runtimeImport("wasm/core" "setText" array of e n n e end array of e end)
                runtimeImport("wasm/core" "setFlags" array of e n n end array of e end)
                runtimeImport("wasm/core" "boundVar" array of n end array of e end)
                runtimeImport("wasm/core" "instantiate" array of e e end array of e end)
                (* records' tables and views (section 2.5) *)
                runtimeImport("wasm/core" "viewDict" array of e e end array of e end)
                runtimeImport("wasm/core" "storedField" array of e e n e end array of e end)
                runtimeImport("wasm/core" "convert" array of e e e end array of e end)
                runtimeImport("wasm/core" "isSubtype" array of e e end array of model.i32 end)
                runtimeImport("wasm/core" "registerAbstract" array of e n e end array of e end)
                runtimeImport("wasm/core" "valIs" array of e e e end array of model.i32 end)
                runtimeImport("wasm/core" "viewMap" array of e e end array of e end)
                runtimeImport("wasm/core" "viewIndex" array of e n end array of n end)
                runtimeImport("wasm/core" "viewPart" array of e n e end array of e end)
                runtimeImport("wasm/core" "viewRecordSlot" array of e e n end array of n end)
                runtimeImport("wasm/core" "viewRecordField" array of e e e n end array of e end)
                runtimeImport("wasm/core" "viewOptionComponent" array of e e n n end array of e end)
                runtimeImport("wasm/core" "viewOptionPayload" array of e e end array of e end)
                if echoes then runtimeImport("wasm/print" "echo" array of e e e e end array of e end) end
            end
            (* What the unit's statements call: each other unit's function
             * called by name (register), unless it is a library external
             * compiled in place; and the runtime units' functions behind the
             * externals, intrinsics, and operators it uses *)
            let allBodies = walk.unitBodies(unit)
            for b = 0 upto extent allBodies - 1 do
                let ss = walk.walkStatements(allBodies[b] true)
                for k = 0 upto vector.length(ss) - 1 do
                    (* echo of a Real writes it with util/realconv *)
                    case vector.get(ss k)
                        when sEcho with x then
                            if stringOp.equal(describe.echoValueKind(x.type) "Real")
                                    andif not(hashMap.contains(g.runtimeUnits "util/realconv.magnitude")) then
                                runtimeImport("util/realconv" "magnitude" array of model.f64 end
                                        array of model.eqref end)
                            end
                        else ok
                    end
                    let op =
                        case vector.get(ss k)
                            when sLet with x then maybe.some(x.value)
                            when sDo with x then maybe.some(x.value)
                            else maybe.none(:ir.Op)
                        end
                    if maybe.isSome(op) then
                        let register = fun(callee: maybe.T(ir.Variable) moduleRef: maybe.T(ir.ModuleRef)
                                member: maybe.T(String) calleeType: maybe.T(ir.Type)): Ok
                            if maybe.isSome(moduleRef) andif maybe.isNone(callee) then
                                case maybe.unwrap(moduleRef)
                                    when refImport with imp then
                                        let key = imp.i.canonicalPath <> "." <> maybe.unwrapOr(member "")
                                        let known = hashMap.contains(g.importFunctions key)
                                        let fast = maybe.isSome(imp.i.libPath)
                                            andif maybe.isSome(externalSymbol(maybe.unwrap(imp.i.libPath)
                                                    maybe.unwrapOr(member "")))
                                        if isUnitImport(moduleName imp.i) andif not(known) andif not(fast)
                                                andif maybe.isSome(calleeType) then
                                            let sig = closureSig(maybe.unwrap(calleeType))
                                            hashMap.insert(g.importFunctions key
                                                    importFunction(unitName(imp.i)
                                                            maybe.unwrapOr(member "") nativeType(g sig)))
                                        end
                                    else ok
                                end
                            end
                        let realconvImport = fun(field: String): Ok
                            if not(hashMap.contains(g.runtimeUnits "util/realconv." <> field)) then
                                if stringOp.equal(field "toReal") then
                                    runtimeImport("util/realconv" field array of model.eqref end array of model.f64 end)
                                elsif stringOp.equal(field "format") then
                                    runtimeImport("util/realconv" field array of model.f64 model.i32 model.i64 end
                                            array of model.eqref end)
                                else
                                    runtimeImport("util/realconv" field array of model.f64 end array of model.eqref end)
                                end
                            end
                        let realmathImport = fun(field: String arity: Int): Ok
                            if not(hashMap.contains(g.runtimeUnits "util/realmath." <> field)) then
                                runtimeImport("util/realmath" field array of(arity model.f64) array of model.f64 end)
                            end
                        let coreFunction = fun(symbol: String): Ok
                            if stringOp.equal(symbol "quest_system_exit") andif not(g.isCore) then
                                if not(hashMap.contains(g.runtimeUnits "wasm/core.exitStatus")) then
                                    runtimeImport("wasm/core" "exitStatus" repTypes("n") repTypes("n"))
                                end
                            elsif maybe.isSome(realmathFunction(symbol)) then
                                let e = maybe.unwrap(realmathFunction(symbol))
                                realmathImport(e[1] if stringOp.equal(e[2] "2") then 2 else 1 end)
                            elsif maybe.isSome(realconvFunction(symbol)) then
                                realconvImport(maybe.unwrap(realconvFunction(symbol)))
                            elsif not(g.isCore) andif maybe.isSome(coreExternal(symbol)) then
                                let e = maybe.unwrap(coreExternal(symbol))
                                if not(hashMap.contains(g.runtimeUnits "wasm/core." <> e[1])) then
                                    runtimeImport("wasm/core" e[1] repTypes(e[2]) repTypes(e[3]))
                                end
                            end
                        case maybe.unwrap(op)
                            when opCall with c then
                                register(c.callee c.moduleRef c.member c.calleeType)
                                if maybe.isNone(c.callee) andif maybe.isSome(c.moduleRef) then
                                    case maybe.unwrap(c.moduleRef)
                                        when refImport with imp then
                                            if maybe.isSome(imp.i.libPath) then
                                                let sym = externalSymbol(maybe.unwrap(imp.i.libPath)
                                                        maybe.unwrapOr(c.member ""))
                                                if maybe.isSome(sym) then coreFunction(maybe.unwrap(sym)) end
                                            end
                                        else ok
                                    end
                                end
                            when opCallExternal with c then
                                coreFunction(c.symbol)
                                (* The host's functions (section 4.5), each
                                 * of Ints as i32s; and print's capture *)
                                let hostPrefix = "wasm.host."
                                if strutil.startsWith(c.symbol hostPrefix) then
                                    let field = stringOp.getSub(c.symbol stringOp.length(hostPrefix)
                                            {stringOp.length(c.symbol) - stringOp.length(hostPrefix)})
                                    if not(hashMap.contains(g.runtimeUnits "quest.host." <> field)) then
                                        hashMap.insert(g.runtimeUnits "quest.host." <> field
                                                importFunction("quest.host" field funcType(g
                                                        array of(extent c.args model.i32) array of model.i32 end)))
                                    end
                                elsif stringOp.equal(c.symbol "wasm.raisedName") then
                                    if not(hashMap.contains(g.runtimeUnits "wasm/print.show")) then
                                        runtimeImport("wasm/print" "show" array of e e end array of e end)
                                    end
                                    if not(hashMap.contains(g.runtimeUnits "wasm/print.init")) then
                                        hashMap.insert(g.runtimeUnits "wasm/print.init"
                                                importFunction("wasm/print" "init" funcType(g noTypes noTypes)))
                                    end
                                elsif stringOp.equal(c.symbol "wasm.print.capture")
                                        orif stringOp.equal(c.symbol "wasm.print.captured") then
                                    let field = stringOp.getSub(c.symbol 11 {stringOp.length(c.symbol) - 11})
                                    if not(hashMap.contains(g.runtimeUnits "wasm/print." <> field)) then
                                        runtimeImport("wasm/print" field noTypes array of e end)
                                    end
                                    (* print initialized before its capture *)
                                    if not(hashMap.contains(g.runtimeUnits "wasm/print.init")) then
                                        hashMap.insert(g.runtimeUnits "wasm/print.init"
                                                importFunction("wasm/print" "init" funcType(g noTypes noTypes)))
                                    end
                                end
                            when opExternal with c then coreFunction(c.symbol)
                            when opPrim with c then if c.op?primRealPow then realmathImport("pow" 2) end
                            when opBuiltin with c then if stringOp.equal(c.name "^^") then realmathImport("pow" 2) end
                            when opTypeApp with c then register(c.callee c.moduleRef c.member c.calleeType)
                            else ok
                        end
                    end
                end
            end
            (* A program's _start flushes the files' writers when it ends *)
            if g.unit.isProgram andif not(g.isRuntime)
                    andif not(hashMap.contains(g.runtimeUnits "wasm/core.flushWriters")) then
                runtimeImport("wasm/core" "flushWriters" repTypes("") repTypes("e"))
            end
            (* The core initialized before any of its functions is called *)
            let usesCore = fun(): Bool
                begin
                    let var any = hashMap.contains(g.runtimeUnits "wasm/core.flushWriters")
                        orif hashMap.contains(g.runtimeUnits "wasm/core.exitStatus")
                    for k = 0 upto extent coreExternals - 1 do
                        if hashMap.contains(g.runtimeUnits "wasm/core." <> coreExternals[k][1]) then
                            any := true
                        end
                    end
                    any
                end
            let usesRealconv = hashMap.contains(g.runtimeUnits "util/realconv.toString")
                orif hashMap.contains(g.runtimeUnits "util/realconv.toReal")
                orif hashMap.contains(g.runtimeUnits "util/realconv.magnitude")
            let usesRealconv1 = usesRealconv orif hashMap.contains(g.runtimeUnits "util/realconv.format")
            if usesRealconv1 then
                hashMap.insert(g.runtimeUnits "util/realconv.init"
                        importFunction("util/realconv" "init" funcType(g noTypes noTypes)))
            end
            let var usesRealmath = false
            for k = 0 upto extent realmathExternals - 1 do
                if hashMap.contains(g.runtimeUnits "util/realmath." <> realmathExternals[k][1]) then
                    usesRealmath := true
                end
            end
            if usesRealmath then
                hashMap.insert(g.runtimeUnits "util/realmath.init"
                        importFunction("util/realmath" "init" funcType(g noTypes noTypes)))
            end
            if usesCore() andif not(hashMap.contains(g.runtimeUnits "wasm/core.init")) then
                hashMap.insert(g.runtimeUnits "wasm/core.init"
                        importFunction("wasm/core" "init" funcType(g noTypes noTypes)))
            end
            (* Each function's index and type, before any is compiled, so that
             * a call, a tail call above all, knows its callee's signature
             * wherever the callee is in the unit; its code is filled in when
             * it is compiled *)
            let base = model.importedFunctions(m)
            let placeholder = funcType(g noTypes noTypes)
            for k = 0 upto vector.length(unit.functions) - 1 do
                let fn = vector.get(unit.functions k)
                let sig = signature(g fn)
                hashMap.insert(g.functions fn.id base + k)
                vector.append(m.functions tuple
                    let name = fresh(g.names fn.v.hint)
                    let type = funcType(g sig.params sig.results)
                    let params = array of :String end
                    let locals = vector.new(:model.Local)
                    let body = vector.new(:Inst)
                end)
            end
            (* The top level's and _start's (a module's init), before the
             * uniform entries that compiling the functions makes *)
            let mainIndex = base + vector.length(unit.functions)
            for k = 0 upto if asProgram then 1 else 0 end do
                vector.append(m.functions tuple
                    let name = ""
                    let type = placeholder
                    let params = array of :String end
                    let locals = vector.new(:model.Local)
                    let body = vector.new(:Inst)
                end)
            end
            let descIndex = mainIndex + if asProgram then 2 else 1 end
            let forms = if described then descriptorGlobals(g) else vector.new(:staticdata.DescriptorForm) end
            if described then
                vector.append(m.functions tuple
                    let name = ""
                    let type = placeholder
                    let params = array of :String end
                    let locals = vector.new(:model.Local)
                    let body = vector.new(:Inst)
                end)
            end
            for k = 0 upto vector.length(unit.functions) - 1 do
                function(g vector.get(unit.functions k))
            end
            (* The runtime's units initialized, and the unit's descriptors
             * made, first in its initializer *)
            if described then
                let df = newF(g array of :String end noTypes ~1)
                makeDescriptors(df forms)
                fill(df descIndex "descriptors" placeholder)
            end
            let initRuntime = fun(f: F): Ok
                begin
                    if hashMap.contains(g.runtimeUnits "wasm/core.init") then
                        emit(f i1(ops.call hashMap.find(g.runtimeUnits "wasm/core.init")))
                    end
                    if hashMap.contains(g.runtimeUnits "util/realconv.init") then
                        emit(f i1(ops.call hashMap.find(g.runtimeUnits "util/realconv.init")))
                    end
                    if hashMap.contains(g.runtimeUnits "util/realmath.init") then
                        emit(f i1(ops.call hashMap.find(g.runtimeUnits "util/realmath.init")))
                    end
                    if described then emit(f i1(ops.call descIndex)) end
                    if {described andif echoes} orif g.isPhrase
                            orif hashMap.contains(g.runtimeUnits "wasm/print.capture") then
                        emit(f i1(ops.call hashMap.find(g.runtimeUnits "wasm/print.init")))
                    end
                end
            (* Each unit imported initialized, in the order of the imports *)
            let initImports = fun(f: F): Ok
                for k = 0 upto extent unit.imports - 1 do
                    if isUnitImport(moduleName unit.imports[k]) then
                        emit(f i1(ops.call hashMap.find(g.importInits unit.imports[k].canonicalPath)))
                    end
                end
            if not(asProgram) then
                (* A module's init, guarded by a flag, as in C (section 5.1);
                 * its record's globals, which its body sets, exported, and
                 * its functions at their interface types' signatures *)
                let mod = vector.get(unit.modules {nmodules - 1})
                let flag = model.importedGlobals(m) + vector.length(m.globals)
                vector.append(m.globals tuple
                    let name = "initialized"
                    let type = model.i32
                    let mutable = true
                    let init = array of model.i32Const(0) end
                end)
                let initF = newF(g array of :String end noTypes ~1)
                emit(initF i1(ops.globalGet flag))
                emit(initF model.ifInst(empty ""))
                emit(initF i(ops.returnOp))
                emit(initF model.endInst)
                emit(initF model.i32Const(1))
                emit(initF i1(ops.globalSet flag))
                initRuntime(initF)
                initImports(initF)
                for k = 0 upto nmodules - 1 do registerAbstracts(initF vector.get(unit.modules k)) end
                adaptersPast(initF pastArities)
                for k = 0 upto nmodules - 1 do body(initF vector.get(unit.modules k).init) end
                (* and a phrase unit's top level, as the native entry runs it *)
                if g.isPhrase then body(initF unit.main) end
                fill(initF mainIndex "init" placeholder)
                let exportFunction = fun(field: String index: Int): Ok
                    vector.append(m.exports tuple
                        let field = field
                        let kind = option exportFunc of model.ExportKind end
                        let index = index
                    end)
                exportFunction("init" mainIndex)
                if maybe.isNone(mod.recordVar) then fail("a module without its record") end
                let recordVar = maybe.unwrap(mod.recordVar)
                let first = global(initF recordVar)
                for j = 0 upto 1 do
                    vector.append(m.exports tuple
                        let field = if j is 0 then "record.payload" else "record.dict" end
                        let kind = option exportGlobal of model.ExportKind end
                        let index = first + j
                    end)
                end
                (* The functions of a module's record, at their interface types'
                 * signatures, exported with prefix before their names *)
                let exportMembers = fun(mod: ir.Module prefix: String): Ok
                    begin
                        let members = maybe.unwrapOr(mod.exports mod.members)
                        let recordShape = shapeOf(maybe.unwrap(mod.recordVar).type)
                        for k = 0 upto vector.length(members.names) - 1 do
                            let name = vector.get(members.names k)
                            let v = maybe.unwrap(ir.member(members name))
                            let c = shapes.component(recordShape name)
                            let isFunction = hashMap.contains(g.known v.id)
                            if maybe.isSome(c) andif isFunction then
                                let interfaceType = shapes.componentShape(maybe.unwrap(c)).type
                                let fn = hashMap.find(g.known v.id).code
                                let native = hashMap.find(g.functions fn.id)
                                let outer = closureSig(interfaceType)
                                let inner = signature(g fn)
                                let innerParams = array of(extent inner.params - 1 model.i64)
                                for j = 1 upto extent inner.params - 1 do innerParams[j - 1] := inner.params[j] end
                                if sameTypes(outer.params innerParams) andif sameTypes(outer.results inner.results) then
                                    exportFunction(prefix <> name native)
                                else
                                    (* converted to its interface's types *)
                                    if {extent outer.params isnot extent innerParams}
                                            orif {extent outer.results isnot 1} orif {extent inner.results isnot 1} then
                                        fail("an exported function whose interface type differs in its parts: "
                                            <> sigText(g outer) <> " against " <> sigText(g inner))
                                    end
                                    let names = array of(extent outer.params + 1 "")
                                    let wf = newF(g names outer.results ~1)
                                    emit(wf i1(ops.localGet 0))
                                    for j = 0 upto extent outer.params - 1 do
                                        emit(wf i1(ops.localGet j + 1))
                                        convertRep(wf outer.params[j] innerParams[j])
                                    end
                                    emit(wf i1(ops.call native))
                                    convertRep(wf inner.results[0] outer.results[0])
                                    let at = model.importedFunctions(m) + vector.length(m.functions)
                                    vector.append(m.functions tuple
                                        let name = fresh(g.names name <> ".export")
                                        let type = nativeType(g outer)
                                        let params = names
                                        let locals = wf.declared
                                        let body = wf.code
                                    end)
                                    exportFunction(prefix <> name at)
                                end
                            end
                        end
                    end
                exportMembers(mod "")
                (* A phrase unit's declared modules, which later inputs import
                 * by their names (qj_N_k), exported as NAME.FIELD, which the
                 * host gives them as the module NAME's (section 5.1) *)
                if g.isPhrase then
                    for k = 0 upto nmodules - 2 do
                        let declared = vector.get(unit.modules k)
                        if maybe.isSome(declared.recordVar) then
                            let at = global(initF maybe.unwrap(declared.recordVar))
                            for j = 0 upto 1 do
                                vector.append(m.exports tuple
                                    let field = declared.name
                                        <> if j is 0 then ".record.payload" else ".record.dict" end
                                    let kind = option exportGlobal of model.ExportKind end
                                    let index = at + j
                                end)
                            end
                            exportMembers(declared declared.name <> ".")
                        end
                    end
                end
            else
                (* The program's top level *)
                let flushWriters = fun(f: F): Ok
                    if hashMap.contains(g.runtimeUnits "wasm/core.flushWriters") then
                        emit(f i1(ops.globalGet g.noClosure))
                        runtimeUnitCall(f "wasm/core.flushWriters")
                        emit(f i(ops.drop))
                    end
                let mainF = newF(g array of :String end noTypes ~1)
                initRuntime(mainF)
                initImports(mainF)
                for k = 0 upto nmodules - 1 do registerAbstracts(mainF vector.get(unit.modules k)) end
                adaptersPast(mainF pastArities)
                (* the modules the program defines, in order, then its top
                 * level *)
                for k = 0 upto nmodules - 1 do body(mainF vector.get(unit.modules k).init) end
                body(mainF unit.main)
                fill(mainF mainIndex fresh(g.names "main") placeholder)
                (* _start: the top level, and an uncaught exception's report *)
                let start = newF(g array of :String end noTypes ~1)
                emit(start
                        model.blockInst(option blockValue of model.BlockType with
                            let type = model.eqref
                        end "uncaught"))
                emit(start option instTryTable of Inst with
                    let type = empty
                    let label = ""
                    let catches = array of
                        tuple let kind = option catchTag of model.CatchKind end let tag = 0 let label = 0 end
                    end
                end)
                emit(start i1(ops.call mainIndex))
                flushWriters(start)
                emit(start model.endInst)
                emit(start i(ops.returnOp))
                emit(start model.endInst)
                (* the payload as print's show writes it, if its descriptor
                 * writes it *)
                let tRaised = rt.index("raised")
                let state = scratch(start model.refNull(tRaised))
                castTo(start tRaised)
                emit(start i1(ops.localTee state))
                emit(start i1(ops.localGet state))
                emit(start i2(ops.structGet tRaised rt.field("raised" "desc")))
                emit(start i(ops.refIsNull))
                emit(start model.ifInst(option blockValue of model.BlockType with let type = model.eqref end ""))
                emit(start option instRefNull of Inst with let heap = option heapNone of model.HeapType end end)
                emit(start model.elseInst)
                runtimeUnitCall(start "wasm/print.init")
                emit(start i1(ops.globalGet g.noClosure))
                emit(start i1(ops.localGet state))
                emit(start i2(ops.structGet tRaised rt.field("raised" "payload")))
                emit(start i1(ops.localGet state))
                emit(start i2(ops.structGet tRaised rt.field("raised" "desc")))
                runtimeUnitCall(start "wasm/print.show")
                emit(start model.endInst)
                flushWriters(start)
                runtimeCall(start "uncaught")
                fill(start mainIndex + 1 "_start" placeholder)
                vector.append(m.exports tuple
                    let field = "_start"
                    let kind = option exportFunc of model.ExportKind end
                    let index = mainIndex + 1
                end)
            end
            if sb.length(g.strings) > 0 then
                vector.append(m.data
                        tuple let name = "strings" let bytes = sb.toString(g.strings) let offset = ~1 end)
            end
            (* The locals that are never live together share one *)
            reuse.reuse(m)
            m
        end
end
