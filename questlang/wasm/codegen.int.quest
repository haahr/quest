(* Quest Self-Hosted Compiler: The wasm Code Generator Interface
 *
 * A unit's represented IR (docs/ir.md) as a WebAssembly module on WasmGC
 * (wasm/model), as docs/wasm-plan.md specifies: values (section 2),
 * closures (section 3), the runtime it imports (section 4), and a module
 * for each unit (section 5.1).
 *
 * Values: an Int, Word, Bool, Char, or Real is a WebAssembly number; a
 * record is two values, its payload and its view's table, a variant two,
 * its tag and its payload, and a location (section 2.6) two, a slot array
 * and an index; anything else is an eqref, cast where it is used. A slot of
 * an aggregate holds each value boxed (section 2.1). Tuples are $tuples
 * over slots, and unboxed tuples (ir/unbox) a value for each component,
 * returned as several results; options are tagged in name order; arrays
 * test their indices and counts first. A value that may be a proxy, or
 * that is read through a view map, is read through the runtime's core.
 *
 * Code: statements' joins, loops, switches, and trys are blocks, branches,
 * and try_tables (section 4.1). A call of the unit's own function is
 * direct, and a tail call wherever its result reaches a return (section
 * 3.3); a call through a closure takes its native entry when the closure is
 * of the callee type's signature, else its uniform entry (section 3.1).
 * Division and remainder test their divisor before the instruction that
 * would trap (section 2.10).
 *
 * The runtime: the base, which wasm/runtime builds, and the units in Quest,
 * wasm/core and wasm/print (section 4.2). The library's externals compile
 * to calls of them, of util/realconv and util/realmath, or to instructions
 * in place, as do the intrinsics (section 4.5) that the runtime's units
 * use. The unit's initializer makes the descriptors its code needs through
 * the core.
 *
 * What it cannot compile raises unsupported, naming it; in a module's unit
 * (not a program's, nor the runtime's), a function it cannot compile ends
 * the program when it is called instead. *)

interface Codegen
import
    ir = questlang/ir/nodes : questlang/ir/Nodes
    questlang/wasm/model : questlang/wasm/Model
export
    unsupported: Exception(String)

    (* A unit's module (docs/wasm-plan.md section 5.1): a program's, which
     * exports _start, or a module file's, which exports its init, its
     * record's two globals, and its functions, each at its interface type's
     * closure signature. A phrase unit, a JIT's input, is compiled as a
     * module file's, its init running its top level. Each imports the units
     * it does by their names, a library unit's its path in lib/ *)
    unitModule(unit: ir.Unit): model.Module
end
