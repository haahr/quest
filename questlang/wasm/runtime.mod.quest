(* Quest Self-Hosted Compiler: The WebAssembly Runtime Implementation *)

module runtime : Runtime
import
    questlang/wasm/model : questlang/wasm/Model
    questlang/wasm/ops : questlang/wasm/Ops
    rt = questlang/wasm/runtimeTypes : questlang/wasm/RuntimeTypes
    collections/vector : collections/Vector
    stringOp = string : StringOp
    ascii : Ascii
    conv : Conv
export
    Def Export = Tuple field: String params: Array(model.ValType) results: Array(model.ValType) end
    Let Inst = model.Inst

    let name = "quest.runtime"
    let tagField = "error"

    let none = array of :model.ValType end
    let entry(field: String params: Array(model.ValType) results: Array(model.ValType)): Export =
        tuple let field = field let params = params let results = results end
    (* The functions of WASI's first preview the runtime imports besides
     * fd_write and proc_exit, each with its parameters (i an i32, I an i64);
     * each returns an errno *)
    let wasiFunctions = array of
        array of "args_sizes_get" "ii" end
        array of "args_get" "ii" end
        array of "environ_sizes_get" "ii" end
        array of "environ_get" "ii" end
        array of "fd_prestat_get" "ii" end
        array of "fd_prestat_dir_name" "iii" end
        array of "path_open" "iiiiiIIii" end
        array of "fd_read" "iiii" end
        array of "fd_close" "i" end
        array of "path_filestat_get" "iiiii" end
        array of "path_create_directory" "iii" end
        array of "path_unlink_file" "iii" end
        array of "path_remove_directory" "iii" end
        array of "path_rename" "iiiiii" end
        array of "fd_readdir" "iiiIi" end
    end
    let wasiCount = extent wasiFunctions
    let fixedExports = array of
        entry("putString" array of model.eqref model.eqref end array of model.eqref end)
        entry("putChar" array of model.eqref model.i32 end array of model.eqref end)
        entry("concat" array of model.eqref model.eqref end array of model.eqref end)
        entry("convInt" array of model.i64 end array of model.eqref end)
        entry("convBool" array of model.i32 end array of model.eqref end)
        entry("convChar" array of model.i32 end array of model.eqref end)
        entry("raise" array of model.eqref model.eqref model.eqref model.eqref model.i32 model.eqref end none)
        entry("uncaught" array of model.eqref model.eqref end none)
        entry("decimal" array of model.i64 end array of model.eqref end)
        entry("hex" array of model.i64 end array of model.eqref end)
        entry("escaped" array of model.eqref model.i32 end array of model.eqref end)
        entry("boxInt" array of model.i64 end array of model.eqref end)
        entry("unboxInt" array of model.eqref end array of model.i64 end)
        entry("fatal" array of model.eqref model.i32 end none)
        entry("stringGetChar" array of model.eqref model.i64 end array of model.i32 end)
        entry("stringSetChar" array of model.eqref model.i64 model.i32 end array of model.eqref end)
        entry("stringNew" array of model.i64 model.i32 end array of model.eqref end)
        entry("stringGetSub" array of model.eqref model.i64 model.i64 end array of model.eqref end)
        entry("stringSetSub" array of model.eqref model.i64 model.eqref model.i64 model.i64 end
            array of model.eqref end)
        entry("stringEqual" array of model.eqref model.eqref end array of model.i32 end)
        entry("exceptionOf" array of model.eqref end array of model.eqref end)
        entry("payloadOf" array of model.eqref end array of model.eqref end)
        (* A raised exception's text, as the uncaught report writes it after
         * "Exception: ": its name, and its payload, as shown writes it (or
         * the base's show, if shown is null), and its type *)
        entry("raisedText" array of model.eqref model.eqref end array of model.eqref end)
        (* Memory, for the core's calls of WASI: a byte, a 32-bit word, and a
         * 64-bit one, read and written at an address; the memory grown to
         * hold an address; n bytes from an address as a new string; a
         * string's bytes written at an address *)
        entry("memLoad8" array of model.i64 end array of model.i64 end)
        entry("memStore8" array of model.i64 model.i64 end none)
        entry("memLoad32" array of model.i64 end array of model.i64 end)
        entry("memStore32" array of model.i64 model.i64 end none)
        entry("memLoad64" array of model.i64 end array of model.i64 end)
        entry("memStore64" array of model.i64 model.i64 end none)
        entry("memEnsure" array of model.i64 end none)
        entry("memToString" array of model.i64 model.i64 end array of model.eqref end)
        entry("stringToMem" array of model.eqref model.i64 end none)
    end
    (* WASI's functions, each exported as wasi:NAME with its parameters and
     * its errno i64s *)
    let wasiExports: Array(Export) =
        begin
            let es = array of(wasiCount entry("" none none))
            for k = 0 upto wasiCount - 1 do
                es[k] := entry("wasi:" <> wasiFunctions[k][0]
                    array of(stringOp.length(wasiFunctions[k][1]) model.i64) array of model.i64 end)
            end
            es
        end
    let exports: Array(Export) =
        begin
            let es = array of({extent fixedExports} + wasiCount entry("" none none))
            for k = 0 upto extent fixedExports - 1 do es[k] := fixedExports[k] end
            for k = 0 upto wasiCount - 1 do es[{extent fixedExports} + k] := wasiExports[k] end
            es
        end

    (* The built-in exceptions, the C runtime's quest_exc globals, each a
     * global of the runtime exported as exception:NAME *)
    let builtinExceptions = array of
        "int.error" "real.error" "word.error" "string.error" "arrayOp.error" "variant.tagMismatch" "ascii.error"
        "dynamic.error" "writer.error" "reader.error" "system.error" "value.error" "readline.error"
    end
    let exceptionField(name: String): String = "exception:" <> name

    (* ======================================================================
     * Building
     * ====================================================================== *)

    let noArgs = array of :Int end
    let i(o: model.Op): Inst = model.op(o noArgs)
    let i1(o: model.Op a: Int): Inst = model.op(o array of a end)
    let i2(o: model.Op a: Int b: Int): Inst = model.op(o array of a b end)
    let c32(n: Int): Inst = model.i32Const(n)
    let empty = option blockEmpty of model.BlockType end
    let result(t: model.ValType): model.BlockType = option blockValue of model.BlockType with let type = t end
    let castTo(t: Int): Inst =
        option instRefCast of Inst with
            let type = tuple
                let nullable = false let heap = option heapIndex of model.HeapType with let index = t end
            end
        end
    let castI31: Inst =
        option instRefCast of Inst with
            let type = tuple let nullable = false let heap = option heapI31 of model.HeapType end end
        end
    let local(name: String t: model.ValType): model.Local = tuple let name = name let type = t end

    (* The function index of each import and function, in the order they are
     * added below *)
    let fdWrite = 0
    let procExit = 1
    let putString = 2 + wasiCount
    let putChar = 3 + wasiCount
    let concat = 4 + wasiCount
    let convInt = 5 + wasiCount
    let convBool = 6 + wasiCount
    let convChar = 7 + wasiCount
    let raiseIt = 8 + wasiCount
    let uncaught = 9 + wasiCount
    let decimal = 10 + wasiCount
    let hex = 11 + wasiCount
    let escaped = 12 + wasiCount
    let boxInt = 13 + wasiCount
    let unboxInt = 14 + wasiCount
    let fatal = 15 + wasiCount
    let stringGetChar = 16 + wasiCount
    let stringSetChar = 17 + wasiCount
    let stringNew = 18 + wasiCount
    let stringGetSub = 19 + wasiCount
    let stringSetSub = 20 + wasiCount
    let stringEqual = 21 + wasiCount
    let exceptionOf = 22 + wasiCount
    let payloadOf = 23 + wasiCount
    let ensure = 24 + wasiCount + {extent exports - 22}
    let digits = 25 + wasiCount + {extent exports - 22}
    let escapeChar = 26 + wasiCount + {extent exports - 22}
    let hexDigit = 27 + wasiCount + {extent exports - 22}
    let putByte = 28 + wasiCount + {extent exports - 22}
    let stringError = 29 + wasiCount + {extent exports - 22}
    let show = 30 + wasiCount + {extent exports - 22}

    (* The runtime's own text, in its one passive data segment: each string's
     * offset and length *)
    let text = "truefalseException: \n  at \nstring.error with :'\"ok16##<fun><hidden><val>"
    Def Piece = Tuple offset: Int length: Int end
    let piece(offset: Int length: Int): Piece = tuple let offset = offset let length = length end
    let trueText = piece(0 4)
    let falseText = piece(4 5)
    let exceptionText = piece(9 11)
    let atText = piece(20 6)
    let siteLead = piece(21 5)
    let newlineText = piece(26 1)
    let stringErrorText = piece(27 12)
    let emptyText = piece(0 0)
    let withText = piece(39 6)
    let colonText = piece(45 1)
    let apostropheText = piece(46 1)
    let quoteText = piece(47 1)
    let okText = piece(48 2)
    let hexPrefixText = piece(50 3)
    let hashText = piece(53 1)
    let funText = piece(54 5)
    let hiddenText = piece(59 8)
    let valText = piece(67 5)

    let runtimeModule(): model.Module =
        begin
            let m = model.newModule("quest.runtime")
            vector.append(:model.RecGroup m.types rt.group)
            let tString = rt.index("string")
            let tBytes = rt.index("bytes")
            let tBoxInt = rt.index("boxInt")
            let tException = rt.index("exception")
            let tRaised = rt.index("raised")
            (* The built-in exceptions, their names written out, as constant
             * expressions allow *)
            for k = 0 upto extent builtinExceptions - 1 do
                let exceptionName = builtinExceptions[k]
                let init = vector.new(:Inst)
                vector.append(:Inst init c32(0))
                vector.append(:Inst init c32(0))
                vector.append(:Inst init c32(stringOp.length(exceptionName)))
                for j = 0 upto stringOp.length(exceptionName) - 1 do
                    vector.append(:Inst init c32(ascii.val(stringOp.getChar(exceptionName j))))
                end
                vector.append(:Inst init i2(ops.arrayNewFixed tBytes stringOp.length(exceptionName)))
                vector.append(:Inst init i1(ops.structNew tString))
                vector.append(:Inst init i1(ops.structNew tException))
                vector.append(:model.Global m.globals tuple
                    let name = exceptionName let type = model.ref(tException) let mutable = false
                    let init = vector.toArray(:Inst init)
                end)
            end
            let sLength = rt.field("string" "length")
            let sBytes = rt.field("string" "bytes")
            let nullString = model.refNull(tString)
            let nullBytes = model.refNull(tBytes)
            let funcType(params: Array(model.ValType) results: Array(model.ValType)): Int =
                begin
                    let n = vector.length(:model.RecGroup m.types)
                    let base = {extent rt.group} + {n - 1}
                    vector.append(:model.RecGroup m.types array of
                        tuple let name = "" let final = true let supers = array of :Int end
                            let composite = option compFunc of model.Composite with
                                let params = params let results = results end
                        end
                    end)
                    base
                end
            (* A new string of the runtime's text, as its own bytes *)
            let pieceString(p: Piece): Array(Inst) =
                array of
                    c32(0) c32(p.length) c32(p.offset) c32(p.length) i2(ops.arrayNewData tBytes 0)
                    i1(ops.structNew tString)
                end
            let add(name: String t: Int params: Array(String) locals: Array(model.Local) body: Array(Inst)): Ok =
                vector.append(:model.Function m.functions tuple
                    let name = name let type = t let params = params
                    let locals = vector.fromArray(:model.Local locals) let body = vector.fromArray(:Inst body)
                end)
            let cat(parts: Array(Array(Inst))): Array(Inst) =
                begin
                    let all = vector.new(:Inst)
                    for k = 0 upto extent parts - 1 do
                        for j = 0 upto extent parts[k] - 1 do vector.append(:Inst all parts[k][j]) end
                    end
                    vector.toArray(:Inst all)
                end

            let wasi = "wasi_snapshot_preview1"
            vector.append(:model.Import m.imports tuple
                let moduleName = wasi let field = "fd_write" let name = "fdWrite"
                let kind = option importFunc of model.ImportKind with
                    let type = funcType(array of model.i32 model.i32 model.i32 model.i32 end array of model.i32 end)
                end
            end)
            vector.append(:model.Import m.imports tuple
                let moduleName = wasi let field = "proc_exit" let name = "procExit"
                let kind = option importFunc of model.ImportKind with
                    let type = funcType(array of model.i32 end none)
                end
            end)
            for k = 0 upto wasiCount - 1 do
                let ps = wasiFunctions[k][1]
                let params = array of(stringOp.length(ps) model.i32)
                for j = 0 upto stringOp.length(ps) - 1 do
                    if stringOp.getChar(ps j) is 'I' then params[j] := model.i64 end
                end
                vector.append(:model.Import m.imports tuple
                    let moduleName = wasi let field = wasiFunctions[k][0] let name = wasiFunctions[k][0]
                    let kind = option importFunc of model.ImportKind with
                        let type = funcType(params array of model.i32 end)
                    end
                end)
            end
            vector.append(:model.Memory m.memories tuple let name = "memory" let min = 1 let max = ~1 end)
            vector.append(:model.Tag m.tags
                tuple let name = "error" let type = funcType(array of model.eqref end none) end)
            vector.append(:model.Data m.data tuple let name = "text" let bytes = text let offset = ~1 end)
            let typeOf = array of(extent exports 0)
            for k = 0 upto extent exports - 1 do typeOf[k] := funcType(exports[k].params exports[k].results) end

            (* Bytes cross at 16 and up; the iovec is at 0, the count written
             * at 8 *)
            let write(fd: Array(Inst)): Array(Inst) = cat(array of
                array of c32(0) c32(16) i1(ops.i32Store 0) end
                fd
                array of c32(0) c32(1) c32(8) i1(ops.call fdWrite) i(ops.drop) end
            end)
            add("putString" typeOf[0] array of "w" "s" end
                array of local("str" nullString) local("n" model.i32) local("bytes" nullBytes) local("i" model.i32) end
                cat(array of array of
                    i1(ops.localGet 1) castTo(tString) i1(ops.localTee 2) i2(ops.structGet tString sLength)
                    i1(ops.localSet 3)
                    i1(ops.localGet 2) i2(ops.structGet tString sBytes) i1(ops.localSet 4)
                    i1(ops.localGet 3) c32(16) i(ops.i32Add) i1(ops.call ensure)
                    c32(0) i1(ops.localSet 5)
                    model.blockInst(empty "done") model.loopInst(empty "copy")
                    i1(ops.localGet 5) i1(ops.localGet 3) i(ops.i32GeU) i1(ops.brIf 1)
                    i1(ops.localGet 5) c32(16) i(ops.i32Add)
                    i1(ops.localGet 4) i1(ops.localGet 5) i1(ops.arrayGetU tBytes) i1(ops.i32Store8 0)
                    i1(ops.localGet 5) c32(1) i(ops.i32Add) i1(ops.localSet 5)
                    i1(ops.br 0)
                    model.endInst model.endInst
                    c32(4) i1(ops.localGet 3) i1(ops.i32Store 0)
                end
                write(array of i1(ops.localGet 0) castI31 i(ops.i31GetS) end)
                array of c32(0) i(ops.refI31) end
                end))
            add("putChar" typeOf[1] array of "w" "c" end array of :model.Local end cat(array of
                array of c32(16) i1(ops.localGet 1) i1(ops.i32Store8 0) c32(4) c32(1) i1(ops.i32Store 0) end
                write(array of i1(ops.localGet 0) castI31 i(ops.i31GetS) end)
                array of c32(0) i(ops.refI31) end
            end))
            add("concat" typeOf[2] array of "a" "b" end
                array of local("x" nullString) local("y" nullString) local("la" model.i32) local("lb" model.i32)
                    local("out" nullBytes) end
                array of
                    i1(ops.localGet 0) castTo(tString) i1(ops.localTee 2) i2(ops.structGet tString sLength)
                    i1(ops.localSet 4)
                    i1(ops.localGet 1) castTo(tString) i1(ops.localTee 3) i2(ops.structGet tString sLength)
                    i1(ops.localSet 5)
                    i1(ops.localGet 4) i1(ops.localGet 5) i(ops.i32Add) i1(ops.arrayNewDefault tBytes)
                    i1(ops.localSet 6)
                    i1(ops.localGet 6) c32(0) i1(ops.localGet 2) i2(ops.structGet tString sBytes) c32(0)
                    i1(ops.localGet 4)
                    i2(ops.arrayCopy tBytes tBytes)
                    i1(ops.localGet 6) i1(ops.localGet 4) i1(ops.localGet 3) i2(ops.structGet tString sBytes) c32(0)
                    i1(ops.localGet 5) i2(ops.arrayCopy tBytes tBytes)
                    c32(0) i1(ops.localGet 4) i1(ops.localGet 5) i(ops.i32Add) i1(ops.localGet 6) i(ops.refAsNonNull)
                    i1(ops.structNew tString)
                end)
            add("convInt" typeOf[3] array of "n" end array of :model.Local end array of
                i1(ops.localGet 0) c32(126) i1(ops.call digits)
            end)
            add("convBool" typeOf[4] array of "b" end array of :model.Local end cat(array of
                array of i1(ops.localGet 0) model.ifInst(result(model.eqref) "") end
                pieceString(trueText)
                array of model.elseInst end
                pieceString(falseText)
                array of model.endInst end
            end))
            add("convChar" typeOf[5] array of "c" end array of :model.Local end array of
                c32(0) c32(1) i1(ops.localGet 0) c32(1) i1(ops.arrayNew tBytes) i1(ops.structNew tString)
            end)
            (* Raises exception with its payload at site (section 2.9): its
             * state, which the one tag carries *)
            add("raise" typeOf[6] array of "exception" "payload" "site" "text" "kind" "desc" end
                array of :model.Local end
                array of
                    i1(ops.localGet 0) castTo(tException) i1(ops.localGet 1) i1(ops.localGet 2) i1(ops.localGet 3)
                    i1(ops.localGet 4) i1(ops.localGet 5) i1(ops.structNew tRaised) i1(ops.throw 0)
                end)
            (* An uncaught exception's report, as quest_reraise writes it, less
             * the frames (decision 12): Exception: NAME, with its payload as
             * echo writes it and its type, and the raise's site *)
            add("uncaught" typeOf[7] array of "state" "shown" end
                array of local("s" model.refNull(tRaised)) local("report" model.eqref) local("kind" model.i32) end
                cat(array of
                    array of i1(ops.localGet 0) castTo(tRaised) i1(ops.localSet 2) end
                    pieceString(exceptionText)
                    array of
                        i1(ops.localGet 2) i2(ops.structGet tRaised 0) i2(ops.structGet tException 1)
                        i1(ops.call concat) i1(ops.localSet 3)
                        i1(ops.localGet 2) i2(ops.structGet tRaised 4) i1(ops.localTee 4)
                        model.ifInst(empty "")
                        i1(ops.localGet 3)
                    end
                    pieceString(withText)
                    array of
                        i1(ops.call concat)
                        i1(ops.localGet 1) i(ops.refIsNull)
                        model.ifInst(option blockValue of model.BlockType with let type = model.eqref end "")
                        i1(ops.localGet 2) i2(ops.structGet tRaised 1) i1(ops.localGet 4) i1(ops.call show)
                        model.elseInst i1(ops.localGet 1) model.endInst
                        i1(ops.call concat)
                    end
                    pieceString(colonText)
                    array of
                        i1(ops.call concat) i1(ops.localGet 2) i2(ops.structGet tRaised 3) i1(ops.call concat)
                        i1(ops.localSet 3)
                        model.endInst
                        i1(ops.localGet 3)
                    end
                    pieceString(newlineText)
                    array of
                        i1(ops.call concat) i1(ops.localSet 3)
                        i1(ops.localGet 2) i2(ops.structGet tRaised 2) castTo(tString) i2(ops.structGet tString sLength)
                        i(ops.i32Eqz) i(ops.i32Eqz)
                        model.ifInst(empty "")
                        i1(ops.localGet 3)
                    end
                    pieceString(siteLead)
                    array of i1(ops.call concat) i1(ops.localGet 2) i2(ops.structGet tRaised 2) i1(ops.call concat) end
                    pieceString(newlineText)
                    array of
                        i1(ops.call concat) i1(ops.localSet 3)
                        model.endInst
                        c32(2) i(ops.refI31) i1(ops.localGet 3) i1(ops.call putString) i(ops.drop)
                        c32(1) i1(ops.call procExit)
                    end
                end))
            add("decimal" typeOf[8] array of "n" end array of :model.Local end array of
                i1(ops.localGet 0) c32(45) i1(ops.call digits)
            end)
            (* w in hexadecimal, lower case, as printf's %llx *)
            add("hex" typeOf[9] array of "w" end
                array of local("buf" nullBytes) local("p" model.i32) local("m" model.i64) local("out" nullBytes) end
                array of
                    c32(16) i1(ops.arrayNewDefault tBytes) i1(ops.localSet 1)
                    c32(16) i1(ops.localSet 2)
                    i1(ops.localGet 0) i1(ops.localSet 3)
                    model.loopInst(empty "digit")
                    i1(ops.localGet 2) c32(1) i(ops.i32Sub) i1(ops.localSet 2)
                    i1(ops.localGet 1) i1(ops.localGet 2)
                    i1(ops.localGet 3) model.i64Const(15) i(ops.i64And) i(ops.i32WrapI64) i1(ops.call hexDigit)
                    i1(ops.arraySet tBytes)
                    i1(ops.localGet 3) model.i64Const(4) i(ops.i64ShrU) i1(ops.localTee 3) model.i64Const(0)
                    i(ops.i64Ne) i1(ops.brIf 0)
                    model.endInst
                    c32(16) i1(ops.localGet 2) i(ops.i32Sub) i1(ops.arrayNewDefault tBytes) i1(ops.localSet 4)
                    i1(ops.localGet 4) c32(0) i1(ops.localGet 1) i1(ops.localGet 2) c32(16) i1(ops.localGet 2)
                    i(ops.i32Sub) i2(ops.arrayCopy tBytes tBytes)
                    c32(0) c32(16) i1(ops.localGet 2) i(ops.i32Sub) i1(ops.localGet 4) i(ops.refAsNonNull)
                    i1(ops.structNew tString)
                end)
            (* s's bytes escaped as echo writes them inside quotes quote
             * (quest_escape_char): the length found first, then the bytes *)
            let printable = array of
                i1(ops.localGet 9) c32(32) i(ops.i32GeU) i1(ops.localGet 9) c32(126) i(ops.i32LeU) i(ops.i32And)
            end
            let put(b: Array(Inst)): Array(Inst) = cat(array of
                array of i1(ops.localGet 7) i1(ops.localGet 8) end
                b
                array of i1(ops.call putByte) i1(ops.localSet 8) end
            end)
            (* Each byte of s in turn as local 9, i from 0 *)
            let eachByte(each: Array(Inst)): Array(Inst) = cat(array of
                array of
                    c32(0) i1(ops.localSet 5)
                    model.blockInst(empty "") model.loopInst(empty "")
                    i1(ops.localGet 5) i1(ops.localGet 3) i(ops.i32GeU) i1(ops.brIf 1)
                    i1(ops.localGet 4) i1(ops.localGet 5) i1(ops.arrayGetU tBytes) i1(ops.localSet 9)
                end
                each
                array of
                    i1(ops.localGet 5) c32(1) i(ops.i32Add) i1(ops.localSet 5)
                    i1(ops.br 0) model.endInst model.endInst
                end
            end)
            add("escaped" typeOf[10] array of "s" "quote" end
                array of local("str" nullString) local("n" model.i32) local("bytes" nullBytes) local("i" model.i32)
                    local("length" model.i32) local("out" nullBytes) local("j" model.i32) local("c" model.i32)
                    local("e" model.i32) end
                cat(array of
                    array of
                        i1(ops.localGet 0) castTo(tString) i1(ops.localTee 2) i2(ops.structGet tString sLength)
                        i1(ops.localSet 3)
                        i1(ops.localGet 2) i2(ops.structGet tString sBytes) i1(ops.localSet 4)
                        c32(0) i1(ops.localSet 6)
                    end
                    eachByte(cat(array of
                        array of
                            i1(ops.localGet 6) i1(ops.localGet 9) i1(ops.localGet 1) i1(ops.call escapeChar)
                            model.ifInst(result(model.i32) "") c32(2) model.elseInst
