             * direct call passes its unit's own (docs/wasm-plan.md step 11) *)
            vector.append(:model.Export m.exports tuple
                let field = "noClosure" let kind = option exportGlobal of model.ExportKind end
                let index = vector.length(:model.Global m.globals)
            end)
            vector.append(:model.Global m.globals tuple
                let name = "noClosure" let type = model.ref(rt.index("clos")) let mutable = false
                let init = array of c32(0) i1(ops.structNew rt.index("clos")) end
            end)
            for k = 0 upto extent builtinExceptions - 1 do
                vector.append(:model.Export m.exports tuple
                    let field = exceptionField(builtinExceptions[k])
                    let kind = option exportGlobal of model.ExportKind end
                    let index = k
                end)
            end
            vector.append(:model.Export m.exports
                tuple let field = tagField let kind = option exportTag of model.ExportKind end let index = 0 end)
            for k = 0 upto extent exports - 1 do
                vector.append(:model.Export m.exports tuple
                    let field = exports[k].field let kind = option exportFunc of model.ExportKind end
                    let index = {2 + wasiCount} + k
                end)
            end
            m
        end
end
