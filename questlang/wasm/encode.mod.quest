(* Quest Self-Hosted Compiler: The WebAssembly Encoder Implementation *)

module encode : Encode
import
    questlang/wasm/model : questlang/wasm/Model
    collections/vector : collections/Vector
    sb = util/stringBuilder : util/StringBuilder
    ascii : Ascii
    word : Word
    conv : Conv
    stringOp = string : StringOp
export
    Let Builder = sb.T
    Let Module = model.Module
    Let ValType = model.ValType
    Let HeapType = model.HeapType
    Let Inst = model.Inst

    let fail(what: String): Ok = raise model.malformed with what end

    (* ======================================================================
     * Numbers, names, and vectors
     * ====================================================================== *)

    let byte(b: Builder n: Int): Ok = begin sb.char(b ascii.char(n)) ok end

    (* An unsigned LEB128 number, n from 0 to 2^32 - 1 *)
    let u32(b: Builder n: Int): Ok =
        begin
            if {n < 0} orif {n > 0xFFFFFFFF} then fail("the unsigned 32-bit number " <> conv.int(n)) end
            let var v = n
            loop
                let low = v - {{v / 128} * 128}
                v := v / 128
                if v is 0 then
                    byte(b low)
                    exit
                end
                byte(b low + 128)
            end
        end

    (* A signed LEB128 number, any Int: 7 bits at a time from the bottom, the
     * rest shifted arithmetically, until what is left is all sign *)
    let sleb(b: Builder n: Int): Ok =
        begin
            let var v = n
            loop
                let low = word.toInt(word.extract(word.fromInt(v) 0 7))
                (* v shifted right by 7, rounding toward minus infinity *)
                v := if v >= 0 then v / 128 else {0 - 1} - {{{0 - 1} - v} / 128} end
                let signBit = low >= 64
                if {{v is 0} andif not(signBit)} orif {{v is ~1} andif signBit} then
                    byte(b low)
                    exit
                end
                byte(b low + 128)
            end
        end

    let s32(b: Builder n: Int): Ok =
        begin
            if {n < ~0x80000000} orif {n > 0x7FFFFFFF} then fail("the signed 32-bit number " <> conv.int(n)) end
            sleb(b n)
        end

    (* A name or a string of bytes: its length and its bytes *)
    let name(b: Builder s: String): Ok =
        begin
            u32(b stringOp.length(s))
            sb.str(b s) ok
        end

    (* What one builder holds, after its length, as a section or a function's
     * body is written *)
    let sized(b: Builder inner: Builder): Ok =
        begin
            u32(b sb.length(inner))
            sb.strShared(b sb.toString(inner)) ok
        end

    let section(b: Builder id: Int inner: Builder): Ok =
        begin
            byte(b id)
            sized(b inner)
        end

    let customSection(title: String bytes: String): String =
        begin
            let inner = sb.new()
            name(inner title)
            sb.str(inner bytes)
            let b = sb.new()
            section(b 0 inner)
            sb.toString(b)
        end

    (* ======================================================================
     * Types
     * ====================================================================== *)

    (* An abstract heap type is one byte; a type index is a signed LEB128
     * number, as is a block type's index, so that its first byte, positive,
     * is never taken for an abstract type's code, which read signed is
     * negative *)
    let heapType(b: Builder h: HeapType): Ok =
        case h
            when heapAny then byte(b 0x6E) when heapEq then byte(b 0x6D) when heapI31 then byte(b 0x6C)
            when heapStruct then byte(b 0x6B) when heapArray then byte(b 0x6A) when heapNone then byte(b 0x71)
            when heapFunc then byte(b 0x70) when heapNoFunc then byte(b 0x73) when heapExtern then byte(b 0x6F)
            when heapNoExtern then byte(b 0x72) when heapExn then byte(b 0x69) when heapNoExn then byte(b 0x74)
            when heapIndex with x then
                if x.index < 0 then fail("the type index " <> conv.int(x.index)) end
                sleb(b x.index)
        end

    (* A reference type: a nullable abstract one in its byte alone, as the
     * text's eqref is, any other after 0x63 (nullable) or 0x64 *)
    let refType(b: Builder nullable: Bool h: HeapType): Ok =
        if nullable andif not(h?heapIndex) then heapType(b h)
        else
            byte(b if nullable then 0x63 else 0x64 end)
            heapType(b h)
        end

    let valType(b: Builder t: ValType): Ok =
        case t
            when valI32 then byte(b 0x7F) when valI64 then byte(b 0x7E) when valF32 then byte(b 0x7D)
            when valF64 then byte(b 0x7C)
            when valRef with x then refType(b x.nullable x.heap)
        end

    let valTypes(b: Builder ts: Array(ValType)): Ok =
        begin
            u32(b extent ts)
            for i = 0 upto extent ts - 1 do valType(b ts[i]) end
        end

    let field(b: Builder f: model.Field): Ok =
        begin
            case f.storage
                when storageI8 then byte(b 0x78)
                when storageI16 then byte(b 0x77)
                when storageValue with x then valType(b x.type)
            end
            byte(b if f.mutable then 1 else 0 end)
        end

    let composite(b: Builder c: model.Composite): Ok =
        case c
            when compFunc with x then
                byte(b 0x60)
                valTypes(b x.params)
                valTypes(b x.results)
            when compStruct with x then
                byte(b 0x5F)
                u32(b extent x.fields)
                for i = 0 upto extent x.fields - 1 do field(b x.fields[i]) end
            when compArray with x then
                byte(b 0x5E)
                field(b x.element)
        end

    let subType(b: Builder t: model.SubType): Ok =
        begin
            if {extent t.supers} > 1 then fail("type " <> t.name <> " has more than one supertype") end
            if t.final andif {extent t.supers is 0} then composite(b t.composite)
            else
                byte(b if t.final then 0x4F else 0x50 end)
                u32(b extent t.supers)
                for i = 0 upto extent t.supers - 1 do u32(b t.supers[i]) end
                composite(b t.composite)
            end
        end

    let typeSection(b: Builder m: Module): Ok =
        begin
            let groups = m.types
            if vector.length(groups) > 0 then
                let s = sb.new()
                u32(s vector.length(groups))
                for g = 0 upto vector.length(groups) - 1 do
                    let group = vector.get(groups g)
                    if extent group is 1 then subType(s group[0])
                    else
                        byte(s 0x4E)
                        u32(s extent group)
                        for i = 0 upto extent group - 1 do subType(s group[i]) end
                    end
                end
                section(b 1 s)
            end
        end

    (* ======================================================================
     * Instructions
     * ====================================================================== *)

    let blockType(b: Builder t: model.BlockType): Ok =
        case t
            when blockEmpty then byte(b 0x40)
            when blockValue with x then valType(b x.type)
            when blockIndex with x then sleb(b x.index)
        end

    let opcode(b: Builder prefix: Int code: Int): Ok =
        if prefix is 0 then byte(b code)
        else
            byte(b prefix)
            u32(b code)
        end

    let instruction(b: Builder i: Inst): Ok =
        case i
            when instOp with x then
                let o = x.op
                if {extent x.args} isnot {extent o.imms} then
                    fail(o.name <> " has " <> conv.int(extent x.args) <> " immediates, not "
                         <> conv.int(extent o.imms))
                end
                opcode(b o.prefix o.code)
                for k = 0 upto extent o.imms - 1 do
                    let a = x.args[k]
                    case o.imms[k]
                        when immI32 then s32(b a)
                        when immI64 then sleb(b a)
                        when immOffset then
                            u32(b o.align)
                            u32(b a)
                        else u32(b a)
                    end
                end
            when instBlock with x then
                byte(b case x.kind when kindBlock then 0x02 when kindLoop then 0x03 when kindIf then 0x04 end)
                blockType(b x.type)
            when instTryTable with x then
                byte(b 0x1F)
                blockType(b x.type)
                u32(b extent x.catches)
                for k = 0 upto extent x.catches - 1 do
                    let c = x.catches[k]
                    case c.kind
                        when catchTag then
                            byte(b 0)
                            u32(b c.tag)
                        when catchTagRef then
                            byte(b 1)
                            u32(b c.tag)
                        when catchAll then byte(b 2)
                        when catchAllRef then byte(b 3)
                    end
                    u32(b c.label)
                end
            when instElse then byte(b 0x05)
            when instEnd then byte(b 0x0B)
            when instBrTable with x then
                byte(b 0x0E)
                u32(b extent x.labels)
                for k = 0 upto extent x.labels - 1 do u32(b x.labels[k]) end
                u32(b x.default)
            when instF64Const with x then
                byte(b 0x44)
                let w = word.fromInt(x.bits)
                for k = 0 upto 7 do byte(b word.toInt(word.extract(w {8 * k} 8))) end
            when instRefNull with x then
                byte(b 0xD0)
                heapType(b x.heap)
            when instRefTest with x then
                opcode(b 0xFB if x.type.nullable then 21 else 20 end)
                heapType(b x.type.heap)
            when instRefCast with x then
                opcode(b 0xFB if x.type.nullable then 23 else 22 end)
                heapType(b x.type.heap)
            when instBrOnCast with x then
                opcode(b 0xFB if x.fail then 25 else 24 end)
                (* flags: bit 0 the source type nullable, bit 1 the target *)
                byte(b {if x.from.nullable then 1 else 0 end} + {if x.to.nullable then 2 else 0 end})
                u32(b x.label)
                heapType(b x.from.heap)
                heapType(b x.to.heap)
            when instSelect with x then
                if extent x.types is 0 then byte(b 0x1B)
                else
                    byte(b 0x1C)
                    valTypes(b x.types)
                end
        end

    (* A constant expression, and its end *)
    let expression(b: Builder insts: Array(Inst)): Ok =
        begin
            for k = 0 upto extent insts - 1 do instruction(b insts[k]) end
            byte(b 0x0B)
        end

    (* Whether an instruction names a data segment, which requires the data
     * count section *)
    let namesData(i: Inst): Bool =
        case i
            when instOp with x then
                let var found = false
                for k = 0 upto extent x.op.imms - 1 do if x.op.imms[k]?immData then found := true end end
                found
            else false
        end

    (* ======================================================================
     * Sections
     * ====================================================================== *)

    let limits(b: Builder min: Int max: Int): Ok =
        if max < 0 then
            byte(b 0x00)
            u32(b min)
        else
            byte(b 0x01)
            u32(b min)
            u32(b max)
        end

    let importSection(b: Builder m: Module): Ok =
        if vector.length(m.imports) > 0 then
            let s = sb.new()
            u32(s vector.length(m.imports))
            for k = 0 upto vector.length(m.imports) - 1 do
                let i = vector.get(m.imports k)
                name(s i.moduleName)
                name(s i.field)
                case i.kind
                    when importFunc with x then
                        byte(s 0x00)
                        u32(s x.type)
                    when importMemory with x then
                        byte(s 0x02)
                        limits(s x.min x.max)
                    when importGlobal with x then
                        byte(s 0x03)
                        valType(s x.type)
                        byte(s if x.mutable then 1 else 0 end)
                    when importTag with x then
                        byte(s 0x04)
                        byte(s 0x00)
                        u32(s x.type)
                end
            end
            section(b 2 s)
        end

    let functionSection(b: Builder m: Module): Ok =
        if vector.length(m.functions) > 0 then
            let s = sb.new()
            u32(s vector.length(m.functions))
            for k = 0 upto vector.length(m.functions) - 1 do
                u32(s vector.get(m.functions k).type)
            end
            section(b 3 s)
        end

    let memorySection(b: Builder m: Module): Ok =
        if vector.length(m.memories) > 0 then
            let s = sb.new()
            u32(s vector.length(m.memories))
            for k = 0 upto vector.length(m.memories) - 1 do
                let mem = vector.get(m.memories k)
                limits(s mem.min mem.max)
            end
            section(b 5 s)
        end

    let tagSection(b: Builder m: Module): Ok =
        if vector.length(m.tags) > 0 then
            let s = sb.new()
            u32(s vector.length(m.tags))
            for k = 0 upto vector.length(m.tags) - 1 do
                byte(s 0x00)
                u32(s vector.get(m.tags k).type)
            end
            section(b 13 s)
        end

    let globalSection(b: Builder m: Module): Ok =
        if vector.length(m.globals) > 0 then
            let s = sb.new()
            u32(s vector.length(m.globals))
            for k = 0 upto vector.length(m.globals) - 1 do
                let g = vector.get(m.globals k)
                valType(s g.type)
                byte(s if g.mutable then 1 else 0 end)
                expression(s g.init)
            end
            section(b 6 s)
        end

    let exportSection(b: Builder m: Module): Ok =
        if vector.length(m.exports) > 0 then
            let s = sb.new()
            u32(s vector.length(m.exports))
            for k = 0 upto vector.length(m.exports) - 1 do
                let e = vector.get(m.exports k)
                name(s e.field)
                byte(s case e.kind
                    when exportFunc then 0 when exportMemory then 2 when exportGlobal then 3 when exportTag then 4
                end)
                u32(s e.index)
            end
            section(b 7 s)
        end

    let startSection(b: Builder m: Module): Ok =
        if m.start >= 0 then
            let s = sb.new()
            u32(s m.start)
            section(b 8 s)
        end

    (* The functions ref.func takes, in one declarative segment (flags 3) of
     * function indices (element kind 0, funcref) *)
    let elementSection(b: Builder m: Module): Ok =
        if vector.length(m.declared) > 0 then
            let s = sb.new()
            u32(s 1)
            u32(s 3)
            byte(s 0x00)
            u32(s vector.length(m.declared))
            for k = 0 upto vector.length(m.declared) - 1 do u32(s vector.get(m.declared k)) end
            section(b 9 s)
        end

    let dataCountSection(b: Builder m: Module): Ok =
        begin
            let var needed = false
            for k = 0 upto vector.length(m.functions) - 1 do
                let body = vector.get(m.functions k).body
                for j = 0 upto vector.length(body) - 1 do
                    if namesData(vector.get(body j)) then needed := true end
                end
            end
            if needed then
                let s = sb.new()
                u32(s vector.length(m.data))
                section(b 12 s)
            end
        end

    (* Whether two value types are one, which their encodings say *)
    let sameType(x: ValType y: ValType): Bool =
        begin
            let a = sb.new()
            let c = sb.new()
            valType(a x)
            valType(c y)
            stringOp.equal(sb.toString(a) sb.toString(c))
        end

    (* A function's locals, after its parameters, in runs of one type *)
    let locals(b: Builder ls: vector.T(model.Local)): Ok =
        begin
            let n = vector.length(ls)
            let runs = vector.new(:Int)
            for k = 0 upto n - 1 do
                if k is 0 then vector.append(runs k)
                elsif not(sameType(vector.get(ls k).type vector.get(ls {k - 1}).type)) then
                    vector.append(runs k)
                end
            end
            u32(b vector.length(runs))
            for r = 0 upto vector.length(runs) - 1 do
                let first = vector.get(runs r)
                let next = if {r + 1} < vector.length(runs) then vector.get(runs {r + 1}) else n end
                u32(b next - first)
                valType(b vector.get(ls first).type)
            end
        end

    let codeSection(b: Builder m: Module): Ok =
        if vector.length(m.functions) > 0 then
            let s = sb.new()
            u32(s vector.length(m.functions))
            for k = 0 upto vector.length(m.functions) - 1 do
                let f = vector.get(m.functions k)
                let body = sb.new()
                locals(body f.locals)
                for j = 0 upto vector.length(f.body) - 1 do instruction(body vector.get(f.body j)) end
                byte(body 0x0B)
                sized(s body)
            end
            section(b 10 s)
        end

    let dataSection(b: Builder m: Module): Ok =
        if vector.length(m.data) > 0 then
            let s = sb.new()
            u32(s vector.length(m.data))
            for k = 0 upto vector.length(m.data) - 1 do
                let d = vector.get(m.data k)
                if d.offset < 0 then u32(s 1)
                else
                    u32(s 0)
                    expression(s array of model.i32Const(d.offset) end)
                end
                name(s d.bytes)
            end
            section(b 11 s)
        end

    (* ======================================================================
     * The name section
     * ====================================================================== *)

    (* A name map of the names given, by index, leaving out the empty ones;
     * whether there was any *)
    let nameMap(b: Builder names: Array(String)): Bool =
        begin
            let var n = 0
            for k = 0 upto extent names - 1 do if not(stringOp.isEmpty(names[k])) then n := n + 1 end end
            u32(b n)
            for k = 0 upto extent names - 1 do
                if not(stringOp.isEmpty(names[k])) then
                    u32(b k)
                    name(b names[k])
                end
            end
            n > 0
        end

    (* A subsection of names, if it has any *)
    let subsection(b: Builder id: Int names: Array(String)): Ok =
        begin
            let s = sb.new()
            if nameMap(s names) then section(b id s) end
        end

    (* An indirect name map's subsection: for each index outer gives with any
     * names, those names *)
    let indirect(b: Builder id: Int outer: Array(Int) inner: Array(Array(String))): Ok =
        begin
            let s = sb.new()
            let var n = 0
            for k = 0 upto extent outer - 1 do
                let one = sb.new()
                if nameMap(one inner[k]) then n := n + 1 end
            end
            if n > 0 then
                u32(s n)
                for k = 0 upto extent outer - 1 do
                    let one = sb.new()
                    if nameMap(one inner[k]) then
                        u32(s outer[k])
                        sb.strShared(s sb.toString(one)) ok
                    end
                end
                section(b id s)
            end
        end

    (* The names of the imports of a kind and then of the definitions *)
    let spaceNames(m: Module kind: All(k: model.ImportKind) Bool defined: Array(String)): Array(String) =
        begin
            let names = vector.new(:String)
            for k = 0 upto vector.length(m.imports) - 1 do
                let i = vector.get(m.imports k)
                if kind(i.kind) then vector.append(names i.name) end
            end
            for k = 0 upto extent defined - 1 do vector.append(names defined[k]) end
            vector.toArray(names)
        end

    (* The labels of a function's structured instructions, in order *)
    let labels(f: model.Function): Array(String) =
        begin
            let names = vector.new(:String)
            for j = 0 upto vector.length(f.body) - 1 do
                case vector.get(f.body j)
                    when instBlock with x then vector.append(names x.label)
                    when instTryTable with x then vector.append(names x.label)
                    else ok
                end
            end
            vector.toArray(names)
        end

    let isFunc(k: model.ImportKind): Bool = k?importFunc
    let isMemory(k: model.ImportKind): Bool = k?importMemory
    let isGlobal(k: model.ImportKind): Bool = k?importGlobal
    let isTag(k: model.ImportKind): Bool = k?importTag

    (* The local names of a defined function: its parameters', then its
     * other locals' *)
    let localNames(f: model.Function): Array(String) =
        begin
            let ls = vector.new(:String)
            for k = 0 upto extent f.params - 1 do vector.append(ls f.params[k]) end
            for k = 0 upto vector.length(f.locals) - 1 do
                vector.append(ls vector.get(f.locals k).name)
            end
            vector.toArray(ls)
        end

    (* A struct type's field names; none for another type *)
    let fieldNames(t: model.SubType): Array(String) =
        case t.composite
            when compStruct with x then
                let names = array of(extent x.fields "")
                for k = 0 upto extent x.fields - 1 do names[k] := x.fields[k].name end
                names
            else array of :String end
        end

    (* The custom section "name", its subsections by id in increasing order,
     * as the format requires: 0 the module, 1 functions, 2 locals, 3
     * labels, 4 types, 6 memories, 7 globals, 9 data segments, 10 fields,
     * and 11 tags; one with no names is left out *)
    let nameSection(b: Builder m: Module): Ok =
        begin
            let s = sb.new()
            if not(stringOp.isEmpty(m.name)) then
                let one = sb.new()
                name(one m.name)
                section(s 0 one)
            end
            let nf = vector.length(m.functions)
            let imported = model.importedFunctions(m)
            let functionNames = array of(nf "")
            let defined = array of(nf 0)
            let locals = array of(nf array of :String end)
            let blockLabels = array of(nf array of :String end)
            for k = 0 upto nf - 1 do
                let f = vector.get(m.functions k)
                functionNames[k] := f.name
                defined[k] := imported + k
                locals[k] := localNames(f)
                blockLabels[k] := labels(f)
            end
            subsection(s 1 spaceNames(m isFunc functionNames))
            indirect(s 2 defined locals)
            indirect(s 3 defined blockLabels)
            let types = vector.new(:model.SubType)
            for g = 0 upto vector.length(m.types) - 1 do
                let group = vector.get(m.types g)
                for k = 0 upto extent group - 1 do vector.append(types group[k]) end
            end
            let nt = vector.length(types)
            let typeNames = array of(nt "")
            let typeIndices = array of(nt 0)
            let fields = array of(nt array of :String end)
            for k = 0 upto nt - 1 do
                typeNames[k] := vector.get(types k).name
                typeIndices[k] := k
                fields[k] := fieldNames(vector.get(types k))
            end
            subsection(s 4 typeNames)
            let memoryNames = array of(vector.length(m.memories) "")
            for k = 0 upto extent memoryNames - 1 do memoryNames[k] := vector.get(m.memories k).name end
            subsection(s 6 spaceNames(m isMemory memoryNames))
            let globalNames = array of(vector.length(m.globals) "")
            for k = 0 upto extent globalNames - 1 do globalNames[k] := vector.get(m.globals k).name end
            subsection(s 7 spaceNames(m isGlobal globalNames))
            let dataNames = array of(vector.length(m.data) "")
            for k = 0 upto extent dataNames - 1 do dataNames[k] := vector.get(m.data k).name end
            subsection(s 9 dataNames)
            indirect(s 10 typeIndices fields)
            let tagNames = array of(vector.length(m.tags) "")
            for k = 0 upto extent tagNames - 1 do tagNames[k] := vector.get(m.tags k).name end
            subsection(s 11 spaceNames(m isTag tagNames))
            if sb.length(s) > 0 then
                let custom = sb.new()
                name(custom "name")
                sb.strShared(custom sb.toString(s))
                section(b 0 custom)
            end
        end

    let encode(m: Module): String =
        begin
            let b = sb.new()
            (* The magic number, "\0asm", and the version, 1 *)
            sb.str(b "\x00asm\x01\x00\x00\x00")
            (* The sections in the order the format requires, which is not
             * their ids': the tag section (13) between memory and global, the
             * data count (12) before code *)
            typeSection(b m)
            importSection(b m)
            functionSection(b m)
            memorySection(b m)
            tagSection(b m)
            globalSection(b m)
            exportSection(b m)
            startSection(b m)
            elementSection(b m)
            dataCountSection(b m)
            codeSection(b m)
            dataSection(b m)
            nameSection(b m)
            sb.toString(b)
        end
end
