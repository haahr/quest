(* Quest Self-Hosted Compiler: The WebAssembly Runtime Interface
 *
 * The runtime module that every unit the wasm backend compiles imports
 * (docs/wasm-plan.md section 4.2), as the module named name: its exception
 * tag, the memory that bytes cross to the host in (section 4.4), and the
 * functions compiled code calls. It is built here, from wasm/model, for what
 * step 3 compiles: strings' text and output, Int, Bool, and Char written as
 * text, as conv and as echo writes them, and run-time errors with their
 * uncaught report; and, from step 4, Ints in slots and string's externals.
 * The plan's runtime in Quest, over intrinsics, replaces it from step 6,
 * behind the same exports.
 *
 * Every reference crosses as an eqref (section 3.2); the runtime casts. The
 * host it imports is WASI's first preview, fd_write and proc_exit, which
 * wasmtime provides, and runtime/wasm/run.mjs for node. *)

interface Runtime
import
    questlang/wasm/model : questlang/wasm/Model
export
    (* The module name units import the runtime by; not a unit's canonical
     * name, which has no dot *)
    name: String

    (* A function the runtime exports, by its field, and its type *)
    Def Export = Tuple field: String params: Array(model.ValType) results: Array(model.ValType) end

    (* The functions, each with the field compiled code imports it by:
     *
     *   putString(w s): Ok      s's bytes to the stream w (an i31, its file
     *                            descriptor: 1 for writer.output, 2 for
     *                            writer.error)
     *   putChar(w c): Ok         one byte to the stream w
     *   concat(a b): String      a's bytes, then b's, as a new string
     *   convInt(n): String       n in decimal, ~ for negatives, as conv.int
     *   convBool(b): String      "true" or "false"
     *   convChar(c): String      the one character c
     *   raise(exception payload site text kind desc)
     *                            raises exception with its payload (ok for
     *                            none) at site ("file:line:col", or empty);
     *                            text is the payload's type as the raise
     *                            wrote it, kind how its value is written in
     *                            the report (0 for no payload, 9 by its
     *                            descriptor), and desc that descriptor, or
     *                            null
     *   uncaught(state shown)    writes an uncaught exception's report to
     *                            standard error and ends the program with
     *                            status 1; shown is the payload as text,
     *                            which wasm/print writes for kind 9, or null
     *   decimal(n): String       n in decimal, - for negatives, as echo
     *   hex(w): String           w in hexadecimal, lower case, as echo
     *   escaped(s quote): String s's bytes as echo writes them between
     *                            quotes quote (' or "): \n, \t, \r, \\,
     *                            the quote, and others not printable as
     *                            \xhh
     *   boxInt(n): eqref         n as a slot holds it: an i31 if it fits 31
     *                            bits, signed, else a $boxInt
     *   unboxInt(e): Int         the Int a slot holds
     *   fatal(report status)     writes the report to standard error and
     *                            ends the program with status, as a fatal
     *                            error (1) or running out of memory (70)
     *   stringGetChar, stringSetChar, stringNew, stringGetSub, stringSetSub,
     *   stringEqual              string's externals, raising string.error
     *                            for an index or a size outside a string
     *   exceptionOf(x)           the exception a handler's state holds, or x
     *                            itself, an exception
     *   payloadOf(state)         a raised exception's payload *)
    exports: Array(Export)

    (* The tag every Quest exception is thrown with, of one eqref, a raised
     * exception's state ($raised), and the field it is exported by *)
    tagField: String

    (* The built-in exceptions, by name (as "int.error"), each a global the
     * runtime exports by exceptionField(name), in this order *)
    builtinExceptions: Array(String)
    exceptionField(name: String): String

    (* The runtime module itself, with R first (wasm/runtimeTypes) *)
    runtimeModule(): model.Module
end
