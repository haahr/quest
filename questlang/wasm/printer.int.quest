(* Quest Self-Hosted Compiler: The WebAssembly Printer Interface
 *
 * A module (wasm/model) in the text format, which wasm-tools parse turns
 * into exactly the bytes wasm/encode writes (docs/wasm-plan.md section 8.1,
 * step 2): the form of the wasm backend's goldens, and what a person reads.
 * Instructions are written flat, one to a line, indented by the structured
 * instructions they are in; an index is written as its $name when it has
 * one, a branch's depth as its label's, and every other as a number. A
 * function's type is always written by index, with its parameters and
 * results after it, so that no type is made implicitly. *)

interface Printer
import
    questlang/wasm/model : questlang/wasm/Model
export
    (* The module's text, ending in a newline. Raises model.malformed for
     * what the text cannot say: a function whose type is not a function
     * type, a branch deeper than the blocks around it, an end with no block
     * to end. *)
    print(m: model.Module): String

    (* A value type's text: i64, eqref, (ref $t), (ref null 3) *)
    valType(m: model.Module t: model.ValType): String
end
