(* Quest Self-Hosted Compiler: The WebAssembly Runtime Types Interface
 *
 * Defines R, the single WebAssembly GC recursion group of runtime types that
 * compiled code distinguishes with runtime casts (docs/wasm.md section 2.11).
 * Every compiled module declares R first from this table so that each type has
 * the same index and the same iso-recursive identity across modules; any
 * change to R changes the ABI.
 *
 * R contains $obj (the base type for heap values with identity and cached
 * hash); $boxInt and $boxReal (boxed Int and Real); the array types $slots,
 * $bytes, and $i32s; $tupleLike, $tuple, $option, and $proxy (section 2.3);
 * $string and $array (sections 2.7 and 2.4); $varBox (mutable variable cell);
 * $record, $dict, and $recBox (a record's payload, its view offset dictionary,
 * and the two boxed together, section 2.5); $clos (the base of closures,
 * section 3.1); $auto (an existential package); and $exception and $raised
 * (section 2.9). Type descriptors and view maps are not in R (section 2.11):
 * they are ordinary Quest tuples defined in runtime/wasm/core (Desc and
 * ViewMap), so types in R hold them as eqref (WebAssembly's generic GC
 * reference type), as in $record's layout and $auto's desc fields. *)

interface RuntimeTypes
import
    questlang/wasm/model : questlang/wasm/Model
export
    (* R's types, in the order of their indices from 0 *)
    group: model.RecGroup

    (* Returns the index of the type named name in R (such as "tuple" for
     * $tuple), or of its field named field. Both raise model.malformed if the
     * name is not found in R. *)
    index(name: String): Int
    field(name: String field: String): Int
end
