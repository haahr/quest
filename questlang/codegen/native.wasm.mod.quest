(* Quest Self-Hosted Compiler: The Native Backends, for WebAssembly
 *
 * This is the wasm variant of codegen/native, selected when compiling the
 * driver to WebAssembly. It omits the SSA pipeline and all native backends
 * so they are not linked into the WebAssembly driver (docs/wasm.md
 * section 5.1). Compiling a unit with any native backend raises unsupported,
 * and setInterruptChecks is a no-op because the WebAssembly driver uses the
 * wasm JIT rather than SSA-generated code. *)

module native : Native
import
    util/maybe : util/Maybe

    questlang/ir/nodes : questlang/ir/Nodes
export
    let unsupported: Exception(String) = exception unsupported: String end

    Let Datum = Tuple symbol: String text: String end

    let unitCode(unit: nodes.Unit interfaceHeader: maybe.T(String) backend: String datum: maybe.T(Datum)): String =
        raise unsupported with
            "the " <> backend <> " backend: this driver was compiled to WebAssembly, and compiles only to it"
        end

    let cFlags(backend: String): Array(String) = array of :String end

    let setInterruptChecks(on: Bool): Ok = ok
end
