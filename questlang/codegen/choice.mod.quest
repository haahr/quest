(* Quest Self-Hosted Compiler: The Choice of Backends Implementation *)

module choice : Choice
import
    ascii : Ascii
    stringOp = string : StringOp

    util/maybe : util/Maybe
export
    Def Override = Tuple unit: String backend: String end
    Def Alternative = Tuple unit: String name: String end
    Def T = Tuple default: String overrides: Array(Override) variants: Array(Alternative) end

    let eq(a: String b: String): Bool = stringOp.equal(a b)

    let backends = array of "c" "ssac" "arm64" "wasm" end
    let isBackend(name: String): Bool =
        begin
            let var found = false
            for i = 0 upto {extent backends - 1} do if eq(backends[i] name) then found := true end end
            found
        end

    let standard: T = tuple
        let default = "c"
        let overrides = array of :Override end
        let variants = array of :Alternative end
    end
    let programUnit = "main"

    let forUnit(c: T unit: String): String =
        begin
            let var backend = c.default
            for i = 0 upto {extent c.overrides - 1} do
                if eq(c.overrides[i].unit unit) then backend := c.overrides[i].backend end
            end
            backend
        end

    let forFile(c: T unit: String library: Bool): String = forUnit(c unit)

    let variantFor(c: T unit: String): String =
        begin
            let var chosen = forUnit(c unit)
            for i = 0 upto {extent c.variants - 1} do
                if eq(c.variants[i].unit unit) then chosen := c.variants[i].name end
            end
            chosen
        end

    let allC(c: T): Bool =
        begin
            let var all = eq(c.default "c")
            for i = 0 upto {extent c.overrides - 1} do if not(eq(c.overrides[i].backend "c")) then all := false end end
            all
        end

    let parseOverride(s: String): maybe.T(Override) =
        begin
            let var at = ~1
            for i = 0 upto {stringOp.length(s) - 1} do
                if {at < 0} andif {stringOp.getChar(s i) is '='} then at := i end
            end
            if at <= 0 then
                maybe.none()
            else
                let backend = stringOp.getSub(s {at + 1} {{stringOp.length(s) - at} - 1})
                if isBackend(backend) then
                    maybe.some(tuple let unit = stringOp.getSub(s 0 at) let backend = backend end)
                else
                    maybe.none()
                end
            end
        end

    let parseVariant(s: String): maybe.T(Alternative) =
        begin
            let var at = ~1
            for i = 0 upto {stringOp.length(s) - 1} do
                if {at < 0} andif {stringOp.getChar(s i) is '='} then at := i end
            end
            let name = if at > 0 then stringOp.getSub(s {at + 1} {{stringOp.length(s) - at} - 1}) else "" end
            let var valid = stringOp.length(name) > 0
            for i = 0 upto {stringOp.length(name) - 1} do
                let c = ascii.val(stringOp.getChar(name i))
                if not({{c >= 97} andif {c <= 122}} orif {{c >= 65} andif {c <= 90}}
                        orif {{c >= 48} andif {c <= 57}}) then
                    valid := false
                end
            end
            if valid then maybe.some(tuple let unit = stringOp.getSub(s 0 at) let name = name end)
            else maybe.none()
            end
        end

    let isAssembly(backend: String): Bool = eq(backend "arm64")
    let isWasm(backend: String): Bool = eq(backend "wasm")
    let referencesAlike(backend: String): Bool = eq(backend "arm64") orif eq(backend "wasm")
    let codeFile(cFile: String backend: String): String =
        begin
            let n = stringOp.length(cFile)
            let suffix = if isAssembly(backend) then ".s" elsif isWasm(backend) then ".wasm" else ".c" end
            if {n > 2} andif eq(stringOp.getSub(cFile {n - 2} 2) ".c") then stringOp.getSub(cFile 0 {n - 2}) <> suffix
            else cFile
            end
        end

    let arguments(c: T): Array(String) =
        begin
            let n = extent c.overrides
            let args = array of({2 + 2 * {n + extent c.variants}} "")
            args[0] := "--backend"
            args[1] := c.default
            for i = 0 upto {n - 1} do
                args[2 + 2 * i] := "--unit-backend"
                args[3 + 2 * i] := c.overrides[i].unit <> "=" <> c.overrides[i].backend
            end
            for i = 0 upto {extent c.variants - 1} do
                args[2 + 2 * {n + i}] := "--variant"
                args[3 + 2 * {n + i}] := c.variants[i].unit <> "=" <> c.variants[i].name
            end
            args
        end
end
