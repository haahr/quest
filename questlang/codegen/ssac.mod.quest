(* Quest Self-Hosted Compiler: The SSA's C Printer Implementation *)

module ssac : Ssac
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/codegen/syntax : questlang/codegen/Syntax
    questlang/codegen/runtimeLayout : questlang/codegen/RuntimeLayout
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    util/stringBuilder : util/StringBuilder
    stringOp = string : StringOp
    conv : Conv
export
    Let Function = ssa.Function
    Let Builder = stringBuilder.T

    let unsupported: Exception(String) = exception unsupported: String end
    let eq(a: String b: String): Bool = stringOp.equal(a b)
    let intEqual(a: Int b: Int): Bool = a is b
    let put(K::TYPE V::TYPE m: hashMap.T(K V) k: K v: V): Ok = begin hashMap.insert(:K :V m k v) ok end

    let cFlags = array of
        "-std=gnu11" "-Wno-pedantic" "-fno-strict-aliasing" "-fno-builtin" "-Wno-unused" "-Wno-unused-parameter"
        "-Wno-incompatible-library-redeclaration" "-Wno-builtin-requires-header"
    end

    (* =========================================================================
     * Values and literals
     * ====================================================================== *)

    let v(n: Int): String = "v" <> conv.int(n)
    let blockLabel(b: Int): String = "b" <> conv.int(b)

    let cType(t: ssa.Type): String =
        case t when typeInt then "int64_t" when typePtr then "char *" when typeReal then "double" end
    let typeOf(f: Function n: Int): ssa.Type = ssa.typeOf(f n)

    (* An Int as C spells it: INT64_MIN has no literal *)
    let intLiteral(n: Int): String =
        if n < 0 then "(-INT64_C(" <> conv.int({0 - n} - 1) <> ") - 1)" else "INT64_C(" <> conv.int(n) <> ")" end

    (* An offset as C spells it (conv.int spells a negative one with ~) *)
    let decimal(n: Int): String = if n < 0 then "(" <> intLiteral(n) <> ")" else conv.int(n) end

    (* A value as a word (for a composite's half), and a word as a value of
     * type t *)
    let asWord(f: Function n: Int): String =
        case typeOf(f n)
            when typeInt then "(uint64_t)" <> v(n)
            when typePtr then "(uint64_t)(uintptr_t)" <> v(n)
            when typeReal then "ssac_bits(" <> v(n) <> ")"
        end
    let fromWord(w: String t: ssa.Type): String =
        case t
            when typeInt then "(int64_t)" <> w
            when typePtr then "(char *)(uintptr_t)" <> w
            when typeReal then "ssac_real(" <> w <> ")"
        end

    let contains(xs: Array(Int) x: Int): Bool =
        begin
            let var found = false
            for i = 0 upto {extent xs - 1} do if xs[i] is x then found := true end end
            found
        end

    (* =========================================================================
     * A function
     * ====================================================================== *)

    Let Printer = Tuple
        f: Function
        buf: Builder
        (* Whether the function enters a try: its values are volatile, and
         * so is its memory *)
        hasTry: Bool
        (* The bytes of the slot each value that is a slot's address
         * addresses, for a composite passed through memory *)
        slotOf: hashMap.T(Int Int)
        threadLocals: hashMap.T(String Bool)
    end

    let line(p: Printer s: String): Ok = begin p.buf.str("    " <> s <> "\n") ok end
    let text(buf: Builder s: String): Ok = begin buf.str(s) ok end
    let volatile(p: Printer): String = if p.hasTry then " volatile" else "" end

    (* A pointer to memory of C type t at a value plus an offset *)
    let memory(p: Printer t: String address: Int offset: Int): String =
        "*(" <> t <> volatile(p) <> " *)(" <> v(address) <> " + " <> decimal(offset) <> ")"

    let symbolAddress(p: Printer symbol: String): String =
        if hashMap.contains(:String :Bool p.threadLocals symbol) then "(char *)&" <> symbol
        else "(char *)(void *)" <> symbol end

    (* A composite passed through memory: a struct of its bytes *)
    let memoryType(bytes: Int): String = "QSsaMem" <> conv.int(bytes)

    (* A call's C function type and arguments, of its arguments from first on,
     * and its result type *)
    Let Call = Tuple fnType: String args: String results: Array(Int) end
    let callOf(p: Printer i: ssa.Inst first: Int): Call =
        begin
            let f = p.f
            let types = vector.new(:String)
            let exprs = vector.new(:String)
            let var k = first
            while k < extent i.args do
                if contains(i.pairs k) then
                    vector.append(:String types "QSsaPair")
                    vector.append(:String exprs "(QSsaPair){ " <> asWord(f i.args[k]) <> ", " <> asWord(f i.args[k + 1]) <> " }")
                    k := k + 2
                elsif contains(i.memory k) then
                    let bytes = maybe.unwrapOr(:Int hashMap.get(:Int :Int p.slotOf i.args[k]) 0)
                    if bytes is 0 then raise unsupported with "ssac: a composite through memory not in a slot" end end
                    vector.append(:String types memoryType(bytes))
                    vector.append(:String exprs "*(" <> memoryType(bytes) <> " *)" <> v(i.args[k]))
                    k := k + 1
                elsif contains(i.narrow k) then
                    (* A bool or a char, which C passes as one byte *)
                    vector.append(:String types "uint8_t")
                    vector.append(:String exprs "(uint8_t)" <> v(i.args[k]))
                    k := k + 1
                else
                    vector.append(:String types cType(typeOf(f i.args[k])))
                    vector.append(:String exprs v(i.args[k]))
                    k := k + 1
                end
            end
            let result = if extent i.results is 0 then "void" elsif extent i.results is 1 then cType(typeOf(f i.results[0]))
                else "QSsaPair" end
            let params = if vector.empty(:String types) then "void" else syntax.comma(types) end
            tuple let fnType = result <> " (*)(" <> params <> ")" let args = syntax.comma(exprs) let results = i.results end
        end

    (* A call's expression *)
    let callExpr(p: Printer i: ssa.Inst): String =
        begin
            let direct = stringOp.length(i.symbol) > 0
            let c = callOf(p i if direct then 0 else 1 end)
            let callee = if direct then "(void *)" <> i.symbol else v(i.args[0]) end
            "((" <> c.fnType <> ")" <> callee <> ")(" <> c.args <> ")"
        end

    let binaryOp(op: ssa.Opcode): maybe.T(String) =
        case op
            when opAdd then maybe.some(:String "+") when opSub then maybe.some(:String "-")
            when opMul then maybe.some(:String "*") when opDiv then maybe.some(:String "/")
            when opRem then maybe.some(:String "%") when opAnd then maybe.some(:String "&")
            when opOr then maybe.some(:String "|") when opXor then maybe.some(:String "^")
            when opAshr then maybe.some(:String ">>")
            when opEq then maybe.some(:String "==") when opNe then maybe.some(:String "!=")
            when opLt then maybe.some(:String "<") when opLe then maybe.some(:String "<=")
            when opGt then maybe.some(:String ">") when opGe then maybe.some(:String ">=")
            when opPeq then maybe.some(:String "==") when opPne then maybe.some(:String "!=")
            when opFadd then maybe.some(:String "+") when opFsub then maybe.some(:String "-")
            when opFmul then maybe.some(:String "*") when opFdiv then maybe.some(:String "/")
            when opFeq then maybe.some(:String "==") when opFlt then maybe.some(:String "<")
            when opFle then maybe.some(:String "<=") when opFgt then maybe.some(:String ">")
            when opFge then maybe.some(:String ">=")
            else maybe.none(:String)
        end

    let rec instruction(p: Printer i: ssa.Inst): Ok =
        begin
            let f = p.f
            let a(k: Int): String = v(i.args[k])
            let set(rhs: String): Ok = line(p v(i.results[0]) <> " = " <> rhs <> ";")
            let op = binaryOp(i.op)
            if maybe.isSome(:String op) then
                set(a(0) <> " " <> maybe.unwrap(:String op) <> " " <> a(1))
            else
                case i.op
                    when opConst then set(intLiteral(i.imm))
                    when opRealConst then set("ssac_real((uint64_t)" <> intLiteral(i.imm) <> ")")
                    when opSymbol then
                        set(symbolAddress(p i.symbol) <> if i.imm is 0 then "" else " + " <> decimal(i.imm) end)
                    when opNull then set("(char *)0")
                    when opSlot then set("(char *)s" <> conv.int(i.imm))
                    when opShl then set("(int64_t)((uint64_t)" <> a(0) <> " << " <> a(1) <> ")")
                    when opLshr then set("(int64_t)((uint64_t)" <> a(0) <> " >> " <> a(1) <> ")")
                    when opUlt then set("(uint64_t)" <> a(0) <> " < (uint64_t)" <> a(1))
                    when opIsNaN then set(a(0) <> " != " <> a(0))
                    when opIntToPtr then set("(char *)(uintptr_t)" <> a(0))
                    when opPtrToInt then set("(int64_t)(uintptr_t)" <> a(0))
                    when opRealBits then set("(int64_t)ssac_bits(" <> a(0) <> ")")
                    when opBitsReal then set("ssac_real((uint64_t)" <> a(0) <> ")")
                    when opSext8 then set("(int64_t)(int8_t)" <> a(0))
                    when opZext8 then set("(int64_t)(uint8_t)" <> a(0))
                    when opCopy then set(a(0))
                    when opLoad then
                        let t = typeOf(f i.results[0])
                        set(if i.width is 8 then memory(p cType(t) i.args[0] i.imm)
                            elsif i.width is 4 then "(int64_t)" <> memory(p "int32_t" i.args[0] i.imm)
                            elsif i.signed then "(int64_t)" <> memory(p "int8_t" i.args[0] i.imm)
                            else "(int64_t)" <> memory(p "uint8_t" i.args[0] i.imm) end)
                    when opStore then
                        let t = typeOf(f i.args[1])
                        line(p if i.width is 8 then memory(p cType(t) i.args[0] i.imm) <> " = " <> a(1) <> ";"
                            elsif i.width is 4 then memory(p "int32_t" i.args[0] i.imm) <> " = (int32_t)" <> a(1) <> ";"
                            else memory(p "uint8_t" i.args[0] i.imm) <> " = (uint8_t)" <> a(1) <> ";" end)
                    when opCall then call(p i)
                    when opCallIndirect then call(p i)
                    else raise unsupported with "ssac: opcode " <> ssa.opcodeName(i.op) end
                end
            end
        end

    and call(p: Printer i: ssa.Inst): Ok =
        begin
            let e = callExpr(p i)
            if extent i.results is 0 then line(p e <> ";")
            elsif extent i.results is 1 then line(p v(i.results[0]) <> " = " <> e <> ";")
            else
                line(p "{ QSsaPair r = " <> e <> "; " <> v(i.results[0]) <> " = " <> fromWord("r.w0" typeOf(p.f i.results[0]))
                    <> "; " <> v(i.results[1]) <> " = " <> fromWord("r.w1" typeOf(p.f i.results[1])) <> "; }")
            end
        end

    (* A jump: the target's parameters assigned its arguments, at once *)
    let jumpText(p: Printer t: ssa.Target): String =
        begin
            let params = ssa.block(p.f t.block).params
            let var text = ""
            if extent t.args > 0 then
                text := "{ "
                for k = 0 upto {extent t.args - 1} do
                    text := text <> cType(typeOf(p.f t.args[k])) <> " t" <> conv.int(k) <> " = " <> v(t.args[k]) <> "; "
                end
                for k = 0 upto {extent t.args - 1} do
                    text := text <> v(vector.get(:Int params k)) <> " = t" <> conv.int(k) <> "; "
                end
                text := text <> "} "
            end
            text <> "goto " <> blockLabel(t.block) <> ";"
        end

    let isMain(f: Function): Bool = eq(f.symbol "main")

    let returnText(p: Printer vs: Array(Int)): String =
        if extent vs is 0 then "return;"
        elsif isMain(p.f) then "return (int)" <> v(vs[0]) <> ";"
        elsif extent vs is 1 then "return " <> v(vs[0]) <> ";"
        else "return (QSsaPair){ " <> asWord(p.f vs[0]) <> ", " <> asWord(p.f vs[1]) <> " };"
        end

    let terminator(p: Printer t: ssa.Terminator): Ok =
        case t
            when termNone then raise unsupported with "ssac: a block without a terminator" end
            when termJump with x then line(p jumpText(p x.target))
            when termBranch with x then
                line(p "if (" <> v(x.cond) <> ") " <> jumpText(p x.ifTrue) <> " else " <> jumpText(p x.ifFalse))
            when termSwitch with x then
                line(p "switch (" <> v(x.value) <> ") {")
                for k = 0 upto {extent x.cases - 1} do
                    line(p "case " <> intLiteral(x.cases[k]) <> ": " <> jumpText(p x.targets[k]))
                end
                line(p "default: " <> jumpText(p x.default))
                line(p "}")
            when termReturn with x then line(p returnText(p x.values))
            when termTailCall with x then
                let e = callExpr(p x.call)
                line(p if extent x.call.results is 0 then e <> "; return;" else "return " <> e <> ";" end)
            when termTry with x then
                line(p "if (_setjmp((int *)(void *)(s" <> conv.int(x.slot) <> " + "
                    <> conv.int(runtimeLayout.offset("QExceptionHandler" "env_jmp")) <> ")) == 0) " <> jumpText(p x.body))
                line(p "goto " <> blockLabel(x.handler) <> ";")
            when termUnreachable then line(p "__builtin_unreachable();")
        end

    (* The C type a function returns, and its parameters' declarations *)
    let resultType(f: Function): String =
        if isMain(f) then "int"
        elsif vector.length(:ssa.Type f.resultTypes) is 0 then "void"
        elsif vector.length(:ssa.Type f.resultTypes) is 1 then cType(vector.get(:ssa.Type f.resultTypes 0))
        else "QSsaPair"
        end

    (* The parameters, named when named: a composite's halves as the pair's
     * words, assigned to their values on entry *)
    let paramsText(f: Function named: Bool): String =
        if isMain(f) then
            if named then "int ssac_argc, char **ssac_argv" else "int, char **" end
        else
            let params = ssa.block(f 0).params
            let decls = vector.new(:String)
            let var k = 0
            while k < vector.length(:Int params) do
                if contains(f.paramPairs k) then
                    vector.append(:String decls "QSsaPair" <> if named then " p" <> conv.int(k) else "" end)
                    k := k + 2
                else
                    let n = vector.get(:Int params k)
                    let t = if contains(f.paramNarrow k) then "uint8_t" else cType(typeOf(f n)) end
                    vector.append(:String decls t <> if named then " " <> v(n) else "" end)
                    k := k + 1
                end
            end
            if vector.empty(:String decls) then "void" else syntax.comma(decls) end
        end

    let linkage(f: Function): String = if f.exported then "" else "static " end
    let prototype(f: Function named: Bool): String =
        linkage(f) <> resultType(f) <> " " <> f.symbol <> "(" <> paramsText(f named) <> ")"

    let function(buf: Builder f: Function threadLocals: hashMap.T(String Bool)): Ok =
        begin
            let var hasTry = false
            let slotOf = hashMap.new(:Int :Int intEqual hash.int)
            for b = 0 upto {vector.length(:ssa.Block f.blocks) - 1} do
                let blk = ssa.block(f b)
                case blk.term when termTry then hasTry := true else ok end
                for k = 0 upto {vector.length(:ssa.Inst blk.insts) - 1} do
                    let i = vector.get(:ssa.Inst blk.insts k)
                    case i.op
                        when opSlot then put(:Int :Int slotOf i.results[0] vector.get(:ssa.Slot f.slots i.imm).bytes)
                        else ok
                    end
                end
            end
            let p = tuple let f = f let buf = buf let hasTry = hasTry let slotOf = slotOf let threadLocals = threadLocals end
            text(buf prototype(f true) <> " {\n")
            let params = ssa.block(f 0).params
            let isParam = array of(vector.length(:ssa.Type f.types) false)
            if isMain(f) then
                line(p "int64_t " <> v(vector.get(:Int params 0)) <> " = ssac_argc;")
                line(p "char *" <> v(vector.get(:Int params 1)) <> " = (char *)ssac_argv;")
            end
            for k = 0 upto {vector.length(:Int params) - 1} do isParam[vector.get(:Int params k)] := true end
            (* A composite parameter's halves *)
            for k = 0 upto {extent f.paramPairs - 1} do
                let at = f.paramPairs[k]
                let first = vector.get(:Int params at)
                let second = vector.get(:Int params at + 1)
                let pair = "p" <> conv.int(at)
                line(p cType(typeOf(f first)) <> " " <> v(first) <> " = " <> fromWord(pair <> ".w0" typeOf(f first)) <> ";")
                line(p cType(typeOf(f second)) <> " " <> v(second) <> " = " <> fromWord(pair <> ".w1" typeOf(f second)) <> ";")
            end
            for n = 0 upto {vector.length(:ssa.Type f.types) - 1} do
                if not(isParam[n]) then
                    let t = typeOf(f n)
                    let decl = case t when typePtr then "char *" <> volatile(p) <> " "
                        else if p.hasTry then "volatile " else "" end <> cType(t) <> " " end
                    line(p decl <> v(n) <> ";")
                end
            end
            for s = 0 upto {vector.length(:ssa.Slot f.slots) - 1} do
                let slot = vector.get(:ssa.Slot f.slots s)
                line(p "unsigned char s" <> conv.int(s) <> "[" <> conv.int(if slot.bytes > 0 then slot.bytes else 1 end)
                    <> "] __attribute__((aligned(" <> conv.int(if slot.align > 8 then slot.align else 8 end) <> ")));")
            end
            for b = 0 upto {vector.length(:ssa.Block f.blocks) - 1} do
                let blk = ssa.block(f b)
                text(buf blockLabel(b) <> ":;\n")
                for k = 0 upto {vector.length(:ssa.Inst blk.insts) - 1} do instruction(p vector.get(:ssa.Inst blk.insts k)) end
                terminator(p blk.term)
            end
            text(buf "}\n\n")
        end

    (* =========================================================================
     * Data and the unit
     * ====================================================================== *)

    let wordText(w: ssa.Word threadLocals: hashMap.T(String Bool)): String =
        case w
            when wordInt with x then "(void *)(uintptr_t)" <> intLiteral(x.n)
            when wordSymbol with x then
                (* A thread-local's address is not a constant *)
                if hashMap.contains(:String :Bool threadLocals x.symbol) then
                    raise unsupported with "ssac: static data holding a thread-local's address, " <> x.symbol end
                end
                "(void *)((char *)(void *)" <> x.symbol <> " + " <> decimal(x.addend) <> ")"
        end

    (* A datum's C declaration, without its contents *)
    let dataDeclaration(d: ssa.Data): String =
        begin
            let linkageText = if d.exported then "" else "static " end
            case d.contents
                when contentsZero with x then
                    linkageText <> "uint64_t " <> d.symbol <> "[" <> conv.int({x.bytes + 7} / 8) <> "]"
                when contentsText with x then
                    linkageText <> if d.writable then "char " else "const char " end <> d.symbol <> "["
                        <> conv.int(stringOp.length(x.text) + 1) <> "]"
                when contentsWords with x then
                    linkageText <> if d.writable then "void *" else "void *const " end <> d.symbol <> "["
                        <> conv.int(if extent x.words > 0 then extent x.words else 1 end) <> "]"
            end
        end

    let dataDefinition(d: ssa.Data threadLocals: hashMap.T(String Bool)): String =
        case d.contents
            when contentsZero then dataDeclaration(d) <> ";"
            when contentsText with x then dataDeclaration(d) <> " = " <> syntax.cString(x.text) <> ";"
            when contentsWords with x then
                let ws = vector.new(:String)
                for k = 0 upto {extent x.words - 1} do vector.append(:String ws wordText(x.words[k] threadLocals)) end
                if extent x.words is 0 then vector.append(:String ws "0") end
                dataDeclaration(d) <> " = { " <> syntax.comma(ws) <> " };"
        end

    let printUnit(u: ssa.Unit): String =
        begin
            let buf = stringBuilder.new()
            let defined = hashMap.new(:String :Bool eq hash.string)
            let threadLocals = hashMap.new(:String :Bool eq hash.string)
            for k = 0 upto {extent runtimeLayout.threadLocals - 1} do put(:String :Bool threadLocals runtimeLayout.threadLocals[k] true) end
            for k = 0 upto {vector.length(:Function u.functions) - 1} do
                put(:String :Bool defined vector.get(:Function u.functions k).symbol true)
            end
            for k = 0 upto {vector.length(:ssa.Data u.data) - 1} do put(:String :Bool defined vector.get(:ssa.Data u.data k).symbol true) end
            (* The symbols the unit refers to but does not define, in order *)
            let externs = vector.new(:String)
            let seen = hashMap.new(:String :Bool eq hash.string)
            let refer(symbol: String): Ok =
                if {stringOp.length(symbol) > 0} andif not(hashMap.contains(:String :Bool defined symbol))
                    andif not(hashMap.contains(:String :Bool seen symbol)) then
                    put(:String :Bool seen symbol true)
                    vector.append(:String externs symbol)
                end
            (* The sizes of the composites passed through memory *)
            let memorySizes = hashMap.new(:Int :Bool intEqual hash.int)
            let referInst(f: Function i: ssa.Inst): Ok =
                begin
                    case i.op
                        when opSymbol then refer(i.symbol)
                        when opCall then refer(i.symbol)
                        else ok
                    end
                    for k = 0 upto {extent i.memory - 1} do
                        (* Found by the slot the argument addresses *)
                        let a = i.args[i.memory[k]]
                        for b = 0 upto {vector.length(:ssa.Block f.blocks) - 1} do
                            let blk = ssa.block(f b)
                            for j = 0 upto {vector.length(:ssa.Inst blk.insts) - 1} do
                                let def = vector.get(:ssa.Inst blk.insts j)
                                case def.op
                                    when opSlot then
                                        if def.results[0] is a then
                                            put(:Int :Bool memorySizes vector.get(:ssa.Slot f.slots def.imm).bytes true)
                                        end
                                    else ok
                                end
                            end
                        end
                    end
                end
            for k = 0 upto {vector.length(:Function u.functions) - 1} do
                let f = vector.get(:Function u.functions k)
                for b = 0 upto {vector.length(:ssa.Block f.blocks) - 1} do
                    let blk = ssa.block(f b)
                    for j = 0 upto {vector.length(:ssa.Inst blk.insts) - 1} do referInst(f vector.get(:ssa.Inst blk.insts j)) end
                    case blk.term when termTailCall with x then referInst(f x.call) else ok end
                end
            end
            for k = 0 upto {vector.length(:ssa.Data u.data) - 1} do
                case vector.get(:ssa.Data u.data k).contents
                    when contentsWords with x then
                        for j = 0 upto {extent x.words - 1} do
                            case x.words[j] when wordSymbol with w then refer(w.symbol) else ok end
                        end
                    else ok
                end
            end

            buf.str("/* Emitted by the Quest SSA's C printer (ssac) */\n")
            buf.str("#include <stdint.h>\n\n")
            buf.str("typedef struct { uint64_t w0, w1; } QSsaPair;\n")
            let sizes = hashMap.keys(:Int :Bool memorySizes)
            for k = 0 upto {vector.length(:Int sizes) - 1} do
                let n = vector.get(:Int sizes k)
                buf.str("typedef struct { unsigned char b[" <> conv.int(n) <> "]; } " <> memoryType(n) <> ";\n")
            end
            buf.str("static inline double ssac_real(uint64_t b) { double d; __builtin_memcpy(&d, &b, 8); return d; }\n")
            buf.str("static inline uint64_t ssac_bits(double d) { uint64_t b; __builtin_memcpy(&b, &d, 8); return b; }\n")
            buf.str("extern int _setjmp(int *) __attribute__((returns_twice));\n\n")
            for k = 0 upto {vector.length(:String externs) - 1} do
                let symbol = vector.get(:String externs k)
                buf.str(if hashMap.contains(:String :Bool threadLocals symbol) then "extern __thread uint64_t " <> symbol <> "[8];\n"
                    else "extern char " <> symbol <> "[];\n" end)
            end
            buf.str("\n")
            for k = 0 upto {vector.length(:ssa.Data u.data) - 1} do
                buf.str(dataDeclaration(vector.get(:ssa.Data u.data k)) <> ";\n")
            end
            for k = 0 upto {vector.length(:Function u.functions) - 1} do
                buf.str(prototype(vector.get(:Function u.functions k) false) <> ";\n")
            end
            buf.str("\n")
            for k = 0 upto {vector.length(:ssa.Data u.data) - 1} do
                buf.str(dataDefinition(vector.get(:ssa.Data u.data k) threadLocals) <> "\n")
            end
            buf.str("\n")
            for k = 0 upto {vector.length(:Function u.functions) - 1} do function(buf vector.get(:Function u.functions k) threadLocals) end
            buf.toString()
        end
end
