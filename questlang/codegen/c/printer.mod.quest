(* Quest Self-Hosted Compiler: The C Printer Implementation
 *
 * Names and temporaries are numbered as they are made, so the printer makes
 * them in the bootstrap's order: each function's signature, prologue, locals,
 * and body in turn, and within an expression, its parts left to right. *)

module printer : Printer
import
    questlang/common/location : questlang/common/Location
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/types/model : questlang/types/Model
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/ir/walk : questlang/ir/Walk
    questlang/ir/describe : questlang/ir/Describe
    questlang/repr/syntax : questlang/repr/Syntax
    questlang/repr/layout : questlang/repr/Layout
    questlang/repr/genericLayout : questlang/repr/GenericLayout
    questlang/repr/symbols : questlang/repr/Symbols
    questlang/repr/externals : questlang/repr/Externals
    questlang/repr/staticdata : questlang/repr/StaticData
    questlang/repr/objectLayout : questlang/repr/ObjectLayout
    questlang/repr/runtimeLayout : questlang/repr/RuntimeLayout
    questlang/codegen/c/types : questlang/codegen/c/Types
    questlang/codegen/c/declarations : questlang/codegen/c/Declarations
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/iter : util/Iter
    util/hash : util/Hash
    util/maybe : util/Maybe
    util/sort : util/Sort
    util/strutil : util/Strutil
    stringOp = string : StringOp
    conv : Conv
export
    Let Type = model.Type
    Let Shape = shapes.Shape
    Let Variable = nodes.Variable
    Let Atom = nodes.Atom
    Let Lines = vector.T(String)

    let unsupported: Exception(String) = exception unsupported: String end

    let eq(a: String b: String): Bool = stringOp.equal(a b)
    let intEqual(a: Int b: Int): Bool = a is b
    let cInt(n: Int): String = syntax.cInt(n)
    let lit(n: Int): String = syntax.cIntLiteral(n)
    let strings(xs: Array(String)): vector.T(String) = vector.fromArray(xs)
    let add(lines: Lines line: String): Ok = vector.append(lines line)
    let addAll(lines: Lines more: Lines): Ok =
        begin
            for i = 0 upto {vector.length(more) - 1} do add(lines vector.get(more i)) end
            ok
        end
    let joinedWith(first: vector.T(String) rest: vector.T(String)): vector.T(String) =
        begin
            let v = vector.copy(first)
            addAll(v rest)
            v
        end
    let one(s: String): vector.T(String) = strings(array of s end)
    let removePrefix(s: String prefix: String): String =
        if strutil.startsWith(s prefix) then
            stringOp.getSub(s stringOp.length(prefix) {stringOp.length(s) - stringOp.length(prefix)})
        else s
        end
    (* Adds or replaces a map's entry *)
    let put(K::TYPE V::TYPE m: hashMap.T(K V) key: K value: V): Ok =
        begin
            hashMap.insert(m key value)
            ok
        end
    let shapeOf(t: Type): Shape = shapes.shape(t)
    let isOk(t: Type): Bool = shapes.kindIs(shapeOf(t) shapes.shapeOk)
    (* Whether a value of type t holds a word that may be a pointer, which a
     * store of it into an existing object must barrier (docs/collector.md
     * section 3.5) *)
    let holdsPointer(t: Type): Bool =
        begin
            let ks = objectLayout.representationKinds(shapeOf(t))
            let var found = false
            for i = 0 upto {extent ks - 1} do
                case ks[i] when kindScalar then ok else found := true end
            end
            found
        end
    let componentShape(s: Shape i: Int): Shape = maybe.unwrap(s.components[i].shape)
    let atomType(a: Atom): Type = nodes.atomType(a)
    let atomVar(a: Atom): maybe.T(Variable) = nodes.atomVarOf(a)
    let some(s: String): maybe.T(String) = maybe.some(s)

    (* The shape of t's values as held, if it is of the kind: t's own, or a
     * bounded type parameter's bound's (ir/represent's held_shape) *)
    let heldShape(t: Type kind: shapes.ShapeKind): maybe.T(Shape) =
        begin
            let held = layout.resolvedShape(shapeOf(t))
            if shapes.sameKind(held.kind kind) then maybe.some(held) else maybe.none() end
        end

    (* How many type parameters t's quantifiers bind, nested ones included:
     * the descriptors a function of type t takes after its environment *)
    let typeParameterCount(t: Type): Int =
        begin
            let var s = shapeOf(t)
            let var count = 0
            while shapes.kindIs(s shapes.shapeAll) do
                count := count + extent s.typeParams
                s := shapes.body(s)
            end
            count
        end

    (* Whether t is a function type, under any quantifiers *)
    let isFunction(t: Type): Bool =
        begin
            let var s = shapeOf(t)
            while shapes.kindIs(s shapes.shapeAll) do s := shapes.body(s) end
            shapes.kindIs(s shapes.shapeFun)
        end

    (* The index of a case of a variant or option shape (0 if it has none of
     * the name) *)
    let tagIndex(s: Shape tag: maybe.T(String)): Int =
        begin
            let var index = ~1
            for i = 0 upto {extent s.cases - 1} do
                if {index < 0} andif maybe.isSome(tag) andif maybe.isSome(s.cases[i].name)
                    andif eq(maybe.unwrap(s.cases[i].name) maybe.unwrap(tag)) then
                    index := i
                end
            end
            if index < 0 then 0 else index end
        end
    let tagIndexOf(s: Shape tag: String): Int = tagIndex(s some(tag))
    let caseOf(s: Shape tag: String): maybe.T(shapes.Component) = shapes.caseOf(s tag)
    let caseShape(s: Shape tag: String): maybe.T(Shape) =
        begin
            let c = caseOf(s tag)
            if maybe.isSome(c) then
                maybe.unwrap(c).shape else maybe.none() end
        end

    (* =========================================================================
     * The printer's state
     * ====================================================================== *)

    Let Local = Tuple cType: String name: String end
    (* An object whose initializing stores are being printed, and the calls
     * printed before its allocation ended (beginInit) *)
    Let Init = Tuple obj: String mark: Int end
    (* What printing one C function needs: its locals and the labels and
     * handlers in scope *)
    Let FnState = Tuple
        function: maybe.T(nodes.Function)
        locals: vector.T(Local)
        (* Labels used by jumps, breaks, and continues (only used labels are
         * printed) *)
        usedLabels: hashMap.T(String Bool)
        (* The try handlers entered, innermost last, and for each label the
         * number entered where it is defined *)
        handlers: vector.T(String)
        labelDepth: hashMap.T(String Int)
        joinParams: hashMap.T(String Array(Variable))
        var volatile: hashMap.T(Int Bool)
        (* The lets of tuples made only to be an option's payload, which the
         * next statement makes: printed as the option's components instead,
         * by variable (fusedTuples) *)
        var fused: hashMap.T(Int nodes.Stmt)
        (* The objects being initialized, outermost first (beginInit) *)
        inits: vector.T(Init)
    end
    let newFnState(f: maybe.T(nodes.Function)): FnState =
        tuple
            let function = f
            let locals = vector.new()
            let usedLabels = hashMap.new(eq hash.string)
            let handlers = vector.new()
            let labelDepth = hashMap.new(eq hash.string)
            let joinParams = hashMap.new(eq hash.string)
            let var volatile = hashMap.new(intEqual hash.int)
            let var fused = hashMap.new(intEqual hash.int)
            let inits = vector.new()
        end

    (* A field of an aggregate being made: its C expression, a record or
     * variant to be stored in a box sharing the aggregate's allocation, or
     * that box once made room for *)
    Let Field = Option
        fieldText with s: String end
        fieldFresh with value: String shape: Shape end
        fieldBox with k: Int box: String value: String end
    end
    let text(s: String): Field = option fieldText of Field with let s = s end

    (* An aggregate allocation with room for embedded boxes (embeddedBoxes)
     * whose statement has not been printed yet: boxes, the temporary that is
     * to point at the room, and block, the temporary the allocation is
     * assigned to. The room starts right after block's struct, so once the
     * allocation is printed, fillEmbedded sets boxes to block + 1 *)
    Let Pending = Tuple boxes: String block: String end
    (* A let rec's closures capture the let rec's own variables, whose values
     * do not exist until every closure of it is made. So while its body is
     * printed (statement's sLetRec), Deferred holds those variables, by id,
     * and makeClosure leaves a capture of one of them unstored, recording in
     * captures the environment, the index of the capture in it, and the atom.
     * After the body, the deferred captures are stored (with their barriers),
     * tying the knot. For example, in
     *
     *     let rec even(n: Int): Bool = ... odd(n - 1) ...
     *     and odd(n: Int): Bool = ... even(n - 1) ...
     *
     * even's environment is made before odd's closure exists, and its
     * capture of odd is stored once both are made *)
    Let DeferredCapture = Tuple env: String index: Int a: Atom end
    Let Deferred = Tuple vars: hashMap.T(Int Bool) captures: vector.T(DeferredCapture) end

    (* The state of printing one unit (printC) *)
    Let P = Tuple
        unit: nodes.Unit
        (* The path of the unit's interface header, which the C includes *)
        interfaceHeader: maybe.T(String)
        ctx: staticdata.RecordNaming
        (* The variables that are C globals, named g_, by id: those of the
         * main body and the modules' initializers that a function or another
         * of those bodies names, or that are a module's members, exports, or
         * record (walk.globalVariables) *)
        globals: hashMap.T(Int Bool)
        (* The C name of each variable, by id, and of each function's code
         * (codeNames, by function id); every name given (usedNames), and for
         * each base name the count its next fresh name starts at (freshName) *)
        names: hashMap.T(Int String)
        usedNames: hashMap.T(String Bool)
        nameCounts: hashMap.T(String Int)
        codeNames: hashMap.T(Int String)
        (* The closure each variable is known to hold, by id, so that its
         * calls call the closure's code directly (callClosure): those
         * walk.knownClosures finds, and each let of a closure as statement
         * prints it *)
        closures: hashMap.T(Int nodes.OpMakeClosure)
        (* The variables that hold a caught exception (a try's exc), by id,
         * which C declares as the whole exception state, QExceptionState *)
        handlerVars: hashMap.T(Int Bool)
        (* The pairs of tuple types converted by casts (whose layouts agree,
         * which the C asserts), in the order first cast *)
        tupleCastKeys: vector.T(String)
        tupleCasts: hashMap.T(String declarations.Pair)
        (* The tables of options of cases without components, by option
         * struct: their names, and their definitions in the order first used
         * (docs/c-representation.md section 5.3) *)
        optionTables: hashMap.T(String String)
        optionTableDecls: vector.T(String)
        (* The unit's string literals, each one static object
         * (QStaticString): their names, by text, and their definitions in
         * the order first used *)
        stringObjects: hashMap.T(String String)
        stringDecls: vector.T(String)
        (* The layouts of the objects the unit allocates (docs/collector.md
         * section 3.2), each defined once *)
        layouts: objectLayout.Table
        (* The function (or top level) being printed: its state, the lines of
         * its body printed so far, their indentation in units of four
         * spaces, and the count temporaries (_tN) are numbered by *)
        var fs: FnState
        var lines: Lines
        var indent: Int
        var tmp: Int
        (* The lines printed that call a function (beginInit) *)
        var calls: Int
        var pending: maybe.T(Pending)
        var deferred: maybe.T(Deferred)
        (* The declarations' printer, made by declarationLines, which
         * importDeclarations uses too *)
        var emitter: maybe.T(declarations.Emitter)
    end

    (* =========================================================================
     * Names
     * ====================================================================== *)

    let freshName(p: P base: String): String =
        begin
            (* The search for a base's next name starts where its last one
             * stopped: every name before it is taken *)
            let var n = maybe.unwrapOr(hashMap.get(p.nameCounts base) 1)
            let var name = if n is 1 then base else base <> "_" <> cInt(n) end
            while hashMap.contains(p.usedNames name) do
                n := n + 1
                name := base <> "_" <> cInt(n)
            end
            put(p.nameCounts base n)
            put(p.usedNames name true)
            name
        end

    let name(p: P v: Variable): String =
        begin
            if not(hashMap.contains(p.names v.id))
                andif {model.same(v.type nodes.descriptorType) orif model.same(v.type nodes.viewMapType)} then
                (* A descriptor variable (a function's descriptor parameter), or
                 * a view map *)
                put(p.names v.id freshName(p v.hint))
            end
            if not(hashMap.contains(p.names v.id)) then
                let base = symbols.mangleIdent(if stringOp.length(v.hint) > 0 then v.hint else "t" end)
                let prefix = if hashMap.contains(p.globals v.id) then "g_" else "l_" end
                put(p.names v.id freshName(p prefix <> removePrefix(base "qv_")))
            end
            hashMap.find(p.names v.id)
        end

    let atomName(p: P a: Atom): String = name(p maybe.unwrap(atomVar(a)))

    let codeName(p: P f: nodes.Function): String =
        begin
            if not(hashMap.contains(p.codeNames f.id)) then
                let base = symbols.mangleIdent(if stringOp.length(f.v.hint) > 0 then f.v.hint else "fun" end)
                put(p.codeNames f.id freshName(p "qf_" <> removePrefix(base "qv_")))
            end
            hashMap.find(p.codeNames f.id)
        end

    let temp(p: P cType: String): String =
        begin
            p.tmp := p.tmp + 1
            let n = "_t" <> cInt(p.tmp)
            vector.append(p.fs.locals tuple let cType = cType let name = n end)
            n
        end

    (* Whether a line of C calls a function (an identifier right before a
     * parenthesis; sizeof aside): a call may allocate, and so collect *)
    let callsFunction(line: String): Bool =
        begin
            let n = stringOp.length(line)
            let var found = false
            let var i = 1
            while {i < n} andif not(found) do
                if stringOp.getChar(line i) is '(' then
                    let c = stringOp.getChar(line {i - 1})
                    let separator = {c is ' '} orif {c is '('} orif {c is ')'} orif {c is '*'} orif {c is '{'}
                        orif {c is '='} orif {c is ','} orif {c is '&'} orif {c is '!'} orif {c is '-'} orif {c is '+'}
                        orif {c is '"'}
                    if not(separator) andif not({i >= 6} andif stringOp.equalSub(line {i - 6} 6 "sizeof" 0 6)) then
                        found := true
                    end
                end
                i := i + 1
            end
            found
        end

    let emit(p: P line: String): Ok =
        begin
            if callsFunction(line) andif not(strutil.startsWith(line "quest_barrier")) then
                (* A call may collect. An object being initialized that an
                 * earlier call may have left old is logged first, for the
                 * stores since that call (beginInit) *)
                for i = 0 upto {vector.length(p.fs.inits) - 1} do
                    let init = vector.get(p.fs.inits i)
                    if p.calls > init.mark then
                        add(p.lines stringOp.new(4 * p.indent ' ') <> "quest_barrier(" <> init.obj <> ");")
                    end
                end
                p.calls := p.calls + 1
            end
            add(p.lines stringOp.new(4 * p.indent ' ') <> line)
        end

    (* Before an object's initializing stores, which have no barrier, as a
     * young object's need none: the object stays young until a call, in
     * which a collection may run and mark it old (collector.md section 3.5),
     * and the stores after that call must be logged before the next
     * collection. So from the second call on, emit logs the object before
     * the call, and initBarrier logs it after the last store. The mark is
     * what initBarrier takes *)
    let beginInit(p: P obj: String): Int =
        begin
            vector.append(p.fs.inits tuple let obj = obj let mark = p.calls end)
            p.calls
        end

    (* After the initializing stores beginInit began: logs the object if a
     * call was printed since its allocation *)
    let initBarrier(p: P mark: Int obj: String): Ok =
        begin
            let var found = false
            while not(found) andif not(vector.empty(p.fs.inits)) do
                found := stringOp.equal(vector.pop(p.fs.inits).obj obj)
            end
            if p.calls > mark then emit(p "quest_barrier(" <> obj <> ");") else ok end
        end

    (* =========================================================================
     * Types
     * ====================================================================== *)

    let cType(t: Type): String = types.qtypeToCType(t)

    (* The address of a layout of the unit, registering it *)
    let layoutRef(p: P l: objectLayout.Layout): String = "&" <> objectLayout.register(p.layouts l)

    (* The shapes of the fields boxed in an aggregate's allocation, in
     * order *)
    let boxShapes(fields: vector.T(Field)): Array(Shape) =
        begin
            let res = vector.new(:Shape)
            for i = 0 upto {vector.length(fields) - 1} do
                case vector.get(fields i)
                    when fieldFresh with x then vector.append(res x.shape)
                    else ok
                end
            end
            vector.toArray(res)
        end

    let noBoxes = array of :Shape end

    (* The layout of a closure's environment, struct QEnv_<code>, whose
     * fields C lays out: a Bool or Char capture is a byte, every other
     * field a word or two, aligned to a word *)
    let envLayoutOf(code: String o: nodes.OpMakeClosure): objectLayout.Layout =
        begin
            let kinds = vector.new(:objectLayout.Kind)
            let scalar = option kindScalar of objectLayout.Kind end
            let var offset = 0
            let wordAt(i: Int k: objectLayout.Kind): Ok =
                begin
                    while vector.length(kinds) <= i do
                        vector.append(kinds scalar)
                    end
                    vector.set(kinds i k)
                end
            let words(ks: Array(objectLayout.Kind)): Ok =
                begin
                    offset := {{offset + 7} / 8} * 8
                    for j = 0 upto {extent ks - 1} do
                        wordAt(offset / 8 ks[j])
                        offset := offset + 8
                    end
                end
            for i = 0 upto {extent o.typeArgs - 1} do words(array of option kindPointer of objectLayout.Kind end end) end
            for i = 0 upto {extent o.captures - 1} do
                let t = atomType(o.captures[i])
                if isOk(t) then words(array of scalar end)
                else
                    case layout.representationKind(t)
                        when repBool, repChar then
                            wordAt(offset / 8 scalar)
                            offset := offset + 1
                        when repVoid, repInt, repWord, repReal, repRecord, repVariant, repPointer, repQVal then
                            words(objectLayout.representationKinds(shapeOf(t)))
                    end
                end
            end
            if vector.length(kinds) is 0 then wordAt(0 scalar) end
            objectLayout.envLayout(code vector.toArray(kinds)
                8 * vector.length(kinds) "sizeof(struct QEnv_" <> code <> ")")
        end

    (* The definitions of the unit's layouts, after every function has been
     * printed *)
    let layoutDefinitions(p: P): Lines =
        begin
            let lines = vector.new(:String)
            let ls = objectLayout.layouts(p.layouts)
            for i = 0 upto {extent ls - 1} do
                let l = ls[i]
                let kinds = vector.new(:String)
                for j = 0 upto {extent l.words - 1} do add(kinds cInt(objectLayout.kindCode(l.words[j]))) end
                for j = 0 upto {extent l.element - 1} do add(kinds cInt(objectLayout.kindCode(l.element[j]))) end
                if vector.empty(kinds) then add(kinds "0") end
                add(lines "static const uint8_t qlk_" <> l.tag <> "[] = { " <> syntax.comma(kinds) <> " };")
                let form = case l.form when formFixed then "Q_LAYOUT_FIXED" when formArray then "Q_LAYOUT_ARRAY" end
                let size = if eq(l.cSize "") then cInt(l.bytes) else l.cSize end
                let flags = if objectLayout.noscan(l) then "Q_LAYOUT_NOSCAN" else "0" end
                add(lines "static const QLayout " <> objectLayout.symbol(l) <> " Q_UNUSED = { "
                    <> syntax.cString(l.tag) <> ", " <> form <> ", " <> flags <> ", " <> size <> ", "
                    <> cInt(l.lengthOffset) <> ", "
                    <> cInt(extent l.element) <> ", " <> cInt(extent l.words) <> ", qlk_" <> l.tag <> " };")
            end
            if not(vector.empty(lines)) then add(lines "") end
            lines
        end

    let slotCType(s: Shape): String = layout.shapeSlotRepresentation(s)
    let locationCType(t: Type): String = layout.shapeLocationRepresentation(shapeOf(t))

    let held(t: Type kind: shapes.ShapeKind): Shape =
        begin
            let s = heldShape(t kind)
            if maybe.isNone(s) then
                raise unsupported with "C printing of a " <> shapes.kindName(kind) <> " operation on a value of type "
                    <> model.show(t) end
            end
            maybe.unwrap(s)
        end

    let tagShape(t: Type): Shape =
        begin
            let v = heldShape(t shapes.shapeVariant)
            let s = if maybe.isSome(v) then v else heldShape(t shapes.shapeOption) end
            if maybe.isNone(s) then
                raise unsupported with "C printing of a tag test on a value of type " <> model.show(t) end
            end
            maybe.unwrap(s)
        end

    let elementShape(a: Atom): Shape =
        begin
            let s = shapeOf(atomType(a))
            if not(shapes.kindIs(s shapes.shapeArray)) then
                raise unsupported with
                    "C printing of an array operation on a value of type " <> model.show(atomType(a))
                end
            end
            shapes.element(s)
        end

    let isPointerParam(p: P v: Variable): Bool =
        begin
            let var found = false
            if maybe.isSome(p.fs.function) then
                let params = maybe.unwrap(p.fs.function).params
                for i = 0 upto {extent params - 1} do
                    if nodes.same(params[i].v v) andif not(eq(params[i].mode "value")) then found := true end
                end
            end
            found
        end

    (* An unboxed tuple's C type: its struct, by value *)
    let unboxedCType(t: Type): String = begin cType(t) layout.shapeTag(shapeOf(t)) end

    let varCType(p: P v: Variable): String =
        if hashMap.contains(p.handlerVars v.id) then "QExceptionState"
        elsif v.boxed then slotCType(shapeOf(v.type))
        elsif v.unboxed then unboxedCType(v.type)
        else cType(v.type)
        end

    (* =========================================================================
     * Descriptors
     * ====================================================================== *)

    let staticForm(p: P t: Type): staticdata.DescriptorForm =
        try staticdata.descriptorForm(t maybe.some(p.ctx))
        when staticdata.missingDescriptor with m then raise unsupported with "C code generation: " <> m end
        end

    let staticDescriptor(p: P t: Type): String = types.cExpr(staticForm(p t))

    let staticDescriptorOf(p: P d: nodes.StaticDescriptor): String =
        begin
            let form = if d.echo then staticdata.echoDescriptorForm(d.type maybe.some(p.ctx))
                else maybe.none(:staticdata.DescriptorForm)
            end
            types.cExpr(if maybe.isSome(form) then maybe.unwrap(form)
                else staticForm(p d.type)
            end)
        end

    (* A descriptor operand (ir/describe): a descriptor variable, a static
     * descriptor, or a template instantiated at run time with its holes'
     * descriptors *)
    let rec descriptor(p: P d: nodes.Descriptor): String =
        case d
            when descVar with x then name(p x.v)
            when descStatic with x then staticDescriptorOf(p x.d)
            when descInstantiate with x then
                let form = staticForm(p x.template)
                if eq(form.kind "base") then
                    types.cExpr(form)
                else
                    let args = vector.new(:String)
                    for i = 0 upto {extent x.args - 1} do add(args descriptor(p x.args[i])) end
                    "quest_instantiate_descriptor(" <> types.cExpr(form) <> ", " <> cInt(extent x.args)
                        <> ", (const QTypeDescriptor *const[]){ " <> syntax.comma(args) <> " })"
                end
        end

    let maybeDescriptor(p: P d: maybe.T(nodes.Descriptor)): String =
        if maybe.isSome(d) then descriptor(p maybe.unwrap(d))
        else raise unsupported with "C code generation: a run-time use of a type without its descriptor" end
        end

    (* =========================================================================
     * Atoms
     * ====================================================================== *)

    (* The string literal s: its static object, defined once in the unit, and
     * the same at every evaluation (docs/extensions.md, String Literals) *)
    let stringLiteral(p: P s: String): String =
        begin
            if not(hashMap.contains(p.stringObjects s)) then
                let name = "qsl_" <> conv.int(hashMap.size(p.stringObjects) + 1)
                put(p.stringObjects s name)
                vector.append(p.stringDecls "static Q_UNUSED const QStaticString " <> name
                    <> " = { Q_STATIC_STRING_HEADER, { " <> lit(stringOp.length(s)) <> ", (char *)" <> syntax.cString(s)
                    <> " } };")
            end
            "((QString *)&" <> hashMap.find(p.stringObjects s) <> ".string)"
        end

    let const(p: P c: nodes.Const): String =
        case c.value
            when constOk then "Q_OK_VAL"
            when constBool with x then if x.b then "true" else "false" end
            when constInt with x then
                if shapes.kindIs(c.shape shapes.shapeInt) then lit(x.n)
                else raise unsupported with "constant " <> conv.int(x.n) <> " of shape "
                    <> shapes.kindName(c.shape.kind) end
                end
            when constReal with x then syntax.cReal(x.r)
            when constChar with x then syntax.cChar(x.c)
            when constString with x then stringLiteral(p x.s)
        end

    let atom(p: P a: Atom): String =
        case a
            when atomConst with x then const(p x.c)
            when atomVar with x then
                let v = x.v
                if isOk(v.type) then
                    "Q_OK_VAL"
                else
                    let n = name(p v)
                    if hashMap.contains(p.handlerVars v.id) then n <> ".exc"
                    elsif v.isMutable andif isPointerParam(p v) then
                        if v.boxed then "(*(*" <> n <> "))" else "(*" <> n <> ")" end
                    elsif v.boxed andif v.isMutable then
                        (* A boxed mutable variable holds its location's box (a
                         * boxed value is the box itself) *)
                        "(*" <> n <> ")"
                    else
                        n
                    end
                end
        end

    let varAtom(p: P v: Variable): String = atom(p nodes.atomOfVar(v))

    let atoms(p: P xs: Array(Atom)): vector.T(String) =
        begin
            let res = vector.new(:String)
            for i = 0 upto {extent xs - 1} do add(res atom(p xs[i])) end
            res
        end

    (* The site of a raise at offset in the unit, as a C string
     * ("file:line:col"), or NULL if it is not known *)
    let site(p: P offset: maybe.T(Int)): String =
        begin
            let s = if maybe.isNone(offset) then maybe.none(:String)
                else nodes.site(p.unit maybe.unwrap(offset)) end
            if maybe.isNone(s) then "NULL" else syntax.cString(maybe.unwrap(s)) end
        end

    (* =========================================================================
     * Proxies (docs/c-representation.md section 5.8): a value of a tuple or
     * option type that may be proxied may be a view of an object of a subtype,
     * whose components are read (and var components written) through the
     * runtime, as the represent pass decided
     * ====================================================================== *)

    (* The slot form of component i of the tuple t of shape ts, read as access
     * says *)
    let tupleComponent(p: P t: String ts: Shape i: Int access: nodes.Access): String =
        case access
            when direct then "(" <> t <> ")->_" <> cInt(i)
            (* Read from the original as it is (its slot at the same offset) *)
            when original then "((" <> cType(ts.type) <> ")quest_unproxy(" <> t <> "))->_" <> cInt(i)
            when proxy then
                let comp = componentShape(ts i)
                let tmp = temp(p slotCType(comp))
                let through = types.shapeQvalToSlot("quest_proxy_element(" <> t <> ", " <> cInt(i) <> ")" comp)
                emit(p tmp <> " = quest_is_proxy(" <> t <> ") ? " <> through <> " : (" <> t <> ")->_" <> cInt(i) <> ";")
                tmp
        end

    (* The tag of the option v, in its type's numbering, read as access says *)
    let optionTag(v: String access: nodes.Access): String =
        case access
            when direct then "((" <> v <> ")->tag)"
            when original, proxy then "(quest_is_proxy(" <> v <> ") ? quest_proxy_tag(" <> v <> ") : (" <> v <> ")->tag)"
        end

    (* The tag of the variant or option v, of shape ts, in its numbering: read
     * as access says, or for a bounded type parameter's value, through the
     * view map of its type argument at the bound ts *)
    let tagOf(p: P v: String ts: Shape access: nodes.Access viewMap: maybe.T(Variable)): String =
        if maybe.isSome(viewMap) then
            let vm = name(p maybe.unwrap(viewMap))
            case ts.kind
                when shapeVariant then "(" <> vm <> "->index[" <> v <> ".tag])"
                when shapeInt, shapeReal, shapeBool, shapeChar, shapeString, shapeOk, shapeWord, shapeBottom,
                    shapeTuple, shapeRecord, shapeOption, shapeArray, shapeCell, shapeOut, shapeException, shapeFun,
                    shapeAll, shapeAuto, shapeTypevar, shapeAbstract, shapeExternal, shapeOperator, shapePending then
                    "quest_view_option_tag(" <> v <> ", " <> vm <> ")"
            end
        elsif shapes.kindIs(ts shapes.shapeVariant) then
            v <> ".tag"
        else
            optionTag(v access)
        end

    (* The slot form of component i (none: the payload, when it is not a tuple)
     * of the payload of case tag of the option v of shape os, read as access
     * says *)
    let optionComponent(p: P v: String os: Shape tag: String i: maybe.T(Int) access: nodes.Access): String =
        begin
            let part = if maybe.isNone(i) then ".val" else "._" <> cInt(maybe.unwrap(i)) end
            let raw = v <> "->u.qo_" <> tag <> part
            case access
                when direct then raw
                when original then
                    "((" <> layout.shapeRepresentation(os) <> ")quest_unproxy(" <> v <> "))->u.qo_" <> tag <> part
                when proxy then
                    let cs = maybe.unwrap(caseShape(os tag))
                    let comp = if maybe.isNone(i) then cs else componentShape(cs maybe.unwrap(i)) end
                    let tmp = temp(p slotCType(comp))
                    let through = types.shapeQvalToSlot("quest_proxy_option_element(" <> v <> ", "
                        <> cInt(maybe.unwrapOr(i 0)) <> ")" comp)
                    emit(p tmp <> " = quest_is_proxy(" <> v <> ") ? " <> through <> " : " <> raw <> ";")
                    tmp
            end
        end

    (* The payload of case tag of a variant held at its own view, read through
     * the view map and converted to the bound's type for it, or a new tuple of
     * an option's case components (after its ordinal, when t has one more
     * component than the case), read so, as a value of type t *)
    let viewPayload(p: P v: String ts: Shape tag: String viewMap: Variable t: Type): String =
        begin
            let vm = name(p viewMap)
            let b = tagIndexOf(ts tag)
            let cs = caseShape(ts tag)
            case ts.kind
                when shapeVariant then
                    let caseS = if maybe.isSome(cs) then maybe.unwrap(cs) else shapeOf(t) end
                    types.shapeQvalUnwrap("quest_view_part(" <> vm <> ", " <> cInt(b) <> ", " <> v <> ".payload)" caseS)
                when shapeInt, shapeReal, shapeBool, shapeChar, shapeString, shapeOk, shapeWord, shapeBottom,
                    shapeTuple, shapeRecord, shapeOption, shapeArray, shapeCell, shapeOut, shapeException, shapeFun,
                    shapeAll, shapeAuto, shapeTypevar, shapeAbstract, shapeExternal, shapeOperator, shapePending then
                    let tupleS = shapeOf(t)
                    if not(shapes.kindIs(tupleS shapes.shapeTuple)) then
                        (* A payload that is not a tuple: its one component *)
                        types.shapeQvalUnwrap("quest_view_option_component(" <> v <> ", " <> vm <> ", " <> conv.int(b)
                            <> ", 0)" tupleS)
                    else
                        let struct = layout.shapeTag(tupleS)
                        let tmp = temp(p struct <> " *")
                        emit(p tmp <> " = (" <> struct <> " *)quest_alloc(sizeof(" <> struct <> "), "
                            <> layoutRef(p objectLayout.tupleLayout(tupleS struct noBoxes)) <> ");")
                        let mark = beginInit(p tmp)
                        let comps = vector.new(:Shape)
                        if maybe.isSome(cs) then
                            let pt = maybe.unwrap(cs)
                            case pt.kind
                                when shapeTuple then
                                    for i = 0 upto {extent pt.components - 1} do
                                        vector.append(comps componentShape(pt i)) end
                                when shapeInt, shapeReal, shapeBool, shapeChar, shapeString, shapeOk, shapeWord,
                                    shapeBottom, shapeRecord, shapeVariant, shapeOption, shapeArray, shapeCell,
                                    shapeOut,
                                    shapeException, shapeFun, shapeAll, shapeAuto, shapeTypevar, shapeAbstract,
                                    shapeExternal, shapeOperator, shapePending then
                                    vector.append(comps pt)
                            end
                        end
                        let offset = extent tupleS.components - vector.length(comps)
                        if offset > 0 then emit(p tmp <> "->_0 = 0LL;") end
                        for j = 0 upto {vector.length(comps) - 1} do
                            let word = "quest_view_option_component(" <> v <> ", " <> vm <> ", " <> cInt(b) <> ", "
                                <> cInt(j) <> ")"
                            let slot = types.shapeQvalToSlot(word componentShape(tupleS j + offset))
                            emit(p tmp <> "->_" <> cInt(j + offset) <> " = " <> slot <> ";")
                        end
                        initBarrier(p mark tmp)
                        tmp
                    end
            end
        end

    (* =========================================================================
     * Aggregates being made, and their fields' boxes
     * ====================================================================== *)

    (* The fields of an aggregate being made: the atoms' C expressions (their
     * slot forms), or for those the represent pass embedded, fresh boxes,
     * which the aggregate's allocation makes room for *)
    let slotFields(p: P args: Array(Atom) shapesOf: Array(Shape) embedded: Array(Int)): vector.T(Field) =
        begin
            let res = vector.new(:Field)
            let n = if extent args < extent shapesOf then extent args else extent shapesOf end
            for i = 0 upto {n - 1} do
                let var isEmbedded = false
                for j = 0 upto {extent embedded - 1} do if embedded[j] is i then isEmbedded := true end end
                let value = atom(p args[i])
                vector.append(res if isEmbedded then
                    option fieldFresh of Field with let value = value let shape = shapesOf[i] end
                else
                    text(value)
                end)
            end
            res
        end

    Let Sized = Tuple size: String fields: vector.T(Field) end

    (* The size of an aggregate's allocation with room after it (size, at
     * block) for the boxes of its fields that are fresh, and the fields,
     * those boxes' addresses in place of the fresh ones: a field's box is
     * immutable, so it may share the aggregate's allocation *)
    let embeddedBoxes(p: P block: String size: String fields: vector.T(Field)): Sized =
        begin
            let var fresh = 0
            for i = 0 upto {vector.length(fields) - 1} do
                case vector.get(fields i) when fieldFresh then fresh := fresh + 1 else ok end
            end
            if fresh is 0 then
                tuple let size = size let fields = fields end
            else
                let boxes = temp(p "QRecordVal *")
                p.pending := maybe.some(tuple let boxes = boxes let block = block end)
                let res = vector.new(:Field)
                let var k = 0
                for i = 0 upto {vector.length(fields) - 1} do
                    let f = vector.get(fields i)
                    case f
                        when fieldFresh with x then
                            let box = "((" <> slotCType(x.shape) <> ")&" <> boxes <> "[" <> cInt(k) <> "])"
                            vector.append(res option fieldBox of Field with let k = k let box = box let value =
                                x.value end)
                            k := k + 1
                        else vector.append(res f)
                    end
                end
                tuple let size = size <> " + " <> cInt(fresh) <> " * sizeof(QRecordVal)" let fields = res end
            end
        end

    (* Fills in the embedded boxes of fields, returning the fields' slot
     * forms *)
    let fillEmbedded(p: P fields: vector.T(Field)): vector.T(String) =
        begin
            let res = vector.new(:String)
            if maybe.isSome(p.pending) then
                let pending = maybe.unwrap(p.pending)
                p.pending := maybe.none()
                emit(p pending.boxes <> " = (QRecordVal *)(" <> pending.block <> " + 1);")
                for i = 0 upto {vector.length(fields) - 1} do
                    case vector.get(fields i)
                        when fieldBox with x then
                            emit(p "*" <> x.box <> " = " <> x.value <> ";")
                            add(res x.box)
                        when fieldText with x then add(res x.s)
                        when fieldFresh with x then add(res x.value)
                    end
                end
            else
                for i = 0 upto {vector.length(fields) - 1} do
                    case vector.get(fields i)
                        when fieldText with x then add(res x.s)
                        when fieldFresh with x then add(res x.value)
                        when fieldBox with x then add(res x.box)
                    end
                end
            end
            res
        end

    (* A new tuple of type t of the fields *)
    let makeTuple(p: P t: Type fields: vector.T(Field)): String =
        begin
            let struct = layout.shapeTag(shapeOf(t))
            let tmp = temp(p struct <> " *")
            let sized = embeddedBoxes(p tmp "sizeof(" <> struct <> ")" fields)
            emit(p tmp <> " = (" <> struct <> " *)quest_alloc(" <> sized.size <> ", "
                <> layoutRef(p objectLayout.tupleLayout(shapeOf(t) struct boxShapes(fields))) <> ");")
            let mark = beginInit(p tmp)
            let values = fillEmbedded(p sized.fields)
            for i = 0 upto {vector.length(values) - 1} do
                emit(p tmp <> "->_" <> cInt(i) <> " = " <> vector.get(values i) <> ";")
            end
            initBarrier(p mark tmp)
            tmp
        end

    let textFields(xs: vector.T(String)): vector.T(Field) =
        begin
            let res = vector.new(:Field)
            for i = 0 upto {vector.length(xs) - 1} do
                vector.append(res text(vector.get(xs i))) end
            res
        end

    (* The address of a slot holding values of shape s, as the address of a
     * location of the value: a record's or variant's box, a Bool's or Char's
     * word through its first byte *)
    let slotAddress(ptr: String s: Shape): String =
        begin
            let slot = slotCType(s)
            let c = layout.shapeLocationRepresentation(s)
            if eq(slot c) then ptr else "((" <> c <> " *)" <> ptr <> ")" end
        end

    (* A field's slot: a C pointer to it, and the field's shape *)
    Let Slot = Tuple ptr: String shape: Shape end
    let fieldIndex(rs: Shape field: String): Int =
        begin
            let fields = shapes.sortedComponents(rs)
            let var index = ~1
            for i = 0 upto {extent fields - 1} do
                if {index < 0} andif eq(maybe.unwrap(fields[i].name) field) then index := i end
            end
            index
        end
    (* The slot of field in the record recC, a QRecordVal (a pointer to the
     * record's payload, val, and its offset table, dict) seen at shape rs:
     * what recordField reads, a store into a var field writes, and & of a
     * field takes. Code that sees a record at a supertype cannot know where
     * its creator put a field, so it finds the field through the offset
     * table, a struct of one byte offset per field of the type it is seen at
     * (docs/c-representation.md section 5.2). A value of a type parameter
     * bounded by rs is held at its type argument's view, with that type's
     * table, whose fields are not rs's; there viewMap, which the function's
     * prologue fetched from the runtime, gives the index of rs's field among
     * the argument's (docs/codegen-c.md section 10.4) *)
    let recordSlot(p: P recC: String rs: Shape field: String viewMap: maybe.T(Variable)): Slot =
        begin
            let fields = shapes.sortedComponents(rs)
            let k = fieldIndex(rs field)
            let fs = maybe.unwrap(fields[k].shape)
            if maybe.isSome(viewMap) then
                let slot = syntax.call("quest_view_record_slot"
                    strings(array of recC name(p maybe.unwrap(viewMap)) cInt(k) end))
                tuple let ptr = "((" <> slotCType(fs) <> " *)" <> slot <> ")" let shape = fs end
            else
                let dictType = staticdata.offsetDictStructName(p.ctx rs.structure)
                tuple
                    let ptr = "((" <> slotCType(fs) <> " *)((char *)" <> recC <> ".val + ((const " <> dictType <> " *)"
                        <> recC <> ".dict)->offset_" <> field <> "))"
                    let shape = fs
                end
            end
        end

    (* =========================================================================
     * Conversions
     * ====================================================================== *)

    (* The C expression for the value of C expression c converted as plan
     * says: the C for a convert operation, whose plan the represent pass chose
     * (plan in ir/represent; nodes.Plan lists the kinds). A plan that needs
     * more than an expression emits statements first, and returns a temporary
     * holding the result.
     *
     * For example, where the plan's kind is (a cast's star is written apart
     * from its parenthesis here, since together they would end this comment)
     *
     * - box: a native value into a QVal, the one word in which generic code
     *   holds a value of an unbounded type parameter, and unbox, back:
     *       ((QVal){ .i = (int64_t)(2LL) })        (l_t_2.i)
     * - record_view: a record seen at a supertype, which needs the table of
     *   field offsets for that type, looked up by the runtime:
     *       quest_record_view(g_r0, (&quest_type_QT_record_48ec741d...))
     * - variant_tags: a variant's tag renumbered for a supertype, through a
     *   static table (emitCoercionTables in codegen/c/declarations):
     *       ((QVariantVal){ .tag = tagmap_..._a_Int_c_Int[_t3.tag],
     *                       .payload = _t3.payload })
     * - cast: the same pointer through another struct type whose layout
     *   agrees. A cast between two tuple types is recorded (tupleCasts), so
     *   that a static assertion checks that the layouts do agree:
     *       ((QTuple_Int * )g_t0)
     * - unproxy: a tuple or option that may be a proxy (a stand-in showing
     *   the original at another view, docs/c-representation.md section 5.8)
     *   used where it cannot be one, which the original serves:
     *       ((QTuple_Int * )quest_unproxy(c))
     * - slot_box and slot_unbox: a record or variant into, or out of, the box
     *   an aggregate's slot holds it in, a dereference of c for slot_unbox;
     * - view and runtime: converted by the runtime between the descriptors of
     *   two types (quest_convert), through a QVal;
     * - adapt: a closure wrapped in a new closure whose function is the
     *   plan's adapter (a function of the unit, made by ir/thunks), converting
     *   the arguments and the result, and whose environment is the original
     *   closure;
     * - copy: a new tuple, each component read from the source and converted
     *   by its own plan. *)
    let rec convert(p: P c: String plan: nodes.Plan): String =
        begin
            let kind = plan.kind
            case kind
                when planBox then
                    types.qvalWrap(c plan.source)
                when planUnbox then
                    types.qvalUnwrap(c plan.target)
                when planRecordView then
                    "quest_record_view(" <> c <> ", " <> descriptor(p plan.descriptors[0]) <> ")"
                when planVariantTags then
                    let table = maybe.unwrap(plan.tagMap)
                    let v = temp(p "QVariantVal")
                    emit(p v <> " = " <> c <> ";")
                    let tagmap = "tagmap_" <> layout.typeTag(table.target) <> "_" <> layout.typeTag(table.source)
                    "((QVariantVal){ .tag = " <> tagmap <> "[" <> v <> ".tag], .payload = " <> v <> ".payload })"
                when planCast then
                    let sourceS = shapeOf(plan.source)
                    let targetS = shapeOf(plan.target)
                    if shapes.kindIs(sourceS shapes.shapeTuple) andif shapes.kindIs(targetS shapes.shapeTuple)
                        andif not(eq(layout.shapeTag(sourceS) layout.shapeTag(targetS))) then
                        let key = layout.shapeTag(targetS) <> "\n" <> layout.shapeTag(sourceS)
                        if not(hashMap.contains(p.tupleCasts key)) then
                            add(p.tupleCastKeys key) end
                        put(p.tupleCasts key
                            tuple let target = targetS.structure let source = sourceS.structure end)
                    end
                    "((" <> cType(plan.target) <> ")" <> c <> ")"
                when planUnproxy then
                    "((" <> cType(plan.target) <> ")quest_unproxy(" <> c <> "))"
                when planSlotBox then
                    types.shapeSlotStore(c shapeOf(plan.source))
                when planSlotUnbox then
                    "(*" <> c <> ")"
                when planView then
                    let sourceD = descriptor(p plan.descriptors[0])
                    let targetD = descriptor(p plan.descriptors[1])
                    let converted = "quest_convert(" <> types.qvalWrap(c plan.source) <> ", " <> sourceD <> ", "
                        <> targetD <> ")"
                    types.qvalUnwrap(converted plan.target)
                when planAdapt then
                    if maybe.isNone(plan.thunk) then
                        raise unsupported with "C printing of an adapt plan without its adapter" end
                    end
                    let clos = temp(p "QClosure *")
                    emit(p clos <> " = (QClosure *)quest_alloc(sizeof(QClosure), &quest_layout_closure);")
                    let mark = beginInit(p clos)
                    emit(p clos <> "->fn = (void *)" <> codeName(p maybe.unwrap(plan.thunk)) <> ";")
                    emit(p clos <> "->env = (void *)(" <> c <> ");")
                    initBarrier(p mark clos)
                    clos
                when planRuntime then
                    let l = maybe.unwrap(plan.layout)
                    let genericType = if l.toGeneric then plan.target else plan.source end
                    let nativeType = model.substitute(genericType l.subst)
                    let fromType = if l.toGeneric then nativeType else genericType end
                    let toType = if l.toGeneric then genericType else nativeType end
                    let fromD = descriptor(p plan.descriptors[0])
                    let toD = descriptor(p plan.descriptors[1])
                    let converted = "quest_convert(" <> types.qvalWrap(c fromType) <> ", " <> fromD <> ", " <> toD
                        <> ")"
                    types.qvalUnwrap(converted toType)
                when planCopy then
                    let src = temp(p cType(plan.source))
                    emit(p src <> " = " <> c <> ";")
                    let fields = vector.new(:Field)
                    let sourceS = shapeOf(plan.source)
                    let targetS = shapeOf(plan.target)
                    let n = if extent targetS.components < extent plan.fields then extent targetS.components
                        else extent plan.fields
                    end
                    for i = 0 upto {n - 1} do
                        let tc = componentShape(targetS i)
                        let fp = plan.fields[i]
                        let sc = componentShape(sourceS i)
                        let fc = tupleComponent(p src sourceS i plan.access[i])
                        let byDescriptor =
                            maybe.isSome(fp) andif nodes.planIs(maybe.unwrap(fp) nodes.planView)
                        if byDescriptor then
                            (* Converted by descriptor, from the slot's QVal
                             * form to the target slot's *)
                            let f = maybe.unwrap(fp)
                            let sourceD = descriptor(p f.descriptors[0])
                            let targetD = descriptor(p f.descriptors[1])
                            let converted = "quest_convert(" <> types.shapeSlotToQval(fc sc) <> ", " <> sourceD <> ", "
                                <> targetD <> ")"
                            vector.append(fields text(types.shapeQvalToSlot(converted tc)))
                        elsif maybe.isSome(fp) then
                            vector.append(fields
                                text(types.shapeSlotStore(convert(p types.shapeSlotLoad(fc sc)
                                    maybe.unwrap(fp)) tc)))
                        elsif eq(slotCType(sc) slotCType(tc)) then
                            vector.append(fields text(fc))
                        else
                            vector.append(fields text(types.shapeQvalToSlot(types.shapeSlotToQval(fc sc) tc)))
                        end
                    end
                    makeTuple(p plan.target fields)
            end
        end

    (* =========================================================================
     * Aggregates (laid out as docs/c-representation.md section 5 says)
     * ====================================================================== *)

    (* A new record, made in its box (the payload following it in one
     * allocation): the box, for a boxed variable, or the record *)
    let makeRecord(p: P o: nodes.OpMakeRecord result: Variable): String =
        begin
            let fields = vector.new(:model.RecordField)
            for i = 0 upto {extent o.fields - 1} do
                let f = o.fields[i]
                vector.append(fields tuple
                    let name = f.name let type = atomType(f.atom) let isVar = f.isVar
                end)
            end
            let concrete = model.recordType(vector.toArray(fields) maybe.none())
            let struct = staticdata.recordStructName(concrete maybe.some(p.ctx))
            let box = temp(p "QRecordVal *")
            let payload = temp(p struct <> " *")
            Let Stored = Tuple index: Int name: String a: Atom end
            let stored = vector.new(:Stored)
            for i = 0 upto {extent o.fields - 1} do
                if not(isOk(atomType(o.fields[i].atom))) then
                    vector.append(stored tuple let index = i let name = o.fields[i].name let a =
                        o.fields[i].atom end)
                end
            end
            let values = vector.new(:Field)
            for j = 0 upto {vector.length(stored) - 1} do
                let s = vector.get(stored j)
                let var isEmbedded = false
                for k = 0 upto {extent o.embedded - 1} do if o.embedded[k] is s.index then isEmbedded := true end end
                let value = atom(p s.a)
                vector.append(values if isEmbedded then
                    option fieldFresh of Field with let value = value let shape = shapeOf(atomType(s.a)) end
                else
                    text(value)
                end)
            end
            let sized = embeddedBoxes(p payload "sizeof(QRecordVal) + sizeof(" <> struct <> ")" values)
            emit(p box <> " = (QRecordVal *)quest_alloc(" <> sized.size <> ", "
                <> layoutRef(p objectLayout.recordLayout(concrete struct boxShapes(values))) <> ");")
            let mark = beginInit(p box)
            emit(p payload <> " = (" <> struct <> " *)(" <> box <> " + 1);")
            emit(p payload <> "->header.descriptor = " <> maybeDescriptor(p o.descriptor) <> ";")
            let filled = fillEmbedded(p sized.fields)
            for j = 0 upto {vector.length(stored) - 1} do
                emit(p payload <> "->qf_" <> vector.get(stored j).name <> " = "
                    <> vector.get(filled j) <> ";")
            end
            let dictExpr = if o.runtimeOffsets then
                "quest_record_dict(" <> maybeDescriptor(p o.viewDescriptor) <> ", " <> maybeDescriptor(p o.descriptor)
                    <> ")"
            else
                let table = maybe.unwrap(o.offsets)
                "(const void *)&" <> staticdata.offsetDictInstanceName(p.ctx table.view table.layout)
            end
            emit(p "*" <> box <> " = (QRecordVal){ .val = (void *)" <> payload <> ", .dict = " <> dictExpr <> " };")
            initBarrier(p mark box)
            if result.boxed then box else "(*" <> box <> ")" end
        end

    (* A field of a record of shape rs, through its offset table: its slot
     * form, or when stored (a field the payload may store at another type)
     * read as stored and converted to the field's type, by its descriptor *)
    let recordField(p: P recC: String rs: Shape field: String o: nodes.OpRecordField): String =
        begin
            let slot = recordSlot(p recC rs field o.viewMap)
            if not(o.stored) then
                "(*" <> slot.ptr <> ")"
            elsif maybe.isSome(o.viewMap) then
                (* Through the view map: read as stored, converted to the
                 * bound's type for it *)
                let k = fieldIndex(rs field)
                types.shapeQvalUnwrap("quest_view_record_field(" <> recC <> ", "
                    <> name(p maybe.unwrap(o.viewMap))
                    <> ", " <> cInt(k) <> ")" slot.shape)
            else
                let index = fieldIndex(rs field)
                let cField = layout.shapeRepresentation(slot.shape)
                let dictType = staticdata.offsetDictStructName(p.ctx rs.structure)
                let val = temp(p cField)
                let stored = "((const " <> dictType <> " *)" <> recC <> ".dict)->stored_types"
                let converted = types.shapeQvalUnwrap("quest_convert(quest_slot_read(" <> slot.ptr <> "), " <> stored
                    <> "["
                    <> cInt(index) <> "], " <> maybeDescriptor(p o.descriptor) <> ")" slot.shape)
                emit(p "if (" <> stored <> " != NULL && " <> stored <> "[" <> cInt(index) <> "] != NULL) " <> val
                    <> " = "
                    <> converted <> ";")
                emit(p "else " <> val <> " = " <> types.shapeSlotLoad("*" <> slot.ptr slot.shape) <> ";")
                val
            end
        end

    (* Whether a tuple's let st can be fused into the option the next
     * statement makes of it: the option's case stores each component as the
     * tuple would (of the same shape, read directly), and none needs a box *)
    let fusable(p: P st: nodes.StmtLet next: nodes.Stmt): Bool =
        case st.value
            when opMakeTuple with t then
                case next
                    when sLet with y then
                        case y.value
                            when opMakeOption with o then
                                let os = held(y.v.type shapes.shapeOption)
                                let rs = shapeOf(st.v.type)
                                let pt = if maybe.isSome(o.tag) then caseShape(os maybe.unwrap(o.tag))
                                    else maybe.none(:Shape) end
                                if {extent t.embedded > 0} orif maybe.isNone(pt)
                                    orif not(shapes.kindIs(maybe.unwrap(pt) shapes.shapeTuple))
                                    orif {extent maybe.unwrap(:Shape pt).components isnot extent rs.components}
                                    orif {extent t.args isnot extent rs.components} then
                                    false
                                else
                                    let cs = maybe.unwrap(pt)
                                    let var same = true
                                    for i = 0 upto {extent rs.components - 1} do
                                        if {componentShape(rs i).id isnot componentShape(cs i).id}
                                            orif not(o.access[i]?direct) then
                                            same := false
                                        end
                                    end
                                    same
                                end
                            else false
                        end
                    else false
                end
            else false
        end

    (* The lets of a body's tuples that only the next statement uses, as the
     * payload of the option it makes: those not global, volatile, or unboxed
     * (docs/c-representation.md section 5.3, payloads not made) *)
    let fusedTuples(p: P b: nodes.Body): hashMap.T(Int nodes.Stmt) =
        begin
            let found = hashMap.new(:Int :nodes.Stmt intEqual hash.int)
            let uses = hashMap.new(:Int :Int intEqual hash.int)
            let all = walk.walkStatements(b false)
            for i = 0 upto {vector.length(all) - 1} do
                let us = walk.statementUses(vector.get(all i))
                for j = 0 upto {extent us - 1} do
                    case us[j]
                        when atomVar with v then
                            put(uses v.v.id maybe.unwrapOr(hashMap.get(uses v.v.id) 0) + 1)
                        else ok
                    end
                end
            end
            let rec visit(body: nodes.Body): Ok =
                begin
                    let n = vector.length(body.statements)
                    for k = 0 upto {n - 1} do
                        let st = vector.get(body.statements k)
                        let inner = walk.statementBodies(st)
                        for j = 0 upto {extent inner - 1} do visit(inner[j]) end
                        if {k + 1} < n then
                            case st
                                when sLet with x then
                                    let next = vector.get(body.statements k + 1)
                                    let paysFor = case next
                                        when sLet with y then
                                            case y.value
                                                when opMakeOption with o then
                                                    maybe.isNone(o.ordinalAtom)
                                                        andif maybe.isSome(o.payload)
                                                        andif case maybe.unwrap(o.payload)
                                                            when atomVar with v then nodes.same(v.v x.v)
                                                            else false
                                                        end
                                                else false
                                            end
                                        else false
                                    end
                                    let readOnce = case next
                                        when sLet with y then
                                            case y.value
                                                when opTupleField with f then
                                                    maybe.isNone(f.viewMap)
                                                        andif {f.index >= 1} andif case f.tup
                                                            when atomVar with v then nodes.same(v.v x.v)
                                                            else false
                                                        end
                                                else false
                                            end
                                        else false
                                    end
                                    let payloadRead = readOnce andif case x.value
                                        when opPayload with q then
                                            maybe.isNone(q.viewMap)
                                                andif tagShape(atomType(q.value)).kind?shapeOption
                                        else false
                                    end
                                    if {{paysFor andif fusable(p x next)} orif payloadRead} andif not(x.v.unboxed)
                                        andif not(hashMap.contains(p.globals x.v.id))
                                        andif not(hashMap.contains(p.fs.volatile x.v.id))
                                        andif {maybe.unwrapOr(hashMap.get(uses x.v.id) 0) is 1} then
                                        put(found x.v.id st)
                                    end
                                else ok
                            end
                        end
                    end
                end
            visit(b)
            found
        end

    (* The C values of a fused payload tuple's components, as its slots would
     * have held them *)
    let fusedValues(p: P st: nodes.Stmt): vector.T(String) =
        begin
            let values = vector.new(:String)
            case st
                when sLet with x then
                    case x.value
                        when opMakeTuple with t then
                            for i = 0 upto {extent t.args - 1} do add(values atom(p t.args[i])) end
                        else ok
                    end
                else ok
            end
            values
        end

    (* A new option of shape os, allocated as its C struct, struct: makeOption's
     * case for an option whose case has components (options of cases without
     * any are entries of a static table). The tag stored is the case's index
     * in os, whose cases are ordered by name; for option ordinal(n) of T end,
     * it is computed at run time, from n checked to be in range, through a
     * table from T's order of cases to os's when they differ. The payload's
     * components go into the case's member of the struct's union, u.qo_<tag>:
     * those of a fused tuple (fusedTuples), the payload tuple never made, or
     * else read from the payload tuple as o.access says, or for a case whose
     * payload is not a tuple, the payload itself, in .val *)
    (* The tag of an option made with ordinal(value): the ordinal, checked to
     * be one of the type's cases, counts in its cases as written, and the tag
     * numbers the shape's, ordered by name, so it goes through a table unless
     * the two orders agree *)
    let ordinalTag(p: P o: nodes.OpMakeOption os: Shape value: Atom): String =
        begin
            let checked = syntax.call("quest_check_option_ordinal_at"
                strings(array of atom(p value) lit(extent os.cases) site(p o.offset) end))
            let tags = array of(extent o.cases 0)
            let var identity = true
            for i = 0 upto {extent o.cases - 1} do
                tags[i] := tagIndexOf(os o.cases[i])
                if not(tags[i] is i) then identity := false end
            end
            if identity then checked else syntax.indexTable(tags) <> "[" <> checked <> "]" end
        end

    let makeAllocatedOption(p: P o: nodes.OpMakeOption os: Shape struct: String): String =
        begin
            let tmp = temp(p struct <> " *")
            emit(p tmp <> " = (" <> struct <> " *)quest_alloc(sizeof(" <> struct <> "), "
                <> layoutRef(p objectLayout.optionLayout(os struct o.tag)) <> ");")
            let mark = beginInit(p tmp)
            let var tag = o.tag
            if maybe.isSome(o.ordinalAtom) then
                (* The ordinal counts in the type's cases as written; the tag
                 * numbers the shape's, ordered by name *)
                let ordinalValue = maybe.unwrap(o.ordinalAtom)
                emit(p tmp <> "->tag = " <> ordinalTag(p o os ordinalValue) <> ";")
                (* The payload is stored as the case of a constant ordinal
                 * stores it, and otherwise as the first case does, whose
                 * components the union overlays on the other cases' *)
                let n = case ordinalValue
                    when atomConst with x then case x.c.value when constInt with y then y.n else ~1 end
                    else ~1
                end
                tag := if {n >= 0} andif {n < extent o.cases} then some(o.cases[n])
                    else os.cases[0].name
                end
            else
                emit(p tmp <> "->tag = " <> lit(tagIndex(os tag)) <> ";")
            end
            let fusedLet = if maybe.isSome(o.payload) then
                case maybe.unwrap(o.payload)
                    when atomVar with v then hashMap.get(p.fs.fused v.v.id)
                    else maybe.none(:nodes.Stmt)
                end
            else
                maybe.none(:nodes.Stmt)
            end
            let fusedComponents = if maybe.isSome(fusedLet) andif maybe.isSome(tag) then
                maybe.some(fusedValues(p maybe.unwrap(fusedLet)))
            else
                maybe.none(:vector.T(String))
            end
            if maybe.isSome(fusedComponents) then
                (* The payload tuple's components, stored as it would have
                 * stored them, the tuple never made *)
                let values = maybe.unwrap(fusedComponents)
                for i = 0 upto {vector.length(values) - 1} do
                    emit(p tmp <> "->u.qo_" <> maybe.unwrap(tag) <> "._" <> cInt(i) <> " = "
                        <> vector.get(values i) <> ";")
                end
            elsif maybe.isSome(o.payload) andif maybe.isSome(tag) then
                let tagName = maybe.unwrap(tag)
                let pt = caseShape(os tagName)
                let payloadAtom = maybe.unwrap(o.payload)
                let pv = atom(p payloadAtom)
                if maybe.isSome(pt) andif shapes.kindIs(maybe.unwrap(pt) shapes.shapeTuple) then
                    let ps = shapeOf(atomType(payloadAtom))
                    for i = 0 upto {extent maybe.unwrap(:Shape pt).components - 1} do
                        emit(p tmp <> "->u.qo_" <> tagName <> "._" <> cInt(i) <> " = "
                            <> tupleComponent(p pv ps i o.access[i]) <> ";")
                    end
                else
                    emit(p tmp <> "->u.qo_" <> tagName <> ".val = " <> pv <> ";")
                end
            end
            initBarrier(p mark tmp)
            tmp
        end

    (* Whether an option shape's case has no components *)
    let caseWithoutComponents(os: Shape tag: String): Bool =
        begin
            let pt = caseShape(os tag)
            maybe.isNone(pt) orif {extent maybe.unwrap(:Shape pt).components is 0}
        end

    (* The table of option struct's options of each tag, which those of cases
     * without components are
     * (docs/c-representation.md section 5.3) *)
    let optionTable(p: P struct: String count: Int): String =
        begin
            if not(hashMap.contains(p.optionTables struct)) then
                let name = "qc_" <> struct
                put(p.optionTables struct name)
                let entries = vector.new(:String)
                for i = 0 upto {count - 1} do vector.append(entries "{ .tag = " <> lit(i) <> " }") end
                vector.append(p.optionTableDecls "static Q_UNUSED const " <> struct <> " " <> name <> "["
                    <> cInt(count) <> "] = { " <> strutil.join(", " entries) <> " };")
            end
            hashMap.find(p.optionTables struct)
        end

    (* A new option of type t, as o makes it: for a case without components,
     * a pointer to its entry in the option struct's static table
     * (optionTable), and for an ordinal, when no case has components, the
     * entry its checked value picks; otherwise one allocated
     * (makeAllocatedOption) *)
    let makeOption(p: P o: nodes.OpMakeOption t: Type): String =
        begin
            let os = held(t shapes.shapeOption)
            let struct = layout.shapeTag(os)
            let var allWithout = true
            for i = 0 upto {extent os.cases - 1} do
                if not(caseWithoutComponents(os maybe.unwrapOr(os.cases[i].name ""))) then allWithout := false end
            end
            if maybe.isNone(o.ordinalAtom) andif maybe.isSome(o.tag)
                andif caseWithoutComponents(os maybe.unwrap(o.tag)) then
                "((" <> struct <> " *)&" <> optionTable(p struct extent os.cases) <> "["
                    <> cInt(tagIndex(os o.tag)) <> "])"
            elsif maybe.isSome(o.ordinalAtom) andif allWithout then
                let mapped = ordinalTag(p o os maybe.unwrap(o.ordinalAtom))
                "((" <> struct <> " *)&" <> optionTable(p struct extent os.cases) <> "[" <> mapped <> "])"
            else
                makeAllocatedOption(p o os struct)
            end
        end

    (* src, component index of an option's case whose payload is stored at
     * shape stored, in wanted's slot C type: unwrapped where it is stored as
     * a QVal word and wanted is not one, cast where both are pointers of
     * different types, and otherwise (or where stored is not a tuple) src as
     * it is *)
    let optionField(src: String stored: maybe.T(Shape) index: Int wanted: Shape): String =
        if maybe.isNone(stored) orif not(shapes.kindIs(maybe.unwrap(stored) shapes.shapeTuple))
            orif {index >= extent maybe.unwrap(:Shape stored).components} then
            src
        else
            let storedC = slotCType(componentShape(maybe.unwrap(stored) index))
            let wantedC = slotCType(wanted)
            if eq(storedC "QVal") andif not(eq(wantedC "QVal")) then types.shapeQvalToSlot(src wanted)
            elsif strutil.endsWith(storedC "*") andif strutil.endsWith(wantedC "*") andif not(eq(storedC wantedC)) then
                "(" <> wantedC <> ")(" <> src <> ")"
            else src
            end
        end

    (* A new tuple of an option's case components (after offset components of
     * tupleType: the case's ordinal), read as access says *)
    let optionCaseTuple(p: P opt: String os: Shape tag: String tupleType: Type offset: Int access: Array(nodes.Access)
        ordinalValue: Int): String =
        begin
            let ts = shapeOf(tupleType)
            let struct = layout.shapeTag(ts)
            let tmp = temp(p struct <> " *")
            emit(p tmp <> " = (" <> struct <> " *)quest_alloc(sizeof(" <> struct <> "), "
                <> layoutRef(p objectLayout.tupleLayout(ts struct noBoxes)) <> ");")
            let mark = beginInit(p tmp)
            let pt = caseShape(os tag)
            if offset > 0 then emit(p tmp <> "->_0 = " <> lit(ordinalValue) <> ";") end
            if maybe.isSome(pt) andif shapes.kindIs(maybe.unwrap(pt) shapes.shapeTuple) then
                let ptShape = maybe.unwrap(pt)
                for i = 0 upto {extent ptShape.components - 1} do
                    if {i + offset} < extent ts.components then
                        let src = optionField(optionComponent(p opt os tag maybe.some(i) access[i]) pt i
                            componentShape(ts i + offset))
                        emit(p tmp <> "->_" <> cInt(i + offset) <> " = " <> src <> ";")
                    end
                end
            elsif maybe.isSome(pt) then
                emit(p tmp <> "->_" <> cInt(offset) <> " = "
                    <> optionComponent(p opt os tag maybe.none() access[0]) <> ";")
            end
            initBarrier(p mark tmp)
            tmp
        end

    (* The payload of an option's case, a tuple, which a case's binder shares
     * (var components included): the option's own, which follows its tag (a
     * tuple's struct), or through a proxy, the original's, viewed at the
     * proxy's payload type (proxied where a component changes view) *)
    let optionCasePayload(opt: String tupleType: Type tagAccess: nodes.Access access: Array(nodes.Access)): String =
        begin
            let struct = layout.shapeTag(shapeOf(tupleType))
            let own(o: String): String = "((" <> struct <> " *)((const char *)(" <> o <> ") + sizeof(int64_t)))"
            let var proxied = false
            for i = 0 upto {extent access - 1} do
                case access[i] when proxy then proxied := true when direct, original then ok end
            end
            let tagDirect = case tagAccess when direct then true when original, proxy then false end
            if tagDirect then own(opt)
            elsif not(proxied) then own("quest_unproxy(" <> opt <> ")")
            else "(quest_is_proxy(" <> opt <> ") ? (" <> struct <> " *)quest_proxy_option_payload(" <> opt <> ") : "
                <> own(opt) <> ")"
            end
        end

    (* Component index (from 1; 0 is the ordinal) of the tuple a fused payload
     * let would have made of its option: the option's tag checked as the
     * payload checks it, and the component read from its case, in the
     * tuple's slot form *)
    let payloadComponent(p: P st: nodes.Stmt index: Int): String =
        case st
            when sLet with x then
                case x.value
                    when opPayload with o then
                        let ts = tagShape(atomType(o.value))
                        let v = atom(p o.value)
                        emit(p "if (" <> optionTag(v o.access) <> " != " <> lit(tagIndexOf(ts o.tag))
                            <> ") quest_raise_variant_error_at(" <> site(p o.offset) <> ");")
                        let pt = caseShape(ts o.tag)
                        let i = index - 1
                        let wanted = componentShape(shapeOf(x.v.type) index)
                        if maybe.isSome(pt) andif shapes.kindIs(maybe.unwrap(pt) shapes.shapeTuple) then
                            optionField(optionComponent(p v ts o.tag maybe.some(i) o.components[i]) pt i wanted)
                        else
                            optionComponent(p v ts o.tag maybe.none() o.components[0])
                        end
                    else "/* not a payload */ 0"
                end
            else "/* not a payload */ 0"
        end

    (* v!tag, of type t: the payload of the variant or option o.value, after
     * a check of its tag that raises the runtime's variant error (at o's
     * site) if it is another case. A variant's payload is its payload word,
     * in its slot form. An option's is a new tuple, its ordinal (the case's
     * index in the option's type as written) then copies of the case's
     * components (docs/c-representation.md section 5.3). For a value of a
     * type parameter bounded by a variant or option type, the tag is mapped
     * and the payload read through the view map o.viewMap (see recordSlot) *)
    let payload(p: P o: nodes.OpPayload t: Type): String =
        begin
            let ts = tagShape(atomType(o.value))
            let st = site(p o.offset)
            if maybe.isSome(o.viewMap) then
                let tagC = tagOf(p atom(p o.value) ts o.access o.viewMap)
                emit(p "if (" <> tagC <> " != " <> lit(tagIndexOf(ts o.tag)) <> ") quest_raise_variant_error_at("
                    <> st <> ");")
                let result = viewPayload(p atom(p o.value) ts o.tag maybe.unwrap(o.viewMap) t)
                case ts.kind
                    when shapeOption then
                        emit(p result <> "->_0 = " <> lit(maybe.unwrapOr(o.ordinalIndex 0)) <> ";")
                    when shapeInt, shapeReal, shapeBool, shapeChar, shapeString, shapeOk, shapeWord, shapeBottom,
                        shapeTuple, shapeRecord, shapeVariant, shapeArray, shapeCell, shapeOut, shapeException,
                        shapeFun, shapeAll, shapeAuto, shapeTypevar, shapeAbstract, shapeExternal, shapeOperator,
                        shapePending then ok
                end
                result
            else
                let index = tagIndexOf(ts o.tag)
                case ts.kind
                    when shapeVariant then
                        emit(p "if (" <> atom(p o.value) <> ".tag != " <> lit(index)
                            <> ") quest_raise_variant_error_at("
                            <> st <> ");")
                        let cs = caseShape(ts o.tag)
                        let caseS = if maybe.isSome(cs) then maybe.unwrap(cs) else shapeOf(t) end
                        (* In its slot form (a record or variant, for a boxed
                         * variable) *)
                        types.shapeQvalToSlot(atom(p o.value) <> ".payload" caseS)
                    when shapeInt, shapeReal, shapeBool, shapeChar, shapeString, shapeOk, shapeWord, shapeBottom,
                        shapeTuple, shapeRecord, shapeOption, shapeArray, shapeCell, shapeOut, shapeException, shapeFun,
                        shapeAll, shapeAuto, shapeTypevar, shapeAbstract, shapeExternal, shapeOperator,
                        shapePending then
                        let tagC = optionTag(atom(p o.value) o.access)
                        emit(p "if (" <> tagC <> " != " <> lit(index) <> ") quest_raise_variant_error_at(" <> st
                            <> ");")
                        optionCaseTuple(p atom(p o.value) ts o.tag t 1 o.components
                            maybe.unwrapOr(o.ordinalIndex 0))
                end
            end
        end

    (* An atom (in its slot form) as an array element of shape elem holds it:
     * its QVal form *)
    let arrayElement(p: P a: Atom elem: Shape): String = types.shapeSlotToQval(atom(p a) elem)

    let arraySlot(p: P arr: String idx: String elem: Shape offset: maybe.T(Int)): String =
        begin
            emit(p "quest_check_array_bounds_at(" <> arr <> ", " <> idx <> ", " <> site(p offset) <> ");")
            let cElem = layout.shapeLocationRepresentation(elem)
            if eq(cElem "QVal") then "(&(" <> arr <> "->data[" <> idx <> "]))"
            elsif shapes.kindIs(elem shapes.shapeInt) then "(&(" <> arr <> "->data[" <> idx <> "].i))"
            elsif shapes.kindIs(elem shapes.shapeReal) then "(&(" <> arr <> "->data[" <> idx <> "].r))"
            (* A Bool or Char in its word's low byte, a pointer in its word *)
            else "((" <> cElem <> " *)(&(" <> arr <> "->data[" <> idx <> "])))"
            end
        end

    let makeArray(p: P elements: vector.T(String) t: Type): String =
        begin
            let n = vector.length(elements)
            let arr = temp(p cType(t))
            emit(p arr <> " = (QArray *)quest_alloc(sizeof(QArray) + (size_t)(" <> lit(n) <> ") * sizeof(QVal), &"
                <> objectLayout.arraySymbol(objectLayout.slotKind(shapes.element(shapeOf(t)))) <> ");")
            let mark = beginInit(p arr)
            emit(p arr <> "->length = " <> lit(n) <> ";")
            for i = 0 upto {n - 1} do emit(p arr <> "->data[" <> lit(i) <> "] = " <> vector.get(elements i)
                <> ";") end
            initBarrier(p mark arr)
            arr
        end

    (* =========================================================================
     * Primitives and calls
     * ====================================================================== *)

    let prim(p: P o: nodes.OpPrim): String =
        begin
            let cs = atoms(p o.args)
            let left = vector.get(cs 0)
            let right(): String = vector.get(cs 1)
            let infix(c: String): String = "((" <> left <> ") " <> c <> " (" <> right() <> "))"
            let checked(helper: String): String =
                helper <> "(" <> left <> ", " <> right() <> ", " <> site(p o.offset) <> ")"
            (* is, or with isIs false, isnot *)
            let identity(isIs: Bool): String =
                begin
                    let first = o.args[0]
                    let var t = maybe.some(atomType(first))
                    case first
                        when atomVar with x then
                            if hashMap.contains(p.handlerVars x.v.id) then t := maybe.none() end
                        else ok
                    end
                    if maybe.isSome(t) andif eq(cType(maybe.unwrap(t)) "QVal") then
                        let negate = if isIs then "" else "!" end
                        "(" <> negate <> "quest_val_is(" <> maybeDescriptor(p o.descriptor) <> ", " <> left <> ", "
                            <> right() <> "))"
                    elsif maybe.isSome(t) andif maybe.isSome(o.descriptor)
                        andif eq(cType(maybe.unwrap(t)) "QVariantVal") then
                        (* By case and value (docs/extensions.md, Variants as
                         * Values) *)
                        let negate = if isIs then "" else "!" end
                        "(" <> negate <> "quest_variant_is(" <> maybeDescriptor(p o.descriptor) <> ", " <> left <> ", "
                            <> right() <> "))"
                    elsif maybe.isSome(t) andif maybe.isSome(o.descriptor) then
                        (* An option type whose options is compares by case or
                         * component (docs/extensions.md, Options as Values) *)
                        let negate = if isIs then "" else "!" end
                        "(" <> negate <> "quest_option_is(" <> maybeDescriptor(p o.descriptor) <> ", (const void *)("
                            <> left <> "), (const void *)(" <> right() <> ")))"
                    else
                        let var l = left
                        let var r = right()
                        let t2 = if maybe.isSome(t) then
                            maybe.some(atomType(o.args[1])) else maybe.none(:Type) end
                        let viaOriginal = case o.access when original then true when direct, proxy then false end
                        if maybe.isSome(t) andif eq(cType(maybe.unwrap(t)) "QRecordVal") then
                            (* A record is its payload: a view changes only its
                             * offset table (quest_record_view) *)
                            l := "(" <> l <> ").val"
                            r := "(" <> r <> ").val"
                        elsif viaOriginal then
                            (* A proxy is the object it views *)
                            l := "quest_unproxy(" <> l <> ")"
                            r := "quest_unproxy(" <> r <> ")"
                        elsif maybe.isSome(t2)
                            andif not(eq(cType(maybe.unwrap(t)) cType(maybe.unwrap(t2))))
                            andif strutil.endsWith(cType(maybe.unwrap(t)) "*") then
                            (* Pointers to aggregates of different (subtype-
                             * related) types: compared as addresses *)
                            l := "(const void *)(" <> l <> ")"
                            r := "(const void *)(" <> r <> ")"
                        end
                        "((" <> l <> ") " <> if isIs then "==" else "!=" end <> " (" <> r <> "))"
                    end
                end
            case o.op
                when primNot then "(!(" <> left <> "))"
                when primExtent then "((" <> left <> ")->length)"
                when primDiv then checked("quest_int_div_at")
                when primRem, primMod then checked("quest_int_mod_at")
                when primRealAdd then checked("quest_real_add_at")
                when primRealSub then checked("quest_real_sub_at")
                when primRealMul then checked("quest_real_mul_at")
                when primRealDiv then checked("quest_real_divide_at")
                when primRealPow then checked("quest_real_pow_at")
                when primConcat then "quest_string_concat(" <> left <> ", " <> right() <> ")"
                when primIs then identity(true)
                when primIsnot then identity(false)
                when primAdd, primSub, primMul, primLt, primLe, primGt, primGe then infix(nodes.primName(o.op))
                when primRealLt then infix("<")
                when primRealLe then infix("<=")
                when primRealGt then infix(">")
                when primRealGe then infix(">=")
                when primAnd then infix("&&")
                when primOr then infix("||")
            end
        end

    let descriptors(p: P ds: Array(nodes.Descriptor)): vector.T(String) =
        begin
            let res = vector.new(:String)
            for i = 0 upto {extent ds - 1} do add(res descriptor(p ds[i])) end
            res
        end

    let moduleOf(r: nodes.ModuleRef): maybe.T(nodes.Module) =
        case r when refModule with x then maybe.some(x.m) else maybe.none() end
    let importOf(r: nodes.ModuleRef): maybe.T(nodes.Import) =
        case r when refImport with x then maybe.some(x.i) else maybe.none() end
    let memberOf(m: nodes.Module member: String): Variable = maybe.unwrap(nodes.member(m.members member))

    (* A call of the closure callee holds, of descriptors descs and then
     * args: of its code directly when callee is known to hold a closure
     * without type arguments (p.closures), its environment NULL if it
     * captures nothing; else through the closure's function pointer, cast to
     * the C signature of callee's type, its environment first *)
    let callClosure(p: P callee: Variable descs: vector.T(String) args: Array(Atom)): String =
        begin
            let cArgs = joinedWith(descs atoms(p args))
            let known = hashMap.get(p.closures callee.id)
            if maybe.isSome(known)
                andif {extent maybe.unwrap(:nodes.OpMakeClosure known).typeArgs is 0} then
                let k = maybe.unwrap(known)
                let env = if extent k.captures is 0 then "NULL" else name(p callee) <> "->env" end
                syntax.call(codeName(p k.code) joinedWith(one(env) cArgs))
            else
                let fnPtr = types.closureFnPtrType(callee.type)
                let clos = varAtom(p callee)
                syntax.call("((" <> fnPtr <> ")(" <> clos <> "->fn))" joinedWith(one(clos <> "->env") cArgs))
            end
        end

    (* The C function a call of an imported member is, if the member is one of
     * the standard library's external functions built into the compiler
     * (questlang/repr/externals), the import resolves to lib/, and the
     * member's wrapper has the C function's signature: no parameter or result
     * held as a QVal, as the importer holds an external type it sees only as
     * abstract (os/process's process.T) *)
    let libraryExternal(imp: nodes.Import member: String calleeType: maybe.T(Type)): maybe.T(String) =
        begin
            let var symbol = maybe.none(:String)
            let concrete = if maybe.isSome(calleeType) then
                case maybe.unwrap(calleeType).form
                    when typeFun with f then
                        let var all = not(eq(types.qtypeToCType(f.result) "QVal"))
                        for i = 0 upto {extent f.params - 1} do
                            if eq(types.qtypeToCType(f.params[i].type) "QVal") then all := false end
                        end
                        all
                    else false
                end
            else
                false
            end
            if concrete andif maybe.isSome(imp.libPath) then
                for i = 0 upto {extent externals.functions - 1} do
                    let entry = externals.functions[i]
                    if eq(entry[0] maybe.unwrap(imp.libPath)) andif eq(entry[1] member) then
                        symbol := maybe.some(entry[2])
                    end
                end
            end
            symbol
        end

    let callOp(p: P o: nodes.OpCall): String =
        begin
            let descs = descriptors(p o.descriptors)
            if maybe.isNone(o.callee) then
                let r = maybe.unwrap(o.moduleRef)
                let member = maybe.unwrap(o.member)
                if maybe.isSome(moduleOf(r)) then
                    callClosure(p memberOf(maybe.unwrap(moduleOf(r)) member) descs o.args)
                else
                    let imp = maybe.unwrap(importOf(r))
                    let direct = libraryExternal(imp member o.calleeType)
                    if maybe.isSome(direct) then
                        (* The C function itself, which the C compiler may
                         * inline, rather than the module's wrapper, whose
                         * signature it has *)
                        syntax.call(maybe.unwrap(direct) atoms(p o.args))
                    else
                        let clean = symbols.mangleModuleName(imp.canonicalPath)
                        syntax.call(symbols.mangleModuleIdent(clean member) joinedWith(descs atoms(p o.args)))
                    end
                end
            else
                callClosure(p maybe.unwrap(o.callee) descs o.args)
            end
        end

    (* The C for a module, its record, or with member, the member's value.
     * A module of this unit names its record's global and its members'
     * variables directly. An imported module's record is the extern global
     * qm_<module> its own unit defines (importDeclarations); its members are
     * fields of that record, read through the record's offset table
     * (recordSlot), since this unit knows only the record's type, the
     * module's interface, and not how the module's unit lays the record out.
     * (A call of an imported module's function does not come here: callOp
     * calls the C function the module exports.) Raises unsupported for a
     * member of an import whose interface is unknown or lacks it *)
    let moduleMember(p: P r: nodes.ModuleRef member: maybe.T(String)): String =
        case r
            when refModule with x then
                if maybe.isNone(member) then symbols.moduleRecordIdent(symbols.mangleModuleName(x.m.name))
                else varAtom(p memberOf(x.m maybe.unwrap(member)))
                end
            when refImport with x then
                let clean = symbols.mangleModuleName(x.i.canonicalPath)
                let recordIdent = symbols.moduleRecordIdent(clean)
                if maybe.isNone(member) then
                    recordIdent
                else
                    if maybe.isNone(x.i.recordType) then
                        raise unsupported with "module " <> x.i.name <> ": its interface is unknown" end
                    end
                    let recType = maybe.unwrap(x.i.recordType)
                    let fieldName = maybe.unwrap(member)
                    let fields = case recType.form
                        when typeRecord with rt then rt.fields
                        else vector.toArray(vector.new(:model.RecordField))
                    end
                    let var fieldType = maybe.none(:Type)
                    for i = 0 upto {extent fields - 1} do
                        if maybe.isNone(fieldType) andif eq(fields[i].name fieldName) then
                            fieldType := maybe.some(fields[i].type)
                        end
                    end
                    if maybe.isNone(fieldType) then
                        raise unsupported with "module " <> x.i.name <> ": its interface has no member " <> fieldName end
                    end
                    let cField = slotCType(shapeOf(maybe.unwrap(fieldType)))
                    let dictType = staticdata.offsetDictStructName(p.ctx recType)
                    (* In its slot form (a record or variant, for a boxed
                     * variable) *)
                    "(*((" <> cField <> " *)((char *)" <> recordIdent <> ".val + ((const " <> dictType <> " *)"
                        <> recordIdent
                        <> ".dict)->offset_" <> fieldName <> ")))"
                end
        end

    (* A closure of o.code: the static <code>_closure when it captures
     * nothing and takes no type arguments; else a new QClosure of the code
     * and a new environment, struct QEnv_<code> (envStruct), of o's
     * descriptors (d0, d1, ...) and captures (c0, c1, ...). A capture of a
     * variable of the let rec being printed is stored after the let rec's
     * body instead (Deferred). *)
    let makeClosure(p: P o: nodes.OpMakeClosure): String =
        begin
            let code = codeName(p o.code)
            if {extent o.captures is 0} andif {extent o.typeArgs is 0} then
                "(&" <> code <> "_closure)"
            else
                let env = temp(p "struct QEnv_" <> code <> " *")
                emit(p env <> " = (struct QEnv_" <> code <> " *)quest_alloc(sizeof(struct QEnv_" <> code <> "), "
                    <> layoutRef(p envLayoutOf(code o)) <> ");")
                let mark = beginInit(p env)
                for i = 0 upto {extent o.descriptors - 1} do
                    emit(p env <> "->d" <> cInt(i) <> " = " <> descriptor(p o.descriptors[i]) <> ";")
                end
                for i = 0 upto {extent o.captures - 1} do
                    let a = o.captures[i]
                    let v = atomVar(a)
                    let var isDeferred = false
                    if maybe.isSome(p.deferred) andif maybe.isSome(v) then
                        let d = maybe.unwrap(p.deferred)
                        if hashMap.contains(d.vars maybe.unwrap(v).id) then
                            (* A variable of the let rec being made, which holds
                             * its value once the let rec's body has run *)
                            vector.append(d.captures tuple let env = env let index = i let a = a end)
                            isDeferred := true
                        end
                    end
                    if not(isDeferred) then emit(p env <> "->c" <> cInt(i) <> " = " <> atom(p a) <> ";") end
                end
                initBarrier(p mark env)
                let clos = temp(p "QClosure *")
                emit(p clos <> " = (QClosure *)quest_alloc(sizeof(QClosure), &quest_layout_closure);")
                emit(p clos <> "->fn = (void *)" <> code <> ";")
                emit(p clos <> "->env = (void *)" <> env <> ";")
                clos
            end
        end

    (* A polymorphic value of no parameters applied to types: its value at the
     * type arguments (a function applied to types is its thunk's closure,
     * made by ir/thunks) *)
    let typeApp(p: P o: nodes.OpTypeApp result: Variable): String =
        begin
            (* The polymorphic value: a variable, a member of a module of this
             * unit, or an imported module's member *)
            let var origType = model.okType
            let var clos = ""
            if maybe.isSome(o.callee) then
                origType := maybe.unwrap(o.callee).type
                clos := varAtom(p maybe.unwrap(o.callee))
            else
                let r = maybe.unwrap(o.moduleRef)
                if maybe.isSome(moduleOf(r)) then
                    let member = memberOf(maybe.unwrap(moduleOf(r)) maybe.unwrap(o.member))
                    origType := member.type
                    clos := varAtom(p member)
                else
                    origType := maybe.unwrap(o.calleeType)
                    clos := moduleMember(p r o.member)
                end
            end
            (* Called with the type arguments' descriptors: an imported member
             * directly by its symbol, any other through its closure, its
             * environment first *)
            let descs = descriptors(p o.descriptors)
            if maybe.isNone(o.thunkParams) then
                let isImport = maybe.isNone(o.callee)
                    andif maybe.isSome(importOf(maybe.unwrap(o.moduleRef)))
                let called = if isImport then
                    let imp = maybe.unwrap(importOf(maybe.unwrap(o.moduleRef)))
                    syntax.call(symbols.mangleModuleIdent(symbols.mangleModuleName(imp.canonicalPath)
                        maybe.unwrap(o.member))
                        descs)
                else
                    let fnPtr = types.closureFnPtrType(origType)
                    syntax.call("((" <> fnPtr <> ")(" <> clos <> "->fn))" joinedWith(one(clos <> "->env") descs))
                end
                let pl = o.plans[0]
                if maybe.isNone(pl) then called else convert(p called maybe.unwrap(pl)) end
            else
                raise unsupported with "C printing of a type application whose instance is a function, not its thunk's closure" end
            end
        end

    (* =========================================================================
     * Operations
     * ====================================================================== *)

    let makeAuto(p: P witness: maybe.T(nodes.Descriptor) autoType: Type payloadAtom: Atom): String =
        begin
            let storedType = model.autoPayloadType(autoType maybe.none())
            "quest_auto_new(" <> maybeDescriptor(p witness) <> ", "
                <> types.shapeSlotToQval(atom(p payloadAtom) shapeOf(storedType))
                <> ")"
        end

    let operation(p: P o: nodes.Op result: maybe.T(Variable)): String =
        case o
            when opAtom with x then atom(p x.atom)
            when opPrim with x then prim(p x)
            when opOrdinal with x then
                (* The tag numbers the shape's cases, ordered by name; the
                 * ordinal counts in the static type's order *)
                let ts = tagShape(atomType(x.value))
                let tag = tagOf(p atom(p x.value) ts x.access x.viewMap)
                let var same = extent ts.cases is extent x.cases
                let indices = array of(extent ts.cases 0)
                for i = 0 upto {extent ts.cases - 1} do
                    let caseName = maybe.unwrap(ts.cases[i].name)
                    let var index = ~1
                    for j = 0 upto {extent x.cases - 1} do if {index < 0}
                        andif eq(x.cases[j] caseName) then index := j end end
                    indices[i] := index
                    if not(index is i) then same := false end
                end
                if same then tag else syntax.indexTable(indices) <> "[" <> tag <> "]" end
            when opCall with x then callOp(p x)
            when opModuleMember with x then moduleMember(p x.moduleRef x.member)
            when opBuiltin with x then "(&" <> symbols.mangleIdent(x.name) <> "_closure)"
            when opExternal with x then
                if maybe.isSome(result) andif isFunction(maybe.unwrap(result).type) then
                    raise unsupported with "C printing of an external C function used as a value, not its thunk's closure" end
                end
                x.symbol
            when opCallExternal with x then
                syntax.call(x.symbol joinedWith(descriptors(p x.descriptors) atoms(p x.args)))
            when opMakeClosure with x then makeClosure(p x)
            when opEnvField with x then atomName(p x.env) <> "->c" <> cInt(x.index)
            when opConvert with x then
                let v = atomVar(x.value)
                if nodes.planIs(x.plan nodes.planUnbox) andif maybe.isSome(result)
                    andif maybe.unwrap(result).boxed then
                    (* A QVal word holds a record or variant as its box *)
                    types.shapeQvalToSlot(atom(p x.value) shapeOf(x.plan.target))
                elsif nodes.planIs(x.plan nodes.planBox) andif maybe.isSome(v)
                    andif maybe.unwrap(v).boxed andif not(maybe.unwrap(v).isMutable) then
                    (* A box is a record's or variant's QVal word *)
                    types.shapeSlotToQval(atom(p x.value) shapeOf(x.plan.source))
                else
                    convert(p atom(p x.value) x.plan)
                end
            when opMakeException with x then syntax.call("quest_alloc_exception" one(syntax.cString(x.name)))
            when opExceptionPayload with x then
                (* In its slot form (a record or variant, for a boxed
                 * variable) *)
                types.shapeQvalToSlot(atomName(p x.exc) <> ".payload" shapeOf(maybe.unwrap(result).type))
            when opCaughtException with x then syntax.call("quest_raised_capture" one("&" <> atomName(p x.exc)))
            when opAddrVar with x then
                if isPointerParam(p x.v) then name(p x.v)
                elsif hashMap.contains(p.fs.volatile x.v.id) then
                    "((" <> locationCType(x.v.type) <> " *)&" <> name(p x.v) <> ")"
                else "(&" <> name(p x.v) <> ")"
                end
            when opAddrCell with x then
                let cell = temp(p locationCType(atomType(x.init)))
                emit(p cell <> " = " <> atom(p x.init) <> ";")
                "(&" <> cell <> ")"
            when opLoad with x then "(*" <> atom(p x.address) <> ")"
            when opAddrField with x then
                let slot = recordSlot(p atom(p x.base) held(atomType(x.base) shapes.shapeRecord) x.name x.viewMap)
                slotAddress(slot.ptr slot.shape)
            when opAddrComponent with x then
                if maybe.isSome(x.viewMap) then
                    let component = componentShape(layout.resolvedShape(shapeOf(atomType(x.base))) x.index)
                    let slot = "quest_view_tuple_slot(" <> atom(p x.base) <> ", "
                        <> name(p maybe.unwrap(x.viewMap)) <> ", "
                        <> cInt(x.index) <> ")"
                    slotAddress("((" <> slotCType(component) <> " *)" <> slot <> ")" component)
                else
                    let ts = layout.resolvedShape(shapeOf(atomType(x.base)))
                    let component = componentShape(ts x.index)
                    let b = atom(p x.base)
                    let address = slotAddress("(&(" <> b <> "->_" <> cInt(x.index) <> "))" component)
                    case x.access
                        when direct then address
                        when original then
                            let unproxied = "((" <> cType(ts.type) <> ")quest_unproxy(" <> b <> "))"
                            slotAddress("(&(" <> unproxied <> "->_" <> cInt(x.index) <> "))" component)
                        when proxy then
                            let through = "((" <> layout.shapeLocationRepresentation(component) <> " *)quest_proxy_slot("
                                <> b <> ", "
                                <> cInt(x.index) <> "))"
                            "(quest_is_proxy(" <> b <> ") ? " <> through <> " : " <> address <> ")"
                    end
                end
            when opAddrElement with x then arraySlot(p atom(p x.base) atom(p x.index) elementShape(x.base) x.offset)
            when opMakeTuple with x then
                let rs = shapeOf(maybe.unwrap(result).type)
                let shapesOf = array of(extent rs.components rs)
                for i = 0 upto {extent rs.components - 1} do shapesOf[i] := componentShape(rs i) end
                let fields = slotFields(p x.args shapesOf x.embedded)
                if maybe.unwrap(result).unboxed then
                    (* Its struct's value, of its components (none boxed) *)
                    let values = vector.new(:String)
                    for i = 0 upto {vector.length(fields) - 1} do
                        case vector.get(fields i)
                            when fieldText with f then add(values f.s)
                            when fieldFresh with f then add(values f.value)
                            when fieldBox with f then add(values f.box)
                        end
                    end
                    "((" <> unboxedCType(maybe.unwrap(result).type) <> "){ "
                        <> strutil.join(", " values) <> " })"
                else
                    makeTuple(p maybe.unwrap(result).type fields)
                end
            when opTupleField with x then
                let fusedPayload = case x.tup
                    when atomVar with v then hashMap.get(p.fs.fused v.v.id)
                    else maybe.none(:nodes.Stmt)
                end
                if maybe.isSome(fusedPayload) then
                    (* o!tag.field: the option's component, read in place,
                     * the tuple of its ordinal and components never made *)
                    payloadComponent(p maybe.unwrap(fusedPayload) x.index)
                elsif maybe.isSome(x.viewMap) then
                    (* A tuple-bounded type parameter's value: through the view
                     * map, converted to the bound's type *)
                    let comp = componentShape(layout.resolvedShape(shapeOf(atomType(x.tup))) x.index)
                    let element = syntax.call("quest_view_tuple_element"
                        strings(array of atom(p x.tup) name(p maybe.unwrap(x.viewMap)) cInt(x.index) end))
                    types.shapeQvalUnwrap(element comp)
                elsif maybe.isSome(nodes.atomVarOf(x.tup)) andif maybe.unwrap(nodes.atomVarOf(x.tup)).unboxed then
                    atom(p x.tup) <> "._" <> cInt(x.index)
                else
                    tupleComponent(p atom(p x.tup) layout.resolvedShape(shapeOf(atomType(x.tup))) x.index x.access)
                end
            when opMakeRecord with x then makeRecord(p x maybe.unwrap(result))
            when opRecordField with x then
                recordField(p atom(p x.recordAtom) held(atomType(x.recordAtom) shapes.shapeRecord) x.name x)
            when opMakeVariant with x then
                let vs = held(maybe.unwrap(result).type shapes.shapeVariant)
                let index = tagIndexOf(vs x.tag)
                if maybe.isNone(x.payload) then
                    "((QVariantVal){ .tag = " <> lit(index) <> ", .payload = Q_OK_VAL })"
                else
                    let pa = maybe.unwrap(x.payload)
                    let cs = caseShape(vs x.tag)
                    let caseS = if maybe.isSome(cs) then maybe.unwrap(cs) else shapeOf(atomType(pa)) end
                    let word = types.shapeSlotToQval(atom(p pa) caseS)
                    "((QVariantVal){ .tag = " <> lit(index) <> ", .payload = " <> word <> " })"
                end
            when opMakeOption with x then makeOption(p x maybe.unwrap(result).type)
            when opIsTag with x then
                let ts = tagShape(atomType(x.value))
                let tagC = tagOf(p atom(p x.value) ts x.access x.viewMap)
                "(" <> tagC <> " == " <> lit(tagIndexOf(ts x.tag)) <> ")"
            when opPayload with x then payload(p x maybe.unwrap(result).type)
            when opMakeArray with x then
                let elem = shapes.element(shapeOf(maybe.unwrap(result).type))
                let elements = vector.new(:String)
                for i = 0 upto {extent x.args - 1} do add(elements arrayElement(p x.args[i] elem)) end
                makeArray(p elements maybe.unwrap(result).type)
            when opArrayRep with x then
                let n = "quest_check_array_count_at(" <> atom(p x.count) <> ", " <> site(p x.offset) <> ")"
                let elem = shapes.element(shapeOf(maybe.unwrap(result).type))
                "quest_array_new(" <> n <> ", " <> arrayElement(p x.init elem) <> ", &"
                    <> objectLayout.arraySymbol(objectLayout.slotKind(elem)) <> ")"
            when opTypeApp with x then typeApp(p x maybe.unwrap(result))
            when opMakeAuto with x then makeAuto(p x.descriptor x.autoType x.payload)
            when opIndex with x then
                let arr = atom(p x.arr)
                let idx = atom(p x.index)
                emit(p "quest_check_array_bounds_at(" <> arr <> ", " <> idx <> ", " <> site(p x.offset) <> ");")
                (* In its slot form (a record or variant, for a boxed
                 * variable) *)
                types.shapeQvalToSlot("(" <> arr <> "->data[" <> idx <> "])" elementShape(x.arr))
        end

    (* =========================================================================
     * Statements
     * ====================================================================== *)

    (* Assigns a variable (a boxed one, its box: a var or out parameter's
     * location, or a boxed mutable variable's own) *)
    let assign(p: P v: Variable value: String): Ok =
        if isOk(v.type) then
            if not(eq(value "Q_OK_VAL")) then emit(p "(void)(" <> value <> ");") end
        else
            let pointer = v.isMutable andif isPointerParam(p v)
            let target = if pointer then "(*" <> name(p v) <> ")" else name(p v) end
            (* A store's barrier follows it, here and in statement: the value
             * stored may be a call (an allocation, a string literal's among
             * them) that collects, after which a barrier before it has been
             * forgotten *)
            emit(p target <> " = " <> value <> ";")
            if pointer andif holdsPointer(v.type) then emit(p "quest_barrier_slot(" <> name(p v) <> ");") end
        end

    (* Pops the try handlers entered since depth, for a jump out of them *)
    let leaveTo(p: P depth: Int): Ok =
        if vector.length(p.fs.handlers) > depth then
            emit(p "quest_current_exception_handler = " <> vector.get(p.fs.handlers depth) <> ".prev;")
        end

    (* Records in a try's handler what it catches (docs/exceptions.md section
     * 5.1) *)
    let emitCatches(p: P handler: String catching: nodes.Catching catches: Array(Atom)): Ok =
        case catching
            when catchAll then
                emit(p handler <> ".catches = NULL;")
                emit(p handler <> ".n_catches = Q_CATCH_ALL;")
            when catchAllTraced then
                emit(p handler <> ".catches = NULL;")
                emit(p handler <> ".n_catches = Q_CATCH_ALL_TRACED;")
            when catchUnknown then
                emit(p handler <> ".catches = NULL;")
                emit(p handler <> ".n_catches = Q_CATCH_UNKNOWN;")
            when catchListed then
                let catchArray = freshName(p "_qc")
                emit(p "const QException *" <> catchArray <> "[] = { " <> syntax.comma(atoms(p catches)) <> " };")
                emit(p handler <> ".catches = " <> catchArray <> ";")
                emit(p handler <> ".n_catches = " <> cInt(extent catches) <> ";")
        end

    (* Prints a top-level phrase's value as the interpreter does: by its type's
     * kind, or by the descriptor the describe pass gave it. The value is in
     * its slot form, its QVal word. *)
    let echo(p: P prefix: String value: String t: Type d: maybe.T(nodes.Descriptor) suffix: String): Ok =
        begin
            let wrapped = types.shapeSlotToQval(value shapeOf(t))
            let kind = describe.echoValueKind(t)
            if stringOp.length(kind) > 0 then
                emit(p syntax.call("quest_print_value"
                    strings(array of syntax.cString(prefix) wrapped syntax.cString(kind) syntax.cString(suffix) end))
                        <> ";")
            else
                emit(p syntax.call("quest_print_typed"
                    strings(array of syntax.cString(prefix) wrapped maybeDescriptor(p d) syntax.cString(suffix) end))
                        <> ";")
            end
        end

    (* The components S[T] of an auto value, converted by descriptor from the
     * stored ones as the case's arm says, by the descriptors the describe pass
     * gave the arm *)
    let autoArmConverted(p: P arm: nodes.InspectArm stored: String storedType: Type armType: Type): String =
        begin
            let armStruct = layout.tupleStructName(armType)
            let a = temp(p armStruct <> " *")
            emit(p a <> " = (" <> armStruct <> " *)quest_alloc(sizeof(" <> armStruct <> "), "
                <> layoutRef(p objectLayout.tupleLayout(shapeOf(armType) armStruct noBoxes)) <> ");")
            let mark = beginInit(p a)
            let storedFields = case storedType.form
                when typeTuple with x then model.tupleValueFields(x.fields)
                else vector.toArray(vector.new(:model.ValueField))
            end
            let armFields = case armType.form
                when typeTuple with x then model.tupleValueFields(x.fields)
                else vector.toArray(vector.new(:model.ValueField))
            end
            let var n = extent arm.descriptors
            if extent storedFields < n then n := extent storedFields end
            if extent armFields < n then n := extent armFields end
            (* A component the arm has no descriptor pair for is laid out alike
             * in both, and copied; any other converted through a QVal word *)
            for i = 0 upto {n - 1} do
                let src = stored <> "->_" <> cInt(i)
                let pair = arm.descriptors[i]
                if maybe.isNone(pair) then
                    emit(p a <> "->_" <> cInt(i) <> " = " <> src <> ";")
                else
                    let pr = maybe.unwrap(pair)
                    let fromDesc = descriptor(p pr.source)
                    let toDesc = descriptor(p pr.target)
                    let viewed = "quest_convert(" <> types.shapeSlotToQval(src shapeOf(storedFields[i].type)) <> ", "
                        <> fromDesc
                        <> ", " <> toDesc <> ")"
                    emit(p a <> "->_" <> cInt(i) <> " = " <> types.shapeQvalToSlot(viewed shapeOf(armFields[i].type))
                        <> ";")
                end
            end
            initBarrier(p mark a)
            a
        end

    (* Prints the IR statement s as C statements (docs/codegen-c.md section
     * 4). The IR's control is structured, so each statement maps to C
     * directly: an if to if, a loop to for (;;) with labels for its breaks
     * and continues, a join point to a block, its label, and its continuation,
     * which a jump reaches by assigning the join point's parameters and a
     * goto. A try is a QExceptionHandler pushed onto
     * quest_current_exception_handler and entered with setjmp; any jump out
     * of tries (a break, continue, jump, or return) first pops the handlers
     * it leaves (leaveTo). A store that may write a pointer into an existing
     * object is followed by a write barrier, quest_barrier or
     * quest_barrier_slot, which tells the collector that an older object may
     * now point at a younger one (docs/collector.md section 3.5). A let of a
     * closure is remembered, so that calls of the variable call its function
     * directly; a let rec's captures of its own variables are stored after its
     * body (Deferred). The Funs of the SSA backends are not C's: they raise
     * unsupported *)
    let rec statement(p: P s: nodes.Stmt): Ok =
        case s
            when sLet with x then
                case x.value when opMakeClosure with c then
                    put(p.closures x.v.id c) else ok end
                assign(p x.v operation(p x.value maybe.some(x.v)))
            when sDo with x then
                let c = operation(p x.value maybe.none())
                emit(p c <> ";")
            when sVarDecl with x then
                if maybe.isSome(x.init) then assign(p x.v atom(p maybe.unwrap(x.init))) end
            when sAssign with x then assign(p x.v atom(p x.value))
            when sStoreAt with x then
                emit(p "*" <> atom(p x.address) <> " = " <> atom(p x.value) <> ";")
                if holdsPointer(atomType(x.value)) then emit(p "quest_barrier_slot(" <> atom(p x.address) <> ");") end
            when sStoreField with x then
                let slot = recordSlot(p atom(p x.base) held(atomType(x.base) shapes.shapeRecord) x.name x.viewMap)
                emit(p "*" <> slot.ptr <> " = " <> atom(p x.value) <> ";")
                if holdsPointer(atomType(x.value)) then emit(p "quest_barrier_slot(" <> slot.ptr <> ");") end
            when sStoreComponent with x then
                if maybe.isSome(x.viewMap) then
                    let component = componentShape(layout.resolvedShape(shapeOf(atomType(x.base))) x.index)
                    let slot = "quest_view_tuple_slot(" <> atom(p x.base) <> ", "
                        <> name(p maybe.unwrap(x.viewMap)) <> ", "
                        <> cInt(x.index) <> ")"
                    emit(p "*((" <> slotCType(component) <> " *)" <> slot <> ") = " <> atom(p x.value) <> ";")
                    if holdsPointer(atomType(x.value)) then emit(p "quest_barrier_slot(" <> slot <> ");") end
                else
                    let ts = layout.resolvedShape(shapeOf(atomType(x.base)))
                    let component = componentShape(ts x.index)
                    let b = atom(p x.base)
                    let v = atom(p x.value)
                    let barrier = holdsPointer(atomType(x.value))
                    case x.access
                        (* Stored into the original as it is *)
                        when original then
                            emit(p "((" <> cType(ts.type) <> ")quest_unproxy(" <> b <> "))->_" <> cInt(x.index) <> " = "
                                <> v <> ";")
                            if barrier then emit(p "quest_barrier(quest_unproxy(" <> b <> "));") end
                        (* A var component of a proxy is the original's, which
                         * quest_proxy_store barriers itself *)
                        when proxy then
                            emit(p "if (quest_is_proxy(" <> b <> ")) quest_proxy_store(" <> b <> ", " <> cInt(x.index)
                                <> ", "
                                <> types.shapeSlotToQval(v component) <> ");")
                            if barrier then
                                emit(p "else { " <> b <> "->_" <> cInt(x.index) <> " = " <> v <> "; quest_barrier(" <> b
                                    <> "); }")
                            else
                                emit(p "else " <> b <> "->_" <> cInt(x.index) <> " = " <> v <> ";")
                            end
                        when direct then
                            emit(p b <> "->_" <> cInt(x.index) <> " = " <> v <> ";")
                            if barrier then emit(p "quest_barrier(" <> b <> ");") end
                    end
                end
            when sStoreElement with x then
                let arr = atom(p x.base)
                let idx = atom(p x.index)
                let elem = elementShape(x.base)
                emit(p "quest_check_array_bounds_at(" <> arr <> ", " <> idx <> ", " <> site(p x.offset) <> ");")
                emit(p arr <> "->data[" <> idx <> "] = " <> arrayElement(p x.value elem) <> ";")
                if holdsPointer(elem.type) then emit(p "quest_barrier_slot(&" <> arr <> "->data[" <> idx <> "]);") end
            when sSwitch with x then switch(p x)
            when sInspect with x then inspectAuto(p x)
            when sLetRec with x then
                let saved = p.deferred
                let vars = hashMap.new(:Int :Bool intEqual hash.int)
                for i = 0 upto {extent x.vars - 1} do put(vars x.vars[i].id true) end
                let d = tuple let vars = vars let captures = vector.new(:DeferredCapture) end
                p.deferred := maybe.some(d)
                body(p x.body)
                for i = 0 upto {vector.length(d.captures) - 1} do
                    let c = vector.get(d.captures i)
                    (* The environment was made before the body ran *)
                    emit(p c.env <> "->c" <> cInt(c.index) <> " = " <> atom(p c.a) <> ";")
                    if holdsPointer(atomType(c.a)) then emit(p "quest_barrier(" <> c.env <> ");") end
                end
                p.deferred := saved
            when sIf with x then
                emit(p "if (" <> atom(p x.cond) <> ") {")
                block(p x.thenBody)
                if not(vector.empty(x.elseBody.statements)) then
                    emit(p "} else {")
                    block(p x.elseBody)
                end
                emit(p "}")
            when sLoop with x then
                put(p.fs.labelDepth x.label vector.length(p.fs.handlers))
                emit(p "for (;;) {")
                block(p x.body)
                if hashMap.contains(p.fs.usedLabels x.label <> "_continue") then
                    emit(p "    " <> x.label <> "_continue:;")
                end
                emit(p "}")
                if hashMap.contains(p.fs.usedLabels x.label <> "_break") then emit(p x.label
                    <> "_break:;") end
            when sBreak with x then jumpOut(p x.label "break")
            when sContinue with x then jumpOut(p x.label "continue")
            when sJoin with x then
                (* Labels are unique within a function (a clone keeps its
                 * original's) *)
                put(p.fs.joinParams x.label x.params)
                put(p.fs.labelDepth x.label vector.length(p.fs.handlers))
                emit(p "{")
                block(p x.body)
                emit(p "}")
                let finish = x.label <> "_end"
                if not(nodes.terminated(x.body)) then
                    put(p.fs.usedLabels finish true)
                    emit(p "goto " <> finish <> ";")
                end
                emit(p x.label <> ":;")
                emit(p "{")
                block(p x.continuation)
                emit(p "}")
                if hashMap.contains(p.fs.usedLabels finish) then emit(p finish <> ":;") end
            when sJump with x then
                let params = hashMap.find(p.fs.joinParams x.label)
                let n = if extent params < extent x.args then extent params else extent x.args end
                for i = 0 upto {n - 1} do assign(p params[i] atom(p x.args[i])) end
                leaveTo(p hashMap.find(p.fs.labelDepth x.label))
                emit(p "goto " <> x.label <> ";")
            when sTry with x then
                let h = freshName(p "_qh")
                emit(p "{")
                p.indent := p.indent + 1
                emit(p "QExceptionHandler " <> h <> ";")
                emit(p h <> ".prev = quest_current_exception_handler;")
                emit(p h <> ".resume = NULL;")
                emitCatches(p h x.catching x.catches)
                emit(p "quest_current_exception_handler = &" <> h <> ";")
                emit(p "if (Q_SETJMP(" <> h <> ".env_jmp) == 0) {")
                add(p.fs.handlers h)
                block(p x.body)
                vector.pop(p.fs.handlers)
                if not(nodes.terminated(x.body)) then emit(p "    quest_current_exception_handler = " <> h
                    <> ".prev;") end
                emit(p "} else {")
                emit(p "    quest_current_exception_handler = " <> h <> ".prev;")
                emit(p "    " <> name(p x.exc) <> " = quest_current_exception;")
                block(p x.handler)
                emit(p "}")
                p.indent := p.indent - 1
                emit(p "}")
            when sReturn with x then
                leaveTo(p 0)
                if maybe.isSome(p.fs.function)
                    andif isOk(maybe.unwrap(p.fs.function).resultType) then
                    emit(p "return;")
                else
                    emit(p "return " <> atom(p x.value) <> ";")
                end
            when sRaise with x then
                let pl = if maybe.isNone(x.payload) then "Q_OK_VAL"
                    else types.shapeSlotToQval(atom(p maybe.unwrap(x.payload))
                        shapeOf(atomType(maybe.unwrap(x.payload))))
                end
                if maybe.isSome(x.descriptor) then
                    emit(p "quest_raise_typed_at(" <> atom(p x.exc) <> ", " <> pl <> ", " <> maybeDescriptor(p x.descriptor)
                        <> ", " <> syntax.cString(x.payloadText) <> ", " <> site(p x.offset) <> ");")
                else
                    emit(p "quest_raise_at(" <> atom(p x.exc) <> ", " <> pl <> ", " <> site(p x.offset) <> ");")
                end
            when sReraise with x then emit(p "quest_reraise(" <> name(p x.exc) <> ");")
            when sUnreachable then emit(p "abort();")
            when sEcho with x then
                let value = atom(p x.value)
                echo(p x.prefix value x.type x.descriptor
                    if stringOp.length(x.prefix) > 0 then "" else " : " <> genericLayout.qtypeToNameStr(x.type) end)
            when sEchoText with x then emit(p syntax.call("puts" one(syntax.cString(x.text))) <> ";")
            when sFuns then raise unsupported with "C printing of Funs" end
        end

    and jumpOut(p: P label: String which: String): Ok =
        begin
            leaveTo(p hashMap.find(p.fs.labelDepth label))
            put(p.fs.usedLabels label <> "_" <> which true)
            emit(p "goto " <> label <> "_" <> which <> ";")
        end

    and body(p: P b: nodes.Body): Ok =
        begin
            for i = 0 upto {vector.length(b.statements) - 1} do
                let st = vector.get(b.statements i)
                let skipped = case st
                    when sLet with x then hashMap.contains(p.fs.fused x.v.id)
                    else false
                end
                if not(skipped) then statement(p st) end
            end
            ok
        end

    and block(p: P b: nodes.Body): Ok =
        begin
            p.indent := p.indent + 1
            body(p b)
            p.indent := p.indent - 1
            ok
        end

    (* Prints a case on a variant or option as a C switch on its tag.
     *
     * Cases are numbered in the order of their names, so for
     *
     *     Let Shape = Option circle with r: Int end square with side: Int end
     *         point end
     *
     * circle is 0, point 1, and square 2, and a case with two branches and an
     * else prints as (a cast's star written apart from its parenthesis, since
     * together they would end this comment)
     *
     *     switch ((quest_is_proxy(l_s) ? quest_proxy_tag(l_s) : (l_s)->tag)) {
     *         case 0LL:
     *         {
     *             l_c = ((QTuple_Int * )((const char * )(quest_unproxy(l_s))
     *                                   + sizeof(int64_t)));
     *             ...
     *             break;
     *         }
     *         case 2LL: ...
     *         default: { l_r = 0LL; ... break; }
     *     }
     *
     * An option may be a proxy, so its tag is read as x.access says (here,
     * through the proxy if it is one). A branch naming several tags gets one
     * case label for each. Its binder is bound to the payload: a variant's is
     * read from the variant's payload word (l_v.payload.i, for an Int); an
     * option's is its case's components, a tuple, which the binder shares
     * with the option: the components follow the option's tag in memory, laid
     * out as that tuple's struct, so the binder points at them and sees any
     * update of a var component.
     *
     * A value of a type parameter bounded by the variant or option type
     * (A <: Shape) is held at its own type's view, which may number the cases
     * differently: its tag is translated, and its payload read, through the
     * type argument's view map (x.viewMap; quest_view_option_tag). Without an
     * else branch the cases cover every tag, as the type checker requires, and
     * the default case only raises a variant error
     * (quest_raise_variant_error), should the tag be none of them. *)
    and switch(p: P x: nodes.StmtSwitch): Ok =
        begin
            let v = atom(p x.value)
            let t = tagShape(atomType(x.value))
            let isVariant = shapes.kindIs(t shapes.shapeVariant)
            emit(p "switch (" <> tagOf(p v t x.access x.viewMap) <> ") {")
            p.indent := p.indent + 1
            for ci = 0 upto {extent x.cases - 1} do
                let c = x.cases[ci]
                for ti = 0 upto {extent c.tags - 1} do emit(p "case " <> lit(tagIndexOf(t c.tags[ti])) <> ":") end
                emit(p "{")
                p.indent := p.indent + 1
                if maybe.isSome(c.binder) andif not(isOk(maybe.unwrap(c.binder).type)) then
                    let binder = maybe.unwrap(c.binder)
                    let binderKind = shapeOf(binder.type).kind
                    if maybe.isSome(x.viewMap) andif not(isVariant)
                        andif shapes.sameKind(binderKind shapes.shapeTuple) then
                        (* A bounded type parameter's value: its payload, viewed
                         * at the bound's payload type *)
                        let struct = layout.shapeTag(shapeOf(binder.type))
                        assign(p binder "((" <> struct <> " *)quest_view_option_payload(" <> v <> ", "
                            <> name(p maybe.unwrap(x.viewMap)) <> "))")
                    elsif maybe.isSome(x.viewMap) then
                        (* A bounded type parameter's value: its payload read
                         * through the view map, converted *)
                        assign(p binder viewPayload(p v t c.tags[0] maybe.unwrap(x.viewMap) binder.type))
                    elsif isVariant then
                        (* In its slot form (a record or variant, for a boxed
                         * variable) *)
                        assign(p binder types.shapeQvalToSlot(v <> ".payload" shapeOf(binder.type)))
                    elsif shapes.sameKind(binderKind shapes.shapeTuple) then
                        assign(p binder optionCasePayload(v binder.type x.access c.components))
                    else
                        (* In its slot form (a record or variant, for a boxed
                         * variable) *)
                        assign(p binder optionComponent(p v t c.tags[0] maybe.none() c.components[0]))
                    end
                end
                body(p c.body)
                emit(p "break;")
                p.indent := p.indent - 1
                emit(p "}")
            end
            emit(p "default: {")
            if maybe.isSome(x.elseBody) then block(p maybe.unwrap(x.elseBody))
            else emit(p "    quest_raise_variant_error();")
            end
            emit(p "    break;")
            emit(p "}")
            p.indent := p.indent - 1
            emit(p "}")
        end

    (* Prints an inspect on an auto value as a chain of if statements, one per
     * case, testing the value's type at run time.
     *
     * An auto value (QAuto) holds its type component's descriptor, type_desc,
     * and its other components, stored in a layout that does not depend on
     * that type (docs/c-representation.md section 8.1): the layout of the
     * components with A an abstract type (model.autoPayloadType without a
     * witness), so that a component of type A is a QVal word when A is
     * unbounded. For Pack = Auto A::TYPE with a: A end,
     *
     *     inspect p when Int with x then x.a when String with y then 1
     *         else 0 end
     *
     * prints as (a cast's star written apart from its parenthesis, since
     * together they would end this comment)
     *
     *     _t1 = l_p;
     *     _t2 = (QTuple_QVal * )_t1->payload.p;
     *     if (quest_is_subtype(_t1->type_desc, &quest_type_Int)) {
     *         _t3 = (QTuple_Int * )quest_alloc(sizeof(QTuple_Int));
     *         _t3->_0 = (quest_convert(_t2->_0, _t1->type_desc,
     *                                  &quest_type_Int).i);
     *         l_x = _t3;
     *         ...
     *     } else if (quest_is_subtype(_t1->type_desc, &quest_type_String)) {
     *         ...
     *     } else {
     *         l_r = 0LL;
     *         ...
     *     }
     *
     * A case matches if the type component is a subtype of its type, or for
     * an exact case, equal to it (a subtype both ways; see nodes.InspectCase).
     * A case's binders get a new tuple of the components at the case's type,
     * each converted from its stored form as the represent pass decided
     * (the case's arm, autoArmConverted). An exact case first checks whether
     * the stored layout is already the case's (quest_layout_equivalent): if
     * so, the stored components serve, shared or converted by one plan, and
     * if not, they are converted one by one as for any case. Without an else
     * branch, a value no case matches raises a dynamic error.
     *
     * Inside the cases, the auto type's type parameter is the value's type
     * component: x.witness names the descriptor variable that stands for it,
     * which here is _t1->type_desc. *)
    and inspectAuto(p: P x: nodes.StmtInspect): Ok =
        begin
            let autoType = maybe.unwrap(x.autoType)
            let storedType = model.autoPayloadType(autoType maybe.none())
            let storedStruct = layout.tupleStructName(storedType)
            let tgt = temp(p "const QAuto *")
            emit(p tgt <> " = " <> atom(p x.value) <> ";")
            if maybe.isSome(x.witness) then
                (* The value's type component, the descriptor variable the arms'
                 * descriptors use *)
                put(p.names maybe.unwrap(x.witness).v.id tgt <> "->type_desc")
            end
            let stored = temp(p storedStruct <> " *")
            emit(p stored <> " = (" <> storedStruct <> " *)" <> tgt <> "->payload.p;")
            for i = 0 upto {extent x.cases - 1} do
                let c = x.cases[i]
                let matchDesc = maybeDescriptor(p c.descriptor)
                let var cond = "quest_is_subtype(" <> tgt <> "->type_desc, " <> matchDesc <> ")"
                if c.exact then cond := cond <> " && quest_is_subtype(" <> matchDesc <> ", " <> tgt
                    <> "->type_desc)" end
                emit(p if i is 0 then "if" else "} else if" end <> " (" <> cond <> ") {")
                p.indent := p.indent + 1
                if extent c.binders > 0 then
                    let arm = maybe.unwrap(c.arm)
                    let armType = model.autoPayloadType(autoType maybe.some(c.matchType))
                    let var a = ""
                    if arm.exact then
                        let armStruct = layout.tupleStructName(armType)
                        a := temp(p armStruct <> " *")
                        emit(p "if (quest_layout_equivalent(" <> tgt <> "->type_desc, " <> matchDesc <> ")) {")
                        if arm.shared then
                            (* The binders share the stored components (and so
                             * see updates of var components) *)
                            emit(p "    " <> a <> " = (" <> armStruct <> " *)" <> stored <> ";")
                        else
                            p.indent := p.indent + 1
                            let converted = if maybe.isNone(arm.plan) then stored
                                else convert(p stored maybe.unwrap(arm.plan))
                            end
                            emit(p a <> " = " <> converted <> ";")
                            p.indent := p.indent - 1
                        end
                        emit(p "} else {")
                        p.indent := p.indent + 1
                        if arm.layoutError then
                            emit(p "quest_layout_conversion_error(" <> tgt <> "->type_desc, " <> matchDesc <> ");")
                        end
                        let converted = autoArmConverted(p arm stored storedType armType)
                        emit(p a <> " = " <> converted <> ";")
                        p.indent := p.indent - 1
                        emit(p "}")
                    else
                        a := autoArmConverted(p arm stored storedType armType)
                    end
                    for j = 0 upto {extent c.binders - 1} do assign(p c.binders[j] a) end
                end
                body(p c.body)
                p.indent := p.indent - 1
            end
            if extent x.cases > 0 then
                emit(p "} else {")
                p.indent := p.indent + 1
            end
            if maybe.isSome(x.elseBody) then body(p maybe.unwrap(x.elseBody))
            else emit(p "quest_raise_dynamic_error_at(" <> site(p x.offset) <> ");")
            end
            if extent x.cases > 0 then
                p.indent := p.indent - 1
                emit(p "}")
            end
            ok
        end

    (* =========================================================================
     * Functions
     * ====================================================================== *)

    (* The C declarations of the variables a function (or a top level) binds,
     * but for exclude's *)
    let declareLocals(p: P b: nodes.Body exclude: hashMap.T(Int Bool)): vector.T(Local) =
        begin
            let decls = vector.new(:Local)
            let seen = hashMap.new(:Int :Bool intEqual hash.int)
            let statements = walk.walkStatements(b false)
            for i = 0 upto {vector.length(statements) - 1} do
                let s = vector.get(statements i)
                case s when sTry with x then put(p.handlerVars x.exc.id true) else ok end
                let binders = walk.statementBinders(s)
                for j = 0 upto {extent binders - 1} do
                    let v = binders[j]
                    (* A let rec's variable is bound by the let rec and by the
                     * let in it that computes its value *)
                    if not(hashMap.contains(seen v.id)) andif not(hashMap.contains(exclude v.id))
                        andif not(isOk(v.type)) then
                        put(seen v.id true)
                        let c = varCType(p v)
                        let typed = if hashMap.contains(p.fs.volatile v.id) then c <> " volatile" else c end
                        vector.append(decls tuple let cType = typed let name = name(p v) end)
                    end
                end
            end
            decls
        end

    (* The variables a try body assigns, which C must declare volatile for the
     * handler to read them after longjmp; and those it stores through, since
     * clang may keep the fields of an object allocated in the function, whose
     * address does not escape, in registers that longjmp restores *)
    let volatileVars(b: nodes.Body): hashMap.T(Int Bool) =
        begin
            let found = hashMap.new(:Int :Bool intEqual hash.int)
            let through = fun(a: nodes.Atom): Ok
                case a
                    when atomVar with v then put(found v.v.id true)
                    else ok
                end
            let statements = walk.walkStatements(b false)
            for i = 0 upto {vector.length(statements) - 1} do
                case vector.get(statements i)
                    when sTry with x then
                        let inner = walk.walkStatements(x.body false)
                        for j = 0 upto {vector.length(inner) - 1} do
                            case vector.get(inner j)
                                when sAssign with y then put(found y.v.id true)
                                when sStoreField with y then through(y.base)
                                when sStoreComponent with y then through(y.base)
                                when sStoreElement with y then through(y.base)
                                when sStoreAt with y then through(y.address)
                                else ok
                            end
                        end
                    else ok
                end
            end
            found
        end

    let functionSignature(p: P f: nodes.Function): String =
        begin
            let count = typeParameterCount(f.v.type)
            let params = vector.new(:String)
            add(params "void *_raw_env")
            if count > 0 then
                let n = extent f.descriptorParams
                for i = n - count upto {n - 1} do
                    add(params "const QTypeDescriptor *" <> name(p f.descriptorParams[i].v))
                end
            end
            for i = 0 upto {extent f.params - 1} do
                let entry = f.params[i]
                if not(eq(entry.mode "value")) then
                    add(params locationCType(entry.v.type) <> " *" <> name(p entry.v))
                else
                    let c = if isOk(entry.v.type) then "QVal" else cType(entry.v.type) end
                    add(params c <> " " <> name(p entry.v))
                end
            end
            let ret = if isOk(f.resultType) then "void" elsif f.unboxedResult then unboxedCType(f.resultType)
                else cType(f.resultType) end
            "static Q_UNUSED " <> ret <> " " <> syntax.call(codeName(p f) params)
        end

    (* The C definition of the lifted function f: its signature
     * (functionSignature: the raw environment, then its own type parameters'
     * descriptors, then its parameters), a prologue, the declarations of its
     * variables and temporaries, and its body. The prologue casts _raw_env to
     * what f's closure carries (a struct QEnv_<f> of its captures, or for an
     * adapter, the closure it adapts), loads the descriptors of the type
     * parameters the closure supplies rather than the caller, and fetches the
     * view map of each type parameter whose values the body reads through
     * its bound (codegen-c.md section 10.4). Every variable is declared at
     * the top, as an IR variable may be read outside the C block that binds
     * it (a join point's parameters are assigned in one block and read in
     * another); and the body is printed before the declarations are, since
     * printing it makes the temporaries. The (void) casts keep the C
     * compiler from warning of parameters the body does not use *)
    let function(p: P f: nodes.Function): Lines =
        begin
            p.fs := newFnState(maybe.some(f))
            p.fs.volatile := volatileVars(f.body)
            p.fs.fused := fusedTuples(p f.body)
            let nCaptured = extent f.typeParams - typeParameterCount(f.v.type)
            let signature = functionSignature(p f)
            let prologue = vector.new(:String)
            for i = nCaptured upto {extent f.descriptorParams - 1} do
                add(prologue "(void)" <> name(p f.descriptorParams[i].v) <> ";")
            end
            if maybe.isSome(f.env) andif not(isOk(maybe.unwrap(f.env).type)) then
                (* An adapter's environment is the closure it adapts, of that
                 * closure's type (ir/thunks); a lifted function's, a struct of
                 * captures, has the placeholder type Ok *)
                let env = maybe.unwrap(f.env)
                add(prologue cType(env.type) <> " " <> name(p env) <> " = (" <> cType(env.type) <> ")_raw_env;")
            elsif maybe.isSome(f.env) then
                let envStruct = "struct QEnv_" <> codeName(p f)
                let envName = name(p maybe.unwrap(f.env))
                add(prologue envStruct <> " *" <> envName <> " = (" <> envStruct <> " *)_raw_env;")
                (* The descriptors of the type parameters its closure
                 * supplies *)
                for i = 0 upto {nCaptured - 1} do
                    let d = name(p f.descriptorParams[i].v)
                    add(prologue "const QTypeDescriptor *" <> d <> " = " <> name(p maybe.unwrap(f.env))
                        <> "->d" <> cInt(i)
                        <> ";")
                    add(prologue "(void)" <> d <> ";")
                end
            else
                add(prologue "(void)_raw_env;")
            end
            for i = 0 upto {extent f.viewMaps - 1} do
                (* The view maps of type parameters whose values the body reads
                 * through their bounds *)
                let m = f.viewMaps[i]
                add(prologue "const QViewMap *" <> name(p m.v) <> " = quest_view_map(" <> name(p m.descriptor) <> ", "
                    <> descriptor(p m.bound) <> ");")
            end
            let exclude = hashMap.new(:Int :Bool intEqual hash.int)
            for i = 0 upto {extent f.params - 1} do put(exclude f.params[i].v.id true) end
            let decls = declareLocals(p f.body exclude)
            p.lines := vector.new()
            p.indent := 1
            body(p f.body)
            let bodyLines = p.lines
            let res = vector.new(:String)
            add(res signature <> " {")
            for i = 0 upto {vector.length(prologue) - 1} do add(res "    "
                <> vector.get(prologue i)) end
            for i = 0 upto {vector.length(decls) - 1} do
                let l = vector.get(decls i)
                add(res "    " <> l.cType <> " " <> l.name <> ";")
            end
            for i = 0 upto {vector.length(p.fs.locals) - 1} do
                let l = vector.get(p.fs.locals i)
                add(res "    " <> l.cType <> " " <> l.name <> ";")
            end
            addAll(res bodyLines)
            add(res "}")
            add(res "")
            res
        end

    let envStruct(p: P f: nodes.Function closure: nodes.OpMakeClosure): Lines =
        begin
            let lines = vector.new(:String)
            add(lines "struct QEnv_" <> codeName(p f) <> " {")
            for i = 0 upto {extent closure.typeArgs - 1} do add(lines "    const QTypeDescriptor *d" <> cInt(i)
                <> ";") end
            for i = 0 upto {extent closure.captures - 1} do
                (* An Ok has no C type of its own (void): its field holds
                 * Q_OK_VAL, as a slot does *)
                let t = atomType(closure.captures[i])
                add(lines "    " <> if isOk(t) then "QVal" else cType(t) end <> " c" <> cInt(i) <> ";")
            end
            if {extent closure.typeArgs is 0}
                andif {extent closure.captures is 0} then add(lines "    char _unused;") end
            add(lines "};")
            lines
        end

    (* =========================================================================
     * The unit
     * ====================================================================== *)

    (* A top level's local declarations (its variables bound in loops) and its
     * statements *)
    Let TopLevel = Tuple decls: vector.T(Local) lines: Lines end
    let topLevel(p: P b: nodes.Body): TopLevel =
        begin
            p.fs := newFnState(maybe.none())
            p.fs.volatile := volatileVars(b)
            p.fs.fused := fusedTuples(p b)
            let decls = declareLocals(p b p.globals)
            p.lines := vector.new()
            p.indent := 1
            body(p b)
            let all = vector.copy(decls)
            for i = 0 upto {vector.length(p.fs.locals) - 1} do
                vector.append(all vector.get(p.fs.locals i)) end
            tuple let decls = all let lines = p.lines end
        end

    let staticData(p: P): nodes.StaticData = maybe.unwrap(p.unit.staticData)

    (* The declarations of the types the unit uses: structs, offset tables,
     * descriptors, and adapters *)
    let declarationLines(p: P): Lines =
        begin
            let data = staticData(p)
            let e = declarations.newEmitter(p.ctx)
            p.emitter := maybe.some(e)
            (* The aggregates of the types the describe pass listed *)
            let aggregates = declarations.collectAggregateTypes(vector.toArray(data.types) p.ctx).aggregates
            (* The static tables the unit's operations refer to, by their C
             * names *)
            let ctx = maybe.some(p.ctx)
            let tableKeys = vector.new(:String)
            let tables = hashMap.new(:String :declarations.Pair eq hash.string)
            for i = 0 upto {vector.length(data.offsetTables) - 1} do
                let t = vector.get(data.offsetTables i)
                let key = staticdata.recordStructName(t.view ctx) <> "\n" <> staticdata.recordStructName(t.layout ctx)
                if not(hashMap.contains(tables key)) then add(tableKeys key) end
                put(tables key tuple let target = t.view let source = t.layout end)
            end
            let mapKeys = vector.new(:String)
            let maps = hashMap.new(:String :declarations.Pair eq hash.string)
            for i = 0 upto {vector.length(data.tagMaps) - 1} do
                let t = vector.get(data.tagMaps i)
                let key = layout.typeTag(t.target) <> "\n" <> layout.typeTag(t.source)
                if not(hashMap.contains(maps key)) then add(mapKeys key) end
                put(maps key tuple let target = t.target let source = t.source end)
            end
            let valuesOf(keys: vector.T(String) m: hashMap.T(String declarations.Pair)): vector.T(declarations.Pair) =
                begin
                    let res = vector.new(:declarations.Pair)
                    for i = 0 upto {vector.length(keys) - 1} do
                        vector.append(res
                            hashMap.find(m vector.get(keys i)))
                    end
                    res
                end
            let plain = vector.new(:Type)
            let echoed = vector.new(:Type)
            for i = 0 upto {vector.length(data.descriptors) - 1} do
                let d = vector.get(data.descriptors i)
                vector.append(if d.echo then echoed else plain end d.type)
            end
            let structNames = vector.new(:String)
            for i = 0 upto {vector.length(aggregates) - 1} do
                add(structNames vector.get(aggregates i).name)
            end
            let lines = vector.new(:String)
            addAll(lines declarations.emitForwardTypedefs(e aggregates))
            addAll(lines declarations.emitAggregateStructs(e aggregates))
            addAll(lines declarations.emitEvidenceDictionaries(e aggregates valuesOf(tableKeys tables)))
            addAll(lines
                declarations.emitCoercionTables(e valuesOf(p.tupleCastKeys p.tupleCasts) valuesOf(mapKeys maps)))
            let static(t: Type): staticdata.DescriptorForm = staticForm(p t)
            addAll(lines declarations.emitTypeDescriptors(e plain static echoed structNames))
            addAll(lines declarations.emitFunTypeAdapters(e e.emittedFunTypes))
            lines
        end

    (* The extern declarations of what the unit's imports define, each module
     * once: its record (qm_<module>), its initializer, and the functions it
     * exports (emitPrecompiledModuleDeclarations) *)
    let importDeclarations(p: P): Lines =
        begin
            let imports = vector.new(:nodes.Import)
            let seen = hashMap.new(:String :Bool eq hash.string)
            for i = 0 upto {extent p.unit.imports - 1} do
                let imp = p.unit.imports[i]
                if not(hashMap.contains(seen imp.canonicalPath)) then
                    put(seen imp.canonicalPath true)
                    vector.append(imports imp)
                end
            end
            let lines = vector.new(:String)
            let records = vector.new(:declarations.ModuleRecord)
            for i = 0 upto {vector.length(imports) - 1} do
                let imp = vector.get(imports i)
                let clean = symbols.mangleModuleName(imp.canonicalPath)
                add(lines "extern QRecordVal " <> symbols.moduleRecordIdent(clean) <> ";")
                add(lines "extern void qv_mod_" <> clean <> "_init(void);")
                vector.append(records
                    tuple let name = imp.canonicalPath let recordType = imp.recordType end)
            end
            addAll(lines
                declarations.emitPrecompiledModuleDeclarations(maybe.unwrap(p.emitter) records))
            lines
        end

    (* A global's declaration, and the words of it a root table lists: all
     * of them if any may be a pointer, else none; a handler's variable is a
     * copy of the exception state (QExceptionState), whose every word may be
     * one *)
    Let GlobalDecl = Tuple name: String cType: String words: Int end
    let globalDeclarations(p: P): vector.T(GlobalDecl) =
        begin
            let found = vector.new(:GlobalDecl)
            let seen = hashMap.new(:Int :Bool intEqual hash.int)
            let bodies = vector.new(:nodes.Body)
            vector.append(bodies p.unit.main)
            for i = 0 upto {vector.length(p.unit.modules) - 1} do
                vector.append(bodies vector.get(p.unit.modules i).init)
            end
            for b = 0 upto {vector.length(bodies) - 1} do
                let statements = walk.walkStatements(vector.get(bodies b) false)
                for i = 0 upto {vector.length(statements) - 1} do
                    let binders = walk.statementBinders(vector.get(statements i))
                    for j = 0 upto {extent binders - 1} do
                        let v = binders[j]
                        if hashMap.contains(p.globals v.id) andif not(hashMap.contains(seen v.id))
                            andif not(isOk(v.type)) then
                            put(seen v.id true)
                            let words =
                                if hashMap.contains(p.handlerVars v.id) then
                                    maybe.unwrap(runtimeLayout.struct("QExceptionState")).bytes / 8
                                elsif holdsPointer(v.type) then extent objectLayout.representationKinds(shapeOf(v.type))
                                else 0 end
                            vector.append(found tuple
                                let name = name(p v) let cType = varCType(p v) let words = words end)
                        end
                    end
                end
            end
            found
        end

    let isModuleFile(p: P): Bool = not(p.unit.isProgram)

    (* The C functions of the unit that have frames in tracebacks, and their
     * frame names: its functions with names (not those the passes made), its
     * modules' initializers, and a program's main *)
    Let FuncEntry = Tuple cName: String frame: String end
    let funcTableEntries(p: P): vector.T(FuncEntry) =
        begin
            let entries = vector.new(:FuncEntry)
            for i = 0 upto {vector.length(p.unit.functions) - 1} do
                let f = vector.get(p.unit.functions i)
                if maybe.isSome(f.traceName) then
                    vector.append(entries tuple let cName = codeName(p f) let frame =
                        maybe.unwrap(f.traceName) end)
                end
            end
            for i = 0 upto {vector.length(p.unit.modules) - 1} do
                let m = vector.get(p.unit.modules i)
                vector.append(entries tuple
                    let cName = "qv_mod_" <> symbols.mangleModuleName(m.name) <> "_init"
                    let frame = diagnostics.initFrame(m.name)
                end)
            end
            if not(isModuleFile(p)) then
                vector.append(entries tuple let cName = "main" let frame = diagnostics.mainFrame end)
            end
            entries
        end

    (* Registers a module's abstract types with their representations, for
     * dynamic values (docs/dynamic.md section 2.3), as the describe pass
     * listed them; a representation without a descriptor is not registered *)
    let abstractTypeRegistrations(p: P m: nodes.Module): Lines =
        begin
            let res = vector.new(:String)
            for i = 0 upto {extent m.abstractTypes - 1} do
                let entry = m.abstractTypes[i]
                let form = try maybe.some(staticdata.descriptorForm(entry.descriptor.type
                        maybe.some(p.ctx)))
                    when staticdata.missingDescriptor then maybe.none(:staticdata.DescriptorForm)
                end
                if maybe.isSome(form) then
                    let registered = syntax.call("quest_register_abstract_type"
                        strings(array of syntax.cString(entry.name) cInt(entry.arity)
                            types.cExpr(maybe.unwrap(form)) end))
                    add(res "    " <> registered <> ";")
                end
            end
            res
        end

    (* A module file's exported functions (qv_<module>_<member>), one for each
     * of its interface's functions and polymorphic values, which call its
     * export's function directly when the export is known to be a closure
     * without captures (an adapter's, the thunks pass makes it so, when the
     * interface's type differs), and its closure otherwise *)
    let exportedFunctions(p: P m: nodes.Module): Lines =
        begin
            let clean = symbols.mangleModuleName(m.name)
            let res = vector.new(:String)
            let exports = maybe.unwrap(m.exports)
            for i = 0 upto {vector.length(exports.names) - 1} do
                let exportName = vector.get(exports.names i)
                let exportVar = maybe.unwrap(nodes.member(exports exportName))
                let sig = declarations.moduleFunctionSignature(clean exportName exportVar.type)
                if maybe.isSome(sig) then
                    let fsig = maybe.unwrap(sig)
                    let args = declarations.moduleFunctionArguments(exportVar.type)
                    let known = hashMap.get(p.closures exportVar.id)
                    let direct = maybe.isSome(known)
                        andif {extent maybe.unwrap(:nodes.OpMakeClosure known).typeArgs is 0}
                        andif {extent maybe.unwrap(:nodes.OpMakeClosure known).captures is 0}
                    let called = if direct then
                        syntax.call(codeName(p maybe.unwrap(known).code)
                            joinedWith(one("NULL") args))
                    else
                        let fnPtr = types.closureFnPtrType(exportVar.type)
                        let clos = name(p exportVar)
                        syntax.call("((" <> fnPtr <> ")(" <> clos <> "->fn))" joinedWith(one(clos <> "->env") args))
                    end
                    let params = if vector.empty(fsig.params) then one("void") else fsig.params end
                    add(res fsig.result <> " " <> syntax.call(fsig.name params) <> " {")
                    add(res if eq(fsig.result "void") then "    " <> called <> ";" else "    return " <> called
                        <> ";" end)
                    add(res "}")
                    add(res "")
                end
            end
            res
        end

    (* A module's initializer, whose body makes its record, stored in the
     * module's global. A module file's is extern, as are its record and its
     * exported functions, and initializes the modules it imports first, as a
     * program's main does. *)
    let moduleInit(p: P m: nodes.Module): Lines =
        begin
            let clean = symbols.mangleModuleName(m.name)
            let top = topLevel(p m.init)
            let exported = maybe.isSome(m.exports)
            let linkage = if exported then "" else "static " end
            let res = vector.new(:String)
            add(res linkage <> "void qv_mod_" <> clean <> "_init(void) {")
            add(res "    if (qv_mod_" <> clean <> "_initialized) return;")
            add(res "    qv_mod_" <> clean <> "_initialized = true;")
            for i = 0 upto {vector.length(top.decls) - 1} do
                let l = vector.get(top.decls i)
                add(res "    " <> l.cType <> " " <> l.name <> ";")
            end
            addAll(res abstractTypeRegistrations(p m))
            if exported then
                add(res "    qr_register_dicts();")
                for i = 0 upto {extent p.unit.imports - 1} do
                    add(res "    qv_mod_" <> symbols.mangleModuleName(p.unit.imports[i].canonicalPath) <> "_init();")
                end
            end
            addAll(res top.lines)
            (* The record the initializer made last, if it has one (a whole
             * program's module whose record nothing reads has none) *)
            if maybe.isSome(m.recordVar) then
                add(res "    " <> symbols.moduleRecordIdent(clean) <> " = "
                    <> varAtom(p maybe.unwrap(m.recordVar)) <> ";")
            end
            add(res "}")
            add(res "")
            if exported then addAll(res exportedFunctions(p m)) end
            res
        end

    (* The C file of p.unit, a program or a module file, as the bootstrap's
     * CPrinter.print_unit (bootstrap/python/quest/codegen/c/printer.py)
     * writes it (docs/codegen-c.md section 3.1).
     *
     * Two things come first. The closures each function is made by are
     * collected, for the environment structs and for direct calls (a call of
     * a variable known to hold one closure jumps straight to its code). Then
     * the functions, the modules' initializers, and the program's top level
     * are printed into buffers before anything else: printing them is what
     * finds the tuple casts, option tables, object layouts, and names the
     * declarations at the top of the file must list, and it numbers names in
     * the bootstrap's order, so the two compilers' C can be compared.
     *
     * The file is then, in order: the includes (the runtime header, and a
     * module file's interface header); the declarations of the types the
     * unit uses and of the modules it imports; environment structs; a
     * prototype and a static closure for each function; globals, option
     * tables, and the modules' records; the root table (the globals and
     * records the collector must scan); the object layouts; the table of
     * functions that appear in tracebacks; qr_register_dicts, which registers
     * those two tables and the offset tables of records the unit views at
     * supertypes when the unit starts; and the buffered functions and
     * initializers.
     *
     * A program ends with main, which initializes the runtime, the modules
     * it imports and its own, and then runs its top level. A module file
     * has no main: its initializer is extern, and calls qr_register_dicts
     * and its imports' initializers itself (moduleInit) *)
    let printUnit(p: P): String =
        begin
            let unit = p.unit
            (* The closure that makes each function, by the function's id
             * (the first found), for its environment's struct *)
            let closuresOf = hashMap.new(:Int :nodes.OpMakeClosure intEqual hash.int)
            let bodies = vector.new(:nodes.Body)
            vector.append(bodies unit.main)
            for i = 0 upto {vector.length(unit.modules) - 1} do
                vector.append(bodies vector.get(unit.modules i).init)
            end
            for i = 0 upto {vector.length(unit.functions) - 1} do
                vector.append(bodies vector.get(unit.functions i).body)
            end
            for b = 0 upto {vector.length(bodies) - 1} do
                let statements = walk.walkStatements(vector.get(bodies b) false)
                for i = 0 upto {vector.length(statements) - 1} do
                    case vector.get(statements i)
                        when sLet with x then
                            case x.value
                                when opMakeClosure with c then
                                    if not(hashMap.contains(closuresOf c.code.id)) then
                                        put(closuresOf c.code.id c)
                                    end
                                else ok
                            end
                        else ok
                    end
                end
            end
            (* The closure each variable is known to hold, for direct calls:
             * a let's, a copy's, and an environment's read of one
             * (walk.knownClosures) *)
            let known = walk.knownClosures(unit)
            let entries = hashMap.entryIter(known)
            while iter.more(entries) do
                let e = iter.next(entries)
                put(p.closures e.key e.value)
            end

            let functions = vector.new(:String)
            for i = 0 upto {vector.length(unit.functions) - 1} do
                addAll(functions function(p vector.get(unit.functions i)))
            end
            let moduleInits = vector.new(:String)
            for i = 0 upto {vector.length(unit.modules) - 1} do
                addAll(moduleInits moduleInit(p vector.get(unit.modules i)))
            end
            let main = topLevel(p unit.main)

            let moduleFile = isModuleFile(p)
            let res = vector.new(:String)
            add(res "/* Emitted by the Quest IR C printer */")
            add(res "#include \"quest_runtime.h\"")
            if maybe.isSome(p.interfaceHeader) then
                add(res "#include \"" <> maybe.unwrap(p.interfaceHeader) <> "\"")
            end
            add(res "")
            addAll(res declarationLines(p))
            addAll(res importDeclarations(p))
            for i = 0 upto {vector.length(unit.functions) - 1} do
                let f = vector.get(unit.functions i)
                let closure = hashMap.get(closuresOf f.id)
                if maybe.isSome(f.env) andif maybe.isSome(closure) then
                    addAll(res envStruct(p f maybe.unwrap(closure)))
                end
            end
            add(res "")
            for i = 0 upto {vector.length(unit.functions) - 1} do
                let f = vector.get(unit.functions i)
                add(res functionSignature(p f) <> ";")
                let code = codeName(p f)
                add(res "static Q_UNUSED QClosure " <> code <> "_closure = { (void *)" <> code <> ", NULL };")
            end
            add(res "")
            let globalDecls = globalDeclarations(p)
            for i = 0 upto {vector.length(globalDecls) - 1} do
                let g = vector.get(globalDecls i)
                add(res "static " <> g.cType <> " " <> g.name <> ";")
            end
            for i = 0 upto {vector.length(p.optionTableDecls) - 1} do
                add(res vector.get(p.optionTableDecls i))
            end
            for i = 0 upto {vector.length(p.stringDecls) - 1} do add(res vector.get(p.stringDecls i)) end
            for i = 0 upto {vector.length(unit.modules) - 1} do
                let m = vector.get(unit.modules i)
                let clean = symbols.mangleModuleName(m.name)
                let linkage = if maybe.isSome(m.exports) then "" else "static " end
                add(res linkage <> "QRecordVal " <> symbols.moduleRecordIdent(clean) <> ";")
                add(res "static bool qv_mod_" <> clean <> "_initialized = false;")
                if maybe.isSome(m.exports) then add(res "void qv_mod_" <> clean <> "_init(void);") end
            end
            add(res "")
            (* The unit's root table: its globals that may hold pointers, and
             * its module records (docs/collector.md section 3.8) *)
            add(res "static const QRootEntry qr_roots[] = {")
            for i = 0 upto {vector.length(globalDecls) - 1} do
                let g = vector.get(globalDecls i)
                if g.words > 0 then add(res "    { (void *)&" <> g.name <> ", " <> cInt(g.words) <> " },") end
            end
            (* Not the record of a whole program's module left without one
             * (whole.dropUnreachable), which stays zero *)
            for i = 0 upto {vector.length(unit.modules) - 1} do
                let m = vector.get(unit.modules i)
                if maybe.isSome(m.recordVar) then
                    add(res "    { (void *)&" <> symbols.moduleRecordIdent(symbols.mangleModuleName(m.name)) <> ", 2 },")
                end
            end
            add(res "    { NULL, 0 },")
            add(res "};")
            addAll(res layoutDefinitions(p))
            (* The unit's functions with frames in tracebacks
             * (docs/exceptions.md section 5.2) *)
            let funcs = funcTableEntries(p)
            if not(vector.empty(funcs)) then
                for i = 0 upto {vector.length(unit.modules) - 1} do
                    let m = vector.get(unit.modules i)
                    if maybe.isNone(m.exports) then
                        add(res "static void qv_mod_" <> symbols.mangleModuleName(m.name) <> "_init(void);")
                    end
                end
                if not(moduleFile) then add(res "int main(int argc, char **argv);") end
                add(res "static const QFuncEntry qr_funcs[] = {")
                for i = 0 upto {vector.length(funcs) - 1} do
                    let f = vector.get(funcs i)
                    add(res "    { (const void *)&" <> f.cName <> ", " <> syntax.cString(f.frame) <> " },")
                end
                add(res "};")
                add(res "")
            end
            (* Registers the unit's root table, its function table, and the
             * offset tables of the records it views at supertypes, for
             * dynamic values *)
            add(res "static void qr_register_dicts(void) {")
            add(res "    quest_register_roots(qr_roots);")
            if not(vector.empty(funcs)) then
                add(res "    quest_register_funcs(qr_funcs, sizeof qr_funcs / sizeof qr_funcs[0]);")
            end
            let registered = hashMap.new(:String :Bool eq hash.string)
            let tables = staticData(p).offsetTables
            for i = 0 upto {vector.length(tables) - 1} do
                let table = vector.get(tables i)
                let dictName = staticdata.offsetDictInstanceName(p.ctx table.view table.layout)
                if maybe.isSome(table.registered)
                    andif not(hashMap.contains(registered dictName)) then
                    put(registered dictName true)
                    let r = maybe.unwrap(table.registered)
                    let viewD = staticDescriptorOf(p r.view)
                    let layoutD = staticDescriptorOf(p r.layout)
                    add(res "    quest_register_record_dict(" <> viewD <> ", " <> layoutD <> ", &" <> dictName <> ");")
                end
            end
            add(res "}")
            add(res "")
            addAll(res functions)
            addAll(res moduleInits)
            if moduleFile then
                syntax.linesText(res)
            else
                add(res "int main(int argc, char **argv) {")
                add(res "    quest_gc_init();")
                add(res "    quest_builtins_init(argc, argv);")
                add(res "    qr_register_dicts();")
                for i = 0 upto {extent unit.imports - 1} do
                    add(res "    qv_mod_" <> symbols.mangleModuleName(unit.imports[i].canonicalPath) <> "_init();")
                end
                for i = 0 upto {vector.length(unit.modules) - 1} do
                    add(res "    qv_mod_" <> symbols.mangleModuleName(vector.get(unit.modules i).name)
                        <> "_init();")
                end
                for i = 0 upto {vector.length(main.decls) - 1} do
                    let l = vector.get(main.decls i)
                    add(res "    " <> l.cType <> " " <> l.name <> ";")
                end
                addAll(res main.lines)
                add(res "    return 0;")
                add(res "}")
                add(res "")
                syntax.linesText(res)
            end
        end

    let printC(unit: nodes.Unit interfaceHeader: maybe.T(String)): String =
        printUnit(tuple
            let unit = unit
            let interfaceHeader = interfaceHeader
            let ctx = staticdata.newRecordNaming()
            let globals = walk.globalVariables(unit)
            let names = hashMap.new(intEqual hash.int)
            let usedNames = hashMap.new(eq hash.string)
            let nameCounts = hashMap.new(eq hash.string)
            let codeNames = hashMap.new(intEqual hash.int)
            let closures = hashMap.new(intEqual hash.int)
            let handlerVars = hashMap.new(intEqual hash.int)
            let tupleCastKeys = vector.new()
            let tupleCasts = hashMap.new(eq hash.string)
            let optionTables = hashMap.new(eq hash.string)
            let optionTableDecls = vector.new()
            let stringObjects = hashMap.new(eq hash.string)
            let stringDecls = vector.new()
            let layouts = objectLayout.newTable()
            let var fs = newFnState(maybe.none())
            let var lines = vector.new()
            let var indent = 1
            let var tmp = 0
            let var calls = 0
            let var pending = maybe.none()
            let var deferred = maybe.none()
            let var emitter = maybe.none()
        end)
end
