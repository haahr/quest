(* Quest Self-Hosted Compiler: C Declarations Interface
 *
 * Self-hosted counterpart of bootstrap/python/quest/codegen/c/declarations.py.
 * This interface emits the C declarations used by the IR printer
 * (codegen/c/printer) and by interface C headers (codegen/c/headers):
 * aggregate structs, record offset tables, subtyping coercion tables, runtime
 * type descriptors, function type adapters, and extern declarations for
 * modules' exported functions. Each emitter returns a vector of C lines. *)

interface Declarations
import
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/codegen/c/types : questlang/codegen/c/Types
    questlang/common/maps : questlang/common/Maps
    questlang/repr/staticdata : questlang/repr/StaticData
    questlang/types/model : questlang/types/Model
export
    (* Returns the C function signature that a module file exports for an
     * interface member that is a function or polymorphic value, or none for
     * other members. The exported function is named qv_<module>_<member> and
     * takes its type parameters' runtime descriptors followed by its value
     * parameters, typed according to the interface. *)
    Def FunctionSignature = Tuple result: String name: String params: vector.T(String) end
    moduleFunctionSignature(cleanMod: String name: String t: model.Type): maybe.T(FunctionSignature)
    (* The names of the parameters moduleFunctionSignature declares, in
     * order *)
    moduleFunctionArguments(t: model.Type): vector.T(String)

    (* Collects the aggregate types reached from ts via their canonical shapes.
     * The returned record holds the tuple, record, and option structs (each
     * paired with its C struct name and shape structure, in first-reached
     * order as pinned by interface C headers in tests/abi), the variant types,
     * and every reached shape's structure. *)
    Def Aggregate = Tuple name: String type: model.Type end
    Def Aggregates = Tuple
        aggregates: vector.T(Aggregate)
        variants: vector.T(model.Type)
        all: vector.T(model.Type)
    end
    collectAggregateTypes(ts: Array(model.Type) ctx: staticdata.RecordNaming): Aggregates

    (* A pair of types a static table relates *)
    Def Pair = Tuple target: model.Type source: model.Type end

    (* Emits declarations, remembering the descriptors and structs emitted, so
     * that a later call emits only those earlier calls did not *)
    Def Emitter = Tuple
        ctx: staticdata.RecordNaming
        (* The descriptor tags the last emitTypeDescriptors emitted, sorted *)
        var emittedDescriptorTags: vector.T(String)
        (* The function types with descriptors the last emitTypeDescriptors
         * reached, whose adapters emitFunTypeAdapters defines *)
        var emittedFunTypes: vector.T(Aggregate)
        emittedBefore: maps.StringSet
        definedStructs: maps.StringSet
    end
    newEmitter(ctx: staticdata.RecordNaming): Emitter

    emitForwardTypedefs(e: Emitter aggregates: vector.T(Aggregate)): vector.T(String)
    (* The extern declarations of the functions modules compiled on their own
     * export, for each module by its canonical name and its interface's record
     * type *)
    Def ModuleRecord = Tuple name: String recordType: maybe.T(model.Type) end
    emitPrecompiledModuleDeclarations(e: Emitter modules: vector.T(ModuleRecord)): vector.T(String)
    (* The C struct of each tuple, record, and option type in aggregates *)
    emitAggregateStructs(e: Emitter aggregates: vector.T(Aggregate)): vector.T(String)
    (* Emits offset tables ("evidence dictionaries") for record subtyping
     * (docs/c-representation.md section 5.2). For a record viewed at a
     * supertype, its offset table holds the byte offset of each supertype
     * field in the record's concrete struct, so code that knows only the
     * supertype can read fields through it. Defines the table struct for each
     * record type in aggregates and the static table for each (view, layout)
     * pair in needed. *)
    emitEvidenceDictionaries(e: Emitter aggregates: vector.T(Aggregate) needed: vector.T(Pair)): vector.T(String)
    (* Emits the checks and tables that let a value be used at a supertype
     * without copying. For each tuple pair in tuples, emits static assertions
     * confirming that the supertype's components sit at identical offsets in
     * both structs so the pointer can be cast safely. For each variant pair in
     * variants, emits a table that maps the subtype's case tags to the
     * supertype's tag numbering. *)
    emitCoercionTables(e: Emitter tuples: vector.T(Pair) variants: vector.T(Pair)): vector.T(String)
    (* Emits static runtime type descriptors for ts and for echoTypes (used by
     * echo), along with descriptors for their component types. formOf returns
     * the descriptor form used to refer to a component type, and
     * definedStructs lists the aggregate structs already defined so any
     * missing ones can be emitted first. *)
    emitTypeDescriptors(e: Emitter ts: vector.T(model.Type) formOf: All(t: model.Type) staticdata.DescriptorForm
            echoTypes: vector.T(model.Type) definedStructs: vector.T(String)): vector.T(String)
    (* The adapter and the invoker of each function type that has a runtime
     * descriptor *)
    emitFunTypeAdapters(e: Emitter funs: vector.T(Aggregate)): vector.T(String)
end
