(* Quest Self-Hosted Compiler: The C Backend's Entry Points Implementation *)

module backend : Backend
import
    questlang/common/location : questlang/common/Location
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/lower : questlang/ir/Lower
    questlang/ir/verify : questlang/ir/Verify
    passes = questlang/codegen/backend : questlang/codegen/Backend
    questlang/codegen/c/printer : questlang/codegen/c/Printer
    ssaBuild = questlang/ssa/build : questlang/ssa/Build
    ssaVerify = questlang/ssa/verify : questlang/ssa/Verify
    questlang/codegen/ssac : questlang/codegen/Ssac
    arm64 = questlang/codegen/arm64/codegen : questlang/codegen/arm64/Codegen
    util/maybe : util/Maybe
    stringOp = string : StringOp
export
    let unitToC(unit: nodes.Unit interfaceHeader: maybe.T(String) backend: String): String =
        if stringOp.equal(backend "ssac") orif stringOp.equal(backend "arm64") then
            try
                let built = ssaBuild.buildUnit(unit)
                ssaVerify.checkUnit(built)
                if stringOp.equal(backend "ssac") then ssac.printUnit(built) else arm64.assembleUnit(built) end
            when ssaBuild.unsupported with m then raise printer.unsupported with "ssa: unsupported: " <> m end
            when ssaVerify.verifyError with m then raise printer.unsupported with m end
            when ssac.unsupported with m then raise printer.unsupported with m end
            when arm64.unsupported with m then raise printer.unsupported with m end
            end
        else
            printer.printC(unit interfaceHeader)
        end

    let cFlags(backend: String): Array(String) = if stringOp.equal(backend "ssac") then ssac.cFlags else array of :String end end

    let programToC(program: typedAst.Program e: env.T sourceMap: maybe.T(location.SourceMap) echo: Bool printResult:
        Bool backend: String)
        : Tuple c: String unit: nodes.Unit end =
        begin
            let lowered = lower.lowerProgram(program e sourceMap echo printResult)
            if verify.irChecksEnabled() then verify.checkUnit(lowered) end
            let unit = passes.runPasses(lowered)
            tuple let c = unitToC(unit maybe.none(:String) backend) let unit = unit end
        end

    let moduleFileToC(m: typedAst.Binding e: env.T sourceMap: maybe.T(location.SourceMap)
        interfaceHeader: maybe.T(String) backend: String): String =
        begin
            let unit = lower.lowerModuleFile(m e sourceMap)
            if verify.irChecksEnabled() then verify.checkUnit(unit) end
            unitToC(passes.runPasses(unit) interfaceHeader backend)
        end
end
