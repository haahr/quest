(* Quest Self-Hosted Compiler: The C Printer Interface
 *
 * bootstrap/python/quest/codegen/c/printer.py (docs/ir.md section 8.5): prints
 * a described IR unit as C, the IR's backend. It prints what the passes
 * decided: each IR function is a C function taking its closure's environment
 * first (and its own type parameters' descriptors, then its parameters), each
 * closure a QClosure of one (a static one when it captures nothing), each
 * variable a C variable of its type's representation (globals for the
 * variables the top levels bind outside loops), and each structured statement
 * a C statement: join points and loop exits are labels, and try regions
 * setjmp handlers, popped on every way out. Every representation decision is
 * the represent pass's, recorded in the IR, and every descriptor the describe
 * pass's. The declarations of the types the unit uses are
 * codegen/c/declarations', spelled in C by codegen/c/types. A module file's
 * unit exports its interface's members: its record (qm_<module>), initializer
 * (qv_mod_<module>_init), and a function for each function or polymorphic
 * value (qv_<module>_<member>), the ABI other units link against. *)

interface Printer
import
    questlang/ir/nodes : questlang/ir/Nodes
    util/maybe : util/Maybe
export
    (* A unit the printer cannot print (the bootstrap's NotImplementedError),
     * with its message *)
    unsupported: Exception(String)

    (* The C translation of a described unit: a program, or a module file
     * (including its interface's C header, if it has one) *)
    printC(unit: nodes.Unit interfaceHeader: maybe.T(String)): String
end
