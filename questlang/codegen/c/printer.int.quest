(* Quest Self-Hosted Compiler: The C Printer Interface
 *
 * Self-hosted counterpart of bootstrap/python/quest/codegen/c/printer.py
 * (docs/ir.md section 8.5). This interface prints a described IR unit as C
 * source code, emitting what the earlier IR passes decided: each IR function
 * becomes a C function taking its closure environment first (followed by its
 * type parameters' runtime descriptors and then its value parameters), each
 * closure becomes a QClosure (a static one when it captures nothing), each
 * variable becomes a C variable of its representation type (globals for
 * top-level bindings outside loops), and each structured statement becomes a C
 * statement. Join points (shared merge blocks) and loop exits compile to C
 * labels, and try regions compile to setjmp exception handlers that are popped
 * on every exit path. Representation decisions come from the represent pass,
 * runtime type descriptors come from the describe pass, and C type
 * declarations and spellings come from codegen/c/declarations and
 * codegen/c/types. A module file exports its interface members as its module
 * record (qm_<module>), its initializer (qv_mod_<module>_init), and a C
 * function (qv_<module>_<member>) for each exported function or polymorphic
 * value, forming the ABI that other units link against. *)

interface Printer
import
    questlang/ir/nodes : questlang/ir/Nodes
    util/maybe : util/Maybe
export
    (* A unit the printer cannot print (the bootstrap's NotImplementedError),
     * with its message *)
    unsupported: Exception(String)

    (* The C translation of a described unit: a program, or a module file
     * (including its interface's C header, if it has one) *)
    printC(unit: nodes.Unit interfaceHeader: maybe.T(String)): String
end
