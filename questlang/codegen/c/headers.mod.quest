(* Quest Self-Hosted Compiler: Interface Headers Implementation *)

module headers : Headers
import
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
    questlang/modules/paths : questlang/modules/Paths
    questlang/types/env : questlang/types/Env
    questlang/modules/graph : questlang/modules/Graph
    questlang/modules/loader : questlang/modules/Loader
    questlang/modules/interfaceCompiler : questlang/modules/InterfaceCompiler
    questlang/config/abi : questlang/config/Abi
    questlang/codegen/syntax : questlang/codegen/Syntax
    questlang/codegen/layout : questlang/codegen/Layout
    questlang/codegen/c/types : questlang/codegen/c/Types
    questlang/codegen/c/declarations : questlang/codegen/c/Declarations
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    util/stringBuilder : util/StringBuilder
    util/strutil : util/Strutil
    stringOp = string : StringOp
    real : RealOp
    ascii : Ascii
    writer : Writer
    system : System
export
    Let Type = model.Type

    let eq(a: String b: String): Bool = stringOp.equal(a b)
    let add(lines: vector.T(String) line: String): Ok = vector.append(:String lines line)

    let cKeywords = array of
        "auto" "break" "case" "char" "const" "continue" "default" "do" "double" "else" "enum" "extern" "float" "for"
        "goto" "if" "inline" "int" "long" "register" "restrict" "return" "short" "signed" "sizeof" "static" "struct"
        "switch" "typedef" "union" "unsigned" "void" "volatile" "while" "_Alignas" "_Alignof" "_Atomic" "_Bool"
        "_Complex" "_Generic" "_Imaginary" "_Noreturn" "_Static_assert" "_Thread_local"
    end
    let isCKeyword(name: String): Bool =
        begin
            let var found = false
            for i = 0 upto {extent cKeywords - 1} do if eq(cKeywords[i] name) then found := true end end
            found
        end

    let upper(s: String): String =
        begin
            let b = stringBuilder.new()
            for i = 0 upto {stringOp.length(s) - 1} do
                let c = stringOp.getChar(s i)
                let code = ascii.val(c)
                b.char(if {code >= 97} andif {code <= 122} then ascii.char(code - 32) else c end)
            end
            b.toString()
        end

    let cType(t: Type): String = types.qtypeToCType(t)

    let compileInterfaceToHeader(decl: ast.InterfaceDecl scope: symbols.Scope canonicalName: String): String =
        begin
            let cName = strutil.replace(canonicalName "/" "__")
            let guard = "QUEST_INTF_" <> upper(cName) <> "_H"
            let lines = vector.new(:String)
            add(lines abi.headerStamp)
            add(lines "/* Generated by Quest compiler for interface " <> decl.name <> " */")
            add(lines "#ifndef " <> guard)
            add(lines "#define " <> guard)
            add(lines "")
            add(lines "#include \"quest_runtime.h\"")
            add(lines "")
            add(lines "#ifdef __cplusplus")
            add(lines "extern \"C\" {")
            add(lines "#endif")
            add(lines "")

            (* Imported interfaces *)
            if not(vector.empty(:ast.ImportItem decl.imports)) then
                add(lines "/* --- Imported Interfaces --- */")
                for i = 0 upto {vector.length(:ast.ImportItem decl.imports) - 1} do
                    let imp = vector.get(:ast.ImportItem decl.imports i)
                    let path = paths.lower(maybe.unwrapOr(:String imp.interfacePath imp.interfaceName))
                    if not(eq(path "word")) then add(lines "#include \"" <> path <> ".int.h\"") end
                end
                add(lines "")
            end

            (* Aggregate struct definitions used in the interface *)
            let ctx = types.newRecordNaming()
            let aggregates = vector.new(:declarations.Aggregate)
            let names = hashMap.new(:String :Bool eq hash.string)
            let collect(t: Type): Ok =
                begin
                    let found = declarations.collectAggregateTypes(array of t end ctx).aggregates
                    for i = 0 upto {vector.length(:declarations.Aggregate found) - 1} do
                        let a = vector.get(:declarations.Aggregate found i)
                        if not(hashMap.contains(:String :Bool names a.name)) then
                            hashMap.insert(:String :Bool names a.name true)
                            vector.append(:declarations.Aggregate aggregates a)
                        end
                    end
                    ok
                end
            let typeSyms = hashMap.values(:String :symbols.TypeSymbol scope.types)
            for i = 0 upto {vector.length(:symbols.TypeSymbol typeSyms) - 1} do
                let d = vector.get(:symbols.TypeSymbol typeSyms i).definition
                if maybe.isSome(:Type d) then collect(maybe.unwrap(:Type d)) end
            end
            let valueSyms = hashMap.values(:String :symbols.ValueSymbol scope.values)
            for i = 0 upto {vector.length(:symbols.ValueSymbol valueSyms) - 1} do
                collect(vector.get(:symbols.ValueSymbol valueSyms i).type)
            end
            if not(vector.empty(:declarations.Aggregate aggregates)) then
                let emitter = declarations.newEmitter(ctx)
                let typedefs = declarations.emitForwardTypedefs(emitter aggregates)
                for i = 0 upto {vector.length(:String typedefs) - 1} do add(lines vector.get(:String typedefs i)) end
                let structs = declarations.emitAggregateStructs(emitter aggregates)
                for i = 0 upto {vector.length(:String structs) - 1} do add(lines vector.get(:String structs i)) end
            end

            (* Abstract types (erased to QVal in C) *)
            add(lines "/* --- Type Declarations --- */")
            let var hasTypes = false
            let sigs = interfaceCompiler.typeSignatures(decl)
            for i = 0 upto {extent sigs - 1} do
                case sigs[i].sig
                    when sigType with s then
                        hasTypes := true
                        (* A bounded abstract type (POWER(B)) is held as a value
                         * of B, as the signatures below declare it *)
                        let formal = symbols.lookupTypeLocal(scope s.val.name)
                        let kind = if maybe.isSome(:symbols.TypeSymbol formal) then
                            maybe.some(:model.Kind maybe.unwrap(:symbols.TypeSymbol formal).kind)
                        else
                            maybe.none(:model.Kind)
                        end
                        let isPower = maybe.isSome(:model.Kind kind) andif model.isPower(maybe.unwrap(:model.Kind kind))
                        let rep = if isPower then
                            cType(model.powerBound(maybe.unwrap(:model.Kind kind))) else "QVal" end
                        let kindText = if maybe.isSome(:model.Kind kind) then
                            interfaceCompiler.formatKindForQi(maybe.unwrap(:model.Kind kind))
                        else
                            "TYPE"
                        end
                        add(lines "/* Abstract type " <> s.val.name <> "::" <> kindText <> " */")
                        add(lines "typedef " <> rep <> " quest_type_" <> cName <> "_" <> s.val.name <> ";")
                    when sigTypeBinding with s then
                        if not(s.val.isRec) then
                            hasTypes := true
                            let typeSym = symbols.lookupTypeLocal(scope s.val.name)
                            let concrete = if maybe.isSome(:symbols.TypeSymbol typeSym) then
                                maybe.unwrap(:symbols.TypeSymbol typeSym).definition
                            else
                                maybe.none(:Type)
                            end
                            add(lines "/* Manifest type " <> s.val.name <> " */")
                            let isRecord = maybe.isSome(:Type concrete)
                                andif case maybe.unwrap(:Type concrete).form when typeRecord then true else false end
                            if isRecord then
                                add(lines "typedef struct quest_rec_" <> cName <> "_" <> s.val.name <> " {")
                                case maybe.unwrap(:Type concrete).form
                                    when typeRecord with r then
                                        for j = 0 upto {extent r.fields - 1} do
                                            add(lines "    " <> layout.slotRepresentation(r.fields[j].type) <> " "
                                                <> r.fields[j].name
                                                <> ";")
                                        end
                                    else ok
                                end
                                add(lines "} quest_rec_" <> cName <> "_" <> s.val.name <> ";")
                                add(lines "typedef QRecordVal quest_type_" <> cName <> "_" <> s.val.name <> ";")
                            else
                                let c = if maybe.isSome(:Type concrete) then
                                    cType(maybe.unwrap(:Type concrete)) else "QVal" end
                                add(lines "typedef " <> c <> " quest_type_" <> cName <> "_" <> s.val.name <> ";")
                            end
                        end
                    else ok
                end
            end
            if not(hasTypes) then add(lines "/* (No types declared) */") end
            add(lines "")

            (* Member signatures as function pointer typedefs *)
            add(lines "/* --- Member Signatures for Interface " <> decl.name <> " --- */")
            let var hasValues = false
            for i = 0 upto {vector.length(:ast.Signature decl.signatures) - 1} do
                case vector.get(:ast.Signature decl.signatures i)
                    when sigValue with s then
                        if maybe.isSome(:String s.val.name) then
                            hasValues := true
                            let name = maybe.unwrap(:String s.val.name)
                            let valSym = symbols.lookupValueLocal(scope name)
                            let valType = if maybe.isSome(:symbols.ValueSymbol valSym) then
                                maybe.some(:Type maybe.unwrap(:symbols.ValueSymbol valSym).type)
                            else
                                maybe.none(:Type)
                            end
                            let comment = "/* " <> name <> ": " <> if maybe.isSome(:Type valType) then
                                interfaceCompiler.formatTypeForQi(maybe.unwrap(:Type valType))
                            else
                                ""
                            end <> " */"
                            let isFunction = maybe.isSome(:Type valType) andif case maybe.unwrap(:Type valType).form
                                when typeFun, typeAll then true
                                else false
                            end
                            if isFunction then
                                let t = maybe.unwrap(:Type valType)
                                let params = vector.new(:String)
                                let inner = case t.form
                                    when typeAll with a then
                                        for j = 0 upto {extent a.quantifiers - 1} do
                                            add(params "const QTypeDescriptor *desc_" <> a.quantifiers[j].name)
                                        end
                                        a.body
                                    else t
                                end
                                let ret = case inner.form
                                    when typeFun with f then
                                        for j = 0 upto {extent f.params - 1} do
                                            let p = f.params[j]
                                            let pName0 = if stringOp.length(p.name) > 0 then p.name else "arg" end
                                            let pName = if isCKeyword(pName0) then "q_" <> pName0 else pName0 end
                                            if p.isVar orif p.isOut then
                                                add(params layout.locationRepresentation(p.type) <> " *" <> pName)
                                            else
                                                add(params cType(p.type) <> " " <> pName)
                                            end
                                        end
                                        cType(f.result)
                                    else cType(inner)
                                end
                                let shown = if vector.empty(:String params) then
                                    vector.fromArray(:String array of "void" end)
                                    else params
                                end
                                add(lines comment)
                                add(lines "typedef " <> ret <> " (*quest_sig_" <> cName <> "_" <> name <> ")("
                                    <> syntax.comma(shown) <> ");")
                            else
                                let c = if maybe.isSome(:Type valType) then
                                    cType(maybe.unwrap(:Type valType)) else "QVal" end
                                add(lines comment)
                                add(lines "typedef " <> c <> " quest_sig_" <> cName <> "_" <> name <> ";")
                            end
                        end
                    else ok
                end
            end
            if not(hasValues) then add(lines "/* (No values declared) */") end
            add(lines "")

            add(lines "#ifdef __cplusplus")
            add(lines "}")
            add(lines "#endif")
            add(lines "")
            add(lines "#endif /* " <> guard <> " */")
            add(lines "")
            syntax.linesText(lines)
        end

    let interfaceHeaderFile(qi: String): String =
        begin
            let base = paths.baseName(qi)
            paths.join(paths.parent(qi) stringOp.getSub(base 0 {stringOp.length(base) - 3}) <> ".int.h")
        end

    let headerIsCurrent(qi: String header: String): Bool =
        system.isFile(header) andif system.isFile(qi)
            andif real.greaterEq(system.modifiedTime(header) system.modifiedTime(qi))

    let writeText(file: String text: String): Ok =
        begin
            system.makeDirectory(paths.parent(file))
            let w = writer.file(file)
            writer.putString(w text)
            writer.close(w)
        end

    Let Artifacts = Tuple header: String qi: String end

    let rec writeInterfaceHeader(compiled: interfaceCompiler.CompiledInterface buildDir: maybe.T(String)
        programDir: maybe.T(String) res: graph.Resolver): String =
        begin
            if maybe.isSome(:String buildDir) then
                let buildRoot = paths.absolute(maybe.unwrap(:String buildDir))
                let roots = graph.rootsOf(compiled.includePaths programDir)
                for i = 0 upto {vector.length(:ast.ImportItem compiled.decl.imports) - 1} do
                    let imp = vector.get(:ast.ImportItem compiled.decl.imports i)
                    ensureResolvedInterfaceHeader(graph.resolveInterface(res
                        maybe.unwrapOr(:String imp.interfacePath imp.interfaceName)
                        maybe.some(:String paths.parent(compiled.source)) roots) buildRoot res)
                end
            end
            let header = interfaceHeaderFile(compiled.qiFile)
            let canonicalName =
                paths.canonicalizeInterfaceName(maybe.some(:String compiled.source) compiled.includePaths
                compiled.decl.name maybe.none(:String))
            writeText(header compileInterfaceToHeader(compiled.decl compiled.scope canonicalName))
            header
        end

    and ensureResolvedInterfaceHeader(resolved: graph.Resolved buildDir: String res: graph.Resolver): Artifacts =
        begin
            let programDir = resolved.roots.programDir
            let write = fun(c: interfaceCompiler.CompiledInterface): Ok
                begin
                    writeInterfaceHeader(c maybe.some(:String buildDir) programDir res)
                    ok
                end
            let artifacts = interfaceCompiler.ensureResolvedInterfaceArtifacts(resolved buildDir
                maybe.some(:interfaceCompiler.OnCompiled write) res)
            let header = interfaceHeaderFile(artifacts.qiFile)
            if maybe.isNone(:String artifacts.source) orif headerIsCurrent(artifacts.qiFile header) then
                tuple let header = header let qi = artifacts.qiFile end
            else
                (* A header that is missing or older than a fresh .qi is written
                 * from the interface elaborated again, leaving the .qi
                 * untouched, unless the .qi was found outside the build
                 * directory: then both are rebuilt there *)
                let inBuildDir =
                    stringOp.equal(paths.absolute(paths.parent(artifacts.qiFile)) paths.absolute(artifacts.targetDir))
                system.makeDirectory(artifacts.targetDir)
                let compiled = interfaceCompiler.compileInterfaceFile(maybe.unwrap(:String artifacts.source)
                    maybe.some(:String artifacts.targetDir) artifacts.searchPaths maybe.some(:String buildDir)
                        programDir
                    not(inBuildDir) maybe.none(:interfaceCompiler.OnCompiled) res)
                tuple
                    let header = writeInterfaceHeader(compiled maybe.some(:String buildDir) programDir res)
                    let qi = compiled.qiFile
                end
            end
        end

    let ensureImportedInterfaceHeader(name: String e: env.T): maybe.T(String) =
        begin
            let resolved = env.resolveInterface(e name)
            let root = loader.resolvedArtifactRoot(e resolved)
            if maybe.isNone(:String root) then maybe.none(:String)
            else maybe.some(:String
                ensureResolvedInterfaceHeader(resolved maybe.unwrap(:String root) e.units.resolver).header)
            end
        end

    let compileInterfaceWithHeader(file: String outputDir: maybe.T(String) includePaths: Array(String)
        buildDir: maybe.T(String) programDir: maybe.T(String)): Artifacts =
        begin
            let res = graph.newResolver()
            let write = fun(c: interfaceCompiler.CompiledInterface): Ok
                begin
                    writeInterfaceHeader(c buildDir programDir res)
                    ok
                end
            let compiled = interfaceCompiler.compileInterfaceFile(file outputDir includePaths buildDir programDir true
                maybe.some(:interfaceCompiler.OnCompiled write) res)
            tuple let header = interfaceHeaderFile(compiled.qiFile) let qi = compiled.qiFile end
        end
end
