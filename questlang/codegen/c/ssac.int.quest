(* Quest Self-Hosted Compiler: The SSA's C Printer Interface
 *
 * This interface prints a compilation unit's SSA IR (questlang/ssa) as C
 * (docs/arm64.md section 3.14). The emitted C serves as a reference oracle for
 * the SSA IR and for the native backends that lower it, much as MLton's C
 * backend prints its lowest IR. Each basic block becomes a label and each SSA
 * value becomes a local variable; a jump assigns the target block's parameters
 * before its goto; a stack slot is a local byte array; and memory accesses use
 * byte offsets. The printer chooses no data representation and computes no
 * layout: static data is emitted as word arrays, and external symbols are
 * declared directly (as byte arrays) so the
 * generated C needs no Quest runtime headers and calls each function through a
 * function pointer whose signature matches the call's arguments under AAPCS64
 * (the arm64 procedure call standard that specifies how arguments are passed
 * in registers and on the stack). *)

interface SSAC
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    (* Raised when a unit is malformed or uses a construct ssac cannot print *)
    unsupported: Exception(String)
    (* The C of a unit's SSA *)
    printUnit(u: ssa.Unit): String
    (* Extra C compiler flags required to compile ssac's output, in addition to
     * the C backend's flags. They enable GNU C (so function and object pointers
     * can be cast), disable strict type-based aliasing (since memory words are
     * accessed at multiple C types), disable built-in library declarations
     * (which would conflict with ssac's own extern declarations), and suppress
     * warnings about unused locals or parameters. *)
    cFlags: Array(String)
end
