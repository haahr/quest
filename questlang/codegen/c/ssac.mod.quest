(* Quest Self-Hosted Compiler: The SSA's C Printer Implementation *)

module ssac : Ssac
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/repr/syntax : questlang/repr/Syntax
    questlang/repr/runtimeLayout : questlang/repr/RuntimeLayout
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    collections/bitset : collections/Bitset
    util/hash : util/Hash
    util/maybe : util/Maybe
    sb = util/stringBuilder : util/StringBuilder
    stringOp = string : StringOp
    conv : Conv
export
    Let Function = ssa.Function
    Let Builder = sb.T

    let unsupported: Exception(String) = exception unsupported: String end
    let eq(a: String b: String): Bool = stringOp.equal(a b)
    let intEqual(a: Int b: Int): Bool = a is b
    let put(K::TYPE V::TYPE m: hashMap.T(K V) k: K v: V): Ok = begin hashMap.insert(m k v) ok end

    let cFlags = array of
        "-std=gnu11" "-Wno-pedantic" "-fno-strict-aliasing" "-fno-builtin" "-Wno-unused" "-Wno-unused-parameter"
        "-Wno-incompatible-library-redeclaration" "-Wno-builtin-requires-header"
    end

    (* =========================================================================
     * Values and literals
     * ====================================================================== *)

    let v(n: Int): String = "v" <> conv.int(n)
    let blockLabel(b: Int): String = "b" <> conv.int(b)

    let cType(t: ssa.Type): String =
        case t when typeInt, typeVal then "int64_t" when typePtr then "char *" when typeReal then "double" end
    let typeOf(f: Function n: Int): ssa.Type = ssa.typeOf(f n)

    (* An Int as C spells it: INT64_MIN has no literal *)
    let intLiteral(n: Int): String =
        if n < 0 then "(-INT64_C(" <> conv.int({0 - n} - 1) <> ") - 1)" else "INT64_C(" <> conv.int(n) <> ")" end

    (* An offset as C spells it (conv.int spells a negative one with ~) *)
    let decimal(n: Int): String = if n < 0 then "(" <> intLiteral(n) <> ")" else conv.int(n) end

    (* A value as a word (for a composite's half), and a word as a value of
     * type t *)
    let asWord(f: Function n: Int): String =
        case typeOf(f n)
            when typeInt, typeVal then "(uint64_t)" <> v(n)
            when typePtr then "(uint64_t)(uintptr_t)" <> v(n)
            when typeReal then "ssac_bits(" <> v(n) <> ")"
        end
    let fromWord(w: String t: ssa.Type): String =
        case t
            when typeInt, typeVal then "(int64_t)" <> w
            when typePtr then "(char *)(uintptr_t)" <> w
            when typeReal then "ssac_real(" <> w <> ")"
        end

    let contains(xs: Array(Int) x: Int): Bool =
        begin
            let var found = false
            for i = 0 upto {extent xs - 1} do if xs[i] is x then found := true end end
            found
        end

    (* =========================================================================
     * A function
     * ====================================================================== *)

    Let Printer = Tuple
        f: Function
        buf: Builder
        (* Whether the function contains a try block. Raising an exception
         * returns to the try's _setjmp a second time, and C leaves any
         * non-volatile local modified after the first return indeterminate.
         * Every memory access in such a function is therefore emitted as
         * volatile, since a stack slot written in the body may be read in the
         * handler. *)
        hasTry: Bool
        (* Which SSA values must be volatile locals for the _setjmp rule above:
         * those live (possibly read before redefinition) at the start of any
         * handler, as computed by handlerLive. Other values are never read
         * after a raise returns to _setjmp, so C may keep them in registers
         * and reuse their stack slots rather than reserving a separate stack
         * slot for every local in a large function. *)
        volatileValue: Array(Bool)
    end

    let line(p: Printer s: String): Ok = begin sb.strShared(p.buf "    " <> s <> "\n") ok end
    let text(buf: Builder s: String): Ok = begin sb.strShared(buf s) ok end
    let volatile(p: Printer): String = if p.hasTry then " volatile" else "" end

    (* An lvalue of C type t dereferenced at address plus offset *)
    let memory(p: Printer t: String address: Int offset: Int): String =
        "*(" <> t <> volatile(p) <> " *)(" <> v(address) <> " + " <> decimal(offset) <> ")"

    let symbolAddress(p: Printer symbol: String): String = "(char *)(void *)" <> symbol

    (* A composite passed through memory: a struct of its bytes *)
    let memoryType(bytes: Int): String = "QSsaMem" <> conv.int(bytes)

    (* The C return type for a call's result convention and result values vs *)
    let resultOf(results: Array(ssa.Passed) vs: Array(Int) f: Function): String =
        if extent results is 0 then "void"
        elsif extent results is 2 then "QSsaPair"
        else
            case results[0]
                when passByte then "uint8_t"
                when passInt32 then "int"
                when passWord, passReal, passPair, passPairRest, passMemory then cType(typeOf(f vs[0]))
            end
        end

    (* The C function-pointer type, formatted argument list (starting at index
     * first), and result value indices for a call instruction *)
    Let Call = Tuple fnType: String args: String results: Array(Int) end
    let callOf(p: Printer i: ssa.Inst first: Int): Call =
        begin
            let f = p.f
            let ps = i.signature.params
            let types = vector.new(:String)
            let exprs = vector.new(:String)
            let var k = first
            while k < extent i.args do
                let a = i.args[k]
                (* What C passes for the argument, and whether it takes the
                 * next one too *)
                let var t = cType(typeOf(f a))
                let var e = v(a)
                let var pair = false
                case ps[k]
                    when passPair then
                        t := "QSsaPair"
                        e := "(QSsaPair){ " <> asWord(f a) <> ", " <> asWord(f i.args[k + 1]) <> " }"
                        pair := true
                    when passMemory with x then
                        t := memoryType(x.bytes)
                        e := "*(" <> memoryType(x.bytes) <> " *)" <> v(a)
                    (* A bool or a char, which C passes as one byte *)
                    when passByte then
                        t := "uint8_t"
                        e := "(uint8_t)" <> v(a)
                    when passInt32 then
                        t := "int"
                        e := "(int)" <> v(a)
                    when passWord, passReal, passPairRest then ok
                end
                vector.append(types t)
                vector.append(exprs e)
                k := k + {if pair then 2 else 1 end}
            end
            let params = if vector.empty(types) then "void" else syntax.comma(types) end
            tuple
                let fnType = resultOf(i.signature.results i.results f) <> " (*)(" <> params <> ")"
                let args = syntax.comma(exprs) let results = i.results
            end
        end

    (* A call's expression *)
    let callExpr(p: Printer i: ssa.Inst): String =
        begin
            let direct = stringOp.length(i.symbol) > 0
            let c = callOf(p i if direct then 0 else 1 end)
            let callee = if direct then "(void *)" <> i.symbol else v(i.args[0]) end
            "((" <> c.fnType <> ")" <> callee <> ")(" <> c.args <> ")"
        end

    let rec instruction(p: Printer i: ssa.Inst): Ok =
        begin
            let f = p.f
            let a(k: Int): String = v(i.args[k])
            let set(rhs: String): Ok = line(p v(i.results[0]) <> " = " <> rhs <> ";")
            let binary(op: String): Ok = set(a(0) <> " " <> op <> " " <> a(1))
            case i.op
                when opAdd, opFadd then binary("+")
                when opSub, opFsub then binary("-")
                when opMul, opFmul then binary("*")
                when opDiv, opFdiv then binary("/")
                when opRem then binary("%")
                when opAnd then binary("&")
                when opOr then binary("|")
                when opXor then binary("^")
                when opAshr then binary(">>")
                when opEq, opPeq, opFeq then binary("==")
                when opNe, opPne then binary("!=")
                when opLt, opFlt then binary("<")
                when opLe, opFle then binary("<=")
                when opGt, opFgt then binary(">")
                when opGe, opFge then binary(">=")
                when opConst then set(intLiteral(i.imm))
                when opRealConst then set("ssac_real((uint64_t)" <> intLiteral(i.imm) <> ")")
                when opSymbol then
                    set(symbolAddress(p i.symbol) <> if i.imm is 0 then "" else " + " <> decimal(i.imm) end)
                when opNull then set("(char *)0")
                when opSlot then set("(char *)s" <> conv.int(i.imm))
                when opShl then set("(int64_t)((uint64_t)" <> a(0) <> " << " <> a(1) <> ")")
                when opLshr then set("(int64_t)((uint64_t)" <> a(0) <> " >> " <> a(1) <> ")")
                when opUlt then set("(uint64_t)" <> a(0) <> " < (uint64_t)" <> a(1))
                when opMulHiU then
                    set("(int64_t)(uint64_t)(((unsigned __int128)(uint64_t)" <> a(0) <> " * (uint64_t)" <> a(1)
                        <> ") >> 64)")
                when opIsNaN then set(a(0) <> " != " <> a(0))
                when opSelect then set(a(0) <> " ? " <> a(1) <> " : " <> a(2))
                when opIntToPtr then set("(char *)(uintptr_t)" <> a(0))
                when opPtrToInt then set("(int64_t)(uintptr_t)" <> a(0))
                when opRealBits then set("(int64_t)ssac_bits(" <> a(0) <> ")")
                when opBitsReal then set("ssac_real((uint64_t)" <> a(0) <> ")")
                when opSext8 then set("(int64_t)(int8_t)" <> a(0))
                when opZext8 then set("(int64_t)(uint8_t)" <> a(0))
                when opCopy then set(a(0))
                (* Normal compilation never reaches this case, because
                 * ssa/pipeline.lower runs before ssac and lowers every
                 * opUnproxy (unwrapping a QProxy forwarding wrapper) via
                 * ssa/passes/unproxies. The runtime's quest_unproxy helper is
                 * not declared in ssac's headerless C output. *)
                when opUnproxy then set("(char *)quest_unproxy(" <> a(0) <> ")")
                when opLoad then
                    let t = typeOf(f i.results[0])
                    set(if i.width is 8 then memory(p cType(t) i.args[0] i.imm)
                        elsif i.width is 4 then "(int64_t)" <> memory(p "int32_t" i.args[0] i.imm)
                        elsif i.signed then "(int64_t)" <> memory(p "int8_t" i.args[0] i.imm)
                        else "(int64_t)" <> memory(p "uint8_t" i.args[0] i.imm) end)
                when opStore then
                    let t = typeOf(f i.args[1])
                    line(p if i.width is 8 then memory(p cType(t) i.args[0] i.imm) <> " = " <> a(1) <> ";"
                        elsif i.width is 4 then memory(p "int32_t" i.args[0] i.imm) <> " = (int32_t)" <> a(1) <> ";"
                        else memory(p "uint8_t" i.args[0] i.imm) <> " = (uint8_t)" <> a(1) <> ";" end)
                when opCall, opCallIndirect then call(p i)
                when opThreadLocal then set("(char *)&" <> i.symbol)
                when opPtrAdd then set(a(0) <> " + " <> a(1))
                (* A QVal word is an int64_t *)
                when opToVal, opFromVal then
                    let pointer = case typeOf(f if ssa.isOp(i ssa.opToVal) then i.args[0] else i.results[0] end)
                        when typePtr then true when typeInt, typeReal, typeVal then false
                    end
                    set(if not(pointer) then a(0)
                        elsif ssa.isOp(i ssa.opToVal) then "(int64_t)(uintptr_t)" <> a(0)
                        else "(char *)(uintptr_t)" <> a(0) end)
            end
        end

    and call(p: Printer i: ssa.Inst): Ok =
        begin
            let e = callExpr(p i)
            if extent i.results is 0 then line(p e <> ";")
            elsif extent i.results is 1 then line(p v(i.results[0]) <> " = " <> e <> ";")
            else
                line(p "{ QSsaPair r = " <> e <> "; " <> v(i.results[0]) <> " = " <> fromWord("r.w0" typeOf(p.f i.results[0]))
                    <> "; " <> v(i.results[1]) <> " = " <> fromWord("r.w1" typeOf(p.f i.results[1])) <> "; }")
            end
        end

    (* A jump to t, assigning the target block's parameters in parallel via
     * temporaries so arguments that alias parameters are not clobbered *)
    let jumpText(p: Printer t: ssa.Target): String =
        begin
            let params = ssa.block(p.f t.block).params
            if extent t.args is 0 then "goto " <> blockLabel(t.block) <> ";"
            else
                let b = sb.new()
                sb.str(b "{ ")
                for k = 0 upto {extent t.args - 1} do
                    sb.strShared(b cType(typeOf(p.f t.args[k]))) sb.str(b " t") sb.int(b k) sb.str(b " = ")
                    sb.strShared(b v(t.args[k])) sb.str(b "; ")
                end
                for k = 0 upto {extent t.args - 1} do
                    sb.strShared(b v(vector.get(params k))) sb.str(b " = t") sb.int(b k) sb.str(b "; ")
                end
                sb.str(b "} goto ") sb.strShared(b blockLabel(t.block)) sb.str(b ";")
                sb.toString(b)
            end
        end

    (* A C return statement for vs, casting a single result to the signature's
     * C type and packing two results into a QSsaPair *)
    let returnText(p: Printer vs: Array(Int)): String =
        if extent vs is 0 then "return;"
        elsif extent vs is 1 then
            let cast = case p.f.signature.results[0]
                when passByte then "(uint8_t)"
                when passInt32 then "(int)"
                when passWord, passReal, passPair, passPairRest, passMemory then ""
            end
            "return " <> cast <> v(vs[0]) <> ";"
        else "return (QSsaPair){ " <> asWord(p.f vs[0]) <> ", " <> asWord(p.f vs[1]) <> " };"
        end

    let terminator(p: Printer t: ssa.Terminator): Ok =
        case t
            when termNone then raise unsupported with "ssac: a block without a terminator" end
            when termJump with x then line(p jumpText(p x.target))
            when termBranch with x then
                line(p "if (" <> v(x.cond) <> ") " <> jumpText(p x.ifTrue) <> " else " <> jumpText(p x.ifFalse))
            when termSwitch with x then
                line(p "switch (" <> v(x.value) <> ") {")
                for k = 0 upto {extent x.cases - 1} do
                    line(p "case " <> intLiteral(x.cases[k]) <> ": " <> jumpText(p x.targets[k]))
                end
                line(p "default: " <> jumpText(p x.default))
                line(p "}")
            when termReturn with x then line(p returnText(p x.values))
            when termTailCall with x then
                (* The call may return a pointer where this function returns
                 * a QVal word, or the reverse (docs/ssa.md section 2.2),
                 * which C converts only with a cast *)
                let e = callExpr(p x.call)
                let rs = vector.toArray(p.f.resultTypes)
                let cast = if {extent x.call.results is 1} andif {extent rs is 1}
                        andif not(eq(cType(typeOf(p.f x.call.results[0])) cType(rs[0]))) then
                    "(" <> cType(rs[0]) <> ")"
                else "" end
                line(p if extent x.call.results is 0 then e <> "; return;" else "return " <> cast <> e <> ";" end)
            (* The try's handler record lives in its stack slot. On entry,
             * _setjmp saves the registers there and returns 0 so the body runs.
             * A raise jumps back via longjmp, making _setjmp return nonzero so
             * control transfers to the handler. *)
            when termTry with x then
                line(p "if (_setjmp((int *)(void *)(s" <> conv.int(x.slot) <> " + "
                    <> conv.int(runtimeLayout.offset("QExceptionHandler" "env_jmp")) <> ")) == 0) " <> jumpText(p x.body))
                line(p "goto " <> blockLabel(x.handler) <> ";")
            when termUnreachable then line(p "__builtin_unreachable();")
        end

    (* The C type a function returns, and its parameters' declarations *)
    let resultType(f: Function): String =
        begin
            let rs = vector.toArray(f.resultTypes)
            if extent rs is 1 then
                case f.signature.results[0]
                    when passByte then "uint8_t"
                    when passInt32 then "int"
                    when passWord, passReal, passPair, passPairRest, passMemory then cType(rs[0])
                end
            elsif extent rs is 0 then "void"
            else "QSsaPair" end
        end

    (* The C declaration for parameter k of f, along with any entry statements
     * needed to unpack it into SSA locals (splitting a QSsaPair into two
     * values, widening a C int to int64_t, or taking the address of a struct
     * passed by value). C requires main's second parameter to be char **. *)
    Let Param = Tuple decl: String entry: Array(String) words: Int end
    let param(f: Function k: Int named: Bool): Param =
        begin
            let params = ssa.block(f 0).params
            let n = vector.get(params k)
            let pk = "p" <> conv.int(k)
            let declared(t: String name: String): String = t <> if named then " " <> name else "" end
            let direct = fun(t: String): Param
                tuple let decl = declared(t v(n)) let entry = array of :String end let words = 1 end
            case f.signature.params[k]
                when passPair then
                    let second = vector.get(params k + 1)
                    tuple
                        let decl = declared("QSsaPair" pk)
                        let entry = array of
                            cType(typeOf(f n)) <> " " <> v(n) <> " = " <> fromWord(pk <> ".w0" typeOf(f n)) <> ";"
                            cType(typeOf(f second)) <> " " <> v(second) <> " = " <> fromWord(pk
                                <> ".w1" typeOf(f second)) <> ";"
                        end
                        let words = 2
                    end
                when passByte then direct("uint8_t")
                when passInt32 then
                    tuple let decl = declared("int" pk) let entry = array of "int64_t " <> v(n) <> " = " <> pk
                        <> ";" end let words = 1 end
                when passMemory with x then
                    tuple
                        let decl = declared(memoryType(x.bytes) pk)
                        let entry = array of "char *" <> v(n) <> " = (char *)&" <> pk <> ";" end
                        let words = 1
                    end
                when passWord, passReal, passPairRest then
                    if eq(f.symbol "main") andif {k is 1} then
                        tuple let decl = declared("char **" pk) let entry = array of "char *" <> v(n) <> " = (char *)"
                            <> pk <> ";" end
                            let words = 1 end
                    else direct(cType(typeOf(f n))) end
            end
        end

    let paramsText(f: Function named: Bool): String =
        begin
            let decls = vector.new(:String)
            let var k = 0
            while k < vector.length(ssa.block(f 0).params) do
                let pm = param(f k named)
                vector.append(decls pm.decl)
                k := k + pm.words
            end
            if vector.empty(decls) then "void" else syntax.comma(decls) end
        end

    let linkage(f: Function): String = if f.exported then "" else "static " end
    let prototype(f: Function named: Bool): String =
        linkage(f) <> resultType(f) <> " " <> f.symbol <> "(" <> paramsText(f named) <> ")"

    (* A boolean array marking every SSA value that is live (possibly read
     * before redefinition) at the start of some exception handler in f. Because
     * every path from a handler stays within the blocks reachable from
     * handlers, liveness is computed over those blocks alone by iterating each
     * block's live-in set to a fixed point. *)
    let handlerLive(f: Function): Array(Bool) =
        begin
            let n = vector.length(f.blocks)
            let nv = vector.length(f.types)
            let result = array of(nv false)
            let reached = array of(n false)
            let handlers = vector.new(:Int)
            let work = vector.new(:Int)
            for b = 0 upto {n - 1} do
                case ssa.block(f b).term
                    when termTry with x then
                        vector.append(handlers x.handler)
                        if not(reached[x.handler]) then
                            reached[x.handler] := true
                            vector.append(work x.handler)
                        end
                    when termNone, termJump, termBranch, termSwitch, termReturn, termTailCall, termUnreachable then ok
                end
            end
            while not(vector.empty(work)) do
                let succs = ssa.successors(ssa.block(f vector.pop(work)).term)
                for i = 0 upto {extent succs - 1} do
                    if not(reached[succs[i]]) then
                        reached[succs[i]] := true
                        vector.append(work succs[i])
                    end
                end
            end
            let liveIn = array of(n bitset.new(0))
            for b = 0 upto {n - 1} do if reached[b] then liveIn[b] := bitset.new(nv) end end
            let var changed = true
            while changed do
                changed := false
                for k = 0 upto {n - 1} do
                    let b = {n - 1} - k
                    if reached[b] then
                        let blk = ssa.block(f b)
                        let live = bitset.new(nv)
                        let succs = ssa.successors(blk.term)
                        for i = 0 upto {extent succs - 1} do bitset.unionWith(live liveIn[succs[i]]) end
                        let uses = ssa.terminatorUses(blk.term)
                        for i = 0 upto {extent uses - 1} do bitset.insert(live uses[i]) end
                        for j = 0 upto {vector.length(blk.insts) - 1} do
                            let inst = vector.get(blk.insts {vector.length(blk.insts) - 1} - j)
                            for i = 0 upto {extent inst.results - 1} do bitset.remove(live inst.results[i]) end
                            for i = 0 upto {extent inst.args - 1} do bitset.insert(live inst.args[i]) end
                        end
                        for i = 0 upto {vector.length(blk.params) - 1} do bitset.remove(live vector.get(blk.params i)) end
                        if not(bitset.equal(live liveIn[b])) then
                            bitset.assign(liveIn[b] live)
                            changed := true
                        end
                    end
                end
            end
            for i = 0 upto {vector.length(handlers) - 1} do
                let live = bitset.elements(liveIn[vector.get(handlers i)])
                for j = 0 upto {extent live - 1} do result[live[j]] := true end
            end
            result
        end

    (* Writes the C definition of f into buf: its prototype, parameter-unpacking
     * statements, local declarations for all other SSA values, aligned byte
     * arrays for stack slots, and each block as a label followed by its
     * instructions and terminator *)
    let function(buf: Builder f: Function): Ok =
        begin
            let var hasTry = false
            for b = 0 upto {vector.length(f.blocks) - 1} do
                case ssa.block(f b).term
                    when termTry then hasTry := true
                    when termNone, termJump, termBranch, termSwitch, termReturn, termTailCall, termUnreachable then ok
                end
            end
            let volatileValue = if hasTry then handlerLive(f) else array of :Bool end end
            let p = tuple let f = f let buf = buf let hasTry = hasTry let volatileValue = volatileValue end
            text(buf prototype(f true) <> " {\n")
            let params = ssa.block(f 0).params
            let isParam = array of(vector.length(f.types) false)
            for k = 0 upto {vector.length(params) - 1} do isParam[vector.get(params k)] := true end
            let var k = 0
            while k < vector.length(params) do
                let pm = param(f k true)
                for j = 0 upto {extent pm.entry - 1} do line(p pm.entry[j]) end
                k := k + pm.words
            end
            for n = 0 upto {vector.length(f.types) - 1} do
                if not(isParam[n]) then
                    let t = typeOf(f n)
                    let isVolatile = p.hasTry andif p.volatileValue[n]
                    let decl = case t when typePtr then if isVolatile then "char * volatile " else "char * " end
                        else if isVolatile then "volatile " else "" end <> cType(t) <> " " end
                    line(p decl <> v(n) <> ";")
                end
            end
            for s = 0 upto {vector.length(f.slots) - 1} do
                let slot = vector.get(f.slots s)
                line(p "unsigned char s" <> conv.int(s) <> "[" <> conv.int(if slot.bytes > 0 then slot.bytes else 1 end)
                    <> "] __attribute__((aligned(" <> conv.int(if slot.align > 8 then slot.align else 8 end) <> ")));")
            end
            for b = 0 upto {vector.length(f.blocks) - 1} do
                let blk = ssa.block(f b)
                text(buf blockLabel(b) <> ":;\n")
                for k = 0 upto {vector.length(blk.insts) - 1} do instruction(p vector.get(blk.insts k)) end
                terminator(p blk.term)
            end
            text(buf "}\n\n")
        end

    (* =========================================================================
     * Data and the unit
     * ====================================================================== *)

    let wordText(w: ssa.Word threadLocals: hashMap.T(String Bool)): String =
        case w
            when wordInt with x then "(void *)(uintptr_t)" <> intLiteral(x.n)
            when wordSymbol with x then
                (* A thread-local's address is not a constant *)
                if hashMap.contains(threadLocals x.symbol) then
                    raise unsupported with "ssac: static data holding a thread-local's address, " <> x.symbol end
                end
                "(void *)((char *)(void *)" <> x.symbol <> " + " <> decimal(x.addend) <> ")"
        end

    (* A datum's C declaration, without its contents *)
    let dataDeclaration(d: ssa.Data): String =
        begin
            let linkageText = if d.exported then "" else "static " end
            case d.contents
                when contentsZero with x then
                    linkageText <> "uint64_t " <> d.symbol <> "[" <> conv.int({x.bytes + 7} / 8) <> "]"
                when contentsText with x then
                    linkageText <> if d.writable then "char " else "const char " end <> d.symbol <> "["
                        <> conv.int(stringOp.length(x.text) + 1) <> "]"
                when contentsWords with x then
                    linkageText <> if d.writable then "void *" else "void *const " end <> d.symbol <> "["
                        <> conv.int(if extent x.words > 0 then extent x.words else 1 end) <> "]"
            end
        end

    let dataDefinition(d: ssa.Data threadLocals: hashMap.T(String Bool)): String =
        case d.contents
            when contentsZero then dataDeclaration(d) <> ";"
            when contentsText with x then dataDeclaration(d) <> " = " <> syntax.cString(x.text) <> ";"
            when contentsWords with x then
                let ws = vector.new(:String)
                for k = 0 upto {extent x.words - 1} do vector.append(ws wordText(x.words[k] threadLocals)) end
                if extent x.words is 0 then vector.append(ws "0") end
                dataDeclaration(d) <> " = { " <> syntax.comma(ws) <> " };"
        end

    (* The printer first collects all external symbols referenced by u. The
     * emitted C file then contains, in order: supporting types and helper
     * functions, extern declarations for those symbols, forward declarations
     * for the unit's data and functions (so any definition may refer to any
     * other), data definitions, and function definitions. *)
    let printUnit(u: ssa.Unit): String =
        begin
            let buf = sb.new()
            let defined = hashMap.new(:String :Bool eq hash.string)
            (* The thread-locals the unit's code takes the addresses of *)
            let threadLocals = hashMap.new(:String :Bool eq hash.string)
            for k = 0 upto {vector.length(u.functions) - 1} do
                put(defined vector.get(u.functions k).symbol true)
            end
            for k = 0 upto {vector.length(u.data) - 1} do put(defined vector.get(u.data k).symbol true) end
            (* The symbols the unit refers to but does not define, in order *)
            let externs = vector.new(:String)
            let seen = hashMap.new(:String :Bool eq hash.string)
            let refer(symbol: String): Ok =
                if {stringOp.length(symbol) > 0} andif not(hashMap.contains(defined symbol))
                    andif not(hashMap.contains(seen symbol)) then
                    put(seen symbol true)
                    vector.append(externs symbol)
                end
            (* The sizes of the composites passed through memory *)
            let memorySizes = hashMap.new(:Int :Bool intEqual hash.int)
            let referInst(f: Function i: ssa.Inst): Ok =
                begin
                    if ssa.isOp(i ssa.opSymbol) orif ssa.isOp(i ssa.opCall) then refer(i.symbol) end
                    if ssa.isOp(i ssa.opThreadLocal) then
                        put(threadLocals i.symbol true)
                        refer(i.symbol)
                    end
                    for k = 0 upto {extent i.signature.params - 1} do
                        case i.signature.params[k]
                            when passMemory with x then put(memorySizes x.bytes true)
                            when passWord, passReal, passPair, passPairRest, passByte, passInt32 then ok
                        end
                    end
                end
            for k = 0 upto {vector.length(u.functions) - 1} do
                let f = vector.get(u.functions k)
                for b = 0 upto {vector.length(f.blocks) - 1} do
                    let blk = ssa.block(f b)
                    for j = 0 upto {vector.length(blk.insts) - 1} do referInst(f vector.get(blk.insts j)) end
                    case blk.term
                        when termTailCall with x then referInst(f x.call)
                        when termNone, termJump, termBranch, termSwitch, termReturn, termTry, termUnreachable then ok
                    end
                end
            end
            for k = 0 upto {vector.length(u.data) - 1} do
                case vector.get(u.data k).contents
                    when contentsWords with x then
                        for j = 0 upto {extent x.words - 1} do
                            case x.words[j] when wordSymbol with w then refer(w.symbol) else ok end
                        end
                    else ok
                end
            end

            sb.str(buf "/* Emitted by the Quest SSA's C printer (ssac) */\n")
            sb.str(buf "#include <stdint.h>\n\n")
            sb.str(buf "typedef struct { uint64_t w0, w1; } QSsaPair;\n")
            let sizes = hashMap.keys(memorySizes)
            for k = 0 upto {vector.length(sizes) - 1} do
                let n = vector.get(sizes k)
                sb.str(buf "typedef struct { unsigned char b[" <> conv.int(n) <> "]; } " <> memoryType(n) <> ";\n")
            end
            sb.str(buf
                "static inline double ssac_real(uint64_t b) { double d; __builtin_memcpy(&d, &b, 8); return d; }\n")
            sb.str(buf
                "static inline uint64_t ssac_bits(double d) { uint64_t b; __builtin_memcpy(&b, &d, 8); return b; }\n")
            sb.str(buf "extern int _setjmp(int *) __attribute__((returns_twice));\n\n")
            (* Only an extern's address is used, so its declared size is
             * arbitrary *)
            for k = 0 upto {vector.length(externs) - 1} do
                let symbol = vector.get(externs k)
                sb.str(buf
                    if hashMap.contains(threadLocals symbol) then
                        "extern __thread uint64_t " <> symbol <> "[8];\n"
                    else "extern char " <> symbol <> "[];\n" end)
            end
            sb.str(buf "\n")
            for k = 0 upto {vector.length(u.data) - 1} do
                sb.str(buf dataDeclaration(vector.get(u.data k)) <> ";\n")
            end
            for k = 0 upto {vector.length(u.functions) - 1} do
                sb.str(buf prototype(vector.get(u.functions k) false) <> ";\n")
            end
            sb.str(buf "\n")
            for k = 0 upto {vector.length(u.data) - 1} do
                sb.str(buf dataDefinition(vector.get(u.data k) threadLocals) <> "\n")
            end
            sb.str(buf "\n")
            for k = 0 upto {vector.length(u.functions) - 1} do function(buf vector.get(u.functions
                k)) end
            sb.toString(buf)
        end
end
