(* Quest Self-Hosted Compiler: C Spellings Implementation *)

module types : Types
import
    questlang/types/model : questlang/types/Model
    questlang/ir/shapes : questlang/ir/Shapes
    questlang/codegen/syntax : questlang/codegen/Syntax
    questlang/codegen/layout : questlang/codegen/Layout
    questlang/codegen/staticdata : questlang/codegen/StaticData
    collections/vector : collections/Vector
    stringOp = string : StringOp
export
    Let Type = model.Type
    Let Shape = shapes.Shape

    let eq(a: String b: String): Bool = stringOp.equal(a b)
    let isOneOf(s: String items: Array(String)): Bool =
        begin
            let var found = false
            for i = 0 upto {extent items - 1} do if eq(s items[i]) then found := true end end
            found
        end

    let cExpr(f: staticdata.DescriptorForm): String = staticdata.cExpr(f)

    (* =========================================================================
     * Values in C
     * ====================================================================== *)

    let qtypeToCType(t: Type): String = layout.representation(t)

    (* The C of a value's QVal word, and of the value of a word, by the
     * value's word form (layout.wordForm) *)
    let shapeQvalWrap(e: String s: Shape): String =
        case layout.wordForm(s)
            when wordItself then e
            when wordOk then "Q_OK_VAL"
            when wordRecordBox then "((QVal){ .p = (void *)quest_record_box(" <> e <> ") })"
            when wordVariantBox then "((QVal){ .p = (void *)quest_variant_box(" <> e <> ") })"
            when wordBits then "((QVal){ .u = (uint64_t)(" <> e <> ") })"
            when wordInteger then "((QVal){ .i = (int64_t)(" <> e <> ") })"
            when wordReal then "((QVal){ .r = (double)(" <> e <> ") })"
            when wordPointer then "((QVal){ .p = (void *)(" <> e <> ") })"
        end

    let qvalWrap(e: String t: Type): String = shapeQvalWrap(e shapes.shape(t))

    let shapeQvalUnwrap(e: String s: Shape): String =
        case layout.wordForm(s)
            when wordItself then e
            when wordOk then "((void)0)"
            when wordRecordBox then "(*((QRecordVal *)(" <> e <> ".p)))"
            when wordVariantBox then "(*((QVariantVal *)(" <> e <> ".p)))"
            when wordBits then "(" <> e <> ".u)"
            when wordInteger then "(" <> e <> ".i)"
            when wordReal then "(" <> e <> ".r)"
            when wordPointer then "((" <> layout.shapeRepresentation(layout.resolvedShape(s)) <> ")(" <> e <> ".p))"
        end

    let qvalUnwrap(e: String t: Type): String = shapeQvalUnwrap(e shapes.shape(t))

    let shapeSlotLoad(e: String s: Shape): String = if layout.isBoxedInSlots(s) then "(*(" <> e <> "))" else e end

    let shapeSlotStore(e: String s: Shape): String =
        if layout.isBoxedInSlots(s) then
            let box = if eq(layout.shapeRepresentation(s) "QRecordVal") then "quest_record_box"
                else "quest_variant_box"
            end
            box <> "(" <> e <> ")"
        else
            e
        end

    let shapeSlotToQval(e: String s: Shape): String =
        if eq(layout.shapeSlotRepresentation(s) "QVal") then e
        elsif layout.isBoxedInSlots(s) then "((QVal){ .p = (void *)(" <> e <> ") })"
        else shapeQvalWrap(e s)
        end

    let shapeQvalToSlot(e: String s: Shape): String =
        begin
            let slot = layout.shapeSlotRepresentation(s)
            if eq(slot "QVal") then e
            elsif layout.isBoxedInSlots(s) then "((" <> slot <> ")(" <> e <> ".p))"
            else shapeQvalUnwrap(e s)
            end
        end

    let closureFnPtrType(t: Type): String =
        begin
            let var s = shapes.shape(t)
            let params = vector.new(:String)
            vector.append(:String params "void *")
            while eq(s.kind "all") do
                (* Quantifier descriptors appear immediately after env *)
                for i = 0 upto {extent s.typeParams - 1} do vector.append(:String params "const QTypeDescriptor *") end
                s := shapes.body(s)
            end
            if not(eq(s.kind "fun")) then
                layout.shapeRepresentation(s) <> " (*)(" <> syntax.comma(params) <> ")"
            else
                for i = 0 upto {extent s.params - 1} do
                    let p = s.params[i]
                    if not(eq(p.mode "value")) then
                        vector.append(:String params layout.shapeLocationRepresentation(p.shape) <> " *")
                    elsif eq(p.shape.kind "ok") then
                        vector.append(:String params "QVal")
                    else
                        vector.append(:String params layout.shapeRepresentation(p.shape))
                    end
                end
                layout.shapeRepresentation(shapes.result(s)) <> " (*)(" <> syntax.comma(params) <> ")"
            end
        end
end
