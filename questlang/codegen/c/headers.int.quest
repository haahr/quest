(* Quest Self-Hosted Compiler: Interface Headers Interface
 *
 * A Quest interface's C header (.int.h) declares its aggregate structs,
 * typedefs for its types' C representations, and signatures for its exported
 * members so generated C code that uses the interface can include it
 * (matching bootstrap/python/quest/codegen/c/headers.py). The compiler writes
 * each header beside the interface's compiled .qi file when C compilation
 * needs it, and treats it as up to date when it is at least as new as the .qi
 * file (docs/build-process.md section 5). *)

interface Headers
import
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/types/symbols : questlang/types/Symbols
export
    (* The C header text for an interface, with its include guard and typedef
     * names derived from canonicalName (the interface's include-relative path,
     * such as util/Math) *)
    compileInterfaceToHeader(decl: ast.InterfaceDecl scope: symbols.Scope canonicalName: String): String
end
