(* Quest Self-Hosted Compiler: Interface Headers Interface
 *
 * bootstrap/python/quest/codegen/c/headers.py: the C headers of interfaces
 * (.int.h): for each interface, its aggregate structs, its types' C
 * representations, and its members' signatures, which C that uses the
 * interface includes. A header is written beside its interface's .qi, from the
 * interface as compiled, when C compilation needs it, and is up to date when
 * it is at least as new as its .qi (docs/build-process.md section 5). *)

interface Headers
import
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/types/symbols : questlang/types/Symbols
    questlang/types/env : questlang/types/Env
    questlang/modules/graph : questlang/modules/Graph
    questlang/modules/artifacts/interfaceCompiler : questlang/modules/artifacts/InterfaceCompiler
    util/maybe : util/Maybe
export
    (* The C header of an interface, its include guard and typedef names
     * derived from canonicalName, its include-relative path (util/Math) *)
    compileInterfaceToHeader(decl: ast.InterfaceDecl scope: symbols.Scope canonicalName: String): String
end
