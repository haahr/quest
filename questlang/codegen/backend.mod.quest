(* Quest Self-Hosted Compiler: The Backends' Entry Points Implementation
 *
 * The wasm backend is implemented directly here, while the native backends
 * (c, ssac, and arm64) are delegated to codegen/native so that a driver
 * compiled to WebAssembly can omit them. *)

module backend : Backend
import
    ascii : Ascii
    conv : Conv
    stringOp = string : StringOp
    word : Word

    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe

    questlang/codegen/choice : questlang/codegen/Choice
    questlang/codegen/native : questlang/codegen/Native
    questlang/common/location : questlang/common/Location
    questlang/ir/lower : questlang/ir/Lower
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/opened : questlang/ir/Opened
    passes = questlang/ir/pipeline : questlang/ir/Pipeline
    questlang/repr/symbols : questlang/repr/Symbols
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
    wasm = questlang/wasm/codegen : questlang/wasm/Codegen
    questlang/wasm/encode : questlang/wasm/Encode
    questlang/wasm/model : questlang/wasm/Model
    wasmPrinter = questlang/wasm/printer : questlang/wasm/Printer
    wasmRuntime = questlang/wasm/runtime : questlang/wasm/Runtime
export
    let unsupported: Exception(String) = exception unsupported: String end

    (* A unit's WebAssembly module (docs/wasm.md section 5.1) *)
    let wasmModule(unit: nodes.Unit): model.Module =
        try wasm.unitModule(unit)
        when wasm.unsupported with m then raise unsupported with "wasm: unsupported: " <> m end
        when model.malformed with m then raise unsupported with "wasm: malformed: " <> m end
        end

    let wasmText(unit: nodes.Unit): String = wasmPrinter.print(wasmModule(unit))

    (* Computes and caches the stamp of the WebAssembly runtime that wasm units
     * are built against: a hash of the encoded runtime module, which changes
     * whenever its types or functions change. Each compiled wasm object embeds
     * this stamp in a quest.runtime custom section so the build can treat an
     * object with a different stamp as stale instead of failing at
     * instantiation time (docs/wasm.md section 5.3). *)
    let stamps = tuple let var made = "" end
    let runtimeStamp(): String =
        begin
            if stringOp.isEmpty(stamps.made) then
                stamps.made := conv.int(word.toInt(hash.string(encode.encode(wasmRuntime.runtimeModule()))))
            end
            stamps.made
        end

    (* Decodes an unsigned LEB128 variable-length integer in bytes starting at
     * offset at, returning its value and the index immediately after it *)
    Def Leb = Tuple value: Int next: Int end
    let leb(bytes: String at: Int): Leb =
        begin
            let n = stringOp.length(bytes)
            let var i = at
            let var v = 0
            let var shift = 1
            let var going = true
            while going andif {i < n} do
                let b = ascii.val(stringOp.getChar(bytes i))
                i := i + 1
                v := v + {{b % 128} * shift}
                shift := shift * 128
                going := b >= 128
            end
            tuple let value = v let next = i end
        end

    (* The quest.runtime section of a wasm object's bytes, or "" *)
    let objectRuntimeStamp(bytes: String): String =
        begin
            let n = stringOp.length(bytes)
            let var at = 8
            let var found = ""
            while {at < n} andif stringOp.isEmpty(found) do
                let id = ascii.val(stringOp.getChar(bytes at))
                let size = leb(bytes at + 1)
                let sectionEnd = size.next + size.value
                if id is 0 then
                    let length = leb(bytes size.next)
                    let named = length.next + length.value
                    if {named <= sectionEnd} andif {sectionEnd <= n}
                            andif stringOp.equal(stringOp.getSub(bytes length.next length.value) "quest.runtime") then
                        found := stringOp.getSub(bytes named sectionEnd - named)
                    end
                end
                at := sectionEnd
            end
            found
        end

    (* Compiles unit for backend, optionally attaching an exported datum (a
     * symbol name and string payload, embedded as a C string or a WebAssembly
     * custom section). Any backend failure is re-raised as unsupported so
     * callers handle one exception type. *)
    let unitWithDatum(unit: nodes.Unit interfaceHeader: maybe.T(String) backend: String
            datum: maybe.T(native.Datum)): String =
        if choice.isWasm(backend) then
            (* Append the runtime stamp and, for module units, the interface
             * fingerprint in custom sections so a host JIT can check
             * compatibility (docs/wasm.md section 5.3) *)
            encode.encode(wasmModule(unit)) <> encode.customSection("quest.runtime" runtimeStamp())
                <> if maybe.isSome(datum) then
                    encode.customSection("quest.fingerprint" maybe.unwrap(datum).text)
                else
                    ""
                end
        else
            (* Delegate to the native backends (codegen/native), which a driver
             * compiled to WebAssembly omits *)
            try native.unitCode(unit interfaceHeader backend datum)
            when native.unsupported with m then raise unsupported with m end
            end
        end

    let codeOfUnit(unit: nodes.Unit interfaceHeader: maybe.T(String) backend: String): String =
        unitWithDatum(unit interfaceHeader backend maybe.none())

    let cFlags(backend: String): Array(String) = native.cFlags(backend)

    let codeOfProgram(program: typedAst.Program e: env.T sourceMap: maybe.T(location.SourceMap) echo: Bool printResult:
            Bool backend: String)
            : Tuple code: String unit: nodes.Unit end =
        begin
            (* A separately compiled unit, with copies of the inlined modules
             * it imports (ir/opened) *)
            let lowered = opened.openImports(lower.lowerProgram(program e sourceMap echo printResult) e)
            let unit = passes.runPasses(lowered choice.referencesAlike(backend))
            tuple let code = codeOfUnit(unit maybe.none() backend) let unit = unit end
        end

    let codeOfModuleFile(m: typedAst.Binding e: env.T sourceMap: maybe.T(location.SourceMap)
            interfaceHeader: maybe.T(String) backend: String fingerprint: String): String =
        begin
            let unit = opened.openImports(lower.lowerModuleFile(m e sourceMap 0) e)
            (* The unit's module is the one that exports *)
            let var symbol = ""
            for i = 0 upto {vector.length(unit.modules) - 1} do
                let md = vector.get(unit.modules i)
                if maybe.isSome(md.exports) then
                    symbol := symbols.fingerprintIdent(symbols.mangleModuleName(md.name))
                end
            end
            unitWithDatum(passes.runPasses(unit choice.referencesAlike(backend)) interfaceHeader backend
                    maybe.some(tuple let symbol = symbol let text = fingerprint end))
        end
end
