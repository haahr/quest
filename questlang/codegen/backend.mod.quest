(* Quest Self-Hosted Compiler: The Backends' Entry Points Implementation: the
 * wasm backend's here, the native ones' through codegen/native *)

module backend : Backend
import
    questlang/common/location : questlang/common/Location
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/lower : questlang/ir/Lower
    questlang/ir/verify : questlang/ir/Verify
    passes = questlang/ir/pipeline : questlang/ir/Pipeline
    questlang/repr/symbols : questlang/repr/Symbols
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/codegen/native : questlang/codegen/Native
    wasm = questlang/wasm/codegen : questlang/wasm/Codegen
    questlang/wasm/encode : questlang/wasm/Encode
    wasmPrinter = questlang/wasm/printer : questlang/wasm/Printer
    questlang/wasm/model : questlang/wasm/Model
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    stringOp = string : StringOp
export
    let unsupported: Exception(String) = exception unsupported: String end

    (* A unit's WebAssembly module (docs/wasm-plan.md section 5.1) *)
    let wasmModule(unit: nodes.Unit): model.Module =
        try wasm.unitModule(unit)
            when wasm.unsupported with m then raise unsupported with "wasm: unsupported: " <> m end
            when model.malformed with m then raise unsupported with "wasm: malformed: " <> m end
        end

    let wasmText(unit: nodes.Unit): String = wasmPrinter.print(wasmModule(unit))

    (* A unit's C with a datum of its own, exported: a symbol and the C
     * string it names. A backend's failure is raised as unsupported, so that
     * callers handle one exception whatever the backend. *)
    let unitWithDatum(unit: nodes.Unit interfaceHeader: maybe.T(String) backend: String
        datum: maybe.T(Tuple symbol: String text: String end)): String =
        if stringOp.equal(backend "wasm") then
            (* A module unit's fingerprint, for a host's JIT to compare
             * (docs/wasm-plan.md step 13), in a custom section *)
            Let Datum = Tuple symbol: String text: String end
            encode.encode(wasmModule(unit)) <> if maybe.isSome(:Datum datum) then
                encode.customSection("quest.fingerprint" maybe.unwrap(:Datum datum).text)
            else "" end
        else
            (* the native backends' (codegen/native), which a driver compiled
             * to WebAssembly leaves out *)
            try native.unitCode(unit interfaceHeader backend datum)
                when native.unsupported with m then raise unsupported with m end
            end
        end

    let unitToC(unit: nodes.Unit interfaceHeader: maybe.T(String) backend: String): String =
        unitWithDatum(unit interfaceHeader backend maybe.none(:Tuple symbol: String text: String end))

    let cFlags(backend: String): Array(String) = native.cFlags(backend)

    let programToC(program: typedAst.Program e: env.T sourceMap: maybe.T(location.SourceMap) echo: Bool printResult:
        Bool backend: String)
        : Tuple c: String unit: nodes.Unit end =
        begin
            let lowered = lower.lowerProgram(program e sourceMap echo printResult)
            if verify.irChecksEnabled() then verify.checkUnit(lowered) end
            shapes.setReferencesAlike(stringOp.equal(backend "wasm"))
            let unit = passes.runPasses(lowered)
            tuple let c = unitToC(unit maybe.none(:String) backend) let unit = unit end
        end

    let moduleFileToC(m: typedAst.Binding e: env.T sourceMap: maybe.T(location.SourceMap)
        interfaceHeader: maybe.T(String) backend: String fingerprint: String): String =
        begin
            let unit = lower.lowerModuleFile(m e sourceMap 0)
            if verify.irChecksEnabled() then verify.checkUnit(unit) end
            (* The unit's module is the one that exports *)
            let var symbol = ""
            for i = 0 upto {vector.length(:nodes.Module unit.modules) - 1} do
                let md = vector.get(:nodes.Module unit.modules i)
                if maybe.isSome(:nodes.Members md.exports) then
                    symbol := symbols.fingerprintIdent(symbols.mangleModuleName(md.name))
                end
            end
            shapes.setReferencesAlike(stringOp.equal(backend "wasm"))
            unitWithDatum(passes.runPasses(unit) interfaceHeader backend
                maybe.some(:Tuple symbol: String text: String end tuple let symbol = symbol let text = fingerprint end))
        end
end
