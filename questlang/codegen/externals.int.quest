(* Quest Self-Hosted Compiler: The Standard Library's Externals Interface
 *
 * The standard library's members that its modules define as external C
 * functions, and its external types, built into the compiler from lib/
 * (tools/externals writes the module; docs/c-representation.md section 6.2).
 * Each function is a module's path in lib/ (word, collections/vector), a
 * member's name, and its C symbol. A call of such a function from an importer
 * compiles to a call of the C function itself, and importers see such a type
 * as its C type; both only for imports that resolve to lib/'s modules. *)

interface Externals export
    (* The external functions, monomorphic, of value parameters only, and of
     * scalar and external types *)
    functions: Array(Array(String))
    (* The external types (Let T = external "uint64_t"), each a module's path,
     * the type's name, its global name (process.T: its module's declared name
     * and its own), and its C type *)
    types: Array(Array(String))
end
