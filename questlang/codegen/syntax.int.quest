(* Quest Self-Hosted Compiler: C Syntax Interface
 *
 * bootstrap/python/quest/codegen/syntax.py: the spelling of C text, literals and the forms the C backend repeats.
 * Every piece of C is a string built from these and from strings: a number goes through cInt or cIntLiteral (conv.int
 * writes negative numbers with ~), and lists of C are joined only here. *)

interface Syntax
import
    collections/vector : collections/Vector
export
    (* A nonnegative integer in decimal: an index, a count, or a number in a name *)
    cInt(n: Int): String
    (* An int64_t constant: 5LL, or (-5LL) for a negative one *)
    cIntLiteral(n: Int): String
    (* A double constant: Python's repr of it, with .0 appended when it would read as an integer; an infinity is
     * INFINITY or (-INFINITY) *)
    cReal(r: Real): String
    (* A C string literal of s, and a C character literal of c *)
    cString(s: String): String
    cChar(c: Char): String
    (* A C array of int64_t indices, to be indexed by a tag or an ordinal *)
    indexTable(entries: Array(Int)): String

    (* C items separated by commas: arguments, parameters, initializers *)
    comma(items: vector.T(String)): String
    (* A call of f with the arguments *)
    call(f: String args: vector.T(String)): String
    (* Pieces of text separated by separator *)
    joined(separator: String items: vector.T(String)): String
    (* Lines of C separated by newlines *)
    linesText(items: vector.T(String)): String
end
