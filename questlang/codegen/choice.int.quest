(* Quest Self-Hosted Compiler: The Choice of Backends Interface
 *
 * This module records which backend compiles each unit of a build
 * (docs/arm64.md section 3.12). --backend sets the default for every unit,
 * and --unit-backend UNIT=BACKEND overrides it for one unit, named as in
 * its manifest (a module by its canonical name, or a program as main). The
 * available backends are c (the C printer), ssac (the SSA-based C printer),
 * arm64 (native assembly, writing .s files), and wasm (WebAssembly modules,
 * writing .wasm files).
 *
 * It also selects each module's source variant (docs/build-process.md
 * section 6.4). A module may have sibling files NAME.VARIANT.mod.quest
 * implementing the same interface. --variant UNIT=VARIANT selects one
 * explicitly; otherwise, a unit uses the variant named after its backend if
 * that file exists, falling back to its default file. *)

interface Choice
import
    util/maybe : util/Maybe
export
    Def Override = Tuple unit: String backend: String end
    Def Alternative = Tuple unit: String name: String end
    Def T = Tuple default: String overrides: Array(Override) variants: Array(Alternative) end
    (* The backends there are *)
    backends: Array(String)
    isBackend(name: String): Bool
    (* Every unit compiled by the C printer *)
    standard: T
    (* The name a program's unit has *)
    programUnit: String
    (* The backend that compiles a unit: the last override naming it, or the
     * default *)
    forUnit(c: T unit: String): String
    (* The backend that compiles unit; currently identical to forUnit even
     * when library is true, because all backends including wasm compile the
     * standard library (docs/wasm.md section 5.1) *)
    forFile(c: T unit: String library: Bool): String
    (* The variant a unit's source is chosen as: the last --variant naming
     * it, or the name of its backend *)
    variantFor(c: T unit: String): String
    (* Whether every unit is compiled by the C printer *)
    allC(c: T): Bool
    (* --unit-backend's value, UNIT=BACKEND, if it is one *)
    parseOverride(s: String): maybe.T(Override)
    (* Parses a --variant argument of the form UNIT=VARIANT, where VARIANT
     * consists of ASCII letters and digits *)
    parseVariant(s: String): maybe.T(Alternative)
    (* The options that make another driver's choice c *)
    arguments(c: T): Array(String)
    (* Whether a backend writes assembly rather than C: arm64 *)
    isAssembly(backend: String): Bool
    (* Whether a backend writes C from the SSA: ssac *)
    isSsac(backend: String): Bool
    (* Whether a backend compiles through the SSA (ssa/): arm64 or ssac *)
    isNative(backend: String): Bool
    (* Whether a backend writes WebAssembly modules, which are run by an
     * engine rather than linked (docs/wasm.md) *)
    isWasm(backend: String): Bool
    (* Whether backend represents a heap pointer and a QVal (tagged runtime
     * value) identically, in one register or one WebAssembly eqref, so a
     * closure whose parameters and result differ only between the two needs
     * no wrapper adapter (shapes.referencesAlike). True for arm64 and wasm;
     * false for C backends, where their C types differ. *)
    referencesAlike(backend: String): Bool
    (* A unit's code file, from its C file's path (x.mod.c), as its backend
     * writes it *)
    codeFile(cFile: String backend: String): String
end
