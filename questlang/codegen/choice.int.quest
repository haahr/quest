(* Quest Self-Hosted Compiler: The Choice of Backends Interface
 *
 * Which backend compiles each unit of a build (docs/arm64.md section 3.12):
 * --backend names one for every unit, and each --unit-backend UNIT=BACKEND
 * overrides it for one, named as its manifest names it (a module by its
 * canonical name, a program as main). The backends are c, the C printer's,
 * ssac, the SSA's C printer's, and arm64, the native backend's, whose units are
 * assembly (.s where the others write .c). *)

interface Choice
import
    util/maybe : util/Maybe
export
    Def Override = Tuple unit: String backend: String end
    Def T = Tuple default: String overrides: Array(Override) end
    (* The backends there are *)
    backends: Array(String)
    isBackend(name: String): Bool
    (* Every unit compiled by the C printer *)
    standard: T
    (* The name a program's unit has *)
    programUnit: String
    forUnit(c: T unit: String): String
    (* Whether every unit is compiled by the C printer *)
    allC(c: T): Bool
    (* --unit-backend's value, UNIT=BACKEND, if it is one *)
    parseOverride(s: String): maybe.T(Override)
    (* The options that make another driver's choice c *)
    arguments(c: T): Array(String)
    (* Whether a backend writes assembly rather than C *)
    isAssembly(backend: String): Bool
    (* A unit's code file, from its C file's path (x.mod.c), as its backend
     * writes it *)
    codeFile(cFile: String backend: String): String
end
