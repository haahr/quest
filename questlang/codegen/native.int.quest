(* Quest Self-Hosted Compiler: The Native Backends Interface
 *
 * This interface exposes the native code-generation entry points needed by
 * codegen/backend and the driver: C printing (codegen/c/printer), SSA-based
 * C printing (ssac), arm64 assembly generation, and SSA interrupt-check
 * configuration. The native.wasm variant (docs/build-process.md
 * section 6.4), used when compiling the driver to WebAssembly, stubs out
 * these entry points so the SSA pipeline and native backends are omitted
 * from the WebAssembly build (docs/wasm.md section 5.1). *)

interface Native
import
    util/maybe : util/Maybe

    questlang/ir/nodes : questlang/ir/Nodes
export
    (* A native backend's failure, or the absence of the native backends *)
    unsupported: Exception(String)

    (* Compiles unit for backend c, ssac, or arm64, returning C source or arm64
     * assembly. If datum is present, exports its text as a read-only C string
     * under datum.symbol. *)
    Def Datum = Tuple symbol: String text: String end
    unitCode(unit: nodes.Unit interfaceHeader: maybe.T(String) backend: String datum: maybe.T(Datum)): String

    (* Extra C compiler flags required for the C code emitted by backend *)
    cFlags(backend: String): Array(String)

    (* Enables or disables periodic interrupt checks in SSA-generated code *)
    setInterruptChecks(on: Bool): Ok
end
