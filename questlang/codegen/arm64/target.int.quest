(* Quest Self-Hosted Compiler: The arm64 Target Description Interface
 *
 * arm64's registers follow codegen/machine/target's numbering: x0 to x30 are
 * 0 to 30, xzr (the zero register) is 31, d0 to d31 (floating-point
 * registers) are 32 to 63, and sp (the stack pointer) is 64. The register
 * allocator may use all registers except the scratch registers, x18 (reserved
 * by Darwin), and the frame and special registers (fp, lr, xzr, and sp).
 * Caller-saved registers (clobbered by calls) are allocated in the order x12
 * to x15, then x8 down to x0, and d16 to d29, then d7 down to d0; argument
 * registers come last so values with no preference take non-argument
 * registers first. Callee-saved registers (preserved across calls) are x19 to
 * x28 and d8 to d15. The scratch registers are x9, x10, and x11 for operands
 * loaded from or stored to memory, x16 and x17 for address calculations (the
 * linker's branch veneers may clobber them between instructions), and d30 and
 * d31. *)

interface Target
import
    targets = questlang/codegen/machine/target : questlang/codegen/machine/Target
export
    description: targets.Target
    (* The numbers of x0 to x30 and of d0 to d31 *)
    x(n: Int): Int
    d(n: Int): Int
    xzr: Int
    sp: Int
    (* The frame pointer and the link register, x29 and x30 *)
    fp: Int
    lr: Int
    (* A register's name, and its 32-bit half's (w for an x register, s for a
     * d register) *)
    name(r: Int): String
    half(r: Int): String
    isReal(r: Int): Bool
end
