(* Quest Self-Hosted Compiler: arm64 Instruction Selection Interface
 *
 * This module lowers a function's SSA form into a machine function
 * (codegen/machine/machine) of arm64 instructions (codegen/arm64/minst) over
 * virtual registers (unbounded placeholder registers that the register
 * allocator later maps to hardware registers; docs/arm64.md sections 3.17
 * and 3.5). Each SSA value v becomes virtual register firstVirtual + v, with
 * extra temporaries allocated as needed. Key lowering choices:
 *
 *   - Immediates: additions, subtractions, logical ops, shifts, and
 *     comparisons fold fitting constants into immediates; stores of zero use
 *     xzr; and loads and stores fold fitting offsets, leaving the constant
 *     dead unless used elsewhere.
 *   - Fused comparisons: a branch or select on a single-use comparison (or
 *     bit test or comparison conjunction) in the same block emits the flag
 *     test and branch or conditional select directly without materializing a
 *     boolean.
 *   - Addressing: a load or store through a ptrAdd folds a constant offset or
 *     a single-use (optionally scaled) index register into the addressing
 *     mode.
 *   - Calling convention: AAPCS64 (the 64-bit Arm ABI, docs/arm64.md section
 *     3.3) is expressed as moves to and from fixed registers for call
 *     arguments, call results, function parameters, and return values.
 *   - Control flow: a dedicated entry block moves parameters and jumps to
 *     block 0; each conditional branch targets a dedicated edge block that
 *     passes the destination's block arguments; a try stores its exception
 *     handler record and jumps to its body, while raise resumes through a
 *     sibling block (section 3.6).
 *
 * Pure instructions whose results go unused are then removed. Block labels
 * are prefix_bN for machine block N. The stack frame places the outgoing
 * call arguments at sp, followed by stack slots, and then the spill and
 * callee-saved areas added after register allocation. *)

interface Select
import
    collections/vector : collections/Vector

    questlang/codegen/arm64/minst : questlang/codegen/arm64/Minst
    questlang/codegen/machine/machine : questlang/codegen/machine/Machine
    questlang/common/maps : questlang/common/Maps
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    Def Selection = Tuple
        f: machine.Function
        (* Each instruction's operation, by its index *)
        ops: vector.T(minst.Op)
        (* Each instruction's source position (its SSA instruction's or
         * terminator's), by its index; none for what allocation adds *)
        locs: vector.T(ssa.Loc)
        (* Each virtual register's SSA type, by its index (an SSA value's
         * own) *)
        types: vector.T(ssa.Type)
        (* The blocks, in the order their code is laid out *)
        layout: vector.T(Int)
        prefix: String
        (* The bytes of the outgoing arguments' area, each stack slot's offset
         * from sp, and the offset past the slots *)
        outgoing: Int
        slotAt: Array(Int)
        slotsEnd: Int
        (* Whether the function enters a try *)
        entersTry: Bool
    end

    (* Selects arm64 instructions for f. defined maps every symbol defined in
     * the unit to a flag saying whether calls to that function already return
     * narrow integer results sign- or zero-extended (from codegen's
     * definedSymbols). *)
    select(f: ssa.Function prefix: String defined: maps.StringMap(Bool)): Selection
    label(s: Selection b: Int): String
    (* Wraps i as a machine instruction of the given kind and appends its
     * operation to s.ops, marking the first minst.results(i.op) registers as
     * written and the rest as read *)
    make(s: Selection kind: machine.Kind i: minst.Inst): machine.Inst
    (* Whether an instruction may be made again wherever its result is
     * needed: a constant, a symbol's address, or an address in the frame *)
    rematerializable(s: Selection i: machine.Inst): Bool
    (* Whether selection fuses op's value into the instruction that uses it
     * in the same block (a branch, a select, a bit test, or an address), so
     * that value numbering should keep its equal in that block *)
    fuses(op: ssa.Opcode): Bool
    (* The selection as text, a virtual register %N *)
    format(s: Selection): String
end
