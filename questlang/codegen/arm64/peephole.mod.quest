(* Quest Self-Hosted Compiler: arm64 Peephole Passes Implementation *)

module peephole : Peephole
import
    questlang/codegen/arm64/minst : questlang/codegen/arm64/Minst
    questlang/codegen/arm64/printer : questlang/codegen/arm64/Printer
    questlang/codegen/arm64/target : questlang/codegen/arm64/Target
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    util/strutil : util/Strutil
    stringOp = string : StringOp
    conv : Conv
export
    Let Code = vector.T(minst.Inst)
    let eq(a: String b: String): Bool = stringOp.equal(a b)
    let put(K::TYPE V::TYPE m: hashMap.T(K V) k: K v: V): Ok = begin hashMap.insert(:K :V m k v) ok end

    (* How far, in instructions, a conditional branch may reach: 1 MB less a
     * margin; a test of a bit's, 32 KB less a margin *)
    let branchReach = 260000
    let bitBranchReach = 8000
    (* A conditional branch's inverse to a label, its target, and its reach
     * (in instructions), if op is one: cbz and cbnz of a register, tbz and
     * tbnz of a bit, and b.cond *)
    Let Conditional = Tuple inverse: All(l: String) minst.Op target: String reach: Int end
    let conditional(op: minst.Op): maybe.T(Conditional) =
        case op
            when opCbz with x then maybe.some(:Conditional tuple
                let inverse = fun(l: String): minst.Op option opCbnz of minst.Op with let label = l end
                let target = x.label let reach = branchReach
            end)
            when opCbnz with x then maybe.some(:Conditional tuple
                let inverse = fun(l: String): minst.Op option opCbz of minst.Op with let label = l end
                let target = x.label let reach = branchReach
            end)
            when opTbz with x then maybe.some(:Conditional tuple
                let inverse = fun(l: String): minst.Op minst.tbnz(0 x.bit l).op
                let target = x.label let reach = bitBranchReach
            end)
            when opTbnz with x then maybe.some(:Conditional tuple
                let inverse = fun(l: String): minst.Op minst.tbz(0 x.bit l).op
                let target = x.label let reach = bitBranchReach
            end)
            when opBCond with x then maybe.some(:Conditional tuple
                let inverse = fun(l: String): minst.Op minst.bCond(minst.inverse(x.cond) l).op let target = x.label
                let reach = branchReach
            end)
            when opMovImm, opMovz, opMovk, opMovConst, opSymbolAddress, opTlvAddress, opMov, opArith, opAddImm,
                opSubImm, opLogicImm, opShiftImm, opMsub, opSxtb, opSxtw, opCmp, opFcmp, opCmpImm, opCcmp, opCcmpImm,
                opCset, opCsel, opLoad, opStore, opLdp, opStp, opAdrp, opAddPageOff, opAdr, opB, opBSymbol, opBl, opBlr,
                opBr, opRet, opBrk, opNop, opLabel, opJumpTable, opJumpEntry, opJumpTableEnd, opCfiDefCfa, opCfiOffset,
                opLoc then
                maybe.none(:Conditional)
        end
    (* A function's code with each conditional branch whose target is more
     * than reach instructions away turned into the inverse branch around an
     * unconditional one, which reaches 128 MB; repeated until none is *)
    let relaxBranches(code: Code prefix: String reach: Int): Code =
        begin
            (* Each pass finds each label's position, in instructions, then
             * relaxes each far branch. Relaxing adds instructions, which may
             * put another branch out of reach, so the passes repeat *)
            let var current = code
            let var changed = true
            let var count = 0
            while changed do
                changed := false
                let at = hashMap.new(:String :Int eq hash.string)
                let var n = 0
                for k = 0 upto {vector.length(:minst.Inst current) - 1} do
                    let i = vector.get(:minst.Inst current k)
                    case i.op
                        when opLabel with x then put(:String :Int at x.label n)
                        when opMovImm, opMovz, opMovk, opMovConst, opSymbolAddress, opTlvAddress, opMov, opArith,
                            opAddImm, opSubImm, opLogicImm, opShiftImm, opMsub, opSxtb, opSxtw, opCmp, opFcmp, opCmpImm,
                            opCcmp, opCcmpImm, opCset, opCsel, opLoad, opStore, opLdp, opStp, opAdrp, opAddPageOff,
                            opAdr, opB, opBSymbol, opBl, opBlr, opBr, opRet, opCbz, opCbnz, opTbz, opTbnz, opBCond,
                            opBrk, opNop, opJumpTable, opJumpEntry, opJumpTableEnd, opCfiDefCfa, opCfiOffset, opLoc then
                            n := n + printer.count(i.op)
                    end
                end
                let next = vector.new(:minst.Inst)
                let var position = 0
                for k = 0 upto {vector.length(:minst.Inst current) - 1} do
                    let i = vector.get(:minst.Inst current k)
                    let c = conditional(i.op)
                    let var far = false
                    (* The inverse branch relaxing makes, to an _r label,
                     * only jumps over the b after it, so is never far *)
                    if maybe.isSome(:Conditional c) then
                        let target = maybe.unwrap(:Conditional c).target
                        let t = hashMap.get(:String :Int at target)
                        if not(strutil.startsWith(target prefix <> "_r")) andif maybe.isSome(:Int t) then
                            let d = maybe.unwrap(:Int t) - position
                            let within = if maybe.unwrap(:Conditional c).reach < reach then
                                maybe.unwrap(:Conditional c).reach else reach end
                            far := {d > within} orif {{0 - d} > within}
                        end
                    end
                    if far then
                        count := count + 1
                        let skip = prefix <> "_r" <> conv.int(count)
                        vector.append(:minst.Inst next tuple
                            let op = maybe.unwrap(:Conditional c).inverse(skip) let regs = i.regs
                        end)
                        vector.append(:minst.Inst next minst.b(maybe.unwrap(:Conditional c).target))
                        vector.append(:minst.Inst next minst.label(skip))
                        changed := true
                    else
                        vector.append(:minst.Inst next i)
                    end
                    position := position + printer.count(i.op)
                end
                current := next
            end
            current
        end
    (* A load or store of 8 bytes at a base plus an immediate offset: whether
     * it loads, its register, its base, and its offset *)
    Let Access = Tuple load: Bool t: Int base: Int offset: Int end
    let access(i: minst.Inst): maybe.T(Access) =
        begin
            let made = fun(load: Bool offset: Int): maybe.T(Access)
                maybe.some(:Access tuple let load = load let t = i.regs[0] let base = i.regs[1] let offset = offset end)
            let at = fun(load: Bool m: minst.Mode): maybe.T(Access)
                case m
                    when modeOffset with x then made(load x.imm)
                    when modeBase then made(load 0)
                    when modePre, modePost, modePageOff, modeIndex then maybe.none(:Access)
                end
            case i.op
                when opLoad with x then
                    case x.load
                        when load64 then at(true x.mode)
                        when loadS32, loadS8, loadU8 then maybe.none(:Access)
                    end
                when opStore with x then
                    case x.store
                        when store64 then at(false x.mode)
                        when store32, store8 then maybe.none(:Access)
                    end
                when opMovImm, opMovz, opMovk, opMovConst, opSymbolAddress, opTlvAddress, opMov, opArith, opAddImm,
                    opSubImm, opLogicImm, opShiftImm, opMsub, opSxtb, opSxtw, opCmp, opFcmp, opCmpImm, opCcmp,
                    opCcmpImm, opCset, opCsel, opLdp, opStp, opAdrp, opAddPageOff, opAdr, opB, opBSymbol, opBl, opBlr,
                    opBr, opRet, opCbz, opCbnz, opTbz, opTbnz, opBCond, opBrk, opNop, opLabel, opJumpTable, opJumpEntry,
                    opJumpTableEnd, opCfiDefCfa, opCfiOffset, opLoc then
                    maybe.none(:Access)
            end
        end
    (* How an instruction between two accesses bears on pairing them: one a
     * pair may move across, which touches only registers (and the flags), or
     * a load of one register (which a load may move across, and a store not),
     * or neither (a store, a call, a branch, or a label) *)
    let registersOnly = 0
    let aLoad = 1
    let barrier = 2
    let crossing(op: minst.Op): Int =
        case op
            when opMovImm, opMovz, opMovk, opMovConst, opSymbolAddress, opMov, opArith, opAddImm, opSubImm, opLogicImm,
                opShiftImm, opMsub, opSxtb, opSxtw, opCmp, opFcmp, opCmpImm, opCcmp, opCcmpImm, opCset, opCsel, opAdrp,
                opAddPageOff, opAdr, opLoc then
                registersOnly
            when opLoad with x then
                case x.mode
                    when modeOffset, modeBase, modePageOff, modeIndex then aLoad
                    when modePre, modePost then barrier
                end
            when opTlvAddress, opStore, opLdp, opStp, opB, opBSymbol, opBl, opBlr, opBr, opRet, opCbz, opCbnz, opTbz,
                opTbnz, opBCond, opBrk, opNop, opLabel, opJumpTable, opJumpEntry, opJumpTableEnd, opCfiDefCfa,
                opCfiOffset then
                barrier
        end
    (* Whether b can be a's partner, given the registers written and read
     * between them: the same kind of access, of the same class of register,
     * off the same base, at offsets 8 apart that ldp and stp can encode; a
     * load's partner's register neither written nor read between them, and a
     * store's own not written *)
    let pairable(a: Access b: Access written: Array(Bool) read: Array(Bool)): Bool =
        begin
            let low = if a.offset < b.offset then a.offset else b.offset end
            let apart = {{a.offset - b.offset} is 8} orif {{b.offset - a.offset} is 8}
            let free = if a.load then not(written[b.t]) andif not(read[b.t]) else not(written[a.t]) end
            {b.load is a.load} andif {b.base is a.base} andif {target.isReal(b.t) is target.isReal(a.t)} andif apart
                andif {{low % 8} is 0} andif {low >= ~512} andif {low <= 504} andif {b.t isnot a.t}
                andif not(written[a.base]) andif free
        end
    (* How many instructions after a load or store its pair is looked for,
     * and how many after a pair of stores a lone load of one of its words *)
    let pairWindow = 16
    let forwardWindow = 12
    (* A function's code with loads (and stores) of 8 bytes off one base, at
     * offsets 8 apart, merged into ldp (stp) where the instructions between
     * them allow: a load's partner is moved up to it, across instructions
     * that neither write its base or register nor read its register, nor
     * store; a store is moved down to its partner, across instructions that
     * write neither its base nor its register, nor load or store. Tuples,
     * list cells, and options' payloads are adjacent words, and so are a
     * frame's slots, so this is AArch64LoadStoreOptimizer's main pattern.
     * Two stores are left apart when the code that runs just after loads
     * one of their two words alone: a load does not forward from half of a
     * pair's store, and waits for the store to reach the cache
     * (psdes-random's loop, which makes a tuple and reads a component of it
     * at once, took 1.22 of its time so: docs/benchmarks.md section 17.2) *)
    let pairs(code: Code): Code =
        begin
            let n = vector.length(:minst.Inst code)
            let accesses = array of(n maybe.none(:Access))
            for k = 0 upto {n - 1} do accesses[k] := access(vector.get(:minst.Inst code k)) end
            (* What replaces each instruction (none for one dropped), and
             * whether it is already in a pair *)
            let replaced = array of(n maybe.none(:minst.Inst))
            let dropped = array of(n false)
            let paired = array of(n false)
            let written = array of(65 false)
            let read = array of(65 false)
            (* Each label's place in the code *)
            let labelAt = hashMap.new(:String :Int eq hash.string)
            for k = 0 upto {n - 1} do
                case vector.get(:minst.Inst code k).op
                    when opLabel with x then put(:String :Int labelAt x.label k)
                    else ok
                end
            end
            (* Whether the code that runs after index from loads one of the
             * two words at low and low + 8 off base alone: the first load
             * of either within forwardWindow instructions, following jumps,
             * until a call, a return, or a write of the base, with no load
             * of the other in the four instructions after it (two loads so
             * close become a pair's, which forwards from a pair's store) *)
            let halfLoaded(from: Int base: Int low: Int): Bool =
                begin
                    let var hazard = false
                    let var k = from
                    let var steps = 0
                    let var going = true
                    while going andif {k < n} andif {steps < forwardWindow} do
                        let next = vector.get(:minst.Inst code k)
                        let var to = k + 1
                        if maybe.isSome(:Access accesses[k]) then
                            let x = maybe.unwrap(:Access accesses[k])
                            if x.load andif {x.base is base} andif {{x.offset is low} orif {x.offset is {low + 8}}} then
                                let other = if x.offset is low then low + 8 else low end
                                let var partnered = false
                                for d = 1 upto 4 do
                                    if {{k + d} < n} andif maybe.isSome(:Access accesses[k + d]) then
                                        let y = maybe.unwrap(:Access accesses[k + d])
                                        if y.load andif {y.base is base} andif {y.offset is other} then
                                            partnered := true
                                        end
                                    end
                                end
                                hazard := not(partnered)
                                going := false
                            end
                        end
                        case next.op
                            when opB with x then
                                let target = hashMap.get(:String :Int labelAt x.label)
                                if maybe.isSome(:Int target) then to := maybe.unwrap(:Int target)
                                else going := false end
                            when opBSymbol, opBl, opBlr, opBr, opRet, opBrk then going := false
                            else ok
                        end
                        for r = 0 upto {minst.results(next.op) - 1} do
                            if next.regs[r] is base then going := false end
                        end
                        k := to
                        steps := steps + 1
                    end
                    hazard
                end
            for i = 0 upto {n - 1} do
                if maybe.isSome(:Access accesses[i]) andif not(paired[i]) then
                    let a = maybe.unwrap(:Access accesses[i])
                    for r = 0 upto 64 do
                        written[r] := false
                        read[r] := false
                    end
                    let first = vector.get(:minst.Inst code i)
                    for r = 0 upto {minst.results(first.op) - 1} do written[first.regs[r]] := true end
                    let var j = i + 1
                    let var looking = true
                    while looking andif {j < n} andif {j <= {i + pairWindow}} do
                        let next = vector.get(:minst.Inst code j)
                        let c = crossing(next.op)
                        let fits = maybe.isSome(:Access accesses[j]) andif not(paired[j])
                            andif pairable(a maybe.unwrap(:Access accesses[j]) written read)
                        let partner = fits andif {a.load orif not(halfLoaded(j + 1 a.base
                            if a.offset < maybe.unwrap(:Access accesses[j]).offset then a.offset
                            else maybe.unwrap(:Access accesses[j]).offset end))}
                        if partner then
                            let b = maybe.unwrap(:Access accesses[j])
                            let lowFirst = a.offset < b.offset
                            let lo = if lowFirst then a.t else b.t end
                            let hi = if lowFirst then b.t else a.t end
                            let low = if lowFirst then a.offset else b.offset end
                            let m = if low is 0 then minst.modeBase else minst.offset(low) end
                            if a.load then
                                replaced[i] := maybe.some(:minst.Inst minst.ldp(lo hi a.base m))
                                dropped[j] := true
                            else
                                replaced[j] := maybe.some(:minst.Inst minst.stp(lo hi a.base m))
                                dropped[i] := true
                            end
                            paired[i] := true
                            paired[j] := true
                            looking := false
                        elsif {c is barrier} orif {{c is aLoad} andif not(a.load)} then
                            looking := false
                        else
                            for r = 0 upto {minst.results(next.op) - 1} do written[next.regs[r]] := true end
                            for r = 0 upto {extent next.regs - 1} do read[next.regs[r]] := true end
                            if written[a.base] orif {not(a.load) andif written[a.t]} then looking := false end
                        end
                        j := j + 1
                    end
                end
            end
            let merged = vector.new(:minst.Inst)
            for k = 0 upto {n - 1} do
                if maybe.isSome(:minst.Inst replaced[k]) then
                    vector.append(:minst.Inst merged maybe.unwrap(:minst.Inst replaced[k]))
                elsif not(dropped[k]) then
                    vector.append(:minst.Inst merged vector.get(:minst.Inst code k))
                end
            end
            merged
        end
end
