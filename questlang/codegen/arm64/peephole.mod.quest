(* Quest Self-Hosted Compiler: arm64 Peephole Passes Implementation *)

module peephole : Peephole
import
    conv : Conv
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/codegen/arm64/minst : questlang/codegen/arm64/Minst
    questlang/codegen/arm64/printer : questlang/codegen/arm64/Printer
    questlang/codegen/arm64/target : questlang/codegen/arm64/Target
export
    Let Code = vector.T(minst.Inst)
    let eq(a: String b: String): Bool = stringOp.equal(a b)
    let put(K::TYPE V::TYPE m: hashMap.T(K V) k: K v: V): Ok = begin hashMap.insert(m k v) ok end

    (* Maximum branch reach in instructions, leaving a safety margin: 1 MB
     * for cbz, cbnz, and b.cond, and 32 KB for tbz and tbnz *)
    let branchReach = 260000
    let bitBranchReach = 8000
    (* A conditional branch's inverse to a label, its target, and its reach
     * (in instructions), if op is one: cbz and cbnz of a register, tbz and
     * tbnz of a bit, and b.cond *)
    Let Conditional = Tuple inverse: All(l: String) minst.Op target: String reach: Int end
    let conditional(op: minst.Op): maybe.T(Conditional) =
        case op
            when opCbz with x then maybe.some(tuple
                let inverse = fun(l: String): minst.Op option opCbnz of minst.Op with let label = l end
                let target = x.label
                let reach = branchReach
            end)
            when opCbnz with x then maybe.some(tuple
                let inverse = fun(l: String): minst.Op option opCbz of minst.Op with let label = l end
                let target = x.label
                let reach = branchReach
            end)
            when opTbz with x then maybe.some(tuple
                let inverse = fun(l: String): minst.Op minst.tbnz(0 x.bit l).op
                let target = x.label
                let reach = bitBranchReach
            end)
            when opTbnz with x then maybe.some(tuple
                let inverse = fun(l: String): minst.Op minst.tbz(0 x.bit l).op
                let target = x.label
                let reach = bitBranchReach
            end)
            when opBCond with x then maybe.some(tuple
                let inverse = fun(l: String): minst.Op minst.bCond(minst.inverse(x.cond) l).op
                let target = x.label
                let reach = branchReach
            end)
            when opMovImm, opMovz, opMovk, opMovConst, opSymbolAddress, opMov, opArith, opAdds, opAddImm,
                    opSubImm, opLogicImm, opShiftImm, opMsub, opSxtb, opSxtw, opScvtf, opCmp, opFcmp, opCmpImm, opCcmp,
                    opCcmpImm,
                    opCset, opCsel, opLoad, opStore, opLdp, opStp, opAdrp, opAddPageOff, opAdr, opB, opBSymbol, opBl,
                    opBlr,
                    opBr, opRet, opBrk, opNop, opLabel, opJumpTable, opJumpEntry, opJumpTableEnd, opCfiDefCfa,
                    opCfiOffset,
                    opLoc then
                maybe.none()
        end
    (* Rewrites out-of-range conditional branches into an inverted branch
     * around an unconditional branch (which reaches 128 MB), repeating until
     * all conditional branches are in range *)
    let relaxBranches(code: Code prefix: String reach: Int): Code =
        begin
            (* Each pass records each label's position in instructions, then
             * relaxes every out-of-range branch. Relaxing inserts
             * instructions, which can push another branch out of range, so
             * the passes repeat until nothing changes. *)
            let var current = code
            let var changed = true
            let var count = 0
            while changed do
                changed := false
                let at = hashMap.new(:String :Int eq hash.string)
                let var n = 0
                for k = 0 upto {vector.length(current) - 1} do
                    let i = vector.get(current k)
                    case i.op
                        when opLabel with x then put(at x.label n)
                        else n := n + printer.count(i.op)
                    end
                end
                let next = vector.new(:minst.Inst)
                let var position = 0
                for k = 0 upto {vector.length(current) - 1} do
                    let i = vector.get(current k)
                    let c = conditional(i.op)
                    let var far = false
                    (* An inverted branch created by relaxation jumps only
                     * over the b immediately following it to an _r label, so
                     * it is never out of range *)
                    if maybe.isSome(c) then
                        let target = maybe.unwrap(c).target
                        let t = hashMap.get(at target)
                        if not(strutil.startsWith(target prefix <> "_r")) andif maybe.isSome(t) then
                            let d = maybe.unwrap(t) - position
                            let within =
                                if maybe.unwrap(c).reach < reach then
                                    maybe.unwrap(c).reach
                                else
                                    reach
                                end
                            far := {d > within} orif {{0 - d} > within}
                        end
                    end
                    if far then
                        count := count + 1
                        let skip = prefix <> "_r" <> conv.int(count)
                        vector.append(next tuple
                            let op = maybe.unwrap(c).inverse(skip)
                            let regs = i.regs
                        end)
                        vector.append(next minst.b(maybe.unwrap(c).target))
                        vector.append(next minst.label(skip))
                        changed := true
                    else
                        vector.append(next i)
                    end
                    position := position + printer.count(i.op)
                end
                current := next
            end
            current
        end
    (* A load or store of 8 bytes at a base plus an immediate offset: whether
     * it loads, its register, its base, and its offset *)
    Let Access = Tuple load: Bool t: Int base: Int offset: Int end
    let access(i: minst.Inst): maybe.T(Access) =
        begin
            let made = fun(load: Bool offset: Int): maybe.T(Access)
                maybe.some(tuple let load = load let t = i.regs[0] let base = i.regs[1] let offset = offset end)
            let at = fun(load: Bool m: minst.Mode): maybe.T(Access)
                case m
                    when modeOffset with x then made(load x.imm)
                    when modeBase then made(load 0)
                    when modePre, modePost, modePageOff, modeIndex then maybe.none()
                end
            case i.op
                when opLoad with x then
                    case x.load
                        when load64 then at(true x.mode)
                        when loadS32, loadS8, loadU8 then maybe.none()
                    end
                when opStore with x then
                    case x.store
                        when store64 then at(false x.mode)
                        when store32, store8 then maybe.none()
                    end
                else maybe.none()
            end
        end
    (* Classifies whether an intervening instruction allows pairing across it:
     * registersOnly touches only registers and flags (safe for loads and
     * stores), aLoad is a single-register load (safe for loads, not stores),
     * and barrier (stores, calls, branches, labels, and pre/post-indexed
     * loads) blocks both *)
    let registersOnly = 0
    let aLoad = 1
    let barrier = 2
    let crossing(op: minst.Op): Int =
        case op
            when opLoad with x then
                case x.mode
                    when modeOffset, modeBase, modePageOff, modeIndex then aLoad
                    when modePre, modePost then barrier
                end
            else if minst.info(op).registersOnly then registersOnly else barrier end
        end
    (* Reports whether b can be paired with a given the registers written and
     * read between them. Both must be the same kind of access (load or store)
     * with the same register class and base, distinct target registers, and
     * 8-byte-aligned offsets 8 bytes apart within ldp/stp range (-512..504).
     * Neither may cross a write to the base; a moved load's register cannot
     * be read or written in between, and a moved store's register cannot be
     * written. *)
    let pairable(a: Access b: Access written: Array(Bool) read: Array(Bool)): Bool =
        begin
            let low = if a.offset < b.offset then a.offset else b.offset end
            let apart = {{a.offset - b.offset} is 8} orif {{b.offset - a.offset} is 8}
            let free = if a.load then not(written[b.t]) andif not(read[b.t]) else not(written[a.t]) end
            {b.load is a.load} andif {b.base is a.base} andif {target.isReal(b.t) is target.isReal(a.t)} andif apart
                andif {{low % 8} is 0} andif {low >= ~512} andif {low <= 504} andif {b.t isnot a.t}
                andif not(written[a.base]) andif free
        end
    (* How many instructions after a load or store its pair is looked for,
     * and how many after a pair of stores a lone load of one of its words *)
    let pairWindow = 16
    let forwardWindow = 12
    (* Merges pairs of 8-byte loads (or stores) off the same base at offsets 8
     * bytes apart into ldp (or stp) where intervening instructions allow. A
     * load's partner moves up across instructions that neither store nor
     * write the base or touch the partner's register; a store moves down
     * across instructions that neither load nor store nor write the base or
     * the stored register. Tuples, list cells, option payloads, and frame
     * slots all occupy adjacent words, so this is AArch64LoadStoreOptimizer's
     * main pattern. Two stores are left separate when immediately followed by
     * a lone load of just one of the two words: CPU store-to-load forwarding
     * cannot satisfy an 8-byte load from half of a 16-byte stp, stalling
     * until the store reaches cache (psdes-random's loop took 1.22x longer
     * when paired: docs/benchmarks.md section 17.2). *)
    let pairs(code: Code): Code =
        begin
            let n = vector.length(code)
            let accesses = array of(n maybe.none(:Access))
            for k = 0 upto {n - 1} do accesses[k] := access(vector.get(code k)) end
            (* What replaces each instruction (none for one dropped), and
             * whether it is already in a pair *)
            let replaced = array of(n maybe.none(:minst.Inst))
            let dropped = array of(n false)
            let paired = array of(n false)
            let written = array of(65 false)
            let read = array of(65 false)
            (* Each label's place in the code *)
            let labelAt = hashMap.new(:String :Int eq hash.string)
            for k = 0 upto {n - 1} do
                case vector.get(code k).op
                    when opLabel with x then put(labelAt x.label k)
                    else ok
                end
            end
            (* Reports whether code starting at index from loads just one of
             * the two words at low and low + 8 off base. It scans up to
             * forwardWindow instructions, following unconditional jumps and
             * stopping at a call, return, or write to base; if it finds a
             * load of either word with no load of the other within the next
             * four instructions (which would pair into an ldp that can
             * forward from stp), it returns true. *)
            let halfLoaded(from: Int base: Int low: Int): Bool =
                begin
                    let var hazard = false
                    let var k = from
                    let var steps = 0
                    let var going = true
                    while going andif {k < n} andif {steps < forwardWindow} do
                        let next = vector.get(code k)
                        let var to = k + 1
                        if maybe.isSome(accesses[k]) then
                            let x = maybe.unwrap(accesses[k])
                            if x.load andif {x.base is base} andif {{x.offset is low} orif {x.offset is {low + 8}}} then
                                let other = if x.offset is low then low + 8 else low end
                                let var partnered = false
                                for d = 1 upto 4 do
                                    if {{k + d} < n} andif maybe.isSome(accesses[k + d]) then
                                        let y = maybe.unwrap(accesses[k + d])
                                        if y.load andif {y.base is base} andif {y.offset is other} then
                                            partnered := true
                                        end
                                    end
                                end
                                hazard := not(partnered)
                                going := false
                            end
                        end
                        case next.op
                            when opB with x then
                                let target = hashMap.get(labelAt x.label)
                                if maybe.isSome(target) then to := maybe.unwrap(target)
                                else going := false
                                end
                            when opBSymbol, opBl, opBlr, opBr, opRet, opBrk then going := false
                            else ok
                        end
                        for r = 0 upto {minst.results(next.op) - 1} do
                            if next.regs[r] is base then going := false end
                        end
                        k := to
                        steps := steps + 1
                    end
                    hazard
                end
            for i = 0 upto {n - 1} do
                if maybe.isSome(accesses[i]) andif not(paired[i]) then
                    let a = maybe.unwrap(accesses[i])
                    for r = 0 upto 64 do
                        written[r] := false
                        read[r] := false
                    end
                    let first = vector.get(code i)
                    for r = 0 upto {minst.results(first.op) - 1} do written[first.regs[r]] := true end
                    let var j = i + 1
                    let var looking = true
                    while looking andif {j < n} andif {j <= {i + pairWindow}} do
                        let next = vector.get(code j)
                        let c = crossing(next.op)
                        let fits = maybe.isSome(accesses[j]) andif not(paired[j])
                            andif pairable(a maybe.unwrap(accesses[j]) written read)
                        let partner = fits andif {a.load orif not(halfLoaded(j + 1 a.base
                                if a.offset < maybe.unwrap(accesses[j]).offset then a.offset
                                else maybe.unwrap(accesses[j]).offset
                                end))}
                        if partner then
                            let b = maybe.unwrap(accesses[j])
                            let lowFirst = a.offset < b.offset
                            let lo = if lowFirst then a.t else b.t end
                            let hi = if lowFirst then b.t else a.t end
                            let low = if lowFirst then a.offset else b.offset end
                            let m = if low is 0 then minst.modeBase else minst.offset(low) end
                            if a.load then
                                replaced[i] := maybe.some(minst.ldp(lo hi a.base m))
                                dropped[j] := true
                            else
                                replaced[j] := maybe.some(minst.stp(lo hi a.base m))
                                dropped[i] := true
                            end
                            paired[i] := true
                            paired[j] := true
                            looking := false
                        elsif {c is barrier} orif {{c is aLoad} andif not(a.load)} then
                            looking := false
                        else
                            for r = 0 upto {minst.results(next.op) - 1} do written[next.regs[r]] := true end
                            for r = 0 upto {extent next.regs - 1} do read[next.regs[r]] := true end
                            if written[a.base] orif {not(a.load) andif written[a.t]} then looking := false end
                        end
                        j := j + 1
                    end
                end
            end
            let merged = vector.new(:minst.Inst)
            for k = 0 upto {n - 1} do
                if maybe.isSome(replaced[k]) then
                    vector.append(merged maybe.unwrap(replaced[k]))
                elsif not(dropped[k]) then
                    vector.append(merged vector.get(code k))
                end
            end
            merged
        end
end
