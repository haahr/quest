(* Quest Self-Hosted Compiler: The arm64 Backend's Code Generator Interface
 *
 * Compiles a unit's SSA (questlang/ssa) to Darwin arm64 assembly
 * (docs/arm64.md section 3): each function selected as a machine function of
 * codegen/arm64/minst's instructions (codegen/arm64/select), its virtual
 * registers given registers or slots in the frame by codegen/machine/regalloc's linear
 * scan and rewritten in them (section 3.8), then the frame's prologue and
 * epilogues added, blocks that only jump passed over, and a jump to the next
 * block left to fall through. Calls pass arguments and results as AAPCS64
 * does (section 3.3); a try pushes a native handler's record, and a raise
 * resumes beside it with every register dead (section 3.6).
 * codegen/arm64/printer spells the instructions; the directives are
 * codegen/arm64/asm's. *)

interface Codegen
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/codegen/arm64/minst : questlang/codegen/arm64/Minst
    questlang/codegen/arm64/encode : questlang/codegen/arm64/Encode
    collections/vector : collections/Vector
    util/maybe : util/Maybe
export
    (* What the backend cannot compile, naming it *)
    unsupported: Exception(String)
    (* A unit's assembly *)
    assembleUnit(u: ssa.Unit): String
    (* A unit's code and data, encoded, for the JIT (docs/jit.md section
     * 3.5) *)
    encodeUnit(u: ssa.Unit): encode.Encoded
    (* A function's instructions with each conditional branch whose target is
     * more than reach instructions away (a pseudo-instruction counted as the
     * instructions it is) turned into the inverse branch around an
     * unconditional one (docs/arm64.md section 3.11); its labels begin with
     * prefix *)
    relaxBranches(code: vector.T(minst.Inst) prefix: String reach: Int): vector.T(minst.Inst)

    (* A slot of a function's frame, at offset from sp after the prologue, of
     * bytes (docs/arm64.md section 3.13): a virtual register in
     * memory, of its SSA type (a ptr is a pointer and an int is not, though an
     * int may be a QVal word, whose pointer-ness its type descriptor says), id
     * being its index (an SSA value's own number); or with no type, a stack
     * slot's memory, whose words have no class here, id being the slot. What
     * the frame table's maps are made from. *)
    Def FrameSlot = Tuple offset: Int bytes: Int type: maybe.T(ssa.Type) id: Int end
    (* The slots of the frame f is compiled with, in order of their offsets *)
    frameSlots(f: ssa.Function): Array(FrameSlot)
    (* The frame f is compiled with as the unit's frame table describes it to
     * the collector (docs/arm64.md section 3.13; runtime/quest_gc.c has the
     * table's form), as text: a line for the frame (the words from sp to its
     * frame record, the pairs of callee-saved registers it saves, and the
     * words at sp that nothing describes), then one for each call, in the
     * order of the code: its return address, in instructions from the
     * function's start, and what is live across it, each callee-saved
     * register and each word of the frame (by its offset from sp) as a ptr
     * or as an ambiguous word. None for a function that enters a try, whose
     * frame is scanned whole. *)
    frameMaps(f: ssa.Function): Array(String)
end
