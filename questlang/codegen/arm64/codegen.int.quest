(* Quest Self-Hosted Compiler: The arm64 Backend's Code Generator Interface
 *
 * This module compiles a unit's SSA (Static Single Assignment IR,
 * questlang/ssa) to Darwin arm64 assembly or JIT machine code (docs/arm64.md
 * section 3). For each function, codegen/arm64/select lowers SSA to
 * codegen/arm64/minst instructions with virtual registers;
 * codegen/machine/regalloc assigns physical registers or stack spill slots by
 * linear scan and rewrites the instructions (section 3.8); and this module
 * adds the frame prologue and epilogues, bypasses jump-only blocks, orders
 * blocks so common edges fall through, and relaxes out-of-range branches.
 * Calls follow the AAPCS64 calling convention (section 3.3). A try pushes a
 * native exception-handler record, and a raise resumes at the handler with
 * every register dead (section 3.6). Assembly text is formatted by
 * codegen/arm64/printer and codegen/arm64/asm; binary encoding is handled by
 * codegen/arm64/encode. *)

interface Codegen
import
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/codegen/arm64/encode : questlang/codegen/arm64/Encode
    questlang/codegen/arm64/minst : questlang/codegen/arm64/Minst
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    (* Raised when the backend cannot compile a construct, naming it *)
    unsupported: Exception(String)
    (* What this backend tells the SSA's passes (ssa/nodes' Policy): every
     * loop rotated, and value numbering keeping within its block an equal of
     * a rematerializable value or of one selection fuses (select.fuses);
     * value numbering would otherwise leave a constant, a symbol's address,
     * or a null live across blocks and spill it (docs/ssa.md section 4.1:
     * hamlet's stack accesses rose from 8,129 to 10,022), and a comparison,
     * an and, a multiplication, or a pointer addition apart from what fuses
     * it *)
    ssaPolicy: ssa.Policy
    (* A unit's assembly *)
    assembleUnit(u: ssa.Unit): String
    (* A unit's code and data, encoded, for the JIT (docs/jit.md section
     * 3.5) *)
    encodeUnit(u: ssa.Unit): encode.Encoded

    (* A slot in a function's stack frame, located at offset bytes from sp
     * after the prologue and spanning bytes bytes (docs/arm64.md section
     * 3.13). When type is present, the slot holds a spilled virtual register
     * of that SSA type (ptr is a heap pointer; int or val may hold a pointer
     * or a tagged QVal word) and id is the virtual register's index. When
     * type is absent, the slot is an explicit stack allocation whose words
     * are not classified individually, and id is the stack slot index. *)
    Def FrameSlot = Tuple offset: Int bytes: Int type: maybe.T(ssa.Type) id: Int end
    (* The slots of the frame f is compiled with, in order of their offsets *)
    frameSlots(f: ssa.Function): Array(FrameSlot)
    (* A textual summary of f's garbage-collector frame map (docs/arm64.md
     * section 3.13; runtime/quest_gc.c defines the binary table format). The
     * first line gives the frame header: the number of 8-byte words from sp
     * to the frame record, the callee-saved register pairs saved, and the
     * number of undescribed words at sp. Each subsequent line corresponds to
     * a call site in code order, giving its return address (in instructions
     * from the start of f) and every live callee-saved register or frame word
     * (by offset from sp) classified as a ptr or an ambiguous word. Returns
     * an empty array for a function that enters a try, since the collector
     * scans such frames conservatively in full. *)
    frameMaps(f: ssa.Function): Array(String)
end
