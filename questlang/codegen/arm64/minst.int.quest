(* Quest Self-Hosted Compiler: arm64 Machine Instructions Interface
 *
 * This interface represents arm64 machine instructions as data (docs/arm64.md
 * section 3.17). Op is a tagged union of arm64 operations carrying their
 * immediates, conditions, addressing modes, and labels; an Inst pairs an Op
 * with an array of register numbers (from codegen/arm64/target) in the order
 * documented on each Op variant. Only the arm64 backend (instruction
 * selection, code generation, peephole optimization, printing, and encoding)
 * inspects Op values; target-independent passes such as register allocation
 * treat them as opaque. Labels, jump-table entries, source locations, and
 * unwind directives are also represented as instructions so that a function's
 * code forms a single flat sequence. *)

interface Minst
export
    (* A condition code tested after a comparison. For integers, lt/ge/gt/le
     * are signed and lo/hs/hi/ls are unsigned. After floating-point fcmp, mi,
     * ls, gt, and ge are false when either operand is NaN, and vs is true
     * when either operand is NaN. *)
    Def Cond = Option
        condEq condNe condLt condGe condGt condLe condLo condHs condHi condLs condMi condPl condVs condVc
    end
    (* Three-register arithmetic, bitwise, and floating-point operations *)
    Def Arith = Option
        arithAdd arithSub arithMul arithUmulh arithSdiv arithAnd arithOrr arithEor arithLsl arithLsr arithAsr
        arithFadd arithFsub arithFmul arithFdiv
    end
    (* Relocation kinds for addressing a symbol: the symbol's own page and
     * offset, or its GOT (Global Offset Table) entry for external symbols *)
    Def Reloc = Option relocPage relocGot end
    (* Memory addressing modes relative to a base register: base plus
     * immediate offset, base alone, pre-indexed (update base before access),
     * post-indexed (update base after access), base plus a symbol's page
     * offset, or base plus an index register (the instruction's last
     * register) shifted left by shift (0 or log2 of the access width) *)
    Def Mode = Option
        modeOffset with imm: Int end
        modeBase
        modePre with imm: Int end
        modePost with imm: Int end
        modePageOff with symbol: String reloc: Reloc end
        modeIndex with shift: Int end
    end
    (* A load's width and extension: 8 bytes (into an x or d register), 4
     * sign-extended, 1 sign-extended, or 1 zero-extended; a store's width *)
    Def Load = Option load64 loadS32 loadS8 loadU8 end
    Def Store = Option store64 store32 store8 end

    (* Each Op comment lists its register operands in order *)
    Def Op = Option
        (* d := an immediate: mov (any, written in one instruction), movz (a
         * halfword shifted), movk (d's halfword replaced; d is read too) *)
        opMovImm with imm: Int end
        opMovz with imm: Int shift: Int end
        opMovk with imm: Int shift: Int end
        (* d := any 64-bit integer, expanded by the printer into the fewest
         * instructions: one mov if isMovImm holds, else a mov from 0 or ~0
         * (whichever leaves fewer 16-bit halfwords to fill) followed by movk
         * for each remaining halfword *)
        opMovConst with imm: Int end
        (* d := a symbol's address plus offset. When local is true, the symbol
         * is defined in this unit and addressed directly; otherwise its
         * address is loaded from the GOT. Large offsets use x17 as scratch. *)
        opSymbolAddress with symbol: String offset: Int local: Bool end
        (* d, s: a register's copy, of either class *)
        opMov
        (* d, x, y *)
        opArith with arith: Arith end
        (* d, x, y: d := x + y, setting the flags (hs: the add carried out) *)
        opAdds
        (* d, s: integer immediate operations: add (with imm shifted left by
         * shift, 0 or 12), sub, bitwise logic with a bitmask immediate
         * accepted by isLogical, or shift by an immediate (lsl, lsr, asr) *)
        opAddImm with imm: Int shift: Int end
        opSubImm with imm: Int end
        opLogicImm with arith: Arith imm: Int end
        opShiftImm with arith: Arith imm: Int end
        (* d, x, y, z: d := z - x * y *)
        opMsub
        (* d, s: s's low byte, or its low 4 bytes, sign-extended *)
        opSxtb
        opSxtw
        (* d, s: the integer s converted to a real, rounded to nearest *)
        opScvtf
        (* x, y: the flags set by their comparison; x: by its comparison
         * with an immediate *)
        opCmp
        opFcmp
        opCmpImm with imm: Int end
        (* x, y (or x with a 0..31 immediate): if cond holds, compare and set
         * flags; otherwise set the flags to the 4-bit nzcv immediate *)
        opCcmp with nzcv: Int cond: Cond end
        opCcmpImm with imm: Int nzcv: Int cond: Cond end
        (* d: 1 if the condition holds, else 0 *)
        opCset with cond: Cond end
        (* d, x, y: x if the condition holds, else y *)
        opCsel with cond: Cond end
        (* t, base: t loaded from, or stored to, memory *)
        opLoad with load: Load mode: Mode end
        opStore with store: Store mode: Mode end
        (* a, b, base: a pair of registers loaded or stored *)
        opLdp with mode: Mode end
        opStp with mode: Mode end
        (* d: a symbol's page, as reloc says; d, s: d := s plus the symbol's
         * offset in its page; d: a label's address *)
        opAdrp with symbol: String reloc: Reloc end
        opAddPageOff with symbol: String end
        opAdr with label: String end
        (* Branches: to a label, or to a symbol (a tail call); a call of a
         * symbol, or (r) of a register; (r) a branch to a register; a return *)
        opB with label: String end
        opBSymbol with symbol: String end
        opBl with symbol: String end
        opBlr
        opBr
        opRet
        (* r: a branch if r is zero, or not *)
        opCbz with label: String end
        opCbnz with label: String end
        (* r: a branch if r's bit is zero, or not; reaching 32 KB *)
        opTbz with bit: Int label: String end
        opTbnz with bit: Int label: String end
        (* A branch if the condition holds *)
        opBCond with cond: Cond label: String end
        opBrk with imm: Int end
        opNop
        (* A label, before the instruction that follows *)
        opLabel with label: String end
        (* A jump table (docs/arm64.md section 3.11), emitted immediately
         * after the br that dispatches through it. opJumpTable marks the
         * table's start label, each opJumpEntry holds a 32-bit offset from
         * the table label to a target label, and opJumpTableEnd marks the
         * end of the table and ends the block. *)
        opJumpTable with label: String end
        opJumpEntry with table: String label: String end
        opJumpTableEnd
        (* r: DWARF unwind directives setting the Canonical Frame Address
         * (CFA) to r plus offset, or recording that r is saved at CFA plus
         * offset *)
        opCfiDefCfa with offset: Int end
        opCfiOffset with offset: Int end
        (* The line table's source position of the instructions that
         * follow: a file (by its number in the unit), a line, and a
         * column *)
        opLoc with file: Int line: Int col: Int end
    end
    Def Inst = Tuple op: Op regs: Array(Int) end

    condEq: Cond
    condNe: Cond
    condLt: Cond
    condGe: Cond
    condGt: Cond
    condLe: Cond
    condLo: Cond
    condHs: Cond
    condHi: Cond
    condLs: Cond
    condMi: Cond
    condPl: Cond
    condVs: Cond
    condVc: Cond
    (* The condition that holds where c does not *)
    inverse(c: Cond): Cond
    (* Flags (n, z, c, and v, from bit 3 to bit 0) under which c is false *)
    falsifying(c: Cond): Int
    (* Whether n is a logical immediate: a rotation of a run of ones (not all
     * of them), in each element of 2, 4, 8, 16, 32, or 64 bits, repeated *)
    isLogical(n: Int): Bool
    (* The halfword shift (0 to 3) at which n is its one nonzero halfword (0
     * for 0), or ~1 *)
    soleHalfword(n: Int): Int
    (* Whether one mov makes n: movz of its one nonzero halfword, movn of its
     * complement's, or orr of a logical immediate *)
    isMovImm(n: Int): Bool
    (* How many leading registers in its register array op writes *)
    results(op: Op): Int
    (* Whether op is a pure value computation with no memory, flag, control,
     * or partial-register effects *)
    pure(op: Op): Bool

    arithAdd: Arith
    arithSub: Arith
    arithMul: Arith
    arithUmulh: Arith
    arithSdiv: Arith
    arithAnd: Arith
    arithOrr: Arith
    arithEor: Arith
    arithLsl: Arith
    arithLsr: Arith
    arithAsr: Arith
    arithFadd: Arith
    arithFsub: Arith
    arithFmul: Arith
    arithFdiv: Arith

    relocPage: Reloc
    relocGot: Reloc

    offset(imm: Int): Mode
    modeBase: Mode
    indexed(shift: Int): Mode
    pre(imm: Int): Mode
    post(imm: Int): Mode
    pageOff(symbol: String reloc: Reloc): Mode

    load64: Load
    loadS32: Load
    loadS8: Load
    loadU8: Load
    store64: Store
    store32: Store
    store8: Store

    (* The instructions, by their operations *)
    movImm(d: Int imm: Int): Inst
    movz(d: Int imm: Int shift: Int): Inst
    movk(d: Int imm: Int shift: Int): Inst
    movConst(d: Int imm: Int): Inst
    symbolAddress(d: Int symbol: String offset: Int local: Bool): Inst
    mov(d: Int s: Int): Inst
    arith(a: Arith d: Int x: Int y: Int): Inst
    adds(d: Int x: Int y: Int): Inst
    addImm(d: Int s: Int imm: Int shift: Int): Inst
    subImm(d: Int s: Int imm: Int): Inst
    andImm(d: Int s: Int imm: Int): Inst
    logicImm(a: Arith d: Int s: Int imm: Int): Inst
    shiftImm(a: Arith d: Int s: Int imm: Int): Inst
    msub(d: Int x: Int y: Int z: Int): Inst
    sxtb(d: Int s: Int): Inst
    scvtf(d: Int s: Int): Inst
    sxtw(d: Int s: Int): Inst
    cmp(x: Int y: Int): Inst
    fcmp(x: Int y: Int): Inst
    cmpImm(x: Int imm: Int): Inst
    ccmp(x: Int y: Int nzcv: Int c: Cond): Inst
    ccmpImm(x: Int imm: Int nzcv: Int c: Cond): Inst
    cset(c: Cond d: Int): Inst
    csel(c: Cond d: Int x: Int y: Int): Inst
    load(l: Load t: Int base: Int m: Mode): Inst
    store(s: Store t: Int base: Int m: Mode): Inst
    (* A load or store at base plus index, shifted left by shift *)
    loadIndex(l: Load t: Int base: Int index: Int shift: Int): Inst
    storeIndex(s: Store t: Int base: Int index: Int shift: Int): Inst
    ldp(a: Int b: Int base: Int m: Mode): Inst
    stp(a: Int b: Int base: Int m: Mode): Inst
    adrp(d: Int symbol: String reloc: Reloc): Inst
    addPageOff(d: Int s: Int symbol: String): Inst
    adr(d: Int label: String): Inst
    b(label: String): Inst
    bSymbol(symbol: String): Inst
    bl(symbol: String): Inst
    blr(r: Int): Inst
    br(r: Int): Inst
    ret: Inst
    cbz(r: Int label: String): Inst
    cbnz(r: Int label: String): Inst
    tbz(r: Int bit: Int label: String): Inst
    tbnz(r: Int bit: Int label: String): Inst
    bCond(c: Cond label: String): Inst
    brk(imm: Int): Inst
    nop: Inst
    label(l: String): Inst
    jumpTable(label: String): Inst
    jumpEntry(table: String label: String): Inst
    jumpTableEnd: Inst
    cfiDefCfa(r: Int offset: Int): Inst
    cfiOffset(r: Int offset: Int): Inst
    loc(file: Int line: Int col: Int): Inst
end
