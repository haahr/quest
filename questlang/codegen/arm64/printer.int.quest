(* Quest Self-Hosted Compiler: The arm64 Printer Interface
 *
 * This module formats codegen/arm64/minst instructions as Darwin arm64
 * assembly text, and is the only part of the arm64 backend that renders
 * instructions as strings. Registers are printed by their architectural names
 * (with an x register's 32-bit low half as a w register), and symbols and
 * relocations are formatted by codegen/arm64/asm. Loads and stores with an
 * immediate offset use the scaled form (such as ldr) when the offset is a
 * non-negative multiple of the access width that fits in the instruction's
 * immediate field, and the unscaled form (such as ldur) otherwise. *)

interface Printer
import
    questlang/codegen/arm64/minst : questlang/codegen/arm64/Minst
export
    (* Register naming callbacks: full name, 32-bit half name, and whether a
     * register is a floating-point (d) register *)
    Def Names = Tuple full: All(r: Int) String half: All(r: Int) String real: All(r: Int) Bool end
    (* arm64's own names, of codegen/arm64/target's numbers *)
    physical: Names
    (* The assembly lines for an operation: a label is formatted with a
     * trailing colon, a jump table header emits its directive and label, and
     * every other instruction (after expanding pseudo-instructions such as
     * multi-instruction constants or symbol addresses) or directive is
     * indented with a tab *)
    lines(op: minst.Op regs: Array(Int) names: Names): Array(String)
    (* The number of 4-byte instruction words an operation emits: 0 for a
     * label or directive, 1 for an ordinary instruction or jump-table entry,
     * and the expanded length for a pseudo-instruction *)
    count(op: minst.Op): Int
    (* The expanded machine instructions for a pseudo-instruction, or a
     * single-element array containing the operation itself *)
    expansion(op: minst.Op regs: Array(Int)): Array(minst.Inst)
    (* Whether a load or store of width bytes with mode m takes its unscaled
     * form (ldur, stur): an offset that is negative, not a multiple of width,
     * or too large for the 12-bit scaled immediate *)
    unscaledOffset(m: minst.Mode width: Int): Bool
end
