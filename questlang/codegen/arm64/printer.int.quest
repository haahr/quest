(* Quest Self-Hosted Compiler: The arm64 Printer Interface
 *
 * Spells codegen/arm64/minst's instructions as Darwin's assembler reads them,
 * the only part of the arm64 backend that writes instructions as text: a
 * register by its name (an x register's low half as a w register), a symbol
 * and a relocation as codegen/arm64/asm spells them, and a load or store with
 * an immediate offset in its scaled form (ldr) where the offset is a multiple
 * of the width that fits, else its unscaled form (ldur). *)

interface Printer
import
    questlang/codegen/arm64/minst : questlang/codegen/arm64/Minst
export
    (* How registers are named: a register's name, or its 32-bit half's; and
     * whether it is a d register *)
    Def Names = Tuple full: All(r: Int) String half: All(r: Int) String real: All(r: Int) Bool end
    (* arm64's own names, of codegen/arm64/target's numbers *)
    physical: Names
    (* An instruction's lines: a label's name and a colon, else for each
     * instruction it is (a constant's movz and movk, a symbol's adrp and
     * add) or directive, a tab and its text *)
    lines(op: minst.Op regs: Array(Int) names: Names): Array(String)
    (* How many instructions an operation is: none for a label or a
     * directive, more than one for a pseudo-instruction *)
    count(op: minst.Op): Int
end
