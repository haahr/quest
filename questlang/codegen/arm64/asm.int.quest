(* Quest Self-Hosted Compiler: arm64 Assembly Interface
 *
 * This interface isolates Darwin (macOS) arm64 assembly syntax
 * (docs/arm64.md section 3.11) in one module so that targeting another object
 * format requires replacing only this module. It formats symbol names with
 * their leading underscore, code and data sections, data directives, and
 * relocations (linker placeholders that address a symbol by its memory page
 * and page offset, or through the GOT for an external symbol). *)

interface Asm
import
    questlang/codegen/arm64/minst : questlang/codegen/arm64/Minst
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    (* A C symbol as the assembler names it *)
    symbol(name: String): String
    (* An Int as the assembler spells it (conv.int spells a negative one
     * with ~) *)
    decimal(n: Int): String
    (* Returns name with a relocation modifier for use as an instruction
     * operand: either the 4 KB page address or the offset within that page
     * (when pageOffset is true), targeting the symbol directly or its GOT
     * entry. A GOT (global offset table)
     * entry is a word the linker or loader fills with the symbol's address so
     * code can reach a symbol defined in another binary image. *)
    reference(name: String reloc: minst.Reloc pageOffset: Bool): String
    (* The directives that begin a function's code, and end it *)
    functionStart(name: String exported: Bool): Array(String)
    functionEnd: Array(String)
    (* A datum's directives *)
    data(d: ssa.Data): Array(String)
    (* The directives that begin and end a unit *)
    unitStart: Array(String)
    unitEnd: Array(String)

    (* Emits the debug line table's source files (docs/arm64.md section 3.16).
     * Produces a .file directive for each non-empty absolute path, numbered
     * from 1 so minst's loc instructions can refer to them by index, and
     * skips empty paths that represent unknown files. *)
    files(paths: Array(String)): Array(String)
    (* A function, for the debugging information: its symbol, and the label
     * just past its code *)
    Def DebugFunction = Tuple symbol: String endLabel: String end
    (* Emits the DWARF debugging sections that a debugger uses to read the
     * line table, since the assembler does not synthesize them from .loc
     * directives alone. The output includes a compile unit named for file
     * (an absolute path) with a subprogram entry for each function so that
     * dsymutil and lldb map each function's lines to its address, followed by
     * the line table section that the assembler populates from .loc
     * directives. *)
    debugInfo(file: String functions: Array(DebugFunction)): Array(String)

    (* Emits a unit's GC frame table (the stack-map table that
     * runtime/quest_gc.c uses to locate live pointers in stack frames;
     * docs/arm64.md section 3.13) under symbol in read-only data beside the
     * code. The table stores the first function's offset from the table, each
     * listed function's offset from first (both resolved by the linker), the
     * byte offset of each function's frame description, and the description
     * bytes themselves. *)
    Def FrameFunction = Tuple symbol: String description: Int end
    frames(symbol: String first: String listed: Array(FrameFunction) descriptions: Array(Int)): Array(String)
end
