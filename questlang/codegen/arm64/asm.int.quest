(* Quest Self-Hosted Compiler: arm64 Assembly Interface
 *
 * The spellings of Darwin's arm64 assembly (docs/arm64.md section 3.11), in one
 * module, so that another object format would replace only it: symbols with
 * their leading underscore, the sections of code and data, the relocations
 * that address a symbol (its page and offset in it, through the GOT for one
 * the unit does not define, through its descriptor for a thread-local), and
 * data directives. *)

interface Asm
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/codegen/arm64/minst : questlang/codegen/arm64/Minst
export
    (* A C symbol as the assembler names it *)
    symbol(name: String): String
    (* An Int as the assembler spells it (conv.int spells a negative one
     * with ~) *)
    decimal(n: Int): String
    (* A symbol with a relocation, as an instruction's operand: its page, or
     * its offset in its page, or its GOT entry's, or its thread-local
     * descriptor's *)
    reference(name: String reloc: minst.Reloc pageOffset: Bool): String
    (* The directives that begin a function's code, and end it *)
    functionStart(name: String exported: Bool): Array(String)
    functionEnd: Array(String)
    (* A datum's directives *)
    data(d: ssa.Data): Array(String)
    (* The directives that begin and end a unit *)
    unitStart: Array(String)
    unitEnd: Array(String)
end
