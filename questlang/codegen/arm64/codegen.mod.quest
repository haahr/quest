(* Quest Self-Hosted Compiler: The arm64 Backend's Code Generator
 * Implementation *)

module codegen : Codegen
import
    conv : Conv
    stringOp = string : StringOp
    system : System

    collections/bitset : collections/Bitset
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/codegen/arm64/asm : questlang/codegen/arm64/Asm
    questlang/codegen/arm64/encode : questlang/codegen/arm64/Encode
    questlang/codegen/arm64/minst : questlang/codegen/arm64/Minst
    questlang/codegen/arm64/peephole : questlang/codegen/arm64/Peephole
    questlang/codegen/arm64/printer : questlang/codegen/arm64/Printer
    questlang/codegen/arm64/select : questlang/codegen/arm64/Select
    questlang/codegen/arm64/target : questlang/codegen/arm64/Target
    questlang/codegen/machine/machine : questlang/codegen/machine/Machine
    questlang/codegen/machine/regalloc : questlang/codegen/machine/Regalloc
    targets = questlang/codegen/machine/target : questlang/codegen/machine/Target
    questlang/common/maps : questlang/common/Maps
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    Let Function = ssa.Function
    Let Lines = vector.T(String)
    Let Code = vector.T(minst.Inst)

    let unsupported: Exception(String) = exception unsupported: String end
    let eq(a: String b: String): Bool = stringOp.equal(a b)
    let put(K::TYPE V::TYPE m: hashMap.T(K V) k: K v: V): Ok = begin hashMap.insert(m k v) ok end
    let contains(xs: Array(Int) x: Int): Bool =
        begin
            let var found = false
            for i = 0 upto {extent xs - 1} do if xs[i] is x then found := true end end
            found
        end
    let alignUp(n: Int a: Int): Int = {{{n + a} - 1} / a} * a

    (* Register shorthands used by frame lowering: scratch registers (x9 for
     * a large frame's size, x16 for large frame offsets) and the frame
     * registers (sp, fp, lr) *)
    let x9 = target.x(9)
    let x16 = target.x(16)
    let sp = target.sp
    let fp = target.fp
    let lr = target.lr

    (* =========================================================================
     * Per-function compilation: instruction selection, register allocation,
     * frame layout, and call-site GC maps. Below the frame record and saved
     * callee-saved registers, a frame lays out the outgoing-argument area at
     * sp, then the function's explicit stack slots, then spill slots for
     * virtual registers stored in memory.
     * ====================================================================== *)

    Let FrameSlot = Tuple offset: Int bytes: Int type: maybe.T(ssa.Type) id: Int end

    (* GC root map for a single call site (docs/arm64.md section 3.13).
     * registers packs two bits per callee-saved register x19-x28 (0 = dead,
     * 1 = ptr, 2 = ambiguous word for int or val). slots lists each live
     * spill-slot word as 2 * (word index from sp) + (0 for ptr, 1 for
     * ambiguous word). *)
    Let CallMap = Tuple registers: Int slots: Array(Int) end
    (* Frame-table entry for one function. below is the number of 8-byte words
     * from sp to the frame record, saved is a bitmask of saved callee-saved
     * pairs (indexed by savedFirsts), undescribed is the number of words at
     * sp scanned conservatively (outgoing arguments and stack slots), and
     * calls records each call site's return offset (in instructions from the
     * function's start) and GC root map. *)
    Let CallSite = Tuple offset: Int map: CallMap end
    Let Frame = Tuple below: Int saved: Int undescribed: Int calls: Array(CallSite) end

    Let Compiled = Tuple
        selection: select.Selection
        (* The frame's size below the saved registers, and its slots *)
        size: Int
        slots: Array(FrameSlot)
        (* The pairs of callee-saved registers it saves (indices in
         * savedFirsts and savedSeconds): every pair if it enters a try, else
         * those its values use *)
        saved: Array(Int)
        (* With QUEST_LIVE_SLOTS=1, for each block's calls in order, where
         * the values live across each are: their slots and registers *)
        liveAtCalls: Array(Array(String))
        (* For each block's calls in order, the map of each; none for a
         * function that enters a try, whose frame is scanned whole *)
        maps: Array(Array(CallMap))
    end

    (* A word's bytes, and a pair's: what one stp stores, a pair of saved
     * registers or the frame record (fp and lr) *)
    let wordBytes = target.description.wordBytes
    let pairBytes = 2 * wordBytes

    (* Callee-saved register pairs in the order they are pushed below the
     * frame record: each class's callee-saved registers
     * (target.description.calleeSaved, x19-x28 then d8-d15) two at a time.
     * Each pair stores its higher-numbered register at the lower address (for
     * example, stp x20, x19) to match Darwin's compact unwind encoding. The
     * opposite order would force the assembler to fall back to DWARF unwind
     * tables, which libunwind must interpret on every stack frame during an
     * exception raise (docs/arm64.md section 3.10). The frame table numbers
     * the pairs in this order (Frame.saved), as the collector reads them
     * (runtime/quest_gc.c). *)
    Let SavedPairs = Tuple firsts: Array(Int) seconds: Array(Int) end
    let savedPairs: SavedPairs =
        begin
            let firsts = vector.new(:Int)
            let seconds = vector.new(:Int)
            for c = 0 upto {targets.classes - 1} do
                let cs = target.description.calleeSaved[c]
                if {extent cs % 2} isnot 0 then
                    raise unsupported with "the callee-saved " <> target.description.registers[cs[0]].name
                        <> " and the rest are not in pairs"
                    end
                end
                for k = 0 upto {{extent cs / 2} - 1} do
                    vector.append(firsts cs[{2 * k} + 1])
                    vector.append(seconds cs[2 * k])
                end
            end
            tuple let firsts = vector.toArray(firsts) let seconds = vector.toArray(seconds) end
        end
    let savedFirsts = savedPairs.firsts
    let savedSeconds = savedPairs.seconds

    (* The callee-saved registers a call map describes, two bits each, in
     * order: the integer class's (x19-x28), which the collector reads as x19
     * and up (runtime/quest_gc.c) *)
    let mapped: Array(Int) =
        begin
            let cs = targets.at(target.description.calleeSaved targets.classInt)
            for k = 0 upto {extent cs - 1} do
                if cs[k] isnot target.x(19 + k) then
                    raise unsupported with "the collector's frame maps take the callee-saved registers to be x19 and up"
                    end
                end
            end
            cs
        end

    (* Loads or stores the 8-byte frame slot at sp + off. Offsets up to 32760
     * (8 * 4095) fit in a scaled immediate; larger offsets compute the base
     * page in x16 first. *)
    let frameAccess(s: select.Selection off: Int access: All(base: Int m: minst.Mode) minst.Inst):
            Array(machine.Inst) =
        if off <= 32760 then
            array of select.make(s machine.kindOrdinary access(sp minst.offset(off))) end
        else
            let low = off - {4096 * {off / 4096}}
            array of
                select.make(s machine.kindOrdinary minst.addImm(x16 sp off / 4096 12))
                select.make(s machine.kindOrdinary access(x16 minst.offset(low)))
            end
        end

    (* Whether an operation is a jump table's end, which leaves its block
     * by the br before the table, not by returning *)
    let isTableEnd(op: minst.Op): Bool = case op when opJumpTableEnd then true else false end

    let isBrk(op: minst.Op): Bool = case op when opBrk then true else false end

    (* Whether an operation calls the runtime for a proxy: the slow path of a
     * tuple's or option's access that may meet one, which programs rarely
     * take (most make no proxies) *)
    let callsProxy(op: minst.Op): Bool =
        case op
            when opBl with x then
                strutil.startsWith(x.symbol "_quest_proxy_") orif strutil.startsWith(x.symbol "quest_proxy_")
            else false
        end

    (* Marks blocks from which every path raises an exception: a block that
     * ends in brk (unreachable after a raise), or a block that does not
     * return and whose successors are all cold; and a proxy's slow path, a
     * block that calls the runtime for one, which a program rarely takes, so
     * that the allocator charges it little and gives the hot path the
     * registers at the join, and the layout puts it out of line *)
    let coldBlocks(s: select.Selection): Array(Bool) =
        begin
            let m = s.f
            let n = vector.length(m.blocks)
            let cold = array of(n false)
            let var changed = true
            while changed do
                changed := false
                for b = 0 upto {n - 1} do
                    if not(cold[b]) then
                        let insts = machine.block(m b).insts
                        let var raises = false
                        let var leaves = false
                        let var exits = 0
                        let var hot = false
                        for j = 0 upto {vector.length(insts) - 1} do
                            let i = vector.get(insts j)
                            if callsProxy(vector.get(s.ops i.op)) then raises := true end
                            if machine.isKind(i machine.kindReturn) then
                                if isBrk(vector.get(s.ops i.op)) then raises := true else leaves := true end
                            end
                            if i.target >= 0 then
                                exits := exits + 1
                                if not(cold[i.target]) then hot := true end
                            end
                        end
                        if raises orif {not(leaves) andif {exits > 0} andif not(hot)} then
                            cold[b] := true
                            changed := true
                        end
                    end
                end
            end
            cold
        end

    (* Returns, for each block's calls in code order, a formatted list of the
     * virtual registers live across that call and their locations afterward
     * (stack slot offset from sp and/or physical register). Computed by
     * walking each block backward from its live-out set. Used under
     * QUEST_LIVE_SLOTS=1 to inspect what a garbage collection during a call
     * actually needs to keep live (docs/profiling.md section 6). *)
    let describeLive(s: select.Selection a: regalloc.Allocation spillAt: Array(Int)): Array(Array(String)) =
        begin
            let m = s.f
            let nBlocks = vector.length(m.blocks)
            let n = machine.virtuals(m)
            let live = machine.live(m)
            let described = array of(nBlocks array of :String end)
            for b = 0 upto {nBlocks - 1} do
                if a.blockStart[b] >= 0 then
                    let insts = machine.block(m b).insts
                    let cur = bitset.new(n)
                    bitset.assign(cur live.liveOut[b])
                    let found = vector.new(:String)
                    for j = {vector.length(insts) - 1} downto 0 do
                        let i = vector.get(insts j)
                        if machine.isKind(i machine.kindCall) then
                            let p = a.blockStart[b] + {2 * {j + 1}}
                            let parts = vector.new(:String)
                            let vs = bitset.elements(cur)
                            for k = 0 upto {extent vs - 1} do
                                let v = vs[k]
                                let what = "%" <> conv.int(v) <> " " <> ssa.typeName(vector.get(s.types v))
                                if regalloc.needsSlot(a v) then
                                    vector.append(parts "sp+" <> conv.int(spillAt[v]) <> " " <> what)
                                end
                                let h = regalloc.home(a v p + 1)
                                if h isnot regalloc.memory then
                                    vector.append(parts target.description.registers[h].name <> " " <> what)
                                end
                            end
                            vector.append(found strutil.join(", " parts))
                        end
                        for k = 0 upto {extent i.operands - 1} do
                            let o = i.operands[k]
                            if machine.isVirtual(m o.reg) andif o.defines then
                                begin let ignored = bitset.remove(cur machine.index(m o.reg)) end
                            end
                        end
                        for k = 0 upto {extent i.operands - 1} do
                            let o = i.operands[k]
                            if machine.isVirtual(m o.reg) andif not(o.defines) then
                                begin let ignored = bitset.insert(cur machine.index(m o.reg)) end
                            end
                        end
                    end
                    let ordered = vector.toArray(found)
                    let r = array of(extent ordered "")
                    for k = 0 upto {extent ordered - 1} do r[k] := ordered[{extent ordered - 1} - k] end
                    described[b] := r
                end
            end
            described
        end

    (* Classifies an SSA type for garbage-collection root maps: 1 for ptr (a
     * heap pointer), 2 for int or val (an ambiguous word scanned
     * conservatively: a val's pointer-ness depends on its runtime type
     * descriptor, and an int may hold pointer bits from ptrToInt after the
     * ptr itself is dead), and 0 for real (never a pointer) *)
    let wordClass(t: ssa.Type): Int = case t when typePtr then 1 when typeInt, typeVal then 2 when typeReal then 0 end

    (* Builds the GC root map for each call site in each block, in code order,
     * using the same backward liveness walk as describeLive (docs/arm64.md
     * section 3.13). A live value with a spill slot is recorded at that slot,
     * which holds it throughout its lifetime. A live value with no spill slot
     * is recorded in its physical register, which must be callee-saved
     * because calls clobber all other registers. Rematerialized values (such
     * as constants or static addresses) have neither a slot nor a register
     * and never point into the heap. *)
    let callMaps(s: select.Selection a: regalloc.Allocation spillAt: Array(Int)): Array(Array(CallMap)) =
        begin
            let m = s.f
            let nBlocks = vector.length(m.blocks)
            let n = machine.virtuals(m)
            let live = machine.live(m)
            let maps = array of(nBlocks array of :CallMap end)
            for b = 0 upto {nBlocks - 1} do
                if a.blockStart[b] >= 0 then
                    let insts = machine.block(m b).insts
                    let cur = bitset.new(n)
                    bitset.assign(cur live.liveOut[b])
                    let found = vector.new(:CallMap)
                    for j = {vector.length(insts) - 1} downto 0 do
                        let i = vector.get(insts j)
                        for k = 0 upto {extent i.operands - 1} do
                            let o = i.operands[k]
                            if machine.isVirtual(m o.reg) andif o.defines then
                                begin let ignored = bitset.remove(cur machine.index(m o.reg)) end
                            end
                        end
                        if machine.isKind(i machine.kindCall) then
                            let p = a.blockStart[b] + {2 * {j + 1}}
                            let classes = array of(extent mapped 0)
                            let slots = vector.new(:Int)
                            let vs = bitset.elements(cur)
                            for k = 0 upto {extent vs - 1} do
                                let v = vs[k]
                                let class = wordClass(vector.get(s.types v))
                                if class > 0 then
                                    if regalloc.needsSlot(a v) then
                                        vector.append(slots {2 * {spillAt[v] / 8}} + {class - 1})
                                    else
                                        let h = regalloc.home(a v p + 1)
                                        if h isnot regalloc.memory then
                                            let var r = ~1
                                            for x = 0 upto {extent mapped - 1} do if h is mapped[x] then r := x end end
                                            if r < 0 then
                                                raise unsupported with "a value live across a call in "
                                                    <> target.description.registers[h].name
                                                end
                                            end
                                            if class > classes[r] then classes[r] := class end
                                        end
                                    end
                                end
                            end
                            let var registers = 0
                            for x = {extent mapped - 1} downto 0 do registers := {4 * registers} + classes[x] end
                            vector.append(found tuple
                                let registers = registers
                                let slots = vector.toArray(slots)
                            end)
                        end
                        for k = 0 upto {extent i.operands - 1} do
                            let o = i.operands[k]
                            if machine.isVirtual(m o.reg) andif not(o.defines) then
                                begin let ignored = bitset.insert(cur machine.index(m o.reg)) end
                            end
                        end
                    end
                    let backward = vector.toArray(found)
                    let r = array of(extent backward tuple let registers = 0 let slots = array of :Int end end)
                    for k = 0 upto {extent backward - 1} do r[k] := backward[{extent backward - 1} - k] end
                    maps[b] := r
                end
            end
            maps
        end

    (* Compiles f with labels prefixed Lf<index>, using defined (from
     * definedSymbols) to know which callees extend narrow results. It selects
     * instructions, runs register allocation, lays out stack slots and spill
     * slots, builds call-site GC maps, and rewrites virtual registers into
     * physical registers and frame accesses. Functions that enter a try save
     * every callee-saved pair: an exception raise resumes at the handler with
     * the registers left by the raising function rather than restored by
     * intermediate frames, so the function must restore all of its caller's
     * callee-saved registers from its own frame. *)
    let compile(f: Function index: Int defined: maps.StringMap(Bool)): Compiled =
        begin
            let s = select.select(f "Lf" <> conv.int(index) defined)
            let m = s.f
            let cold = coldBlocks(s)
            let kind = fun(v: Int): Int
                case vector.get(s.types machine.index(m v))
                    when typeInt then 0
                    when typePtr then 1
                    when typeVal then 2
                    when typeReal then 3
                end
            let rematerializable = fun(i: machine.Inst): Bool select.rematerializable(s i)
            (* Coalesced first, unless it enters a try, whose handlers reload
             * each value from a slot of its own (docs/arm64.md section 3.8) *)
            let a =
                if not(s.entersTry) then
                    regalloc.coalesceAndAllocate(m target.description kind rematerializable
                            fun(b: Int): Bool
                                cold[b])
                else
                    regalloc.allocate(m target.description rematerializable fun(b: Int): Bool cold[b])
                end
            (* The stack slots, then (below) the slots of registers stored in
             * memory *)
            let slots = vector.new(:FrameSlot)
            for k = 0 upto {extent s.slotAt - 1} do
                let slot = vector.get(f.slots k)
                vector.append(slots tuple
                    let offset = s.slotAt[k]
                    let bytes = alignUp(if slot.bytes > 0 then slot.bytes else 8 end 8)
                    let type = maybe.none(:ssa.Type)
                    let id = k
                end)
            end
            let n = machine.virtuals(m)
            let spillAt = array of(n ~1)
            let lowering = tuple
                let move = fun(dst: Int src: Int): machine.Inst select.make(s machine.kindMove minst.mov(dst src))
                let load = fun(dst: Int v: Int): Array(machine.Inst)
                    frameAccess(s spillAt[machine.index(m v)] fun(base: Int mode: minst.Mode): minst.Inst
                        minst.load(minst.load64 dst base mode))
                let store = fun(src: Int v: Int): Array(machine.Inst)
                    frameAccess(s spillAt[machine.index(m v)] fun(base: Int mode: minst.Mode): minst.Inst
                        minst.store(minst.store64 src base mode))
                let scratch = target.description.scratch
            end
            (* Values of the same SSA type share spill slots when their
             * lifetimes do not overlap (docs/arm64.md section 3.8), so each
             * slot has a single type throughout the function and takes its id
             * from the first value assigned to it. Functions that enter a try
             * skip sharing: an exception handler reloads its values from
             * spill slots after a raise from anywhere in the try body, where
             * normal liveness does not see the handler's uses, so each
             * spilled value keeps its own slot. *)
            let slotOf =
                if s.entersTry then
                    begin
                        let own = array of(n ~1)
                        for v = 0 upto {n - 1} do own[v] := v end
                        own
                    end
                else
                    regalloc.shareSlots(m a kind)
                end
            let offsetOf = array of(n ~1)
            let var at = s.slotsEnd
            for v = 0 upto {n - 1} do
                if regalloc.needsSlot(a v) then
                    let k = slotOf[v]
                    if offsetOf[k] < 0 then
                        offsetOf[k] := at
                        vector.append(slots tuple
                            let offset = at
                            let bytes = 8
                            let type = maybe.some(vector.get(s.types v))
                            let id = v
                        end)
                        at := at + 8
                    end
                    spillAt[v] := offsetOf[k]
                end
            end
            let liveAtCalls =
                if stringOp.equal(system.getEnv("QUEST_LIVE_SLOTS") "1") then
                    describeLive(s a spillAt)
                else
                    array of(vector.length(m.blocks) array of :String end)
                end
            let maps = if s.entersTry then array of(vector.length(m.blocks) array of :CallMap end)
                else callMaps(s a spillAt) end
            regalloc.rewrite(m a lowering)
            let savedList = vector.new(:Int)
            for k = 0 upto {extent savedFirsts - 1} do
                let used = contains(a.calleeUsed savedFirsts[k]) orif contains(a.calleeUsed savedSeconds[k])
                if s.entersTry orif used then vector.append(savedList k) end
            end
            tuple
                let selection = s
                let size = alignUp(at target.description.stackAlign)
                let slots = vector.toArray(slots)
                let saved = vector.toArray(savedList)
                let liveAtCalls = liveAtCalls
                let maps = maps
            end
        end

    let frameSlots(f: Function): Array(FrameSlot) = compile(f 0 maps.newStringMap()).slots

    (* =========================================================================
     * Emitting a function's code: the prologue, each block's instructions,
     * and the epilogue before each return
     * ====================================================================== *)

    Let Emitter = Tuple
        c: Compiled
        code: Code
    end

    let emit(e: Emitter i: minst.Inst): Ok = vector.append(e.code i)

    (* Emits DWARF .cfi_offset directives for the saved callee-saved pairs:
     * for pair k, the first register is at CFA - 16 * (k + 2) (the frame
     * record's pair and k + 1 pairs below the CFA) and the second is a word
     * above it. Emitting the second register before the first,
     * walking downward from the frame record, matches the order the Darwin
     * assembler requires to synthesize a compact unwind entry. *)
    let savedOffsets(e: Emitter): Ok =
        begin
            let saved = e.c.saved
            for k = 0 upto {extent saved - 1} do
                emit(e minst.cfiOffset(savedSeconds[saved[k]] {0 - {pairBytes * {k + 2}}} + wordBytes))
                emit(e minst.cfiOffset(savedFirsts[saved[k]] 0 - {pairBytes * {k + 2}}))
            end
        end

    (* Emits the function prologue: the frame record (fp, lr), the saved
     * callee-saved pairs below it, unwind directives, and the local frame
     * allocation. The lowest saved pair is stored first with a single sp
     * decrement, matching clang, so a stack overflow faults on the prologue's
     * very first store or not at all. Storing pairs downward one by one could
     * fault after the frame record was already written above the guard page,
     * causing a crash backtrace using compact unwind info (which assumes a
     * complete prologue) to read the unsaved pair from the guard page. *)
    let prologue(e: Emitter): Ok =
        begin
            let saved = e.c.saved
            let n = extent saved
            if n is 0 then
                emit(e minst.stp(fp lr sp minst.pre(0 - pairBytes)))
                emit(e minst.mov(fp sp))
            else
                let last = saved[n - 1]
                emit(e minst.stp(savedFirsts[last] savedSeconds[last] sp minst.pre(0 - {pairBytes * {n + 1}})))
                for k = {n - 2} downto 0 do
                    emit(e minst.stp(savedFirsts[saved[k]] savedSeconds[saved[k]] sp
                            minst.offset(pairBytes * {{n - 1} - k})))
                end
                emit(e minst.stp(fp lr sp minst.offset(pairBytes * n)))
                emit(e minst.addImm(fp sp pairBytes * n 0))
            end
            emit(e minst.cfiDefCfa(fp pairBytes))
            emit(e minst.cfiOffset(lr 0 - wordBytes))
            emit(e minst.cfiOffset(fp 0 - pairBytes))
            savedOffsets(e)
            (* A frame of more than a page is probed a page at a time, as clang
             * does, so that a stack overflow faults in the guard page rather
             * than past it (docs/arm64.md section 3.10) *)
            let size = e.c.size
            if size is 0 then ok
            elsif size <= 4096 then
                emit(e minst.subImm(sp sp size))
            else
                emit(e minst.movConst(x9 size))
                emit(e minst.bl("__chkstk_darwin"))
                emit(e minst.movConst(x9 size))
                emit(e minst.arith(minst.arithSub sp sp x9))
            end
        end

    (* Emits the epilogue that pops the frame and restores callee-saved
     * registers, fp, and lr, without emitting ret *)
    let restore(e: Emitter): Ok =
        begin
            let saved = e.c.saved
            if extent saved > 0 then
                emit(e minst.subImm(sp fp pairBytes * extent saved))
                for k = {extent saved - 1} downto 0 do
                    emit(e minst.ldp(savedFirsts[saved[k]] savedSeconds[saved[k]] sp minst.post(pairBytes)))
                end
            else
                emit(e minst.mov(sp fp))
            end
            emit(e minst.ldp(fp lr sp minst.post(pairBytes)))
        end

    (* =========================================================================
     * Functions and the unit
     * ====================================================================== *)

    (* Orders blocks for emission into fall-through chains, mapping each block
     * through final to skip jump-only blocks. Starting from the entry block,
     * each block is followed by its best unplaced non-cold successor so the
     * branch can fall through; when none remains, the next unplaced non-cold
     * block from the builder's layout starts a new chain. Among non-cold
     * successors, deeper loop nesting wins first, then a block that enters a
     * deeper loop (a loop's preheader, as Ball and Larus predict a branch into
     * a loop taken: a rotated loop's guard otherwise fell through to its exit,
     * and took two jumps to enter, which cost fib 1.17 times the cycles), then
     * blocks without calls (keeping a fast path ahead of a proxy's slow
     * path), then earlier layout order. Cold blocks (from which every path raises) are placed last in
     * layout order; otherwise a check's raising block or a proxy's slow path
     * would sit inline and force the hot path to jump over it on every
     * execution (docs/arm64.md section 3.5). *)
    let chains(s: select.Selection final: Array(Int)): Array(Int) =
        begin
            let m = s.f
            let cold = coldBlocks(s)
            let depth = machine.loopDepths(m)
            let count = vector.length(s.layout)
            let n = vector.length(m.blocks)
            let at = array of(n ~1)
            for k = 0 upto {count - 1} do at[vector.get(s.layout k)] := k end
            let calls = array of(n false)
            (* Whether a block branches to a block nested in more loops *)
            let enters = array of(n false)
            for b = 0 upto {n - 1} do
                let insts = machine.block(m b).insts
                for j = 0 upto {vector.length(insts) - 1} do
                    let i = vector.get(insts j)
                    if machine.isKind(i machine.kindCall) then calls[b] := true end
                    if {i.target >= 0} andif {depth[final[i.target]] > depth[b]} then enters[b] := true end
                end
            end
            (* Each block's predecessors, by the branches that name it *)
            let preds = array of(n 0)
            let onlyPred = array of(n ~1)
            for b = 0 upto {n - 1} do
                let insts = machine.block(m b).insts
                for j = 0 upto {vector.length(insts) - 1} do
                    let t = vector.get(insts j).target
                    if t >= 0 then
                        let ft = final[t]
                        preds[ft] := preds[ft] + 1
                        onlyPred[ft] := b
                    end
                end
            end
            let placed = array of(n false)
            let order = vector.new(:Int)
            let place(b: Int): Ok =
                begin
                    placed[b] := true
                    vector.append(order b)
                end
            let open(b: Int): Bool = {at[b] >= 0} andif {final[b] is b} andif not(placed[b]) andif not(cold[b])
            let better(a: Int b: Int): Bool =
                if depth[a] isnot depth[b] then depth[a] > depth[b]
                elsif enters[a] isnot enters[b] then enters[a]
                elsif calls[a] isnot calls[b] then not(calls[a])
                else at[a] < at[b]
                end
            let var cur = vector.get(s.layout 0)
            let var next = 0
            place(cur)
            let var done = false
            while not(done) do
                let insts = machine.block(m cur).insts
                let var best = ~1
                for j = 0 upto {vector.length(insts) - 1} do
                    let t = vector.get(insts j).target
                    if {t >= 0} andif open(final[t]) andif {{best < 0} orif better(final[t] best)} then
                        best := final[t]
                    end
                end
                (* A new chain does not start at a block that one block alone,
                 * not yet placed and not cold, goes to: that block will place
                 * it as what it falls through to, as a loop's latch does its
                 * test at the loop's bottom, which placed first would put the
                 * test ahead of the loop and a jump back to it at its end *)
                let waits = fun(b: Int): Bool
                    {preds[b] is 1} andif {onlyPred[b] >= 0} andif not(placed[onlyPred[b]]) andif not(cold[onlyPred[b]])
                        andif {final[onlyPred[b]] is onlyPred[b]} andif {onlyPred[b] isnot b}
                if best < 0 then
                    let var k = next
                    while {best < 0} andif {k < count} do
                        let c = vector.get(s.layout k)
                        if open(c) andif not(waits(c)) then best := c end
                        k := k + 1
                    end
                end
                while {best < 0} andif {next < count} do
                    if open(vector.get(s.layout next)) then best := vector.get(s.layout next) end
                    next := next + 1
                end
                if best < 0 then
                    done := true
                else
                    place(best)
                    cur := best
                end
            end
            for k = 0 upto {count - 1} do
                let b = vector.get(s.layout k)
                if not(placed[b]) andif {final[b] is b} then place(b) end
            end
            vector.toArray(order)
        end

    (* Whether a function can omit its frame record: it saves no callee-saved
     * registers, allocates no local frame, makes no calls (a tail call is a
     * branch), and has no instruction referencing fp, lr, or sp (such as a
     * stack-passed argument). Such a function leaves fp and lr untouched and
     * uses frameless unwind info; garbage collection can never see it on the
     * stack because it makes no calls. *)
    let frameless(c: Compiled): Bool =
        if {extent c.saved > 0} orif {c.size > 0} then
            false
        else
            let m = c.selection.f
            let var none = true
            for b = 0 upto {vector.length(m.blocks) - 1} do
                let insts = machine.block(m b).insts
                for j = 0 upto {vector.length(insts) - 1} do
                    let i = vector.get(insts j)
                    if machine.isKind(i machine.kindCall) then none := false end
                    case vector.get(c.selection.ops i.op)
                        when opBl, opBlr then none := false
                        else ok
                    end
                    for r = 0 upto {extent i.operands - 1} do
                        let reg = i.operands[r].reg
                        if {reg is fp} orif {reg is lr} orif {reg is sp} then none := false end
                    end
                end
            end
            none
        end

    (* The label just past the code of the unit's function numbered index *)
    let endLabel(index: Int): String = "Lf" <> conv.int(index) <> "_end"

    (* Where each block's code is: its own, or, passed over, where its jumps
     * lead (its own again for a cycle of blocks that only jump). A non-entry
     * block that is not a raise target and contains only an unconditional
     * jump is bypassed by redirecting incoming edges to its target. *)
    let finalBlocks(m: machine.Function): Array(Int) =
        begin
            let nBlocks = vector.length(m.blocks)
            let passes(b: Int): Bool =
                begin
                    let blk = machine.block(m b)
                    {b > 0} andif not(blk.raised) andif {vector.length(blk.insts) is 1}
                        andif machine.isKind(vector.get(blk.insts 0) machine.kindJump)
                end
            let final = array of(nBlocks 0)
            for b = 0 upto {nBlocks - 1} do
                let var to = b
                let var steps = 0
                while passes(to) andif {steps < nBlocks} do
                    to := vector.get(machine.block(m to).insts 0).target
                    steps := steps + 1
                end
                final[b] := if passes(to) then b else to end
            end
            final
        end

    (* What emitting a function's blocks shares: the emitter, the function's
     * symbol, where each block's code is (finalBlocks), whether the function
     * has no frame, the prefix of the labels that mark mapped calls and the
     * maps of those calls so far, how many live-slot labels it has, and the
     * last source position emitted *)
    Let Emitting = Tuple
        e: Emitter
        symbol: String
        final: Array(Int)
        bare: Bool
        marker: String
        mapped: vector.T(CallMap)
        var liveLabels: Int
        var last: ssa.Loc
    end

    (* Emits block b, which next follows in the layout (~1 for none) *)
    let emitBlock(x: Emitting b: Int next: Int): Ok =
        begin
            let e = x.e
            let s = e.c.selection
            let m = s.f
            let final = x.final
            emit(e minst.label(select.label(s b)))
            let insts = machine.block(m b).insts
            let count = vector.length(insts)
            let var inverted = false
            let var calls = 0
            let var mappedCalls = 0
            for j = 0 upto {count - 1} do
                let i = vector.get(insts j)
                let regs = array of(extent i.operands 0)
                for r = 0 upto {extent regs - 1} do regs[r] := i.operands[r].reg end
                let base = vector.get(s.ops i.op)
                let op = if i.target >= 0 then minst.withLabel(base select.label(s final[i.target])) else base end
                (* If a conditional branch targets the next block and is
                 * immediately followed by a trailing unconditional jump,
                 * invert the condition to branch to the jump's target and
                 * drop the jump. An unconditional jump to the next block also
                 * falls through. *)
                let c = peephole.conditional(op)
                let following =
                    if {j + 1} < count then maybe.some(vector.get(insts j + 1)) else maybe.none(:machine.Inst) end
                let invert = maybe.isSome(c) andif {final[i.target] is next} andif {{j + 2} is count}
                    andif machine.isKind(maybe.unwrap(following) machine.kindJump)
                    andif {final[maybe.unwrap(following).target] isnot next}
                let falls = inverted orif {machine.isKind(i machine.kindJump) andif {final[i.target] is next}}
                (* A jump to a block that only returns returns itself, with
                 * its own epilogue, so that whichever way a branch is laid
                 * out, the path that leaves takes one branch, not a branch and
                 * a jump (tak's base case, once the layout let a rotated
                 * loop's guard fall into the loop) *)
                let returned =
                    if machine.isKind(i machine.kindJump) andif not(falls) then
                        let to = machine.block(m final[i.target])
                        if not(to.raised) andif {vector.length(to.insts) is 1}
                                andif machine.isKind(vector.get(to.insts 0) machine.kindReturn) then
                            let r = vector.get(to.insts 0)
                            let rop = vector.get(s.ops r.op)
                            if isBrk(rop) orif isTableEnd(rop) then maybe.none(:machine.Inst) else maybe.some(r) end
                        else
                            maybe.none(:machine.Inst)
                        end
                    else
                        maybe.none(:machine.Inst)
                    end
                if maybe.isSome(returned) then
                    let r = maybe.unwrap(returned)
                    let rregs = array of(extent r.operands 0)
                    for q = 0 upto {extent rregs - 1} do rregs[q] := r.operands[q].reg end
                    if not(x.bare) then restore(e) end
                    emit(e tuple let op = vector.get(s.ops r.op) let regs = rregs end)
                elsif invert orif not(falls) then
                    (* A .loc directive before each instruction whose source
                     * position differs from the previous one. Rematerialized
                     * values (constants or addresses recomputed at use
                     * sites) still carry their definition's location, so they
                     * do not emit .loc. *)
                    let l = vector.get(s.locs i.op)
                    if ssa.hasLoc(l) andif not(ssa.sameLoc(l x.last)) andif not(select.rematerializable(s i)) then
                        emit(e minst.loc(l.file l.line l.col))
                        x.last := l
                    end
                    if machine.isKind(i machine.kindReturn) andif not(isBrk(op)) andif not(isTableEnd(op))
                            andif not(x.bare) then
                        restore(e)
                    end
                    if invert then
                        let to = select.label(s final[maybe.unwrap(following).target])
                        emit(e tuple let op = maybe.unwrap(c).inverse(to) let regs = regs end)
                        inverted := true
                    else
                        emit(e tuple let op = op let regs = regs end)
                    end
                end
                if machine.isKind(i machine.kindCall) andif {mappedCalls < extent e.c.maps[b]} then
                    emit(e minst.label(x.marker <> conv.int(vector.length(x.mapped))))
                    vector.append(x.mapped e.c.maps[b][mappedCalls])
                    mappedCalls := mappedCalls + 1
                end
                (* Under QUEST_LIVE_SLOTS=1, emit a symbol and comment at the
                 * call's return address recording the frame size and the
                 * values live across the call so a debugger can inspect them
                 * (docs/profiling.md section 6). Marking the symbol
                 * .alt_entry prevents the linker from treating it as a
                 * separate function. *)
                if machine.isKind(i machine.kindCall) andif {calls < extent e.c.liveAtCalls[b]} then
                    let name = asm.symbol(x.symbol <> "_live_" <> conv.int(x.liveLabels))
                    let described = e.c.liveAtCalls[b][calls]
                    let comment = "// live (frame " <> conv.int(e.c.size) <> "): " <> described
                    emit(e minst.label(".alt_entry " <> name <> "\n" <> comment <> "\n" <> name))
                    calls := calls + 1
                    x.liveLabels := x.liveLabels + 1
                end
            end
        end

    (* The code with the labels that mark mapped calls taken out, and each
     * such call's site: its return address's offset, in instructions, and
     * its map *)
    Let Stripped = Tuple code: Code sites: vector.T(CallSite) end
    let stripMarkers(relaxed: Code marker: String mapped: vector.T(CallMap)): Stripped =
        begin
            let code = vector.new(:minst.Inst)
            let sites = vector.new(:CallSite)
            let var at = 0
            for k = 0 upto {vector.length(relaxed) - 1} do
                let i = vector.get(relaxed k)
                case i.op
                    when opLabel with x then
                        if strutil.startsWith(x.label marker) then
                            vector.append(sites tuple
                                let offset = at
                                let map = vector.get(mapped vector.length(sites))
                            end)
                        else
                            vector.append(code i)
                        end
                    else
                        at := at + printer.count(i.op)
                        vector.append(code i)
                end
            end
            tuple let code = code let sites = sites end
        end

    (* The frame table's bitmask of the saved pairs, by their indices *)
    let savedMask(saved: Array(Int)): Int =
        begin
            let var mask = 0
            for k = {extent saved - 1} downto 0 do
                let var bit = 1
                for x = 1 upto saved[k] do bit := 2 * bit end
                mask := mask + bit
            end
            mask
        end

    (* Emits a function's machine code (after load/store pairing and branch
     * relaxation) together with its GC frame-table entry when the function
     * does not enter a try. A temporary label (prefix_mN) after each mapped
     * call tracks its return address through peephole pairing and branch
     * relaxation, then is stripped once its instruction offset is recorded. *)
    Let Machined = Tuple code: Code frame: maybe.T(Frame) end
    let machineCode(f: Function index: Int defined: maps.StringMap(Bool)): Machined =
        begin
            let c = compile(f index defined)
            let s = c.selection
            let e = tuple let c = c let code = vector.new(:minst.Inst) end
            let final = finalBlocks(s.f)
            let printed = chains(s final)
            let bare = frameless(c)
            if not(bare) then prologue(e) end
            let x = tuple
                let e = e
                let symbol = f.symbol
                let final = final
                let bare = bare
                let marker = s.prefix <> "_m"
                let mapped = vector.new(:CallMap)
                let var liveLabels = 0
                let var last = ssa.noLoc
            end
            for k = 0 upto {extent printed - 1} do
                emitBlock(x printed[k] if {k + 1} < extent printed then printed[k + 1] else ~1 end)
            end
            let relaxed = peephole.relaxBranches(peephole.pairs(e.code) s.prefix peephole.branchReach)
            let stripped = stripMarkers(relaxed x.marker x.mapped)
            tuple
                let code = stripped.code
                let frame = if s.entersTry then maybe.none() else maybe.some(tuple
                    let below = {{pairBytes * extent c.saved} + c.size} / wordBytes
                    let saved = savedMask(c.saved)
                    let undescribed = s.slotsEnd / wordBytes
                    let calls = vector.toArray(stripped.sites)
                end) end
            end
        end

    let frameMaps(f: Function): Array(String) =
        begin
            let made = machineCode(f 0 maps.newStringMap())
            let lines = vector.new(:String)
            if maybe.isSome(made.frame) then
                let frame = maybe.unwrap(made.frame)
                let pairs = vector.new(:String)
                let var mask = frame.saved
                for k = 0 upto {extent savedFirsts - 1} do
                    if {mask % 2} is 1 then
                        vector.append(pairs target.description.registers[savedFirsts[k]].name <> "/"
                            <> target.description.registers[savedSeconds[k]].name)
                    end
                    mask := mask / 2
                end
                vector.append(lines "frame: " <> conv.int(frame.below) <> " words below the record, saves "
                    <> if vector.empty(pairs) then "nothing" else strutil.join(" " pairs) end <> ", "
                    <> conv.int(frame.undescribed) <> " words not described")
                let className(class: Int): String = if class is 1 then "ptr" else "word" end
                for c = 0 upto {extent frame.calls - 1} do
                    let site = frame.calls[c]
                    let parts = vector.new(:String)
                    let var registers = site.map.registers
                    for x = 0 upto {extent mapped - 1} do
                        if {registers % 4} > 0 then
                            vector.append(parts target.description.registers[mapped[x]].name <> " "
                                <> className(registers % 4))
                        end
                        registers := registers / 4
                    end
                    for k = 0 upto {extent site.map.slots - 1} do
                        let slot = site.map.slots[k]
                        vector.append(parts
                                "sp+" <> conv.int(8 * {slot / 2}) <> " " <> className(1 + {slot % 2}))
                    end
                    vector.append(lines "call returning at " <> conv.int(site.offset) <> ": "
                        <> if vector.empty(parts) then "nothing live" else strutil.join(", " parts) end)
                end
            end
            vector.toArray(lines)
        end

    let function(f: Function index: Int code: Code): Lines =
        begin
            let lines = vector.new(:String)
            let start = asm.functionStart(f.symbol f.exported)
            for k = 0 upto {extent start - 1} do vector.append(lines start[k]) end
            for k = 0 upto {vector.length(code) - 1} do
                let i = vector.get(code k)
                let ls = printer.lines(i.op i.regs printer.physical)
                for j = 0 upto {extent ls - 1} do vector.append(lines ls[j]) end
            end
            vector.append(lines endLabel(index) <> ":")
            for k = 0 upto {extent asm.functionEnd - 1} do vector.append(lines asm.functionEnd[k]) end
            lines
        end

    (* Maps every symbol defined in u to whether calling it within u is
     * guaranteed to return narrow (sub-64-bit) results already sign- or
     * zero-extended, letting callers skip redundant extension (docs/ssa.md
     * section 2.2). A function defined in u satisfies this unless it
     * tail-calls, for a narrow result, an external function, an indirect
     * function pointer, or another local function that lacks the guarantee.
     * Data symbols map to false. *)
    let definedSymbols(u: ssa.Unit): maps.StringMap(Bool) =
        begin
            let defined = maps.newStringMap(:Bool)
            for k = 0 upto {vector.length(u.data) - 1} do
                put(defined vector.get(u.data k).symbol false)
            end
            let n = vector.length(u.functions)
            for k = 0 upto {n - 1} do put(defined vector.get(u.functions k).symbol true) end
            let extends(i: ssa.Inst): Bool =
                {extent ssa.narrowOf(i.signature.results) is 0} orif {ssa.isOp(i ssa.opCall)
                    andif maybe.isSome(hashMap.get(defined i.symbol))
                    andif maybe.unwrap(hashMap.get(defined i.symbol))}
            let var changed = true
            while changed do
                changed := false
                for k = 0 upto {n - 1} do
                    let f = vector.get(u.functions k)
                    if maybe.unwrap(hashMap.get(defined f.symbol)) then
                        for b = 0 upto {vector.length(f.blocks) - 1} do
                            case ssa.block(f b).term
                                when termTailCall with x then
                                    if not(extends(x.call)) then
                                        put(defined f.symbol false)
                                        changed := true
                                    end
                                when termNone, termJump, termBranch, termSwitch, termReturn, termTry,
                                        termUnreachable then
                                    ok
                            end
                        end
                    end
                end
            end
            defined
        end

    (* Symbol name of the unit's GC frame table. ssa/build/unit emits a
     * placeholder data symbol under this name along with the startup call
     * that registers it, and the backend replaces the placeholder with the
     * real table. *)
    let framesSymbol = "qr_frames"
    let hasFrames(u: ssa.Unit): Bool =
        begin
            let var found = false
            for k = 0 upto {vector.length(u.data) - 1} do
                if eq(vector.get(u.data k).symbol framesSymbol) then found := true end
            end
            found
        end
    let dataBesidesFrames(u: ssa.Unit): Array(ssa.Data) =
        begin
            let kept = vector.new(:ssa.Data)
            for k = 0 upto {vector.length(u.data) - 1} do
                let d = vector.get(u.data k)
                if not(eq(d.symbol framesSymbol)) then vector.append(kept d) end
            end
            vector.toArray(kept)
        end

    (* Appends n encoded as unsigned LEB128 (variable-length 7-bit chunks) *)
    let leb(bytes: vector.T(Int) n: Int): Ok =
        begin
            let var rest = n
            let var more = true
            while more do
                let low = rest % 128
                rest := rest / 128
                if rest is 0 then
                    vector.append(bytes low)
                    more := false
                else
                    vector.append(bytes low + 128)
                end
            end
        end

    (* Encodes the unit's GC frame table before final code addresses are known
     * (docs/arm64.md section 3.13; runtime/quest_gc.c defines the layout).
     * Lists every function that has at least one mapped call site, packing
     * each function's description as unsigned LEB128 integers: words from sp
     * to the frame record, saved-pair bitmask, undescribed words at sp, call
     * count, and for each call its delta-encoded return offset (in
     * instructions from the previous call), live register mask, and live
     * spill slots. *)
    let frameTable(frames: Array(maybe.T(Frame))): encode.Frames =
        begin
            let listed = vector.new(:encode.Listed)
            let bytes = vector.new(:Int)
            for k = 0 upto {extent frames - 1} do
                if maybe.isSome(frames[k]) andif {extent maybe.unwrap(:Frame frames[k]).calls > 0} then
                    let f = maybe.unwrap(frames[k])
                    vector.append(listed
                            tuple let index = k let description = vector.length(bytes) end)
                    leb(bytes f.below)
                    leb(bytes f.saved)
                    leb(bytes f.undescribed)
                    leb(bytes extent f.calls)
                    let var last = 0
                    for c = 0 upto {extent f.calls - 1} do
                        let site = f.calls[c]
                        leb(bytes site.offset - last)
                        last := site.offset
                        leb(bytes site.map.registers)
                        leb(bytes extent site.map.slots)
                        for x = 0 upto {extent site.map.slots - 1} do leb(bytes site.map.slots[x]) end
                    end
                end
            end
            tuple
                let listed = vector.toArray(listed)
                let descriptions = vector.toArray(bytes)
            end
        end

    (* Compiles every function in u to machine code and GC frame metadata,
     * shared by assembleUnit and encodeUnit *)
    Let UnitCode = Tuple machines: Array(encode.Function) frames: Array(maybe.T(Frame)) end
    let unitCode(u: ssa.Unit defined: maps.StringMap(Bool)): UnitCode =
        begin
            let machines = array of(vector.length(u.functions) tuple
                let symbol = ""
                let exported = false
                let code = vector.new(:minst.Inst)
                let endLabel = ""
            end)
            let frames = array of(vector.length(u.functions) maybe.none(:Frame))
            for k = 0 upto {vector.length(u.functions) - 1} do
                let f = vector.get(u.functions k)
                let made = machineCode(f k defined)
                machines[k] := tuple
                    let symbol = f.symbol
                    let exported = f.exported
                    let code = made.code
                    let endLabel = endLabel(k)
                end
                frames[k] := made.frame
            end
            tuple let machines = machines let frames = frames end
        end

    let ssaPolicy: ssa.Policy =
        tuple
            let rotateAll = true
            let rematerializable = fun(op: ssa.Opcode): Bool ssa.info(op).rematerializable orif select.fuses(op)
        end

    let assembleUnit(u: ssa.Unit): String =
        begin
            let defined = definedSymbols(u)
            let lines = vector.new(:String)
            let appendAll(ls: Array(String)): Ok = for k = 0 upto {extent ls - 1} do vector.append(lines ls[k]) end
            appendAll(asm.unitStart)
            (* The line table's files, and its debugging information if the
             * unit's own file is known and the unit has code *)
            let files = vector.toArray(u.files)
            appendAll(asm.files(files))
            let debugged = {extent files > 0} andif {stringOp.length(files[0]) > 0}
                andif not(vector.empty(u.functions))
            let made = unitCode(u defined)
            let machines = made.machines
            let frames = made.frames
            for k = 0 upto {vector.length(u.functions) - 1} do
                let fl = function(vector.get(u.functions k) k machines[k].code)
                for j = 0 upto {vector.length(fl) - 1} do
                    vector.append(lines vector.get(fl j))
                end
            end
            let data = dataBesidesFrames(u)
            for k = 0 upto {extent data - 1} do
                let dl = asm.data(data[k])
                for j = 0 upto {extent dl - 1} do vector.append(lines dl[j]) end
            end
            let table = if hasFrames(u) then maybe.some(frameTable(frames))
                else maybe.none(:encode.Frames) end
            if maybe.isSome(table) then
                let t = maybe.unwrap(table)
                let listed = array of(extent t.listed tuple let symbol = "" let description = 0 end)
                for k = 0 upto {extent listed - 1} do
                    listed[k] := tuple
                        let symbol = machines[t.listed[k].index].symbol
                        let description = t.listed[k].description
                    end
                end
                appendAll(asm.frames(framesSymbol if extent machines > 0 then machines[0].symbol else "" end listed
                        t.descriptions))
            end
            if debugged then
                let functions = array of(vector.length(u.functions)
                        tuple let symbol = "" let endLabel = "" end)
                for k = 0 upto {extent functions - 1} do
                    functions[k] := tuple
                        let symbol = vector.get(u.functions k).symbol
                        let endLabel = endLabel(k)
                    end
                end
                appendAll(asm.debugInfo(files[0] functions))
            end
            appendAll(asm.unitEnd)
            (* Under QUEST_CHECK_ENCODING=1, append the binary encoder's
             * output as assembly comments so tests/self-hosted/encoder.py can
             * verify it against the system assembler's output *)
            if stringOp.equal(system.getEnv("QUEST_CHECK_ENCODING") "1") then
                let described = encode.describe(encode.unit(machines data vector.toArray(u.files) table))
                for k = 0 upto {extent described - 1} do vector.append(lines "// encoded " <> described[k]) end
            end
            strutil.join("\n" lines) <> "\n"
        end

    let encodeUnit(u: ssa.Unit): encode.Encoded =
        begin
            let made = unitCode(u definedSymbols(u))
            encode.unit(made.machines dataBesidesFrames(u) vector.toArray(u.files)
                    if hasFrames(u) then maybe.some(frameTable(made.frames))
                    else maybe.none()
                    end)
        end
end
