(* Quest Self-Hosted Compiler: The arm64 Backend's Code Generator
 * Implementation *)

module codegen : Codegen
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/codegen/machine : questlang/codegen/Machine
    questlang/codegen/regalloc : questlang/codegen/Regalloc
    questlang/codegen/arm64/asm : questlang/codegen/arm64/Asm
    questlang/codegen/arm64/minst : questlang/codegen/arm64/Minst
    questlang/codegen/arm64/printer : questlang/codegen/arm64/Printer
    questlang/codegen/arm64/select : questlang/codegen/arm64/Select
    questlang/codegen/arm64/target : questlang/codegen/arm64/Target
    questlang/codegen/arm64/encode : questlang/codegen/arm64/Encode
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    collections/bitset : collections/Bitset
    util/hash : util/Hash
    util/maybe : util/Maybe
    util/strutil : util/Strutil
    stringOp = string : StringOp
    conv : Conv
    system : System
export
    Let Function = ssa.Function
    Let Lines = vector.T(String)
    Let Code = vector.T(minst.Inst)

    let unsupported: Exception(String) = exception unsupported: String end
    let eq(a: String b: String): Bool = stringOp.equal(a b)
    let put(K::TYPE V::TYPE m: hashMap.T(K V) k: K v: V): Ok = begin hashMap.insert(:K :V m k v) ok end
    let contains(xs: Array(Int) x: Int): Bool =
        begin
            let var found = false
            for i = 0 upto {extent xs - 1} do if xs[i] is x then found := true end end
            found
        end
    let alignUp(n: Int a: Int): Int = {{{n + a} - 1} / a} * a

    (* The registers the frame's code names: the scratch registers (x9, x10,
     * and x11 for operands in memory, x16 within a sequence that addresses
     * the frame, d30 and d31) and the frame's *)
    let x9 = target.x(9)
    let x10 = target.x(10)
    let x11 = target.x(11)
    let x16 = target.x(16)
    let sp = target.sp
    let fp = target.fp
    let lr = target.lr

    (* =========================================================================
     * A function compiled: selected, allocated, and rewritten in the
     * registers allocated. Its frame, below the frame record and the
     * callee-saved registers it saves: the outgoing arguments' area at sp,
     * the function's stack slots, then a slot for each virtual register
     * stored in memory
     * ====================================================================== *)

    Let FrameSlot = Tuple offset: Int bytes: Int type: maybe.T(ssa.Type) id: Int end

    (* What a collection inside a call scans of the caller's frame (section
     * 3.13): the callee-saved registers that hold values live across the
     * call, two bits each from x19 (1 for a ptr, a pointer; 2 for an int or a
     * val, an ambiguous word), and the frame's words that do, each as twice
     * its index from sp, plus 1 for an ambiguous word *)
    Let CallMap = Tuple registers: Int slots: Array(Int) end
    (* A function's frame for the unit's frame table: the words from sp to
     * the frame record, the pairs of callee-saved registers saved (a bit
     * each, by their indices in savedFirsts), the words at sp that nothing
     * describes (the outgoing arguments and the stack slots), and each call's
     * return address, in instructions from the function's start, with its
     * map *)
    Let CallSite = Tuple offset: Int map: CallMap end
    Let Frame = Tuple below: Int saved: Int undescribed: Int calls: Array(CallSite) end

    Let Compiled = Tuple
        selection: select.Selection
        (* The frame's size below the saved registers, and its slots *)
        size: Int
        slots: Array(FrameSlot)
        (* The pairs of callee-saved registers it saves (indices in
         * savedFirsts and savedSeconds): every pair if it enters a try, else
         * those its values use *)
        saved: Array(Int)
        (* With QUEST_LIVE_SLOTS=1, for each block's calls in order, where
         * the values live across each are: their slots and registers *)
        liveAtCalls: Array(Array(String))
        (* For each block's calls in order, the map of each; none for a
         * function that enters a try, whose frame is scanned whole *)
        maps: Array(Array(CallMap))
    end

    (* The callee-saved registers a function saves, in pairs, in the order it
     * pushes them below its frame record. Each pair's odd register is above
     * its even one (stp x20, x19), the places Darwin's compact unwind
     * encoding gives them: in the other order, every function that saves a
     * pair needed DWARF unwind information, which libunwind interprets at
     * each frame a raise walks (docs/arm64-performance-review.md section
     * 3.6) *)
    let savedFirsts = array of target.x(20) target.x(22) target.x(24) target.x(26) target.x(28) target.d(9)
        target.d(11) target.d(13) target.d(15) end
    let savedSeconds = array of target.x(19) target.x(21) target.x(23) target.x(25) target.x(27) target.d(8)
        target.d(10) target.d(12) target.d(14) end

    (* The frame's memory at sp plus off, by a load or store through x16 when
     * off is too far for an immediate (an 8-byte access's reaches 8 * 4095,
     * scaled) *)
    let frameAccess(s: select.Selection off: Int access: All(base: Int m: minst.Mode) minst.Inst):
            Array(machine.Inst) =
        if off <= 32760 then array of select.make(s machine.kindOrdinary access(sp minst.offset(off))) end
        else
            let low = off - {4096 * {off / 4096}}
            array of
                select.make(s machine.kindOrdinary minst.addImm(x16 sp off / 4096 12))
                select.make(s machine.kindOrdinary access(x16 minst.offset(low)))
            end
        end

    let isBrk(op: minst.Op): Bool =
        case op
            when opBrk then true
            when opMovImm, opMovz, opMovk, opMovConst, opSymbolAddress, opTlvAddress, opMov, opArith, opAddImm,
                opSubImm, opLogicImm, opShiftImm, opMsub, opSxtb, opSxtw, opCmp, opFcmp, opCmpImm, opCcmp, opCcmpImm,
                opCset, opCsel, opLoad, opStore, opLdp, opStp, opAdrp, opAddPageOff, opAdr, opB, opBSymbol, opBl, opBlr,
                opBr, opRet, opCbz, opCbnz, opTbz, opTbnz, opBCond, opNop, opLabel, opCfiDefCfa, opCfiOffset, opLoc then
                false
        end

    (* The blocks from which every path raises: one that ends in brk
     * (termUnreachable), or every block it can go to is cold and it does not
     * return *)
    let coldBlocks(s: select.Selection): Array(Bool) =
        begin
            let m = s.f
            let n = vector.length(:machine.Block m.blocks)
            let cold = array of(n false)
            let var changed = true
            while changed do
                changed := false
                for b = 0 upto {n - 1} do
                    if not(cold[b]) then
                        let insts = machine.block(m b).insts
                        let var raises = false
                        let var leaves = false
                        let var exits = 0
                        let var hot = false
                        for j = 0 upto {vector.length(:machine.Inst insts) - 1} do
                            let i = vector.get(:machine.Inst insts j)
                            if machine.isKind(i machine.kindReturn) then
                                if isBrk(vector.get(:minst.Op s.ops i.op)) then raises := true else leaves := true end
                            end
                            if i.target >= 0 then
                                exits := exits + 1
                                if not(cold[i.target]) then hot := true end
                            end
                        end
                        if raises orif {not(leaves) andif {exits > 0} andif not(hot)} then
                            cold[b] := true
                            changed := true
                        end
                    end
                end
            end
            cold
        end

    (* For each block's calls, in order, the values live across each (by a
     * backward walk from what the block has live out), each where it is
     * after the call: its slot, as an offset from sp, if it has one (which
     * holds it wherever it is live), and its register, if it is in one. What
     * a collection in the call scans of the frame and the callee-saved
     * registers, other than these, holds no live value (docs/profiling.md
     * section 6). *)
    let describeLive(s: select.Selection a: regalloc.Allocation spillAt: Array(Int)): Array(Array(String)) =
        begin
            let m = s.f
            let nBlocks = vector.length(:machine.Block m.blocks)
            let n = machine.virtuals(m)
            let live = machine.live(m)
            let described = array of(nBlocks array of :String end)
            for b = 0 upto {nBlocks - 1} do
                if a.blockStart[b] >= 0 then
                    let insts = machine.block(m b).insts
                    let cur = bitset.new(n)
                    bitset.assign(cur live.liveOut[b])
                    let found = vector.new(:String)
                    for j = {vector.length(:machine.Inst insts) - 1} downto 0 do
                        let i = vector.get(:machine.Inst insts j)
                        if machine.isKind(i machine.kindCall) then
                            let p = a.blockStart[b] + {2 * {j + 1}}
                            let parts = vector.new(:String)
                            let vs = bitset.elements(cur)
                            for k = 0 upto {extent vs - 1} do
                                let v = vs[k]
                                let what = "%" <> conv.int(v) <> " " <> ssa.typeName(vector.get(:ssa.Type s.types v))
                                if regalloc.needsSlot(a v) then
                                    vector.append(:String parts "sp+" <> conv.int(spillAt[v]) <> " " <> what)
                                end
                                let h = regalloc.home(a v p + 1)
                                if h isnot regalloc.memory then
                                    vector.append(:String parts target.description.registers[h].name <> " " <> what)
                                end
                            end
                            vector.append(:String found strutil.join(", " parts))
                        end
                        for k = 0 upto {extent i.operands - 1} do
                            let o = i.operands[k]
                            if machine.isVirtual(m o.reg) andif o.defines then
                                begin let ignored = bitset.remove(cur machine.index(m o.reg)) end
                            end
                        end
                        for k = 0 upto {extent i.operands - 1} do
                            let o = i.operands[k]
                            if machine.isVirtual(m o.reg) andif not(o.defines) then
                                begin let ignored = bitset.insert(cur machine.index(m o.reg)) end
                            end
                        end
                    end
                    let ordered = vector.toArray(:String found)
                    let r = array of(extent ordered "")
                    for k = 0 upto {extent ordered - 1} do r[k] := ordered[{extent ordered - 1} - k] end
                    described[b] := r
                end
            end
            described
        end

    (* How a collection takes a live value of an SSA type: a ptr as a pointer
     * (1); an int or a val as an ambiguous word (2), a val because its
     * descriptor, not its type, says whether it is a pointer, and an int
     * because a pointer's bits may be in one (ptrToInt) with the pointer
     * itself dead; a real not at all (0) *)
    let wordClass(t: ssa.Type): Int =
        case t when typePtr then 1 when typeInt, typeVal then 2 when typeReal then 0 end

    (* For each block's calls, in order, the map of each (docs/arm64.md
     * section 3.13), by the backward walk of describeLive: a value live
     * across the call that has a slot is taken from the slot, which holds it
     * wherever it is live, and one that has none from its register, which is
     * callee-saved, since a call leaves no other with a value in it (a
     * rematerialized one is in neither: it is a constant or an address that
     * is not the heap's) *)
    let callMaps(s: select.Selection a: regalloc.Allocation spillAt: Array(Int)): Array(Array(CallMap)) =
        begin
            let m = s.f
            let nBlocks = vector.length(:machine.Block m.blocks)
            let n = machine.virtuals(m)
            let live = machine.live(m)
            let maps = array of(nBlocks array of :CallMap end)
            for b = 0 upto {nBlocks - 1} do
                if a.blockStart[b] >= 0 then
                    let insts = machine.block(m b).insts
                    let cur = bitset.new(n)
                    bitset.assign(cur live.liveOut[b])
                    let found = vector.new(:CallMap)
                    for j = {vector.length(:machine.Inst insts) - 1} downto 0 do
                        let i = vector.get(:machine.Inst insts j)
                        for k = 0 upto {extent i.operands - 1} do
                            let o = i.operands[k]
                            if machine.isVirtual(m o.reg) andif o.defines then
                                begin let ignored = bitset.remove(cur machine.index(m o.reg)) end
                            end
                        end
                        if machine.isKind(i machine.kindCall) then
                            let p = a.blockStart[b] + {2 * {j + 1}}
                            let classes = array of(10 0)
                            let slots = vector.new(:Int)
                            let vs = bitset.elements(cur)
                            for k = 0 upto {extent vs - 1} do
                                let v = vs[k]
                                let class = wordClass(vector.get(:ssa.Type s.types v))
                                if class > 0 then
                                    if regalloc.needsSlot(a v) then
                                        vector.append(:Int slots {2 * {spillAt[v] / 8}} + {class - 1})
                                    else
                                        let h = regalloc.home(a v p + 1)
                                        if h isnot regalloc.memory then
                                            let var r = ~1
                                            for x = 0 upto 9 do if h is target.x(19 + x) then r := x end end
                                            if r < 0 then
                                                raise unsupported with "a value live across a call in " <>
                                                    target.description.registers[h].name
                                                end
                                            end
                                            if class > classes[r] then classes[r] := class end
                                        end
                                    end
                                end
                            end
                            let var registers = 0
                            for x = 9 downto 0 do registers := {4 * registers} + classes[x] end
                            vector.append(:CallMap found tuple
                                let registers = registers let slots = vector.toArray(:Int slots)
                            end)
                        end
                        for k = 0 upto {extent i.operands - 1} do
                            let o = i.operands[k]
                            if machine.isVirtual(m o.reg) andif not(o.defines) then
                                begin let ignored = bitset.insert(cur machine.index(m o.reg)) end
                            end
                        end
                    end
                    let backward = vector.toArray(:CallMap found)
                    let r = array of(extent backward tuple let registers = 0 let slots = array of :Int end end)
                    for k = 0 upto {extent backward - 1} do r[k] := backward[{extent backward - 1} - k] end
                    maps[b] := r
                end
            end
            maps
        end

    (* A function that enters a try saves every callee-saved pair. A raise
     * resumes in it with the registers as the function that raised left
     * them, not as the functions in between restored them, so it must restore
     * all of its caller's from its own frame *)
    let compile(f: Function index: Int defined: hashMap.T(String Bool)): Compiled =
        begin
            let s = select.select(f "Lf" <> conv.int(index) defined)
            let m = s.f
            let cold = coldBlocks(s)
            let a = regalloc.allocate(m target.description fun(i: machine.Inst): Bool select.rematerializable(s i)
                fun(b: Int): Bool cold[b])
            (* The stack slots, then (below) the slots of registers stored in
             * memory *)
            let slots = vector.new(:FrameSlot)
            for k = 0 upto {extent s.slotAt - 1} do
                let slot = vector.get(:ssa.Slot f.slots k)
                vector.append(:FrameSlot slots tuple
                    let offset = s.slotAt[k] let bytes = alignUp(if slot.bytes > 0 then slot.bytes else 8 end 8)
                    let type = maybe.none(:ssa.Type) let id = k
                end)
            end
            let n = machine.virtuals(m)
            let spillAt = array of(n ~1)
            let lowering = tuple
                let move = fun(dst: Int src: Int): machine.Inst select.make(s machine.kindMove minst.mov(dst src))
                let load = fun(dst: Int v: Int): Array(machine.Inst)
                    frameAccess(s spillAt[machine.index(m v)] fun(base: Int mode: minst.Mode): minst.Inst
                        minst.load(minst.load64 dst base mode))
                let store = fun(src: Int v: Int): Array(machine.Inst)
                    frameAccess(s spillAt[machine.index(m v)] fun(base: Int mode: minst.Mode): minst.Inst
                        minst.store(minst.store64 src base mode))
                let scratch = array of array of x9 x10 x11 end array of target.d(30) target.d(31) end end
                (* No dead value's slot is cleared: a collection scans, of
                 * this frame, the slots the call's map says are live (section
                 * 3.13), so a dead pointer in one keeps nothing. (A function
                 * that enters a try has no maps, and its handler reloads
                 * what it uses from slots, after a raise from anywhere in the
                 * try's body, where liveness does not see the handler's
                 * uses, so its slots could not be cleared either.) *)
                let clears = fun(v: Int): Bool false
                let clear = fun(v: Int): Array(machine.Inst)
                    frameAccess(s spillAt[machine.index(m v)] fun(base: Int mode: minst.Mode): minst.Inst
                        minst.store(minst.store64 target.xzr base mode))
            end
            (* Values of one SSA type share slots where their lifetimes do not
             * overlap (docs/arm64-performance-review.md section 3.2), so a
             * slot holds one type for its whole life; the first value given
             * one names it. Not in a function that enters a try, for the
             * reason above. *)
            let kind = fun(v: Int): Int
                case vector.get(:ssa.Type s.types machine.index(m v))
                    when typeInt then 0
                    when typePtr then 1
                    when typeVal then 2
                    when typeReal then 3
                end
            let slotOf = if s.entersTry then
                begin
                    let own = array of(n ~1)
                    for v = 0 upto {n - 1} do own[v] := v end
                    own
                end
            else regalloc.shareSlots(m a lowering kind) end
            let offsetOf = array of(n ~1)
            let var at = s.slotsEnd
            for v = 0 upto {n - 1} do
                if regalloc.needsSlot(a v) then
                    let k = slotOf[v]
                    if offsetOf[k] < 0 then
                        offsetOf[k] := at
                        vector.append(:FrameSlot slots tuple
                            let offset = at let bytes = 8
                            let type = maybe.some(:ssa.Type vector.get(:ssa.Type s.types v)) let id = v
                        end)
                        at := at + 8
                    end
                    spillAt[v] := offsetOf[k]
                end
            end
            let liveAtCalls = if stringOp.equal(system.getEnv("QUEST_LIVE_SLOTS") "1") then
                describeLive(s a spillAt)
            else array of(vector.length(:machine.Block m.blocks) array of :String end) end
            let maps = if s.entersTry then array of(vector.length(:machine.Block m.blocks) array of :CallMap end)
                else callMaps(s a spillAt) end
            regalloc.rewrite(m a lowering)
            let savedList = vector.new(:Int)
            for k = 0 upto {extent savedFirsts - 1} do
                let used = contains(a.calleeUsed savedFirsts[k]) orif contains(a.calleeUsed savedSeconds[k])
                if s.entersTry orif used then vector.append(:Int savedList k) end
            end
            tuple
                let selection = s let size = alignUp(at 16) let slots = vector.toArray(:FrameSlot slots)
                let saved = vector.toArray(:Int savedList) let liveAtCalls = liveAtCalls let maps = maps
            end
        end

    let frameSlots(f: Function): Array(FrameSlot) = compile(f 0 hashMap.new(:String :Bool eq hash.string)).slots

    (* =========================================================================
     * Emitting a function's code: the prologue, each block's instructions,
     * and the epilogue before each return
     * ====================================================================== *)

    Let Emitter = Tuple
        c: Compiled
        code: Code
    end

    let emit(e: Emitter i: minst.Inst): Ok = vector.append(:minst.Inst e.code i)

    (* The unwind information of the pairs saved: the first of the kth at the
     * CFA less 16 * (k + 2), the second 8 above it. The second's comes first,
     * and the pairs in order down from the frame record, as the assembler
     * needs them to make a compact unwind entry *)
    let savedOffsets(e: Emitter): Ok =
        begin
            let saved = e.c.saved
            for k = 0 upto {extent saved - 1} do
                emit(e minst.cfiOffset(savedSeconds[saved[k]] {0 - {16 * {k + 2}}} + 8))
                emit(e minst.cfiOffset(savedFirsts[saved[k]] 0 - {16 * {k + 2}}))
            end
        end

    (* The frame record, with the pairs saved below it, then the frame. The
     * lowest pair is stored first, moving sp once, as clang does: a stack
     * overflow then faults on the prologue's first store or not at all.
     * Stored downward one at a time, a pair could fault below a record stored
     * just above the guard page, and the fault's backtrace, by the compact
     * unwind information, which assumes a whole prologue, read the pair from
     * the guard page *)
    let prologue(e: Emitter): Ok =
        begin
            let saved = e.c.saved
            let n = extent saved
            if n is 0 then
                emit(e minst.stp(fp lr sp minst.pre(~16)))
                emit(e minst.mov(fp sp))
            else
                let last = saved[n - 1]
                emit(e minst.stp(savedFirsts[last] savedSeconds[last] sp minst.pre(0 - {16 * {n + 1}})))
                for k = {n - 2} downto 0 do
                    emit(e minst.stp(savedFirsts[saved[k]] savedSeconds[saved[k]] sp minst.offset(16 * {{n - 1} - k})))
                end
                emit(e minst.stp(fp lr sp minst.offset(16 * n)))
                emit(e minst.addImm(fp sp 16 * n 0))
            end
            emit(e minst.cfiDefCfa(fp 16))
            emit(e minst.cfiOffset(lr ~8))
            emit(e minst.cfiOffset(fp ~16))
            savedOffsets(e)
            (* A frame of more than a page is probed a page at a time, as clang
             * does, so that a stack overflow faults in the guard page rather
             * than past it (docs/arm64.md section 3.10) *)
            let size = e.c.size
            if size is 0 then ok
            elsif size <= 4096 then
                emit(e minst.subImm(sp sp size))
            else
                emit(e minst.movConst(x9 size))
                emit(e minst.bl("__chkstk_darwin"))
                emit(e minst.movConst(x9 size))
                emit(e minst.arith(minst.arithSub sp sp x9))
            end
        end

    (* The frame popped and the caller's registers restored, short of
     * returning *)
    let restore(e: Emitter): Ok =
        begin
            let saved = e.c.saved
            if extent saved > 0 then
                emit(e minst.subImm(sp fp 16 * extent saved))
                for k = {extent saved - 1} downto 0 do
                    emit(e minst.ldp(savedFirsts[saved[k]] savedSeconds[saved[k]] sp minst.post(16)))
                end
            else
                emit(e minst.mov(sp fp))
            end
            emit(e minst.ldp(fp lr sp minst.post(16)))
        end

    (* An operation's branch retargeted to a label *)
    let retarget(op: minst.Op l: String): minst.Op =
        case op
            when opB then minst.b(l).op
            when opCbz then option opCbz of minst.Op with let label = l end
            when opCbnz then option opCbnz of minst.Op with let label = l end
            when opTbz with x then minst.tbz(0 x.bit l).op
            when opTbnz with x then minst.tbnz(0 x.bit l).op
            when opBCond with x then minst.bCond(x.cond l).op
            when opAdr then option opAdr of minst.Op with let label = l end
            when opMovImm, opMovz, opMovk, opMovConst, opSymbolAddress, opTlvAddress, opMov, opArith, opAddImm,
                opSubImm, opLogicImm, opShiftImm, opMsub, opSxtb, opSxtw, opCmp, opFcmp, opCmpImm, opCcmp, opCcmpImm,
                opCset, opCsel, opLoad, opStore, opLdp, opStp, opAdrp, opAddPageOff, opBSymbol, opBl, opBlr, opBr,
                opRet, opBrk, opNop, opLabel, opCfiDefCfa, opCfiOffset, opLoc then
                op
        end

    (* =========================================================================
     * Branch relaxation (docs/arm64.md section 3.11)
     * ====================================================================== *)

    (* How far, in instructions, a conditional branch may reach: 1 MB less a
     * margin; a test of a bit's, 32 KB less a margin *)
    let branchReach = 260000
    let bitBranchReach = 8000

    (* A conditional branch's inverse to a label, its target, and its reach
     * (in instructions), if op is one: cbz and cbnz of a register, tbz and
     * tbnz of a bit, and b.cond *)
    Let Conditional = Tuple inverse: All(l: String) minst.Op target: String reach: Int end
    let conditional(op: minst.Op): maybe.T(Conditional) =
        case op
            when opCbz with x then maybe.some(:Conditional tuple
                let inverse = fun(l: String): minst.Op option opCbnz of minst.Op with let label = l end
                let target = x.label let reach = branchReach
            end)
            when opCbnz with x then maybe.some(:Conditional tuple
                let inverse = fun(l: String): minst.Op option opCbz of minst.Op with let label = l end
                let target = x.label let reach = branchReach
            end)
            when opTbz with x then maybe.some(:Conditional tuple
                let inverse = fun(l: String): minst.Op minst.tbnz(0 x.bit l).op
                let target = x.label let reach = bitBranchReach
            end)
            when opTbnz with x then maybe.some(:Conditional tuple
                let inverse = fun(l: String): minst.Op minst.tbz(0 x.bit l).op
                let target = x.label let reach = bitBranchReach
            end)
            when opBCond with x then maybe.some(:Conditional tuple
                let inverse = fun(l: String): minst.Op minst.bCond(minst.inverse(x.cond) l).op let target = x.label
                let reach = branchReach
            end)
            when opMovImm, opMovz, opMovk, opMovConst, opSymbolAddress, opTlvAddress, opMov, opArith, opAddImm,
                opSubImm, opLogicImm, opShiftImm, opMsub, opSxtb, opSxtw, opCmp, opFcmp, opCmpImm, opCcmp, opCcmpImm,
                opCset, opCsel, opLoad, opStore, opLdp, opStp, opAdrp, opAddPageOff, opAdr, opB, opBSymbol, opBl, opBlr,
                opBr, opRet, opBrk, opNop, opLabel, opCfiDefCfa, opCfiOffset, opLoc then
                maybe.none(:Conditional)
        end

    (* A function's code with each conditional branch whose target is more
     * than reach instructions away turned into the inverse branch around an
     * unconditional one, which reaches 128 MB; repeated until none is *)
    let relaxBranches(code: Code prefix: String reach: Int): Code =
        begin
            (* Each pass finds each label's position, in instructions, then
             * relaxes each far branch. Relaxing adds instructions, which may
             * put another branch out of reach, so the passes repeat *)
            let var current = code
            let var changed = true
            let var count = 0
            while changed do
                changed := false
                let at = hashMap.new(:String :Int eq hash.string)
                let var n = 0
                for k = 0 upto {vector.length(:minst.Inst current) - 1} do
                    let i = vector.get(:minst.Inst current k)
                    case i.op
                        when opLabel with x then put(:String :Int at x.label n)
                        when opMovImm, opMovz, opMovk, opMovConst, opSymbolAddress, opTlvAddress, opMov, opArith,
                            opAddImm, opSubImm, opLogicImm, opShiftImm, opMsub, opSxtb, opSxtw, opCmp, opFcmp, opCmpImm,
                            opCcmp, opCcmpImm, opCset, opCsel, opLoad, opStore, opLdp, opStp, opAdrp, opAddPageOff,
                            opAdr, opB, opBSymbol, opBl, opBlr, opBr, opRet, opCbz, opCbnz, opTbz, opTbnz, opBCond,
                            opBrk, opNop, opCfiDefCfa, opCfiOffset, opLoc then
                            n := n + printer.count(i.op)
                    end
                end
                let next = vector.new(:minst.Inst)
                let var position = 0
                for k = 0 upto {vector.length(:minst.Inst current) - 1} do
                    let i = vector.get(:minst.Inst current k)
                    let c = conditional(i.op)
                    let var far = false
                    (* The inverse branch relaxing makes, to an _r label,
                     * only jumps over the b after it, so is never far *)
                    if maybe.isSome(:Conditional c) then
                        let target = maybe.unwrap(:Conditional c).target
                        let t = hashMap.get(:String :Int at target)
                        if not(strutil.startsWith(target prefix <> "_r")) andif maybe.isSome(:Int t) then
                            let d = maybe.unwrap(:Int t) - position
                            let within = if maybe.unwrap(:Conditional c).reach < reach then
                                maybe.unwrap(:Conditional c).reach else reach end
                            far := {d > within} orif {{0 - d} > within}
                        end
                    end
                    if far then
                        count := count + 1
                        let skip = prefix <> "_r" <> conv.int(count)
                        vector.append(:minst.Inst next tuple
                            let op = maybe.unwrap(:Conditional c).inverse(skip) let regs = i.regs
                        end)
                        vector.append(:minst.Inst next minst.b(maybe.unwrap(:Conditional c).target))
                        vector.append(:minst.Inst next minst.label(skip))
                        changed := true
                    else
                        vector.append(:minst.Inst next i)
                    end
                    position := position + printer.count(i.op)
                end
                current := next
            end
            current
        end

    (* =========================================================================
     * Pairs of loads and stores (docs/arm64-performance-review.md section 3.5)
     * ====================================================================== *)

    (* A load or store of 8 bytes at a base plus an immediate offset: whether
     * it loads, its register, its base, and its offset *)
    Let Access = Tuple load: Bool t: Int base: Int offset: Int end
    let access(i: minst.Inst): maybe.T(Access) =
        begin
            let made = fun(load: Bool offset: Int): maybe.T(Access)
                maybe.some(:Access tuple let load = load let t = i.regs[0] let base = i.regs[1] let offset = offset end)
            let at = fun(load: Bool m: minst.Mode): maybe.T(Access)
                case m
                    when modeOffset with x then made(load x.imm)
                    when modeBase then made(load 0)
                    when modePre, modePost, modePageOff, modeIndex then maybe.none(:Access)
                end
            case i.op
                when opLoad with x then
                    case x.load
                        when load64 then at(true x.mode)
                        when loadS32, loadS8, loadU8 then maybe.none(:Access)
                    end
                when opStore with x then
                    case x.store
                        when store64 then at(false x.mode)
                        when store32, store8 then maybe.none(:Access)
                    end
                when opMovImm, opMovz, opMovk, opMovConst, opSymbolAddress, opTlvAddress, opMov, opArith, opAddImm,
                    opSubImm, opLogicImm, opShiftImm, opMsub, opSxtb, opSxtw, opCmp, opFcmp, opCmpImm, opCcmp,
                    opCcmpImm, opCset, opCsel, opLdp, opStp, opAdrp, opAddPageOff, opAdr, opB, opBSymbol, opBl, opBlr,
                    opBr, opRet, opCbz, opCbnz, opTbz, opTbnz, opBCond, opBrk, opNop, opLabel, opCfiDefCfa, opCfiOffset,
                    opLoc then
                    maybe.none(:Access)
            end
        end

    (* How an instruction between two accesses bears on pairing them: one a
     * pair may move across, which touches only registers (and the flags), or
     * a load of one register (which a load may move across, and a store not),
     * or neither (a store, a call, a branch, or a label) *)
    let registersOnly = 0
    let aLoad = 1
    let barrier = 2
    let crossing(op: minst.Op): Int =
        case op
            when opMovImm, opMovz, opMovk, opMovConst, opSymbolAddress, opMov, opArith, opAddImm, opSubImm, opLogicImm,
                opShiftImm, opMsub, opSxtb, opSxtw, opCmp, opFcmp, opCmpImm, opCcmp, opCcmpImm, opCset, opCsel, opAdrp,
                opAddPageOff, opAdr, opLoc then
                registersOnly
            when opLoad with x then
                case x.mode
                    when modeOffset, modeBase, modePageOff, modeIndex then aLoad
                    when modePre, modePost then barrier
                end
            when opTlvAddress, opStore, opLdp, opStp, opB, opBSymbol, opBl, opBlr, opBr, opRet, opCbz, opCbnz, opTbz,
                opTbnz, opBCond, opBrk, opNop, opLabel, opCfiDefCfa, opCfiOffset then
                barrier
        end

    (* Whether b can be a's partner, given the registers written and read
     * between them: the same kind of access, of the same class of register,
     * off the same base, at offsets 8 apart that ldp and stp can encode; a
     * load's partner's register neither written nor read between them, and a
     * store's own not written *)
    let pairable(a: Access b: Access written: Array(Bool) read: Array(Bool)): Bool =
        begin
            let low = if a.offset < b.offset then a.offset else b.offset end
            let apart = {{a.offset - b.offset} is 8} orif {{b.offset - a.offset} is 8}
            let free = if a.load then not(written[b.t]) andif not(read[b.t]) else not(written[a.t]) end
            {b.load is a.load} andif {b.base is a.base} andif {target.isReal(b.t) is target.isReal(a.t)} andif apart
                andif {{low % 8} is 0} andif {low >= ~512} andif {low <= 504} andif {b.t isnot a.t}
                andif not(written[a.base]) andif free
        end

    (* How many instructions after a load or store its pair is looked for,
     * and how many after a pair of stores a lone load of one of its words *)
    let pairWindow = 16
    let forwardWindow = 12

    (* A function's code with loads (and stores) of 8 bytes off one base, at
     * offsets 8 apart, merged into ldp (stp) where the instructions between
     * them allow: a load's partner is moved up to it, across instructions
     * that neither write its base or register nor read its register, nor
     * store; a store is moved down to its partner, across instructions that
     * write neither its base nor its register, nor load or store. Tuples,
     * list cells, and options' payloads are adjacent words, and so are a
     * frame's slots, so this is AArch64LoadStoreOptimizer's main pattern.
     * Two stores are left apart when the code that runs just after loads
     * one of their two words alone: a load does not forward from half of a
     * pair's store, and waits for the store to reach the cache
     * (psdes-random's loop, which makes a tuple and reads a component of it
     * at once, took 1.22 of its time so: docs/benchmarks.md section 17.2) *)
    let pairs(code: Code): Code =
        begin
            let n = vector.length(:minst.Inst code)
            let accesses = array of(n maybe.none(:Access))
            for k = 0 upto {n - 1} do accesses[k] := access(vector.get(:minst.Inst code k)) end
            (* What replaces each instruction (none for one dropped), and
             * whether it is already in a pair *)
            let replaced = array of(n maybe.none(:minst.Inst))
            let dropped = array of(n false)
            let paired = array of(n false)
            let written = array of(65 false)
            let read = array of(65 false)
            (* Each label's place in the code *)
            let labelAt = hashMap.new(:String :Int eq hash.string)
            for k = 0 upto {n - 1} do
                case vector.get(:minst.Inst code k).op
                    when opLabel with x then put(:String :Int labelAt x.label k)
                    else ok
                end
            end
            (* Whether the code that runs after index from loads one of the
             * two words at low and low + 8 off base alone: the first load
             * of either within forwardWindow instructions, following jumps,
             * until a call, a return, or a write of the base, with no load
             * of the other in the four instructions after it (two loads so
             * close become a pair's, which forwards from a pair's store) *)
            let halfLoaded(from: Int base: Int low: Int): Bool =
                begin
                    let var hazard = false
                    let var k = from
                    let var steps = 0
                    let var going = true
                    while going andif {k < n} andif {steps < forwardWindow} do
                        let next = vector.get(:minst.Inst code k)
                        let var to = k + 1
                        if maybe.isSome(:Access accesses[k]) then
                            let x = maybe.unwrap(:Access accesses[k])
                            if x.load andif {x.base is base} andif {{x.offset is low} orif {x.offset is {low + 8}}} then
                                let other = if x.offset is low then low + 8 else low end
                                let var partnered = false
                                for d = 1 upto 4 do
                                    if {{k + d} < n} andif maybe.isSome(:Access accesses[k + d]) then
                                        let y = maybe.unwrap(:Access accesses[k + d])
                                        if y.load andif {y.base is base} andif {y.offset is other} then
                                            partnered := true
                                        end
                                    end
                                end
                                hazard := not(partnered)
                                going := false
                            end
                        end
                        case next.op
                            when opB with x then
                                let target = hashMap.get(:String :Int labelAt x.label)
                                if maybe.isSome(:Int target) then to := maybe.unwrap(:Int target)
                                else going := false end
                            when opBSymbol, opBl, opBlr, opBr, opRet, opBrk then going := false
                            else ok
                        end
                        for r = 0 upto {minst.results(next.op) - 1} do
                            if next.regs[r] is base then going := false end
                        end
                        k := to
                        steps := steps + 1
                    end
                    hazard
                end
            for i = 0 upto {n - 1} do
                if maybe.isSome(:Access accesses[i]) andif not(paired[i]) then
                    let a = maybe.unwrap(:Access accesses[i])
                    for r = 0 upto 64 do
                        written[r] := false
                        read[r] := false
                    end
                    let first = vector.get(:minst.Inst code i)
                    for r = 0 upto {minst.results(first.op) - 1} do written[first.regs[r]] := true end
                    let var j = i + 1
                    let var looking = true
                    while looking andif {j < n} andif {j <= {i + pairWindow}} do
                        let next = vector.get(:minst.Inst code j)
                        let c = crossing(next.op)
                        let fits = maybe.isSome(:Access accesses[j]) andif not(paired[j])
                            andif pairable(a maybe.unwrap(:Access accesses[j]) written read)
                        let partner = fits andif {a.load orif not(halfLoaded(j + 1 a.base
                            if a.offset < maybe.unwrap(:Access accesses[j]).offset then a.offset
                            else maybe.unwrap(:Access accesses[j]).offset end))}
                        if partner then
                            let b = maybe.unwrap(:Access accesses[j])
                            let lowFirst = a.offset < b.offset
                            let lo = if lowFirst then a.t else b.t end
                            let hi = if lowFirst then b.t else a.t end
                            let low = if lowFirst then a.offset else b.offset end
                            let m = if low is 0 then minst.modeBase else minst.offset(low) end
                            if a.load then
                                replaced[i] := maybe.some(:minst.Inst minst.ldp(lo hi a.base m))
                                dropped[j] := true
                            else
                                replaced[j] := maybe.some(:minst.Inst minst.stp(lo hi a.base m))
                                dropped[i] := true
                            end
                            paired[i] := true
                            paired[j] := true
                            looking := false
                        elsif {c is barrier} orif {{c is aLoad} andif not(a.load)} then
                            looking := false
                        else
                            for r = 0 upto {minst.results(next.op) - 1} do written[next.regs[r]] := true end
                            for r = 0 upto {extent next.regs - 1} do read[next.regs[r]] := true end
                            if written[a.base] orif {not(a.load) andif written[a.t]} then looking := false end
                        end
                        j := j + 1
                    end
                end
            end
            let merged = vector.new(:minst.Inst)
            for k = 0 upto {n - 1} do
                if maybe.isSome(:minst.Inst replaced[k]) then
                    vector.append(:minst.Inst merged maybe.unwrap(:minst.Inst replaced[k]))
                elsif not(dropped[k]) then
                    vector.append(:minst.Inst merged vector.get(:minst.Inst code k))
                end
            end
            merged
        end

    (* =========================================================================
     * Functions and the unit
     * ====================================================================== *)

    (* The blocks in the order they are emitted, each by where its code is
     * (final, past the blocks that only jump), in chains: from the entry,
     * each block is followed by its best successor not yet placed, so that
     * the edge falls through, and where none is left, by the next block of
     * the builder's layout. A successor is better if it is not cold (one
     * from which every path raises), then if it is in a deeper loop, then if
     * it makes no call (a proxy's slow path, say, beside the fast path), then
     * if it comes first in the layout. The cold blocks are last, in the
     * layout's order. Laid out where the builder made them, a check's
     * raising block came between the check and the code after it, which
     * jumped over it every time (docs/arm64-performance-review.md section
     * 3.3), and so did a proxy's slow path. *)
    let chains(s: select.Selection final: Array(Int)): Array(Int) =
        begin
            let m = s.f
            let cold = coldBlocks(s)
            let depth = machine.loopDepths(m)
            let count = vector.length(:Int s.layout)
            let n = vector.length(:machine.Block m.blocks)
            let at = array of(n ~1)
            for k = 0 upto {count - 1} do at[vector.get(:Int s.layout k)] := k end
            let calls = array of(n false)
            for b = 0 upto {n - 1} do
                let insts = machine.block(m b).insts
                for j = 0 upto {vector.length(:machine.Inst insts) - 1} do
                    if machine.isKind(vector.get(:machine.Inst insts j) machine.kindCall) then calls[b] := true end
                end
            end
            let placed = array of(n false)
            let order = vector.new(:Int)
            let place(b: Int): Ok =
                begin
                    placed[b] := true
                    vector.append(:Int order b)
                end
            let open(b: Int): Bool = {at[b] >= 0} andif {final[b] is b} andif not(placed[b]) andif not(cold[b])
            let better(a: Int b: Int): Bool =
                if depth[a] isnot depth[b] then depth[a] > depth[b]
                elsif calls[a] isnot calls[b] then not(calls[a])
                else at[a] < at[b] end
            let var cur = vector.get(:Int s.layout 0)
            let var next = 0
            place(cur)
            let var done = false
            while not(done) do
                let insts = machine.block(m cur).insts
                let var best = ~1
                for j = 0 upto {vector.length(:machine.Inst insts) - 1} do
                    let t = vector.get(:machine.Inst insts j).target
                    if {t >= 0} andif open(final[t]) andif {{best < 0} orif better(final[t] best)} then
                        best := final[t]
                    end
                end
                while {best < 0} andif {next < count} do
                    if open(vector.get(:Int s.layout next)) then best := vector.get(:Int s.layout next) end
                    next := next + 1
                end
                if best < 0 then done := true
                else
                    place(best)
                    cur := best
                end
            end
            for k = 0 upto {count - 1} do
                let b = vector.get(:Int s.layout k)
                if not(placed[b]) andif {final[b] is b} then place(b) end
            end
            vector.toArray(:Int order)
        end

    (* The label just past the code of the unit's function numbered index *)
    let endLabel(index: Int): String = "Lf" <> conv.int(index) <> "_end"

    (* A function's machine code, after branch relaxation, and its frame for
     * the unit's frame table, if its calls have maps. A label after each
     * such call (prefix_mN) keeps the call's place through pairing and
     * relaxation, and is then dropped, its offset noted *)
    Let Machined = Tuple code: Code frame: maybe.T(Frame) end
    let machineCode(f: Function index: Int defined: hashMap.T(String Bool)): Machined =
        begin
            let c = compile(f index defined)
            let s = c.selection
            let m = s.f
            let e = tuple let c = c let code = vector.new(:minst.Inst) end
            let nBlocks = vector.length(:machine.Block m.blocks)
            (* A block that only jumps, which a raise does not enter and which
             * is not the entry, is passed over: what goes to it goes where it
             * does *)
            let passes(b: Int): Bool =
                begin
                    let blk = machine.block(m b)
                    {b > 0} andif not(blk.raised) andif {vector.length(:machine.Inst blk.insts) is 1}
                        andif machine.isKind(vector.get(:machine.Inst blk.insts 0) machine.kindJump)
                end
            (* Where each block's code is: its own, or, passed over, where its
             * jumps lead (its own again for a cycle of blocks that only
             * jump) *)
            let final = array of(nBlocks 0)
            for b = 0 upto {nBlocks - 1} do
                let var to = b
                let var steps = 0
                while passes(to) andif {steps < nBlocks} do
                    to := vector.get(:machine.Inst machine.block(m to).insts 0).target
                    steps := steps + 1
                end
                final[b] := if passes(to) then b else to end
            end
            let printed = vector.new(:Int)
            let order = chains(s final)
            for k = 0 upto {extent order - 1} do vector.append(:Int printed order[k]) end
            prologue(e)
            let var liveLabels = 0
            let marker = s.prefix <> "_m"
            let mapped = vector.new(:CallMap)
            (* The line table: the source position before each instruction
             * whose position differs from the last one given. A constant or an
             * address made again where it is used keeps its definition's
             * position, so it gives none *)
            let var last = ssa.noLoc
            for k = 0 upto {vector.length(:Int printed) - 1} do
                let b = vector.get(:Int printed k)
                let next = if {k + 1} < vector.length(:Int printed) then vector.get(:Int printed k + 1) else ~1 end
                emit(e minst.label(select.label(s b)))
                let insts = machine.block(m b).insts
                let count = vector.length(:machine.Inst insts)
                let var inverted = false
                let var calls = 0
                let var mappedCalls = 0
                for j = 0 upto {count - 1} do
                    let i = vector.get(:machine.Inst insts j)
                    let regs = array of(extent i.operands 0)
                    for r = 0 upto {extent regs - 1} do regs[r] := i.operands[r].reg end
                    let base = vector.get(:minst.Op s.ops i.op)
                    let op = if i.target >= 0 then retarget(base select.label(s final[i.target])) else base end
                    (* A conditional branch to the next block, before the
                     * block's last jump, is its inverse to the jump's target,
                     * and the jump falls through, as does a jump to the next
                     * block *)
                    let c = conditional(op)
                    let following = if {j + 1} < count then
                        maybe.some(:machine.Inst vector.get(:machine.Inst insts j + 1))
                    else maybe.none(:machine.Inst) end
                    let invert = maybe.isSome(:Conditional c) andif {final[i.target] is next} andif {{j + 2} is count}
                        andif machine.isKind(maybe.unwrap(:machine.Inst following) machine.kindJump)
                        andif {final[maybe.unwrap(:machine.Inst following).target] isnot next}
                    let falls = inverted orif {machine.isKind(i machine.kindJump) andif {final[i.target] is next}}
                    if invert orif not(falls) then
                        let l = vector.get(:ssa.Loc s.locs i.op)
                        if ssa.hasLoc(l) andif not(ssa.sameLoc(l last)) andif not(select.rematerializable(s i)) then
                            emit(e minst.loc(l.file l.line l.col))
                            last := l
                        end
                        if machine.isKind(i machine.kindReturn) andif not(isBrk(op)) then restore(e) end
                        if invert then
                            let to = select.label(s final[maybe.unwrap(:machine.Inst following).target])
                            emit(e tuple let op = maybe.unwrap(:Conditional c).inverse(to) let regs = regs end)
                            inverted := true
                        else
                            emit(e tuple let op = op let regs = regs end)
                        end
                    end
                    if machine.isKind(i machine.kindCall) andif {mappedCalls < extent e.c.maps[b]} then
                        emit(e minst.label(marker <> conv.int(vector.length(:CallMap mapped))))
                        vector.append(:CallMap mapped e.c.maps[b][mappedCalls])
                        mappedCalls := mappedCalls + 1
                    end
                    (* With QUEST_LIVE_SLOTS=1, a symbol at the return address,
                     * by which a debugger can find what is live across the
                     * call, which a comment gives with the size of the frame
                     * below the saved registers (docs/profiling.md section 6).
                     * The symbol is an alternative entry, so that the linker
                     * does not take it to start a function of its own. *)
                    if machine.isKind(i machine.kindCall) andif {calls < extent e.c.liveAtCalls[b]} then
                        let name = asm.symbol(f.symbol <> "_live_" <> conv.int(liveLabels))
                        let described = e.c.liveAtCalls[b][calls]
                        let comment = "// live (frame " <> conv.int(e.c.size) <> "): " <> described
                        emit(e minst.label(".alt_entry " <> name <> "\n" <> comment <> "\n" <> name))
                        calls := calls + 1
                        liveLabels := liveLabels + 1
                    end
                end
            end
            let relaxed = relaxBranches(pairs(e.code) s.prefix branchReach)
            let code = vector.new(:minst.Inst)
            let sites = vector.new(:CallSite)
            let var at = 0
            for k = 0 upto {vector.length(:minst.Inst relaxed) - 1} do
                let i = vector.get(:minst.Inst relaxed k)
                case i.op
                    when opLabel with x then
                        if strutil.startsWith(x.label marker) then
                            vector.append(:CallSite sites tuple
                                let offset = at let map = vector.get(:CallMap mapped vector.length(:CallSite sites))
                            end)
                        else vector.append(:minst.Inst code i) end
                    else
                        at := at + printer.count(i.op)
                        vector.append(:minst.Inst code i)
                end
            end
            let var savedMask = 0
            for k = {extent c.saved - 1} downto 0 do
                let var bit = 1
                for x = 1 upto c.saved[k] do bit := 2 * bit end
                savedMask := savedMask + bit
            end
            tuple
                let code = code
                let frame = if s.entersTry then maybe.none(:Frame) else maybe.some(:Frame tuple
                    let below = {{16 * extent c.saved} + c.size} / 8 let saved = savedMask
                    let undescribed = s.slotsEnd / 8 let calls = vector.toArray(:CallSite sites)
                end) end
            end
        end

    let frameMaps(f: Function): Array(String) =
        begin
            let made = machineCode(f 0 hashMap.new(:String :Bool eq hash.string))
            let lines = vector.new(:String)
            if maybe.isSome(:Frame made.frame) then
                let frame = maybe.unwrap(:Frame made.frame)
                let pairs = vector.new(:String)
                let var mask = frame.saved
                for k = 0 upto {extent savedFirsts - 1} do
                    if {mask % 2} is 1 then
                        vector.append(:String pairs target.description.registers[savedFirsts[k]].name <> "/"
                            <> target.description.registers[savedSeconds[k]].name)
                    end
                    mask := mask / 2
                end
                vector.append(:String lines "frame: " <> conv.int(frame.below) <> " words below the record, saves "
                    <> if vector.empty(:String pairs) then "nothing" else strutil.join(" " pairs) end <> ", "
                    <> conv.int(frame.undescribed) <> " words not described")
                let className(class: Int): String = if class is 1 then "ptr" else "word" end
                for c = 0 upto {extent frame.calls - 1} do
                    let site = frame.calls[c]
                    let parts = vector.new(:String)
                    let var registers = site.map.registers
                    for x = 0 upto 9 do
                        if {registers % 4} > 0 then
                            vector.append(:String parts "x" <> conv.int(19 + x) <> " " <> className(registers % 4))
                        end
                        registers := registers / 4
                    end
                    for k = 0 upto {extent site.map.slots - 1} do
                        let slot = site.map.slots[k]
                        vector.append(:String parts
                            "sp+" <> conv.int(8 * {slot / 2}) <> " " <> className(1 + {slot % 2}))
                    end
                    vector.append(:String lines "call returning at " <> conv.int(site.offset) <> ": "
                        <> if vector.empty(:String parts) then "nothing live" else strutil.join(", " parts) end)
                end
            end
            vector.toArray(:String lines)
        end

    let function(f: Function index: Int code: Code): Lines =
        begin
            let lines = vector.new(:String)
            let start = asm.functionStart(f.symbol f.exported)
            for k = 0 upto {extent start - 1} do vector.append(:String lines start[k]) end
            for k = 0 upto {vector.length(:minst.Inst code) - 1} do
                let i = vector.get(:minst.Inst code k)
                let ls = printer.lines(i.op i.regs printer.physical)
                for j = 0 upto {extent ls - 1} do vector.append(:String lines ls[j]) end
            end
            vector.append(:String lines endLabel(index) <> ":")
            for k = 0 upto {extent asm.functionEnd - 1} do vector.append(:String lines asm.functionEnd[k]) end
            lines
        end

    (* The symbols the unit defines, each with whether a call of it in the
     * unit gets its narrow results extended, so that the caller need not
     * extend them again (docs/ssa.md section 2.2): a function's do, since it
     * extends what it computes, unless it tail-calls, for a narrow result, a
     * function outside the unit, through a pointer, or one whose results do
     * not, returning the byte as that callee left it. Data's are false. *)
    let definedSymbols(u: ssa.Unit): hashMap.T(String Bool) =
        begin
            let defined = hashMap.new(:String :Bool eq hash.string)
            for k = 0 upto {vector.length(:ssa.Data u.data) - 1} do
                put(:String :Bool defined vector.get(:ssa.Data u.data k).symbol false)
            end
            let n = vector.length(:Function u.functions)
            for k = 0 upto {n - 1} do put(:String :Bool defined vector.get(:Function u.functions k).symbol true) end
            let extends(i: ssa.Inst): Bool =
                {extent ssa.narrowOf(i.signature.results) is 0} orif {ssa.isOp(i ssa.opCall)
                    andif maybe.isSome(:Bool hashMap.get(:String :Bool defined i.symbol))
                    andif maybe.unwrap(:Bool hashMap.get(:String :Bool defined i.symbol))}
            let var changed = true
            while changed do
                changed := false
                for k = 0 upto {n - 1} do
                    let f = vector.get(:Function u.functions k)
                    if maybe.unwrap(:Bool hashMap.get(:String :Bool defined f.symbol)) then
                        for b = 0 upto {vector.length(:ssa.Block f.blocks) - 1} do
                            case ssa.block(f b).term
                                when termTailCall with x then
                                    if not(extends(x.call)) then
                                        put(:String :Bool defined f.symbol false)
                                        changed := true
                                    end
                                when termNone, termJump, termBranch, termSwitch, termReturn, termTry, termUnreachable
                                    then ok
                            end
                        end
                    end
                end
            end
            defined
        end

    (* The unit's frame table's symbol, a placeholder of which the SSA's
     * builder makes (ssa/build/unit), with the call that registers it: the
     * backend writes the table in the placeholder's place *)
    let framesSymbol = "qr_frames"
    let hasFrames(u: ssa.Unit): Bool =
        begin
            let var found = false
            for k = 0 upto {vector.length(:ssa.Data u.data) - 1} do
                if eq(vector.get(:ssa.Data u.data k).symbol framesSymbol) then found := true end
            end
            found
        end
    let dataBesidesFrames(u: ssa.Unit): Array(ssa.Data) =
        begin
            let kept = vector.new(:ssa.Data)
            for k = 0 upto {vector.length(:ssa.Data u.data) - 1} do
                let d = vector.get(:ssa.Data u.data k)
                if not(eq(d.symbol framesSymbol)) then vector.append(:ssa.Data kept d) end
            end
            vector.toArray(:ssa.Data kept)
        end

    (* An unsigned LEB128 number's bytes *)
    let leb(bytes: vector.T(Int) n: Int): Ok =
        begin
            let var rest = n
            let var more = true
            while more do
                let low = rest % 128
                rest := rest / 128
                if rest is 0 then
                    vector.append(:Int bytes low)
                    more := false
                else
                    vector.append(:Int bytes low + 128)
                end
            end
        end

    (* The unit's frame table before its addresses are known (docs/arm64.md
     * section 3.13; runtime/quest_gc.c has the form): the functions with
     * calls that have maps, each with its description: the words from sp to
     * its frame record, the pairs it saves, the words at sp with no
     * description, its calls' number, and each call's return address (in
     * instructions from the call before's), registers, and slots *)
    let frameTable(frames: Array(maybe.T(Frame))): encode.Frames =
        begin
            let listed = vector.new(:encode.Listed)
            let bytes = vector.new(:Int)
            for k = 0 upto {extent frames - 1} do
                if maybe.isSome(:Frame frames[k]) andif {extent maybe.unwrap(:Frame frames[k]).calls > 0} then
                    let f = maybe.unwrap(:Frame frames[k])
                    vector.append(:encode.Listed listed
                        tuple let index = k let description = vector.length(:Int bytes) end)
                    leb(bytes f.below)
                    leb(bytes f.saved)
                    leb(bytes f.undescribed)
                    leb(bytes extent f.calls)
                    let var last = 0
                    for c = 0 upto {extent f.calls - 1} do
                        let site = f.calls[c]
                        leb(bytes site.offset - last)
                        last := site.offset
                        leb(bytes site.map.registers)
                        leb(bytes extent site.map.slots)
                        for x = 0 upto {extent site.map.slots - 1} do leb(bytes site.map.slots[x]) end
                    end
                end
            end
            tuple
                let listed = vector.toArray(:encode.Listed listed) let descriptions = vector.toArray(:Int bytes)
            end
        end

    let assembleUnit(u: ssa.Unit): String =
        begin
            let defined = definedSymbols(u)
            let lines = vector.new(:String)
            let appendAll(ls: Array(String)): Ok =
                for k = 0 upto {extent ls - 1} do vector.append(:String lines ls[k]) end
            appendAll(asm.unitStart)
            (* The line table's files, and its debugging information if the
             * unit's own file is known and the unit has code *)
            let files = vector.toArray(:String u.files)
            appendAll(asm.files(files))
            let debugged = {extent files > 0} andif {stringOp.length(files[0]) > 0}
                andif not(vector.empty(:Function u.functions))
            let machines = array of(vector.length(:Function u.functions) tuple
                let symbol = "" let exported = false let code = vector.new(:minst.Inst) let endLabel = ""
            end)
            let frames = array of(vector.length(:Function u.functions) maybe.none(:Frame))
            for k = 0 upto {vector.length(:Function u.functions) - 1} do
                let f = vector.get(:Function u.functions k)
                let made = machineCode(f k defined)
                machines[k] := tuple
                    let symbol = f.symbol let exported = f.exported let code = made.code let endLabel = endLabel(k)
                end
                frames[k] := made.frame
                let fl = function(f k machines[k].code)
                for j = 0 upto {vector.length(:String fl) - 1} do
                    vector.append(:String lines vector.get(:String fl j))
                end
            end
            let data = dataBesidesFrames(u)
            for k = 0 upto {extent data - 1} do
                let dl = asm.data(data[k])
                for j = 0 upto {extent dl - 1} do vector.append(:String lines dl[j]) end
            end
            let table = if hasFrames(u) then maybe.some(:encode.Frames frameTable(frames))
                else maybe.none(:encode.Frames) end
            if maybe.isSome(:encode.Frames table) then
                let t = maybe.unwrap(:encode.Frames table)
                let listed = array of(extent t.listed tuple let symbol = "" let description = 0 end)
                for k = 0 upto {extent listed - 1} do
                    listed[k] := tuple
                        let symbol = machines[t.listed[k].index].symbol let description = t.listed[k].description
                    end
                end
                appendAll(asm.frames(framesSymbol if extent machines > 0 then machines[0].symbol else "" end listed
                    t.descriptions))
            end
            if debugged then
                let functions = array of(vector.length(:Function u.functions)
                    tuple let symbol = "" let endLabel = "" end)
                for k = 0 upto {extent functions - 1} do
                    functions[k] := tuple
                        let symbol = vector.get(:Function u.functions k).symbol let endLabel = endLabel(k)
                    end
                end
                appendAll(asm.debugInfo(files[0] functions))
            end
            appendAll(asm.unitEnd)
            (* With QUEST_CHECK_ENCODING=1, the encoder's code and data for
             * the unit, as comments, which tests/self-hosted/encoder.py
             * compares with what the assembler makes of the rest *)
            if stringOp.equal(system.getEnv("QUEST_CHECK_ENCODING") "1") then
                let described = encode.describe(encode.unit(machines data vector.toArray(:String u.files) table))
                for k = 0 upto {extent described - 1} do vector.append(:String lines "// encoded " <> described[k]) end
            end
            strutil.join("\n" lines) <> "\n"
        end

    let encodeUnit(u: ssa.Unit): encode.Encoded =
        begin
            let defined = definedSymbols(u)
            let machines = array of(vector.length(:Function u.functions) tuple
                let symbol = "" let exported = false let code = vector.new(:minst.Inst) let endLabel = ""
            end)
            let frames = array of(vector.length(:Function u.functions) maybe.none(:Frame))
            for k = 0 upto {vector.length(:Function u.functions) - 1} do
                let f = vector.get(:Function u.functions k)
                let made = machineCode(f k defined)
                machines[k] := tuple
                    let symbol = f.symbol let exported = f.exported let code = made.code let endLabel = endLabel(k)
                end
                frames[k] := made.frame
            end
            encode.unit(machines dataBesidesFrames(u) vector.toArray(:String u.files)
                if hasFrames(u) then maybe.some(:encode.Frames frameTable(frames))
                else maybe.none(:encode.Frames) end)
        end
end
