(* Quest Self-Hosted Compiler: The arm64 Encoder Interface
 *
 * This module encodes arm64 machine instructions directly into binary machine
 * code for the JIT, bypassing the external assembler (as) and linker (ld)
 * (docs/jit.md section 3.5). It turns each codegen/arm64/minst instruction
 * into its 32-bit word (matching codegen/arm64/printer) and packs a unit's
 * functions and static data into code and data sections with relocations
 * (placeholders the loader patches with final symbol addresses). Labels are
 * resolved here, while symbols (even the unit's own, except non-exported
 * self-calls) are left to the loader, so relocated instruction fields are
 * left as 0 and relocated data words hold their addend, as in an object file.
 * Unwind directives are dropped, and source line positions are kept in a
 * table that the JIT exposes to a debugger (docs/jit.md section 3.12). *)

interface Encode
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/codegen/arm64/minst : questlang/codegen/arm64/Minst
    collections/vector : collections/Vector
    util/maybe : util/Maybe
export
    (* The relocation kinds that patch an instruction or data word: a 26-bit
     * branch target for bl or b (branch26); a 21-bit page address for adrp
     * and its 12-bit page offset for add or load, targeting a symbol
     * directly (page21, pageOff12), its GOT entry (gotPage21, gotPageOff12),
     * or its thread-local descriptor (tlvPage21, tlvPageOff12); and a 64-bit
     * absolute address in a data word (absolute64) *)
    Def RelocKind = Option
        relocBranch26 relocPage21 relocPageOff12 relocGotPage21 relocGotPageOff12 relocTlvPage21 relocTlvPageOff12
        relocAbsolute64
    end
    (* At offset bytes into its section, the symbol's address plus addend *)
    Def Reloc = Tuple offset: Int kind: RelocKind symbol: String addend: Int end
    (* A symbol defined at offset bytes into its section, of size bytes *)
    Def Symbol = Tuple name: String offset: Int size: Int exported: Bool end

    (* A function's machine code: its instructions, after branch relaxation,
     * and the label just past them *)
    Def Function = Tuple symbol: String exported: Bool code: vector.T(minst.Inst) endLabel: String end

    (* From offset bytes into the code, the source position file (a number in
     * the unit's files, from 1), line, and column, as a .loc directive gives
     * it *)
    Def Line = Tuple offset: Int file: Int line: Int column: Int end

    (* A unit's GC frame table (stack maps for runtime/quest_gc.c;
     * docs/arm64.md section 3.13) before code addresses are known. Each
     * Listed entry identifies a function by its index in the unit (in code
     * order) and the byte offset where its stack-map description starts in
     * descriptions. *)
    Def Listed = Tuple index: Int description: Int end
    Def Frames = Tuple listed: Array(Listed) descriptions: Array(Int) end

    (* An encoded compilation unit ready for the JIT loader. It holds the
     * code section as 32-bit words, the data section as bytes (each datum
     * aligned to 8 bytes, matching asm), symbol and relocation tables,
     * source-line entries referring to the absolute file paths in files
     * (from ssa.Unit.files), and the GC frame table as 32-bit words (empty
     * if none). The loader places the frame table within 2 GB of the code
     * and patches its first word to the code address minus the table
     * address. *)
    Def Encoded = Tuple
        code: Array(Int)
        codeRelocs: Array(Reloc)
        functions: Array(Symbol)
        data: Array(Int)
        dataRelocs: Array(Reloc)
        dataSymbols: Array(Symbol)
        lines: Array(Line)
        files: Array(String)
        frames: Array(Int)
    end

    (* What cannot be encoded, naming it *)
    unencodable: Exception(String)

    (* Encodes op on registers regs at byte offset at into its 32-bit machine
     * word. op must be a single real instruction (not a pseudo-instruction,
     * which printer.expansion splits first, nor a label or directive).
     * labelOffset returns each label's byte offset in the code.
     * localFunction returns the byte offset of a function reachable directly
     * without a relocation, or ~1 otherwise; matching the assembler, only a
     * non-exported function's recursive call to itself qualifies. Any
     * relocation the instruction needs (a call to another symbol, an adrp
     * page, or a page offset) is appended to relocs with its bit field left
     * as 0. Raises unencodable if op has no encoding. *)
    word(op: minst.Op regs: Array(Int) at: Int labelOffset: All(label: String) Int
        localFunction: All(symbol: String) Int relocs: vector.T(Reloc)): Int

    (* Encodes a unit into binary code, data, relocations, line info, and an
     * optional GC frame table. Functions are laid out in order, padded with
     * nop instructions to 16-byte boundaries (matching asm.functionStart),
     * and each datum is aligned to an 8-byte boundary. Raises unencodable if
     * any branch references an undefined label or if an instruction has no
     * encoding. *)
    unit(functions: Array(Function) data: Array(ssa.Data) files: Array(String) frames: maybe.T(Frames)): Encoded

    (* An Encoded as text, one item a line, for the encoder's check
     * (tests/self-hosted/encoder.py): "code OFFSET WORD", "reloc SECTION
     * OFFSET KIND SYMBOL ADDEND", "function NAME OFFSET SIZE", "data NAME
     * OFFSET BYTES", "frames WORDS" (words and bytes in hexadecimal) *)
    describe(e: Encoded): Array(String)
end
