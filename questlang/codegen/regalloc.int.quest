(* Quest Self-Hosted Compiler: The Register Allocator's Interface
 *
 * Linear scan with interval splitting over a function's SSA (docs/arm64.md
 * section 3.8, after Wimmer and Mossenbock), parameterized by a target's
 * registers so that it can be tested on its own. The blocks are laid out in
 * reverse postorder, two positions for each block's start, instruction, and
 * terminator: an instruction's operands are read at its position and its
 * results written at the next, so that a result may take a register an
 * operand's interval ends in. Each value's lifetime interval is the ranges of
 * positions where it is live, with holes where it is not, from liveness over
 * the blocks. The intervals are taken in order of their starts; each gets a
 * register free for all of it, or for a part, the rest split off; when none is
 * free, the interval whose next use is furthest is spilled until its next use.
 *
 * So a value lives in pieces, each in a register or in memory. A value with a
 * piece in memory is stored there when it is defined, and since an SSA value
 * never changes, its memory is valid wherever it is live: going from a
 * register to memory costs nothing, and going back is a load (or, for a
 * constant, an address, or the null, which codegen rematerializes, the
 * instruction again) where the piece starts, before an instruction that uses
 * it. A piece starting at a block's start is reached on each edge into the
 * block, whose code moves each value live there from where it is at the edge's
 * source. A call clobbers the caller-saved registers, so a value live across
 * one is in a callee-saved register or in memory there; a try's handler is
 * entered with every register dead, so a value live into one is in memory at
 * its start. *)

interface Regalloc
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    (* A target's allocatable registers by class: 0 for integers and pointers,
     * 1 for reals. A call preserves the callee-saved ones and no others. *)
    Def Registers = Tuple callerSaved: Array(Array(String)) calleeSaved: Array(Array(String)) end

    (* At a position, a value's move from a register ("" for its memory) to
     * the register its next piece is in *)
    Def Move = Tuple at: Int value: Int from: String to: String end

    Def Allocation = Tuple
        (* Each value's pieces: where each starts, in order, and its register,
         * "" for memory *)
        starts: Array(Array(Int))
        homes: Array(Array(String))
        (* Whether a value has a piece in memory (or no pieces), and so is
         * stored there when it is defined *)
        spilled: Array(Bool)
        (* The moves to pieces in registers that start inside blocks, in order
         * of their positions, each made just before the instruction there *)
        moves: Array(Move)
        (* Each block's first position, negative for one not reached *)
        blockStart: Array(Int)
        (* What each block's edges in must move: the values live into it *)
        liveIn: Array(Array(Int))
        (* The callee-saved registers given to any value *)
        calleeUsed: Array(String)
    end

    (* The allocation of a function's values; clobbers says which
     * instructions are calls, or otherwise use the registers a call may *)
    allocate(f: ssa.Function regs: Registers clobbers: All(i: ssa.Inst) Bool): Allocation
    (* None: every value in memory throughout *)
    spillAll(f: ssa.Function): Allocation
    (* Where a value is at a position: its register, "" for memory *)
    home(a: Allocation v: Int p: Int): String
end
