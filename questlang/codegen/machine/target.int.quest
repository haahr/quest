(* Quest Self-Hosted Compiler: A Target Description Interface
 *
 * This interface describes what shared machine-level code (the register
 * allocator and codegen/machine/machine; docs/arm64.md section 3.17) needs
 * to know about a target architecture: its numbered registers (each with a
 * class and a name), which registers are allocatable and which are preserved
 * across calls, and its calling convention's registers and sizes, which the
 * target's instruction selection and the allocator's lowering read. Register
 * names are used only for printing and tests; shared code compares register
 * numbers. *)

interface Target
export
    (* A register's class: integers and pointers, or reals *)
    Def Class = Option classInt classReal end
    Def Register = Tuple name: String class: Class end
    classInt: Class
    classReal: Class
    (* A table with an entry for each class, at the class's index *)
    Def PerClass = Fun(A::TYPE) Array(A)

    Def Target = Tuple
        (* Each register, by its number *)
        registers: Array(Register)
        (* The allocatable registers, by class: those a call clobbers, and
         * those it preserves, in order of preference *)
        callerSaved: PerClass(Array(Int))
        calleeSaved: PerClass(Array(Int))
        (* The registers arguments and results are passed in, by class, in
         * order *)
        arguments: PerClass(Array(Int))
        results: PerClass(Array(Int))
        (* Registers no value is given, by class, in the order the
         * allocator's rewrite uses them for operands in memory
         * (machine.Lowering's scratch) *)
        scratch: PerClass(Array(Int))
        (* The stack's alignment at a call, and a word's size, in bytes:
         * each argument passed on the stack takes a word unless the target
         * packs it narrower *)
        stackAlign: Int
        wordBytes: Int
    end

    (* The classes, and each one's index into a table by class *)
    classes: Int
    index(c: Class): Int
    (* A table's entry for a class *)
    at(A::TYPE)(table: PerClass(A) c: Class): A
    (* A register's name *)
    name(t: Target r: Int): String
end
