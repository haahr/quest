(* Quest Self-Hosted Compiler: A Target Description Implementation *)

module target : Target
export
    Def Class = Option classInt classReal end
    Def Register = Tuple name: String class: Class end
    let classInt: Class = option classInt of Class end
    let classReal: Class = option classReal of Class end
    Def PerClass = Fun(A::TYPE) Array(A)
    Def Target = Tuple
        registers: Array(Register)
        callerSaved: PerClass(Array(Int))
        calleeSaved: PerClass(Array(Int))
        arguments: PerClass(Array(Int))
        results: PerClass(Array(Int))
        scratch: PerClass(Array(Int))
        stackAlign: Int
        wordBytes: Int
    end

    let classes = 2
    let index(c: Class): Int = case c when classInt then 0 when classReal then 1 end
    let at(A::TYPE)(table: PerClass(A) c: Class): A = table[index(c)]
    let name(t: Target r: Int): String = t.registers[r].name
end
