(* Quest Self-Hosted Compiler: The Register Allocator's Implementation
 *
 * The interface's header describes the algorithm. This module has four
 * parts: lifetime intervals and the operations on them; a heap of the
 * intervals not yet allocated, earliest start first; the scan, allocate,
 * which chooses each interval's register; and rewrite, which puts the
 * choices into the function's instructions. *)

module regalloc : Regalloc
import
    targets = questlang/codegen/target : questlang/codegen/Target
    questlang/codegen/machine : questlang/codegen/Machine
    collections/vector : collections/Vector
    collections/bitset : collections/Bitset
    util/sort : util/Sort
export
    Def Move = Tuple at: Int value: Int from: Int to: Int end
    Def Allocation = Tuple
        starts: Array(Array(Int)) homes: Array(Array(Int)) spilled: Array(Bool) remat: Array(Bool) moves: Array(Move)
        blockStart: Array(Int) liveIn: Array(Array(Int)) calleeUsed: Array(Int) first: Array(Int) last: Array(Int)
    end
    let memory = ~1
    Let Function = machine.Function

    (* A lifetime interval, or a piece split from one: its virtual register's
     * index; its ranges of positions, from froms[k] to tos[k] inclusive, in
     * order, with gaps (holes) between them; the positions where it is read,
     * in order; and its register, as an index in its class's pool (Scan,
     * below), ~1 for memory, and ~2 for none chosen yet. Splitting shortens an
     * interval in place, and the scan sets its register, so the fields are
     * var. *)
    Let Interval = Tuple
        value: Int
        var froms: Array(Int)
        var tos: Array(Int)
        var uses: Array(Int)
        var reg: Int
    end

    (* A position past every position: the next use of an interval that has
     * none left, and the limit of a register that nothing makes unavailable *)
    let never = 4611686018427387903

    (* Adds v to s, whether or not it was there *)
    let add(s: bitset.T v: Int): Ok = if bitset.insert(s v) then ok else ok end
    let concat(a: Array(Int) b: Array(Int)): Array(Int) =
        begin
            let r = array of({extent a + extent b} 0)
            for i = 0 upto {extent a - 1} do r[i] := a[i] end
            for i = 0 upto {extent b - 1} do r[extent a + i] := b[i] end
            r
        end
    (* v's elements, last first: allocate builds its lists backwards *)
    let reversed(v: vector.T(Int)): Array(Int) =
        begin
            let n = vector.length(:Int v)
            let r = array of(n 0)
            for i = 0 upto {n - 1} do r[i] := vector.get(:Int v {n - 1} - i) end
            r
        end

    (* The piece holding v at p is the last that starts at or before p. Before
     * its first piece v is not yet defined, so nothing reads it there. *)
    let home(a: Allocation v: Int p: Int): Int =
        begin
            let k = sort.bisectRight(:Int a.starts[v] p sort.intCompare) - 1
            if k < 0 then memory else a.homes[v][k] end
        end
    (* A value with a piece in memory is stored when it is defined, unless it
     * is rematerialized: computed again wherever it is needed instead *)
    let needsSlot(a: Allocation v: Int): Bool = a.spilled[v] andif not(a.remat[v])

    (* =========================================================================
     * Intervals
     * ====================================================================== *)

    let firstPos(it: Interval): Int = it.froms[0]
    let lastPos(it: Interval): Int = it.tos[extent it.tos - 1]

    (* Whether p is in one of its ranges, rather than in a hole or outside
     * it: a binary search for the last range starting at or before p *)
    let covers(it: Interval p: Int): Bool =
        begin
            let k = sort.bisectRight(:Int it.froms p sort.intCompare) - 1
            {k >= 0} andif {it.tos[k] >= p}
        end

    (* The first position both cover, ~1 for none. It walks the two lists of
     * ranges together, as a merge does, each time moving past whichever
     * current range ends first, until two ranges overlap. *)
    let intersection(a: Interval b: Interval): Int =
        begin
            let var i = 0
            let var j = 0
            let var found = ~1
            while {found < 0} andif {i < extent a.froms} andif {j < extent b.froms} do
                let lo = if a.froms[i] > b.froms[j] then a.froms[i] else b.froms[j] end
                let hi = if a.tos[i] < b.tos[j] then a.tos[i] else b.tos[j] end
                if lo <= hi then found := lo
                elsif a.tos[i] < b.tos[j] then i := i + 1
                else j := j + 1 end
            end
            found
        end

    (* Its first use at or after p, never for none *)
    let nextUse(it: Interval p: Int): Int =
        begin
            let k = sort.bisectLeft(:Int it.uses p sort.intCompare)
            if k < extent it.uses then it.uses[k] else never end
        end

    (* Its part from p on, split off as a new piece with no register yet: it
     * keeps what is before p. A range that spans p is cut in two, up to p - 1
     * and from p; each use goes with the side its position is on. If p is in
     * a hole, the new piece starts at the next range. The caller must split
     * where both sides are left with a range. *)
    let split(it: Interval p: Int): Interval =
        begin
            let hf = vector.new(:Int)
            let ht = vector.new(:Int)
            let cf = vector.new(:Int)
            let ct = vector.new(:Int)
            for k = 0 upto {extent it.froms - 1} do
                let a = it.froms[k]
                let b = it.tos[k]
                if b < p then
                    vector.append(:Int hf a)
                    vector.append(:Int ht b)
                elsif a >= p then
                    vector.append(:Int cf a)
                    vector.append(:Int ct b)
                else
                    vector.append(:Int hf a)
                    vector.append(:Int ht p - 1)
                    vector.append(:Int cf p)
                    vector.append(:Int ct b)
                end
            end
            let hu = vector.new(:Int)
            let cu = vector.new(:Int)
            for k = 0 upto {extent it.uses - 1} do
                if it.uses[k] < p then vector.append(:Int hu it.uses[k]) else vector.append(:Int cu it.uses[k]) end
            end
            it.froms := vector.toArray(:Int hf)
            it.tos := vector.toArray(:Int ht)
            it.uses := vector.toArray(:Int hu)
            tuple
                let value = it.value let var froms = vector.toArray(:Int cf) let var tos = vector.toArray(:Int ct)
                let var uses = vector.toArray(:Int cu) let var reg = ~2
            end
        end

    (* =========================================================================
     * The unhandled intervals: a heap, earliest start first
     *
     * A binary heap in a vector, the children of element k at 2k + 1 and
     * 2k + 2. Splitting adds intervals that start no earlier than the
     * current one, so the intervals waiting to be allocated are a priority
     * queue rather than a list sorted once.
     * ====================================================================== *)

    (* Whether a comes out of the heap before b: the earlier start first, and
     * at the same start, the lower virtual register, so that the order
     * depends only on the intervals *)
    let before(a: Interval b: Interval): Bool =
        {firstPos(a) < firstPos(b)} orif {{firstPos(a) is firstPos(b)} andif {a.value < b.value}}

    let swap(h: vector.T(Interval) i: Int j: Int): Ok =
        begin
            let t = vector.get(:Interval h i)
            vector.set(:Interval h i vector.get(:Interval h j))
            vector.set(:Interval h j t)
        end

    (* Adds it at the end, then moves it up past each parent it comes before *)
    let push(h: vector.T(Interval) it: Interval): Ok =
        begin
            vector.append(:Interval h it)
            let var k = vector.length(:Interval h) - 1
            while {k > 0} andif before(vector.get(:Interval h k) vector.get(:Interval h {k - 1} / 2)) do
                swap(h k {k - 1} / 2)
                k := {k - 1} / 2
            end
        end

    (* Removes and returns the first interval: the last element takes its
     * place, and moves down, swapped with its earlier child, while either
     * child comes before it *)
    let pop(h: vector.T(Interval)): Interval =
        begin
            let top = vector.get(:Interval h 0)
            let last = vector.pop(:Interval h)
            let n = vector.length(:Interval h)
            if n > 0 then
                vector.set(:Interval h 0 last)
                let var k = 0
                let var going = true
                while going do
                    let l = {2 * k} + 1
                    let r = l + 1
                    let var m = k
                    if {l < n} andif before(vector.get(:Interval h l) vector.get(:Interval h m)) then m := l end
                    if {r < n} andif before(vector.get(:Interval h r) vector.get(:Interval h m)) then m := r end
                    if m is k then going := false
                    else
                        swap(h k m)
                        k := m
                    end
                end
            end
            top
        end

    (* =========================================================================
     * The scan
     *
     * The intervals come off the heap in order of their starts. When one
     * does, call its start the current position. Each interval already given
     * a register that has not ended is either active, covering the current
     * position, or inactive, in a hole there; those are the only intervals
     * whose registers the current one must avoid. Intervals in memory need no
     * tracking, since memory is never short.
     * ====================================================================== *)

    Let Scan = Tuple
        (* Each virtual register's class, by its index *)
        classes: Array(Int)
        (* Every interval and piece, for the allocation's pieces *)
        intervals: vector.T(Interval)
        heap: vector.T(Interval)
        (* The intervals in registers that cover the current position, and
         * those in a hole there *)
        var active: vector.T(Interval)
        var inactive: vector.T(Interval)
        (* Each class's allocatable registers, caller-saved first, and the
         * index in each of the first callee-saved one. An interval's reg is an
         * index into its class's pool. *)
        pools: Array(Array(Int))
        firstCallee: Array(Int)
        (* The positions of calls, and of the starts of blocks a raise
         * enters, in order *)
        calls: Array(Int)
        handlers: Array(Int)
        (* Where each register of each class's pool is fixed, as an interval
         * (of no ranges for one never fixed) *)
        fixed: Array(Array(Interval))
        (* Each virtual register's hints, registers physical or virtual, and
         * the register it was last given (~1 for none) *)
        firstVirtual: Int
        hints: Array(vector.T(Int))
        given: Array(Int)
    end

    (* Records a new interval or piece, so that the allocation can list every
     * piece at the end *)
    let made(sc: Scan it: Interval): Ok = vector.append(:Interval sc.intervals it)

    (* For each register of class c's pool, the first position from where cur
     * starts at which cur cannot be in it, or never: for a caller-saved one,
     * just after the first call cur is live across; for any, the start of the
     * first block a raise enters that cur covers, and where an operand first
     * fixes it within cur. Only the first of each matters, since the result is
     * where the register first becomes unavailable. *)
    let blocked(sc: Scan cur: Interval c: Int): Array(Int) =
        begin
            let s = firstPos(cur)
            let e = lastPos(cur)
            (* cur is live across a call at p if it covers p, where the call
             * reads its operands, and p + 1, where it writes its results: live
             * after the call, not only an argument to it *)
            let var call = never
            let var k = sort.bisectLeft(:Int sc.calls s sort.intCompare)
            while {call is never} andif {k < extent sc.calls} andif {sc.calls[k] < e} do
                if covers(cur sc.calls[k]) andif covers(cur sc.calls[k] + 1) then call := sc.calls[k] + 1 end
                k := k + 1
            end
            let var handler = never
            let var j = sort.bisectLeft(:Int sc.handlers s sort.intCompare)
            while {handler is never} andif {j < extent sc.handlers} andif {sc.handlers[j] <= e} do
                if covers(cur sc.handlers[j]) then handler := sc.handlers[j] end
                j := j + 1
            end
            let r = array of(extent sc.pools[c] handler)
            if call < handler then for j = 0 upto {sc.firstCallee[c] - 1} do r[j] := call end end
            for j = 0 upto {extent r - 1} do
                let x = intersection(sc.fixed[c][j] cur)
                if {x >= 0} andif {x < r[j]} then r[j] := x end
            end
            r
        end

    (* Spills it from p: splits off its part from p, which is in memory until
     * its next use, where the rest is split off again and goes back on the
     * heap to be allocated. Memory already holds the value there, since a
     * value with a piece in memory is stored where it is defined. If the part
     * from p starts with a use, it needs a register at once, so it goes back
     * on the heap whole. *)
    let splitSpill(sc: Scan it: Interval p: Int): Ok =
        begin
            let child = split(it p)
            made(sc child)
            let u = nextUse(child p)
            if u is firstPos(child) then push(sc.heap child)
            else
                child.reg := ~1
                if u isnot never then
                    let rest = split(child u)
                    made(sc rest)
                    push(sc.heap rest)
                end
            end
        end

    (* Puts cur in memory until its next use after its start, where the rest
     * is split off and goes back on the heap. A use at its start stays in
     * this piece, since splitting there would leave this piece empty; rewrite
     * reads that use from memory. *)
    let spillCurrent(sc: Scan cur: Interval): Ok =
        begin
            cur.reg := ~1
            let u = nextUse(cur firstPos(cur) + 1)
            if u isnot never then
                let rest = split(cur u)
                made(sc rest)
                push(sc.heap rest)
            end
        end

    (* Gives cur a register free for all of it: first one it is hinted to, then
     * the first in the pool, so a caller-saved one before a callee-saved one,
     * which the function would have to save and restore. Failing that, the
     * register free the longest, for the part of cur where it is free, the
     * rest spilled. False if no register is free at cur's start. *)
    let tryFree(sc: Scan cur: Interval): Bool =
        begin
            let c = sc.classes[cur.value]
            let n = extent sc.pools[c]
            (* free[r]: the first position from cur's start at which register r
             * stops being free for cur. An active interval holds its register
             * now; an inactive one, until it is next live where cur is. *)
            let free = blocked(sc cur c)
            for k = 0 upto {vector.length(:Interval sc.active) - 1} do
                let it = vector.get(:Interval sc.active k)
                if sc.classes[it.value] is c then free[it.reg] := 0 end
            end
            for k = 0 upto {vector.length(:Interval sc.inactive) - 1} do
                let it = vector.get(:Interval sc.inactive k)
                if sc.classes[it.value] is c then
                    let x = intersection(it cur)
                    if {x >= 0} andif {x < free[it.reg]} then free[it.reg] := x end
                end
            end
            let s = firstPos(cur)
            let e = lastPos(cur)
            (* A register is free for all of cur if it is free past cur's end.
             * A hint to a virtual register means the register that one was
             * last given, if it has been allocated yet. *)
            let var chosen = ~1
            let hints = sc.hints[cur.value]
            for k = 0 upto {vector.length(:Int hints) - 1} do
                let h = vector.get(:Int hints k)
                let reg = if h >= sc.firstVirtual then sc.given[h - sc.firstVirtual] else h end
                for r = 0 upto {n - 1} do
                    if {chosen < 0} andif {sc.pools[c][r] is reg} andif {free[r] > e} then chosen := r end
                end
            end
            for r = 0 upto {n - 1} do if {chosen < 0} andif {free[r] > e} then chosen := r end end
            if chosen >= 0 then
                cur.reg := chosen
                true
            elsif n is 0 then false
            else
                let var best = 0
                for r = 1 upto {n - 1} do if free[r] > free[best] then best := r end end
                if free[best] <= s then false
                else
                    cur.reg := best
                    splitSpill(sc cur free[best])
                    true
                end
            end
        end

    (* No register free: the one whose holders are next used furthest away is
     * taken from them, unless cur's own next use is further, when cur is
     * spilled instead. A holder that starts where cur does cannot be split
     * there, so its register is not taken. *)
    let allocateBlocked(sc: Scan cur: Interval): Ok =
        begin
            let c = sc.classes[cur.value]
            let n = extent sc.pools[c]
            let s = firstPos(cur)
            let block = blocked(sc cur c)
            (* use[r]: the first use, from cur's start, of an interval holding
             * register r while cur would; ~1 for a register that cannot be
             * taken *)
            let use = array of(n never)
            for k = 0 upto {vector.length(:Interval sc.active) - 1} do
                let it = vector.get(:Interval sc.active k)
                if sc.classes[it.value] is c then
                    if firstPos(it) is s then use[it.reg] := ~1
                    else
                        let u = nextUse(it s)
                        if u < use[it.reg] then use[it.reg] := u end
                    end
                end
            end
            for k = 0 upto {vector.length(:Interval sc.inactive) - 1} do
                let it = vector.get(:Interval sc.inactive k)
                if {sc.classes[it.value] is c} andif {intersection(it cur) >= 0} then
                    let u = nextUse(it s)
                    if u < use[it.reg] then use[it.reg] := u end
                end
            end
            (* Of the registers available at cur's start, the one whose
             * holders' next use is furthest *)
            let var best = ~1
            for r = 0 upto {n - 1} do
                if {block[r] > s} andif {use[r] >= 0} andif {{best < 0} orif {use[r] > use[best]}} then best := r end
            end
            if {best < 0} orif {nextUse(cur s) > use[best]} then spillCurrent(sc cur)
            else
                (* Take it: spill each holder from where it meets cur (an
                 * active one, at cur's start; an inactive one, where it first
                 * overlaps cur), and cur itself from where the register
                 * becomes unavailable, if that is before cur ends *)
                cur.reg := best
                let holders = vector.toArray(:Interval sc.active)
                for k = 0 upto {extent holders - 1} do
                    let it = holders[k]
                    if {sc.classes[it.value] is c} andif {it.reg is best} then splitSpill(sc it s) end
                end
                let sleepers = vector.toArray(:Interval sc.inactive)
                for k = 0 upto {extent sleepers - 1} do
                    let it = sleepers[k]
                    if {sc.classes[it.value] is c} andif {it.reg is best} then
                        let x = intersection(it cur)
                        if x >= 0 then splitSpill(sc it x) end
                    end
                end
                if block[best] <= lastPos(cur) then splitSpill(sc cur block[best]) end
            end
        end

    let allocate(f: Function t: targets.Target rematerializable: All(i: machine.Inst) Bool): Allocation =
        begin
            let nValues = machine.virtuals(f)
            let nBlocks = vector.length(:machine.Block f.blocks)
            let nRegisters = extent t.registers
            let order = machine.order(f)
            let live = machine.live(f)
            let liveIn = live.liveIn
            let liveOut = live.liveOut
            let virtual(r: Int): Bool = machine.isVirtual(f r)
            let classes = array of(nValues 0)
            for v = 0 upto {nValues - 1} do classes[v] := targets.index(machine.virtualClass(f f.firstVirtual + v)) end
            (* The layout: two positions for each block's start and
             * instruction. A block of n instructions starting at bs has its
             * start at bs, its jth instruction at bs + 2(j + 1), and its last
             * position at bs + 2n + 1, where its last instruction writes. A
             * block's parameters are defined at its start. *)
            let blockStart = array of(nBlocks 0 - never)
            let var pos = 0
            for k = 0 upto {extent order - 1} do
                let blk = machine.block(f order[k])
                blockStart[order[k]] := pos
                pos := pos + {2 * {vector.length(:machine.Inst blk.insts) + 1}}
            end
            let positions = pos
            let isStart = bitset.new(positions + 1)
            for k = 0 upto {extent order - 1} do add(isStart blockStart[order[k]]) end
            (* Each class's registers, the caller-saved first *)
            let pools = array of(targets.classes array of :Int end)
            let firstCallee = array of(targets.classes 0)
            for c = 0 upto {targets.classes - 1} do
                pools[c] := concat(t.callerSaved[c] t.calleeSaved[c])
                firstCallee[c] := extent t.callerSaved[c]
            end
            let allocatable = array of(nRegisters false)
            for c = 0 upto {targets.classes - 1} do
                for j = 0 upto {extent pools[c] - 1} do allocatable[pools[c][j]] := true end
            end
            (* Where operands fix registers: from an instruction that writes
             * one to the last that reads it, or from its block's start. A
             * physical register lives only within a block, so the blocks in
             * layout order give each register's ranges in order. For each
             * instruction, its reads come before its writes: a read extends
             * the register's latest range to here if that range began in this
             * block, and otherwise (a function's parameters, read at its
             * entry) starts a range at the block's start. A write starts a
             * range at p + 1, where it happens. *)
            let fixedFroms = array of(nRegisters vector.new(:Int))
            let fixedTos = array of(nRegisters vector.new(:Int))
            for r = 0 upto {nRegisters - 1} do
                fixedFroms[r] := vector.new(:Int)
                fixedTos[r] := vector.new(:Int)
            end
            for k = 0 upto {extent order - 1} do
                let b = order[k]
                let bs = blockStart[b]
                let insts = machine.block(f b).insts
                for j = 0 upto {vector.length(:machine.Inst insts) - 1} do
                    let i = vector.get(:machine.Inst insts j)
                    let p = bs + {2 * {j + 1}}
                    for a = 0 upto {extent i.operands - 1} do
                        let o = i.operands[a]
                        if not(virtual(o.reg)) andif allocatable[o.reg] andif not(o.defines) then
                            let n = vector.length(:Int fixedFroms[o.reg])
                            if {n > 0} andif {vector.get(:Int fixedFroms[o.reg] n - 1) >= bs} then
                                vector.set(:Int fixedTos[o.reg] n - 1 p)
                            else
                                vector.append(:Int fixedFroms[o.reg] bs)
                                vector.append(:Int fixedTos[o.reg] p)
                            end
                        end
                    end
                    for a = 0 upto {extent i.operands - 1} do
                        let o = i.operands[a]
                        if not(virtual(o.reg)) andif allocatable[o.reg] andif o.defines then
                            vector.append(:Int fixedFroms[o.reg] p + 1)
                            vector.append(:Int fixedTos[o.reg] p + 1)
                        end
                    end
                end
            end
            let fixed = array of(targets.classes array of :Interval end)
            for c = 0 upto {targets.classes - 1} do
                fixed[c] := array of(extent pools[c] tuple
                    let value = ~1 let var froms = array of :Int end let var tos = array of :Int end
                    let var uses = array of :Int end let var reg = ~1
                end)
                for j = 0 upto {extent pools[c] - 1} do
                    let r = pools[c][j]
                    (* In order of their starts, as the blocks are *)
                    fixed[c][j] := tuple
                        let value = ~1 let var froms = vector.toArray(:Int fixedFroms[r])
                        let var tos = vector.toArray(:Int fixedTos[r]) let var uses = array of :Int end let var reg = ~1
                    end
                end
            end
            (* The intervals, built backwards (Wimmer and Franz's
             * BuildIntervals): each register's ranges and uses, latest
             * first. Walking the blocks, and each block's instructions, from
             * last to first, a value live out of a block is first taken to be
             * live through all of it; a definition at p + 1 then makes its
             * range start there, and a use at p makes it live from the block's
             * start to p, until a definition earlier in the block cuts that
             * short. *)
            let rangeFroms = array of(nValues vector.new(:Int))
            let rangeTos = array of(nValues vector.new(:Int))
            let usesAt = array of(nValues vector.new(:Int))
            for v = 0 upto {nValues - 1} do
                rangeFroms[v] := vector.new(:Int)
                rangeTos[v] := vector.new(:Int)
                usesAt[v] := vector.new(:Int)
            end
            (* [from, to], at or before the earliest range so far, merged with
             * it when they touch *)
            let addRange(v: Int from: Int to: Int): Ok =
                begin
                    let n = vector.length(:Int rangeFroms[v])
                    if {n > 0} andif {{to + 1} >= vector.get(:Int rangeFroms[v] n - 1)} then
                        if from < vector.get(:Int rangeFroms[v] n - 1) then
                            vector.set(:Int rangeFroms[v] n - 1 from)
                        end
                        if to > vector.get(:Int rangeTos[v] n - 1) then vector.set(:Int rangeTos[v] n - 1 to) end
                    else
                        vector.append(:Int rangeFroms[v] from)
                        vector.append(:Int rangeTos[v] to)
                    end
                end
            (* A definition at p: the earliest range starts there, or, for a
             * value never used, is just p *)
            let setFrom(v: Int p: Int): Ok =
                begin
                    let n = vector.length(:Int rangeFroms[v])
                    if n > 0 then vector.set(:Int rangeFroms[v] n - 1 p)
                    else
                        vector.append(:Int rangeFroms[v] p)
                        vector.append(:Int rangeTos[v] p)
                    end
                end
            (* The same walk finds the calls and the blocks a raise enters, for
             * blocked *)
            let calls = vector.new(:Int)
            let handlers = vector.new(:Int)
            for k = {extent order - 1} downto 0 do
                let b = order[k]
                let blk = machine.block(f b)
                let bs = blockStart[b]
                let n = vector.length(:machine.Inst blk.insts)
                let outs = bitset.elements(liveOut[b])
                for j = 0 upto {extent outs - 1} do addRange(outs[j] bs bs + {{2 * n} + 1}) end
                for j = {n - 1} downto 0 do
                    let i = vector.get(:machine.Inst blk.insts j)
                    let p = bs + {2 * {j + 1}}
                    for a = 0 upto {extent i.operands - 1} do
                        let o = i.operands[a]
                        if virtual(o.reg) andif o.defines then setFrom(machine.index(f o.reg) p + 1) end
                    end
                    for a = 0 upto {extent i.operands - 1} do
                        let o = i.operands[a]
                        if virtual(o.reg) andif not(o.defines) then
                            addRange(machine.index(f o.reg) bs p)
                            vector.append(:Int usesAt[machine.index(f o.reg)] p)
                        end
                    end
                    if machine.isKind(i machine.kindCall) then vector.append(:Int calls p) end
                end
                for p = 0 upto {vector.length(:Int blk.params) - 1} do
                    setFrom(machine.index(f vector.get(:Int blk.params p)) bs)
                end
                if blk.raised then vector.append(:Int handlers bs) end
            end
            let callAt = reversed(calls)
            let handlerAt = vector.toArray(:Int handlers)
            sort.sort(:Int handlerAt sort.intCompare)
            (* The hints: a move's registers, and a jump's arguments and its
             * target's parameters, each other's. A virtual register may be
             * hinted to an allocatable physical one, such as an argument's
             * register, but not the other way, since only virtual registers
             * are allocated. *)
            let hints = array of(nValues vector.new(:Int))
            for v = 0 upto {nValues - 1} do hints[v] := vector.new(:Int) end
            let hint(a: Int b: Int): Ok =
                if virtual(a) andif {virtual(b) orif allocatable[b]} then
                    vector.append(:Int hints[machine.index(f a)] b)
                end
            let remat = array of(nValues false)
            for b = 0 upto {nBlocks - 1} do
                let insts = machine.block(f b).insts
                for j = 0 upto {vector.length(:machine.Inst insts) - 1} do
                    let i = vector.get(:machine.Inst insts j)
                    if machine.isKind(i machine.kindMove) then
                        hint(i.operands[0].reg i.operands[1].reg)
                        hint(i.operands[1].reg i.operands[0].reg)
                    elsif machine.isKind(i machine.kindJump) then
                        let params = machine.block(f i.target).params
                        for a = 0 upto {extent i.operands - 1} do
                            hint(vector.get(:Int params a) i.operands[a].reg)
                            hint(i.operands[a].reg vector.get(:Int params a))
                        end
                    end
                    (* What is rematerialized: the result of an instruction with
                     * one result, computed from no virtual register, that the
                     * target says can be made again (so it gives the same
                     * value anywhere) *)
                    let var results = 0
                    let var reads = 0
                    for a = 0 upto {extent i.operands - 1} do
                        if virtual(i.operands[a].reg) then
                            if i.operands[a].defines then results := results + 1 else reads := reads + 1 end
                        end
                    end
                    if {results is 1} andif {reads is 0} andif rematerializable(i) then
                        for a = 0 upto {extent i.operands - 1} do
                            if virtual(i.operands[a].reg) then remat[machine.index(f i.operands[a].reg)] := true end
                        end
                    end
                end
            end
            let sc = tuple
                let classes = classes let intervals = vector.new(:Interval) let heap = vector.new(:Interval)
                let var active = vector.new(:Interval) let var inactive = vector.new(:Interval)
                let pools = pools let firstCallee = firstCallee let calls = callAt let handlers = handlerAt
                let fixed = fixed let firstVirtual = f.firstVirtual let hints = hints
                let given = array of(nValues ~1)
            end
            (* Every value defined or used has an interval; the lists were
             * built latest first, so each is reversed. Its first and last
             * positions are kept before the scan splits it. *)
            let first = array of(nValues never)
            let last = array of(nValues ~1)
            for v = 0 upto {nValues - 1} do
                if vector.length(:Int rangeFroms[v]) > 0 then
                    let it = tuple
                        let value = v let var froms = reversed(rangeFroms[v]) let var tos = reversed(rangeTos[v])
                        let var uses = reversed(usesAt[v]) let var reg = ~2
                    end
                    first[v] := firstPos(it)
                    last[v] := lastPos(it)
                    made(sc it)
                    push(sc.heap it)
                end
            end
            (* The scan itself. For each interval, from the earliest start:
             * drop the intervals that ended before its start, sort the rest
             * into active and inactive at its start, and allocate it. *)
            while vector.length(:Interval sc.heap) > 0 do
                let cur = pop(sc.heap)
                let s = firstPos(cur)
                let stillActive = vector.new(:Interval)
                let stillInactive = vector.new(:Interval)
                let classify(it: Interval): Ok =
                    if lastPos(it) >= s then
                        if covers(it s) then vector.append(:Interval stillActive it)
                        else vector.append(:Interval stillInactive it) end
                    end
                for k = 0 upto {vector.length(:Interval sc.active) - 1} do
                    classify(vector.get(:Interval sc.active k))
                end
                for k = 0 upto {vector.length(:Interval sc.inactive) - 1} do
                    classify(vector.get(:Interval sc.inactive k))
                end
                sc.active := stillActive
                sc.inactive := stillInactive
                if not(tryFree(sc cur)) then allocateBlocked(sc cur) end
                if cur.reg >= 0 then
                    vector.append(:Interval sc.active cur)
                    sc.given[cur.value] := pools[classes[cur.value]][cur.reg]
                end
            end
            (* Each register's pieces, in order *)
            let pieces = array of(nValues vector.new(:Interval))
            for v = 0 upto {nValues - 1} do pieces[v] := vector.new(:Interval) end
            for k = 0 upto {vector.length(:Interval sc.intervals) - 1} do
                let it = vector.get(:Interval sc.intervals k)
                vector.append(:Interval pieces[it.value] it)
            end
            let starts = array of(nValues array of(0 0))
            let homes = array of(nValues array of :Int end)
            let spilled = array of(nValues false)
            let moves = vector.new(:Move)
            for v = 0 upto {nValues - 1} do
                let ps = vector.toArray(:Interval pieces[v])
                sort.sort(:Interval ps fun(a: Interval b: Interval): Int sort.intCompare(firstPos(a) firstPos(b)))
                let c = classes[v]
                starts[v] := array of(extent ps 0)
                homes[v] := array of(extent ps memory)
                for k = 0 upto {extent ps - 1} do
                    starts[v][k] := firstPos(ps[k])
                    if ps[k].reg >= 0 then homes[v][k] := pools[c][ps[k].reg] else spilled[v] := true end
                    (* A piece in a register inside a block is moved to. Such
                     * a piece starts where its previous piece ends, at a use,
                     * so the value is in that piece's register or memory just
                     * before. A piece starting at a block's start is left to
                     * the block's edges. *)
                    let inside = {k > 0} andif {ps[k].reg >= 0} andif not(bitset.contains(isStart starts[v][k]))
                    if inside andif {homes[v][k] isnot homes[v][k - 1]} then
                        vector.append(:Move moves tuple
                            let at = starts[v][k] let value = v let from = homes[v][k - 1] let to = homes[v][k]
                        end)
                    end
                end
                (* A value never read is never stored, though its piece is in
                 * memory: nothing would read the slot, and since it dies at no
                 * read, nothing would clear it either (a loop's parameter
                 * that only its header defines, say, which the back edge
                 * would store each time round) *)
                if vector.empty(:Int usesAt[v]) then spilled[v] := false end
            end
            let moved = vector.toArray(:Move moves)
            sort.sort(:Move moved fun(a: Move b: Move): Int
                if a.at isnot b.at then sort.intCompare(a.at b.at) else sort.intCompare(a.value b.value) end)
            (* The callee-saved registers in use, in the order of the pool *)
            let given = array of(nRegisters false)
            for v = 0 upto {nValues - 1} do
                for k = 0 upto {extent homes[v] - 1} do
                    if homes[v][k] isnot memory then given[homes[v][k]] := true end
                end
            end
            let used = vector.new(:Int)
            for c = 0 upto {targets.classes - 1} do
                for r = firstCallee[c] upto {extent pools[c] - 1} do
                    if given[pools[c][r]] then vector.append(:Int used pools[c][r]) end
                end
            end
            let ins = array of(nBlocks array of(0 0))
            for b = 0 upto {nBlocks - 1} do ins[b] := bitset.elements(liveIn[b]) end
            tuple
                let starts = starts let homes = homes let spilled = spilled let remat = remat let moves = moved
                let blockStart = blockStart let liveIn = ins let calleeUsed = vector.toArray(:Int used)
                let first = first let last = last
            end
        end

    (* =========================================================================
     * Rewriting the function in the registers allocated
     *
     * Each block's instructions are rebuilt in order: before each
     * instruction, the moves to pieces that start there; then the
     * instruction, its virtual registers replaced by where they are, with
     * loads before it and stores after it as needed; and on each edge, the
     * moves that put every value where the target block expects it.
     * ====================================================================== *)

    (* A place a move reads or writes: a register; or else (reg memory) a
     * virtual register's memory (by its index), its slot, or for one
     * rematerialized (only read), its instruction again *)
    Let Place = Tuple reg: Int value: Int end
    Let Transfer = Tuple dst: Place src: Place end

    let inRegister(r: Int): Place = tuple let reg = r let value = ~1 end
    let inMemory(v: Int): Place = tuple let reg = memory let value = v end
    let transfer(dst: Place src: Place): Transfer = tuple let dst = dst let src = src end
    let samePlace(a: Place b: Place): Bool =
        if a.reg isnot memory then a.reg is b.reg
        else {b.reg is memory} andif {a.value is b.value} end

    Let Rewriter = Tuple
        f: Function
        a: Allocation
        lowering: machine.Lowering
        (* Each virtual register's defining instruction, for those
         * rematerialized *)
        defs: Array(machine.Inst)
        (* The block's instructions so far *)
        code: vector.T(machine.Inst)
    end

    let emit(w: Rewriter i: machine.Inst): Ok = vector.append(:machine.Inst w.code i)
    let emitAll(w: Rewriter insts: Array(machine.Inst)): Ok = for k = 0 upto {extent insts - 1} do emit(w insts[k]) end

    (* A virtual register's memory into a register: loaded from its slot, or
     * its instruction made again, writing reg instead *)
    let reload(w: Rewriter reg: Int v: Int): Ok =
        if w.a.remat[v] then
            let i = w.defs[v]
            let operands = array of(extent i.operands machine.reads(0))
            for k = 0 upto {extent operands - 1} do
                operands[k] := if i.operands[k].defines then machine.writes(reg) else i.operands[k] end
            end
            emit(w machine.inst(i.kind operands i.op i.target))
        else emitAll(w w.lowering.load(reg w.f.firstVirtual + v)) end

    (* A place's word into a register *)
    let readInto(w: Rewriter reg: Int src: Place): Ok =
        if src.reg is memory then reload(w reg src.value)
        elsif src.reg isnot reg then emit(w w.lowering.move(reg src.reg)) end

    (* One move, memory to memory through the first integer scratch
     * register *)
    let place(w: Rewriter dst: Place src: Place): Ok =
        if dst.reg isnot memory then readInto(w dst.reg src)
        else
            let scratch = w.lowering.scratch[0][0]
            let r = if src.reg isnot memory then src.reg else begin readInto(w scratch src) scratch end end
            emitAll(w w.lowering.store(r w.f.firstVirtual + dst.value))
        end

    (* Moves made as if all at once (a parallel move): a jump's arguments may
     * be its target's parameters' registers in another order, say. It makes,
     * in turn, a move whose destination no other move still to be made reads,
     * so nothing is overwritten before it is read. When none is left, the
     * moves left form cycles (a swap is the smallest), and each place in them
     * is read by exactly one move. Then one move's source is copied to the
     * second integer scratch register (which the target's move can do for
     * either class), the move reads that instead, and its cycle unwinds. The
     * scratch register holds one value at a time: the move that reads it is
     * the last of its cycle to become free, and until then another move of
     * the cycle always is. *)
    let parallel(w: Rewriter transfers: vector.T(Transfer)): Ok =
        begin
            let pending = vector.new(:Transfer)
            for k = 0 upto {vector.length(:Transfer transfers) - 1} do
                let t = vector.get(:Transfer transfers k)
                if not(samePlace(t.dst t.src)) then vector.append(:Transfer pending t) end
            end
            while vector.length(:Transfer pending) > 0 do
                let n = vector.length(:Transfer pending)
                let var chosen = ~1
                for k = 0 upto {n - 1} do
                    if chosen < 0 then
                        let t = vector.get(:Transfer pending k)
                        let var read = false
                        for j = 0 upto {n - 1} do
                            if {j isnot k} andif samePlace(vector.get(:Transfer pending j).src t.dst) then
                                read := true
                            end
                        end
                        if not(read) then chosen := k end
                    end
                end
                if chosen < 0 then
                    let t = vector.get(:Transfer pending 0)
                    let breaker = w.lowering.scratch[0][1]
                    readInto(w breaker t.src)
                    vector.set(:Transfer pending 0 transfer(t.dst inRegister(breaker)))
                else
                    let t = vector.get(:Transfer pending chosen)
                    place(w t.dst t.src)
                    vector.delete(:Transfer pending chosen)
                end
            end
        end

    (* Where a register is at a position: a physical one is in itself *)
    let at(w: Rewriter r: Int p: Int): Place =
        if not(machine.isVirtual(w.f r)) then inRegister(r)
        else
            let v = machine.index(w.f r)
            let h = home(w.a v p)
            if h isnot memory then inRegister(h) else inMemory(v) end
        end

    (* An edge's moves, from a jump or a branch at p: each of its target's
     * parameters, to its register and its slot, from its argument, and each
     * register live into the target from where it is at p to its register at
     * the target's start (in memory there, it is already). A parameter is
     * defined on the edge, so the edge also does the store that a value
     * defined by an instruction gets after it. *)
    let edge(w: Rewriter p: Int target: Int args: Array(Int)): Ok =
        begin
            let bs = w.a.blockStart[target]
            let transfers = vector.new(:Transfer)
            let params = machine.block(w.f target).params
            for k = 0 upto {extent args - 1} do
                let param = machine.index(w.f vector.get(:Int params k))
                let h = home(w.a param bs)
                if h isnot memory then vector.append(:Transfer transfers transfer(inRegister(h) at(w args[k] p))) end
                if needsSlot(w.a param) then
                    vector.append(:Transfer transfers transfer(inMemory(param) at(w args[k] p)))
                end
            end
            let ins = w.a.liveIn[target]
            for k = 0 upto {extent ins - 1} do
                let h = home(w.a ins[k] bs)
                if h isnot memory then
                    vector.append(:Transfer transfers transfer(inRegister(h) at(w w.f.firstVirtual + ins[k] p)))
                end
            end
            parallel(w transfers)
        end

    (* An instruction in the registers allocated: an operand in memory loaded
     * into a scratch register first, a result in memory written to one, and a
     * result stored if it has a slot; or, for a result rematerialized whose
     * first piece is in memory, none *)
    let ordinary(w: Rewriter i: machine.Inst p: Int): Ok =
        begin
            let f = w.f
            (* How many of each class's scratch registers the operands have
             * taken, so that each operand in memory gets its own *)
            let used = array of(targets.classes 0)
            let operands = array of(extent i.operands machine.reads(0))
            let stores = vector.new(:Int)
            let stored = vector.new(:Int)
            let var skip = false
            (* Operands are where their values are at p *)
            for k = 0 upto {extent operands - 1} do
                let o = i.operands[k]
                operands[k] := o
                if machine.isVirtual(f o.reg) andif not(o.defines) then
                    let v = machine.index(f o.reg)
                    let h = home(w.a v p)
                    if h isnot memory then operands[k] := machine.reads(h)
                    else
                        let c = targets.index(machine.virtualClass(f o.reg))
                        let scratch = w.lowering.scratch[c][used[c]]
                        used[c] := used[c] + 1
                        reload(w scratch v)
                        operands[k] := machine.reads(scratch)
                    end
                end
            end
            (* Results, where their first pieces are, at p + 1. A result in
             * memory is written to the first scratch register of its class,
             * which an operand may also have been loaded into: the
             * instruction reads its operands before it writes its results. *)
            for k = 0 upto {extent operands - 1} do
                let o = i.operands[k]
                if machine.isVirtual(f o.reg) andif o.defines then
                    let v = machine.index(f o.reg)
                    let h = home(w.a v p + 1)
                    if {h is memory} andif w.a.remat[v] then skip := true end
                    let c = targets.index(machine.virtualClass(f o.reg))
                    let r = if h isnot memory then h else w.lowering.scratch[c][0] end
                    operands[k] := machine.writes(r)
                    if needsSlot(w.a v) then
                        vector.append(:Int stores r)
                        vector.append(:Int stored v)
                    end
                end
            end
            if not(skip) then
                emit(w machine.inst(i.kind operands i.op i.target))
                for k = 0 upto {vector.length(:Int stores) - 1} do
                    emitAll(w w.lowering.store(vector.get(:Int stores k) f.firstVirtual + vector.get(:Int stored k)))
                end
            end
        end

    (* A move: its source into its destination's register, or stored to its
     * slot *)
    let move(w: Rewriter i: machine.Inst p: Int): Ok =
        begin
            let f = w.f
            let dst = i.operands[0].reg
            let src = at(w i.operands[1].reg p)
            if not(machine.isVirtual(f dst)) then readInto(w dst src)
            else
                let v = machine.index(f dst)
                let h = home(w.a v p + 1)
                if h isnot memory then
                    readInto(w h src)
                    if needsSlot(w.a v) then emitAll(w w.lowering.store(h dst)) end
                elsif needsSlot(w.a v) then place(w inMemory(v) src) end
            end
        end

    (* Where the slots of dead values are cleared (docs/arm64-performance-
     * review.md section 3.2). A conservative collector scans every word of
     * every frame, so a slot still holding a dead value's pointer keeps what
     * it points to alive; the value is cleared where it dies instead: after
     * the instruction that last reads it, or at the start of a branch's target
     * it is not live into though it is live at the branch. Only a value the
     * lowering clears (one that may be a pointer) that has a slot is, and only
     * where a call, in which a collection can happen, may follow before the
     * function returns. after holds, for each block's instructions, the values
     * (by index) cleared after each; atStart, those cleared at each block's
     * start. *)
    Let Clears = Tuple after: Array(Array(Array(Int))) atStart: Array(Array(Int)) end

    let clears(f: Function a: Allocation lowering: machine.Lowering): Clears =
        begin
            let nBlocks = vector.length(:machine.Block f.blocks)
            let nValues = machine.virtuals(f)
            let after = array of(nBlocks array of :Array(Int) end)
            let atStart = array of(nBlocks array of :Int end)
            let liveIn = array of(nBlocks bitset.new(nValues))
            for b = 0 upto {nBlocks - 1} do
                liveIn[b] := bitset.new(nValues)
                for k = 0 upto {extent a.liveIn[b] - 1} do add(liveIn[b] a.liveIn[b][k]) end
            end
            let clearable = array of(nValues false)
            for v = 0 upto {nValues - 1} do
                clearable[v] := needsSlot(a v) andif lowering.clears(f.firstVirtual + v)
            end
            (* Whether a call may come after a block's jth instruction, before
             * the function returns: in the block, or in a block it may go to
             * from there (the jth's own target among them, as for the jump that
             * ends the block), to a fixed point *)
            let callIn = array of(nBlocks false)
            let callsAfter(b: Int j: Int): Bool =
                begin
                    let insts = machine.block(f b).insts
                    let var found = false
                    if j >= 0 then
                        let i = vector.get(:machine.Inst insts j)
                        if {i.target >= 0} andif callIn[i.target] then found := true end
                    end
                    for k = {j + 1} upto {vector.length(:machine.Inst insts) - 1} do
                        let i = vector.get(:machine.Inst insts k)
                        if machine.isKind(i machine.kindCall) orif {{i.target >= 0} andif callIn[i.target]} then
                            found := true
                        end
                    end
                    found
                end
            let var changed = true
            while changed do
                changed := false
                for b = 0 upto {nBlocks - 1} do
                    if not(callIn[b]) andif {a.blockStart[b] >= 0} andif callsAfter(b ~1) then
                        callIn[b] := true
                        changed := true
                    end
                end
            end
            (* Each block backward, from what is live at its end (what its
             * jump's target has live in, or nothing at a return): a value an
             * instruction reads, or a branch's target has live in, that is not
             * live after the instruction dies there *)
            for b = 0 upto {nBlocks - 1} do
                let insts = machine.block(f b).insts
                let n = vector.length(:machine.Inst insts)
                after[b] := array of(n array of :Int end)
                if a.blockStart[b] >= 0 then
                    let live = bitset.new(nValues)
                    for j = {n - 1} downto 0 do
                        let i = vector.get(:machine.Inst insts j)
                        let dies = vector.new(:Int)
                        let reads = bitset.new(nValues)
                        (* A jump's target's parameters are not live into it, but
                         * one passed as an argument (a loop's invariant, back
                         * to its header) does not die there: the edge stores
                         * it again *)
                        let redefined = bitset.new(nValues)
                        if machine.isKind(i machine.kindJump) then
                            bitset.assign(live liveIn[i.target])
                            let params = machine.block(f i.target).params
                            for k = 0 upto {vector.length(:Int params) - 1} do
                                add(redefined machine.index(f vector.get(:Int params k)))
                            end
                        end
                        if machine.isKind(i machine.kindBranch) then
                            (* What is live after the branch but not in its
                             * target dies at the target's start *)
                            if callIn[i.target] then
                                let gone = vector.new(:Int)
                                let es = bitset.elements(live)
                                for k = 0 upto {extent es - 1} do
                                    if clearable[es[k]] andif not(bitset.contains(liveIn[i.target] es[k])) then
                                        vector.append(:Int gone es[k])
                                    end
                                end
                                atStart[i.target] := vector.toArray(:Int gone)
                            end
                            bitset.unionWith(reads liveIn[i.target])
                        end
                        for k = 0 upto {extent i.operands - 1} do
                            let o = i.operands[k]
                            if machine.isVirtual(f o.reg) then
                                let v = machine.index(f o.reg)
                                if o.defines then begin let ignored = bitset.remove(live v) end
                                else add(reads v) end
                            end
                        end
                        let rs = bitset.elements(reads)
                        for k = 0 upto {extent rs - 1} do
                            let dead = not(bitset.contains(live rs[k])) andif not(bitset.contains(redefined rs[k]))
                            if clearable[rs[k]] andif dead then vector.append(:Int dies rs[k]) end
                        end
                        if not(machine.isKind(i machine.kindReturn)) andif callsAfter(b j) then
                            after[b][j] := vector.toArray(:Int dies)
                        end
                        bitset.unionWith(live reads)
                    end
                end
            end
            tuple let after = after let atStart = atStart end
        end

    (* Slots are shared as registers are, by intervals that do not intersect,
     * but over each value's whole lifetime, from its first position to its
     * last, holes and all: a value in memory is stored once, where it is
     * defined, and its slot must hold it until its last read. rewrite writes
     * a slot at two places outside that: a parameter's, on each jump into its
     * block (at the jump, where the jump's arguments are read, which may
     * share it otherwise); and a clear, after the instruction where its value
     * dies (where the instruction's results are stored), or at the start of a
     * branch's target (where what is live into the target is held). Each
     * lifetime is stretched to cover those. Then, in order of their first
     * positions, each value takes the first slot of its kind whose values
     * have all ended before it starts, or a new one. *)
    let shareSlots(f: Function a: Allocation lowering: machine.Lowering kind: All(v: Int) Int): Array(Int) =
        begin
            let nBlocks = vector.length(:machine.Block f.blocks)
            let nValues = machine.virtuals(f)
            let first = array of(nValues 0)
            let last = array of(nValues 0)
            for v = 0 upto {nValues - 1} do
                first[v] := a.first[v]
                last[v] := a.last[v]
            end
            let reach(v: Int p: Int): Ok =
                begin
                    if p < first[v] then first[v] := p end
                    if p > last[v] then last[v] := p end
                end
            let cleared = clears(f a lowering)
            for b = 0 upto {nBlocks - 1} do
                let bs = a.blockStart[b]
                if bs >= 0 then
                    for k = 0 upto {extent cleared.atStart[b] - 1} do reach(cleared.atStart[b][k] bs) end
                    let insts = machine.block(f b).insts
                    for j = 0 upto {vector.length(:machine.Inst insts) - 1} do
                        let i = vector.get(:machine.Inst insts j)
                        let p = bs + {2 * {j + 1}}
                        for k = 0 upto {extent cleared.after[b][j] - 1} do reach(cleared.after[b][j][k] p + 1) end
                        if machine.isKind(i machine.kindJump) then
                            let params = machine.block(f i.target).params
                            for k = 0 upto {vector.length(:Int params) - 1} do
                                reach(machine.index(f vector.get(:Int params k)) p)
                            end
                        end
                    end
                end
            end
            let stored = vector.new(:Int)
            for v = 0 upto {nValues - 1} do if needsSlot(a v) then vector.append(:Int stored v) end end
            let byFirst = vector.toArray(:Int stored)
            sort.sort(:Int byFirst fun(x: Int y: Int): Int
                if first[x] isnot first[y] then sort.intCompare(first[x] first[y]) else sort.intCompare(x y) end)
            let slot = array of(nValues ~1)
            let kinds = vector.new(:Int)
            let ends = vector.new(:Int)
            for k = 0 upto {extent byFirst - 1} do
                let v = byFirst[k]
                let c = kind(f.firstVirtual + v)
                let var chosen = ~1
                for s = 0 upto {vector.length(:Int kinds) - 1} do
                    let free = {vector.get(:Int kinds s) is c} andif {vector.get(:Int ends s) < first[v]}
                    if {chosen < 0} andif free then chosen := s end
                end
                if chosen < 0 then
                    chosen := vector.length(:Int kinds)
                    vector.append(:Int kinds c)
                    vector.append(:Int ends 0)
                end
                vector.set(:Int ends chosen last[v])
                slot[v] := chosen
            end
            slot
        end

    let rewrite(f: Function a: Allocation lowering: machine.Lowering): Ok =
        begin
            let nBlocks = vector.length(:machine.Block f.blocks)
            let cleared = clears(f a lowering)
            let clearAll(w: Rewriter vs: Array(Int)): Ok =
                for k = 0 upto {extent vs - 1} do emitAll(w lowering.clear(f.firstVirtual + vs[k])) end
            let nothing = machine.inst(machine.kindOrdinary array of :machine.Operand end ~1 ~1)
            let defs = array of(machine.virtuals(f) nothing)
            (* Where each branch target's one branch is. A branch's edge has no
             * code of its own to put moves in, so they go at the start of its
             * target, which no other edge enters; nothing runs between the
             * branch and there, so every value is where it was at the
             * branch. *)
            let branchAt = array of(nBlocks ~1)
            for b = 0 upto {nBlocks - 1} do
                let insts = machine.block(f b).insts
                for j = 0 upto {vector.length(:machine.Inst insts) - 1} do
                    let i = vector.get(:machine.Inst insts j)
                    for k = 0 upto {extent i.operands - 1} do
                        let o = i.operands[k]
                        if machine.isVirtual(f o.reg) andif o.defines then defs[machine.index(f o.reg)] := i end
                    end
                    if machine.isKind(i machine.kindBranch) then
                        branchAt[i.target] := a.blockStart[b] + {2 * {j + 1}}
                    end
                end
            end
            let moveAts = array of(extent a.moves 0)
            for k = 0 upto {extent moveAts - 1} do moveAts[k] := a.moves[k].at end
            for b = 0 upto {nBlocks - 1} do
                let blk = machine.block(f b)
                let bs = a.blockStart[b]
                let w = tuple
                    let f = f let a = a let lowering = lowering let defs = defs let code = vector.new(:machine.Inst)
                end
                (* A block not reached is left empty *)
                if bs >= 0 then
                    if branchAt[b] >= 0 then edge(w branchAt[b] b array of :Int end) end
                    clearAll(w cleared.atStart[b])
                    for j = 0 upto {vector.length(:machine.Inst blk.insts) - 1} do
                        let i = vector.get(:machine.Inst blk.insts j)
                        let p = bs + {2 * {j + 1}}
                        (* Values whose next piece starts at this instruction,
                         * in a register, are moved there from memory or from
                         * their previous register first. The moves are made as
                         * one parallel move, not one after another, because a
                         * value's new register may still hold another value
                         * that moves here too (two values that swap registers,
                         * say) *)
                        let transfers = vector.new(:Transfer)
                        let var next = sort.bisectLeft(:Int moveAts p sort.intCompare)
                        while {next < extent a.moves} andif {a.moves[next].at is p} do
                            let m = a.moves[next]
                            let src = if m.from is memory then inMemory(m.value) else inRegister(m.from) end
                            vector.append(:Transfer transfers transfer(inRegister(m.to) src))
                            next := next + 1
                        end
                        if vector.length(:Transfer transfers) > 0 then parallel(w transfers) end
                        (* A jump's arguments become its edge's moves, so it
                         * keeps no operands *)
                        case i.kind
                            when kindJump then
                                let args = array of(extent i.operands 0)
                                for k = 0 upto {extent args - 1} do args[k] := i.operands[k].reg end
                                edge(w p i.target args)
                                clearAll(w cleared.after[b][j])
                                emit(w machine.inst(i.kind array of :machine.Operand end i.op i.target))
                            when kindMove then
                                move(w i p)
                                clearAll(w cleared.after[b][j])
                            when kindOrdinary, kindBranch, kindCall, kindReturn then
                                ordinary(w i p)
                                clearAll(w cleared.after[b][j])
                        end
                    end
                end
                vector.clear(:machine.Inst blk.insts)
                for j = 0 upto {vector.length(:machine.Inst w.code) - 1} do
                    vector.append(:machine.Inst blk.insts vector.get(:machine.Inst w.code j))
                end
            end
        end
end
