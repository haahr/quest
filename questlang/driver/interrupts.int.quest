(* Quest Self-Hosted Compiler: The Kernel's Interrupts Interface
 *
 * Handles SIGINT interrupts in Jupyter kernel mode (--kernel; see
 * docs/jupyter-kernel.md section 5). A signal handler installed by the driver
 * sets the runtime flag quest_interrupt_pending, which JIT-compiled code checks
 * (ssa/passes/interrupts) and the interpreter polls. The runtime symbols are
 * looked up dynamically by name (os/code's symbol) so that a driver linked
 * against an older runtime without them still runs, just without interrupts. *)

interface Interrupts export
    (* Installs the SIGINT handler; returns whether the runtime supports it *)
    install(): Bool
    (* Returns whether an interrupt is pending, clearing the flag if so *)
    take(): Bool
    (* Clears any pending interrupt, such as one that arrived between cells *)
    clear(): Ok
end
