(* Quest Self-Hosted Compiler: The Jupyter Kernel's Protocol Implementation *)

module kernel : Kernel
import
    reader : Reader
    stringOp = string : StringOp
    system : System
    writer : Writer

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/json : util/JSON
    util/maybe : util/Maybe
    util/sort : util/Sort
    sb = util/stringBuilder : util/StringBuilder
    util/strutil : util/Strutil

    questlang/codegen/native : questlang/codegen/Native
    questlang/common/diagbag : questlang/common/DiagBag
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/location : questlang/common/Location
    questlang/common/strings : questlang/common/Strings
    questlang/driver/interrupts : questlang/driver/Interrupts
    questlang/driver/repl : questlang/driver/REPL
    questlang/interpreter/treewalk : questlang/interpreter/Treewalk
    questlang/syntax/tokenizer : questlang/syntax/Tokenizer
    questlang/types/echo : questlang/types/Echo
    questlang/types/env : questlang/types/Env
    questlang/types/symbols : questlang/types/Symbols
export
    (* A line of r, without its newline, if r has one before its end *)
    let readRequest(r: reader.T): maybe.T(String) =
        if not(reader.more(r)) then
            maybe.none()
        else
            let b = sb.new()
            let var reading = true
            while reading andif reader.more(r) do
                let c = reader.getChar(r)
                if c is '\n' then reading := false else sb.char(b c) ok end
            end
            maybe.some(sb.toString(b))
        end

    (* Writes a record whose members are names[i]: values[i], after flushing
     * what the program wrote, so that its output precedes the record *)
    let writeRecord(w: writer.T names: Array(String) values: Array(json.Value)): Ok =
        begin
            writer.flush(writer.output)
            writer.flush(writer.err)
            let o = json.newObject()
            for i = 0 upto {extent names - 1} do json.put(o names[i] values[i]) end
            writer.putString(w json.dump(json.object(o)) <> "\n")
            writer.flush(w)
        end

    (* Writes the error record for a failed cell from the diagnostics in bag,
     * including the line and column of the first diagnostic in the cell if it
     * has one *)
    let failed(r: repl.T w: writer.T sm: location.SourceMap bag: diagbag.T): Ok =
        begin
            let shown = maybe.unwrapOr(r.errorSource sm)
            let b = sb.new()
            let var message = ""
            let var position = maybe.none(:location.Pos)
            for i = 0 upto {diagbag.count(bag) - 1} do
                let d = diagbag.get(bag i)
                sb.strShared(b diagnostics.format(d shown))
                if stringOp.isEmpty(message) then
                    message := diagnostics.message(d)
                    let sp = diagnostics.span(d)
                    if stringOp.equal(sp.file repl.inputName) andif {sp.startOffset >= 0} then
                        position := maybe.some(location.locate(sm sp.startOffset))
                    end
                end
            end
            let names = vector.new(:String)
            let values = vector.new(:json.Value)
            vector.append(names "error") vector.append(values json.string(r.failure))
            vector.append(names "message") vector.append(values json.string(message))
            vector.append(names "rendered") vector.append(values json.string(sb.toString(b)))
            if maybe.isSome(position) then
                let p = maybe.unwrap(position)
                vector.append(names "line") vector.append(values json.int(p.line))
                vector.append(names "column") vector.append(values json.int(p.col))
            end
            writeRecord(w vector.toArray(names) vector.toArray(values))
        end

    (* Runs a cell as one input, writing its records *)
    let execute(r: repl.T w: writer.T text: String): Ok =
        begin
            let var status = "ok"
            if stringOp.length(strutil.strip(text)) > 0 then
                let sm = location.newSourceMap(repl.inputName text)
                let bag = diagbag.new()
                r.failure := ""
                let results = repl.evaluate(r text sm bag)
                if maybe.isSome(results) then
                    (* A cell that succeeded may still have warnings; render
                     * them to standard error just as the REPL does *)
                    diagbag.report(bag sm)
                    let shown = maybe.unwrap(results)
                    for i = 0 upto {extent shown - 1} do
                        if stringOp.length(shown[i]) > 0 then
                            writeRecord(w array of "result" end array of json.string(shown[i]) end)
                        end
                    end
                else
                    failed(r w sm bag)
                    status := "error"
                end
            end
            writeRecord(w array of "done" end array of json.string(status) end)
        end

    (* ----------------------------------------------------------------------
     * Completion and inspection: resolves names at a cursor (a byte offset
     * into a cell) against the session's environment
     * ---------------------------------------------------------------------- *)

    let isNameChar = strings.isNameChar
    let nameStart = strings.nameStart

    (* Looks up the module named before a '.' at start, if any. Checks modules
     * already imported or declared in the session first, then loads a matching
     * standard library module on demand. *)
    let qualifier(r: repl.T code: String start: Int): maybe.T(Tuple name: String scope: symbols.Scope end) =
        if {start > 0} andif {stringOp.getChar(code {start - 1}) is '.'} then
            let q = nameStart(code {start - 1})
            let name = stringOp.getSub(code q {{start - 1} - q})
            let known = env.lookupModule(r.e name)
            let scope =
                if maybe.isSome(known) orif maybe.isNone(r.e.registry) then
                    known
                else
                    try maybe.unwrap(r.e.registry).ensureModule(name r.e)
                    when diagnostics.compilerError then maybe.none(:symbols.Scope)
                    end
                end
            if maybe.isSome(scope) then
                maybe.some(tuple let name = name let scope = maybe.unwrap(scope) end)
            else
                maybe.none()
            end
        else
            maybe.none()
        end

    let appendAll(names: vector.T(String) more: vector.T(String)): Ok =
        for i = 0 upto {vector.length(more) - 1} do vector.append(names vector.get(more i)) end

    (* Appends all value and type names declared in scope to names *)
    let addNames(names: vector.T(String) scope: symbols.Scope): Ok =
        begin
            appendAll(names hashMap.keys(scope.values))
            appendAll(names hashMap.keys(scope.types))
        end

    (* Returns the start offset of the identifier before cursor and all
     * matching completion names, sorted and deduplicated *)
    let completions(r: repl.T code: String cursor: Int): Tuple start: Int matches: Array(String) end =
        begin
            let start = nameStart(code cursor)
            let prefix = stringOp.getSub(code start {cursor - start})
            let names = vector.new(:String)
            let q = qualifier(r code start)
            if maybe.isSome(q) then
                addNames(names maybe.unwrap(q).scope)
            elsif {start is 0} orif {stringOp.getChar(code {start - 1}) isnot '.'} then
                let var scope = maybe.some(r.e.currentScope)
                while maybe.isSome(scope) do
                    addNames(names maybe.unwrap(scope))
                    scope := maybe.unwrap(scope).parent
                end
                appendAll(names hashMap.keys(r.e.modules))
                appendAll(names hashMap.keys(r.e.interfaces))
                appendAll(names vector.fromArray(tokenizer.keywordNames()))
            end
            let all = vector.toArray(names)
            sort.sort(all sort.stringCompare)
            (* Names a person could type, once each *)
            let matches = vector.new(:String)
            for i = 0 upto {extent all - 1} do
                let n = all[i]
                let typable = {stringOp.length(n) > 0}
                    andif {strutil.isAlpha(stringOp.getChar(n 0)) orif {stringOp.getChar(n 0) is '_'}}
                let repeated = {i > 0} andif stringOp.equal(all[i - 1] n)
                if typable andif not(repeated) andif strutil.startsWith(n prefix) then
                    vector.append(matches n)
                end
            end
            tuple let start = start let matches = vector.toArray(matches) end
        end

    let showValue = echo.valueDeclaration
    let showType = echo.typeDeclaration

    (* What a module declares, a line a member, in the order declared *)
    let showModule(name: String scope: symbols.Scope): String =
        begin
            let b = sb.new()
            sb.str(b "module ")
            sb.str(b name)
            for i = 0 upto {vector.length(scope.declarations) - 1} do
                case vector.get(scope.declarations i)
                    when valueSymbol with x then sb.str(b "\n    ") sb.strShared(b showValue(x.sym.name x.sym))
                    when typeSymbol with x then sb.str(b "\n    ") sb.strShared(b showType(x.sym.name x.sym))
                    else ok
                end
            end
            sb.toString(b)
        end

    (* What the name at cursor is, as the REPL shows a binding of it *)
    let inspection(r: repl.T code: String cursor: Int): maybe.T(String) =
        begin
            let var finish = cursor
            while {finish < stringOp.length(code)} andif isNameChar(stringOp.getChar(code finish)) do
                finish := finish + 1
            end
            let start = nameStart(code cursor)
            let name = stringOp.getSub(code start {finish - start})
            let q = qualifier(r code start)
            if stringOp.isEmpty(name) then
                maybe.none()
            elsif maybe.isSome(q) then
                let m = maybe.unwrap(q)
                let shown = m.name <> "." <> name
                let v = symbols.lookupValueLocal(m.scope name)
                let t = symbols.lookupTypeLocal(m.scope name)
                if maybe.isSome(v) then
                    maybe.some(showValue(shown maybe.unwrap(v)))
                elsif maybe.isSome(t) then
                    maybe.some(showType(shown maybe.unwrap(t)))
                else
                    maybe.none()
                end
            else
                let v = symbols.lookupValue(r.e.currentScope name)
                let t = symbols.lookupType(r.e.currentScope name)
                let m = env.lookupModule(r.e name)
                (* A module is a value too, of a type that shows only its
                 * name, so it is shown by its members *)
                if maybe.isSome(m) then
                    maybe.some(showModule(name maybe.unwrap(m)))
                elsif maybe.isSome(v) then
                    maybe.some(showValue(name maybe.unwrap(v)))
                elsif maybe.isSome(t) then
                    maybe.some(showType(name maybe.unwrap(t)))
                else
                    maybe.none()
                end
            end
        end

    (* A cursor clamped to the cell *)
    let clamp(code: String cursor: Int): Int =
        if cursor < 0 then 0 elsif cursor > stringOp.length(code) then stringOp.length(code) else cursor end

    let complete(r: repl.T w: writer.T code: String cursor: Int): Ok =
        begin
            let found = completions(r code clamp(code cursor))
            let matches = vector.new(:json.Value)
            for i = 0 upto {extent found.matches - 1} do
                vector.append(matches json.string(found.matches[i]))
            end
            writeRecord(w array of "matches" "start" "end" end
                    array of json.arrayValue(matches) json.int(found.start) json.int(clamp(code cursor)) end)
        end

    let inspectName(r: repl.T w: writer.T code: String cursor: Int): Ok =
        begin
            let shown = inspection(r code clamp(code cursor))
            if maybe.isSome(shown) then
                writeRecord(w array of "found" "text" end
                        array of json.bool(true) json.string(maybe.unwrap(shown)) end)
            else
                writeRecord(w array of "found" end array of json.bool(false) end)
            end
        end

    (* The string member name of o, if it has one *)
    let member(o: json.Object name: String): maybe.T(String) =
        begin
            let v = json.get(o name)
            if maybe.isSome(v) then
                case maybe.unwrap(v)
                    when jString with x then maybe.some(x.s)
                    else maybe.none()
                end
            else
                maybe.none()
            end
        end

    (* A request's cursor, or the end of its code *)
    let cursorOf(o: json.Object code: String): Int =
        begin
            let v = json.get(o "cursor")
            if maybe.isSome(v) then
                case maybe.unwrap(v)
                    when jNumber with x then
                        if x.isInteger then maybe.unwrapOr(strutil.tryToInt(x.text) stringOp.length(code))
                        else stringOp.length(code)
                        end
                    else stringOp.length(code)
                end
            else
                stringOp.length(code)
            end
        end

    (* Answers a request, a line read from descriptor 3, writing its records
     * to w *)
    let serve(r: repl.T w: writer.T line: String): Ok =
        if stringOp.length(strutil.strip(line)) > 0 then
            let request = try maybe.some(json.parse(line)) when json.error then maybe.none(:json.Value) end
            let o =
                if maybe.isSome(request) then
                    case maybe.unwrap(request)
                        when jObject with x then maybe.some(x.o)
                        else maybe.none(:json.Object)
                    end
                else
                    maybe.none(:json.Object)
                end
            let has = fun(name: String): Bool
                maybe.isSome(o) andif maybe.isSome(member(maybe.unwrap(o) name))
            let text = fun(name: String): String maybe.unwrap(member(maybe.unwrap(o) name))
            if has("execute") then
                (* One that arrived between cells is not this cell's *)
                interrupts.clear()
                execute(r w text("execute"))
            elsif has("complete") then
                complete(r w text("complete") cursorOf(maybe.unwrap(o) text("complete")))
                writeRecord(w array of "done" end array of json.string("ok") end)
            elsif has("inspect") then
                inspectName(r w text("inspect") cursorOf(maybe.unwrap(o) text("inspect")))
                writeRecord(w array of "done" end array of json.string("ok") end)
            elsif has("isComplete") then
                let status = if repl.incomplete(text("isComplete")) then "incomplete" else "complete" end
                writeRecord(w array of "status" end array of json.string(status) end)
                writeRecord(w array of "done" end array of json.string("ok") end)
            else
                writeRecord(w array of "error" "message" "rendered" end array of json.string("protocol")
                    json.string("not a request: " <> line) json.string("not a request: " <> line <> "\n")
                end)
                writeRecord(w array of "done" end array of json.string("error") end)
            end
        end

    (* Says that descriptor 3 or 4 is not open, and exits *)
    let closed(what: String): Ok =
        begin
            writer.putString(writer.err "quest: error: --kernel " <> what <> ", which is not open\n")
            system.sysexit(2)
        end

    let records(): writer.T =
        try writer.file("/dev/fd/4") when writer.error then closed("writes records to descriptor 4") writer.output end

    let runKernel(r: repl.T): Int =
        begin
            let requests =
                try reader.file("/dev/fd/3")
                when reader.error then closed("reads requests from descriptor 3") reader.input
                end
            let w = records()
            (* An interrupt raises `interrupted` in the cell running, in code
             * the JIT compiles from now on and in the interpreter *)
            if interrupts.install() then
                native.setInterruptChecks(true)
                treewalk.setInterruptPoll(interrupts.take)
            end
            let var reading = true
            while reading do
                let line = readRequest(requests)
                if maybe.isNone(line) then reading := false else serve(r w maybe.unwrap(line)) end
            end
            writer.flush(writer.output)
            writer.flush(writer.err)
            0
        end

    (* The session a host's calls of request serve, once serving holds it *)
    let held = vector.new(:Tuple r: repl.T w: writer.T end)

    let serving(r: repl.T): Bool =
        if stringOp.length(system.getEnv("QUEST_HOST_SESSION")) > 0 then
            vector.append(held tuple let r = r let w = records() end)
            true
        else
            false
        end

    let request(): Int =
        if vector.length(held) is 0 then
            0
        else
            let session = vector.get(held 0)
            let requests =
                try reader.file("/dev/fd/3")
                when reader.error then closed("reads requests from descriptor 3") reader.input
                end
            let line = readRequest(requests)
            reader.close(requests)
            if maybe.isNone(line) then
                0
            else
                serve(session.r session.w maybe.unwrap(line))
                1
            end
        end
end
