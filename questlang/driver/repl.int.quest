(* Quest Self-Hosted Compiler: The REPL Interface
 *
 * Implements the interactive REPL (docs/repl.md; bootstrap counterpart:
 * bootstrap/python/quest/driver/repl.py). Reads phrases line by line through
 * io/readline until each input is syntactically complete, then type-checks and
 * runs it in a persistent environment and frame, rolling back on failure. *)

interface Repl
import
    questlang/common/location : questlang/common/Location
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/types/env : questlang/types/Env
    questlang/common/diagbag : questlang/common/DiagBag
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/values/model : questlang/values/Model
    questlang/jit/session : questlang/jit/Session
    util/maybe : util/Maybe
export
    (* The prompts, and the prefix of a phrase's result *)
    promptMain: String
    promptContinue: String
    prefixResult: String

    (* Whether text needs more lines to complete a phrase: an unclosed comment
     * or string, or a syntax error at the end of the input
     * (check_input_completeness) *)
    incomplete(text: String): Bool

    (* The diagnostic of an error raised while running, in the file whose code
     * raised it, with its frames (the driver's too) *)
    runErrorDiagnostic(err: model.RunError mainFile: String): diagnostics.Diagnostic

    (* A REPL session's state: the type-checking environment e, the interpreter
     * frame for the next input, errorSource (the source map where a runtime
     * error occurred, when it came from an earlier input's function), failure
     * (the category or exception name of the last failed input, for the
     * kernel), and jit (the JIT session when running with --jit;
     * docs/jit.md) *)
    Def T = Tuple
        e: env.T
        var frame: model.Frame
        var errorSource: maybe.T(location.SourceMap)
        var failure: String
        jit: maybe.T(session.T)
    end
    (* A session continuing in e and f, after a file -i ran, say *)
    new(e: env.T f: model.Frame): T
    (* A session in e whose inputs the JIT compiles and runs, their programs
     * seeing args as system.args *)
    newJit(e: env.T f: model.Frame args: Array(String)): T
    (* Runs a typed program with the JIT as one input (such as a file for -i),
     * printing the last phrase's result (or every phrase's when echo is true)
     * as interpret does. Returns whether it succeeded, recording errors in
     * bag. *)
    runInput(r: T program: typedAst.Program sm: location.SourceMap bag: diagbag.T echo: Bool): Bool
    (* Reads, type-checks, and runs inputs until EOF, persisting history in
     * ~/.quest_history when line editing is active. Returns the exit status. *)
    run(r: T): Int
    (* Compiles and runs one input as a transaction: on failure, the session
     * state is rolled back and errors are recorded in bag. Returns the
     * formatted result of each phrase if it succeeded, or none. *)
    evaluate(r: T text: String sm: location.SourceMap bag: diagbag.T): maybe.T(Array(String))
    (* The name inputs' diagnostics give their source *)
    inputName: String
end
