(* Quest Self-Hosted Compiler: A Binary's Errors Interface
 *
 * Converts the standard error output of a failed compiled program into a
 * source diagnostic, matching the bootstrap compiler's
 * binary_error_diagnostic. It parses an uncaught exception's message, raise
 * site, and stack trace frames so the driver can render them against the
 * program's source. *)

interface BinaryErrors
import
    questlang/common/location : questlang/common/Location
    questlang/common/diagnostics : questlang/common/Diagnostics
export
    (* Builds a diagnostic from a compiled program's standard error output
     * (docs/exceptions.md section 2.2). It extracts the error message, stack
     * trace frames, and raise site, reading the named file if it differs from
     * sm so the diagnostic can show the source line. If there is no raise site
     * or the file cannot be read, the diagnostic has no source location. *)
    binaryErrorDiagnostic(stderr: String sm: location.SourceMap): diagnostics.Diagnostic
end
