(* Quest Self-Hosted Compiler: The Driver's SSA Phases, for WebAssembly
 *
 * Provides the WebAssembly variant of driver/ssaphases. Only the native
 * backends use SSA, so a driver compiled to WebAssembly selects this stub to
 * avoid linking the SSA modules (docs/wasm.md section 5.1). *)

module ssaPhases : SSAPhases
import
    questlang/ir/nodes : questlang/ir/Nodes
export
    let run(unit: nodes.Unit backend: String shows: All(name: String) Bool dump: All(text: String) Ok checks: Bool)
            : String = "ssa: this driver was compiled to WebAssembly, and has no SSA"
end
