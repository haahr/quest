(* Quest Self-Hosted Compiler: The Driver's SSA Phases, for WebAssembly
 *
 * The wasm variant of driver/ssaphases, which a driver compiled to
 * WebAssembly takes: it has no SSA, which the native backends alone use, so
 * that the SSA's units are left out of it (docs/wasm-plan.md step 22). *)

module ssaPhases : SsaPhases
import
    questlang/ir/nodes : questlang/ir/Nodes
export
    let run(unit: nodes.Unit shows: All(name: String) Bool dump: All(text: String) Ok checks: Bool): String =
        "ssa: this driver was compiled to WebAssembly, and has no SSA"
end
