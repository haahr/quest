(* Quest Self-Hosted Compiler: The Driver's SSA Phases
 *
 * The SSA of a unit for --stop-after and --dump-after (docs/ssa.md), apart
 * from the driver so that a variant can leave it out: ssaphases.wasm, which a
 * driver compiled to WebAssembly takes (docs/build-process.md section 6.4),
 * has no SSA (docs/wasm-plan.md step 22). *)

interface SsaPhases
import
    questlang/ir/nodes : questlang/ir/Nodes
export
    (* Builds unit's SSA through its passes, dumping each pass's SSA that shows
     * names (ssa_NAME) and the last (ssa), which with checks must read back
     * as itself: the failure's message, or "" *)
    run(unit: nodes.Unit shows: All(name: String) Bool dump: All(text: String) Ok checks: Bool): String
end
