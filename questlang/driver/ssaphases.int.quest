(* Quest Self-Hosted Compiler: The Driver's SSA Phases Interface
 *
 * Runs the SSA (Static Single Assignment) pipeline for --stop-after and
 * --dump-after (docs/ssa.md). This lives in a separate module so that the
 * WebAssembly driver can substitute ssaphases.wasm (docs/build-process.md
 * section 6.4) and omit the SSA subsystem (docs/wasm.md section 5.1). *)

interface SSAPhases
import
    questlang/ir/nodes : questlang/ir/Nodes
export
    (* Runs unit through the SSA passes under backend's policy
     * (codegen/ssaBackend.policyFor), calling dump for each pass requested by
     * shows (ssa_NAME) and for the final output (ssa). When checks is true,
     * verifies that the printed SSA parses back identically. Returns an error
     * message on failure, or "". *)
    run(unit: nodes.Unit backend: String shows: All(name: String) Bool dump: All(text: String) Ok checks: Bool)
            : String
end
