(* Quest Self-Hosted Compiler: The Driver's SSA Phases Implementation *)

module ssaPhases : SSAPhases
import
    stringOp = string : StringOp

    questlang/codegen/ssaBackend : questlang/codegen/SSABackend
    questlang/ir/nodes : questlang/ir/Nodes
    ssaNodes = questlang/ssa/nodes : questlang/ssa/Nodes
    ssaParser = questlang/ssa/parser : questlang/ssa/Parser
    ssaPipeline = questlang/ssa/pipeline : questlang/ssa/Pipeline
    ssaPrinter = questlang/ssa/printer : questlang/ssa/Printer
export
    (* The SSA as backend's passes leave it, dumped as shows asks; a
     * failure's message, or "" *)
    let dumped(unit: nodes.Unit backend: String shows: All(name: String) Bool dump: All(text: String) Ok checks: Bool)
            : String =
        begin
            let built = ssaPipeline.run(unit ssaBackend.policyFor(backend) fun(name: String u: ssaNodes.Unit): Ok
                if shows("ssa_" <> name) then dump(ssaPrinter.formatUnit(u)) end)
            let var failure = ""
            if shows("ssa") then
                let text = ssaPrinter.formatUnit(built)
                (* The SSA's text reads back as itself (ssa/parser) *)
                if checks andif not(stringOp.equal(ssaPrinter.formatUnit(ssaParser.readUnit(text)) text)) then
                    failure := "ssa: the SSA does not read back as printed"
                end
                dump(text)
            end
            failure
        end

    let run(unit: nodes.Unit backend: String shows: All(name: String) Bool dump: All(text: String) Ok checks: Bool)
            : String =
        try ssaPipeline.attempt(fun(): String dumped(unit backend shows dump checks) fun(m: String): String m)
        when ssaParser.readError with m then "ssa: " <> m
        end
end
