(* Quest Self-Hosted Compiler: The Driver's Command Line Interface
 *
 * Defines the driver's command-line phases (front end, IR stages, SSA passes,
 * and backends), usage reporting, and parsed options. Options are parsed from
 * system.args at module initialization using the bootstrap compiler's option
 * spellings (bootstrap/python/quest/driver/options.py); invalid options print
 * the usage message and exit with status 2. *)

interface Options
import
    util/maybe : util/Maybe

    questlang/codegen/choice : questlang/codegen/Choice
export
    (* Phase lists: IR stages (docs/ir.md section 9) for ir_STAGE and
     * run_ir_STAGE, all recognized phases, SSA phases, and backend phases *)
    irStages: Array(String)
    phases: Array(String)
    ssaPhases: Array(String)
    cPhases: Array(String)
    (* Whether the command is `compile`, and the program's name in errors that
     * are not diagnostics *)
    compileMode: Bool
    (* Whether the command is `fmt` (questlang/format), whose arguments are its
     * own: none of them is parsed here *)
    fmtMode: Bool
    (* Whether the command is `lsp`, the language server (questlang/lsp) *)
    lspMode: Bool
    programName: String
    (* Prints message and the usage to standard error, and exits with 2 *)
    usage(message: String): Ok
    (* The command line, parsed: the phase to stop after (and whether one was
     * given), the program (a file, standard input, -e's code, or the REPL's
     * inputs, as file names it), the options of output and dumps, of the
     * build, and of running, and the program's arguments *)
    Def T = Tuple
        stopAfter: String
        file: String
        fromFile: Bool
        fromStdin: Bool
        code: maybe.T(String)
        showOffsets: Bool
        showValues: Bool
        echo: Bool
        printResult: Bool
        stopGiven: Bool
        buildDir: maybe.T(String)
        output: maybe.T(String)
        verbose: Bool
        jobs: Int
        wholeProgram: Bool
        (* The modules a whole program compiles apart rather than merging
         * (--apart, for measuring what merging them gains:
         * docs/inlined-modules-plan.md section 2.3) *)
        apart: Array(String)
        (* The modules a separately compiled unit inlines, besides the
         * library's (--inline-module, by canonical name), and whether the
         * library's are (no --no-inline-library): modules/inlined *)
        inlineModules: Array(String)
        inlineLibrary: Bool
        backends: choice.T
        (* The engine for wasm runs (wasmtime or node), and whether --backend
         * wasm FILE runs directly like a native program (forwarding stdout,
         * stderr, and exit status) *)
        wasmEngine: String
        runWasm: Bool
        expectedExit: Int
        dumpAfter: Array(String)
        extraObjects: Array(String)
        includePaths: Array(String)
        interactive: Bool
        kernel: Bool
        jit: Bool
        programArgs: Array(String)
        compileOnly: Bool
        emitC: Bool
        nogc: Bool
        (* --report-inferable's mode: "equal" or "exact", or empty if it is not
         * given (typechecker/application's reportInferable) *)
        reportInferable: String
    end
    options: T
end
