(* Quest Self-Hosted Compiler: Whole-Program Units Implementation *)

module whole : Whole
import
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe

    questlang/common/files : questlang/common/Files
    questlang/common/location : questlang/common/Location
    questlang/ir/lower : questlang/ir/Lower
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/opened : questlang/ir/Opened
    questlang/ir/walk : questlang/ir/Walk
    questlang/modules/elaboration : questlang/modules/Elaboration
    questlang/modules/graph : questlang/modules/Graph
    questlang/modules/paths : questlang/modules/Paths
    questlang/modules/units : questlang/modules/Units
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
export
    Let Module = nodes.Module

    let eq(a: String b: String): Bool = stringOp.equal(a b)

    (* Normalizes a canonical module name to lowercase for lookup, since
     * imports are case-insensitive (e.g. prelinked arrayOp is imported as
     * arrayop by library modules) *)
    let key(canonical: String): String = paths.lower(canonical)

    (* Builds a source map for the module named canonical from its resolved
     * source file, if available, so exception raise sites carry file and line
     * info *)
    let sourceMapOf(e: env.T canonical: String): maybe.T(location.SourceMap) =
        begin
            let var found = maybe.none(:location.SourceMap)
            let resolved = hashMap.values(e.units.resolver.memo)
            for k = 0 upto {vector.length(resolved) - 1} do
                let r = vector.get(resolved k)
                if maybe.isNone(found) andif maybe.isSome(r.source)
                        andif maybe.isSome(r.canonical) andif eq(maybe.unwrap(r.canonical) canonical)
                        andif case r.kind when moduleUnit then true when interfaceUnit, programUnit then false end then
                    let file = maybe.unwrap(r.source)
                    let text = files.readText(file)
                    if maybe.isSome(text) then
                        found := maybe.some(location.newSourceMap(file maybe.unwrap(text)))
                    end
                end
            end
            found
        end

    (* Rewrites references to imported modules in body (and any nested bodies
     * or functions) to point to the corresponding merged module in merged,
     * or to the one import kept for a module compiled apart (kept) *)
    let rewriteRefs(body: nodes.Body merged: hashMap.T(String Module) kept: hashMap.T(String nodes.Import)): Ok =
        begin
            let ref(r: nodes.ModuleRef): nodes.ModuleRef =
                case r
                    when refImport with x then
                        let m = hashMap.get(merged key(x.i.canonicalPath))
                        let k = hashMap.get(kept key(x.i.canonicalPath))
                        if maybe.isSome(m) then
                            option refModule of nodes.ModuleRef with let m = maybe.unwrap(m) end
                        elsif maybe.isSome(k) then
                            option refImport of nodes.ModuleRef with let i = maybe.unwrap(k) end
                        else
                            r
                        end
                    when refModule then r
                end
            let optRef(r: maybe.T(nodes.ModuleRef)): maybe.T(nodes.ModuleRef) =
                if maybe.isSome(r) then
                    maybe.some(ref(maybe.unwrap(r)))
                else
                    r
                end
            let op(o: nodes.Op): Ok =
                case o
                    when opCall with x then x.moduleRef := optRef(x.moduleRef)
                    when opTypeApp with x then x.moduleRef := optRef(x.moduleRef)
                    when opModuleMember with x then x.moduleRef := ref(x.moduleRef)
                    else ok
                end
            let stmts = walk.walkStatements(body true)
            for k = 0 upto {vector.length(stmts) - 1} do
                case vector.get(stmts k)
                    when sLet with x then op(x.value)
                    when sDo with x then op(x.value)
                    else ok
                end
            end
        end

    let mergeImports(unit: nodes.Unit e: env.T apart: Array(String)): nodes.Unit =
        begin
            let merged = hashMap.new(:String :Module eq hash.string)
            (* The modules merged, each after those it imports *)
            let order = vector.new(:Module)
            let functions = vector.new(:nodes.Function)
            (* The modules known only through their interfaces and objects (the
             * library's), which stay imported *)
            let kept = vector.new(:nodes.Import)
            let keptNames = hashMap.new(:String :Bool eq hash.string)
            let keptByKey = hashMap.new(:String :nodes.Import eq hash.string)
            let rec visit(i: nodes.Import): Ok =
                if hashMap.contains(merged key(i.canonicalPath)) then ok
                elsif hashMap.contains(keptNames key(i.canonicalPath)) then
                    (* One import of a kept module stands for all, the one
                     * with its interface's record type if any has it *)
                    let held = hashMap.find(keptByKey key(i.canonicalPath))
                    if maybe.isNone(held.recordType) andif maybe.isSome(i.recordType) then
                        begin hashMap.insert(keptByKey key(i.canonicalPath) i) ok end
                        for k = 0 upto {vector.length(kept) - 1} do
                            if vector.get(kept k) is held then vector.set(kept k i) end
                        end
                    end
                else
                    let typed = graph.typedModule(e.units i.canonicalPath)
                    let named = begin
                        let var found = false
                        for k = 0 upto {extent apart - 1} do
                            if eq(key(apart[k]) key(i.canonicalPath)) then found := true end
                        end
                        found
                    end
                    let precompiled = if maybe.isNone(typed) orif named then true
                        else case maybe.unwrap(typed).form
                            when bindModule with x then x.isPrecompiled
                            else true
                        end end
                    if precompiled then
                        (* An import lowered without its interface's record
                         * type (one a merged module makes through an alias
                         * of a module kept apart) is given it from the
                         * interface's scope *)
                        let i =
                            if maybe.isSome(i.recordType) then
                                i
                            else
                                let var scope = graph.interfaceScope(e.units i.canonicalPath)
                                if maybe.isNone(scope) then scope := graph.interfaceScope(e.units i.interfacePath) end
                                if maybe.isNone(scope) then
                                    i
                                else
                                    nodes.newImport(i.name i.modulePath i.canonicalPath i.interfacePath
                                            maybe.some(elaboration.buildRecordTypeFromScope(maybe.unwrap(scope)
                                                    maybe.none(:String))) i.libPath)
                                end
                            end
                        hashMap.insert(keptNames key(i.canonicalPath) true)
                        begin hashMap.insert(keptByKey key(i.canonicalPath) i) ok end
                        vector.append(kept i)
                    else
                        merge(i maybe.unwrap(typed))
                    end
                end
            and merge(i: nodes.Import typed: typedAst.Binding): Ok =
                begin
                    let sm = sourceMapOf(e i.canonicalPath)
                    vector.append(unit.mergedSources sm)
                    let file = vector.length(unit.mergedSources)
                    let mu = lower.lowerModuleFile(typed e sm file)
                    let m = vector.get(mu.modules 0)
                    hashMap.insert(merged key(i.canonicalPath) m)
                    for k = 0 upto {extent mu.imports - 1} do visit(mu.imports[k]) end
                    for k = 0 upto {vector.length(mu.functions) - 1} do
                        vector.append(functions vector.get(mu.functions k))
                    end
                    vector.append(order m)
                end
            for k = 0 upto {extent unit.imports - 1} do visit(unit.imports[k]) end
            (* The unit's own modules (defined in the program) after those
             * merged, which they may import *)
            for k = 0 upto {vector.length(unit.modules) - 1} do
                vector.append(order vector.get(unit.modules k))
            end
            for k = 0 upto {vector.length(unit.functions) - 1} do
                vector.append(functions vector.get(unit.functions k))
            end
            rewriteRefs(unit.main merged keptByKey)
            for k = 0 upto {vector.length(order) - 1} do
                rewriteRefs(vector.get(order k).init merged keptByKey)
            end
            for k = 0 upto {vector.length(functions) - 1} do
                rewriteRefs(vector.get(functions k).body merged keptByKey)
            end
            unit.modules := order
            unit.functions := functions
            unit.imports := vector.toArray(kept)
            unit
        end

    let dropUnreachable(unit: nodes.Unit): nodes.Unit = opened.dropUnreachable(unit fun(m: Module): Bool true)
end
