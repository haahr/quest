(* Quest Self-Hosted Compiler: Whole-Program Units Interface
 *
 * Merges a program's Core IR unit with all transitively imported source
 * modules for --whole-program compilation (docs/build-process.md section 1.2;
 * docs/arm64.md section 3.12). Each imported module is lowered to Core IR and
 * folded into the program's unit in dependency order, with all references to
 * it rewritten to point to the merged module so subsequent passes and backends
 * see a single unit. Precompiled modules known only through their interfaces
 * (such as standard library modules) remain external imports linked from their
 * object files. *)
interface Whole
import
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/types/env : questlang/types/Env
export
    (* Merges all source modules transitively imported by unit into unit,
     * leaving precompiled modules known only through their interfaces as
     * external imports *)
    mergeImports(unit: nodes.Unit e: env.T): nodes.Unit
    (* Prunes unreachable module members from a whole-program unit (docs/ir.md
     * section 8.6). Starting from the main body, top-level functions, and
     * side-effecting module initializer statements, it traces reachable
     * variables and module members. Unreachable pure bindings and function
     * groups are removed from module initializers, members, and exports, and
     * any module whose record value is never read has its recordVar cleared. *)
    dropUnreachable(unit: nodes.Unit): nodes.Unit
end
