(* Quest Self-Hosted Compiler: A Binary's Errors Implementation *)

module binaryErrors : BinaryErrors
import
    questlang/common/location : questlang/common/Location
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/files : questlang/common/Files
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/strutil : util/Strutil
    util/stringBuilder : util/StringBuilder
    stringOp = string : StringOp
    conv : Conv
export
    (* The 0-indexed offset of a (1-indexed) line and column of a source, the
     * inverse of location.locate *)
    let offsetOf(text: String line: Int column: Int): Int =
        begin
            let starts = vector.new(:Int)
            vector.append(:Int starts 0)
            for i = 0 upto {stringOp.length(text) - 1} do
                if stringOp.getChar(text i) is '\n' then vector.append(:Int starts {i + 1}) end
            end
            let index = if line < 1 then 0 elsif line > vector.length(:Int starts) then
                vector.length(:Int starts) - 1 else line - 1 end
            let offset = vector.get(:Int starts index) + {if column > 1 then column - 1 else 0 end}
            if offset > stringOp.length(text) then stringOp.length(text) else offset end
        end

    (* The frames of a traceback's lines, a run of calls of the same function
     * listed in full *)
    let traceOf(lines: vector.T(String) from: Int): Array(String) =
        begin
            let frames = vector.new(:String)
            for i = from upto {vector.length(:String lines) - 1} do
                let line = vector.get(:String lines i)
                if strutil.startsWith(line "  in ") then
                    vector.append(:String frames stringOp.getSub(line 5 {stringOp.length(line) - 5}))
                elsif strutil.startsWith(line "  ... ") andif strutil.endsWith(line " more times") then
                    (* "  ... F repeated N more times" *)
                    let body = stringOp.getSub(line 6 {stringOp.length(line) - 17})
                    let at = strutil.rfind(body " repeated ")
                    if at >= 0 then
                        let name = stringOp.getSub(body 0 at)
                        let count = strutil.toInt(stringOp.getSub(body {at + 10} {stringOp.length(body) - {at + 10}}))
                        for k = 1 upto count do vector.append(:String frames name) end
                    end
                end
            end
            vector.toArray(:String frames)
        end

    let joinLines(lines: vector.T(String) from: Int to: Int): String =
        begin
            let b = stringBuilder.new()
            for i = from upto {to - 1} do
                if i > from then b.char('\n') end
                b.str(vector.get(:String lines i))
            end
            b.toString()
        end

    (* The site a compiled program's error was raised at, from its line
     * "  at FILE:LINE:COLUMN" *)
    let raiseSite(line: String): maybe.T(Tuple file: String line: Int column: Int end) =
        begin
            let none = maybe.none(:Tuple file: String line: Int column: Int end)
            if not(strutil.startsWith(line "  at ")) then
                none
            else
                let rest = stringOp.getSub(line 5 {stringOp.length(line) - 5})
                let second = strutil.rfind(rest ":")
                let first = if second > 0 then strutil.rfind(stringOp.getSub(rest 0 second) ":") else ~1 end
                let digits = fun(t: String): Bool
                    begin
                        let var all = stringOp.length(t) > 0
                        for i = 0 upto {stringOp.length(t) - 1} do
                            let c = stringOp.getChar(t i)
                            if not(strutil.isDigit(c)) then all := false end
                        end
                        all
                    end
                if first <= 0 then
                    none
                else
                    let lineText = stringOp.getSub(rest {first + 1} {second - {first + 1}})
                    let columnText = stringOp.getSub(rest {second + 1} {stringOp.length(rest) - {second + 1}})
                    if digits(lineText) andif digits(columnText) then
                        maybe.some(:Tuple file: String line: Int column: Int end tuple
                            let file = stringOp.getSub(rest 0 first)
                            let line = strutil.toInt(lineText) let column = strutil.toInt(columnText)
                        end)
                    else
                        none
                    end
                end
            end
        end

    (* The diagnostic for the error output of a compiled program
     * (docs/exceptions.md section 2.2): its message, located at the site the
     * program printed, in the program's file or the file the site names, which
     * is read for its source line, with the frames it printed. Without a site,
     * or when the file cannot be read, the diagnostic has no location. *)
    let binaryErrorDiagnostic(stderr: String sm: location.SourceMap): diagnostics.Diagnostic =
        begin
            let var text = stderr
            while {stringOp.length(text) > 0} andif {stringOp.getChar(text {stringOp.length(text) - 1}) is '\n'} do
                text := stringOp.getSub(text 0 {stringOp.length(text) - 1})
            end
            let lines = strutil.splitlines(text)
            let var last = vector.length(:String lines)
            while {last > 0} andif {strutil.startsWith(vector.get(:String lines {last - 1}) "  in ")
                orif strutil.startsWith(vector.get(:String lines {last - 1}) "  ... ")} do
                last := last - 1
            end
            let trace = traceOf(lines last)
            let site = if last > 0 then raiseSite(vector.get(:String lines {last - 1}))
                else maybe.none(:Tuple file: String line: Int column: Int end) end
            let nowhere = location.span("" ~1 ~1)
            let d = if maybe.isNone(:Tuple file: String line: Int column: Int end site) then
                diagnostics.error(strutil.strip(joinLines(lines 0 last)) nowhere)
            else
                let at = maybe.unwrap(:Tuple file: String line: Int column: Int end site)
                let message = strutil.strip(joinLines(lines 0 {last - 1}))
                let siteText = if stringOp.equal(at.file location.file(sm)) then maybe.some(:String location.text(sm))
                    else files.readText(at.file) end
                if maybe.isNone(:String siteText) then
                    diagnostics.error(message <> "\n  at " <> at.file <> ":" <> conv.int(at.line) <> ":"
                        <> conv.int(at.column)
                        nowhere)
                else
                    if not(stringOp.equal(at.file location.file(sm))) then
                        diagnostics.registerSource(location.newSourceMap(at.file maybe.unwrap(:String siteText)))
                    end
                    let offset = offsetOf(maybe.unwrap(:String siteText) at.line at.column)
                    diagnostics.error(message location.span(at.file offset {offset + 1}))
                end
            end
            if extent trace > 0 then diagnostics.setTrace(d trace) end
            d
        end
end
