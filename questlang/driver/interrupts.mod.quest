(* Quest Self-Hosted Compiler: The Kernel's Interrupts Implementation *)

unsound module interrupts : Interrupts
import
    os/code : os/Code
    os/value : os/Value
    util/maybe : util/Maybe
export
    let flag = code.symbol("quest_interrupt_pending")

    let install(): Bool =
        begin
            let handler = code.symbol("quest_interrupt_install")
            if maybe.isSome(handler) andif maybe.isSome(flag) then
                let ignored = code.call(maybe.unwrap(handler))
                true
            else
                false
            end
        end

    (* The flag, a word *)
    let read(): Int =
        if maybe.isSome(flag) then value.be(value.fetch(maybe.unwrap(flag) 0)) else 0 end

    let clear(): Ok =
        if maybe.isSome(flag) then value.store(maybe.unwrap(flag) 0 value.new(0)) end

    let take(): Bool = if read() isnot 0 then begin clear() true end else false end
end
