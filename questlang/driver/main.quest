(* Quest Self-Hosted Compiler: Driver
 *
 * The quest command: it runs a program, prints a phase's output, compiles a
 * unit file alone, builds a binary, or enters the REPL, as the command line
 * asks (usageText lists the forms and options; the bootstrap counterpart is
 * bootstrap/python/quest_driver.py). The forms:
 *
 * Running a program (FILE, -e PROGRAM, or - for standard input): the program
 * is compiled and run by the JIT (questlang/jit), or by the tree-walking
 * interpreter with --no-jit, an option only the interpreter has (such as
 * --stop-after), or a driver that cannot host the JIT. It prints the last
 * phrase's result, or every phrase's with --echo. The arguments after FILE,
 * or after a --, are the program's (system.args). With neither FILE nor -e,
 * the REPL (questlang/driver/repl) starts at a terminal, and otherwise
 * standard input holds the program; -i enters the REPL after running FILE,
 * in its environment and frame.
 *
 * Phases (--stop-after PHASE, --dump-after PHASE): the driver runs the
 * phases through PHASE and prints its output (tokenize, parse, desugar, and
 * typecheck in the bootstrap's format; the IR at a stage, or run; the SSA
 * after a pass; the program's C or arm64 assembly; or the compiled program
 * run) on standard output, and diagnostics on standard error, exiting with 1
 * if there are errors. run_tests.py --self-hosted checks these outputs
 * against the bootstrap's goldens (docs/testing.md section 2.3).
 *
 * A unit file (.int.quest, .mod.quest) given without a phase or -e is
 * compiled alone (compileUnitFile; -c, which says so, is optional): an
 * interface to its .qi and C header, a module to its C, object, and .qm,
 * beside -o, else under --build-dir, else beside the file.
 *
 * Building (quest compile FILE, or a program with -o): the build engine
 * (questlang/build) compiles the program and its modules separately, each
 * only if stale, and links a binary, FILE without .quest or -o's; with -c it
 * compiles them without linking. compile --emit-c writes the program's C
 * (to -o, else standard output) instead, and --whole-program compiles the
 * program and its modules as one unit, both without the engine. Object files
 * given on the command line are linked with the program, which then runs
 * compiled (run_c_compiled) unless a phase or -o is given.
 *
 * A worker of a parallel build is this program too, run with a worker's
 * command line (build/workers) *)

import
    questlang/common/location : questlang/common/Location
    questlang/common/diagbag : questlang/common/DiagBag
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/syntax/tokens : questlang/syntax/Tokens
    questlang/syntax/tokenizer : questlang/syntax/Tokenizer
    questlang/syntax/ast : questlang/syntax/Ast
    questlang/syntax/parser : questlang/syntax/Parser
    questlang/syntax/desugar : questlang/syntax/Desugar
    questlang/syntax/astprint : questlang/syntax/AstPrint
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/typechecker/typedAstPrint : questlang/typechecker/TypedAstPrint
    questlang/typechecker/typecheck : questlang/typechecker/Typecheck
    questlang/modules/paths : questlang/modules/Paths
    questlang/modules/stdlib : questlang/modules/Stdlib
    questlang/modules/units : questlang/modules/Units
    questlang/modules/loader : questlang/modules/Loader
    questlang/modules/graph : questlang/modules/Graph
    questlang/modules/moduleCompiler : questlang/modules/ModuleCompiler
    questlang/codegen/c/headers : questlang/codegen/c/Headers
    questlang/codegen/c/compilerRunner : questlang/codegen/c/CompilerRunner
    questlang/values/model : questlang/values/Model
    questlang/interpreter/builtins : questlang/interpreter/Builtins
    questlang/interpreter/formatting : questlang/interpreter/Formatting
    questlang/interpreter/treewalk : questlang/interpreter/Treewalk
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/lower : questlang/ir/Lower
    questlang/ir/whole : questlang/ir/Whole
    questlang/ir/printer : questlang/ir/Printer
    questlang/ir/verify : questlang/ir/Verify
    questlang/ir/simplify : questlang/ir/Simplify
    questlang/ir/shapes : questlang/ir/Shapes
    questlang/ir/specialize : questlang/ir/Specialize
    questlang/ir/closure : questlang/ir/Closure
    questlang/ir/unbox : questlang/ir/Unbox
    questlang/ir/represent : questlang/ir/Represent
    questlang/ir/describe : questlang/ir/Describe
    questlang/ir/thunks : questlang/ir/Thunks
    ssaBuild = questlang/ssa/build : questlang/ssa/Build
    ssaNodes = questlang/ssa/nodes : questlang/ssa/Nodes
    ssaPipeline = questlang/ssa/pipeline : questlang/ssa/Pipeline
    ssaParser = questlang/ssa/parser : questlang/ssa/Parser
    ssaVerify = questlang/ssa/verify : questlang/ssa/Verify
    ssaPrinter = questlang/ssa/printer : questlang/ssa/Printer
    questlang/interpreter/irInterp : questlang/interpreter/IrInterp
    cPrinter = questlang/codegen/c/printer : questlang/codegen/c/Printer
    cBackend = questlang/codegen/c/backend : questlang/codegen/c/Backend
    questlang/codegen/choice : questlang/codegen/Choice
    questlang/driver/repl : questlang/driver/Repl
    questlang/jit/session : questlang/jit/Session
    questlang/common/memoryFiles : questlang/common/MemoryFiles
    questlang/build/engine : questlang/build/Engine
    questlang/build/workers : questlang/build/Workers
    passes = questlang/codegen/backend : questlang/codegen/Backend
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/strutil : util/Strutil
    conv : Conv
    util/stringBuilder : util/StringBuilder
    stringOp = string : StringOp
    reader : Reader
    writer : Writer
    system : System
    (* Unused here: imported so that the driver links them, as it links the
     * rest of lib/, for the JIT's inputs to import (docs/jit.md section 3.4) *)
    list : List
    dynamic : Dynamic
    collections/hashSet : collections/HashSet
    util/argparse : util/ArgParse
;

(* The IR's stages (docs/ir.md section 9) the driver dumps (ir_STAGE) and runs
 * (run_ir_STAGE) *)
let irStages = array of "core" "simplified" "specialized" "closed" "represented" "described" end;

let phases = array of
    "tokenize" "parse" "desugar" "typecheck"
    "ir_core" "ir_simplified" "ir_specialized" "ir_closed" "ir_represented" "ir_described"
    "run_ir_core" "run_ir_simplified" "run_ir_specialized" "run_ir_closed" "run_ir_represented" "run_ir_described"
    "interpret"
    "codegen_c" "codegen_arm64" "run_c_compiled"
    "ssa_built" "ssa_escape" "ssa_promote" "ssa_constants" "ssa_valueNumbers" "ssa_selects" "ssa_accumulate"
    "ssa_tailCalls" "ssa_tailJumps" "ssa"
end;

(* The SSA's phases (docs/ssa.md): the builder's, each pass's
 * (questlang/ssa/pipeline), and the last *)
let ssaPhases = array of
    "ssa_built" "ssa_escape" "ssa_promote" "ssa_constants" "ssa_valueNumbers" "ssa_selects" "ssa_accumulate"
    "ssa_tailCalls" "ssa_tailJumps" "ssa"
end;

(* The phases of the backends: the program's code (C, or arm64's assembly), and
 * its run *)
let cPhases = array of "codegen_c" "codegen_arm64" "run_c_compiled" end;

let isOneOf(s: String xs: Array(String)): Bool =
    begin
        let var found = false
        for i = 0 upto {extent xs - 1} do if stringOp.equal(xs[i] s) then found := true end end
        found
    end;

(* Object files given to link with the program *)
let objectSuffixes = array of ".o" ".a" ".dylib" ".so" end;
let isObjectFile(arg: String): Bool =
    begin
        let var found = false
        for i = 0 upto {extent objectSuffixes - 1} do if strutil.endsWith(arg objectSuffixes[i]) then
            found := true end end
        found
    end;

let isProgramFile(arg: String): Bool = case units.unitKind(arg) when programUnit then true else false end;

(* `compile`, before the options, translates the program to C and compiles it
 * to a binary (or with --emit-c, writes its C), as the bootstrap's `quest
 * compile` does *)
let compileMode = {extent system.args > 1} andif stringOp.equal(system.args[1] "compile");

(* The program's name in errors that are not diagnostics *)
let programName = if compileMode then "quest compile" else "quest" end;

(* The command line's forms, options, and phases, one to a line *)
let usageText = strutil.joinArray("\n" array of
    "usage: quest [OPTION...] [OBJECT...] [FILE|- [ARG...] | -e PROGRAM [-- ARG...] | -- ARG...]"
    "       quest compile [OPTION...] [OBJECT...] [FILE|- | -e PROGRAM]"
    ""
    "quest runs a program, compiled by the JIT; with neither FILE nor -e, it enters the REPL at a"
    "terminal, and otherwise runs standard input. quest compile writes a binary: FILE without its"
    ".quest, or -o's. OBJECTs (.o, .a, .dylib, .so) are linked with the program."
    ""
    "Options:"
    "  --stop-after PHASE   run through PHASE and print its output"
    "  --dump-after PHASE   print PHASE's output too (may be repeated)"
    "  -e PROGRAM           run PROGRAM, given as a string"
    "  -i                   enter the REPL after running FILE"
    "  --kernel             serve a Jupyter kernel's requests on descriptors 3 and 4"
    "  --jit, --no-jit      compile with the JIT (the default), or interpret"
    "  --echo               print every top-level phrase's result"
    "  --print-result       print the last phrase's result when compiled"
    "  --show-offsets       show source offsets in parse and desugar's output"
    "  --show-values        show tokens' values in tokenize's output"
    "  --expected-exit N    the status a compiled program must exit with"
    "  --backend B          compile every unit with B: arm64 (the default), c, or ssac"
    "  --unit-backend U=B   compile unit U (main, the program's) with B"
    "  --whole-program      compile the program and its modules as one unit"
    "  -o FILE              write the binary to FILE"
    "  -c                   compile without linking"
    "  -I DIR               look for modules in DIR too"
    "  --build-dir DIR      build in DIR (default .build)"
    "  -j N                 compile N modules at once"
    "  -v                   report what the build does"
    "  --emit-c             (compile) write the program's C (the C backend's, unless --backend), not a binary"
    "  --nogc               (compile) compile without the collector"
    "  -h, --help           print this message"
    ""
    "Phases (for --stop-after and --dump-after):"
    "  tokenize, parse, desugar, typecheck"
    "  ir_STAGE, run_ir_STAGE, with STAGE core, simplified, specialized, closed, represented,"
    "    or described: the IR at STAGE, printed or run"
    "  ssa_built, ssa_escape, ssa_promote, ssa_constants, ssa_valueNumbers, ssa_selects, ssa_accumulate,"
    "    ssa_tailCalls, ssa_tailJumps,"
    "    ssa: the SSA after each pass"
    "  interpret: run the program (not with compile)"
    "  codegen_c: the program's code (C, unless --backend arm64 gives assembly)"
    "  codegen_arm64: the program's arm64 assembly"
    "  run_c_compiled: run the compiled program (not with compile)"
    ""
end);

let usage(message: String): Ok =
    begin
        writer.putString(writer.err programName <> ": " <> message <> "\n" <> usageText)
        system.sysexit(2)
    end;

(* The command line: the phase to stop after, the file or the program given, and
 * the program's arguments. Each option has the bootstrap's spellings. *)
let options =
    begin
        let var stopAfter = if compileMode then "codegen_c" else "interpret" end
        let var stopGiven = false
        let var buildDir = maybe.none(:String)
        let var output = maybe.none(:String)
        let var verbose = false
        let var jobs = 1
        let var wholeProgram = false
        let var backend = "arm64"
        let var backendGiven = false
        let unitBackends = vector.new(:choice.Override)
        let var expectedExit = 0
        let dumpAfter = vector.new(:String)
        let extraObjects = vector.new(:String)
        let includePaths = vector.new(:String)
        let var file = ""
        let var code = maybe.none(:String)
        let var showOffsets = false
        let var showValues = false
        let var echo = false
        let var printResult = false
        let var interactive = false
        let var kernel = false
        let var jit = false
        let var noJit = false
        let var compileOnly = false
        let var emitC = false
        let var nogc = false
        let programArgs = vector.new(:String)
        (* The file, of which compile takes only one *)
        let setFile = fun(arg: String): Ok
            begin
                if compileMode andif not(stringOp.equal(file "")) then
                    writer.putString(writer.err "quest compile: error: multiple source files specified: '" <> file
                        <> "' and '" <> arg <> "'\n")
                    system.sysexit(1)
                end
                file := arg
            end
        (* An option of compile alone *)
        let compiling = fun(arg: String): Ok if not(compileMode) then usage(arg <> " is an option of compile") end
        (* A worker's command line is the worker's to read *)
        let var i = if workers.isUnitMode(system.args) then extent system.args elsif compileMode then 2 else 1 end
        while i < extent system.args do
            let arg = system.args[i]
            let valued = {i + 1} < extent system.args
            if isOneOf(arg array of "--stop-after" "--stop_after" end) andif valued then
                stopAfter := system.args[i + 1]
                stopGiven := true
                i := i + 2
            elsif isOneOf(arg array of "--build-dir" "--build_dir" end) andif valued then
                buildDir := maybe.some(:String system.args[i + 1])
                i := i + 2
            elsif isOneOf(arg array of "--dump-after" "--dump_after" end) andif valued then
                vector.append(:String dumpAfter system.args[i + 1])
                i := i + 2
            elsif isOneOf(arg array of "-o" "--output" end) andif valued then
                output := maybe.some(:String system.args[i + 1])
                i := i + 2
            elsif isOneOf(arg array of "-I" "--include" end) andif valued then
                vector.append(:String includePaths system.args[i + 1])
                i := i + 2
            elsif isOneOf(arg array of "-c" "--compile-only" end) then
                compileOnly := true
                i := i + 1
            elsif isOneOf(arg array of "-v" "--verbose" end) then
                verbose := true
                i := i + 1
            elsif {stringOp.equal(arg "-j")} andif valued then
                (* How many modules a build compiles at once *)
                let n = strutil.tryToInt(system.args[i + 1])
                if maybe.isNone(:Int n) orif {maybe.unwrap(:Int n) < 1} then
                    usage("-j takes a number of modules at least 1, not '" <> system.args[i + 1] <> "'")
                end
                jobs := maybe.unwrap(:Int n)
                i := i + 2
            elsif isOneOf(arg array of "--whole-program" "--whole_program" end) then
                wholeProgram := true
                i := i + 1
            elsif stringOp.equal(arg "--backend") andif valued then
                (* The backend every unit is compiled by (codegen/choice) *)
                if not(choice.isBackend(system.args[i + 1])) then
                    usage("--backend takes c, ssac, or arm64, not '" <> system.args[i + 1] <> "'")
                end
                backend := system.args[i + 1]
                backendGiven := true
                i := i + 2
            elsif stringOp.equal(arg "--unit-backend") andif valued then
                let o = choice.parseOverride(system.args[i + 1])
                if maybe.isNone(:choice.Override o) then
                    usage("--unit-backend takes UNIT=BACKEND, with BACKEND c, ssac, or arm64, not '" <> system.args[i + 1]
                        <> "'")
                end
                vector.append(:choice.Override unitBackends maybe.unwrap(:choice.Override o))
                i := i + 2
            elsif isOneOf(arg array of "--expected-exit" "--expected_exit" end) andif valued andif not(compileMode) then
                (* What a compiled program's exit status must be; the
                 * interpreter's is the program's own *)
                expectedExit := strutil.toInt(system.args[i + 1])
                i := i + 2
            elsif isOneOf(arg array of "-e" "--eval" "--code" "--command" end) andif valued then
                code := maybe.some(:String system.args[i + 1])
                i := i + 2
            elsif stringOp.equal(arg "--show-offsets") andif not(compileMode) then
                showOffsets := true
                i := i + 1
            elsif stringOp.equal(arg "--show-values") andif not(compileMode) then
                showValues := true
                i := i + 1
            elsif stringOp.equal(arg "--echo") then
                echo := true
                i := i + 1
            elsif isOneOf(arg array of "--print-result" "--print_result" end) then
                printResult := true
                i := i + 1
            elsif isOneOf(arg array of "-i" "--interactive" end) andif not(compileMode) then
                interactive := true
                i := i + 1
            elsif stringOp.equal(arg "--kernel") andif not(compileMode) then
                (* Requests from a Jupyter kernel instead of lines from a
                 * person (docs/jupyter-kernel.md) *)
                kernel := true
                i := i + 1
            elsif stringOp.equal(arg "--jit") andif not(compileMode) then
                (* The program, or the REPL's inputs, compiled and run by the
                 * JIT, not interpreted (docs/jit.md) *)
                jit := true
                noJit := false
                i := i + 1
            elsif stringOp.equal(arg "--no-jit") andif not(compileMode) then
                (* Interpreted, where the JIT would be the default *)
                jit := false
                noJit := true
                i := i + 1
            elsif stringOp.equal(arg "--emit-c") then
                compiling(arg)
                emitC := true
                i := i + 1
            elsif stringOp.equal(arg "--nogc") then
                compiling(arg)
                nogc := true
                i := i + 1
            elsif isOneOf(arg array of "-h" "--help" end) then
                writer.putString(writer.output usageText)
                system.sysexit(0)
            elsif isObjectFile(arg) then
                vector.append(:String extraObjects if system.fileExists(arg) then paths.absolute(arg) else arg end)
                i := i + 1
            elsif {stringOp.length(arg) > 1} andif {stringOp.getChar(arg 0) is '-'} andif not(stringOp.equal(arg "--"))
                then
                usage("unknown option '" <> arg <> "'")
            elsif compileMode then
                (* compile runs no program, so options may follow its file;
                 * after a --, every argument is a file *)
                if stringOp.equal(arg "--") then
                    for j = {i + 1} upto {extent system.args - 1} do setFile(system.args[j]) end
                    i := extent system.args
                else
                    setFile(arg)
                    i := i + 1
                end
            elsif not(stringOp.equal(arg "--")) andif not(stringOp.equal(arg "-")) andif not(isProgramFile(arg)) then
                (* Options may follow a unit file, which is compiled, not
                 * run *)
                file := arg
                i := i + 1
            else
                (* The arguments after a -- or the program file are the
                 * program's *)
                if not(stringOp.equal(arg "--")) then file := arg end
                for j = {i + 1} upto {extent system.args - 1} do vector.append(:String programArgs system.args[j]) end
                i := extent system.args
            end
        end
        (* Objects given without -o or a phase are linked with the program,
         * which runs compiled *)
        if not(compileMode) andif {vector.length(:String extraObjects) > 0} andif maybe.isNone(:String output)
            andif not(stopGiven) andif vector.empty(:String dumpAfter) then
            stopAfter := "run_c_compiled"
        end
        (* compile neither runs the program nor interprets it *)
        let allowed = fun(phase: String): Bool
            isOneOf(phase phases) andif not(compileMode andif {strutil.startsWith(phase "run_")
                orif stringOp.equal(phase "interpret")})
        if not(allowed(stopAfter)) then usage("unknown phase '" <> stopAfter <> "'") end
        for j = 0 upto {vector.length(:String dumpAfter) - 1} do
            if not(allowed(vector.get(:String dumpAfter j))) then
                usage("unknown phase '" <> vector.get(:String dumpAfter j) <> "'")
            end
        end
        (* codegen_arm64 compiles the program with arm64, unless a backend is
         * given (which must then be arm64, checked once the program's backend
         * is known) *)
        if {stringOp.equal(stopAfter "codegen_arm64") orif isOneOf("codegen_arm64" vector.toArray(:String dumpAfter))}
            andif not(backendGiven) then
            backend := "arm64"
        end
        (* and codegen_c, or compile --emit-c, with C, unless a backend is
         * given; compile's own last phase is codegen_c, which means only
         * that it writes the binary, through any backend *)
        if {{stopGiven andif stringOp.equal(stopAfter "codegen_c")}
            orif isOneOf("codegen_c" vector.toArray(:String dumpAfter)) orif emitC} andif not(backendGiven) then
            backend := "c"
        end
        (* With neither a file nor a program, the REPL starts on an empty
         * program at a terminal; otherwise standard input holds the program,
         * as it does for a file of - *)
        let noProgram = stringOp.equal(file "") andif maybe.isNone(:String code)
        let atTerminal = system.isTerminal(0)
        if kernel andif not(noProgram) then usage("--kernel takes neither FILE nor -e PROGRAM") end
        if compileMode andif noProgram andif atTerminal then usage("compile takes a FILE, -, or -e PROGRAM") end
        let fromStdin = stringOp.equal(file "-") orif {noProgram andif not(interactive) andif not(kernel)
            andif not(atTerminal)}
        let fromFile = not(stringOp.equal(file "")) andif not(fromStdin)
        tuple
            let stopAfter = stopAfter
            (* The program's name, as the bootstrap's diagnostics name it, and
             * as system.args gives it *)
            let file = if maybe.isSome(:String code) then "<string>"
                elsif fromStdin then "<stdin>"
                elsif fromFile then file
                else "<repl>" end
            let fromFile = fromFile
            let fromStdin = fromStdin
            let code = code
            let showOffsets = showOffsets
            let showValues = showValues
            let echo = echo
            let printResult = printResult
            let stopGiven = stopGiven
            let buildDir = buildDir
            let output = output
            let verbose = verbose
            let jobs = jobs
            let wholeProgram = wholeProgram
            let backends = tuple let default = backend let overrides = vector.toArray(:choice.Override unitBackends) end
            let expectedExit = expectedExit
            let dumpAfter = vector.toArray(:String dumpAfter)
            let extraObjects = vector.toArray(:String extraObjects)
            let includePaths = vector.toArray(:String includePaths)
            let interactive = interactive orif {noProgram andif atTerminal}
            let kernel = kernel
            (* A program run, a file's, -e's, or the REPL's inputs, runs on the
             * JIT by default, unless an option asks for the interpreter's
             * phases or output, or for a whole program, or this driver cannot
             * host the JIT (docs/jit.md section 3.10) *)
            let jit = jit orif {not(noJit) andif not(compileMode) andif not(stopGiven)
                andif stringOp.equal(stopAfter "interpret") andif {extent dumpAfter is 0} andif not(showOffsets)
                andif not(showValues) andif not(wholeProgram) andif maybe.isNone(:String session.refusal())}
            let programArgs = vector.toArray(:String programArgs)
            let compileOnly = compileOnly
            let emitC = emitC
            let nogc = nogc
        end
    end;

(* A whole program's modules are one unit, so their abstract types are laid out
 * as their representations are, everywhere (docs/ir.md section 4.1) *)
if options.wholeProgram then shapes.setTransparentAbstractTypes(true) end;

(* The text a reader holds *)
let readAll(r: reader.T): String =
    begin
        let b = stringBuilder.new()
        while reader.more(r) do b.char(reader.getChar(r)) end
        b.toString()
    end;

(* The text of a file *)
let readFile(name: String): String =
    begin
        let r = reader.file(name)
        let text = readAll(r)
        reader.close(r)
        text
    end;

let print(s: String): Ok = begin writer.putString(writer.output s) writer.putString(writer.output "\n") end;

(* Prints a phrase's result in interactive style, unless it shows nothing *)
let printResult(phrase: typedAst.Binding v: model.Value): Ok =
    begin
        let shown = formatting.formatInteractiveResult(phrase v)
        if stringOp.length(shown) > 0 then print(shown) end
    end;

(* The dumps of the phases --dump-after names, and of the one --stop-after
 * does, in phase order. As the bootstrap's driver prints its phases' dumps once
 * its pipeline has run, they follow what the program writes as it runs, but
 * precede an interpreted program's result and a compiled program's output. *)
let pendingDumps = vector.new(:String);
let dump(text: String): Ok = vector.append(:String pendingDumps text);
let flushDumps(): Ok =
    begin
        for i = 0 upto {vector.length(:String pendingDumps) - 1} do print(vector.get(:String pendingDumps i)) end
        vector.clear(:String pendingDumps)
    end;

(* Whether the program goes through the C backend: compiled, with compile or
 * -o, linked with objects, or for a C phase *)
let cPipeline =
    begin
        let var dumpsC = false
        for i = 0 upto {extent options.dumpAfter - 1} do
            if isOneOf(options.dumpAfter[i] cPhases) then dumpsC := true end
        end
        compileMode orif maybe.isSome(:String options.output) orif {extent options.extraObjects > 0}
            orif isOneOf(options.stopAfter cPhases)
            orif dumpsC
    end;

let dumps(phase: String): Bool = isOneOf(phase options.dumpAfter);

(* The backend that compiles the program's own unit *)
let programBackend = choice.forUnit(options.backends choice.programUnit);
if {stringOp.equal(options.stopAfter "codegen_arm64") orif dumps("codegen_arm64")}
    andif not(stringOp.equal(programBackend "arm64")) then
    usage("codegen_arm64 is the arm64 backend's phase, but the program is compiled by " <> programBackend)
end;

let dumpsSsa: Bool =
    begin
        let var any = false
        for i = 0 upto {extent ssaPhases - 1} do if dumps(ssaPhases[i]) then any := true end end
        any
    end;

(* The stage a phase dumps or runs the IR at (the phase's name after its
 * prefix), if it is an IR phase *)
let irStage(prefix: String): maybe.T(String) =
    begin
        let var found = maybe.none(:String)
        for i = 0 upto {extent irStages - 1} do
            if stringOp.equal(options.stopAfter prefix <> irStages[i]) then found := maybe.some(:String irStages[i]) end
        end
        found
    end;

(* The phases the program goes through, as the bootstrap's pipelines have them:
 * the front end's, then either the C backend's (with run_c_compiled unless
 * compile or -o writes a binary), the IR's through the stage run_ir_STAGE runs,
 * the IR's through the last stage dumped or stopped after, or interpret; and of
 * those, the phases through the one --stop-after names *)
let pipeline: Array(String) =
    begin
        let ps = vector.fromArray(:String array of "tokenize" "parse" "desugar" "typecheck" end)
        let irThrough = fun(stage: String): Ok
            begin
                let var i = 0
                let var more = true
                while more andif {i < extent irStages} do
                    vector.append(:String ps "ir_" <> irStages[i])
                    more := not(stringOp.equal(irStages[i] stage))
                    i := i + 1
                end
            end
        let var lastIr = ~1
        for i = 0 upto {extent irStages - 1} do
            if stringOp.equal(options.stopAfter "ir_" <> irStages[i]) orif dumps("ir_" <> irStages[i]) then
                lastIr := i
            end
        end
        if cPipeline then
            irThrough("described")
            vector.append(:String ps "codegen_c")
            (* arm64's code is its assembly, which codegen_c prints too *)
            if stringOp.equal(programBackend "arm64") then vector.append(:String ps "codegen_arm64") end
            if not(compileMode) andif maybe.isNone(:String options.output) then
                vector.append(:String ps "run_c_compiled")
            end
        elsif maybe.isSome(:String irStage("run_ir_")) then
            irThrough(maybe.unwrap(:String irStage("run_ir_")))
            vector.append(:String ps "run_ir_" <> maybe.unwrap(:String irStage("run_ir_")))
        elsif isOneOf(options.stopAfter ssaPhases) orif dumpsSsa then
            (* The SSA of the described IR (docs/ssa.md) *)
            irThrough("described")
            for i = 0 upto {extent ssaPhases - 1} do vector.append(:String ps ssaPhases[i]) end
        elsif lastIr >= 0 then
            irThrough(irStages[lastIr])
        else
            vector.append(:String ps "interpret")
        end
        let through = vector.new(:String)
        let var stopped = false
        for i = 0 upto {vector.length(:String ps) - 1} do
            if not(stopped) then
                vector.append(:String through vector.get(:String ps i))
                stopped := stringOp.equal(vector.get(:String ps i) options.stopAfter)
            end
        end
        vector.toArray(:String through)
    end;

let reaches(phase: String): Bool = isOneOf(phase pipeline);

(* Whether a phase's dump is printed: --dump-after names it, or --stop-after
 * does, and the program goes through it *)
let shows(phase: String): Bool =
    reaches(phase) andif {dumps(phase) orif {options.stopGiven andif stringOp.equal(options.stopAfter phase)}};

(* Reports the diagnostics and exits, with 1 if there are errors, else, for a
 * compiled run, with the status it was expected to exit with *)
let finish(bag: diagbag.T sm: location.SourceMap): Ok =
    begin
        flushDumps()
        diagbag.renderAll(bag sm writer.err)
        writer.flush(writer.output)
        writer.flush(writer.err)
        system.sysexit(if diagbag.hasErrors(bag) then 1
            elsif reaches("run_c_compiled") then options.expectedExit
            else 0 end)
    end;

(* A type-checked program lowered to the IR and taken through the passes to
 * stage, each result verified when QUEST_CHECK_IR=1, and dumped when it is
 * shown *)
let lowered(program: typedAst.Program e: env.T sm: location.SourceMap printResult: Bool stage: String): nodes.Unit =
    begin
        let var unit = lower.lowerProgram(program e maybe.some(:location.SourceMap sm) options.echo printResult)
        (* A whole program is one unit, its modules merged into it, with only
         * the members it can reach *)
        if options.wholeProgram then unit := whole.dropUnreachable(whole.mergeImports(unit e)) end
        let check = fun(u: nodes.Unit at: String): Ok
            begin
                if verify.irChecksEnabled() then verify.checkUnit(u) end
                if shows("ir_" <> at) then dump(printer.formatUnit(u)) end
            end
        check(unit irStages[0])
        let passes = array of
            fun(u: nodes.Unit): nodes.Unit simplify.simplifyUnit(u)
            fun(u: nodes.Unit): nodes.Unit specialize.specializeUnit(u)
            fun(u: nodes.Unit): nodes.Unit closure.closureConvertUnit(u)
            fun(u: nodes.Unit): nodes.Unit represent.representUnit(unbox.unboxUnit(u))
            fun(u: nodes.Unit): nodes.Unit thunks.thunkUnit(describe.describeUnit(u))
        end
        let var i = 1
        while {i < extent irStages} andif not(stringOp.equal(irStages[i - 1] stage)) do
            unit := passes[i - 1](unit)
            check(unit irStages[i])
            i := i + 1
        end
        unit
    end;

(* Lowers the program through the last IR stage it goes through, dumping the
 * stages shown, as the bootstrap's ir_STAGE phases do *)
let lowerOnly(program: typedAst.Program e: env.T sm: location.SourceMap bag: diagbag.T): Ok =
    begin
        let internal = fun(message: String): Ok diagbag.add(bag diagnostics.error(message location.span("" ~1 ~1)))
        let var last = irStages[0]
        for i = 0 upto {extent irStages - 1} do if reaches("ir_" <> irStages[i]) then last := irStages[i] end end
        try
            let unit = lowered(program e sm false last)
            if reaches("ssa_built") then
                let built = ssaPipeline.run(unit fun(name: String u: ssaNodes.Unit): Ok
                    if shows("ssa_" <> name) then dump(ssaPrinter.formatUnit(u)) end)
                if shows("ssa") then
                    let text = ssaPrinter.formatUnit(built)
                    (* The SSA's text reads back as itself (ssa/parser) *)
                    if verify.irChecksEnabled()
                        andif not(stringOp.equal(ssaPrinter.formatUnit(ssaParser.readUnit(text)) text))
                        then
                        internal("ssa: the SSA does not read back as printed")
                    end
                    dump(text)
                end
            end
        when ssaBuild.unsupported with m then internal("ssa: unsupported: " <> m)
        when ssaVerify.verifyError with m then internal(m)
        when ssaParser.readError with m then internal("ssa: " <> m)
        when lower.loweringError with m then internal(m)
        when verify.verifyError with m then internal(m)
        when closure.capturesMutable with m then internal(m)
        when represent.unsupportedConversion with m then internal(m)
        when represent.rejectedConversion with m then internal(m)
        when describe.unsupportedDescriptor with m then internal(m)
        end
    end;

(* Where compile writes the binary, or with --emit-c and no -o, nowhere (the C
 * goes to standard output): -o, else the program's file without its .quest
 * (else with .bin added), else a.out *)
let compileOutput =
    if maybe.isSome(:String options.output) then options.output
    elsif options.emitC then maybe.none(:String)
    elsif options.fromFile then
        maybe.some(:String if strutil.endsWith(options.file ".quest") then
            stringOp.getSub(options.file 0 {stringOp.length(options.file) - 6})
        else options.file <> ".bin" end)
    else maybe.some(:String "a.out")
    end;

(* Running compiled code prints the last phrase's result, as the interpreter
 * does *)
let compiledPrintsResult = options.printResult orif stringOp.equal(options.stopAfter "run_c_compiled");

(* The build directory, which every C phase reuses and builds interface and
 * module artifacts in (docs/build-process.md section 5.2.4) *)
let buildDir = paths.absolute(maybe.unwrapOr(:String options.buildDir ".build"));

(* A program's base name, without its last suffix (Python's Path.stem) *)
let stem(file: String): String =
    begin
        let name = paths.baseName(file)
        let var dot = ~1
        for i = 1 upto {stringOp.length(name) - 1} do if stringOp.getChar(name i) is '.' then dot := i end end
        if dot < 0 then name else stringOp.getSub(name 0 dot) end
    end;

(* The 0-indexed offset of a (1-indexed) line and column of a source, the
 * inverse of location.locate *)
let offsetOf(text: String line: Int column: Int): Int =
    begin
        let starts = vector.new(:Int)
        vector.append(:Int starts 0)
        for i = 0 upto {stringOp.length(text) - 1} do
            if stringOp.getChar(text i) is '\n' then vector.append(:Int starts {i + 1}) end
        end
        let index = if line < 1 then 0 elsif line > vector.length(:Int starts) then
            vector.length(:Int starts) - 1 else line - 1 end
        let offset = vector.get(:Int starts index) + {if column > 1 then column - 1 else 0 end}
        if offset > stringOp.length(text) then stringOp.length(text) else offset end
    end;

(* The frames of a traceback's lines, a run of calls of the same function
 * listed in full *)
let traceOf(lines: vector.T(String) from: Int): Array(String) =
    begin
        let frames = vector.new(:String)
        for i = from upto {vector.length(:String lines) - 1} do
            let line = vector.get(:String lines i)
            if strutil.startsWith(line "  in ") then
                vector.append(:String frames stringOp.getSub(line 5 {stringOp.length(line) - 5}))
            elsif strutil.startsWith(line "  ... ") andif strutil.endsWith(line " more times") then
                (* "  ... F repeated N more times" *)
                let body = stringOp.getSub(line 6 {stringOp.length(line) - 17})
                let at = strutil.rfind(body " repeated ")
                if at >= 0 then
                    let name = stringOp.getSub(body 0 at)
                    let count = strutil.toInt(stringOp.getSub(body {at + 10} {stringOp.length(body) - {at + 10}}))
                    for k = 1 upto count do vector.append(:String frames name) end
                end
            end
        end
        vector.toArray(:String frames)
    end;

let joinLines(lines: vector.T(String) from: Int to: Int): String =
    begin
        let b = stringBuilder.new()
        for i = from upto {to - 1} do
            if i > from then b.char('\n') end
            b.str(vector.get(:String lines i))
        end
        b.toString()
    end;

(* The site a compiled program's error was raised at: "  at FILE:LINE:COLUMN" *)
let raiseSite(line: String): maybe.T(Tuple file: String line: Int column: Int end) =
    begin
        let none = maybe.none(:Tuple file: String line: Int column: Int end)
        if not(strutil.startsWith(line "  at ")) then
            none
        else
            let rest = stringOp.getSub(line 5 {stringOp.length(line) - 5})
            let second = strutil.rfind(rest ":")
            let first = if second > 0 then strutil.rfind(stringOp.getSub(rest 0 second) ":") else ~1 end
            let digits = fun(t: String): Bool
                begin
                    let var all = stringOp.length(t) > 0
                    for i = 0 upto {stringOp.length(t) - 1} do
                        let c = stringOp.getChar(t i)
                        if not(strutil.isDigit(c)) then all := false end
                    end
                    all
                end
            if first <= 0 then
                none
            else
                let lineText = stringOp.getSub(rest {first + 1} {second - {first + 1}})
                let columnText = stringOp.getSub(rest {second + 1} {stringOp.length(rest) - {second + 1}})
                if digits(lineText) andif digits(columnText) then
                    maybe.some(:Tuple file: String line: Int column: Int end tuple
                        let file = stringOp.getSub(rest 0 first)
                        let line = strutil.toInt(lineText) let column = strutil.toInt(columnText)
                    end)
                else
                    none
                end
            end
        end
    end;

(* The diagnostic for the error output of a compiled program
 * (docs/exceptions.md section 2.2): its message, located at the site the
 * program printed, in the program's file or the file the site names, which is
 * read for its source line, with the frames it printed. Without a site, or
 * when the file cannot be read, the diagnostic has no location. *)
let binaryErrorDiagnostic(stderr: String sm: location.SourceMap): diagnostics.Diagnostic =
    begin
        let var text = stderr
        while {stringOp.length(text) > 0} andif {stringOp.getChar(text {stringOp.length(text) - 1}) is '\n'} do
            text := stringOp.getSub(text 0 {stringOp.length(text) - 1})
        end
        let lines = strutil.splitlines(text)
        let var last = vector.length(:String lines)
        while {last > 0} andif {strutil.startsWith(vector.get(:String lines {last - 1}) "  in ")
            orif strutil.startsWith(vector.get(:String lines {last - 1}) "  ... ")} do
            last := last - 1
        end
        let trace = traceOf(lines last)
        let site = if last > 0 then raiseSite(vector.get(:String lines {last - 1}))
            else maybe.none(:Tuple file: String line: Int column: Int end) end
        let nowhere = location.span("" ~1 ~1)
        let d = if maybe.isNone(:Tuple file: String line: Int column: Int end site) then
            diagnostics.error(strutil.strip(joinLines(lines 0 last)) nowhere)
        else
            let at = maybe.unwrap(:Tuple file: String line: Int column: Int end site)
            let message = strutil.strip(joinLines(lines 0 {last - 1}))
            let siteText = if stringOp.equal(at.file location.file(sm)) then maybe.some(:String location.text(sm))
                else paths.readText(at.file) end
            if maybe.isNone(:String siteText) then
                diagnostics.error(message <> "\n  at " <> at.file <> ":" <> conv.int(at.line) <> ":"
                    <> conv.int(at.column)
                    nowhere)
            else
                if not(stringOp.equal(at.file location.file(sm))) then
                    diagnostics.registerSource(location.newSourceMap(at.file maybe.unwrap(:String siteText)))
                end
                let offset = offsetOf(maybe.unwrap(:String siteText) at.line at.column)
                diagnostics.error(message location.span(at.file offset {offset + 1}))
            end
        end
        if extent trace > 0 then diagnostics.setTrace(d trace) end
        d
    end;

(* Writes an error that is not a diagnostic, as the bootstrap's driver does,
 * and exits with 1 *)
let failWith(message: String): Ok =
    begin
        flushDumps()
        writer.flush(writer.output)
        writer.putString(writer.err programName <> ": error: " <> message <> "\n")
        writer.flush(writer.err)
        system.sysexit(1)
    end;

(* The engine that builds the modules a program's C imports *)
let newEngine(e: env.T): engine.T =
    engine.withBackends(engine.parallel(engine.new(maybe.some(:String buildDir) options.includePaths options.verbose
        options.nogc options.extraObjects maybe.some(:graph.Resolver e.units.resolver)) options.jobs system.args[0])
        options.backends);

(* A whole program is one unit, the program's with its modules', which
 * --backend chooses the backend of (docs/arm64.md section 3.12), so a
 * unit of its own has none *)
if options.wholeProgram andif {extent options.backends.overrides > 0} then
    usage("--whole-program compiles one unit, so --unit-backend has none to choose for")
end;

(* A type-checked program's imports, as the engine resolves them *)
let importRefs(program: typedAst.Program): Array(engine.ImportRef) =
    begin
        let refs = vector.new(:engine.ImportRef)
        for i = 0 upto {extent program.phrases - 1} do
            case program.phrases[i].form
                when bindImport with x then
                    for j = 0 upto {extent x.items - 1} do
                        let it = x.items[j]
                        vector.append(:engine.ImportRef refs tuple
                            let interfacePath = typedAst.effectiveInterfacePath(it)
                            let names = it.names
                            let modulePaths = typedAst.effectiveModulePaths(it)
                        end)
                    end
                else ok
            end
        end
        vector.toArray(:engine.ImportRef refs)
    end;

(* The modules a whole program's unit still imports, by canonical name and
 * interface *)
let keptImports(unit: nodes.Unit): Array(passes.ImplicitImport) =
    begin
        let kept = vector.new(:passes.ImplicitImport)
        for i = 0 upto {extent unit.imports - 1} do
            vector.append(:passes.ImplicitImport kept tuple
                let canonicalPath = unit.imports[i].canonicalPath let interfacePath = unit.imports[i].interfacePath
            end)
        end
        vector.toArray(:passes.ImplicitImport kept)
    end;

(* Takes a type-checked program through the C backend, as the bootstrap's
 * codegen_c and run_c_compiled phases (and -o and compile) do: prints its C, or
 * compiles it, with the modules it imports (built by the engine), and runs it
 * or writes it to -o (or compile's output). compile --emit-c writes the C. *)
let compiled(program: typedAst.Program e: env.T sm: location.SourceMap bag: diagbag.T): Ok =
    begin
        let internal = fun(message: String): Ok diagbag.add(bag diagnostics.error(message location.span("" ~1 ~1)))
        let located = fun(message: String): Ok
            diagbag.add(bag diagnostics.error(message location.span(location.file(sm) 0 1)))
        let translated = try
            begin
                let unit = lowered(program e sm compiledPrintsResult "described")
                maybe.some(:Tuple c: String unit: nodes.Unit end
                    tuple let c = cBackend.unitToC(unit maybe.none(:String) programBackend) let unit = unit end)
            end
        when lower.loweringError with m then begin internal(m) maybe.none(:Tuple c: String unit: nodes.Unit end) end
        when verify.verifyError with m then begin internal(m) maybe.none(:Tuple c: String unit: nodes.Unit end) end
        when closure.capturesMutable with m then begin internal(m) maybe.none(:Tuple c: String unit: nodes.Unit end) end
        when represent.unsupportedConversion with m then
            begin internal(m) maybe.none(:Tuple c: String unit: nodes.Unit end) end
        when represent.rejectedConversion with m then
            begin internal(m) maybe.none(:Tuple c: String unit: nodes.Unit end) end
        when describe.unsupportedDescriptor with m then
            begin internal(m) maybe.none(:Tuple c: String unit: nodes.Unit end) end
        when cPrinter.unsupported with m then begin internal(m) maybe.none(:Tuple c: String unit: nodes.Unit end) end
        end
        if maybe.isSome(:Tuple c: String unit: nodes.Unit end translated) then
            let t = maybe.unwrap(:Tuple c: String unit: nodes.Unit end translated)
            if shows("codegen_c") orif shows("codegen_arm64") then dump(t.c) end
            let running = reaches("run_c_compiled")
            let writing = {compileMode orif maybe.isSome(:String options.output)} andif not(options.stopGiven)
                andif not(options.emitC)
            if compileMode andif options.emitC andif not(options.stopGiven) then
                if maybe.isSome(:String compileOutput) then
                    let target = maybe.unwrap(:String compileOutput)
                    try
                        let w = writer.file(target)
                        writer.putString(w t.c)
                        writer.close(w)
                    when writer.error then
                        failWith("error writing '" <> target <> "'")
                    end
                else
                    flushDumps()
                    writer.putString(writer.output t.c)
                end
            elsif running orif writing then
                (* A whole program's modules are in its unit, but for those it
                 * still imports, known only through their interfaces (the
                 * library's, ir/whole), which are built apart *)
                let modules = if options.wholeProgram then
                        engine.unitModuleRefs(array of :engine.ImportRef end keptImports(t.unit)
                            e.currentDir vector.toArray(:String e.includePaths) e.programDir e.units.resolver)
                    else engine.unitModuleRefs(importRefs(program) passes.implicitImports(t.unit program)
                        e.currentDir vector.toArray(:String e.includePaths) e.programDir e.units.resolver)
                    end
                let importer = if strutil.startsWith(options.file "<") then options.file else stem(options.file) end
                try
                    let objects = engine.buildModules(newEngine(e) modules importer e.programDir)
                    if writing then
                        (* An assembled program's line table and debugging
                         * information (docs/arm64.md section 3.16) are in
                         * its object, which is temporary: with -g, clang
                         * copies them into a .dSYM bundle beside the binary,
                         * by dsymutil, where lldb finds them *)
                        let assembly = choice.isAssembly(programBackend)
                        let flags = vector.fromArray(:String cBackend.cFlags(programBackend))
                        if assembly then vector.append(:String flags "-g") end
                        compilerRunner.compileCSource(t.c paths.absolute(maybe.unwrap(:String compileOutput))
                            options.nogc maybe.none(:String) objects vector.toArray(:String flags) assembly)
                    else
                        let binary = compilerRunner.temporaryBinary()
                        compilerRunner.compileCSource(t.c binary false maybe.none(:String) objects
                            cBackend.cFlags(programBackend) choice.isAssembly(programBackend))
                        let r = compilerRunner.runBinary(binary options.programArgs)
                        if system.fileExists(binary) then system.removeFile(binary) end
                        if not(r.code is options.expectedExit) then
                            if stringOp.length(r.stderr) > 0 then
                                diagbag.add(bag binaryErrorDiagnostic(r.stderr sm))
                            else
                                diagbag.add(bag diagnostics.error("Binary exited with code " <> conv.int(r.code)
                                    location.span("" ~1 ~1)))
                            end
                        end
                        let var shown = r.stdout
                        if {stringOp.length(shown) > 0}
                            andif {stringOp.getChar(shown {stringOp.length(shown) - 1}) is '\n'} then
                            shown := stringOp.getSub(shown 0 {stringOp.length(shown) - 1})
                        end
                        (* Its output is run_c_compiled's dump, as the
                         * bootstrap has it, printed when that phase is
                         * stopped after (as linking objects alone does) or
                         * dumped *)
                        flushDumps()
                        if {stringOp.length(shown) > 0} andif {stringOp.equal(options.stopAfter "run_c_compiled")
                            orif dumps("run_c_compiled")} then
                            print(shown)
                        end
                    end
                when diagnostics.compilerError with err then
                    (* Such as a type error in an imported module's body, found
                     * when the module is compiled *)
                    diagbag.add(bag diagnostics.errorDiagnostic(err options.file))
                when engine.buildError with m then
                    if writing then failWith(m) else located(m) end
                when compilerRunner.failure with m then
                    if writing then failWith(m) else located(m) end
                end
            end
        end
    end;

(* The tree-walking interpreter's root frame for a program, with its
 * arguments *)
let runFrame(e: env.T sm: location.SourceMap): model.Frame =
    begin
        let f = treewalk.newRoot(e.units)
        f.root.includePaths := vector.toArray(:String e.includePaths)
        f.root.programDir := e.programDir
        f.currentDir := e.currentDir
        f.sourceMap := maybe.some(:location.SourceMap sm)
        let args = array of({extent options.programArgs + 1} options.file)
        for i = 0 upto {extent options.programArgs - 1} do args[i + 1] := options.programArgs[i] end
        builtins.setSystemArgs(args)
        f
    end;

(* Runs a type-checked program's IR in the IR interpreter, as the bootstrap's
 * run_ir_STAGE phases do: the IR prints the last phrase's result itself (or
 * every phrase's, with --echo) *)
let runIr(program: typedAst.Program e: env.T sm: location.SourceMap bag: diagbag.T stage: String): Ok =
    begin
        let internal = fun(message: String): Ok diagbag.add(bag diagnostics.error(message location.span("" ~1 ~1)))
        try
            let unit = lowered(program e sm true stage)
            let f = runFrame(e sm)
            try
                irInterp.runUnit(unit f)
            when model.runError with err then
                diagbag.add(bag repl.runErrorDiagnostic(err options.file))
            end
        when lower.loweringError with m then internal(m)
        when verify.verifyError with m then internal(m)
        when irInterp.irInterpreterError with m then internal(m)
        when closure.capturesMutable with m then internal(m)
        when represent.unsupportedConversion with m then internal(m)
        when represent.rejectedConversion with m then internal(m)
        when describe.unsupportedDescriptor with m then internal(m)
        end
    end;

(* Runs a type-checked program, as the bootstrap's interpret phase does: the
 * frame the phrases after it would run in, where the REPL continues *)
let interpret(program: typedAst.Program e: env.T sm: location.SourceMap bag: diagbag.T): model.Frame =
    begin
        let f = runFrame(e sm)
        (* The program's phrases run in the outermost frame (docs/exceptions.md
         * section 4) *)
        vector.append(:String f.root.callStack diagnostics.mainFrame)
        try
            let ran = treewalk.evalProgramPhrasesIn(program f fun(r: treewalk.PhraseResult): Ok
                if options.echo then printResult(r.phrase r.value) end)
            let results = ran.results
            flushDumps()
            if not(options.echo) andif {extent results > 0} then
                printResult(results[extent results - 1].phrase results[extent results - 1].value)
            end
            ran.frame
        when model.runError with err then
            treewalk.noteFrames(err f)
            diagbag.add(bag repl.runErrorDiagnostic(err options.file))
            f
        end
    end;

(* Enters the REPL in the program's environment and frame (or with --kernel,
 * serves the kernel's requests), after reporting the program's diagnostics, and
 * exits with its status *)
let interactive(e: env.T f: model.Frame bag: diagbag.T sm: location.SourceMap): Ok =
    begin
        flushDumps()
        writer.flush(writer.output)
        diagbag.renderAll(bag sm writer.err)
        writer.flush(writer.err)
        let r = repl.new(e f)
        system.sysexit(if options.kernel then repl.runKernel(r) else repl.run(r) end)
    end;

(* Runs a program with the JIT (docs/jit.md), as one input, which prints its
 * last phrase's result (or, with --echo, every phrase's) as interpret does; a
 * program that fails to run ends the driver with 1. With -i, the REPL then
 * reads inputs, the program's bindings in scope. *)
let jitRun(program: typedAst.Program e: env.T sm: location.SourceMap bag: diagbag.T): Ok =
    begin
        let args = array of({extent options.programArgs + 1} options.file)
        for i = 0 upto {extent options.programArgs - 1} do args[i + 1] := options.programArgs[i] end
        let r = repl.newJit(e runFrame(e sm) args)
        (* The session's files for a debugger are removed as it ends *)
        let finished = fun(): Ok session.finish(maybe.unwrap(:session.T r.jit))
        if options.fromFile orif options.fromStdin orif maybe.isSome(:String options.code) then
            if not(repl.runInput(r program sm bag options.echo)) then
                finished()
                writer.flush(writer.output)
                diagbag.renderAll(bag maybe.unwrapOr(:location.SourceMap r.errorSource sm) writer.err)
                writer.flush(writer.err)
                system.sysexit(1)
            end
        end
        flushDumps()
        if options.kernel then
            let status = repl.runKernel(r)
            finished()
            system.sysexit(status)
        end
        if options.interactive then
            writer.flush(writer.output)
            diagbag.renderAll(bag sm writer.err)
            writer.flush(writer.err)
            let status = repl.run(r)
            finished()
            system.sysexit(status)
        end
        finished()
    end;

(* Compiles a unit file alone, as the bootstrap's compile_unit_file does *)
let compileUnitFile(): Ok =
    begin
        let bag = diagbag.new()
        let sm = location.newSourceMap(options.file maybe.unwrapOr(:String paths.readText(options.file) ""))
        stdlib.install()
        typecheck.install()
        let includes = array of(extent options.includePaths "")
        for i = 0 upto {extent options.includePaths - 1} do includes[i] := paths.absolute(options.includePaths[i]) end
        let outputDir = if maybe.isSome(:String options.output) then
            maybe.some(:String paths.parent(paths.absolute(maybe.unwrap(:String options.output))))
        else
            maybe.none(:String)
        end
        try
            case units.unitKind(options.file)
                when interfaceUnit then
                    if maybe.isSome(:String outputDir) then system.makeDirectory(maybe.unwrap(:String outputDir)) end
                    headers.compileInterfaceWithHeader(paths.absolute(options.file) outputDir includes options.buildDir
                        maybe.none(:String))
                    ok
                when moduleUnit then
                    if maybe.isSome(:String outputDir) then system.makeDirectory(maybe.unwrap(:String outputDir)) end
                    moduleCompiler.compileModuleFile(paths.absolute(options.file) outputDir includes maybe.none(:String)
                        options.nogc vector.toArray(:String vector.new(:String)) options.buildDir maybe.none(:String)
                        maybe.none(:graph.Resolver) options.backends)
                    ok
                else
                    diagbag.add(bag diagnostics.error("'" <> options.file <> "' is a program, not a unit file"
                        location.span("" ~1 ~1)))
            end
        when diagnostics.compilerError with err then
            diagbag.add(bag diagnostics.errorDiagnostic(err options.file))
        when compilerRunner.failure with m then
            diagbag.add(bag diagnostics.error(m location.span("" ~1 ~1)))
        end
        finish(bag sm)
    end;

(* Runs the program given (a file, -e's, or standard input) through the
 * pipeline's phases, as far as the command line asks (reaches), dumping each
 * phase it shows. Each phase runs only if the ones before it found no errors:
 * the tokenizer's errors stop it before parsing, a syntax error (raised as
 * diagbag.fatalError) at once, and type errors before any backend. A program
 * that type checks then goes to one of: the C or arm64 backend (codegen_c
 * and the phases after it), the IR interpreter (run_ir_STAGE), the IR's
 * dump alone (ir_STAGE), the JIT, or the tree-walking interpreter, which may
 * go on into the REPL. The environment is set up for the backend: compiled
 * code, and the JIT's, know imported modules through their interfaces
 * (unless the whole program is one unit), with the build directory's
 * artifacts (the JIT's in memory without --build-dir). finish prints the
 * diagnostics and exits *)
let run(): Ok =
    begin
        let source = if maybe.isSome(:String options.code) then
            maybe.unwrap(:String options.code)
        elsif options.fromStdin then
            readAll(reader.input)
        elsif options.fromFile then
            readFile(options.file)
        else
            ""
        end
        let sm = location.newSourceMap(options.file source)
        let bag = diagbag.new()
        try
            let toks = tokenizer.tokenizeAll(tokenizer.new(sm bag))
            if not(diagbag.hasErrors(bag)) andif shows("tokenize") then
                dump(tokenizer.formatDump(toks sm options.showValues))
            end
            if not(diagbag.hasErrors(bag)) andif reaches("parse") then
                let program = parser.parseProgram(toks sm bag)
                let show = if options.showOffsets then astprint.dumpWithOffsets else astprint.dump end
                if shows("parse") then dump(show(program)) end
                let desugared = if reaches("desugar") then desugar.program(program) else program end
                if shows("desugar") then dump(show(desugared)) end
                if reaches("typecheck") then
                    stdlib.install()
                    let e = env.new()
                    let dir = if options.fromFile then paths.parent(paths.absolute(options.file))
                        else paths.absolute(".") end
                    e.currentDir := maybe.some(:String dir)
                    e.programDir := maybe.some(:String dir)
                    e.sourceFile := options.file
                    (* The file -i runs, and the REPL's inputs, are interactive
                     * (docs/repl.md section 6) *)
                    e.interactive := options.interactive
                    if cPipeline orif options.jit then
                        (* Compiled to C, or by the JIT, the modules are known
                         * through their interfaces, with the build
                         * directory's artifacts, which is searched first;
                         * the JIT's, unless --build-dir names one, are kept
                         * in memory (docs/jit.md section 3.4.1) *)
                        let artifacts = if options.jit andif maybe.isNone(:String options.buildDir) then memoryFiles.root
                            else buildDir end
                        e.compilingC := not(options.wholeProgram)
                        e.buildDir := maybe.some(:String artifacts)
                        vector.append(:String e.includePaths artifacts)
                    end
                    for i = 0 upto {extent options.includePaths - 1} do
                        vector.append(:String e.includePaths options.includePaths[i])
                    end
                    (* The modules of prebuilt objects are known through their
                     * interfaces alone, by their canonical names and their
                     * base names *)
                    for i = 0 upto {extent options.extraObjects - 1} do
                        let o = options.extraObjects[i]
                        let byPath = graph.unit(e.units option moduleUnit of units.UnitKind end
                            paths.canonicalizeModulePath(o options.includePaths maybe.none(:String)))
                        byPath.precompiled := true
                        let byName = graph.unit(e.units option moduleUnit of units.UnitKind end
                            vector.get(:String strutil.split(paths.baseName(o) ".") 0))
                        byName.precompiled := true
                    end
                    let result = typecheck.elaborateProgram(desugared e)
                    for i = 0 upto {extent result.errors - 1} do
                        diagbag.add(bag diagnostics.errorDiagnostic(result.errors[i] options.file))
                    end
                    for i = 0 upto {extent result.warnings - 1} do
                        diagbag.add(bag diagnostics.warningDiagnostic(result.warnings[i] options.file))
                    end
                    if maybe.isSome(:typedAst.Program result.program) then
                        let typed = maybe.unwrap(:typedAst.Program result.program)
                        if shows("typecheck") then dump(typedAstPrint.dumpProgram(typed)) end
                        if diagbag.hasErrors(bag) then
                            ok
                        elsif reaches("codegen_c") then
                            compiled(typed e sm bag)
                        elsif maybe.isSome(:String irStage("run_ir_")) andif reaches(options.stopAfter) then
                            runIr(typed e sm bag maybe.unwrap(:String irStage("run_ir_")))
                        elsif reaches("ir_core") then
                            lowerOnly(typed e sm bag)
                        elsif reaches("interpret") andif options.jit then
                            jitRun(typed e sm bag)
                        elsif reaches("interpret") then
                            let f = interpret(typed e sm bag)
                            if {options.interactive orif options.kernel} andif not(diagbag.hasErrors(bag)) then
                                interactive(e f bag sm)
                            end
                        end
                    end
                end
            end
        when diagbag.fatalError then
            ok
        end
        finish(bag sm)
    end;

(* Builds the program with the build engine, as -o and compile do: its modules
 * compiled separately, each only if stale. With compile -c, the program is
 * compiled into the build directory but not linked. *)
let buildProgram(): Ok =
    begin
        let bag = diagbag.new()
        let sm = location.newSourceMap(options.file maybe.unwrapOr(:String paths.readText(options.file) ""))
        stdlib.install()
        try
            let eng = engine.withBackends(engine.parallel(engine.new(options.buildDir options.includePaths options.verbose
                options.nogc options.extraObjects maybe.none(:graph.Resolver)) options.jobs system.args[0]) options.backends)
            if compileMode andif options.compileOnly then engine.compileMain(eng options.file)
            else engine.buildMain(eng options.file compileOutput) end
        when diagnostics.compilerError with err then
            diagbag.add(bag diagnostics.errorDiagnostic(err options.file))
        when engine.buildError with m then
            failWith(m)
        when compilerRunner.failure with m then
            failWith(m)
        end
        finish(bag sm)
    end;

(* A worker of a parallel build compiles one module (build/workers). A
 * program goes to the build engine when it is to be built into a binary
 * (compile, or -o) and nothing asks for another path: no whole program, no
 * phase or dump, no --echo, no compile --emit-c or --print-result, and a file
 * rather than -e or standard input; anything else is run. A unit file is
 * compiled alone unless a phase or -e asks for it to be run *)
if workers.isUnitMode(system.args) then
    workers.unitMain(system.args)
else
    case units.unitKind(options.file)
        when programUnit then
            if {compileMode orif maybe.isSome(:String options.output)} andif not(options.wholeProgram)
                andif not(options.stopGiven) andif {extent options.dumpAfter is 0} andif not(options.echo)
                andif not(compileMode andif {options.emitC orif options.printResult}) andif options.fromFile then
                buildProgram()
            else
                run()
            end
        else if options.stopGiven orif maybe.isSome(:String options.code) then run() else compileUnitFile() end
    end
end;
