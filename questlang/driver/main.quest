(* Quest Self-Hosted Compiler: Driver
 *
 * Entry point for the `quest` command: it runs a program, prints a compiler
 * phase's output, compiles a single unit file, builds a binary, or enters the
 * REPL (usageText lists all forms and options; the bootstrap counterpart is
 * bootstrap/python/quest/driver/main.py).
 *
 * Running a program (FILE, -e PROGRAM, or - for standard input): the program
 * is compiled and run by the JIT (questlang/jit), or by the tree-walking
 * interpreter when --no-jit is passed, an interpreter-only option (such as
 * --stop-after) is given, or this driver cannot host the JIT. It prints the
 * last top-level phrase's result, or every phrase's with --echo. Arguments
 * after FILE, or after --, become the program's system.args. With neither FILE
 * nor -e, the REPL (questlang/driver/repl) starts on a terminal, and otherwise
 * standard input is run as a program; -i enters the REPL after running FILE,
 * preserving its environment and runtime frame.
 *
 * Phases (--stop-after PHASE, --dump-after PHASE): the driver runs the
 * pipeline through PHASE and prints its output on standard output (tokenize,
 * parse, desugar, and typecheck in the bootstrap's format; the IR at a stage,
 * printed or interpreted; SSA after a pass; generated C, arm64 assembly, or
 * WebAssembly text; or the compiled program's output), with diagnostics on
 * standard error, exiting with 1 on error. run_tests.py --self-hosted checks
 * these outputs against the bootstrap's goldens (docs/testing.md section 2.3).
 *
 * Unit files (.int.quest, .mod.quest): given without a phase or -e, a unit
 * file is compiled on its own (compileUnitFile; -c is optional). An interface
 * produces a compiled interface (.qi) and C header, and a module produces its
 * backend code, object file, and module metadata (.qm), placed beside -o,
 * under --build-dir, or beside the source file.
 *
 * Building (quest compile FILE, or a program with -o): the build engine
 * (questlang/build) compiles the program and its imported modules separately,
 * rebuilding only stale units, and links a binary (named FILE without .quest,
 * or -o's value); -c compiles without linking. Both `compile --emit-c` (which
 * writes C to -o or standard output) and --whole-program (which merges the
 * program and its modules into one unit) bypass the build engine. Object files
 * on the command line are linked with the program, which then runs compiled
 * (run_c_compiled) unless a phase or -o is given.
 *
 * Parallel build workers also invoke this same executable with a worker
 * command line (build/workers). *)

import
    conv : Conv
    dynamic : Dynamic
    (* Unused here: imported so that the driver links them, as it links the
     * rest of lib/, for the JIT's inputs to import (docs/jit.md section 3.4) *)
    list : List
    reader : Reader
    stringOp = string : StringOp
    system : System
    writer : Writer

    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/argparse : util/ArgParse
    util/maybe : util/Maybe
    util/stringBuilder : util/StringBuilder
    util/strutil : util/Strutil

    questlang/build/compilerRunner : questlang/build/CompilerRunner
    questlang/build/engine : questlang/build/Engine
    questlang/build/interfaceHeaders : questlang/build/InterfaceHeaders
    questlang/build/moduleCompiler : questlang/build/ModuleCompiler
    questlang/build/workers : questlang/build/Workers
    cBackend = questlang/codegen/backend : questlang/codegen/Backend
    questlang/codegen/choice : questlang/codegen/Choice
    questlang/common/diagbag : questlang/common/DiagBag
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/files : questlang/common/Files
    questlang/common/location : questlang/common/Location
    questlang/common/memoryFiles : questlang/common/MemoryFiles
    questlang/common/strings : questlang/common/Strings
    questlang/driver/binaryErrors : questlang/driver/BinaryErrors
    questlang/driver/kernel : questlang/driver/Kernel
    commandLine = questlang/driver/options : questlang/driver/Options
    questlang/driver/repl : questlang/driver/REPL
    ssaDumps = questlang/driver/ssaPhases : questlang/driver/SSAPhases
    questlang/driver/wasmBundle : questlang/driver/WasmBundle
    questlang/driver/whole : questlang/driver/Whole
    questlang/format/format : questlang/format/Format
    questlang/interpreter/builtins : questlang/interpreter/Builtins
    questlang/interpreter/formatting : questlang/interpreter/Formatting
    questlang/interpreter/irInterp : questlang/interpreter/IRInterp
    questlang/interpreter/treewalk : questlang/interpreter/Treewalk
    questlang/ir/lower : questlang/ir/Lower
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/opened : questlang/ir/Opened
    passes = questlang/ir/pipeline : questlang/ir/Pipeline
    questlang/ir/printer : questlang/ir/Printer
    questlang/ir/stages : questlang/ir/Stages
    questlang/ir/verify : questlang/ir/Verify
    questlang/jit/session : questlang/jit/Session
    questlang/lsp/server : questlang/lsp/Server
    questlang/modules/graph : questlang/modules/Graph
    questlang/modules/inlined : questlang/modules/Inlined
    questlang/modules/paths : questlang/modules/Paths
    questlang/modules/resolution : questlang/modules/Resolution
    questlang/modules/stdlib : questlang/modules/Stdlib
    questlang/modules/units : questlang/modules/Units
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/syntax/astprint : questlang/syntax/ASTPrint
    questlang/syntax/desugar : questlang/syntax/Desugar
    questlang/syntax/parser : questlang/syntax/Parser
    questlang/syntax/tokenizer : questlang/syntax/Tokenizer
    questlang/typechecker/application : questlang/typechecker/Application
    questlang/typechecker/typecheck : questlang/typechecker/Typecheck
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/typechecker/typedAstPrint : questlang/typechecker/TypedASTPrint
    questlang/types/env : questlang/types/Env
    questlang/values/model : questlang/values/Model
    questlang/wasm/encode : questlang/wasm/Encode
    wasmRuntime = questlang/wasm/runtime : questlang/wasm/Runtime

(* The command line (driver/options) *)
let options = commandLine.options
let compileMode = commandLine.compileMode
let programName = commandLine.programName
let irStages = commandLine.irStages
let phases = commandLine.phases
let ssaPhases = commandLine.ssaPhases
let backendPhases = commandLine.backendPhases
let isOneOf = strings.isOneOf
let usage(message: String): Ok = commandLine.usage(message)

(* The settings of a compilation, made before any unit is checked: a whole
 * program's modules are one unit, so their abstract types are laid out as
 * their representations are, everywhere (docs/ir.md section 4.1); and the
 * modules inlined into their importers (ir/opened) *)
let programSettings(): Ok =
    begin
        if options.wholeProgram then shapes.setTransparentAbstractTypes(true) end
        inlined.setInlined(options.inlineLibrary options.inlineModules)
    end

(* The text a reader holds *)
let readAll(r: reader.T): String =
    begin
        let b = stringBuilder.new()
        while reader.more(r) do stringBuilder.char(b reader.getChar(r)) end
        stringBuilder.toString(b)
    end

(* The text of a file *)
let readFile(name: String): String =
    begin
        let r = reader.file(name)
        let text = readAll(r)
        reader.close(r)
        text
    end

let print(s: String): Ok = begin writer.putString(writer.output s) writer.putString(writer.output "\n") end

(* Prints a phrase's result in interactive style, unless it shows nothing *)
let printResult(phrase: typedAst.Binding v: model.Value): Ok =
    begin
        let shown = formatting.formatInteractiveResult(phrase v)
        if stringOp.length(shown) > 0 then print(shown) end
    end

(* Buffers phase dumps requested by --dump-after and --stop-after in phase
 * order. Matching the bootstrap driver, dumps are printed after the pipeline
 * finishes, so they follow any output the program wrote while running but
 * precede an interpreted program's result or a compiled program's output. *)
let pendingDumps = vector.new(:String)
let dump(text: String): Ok = vector.append(pendingDumps text)
let flushDumps(): Ok =
    begin
        for i = 0 upto {vector.length(pendingDumps) - 1} do print(vector.get(pendingDumps i)) end
        vector.clear(pendingDumps)
    end

(* Whether the program goes through a compiled backend (C, ssac, arm64, or
 * wasm): via `compile`, -o, linked object files, or a backend phase *)
let compiledPipeline =
    begin
        let var dumpsC = false
        for i = 0 upto {extent options.dumpAfter - 1} do
            if isOneOf(options.dumpAfter[i] backendPhases) then dumpsC := true end
        end
        compileMode orif maybe.isSome(options.output) orif {extent options.extraObjects > 0}
            orif isOneOf(options.stopAfter backendPhases)
            orif dumpsC
    end

let dumps(phase: String): Bool = isOneOf(phase options.dumpAfter)

(* The backend that compiles the program's own unit *)
let programBackend = choice.forUnit(options.backends choice.programUnit)
if {stringOp.equal(options.stopAfter "codegen_arm64") orif dumps("codegen_arm64")}
        andif not(stringOp.equal(programBackend "arm64")) then
    usage("codegen_arm64 is the arm64 backend's phase, but the program is compiled by " <> programBackend)
end
if {stringOp.equal(options.stopAfter "codegen_wasm") orif dumps("codegen_wasm")}
        andif not(choice.isWasm(programBackend)) then
    usage("codegen_wasm is the wasm backend's phase, but the program is compiled by " <> programBackend)
end

let dumpsSsa: Bool =
    begin
        let var any = false
        for i = 0 upto {extent ssaPhases - 1} do if dumps(ssaPhases[i]) then any := true end end
        any
    end

(* The stage a phase dumps or runs the IR at (the phase's name after its
 * prefix), if it is an IR phase *)
let irStage(prefix: String): maybe.T(String) =
    begin
        let var found = maybe.none(:String)
        for i = 0 upto {extent irStages - 1} do
            if stringOp.equal(options.stopAfter prefix <> irStages[i]) then found := maybe.some(irStages[i]) end
        end
        found
    end

(* The sequence of phases the program runs through, matching the bootstrap's
 * pipelines: the front end (tokenize through typecheck), then one of the
 * compiled backend pipeline (ending in run_c_compiled unless compile or -o
 * writes a binary), the IR pipeline through run_ir_STAGE, the SSA pipeline,
 * the IR pipeline through the last dumped or stopped stage, or interpret. The
 * list is truncated after the phase named by --stop-after. *)
let pipeline: Array(String) =
    begin
        let ps = vector.fromArray(array of "tokenize" "parse" "desugar" "typecheck" end)
        let irThrough = fun(stage: String): Ok
            begin
                let var i = 0
                let var more = true
                while more andif {i < extent irStages} do
                    vector.append(ps "ir_" <> irStages[i])
                    more := not(stringOp.equal(irStages[i] stage))
                    i := i + 1
                end
            end
        let var lastIr = ~1
        for i = 0 upto {extent irStages - 1} do
            if stringOp.equal(options.stopAfter "ir_" <> irStages[i]) orif dumps("ir_" <> irStages[i]) then
                lastIr := i
            end
        end
        if compiledPipeline then
            irThrough("described")
            vector.append(ps "codegen_c")
            (* arm64's code is its assembly, which codegen_c prints too *)
            if stringOp.equal(programBackend "arm64") then vector.append(ps "codegen_arm64") end
            (* and wasm's its module's text *)
            if choice.isWasm(programBackend) then vector.append(ps "codegen_wasm") end
            if not(compileMode) andif maybe.isNone(options.output) then
                vector.append(ps "run_c_compiled")
            end
        elsif maybe.isSome(irStage("run_ir_")) then
            irThrough(maybe.unwrap(irStage("run_ir_")))
            vector.append(ps "run_ir_" <> maybe.unwrap(irStage("run_ir_")))
        elsif isOneOf(options.stopAfter ssaPhases) orif dumpsSsa then
            (* The SSA of the described IR (docs/ssa.md) *)
            irThrough("described")
            for i = 0 upto {extent ssaPhases - 1} do vector.append(ps ssaPhases[i]) end
        elsif lastIr >= 0 then
            irThrough(irStages[lastIr])
        else
            vector.append(ps "interpret")
        end
        let through = vector.new(:String)
        let var stopped = false
        for i = 0 upto {vector.length(ps) - 1} do
            if not(stopped) then
                vector.append(through vector.get(ps i))
                stopped := stringOp.equal(vector.get(ps i) options.stopAfter)
            end
        end
        vector.toArray(through)
    end

let reaches(phase: String): Bool = isOneOf(phase pipeline)

(* Whether a phase's dump is printed: --dump-after names it, or --stop-after
 * does, and the program goes through it *)
let shows(phase: String): Bool =
    reaches(phase) andif {dumps(phase) orif {options.stopGiven andif stringOp.equal(options.stopAfter phase)}}

(* Reports the diagnostics and exits, with 1 if there are errors, else, for a
 * compiled run, with the status it was expected to exit with *)
let finish(bag: diagbag.T sm: location.SourceMap): Ok =
    begin
        flushDumps()
        diagbag.renderAll(bag sm writer.err)
        writer.flush(writer.output)
        writer.flush(writer.err)
        system.sysexit(if diagbag.hasErrors(bag) then 1
            elsif reaches("run_c_compiled") then options.expectedExit
            else 0 end)
    end

(* A type-checked program lowered to the IR and taken through the passes to
 * stage, each result verified when QUEST_CHECK_IR=1, and dumped when it is
 * shown *)
let lowered(program: typedAst.Program e: env.T sm: location.SourceMap printResult: Bool stage: String): nodes.Unit =
    begin
        let var unit = lower.lowerProgram(program e maybe.some(sm) options.echo printResult)
        (* A whole program is one unit, its modules merged into it, with only
         * the members it can reach *)
        if options.wholeProgram then
            unit := whole.dropUnreachable(whole.mergeImports(unit e options.apart))
        else
            (* Compiled separately, with copies of the inlined modules it
             * imports (ir/opened) *)
            unit := opened.openImports(unit e)
        end
        let var last = stages.core
        for i = 0 upto {extent stages.all - 1} do
            if stringOp.equal(stages.name(stages.all[i]) stage) then last := stages.all[i] end
        end
        passes.runThrough(unit last choice.referencesAlike(programBackend) fun(u: nodes.Unit s: stages.Stage): Ok
            begin
                if verify.irChecksEnabled() then verify.checkUnit(u) end
                if shows("ir_" <> stages.name(s)) then dump(printer.formatUnit(u)) end
            end)
    end

(* An internal error: the compiler's own failure, not the program's, which has
 * no location in it *)
let internalError(bag: diagbag.T message: String): Ok =
    diagbag.add(bag diagnostics.error(message location.span("" ~1 ~1)))

(* Runs body and catches internal compiler exceptions from lowering, IR passes,
 * the IR interpreter, or the backend, recording each as an internal error in
 * bag and returning failed *)
let reportingInternal(A::TYPE bag: diagbag.T failed: A body: All() A): A =
    begin
        let internal = fun(message: String): A begin internalError(bag message) failed end
        try
            body()
        when nodes.irError with m then internal(m)
        when irInterp.irInterpreterError with m then internal(m)
        when cBackend.unsupported with m then internal(m)
        end
    end

(* Lowers the program through the last requested IR stage (and runs SSA passes
 * if requested), dumping each shown stage as the bootstrap's ir_STAGE phases
 * do *)
let lowerOnly(program: typedAst.Program e: env.T sm: location.SourceMap bag: diagbag.T): Ok =
    begin
        let var last = irStages[0]
        for i = 0 upto {extent irStages - 1} do if reaches("ir_" <> irStages[i]) then last := irStages[i] end end
        reportingInternal(bag ok fun(): Ok
            begin
                let unit = lowered(program e sm false last)
                if reaches("ssa_built") then
                    (* driver/ssaphases, which a driver compiled to WebAssembly
                     * leaves out *)
                    let failure = ssaDumps.run(unit programBackend shows dump verify.irChecksEnabled())
                    if not(stringOp.isEmpty(failure)) then internalError(bag failure) end
                end
            end)
    end

(* Where compile writes the binary, or with --emit-c and no -o, nowhere (the C
 * goes to standard output): -o, else the program's file without its .quest
 * (else with .bin added), else a.out *)
let compileOutput =
    if maybe.isSome(options.output) then options.output
    elsif options.emitC then maybe.none(:String)
    elsif options.fromFile then
        maybe.some(if strutil.endsWith(options.file ".quest") then
            stringOp.getSub(options.file 0 {stringOp.length(options.file) - 6})
        else
            options.file <> ".bin"
        end)
    else maybe.some("a.out")
    end

(* Running compiled code prints the last phrase's result, as the interpreter
 * does *)
let compiledPrintsResult = options.printResult orif stringOp.equal(options.stopAfter "run_c_compiled")

(* The build directory, which every C phase reuses and builds interface and
 * module artifacts in (docs/build-process.md section 5.2.4) *)
let buildDir = files.absolute(maybe.unwrapOr(options.buildDir ".build"))

(* Writes an error that is not a diagnostic, as the bootstrap's driver does,
 * and exits with 1 *)
let failWith(message: String): Ok =
    begin
        flushDumps()
        writer.flush(writer.output)
        writer.putString(writer.err programName <> ": error: " <> message <> "\n")
        writer.flush(writer.err)
        system.sysexit(1)
    end

(* The build engine's settings, from the command line: each engine builds in
 * dir with includes, resolving with resolver *)
let engineSettings(dir: maybe.T(String) includes: Array(String)
        resolver: maybe.T(resolution.Resolver)): engine.Settings =
    tuple
        let buildDir = dir
        let includePaths = includes
        let verbose = options.verbose
        let nogc = options.nogc
        let extraObjects = options.extraObjects
        let resolver = resolver
        let jobs = options.jobs
        let driver = system.args[0]
        let backends = options.backends
        let reportInferable = options.reportInferable
    end

(* The engine that builds the modules a program's C imports *)
let newEngine(e: env.T): engine.T =
    engine.new(engineSettings(maybe.some(buildDir) options.includePaths maybe.some(e.units.resolver)))

(* Whole-program compilation merges all modules into one unit compiled by
 * --backend (docs/arm64.md section 3.12), so per-unit --unit-backend overrides
 * are rejected *)
if options.wholeProgram andif {extent options.backends.overrides > 0} then
    usage("--whole-program compiles one unit, so --unit-backend has none to choose for")
end

(* A type-checked program's imports, as the engine resolves them *)
let importRefs(program: typedAst.Program): Array(engine.ImportRef) =
    begin
        let refs = vector.new(:engine.ImportRef)
        for i = 0 upto {extent program.phrases - 1} do
            case program.phrases[i].form
                when bindImport with x then
                    for j = 0 upto {extent x.items - 1} do
                        let it = x.items[j]
                        vector.append(refs tuple
                            let interfacePath = typedAst.effectiveInterfacePath(it)
                            let names = it.names
                            let modulePaths = typedAst.effectiveModulePaths(it)
                        end)
                    end
                else ok
            end
        end
        vector.toArray(refs)
    end

(* The modules a whole program's unit still imports, by canonical name and
 * interface *)
let keptImports(unit: nodes.Unit): Array(passes.ImplicitImport) =
    begin
        let kept = vector.new(:passes.ImplicitImport)
        for i = 0 upto {extent unit.imports - 1} do
            vector.append(kept tuple
                let canonicalPath = unit.imports[i].canonicalPath
                let interfacePath = unit.imports[i].interfacePath
            end)
        end
        vector.toArray(kept)
    end

(* The program's name as the importer of the modules the build engine builds
 * for it, which its conformance errors name: the program's file without its
 * extension, or a name like <stdin> as it is *)
let importer = if strutil.startsWith(options.file "<") then options.file else files.stem(options.file) end

(* Compiled backend execution: takes a type-checked program through the
 * selected backend (C, ssac, arm64, or wasm), matching the bootstrap's
 * codegen_c and run_c_compiled phases as well as -o and `compile`. It prints
 * generated code, writes a binary or wasm bundle, or runs the compiled
 * program, building imported modules with the build engine. *)
let compiled(program: typedAst.Program e: env.T sm: location.SourceMap bag: diagbag.T): Ok =
    begin
        let located = fun(message: String): Ok
            diagbag.add(bag diagnostics.error(message location.span(location.file(sm) 0 1)))
        Let Translated = maybe.T(Tuple code: String unit: nodes.Unit end)
        let translated = reportingInternal(bag maybe.none(:Tuple code: String unit: nodes.Unit end)
                fun(): Translated
                    begin
                        let unit = lowered(program e sm compiledPrintsResult "described")
                        maybe.some(tuple
                            let code = cBackend.codeOfUnit(unit maybe.none(:String) programBackend)
                            let unit = unit
                        end)
                    end)
        if maybe.isSome(translated) then
            let t = maybe.unwrap(translated)
            if shows("codegen_c") orif shows("codegen_arm64") then dump(t.code) end
            if shows("codegen_wasm") then dump(cBackend.wasmText(t.unit)) end
            let running = reaches("run_c_compiled")
            let writing = {compileMode orif maybe.isSome(options.output)} andif not(options.stopGiven)
                andif not(options.emitC)
            (* A compiled run's result: an unexpected exit code turns stderr
             * into a diagnostic, and stdout is printed when run_c_compiled is
             * stopped after (including when linking extra objects) or
             * dumped *)
            let finishRun = fun(r: Tuple code: Int stdout: String stderr: String end): Ok
                begin
                    if not(r.code is options.expectedExit) then
                        if stringOp.length(r.stderr) > 0 then
                            diagbag.add(bag binaryErrors.binaryErrorDiagnostic(r.stderr sm))
                        else
                            diagbag.add(bag diagnostics.error("Binary exited with code " <> conv.int(r.code)
                                    location.span("" ~1 ~1)))
                        end
                    end
                    let var shown = r.stdout
                    if {stringOp.length(shown) > 0}
                            andif {stringOp.getChar(shown {stringOp.length(shown) - 1}) is '\n'} then
                        shown := stringOp.getSub(shown 0 {stringOp.length(shown) - 1})
                    end
                    flushDumps()
                    if {stringOp.length(shown) > 0} andif {stringOp.equal(options.stopAfter "run_c_compiled")
                            orif dumps("run_c_compiled")} then
                        print(shown)
                    end
                end
            if compileMode andif options.emitC andif not(options.stopGiven) then
                if maybe.isSome(compileOutput) then
                    let target = maybe.unwrap(compileOutput)
                    try
                        let w = writer.file(target)
                        writer.putString(w t.code)
                        writer.close(w)
                    when writer.error then
                        failWith("error writing '" <> target <> "'")
                    end
                else
                    flushDumps()
                    writer.putString(writer.output t.code)
                end
            elsif choice.isWasm(programBackend) andif {running orif writing} then
                (* Builds and runs or writes the WebAssembly bundle
                 * (driver/wasmBundle): the program's module, the runtime
                 * module, and every imported unit (including standard library
                 * modules), each built as its .o artifact in buildDir *)
                let runtimeBytes = encode.encode(wasmRuntime.runtimeModule())
                try
                    (* Include runtime/ so the build engine finds the Quest
                     * runtime modules (wasm/core, wasm/print; section 4.5)
                     * that any wasm-compiled unit may import *)
                    let runtimeRoot = files.join(paths.projectDir() "runtime")
                    let includes = vector.copy(e.includePaths)
                    let implicit = vector.new(:passes.ImplicitImport)
                    let found = passes.implicitImports(t.unit program)
                    for k = 0 upto extent found - 1 do vector.append(implicit found[k]) end
                    vector.append(implicit
                            tuple let canonicalPath = "wasm/print" let interfacePath = "wasm/Print" end)
                    (* The wasm backend lowers real math functions and ^^ to
                     * calls in util/realmath (section 4.3) *)
                    vector.append(implicit
                            tuple let canonicalPath = "util/realmath" let interfacePath = "util/RealMath" end)
                    let modules = engine.unitModuleRefs(importRefs(program) vector.toArray(implicit)
                            e.currentDir vector.toArray(includes) e.programDir e.units.resolver)
                    let engineIncludes = array of(extent options.includePaths + 1 runtimeRoot)
                    for k = 0 upto extent options.includePaths - 1 do engineIncludes[k] := options.includePaths[k] end
                    let wasmEngine = engine.new(engineSettings(maybe.some(buildDir) engineIncludes
                            maybe.some(e.units.resolver)))
                    let objects = engine.buildModules(wasmEngine modules importer e.programDir)
                    let units = wasmBundle.ordered(objects buildDir)
                    if writing then
                        wasmBundle.write(files.absolute(maybe.unwrap(compileOutput)) t.code runtimeBytes units)
                    else
                        let base = compilerRunner.temporaryBinary()
                        let program = base <> ".wasm"
                        let runtimePath = base <> ".runtime.wasm"
                        let save = fun(path: String contents: String): Ok
                            begin
                                let w = writer.file(path)
                                writer.putString(w contents)
                                writer.close(w)
                            end
                        save(program t.code)
                        save(runtimePath runtimeBytes)
                        let r = wasmBundle.asRun(system.run(wasmBundle.command(options.wasmEngine program
                                wasmRuntime.name runtimePath units options.programArgs)))
                        if system.fileExists(base) then system.removeFile(base) end
                        if system.fileExists(program) then system.removeFile(program) end
                        if system.fileExists(runtimePath) then system.removeFile(runtimePath) end
                        if options.runWasm then
                            (* as the program ran: its output, and its status *)
                            writer.putString(writer.output r.stdout)
                            writer.putString(writer.err r.stderr)
                            writer.flush(writer.output)
                            writer.flush(writer.err)
                            system.sysexit(r.code)
                        end
                        finishRun(r)
                    end
                when writer.error then failWith("error writing the program's WebAssembly modules")
                when diagnostics.compilerError with err then
                    diagbag.add(bag diagnostics.errorDiagnostic(err options.file))
                when engine.buildError with m then located(m)
                end
            elsif running orif writing then
                (* In whole-program mode, source modules are already merged
                 * into t.unit; only precompiled modules known solely through
                 * their interfaces (such as the standard library; see
                 * driver/whole) remain to be built separately *)
                let modules =
                    if options.wholeProgram then
                        engine.unitModuleRefs(array of :engine.ImportRef end keptImports(t.unit)
                                e.currentDir vector.toArray(e.includePaths) e.programDir e.units.resolver)
                    else
                        engine.unitModuleRefs(importRefs(program) passes.implicitImports(t.unit program)
                                e.currentDir vector.toArray(e.includePaths) e.programDir e.units.resolver)
                    end
                try
                    let objects = engine.buildModules(newEngine(e) modules importer e.programDir)
                    if writing then
                        (* An assembled program's line table and debugging
                         * information (docs/arm64.md section 3.16) are in
                         * its object, which is temporary: with -g, clang
                         * copies them into a .dSYM bundle beside the binary,
                         * by dsymutil, where lldb finds them *)
                        let assembly = choice.isAssembly(programBackend)
                        let flags = vector.fromArray(cBackend.cFlags(programBackend))
                        if assembly then vector.append(flags "-g") end
                        compilerRunner.buildExecutable(t.code files.absolute(maybe.unwrap(compileOutput))
                                options.nogc maybe.none() objects vector.toArray(flags) assembly)
                    else
                        let binary = compilerRunner.temporaryBinary()
                        compilerRunner.buildExecutable(t.code binary false maybe.none() objects
                                cBackend.cFlags(programBackend) choice.isAssembly(programBackend))
                        let r = compilerRunner.runBinary(binary options.programArgs)
                        if system.fileExists(binary) then system.removeFile(binary) end
                        finishRun(r)
                    end
                when diagnostics.compilerError with err then
                    (* Such as a type error in an imported module's body, found
                     * when the module is compiled *)
                    diagbag.add(bag diagnostics.errorDiagnostic(err options.file))
                when engine.buildError with m then
                    if writing then failWith(m) else located(m) end
                when compilerRunner.failure with m then
                    if writing then failWith(m) else located(m) end
                end
            end
        end
    end

(* The arguments a program run here sees (system.args): its file's name, then
 * its own *)
let systemArgs =
    begin
        let args = array of({extent options.programArgs + 1} options.file)
        for i = 0 upto {extent options.programArgs - 1} do args[i + 1] := options.programArgs[i] end
        args
    end

(* The tree-walking interpreter's root frame for a program, with its
 * arguments *)
let runFrame(e: env.T sm: location.SourceMap): model.Frame =
    begin
        let f = treewalk.newRoot(e.units)
        f.root.includePaths := vector.toArray(e.includePaths)
        f.root.programDir := e.programDir
        f.currentDir := e.currentDir
        f.sourceMap := maybe.some(sm)
        builtins.setSystemArgs(systemArgs)
        f
    end

(* Runs a type-checked program's IR in the IR interpreter, as the bootstrap's
 * run_ir_STAGE phases do: the IR prints the last phrase's result itself (or
 * every phrase's, with --echo) *)
let runIr(program: typedAst.Program e: env.T sm: location.SourceMap bag: diagbag.T stage: String): Ok =
    begin
        reportingInternal(bag ok fun(): Ok
            begin
                let unit = lowered(program e sm true stage)
                let f = runFrame(e sm)
                try
                    irInterp.runUnit(unit f)
                when model.runError with err then
                    diagbag.add(bag repl.runErrorDiagnostic(err options.file))
                end
            end)
    end

(* Runs a type-checked program in the tree-walking interpreter, matching the
 * bootstrap's interpret phase. Returns the resulting frame so -i can continue
 * the REPL in it. *)
let interpret(program: typedAst.Program e: env.T sm: location.SourceMap bag: diagbag.T): model.Frame =
    begin
        let f = runFrame(e sm)
        (* The program's phrases run in the outermost frame (docs/exceptions.md
         * section 4) *)
        vector.append(f.root.callStack diagnostics.mainFrame)
        try
            let ran = treewalk.evalProgramPhrasesIn(program f fun(r: treewalk.PhraseResult): Ok
                if options.echo then printResult(r.phrase r.value) end)
            let results = ran.results
            flushDumps()
            if not(options.echo) andif {extent results > 0} then
                printResult(results[extent results - 1].phrase results[extent results - 1].value)
            end
            ran.frame
        when model.runError with err then
            treewalk.noteFrames(err f)
            diagbag.add(bag repl.runErrorDiagnostic(err options.file))
            f
        end
    end

(* Enters the REPL in the program's environment and frame (or with --kernel,
 * serves the kernel's requests), after reporting the program's diagnostics, and
 * exits with its status *)
let interactive(e: env.T f: model.Frame bag: diagbag.T sm: location.SourceMap): Ok =
    begin
        flushDumps()
        diagbag.report(bag sm)
        let r = repl.new(e f)
        (* A host's session (with --kernel or -i) returns to the host, which
         * calls kernel.request *)
        if not(kernel.serving(r)) then
            system.sysexit(if options.kernel then kernel.runKernel(r) else repl.run(r) end)
        end
    end

(* Runs a program with the JIT (docs/jit.md), as one input, which prints its
 * last phrase's result (or, with --echo, every phrase's) as interpret does; a
 * program that fails to run ends the driver with 1. With -i, the REPL then
 * reads inputs, the program's bindings in scope. *)
let jitRun(program: typedAst.Program e: env.T sm: location.SourceMap bag: diagbag.T): Ok =
    begin
        let r = repl.newJit(e runFrame(e sm) systemArgs)
        (* The session's files for a debugger are removed as it ends *)
        let finished = fun(): Ok session.finish(maybe.unwrap(r.jit))
        if options.fromFile orif options.fromStdin orif maybe.isSome(options.code) then
            if not(repl.runInput(r program sm bag options.echo)) then
                finished()
                diagbag.report(bag maybe.unwrapOr(r.errorSource sm))
                system.sysexit(1)
            end
        end
        flushDumps()
        if {options.kernel orif options.interactive} andif kernel.serving(r) then
            (* A host's session, which calls kernel.request (docs/wasm.md
             * section 6.1) *)
            diagbag.report(bag sm)
        elsif options.kernel then
            let status = kernel.runKernel(r)
            finished()
            system.sysexit(status)
        elsif options.interactive then
            diagbag.report(bag sm)
            let status = repl.run(r)
            finished()
            system.sysexit(status)
        else
            finished()
        end
    end

(* Compiles a unit file alone, as the bootstrap's compile_unit_file does *)
let compileUnitFile(): Ok =
    begin
        let bag = diagbag.new()
        let sm = location.newSourceMap(options.file maybe.unwrapOr(files.readText(options.file) ""))
        stdlib.install()
        typecheck.install()
        let includes = array of(extent options.includePaths "")
        for i = 0 upto {extent options.includePaths - 1} do includes[i] := files.absolute(options.includePaths[i]) end
        let outputDir =
            if maybe.isSome(options.output) then
                maybe.some(files.parent(files.absolute(maybe.unwrap(options.output))))
            else
                maybe.none(:String)
            end
        try
            case units.unitKind(options.file)
                when interfaceUnit then
                    if maybe.isSome(outputDir) then system.makeDirectory(maybe.unwrap(outputDir)) end
                    interfaceHeaders.compileInterfaceWithHeader(files.absolute(options.file) outputDir includes
                            options.buildDir
                            maybe.none())
                    ok
                when moduleUnit then
                    if maybe.isSome(outputDir) then system.makeDirectory(maybe.unwrap(outputDir)) end
                    let settings = tuple
                        let includePaths = includes
                        let nogc = options.nogc
                        let buildDir = options.buildDir
                        let programDir = maybe.none(:String)
                        let backends = options.backends
                        let reportInferable = options.reportInferable
                    end
                    moduleCompiler.compileModuleFile(files.absolute(options.file) outputDir settings maybe.none())
                    ok
                else
                    diagbag.add(bag diagnostics.error("'" <> options.file <> "' is a program, not a unit file"
                            location.span("" ~1 ~1)))
            end
        when diagnostics.compilerError with err then
            diagbag.add(bag diagnostics.errorDiagnostic(err options.file))
        when compilerRunner.failure with m then
            diagbag.add(bag diagnostics.error(m location.span("" ~1 ~1)))
        end
        finish(bag sm)
    end

(* Runs the given program (from a file, -e, or standard input) through the
 * pipeline's phases as far as the command line asks (reaches), dumping each
 * phase it shows. Each phase runs only if earlier phases found no errors:
 * tokenizer errors stop before parsing, syntax errors (raised as
 * diagbag.fatalError) stop immediately, and type errors stop before any
 * backend. A program that type-checks then goes to a compiled backend (C,
 * ssac, arm64, or wasm via codegen_c and later phases), the IR interpreter
 * (run_ir_STAGE), IR/SSA dumping (ir_STAGE, ssa_PASS), the JIT, or the
 * tree-walking interpreter (which may continue into the REPL or kernel). The
 * environment is configured for the target: compiled code and the JIT see
 * imported modules through their interfaces (unless --whole-program merges
 * them) using artifacts in the build directory (or in memory for the JIT
 * without --build-dir). Finally, finish prints diagnostics and exits. *)
let run(): Ok =
    begin
        let source =
            if maybe.isSome(options.code) then
                maybe.unwrap(options.code)
            elsif options.fromStdin then
                readAll(reader.input)
            elsif options.fromFile then
                readFile(options.file)
            else
                ""
            end
        let sm = location.newSourceMap(options.file source)
        let bag = diagbag.new()
        try
            let toks = tokenizer.tokenizeAll(tokenizer.new(sm bag))
            if not(diagbag.hasErrors(bag)) andif shows("tokenize") then
                dump(tokenizer.formatDump(toks sm options.showValues))
            end
            if not(diagbag.hasErrors(bag)) andif reaches("parse") then
                let program = parser.parseProgram(toks sm bag)
                let show = if options.showOffsets then astprint.dumpWithOffsets else astprint.dump end
                if shows("parse") then dump(show(program)) end
                let desugared = if reaches("desugar") then desugar.program(program) else program end
                if shows("desugar") then dump(show(desugared)) end
                if reaches("typecheck") then
                    stdlib.install()
                    let dir = if options.fromFile then files.parent(files.absolute(options.file))
                        else files.absolute(".") end
                    let e = env.forProgram(options.file dir)
                    (* Install the variant selector before any module is
                     * resolved (docs/build-process.md section 6.4) *)
                    e.units.resolver.variantOf := fun(unit: String): String choice.variantFor(options.backends unit)
                    e.reportInferable := options.reportInferable
                    (* The file -i runs, and the REPL's inputs, are interactive
                     * (docs/repl.md section 6) *)
                    e.interactive := options.interactive
                    if compiledPipeline orif options.jit then
                        (* For compiled backends and the JIT, imported modules
                         * are checked through their interfaces using artifacts
                         * from the build directory, which is searched first.
                         * Without --build-dir, the JIT keeps its artifacts in
                         * memory (docs/jit.md section 3.4.1). *)
                        let artifacts = if options.jit andif maybe.isNone(options.buildDir) then memoryFiles.root
                            else buildDir end
                        e.importsThroughInterfaces := not(options.wholeProgram)
                        (* The JIT's units copy no inlined module (ir/opened),
                         * so their sources are not elaborated *)
                        e.openInlined := not(options.jit)
                        env.useArtifacts(e artifacts)
                    end
                    for i = 0 upto {extent options.includePaths - 1} do
                        vector.append(e.includePaths options.includePaths[i])
                    end
                    (* Add runtime/ to the search path so type-checking finds
                     * the Quest runtime units (docs/wasm.md section 4.5) that
                     * wasm library variants import (e.g. lib/dynamic.wasm
                     * imports wasm/core) *)
                    if choice.isWasm(programBackend) then
                        vector.append(e.includePaths files.join(paths.projectDir() "runtime"))
                    end
                    (* The modules of prebuilt objects are known through their
                     * interfaces alone, by their canonical names and their
                     * base names *)
                    for i = 0 upto {extent options.extraObjects - 1} do
                        let o = options.extraObjects[i]
                        let byPath = graph.unit(e.units option moduleUnit of units.UnitKind end
                                paths.canonicalizeModulePath(o options.includePaths maybe.none()))
                        byPath.precompiled := true
                        let byName = graph.unit(e.units option moduleUnit of units.UnitKind end
                                vector.get(strutil.split(files.baseName(o) ".") 0))
                        byName.precompiled := true
                    end
                    (* --inline-module's paths name modules as the program's
                     * imports do, resolved from its directory: by canonical
                     * name from here on, in workers too *)
                    if extent options.inlineModules > 0 then
                        let named = vector.new(:String)
                        for i = 0 upto {extent options.inlineModules - 1} do
                            let path = options.inlineModules[i]
                            vector.append(named try resolution.canonicalName(env.resolveModule(e path))
                            when diagnostics.compilerError then path end)
                        end
                        inlined.setInlined(options.inlineLibrary vector.toArray(named))
                    end
                    let result = typecheck.elaborateProgram(desugared e)
                    application.reportInferable(e sm)
                    diagbag.addChecked(bag result.errors result.warnings options.file)
                    if maybe.isSome(result.program) then
                        let typed = maybe.unwrap(result.program)
                        if shows("typecheck") then dump(typedAstPrint.dumpProgram(typed)) end
                        if diagbag.hasErrors(bag) then
                            ok
                        elsif reaches("codegen_c") then
                            compiled(typed e sm bag)
                        elsif maybe.isSome(irStage("run_ir_")) andif reaches(options.stopAfter) then
                            runIr(typed e sm bag maybe.unwrap(irStage("run_ir_")))
                        elsif reaches("ir_core") then
                            lowerOnly(typed e sm bag)
                        elsif reaches("interpret") andif options.jit then
                            jitRun(typed e sm bag)
                        elsif reaches("interpret") then
                            let f = interpret(typed e sm bag)
                            if {options.interactive orif options.kernel} andif not(diagbag.hasErrors(bag)) then
                                interactive(e f bag sm)
                            end
                        end
                    end
                end
            end
        when diagbag.fatalError then
            ok
        end
        finish(bag sm)
    end

(* Builds the program with the build engine, as -o and compile do: its modules
 * compiled separately, each only if stale. With compile -c, the program is
 * compiled into the build directory but not linked. *)
let buildProgram(): Ok =
    begin
        let bag = diagbag.new()
        let sm = location.newSourceMap(options.file maybe.unwrapOr(files.readText(options.file) ""))
        stdlib.install()
        try
            let eng = engine.new(engineSettings(options.buildDir options.includePaths maybe.none()))
            if compileMode andif options.compileOnly then engine.compileMain(eng options.file)
            else engine.buildMain(eng options.file compileOutput)
            end
        when diagnostics.compilerError with err then
            diagbag.add(bag diagnostics.errorDiagnostic(err options.file))
        when engine.buildError with m then
            failWith(m)
        when compilerRunner.failure with m then
            failWith(m)
        end
        finish(bag sm)
    end

(* What the command line asks for (options.Command) *)
case commandLine.command
    when commandFmt then
        (* quest fmt formats source files and exits (questlang/format) *)
        begin
            let rest = array of(extent(system.args) - 2 "")
            for i = 2 upto {extent(system.args) - 1} do rest[i - 2] := system.args[i] end
            format.main(rest)
        end
    when commandLsp then
        (* quest lsp serves the Language Server Protocol on standard input and
         * output until the client exits it (docs/lsp.md) *)
        begin
            if extent(system.args) > 2 then usage("lsp takes no arguments") end
            system.sysexit(server.run())
        end
    when commandWorker then begin programSettings() workers.unitMain(system.args) end
    when commandUnitFile then begin programSettings() compileUnitFile() end
    when commandBuild then begin programSettings() buildProgram() end
    when commandRun then begin programSettings() run() end
end
