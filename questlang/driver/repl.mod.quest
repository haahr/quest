(* Quest Self-Hosted Compiler: The REPL Implementation *)

module repl : Repl
import
    questlang/common/location : questlang/common/Location
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/diagbag : questlang/common/DiagBag
    questlang/syntax/tokens : questlang/syntax/Tokens
    questlang/syntax/tokenizer : questlang/syntax/Tokenizer
    questlang/syntax/parser : questlang/syntax/Parser
    questlang/syntax/desugar : questlang/syntax/Desugar
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/typechecker/typecheck : questlang/typechecker/Typecheck
    questlang/modules/graph : questlang/modules/Graph
    questlang/values/model : questlang/values/Model
    questlang/interpreter/formatting : questlang/interpreter/Formatting
    questlang/interpreter/treewalk : questlang/interpreter/Treewalk
    questlang/jit/session : questlang/jit/Session
    questlang/values/json : questlang/values/Json
    io/readline : io/Readline
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/strutil : util/Strutil
    util/stringBuilder : util/StringBuilder
    stringOp = string : StringOp
    reader : Reader
    writer : Writer
    system : System
export
    let promptMain = ">>  "
    let promptContinue = "    "
    let prefixResult = "==  "

    (* The name inputs' diagnostics give their source *)
    let inputName = "<repl>"
    let historyFileName = ".quest_history"
    let historyLength = 1000

    (* ======================================================================
     * 1. Completeness
     * ====================================================================== *)

    let incomplete(text: String): Bool =
        if stringOp.length(strutil.strip(text)) is 0 then
            false
        else
            let sm = location.newSourceMap(inputName text)
            let bag = diagbag.new()
            try
                let toks = tokenizer.tokenizeAll(tokenizer.new(sm bag))
                if diagbag.count(bag) > 0 then
                    (* More lines can close a comment or a string *)
                    let message = diagnostics.message(diagbag.get(bag 0))
                    {strutil.find(message "Unclosed comment") >= 0} orif {strutil.find(message "Unterminated string") >= 0}
                else
                    let endOffset = vector.get(:tokens.Token toks {vector.length(:tokens.Token toks) - 1}).span.startOffset
                    try
                        parser.parseProgram(toks sm bag)
                        false
                    when diagbag.fatalError with d then
                        (* A syntax error at the end of the input expected more
                         * of it *)
                        diagnostics.span(d).startOffset is endOffset
                    end
                end
            when diagbag.fatalError then
                false
            end
        end

    (* ======================================================================
     * 2. Evaluation
     * ====================================================================== *)

    let runErrorDiagnostic(err: model.RunError mainFile: String): diagnostics.Diagnostic =
        begin
            let file = if maybe.isSome(:location.SourceMap err.sourceMap) then
                location.file(maybe.unwrap(:location.SourceMap err.sourceMap))
            else
                mainFile
            end
            let sp = if maybe.isSome(:Int err.offset) then
                location.span(file maybe.unwrap(:Int err.offset) {maybe.unwrap(:Int err.offset) + 1})
            else
                location.span("" ~1 ~1)
            end
            let d = diagnostics.error(model.runErrorMessage(err) sp)
            if maybe.isSome(:Array(String) err.frames) then diagnostics.setTrace(d maybe.unwrap(:Array(String) err.frames)) end
            d
        end

    Let T = Tuple
        e: env.T
        var frame: model.Frame
        var errorSource: maybe.T(location.SourceMap)
        var failure: String
        jit: maybe.T(session.T)
    end

    let new(e: env.T f: model.Frame): T =
        tuple
            let e = e let var frame = f let var errorSource = maybe.none(:location.SourceMap) let var failure = ""
            let jit = maybe.none(:session.T)
        end

    (* A driver that cannot host the JIT ends with 1 *)
    let newJit(e: env.T f: model.Frame args: Array(String)): T =
        begin
            let refusal = session.refusal()
            if maybe.isSome(:String refusal) then
                writer.putString(writer.err "quest: error: " <> maybe.unwrap(:String refusal) <> "\n")
                system.sysexit(1)
            end
            tuple
                let e = e let var frame = f let var errorSource = maybe.none(:location.SourceMap) let var failure = ""
                let jit = maybe.some(:session.T session.new(e args))
            end
        end

    (* An input run by the JIT: its phrases' results, or none, its error in
     * bag *)
    let runJit(r: T s: session.T program: typedAst.Program sm: location.SourceMap bag: diagbag.T echo: Bool
        printResult: Bool capture: Bool): maybe.T(Array(String)) =
        try
            case session.run(s program sm echo printResult capture)
                when ran with x then maybe.some(:Array(String) x.shown)
                when raised with x then
                    let file = if maybe.isSome(:location.SourceMap x.sourceMap) then
                        location.file(maybe.unwrap(:location.SourceMap x.sourceMap)) else "" end
                    let sp = if maybe.isSome(:Int x.offset) then
                        location.span(file maybe.unwrap(:Int x.offset) maybe.unwrap(:Int x.offset) + 1)
                    else location.span("" ~1 ~1) end
                    let d = diagnostics.error("Exception: " <> x.name sp)
                    if extent x.frames > 0 then diagnostics.setTrace(d x.frames) end
                    r.errorSource := x.sourceMap
                    r.failure := x.name
                    diagbag.add(bag d)
                    maybe.none(:Array(String))
            end
        when session.unsupported with m then
            r.failure := "unsupported"
            diagbag.add(bag diagnostics.error("the JIT cannot compile this input: " <> m location.span("" ~1 ~1)))
            maybe.none(:Array(String))
        when diagnostics.compilerError with err then
            (* An error in a module file the input imports, which the JIT
             * compiles (docs/jit.md section 3.4) *)
            r.failure := "compile"
            diagbag.add(bag diagnostics.errorDiagnostic(err inputName))
            maybe.none(:Array(String))
        end

    (* The exception's name in an error's message ("Exception: name ..."), or
     * "error" for an error of the interpreter's own *)
    let exceptionName(message: String): String =
        if strutil.startsWith(message "Exception: ") then
            let rest = stringOp.getSub(message 11 {stringOp.length(message) - 11})
            let space = strutil.find(rest " ")
            if space >= 0 then stringOp.getSub(rest 0 space) else rest end
        else
            "error"
        end

    (* An input's phrases' results, if it ran; the errors it found are in bag *)
    let compileAndRun(r: T text: String sm: location.SourceMap bag: diagbag.T): maybe.T(Array(String)) =
        begin
            let failed = maybe.none(:Array(String))
            r.failure := "syntax"
            try
                let toks = tokenizer.tokenizeAll(tokenizer.new(sm bag))
                if diagbag.hasErrors(bag) then
                    failed
                else
                    let program = parser.parseProgram(toks sm bag)
                    r.failure := "type"
                    let result = typecheck.elaborateProgram(desugar.program(program) r.e)
                    for i = 0 upto {extent result.errors - 1} do
                        diagbag.add(bag diagnostics.errorDiagnostic(result.errors[i] inputName))
                    end
                    for i = 0 upto {extent result.warnings - 1} do
                        diagbag.add(bag diagnostics.warningDiagnostic(result.warnings[i] inputName))
                    end
                    if diagbag.hasErrors(bag) orif maybe.isNone(:typedAst.Program result.program) then
                        failed
                    elsif maybe.isSome(:session.T r.jit) then
                        runJit(r maybe.unwrap(:session.T r.jit) maybe.unwrap(:typedAst.Program result.program) sm bag
                            true false true)
                    else
                        (* The input runs in a scope of its own, which holds its
                         * source, so that the functions earlier inputs made go
                         * on locating errors in theirs *)
                        let f = treewalk.pushScope(r.frame)
                        f.sourceMap := maybe.some(:location.SourceMap sm)
                        try
                            let ran = treewalk.evalProgramPhrasesIn(maybe.unwrap(:typedAst.Program result.program) f
                                fun(p: treewalk.PhraseResult): Ok ok)
                            r.frame := ran.frame
                            let shown = array of(extent ran.results "")
                            for i = 0 upto {extent shown - 1} do
                                let p = ran.results[i]
                                shown[i] := formatting.formatInteractiveResult(p.phrase p.value)
                            end
                            maybe.some(:Array(String) shown)
                        when model.runError with err then
                            treewalk.noteFrames(err f)
                            r.errorSource := err.sourceMap
                            r.failure := exceptionName(model.runErrorMessage(err))
                            diagbag.add(bag runErrorDiagnostic(err inputName))
                            failed
                        end
                    end
                end
            when diagbag.fatalError then
                failed
            end
        end

    (* Compiles and runs one input as a transaction: an input that fails leaves
     * the session as it found it (evaluate). Each input is a compilation
     * session of its own on the unit graph, so that its imports find files
     * created since; units loaded by earlier inputs stay loaded *)
    let evaluate(r: T text: String sm: location.SourceMap bag: diagbag.T): maybe.T(Array(String)) =
        begin
            r.errorSource := maybe.none(:location.SourceMap)
            let envSnapshot = env.snapshot(r.e)
            let start = r.frame
            let frameSnapshot = treewalk.snapshot(start)
            graph.newSession(r.e.units)
            let results = compileAndRun(r text sm bag)
            if maybe.isNone(:Array(String) results) then
                env.restore(r.e envSnapshot)
                (* A phrase that rebinds a name continues in a new frame; go
                 * back to the one the input started in *)
                r.frame := start
                treewalk.restore(start frameSnapshot)
            end
            results
        end

    let runInput(r: T program: typedAst.Program sm: location.SourceMap bag: diagbag.T echo: Bool): Bool =
        maybe.isSome(:Array(String) runJit(r maybe.unwrap(:session.T r.jit) program sm bag echo not(echo) false))

    (* ======================================================================
     * 3. The loop
     * ====================================================================== *)

    let say(s: String): Ok = writer.putString(writer.output s)

    (* A phrase's result, as interpret shows it, its lines after the first
     * indented as the prompts are *)
    let showResult(shown: String): Ok =
        begin
            if stringOp.length(shown) > 0 then
                let lines = strutil.split(shown "\n")
                say(prefixResult <> vector.get(:String lines 0) <> "\n")
                for i = 1 upto {vector.length(:String lines) - 1} do
                    say(promptContinue <> vector.get(:String lines i) <> "\n")
                end
            end
        end

    (* The history file, if lines are edited and there is a home directory *)
    let historyPath(): maybe.T(String) =
        begin
            let home = system.getEnv("HOME")
            if readline.editing() andif {stringOp.length(home) > 0} then
                maybe.some(:String home <> "/" <> historyFileName)
            else
                maybe.none(:String)
            end
        end

    let run(r: T): Int =
        begin
            let history = historyPath()
            if maybe.isSome(:String history) then
                try readline.readHistory(maybe.unwrap(:String history)) when readline.error then ok end
            end
            let lines = vector.new(:String)
            let var reading = true
            while reading do
                let prompt = if vector.empty(:String lines) then promptMain else promptContinue end
                try
                    let line = readline.readLine(prompt)
                    if maybe.isSome(:String history) andif {stringOp.length(strutil.strip(line)) > 0} then
                        readline.addHistory(line)
                    end
                    vector.append(:String lines line)
                    let text = strutil.join("\n" lines)
                    if not(incomplete(text)) then
                        vector.clear(:String lines)
                        if stringOp.length(strutil.strip(text)) > 0 then
                            let sm = location.newSourceMap(inputName text)
                            let bag = diagbag.new()
                            let results = evaluate(r text sm bag)
                            if maybe.isSome(:Array(String) results) then
                                (* An input that ran may have warnings *)
                                writer.flush(writer.output)
                                diagbag.renderAll(bag sm writer.err)
                                writer.flush(writer.err)
                                let shown = maybe.unwrap(:Array(String) results)
                                for i = 0 upto {extent shown - 1} do showResult(shown[i]) end
                            else
                                writer.flush(writer.output)
                                diagbag.renderAll(bag maybe.unwrapOr(:location.SourceMap r.errorSource sm) writer.err)
                                writer.flush(writer.err)
                            end
                        end
                    end
                when readline.endOfInput then
                    say("\n")
                    reading := false
                when readline.interrupted then
                    say("\n")
                    vector.clear(:String lines)
                end
            end
            writer.flush(writer.output)
            if maybe.isSome(:String history) then
                try readline.writeHistory(maybe.unwrap(:String history) historyLength) when readline.error then ok end
            end
            0
        end

    (* ======================================================================
     * 4. Kernel mode
     *
     * docs/jupyter.md section 2: a request or a record is a JSON object on a
     * line of its own, its strings bytes (each above 126 escaped as \u00XX).
     * Standard output and error are the program's, flushed before each record
     * so that what the program wrote is in its pipe ahead of the record.
     * ====================================================================== *)

    (* A line of r, without its newline, if r has one before its end *)
    let readRequest(r: reader.T): maybe.T(String) =
        if not(reader.more(r)) then
            maybe.none(:String)
        else
            let b = stringBuilder.new()
            let var reading = true
            while reading andif reader.more(r) do
                let c = reader.getChar(r)
                if c is '\n' then reading := false else b.char(c) ok end
            end
            maybe.some(:String b.toString())
        end

    (* Writes a record of the members names and values, after the program's
     * output *)
    let writeRecord(w: writer.T names: Array(String) values: Array(json.Value)): Ok =
        begin
            writer.flush(writer.output)
            writer.flush(writer.err)
            let o = json.newObject()
            for i = 0 upto {extent names - 1} do json.put(o names[i] values[i]) end
            writer.putString(w json.dump(json.object(o)) <> "\n")
            writer.flush(w)
        end

    (* The records of a cell that failed: its error, from the diagnostics in
     * bag, with the position of the first in the cell, if it has one *)
    let failed(r: T w: writer.T sm: location.SourceMap bag: diagbag.T): Ok =
        begin
            let shown = maybe.unwrapOr(:location.SourceMap r.errorSource sm)
            let b = stringBuilder.new()
            let var message = ""
            let var position = maybe.none(:location.Pos)
            for i = 0 upto {diagbag.count(bag) - 1} do
                let d = diagbag.get(bag i)
                b.str(diagnostics.format(d shown))
                if stringOp.isEmpty(message) then
                    message := diagnostics.message(d)
                    let sp = diagnostics.span(d)
                    if stringOp.equal(sp.file inputName) andif {sp.startOffset >= 0} then
                        position := maybe.some(:location.Pos location.locate(sm sp.startOffset))
                    end
                end
            end
            let names = vector.new(:String)
            let values = vector.new(:json.Value)
            vector.append(:String names "error") vector.append(:json.Value values json.string(r.failure))
            vector.append(:String names "message") vector.append(:json.Value values json.string(message))
            vector.append(:String names "rendered") vector.append(:json.Value values json.string(b.toString()))
            if maybe.isSome(:location.Pos position) then
                let p = maybe.unwrap(:location.Pos position)
                vector.append(:String names "line") vector.append(:json.Value values json.int(p.line))
                vector.append(:String names "column") vector.append(:json.Value values json.int(p.col))
            end
            writeRecord(w vector.toArray(:String names) vector.toArray(:json.Value values))
        end

    (* Runs a cell as one input, writing its records *)
    let execute(r: T w: writer.T text: String): Ok =
        begin
            let var status = "ok"
            if stringOp.length(strutil.strip(text)) > 0 then
                let sm = location.newSourceMap(inputName text)
                let bag = diagbag.new()
                r.failure := ""
                let results = evaluate(r text sm bag)
                if maybe.isSome(:Array(String) results) then
                    let shown = maybe.unwrap(:Array(String) results)
                    for i = 0 upto {extent shown - 1} do
                        if stringOp.length(shown[i]) > 0 then
                            writeRecord(w array of "result" end array of json.string(shown[i]) end)
                        end
                    end
                else
                    failed(r w sm bag)
                    status := "error"
                end
            end
            writeRecord(w array of "done" end array of json.string(status) end)
        end

    (* The string member name of o, if it has one *)
    let member(o: json.Object name: String): maybe.T(String) =
        begin
            let v = json.get(o name)
            if maybe.isSome(:json.Value v) then
                case maybe.unwrap(:json.Value v)
                    when jString with x then maybe.some(:String x.s)
                    else maybe.none(:String)
                end
            else
                maybe.none(:String)
            end
        end

    let runKernel(r: T): Int =
        begin
            let closed = fun(what: String): Ok
                begin
                    writer.putString(writer.err "quest: error: --kernel " <> what <> ", which is not open\n")
                    system.sysexit(2)
                end
            let requests = try reader.file("/dev/fd/3")
                when reader.error then closed("reads requests from descriptor 3") reader.input end
            let w = try writer.file("/dev/fd/4")
                when writer.error then closed("writes records to descriptor 4") writer.output end
            let var reading = true
            while reading do
                let line = readRequest(requests)
                if maybe.isNone(:String line) then
                    reading := false
                elsif stringOp.length(strutil.strip(maybe.unwrap(:String line))) > 0 then
                    let request = try maybe.some(:json.Value json.parse(maybe.unwrap(:String line)))
                        when json.error then maybe.none(:json.Value) end
                    let code = if maybe.isSome(:json.Value request) then
                        case maybe.unwrap(:json.Value request)
                            when jObject with x then member(x.o "execute")
                            else maybe.none(:String)
                        end
                    else
                        maybe.none(:String)
                    end
                    if maybe.isSome(:String code) then
                        execute(r w maybe.unwrap(:String code))
                    else
                        writeRecord(w array of "error" "message" "rendered" end array of json.string("protocol")
                            json.string("not a request: " <> maybe.unwrap(:String line))
                            json.string("not a request: " <> maybe.unwrap(:String line) <> "\n") end)
                        writeRecord(w array of "done" end array of json.string("error") end)
                    end
                end
            end
            writer.flush(writer.output)
            writer.flush(writer.err)
            0
        end
end
