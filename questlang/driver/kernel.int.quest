(* Quest Self-Hosted Compiler: The Jupyter Kernel's Protocol Interface
 *
 * The driver's kernel mode, through which tools/jupyter's kernel runs a
 * session of the REPL (driver/repl): docs/jupyter-kernel.md section 2. A
 * request or a record is a JSON object on a line of its own, its strings bytes
 * (each above 126 escaped as \u00XX). Standard output and error are the
 * program's, flushed before each record so that what the program wrote is in
 * its pipe ahead of the record. *)

interface Kernel
import
    questlang/driver/repl : questlang/driver/Repl
export
    (* Kernel mode (docs/jupyter-kernel.md section 2): reads requests, a JSON
     * object a line, from descriptor 3, and writes their records to descriptor
     * 4, until descriptor 3 ends; the exit status *)
    runKernel(r: repl.T): Int
end
