(* Quest Self-Hosted Compiler: The Jupyter Kernel's Protocol Interface
 *
 * Implements the driver's kernel mode, through which tools/jupyter drives a
 * REPL session (driver/repl; see docs/jupyter-kernel.md section 2). Each
 * request and response record is a single-line JSON object whose strings encode
 * raw bytes (escaping bytes above 126 as \u00XX). Standard output and error
 * belong to the running program and are flushed before each record so program
 * output reaches its pipe ahead of the protocol record. *)

interface Kernel
import
    questlang/driver/repl : questlang/driver/Repl
export
    (* Runs kernel mode (docs/jupyter-kernel.md section 2), reading one JSON
     * request per line from file descriptor 3 and writing response records to
     * file descriptor 4 until descriptor 3 reaches EOF. Returns the exit
     * status. *)
    runKernel(r: repl.T): Int

    (* Registers r for a host-driven session when QUEST_HOST_SESSION is set
     * (docs/wasm.md section 6.1) and returns whether it did so. In that mode
     * the driver returns to the host without exiting, and the host invokes
     * request() for each request instead of the driver running a read loop. *)
    serving(r: repl.T): Bool
    (* Handles a single request staged by the host on file descriptor 3,
     * writing response records to file descriptor 4. Returns 1 if a request
     * was read, or 0 if descriptor 3 was empty or no session is registered. *)
    request(): Int
end
