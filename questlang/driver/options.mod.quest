(* Quest Self-Hosted Compiler: The Driver's Command Line Implementation *)

module options : Options
import
    questlang/common/files : questlang/common/Files
    questlang/modules/units : questlang/modules/Units
    questlang/codegen/choice : questlang/codegen/Choice
    questlang/driver/kernel : questlang/driver/Kernel
    questlang/jit/session : questlang/jit/Session
    questlang/build/workers : questlang/build/Workers
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/strutil : util/Strutil
    stringOp = string : StringOp
    writer : Writer
    system : System
export
    (* The command line, parsed: the phase to stop after (and whether one was
     * given), the program (a file, standard input, -e's code, or the REPL's
     * inputs, as file names it), the options of output and dumps, of the
     * build, and of running, and the program's arguments *)
    Let T = Tuple
        stopAfter: String
        file: String
        fromFile: Bool
        fromStdin: Bool
        code: maybe.T(String)
        showOffsets: Bool
        showValues: Bool
        echo: Bool
        printResult: Bool
        stopGiven: Bool
        buildDir: maybe.T(String)
        output: maybe.T(String)
        verbose: Bool
        jobs: Int
        wholeProgram: Bool
        backends: choice.T
        expectedExit: Int
        dumpAfter: Array(String)
        extraObjects: Array(String)
        includePaths: Array(String)
        interactive: Bool
        kernel: Bool
        jit: Bool
        programArgs: Array(String)
        compileOnly: Bool
        emitC: Bool
        nogc: Bool
    end

    (* The IR's stages (docs/ir.md section 9) the driver dumps (ir_STAGE) and
     * runs (run_ir_STAGE) *)
    let irStages = array of "core" "simplified" "specialized" "closed" "represented" "described" end

    let phases = array of
        "tokenize" "parse" "desugar" "typecheck"
        "ir_core" "ir_simplified" "ir_specialized" "ir_closed" "ir_represented" "ir_described"
        "run_ir_core" "run_ir_simplified" "run_ir_specialized" "run_ir_closed" "run_ir_represented" "run_ir_described"
        "interpret"
        "codegen_c" "codegen_arm64" "run_c_compiled"
        "ssa_built" "ssa_escape" "ssa_promote" "ssa_constants" "ssa_valueNumbers" "ssa_selects" "ssa_tables"
        "ssa_accumulate" "ssa_tailCalls" "ssa_tailJumps" "ssa"
    end

    (* The SSA's phases (docs/ssa.md): the builder's, each pass's
     * (questlang/ssa/pipeline), and the last *)
    let ssaPhases = array of
        "ssa_built" "ssa_escape" "ssa_promote" "ssa_constants" "ssa_valueNumbers" "ssa_selects" "ssa_tables"
        "ssa_accumulate" "ssa_tailCalls" "ssa_tailJumps" "ssa"
    end

    (* The phases of the backends: the program's code (C, or arm64's assembly),
     * and its run *)
    let cPhases = array of "codegen_c" "codegen_arm64" "run_c_compiled" end

    let isOneOf(s: String xs: Array(String)): Bool =
        begin
            let var found = false
            for i = 0 upto {extent xs - 1} do if stringOp.equal(xs[i] s) then found := true end end
            found
        end

    (* Object files given to link with the program *)
    let objectSuffixes = array of ".o" ".a" ".dylib" ".so" end
    let isObjectFile(arg: String): Bool =
        begin
            let var found = false
            for i = 0 upto {extent objectSuffixes - 1} do if strutil.endsWith(arg objectSuffixes[i]) then
                found := true end end
            found
        end

    let isProgramFile(arg: String): Bool = case units.unitKind(arg) when programUnit then true else false end

    (* `compile`, before the options, translates the program to C and compiles
     * it to a binary (or with --emit-c, writes its C), as the bootstrap's
     * `quest compile` does *)
    let compileMode = {extent system.args > 1} andif stringOp.equal(system.args[1] "compile")

    (* The program's name in errors that are not diagnostics *)
    let programName = if compileMode then "quest compile" else "quest" end

    (* The command line's forms, options, and phases, one to a line *)
    let usageText = strutil.joinArray("\n" array of
        "usage: quest [OPTION...] [OBJECT...] [FILE|- [ARG...] | -e PROGRAM [-- ARG...] | -- ARG...]"
        "       quest compile [OPTION...] [OBJECT...] [FILE|- | -e PROGRAM]"
        ""
        "quest runs a program, compiled by the JIT; with neither FILE nor -e, it enters the REPL at a"
        "terminal, and otherwise runs standard input. quest compile writes a binary: FILE without its"
        ".quest, or -o's. OBJECTs (.o, .a, .dylib, .so) are linked with the program."
        ""
        "Options:"
        "  --stop-after PHASE   run through PHASE and print its output"
        "  --dump-after PHASE   print PHASE's output too (may be repeated)"
        "  -e PROGRAM           run PROGRAM, given as a string"
        "  -i                   enter the REPL after running FILE"
        "  --kernel             serve a Jupyter kernel's requests on descriptors 3 and 4"
        "  --jit, --no-jit      compile with the JIT (the default), or interpret"
        "  --echo               print every top-level phrase's result"
        "  --print-result       print the last phrase's result when compiled"
        "  --show-offsets       show source offsets in parse and desugar's output"
        "  --show-values        show tokens' values in tokenize's output"
        "  --expected-exit N    the status a compiled program must exit with"
        "  --backend B          compile every unit with B: arm64 (the default), c, or ssac"
        "  --unit-backend U=B   compile unit U (main, the program's) with B"
        "  --whole-program      compile the program and its modules as one unit"
        "  -o FILE              write the binary to FILE"
        "  -c                   compile without linking"
        "  -I DIR               look for modules in DIR too"
        "  --build-dir DIR      build in DIR (default .build)"
        "  -j N                 compile N modules at once"
        "  -v                   report what the build does"
        "  --emit-c             (compile) write the program's C (the C backend's, unless --backend), not a binary"
        "  --nogc               (compile) compile without the collector"
        "  -h, --help           print this message"
        ""
        "Phases (for --stop-after and --dump-after):"
        "  tokenize, parse, desugar, typecheck"
        "  ir_STAGE, run_ir_STAGE, with STAGE core, simplified, specialized, closed, represented,"
        "    or described: the IR at STAGE, printed or run"
        "  ssa_built, ssa_escape, ssa_promote, ssa_constants, ssa_valueNumbers, ssa_selects, ssa_tables,"
        "    ssa_accumulate, ssa_tailCalls, ssa_tailJumps,"
        "    ssa: the SSA after each pass"
        "  interpret: run the program (not with compile)"
        "  codegen_c: the program's code (C, unless --backend arm64 gives assembly)"
        "  codegen_arm64: the program's arm64 assembly"
        "  run_c_compiled: run the compiled program (not with compile)"
        ""
    end)

    let usage(message: String): Ok =
        begin
            writer.putString(writer.err programName <> ": " <> message <> "\n" <> usageText)
            system.sysexit(2)
        end

    (* The command line: the phase to stop after, the file or the program given,
     * and the program's arguments. Each option has the bootstrap's spellings. *)
    let options: T =
        begin
            let var stopAfter = if compileMode then "codegen_c" else "interpret" end
            let var stopGiven = false
            let var buildDir = maybe.none(:String)
            let var output = maybe.none(:String)
            let var verbose = false
            let var jobs = 1
            let var wholeProgram = false
            let var backend = "arm64"
            let var backendGiven = false
            let unitBackends = vector.new(:choice.Override)
            let var expectedExit = 0
            let dumpAfter = vector.new(:String)
            let extraObjects = vector.new(:String)
            let includePaths = vector.new(:String)
            let var file = ""
            let var code = maybe.none(:String)
            let var showOffsets = false
            let var showValues = false
            let var echo = false
            let var printResult = false
            let var interactive = false
            let var kernel = false
            let var jit = false
            let var noJit = false
            let var compileOnly = false
            let var emitC = false
            let var nogc = false
            let programArgs = vector.new(:String)
            (* The file, of which compile takes only one *)
            let setFile = fun(arg: String): Ok
                begin
                    if compileMode andif not(stringOp.equal(file "")) then
                        writer.putString(writer.err "quest compile: error: multiple source files specified: '" <> file
                            <> "' and '" <> arg <> "'\n")
                        system.sysexit(1)
                    end
                    file := arg
                end
            (* An option of compile alone *)
            let compiling = fun(arg: String): Ok if not(compileMode) then usage(arg <> " is an option of compile") end
            (* A worker's command line is the worker's to read *)
            let var i = if workers.isUnitMode(system.args) then extent system.args elsif compileMode then 2 else 1 end
            while i < extent system.args do
                let arg = system.args[i]
                let valued = {i + 1} < extent system.args
                if isOneOf(arg array of "--stop-after" "--stop_after" end) andif valued then
                    stopAfter := system.args[i + 1]
                    stopGiven := true
                    i := i + 2
                elsif isOneOf(arg array of "--build-dir" "--build_dir" end) andif valued then
                    buildDir := maybe.some(:String system.args[i + 1])
                    i := i + 2
                elsif isOneOf(arg array of "--dump-after" "--dump_after" end) andif valued then
                    vector.append(:String dumpAfter system.args[i + 1])
                    i := i + 2
                elsif isOneOf(arg array of "-o" "--output" end) andif valued then
                    output := maybe.some(:String system.args[i + 1])
                    i := i + 2
                elsif isOneOf(arg array of "-I" "--include" end) andif valued then
                    vector.append(:String includePaths system.args[i + 1])
                    i := i + 2
                elsif isOneOf(arg array of "-c" "--compile-only" end) then
                    compileOnly := true
                    i := i + 1
                elsif isOneOf(arg array of "-v" "--verbose" end) then
                    verbose := true
                    i := i + 1
                elsif {stringOp.equal(arg "-j")} andif valued then
                    (* How many modules a build compiles at once *)
                    let n = strutil.tryToInt(system.args[i + 1])
                    if maybe.isNone(:Int n) orif {maybe.unwrap(:Int n) < 1} then
                        usage("-j takes a number of modules at least 1, not '" <> system.args[i + 1] <> "'")
                    end
                    jobs := maybe.unwrap(:Int n)
                    i := i + 2
                elsif isOneOf(arg array of "--whole-program" "--whole_program" end) then
                    wholeProgram := true
                    i := i + 1
                elsif stringOp.equal(arg "--backend") andif valued then
                    (* The backend every unit is compiled by (codegen/choice) *)
                    if not(choice.isBackend(system.args[i + 1])) then
                        usage("--backend takes c, ssac, or arm64, not '" <> system.args[i + 1] <> "'")
                    end
                    backend := system.args[i + 1]
                    backendGiven := true
                    i := i + 2
                elsif stringOp.equal(arg "--unit-backend") andif valued then
                    let o = choice.parseOverride(system.args[i + 1])
                    if maybe.isNone(:choice.Override o) then
                        usage("--unit-backend takes UNIT=BACKEND, with BACKEND c, ssac, or arm64, not '" <> system.args[i + 1]
                            <> "'")
                    end
                    vector.append(:choice.Override unitBackends maybe.unwrap(:choice.Override o))
                    i := i + 2
                elsif isOneOf(arg array of "--expected-exit" "--expected_exit" end) andif valued andif not(compileMode) then
                    (* What a compiled program's exit status must be; the
                     * interpreter's is the program's own *)
                    expectedExit := strutil.toInt(system.args[i + 1])
                    i := i + 2
                elsif isOneOf(arg array of "-e" "--eval" "--code" "--command" end) andif valued then
                    code := maybe.some(:String system.args[i + 1])
                    i := i + 2
                elsif stringOp.equal(arg "--show-offsets") andif not(compileMode) then
                    showOffsets := true
                    i := i + 1
                elsif stringOp.equal(arg "--show-values") andif not(compileMode) then
                    showValues := true
                    i := i + 1
                elsif stringOp.equal(arg "--echo") then
                    echo := true
                    i := i + 1
                elsif isOneOf(arg array of "--print-result" "--print_result" end) then
                    printResult := true
                    i := i + 1
                elsif isOneOf(arg array of "-i" "--interactive" end) andif not(compileMode) then
                    interactive := true
                    i := i + 1
                elsif stringOp.equal(arg "--kernel") andif not(compileMode) then
                    (* Requests from a Jupyter kernel instead of lines from a
                     * person (docs/jupyter-kernel.md) *)
                    kernel := true
                    i := i + 1
                elsif stringOp.equal(arg "--jit") andif not(compileMode) then
                    (* The program, or the REPL's inputs, compiled and run by
                     * the JIT, not interpreted (docs/jit.md) *)
                    jit := true
                    noJit := false
                    i := i + 1
                elsif stringOp.equal(arg "--no-jit") andif not(compileMode) then
                    (* Interpreted, where the JIT would be the default *)
                    jit := false
                    noJit := true
                    i := i + 1
                elsif stringOp.equal(arg "--emit-c") then
                    compiling(arg)
                    emitC := true
                    i := i + 1
                elsif stringOp.equal(arg "--nogc") then
                    compiling(arg)
                    nogc := true
                    i := i + 1
                elsif isOneOf(arg array of "-h" "--help" end) then
                    writer.putString(writer.output usageText)
                    system.sysexit(0)
                elsif isObjectFile(arg) then
                    vector.append(:String extraObjects if system.fileExists(arg) then files.absolute(arg) else arg end)
                    i := i + 1
                elsif {stringOp.length(arg) > 1} andif {stringOp.getChar(arg 0) is '-'} andif not(stringOp.equal(arg "--"))
                    then
                    usage("unknown option '" <> arg <> "'")
                elsif compileMode then
                    (* compile runs no program, so options may follow its file;
                     * after a --, every argument is a file *)
                    if stringOp.equal(arg "--") then
                        for j = {i + 1} upto {extent system.args - 1} do setFile(system.args[j]) end
                        i := extent system.args
                    else
                        setFile(arg)
                        i := i + 1
                    end
                elsif not(stringOp.equal(arg "--")) andif not(stringOp.equal(arg "-")) andif not(isProgramFile(arg)) then
                    (* Options may follow a unit file, which is compiled, not
                     * run *)
                    file := arg
                    i := i + 1
                else
                    (* The arguments after a -- or the program file are the
                     * program's *)
                    if not(stringOp.equal(arg "--")) then file := arg end
                    for j = {i + 1} upto {extent system.args - 1} do vector.append(:String programArgs system.args[j]) end
                    i := extent system.args
                end
            end
            (* Objects given without -o or a phase are linked with the program,
             * which runs compiled *)
            if not(compileMode) andif {vector.length(:String extraObjects) > 0} andif maybe.isNone(:String output)
                andif not(stopGiven) andif vector.empty(:String dumpAfter) then
                stopAfter := "run_c_compiled"
            end
            (* compile neither runs the program nor interprets it *)
            let allowed = fun(phase: String): Bool
                isOneOf(phase phases) andif not(compileMode andif {strutil.startsWith(phase "run_")
                    orif stringOp.equal(phase "interpret")})
            if not(allowed(stopAfter)) then usage("unknown phase '" <> stopAfter <> "'") end
            for j = 0 upto {vector.length(:String dumpAfter) - 1} do
                if not(allowed(vector.get(:String dumpAfter j))) then
                    usage("unknown phase '" <> vector.get(:String dumpAfter j) <> "'")
                end
            end
            (* codegen_arm64 compiles the program with arm64, unless a backend
             * is given (which must then be arm64, checked once the program's
             * backend is known) *)
            if {stringOp.equal(stopAfter "codegen_arm64") orif isOneOf("codegen_arm64" vector.toArray(:String dumpAfter))}
                andif not(backendGiven) then
                backend := "arm64"
            end
            (* and codegen_c, or compile --emit-c, with C, unless a backend is
             * given; compile's own last phase is codegen_c, which means only
             * that it writes the binary, through any backend *)
            if {{stopGiven andif stringOp.equal(stopAfter "codegen_c")}
                orif isOneOf("codegen_c" vector.toArray(:String dumpAfter)) orif emitC} andif not(backendGiven) then
                backend := "c"
            end
            (* With neither a file nor a program, the REPL starts on an empty
             * program at a terminal; otherwise standard input holds the
             * program, as it does for a file of - *)
            let noProgram = stringOp.equal(file "") andif maybe.isNone(:String code)
            let atTerminal = system.isTerminal(0)
            if kernel andif not(noProgram) then usage("--kernel takes neither FILE nor -e PROGRAM") end
            if compileMode andif noProgram andif atTerminal then usage("compile takes a FILE, -, or -e PROGRAM") end
            let fromStdin = stringOp.equal(file "-") orif {noProgram andif not(interactive) andif not(kernel)
                andif not(atTerminal)}
            let fromFile = not(stringOp.equal(file "")) andif not(fromStdin)
            tuple
                let stopAfter = stopAfter
                (* The program's name, as the bootstrap's diagnostics name it,
                 * and as system.args gives it *)
                let file = if maybe.isSome(:String code) then "<string>"
                    elsif fromStdin then "<stdin>"
                    elsif fromFile then file
                    else "<repl>" end
                let fromFile = fromFile
                let fromStdin = fromStdin
                let code = code
                let showOffsets = showOffsets
                let showValues = showValues
                let echo = echo
                let printResult = printResult
                let stopGiven = stopGiven
                let buildDir = buildDir
                let output = output
                let verbose = verbose
                let jobs = jobs
                let wholeProgram = wholeProgram
                let backends = tuple let default = backend let overrides = vector.toArray(:choice.Override unitBackends) end
                let expectedExit = expectedExit
                let dumpAfter = vector.toArray(:String dumpAfter)
                let extraObjects = vector.toArray(:String extraObjects)
                let includePaths = vector.toArray(:String includePaths)
                let interactive = interactive orif {noProgram andif atTerminal}
                let kernel = kernel
                (* A program run, a file's, -e's, or the REPL's inputs, runs on
                 * the JIT by default, unless an option asks for the
                 * interpreter's phases or output, or for a whole program, or
                 * this driver cannot host the JIT (docs/jit.md section 3.10) *)
                let jit = jit orif {not(noJit) andif not(compileMode) andif not(stopGiven)
                    andif stringOp.equal(stopAfter "interpret") andif {extent dumpAfter is 0} andif not(showOffsets)
                    andif not(showValues) andif not(wholeProgram) andif maybe.isNone(:String session.refusal())}
                let programArgs = vector.toArray(:String programArgs)
                let compileOnly = compileOnly
                let emitC = emitC
                let nogc = nogc
            end
        end
end
