(* Quest Self-Hosted Compiler: The JIT Session Implementation *)

module session : Session
import
    ascii : Ascii
    conv : Conv
    raised : Raised
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/location : questlang/common/Location
    questlang/common/maps : questlang/common/Maps
    questlang/ir/lower : questlang/ir/Lower
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/verify : questlang/ir/Verify
    questlang/jit/target : questlang/jit/Target
    questlang/modules/artifacts/fingerprint : questlang/modules/artifacts/Fingerprint
    questlang/modules/artifacts/moduleCompiler : questlang/modules/artifacts/ModuleCompiler
    questlang/modules/elaboration : questlang/modules/Elaboration
    questlang/modules/graph : questlang/modules/Graph
    questlang/typechecker/typecheck : questlang/typechecker/Typecheck
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
    tm = questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
export
    Let T = Tuple
        e: env.T
        target: target.T
        var count: Int
        (* The bindings of the inputs that ran, by symbol *)
        earlier: maps.IntMap(lower.Earlier)
        (* The source of each input, by the name its code gives it (<repl>#N),
         * and of each module file loaded, by its own *)
        sources: maps.StringMap(location.SourceMap)
        (* The module files loaded, by canonical name, and those the input
         * running loaded *)
        loaded: maps.StringMap(Bool)
        loadedNow: vector.T(String)
    end
    Let Outcome = Option
        ran with shown: Array(String) end
        raised with
            name: String
            sourceMap: maybe.T(location.SourceMap)
            offset: maybe.T(Int)
            frames: Array(String)
            fatal: Bool
        end
    end

    let unsupported: Exception(String) = target.unsupported
    let fail(A::TYPE m: String): A = raise unsupported with m end

    let refusal(): maybe.T(String) = target.refusal()

    let new(e: env.T args: Array(String)): T =
        begin
            let sources = maps.newStringMap(:location.SourceMap)
            tuple
                let e = e
                let target = target.new(e args sources)
                let var count = 0
                let earlier = maps.newIntMap()
                let sources = sources
                let loaded = maps.newStringMap()
                let loadedNow = vector.new()
            end
        end

    let finish(s: T): Ok = target.finish(s.target)

    (* The value symbols an input binds at its top level, which its record
     * holds (as lowerPhrases makes it): not a redefinition's, which stores to
     * an earlier slot's box *)
    let boundSymbols(program: typedAst.Program): vector.T(symbols.ValueSymbol) =
        begin
            let found = vector.new(:symbols.ValueSymbol)
            for i = 0 upto {extent program.phrases - 1} do
                let phrase = program.phrases[i]
                case phrase.form
                    when bindLetValue with x then
                        if not(x.value.redefines) then vector.append(found x.value.symbol) end
                    when bindLetValueGroup with x then
                        for j = 0 upto {extent x.members - 1} do
                            if not(x.members[j].redefines) then
                                vector.append(found x.members[j].symbol)
                            end
                        end
                    else ok
                end
                (* And the exception it declares *)
                let exc = typedAst.declaredException(phrase)
                if maybe.isSome(exc) then
                    case maybe.unwrap(exc).form
                        when exprException with y then vector.append(found maybe.unwrap(y.symbol))
                        else ok
                    end
                end
            end
            found
        end

    (* An input's code names its source <repl>#N, N its number, so that the
     * site of a raise in it, file:line:col, says which input it is in; a
     * module file's names its file *)
    let sourcePrefix = "<repl>#"

    (* The decimal number text is, if it is one *)
    let number(text: String): maybe.T(Int) =
        begin
            let var n = 0
            let var valid = stringOp.length(text) > 0
            for i = 0 upto {stringOp.length(text) - 1} do
                let d = ascii.val(stringOp.getChar(text i)) - 48
                if {d < 0} orif {d > 9} then valid := false else n := {10 * n} + d end
            end
            if valid then maybe.some(n) else maybe.none() end
        end

    (* Where a site, FILE:LINE:COL, is: the source of the input or module file
     * FILE names, and the offset of its line and column in it *)
    let located(s: T site: String): Tuple sourceMap: maybe.T(location.SourceMap) offset: maybe.T(Int) end =
        begin
            let nowhere = tuple let sourceMap = maybe.none(:location.SourceMap) let offset = maybe.none(:Int) end
            let last = strutil.rfind(site ":")
            let before = if last > 0 then strutil.rfind(stringOp.getSub(site 0 last) ":") else ~1 end
            if before < 0 then
                nowhere
            else
                let found = hashMap.get(s.sources stringOp.getSub(site 0 before))
                let line = number(stringOp.getSub(site before + 1 {last - before} - 1))
                let col = number(stringOp.getSub(site last + 1 {stringOp.length(site) - last} - 1))
                if maybe.isNone(found) orif maybe.isNone(line) orif maybe.isNone(col) then
                    nowhere
                else
                    let text = location.text(maybe.unwrap(found))
                    let var offset = 0
                    let var lines = 1
                    while {lines < maybe.unwrap(line)} andif {offset < stringOp.length(text)} do
                        if stringOp.getChar(text offset) is '\n' then lines := lines + 1 end
                        offset := offset + 1
                    end
                    tuple let sourceMap = found let offset = maybe.some(offset + maybe.unwrap(col) - 1) end
                end
            end
        end

    (* A module of the driver's own that an input or a module file imports is
     * the driver's copy (docs/jit.md section 3.3), whose interface must be the
     * one the driver was built with: its fingerprint, qh_, is that of the
     * interface the import was compiled against. One the driver lacks was
     * loaded before (section 3.4). *)
    let checkImport(s: T imp: nodes.Import): Ok =
        if strutil.startsWith(imp.canonicalPath "qj_") orif {stringOp.length(imp.interfacePath) is 0}
                orif hashMap.contains(s.loaded imp.canonicalPath) then
            ok
        else
            let built = target.fingerprint(s.target imp.canonicalPath)
            if not(target.has(s.target imp.canonicalPath)) then
                fail(:Ok "module '" <> imp.canonicalPath <> "' is neither in the driver nor loaded")
            end
            if not(stringOp.equal(built fingerprint.ofInterface(imp.interfacePath s.e))) then
                fail(:Ok "the driver was built from another version of the interface of module '" <> imp.canonicalPath
                    <> "'; rebuild the driver (./quest rebuilds it)")
            end
        end

    (* A unit checked, compiled, and loaded; the modules it imports are the
     * driver's or loaded *)
    let compileAndLoad(s: T unit: nodes.Unit): Ok =
        begin
            if verify.irChecksEnabled() then
                try verify.checkUnit(unit) when verify.verifyError with x then fail(:Ok x) end
            end
            for i = 0 upto {extent unit.imports - 1} do checkImport(s unit.imports[i]) end
            target.load(s.target unit)
        end

    (* body, with an error it raises in another file than file labeled as
     * imported at offset in file, as env.atImport labels the errors of the
     * units the type checker loads *)
    let importedAt(body: All() Ok offset: Int file: String): Ok =
        try
            body()
        when diagnostics.compilerError with err then
            diagnostics.raiseError(diagnostics.atImport(err offset 1 file))
        end

    (* Compiles and loads a module file that is not linked into the driver,
     * once per session, after recursively loading its own imports (docs/jit.md
     * section 3.4). Its initializer runs when an importer first executes. The
     * module is elaborated with typecheck.install so that member errors are
     * raised immediately rather than recorded in the REPL input's checker, and
     * the previous elaboration hook is restored afterwards even on error. *)
    let rec loadModuleFile(s: T canonical: String source: String): Ok =
        if target.has(s.target canonical) orif hashMap.contains(s.loaded canonical) then
            ok
        else
            let e = s.e
            let saved = elaboration.hooks.elaborateBinding
            typecheck.install()
            let m =
                try
                    moduleCompiler.moduleFileUnit(source vector.toArray(e.includePaths) e.buildDir e.programDir
                            maybe.some(e.units.resolver))
                else with r then
                    elaboration.hooks.elaborateBinding := saved
                    raised.reraise(:moduleCompiler.ModuleUnit r)
                end
            elaboration.hooks.elaborateBinding := saved
            for i = 0 upto {extent m.imports - 1} do
                let imp = m.imports[i]
                importedAt(fun(): Ok loadModuleFile(s imp.name imp.source) imp.offset location.file(m.sourceMap))
            end
            compileAndLoad(s m.unit)
            hashMap.insert(s.sources location.file(m.sourceMap) m.sourceMap)
            hashMap.insert(s.loaded canonical true)
            vector.append(s.loadedNow canonical)
        end

    (* The offset of the import item in program that imports the module
     * canonical, if one does *)
    let importOffset(program: typedAst.Program canonical: String): maybe.T(Int) =
        begin
            let var found = maybe.none(:Int)
            for i = 0 upto {extent program.phrases - 1} do
                case program.phrases[i].form
                    when bindImport with x then
                        for k = 0 upto {extent x.items - 1} do
                            let item = x.items[k]
                            let paths = typedAst.effectiveCanonicalModulePaths(item)
                            for j = 0 upto {extent paths - 1} do
                                if maybe.isNone(found) andif stringOp.equal(paths[j] canonical) then
                                    found := maybe.some(item.offset)
                                end
                            end
                        end
                    else ok
                end
            end
            found
        end

    (* The module an input (program, in file) imports, if the driver does not
     * link it; an error compiling it is labeled as imported where program
     * imports it *)
    let loadImported(s: T imp: nodes.Import program: typedAst.Program file: String): Ok =
        if strutil.startsWith(imp.canonicalPath "qj_") orif {stringOp.length(imp.interfacePath) is 0}
                orif target.has(s.target imp.canonicalPath)
                orif hashMap.contains(s.loaded imp.canonicalPath) then
            ok
        else
            let source = env.resolveModule(s.e imp.canonicalPath).source
            if maybe.isNone(source) then
                fail(:Ok "module '" <> imp.canonicalPath <> "' is not in the driver, and has no source to compile")
            end
            let load = fun(): Ok loadModuleFile(s imp.canonicalPath maybe.unwrap(source))
            let site = importOffset(program imp.canonicalPath)
            if maybe.isSome(site) then importedAt(load maybe.unwrap(site) file) else load() end
        end

    (* Records a module in s.earlier so later inputs can reference it: imported
     * modules by the record the unit imported, and declared modules by the
     * record the unit exported. Its entry has an empty field name because the
     * module's value is the holder's entire record rather than a field of it.
     * rememberImport records each imported module named by item;
     * rememberModule records a module declared in unit. *)
    let remember(s: T symbolId: Int holder: String recordType: tm.Type): Ok =
        begin
            hashMap.insert(s.earlier symbolId tuple
                let holder = holder
                let field = ""
                let recordType = recordType
                let isVar = false
                let boxed = false
            end)
            ok
        end
    let rememberImport(s: T unit: nodes.Unit item: typedAst.ImportItem): Ok =
        if maybe.isSome(item.symbolIds) then
            let ids = maybe.unwrap(item.symbolIds)
            let canonical = typedAst.effectiveCanonicalModulePaths(item)
            for j = 0 upto {extent ids - 1} do
                for u = 0 upto {extent unit.imports - 1} do
                    let imp = unit.imports[u]
                    if maybe.isSome(ids[j]) andif {j < extent canonical}
                            andif stringOp.equal(imp.canonicalPath canonical[j]) andif maybe.isSome(imp.recordType) then
                        remember(s maybe.unwrap(ids[j]) imp.canonicalPath maybe.unwrap(imp.recordType))
                    end
                end
            end
        end
    let rememberModule(s: T unit: nodes.Unit symbolId: Int moduleName: String): Ok =
        for j = 0 upto {vector.length(unit.modules) - 1} do
            let dm = vector.get(unit.modules j)
            if stringOp.equal(dm.name moduleName) andif maybe.isSome(dm.recordVar) then
                remember(s symbolId moduleName maybe.unwrap(dm.recordVar).type)
            end
        end

    (* What each phrase showed, from the text an input captured: after each
     * separator line, the lines up to the next, without their last newline *)
    let shownByPhrase(text: String): Array(String) =
        begin
            let parts = strutil.split(text lower.phraseSeparator <> "\n")
            let shown = vector.new(:String)
            for i = 1 upto {vector.length(parts) - 1} do
                let p = vector.get(parts i)
                vector.append(shown
                        if strutil.endsWith(p "\n") then stringOp.getSub(p 0 stringOp.length(p) - 1) else p end)
            end
            vector.toArray(shown)
        end

    (* Performs run's work without rolling back newly loaded modules on
     * failure. Assigns the input the next number N (module qj_N, source name
     * <repl>#N so located can map raise sites back to sourceMap), lowers it
     * against prior bindings in s.earlier, loads any unlinked imported
     * modules, and compiles and loads the unit via target. target.run then
     * executes the entry under an exception-catching handler: on exception,
     * bindings are not recorded and a raised outcome is returned; on success,
     * top-level bindings (excluding redefinitions, which store into an earlier
     * input's box) and declared or imported modules are recorded in s.earlier
     * for later inputs. Raises unsupported if lowering, compilation, or
     * loading fails. *)
    let runInput(s: T program: typedAst.Program sourceMap: location.SourceMap echo: Bool printResult: Bool
            capture: Bool): Outcome =
        begin
            s.count := s.count + 1
            let number = s.count
            let name = lower.phraseModuleName(number)
            hashMap.insert(s.sources sourcePrefix <> conv.int(number) sourceMap)
            let compiled = location.newSourceMap(sourcePrefix <> conv.int(number) location.text(sourceMap))
            let unit =
                try lower.lowerPhrases(program s.e maybe.some(compiled) number s.earlier echo
                        printResult capture)
                when lower.loweringError with m then fail(:nodes.Unit m)
                end
            for i = 0 upto {extent unit.imports - 1} do
                loadImported(s unit.imports[i] program location.file(sourceMap))
            end
            (* The input's own module, qj_N, which lowerPhrases puts after
             * the modules the input declares *)
            let m = vector.get(unit.modules vector.length(unit.modules) - 1)
            let recordType = maybe.unwrap(m.recordVar).type
            compileAndLoad(s unit)
            case target.run(s.target name capture)
                when raised with r then
                    begin
                        let where = located(s r.site)
                        option raised of Outcome with
                            let name = r.name
                            let sourceMap = where.sourceMap
                            let offset = where.offset
                            let frames = r.frames
                            let fatal = r.fatal
                        end
                    end
                when ran with x then
                    begin
                        let shown = if capture then shownByPhrase(x.shown) else array of :String end end
                        (* Its bindings, for the inputs after it *)
                        let bound = boundSymbols(program)
                        for i = 0 upto {vector.length(bound) - 1} do
                            let sym = vector.get(bound i)
                            hashMap.insert(s.earlier sym.symbolId tuple
                                let holder = name
                                let field = lower.phraseField(sym.symbolId)
                                let recordType = recordType
                                let isVar = sym.isVar
                                let boxed = lower.boxesSlot(s.e sym)
                            end)
                        end
                        (* And the modules it declared and imported *)
                        for i = 0 upto {extent program.phrases - 1} do
                            case program.phrases[i].form
                                when bindImport with x then
                                    for k = 0 upto {extent x.items - 1} do rememberImport(s unit x.items[k]) end
                                when bindModule with x then
                                    if maybe.isSome(x.symbolId) then
                                        rememberModule(s unit maybe.unwrap(x.symbolId) name <> "_" <> x.name)
                                    end
                                else ok
                            end
                        end
                        option ran of Outcome with let shown = shown end
                    end
            end
        end

    (* An input that fails forgets the module files it loaded, as the
     * interpreter forgets the modules it ran: a later import loads them
     * again, afresh (docs/jit.md section 3.4) *)
    let run(s: T program: typedAst.Program sourceMap: location.SourceMap echo: Bool printResult: Bool capture: Bool):
            Outcome =
        begin
            vector.clear(s.loadedNow)
            let forget = fun(): Ok
                for i = 0 upto {vector.length(s.loadedNow) - 1} do
                    begin hashMap.delete(s.loaded vector.get(s.loadedNow i)) ok end
                end
            let outcome =
                try
                    runInput(s program sourceMap echo printResult capture)
                else with r then
                    forget()
                    raised.reraise(:Outcome r)
                end
            if outcome?raised then forget() end
            outcome
        end
end
