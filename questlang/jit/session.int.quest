(* Quest Self-Hosted Compiler: The JIT Session Interface
 *
 * This module manages a REPL JIT session, compiling each input into native or
 * WebAssembly code through jit/target instead of interpreting it (docs/jit.md
 * section 3). Each input is lowered as a phrase unit (ir/lower's
 * lowerPhrases), compiled and loaded by jit/target, and executed under an
 * exception-catching handler. Phrase results are printed by the runtime as
 * they run or captured for the REPL, and top-level bindings are stored in the
 * input's module record so later inputs can read them as fields. Any imported
 * module not already linked into the driver is compiled from source and loaded
 * once per session before the input runs (docs/jit.md section 3.4). *)

interface Session
import
    util/maybe : util/Maybe

    questlang/common/location : questlang/common/Location
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
export
    T::TYPE

    (* What cannot be compiled or loaded, naming it *)
    unsupported: Exception(String)

    (* Why this driver cannot host the JIT, if it cannot: its modules carry no
     * fingerprints (docs/jit.md section 3.10) *)
    refusal(): maybe.T(String)
    (* A session whose inputs are elaborated in e, and whose programs see args
     * as system.args *)
    new(e: env.T args: Array(String)): T

    (* The outcome of running a JIT input. ran carries each phrase's captured
     * output (empty for a phrase that prints nothing). raised carries the
     * exception name, optional source map and byte offset of the raise site,
     * and stack frames from most recent down to the input's own; when fatal is
     * true, it represents a fatal runtime error with its message in name. *)
    Def Outcome = Option
        ran with shown: Array(String) end
        raised with
            name: String
            sourceMap: maybe.T(location.SourceMap)
            offset: maybe.T(Int)
            frames: Array(String)
            fatal: Bool
        end
    end

    (* Compiles, loads, and runs program, which was typechecked in the
     * session's environment from sourceMap; its bindings become visible to
     * later inputs only if execution succeeds. Phrase results are formatted
     * with the runtime's printers (docs/jit.md section 3.8): echo prints every
     * phrase, printResult prints the last, and capture returns the output
     * instead of writing it immediately. *)
    run(s: T program: typedAst.Program sourceMap: location.SourceMap echo: Bool printResult: Bool capture: Bool):
            Outcome

    (* Ends a session: removes the files holding its inputs' sources, which it
     * wrote for a debugger (docs/jit.md section 3.12) *)
    finish(s: T): Ok
end
