(* Quest Self-Hosted Compiler: The JIT Session Interface
 *
 * docs/jit.md section 3: the REPL's inputs compiled to arm64 code in the
 * driver's own process, loaded (jit/loader), and run, instead of interpreted.
 * Each input is a phrase unit (ir/lower's lowerPhrases): the arm64 backend's
 * pipeline compiles it, codegen/arm64/encode encodes it, and its entry runs
 * under a handler that catches every exception. Its phrases' results are
 * printed by the runtime as they run, as a compiled program prints them, or
 * captured for the REPL; its bindings stay in its record for later inputs,
 * which read them as the record's fields. The module files an input imports
 * that the driver does not link are compiled from source and loaded first,
 * once in a session (docs/jit.md section 3.4). *)

interface Session
import
    questlang/common/location : questlang/common/Location
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    util/maybe : util/Maybe
export
    T::TYPE

    (* What cannot be compiled or loaded, naming it *)
    unsupported: Exception(String)

    (* Why this driver cannot host the JIT, if it cannot: its modules carry no
     * fingerprints (docs/jit.md section 3.10) *)
    refusal(): maybe.T(String)
    (* A session whose inputs are elaborated in e, and whose programs see args
     * as system.args *)
    new(e: env.T args: Array(String)): T

    (* What an input came to: what each of its phrases showed, if they were
     * captured (as interpret shows a phrase, its lines after the first
     * continuing it; empty for a phrase that shows nothing), or the exception
     * it raised: its name, where it was raised (the source of the input whose
     * code raised it, and the offset in it), if known, and the frames running
     * there, most recent first, down to the input's own *)
    Def Outcome = Option
        ran with shown: Array(String) end
        raised with
            name: String
            sourceMap: maybe.T(location.SourceMap)
            offset: maybe.T(Int)
            frames: Array(String)
        end
    end

    (* Compiles, loads, and runs an input, typed in the session's
     * environment from the source sourceMap holds; its bindings are known to
     * later inputs only if it ran. Its phrases show their results as a
     * program's do, with the runtime's printers (docs/jit.md section 3.8):
     * with echo every phrase's, with printResult the last's; written as they
     * run, or with capture, returned *)
    run(s: T program: typedAst.Program sourceMap: location.SourceMap echo: Bool printResult: Bool capture: Bool):
        Outcome
end
