(* Quest Self-Hosted Compiler: The JIT's Target Interface
 *
 * This interface abstracts the target-specific operations that jit/session
 * needs (docs/jit.md section 3; docs/wasm.md section 6.1): compiling and
 * loading a unit alongside the driver, invoking an input's entry point, and
 * querying the driver's built-in modules and interface fingerprints. The build
 * selects the implementation via module variants (docs/build-process.md
 * section 6.4): the default implementation compiles to arm64 and loads into
 * the driver's process (os/code, jit/loader), the wasm variant compiles to
 * WebAssembly and delegates loading and execution to the host, and the none
 * variant disables the JIT so the driver falls back to interpretation. *)

interface Target
import
    questlang/common/location : questlang/common/Location
    questlang/types/env : questlang/types/Env
    questlang/ir/nodes : questlang/ir/Nodes
    collections/hashMap : collections/HashMap
    util/maybe : util/Maybe
export
    T::TYPE

    (* What cannot be compiled, loaded, or run, naming it *)
    unsupported: Exception(String)

    (* Why this driver cannot host the JIT, if it cannot *)
    refusal(): maybe.T(String)
    (* A target whose inputs are elaborated in e, whose programs see args as
     * system.args, and whose sources (the session's, by the names their code
     * gives them) it may show a debugger *)
    new(e: env.T args: Array(String) sources: hashMap.T(String location.SourceMap)): T

    (* Whether the driver has the module canonical, and the fingerprint of the
     * interface it was built with (docs/jit.md section 3.3.1), "" if none *)
    has(t: T canonical: String): Bool
    fingerprint(t: T canonical: String): String

    (* Compiles a unit, which the IR's checks have passed, and loads it after
     * those loaded before; the modules it imports are the driver's or loaded *)
    load(t: T unit: nodes.Unit): Ok

    (* The outcome of executing an input's entry point. ran carries captured
     * phrase output. raised carries the exception name, raise site
     * (FILE:LINE:COL), and stack frames from most recent down to the input's
     * <main>; when fatal is true, it represents a fatal runtime error with its
     * message in name (docs/exceptions.md section 2.2). *)
    Def Ran = Option
        ran with shown: String end
        raised with name: String site: String frames: Array(String) fatal: Bool end
    end
    (* Runs the entry of input name (qj_N), the last unit loaded *)
    run(t: T name: String capture: Bool): Ran

    (* Ends a target: removes what it wrote for a debugger *)
    finish(t: T): Ok
end
