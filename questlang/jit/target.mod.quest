(* Quest Self-Hosted Compiler: The JIT's Target Implementation, for arm64
 *
 * This is the default (arm64) variant of jit/target used by native builds.
 * It compiles each unit through the arm64 backend, encodes machine code
 * (codegen/arm64/encode), loads it into the driver's process (jit/loader),
 * and invokes each input's entry point under an exception-catching handler
 * (os/code). *)

unsound module target : Target
import
    ascii : Ascii
    conv : Conv
    stringOp = string : StringOp
    system : System
    words = word : Word
    writer : Writer

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    os/code : os/Code
    os/value : os/Value
    util/maybe : util/Maybe
    util/sort : util/Sort
    util/stringBuilder : util/StringBuilder
    util/strutil : util/Strutil

    arm64 = questlang/codegen/arm64/codegen : questlang/codegen/arm64/Codegen
    questlang/codegen/arm64/encode : questlang/codegen/arm64/Encode
    questlang/common/files : questlang/common/Files
    questlang/common/location : questlang/common/Location
    questlang/common/maps : questlang/common/Maps
    questlang/ir/nodes : questlang/ir/Nodes
    passes = questlang/ir/pipeline : questlang/ir/Pipeline
    questlang/jit/debugObject : questlang/jit/DebugObject
    questlang/jit/loader : questlang/jit/Loader
    questlang/modules/elaboration : questlang/modules/Elaboration
    questlang/repr/runtimeLayout : questlang/repr/RuntimeLayout
    questlang/repr/shapes : questlang/repr/Shapes
    mangling = questlang/repr/symbols : questlang/repr/Symbols
    ssaBuild = questlang/ssa/build : questlang/ssa/Build
    ssaPipeline = questlang/ssa/pipeline : questlang/ssa/Pipeline
    ssaVerify = questlang/ssa/verify : questlang/ssa/Verify
    questlang/types/env : questlang/types/Env
export
    Let T = Tuple
        e: env.T
        loader: loader.T
        (* The session's sources, by name, for a debugger *)
        sources: maps.StringMap(location.SourceMap)
        (* The symbols of the unit loaded last, its own and those it exports *)
        var symbols: maps.StringMap(value.T)
        (* Whether the session describes its code to a debugger
         * (QUEST_JIT_DEBUG=1, docs/jit.md section 3.12), and what it
         * described: the objects and their list entries, kept for as long as
         * the code is, and the directory and files holding inputs' sources *)
        debugging: Bool
        described: vector.T(String)
        var sourceDir: String
        sourceFiles: vector.T(String)
    end
    Let Ran = Option
        ran with shown: String end
        raised with name: String site: String frames: Array(String) fatal: Bool end
    end

    let unsupported: Exception(String) = exception unsupported: String end
    let fail(A::TYPE m: String): A = raise unsupported with m end

    (* The number text is, as decimal digits, if it is one *)
    let number(text: String): maybe.T(Int) =
        begin
            let var n = 0
            let var valid = stringOp.length(text) > 0
            for i = 0 upto {stringOp.length(text) - 1} do
                let d = ascii.val(stringOp.getChar(text i)) - 48
                if {d < 0} orif {d > 9} then valid := false else n := {10 * n} + d end
            end
            if valid then maybe.some(n) else maybe.none() end
        end

    (* An input's code names its source <repl>#N *)
    let sourcePrefix = "<repl>#"

    (* The arena: every bl within 128 MB reaches *)
    let codeBytes = 134217728
    let dataBytes = 67108864

    (* Updates both the runtime's argument array and the args field of the
     * driver's already-initialized system module record (located by its
     * alphabetical field index in the System interface) *)
    let setArgs(e: env.T args: Array(String)): Ok =
        begin
            code.setArgs(args)
            let at = code.symbol("qm_system")
            if maybe.isSome(at) then
                let scope = elaboration.loadInterface("System" e)
                let names = hashMap.keys(scope.values)
                let var index = 0
                for i = 0 upto {vector.length(names) - 1} do
                    if sort.stringCompare(vector.get(names i) "args") < 0 then index := index + 1 end
                end
                let systemRecord = maybe.unwrap(at)
                let offset = value.be(:Int value.fetch(value.fetch(systemRecord 8) 8 * index))
                value.store(value.fetch(systemRecord 0) offset value.new(args))
            end
        end

    (* A driver whose modules carry fingerprints (docs/jit.md section 3.10):
     * this one's own JIT module does if any does *)
    let hostSymbol = mangling.fingerprintIdent(mangling.mangleModuleName("questlang/jit/target"))

    let refusal(): maybe.T(String) =
        if maybe.isSome(code.symbol(hostSymbol)) then maybe.none()
        else maybe.some("this driver cannot host the JIT: its modules carry no fingerprints (a whole-program "
            <> "build drops them)")
        end

    let new(e: env.T args: Array(String) sources: maps.StringMap(location.SourceMap)): T =
        begin
            setArgs(e args)
            tuple
                let e = e
                let loader = loader.new(codeBytes dataBytes)
                let sources = sources
                let var symbols = maps.newStringMap()
                let debugging = stringOp.equal(system.getEnv("QUEST_JIT_DEBUG") "1")
                let described = vector.new()
                let var sourceDir = ""
                let sourceFiles = vector.new()
            end
        end

    (* Parses the runtime's stack-trace text to extract frames belonging to the
     * JIT input, stopping at os/code.call (or jit/target.run,
     * jit/session.runInput, or jit/session.run when a C-built driver elides
     * call's frame). Each frame line has the form "  in NAME", with
     * consecutive duplicates summarized as "  ... NAME repeated N more times".
     * Appends <main> as the bottom frame if it is not already present. *)
    let framesOf(text: String): Array(String) =
        begin
            let frames = vector.new(:String)
            let lines = strutil.split(text "\n")
            let var done = false
            for i = 0 upto {vector.length(lines) - 1} do
                let line = vector.get(lines i)
                if stringOp.equal(line "  in os/code.call")
                        orif stringOp.equal(line "  in questlang/jit/target.run")
                        orif stringOp.equal(line "  in questlang/jit/session.runInput")
                        orif stringOp.equal(line "  in questlang/jit/session.run") then
                    done := true
                end
                if done then
                    ok
                elsif strutil.startsWith(line "  in ") then
                    vector.append(frames stringOp.getSub(line 5 stringOp.length(line) - 5))
                elsif strutil.startsWith(line "  ... ") andif strutil.endsWith(line " more times") then
                    let rest = stringOp.getSub(line 6 stringOp.length(line) - 17)
                    let at = strutil.rfind(rest " repeated ")
                    let count = if at > 0 then number(stringOp.getSub(rest at + 10 {stringOp.length(rest) - at} - 10))
                        else maybe.none(:Int) end
                    if maybe.isSome(count) then
                        let name = stringOp.getSub(rest 0 at)
                        for k = 1 upto maybe.unwrap(count) do vector.append(frames name) end
                    end
                end
            end
            let n = vector.length(frames)
            if {n is 0} orif not(stringOp.equal(vector.get(frames n - 1) "<main>")) then
                vector.append(frames "<main>")
            end
            vector.toArray(frames)
        end

    (* The C string of n characters at a symbol's address, read a word at a
     * time, since fetch takes aligned addresses *)
    let cString(at: value.T n: Int): String =
        begin
            let start = value.be(:Int at)
            let b = stringBuilder.new()
            for i = 0 upto {n - 1} do
                let addr = start + i
                let w = value.be(:words.T value.fetch(value.new(addr - {addr % 8}) 0))
                stringBuilder.char(b ascii.char(words.toInt(words.extract(w 8 * {addr % 8} 8))))
            end
            stringBuilder.toString(b)
        end

    (* Whether the driver links the module canonical names *)
    let has(t: T canonical: String): Bool =
        maybe.isSome(code.symbol(mangling.moduleRecordIdent(mangling.mangleModuleName(canonical))))

    let symbolAt(symbols: maps.StringMap(value.T) name: String): value.T =
        begin
            let found = hashMap.get(symbols name)
            if maybe.isNone(found) then raise unsupported with "the unit defines no " <> name end end
            maybe.unwrap(found)
        end

    (* The GDB JIT interface's descriptor and the function a debugger breaks
     * on, which the runtime defines (quest_code.c), if the driver has them *)
    let descriptorSymbol = "__jit_debug_descriptor"
    let breakSymbol = "__jit_debug_register_code"

    (* A string's characters' address: its QString's data, at the offset the
     * runtime's layout gives, since this compiler runs on that runtime *)
    let bytesOf(text: String): value.T = value.fetch(value.new(text) runtimeLayout.offset("QString" "data"))
    let word(n: Int): value.T = value.new(n)

    (* Adds object to the interface's list of objects, as its first, and
     * calls the function a debugger breaks on, with the action JIT_REGISTER_FN
     * (1). Its entry, of the next and previous entries, the object's address,
     * and its size, is a string's bytes. *)
    let register(t: T object: String): Ok =
        begin
            let descriptor = code.symbol(descriptorSymbol)
            let breaks = code.symbol(breakSymbol)
            if maybe.isSome(descriptor) andif maybe.isSome(breaks) then
                let d = maybe.unwrap(descriptor)
                let holder = stringOp.new(32 ascii.char(0))
                vector.append(t.described object)
                vector.append(t.described holder)
                let entry = bytesOf(holder)
                let first = value.fetch(d 16)
                value.store(entry 0 first)
                value.store(entry 8 word(0))
                value.store(entry 16 bytesOf(object))
                value.store(entry 24 word(stringOp.length(object)))
                if value.be(:Int first) isnot 0 then value.store(first 8 entry) end
                value.store(d 16 entry)
                value.store(d 8 entry)
                (* version 1, action 1 *)
                value.store(d 0 word(4294967297))
                code.call(maybe.unwrap(breaks))
                ok
            end
        end

    (* Writes source text that has no backing file on disk to a file named name
     * inside a session-specific temporary directory under TMPDIR (cleaned up
     * by finish), and returns its path *)
    let writeSource(t: T name: String text: String): String =
        begin
            if stringOp.length(t.sourceDir) is 0 then
                (* Name the directory using a hash of a process address (which
                 * concurrent drivers rarely share) plus the first unused -N
                 * suffix *)
                let tmp = system.getEnv("TMPDIR")
                let base = files.join(if stringOp.length(tmp) > 0 then tmp else "/tmp" end
                        "quest-jit-" <> conv.int(value.be(bytesOf(name)) % 1000000007))
                let var n = 0
                while system.isDirectory(base <> "-" <> conv.int(n)) do n := n + 1 end
                t.sourceDir := base <> "-" <> conv.int(n)
                system.makeDirectory(t.sourceDir)
            end
            let path = files.join(t.sourceDir name)
            let w = writer.file(path)
            writer.putString(w text)
            writer.close(w)
            vector.append(t.sourceFiles path)
            path
        end

    let finish(t: T): Ok =
        begin
            for i = 0 upto {vector.length(t.sourceFiles) - 1} do
                try system.removeFile(vector.get(t.sourceFiles i)) when system.error then ok end
            end
            if stringOp.length(t.sourceDir) > 0 then
                try system.removeDirectory(t.sourceDir) when system.error then ok end
            end
        end

    (* Returns the on-disk path a debugger should use for file: a REPL input
     * (<repl>#N) uses its backing file if one exists or is written to
     * input-N.quest via writeSource; a module file uses its own path *)
    let debugFile(t: T file: String): String =
        begin
            let slash = strutil.rfind(file "/")
            let base = stringOp.getSub(file slash + 1 {stringOp.length(file) - slash} - 1)
            let original =
                if strutil.startsWith(base sourcePrefix) then
                    hashMap.get(t.sources base)
                else
                    maybe.none(:location.SourceMap)
                end
            if maybe.isNone(original) then
                file
            else
                let sm = maybe.unwrap(original)
                let named = files.absolute(location.file(sm))
                if system.isFile(named) then named
                else writeSource(t "input-" <> stringOp.getSub(base stringOp.length(sourcePrefix)
                        {stringOp.length(base) - stringOp.length(sourcePrefix)}) <> ".quest" location.text(sm))
                end
            end
        end

    (* A unit loaded, described to a debugger, if the session describes its
     * code (docs/jit.md section 3.12) *)
    let describe(t: T e: encode.Encoded symbols: maps.StringMap(value.T)): Ok =
        if t.debugging andif {extent e.functions > 0} then
            let start = value.be(symbolAt(symbols e.functions[0].name)) - e.functions[0].offset
            let files = array of(extent e.files "")
            for i = 0 upto {extent files - 1} do files[i] := debugFile(t e.files[i]) end
            register(t debugObject.object(e start files))
        end

    let fingerprint(t: T canonical: String): String =
        begin
            let found = code.symbol(mangling.fingerprintIdent(mangling.mangleModuleName(canonical)))
            if maybe.isSome(found) then cString(maybe.unwrap(found) 64) else "" end
        end

    let load(t: T unit: nodes.Unit): Ok =
        begin
            let encoded =
                try
                    (* The passes hold a pointer and a QVal word alike, as
                     * arm64 does (choice.referencesAlike) *)
                    shapes.setReferencesAlike(true)
                    let built = ssaPipeline.build(passes.runPasses(unit) arm64.ssaPolicy)
                    ssaPipeline.lower(built)
                    arm64.encodeUnit(built)
                (* Convert IR, SSA, arm64, and encoding failures into
                 * unsupported *)
                when nodes.irError with x then fail(:encode.Encoded x)
                when ssaBuild.unsupported with x then fail(:encode.Encoded "ssa: unsupported: " <> x)
                when ssaVerify.verifyError with x then fail(:encode.Encoded x)
                when arm64.unsupported with x then fail(:encode.Encoded x)
                when encode.unencodable with x then fail(:encode.Encoded "encoding: " <> x)
                end
            let symbols =
                try loader.load(t.loader encoded)
                when loader.loadError with x then fail(:maps.StringMap(value.T) x)
                end
            describe(t encoded symbols)
            t.symbols := symbols
        end

    let run(t: T name: String capture: Bool): Ran =
        begin
            let raised = code.call(symbolAt(t.symbols name <> "_entry"))
            if maybe.isSome(raised) then
                let r = maybe.unwrap(raised)
                let name = code.exceptionName(r)
                (* a fatal error, as os/code's call names one *)
                let fatal = strutil.startsWith(name "fatal: ")
                option raised of Ran with
                    let name = if fatal then stringOp.getSub(name 7 {stringOp.length(name) - 7}) else name end
                    let site = code.raiseSite(r)
                    let frames = framesOf(code.frames(r))
                    let fatal = fatal
                end
            else
                let shown = if capture then value.be(:String value.fetch(symbolAt(t.symbols name <> "_echo") 0))
                    else "" end
                option ran of Ran with let shown = shown end
            end
        end
end
