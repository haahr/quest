(* Quest Self-Hosted Compiler: The JIT's Target Implementation, for wasm
 *
 * This is the wasm variant of jit/target, used when the driver itself runs on
 * WebAssembly (docs/wasm.md section 6.1). Each unit is compiled to a
 * WebAssembly module by the wasm backend and passed as bytes to the host,
 * which compiles and instantiates it alongside the driver and previously
 * loaded units. When the host runs an input's entry point, it catches engine
 * stack overflows, traps, and fatal runtime errors at its own frame so the
 * driver's stack stays intact; Quest exceptions raised by the input unwind
 * across the host frame to the handler here.
 *
 * Host functions are imported as wasm.host.NAME with integer parameters;
 * strings are passed via the runtime's linear memory at offset area
 * (runtime/wasm/jit.mjs). *)

unsound module target : Target
import
    raised : Raised
    stringOp = string : StringOp
    system : System

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/sort : util/Sort

    questlang/common/location : questlang/common/Location
    questlang/common/maps : questlang/common/Maps
    questlang/ir/nodes : questlang/ir/Nodes
    passes = questlang/ir/pipeline : questlang/ir/Pipeline
    questlang/modules/elaboration : questlang/modules/Elaboration
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/types/env : questlang/types/Env
    questlang/types/symbols : questlang/types/Symbols
    wasm = questlang/wasm/codegen : questlang/wasm/Codegen
    questlang/wasm/encode : questlang/wasm/Encode
    questlang/wasm/model : questlang/wasm/Model
export
    Let T = Tuple e: env.T end
    Let Ran = Option
        ran with shown: String end
        raised with name: String site: String frames: Array(String) fatal: Bool end
    end

    let unsupported: Exception(String) = exception unsupported: String end
    let fail(A::TYPE m: String): A = raise unsupported with m end

    (* Where a string crosses to the host: past the core's buffers, which are
     * not in use while the host is called *)
    let area = 1048576

    let toMemory(s: String at: Int): Ok = external "wasm.base.stringToMem"
    let fromMemory(at: Int n: Int): String = external "wasm.base.memToString"

    (* The host's functions (runtime/wasm/jit.mjs) *)
    let hostGive(at: Int n: Int): Int = external "wasm.host.give"
    let hostLoad(at: Int n: Int): Int = external "wasm.host.load"
    let hostRun(at: Int n: Int): Int = external "wasm.host.run"
    let hostHas(at: Int n: Int): Int = external "wasm.host.has"
    let hostFingerprint(at: Int n: Int): Int = external "wasm.host.fingerprint"

    (* What a phrase unit's echoes write, captured (wasm/print) *)
    let startCapture(): Ok = external "wasm.print.capture"
    let captured(): String = external "wasm.print.captured"

    (* A raised exception's name, and its raise's site *)
    let raisedName(r: raised.T): String = external "wasm.raisedName"
    let raisedSite(r: raised.T): String = external "wasm.raisedSite"
    let fatalReport(): String = external "wasm.fatalReport"

    (* Splits a runtime fatal-error report into a two-element array [message,
     * site]: message is the first line, and site is extracted from a second
     * line beginning with "  at " if present *)
    let reportParts(report: String): Array(String) =
        begin
            let n = stringOp.length(report)
            let line = fun(from: Int): Int
                begin
                    let var k = from
                    while {k < n} andif {stringOp.getChar(report k) isnot '\n'} do k := k + 1 end
                    k
                end
            let first = line(0)
            let message = stringOp.getSub(report 0 first)
            let var site = ""
            if {first + 6} <= n then
                let second = line(first + 1)
                let text = stringOp.getSub(report first + 1 {second - first} - 1)
                if {stringOp.length(text) > 5} andif stringOp.equal(stringOp.getSub(text 0 5) "  at ") then
                    site := stringOp.getSub(text 5 {stringOp.length(text) - 5})
                end
            end
            array of message site end
        end

    (* External helpers to fetch the driver's system module record and update a
     * field by alphabetical index. A record's payload is not a normal Quest
     * value, so it is typed as String here to pass through without
     * conversion. *)
    let systemRecord(unit: String): String = external "wasm.importedRecord"
    let recordSet(payload: String index: Int value: Array(String)): Ok = external "wasm.recordSet"

    (* A string's bytes at area, for a host's function: its length *)
    let put(s: String): Int =
        begin
            toMemory(s area)
            stringOp.length(s)
        end

    let refusal(): maybe.T(String) = maybe.none(:String)

    (* Sets system.args in the driver's system module record by its
     * alphabetical field index in the System interface, matching the arm64
     * target *)
    let setArgs(e: env.T args: Array(String)): Ok =
        begin
            let scope = elaboration.loadInterface("System" e)
            let names = hashMap.keys(:String :symbols.ValueSymbol scope.values)
            let var index = 0
            for i = 0 upto {vector.length(:String names) - 1} do
                if sort.stringCompare(vector.get(:String names i) "args") < 0 then index := index + 1 end
            end
            recordSet(systemRecord("system") index args)
        end

    let new(e: env.T args: Array(String) sources: maps.StringMap(location.SourceMap)): T =
        begin
            setArgs(e args)
            tuple let e = e end
        end

    let has(t: T canonical: String): Bool = hostHas(area put(canonical)) is 1

    let fingerprint(t: T canonical: String): String =
        begin
            let n = hostFingerprint(area put(canonical))
            if n > 0 then fromMemory(area n) else "" end
        end

    let load(t: T unit: nodes.Unit): Ok =
        begin
            let bytes =
                try
                    begin
                        (* Tell the IR passes that pointers and boxed values share
                         * the same representation (WebAssembly eqref) *)
                        shapes.setReferencesAlike(true)
                        encode.encode(wasm.unitModule(passes.runPasses(unit)))
                    end
                (* Convert IR and WebAssembly backend failures into
                 * unsupported *)
                when nodes.irError with x then fail(:String x)
                when wasm.unsupported with x then fail(:String "wasm: unsupported: " <> x)
                when model.malformed with x then fail(:String "wasm: malformed: " <> x)
                end
            let n = vector.length(:nodes.Module unit.modules)
            if n is 0 then fail(:Ok "a unit with no module") end
            let name = vector.get(:nodes.Module unit.modules n - 1).name
            (* Hand the encoded bytes to the host and load the module under the
             * unit's last module's name; on failure, hostLoad writes the error
             * message at area and returns its length *)
            let given = hostGive(area put(bytes))
            let failed = hostLoad(area put(name))
            if failed > 0 then fail(:Ok fromMemory(area failed)) end
        end

    let run(t: T name: String capture: Bool): Ran =
        begin
            let shown = fun(): String if capture then captured() else "" end
            if capture then startCapture() end
            try
                (* What the host caught at its frame: 0 nothing, 1 the
                 * engine's stack overflow, 2 a trap, 3 a fatal error, whose
                 * report the runtime kept (fatalReport) *)
                let status = hostRun(area put(name))
                if status is 0 then
                    option ran of Ran with let shown = shown() end
                else
                    let discarded = shown()
                    if status is 3 then
                        let parts = reportParts(fatalReport())
                        option raised of Ran with
                            let name = parts[0]
                            let site = parts[1]
                            let frames = array of "<main>" end
                            let fatal = true
                        end
                    else
                        option raised of Ran with
                            let name = if status is 1 then "stack.overflow" else "trap" end
                            let site = ""
                            let frames = array of "<main>" end
                            let fatal = false
                        end
                    end
                end
            else with r then
                let discarded = shown()
                option raised of Ran with
                    let name = raisedName(r)
                    let site = raisedSite(r)
                    let frames = array of "<main>" end
                    let fatal = false
                end
            end
        end

    (* Nothing to remove: this target writes nothing for a debugger *)
    let finish(t: T): Ok = begin let unused = system.getEnv("QUEST_JIT_DEBUG") ok end
end
