(* Quest Self-Hosted Compiler: The JIT's Loader Interface
 *
 * This module loads encoded arm64 units (codegen/arm64/encode) into the
 * running driver (docs/jit.md section 3.6). A session reserves a 128 MB code
 * arena -- small enough that arm64's bl call instruction (which has a +/-128
 * MB range) can reach between any two JIT functions -- and a separate data
 * region. Each unit is appended after the last, with its relocations resolved
 * against its own symbols, previously loaded units' exported symbols, and the
 * driver's symbols (via dlsym).
 *
 * Because driver code may lie beyond bl's range, references to driver symbols
 * go through a GOT (global offset table) slot in the data region holding the
 * symbol's full address, and calls go through a small trampoline stub in the
 * code arena that branches to that slot. Each unit's data region is registered as a
 * garbage-collector root, and each function's code range is registered so
 * stack traces can attribute frames in it. Loaded code and data are never
 * freed. *)

unsound interface Loader
import
    collections/hashMap : collections/HashMap
    os/value : os/Value

    questlang/codegen/arm64/encode : questlang/codegen/arm64/Encode
export
    T::TYPE

    (* What a unit cannot be loaded for: a symbol that resolves nowhere, or a
     * region full *)
    loadError: Exception(String)

    (* A session's loader, with codeBytes of arena and dataBytes of data;
     * raises value.error where code cannot be mapped *)
    new(codeBytes: Int dataBytes: Int): T

    (* Loads a unit, returning the addresses of its symbols, its own and
     * those it exports, which later units see *)
    load(l: T e: encode.Encoded): hashMap.T(String value.T)
end
