(* Quest Self-Hosted Compiler: The SSA's Control Flow Graph Implementation *)

module cfg : CFG
import
    collections/bitset : collections/Bitset
    collections/vector : collections/Vector

    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    Def Graph = Tuple
        preds: Array(Array(Int))
        succs: Array(Array(Int))
        order: Array(Int)
        rank: Array(Int)
        idom: Array(Int)
        children: Array(Array(Int))
        pre: Array(Int)
        post: Array(Int)
    end

    let none: Array(Int) = array of :Int end

    (* Reverse postorder from the entry, by an explicit stack of (block, next
     * successor) *)
    let reversePostorder(succs: Array(Array(Int))): Array(Int) =
        begin
            let n = extent succs
            let visited = array of(n false)
            let post = vector.new(:Int)
            let stackBlocks = vector.new(:Int)
            let stackNext = vector.new(:Int)
            if n > 0 then
                visited[0] := true
                vector.append(stackBlocks 0)
                vector.append(stackNext 0)
            end
            while not(vector.empty(stackBlocks)) do
                let top = vector.length(stackBlocks) - 1
                let b = vector.get(stackBlocks top)
                let k = vector.get(stackNext top)
                if k < extent succs[b] then
                    vector.set(stackNext top k + 1)
                    let s = succs[b][k]
                    if {s >= 0} andif {s < n} andif not(visited[s]) then
                        visited[s] := true
                        vector.append(stackBlocks s)
                        vector.append(stackNext 0)
                    end
                else
                    vector.pop(stackBlocks)
                    vector.pop(stackNext)
                    vector.append(post b)
                end
            end
            let m = vector.length(post)
            let order = array of(m 0)
            for i = 0 upto {m - 1} do order[i] := vector.get(post {m - 1} - i) end
            order
        end

    let graphOf(succs: Array(Array(Int))): Graph =
        begin
            let n = extent succs
            let predLists = array of(n vector.new(:Int))
            for b = 0 upto {n - 1} do predLists[b] := vector.new() end
            for b = 0 upto {n - 1} do
                for k = 0 upto {extent succs[b] - 1} do
                    let s = succs[b][k]
                    if {s >= 0} andif {s < n} then vector.append(predLists[s] b) end
                end
            end
            let preds = array of(n none)
            for b = 0 upto {n - 1} do preds[b] := vector.toArray(predLists[b]) end
            let order = reversePostorder(succs)
            let rank = array of(n ~1)
            for i = 0 upto {extent order - 1} do rank[order[i]] := i end
            (* Computes immediate dominators to a fixed point in reverse
             * postorder. While the loop runs, the entry block is its own
             * immediate dominator so that intersect's walks up the tree stop
             * there; the finished graph records it as ~1. *)
            let idom = array of(n ~1)
            if n > 0 then idom[0] := 0 end
            let intersect(a0: Int b0: Int): Int =
                begin
                    let var a = a0
                    let var b = b0
                    while a isnot b do
                        while rank[a] > rank[b] do a := idom[a] end
                        while rank[b] > rank[a] do b := idom[b] end
                    end
                    a
                end
            let var changed = true
            while changed do
                changed := false
                for i = 1 upto {extent order - 1} do
                    let b = order[i]
                    let var newIdom = ~1
                    for k = 0 upto {extent preds[b] - 1} do
                        let p = preds[b][k]
                        if {rank[p] >= 0} andif {idom[p] >= 0} then
                            newIdom := if newIdom < 0 then p else intersect(p newIdom) end
                        end
                    end
                    if newIdom isnot idom[b] then
                        idom[b] := newIdom
                        changed := true
                    end
                end
            end
            if n > 0 then idom[0] := ~1 end
            (* Builds the dominator tree and computes its preorder and
             * postorder numbers using an explicit stack of (block, next
             * child) *)
            let childLists = array of(n vector.new(:Int))
            for b = 0 upto {n - 1} do childLists[b] := vector.new() end
            for i = 0 upto {extent order - 1} do
                let b = order[i]
                if idom[b] >= 0 then vector.append(childLists[idom[b]] b) end
            end
            let children = array of(n none)
            for b = 0 upto {n - 1} do children[b] := vector.toArray(childLists[b]) end
            let pre = array of(n ~1)
            let post = array of(n ~1)
            let var nextPre = 0
            let var nextPost = 0
            if extent order > 0 then
                let stackBlocks = vector.new(:Int)
                let stackNext = vector.new(:Int)
                vector.append(stackBlocks 0)
                vector.append(stackNext 0)
                pre[0] := nextPre
                nextPre := nextPre + 1
                while not(vector.empty(stackBlocks)) do
                    let top = vector.length(stackBlocks) - 1
                    let b = vector.get(stackBlocks top)
                    let k = vector.get(stackNext top)
                    if k < extent children[b] then
                        vector.set(stackNext top k + 1)
                        let c = children[b][k]
                        pre[c] := nextPre
                        nextPre := nextPre + 1
                        vector.append(stackBlocks c)
                        vector.append(stackNext 0)
                    else
                        vector.pop(stackBlocks)
                        vector.pop(stackNext)
                        post[b] := nextPost
                        nextPost := nextPost + 1
                    end
                end
            end
            tuple
                let preds = preds
                let succs = succs
                let order = order
                let rank = rank
                let idom = idom
                let children = children
                let pre = pre
                let post = post
            end
        end

    let graph(f: ssa.Function): Graph =
        begin
            let n = vector.length(f.blocks)
            let succs = array of(n none)
            for b = 0 upto {n - 1} do succs[b] := ssa.successors(ssa.block(f b).term) end
            graphOf(succs)
        end

    let reached(g: Graph b: Int): Bool = {b >= 0} andif {b < extent g.rank} andif {g.rank[b] >= 0}

    let dominates(g: Graph a: Int b: Int): Bool =
        reached(g a) andif reached(g b) andif {g.pre[a] <= g.pre[b]} andif {g.post[b] <= g.post[a]}

    let isLoopHeader(g: Graph h: Int): Bool =
        begin
            let var found = false
            if reached(g h) then
                for k = 0 upto {extent g.preds[h] - 1} do
                    let p = g.preds[h][k]
                    if reached(g p) andif dominates(g h p) then found := true end
                end
            end
            found
        end

    (* Computes dominance frontiers using Cooper, Harvey, and Kennedy's
     * algorithm, walking from each predecessor of a join block up the
     * dominator tree to the join's immediate dominator *)
    let frontiers(g: Graph): Array(Array(Int)) =
        begin
            let n = extent g.preds
            let lists = array of(n vector.new(:Int))
            for b = 0 upto {n - 1} do lists[b] := vector.new() end
            for b = 0 upto {n - 1} do
                if reached(g b) andif {extent g.preds[b] >= 2} then
                    for p = 0 upto {extent g.preds[b] - 1} do
                        let var runner = g.preds[b][p]
                        while reached(g runner) andif {runner isnot g.idom[b]} do
                            vector.append(lists[runner] b)
                            runner := g.idom[runner]
                        end
                    end
                end
            end
            let result = array of(n none)
            for b = 0 upto {n - 1} do result[b] := vector.toArray(lists[b]) end
            result
        end

    let loopDepths(g: Graph): Array(Int) =
        begin
            let n = extent g.preds
            let depth = array of(n 0)
            (* Which blocks are in the loop being walked: a block is in h's when
             * mark[b] is h, so that no array is cleared between loops, and
             * the walk costs only the loop's blocks *)
            let mark = array of(n ~1)
            for h = 0 upto {n - 1} do
                if reached(g h) then
                    (* The loop of h: the blocks that reach a back edge's source
                     * without passing h *)
                    let work = vector.new(:Int)
                    for k = 0 upto {extent g.preds[h] - 1} do
                        let p = g.preds[h][k]
                        if dominates(g h p) then vector.append(work p) end
                    end
                    if not(vector.empty(work)) then
                        mark[h] := h
                        depth[h] := depth[h] + 1
                        while not(vector.empty(work)) do
                            let b = vector.pop(work)
                            if mark[b] isnot h then
                                mark[b] := h
                                depth[b] := depth[b] + 1
                                for k = 0 upto {extent g.preds[b] - 1} do
                                    let p = g.preds[b][k]
                                    if reached(g p) andif {mark[p] isnot h} then vector.append(work p) end
                                end
                            end
                        end
                    end
                end
            end
            depth
        end

    Def Tail = Tuple insts: vector.T(ssa.Inst) term: ssa.Terminator termLoc: ssa.Loc end

    let cutTail(f: ssa.Function b: Int k: Int): Tail =
        begin
            let blk = ssa.block(f b)
            let insts = vector.new(:ssa.Inst)
            for j = k upto {vector.length(blk.insts) - 1} do vector.append(insts vector.get(blk.insts j)) end
            while vector.length(blk.insts) > k do begin let ignored = vector.pop(blk.insts) end end
            let t = tuple let insts = insts let term = blk.term let termLoc = blk.termLoc end
            blk.term := ssa.termNone
            blk.termLoc := ssa.noLoc
            t
        end

    let appendTail(f: ssa.Function b: Int t: Tail): Ok =
        begin
            let blk = ssa.block(f b)
            for j = 0 upto {vector.length(t.insts) - 1} do vector.append(blk.insts vector.get(t.insts j)) end
            blk.term := t.term
            blk.termLoc := t.termLoc
        end

    let dropUnreached(f: ssa.Function): Ok =
        begin
            let n = vector.length(f.blocks)
            let g = graph(f)
            let number = array of(n ~1)
            let kept = vector.new(:ssa.Block)
            for b = 0 upto {n - 1} do
                if reached(g b) then
                    number[b] := vector.length(kept)
                    vector.append(kept ssa.block(f b))
                end
            end
            if vector.length(kept) < n then
                for b = 0 upto {vector.length(kept) - 1} do
                    let blk = vector.get(kept b)
                    blk.term := ssa.mapBlocks(blk.term fun(x: Int): Int number[x])
                end
                vector.clear(f.blocks)
                for b = 0 upto {vector.length(kept) - 1} do
                    vector.append(f.blocks vector.get(kept b))
                end
            end
        end

    let loopBody(g: Graph h: Int): Array(Bool) =
        begin
            let n = extent g.preds
            let inside = array of(n false)
            let work = vector.new(:Int)
            for k = 0 upto {extent g.preds[h] - 1} do
                let p = g.preds[h][k]
                if reached(g p) andif dominates(g h p) then vector.append(work p) end
            end
            if not(vector.empty(work)) then inside[h] := true end
            while not(vector.empty(work)) do
                let b = vector.pop(work)
                if not(inside[b]) then
                    inside[b] := true
                    for k = 0 upto {extent g.preds[b] - 1} do
                        let p = g.preds[b][k]
                        if reached(g p) andif not(inside[p]) then vector.append(work p) end
                    end
                end
            end
            inside
        end

    let beforeTerminator(f: ssa.Function b: Int emitting: All() Ok): Ok =
        begin
            let blk = ssa.block(f b)
            let t = blk.term
            blk.term := ssa.termNone
            emitting()
            blk.term := t
        end

    let onlyRaises(f: ssa.Function r: Int): Bool =
        begin
            let blk = ssa.block(f r)
            let var only = vector.empty(blk.params) andif not(vector.empty(blk.insts))
            for k = 0 upto {vector.length(blk.insts) - 1} do
                let i = vector.get(blk.insts k)
                if k is {vector.length(blk.insts) - 1} then
                    (* A call that the block's end says does not return *)
                    if not(ssa.isOp(i ssa.opCall)) then only := false end
                elsif not(ssa.info(i.op).rematerializable) then
                    only := false
                end
            end
            case blk.term when termUnreachable then only else false end
        end

    let liveIns(f: ssa.Function within: Array(Bool)): Array(bitset.T) =
        begin
            let n = vector.length(f.blocks)
            let nv = vector.length(f.types)
            let liveIn = array of(n bitset.new(0))
            for b = 0 upto {n - 1} do if within[b] then liveIn[b] := bitset.new(nv) end end
            let var changed = true
            while changed do
                changed := false
                for k = 0 upto {n - 1} do
                    let b = {n - 1} - k
                    if within[b] then
                        let blk = ssa.block(f b)
                        let live = bitset.new(nv)
                        let succs = ssa.successors(blk.term)
                        for i = 0 upto {extent succs - 1} do bitset.unionWith(live liveIn[succs[i]]) end
                        let uses = ssa.terminatorUses(blk.term)
                        for i = 0 upto {extent uses - 1} do bitset.insert(live uses[i]) end
                        for j = 0 upto {vector.length(blk.insts) - 1} do
                            let inst = vector.get(blk.insts {vector.length(blk.insts) - 1} - j)
                            for i = 0 upto {extent inst.results - 1} do bitset.remove(live inst.results[i]) end
                            for i = 0 upto {extent inst.args - 1} do bitset.insert(live inst.args[i]) end
                        end
                        for i = 0 upto {vector.length(blk.params) - 1} do
                            bitset.remove(live vector.get(blk.params i))
                        end
                        if not(bitset.equal(live liveIn[b])) then
                            bitset.assign(liveIn[b] live)
                            changed := true
                        end
                    end
                end
            end
            liveIn
        end
end
