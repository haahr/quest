(* Quest Self-Hosted Compiler: The SSA's Printer Implementation *)

module printer : Printer
import
    conv : Conv
    stringOp = string : StringOp

    collections/vector : collections/Vector
    sb = util/stringBuilder : util/StringBuilder
    util/strutil : util/Strutil

    questlang/repr/syntax : questlang/repr/Syntax
    questlang/ssa/nodes : questlang/ssa/Nodes
export
    Let Function = nodes.Function

    let value(v: Int): String = "%" <> conv.int(v)
    let blockName(b: Int): String = "b" <> conv.int(b)
    let typed(f: Function v: Int): String = value(v) <> ": " <> nodes.typeName(nodes.typeOf(f v))

    let values(vs: Array(Int)): String =
        begin
            let texts = array of(extent vs "")
            for i = 0 upto {extent vs - 1} do texts[i] := value(vs[i]) end
            strutil.joinArray(", " texts)
        end

    let targetText(t: nodes.Target): String = blockName(t.block) <> "(" <> values(t.args) <> ")"

    let intList(xs: Array(Int)): String =
        begin
            let texts = array of(extent xs "")
            for i = 0 upto {extent xs - 1} do texts[i] := conv.int(xs[i]) end
            strutil.joinArray(" " texts)
        end

    let listed(name: String xs: Array(Int)): String = if extent xs is 0 then "" else " " <> name <> " [" <> intList(xs)
        <> "]" end

    (* How a signature's parameters are passed, where not in words: pairs,
     * narrow (bytes), memory (index:bytes), and int32 *)
    let paramsText(s: nodes.Signature): String =
        begin
            let memory = nodes.memoryOf(s.params)
            let places = array of(extent memory "")
            for k = 0 upto {extent memory - 1} do
                let bytes =
                    case s.params[memory[k]]
                        when passMemory with x then x.bytes
                        when passWord, passReal, passPair, passPairRest, passByte, passInt32 then 0
                    end
                places[k] := conv.int(memory[k]) <> ":" <> conv.int(bytes)
            end
            listed("pairs" nodes.pairsOf(s.params)) <> listed("narrow" nodes.narrowOf(s.params))
                <> if extent memory > 0 then " memory [" <> strutil.joinArray(" " places) <> "]" else "" end
                <> listed("int32" nodes.int32Of(s.params))
        end

    (* How a signature's one result is passed, where not in a word: as a
     * byte (narrow) or an int32 *)
    let resultText(s: nodes.Signature): String =
        if extent s.results isnot 1 then
            ""
        else
            case s.results[0]
                when passByte then " result narrow"
                when passInt32 then " result int32"
                when passWord, passReal, passPair, passPairRest, passMemory then ""
            end
        end

    let instText(f: Function i: nodes.Inst): String =
        begin
            let results = array of(extent i.results "")
            for r = 0 upto {extent i.results - 1} do results[r] := typed(f i.results[r]) end
            let head = if extent i.results > 0 then strutil.joinArray(", " results) <> " = " else "" end
            let name = nodes.opcodeName(i.op)
            let body =
                case i.op
                    when opConst then name <> " " <> conv.int(i.imm)
                    when opRealConst then name <> " " <> conv.int(i.imm)
                    when opSymbol then
                        name <> " " <> i.symbol <> if i.imm is 0 then "" else " + " <> conv.int(i.imm) end
                    when opThreadLocal then name <> " " <> i.symbol
                    when opSlot then name <> " " <> conv.int(i.imm)
                    when opLoad then
                        name <> conv.int(i.width) <> if {i.width < 8} andif i.signed then "s" else "" end <> " "
                            <> values(i.args) <> " + " <> conv.int(i.imm)
                            <> if i.invariant then
                                " invariant"
                            else
                                ""
                            end
                    when opStore then
                        name <> conv.int(i.width) <> " " <> value(i.args[0]) <> " + " <> conv.int(i.imm) <> ", "
                            <> value(i.args[1])
                    when opCall then
                        name <> " " <> i.symbol <> "(" <> values(i.args) <> ")" <> paramsText(i.signature)
                            <> resultText(i.signature)
                    when opCallIndirect then name <> " " <> values(i.args) <> paramsText(i.signature)
                        <> resultText(i.signature)
                    when opNull, opAdd, opSub, opMul, opMulHiU, opDiv, opRem, opAnd, opOr, opXor, opShl, opLshr, opAshr,
                            opEq, opNe, opLt, opLe, opGt, opGe, opUlt, opPeq, opPne, opFadd, opFsub, opFmul, opFdiv,
                            opFeq,
                            opFlt, opFle, opFgt, opFge, opIsNaN, opIntToPtr, opPtrToInt, opRealBits, opBitsReal,
                            opIntToReal,
                            opSext8,
                            opZext8, opCopy, opPtrAdd, opToVal, opFromVal, opSelect, opUnproxy then
                        if extent i.args > 0 then name <> " " <> values(i.args) else name end
                end
            head <> body
        end

    let termText(f: Function t: nodes.Terminator): String =
        case t
            when termNone then "(no terminator)"
            when termJump with x then "jump " <> targetText(x.target)
            when termBranch with x then
                "branch " <> value(x.cond) <> ", " <> targetText(x.ifTrue) <> ", " <> targetText(x.ifFalse)
            when termSwitch with x then
                let arms = array of(extent x.cases "")
                for i = 0 upto {extent x.cases - 1} do
                    arms[i] := conv.int(x.cases[i]) <> ": " <> targetText(x.targets[i])
                end
                "switch " <> value(x.value) <> " [" <> strutil.joinArray(", " arms) <> "] default "
                    <> targetText(x.default)
            when termReturn with x then if extent x.values > 0 then "return " <> values(x.values) else "return" end
            when termTailCall with x then "tail " <> instText(f x.call)
            when termTry with x then
                "try slot " <> conv.int(x.slot) <> ", " <> targetText(x.body) <> ", handler " <> blockName(x.handler)
            when termUnreachable then "unreachable"
        end

    (* A source position, on a line of its own before the instructions at it:
     * @line:col in the unit's first file, @file:line:col in another, and @-
     * for none *)
    let locText(l: nodes.Loc): String =
        if not(nodes.hasLoc(l)) then
            "@-"
        else
            "@" <> if l.file is 1 then "" else conv.int(l.file) <> ":" end <> conv.int(l.line) <> ":"
                <> conv.int(l.col)
        end

    let formatFunction(f: Function): String =
        begin
            let b = sb.new()
            let params = nodes.block(f 0).params
            sb.str(b "function " <> f.symbol <> if f.exported then " exported" else "" end <> "(")
            for i = 0 upto {vector.length(params) - 1} do
                sb.str(b if i > 0 then ", " else "" end <> typed(f vector.get(params i)))
            end
            sb.str(b ")")
            sb.str(b paramsText(f.signature))
            if not(vector.empty(f.resultTypes)) then
                sb.str(b ": ")
                for i = 0 upto {vector.length(f.resultTypes) - 1} do
                    sb.str(b if i > 0 then ", " else "" end <> nodes.typeName(vector.get(f.resultTypes i)))
                end
            end
            sb.str(b resultText(f.signature))
            if not(vector.empty(f.slots)) then
                sb.str(b " slots [")
                for i = 0 upto {vector.length(f.slots) - 1} do
                    let s = vector.get(f.slots i)
                    sb.str(b if i > 0 then " " else "" end <> conv.int(s.bytes) <> ":" <> conv.int(s.align))
                end
                sb.str(b "]")
            end
            sb.str(b " {\n")
            for bi = 0 upto {vector.length(f.blocks) - 1} do
                let blk = nodes.block(f bi)
                sb.str(b blockName(bi) <> "(")
                for i = 0 upto {vector.length(blk.params) - 1} do
                    sb.str(b if i > 0 then ", " else "" end <> typed(f vector.get(blk.params i)))
                end
                sb.str(b "):\n")
                (* A block's code starts at no position *)
                let state = tuple let var last = nodes.noLoc end
                let at = fun(l: nodes.Loc): Ok
                    if not(nodes.sameLoc(l state.last)) then
                        sb.str(b "  " <> locText(l) <> "\n")
                        state.last := l
                    end
                for i = 0 upto {vector.length(blk.insts) - 1} do
                    let inst = vector.get(blk.insts i)
                    at(inst.loc)
                    sb.str(b "  " <> instText(f inst) <> "\n")
                end
                at(blk.termLoc)
                sb.str(b "  " <> termText(f blk.term) <> "\n")
            end
            sb.str(b "}\n")
            sb.toString(b)
        end

    let wordText(w: nodes.Word): String =
        case w
            when wordInt with x then conv.int(x.n)
            when wordSymbol with x then x.symbol <> if x.addend is 0 then "" else " + " <> conv.int(x.addend) end
        end

    let formatData(d: nodes.Data): String =
        begin
            let head = "data " <> d.symbol <> if d.exported then " exported" else "" end
                <> if d.writable then " writable" else "" end <> " "
            case d.contents
                when contentsZero with x then head <> "zero " <> conv.int(x.bytes) <> "\n"
                when contentsText with x then head <> "text " <> syntax.cString(x.text) <> "\n"
                when contentsWords with x then
                    let b = sb.new()
                    sb.str(b head <> "words [")
                    for i = 0 upto {extent x.words - 1} do
                        sb.str(b if i > 0 then ", " else "" end <> wordText(x.words[i]))
                    end
                    sb.str(b "]\n")
                    sb.toString(b)
            end
        end

    let formatUnit(u: nodes.Unit): String =
        begin
            let b = sb.new()
            for i = 0 upto {vector.length(u.functions) - 1} do
                if i > 0 then sb.str(b "\n") end
                sb.strShared(b formatFunction(vector.get(u.functions i)))
            end
            if not(vector.empty(u.data)) then sb.str(b "\n") end
            for i = 0 upto {vector.length(u.data) - 1} do
                sb.strShared(b formatData(vector.get(u.data i)))
            end
            sb.toString(b)
        end
end
