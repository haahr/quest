(* Quest Self-Hosted Compiler: The SSA's Nodes Implementation *)

module nodes : Nodes
import
    collections/vector : collections/Vector
    stringOp = string : StringOp
export
    Def Type = Option typeInt typePtr typeReal end

    Def Opcode = Option
        opConst opRealConst opSymbol opNull opSlot
        opAdd opSub opMul opDiv opRem
        opAnd opOr opXor opShl opLshr opAshr
        opEq opNe opLt opLe opGt opGe opUlt opPeq opPne
        opFadd opFsub opFmul opFdiv opFeq opFlt opFle opFgt opFge opIsNaN
        opIntToPtr opPtrToInt opRealBits opBitsReal opSext8 opZext8
        opLoad opStore opCall opCallIndirect opCopy
    end

    Def Inst = Tuple
        op: Opcode
        var args: Array(Int)
        results: Array(Int)
        var imm: Int
        symbol: String
        width: Int
        signed: Bool
        pairs: Array(Int)
        memory: Array(Int)
        narrow: Array(Int)
    end

    Def Target = Tuple block: Int var args: Array(Int) end

    Def Terminator = Option
        termNone
        termJump with target: Target end
        termBranch with cond: Int ifTrue: Target ifFalse: Target end
        termSwitch with value: Int cases: Array(Int) targets: Array(Target) default: Target end
        termReturn with values: Array(Int) end
        termTailCall with call: Inst end
        termTry with slot: Int body: Target handler: Int end
        termUnreachable
    end

    Def Block = Tuple
        params: vector.T(Int)
        insts: vector.T(Inst)
        var term: Terminator
    end

    Def Slot = Tuple bytes: Int align: Int end

    Def Function = Tuple
        symbol: String
        exported: Bool
        paramTypes: vector.T(Type)
        resultTypes: vector.T(Type)
        var paramPairs: Array(Int)
        var paramNarrow: Array(Int)
        types: vector.T(Type)
        blocks: vector.T(Block)
        slots: vector.T(Slot)
    end

    Def Word = Option
        wordInt with n: Int end
        wordSymbol with symbol: String addend: Int end
    end
    Def Contents = Option
        contentsZero with bytes: Int end
        contentsText with text: String end
        contentsWords with words: Array(Word) end
    end
    Def Data = Tuple symbol: String exported: Bool writable: Bool contents: Contents end

    Def Unit = Tuple
        functions: vector.T(Function)
        data: vector.T(Data)
    end

    let none: Array(Int) = array of :Int end

    Def Passing = Tuple pairs: Array(Int) memory: Array(Int) narrow: Array(Int) end
    let passing(pairs: Array(Int) memory: Array(Int) narrow: Array(Int)): Passing =
        tuple let pairs = pairs let memory = memory let narrow = narrow end
    let plain: Passing = passing(none none none)

    let typeInt: Type = option typeInt of Type end
    let typePtr: Type = option typePtr of Type end
    let typeReal: Type = option typeReal of Type end
    let opConst: Opcode = option opConst of Opcode end
    let opRealConst: Opcode = option opRealConst of Opcode end
    let opSymbol: Opcode = option opSymbol of Opcode end
    let opNull: Opcode = option opNull of Opcode end
    let opSlot: Opcode = option opSlot of Opcode end
    let opAdd: Opcode = option opAdd of Opcode end
    let opSub: Opcode = option opSub of Opcode end
    let opMul: Opcode = option opMul of Opcode end
    let opDiv: Opcode = option opDiv of Opcode end
    let opRem: Opcode = option opRem of Opcode end
    let opAnd: Opcode = option opAnd of Opcode end
    let opOr: Opcode = option opOr of Opcode end
    let opXor: Opcode = option opXor of Opcode end
    let opShl: Opcode = option opShl of Opcode end
    let opLshr: Opcode = option opLshr of Opcode end
    let opAshr: Opcode = option opAshr of Opcode end
    let opEq: Opcode = option opEq of Opcode end
    let opNe: Opcode = option opNe of Opcode end
    let opLt: Opcode = option opLt of Opcode end
    let opLe: Opcode = option opLe of Opcode end
    let opGt: Opcode = option opGt of Opcode end
    let opGe: Opcode = option opGe of Opcode end
    let opUlt: Opcode = option opUlt of Opcode end
    let opPeq: Opcode = option opPeq of Opcode end
    let opPne: Opcode = option opPne of Opcode end
    let opFadd: Opcode = option opFadd of Opcode end
    let opFsub: Opcode = option opFsub of Opcode end
    let opFmul: Opcode = option opFmul of Opcode end
    let opFdiv: Opcode = option opFdiv of Opcode end
    let opFeq: Opcode = option opFeq of Opcode end
    let opFlt: Opcode = option opFlt of Opcode end
    let opFle: Opcode = option opFle of Opcode end
    let opFgt: Opcode = option opFgt of Opcode end
    let opFge: Opcode = option opFge of Opcode end
    let opIsNaN: Opcode = option opIsNaN of Opcode end
    let opIntToPtr: Opcode = option opIntToPtr of Opcode end
    let opPtrToInt: Opcode = option opPtrToInt of Opcode end
    let opRealBits: Opcode = option opRealBits of Opcode end
    let opBitsReal: Opcode = option opBitsReal of Opcode end
    let opSext8: Opcode = option opSext8 of Opcode end
    let opZext8: Opcode = option opZext8 of Opcode end
    let opLoad: Opcode = option opLoad of Opcode end
    let opStore: Opcode = option opStore of Opcode end
    let opCall: Opcode = option opCall of Opcode end
    let opCallIndirect: Opcode = option opCallIndirect of Opcode end
    let opCopy: Opcode = option opCopy of Opcode end
    let termNone: Terminator = option termNone of Terminator end
    let termUnreachable: Terminator = option termUnreachable of Terminator end

    let newUnit(): Unit = tuple let functions = vector.new(:Function) let data = vector.new(:Data) end

    let words(symbol: String exported: Bool writable: Bool ws: Array(Word)): Data =
        tuple
            let symbol = symbol let exported = exported let writable = writable
            let contents = option contentsWords of Contents with let words = ws end
        end

    let wordsBytes(c: Contents): Int =
        case c
            when contentsZero with x then x.bytes
            when contentsText with x then stringOp.length(x.text) + 1
            when contentsWords with x then 8 * extent x.words
        end

    let newValue(f: Function t: Type): Int =
        begin
            vector.append(:Type f.types t)
            vector.length(:Type f.types) - 1
        end

    let newBlock(f: Function): Int =
        begin
            vector.append(:Block f.blocks tuple
                let params = vector.new(:Int)
                let insts = vector.new(:Inst)
                let var term = termNone
            end)
            vector.length(:Block f.blocks) - 1
        end

    let block(f: Function b: Int): Block = vector.get(:Block f.blocks b)
    let typeOf(f: Function v: Int): Type = vector.get(:Type f.types v)

    let addParam(f: Function b: Int t: Type): Int =
        begin
            let v = newValue(f t)
            vector.append(:Int block(f b).params v)
            v
        end

    let newSlot(f: Function bytes: Int align: Int): Int =
        begin
            vector.append(:Slot f.slots tuple let bytes = bytes let align = align end)
            vector.length(:Slot f.slots) - 1
        end

    let newFunction(symbol: String exported: Bool params: Array(Type) results: Array(Type)): Function =
        begin
            let f = tuple
                let symbol = symbol
                let exported = exported
                let paramTypes = vector.fromArray(:Type params)
                let resultTypes = vector.fromArray(:Type results)
                let var paramPairs = array of :Int end
                let var paramNarrow = array of :Int end
                let types = vector.new(:Type)
                let blocks = vector.new(:Block)
                let slots = vector.new(:Slot)
            end
            let entry = newBlock(f)
            for i = 0 upto {extent params - 1} do addParam(f entry params[i]) end
            f
        end

    let isTerminated(f: Function b: Int): Bool =
        case block(f b).term
            when termNone then false
            when termJump, termBranch, termSwitch, termReturn, termTailCall, termTry, termUnreachable then true
        end

    let append(f: Function b: Int i: Inst): Ok = vector.append(:Inst block(f b).insts i)

    (* An instruction of every field *)
    let make(op: Opcode args: Array(Int) results: Array(Int) imm: Int symbol: String width: Int signed: Bool p: Passing)
        : Inst =
        tuple
            let op = op let var args = args let results = results let var imm = imm let symbol = symbol
            let width = width let signed = signed let pairs = p.pairs let memory = p.memory let narrow = p.narrow
        end

    let inst(op: Opcode args: Array(Int) results: Array(Int)): Inst = make(op args results 0 "" 0 false plain)

    (* Appends an instruction of no arguments and one result of type t, with
     * an immediate and a symbol *)
    let nullary(f: Function b: Int op: Opcode t: Type imm: Int symbol: String): Int =
        begin
            let v = newValue(f t)
            append(f b make(op none array of v end imm symbol 0 false plain))
            v
        end

    let emit(f: Function b: Int op: Opcode args: Array(Int) t: Type): Int =
        begin
            let v = newValue(f t)
            append(f b inst(op args array of v end))
            v
        end

    let constant(f: Function b: Int n: Int): Int = nullary(f b opConst typeInt n "")
    let realConstant(f: Function b: Int n: Int): Int = nullary(f b opRealConst typeReal n "")
    let null(f: Function b: Int): Int = nullary(f b opNull typePtr 0 "")
    let symbolPlus(f: Function b: Int symbol: String addend: Int): Int = nullary(f b opSymbol typePtr addend symbol)
    let symbolAddress(f: Function b: Int symbol: String): Int = symbolPlus(f b symbol 0)
    let slotAddress(f: Function b: Int s: Int): Int = nullary(f b opSlot typePtr s "")

    (* The type of a binary operation's result *)
    let resultType(op: Opcode x: Type): Type =
        case op
            when opEq, opNe, opLt, opLe, opGt, opGe, opUlt, opPeq, opPne, opFeq, opFlt, opFle, opFgt, opFge then typeInt
            when opConst, opRealConst, opSymbol, opNull, opSlot, opAdd, opSub, opMul, opDiv, opRem, opAnd, opOr, opXor,
                opShl, opLshr, opAshr, opFadd, opFsub, opFmul, opFdiv, opIsNaN, opIntToPtr, opPtrToInt, opRealBits,
                opBitsReal, opSext8, opZext8, opLoad, opStore, opCall, opCallIndirect, opCopy then
                x
        end

    let binary(f: Function b: Int op: Opcode x: Int y: Int): Int = emit(f b op array of x y end resultType(op typeOf(f x)))

    let load(f: Function b: Int address: Int offset: Int width: Int signed: Bool t: Type): Int =
        begin
            let v = newValue(f t)
            append(f b make(opLoad array of address end array of v end offset "" width signed plain))
            v
        end

    let store(f: Function b: Int address: Int offset: Int width: Int value: Int): Ok =
        append(f b make(opStore array of address value end none offset "" width false plain))

    (* A call's instruction, its results new values *)
    let callInst(f: Function symbol: String args: Array(Int) p: Passing results: Array(Type)): Inst =
        begin
            let vs = array of(extent results 0)
            for i = 0 upto {extent results - 1} do vs[i] := newValue(f results[i]) end
            let op = if stringOp.length(symbol) > 0 then opCall else opCallIndirect end
            make(op args vs 0 symbol 0 false p)
        end

    let call(f: Function b: Int symbol: String args: Array(Int) p: Passing results: Array(Type)): Array(Int) =
        begin
            let i = callInst(f symbol args p results)
            append(f b i)
            i.results
        end

    let terminate(f: Function b: Int t: Terminator): Ok = block(f b).term := t

    let tailCall(f: Function b: Int symbol: String args: Array(Int) p: Passing results: Array(Type)): Ok =
        terminate(f b option termTailCall of Terminator with let call = callInst(f symbol args p results) end)

    let target(b: Int args: Array(Int)): Target = tuple let block = b let var args = args end

    let concat(a: Array(Int) b: Array(Int)): Array(Int) =
        begin
            let r = array of({extent a + extent b} 0)
            for i = 0 upto {extent a - 1} do r[i] := a[i] end
            for i = 0 upto {extent b - 1} do r[extent a + i] := b[i] end
            r
        end

    let terminatorUses(t: Terminator): Array(Int) =
        case t
            when termNone then none
            when termJump with x then x.target.args
            when termBranch with x then concat(array of x.cond end concat(x.ifTrue.args x.ifFalse.args))
            when termSwitch with x then
                let var uses = concat(array of x.value end x.default.args)
                for i = 0 upto {extent x.targets - 1} do uses := concat(uses x.targets[i].args) end
                uses
            when termReturn with x then x.values
            when termTailCall with x then x.call.args
            when termTry with x then x.body.args
            when termUnreachable then none
        end

    let successors(t: Terminator): Array(Int) =
        case t
            when termNone then none
            when termJump with x then array of x.target.block end
            when termBranch with x then array of x.ifTrue.block x.ifFalse.block end
            when termSwitch with x then
                let r = array of({extent x.targets + 1} x.default.block)
                for i = 0 upto {extent x.targets - 1} do r[i] := x.targets[i].block end
                r
            when termReturn then none
            when termTailCall then none
            when termTry with x then array of x.body.block x.handler end
            when termUnreachable then none
        end

    let targets(t: Terminator): Array(Target) =
        case t
            when termJump with x then array of x.target end
            when termBranch with x then array of x.ifTrue x.ifFalse end
            when termSwitch with x then
                let r = array of({extent x.targets + 1} x.default)
                for i = 0 upto {extent x.targets - 1} do r[i] := x.targets[i] end
                r
            when termTry with x then array of x.body end
            when termNone, termReturn, termTailCall, termUnreachable then array of :Target end
        end

    (* An opcode's position in Opcode *)
    let opcodeIndex(op: Opcode): Int =
        case op
            when opConst then 0
            when opRealConst then 1
            when opSymbol then 2
            when opNull then 3
            when opSlot then 4
            when opAdd then 5
            when opSub then 6
            when opMul then 7
            when opDiv then 8
            when opRem then 9
            when opAnd then 10
            when opOr then 11
            when opXor then 12
            when opShl then 13
            when opLshr then 14
            when opAshr then 15
            when opEq then 16
            when opNe then 17
            when opLt then 18
            when opLe then 19
            when opGt then 20
            when opGe then 21
            when opUlt then 22
            when opPeq then 23
            when opPne then 24
            when opFadd then 25
            when opFsub then 26
            when opFmul then 27
            when opFdiv then 28
            when opFeq then 29
            when opFlt then 30
            when opFle then 31
            when opFgt then 32
            when opFge then 33
            when opIsNaN then 34
            when opIntToPtr then 35
            when opPtrToInt then 36
            when opRealBits then 37
            when opBitsReal then 38
            when opSext8 then 39
            when opZext8 then 40
            when opLoad then 41
            when opStore then 42
            when opCall then 43
            when opCallIndirect then 44
            when opCopy then 45
        end

    let isOp(i: Inst op: Opcode): Bool = opcodeIndex(i.op) is opcodeIndex(op)
    let isCall(i: Inst): Bool = isOp(i opCall) orif isOp(i opCallIndirect)

    let typeName(t: Type): String = case t when typeInt then "int" when typePtr then "ptr" when typeReal then "real" end

    let opcodeName(op: Opcode): String =
        case op
            when opConst then "const" when opRealConst then "realConst" when opSymbol then "symbol"
            when opNull then "null" when opSlot then "slot"
            when opAdd then "add" when opSub then "sub" when opMul then "mul" when opDiv then "div" when opRem then "rem"
            when opAnd then "and" when opOr then "or" when opXor then "xor" when opShl then "shl"
            when opLshr then "lshr" when opAshr then "ashr"
            when opEq then "eq" when opNe then "ne" when opLt then "lt" when opLe then "le" when opGt then "gt"
            when opGe then "ge" when opUlt then "ult" when opPeq then "peq" when opPne then "pne"
            when opFadd then "fadd" when opFsub then "fsub" when opFmul then "fmul" when opFdiv then "fdiv"
            when opFeq then "feq" when opFlt then "flt" when opFle then "fle" when opFgt then "fgt" when opFge then "fge"
            when opIsNaN then "isNaN"
            when opIntToPtr then "intToPtr" when opPtrToInt then "ptrToInt" when opRealBits then "realBits"
            when opBitsReal then "bitsReal" when opSext8 then "sext8" when opZext8 then "zext8"
            when opLoad then "load" when opStore then "store" when opCall then "call"
            when opCallIndirect then "callIndirect" when opCopy then "copy"
        end
end
