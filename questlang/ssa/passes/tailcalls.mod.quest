(* Quest Self-Hosted Compiler: The SSA's Tail Calls Implementation *)

module tailCalls : TailCalls
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/ssa/cfg : questlang/ssa/Cfg
    collections/vector : collections/Vector
export
    Let Function = ssa.Function

    let sameValues(a: Array(Int) b: Array(Int)): Bool =
        begin
            let var same = extent a is extent b
            if same then for i = 0 upto {extent a - 1} do if a[i] isnot b[i] then same := false end end end
            same
        end

    (* Whether a stack slot's address may escape from f: stored, passed to a
     * call, or returned. Values derived from a slot's address (by arithmetic,
     * copies, selects, and block parameters) are found to a fixed point
     * first, then checked for each of those uses. If any escapes, f makes no
     * tail calls, because a tail call frees f's stack frame (and its slots)
     * before the callee runs. *)
    let slotsEscape(f: Function): Bool =
        begin
            let n = vector.length(f.types)
            let derived = array of(n false)
            let var changed = true
            while changed do
                changed := false
                let mark(v: Int): Bool = if derived[v] then false else begin derived[v] := true true end end
                for b = 0 upto {vector.length(f.blocks) - 1} do
                    let blk = ssa.block(f b)
                    for k = 0 upto {vector.length(blk.insts) - 1} do
                        let i = vector.get(blk.insts k)
                        let from = case i.op
                            when opSlot then true
                            when opAdd, opSub, opPtrAdd then derived[i.args[0]] orif derived[i.args[1]]
                            when opIntToPtr, opPtrToInt, opCopy, opToVal, opFromVal, opUnproxy then derived[i.args[0]]
                            when opSelect then derived[i.args[1]] orif derived[i.args[2]]
                            when opConst, opRealConst, opSymbol, opNull, opMul, opMulHiU, opDiv, opRem, opAnd, opOr,
                                opXor, opShl, opLshr, opAshr, opEq, opNe, opLt, opLe, opGt, opGe, opUlt, opPeq, opPne,
                                opFadd, opFsub, opFmul, opFdiv, opFeq, opFlt, opFle, opFgt, opFge, opIsNaN, opRealBits,
                                opBitsReal, opSext8, opZext8, opLoad, opStore, opCall, opCallIndirect, opThreadLocal then
                                false
                        end
                        if from then
                            for r = 0 upto {extent i.results - 1} do if mark(i.results[r]) then changed := true end end
                        end
                    end
                    (* Propagate slot-derived taint from jump arguments into
                     * block parameters *)
                    let pass(t: ssa.Target): Ok =
                        begin
                            let params = ssa.block(f t.block).params
                            for a = 0 upto {extent t.args - 1} do
                                if derived[t.args[a]] andif mark(vector.get(params a)) then changed := true end
                            end
                        end
                    let ts = ssa.targets(blk.term)
                    for t = 0 upto {extent ts - 1} do pass(ts[t]) end
                end
            end
            let var escapes = false
            let anyDerived(vs: Array(Int)): Bool =
                begin
                    let var found = false
                    for i = 0 upto {extent vs - 1} do if derived[vs[i]] then found := true end end
                    found
                end
            for b = 0 upto {vector.length(f.blocks) - 1} do
                let blk = ssa.block(f b)
                for k = 0 upto {vector.length(blk.insts) - 1} do
                    let i = vector.get(blk.insts k)
                    if ssa.isOp(i ssa.opStore) then
                        if derived[i.args[1]] then escapes := true end
                    elsif ssa.isCall(i) then
                        if anyDerived(i.args) then escapes := true end
                    end
                end
                case blk.term
                    when termReturn with x then if anyDerived(x.values) then escapes := true end
                    when termTailCall with x then if anyDerived(x.call.args) then escapes := true end
                    when termNone, termJump, termBranch, termSwitch, termTry, termUnreachable then ok
                end
            end
            escapes
        end

    (* Whether a jump to t returns exactly values: t's block does nothing but
     * return — or forward through at most 8 hops to another such block — what
     * equals values once its parameters are substituted with t's arguments. A
     * parameter the block does not return (left dead by a join) may receive
     * any argument. *)
    let rec returnsWithin(f: Function t: ssa.Target values: Array(Int) depth: Int): Bool =
        begin
            let blk = ssa.block(f t.block)
            let params = vector.toArray(blk.params)
            let passed(vs: Array(Int)): Array(Int) =
                begin
                    let r = array of(extent vs 0)
                    for i = 0 upto {extent vs - 1} do
                        r[i] := vs[i]
                        for j = 0 upto {extent params - 1} do if vs[i] is params[j] then r[i] := t.args[j] end end
                    end
                    r
                end
            if {depth > 8} orif not(vector.empty(blk.insts)) then
                false
            else
                case blk.term
                    when termReturn with x then sameValues(passed(x.values) values)
                    when termJump with x then
                        returnsWithin(f ssa.target(x.target.block passed(x.target.args)) values {depth + 1})
                    when termNone, termBranch, termSwitch, termTailCall, termTry, termUnreachable then false
                end
            end
        end

    let returnsThrough(f: Function t: ssa.Target values: Array(Int)): Bool = returnsWithin(f t values 0)

    (* How many trailing instructions of blk a tail call would replace: 1 for
     * a call whose results blk returns (directly or through forwarding
     * blocks), 2 for a call followed by a byte sign/zero extension (which the
     * caller will perform anyway; docs/ssa.md section 2.2) or a pointer/QVal
     * (tagged runtime value) retype, or 0 otherwise *)
    let tailPops(f: Function blk: ssa.Block): Int =
        begin
            let n = vector.length(blk.insts)
            let isPtr(v: Int): Bool = case ssa.typeOf(f v) when typePtr then true else false end
            let isExtension(i: ssa.Inst): Bool = ssa.isOp(i ssa.opZext8) orif ssa.isOp(i ssa.opSext8)
                orif {ssa.isOp(i ssa.opToVal) andif isPtr(i.args[0])}
                orif {ssa.isOp(i ssa.opFromVal) andif isPtr(i.results[0])}
            let var returned = array of(0 0)
            let var pops = 0
            if n > 0 then
                let last = vector.get(blk.insts {n - 1})
                if ssa.isCall(last) then
                    returned := last.results
                    pops := 1
                elsif {n > 1} andif isExtension(last) then
                    let before = vector.get(blk.insts {n - 2})
                    if ssa.isCall(before) andif sameValues(last.args before.results) then
                        returned := last.results
                        pops := 2
                    end
                end
            end
            let tail = if pops is 0 then false
                else case blk.term
                    when termReturn with x then sameValues(x.values returned)
                    when termJump with x then returnsThrough(f x.target returned)
                    when termNone, termBranch, termSwitch, termTailCall, termTry, termUnreachable then false
                end
            end
            if tail then pops else 0 end
        end

    let hasTailCalls(f: Function): Bool =
        begin
            let var found = false
            for b = 0 upto {vector.length(f.blocks) - 1} do
                if tailPops(f ssa.block(f b)) > 0 then found := true end
            end
            found
        end

    let markFunction(f: Function): Ok =
        if not(slotsEscape(f)) then
            let var marked = false
            for b = 0 upto {vector.length(f.blocks) - 1} do
                let blk = ssa.block(f b)
                let pops = tailPops(f blk)
                if pops > 0 then
                    let c = vector.get(blk.insts {vector.length(blk.insts) - pops})
                    for k = 1 upto pops do let ignored = vector.pop(blk.insts) end
                    blk.term := option termTailCall of ssa.Terminator with let call = c end
                    blk.termLoc := c.loc
                    marked := true
                end
            end
            (* Drop blocks that only forwarded values now returned by a tail
             * call *)
            if marked then cfg.dropUnreached(f) end
        end

    let markUnit(u: ssa.Unit): Ok =
        for i = 0 upto {vector.length(u.functions) - 1} do
            markFunction(vector.get(u.functions i))
        end
end
