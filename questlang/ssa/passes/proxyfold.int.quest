(* Quest Self-Hosted Compiler: The SSA's Proxy Folding Interface
 *
 * What escape analysis (ssa/passes/escape) and scalar replacement
 * (ssa/scalars) share. Both follow the pointers of objects a function makes,
 * and both know those objects are never proxies (a proxy is a tagged pointer
 * standing for a tuple or option viewed at a supertype,
 * docs/c-representation.md section 5.8): a test of one of their pointers for
 * being a proxy is false, so the branch on it goes only to its false arm.
 * Which pointers are tracked is each pass's own; this module finds where each
 * value is defined, the proxy tests of tracked pointers, and the blocks
 * reached once those tests fold. *)

interface ProxyFold
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    collections/vector : collections/Vector
export
    (* A function's values' definitions: each value's defining instruction, by
     * block and index (~1 for a block parameter), and whether it is a
     * constant (opConst), and its value *)
    Def Defs = Tuple
        f: ssa.Function
        defBlock: Array(Int)
        defIndex: Array(Int)
        isConst: Array(Bool)
        constant: Array(Int)
    end
    definitions(f: ssa.Function): Defs
    (* The instruction that defines v, which must have one; whether v is
     * defined by an instruction of opcode op; whether v is the constant n *)
    defOf(d: Defs v: Int): ssa.Inst
    definedBy(d: Defs v: Int op: ssa.Opcode): Bool
    isConstant(d: Defs v: Int n: Int): Bool

    (* Whether v tests a pointer for being a proxy, and the pointer is one
     * tracked says is the pass's: v is and(ptrToInt(p), QUEST_PROXY_TAG) *)
    isProxyTest(d: Defs v: Int tracked: All(p: Int) Bool): Bool
    (* Sets reach to the blocks reached from the entry, a branch whose
     * condition isTest says is a folded proxy test going only to its false
     * arm *)
    reachable(d: Defs reach: Array(Bool) isTest: All(v: Int) Bool): Ok
    (* The targets of a reached block's terminator that are taken: a branch
     * on a folded proxy test takes only its false one *)
    takenTargets(term: ssa.Terminator isTest: All(v: Int) Bool): Array(ssa.Target)
    (* The pointers and the blocks reached, to a fixed point: each depends on
     * the other (a parameter's pointer on the edges reached, the edges on the
     * proxy tests of pointers). Starts with every block reached, runs
     * pointers, then reachable, until reach does not change *)
    settle(d: Defs reach: Array(Bool) pointers: All() Ok isTest: All(v: Int) Bool): Ok

    (* Whether symbol is a write barrier (collector.md section 3.5), which only
     * logs the object or marks the slot's card: it keeps no pointer, so
     * passing it one is no use of the object, and an object made a stack slot
     * or replaced by its words needs none *)
    isBarrier(symbol: String): Bool
    (* The word an access at offset base + imm of width bytes is, ~1 if it is
     * not a whole aligned word *)
    wordOf(base: Int imm: Int width: Int): Int
    (* A zero of type t, made by instructions at loc appended to insts *)
    zeroOf(f: ssa.Function insts: vector.T(ssa.Inst) t: ssa.Type loc: ssa.Loc): Int
end
