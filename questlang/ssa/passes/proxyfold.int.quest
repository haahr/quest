(* Quest Self-Hosted Compiler: The SSA's Proxy Folding Interface
 *
 * This module holds analysis helpers shared by escape analysis
 * (ssa/passes/escape) and scalar replacement (ssa/scalars). Both passes track
 * pointers to objects allocated inside the current function and know those
 * objects are never proxies (a proxy is a tagged pointer standing for a tuple
 * or option viewed at a supertype; docs/c-representation.md section 5.8). Any
 * proxy-tag test on a tracked pointer therefore evaluates to false, so its
 * branch takes only the false arm. Each pass decides which pointers to track;
 * this module maps values to their definitions, recognizes proxy tests on
 * tracked pointers, and computes block reachability with those branches
 * folded. *)

interface ProxyFold
import
    collections/vector : collections/Vector

    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    (* Definition table for a function's SSA values: each value's defining
     * instruction by block and index (~1 for block parameters), plus whether
     * it is an opConst and its integer value *)
    Def Defs = Tuple
        f: ssa.Function
        defBlock: Array(Int)
        defIndex: Array(Int)
        isConst: Array(Bool)
        constant: Array(Int)
    end
    definitions(f: ssa.Function): Defs
    (* The instruction that defines v, which must have one; whether v is
     * defined by an instruction of opcode op; whether v is the constant n *)
    defOf(d: Defs v: Int): ssa.Inst
    definedBy(d: Defs v: Int op: ssa.Opcode): Bool
    isConstant(d: Defs v: Int n: Int): Bool

    (* True if v is a proxy-tag test and(ptrToInt(p), QUEST_PROXY_TAG) on a
     * pointer p for which tracked(p) holds *)
    isProxyTest(d: Defs v: Int tracked: All(p: Int) Bool): Bool
    (* Fill reach with the blocks reachable from the entry block, treating any
     * branch whose condition satisfies isTest as taking only its false arm *)
    reachable(d: Defs reach: Array(Bool) isTest: All(v: Int) Bool): Ok
    (* The targets of a reached block's terminator that are taken: a branch
     * on a folded proxy test takes only its false one *)
    takenTargets(term: ssa.Terminator isTest: All(v: Int) Bool): Array(ssa.Target)
    (* Whether every use of v in the blocks reach marks is an instruction
     * whose result isTest holds of (a proxy test, which folds) *)
    onlyProxyTests(f: ssa.Function reach: Array(Bool) v: Int isTest: All(v: Int) Bool): Bool
    (* Compute tracked pointers and reachable blocks to a fixed point, since
     * block-parameter pointers depend on reachable edges and reachable edges
     * depend on folded proxy tests. This marks all blocks reachable and then
     * alternates pointers() and reachable() until reach stops changing. *)
    settle(d: Defs reach: Array(Bool) pointers: All() Ok isTest: All(v: Int) Bool): Ok

    (* True if symbol is a GC write barrier (docs/collector.md section 3.5).
     * Write barriers only log the object or mark its card-table entry for the
     * collector without retaining the pointer, so passing a pointer to one
     * does not make the object escape, and stack-allocated or scalar-replaced
     * objects do not need barriers. *)
    isBarrier(symbol: String): Bool
    (* The word an access at offset base + imm of width bytes is, ~1 if it is
     * not a whole aligned word *)
    wordOf(base: Int imm: Int width: Int): Int
    (* A zero of type t, made by instructions at loc appended to insts *)
    zeroOf(f: ssa.Function insts: vector.T(ssa.Inst) t: ssa.Type loc: ssa.Loc): Int
end
