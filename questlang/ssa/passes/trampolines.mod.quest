(* Quest Self-Hosted Compiler: The SSA's Trampolines Implementation *)

module trampolines : Trampolines
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/ssa/passes/tailJumps : questlang/ssa/passes/TailJumps
    collections/vector : collections/Vector
    collections/hashMap : collections/HashMap
    util/hash : util/Hash
    util/maybe : util/Maybe
    stringOp = string : StringOp
export
    Let Function = ssa.Function

    (* The most instructions of a function copied, and the most copies made
     * into one export *)
    let budget = 64
    let rounds = 4

    (* Whether g is small enough to copy, and calls nothing but in tail
     * position or on the way to a raise *)
    let small(g: Function): Bool =
        begin
            let var n = 0
            let var calls = true
            for b = 0 upto {vector.length(g.blocks) - 1} do
                let blk = ssa.block(g b)
                n := n + vector.length(blk.insts) + 1
                let raises = case blk.term
                    when termUnreachable then true
                    when termNone, termJump, termBranch, termSwitch, termReturn, termTailCall, termTry then false
                end
                if not(raises) then
                    for k = 0 upto {vector.length(blk.insts) - 1} do
                        if ssa.isCall(vector.get(blk.insts k)) then calls := false end
                    end
                end
            end
            calls andif {n <= budget}
        end

    (* Whether a block of g goes to its first, which a splice cannot copy *)
    let entered(g: Function): Bool =
        begin
            let var found = false
            for b = 0 upto {vector.length(g.blocks) - 1} do
                let next = ssa.successors(ssa.block(g b).term)
                for k = 0 upto {extent next - 1} do if next[k] is 0 then found := true end end
            end
            found
        end

    (* Whether g's parameter types match the types of args in f *)
    let takes(f: Function g: Function args: Array(Int)): Bool =
        begin
            let var same = extent args is vector.length(g.paramTypes)
            if same then
                for k = 0 upto {extent args - 1} do
                    if ssa.typeOf(f args[k]) isnot vector.get(g.paramTypes k) then same := false end
                end
            end
            same
        end

    (* Copies into f the function its first block tail-calls, while it
     * can, appending the symbols of those copied to copied *)
    let copyCallees(f: Function functions: vector.T(Function) numbers: hashMap.T(String Int) copied: vector.T(String))
        : Ok =
        begin
            let var left = rounds
            while left > 0 do
                left := left - 1
                let blk = ssa.block(f 0)
                case blk.term
                    when termTailCall with x then
                        let n = hashMap.get(numbers x.call.symbol)
                        if ssa.isOp(x.call ssa.opCall) andif maybe.isSome(n) then
                            let g = vector.get(functions maybe.unwrap(n))
                            if not(stringOp.equal(g.symbol f.symbol)) andif small(g) andif tailJumps.copiable(g)
                                andif tailJumps.sameResults(f g) andif not(entered(g)) andif takes(f g x.call.args)
                            then
                                blk.term := ssa.termNone
                                tailJumps.spliceInto(f 0 g x.call.args)
                                vector.append(copied g.symbol)
                            else left := 0 end
                        else left := 0 end
                    when termNone, termJump, termBranch, termSwitch, termReturn, termTry, termUnreachable then left := 0
                end
            end
        end

    (* If f is an exported single-block function, splices the chain of
     * eligible functions its entry block tail-calls into f and returns their
     * symbols *)
    let trampolineFunction(f: Function functions: vector.T(Function) numbers: hashMap.T(String Int))
        : vector.T(String) =
        begin
            let copied = vector.new(:String)
            if f.exported andif {vector.length(f.blocks) is 1} then
                copyCallees(f functions numbers copied)
            end
            copied
        end

    (* Makes the count of entries qr_register_dicts registers n: the second
     * argument ssa/build/unit's registration passes quest_register_funcs
     * becomes a constant of its own, n, made just before the call. (The
     * constant it passed may be shared: value numbering gives one value to
     * equal constants, so changing it in place could change another use.) *)
    let count(u: ssa.Unit n: Int): Ok =
        for k = 0 upto {vector.length(u.functions) - 1} do
            let f = vector.get(u.functions k)
            if stringOp.equal(f.symbol "qr_register_dicts") then
                for b = 0 upto {vector.length(f.blocks) - 1} do
                    let blk = ssa.block(f b)
                    let rebuilt = vector.new(:ssa.Inst)
                    for j = 0 upto {vector.length(blk.insts) - 1} do
                        let i = vector.get(blk.insts j)
                        if ssa.isOp(i ssa.opCall) andif stringOp.equal(i.symbol "quest_register_funcs")
                            andif {extent i.args > 1}
                        then
                            let v = ssa.newValue(f ssa.typeInt)
                            let c = ssa.inst(ssa.opConst array of :Int end array of v end)
                            c.imm := n
                            c.loc := i.loc
                            vector.append(rebuilt c)
                            i.args[1] := v
                        end
                        vector.append(rebuilt i)
                    end
                    vector.clear(blk.insts)
                    for j = 0 upto {vector.length(rebuilt) - 1} do
                        vector.append(blk.insts vector.get(rebuilt j))
                    end
                end
            end
        end

    (* Updates the unit's traceback name table (qr_funcs, built by
     * ssa/build/unit as pairs of function-start symbol and name pointer). A
     * stack frame is identified by the exact entry address of its function,
     * so each export that inlined a callee gets a new entry with that
     * callee's name, and the count passed to quest_register_funcs is updated
     * to match. *)
    let name(u: ssa.Unit exports: vector.T(String) callees: vector.T(vector.T(String))): Ok =
        begin
            let var table = ~1
            for k = 0 upto {vector.length(u.data) - 1} do
                if stringOp.equal(vector.get(u.data k).symbol "qr_funcs") then table := k end
            end
            if table >= 0 then
                let d = vector.get(u.data table)
                case d.contents
                    when contentsWords with x then
                        let names = hashMap.new(:String :ssa.Word stringOp.equal hash.string)
                        for k = 0 upto {{extent x.words / 2} - 1} do
                            case x.words[2 * k]
                                when wordSymbol with w then
                                    let ignored = hashMap.insert(names w.symbol x.words[{2 * k} + 1])
                                when wordInt then ok
                            end
                        end
                        let words = vector.fromArray(x.words)
                        for e = 0 upto {vector.length(exports) - 1} do
                            (* Record the name of the last inlined callee that
                             * has one in qr_funcs *)
                            let copied = vector.get(callees e)
                            let var found = false
                            for c = 0 upto {vector.length(copied) - 1} do
                                let n = hashMap.get(names vector.get(copied c))
                                if maybe.isSome(n) then
                                    if found then begin let ignored = vector.pop(words) end
                                    else
                                        vector.append(words option wordSymbol of ssa.Word with
                                            let symbol = vector.get(exports e) let addend = 0
                                        end)
                                    end
                                    vector.append(words maybe.unwrap(n))
                                    found := true
                                end
                            end
                        end
                        vector.set(u.data table
                            ssa.words(d.symbol d.exported d.writable vector.toArray(words)))
                        count(u vector.length(words) / 2)
                    when contentsZero, contentsText then ok
                end
            end
        end

    let trampolineUnit(u: ssa.Unit): Ok =
        begin
            let numbers = hashMap.new(:String :Int stringOp.equal hash.string)
            for k = 0 upto {vector.length(u.functions) - 1} do
                let ignored = hashMap.insert(numbers vector.get(u.functions k).symbol k)
            end
            let exports = vector.new(:String)
            let callees = vector.new(:vector.T(String))
            for k = 0 upto {vector.length(u.functions) - 1} do
                let f = vector.get(u.functions k)
                let copied = trampolineFunction(f u.functions numbers)
                if not(vector.empty(copied)) then
                    vector.append(exports f.symbol)
                    vector.append(callees copied)
                end
            end
            if not(vector.empty(exports)) then name(u exports callees) end
        end
end
