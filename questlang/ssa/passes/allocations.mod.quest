(* Quest Self-Hosted Compiler: The SSA's Inline Allocation Implementation *)

module allocations : Allocations
import
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/common/maps : questlang/common/Maps
    questlang/ssa/cfg : questlang/ssa/CFG
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/ssa/runtimeFunctions : questlang/ssa/RuntimeFunctions
export
    Let Function = ssa.Function

    let eq(a: String b: String): Bool = stringOp.equal(a b)

    (* The runtime's Q_LAYOUT_NOSCAN bit, stored in the upper 32-bit flags
     * half of a QLayout's second word (runtime/quest_gc.h, ssa/statics) *)
    let noscanFlag = 1
    let high = 4294967296

    (* The heap space for each layout defined in u, keyed by the layout's
     * symbol: 1 for a pointer-free (noscan) layout, 0 otherwise *)
    let spaces(u: ssa.Unit): maps.StringMap(Int) =
        begin
            let m = maps.newStringMap(:Int)
            for i = 0 upto {vector.length(u.data) - 1} do
                let d = vector.get(u.data i)
                case d.contents
                    when contentsWords with x then
                        if {extent x.words > 1} andif strutil.startsWith(d.symbol "quest_layout_") then
                            case x.words[1]
                                when wordInt with w then
                                    let flags = w.n / high
                                    let space = if {flags - flags / 2 * 2} is noscanFlag then 1 else 0 end
                                    begin let ignored = hashMap.insert(m d.symbol space) end
                                when wordSymbol then ok
                            end
                        end
                    when contentsZero, contentsText then ok
                end
            end
            m
        end

    (* The constant each value of f is, by number, for those that are
     * constants *)
    let constants(f: Function): Tuple isConst: Array(Bool) value: Array(Int) end =
        begin
            let n = vector.length(f.types)
            let isConst = array of(n false)
            let value = array of(n 0)
            for b = 0 upto {vector.length(f.blocks) - 1} do
                let blk = ssa.block(f b)
                for k = 0 upto {vector.length(blk.insts) - 1} do
                    let i = vector.get(blk.insts k)
                    if ssa.isOp(i ssa.opConst) then
                        isConst[i.results[0]] := true
                        value[i.results[0]] := i.imm
                    end
                end
            end
            tuple let isConst = isConst let value = value end
        end

    (* The symbol each value of f is the address of, if an opSymbol defines it
     * (a layout's address), else "" *)
    let symbolsOf(f: Function): Array(String) =
        begin
            let found = array of(vector.length(f.types) "")
            for b = 0 upto {vector.length(f.blocks) - 1} do
                let blk = ssa.block(f b)
                for k = 0 upto {vector.length(blk.insts) - 1} do
                    let i = vector.get(blk.insts k)
                    if ssa.isOp(i ssa.opSymbol) then found[i.results[0]] := i.symbol end
                end
            end
            found
        end

    (* Block b is split at the quest_alloc call at index k (allocating sz bytes
     * in heap space `space`). Block b ends with the fast/slow branch, and both
     * paths jump to a new continuation block holding the rest of b, passing
     * the allocation's base address as a block parameter. *)
    let expand(f: Function b: Int k: Int sz: Int space: Int): Ok =
        begin
            let blk = ssa.block(f b)
            let call = vector.get(blk.insts k)
            let layout = call.args[1]
            let obj = call.results[0]
            let at = call.loc
            f.at := at
            let total = 8 + {{{sz + 7} / 8} * 8}
            (* The rest of the block, after the call, which goes; the
             * instructions made here are at the call's position, f.at *)
            let tail = cfg.cutTail(f b k + 1)
            begin let ignored = vector.pop(blk.insts) end
            let none = array of :Int end
            (* The test: no room in the hole (a checking mode, like a cycle,
             * hides the limits, so that this fails) *)
            let cursorAt = ssa.symbolPlus(f b "quest_gc_cursor" 8 * space)
            let limitAt = ssa.symbolPlus(f b "quest_gc_limit" 8 * space)
            let cursor = ssa.load(f b cursorAt 0 8 true ssa.typeInt)
            let limit = ssa.load(f b limitAt 0 8 true ssa.typeInt)
            let bytes = ssa.constant(f b total)
            let slowPath = ssa.binary(f b ssa.opUlt ssa.binary(f b ssa.opSub limit cursor) bytes)
            let fast = ssa.newBlock(f)
            let slow = ssa.newBlock(f)
            let rest = ssa.newBlock(f)
            blk.term := option termBranch of ssa.Terminator with
                let cond = slowPath
                let ifTrue = ssa.target(slow none)
                let ifFalse = ssa.target(fast none)
            end
            blk.termLoc := at
            (* The fast path bumps the cursor past the object and writes the
             * layout header word. The slow path writes that header itself,
             * adding any collector flags needed during incremental marking
             * (runtime/quest_gc.c). *)
            ssa.store(f fast cursorAt 0 8 ssa.binary(f fast ssa.opAdd cursor bytes))
            ssa.store(f fast ssa.emit(f fast ssa.opIntToPtr array of cursor end ssa.typePtr) 0 8 layout)
            let fastBlk = ssa.block(f fast)
            fastBlk.term := ssa.jump(rest array of cursor end)
            fastBlk.termLoc := at
            (* The slow path asks the runtime *)
            let r = runtimeFunctions.function("quest_gc_alloc_slow")
            let base = ssa.call(f slow "quest_gc_alloc_slow" array of bytes layout end runtimeFunctions.signature(r)
                    runtimeFunctions.resultTypes(r))[0]
            let baseInt = ssa.emit(f slow ssa.opPtrToInt array of base end ssa.typeInt)
            let slowBlk = ssa.block(f slow)
            slowBlk.term := ssa.jump(rest array of baseInt end)
            slowBlk.termLoc := at
            (* The rest: the object and its start bit, then what followed the
             * call *)
            let moved = ssa.block(f rest)
            let baseParam = ssa.newValue(f ssa.typeInt)
            vector.append(moved.params baseParam)
            (* Keep the bumped header address as an int so the object's own
             * address (baseParam + 8) is the first pointer value in this
             * block. If the header address had pointer type, instruction
             * selection could fold object field offsets into it, keeping a
             * pointer to the header word live across calls. Because the
             * header sits right at the end of the preceding object, the
             * collector would mistake a header pointer in a stack frame for
             * an end-of-object pointer to that preceding object (docs/arm64.md
             * section 3.13). *)
            let header = ssa.binary(f rest ssa.opAdd baseParam ssa.constant(f rest 8))
            ssa.append(f rest ssa.inst(ssa.opIntToPtr array of header end array of obj end))
            (* The start bit: its byte the base's plus the address >> 6, its
             * bit the address >> 3 & 7 (quest_gc_note_start) *)
            let startBase = ssa.load(f rest ssa.symbolAddress(f rest "quest_gc_start_base") 0 8 true ssa.typeInt)
            let at8 = ssa.emit(f rest ssa.opPtrToInt array of obj end ssa.typeInt)
            let byteOffset = ssa.binary(f rest ssa.opLshr at8 ssa.constant(f rest 6))
            let byteAt = ssa.emit(f rest ssa.opIntToPtr array of ssa.binary(f rest ssa.opAdd startBase byteOffset) end
                    ssa.typePtr)
            let one = ssa.constant(f rest 1)
            let bit = ssa.binary(f rest ssa.opAnd ssa.binary(f rest ssa.opLshr at8 ssa.constant(f rest 3))
                    ssa.constant(f rest 7))
            let mask = ssa.binary(f rest ssa.opShl one bit)
            let old = ssa.load(f rest byteAt 0 1 false ssa.typeInt)
            ssa.store(f rest byteAt 0 1 ssa.binary(f rest ssa.opOr old mask))
            cfg.appendTail(f rest tail)
        end

    let inlineFunction(f: Function spaces: maps.StringMap(Int)): Ok =
        begin
            let cs = constants(f)
            (* Collect symbol definitions before expanding calls; values added
             * during expansion are never layout arguments to existing calls *)
            let symbols = symbolsOf(f)
            let symbolOf(v: Int): String = if v < extent symbols then symbols[v] else "" end
            let var b = 0
            (* Each expansion appends a continuation block for the rest of the
             * split block, which this loop visits in turn *)
            while b < vector.length(f.blocks) do
                let blk = ssa.block(f b)
                let var k = 0
                let var expanded = false
                while not(expanded) andif {k < vector.length(blk.insts)} do
                    let i = vector.get(blk.insts k)
                    if ssa.isOp(i ssa.opCall) andif eq(i.symbol "quest_alloc") andif {extent i.args is 2}
                            andif {extent i.results is 1} andif cs.isConst[i.args[0]] then
                        let space = hashMap.get(spaces symbolOf(i.args[1]))
                        expand(f b k cs.value[i.args[0]] maybe.unwrapOr(space 0))
                        expanded := true
                    end
                    k := k + 1
                end
                b := b + 1
            end
        end

    let inlineUnit(u: ssa.Unit): Ok =
        begin
            let m = spaces(u)
            for i = 0 upto {vector.length(u.functions) - 1} do
                inlineFunction(vector.get(u.functions i) m)
            end
        end
end
