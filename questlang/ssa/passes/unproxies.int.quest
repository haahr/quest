(* Quest Self-Hosted Compiler: The SSA's Unproxies Interface
 *
 * This pass lowers each opUnproxy instruction (docs/ssa.md section 2) into
 * explicit control flow for the backends after optimization passes finish.
 * A proxy (QProxy) is a tagged pointer wrapping a tuple or option viewed at a
 * supertype; opUnproxy unwraps it to the underlying object. Lowering splits
 * the block at the instruction and branches on the pointer's QUEST_PROXY_TAG
 * bit: the proxy arm loads QProxy.orig (subtracting the tag bit from the
 * offset, marked invariant since orig never changes), and the plain arm
 * forwards the pointer unchanged. Both arms jump to a continuation block
 * holding the rest of the original block, passing the unwrapped pointer as a
 * block parameter.
 *
 * Keeping opUnproxy as a single instruction until after optimization lets
 * value numbering merge duplicate unproxies across dominating blocks, so a
 * loop reading fields of a possibly proxied record checks the tag only
 * once. *)

interface Unproxies
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    lowerUnit(u: ssa.Unit): Ok
end
