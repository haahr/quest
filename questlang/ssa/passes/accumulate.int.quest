(* Quest Self-Hosted Compiler: The SSA's Accumulation Interface
 *
 * Turns recursion through an associative operation into a loop (docs/ssa.md
 * section 4.1, as in LLVM's accumulator recursion elimination). This pass
 * applies to a function that returns one integer and does not let any stack
 * slot's address escape. When a block calls the function itself, combines the
 * result with another value using add, mul, and, or, or xor, and returns that
 * result, the pass replaces the call and return with a jump to a loop header,
 * passing the call's arguments and the updated accumulator.
 *
 * The loop header takes over the entry block's instructions and gets block
 * parameters (SSA's form of variables merged at a control-flow join) for the
 * function's parameters plus the accumulator, which the entry initializes to
 * the operation's identity (1 for mul, ~1 for and, 0 otherwise). Each return
 * combines its value with the accumulator, and each self tail call jumps to
 * the header with the accumulator unchanged. Integer arithmetic wraps, so all
 * five operations are associative and commutative and combining in loop order
 * preserves the result. *)

interface Accumulate
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    accumulateFunction(f: ssa.Function): Ok
    accumulateUnit(u: ssa.Unit): Ok
end
