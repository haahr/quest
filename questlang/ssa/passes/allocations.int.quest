(* Quest Self-Hosted Compiler: The SSA's Inline Allocation Interface
 *
 * This pass expands each constant-size call to quest_alloc into the garbage
 * collector's inline bump-pointer allocation sequence (docs/collector.md
 * section 3.4, docs/ssa.md section 4.1). The arm64 and JIT backends cannot
 * inline the allocation helper from the runtime's C header as the C backend
 * does, and ssac's C printer calls every runtime function out of line.
 *
 * The expanded sequence loads the free-region cursor and limit for the
 * object's heap space. Unless a GC checking mode is active or the current
 * free hole has too little room, the fast path bumps the cursor past the
 * object and writes the layout header word before it. Otherwise, the slow
 * path calls quest_gc_alloc_slow, which finds the next hole or runs a
 * collection and writes the header word (including any GC mark flags during
 * incremental marking; docs/collector.md section 3.10). Both paths then set
 * the object's start bit in the collector's bitmap.
 *
 * Each layout's heap space is read from the unit's static layout data:
 * pointer-free layouts allocate in the noscan space, while runtime-owned
 * layouts and layouts with pointers allocate in the scanned space. *)

interface Allocations
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    inlineUnit(u: ssa.Unit): Ok
end
