(* Quest Self-Hosted Compiler: The SSA's Loops Interface
 *
 * Makes the loops that recursion is visible to the SSA, keeps module cells
 * in registers across them, and moves what is invariant out of them
 * (docs/ssa.md section 4.1).
 *
 * Each step is a module of its own, run in this order on each function:
 * ssa/passes/loops/selfCalls makes a self tail call a loop,
 * ssa/passes/loops/cells keeps module cells in registers,
 * ssa/passes/loops/hoisting moves what is invariant before each loop and
 * rotates it, and ssa/passes/loops/bounds decides bounds checks. Then values
 * are numbered and conditions decided again in each function that changed. *)

interface Loops
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    (* Each function's, numbering the values again and deciding the
     * conditions again of each that changed. A loop is rotated when its first
     * pass has no invariant check to move before it only if p.rotateAll: it
     * saves the jump back to the test, on arm64; clang rotates loops itself,
     * and a loop rotated before it reaches clang it can compile worse, so
     * ssac's policy turns it off. *)
    loopUnit(u: ssa.Unit p: ssa.Policy): Ok
    (* After ssa/passes/tailJumps: a function's one self tail call, as
     * ssa/passes/tailCalls marks it, a loop, as loopUnit makes one before
     * it, numbering the values of each that changed. tailJumps copies a
     * mutually recursive function into its caller, which can leave a self
     * tail call (even-odd's even1, odd1 copied in, calls even1) that the
     * backends would make a branch to the function's start, passing its
     * arguments again. *)
    loopTailCalls(u: ssa.Unit p: ssa.Policy): Ok
end
