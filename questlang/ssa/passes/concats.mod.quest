(* Quest Self-Hosted Compiler: The SSA's Concatenations Implementation *)

module concats : Concats
import
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash

    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/ssa/runtimeFunctions : questlang/ssa/RuntimeFunctions
export
    Let Function = ssa.Function

    (* The most parts quest_string_concat_n joins *)
    let most = 7

    let intEqual(a: Int b: Int): Bool = a is b

    let isConcat(i: ssa.Inst): Bool =
        ssa.isOp(i ssa.opCall) andif stringOp.equal(i.symbol "quest_string_concat") andif {extent i.args is 2}
            andif {extent i.results is 1}

    (* How many times each of f's values is used, by an instruction or a
     * terminator *)
    let useCounts(f: Function): Array(Int) =
        begin
            let counts = array of(vector.length(f.types) 0)
            for b = 0 upto {vector.length(f.blocks) - 1} do
                let blk = ssa.block(f b)
                for k = 0 upto {vector.length(blk.insts) - 1} do
                    let i = vector.get(blk.insts k)
                    for j = 0 upto {extent i.args - 1} do counts[i.args[j]] := counts[i.args[j]] + 1 end
                end
                let uses = ssa.terminatorUses(blk.term)
                for j = 0 upto {extent uses - 1} do counts[uses[j]] := counts[uses[j]] + 1 end
            end
            counts
        end

    (* Builds a call to quest_string_concat_n for parts (at most seven) with
     * result and source location loc. Appends the count constant and the null
     * instructions for unused trailing argument slots to emitted. *)
    let joinCall(f: Function emitted: vector.T(ssa.Inst) parts: vector.T(Int) result: Int loc: ssa.Loc): ssa.Inst =
        begin
            let r = runtimeFunctions.function("quest_string_concat_n")
            let n = vector.length(parts)
            let count = ssa.newValue(f ssa.typeInt)
            let c = ssa.instruction(ssa.opConst array of :Int end array of count end n "" 0 false
                    ssa.signature(array of :ssa.Type end array of :ssa.Type end array of :Int end array of :Int end))
            c.loc := loc
            vector.append(emitted c)
            let args = array of({most + 1} count)
            for k = 0 upto {most - 1} do
                if k < n then
                    args[k + 1] := vector.get(parts k)
                else
                    let v = ssa.newValue(f ssa.typePtr)
                    let z = ssa.instruction(ssa.opNull array of :Int end array of v end 0 "" 0 false c.signature)
                    z.loc := loc
                    vector.append(emitted z)
                    args[k + 1] := v
                end
            end
            let i = ssa.instruction(ssa.opCall args array of result end 0 "quest_string_concat_n" 0 false
                    runtimeFunctions.signature(r))
            i.loc := loc
            i
        end

    let concatBlock(f: Function b: Int counts: Array(Int)): Ok =
        begin
            let blk = ssa.block(f b)
            (* Track each concatenation's parts (by result value), the memory
             * generation in which it ran, and which results were absorbed
             * into a later concatenation. The memory generation counts prior
             * writes: a merged chain reads its parts at the final call site,
             * so a concatenation is not merged across a write (such as
             * setChar or a call that may write) that could mutate its parts. *)
            let partsOf = hashMap.new(:Int :vector.T(Int) intEqual hash.int)
            let memoryOf = hashMap.new(:Int :Int intEqual hash.int)
            let absorbed = hashMap.new(:Int :Bool intEqual hash.int)
            let var merged = false
            let var memory = 0
            for k = 0 upto {vector.length(blk.insts) - 1} do
                let i = vector.get(blk.insts k)
                if isConcat(i) then
                    let parts = vector.new(:Int)
                    for j = 0 upto 1 do
                        let a = i.args[j]
                        if hashMap.contains(partsOf a) andif {counts[a] is 1}
                                andif {hashMap.find(memoryOf a) is memory} then
                            let inner = hashMap.find(partsOf a)
                            for p = 0 upto {vector.length(inner) - 1} do vector.append(parts vector.get(inner p)) end
                            hashMap.insert(absorbed a true)
                            merged := true
                        else
                            vector.append(parts a)
                        end
                    end
                    hashMap.insert(partsOf i.results[0] parts)
                    hashMap.insert(memoryOf i.results[0] memory)
                    ok
                elsif ssa.isOp(i ssa.opStore) orif {ssa.isCall(i) andif runtimeFunctions.callWrites(i)} then
                    memory := memory + 1
                end
            end
            if merged then
                let emitted = vector.new(:ssa.Inst)
                for k = 0 upto {vector.length(blk.insts) - 1} do
                    let i = vector.get(blk.insts k)
                    if not(isConcat(i)) then vector.append(emitted i)
                    elsif hashMap.contains(absorbed i.results[0]) then ok
                    else
                        let var parts = hashMap.find(partsOf i.results[0])
                        if vector.length(parts) is 2 then
                            vector.append(emitted i)
                        else
                            (* Join seven parts at a time, passing each
                             * group's result as the first part of the next *)
                            while vector.length(parts) > most do
                                let group = vector.new(:Int)
                                for p = 0 upto {most - 1} do vector.append(group vector.get(parts p)) end
                                let joined = ssa.newValue(f ssa.typePtr)
                                vector.append(emitted joinCall(f emitted group joined i.loc))
                                let rest = vector.new(:Int)
                                vector.append(rest joined)
                                for p = most upto {vector.length(parts) - 1} do
                                    vector.append(rest vector.get(parts p))
                                end
                                parts := rest
                            end
                            vector.append(emitted joinCall(f emitted parts i.results[0] i.loc))
                        end
                    end
                end
                vector.clear(blk.insts)
                for k = 0 upto {vector.length(emitted) - 1} do vector.append(blk.insts vector.get(emitted k)) end
            end
        end

    let concatFunction(f: Function): Ok =
        begin
            let counts = useCounts(f)
            for b = 0 upto {vector.length(f.blocks) - 1} do concatBlock(f b counts) end
        end

    let concatUnit(u: ssa.Unit): Ok =
        for i = 0 upto {vector.length(u.functions) - 1} do concatFunction(vector.get(u.functions i)) end
end
