(* Quest Self-Hosted Compiler: The SSA's Concatenations Interface
 *
 * Merges chains of string concatenations (<>) into single allocations
 * (docs/ssa.md section 4.1). The IR is in A-normal form (every intermediate
 * expression is named and evaluated in order), so x <> y <> z arrives as two
 * calls to quest_string_concat with the first's result passed to the second.
 * Each call allocates a new string and copies both operands, so a chain of n
 * parts allocates n - 1 strings and copies early parts up to n - 1 times.
 *
 * When a quest_string_concat call takes the result of an earlier one in the
 * same block, and that intermediate result is used nowhere else with no
 * intervening memory write, the later call absorbs the earlier one's parts
 * and the earlier call is removed. Each merged chain becomes a call to
 * quest_string_concat_n, which allocates once and copies each part once. A
 * chain of more than seven parts is joined seven at a time. *)

interface Concats
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    (* Merges f's chains of concatenations *)
    concatFunction(f: ssa.Function): Ok
    concatUnit(u: ssa.Unit): Ok
end
