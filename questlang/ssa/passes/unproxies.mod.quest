(* Quest Self-Hosted Compiler: The SSA's Unproxies Implementation *)

module unproxies : Unproxies
import
    collections/vector : collections/Vector

    questlang/repr/runtimeLayout : questlang/repr/RuntimeLayout
    questlang/ssa/cfg : questlang/ssa/CFG
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    Let Function = ssa.Function

    (* Split block b at the opUnproxy instruction at index k, replacing it with
     * a tag-check branch and continuation block *)
    let lower(f: Function b: Int k: Int): Ok =
        begin
            let blk = ssa.block(f b)
            let i = vector.get(blk.insts k)
            let p = i.args[0]
            let at = i.loc
            f.at := at
            (* The rest of the block, after the instruction, which goes *)
            let tail = cfg.cutTail(f b k + 1)
            begin let ignored = vector.pop(blk.insts) end
            let none = array of :Int end
            let tag = runtimeLayout.constant("QUEST_PROXY_TAG")
            let tested = ssa.binary(f b ssa.opAnd ssa.emit(f b ssa.opPtrToInt array of p end ssa.typeInt)
                    ssa.constant(f b tag))
            let proxy = ssa.newBlock(f)
            let plain = ssa.newBlock(f)
            let rest = ssa.newBlock(f)
            blk.term := option termBranch of ssa.Terminator with
                let cond = tested
                let ifTrue = ssa.target(proxy none)
                let ifFalse = ssa.target(plain none)
            end
            blk.termLoc := at
            let orig = runtimeLayout.offset("QProxy" "orig") - tag
            let original = ssa.invariantLoad(f proxy p orig 8 false ssa.typePtr)
            let proxyBlk = ssa.block(f proxy)
            proxyBlk.term := ssa.jump(rest array of original end)
            proxyBlk.termLoc := at
            let plainBlk = ssa.block(f plain)
            plainBlk.term := ssa.jump(rest array of p end)
            plainBlk.termLoc := at
            (* The rest: the object is the instruction's result *)
            let moved = ssa.block(f rest)
            vector.append(moved.params i.results[0])
            cfg.appendTail(f rest tail)
        end

    let lowerFunction(f: Function): Ok =
        begin
            let var b = 0
            (* Each split appends a continuation block for the rest of the
             * block, which this loop visits in turn *)
            while b < vector.length(f.blocks) do
                let blk = ssa.block(f b)
                let var k = 0
                let var split = false
                while not(split) andif {k < vector.length(blk.insts)} do
                    if ssa.isOp(vector.get(blk.insts k) ssa.opUnproxy) then
                        lower(f b k)
                        split := true
                    end
                    k := k + 1
                end
                b := b + 1
            end
        end

    let lowerUnit(u: ssa.Unit): Ok =
        for i = 0 upto {vector.length(u.functions) - 1} do
            lowerFunction(vector.get(u.functions i))
        end
end
