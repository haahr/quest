(* Quest Self-Hosted Compiler: The SSA's Slot Promotion Implementation *)

module promote : Promote
import
    collections/vector : collections/Vector

    questlang/ssa/cfg : questlang/ssa/CFG
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/ssa/passNames : questlang/ssa/PassNames
export
    Let Function = ssa.Function

    let typeCode = ssa.typeCode
    let typeOfCode = ssa.typeOfCode

    (* The blocks some try's handler reaches. A raise arrives at a handler
     * with the values defined before its try and the memory the body wrote,
     * so a slot accessed in any of these blocks keeps its memory; one
     * accessed only elsewhere (by the body, or before the try, or in a
     * function with no try) can be promoted (docs/arm64.md section 3.6) *)
    let handlerReached(f: Function): Array(Bool) =
        begin
            let n = vector.length(f.blocks)
            let reached = array of(n false)
            let work = vector.new(:Int)
            let reach(b: Int): Ok = if not(reached[b]) then begin reached[b] := true vector.append(work b) end end
            for b = 0 upto {n - 1} do
                case ssa.block(f b).term
                    when termTry with x then reach(x.handler)
                    when termNone, termJump, termBranch, termSwitch, termReturn, termTailCall, termUnreachable then ok
                end
            end
            while not(vector.empty(work)) do
                let succs = ssa.successors(ssa.block(f vector.pop(work)).term)
                for k = 0 upto {extent succs - 1} do reach(succs[k]) end
            end
            reached
        end

    (* A function's slots and their words, the variables promotion makes *)
    Let Variables = Tuple
        (* The slot whose address each value is, ~1 for others *)
        slotOf: Array(Int)
        (* Each slot's first variable, and whether it is promoted *)
        base: Array(Int)
        promoted: Array(Bool)
        (* Each variable's type code *)
        kind: Array(Int)
    end

    (* The variable an access of a slot reads or writes, ~1 if it is not a
     * whole word or a word's first byte *)
    let variableOf(f: Function vs: Variables i: ssa.Inst): Int =
        begin
            let s = vs.slotOf[i.args[0]]
            let words = vector.get(f.slots s).bytes / 8
            let aligned = {i.imm >= 0} andif {{i.imm % 8} is 0} andif {{i.imm / 8} < words}
            if aligned andif {{i.width is 8} orif {i.width is 1}} then vs.base[s] + {i.imm / 8} else ~1 end
        end

    (* Finds the slots eligible for promotion: whole-word slots whose
     * addresses are used only for aligned 8-byte or 1-byte loads and stores,
     * and that are not accessed in a block reachable from a handler
     * (inHandler), where each word has one type, one store width, and is
     * never loaded whole after a byte store *)
    let variables(f: Function inHandler: Array(Bool)): Variables =
        begin
            let nSlots = vector.length(f.slots)
            let slotOf = array of(vector.length(f.types) ~1)
            for b = 0 upto {vector.length(f.blocks) - 1} do
                let blk = ssa.block(f b)
                for k = 0 upto {vector.length(blk.insts) - 1} do
                    let i = vector.get(blk.insts k)
                    if ssa.isOp(i ssa.opSlot) then slotOf[i.results[0]] := i.imm end
                end
            end
            let base = array of(nSlots 0)
            let promoted = array of(nSlots true)
            let var nVars = 0
            for s = 0 upto {nSlots - 1} do
                let bytes = vector.get(f.slots s).bytes
                base[s] := nVars
                if {bytes % 8} isnot 0 then promoted[s] := false else nVars := nVars + {bytes / 8} end
            end
            (* Each variable's type code (~2 before any access, ~1 once
             * accesses of two types meet); the width it is stored at (0 for
             * none yet, 8 or 1, or ~1 for both); and whether it is loaded
             * whole *)
            let kind = array of(nVars ~2)
            let stored = array of(nVars 0)
            let loadedWhole = array of(nVars false)
            let vs = tuple let slotOf = slotOf let base = base let promoted = promoted let kind = kind end
            let note(v: Int t: ssa.Type): Ok =
                if kind[v] is ~2 then kind[v] := typeCode(t) elsif kind[v] isnot typeCode(t) then kind[v] := ~1 end
            let escape(v: Int): Ok = if slotOf[v] >= 0 then promoted[slotOf[v]] := false end
            for b = 0 upto {vector.length(f.blocks) - 1} do
                let blk = ssa.block(f b)
                for k = 0 upto {vector.length(blk.insts) - 1} do
                    let i = vector.get(blk.insts k)
                    (* Any other use of a slot's address escapes, as does
                     * any use in a block a handler reaches *)
                    if ssa.isOp(i ssa.opSlot) then ok
                    elsif inHandler[b] then
                        for a = 0 upto {extent i.args - 1} do escape(i.args[a]) end
                    elsif ssa.isOp(i ssa.opLoad) then
                        let s = slotOf[i.args[0]]
                        if {s >= 0} andif promoted[s] then
                            let v = variableOf(f vs i)
                            if v < 0 then
                                promoted[s] := false
                            else
                                note(v ssa.typeOf(f i.results[0]))
                                if i.width is 8 then loadedWhole[v] := true end
                            end
                        end
                    elsif ssa.isOp(i ssa.opStore) then
                        let s = slotOf[i.args[0]]
                        if {s >= 0} andif promoted[s] then
                            let v = variableOf(f vs i)
                            if v < 0 then
                                promoted[s] := false
                            else
                                note(v ssa.typeOf(f i.args[1]))
                                if stored[v] is 0 then stored[v] := i.width
                                elsif stored[v] isnot i.width then stored[v] := ~1
                                end
                            end
                        end
                        escape(i.args[1])
                    else
                        for a = 0 upto {extent i.args - 1} do escape(i.args[a]) end
                    end
                end
                let uses = ssa.terminatorUses(blk.term)
                for a = 0 upto {extent uses - 1} do escape(uses[a]) end
                (* A try's handler record, which the try names by number *)
                case blk.term
                    when termTry with x then promoted[x.slot] := false
                    when termNone, termJump, termBranch, termSwitch, termReturn, termTailCall, termUnreachable then ok
                end
            end
            for s = 0 upto {nSlots - 1} do
                if promoted[s] then
                    for w = 0 upto {{vector.get(f.slots s).bytes / 8} - 1} do
                        let v = base[s] + w
                        (* Default an unaccessed word's type to integer *)
                        if kind[v] is ~2 then kind[v] := 0 end
                        if {kind[v] < 0} orif {stored[v] < 0} orif {{stored[v] is 1} andif loadedWhole[v]} then
                            promoted[s] := false
                        end
                    end
                end
            end
            vs
        end

    let promoteFunction(f: Function): Int =
        if vector.length(f.slots) is 0 then
            0
        else
            begin
                let nBlocks = vector.length(f.blocks)
                let nSlots = vector.length(f.slots)
                let nValues = vector.length(f.types)
                let inHandler = handlerReached(f)
                let vs = variables(f inHandler)
                let nVars = extent vs.kind
                let slotOf = vs.slotOf
                let promoted = vs.promoted
                let variableAt(i: ssa.Inst): Int =
                    if {slotOf[i.args[0]] >= 0} andif promoted[slotOf[i.args[0]]] then variableOf(f vs i) else ~1 end
                let g = cfg.graph(f)
                let frontier = cfg.frontiers(g)
                (* The blocks that store to each variable *)
                let stores = array of(nVars vector.new(:Int))
                for v = 0 upto {nVars - 1} do stores[v] := vector.new() end
                for b = 0 upto {nBlocks - 1} do
                    let blk = ssa.block(f b)
                    for k = 0 upto {vector.length(blk.insts) - 1} do
                        let i = vector.get(blk.insts k)
                        if ssa.isOp(i ssa.opStore) then
                            let v = variableAt(i)
                            if v >= 0 then vector.append(stores[v] b) end
                        end
                    end
                end
                (* Where each variable needs a block parameter: the iterated
                 * frontier of the blocks that store to it, but for the blocks
                 * a handler reaches. A promoted variable is not loaded in
                 * those, nor in any block after them, which a handler also
                 * reaches, so a parameter there would be dead, and the value
                 * a handler's path passed it would be kept live into the
                 * handler for nothing *)
                let needs = array of(nVars array of(0 false))
                for s = 0 upto {nSlots - 1} do
                    if promoted[s] then
                        for w = 0 upto {{vector.get(f.slots s).bytes / 8} - 1} do
                            let v = vs.base[s] + w
                            needs[v] := array of(nBlocks false)
                            let queued = array of(nBlocks false)
                            let work = vector.new(:Int)
                            for k = 0 upto {vector.length(stores[v]) - 1} do
                                let b = vector.get(stores[v] k)
                                if not(queued[b]) then begin queued[b] := true vector.append(work b) end end
                            end
                            while not(vector.empty(work)) do
                                let b = vector.pop(work)
                                for k = 0 upto {extent frontier[b] - 1} do
                                    let x = frontier[b][k]
                                    if not(needs[v][x]) andif not(inHandler[x]) then
                                        needs[v][x] := true
                                        if not(queued[x]) then
                                            queued[x] := true
                                            vector.append(work x)
                                        end
                                    end
                                end
                            end
                            (* A slot with a variable that needs a parameter
                             * at the entry (a loop back to it) is not
                             * promoted: the entry's parameters are the
                             * function's *)
                            if needs[v][0] then promoted[s] := false end
                        end
                    end
                end
                (* Promoted block parameters appended after each block's
                 * existing parameters *)
                let paramVariables = array of(nBlocks vector.new(:Int))
                let paramValues = array of(nBlocks vector.new(:Int))
                for b = 0 upto {nBlocks - 1} do
                    paramVariables[b] := vector.new()
                    paramValues[b] := vector.new()
                end
                for s = 0 upto {nSlots - 1} do
                    if promoted[s] then
                        for w = 0 upto {{vector.get(f.slots s).bytes / 8} - 1} do
                            let v = vs.base[s] + w
                            for b = 0 upto {nBlocks - 1} do
                                if needs[v][b] then
                                    vector.append(paramVariables[b] v)
                                    vector.append(paramValues[b] ssa.addParam(f b typeOfCode(vs.kind[v])))
                                end
                            end
                        end
                    end
                end
                (* Maps each promoted load's result to its replacement value,
                 * and collects entry-block zero instructions for loads that
                 * precede any store *)
                let replaced = array of(nValues ~1)
                let resolve(v: Int): Int =
                    begin
                        let var r = v
                        while {r < nValues} andif {replaced[r] >= 0} do r := replaced[r] end
                        r
                    end
                let zeros = array of(nVars ~1)
                let prelude = vector.new(:ssa.Inst)
                let current = array of(nVars ~1)
                let valueOf(v: Int): Int =
                    begin
                        if current[v] < 0 then
                            if zeros[v] < 0 then
                                let t = typeOfCode(vs.kind[v])
                                zeros[v] := ssa.newValue(f t)
                                let zero(op: ssa.Opcode args: Array(Int) result: Int): Ok =
                                    vector.append(prelude ssa.inst(op args array of result end))
                                case t
                                    when typeInt then zero(ssa.opConst array of :Int end zeros[v])
                                    when typePtr then zero(ssa.opNull array of :Int end zeros[v])
                                    when typeReal then zero(ssa.opRealConst array of :Int end zeros[v])
                                    (* A QVal (tagged runtime value) zero,
                                     * converted from an int zero *)
                                    when typeVal then
                                        let n = ssa.newValue(f ssa.typeInt)
                                        zero(ssa.opConst array of :Int end n)
                                        zero(ssa.opToVal array of n end zeros[v])
                                end
                            end
                            zeros[v]
                        else
                            current[v]
                        end
                    end
                let children = g.children
                (* Rename each block before its dominator-tree children using
                 * an explicit stack: push an exit marker before the children
                 * so definitions saved at block entry are restored on exit *)
                let stackBlocks = vector.new(:Int)
                let stackExits = vector.new(:Bool)
                let savedDefinitions = vector.new(:Array(Int))
                vector.append(stackBlocks 0)
                vector.append(stackExits false)
                while not(vector.empty(stackBlocks)) do
                    let b = vector.pop(stackBlocks)
                    if vector.pop(stackExits) then
                        let saved = vector.pop(savedDefinitions)
                        for v = 0 upto {nVars - 1} do current[v] := saved[v] end
                    else
                        let saved = array of(nVars 0)
                        for v = 0 upto {nVars - 1} do saved[v] := current[v] end
                        vector.append(savedDefinitions saved)
                        for k = 0 upto {vector.length(paramVariables[b]) - 1} do
                            current[vector.get(paramVariables[b] k)] := vector.get(paramValues[b] k)
                        end
                        let blk = ssa.block(f b)
                        let kept = vector.new(:ssa.Inst)
                        for k = 0 upto {vector.length(blk.insts) - 1} do
                            let i = vector.get(blk.insts k)
                            if ssa.isOp(i ssa.opSlot) then
                                if not(promoted[slotOf[i.results[0]]]) then vector.append(kept i) end
                            elsif ssa.isOp(i ssa.opLoad) andif {variableAt(i) >= 0} then
                                let v = variableAt(i)
                                if i.width is 8 then
                                    replaced[i.results[0]] := valueOf(v)
                                else
                                    (* Extract the low byte from the promoted
                                     * word via sign or zero extension *)
                                    let op = if i.signed then ssa.opSext8 else ssa.opZext8 end
                                    let extended = ssa.inst(op array of valueOf(v) end i.results)
                                    extended.loc := i.loc
                                    vector.append(kept extended)
                                end
                            elsif ssa.isOp(i ssa.opStore) andif {variableAt(i) >= 0} then
                                current[variableAt(i)] := resolve(i.args[1])
                            else
                                vector.append(kept i)
                            end
                        end
                        vector.clear(blk.insts)
                        for k = 0 upto {vector.length(kept) - 1} do
                            vector.append(blk.insts vector.get(kept k))
                        end
                        let ts = ssa.targets(blk.term)
                        for k = 0 upto {extent ts - 1} do
                            let t = ts[k]
                            let n = vector.length(paramVariables[t.block])
                            if n > 0 then
                                let args = array of({extent t.args + n} 0)
                                for a = 0 upto {extent t.args - 1} do args[a] := t.args[a] end
                                for a = 0 upto {n - 1} do
                                    args[extent t.args + a] := valueOf(vector.get(paramVariables[t.block] a))
                                end
                                t.args := args
                            end
                        end
                        vector.append(stackBlocks b)
                        vector.append(stackExits true)
                        for k = {extent children[b] - 1} downto 0 do
                            vector.append(stackBlocks children[b][k])
                            vector.append(stackExits false)
                        end
                    end
                end
                (* Renumber the unpromoted slots, prepend entry-block zero
                 * instructions, and rewrite all uses of promoted loads *)
                let renumbered = array of(nSlots ~1)
                let left = vector.new(:ssa.Slot)
                let var count = 0
                for s = 0 upto {nSlots - 1} do
                    if promoted[s] then
                        count := count + 1
                    else
                        renumbered[s] := vector.length(left)
                        vector.append(left vector.get(f.slots s))
                    end
                end
                vector.clear(f.slots)
                for s = 0 upto {vector.length(left) - 1} do
                    vector.append(f.slots vector.get(left s))
                end
                for b = 0 upto {nBlocks - 1} do
                    let blk = ssa.block(f b)
                    if b is 0 then
                        let rest = vector.copy(blk.insts)
                        vector.clear(blk.insts)
                        for k = 0 upto {vector.length(prelude) - 1} do
                            vector.append(blk.insts vector.get(prelude k))
                        end
                        for k = 0 upto {vector.length(rest) - 1} do
                            vector.append(blk.insts vector.get(rest k))
                        end
                    end
                    for k = 0 upto {vector.length(blk.insts) - 1} do
                        let i = vector.get(blk.insts k)
                        if ssa.isOp(i ssa.opSlot) then i.imm := renumbered[i.imm] end
                    end
                    (* A try names its handler record's slot, which is kept *)
                    case blk.term
                        when termTry with x then
                            blk.term := option termTry of ssa.Terminator with
                                let slot = renumbered[x.slot]
                                let body = x.body
                                let handler = x.handler
                            end
                        when termNone, termJump, termBranch, termSwitch, termReturn, termTailCall, termUnreachable then
                            ok
                    end
                end
                ssa.replaceUses(f resolve)
                count
            end
        end

    let promoteAgain(f: Function): Ok = if not(passNames.skipped("promote")) then let ignored = promoteFunction(f) end

    let promoteUnit(u: ssa.Unit): Int =
        begin
            let var count = 0
            for i = 0 upto {vector.length(u.functions) - 1} do
                count := count + promoteFunction(vector.get(u.functions i))
            end
            count
        end
end
