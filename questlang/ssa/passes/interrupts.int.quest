(* Quest Self-Hosted Compiler: The SSA's Interrupt Checks Interface
 *
 * This pass inserts periodic interrupt checks for the Jupyter kernel's JIT
 * driver (--kernel; docs/jupyter-kernel.md section 5). The generated code
 * checks the runtime's interrupt flag (set by its SIGINT handler) at each
 * function entry and at every loop header (a block targeted by a back edge),
 * raising `interrupted` if the flag is nonzero. Each check splits the block,
 * moving its original instructions and terminator into a new block after a
 * load of quest_interrupt_pending and a branch to a shared block that calls
 * quest_interrupt_raise. Other compilation modes do not run this pass (see
 * ssa/pipeline's setInterruptChecks). *)

interface Interrupts
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    checkUnit(u: ssa.Unit): Ok
end
