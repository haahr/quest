(* Quest Self-Hosted Compiler: The SSA's Tables Interface
 *
 * This pass turns constant-returning switches into static lookup-table loads
 * (docs/ssa.md section 4.1). A switch qualifies if every arm jumps (possibly
 * through blocks containing only constant definitions) to the same join block
 * and passes constant arguments. It is replaced by a range check on the
 * switched value and, for each join-block parameter that varies across arms,
 * a load from a read-only static table indexed by `value - minCase`. For
 * example, nodes.opcodeIndex maps each opcode to an integer; without this
 * pass, the arm64 backend emits a compare-and-branch chain instead of a
 * single indexed load.
 *
 * A switch must have at least 4 cases and be dense (the span `max - min` must
 * be less than twice the case count). If the range has gaps, the default arm
 * must also jump to the same join block with constants so its values can fill
 * the gap entries; otherwise the default arm may do anything and handles
 * out-of-range values. Varying arguments may be integers or symbol addresses
 * (including string literals, which are static object addresses), while
 * parameters passed identically by all arms are forwarded unchanged. Switches
 * with real-typed varying parameters or no varying parameters are left
 * unchanged. *)

interface Tables
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    (* Replace eligible switches in f with table lookups, appending the static
     * tables to u *)
    tableFunction(u: ssa.Unit f: ssa.Function): Ok
    tableUnit(u: ssa.Unit): Ok
end
