(* Quest Self-Hosted Compiler: The SSA's Value Numbering Implementation *)

module valueNumbers : ValueNumbers
import
    conv : Conv
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/ssa/cfg : questlang/ssa/CFG
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/ssa/runtimeFunctions : questlang/ssa/RuntimeFunctions
export
    Let Function = ssa.Function
    (* An address as its base and index, as text, and a constant offset *)
    Let Address = Tuple base: String offset: Int end

    (* Whether an instruction is numbered: a pure one, or a load (an
     * ordinary one only while nothing writes memory) *)
    let numbered(i: ssa.Inst): Bool =
        case i.op
            when opConst, opRealConst, opSymbol, opNull, opSlot, opPtrAdd, opAdd, opSub, opMul,
                    opMulHiU, opDiv, opRem, opAnd, opOr, opXor, opShl, opLshr, opAshr, opEq, opNe, opLt, opLe, opGt,
                    opGe,
                    opUlt, opPeq, opPne, opFadd, opFsub, opFmul, opFdiv, opFeq, opFlt, opFle, opFgt, opFge, opIsNaN,
                    opIntToPtr, opPtrToInt, opRealBits, opBitsReal, opIntToReal, opSext8, opZext8, opToVal, opFromVal,
                    opSelect,
                    opUnproxy then
                true
            when opLoad then true
            when opStore, opCall, opCallIndirect, opCopy then false
        end

    (* Whether an instruction may be replaced only by an equal in its own
     * block. This includes operations that arm64 instruction selection fuses
     * into a same-block branch or memory access (codegen/arm64/select's fused
     * and indexOf), plus constants, symbol addresses, and nulls, which
     * otherwise stay live across blocks and spill to the stack because
     * arm64's register allocator does not rematerialize (recompute) them
     * (docs/ssa.md section 4.1: hamlet's stack accesses rose from 8,129 to
     * 10,022). *)
    let local(op: ssa.Opcode): Bool =
        case op
            when opEq, opNe, opLt, opLe, opGt, opGe, opUlt, opPeq, opPne, opFeq, opFlt, opFle, opFgt, opFge, opIsNaN,
                    opAnd, opMul, opPtrAdd, opConst, opRealConst, opSymbol, opNull then
                true
            else false
        end

    let commutative(op: ssa.Opcode): Bool =
        case op
            when opAdd, opMul, opMulHiU, opAnd, opOr, opXor, opEq, opNe, opPeq, opPne, opFadd, opFmul, opFeq then true
            else false
        end

    (* Whether an instruction left without uses can be removed *)
    let removable(i: ssa.Inst): Bool = numbered(i) orif ssa.isOp(i ssa.opLoad) orif ssa.isOp(i ssa.opCopy)

    let numberFunction(f: Function): Ok =
        begin
            let n = vector.length(f.types)
            let nBlocks = vector.length(f.blocks)
            let g = cfg.graph(f)
            (* What each value is replaced by, a chain ending at a value that
             * stays *)
            let repl = array of(n 0)
            for v = 0 upto {n - 1} do repl[v] := v end
            let find(v: Int): Int =
                begin
                    let var r = v
                    while repl[r] isnot r do r := repl[r] end
                    r
                end
            let defs = ssa.definitions(f)
            let constantOf(v: Int): maybe.T(Int) =
                if maybe.isSome(defs[v]) andif ssa.isOp(maybe.unwrap(defs[v]) ssa.opConst) then
                    maybe.some(maybe.unwrap(defs[v]).imm)
                else
                    maybe.none()
                end

            (* Collect incoming jumps to each block and collapse trivial block
             * parameters (ones every jump binds to the same value or to the
             * parameter itself) to a fixed point *)
            let incoming = array of(nBlocks vector.new(:ssa.Target))
            for b = 0 upto {nBlocks - 1} do incoming[b] := vector.new() end
            for b = 0 upto {nBlocks - 1} do
                let ts = ssa.targets(ssa.block(f b).term)
                for k = 0 upto {extent ts - 1} do vector.append(incoming[ts[k].block] ts[k]) end
            end
            let dropped = array of(n false)
            let var changed = true
            while changed do
                changed := false
                for b = 1 upto {nBlocks - 1} do
                    let params = ssa.block(f b).params
                    let jumps = incoming[b]
                    for j = 0 upto {vector.length(params) - 1} do
                        let p = vector.get(params j)
                        if not(dropped[p]) andif not(vector.empty(jumps)) then
                            let var same = ~1
                            let var trivial = true
                            for k = 0 upto {vector.length(jumps) - 1} do
                                let a = find(vector.get(jumps k).args[j])
                                if a isnot p then
                                    if same < 0 then same := a elsif a isnot same then trivial := false end
                                end
                            end
                            if trivial andif {same >= 0} then
                                repl[p] := same
                                dropped[p] := true
                                changed := true
                            end
                        end
                    end
                end
            end

            (* An address as a base, an index (or ~1), and a constant offset,
             * through pointer additions *)
            let address(v: Int offset: Int): Address =
                begin
                    let var base = find(v)
                    let var index = ~1
                    let var off = offset
                    let var more = true
                    while more do
                        more := false
                        let def = defs[base]
                        if maybe.isSome(def) andif ssa.isOp(maybe.unwrap(def) ssa.opPtrAdd) then
                            let d = maybe.unwrap(def)
                            let c = constantOf(find(d.args[1]))
                            if maybe.isSome(c) then
                                off := off + maybe.unwrap(c)
                                base := find(d.args[0])
                                more := true
                            elsif index < 0 then
                                index := find(d.args[1])
                                base := find(d.args[0])
                                more := true
                            end
                        end
                    end
                    tuple let base = conv.int(base) <> " " <> conv.int(index) let offset = off end
                end
            let addressKey(v: Int offset: Int): String =
                begin
                    let a = address(v offset)
                    a.base <> " " <> conv.int(a.offset)
                end
            (* An ordinary load's key, in the memory generation it reads, which
             * a store of the same address and type makes too *)
            let loadKey(width: Int signed: Bool t: String address: Int offset: Int memory: Int): String =
                "load" <> conv.int(width) <> if signed then "s " else " " end <> t <> " " <> addressKey(address offset)
                    <> " in " <> conv.int(memory)
            let key(i: ssa.Inst b: Int memory: Int): String =
                begin
                    let t = ssa.typeName(ssa.typeOf(f i.results[0]))
                    if ssa.isOp(i ssa.opLoad) andif i.invariant then
                        "invariant load" <> conv.int(i.width) <> if i.signed then "s " else " " end <> t <> " "
                            <> addressKey(i.args[0] i.imm)
                    elsif ssa.isOp(i ssa.opLoad) then
                        loadKey(i.width i.signed t i.args[0] i.imm memory)
                    else
                        (* Format each operand by its value number — or by its
                         * constant value, since constants are only numbered
                         * within a block — and sort commutative operands *)
                        let args = array of(extent i.args "")
                        for a = 0 upto {extent i.args - 1} do
                            let v = find(i.args[a])
                            let c = constantOf(v)
                            args[a] := if maybe.isSome(c) then "#" <> conv.int(maybe.unwrap(c))
                                else conv.int(v) end
                        end
                        if commutative(i.op) andif {extent args is 2} andif stringOp.precedes(args[1] args[0]) then
                            let first = args[0]
                            args[0] := args[1]
                            args[1] := first
                        end
                        ssa.opcodeName(i.op) <> " " <> t <> " " <> conv.int(i.imm) <> " " <> i.symbol
                            <> if extent args > 0 then " " <> strutil.joinArray(" " args) else "" end
                            <> if local(i.op) then " @" <> conv.int(b) else "" end
                    end
                end

            (* Walk the dominator tree in preorder. A table entry is valid
             * only while its defining block dominates the current block;
             * entries from already-finished subtrees are overwritten on
             * collision. Memory state is tracked by a generation counter that
             * increments on any store or writing call; a block inherits its
             * sole predecessor's generation unless it is a try handler (since
             * the try body may have written memory before raising), and
             * otherwise starts a fresh generation. *)
            let table = hashMap.new(:String :Int stringOp.equal hash.string)
            let madeIn = hashMap.new(:String :Int stringOp.equal hash.string)
            let enter(text: String v: Int b: Int): Ok =
                begin
                    let ignored = hashMap.insert(table text v)
                    let alsoIgnored = hashMap.insert(madeIn text b)
                end
            let handler = array of(nBlocks false)
            for b = 0 upto {nBlocks - 1} do
                case ssa.block(f b).term when termTry with x then handler[x.handler] := true else ok end
            end
            let memoryAtEnd = array of(nBlocks 0)
            let var generations = 0
            let stack = vector.new(:Int)
            if nBlocks > 0 then vector.append(stack 0) end
            while not(vector.empty(stack)) do
                let b = vector.pop(stack)
                let blk = ssa.block(f b)
                let kept = vector.new(:ssa.Inst)
                (* Record the 8-byte word addresses loaded in this block. A
                 * word load whose neighboring word (+/- 8 bytes) is also
                 * loaded here is kept even if a dominating block has an equal
                 * load, so arm64 can fuse the pair into an ldp instruction
                 * (codegen/arm64/peephole's pairs). Replacing one half of a
                 * pair breaks ldp formation (which slowed psdes-random's loop
                 * from 1.39x to 1.90x of C's time). *)
                let words = hashMap.new(:String :Bool stringOp.equal hash.string)
                for k = 0 upto {vector.length(blk.insts) - 1} do
                    let i = vector.get(blk.insts k)
                    if ssa.isOp(i ssa.opLoad) andif {i.width is 8} then
                        let ignored = hashMap.insert(words addressKey(i.args[0] i.imm) true)
                    end
                end
                let paired(i: ssa.Inst): Bool =
                    if ssa.isOp(i ssa.opLoad) andif {i.width is 8} then
                        let a = address(i.args[0] i.imm)
                        hashMap.contains(words a.base <> " " <> conv.int(a.offset + 8))
                            orif hashMap.contains(words a.base <> " " <> conv.int(a.offset - 8))
                    else
                        false
                    end
                let var memory = 0
                if {extent g.preds[b] is 1} andif not(handler[b]) then
                    memory := memoryAtEnd[g.preds[b][0]]
                else
                    generations := generations + 1
                    memory := generations
                end
                for k = 0 upto {vector.length(blk.insts) - 1} do
                    let i = vector.get(blk.insts k)
                    if ssa.isOp(i ssa.opCopy) then repl[i.results[0]] := find(i.args[0])
                    elsif numbered(i) andif {extent i.results is 1} then
                        let text = key(i b memory)
                        let found = hashMap.get(table text)
                        let at = maybe.unwrapOr(hashMap.get(madeIn text) ~1)
                        if maybe.isSome(found) andif cfg.dominates(g at b)
                                andif {{at is b} orif not(paired(i))} then
                            repl[i.results[0]] := maybe.unwrap(found)
                        else
                            enter(text i.results[0] b)
                            vector.append(kept i)
                        end
                    elsif ssa.isOp(i ssa.opStore) then
                        vector.append(kept i)
                        generations := generations + 1
                        memory := generations
                        (* What a whole word's store stores is what a load of
                         * it reads, until memory is written again *)
                        if i.width is 8 then
                            let v = find(i.args[1])
                            enter(loadKey(8 false ssa.typeName(ssa.typeOf(f v)) i.args[0] i.imm memory) v b)
                        end
                    elsif ssa.isCall(i) then
                        vector.append(kept i)
                        if runtimeFunctions.callWrites(i) then
                            generations := generations + 1
                            memory := generations
                        end
                    else vector.append(kept i)
                    end
                end
                memoryAtEnd[b] := memory
                vector.clear(blk.insts)
                for k = 0 upto {vector.length(kept) - 1} do
                    vector.append(blk.insts vector.get(kept k))
                end
                let children = g.children[b]
                for c = 0 upto {extent children - 1} do
                    vector.append(stack children[{extent children - 1} - c])
                end
            end
            ssa.replaceUses(f find)

            (* Remove collapsed block parameters and their incoming jump
             * arguments *)
            for b = 0 upto {nBlocks - 1} do
                let ts = ssa.targets(ssa.block(f b).term)
                for k = 0 upto {extent ts - 1} do
                    let to = ssa.block(f ts[k].block).params
                    let args = vector.new(:Int)
                    for j = 0 upto {extent ts[k].args - 1} do
                        if not(dropped[vector.get(to j)]) then vector.append(args ts[k].args[j]) end
                    end
                    ts[k].args := vector.toArray(args)
                end
            end
            for b = 0 upto {nBlocks - 1} do
                let params = ssa.block(f b).params
                let left = vector.new(:Int)
                for j = 0 upto {vector.length(params) - 1} do
                    let p = vector.get(params j)
                    if not(dropped[p]) then vector.append(left p) end
                end
                vector.clear(params)
                for j = 0 upto {vector.length(left) - 1} do vector.append(params vector.get(left j)) end
            end

            (* Remove dead removable instructions (those with no remaining
             * uses) to a fixed point *)
            let uses = array of(n 0)
            for b = 0 upto {nBlocks - 1} do
                let blk = ssa.block(f b)
                for k = 0 upto {vector.length(blk.insts) - 1} do
                    let i = vector.get(blk.insts k)
                    for a = 0 upto {extent i.args - 1} do uses[i.args[a]] := uses[i.args[a]] + 1 end
                end
                let us = ssa.terminatorUses(blk.term)
                for a = 0 upto {extent us - 1} do uses[us[a]] := uses[us[a]] + 1 end
            end
            let unused(i: ssa.Inst): Bool =
                begin
                    let var none = removable(i)
                    for r = 0 upto {extent i.results - 1} do if uses[i.results[r]] > 0 then none := false end end
                    none
                end
            changed := true
            while changed do
                changed := false
                for b = 0 upto {nBlocks - 1} do
                    let insts = ssa.block(f b).insts
                    let kept = vector.new(:ssa.Inst)
                    for k = 0 upto {vector.length(insts) - 1} do
                        let i = vector.get(insts {vector.length(insts) - 1} - k)
                        if unused(i) then
                            for a = 0 upto {extent i.args - 1} do uses[i.args[a]] := uses[i.args[a]] - 1 end
                            changed := true
                        else
                            vector.append(kept i)
                        end
                    end
                    vector.clear(insts)
                    for k = 0 upto {vector.length(kept) - 1} do
                        let last = vector.length(kept) - 1
                        vector.append(insts vector.get(kept last - k))
                    end
                end
            end
        end

    let numberUnit(u: ssa.Unit): Ok =
        for i = 0 upto {vector.length(u.functions) - 1} do
            numberFunction(vector.get(u.functions i))
        end
end
