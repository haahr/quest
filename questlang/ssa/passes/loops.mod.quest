(* Quest Self-Hosted Compiler: The SSA's Loops Implementation *)

module loops : Loops
import
    conv : Conv
    stringOp = string : StringOp

    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/repr/runtimeLayout : questlang/repr/RuntimeLayout
    questlang/ssa/blockParams : questlang/ssa/BlockParams
    questlang/ssa/cfg : questlang/ssa/CFG
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/ssa/passes/conditions : questlang/ssa/passes/Conditions
    questlang/ssa/passes/promote : questlang/ssa/passes/Promote
    questlang/ssa/passes/tailCalls : questlang/ssa/passes/TailCalls
    questlang/ssa/passes/valueNumbers : questlang/ssa/passes/ValueNumbers
    questlang/ssa/runtimeFunctions : questlang/ssa/RuntimeFunctions
export
    Let Function = ssa.Function

    (* Whether vs and ws are the same values, in order *)
    let same(vs: Array(Int) ws: Array(Int)): Bool =
        begin
            let var equal = extent vs is extent ws
            for k = 0 upto {extent vs - 1} do if equal andif {vs[k] isnot ws[k]} then equal := false end end
            equal
        end

    (* Whether blk ends in a call of f itself whose results blk returns,
     * directly or through blocks that only pass them on *)
    let selfTail(f: Function blk: ssa.Block): Bool =
        begin
            let n = vector.length(blk.insts)
            if n is 0 then
                false
            else
                let last = vector.get(blk.insts {n - 1})
                if ssa.isOp(last ssa.opCall) andif stringOp.equal(last.symbol f.symbol)
                        andif {extent last.args is vector.length(f.paramTypes)} then
                    case blk.term
                        when termReturn with x then same(x.values last.results)
                        when termJump with x then tailCalls.returnsThrough(f x.target last.results)
                        when termNone, termBranch, termSwitch, termTailCall, termTry, termUnreachable then false
                    end
                else
                    false
                end
            end
        end

    (* Whether blk ends in a tail call of f itself, as ssa/passes/tailCalls
     * marks one, with all of f's arguments *)
    let selfTailCall(f: Function blk: ssa.Block): Bool =
        case blk.term
            when termTailCall with x then
                ssa.isOp(x.call ssa.opCall) andif stringOp.equal(x.call.symbol f.symbol)
                    andif {extent x.call.args is vector.length(f.paramTypes)}
            when termNone, termJump, termBranch, termSwitch, termReturn, termTry, termUnreachable then false
        end

    (* Makes f's one self tail call a loop: a call followed by its return
     * before tailCalls (marked false), or a tail call after it (marked true) *)
    let loopSites(f: Function marked: Bool): Bool =
        begin
            let sites = vector.new(:Int)
            if not(tailCalls.slotsEscape(f)) then
                for b = 0 upto {vector.length(f.blocks) - 1} do
                    let blk = ssa.block(f b)
                    if if marked then selfTailCall(f blk) else selfTail(f blk) end then vector.append(sites b) end
                end
            end
            (* A marked site is a call and a return of its results again, the
             * shape the conversion below takes, when it is the only one *)
            if marked andif {vector.length(sites) is 1} then
                let blk = ssa.block(f vector.get(sites 0))
                case blk.term
                    when termTailCall with x then
                        vector.append(blk.insts x.call)
                        blk.term := option termReturn of ssa.Terminator with let values = x.call.results end
                    when termNone, termJump, termBranch, termSwitch, termReturn, termTry, termUnreachable then ok
                end
            end
            (* Two or more sites are loops nested in one function (an outer
             * one inlined into its inner one's, say), which one header would
             * merge: clang keeps them apart from the calls, and the backends
             * make each call a jump as before *)
            if vector.length(sites) isnot 1 then
                false
            else
                (* The header takes the entry's instructions and terminator,
                 * with fresh parameters that replace the function's *)
                let entry = ssa.block(f 0)
                let params = vector.toArray(entry.params)
                let header = blockParams.splitEntry(f).header
                let h = ssa.block(f header)
                (* Each site's call, its arguments renamed by replaceUses, is
                 * a jump to the header; a site in the entry is now in the
                 * header *)
                for k = 0 upto {vector.length(sites) - 1} do
                    let s = vector.get(sites k)
                    let blk = ssa.block(f if s is 0 then header else s end)
                    let call = vector.pop(blk.insts)
                    blk.term := ssa.jump(header call.args)
                    blk.termLoc := call.loc
                end
                entry.term := ssa.jump(header params)
                entry.termLoc := h.termLoc
                true
            end
        end

    let loopFunction(f: Function): Bool = loopSites(f false)

    (* =========================================================================
     * Module cells kept in registers across loops
     * ====================================================================== *)

    (* Whether a call i in a loop leaves its memory alone and returns: a direct
     * call of a runtime function that writes no memory, cannot raise, and
     * returns (quest_alloc writes only the object it makes) *)
    let calm(i: ssa.Inst): Bool =
        if ssa.isOp(i ssa.opCallIndirect) then
            false
        else
            let var known = false
            for k = 0 upto {extent runtimeFunctions.functions - 1} do
                let r = runtimeFunctions.functions[k]
                if stringOp.equal(r.name i.symbol) then
                    known := case r.effects.memory when memoryWrites then false else true end
                        andif not(r.effects.raises) andif not(r.effects.noReturn)
                end
            end
            known
        end

    (* The blocks of the natural loop whose header is h: those that reach one
     * of h's back edges' sources without passing h, h among them; none when h
     * heads no loop *)
    let body(g: cfg.Graph h: Int): Array(Bool) =
        begin
            let n = extent g.preds
            let inside = array of(n false)
            let work = vector.new(:Int)
            for k = 0 upto {extent g.preds[h] - 1} do
                let p = g.preds[h][k]
                if cfg.reached(g p) andif cfg.dominates(g h p) then vector.append(work p) end
            end
            if not(vector.empty(work)) then inside[h] := true end
            while not(vector.empty(work)) do
                let b = vector.pop(work)
                if not(inside[b]) then
                    inside[b] := true
                    for k = 0 upto {extent g.preds[b] - 1} do
                        let p = g.preds[b][k]
                        if cfg.reached(g p) andif not(inside[p]) then vector.append(work p) end
                    end
                end
            end
            inside
        end

    (* A module cell's word: the global symbol holding the cell's address, the
     * offset of the address in it, and the word's offset in the cell *)
    Let Cell = Tuple symbol: String at: Int offset: Int type: ssa.Type end

    (* The global and offset whose load made address a, if one did: a global
     * of the unit's (g_...) that the loop does not store to, which only its
     * module's initialization writes, or a word an invariant load reads *)
    Let Base = Tuple symbol: String at: Int end
    let baseOf(defs: Array(maybe.T(ssa.Inst)) a: Int): maybe.T(Base) =
        if maybe.isNone(defs[a]) then
            maybe.none()
        else
            let d = maybe.unwrap(defs[a])
            if ssa.isOp(d ssa.opLoad) andif {d.width is 8} andif maybe.isSome(defs[d.args[0]])
                    andif ssa.isOp(maybe.unwrap(defs[d.args[0]]) ssa.opSymbol)
                    andif {d.invariant orif strutil.startsWith(maybe.unwrap(defs[d.args[0]]).symbol "g_")} then
                maybe.some(tuple let symbol = maybe.unwrap(defs[d.args[0]]).symbol let at = d.imm end)
            else
                maybe.none()
            end
        end

    let sameBase(x: maybe.T(Base) y: Base): Bool =
        maybe.isSome(x) andif stringOp.equal(maybe.unwrap(x).symbol y.symbol) andif {maybe.unwrap(x).at is y.at}

    (* An access's address, offset, and width, if i is a load or a store *)
    Let Access = Tuple address: Int offset: Int width: Int end
    let accessOf(i: ssa.Inst): maybe.T(Access) =
        if ssa.isOp(i ssa.opLoad) orif ssa.isOp(i ssa.opStore) then
            maybe.some(tuple let address = i.args[0] let offset = i.imm let width = i.width end)
        else
            maybe.none()
        end

    (* The type a load reads or a store writes *)
    let accessType(f: Function i: ssa.Inst): ssa.Type =
        if ssa.isOp(i ssa.opLoad) then ssa.typeOf(f i.results[0]) else ssa.typeOf(f i.args[1]) end

    (* Whether access i cannot reach a cell's word, whatever its offset: an
     * access of a stack slot or of a global's own word (g_..., a variable's
     * word, never an object's), or an invariant load, which reads a word that
     * nothing writes once made *)
    let apart(defs: Array(maybe.T(ssa.Inst)) i: ssa.Inst): Bool =
        if ssa.isOp(i ssa.opLoad) andif i.invariant then true
        elsif maybe.isNone(defs[i.args[0]]) then false
        else
            let d = maybe.unwrap(defs[i.args[0]])
            ssa.isOp(d ssa.opSlot) orif {ssa.isOp(d ssa.opSymbol) andif strutil.startsWith(d.symbol "g_")}
        end

    (* A cell the loop of h stores to and may keep in a register: its word is
     * read and written only whole, as an Int or a Real, through the global's
     * invariant load; no other access in the loop can reach the word (one at
     * an overlapping offset through any other address, but a stack slot's);
     * and the loop makes no call but calm ones, and enters no try *)
    let candidate(f: Function g: cfg.Graph defs: Array(maybe.T(ssa.Inst)) inside: Array(Bool)): maybe.T(Cell) =
        begin
            let var fine = true
            let cells = vector.new(:Cell)
            let accesses = vector.new(:ssa.Inst)
            for b = 0 upto {extent inside - 1} do
                if inside[b] then
                    let blk = ssa.block(f b)
                    case blk.term when termTry then fine := false else ok end
                    for k = 0 upto {vector.length(blk.insts) - 1} do
                        let i = vector.get(blk.insts k)
                        if ssa.isCall(i) then
                            if not(calm(i)) then fine := false end
                        elsif maybe.isSome(accessOf(i)) then
                            vector.append(accesses i)
                            let base = baseOf(defs i.args[0])
                            let t = accessType(f i)
                            if ssa.isOp(i ssa.opStore) andif maybe.isSome(base) andif {i.width is 8}
                                    andif {{t is ssa.typeInt} orif {t is ssa.typeReal}} then
                                let bb = maybe.unwrap(base)
                                vector.append(cells tuple
                                    let symbol = bb.symbol
                                    let at = bb.at
                                    let offset = i.imm
                                    let type = t
                                end)
                            end
                        end
                    end
                end
            end
            let var found = maybe.none(:Cell)
            if fine then
                for c = 0 upto {vector.length(cells) - 1} do
                    if maybe.isNone(found) then
                        let cell = vector.get(cells c)
                        let base = tuple let symbol = cell.symbol let at = cell.at end
                        let var clear = true
                        (* The global itself is not written in the loop *)
                        for k = 0 upto {vector.length(accesses) - 1} do
                            let i = vector.get(accesses k)
                            if ssa.isOp(i ssa.opStore) andif maybe.isSome(defs[i.args[0]])
                                    andif ssa.isOp(maybe.unwrap(defs[i.args[0]]) ssa.opSymbol)
                                    andif stringOp.equal(maybe.unwrap(defs[i.args[0]]).symbol cell.symbol) then
                                clear := false
                            end
                        end
                        for k = 0 upto {vector.length(accesses) - 1} do
                            let i = vector.get(accesses k)
                            let a = maybe.unwrap(accessOf(i))
                            let overlaps = {a.offset < cell.offset + 8} andif {cell.offset < a.offset + a.width}
                            if overlaps andif not(apart(defs i)) then
                                if sameBase(baseOf(defs a.address) base) then
                                    if {a.offset isnot cell.offset} orif {a.width isnot 8}
                                            orif {accessType(f i) isnot cell.type} then
                                        clear := false
                                    end
                                else
                                    clear := false
                                end
                            end
                        end
                        if clear then found := maybe.some(cell) end
                    end
                end
            end
            found
        end

    (* Appends instructions to block b, which is terminated, before its
     * terminator *)
    let before(f: Function b: Int emitting: All() Ok): Ok =
        begin
            let blk = ssa.block(f b)
            let t = blk.term
            blk.term := ssa.termNone
            emitting()
            blk.term := t
        end

    (* The cell's address, loaded from its global in block b *)
    let cellAddress(f: Function b: Int cell: Cell): Int =
        ssa.invariantLoad(f b ssa.symbolAddress(f b cell.symbol) cell.at 8 false ssa.typePtr)

    (* Keeps cell in a stack slot across the loop of h: each predecessor from
     * outside loads the cell's word into it, the loop's accesses use it, and
     * each edge that leaves the loop stores it back, in a block of its own *)
    let keep(f: Function g: cfg.Graph defs: Array(maybe.T(ssa.Inst)) h: Int inside: Array(Bool) cell: Cell): Ok =
        begin
            let slot = ssa.newSlot(f 8 8)
            let var address = 0
            before(f 0 fun(): Ok address := ssa.slotAddress(f 0 slot))
            let slotAt = address
            for k = 0 upto {extent g.preds[h] - 1} do
                let p = g.preds[h][k]
                if not(inside[p]) then
                    before(f p fun(): Ok
                        ssa.store(f p slotAt 0 8 ssa.load(f p cellAddress(f p cell) cell.offset 8 false cell.type)))
                end
            end
            let base = tuple let symbol = cell.symbol let at = cell.at end
            for b = 0 upto {extent inside - 1} do
                if inside[b] then
                    let blk = ssa.block(f b)
                    for k = 0 upto {vector.length(blk.insts) - 1} do
                        let i = vector.get(blk.insts k)
                        if maybe.isSome(accessOf(i)) andif sameBase(baseOf(defs i.args[0]) base)
                                andif {i.imm is cell.offset} then
                            i.args[0] := slotAt
                            i.imm := 0
                        end
                    end
                end
            end
            for b = 0 upto {extent inside - 1} do
                if inside[b] then
                    let blk = ssa.block(f b)
                    blk.term := ssa.mapTargets(blk.term fun(t: ssa.Target): ssa.Target
                        if inside[t.block] then
                            t
                        else
                            let w = ssa.newBlock(f)
                            let v = ssa.load(f w slotAt 0 8 false cell.type)
                            ssa.store(f w cellAddress(f w cell) cell.offset 8 v)
                            ssa.terminate(f w ssa.jump(t.block t.args))
                            ssa.target(w array of :Int end)
                        end)
                end
            end
        end

    (* Keeps the module cells that f's loops store to in registers, outermost
     * loops first; whether it kept any *)
    let keepCells(f: Function): Bool =
        begin
            let var kept = false
            let var again = true
            let var rounds = 0
            while again andif {rounds < 16} do
                again := false
                rounds := rounds + 1
                let g = cfg.graph(f)
                let defs = ssa.definitions(f)
                for r = 0 upto {extent g.order - 1} do
                    if not(again) andif cfg.isLoopHeader(g g.order[r]) then
                        let h = g.order[r]
                        let inside = body(g h)
                        if inside[h] then
                            let c = candidate(f g defs inside)
                            if maybe.isSome(c) then
                                keep(f g defs h inside maybe.unwrap(c))
                                kept := true
                                again := true
                            end
                        end
                    end
                end
            end
            if kept then let ignored = promote.promoteFunction(f) end
            kept
        end

    (* =========================================================================
     * Loop-invariant instructions and checks moved before their loops
     * ====================================================================== *)

    (* Whether i compares two values, which arm64 fuses into the branch on it
     * (a NaN test included in neither) *)
    let comparison(i: ssa.Inst): Bool =
        case ssa.info(i.op).compares
            when comparesInts, comparesReals then true
            when comparesNone, comparesNaN then false
        end

    (* Whether i may run before its loop whatever the loop does, its arguments
     * being invariant: an operation that cannot trap and touches no memory.
     * Comparisons stay with the branches that arm64 fuses them into, and
     * constants, symbols, and nulls where they are used (rematerialized, as
     * value numbering keeps them), copied before the loop for what moves. A
     * copy is movable too, though value numbering has replaced every one
     * before this pass runs. *)
    let movable(i: ssa.Inst): Bool =
        begin
            let o = ssa.info(i.op)
            o.speculable andif not(o.rematerializable) andif not(comparison(i))
        end

    let remade(i: ssa.Inst): Bool = ssa.info(i.op).rematerializable

    (* Whether i is a conversion that changes no bits and keeps its value in
     * an integer register (a real's bits move to another) *)
    let reinterprets(i: ssa.Inst): Bool =
        case i.op
            when opToVal, opFromVal, opPtrToInt, opIntToPtr then true
            when opConst, opRealConst, opSymbol, opNull, opSlot, opAdd, opSub, opMul, opDiv, opRem, opAnd, opOr, opXor,
                    opShl, opLshr, opAshr, opEq, opNe, opLt, opLe, opGt, opGe, opUlt, opPeq, opPne, opFadd, opFsub,
                    opFmul, opFdiv, opFeq, opFlt, opFle, opFgt, opFge, opIsNaN, opRealBits, opBitsReal, opIntToReal,
                    opSext8, opZext8, opLoad, opStore, opCall, opCallIndirect, opCopy, opPtrAdd, opMulHiU, opSelect,
                    opUnproxy then
                false
        end

    (* Whether i makes a value that is rematerialized where it is used: a
     * constant, a symbol, or a null, or a conversion of one that changes no
     * bits. Moved before a loop that calls, such a value would hold a
     * callee-saved register across the loop to save an instruction or two,
     * and shift the registers of the loop's other values: in peek, the cell
     * that find reloads after its call moved to a register the callee does
     * not restore, so the reload took 1.2 times the cycles *)
    let rematerialized(defs: Array(maybe.T(ssa.Inst)) i: ssa.Inst): Bool =
        if remade(i) then true
        elsif reinterprets(i) andif {extent i.args is 1} andif {i.args[0] < extent defs}
                andif maybe.isSome(defs[i.args[0]]) then
            remade(maybe.unwrap(defs[i.args[0]]))
        else false
        end

    (* Whether block r only raises: no parameters, instructions that make the
     * raise's constants and then call a function, and an end that control
     * never reaches (unreachable), so the call does not return *)
    let raises(f: Function r: Int): Bool =
        begin
            let blk = ssa.block(f r)
            let var only = vector.empty(blk.params) andif not(vector.empty(blk.insts))
            for k = 0 upto {vector.length(blk.insts) - 1} do
                let i = vector.get(blk.insts k)
                if k is {vector.length(blk.insts) - 1} then
                    (* A call that the block's end says does not return *)
                    if not(ssa.isOp(i ssa.opCall)) then only := false end
                elsif not(remade(i)) then
                    only := false
                end
            end
            case blk.term when termUnreachable then only else false end
        end

    (* What one loop's hoisting knows: the loop's blocks, the block that
     * defines each value (~1 for none), and the values that are invariant:
     * defined outside the loop, or moved before it, by value *)
    Let Hoist = Tuple
        f: Function
        inside: Array(Bool)
        home: Array(Int)
        var invariant: Array(Bool)
        (* Values known not to be null before the loop: checked there *)
        var nonNull: Array(Bool)
        (* Copies made before the loop of rematerialized values the loop
         * defines, by value (~1 for none) *)
        var copies: Array(Int)
    end

    (* Grows the per-value arrays to the function's values, which moving and
     * copying add to *)
    let grow(x: Hoist): Ok =
        begin
            let n = vector.length(x.f.types)
            if extent x.invariant < n then
                let widen = fun(a: Array(Bool)): Array(Bool)
                    begin
                        let r = array of(n true)
                        for k = 0 upto {extent a - 1} do r[k] := a[k] end
                        r
                    end
                x.invariant := widen(x.invariant)
                let nn = array of(n false)
                for k = 0 upto {extent x.nonNull - 1} do nn[k] := x.nonNull[k] end
                x.nonNull := nn
                let c = array of(n ~1)
                for k = 0 upto {extent x.copies - 1} do c[k] := x.copies[k] end
                x.copies := c
            end
        end

    (* Whether every argument of i is invariant or rematerialized *)
    let argumentsReady(x: Hoist defs: Array(maybe.T(ssa.Inst)) i: ssa.Inst): Bool =
        begin
            let var ready = true
            for k = 0 upto {extent i.args - 1} do
                let a = i.args[k]
                if not(x.invariant[a]) then
                    if {a < extent defs} andif maybe.isSome(defs[a])
                            andif rematerialized(defs maybe.unwrap(defs[a])) then
                        ok
                    else
                        ready := false
                    end
                end
            end
            ready
        end

    let copied(vs: Array(Int)): Array(Int) =
        begin
            let r = array of(extent vs 0)
            for k = 0 upto {extent vs - 1} do r[k] := vs[k] end
            r
        end

    (* The copy at the end of block b of a, a rematerialized value the loop
     * defines, made there (its own argument first, for a conversion) unless
     * made already *)
    let rec copyOf(x: Hoist defs: Array(maybe.T(ssa.Inst)) b: Int a: Int): Int =
        begin
            if x.copies[a] < 0 then
                let d = maybe.unwrap(defs[a])
                let args = array of(extent d.args 0)
                for k = 0 upto {extent d.args - 1} do
                    args[k] := if x.invariant[d.args[k]] then d.args[k] else copyOf(x defs b d.args[k]) end
                end
                let v = ssa.newValue(x.f ssa.typeOf(x.f a))
                ssa.append(x.f b ssa.copyInst(d args array of v end))
                grow(x)
                x.copies[a] := v
            end
            x.copies[a]
        end

    (* Moves i to the end of block b (unterminated), copying there the
     * rematerialized values the loop defines that it uses *)
    let moveTo(x: Hoist defs: Array(maybe.T(ssa.Inst)) b: Int i: ssa.Inst): Ok =
        begin
            for k = 0 upto {extent i.args - 1} do
                let a = i.args[k]
                if not(x.invariant[a]) then i.args[k] := copyOf(x defs b a) end
            end
            ssa.append(x.f b i)
            grow(x)
            for k = 0 upto {extent i.results - 1} do x.invariant[i.results[k]] := true end
        end

    (* Removes the instructions in moved from the loop's blocks *)
    let removeMoved(f: Function inside: Array(Bool) moved: Array(Bool)): Ok =
        for b = 0 upto {extent inside - 1} do
            if inside[b] then
                let blk = ssa.block(f b)
                let kept = vector.new(:ssa.Inst)
                for k = 0 upto {vector.length(blk.insts) - 1} do
                    let i = vector.get(blk.insts k)
                    let gone = {extent i.results > 0} andif {i.results[0] < extent moved} andif moved[i.results[0]]
                    if not(gone) then vector.append(kept i) end
                end
                vector.clear(blk.insts)
                for k = 0 upto {vector.length(kept) - 1} do vector.append(blk.insts vector.get(kept k)) end
            end
        end

    (* Replaces the uses of v in block b with w. A terminator's arrays may be
     * shared with other blocks' (two returns of one value, say), so they are
     * made anew, never changed in place *)
    let replaceIn(f: Function b: Int v: Int w: Int): Ok =
        begin
            let blk = ssa.block(f b)
            let swapped = fun(vs: Array(Int)): Array(Int)
                begin
                    let r = array of(extent vs 0)
                    for j = 0 upto {extent vs - 1} do r[j] := if vs[j] is v then w else vs[j] end end
                    r
                end
            let one = fun(x: Int): Int if x is v then w else x end
            for k = 0 upto {vector.length(blk.insts) - 1} do
                let i = vector.get(blk.insts k)
                i.args := swapped(i.args)
            end
            let mapped = ssa.mapTargets(blk.term fun(t: ssa.Target): ssa.Target ssa.target(t.block swapped(t.args)))
            blk.term := ssa.mapOperands(mapped one)
        end

    (* Inserts instructions at the start of block b *)
    let prepend(f: Function b: Int emitting: All() Ok): Ok =
        begin
            let blk = ssa.block(f b)
            let old = vector.toArray(blk.insts)
            let t = blk.term
            vector.clear(blk.insts)
            blk.term := ssa.termNone
            emitting()
            for k = 0 upto {extent old - 1} do vector.append(blk.insts old[k]) end
            blk.term := t
        end

    (* Whether a load at address a, invariant, cannot fault before the loop:
     * of a symbol's word, a stack slot's, a new object's (whose null test the
     * conditions pass decides, so that no check is left to show it), or an
     * object checked not null *)
    let safeAddress(x: Hoist defs: Array(maybe.T(ssa.Inst)) a: Int): Bool =
        if x.nonNull[a] then true
        elsif {a >= extent defs} orif maybe.isNone(defs[a]) then false
        else
            let d = maybe.unwrap(defs[a])
            ssa.isOp(d ssa.opSymbol) orif ssa.isOp(d ssa.opSlot)
                orif {ssa.isOp(d ssa.opCall) andif {extent d.results is 1} andif conditions.allocates(d.symbol)}
        end

    (* Moves before the loop of header h, into a new preheader, what of it is
     * invariant: pure operations and loads that cannot fault, anywhere in the
     * loop; and, when the loop's header tests whether to leave it and its
     * first pass then checks invariant values before doing anything else,
     * those checks, behind a copy of the header's test, so that they run once
     * for the loop and raise as the first pass would have, and the loads
     * they make safe. Value numbering and the conditions pass then decide the
     * loop's own copies of the checks. Whether it moved anything *)
    let hoistLoop(f: Function g: cfg.Graph h: Int inside: Array(Bool) rotateAll: Bool): Bool =
        begin
            let defs = ssa.definitions(f)
            let n = vector.length(f.types)
            let home = array of(n ~1)
            for b = 0 upto {vector.length(f.blocks) - 1} do
                let blk = ssa.block(f b)
                for k = 0 upto {vector.length(blk.params) - 1} do home[vector.get(blk.params k)] := b end
                for k = 0 upto {vector.length(blk.insts) - 1} do
                    let i = vector.get(blk.insts k)
                    for j = 0 upto {extent i.results - 1} do home[i.results[j]] := b end
                end
            end
            let invariant = array of(n true)
            for v = 0 upto {n - 1} do if {home[v] >= 0} andif inside[home[v]] then invariant[v] := false end end
            let x = tuple
                let f = f
                let inside = inside
                let home = home
                let var invariant = invariant
                let var nonNull = array of(n false)
                let var copies = array of(n ~1)
            end
            (* The preheader, taking the header's parameters from outside *)
            let hb = ssa.block(f h)
            let pre = ssa.newBlock(f)
            let preParams = array of(vector.length(hb.params) 0)
            for k = 0 upto {vector.length(hb.params) - 1} do
                preParams[k] := ssa.addParam(f pre ssa.typeOf(f vector.get(hb.params k)))
            end
            grow(x)
            for k = 0 upto {extent g.preds[h] - 1} do
                let p = g.preds[h][k]
                if not(inside[p]) then
                    let pb = ssa.block(f p)
                    pb.term := ssa.mapTargets(pb.term fun(t: ssa.Target): ssa.Target
                        if t.block is h then ssa.target(pre t.args) else t end)
                end
            end
            let moved = array of(n false)
            let var any = false
            (* The globals (g_...) the loop stores to: a load of any other
             * reads what nothing changes during the loop, since only its
             * module's initialization writes a global *)
            let written = vector.new(:String)
            for b = 0 upto {extent inside - 1} do
                if inside[b] then
                    let blk = ssa.block(f b)
                    for k = 0 upto {vector.length(blk.insts) - 1} do
                        let i = vector.get(blk.insts k)
                        if ssa.isOp(i ssa.opStore) andif maybe.isSome(defs[i.args[0]])
                                andif ssa.isOp(maybe.unwrap(defs[i.args[0]]) ssa.opSymbol) then
                            vector.append(written maybe.unwrap(defs[i.args[0]]).symbol)
                        end
                    end
                end
            end
            let steady = fun(i: ssa.Inst): Bool
                if not(ssa.isOp(i ssa.opLoad)) then false
                elsif i.invariant then true
                elsif {i.args[0] >= extent defs} orif maybe.isNone(defs[i.args[0]]) then false
                else
                    let d = maybe.unwrap(defs[i.args[0]])
                    if ssa.isOp(d ssa.opSymbol) andif strutil.startsWith(d.symbol "g_") then
                        let var stored = false
                        for k = 0 upto {vector.length(written) - 1} do
                            if stringOp.equal(vector.get(written k) d.symbol) then stored := true end
                        end
                        not(stored)
                    else
                        false
                    end
                end
            (* A derived pointer (ptrAdd) moves only out of a loop that calls
             * nothing, so that none is live across a collection without its
             * object's own pointer *)
            let var calls = false
            for b = 0 upto {extent inside - 1} do
                if inside[b] then
                    let blk = ssa.block(f b)
                    for k = 0 upto {vector.length(blk.insts) - 1} do
                        if ssa.isCall(vector.get(blk.insts k)) then calls := true end
                    end
                end
            end
            (* Anywhere in the loop: pure operations, and invariant loads of
             * what cannot fault *)
            for r = 0 upto {extent g.order - 1} do
                let b = g.order[r]
                if inside[b] then
                    let blk = ssa.block(f b)
                    for k = 0 upto {vector.length(blk.insts) - 1} do
                        let i = vector.get(blk.insts k)
                        let load = steady(i)
                        (* A Real constant takes two instructions to make (a
                         * mov and an fmov), so one used in a loop that calls
                         * nothing is made once before it *)
                        let real = ssa.isOp(i ssa.opRealConst) andif not(calls)
                        if {movable(i) orif load orif real} andif not(calls andif ssa.isOp(i ssa.opPtrAdd))
                                andif not(reinterprets(i) andif rematerialized(defs i)) andif argumentsReady(x defs i)
                                andif {not(load) orif safeAddress(x defs i.args[0])} then
                            moved[i.results[0]] := true
                            moveTo(x defs pre i)
                            any := true
                        end
                    end
                end
            end
            (* The first pass's checks, when the header only tests whether to
             * leave the loop *)
            let var guarded = false
            case hb.term
                when termBranch with tb then
                    let leaves = not(inside[tb.ifTrue.block])
                    let stays = inside[tb.ifFalse.block]
                    let leavesOther = not(inside[tb.ifFalse.block]) andif inside[tb.ifTrue.block]
                    let var pure = true
                    for k = 0 upto {vector.length(hb.insts) - 1} do
                        let i = vector.get(hb.insts k)
                        if {extent i.results is 0} orif {not(moved[i.results[0]])
                                andif not(movable(i) orif remade(i) orif comparison(i))} then
                            pure := false
                        end
                    end
                    if pure andif {{leaves andif stays} orif leavesOther} then
                        let first = if leaves then tb.ifFalse.block else tb.ifTrue.block end
                        (* Walk the first pass from the header's successor while
                         * it does nothing a check could not come before:
                         * collect the invariant checks (a branch on an
                         * invariant comparison to a block that only raises)
                         * and the invariant loads, stopping at a store, a call,
                         * a check of what varies, or a join *)
                        let checks = vector.new(:Int)
                        let var cur = first
                        (* The header's successor may take parameters, which the
                         * guard binds as the header would, from its copies *)
                        let var walking = extent g.preds[first] is 1
                        (* Rotated whether or not it has checks to move, so
                         * that each pass ends in the test, which branches
                         * back, rather than in a jump to it *)
                        let walking0 = walking
                        let rotatable = walking andif rotateAll
                        while walking do
                            let blk = ssa.block(f cur)
                            for k = 0 upto {vector.length(blk.insts) - 1} do
                                let i = vector.get(blk.insts k)
                                if walking then
                                    if ssa.isCall(i) orif ssa.isOp(i ssa.opStore) orif ssa.isOp(i ssa.opDiv)
                                            orif ssa.isOp(i ssa.opRem) orif ssa.isOp(i ssa.opUnproxy) then
                                        walking := false
                                    end
                                end
                            end
                            if walking then
                                case blk.term
                                    when termJump with tj then
                                        let next = tj.target.block
                                        if inside[next] andif {extent g.preds[next] is 1}
                                                andif {vector.length(ssa.block(f next).params) is 0} then
                                            cur := next
                                        else
                                            walking := false
                                        end
                                    when termBranch with tc then
                                        let c = tc.cond
                                        let cd = if c < extent defs then defs[c] else maybe.none(:ssa.Inst) end
                                        let raisesTrue = {not(inside[tc.ifTrue.block])} andif raises(f tc.ifTrue.block)
                                        let raisesFalse =
                                            {not(inside[tc.ifFalse.block])} andif raises(f tc.ifFalse.block)
                                        let next = if raisesTrue then tc.ifFalse.block else tc.ifTrue.block end
                                        if maybe.isSome(cd) andif comparison(maybe.unwrap(cd))
                                                andif argumentsReady(x defs maybe.unwrap(cd))
                                                andif {raisesTrue orif raisesFalse} andif inside[next]
                                                andif {extent g.preds[next] is 1}
                                                andif {vector.length(ssa.block(f next).params) is 0} then
                                            vector.append(checks cur)
                                            cur := next
                                        else
                                            walking := false
                                        end
                                    when termNone, termSwitch, termReturn, termTailCall, termTry, termUnreachable then
                                        walking := false
                                end
                            end
                        end
                        if rotatable orif {walking0 andif not(vector.empty(checks))} then
                            guarded := true
                            (* The guard: the header's test, of the preheader's
                             * parameters, leaving where the header would *)
                            let var rename = array of(vector.length(f.types) ~1)
                            for k = 0 upto {vector.length(hb.params) - 1} do
                                rename[vector.get(hb.params k)] := preParams[k]
                            end
                            let renamed =
                                fun(v: Int): Int if {v < extent rename} andif {rename[v] >= 0} then rename[v] else v end
                            for k = 0 upto {vector.length(hb.insts) - 1} do
                                let i = vector.get(hb.insts k)
                                if not(moved[i.results[0]]) then
                                    let args = array of(extent i.args 0)
                                    for j = 0 upto {extent i.args - 1} do args[j] := renamed(i.args[j]) end
                                    let results = array of(extent i.results 0)
                                    for j = 0 upto {extent i.results - 1} do
                                        results[j] := ssa.newValue(f ssa.typeOf(f i.results[j]))
                                    end
                                    ssa.append(f pre ssa.copyInst(i args results))
                                    let wider = array of(vector.length(f.types) ~1)
                                    for j = 0 upto {extent rename - 1} do wider[j] := rename[j] end
                                    for j = 0 upto {extent i.results - 1} do wider[i.results[j]] := results[j] end
                                    rename := wider
                                end
                            end
                            grow(x)
                            (* The loop is rotated: the guard leaves where the
                             * header would, and its checks enter the header's
                             * successor, so that the header is the loop's test
                             * at its bottom and no longer dominates the rest.
                             * Each of the header's values used elsewhere is
                             * kept in a stack slot, stored by the header and
                             * by the guard, which slot promotion then makes a
                             * block parameter where the two meet *)
                            let fromHeader = array of(vector.length(f.types) false)
                            for k = 0 upto {vector.length(hb.params) - 1} do
                                fromHeader[vector.get(hb.params k)] := true
                            end
                            for k = 0 upto {vector.length(hb.insts) - 1} do
                                let i = vector.get(hb.insts k)
                                for j = 0 upto {extent i.results - 1} do
                                    if not(moved[i.results[j]]) then fromHeader[i.results[j]] := true end
                                end
                            end
                            let outside = vector.length(f.blocks)
                            let slotAt = array of(vector.length(f.types) ~1)
                            for b = 0 upto {outside - 1} do
                                if {b isnot pre} andif {b isnot h} then
                                    let blk = ssa.block(f b)
                                    let used = vector.new(:Int)
                                    let note = fun(v: Int): Ok
                                        if {v < extent fromHeader} andif fromHeader[v] then
                                            let var seen = false
                                            for j = 0 upto {vector.length(used) - 1} do
                                                if vector.get(used j) is v then seen := true end
                                            end
                                            if not(seen) then vector.append(used v) end
                                        end
                                    for k = 0 upto {vector.length(blk.insts) - 1} do
                                        let args = vector.get(blk.insts k).args
                                        for j = 0 upto {extent args - 1} do note(args[j]) end
                                    end
                                    let tu = ssa.terminatorUses(blk.term)
                                    for j = 0 upto {extent tu - 1} do note(tu[j]) end
                                    for k = 0 upto {vector.length(used) - 1} do
                                        let v = vector.get(used k)
                                        if slotAt[v] < 0 then
                                            let slot = ssa.newSlot(f 8 8)
                                            let var at = 0
                                            before(f 0 fun(): Ok at := ssa.slotAddress(f 0 slot))
                                            slotAt[v] := at
                                            before(f h fun(): Ok ssa.store(f h slotAt[v] 0 8 v))
                                            ssa.store(f pre slotAt[v] 0 8 renamed(v))
                                        end
                                        let address = slotAt[v]
                                        let var w = 0
                                        prepend(f b fun(): Ok w := ssa.load(f b address 0 8 false ssa.typeOf(f v)))
                                        replaceIn(f b v w)
                                    end
                                end
                            end
                            grow(x)
                            let renameTarget = fun(t: ssa.Target): ssa.Target
                                begin
                                    let args = array of(extent t.args 0)
                                    for j = 0 upto {extent t.args - 1} do args[j] := renamed(t.args[j]) end
                                    ssa.target(t.block args)
                                end
                            let leaving = if leaves then tb.ifTrue else tb.ifFalse end
                            let var tail = ssa.newBlock(f)
                            let cond = renamed(tb.cond)
                            ssa.block(f pre).term :=
                                if leaves then
                                    option termBranch of ssa.Terminator with
                                        let cond = cond
                                        let ifTrue = renameTarget(leaving)
                                        let ifFalse = ssa.target(tail array of :Int end)
                                    end
                                else
                                    option termBranch of ssa.Terminator with
                                        let cond = cond
                                        let ifTrue = ssa.target(tail array of :Int end)
                                        let ifFalse = renameTarget(leaving)
                                    end
                                end
                            ssa.block(f pre).termLoc := hb.termLoc
                            (* Each check, of a copy of its comparison, then the
                             * invariant loads it makes safe *)
                            for k = 0 upto {vector.length(checks) - 1} do
                                let cb = ssa.block(f vector.get(checks k))
                                case cb.term
                                    when termBranch with tc then
                                        let d = maybe.unwrap(defs[tc.cond])
                                        let v = ssa.newValue(f ssa.typeInt)
                                        let copy = ssa.copyInst(d copied(d.args) array of v end)
                                        grow(x)
                                        moveTo(x defs tail copy)
                                        let next = ssa.newBlock(f)
                                        let raisesTrue = not(inside[tc.ifTrue.block])
                                        ssa.block(f tail).term :=
                                            if raisesTrue then
                                                option termBranch of ssa.Terminator with
                                                    let cond = v
                                                    let ifTrue = ssa.target(tc.ifTrue.block copied(tc.ifTrue.args))
                                                    let ifFalse = ssa.target(next array of :Int end)
                                                end
                                            else
                                                option termBranch of ssa.Terminator with
                                                    let cond = v
                                                    let ifTrue = ssa.target(next array of :Int end)
                                                    let ifFalse = ssa.target(tc.ifFalse.block copied(tc.ifFalse.args))
                                                end
                                            end
                                        ssa.block(f tail).termLoc := cb.termLoc
                                        (* A null test passed: its pointer is
                                         * not null after it *)
                                        if {ssa.isOp(d ssa.opPeq) andif raisesTrue}
                                                orif {ssa.isOp(d ssa.opPne) andif not(raisesTrue)} then
                                            for j = 0 upto 1 do
                                                let a = d.args[j]
                                                let other = d.args[1 - j]
                                                if maybe.isSome(defs[other])
                                                        andif ssa.isOp(maybe.unwrap(defs[other]) ssa.opNull)
                                                        andif x.invariant[a] then
                                                    x.nonNull[a] := true
                                                end
                                            end
                                        end
                                        tail := next
                                        (* The loads this check's block and
                                         * the next make safe *)
                                        let after = ssa.block(f
                                                if raisesTrue then tc.ifFalse.block else tc.ifTrue.block end)
                                        for j = 0 upto {vector.length(after.insts) - 1} do
                                            let i = vector.get(after.insts j)
                                            if steady(i) andif not(moved[i.results[0]])
                                                    andif argumentsReady(x defs i)
                                                    andif safeAddress(x defs i.args[0]) then
                                                moved[i.results[0]] := true
                                                moveTo(x defs tail i)
                                            end
                                        end
                                    when termNone, termJump, termSwitch, termReturn, termTailCall, termTry,
                                            termUnreachable then
                                        ok
                                end
                            end
                            ssa.block(f tail).term :=
                                    option termJump of ssa.Terminator with
                                        let target = renameTarget(if leaves then tb.ifFalse else tb.ifTrue end)
                                    end
                            ssa.block(f tail).termLoc := hb.termLoc
                        end
                    end
                when termNone, termJump, termSwitch, termReturn, termTailCall, termTry, termUnreachable then ok
            end
            if not(guarded) then
                ssa.block(f pre).term := ssa.jump(h preParams)
                ssa.block(f pre).termLoc := hb.termLoc
            end
            removeMoved(f inside moved)
            any orif guarded
        end

    (* Moves what is invariant out of f's loops, innermost first, so that an
     * outer loop then sees what an inner one moved; whether it moved any. The
     * graph is made again after each loop, since hoistLoop gives every loop a
     * preheader even when it moves nothing, but not for each block *)
    let hoistLoops(f: Function rotateAll: Bool): Bool =
        begin
            let g = cfg.graph(f)
            let headers = vector.new(:Int)
            for r = 0 upto {extent g.order - 1} do vector.append(headers g.order[r]) end
            let var any = false
            let var now = g
            let var k = vector.length(headers) - 1
            while k >= 0 do
                let h = vector.get(headers k)
                if cfg.isLoopHeader(now h) then
                    let inside = body(now h)
                    if inside[h] then
                        if hoistLoop(f now h inside rotateAll) then any := true end
                        now := cfg.graph(f)
                    end
                end
                k := k - 1
            end
            any
        end

    (* =========================================================================
     * Bounds checks that the comparisons before them decide
     * ====================================================================== *)

    (* What the bounds analysis knows of a function: each value's defining
     * instruction, each value's block if it is a parameter (~1 if not) and its
     * position, the graph, and the lengths' offsets *)
    Let Ranges = Tuple
        f: Function
        defs: Array(maybe.T(ssa.Inst))
        paramBlock: Array(Int)
        paramIndex: Array(Int)
        g: cfg.Graph
        arrayLength: Int
        stringLength: Int
    end

    let defOf(r: Ranges v: Int): maybe.T(ssa.Inst) = if v < extent r.defs then r.defs[v] else maybe.none() end

    let constantOf(r: Ranges v: Int): maybe.T(Int) = ssa.constantOf(r.defs v)

    let isOne(r: Ranges v: Int): Bool = maybe.isSome(constantOf(r v)) andif {maybe.unwrap(constantOf(r v)) is 1}

    let isZero(r: Ranges v: Int): Bool = maybe.isSome(constantOf(r v)) andif {maybe.unwrap(constantOf(r v)) is 0}

    (* Whether v tests a pointer for null (peq p null) *)
    let nullTest(r: Ranges v: Int): Bool =
        begin
            let d = defOf(r v)
            if maybe.isNone(d) orif not(ssa.isOp(maybe.unwrap(d) ssa.opPeq)) then
                false
            else
                let i = maybe.unwrap(d)
                let isNull =
                    fun(a: Int): Bool maybe.isSome(defOf(r a)) andif ssa.isOp(maybe.unwrap(defOf(r a)) ssa.opNull)
                isNull(i.args[0]) orif isNull(i.args[1])
            end
        end

    (* A value as a base and a constant offset: through additions and
     * subtractions of constants, and with invariant loads named by their
     * address's form and offset, so that a length loaded twice, or a copy of
     * len - 1 made for a loop's guard, compares equal *)
    Let Form = Tuple base: String offset: Int end
    let rec form(r: Ranges v: Int depth: Int): Form =
        begin
            let d = defOf(r v)
            let plain = tuple let base = "v" <> conv.int(v) let offset = 0 end
            if {depth > 8} orif maybe.isNone(d) then
                plain
            else
                let i = maybe.unwrap(d)
                if ssa.isOp(i ssa.opAdd) andif maybe.isSome(constantOf(r i.args[1])) then
                    let inner = form(r i.args[0] depth + 1)
                    tuple let base = inner.base let offset = inner.offset + maybe.unwrap(constantOf(r i.args[1])) end
                elsif ssa.isOp(i ssa.opAdd) andif maybe.isSome(constantOf(r i.args[0])) then
                    let inner = form(r i.args[1] depth + 1)
                    tuple let base = inner.base let offset = inner.offset + maybe.unwrap(constantOf(r i.args[0])) end
                elsif ssa.isOp(i ssa.opSub) andif maybe.isSome(constantOf(r i.args[1])) then
                    let inner = form(r i.args[0] depth + 1)
                    tuple let base = inner.base let offset = inner.offset - maybe.unwrap(constantOf(r i.args[1])) end
                elsif ssa.isOp(i ssa.opLoad) andif i.invariant then
                    let at = form(r i.args[0] depth + 1)
                    tuple
                        let base = "load(" <> at.base <> "+" <> conv.int(at.offset) <> "+" <> conv.int(i.imm) <> ")"
                        let offset = 0
                    end
                elsif ssa.isOp(i ssa.opCopy) then
                    form(r i.args[0] depth + 1)
                elsif ssa.isOp(i ssa.opSymbol) then
                    (* A symbol is what it names, wherever it is made: value
                     * numbering keeps a block's own *)
                    tuple let base = "symbol(" <> i.symbol <> "+" <> conv.int(i.imm) <> ")" let offset = 0 end
                elsif ssa.isOp(i ssa.opSelect) andif nullTest(r i.args[0]) andif isZero(r i.args[1]) then
                    (* string.length: 0 for a null string, else its length,
                     * which is the length's form as a bound: a bound of 0 - 1
                     * leaves no index that is not negative, so a check under
                     * it is never reached *)
                    form(r i.args[2] depth + 1)
                else
                    plain
                end
            end
        end

    (* Whether v is never negative: a constant that is not, an array's or a
     * string's length, such a value plus a small constant, or
     * a block parameter every jump to which binds such a value (assumed of
     * the parameters being asked about, which a loop's back edges reach) *)
    let rec nonNegative(r: Ranges v: Int asking: vector.T(Int) depth: Int): Bool =
        if depth > 12 then
            false
        else
            let d = defOf(r v)
            if maybe.isSome(d) then
                let i = maybe.unwrap(d)
                if ssa.isOp(i ssa.opConst) then i.imm >= 0
                elsif ssa.isOp(i ssa.opLoad) andif i.invariant andif {i.width is 8}
                        andif {{i.imm is r.arrayLength} orif {i.imm is r.stringLength}}
                        andif {ssa.typeOf(r.f i.results[0]) is ssa.typeInt} then
                    true
                elsif ssa.isOp(i ssa.opAdd) then
                    (* Only a small constant added, so that the sum cannot
                     * wrap: a loop's index stepping up, a length plus one *)
                    let small = fun(c: Int): Bool
                        maybe.isSome(constantOf(r c)) andif {maybe.unwrap(constantOf(r c)) >= 0}
                            andif {maybe.unwrap(constantOf(r c)) <= 65536}
                    {small(i.args[1]) andif nonNegative(r i.args[0] asking depth + 1)}
                        orif {small(i.args[0]) andif nonNegative(r i.args[1] asking depth + 1)}
                elsif ssa.isOp(i ssa.opCopy) then nonNegative(r i.args[0] asking depth + 1)
                else false
                end
            elsif {v < extent r.paramBlock} andif {r.paramBlock[v] > 0} then
                let var seen = false
                for k = 0 upto {vector.length(asking) - 1} do if vector.get(asking k) is v then seen := true end end
                if seen then
                    true
                else
                    vector.append(asking v)
                    let b = r.paramBlock[v]
                    let var all = extent r.g.preds[b] > 0
                    for k = 0 upto {extent r.g.preds[b] - 1} do
                        let q = r.g.preds[b][k]
                        if cfg.reached(r.g q) then
                            let ts = ssa.targets(ssa.block(r.f q).term)
                            for t = 0 upto {extent ts - 1} do
                                if {ts[t].block is b} andif all then
                                    all := nonNegative(r ts[t].args[r.paramIndex[v]] asking depth + 1)
                                end
                            end
                        end
                    end
                    let ignored = vector.pop(asking)
                    all
                end
            else
                false
            end
        end

    (* The comparisons known where control goes along an edge from q to b
     * (b's only way in, or the branch of q itself), and along the single
     * edges into the blocks that dominate q: each a comparison's instruction
     * and the value it is known to have *)
    Let Fact = Tuple compare: ssa.Inst holds: Bool end
    let factsOn(r: Ranges q: Int into: Int): vector.T(Fact) =
        begin
            let facts = vector.new(:Fact)
            let note = fun(from: Int to: Int): Ok
                case ssa.block(r.f from).term
                    when termBranch with x then
                        if x.ifTrue.block isnot x.ifFalse.block then
                            let d = defOf(r x.cond)
                            if maybe.isSome(d) andif {{to is x.ifTrue.block} orif {to is x.ifFalse.block}} then
                                vector.append(facts tuple
                                    let compare = maybe.unwrap(d)
                                    let holds = to is x.ifTrue.block
                                end)
                            end
                        end
                    else ok
                end
            if into >= 0 then note(q into) end
            let var b = q
            while {b >= 0} andif cfg.reached(r.g b) do
                if extent r.g.preds[b] is 1 then note(r.g.preds[b][0] b) end
                b := r.g.idom[b]
            end
            facts
        end

    (* What a fact says of x: x <= bound - slack (relation "le", where
     * "x < b" is "x <= b - 1"), or x isnot bound ("ne"), with bound a form;
     * relation "" when it says nothing of x *)
    Let Says = Tuple relation: String bound: Form end
    let says(r: Ranges fact: Fact x: Int): Says =
        begin
            let i = fact.compare
            let nothing = tuple let relation = "" let bound = tuple let base = "" let offset = 0 end end
            if extent i.args isnot 2 then
                nothing
            else
                let a = i.args[0]
                let c = i.args[1]
                (* small <= big - slack *)
                let var small = ~1
                let var big = ~1
                let var slack = 0
                let var relation = "le"
                let relate = fun(s: Int t: Int k: Int): Ok begin small := s big := t slack := k end
                case i.op
                    when opLt then if fact.holds then relate(a c 1) else relate(c a 0) end
                    when opLe then if fact.holds then relate(a c 0) else relate(c a 1) end
                    when opGt then if fact.holds then relate(c a 1) else relate(a c 0) end
                    when opGe then if fact.holds then relate(c a 0) else relate(a c 1) end
                    when opEq then
                        if not(fact.holds) then
                            relation := "ne"
                            if a is x then relate(a c 0) else relate(c a 0) end
                        end
                    when opNe then
                        if fact.holds then
                            relation := "ne"
                            if a is x then relate(a c 0) else relate(c a 0) end
                        end
                    else ok
                end
                if {small is x} andif {big >= 0} then
                    let bf = form(r big 0)
                    tuple
                        let relation = relation
                        let bound = tuple let base = bf.base let offset = bf.offset - slack end
                    end
                else
                    nothing
                end
            end
        end

    (* Whether x <= top holds where control goes from q into b (or at q, when
     * b is ~1): by a known comparison of x itself; or, when x is a block's
     * parameter, along every jump into that block: by the value it binds,
     * or, for a jump that binds x + 1, by a comparison there that says
     * x isnot top or x < top (by induction over the block's entries, x <=
     * top before it, so x + 1 <= top) *)
    let rec atMost(r: Ranges q: Int into: Int x: Int top: Form depth: Int): Bool =
        begin
            let facts = factsOn(r q into)
            let within = fun(strictly: Bool): Bool
                begin
                    let var found = false
                    for k = 0 upto {vector.length(facts) - 1} do
                        let w = says(r vector.get(facts k) x)
                        if stringOp.equal(w.bound.base top.base) then
                            if stringOp.equal(w.relation "le") then
                                if w.bound.offset <= {if strictly then top.offset - 1 else top.offset end} then
                                    found := true
                                end
                            elsif stringOp.equal(w.relation "ne") andif strictly
                                    andif {w.bound.offset is top.offset} then
                                found := true
                            end
                        end
                    end
                    found
                end
            if within(false) then true
            elsif {depth < 4} andif {x < extent r.paramBlock} andif {r.paramBlock[x] > 0} then
                let b = r.paramBlock[x]
                let var all = extent r.g.preds[b] > 0
                for k = 0 upto {extent r.g.preds[b] - 1} do
                    let p = r.g.preds[b][k]
                    if all andif cfg.reached(r.g p) then
                        let ts = ssa.targets(ssa.block(r.f p).term)
                        for t = 0 upto {extent ts - 1} do
                            if {ts[t].block is b} andif all then
                                let a = ts[t].args[r.paramIndex[x]]
                                let d = defOf(r a)
                                let stepped = maybe.isSome(d) andif ssa.isOp(maybe.unwrap(d) ssa.opAdd)
                                    andif {{{maybe.unwrap(d).args[0] is x} andif isOne(r maybe.unwrap(d).args[1])}
                                        orif {{maybe.unwrap(d).args[1] is x} andif isOne(r maybe.unwrap(d).args[0])}}
                                if stepped then
                                    let edge = factsOn(r p b)
                                    let var found = false
                                    for e = 0 upto {vector.length(edge) - 1} do
                                        let w = says(r vector.get(edge e) x)
                                        if stringOp.equal(w.bound.base top.base) then
                                            if stringOp.equal(w.relation "le")
                                                    andif {w.bound.offset <= top.offset - 1} then
                                                found := true
                                            elsif stringOp.equal(w.relation "ne")
                                                    andif {w.bound.offset is top.offset} then
                                                found := true
                                            end
                                        end
                                    end
                                    all := found
                                else
                                    all := atMost(r p b a top depth + 1)
                                end
                            end
                        end
                    end
                end
                all
            else
                false
            end
        end

    (* Decides f's bounds checks (a branch on x <u len to a block that only
     * raises) that the comparisons before them decide: x is never negative,
     * and x <= len - 1 (atMost); whether it decided any *)
    let decideBounds(f: Function): Bool =
        begin
            let n = vector.length(f.types)
            let paramBlock = array of(n ~1)
            let paramIndex = array of(n ~1)
            for b = 1 upto {vector.length(f.blocks) - 1} do
                let ps = ssa.block(f b).params
                for k = 0 upto {vector.length(ps) - 1} do
                    paramBlock[vector.get(ps k)] := b
                    paramIndex[vector.get(ps k)] := k
                end
            end
            let r = tuple
                let f = f
                let defs = ssa.definitions(f)
                let paramBlock = paramBlock
                let paramIndex = paramIndex
                let g = cfg.graph(f)
                let arrayLength = runtimeLayout.offset("QArray" "length")
                let stringLength = runtimeLayout.offset("QString" "length")
            end
            let var decided = false
            for b = 0 upto {vector.length(f.blocks) - 1} do
                if cfg.reached(r.g b) then
                    let blk = ssa.block(f b)
                    case blk.term
                        when termBranch with x then
                            let d = defOf(r x.cond)
                            if maybe.isSome(d) andif ssa.isOp(maybe.unwrap(d) ssa.opUlt)
                                    andif raises(f x.ifFalse.block) andif {x.ifTrue.block isnot x.ifFalse.block} then
                                let i = maybe.unwrap(d)
                                let len = form(r i.args[1] 0)
                                let top = tuple let base = len.base let offset = len.offset - 1 end
                                if nonNegative(r i.args[0] vector.new(:Int) 0) andif atMost(r b ~1 i.args[0] top 0) then
                                    blk.term := option termJump of ssa.Terminator with let target = x.ifTrue end
                                    decided := true
                                end
                            end
                        else ok
                    end
                end
            end
            if decided then cfg.dropUnreached(f) end
            decided
        end

    let loopUnit(u: ssa.Unit p: ssa.Policy): Ok =
        begin
            for i = 0 upto {vector.length(u.functions) - 1} do
                let f = vector.get(u.functions i)
                let looped = loopFunction(f)
                let kept = keepCells(f)
                let hoisted = hoistLoops(f p.rotateAll)
                if hoisted then
                    let ignored = promote.promoteFunction(f)
                    begin let ignored = blockParams.dropDeadParams(f) end
                end
                if looped orif kept orif hoisted then
                    valueNumbers.numberFunction(f p)
                    (* The comparisons of the checks conditions decides are
                     * left without uses, which numbering again removes *)
                    if conditions.decideFunction(f) then valueNumbers.numberFunction(f p) end
                end
                (* Bounds checks last, with equal values numbered alike *)
                if decideBounds(f) then valueNumbers.numberFunction(f p) end
            end
        end

    let loopTailCalls(u: ssa.Unit p: ssa.Policy): Ok =
        for i = 0 upto {vector.length(u.functions) - 1} do
            let f = vector.get(u.functions i)
            if loopSites(f true) then
                (* The header's parameters that nothing reads go, as the
                 * closure's, which the back edge passes as null *)
                begin let ignored = blockParams.dropDeadParams(f) end
                valueNumbers.numberFunction(f p)
            end
        end
end
