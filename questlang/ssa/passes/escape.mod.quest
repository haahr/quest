(* Quest Self-Hosted Compiler: The SSA's Escape Analysis Implementation *)

module escape : Escape
import
    conv : Conv
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash

    questlang/ssa/cfg : questlang/ssa/CFG
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/ssa/passes/proxyFold : questlang/ssa/passes/ProxyFold
    questlang/ssa/passes/tailCalls : questlang/ssa/passes/TailCalls
export
    Def Verdict = Tuple value: Int bytes: Int escapes: Bool reason: String end

    Let Function = ssa.Function

    (* What the analysis knows of a function's values and allocations *)
    Let State = Tuple
        f: Function
        d: proxyFold.Defs
        (* The candidates: each one's value and size, and whether it is still
         * thought not to escape, and if it does, why *)
        allocValue: Array(Int)
        allocBytes: Array(Int)
        alive: Array(Bool)
        reasons: Array(String)
        (* The candidate each value points into (~1 for none) and its offset
         * there *)
        ptr: Array(Int)
        off: Array(Int)
        (* For each candidate, each word: whether it holds the candidate's own
         * pointer, and at what offset *)
        selfHas: Array(Array(Bool))
        selfOff: Array(Array(Int))
        (* The blocks reached once proxy tests of the candidates fold *)
        reach: Array(Bool)
        (* Whether the function of the unit a symbol names uses its first
         * parameter only as the address of loads (firstLoadOnly) *)
        loadOnly: All(symbol: String) Bool
    end

    (* Whether f's first parameter, the closure a call of f passes it, is only
     * ever the address of loads, directly or through the block parameters it
     * is passed to, so that f keeps no pointer to it once it returns *)
    let firstLoadOnly(f: Function): Bool =
        begin
            let entry = ssa.block(f 0)
            if vector.length(entry.params) is 0 then
                false
            else
                let inSet = array of(vector.length(f.types) false)
                inSet[vector.get(entry.params 0)] := true
                let var only = true
                let var changed = true
                while only andif changed do
                    changed := false
                    for b = 0 upto {vector.length(f.blocks) - 1} do
                        let blk = ssa.block(f b)
                        for k = 0 upto {vector.length(blk.insts) - 1} do
                            let i = vector.get(blk.insts k)
                            for j = 0 upto {extent i.args - 1} do
                                if inSet[i.args[j]] andif not(ssa.isOp(i ssa.opLoad) andif {j is 0}) then
                                    only := false
                                end
                            end
                        end
                        let used =
                            case blk.term
                                when termBranch with x then array of x.cond end
                                when termSwitch with x then array of x.value end
                                when termReturn with x then x.values
                                when termTailCall with x then x.call.args
                                when termNone, termJump, termTry, termUnreachable then array of :Int end
                            end
                        for j = 0 upto {extent used - 1} do if inSet[used[j]] then only := false end end
                        let ts = ssa.targets(blk.term)
                        for t = 0 upto {extent ts - 1} do
                            let params = ssa.block(f ts[t].block).params
                            for j = 0 upto {extent ts[t].args - 1} do
                                if inSet[ts[t].args[j]] andif not(inSet[vector.get(params j)]) then
                                    inSet[vector.get(params j)] := true
                                    changed := true
                                end
                            end
                        end
                    end
                end
                only
            end
        end

    (* Whether candidate a holds its own pointer, which a load from it gives
     * whatever it is passed to *)
    let holdsItself(s: State a: Int): Bool =
        begin
            let var found = false
            for w = 0 upto {extent s.selfHas[a] - 1} do if s.selfHas[a][w] then found := true end end
            found
        end

    let defOf(s: State v: Int): ssa.Inst = proxyFold.defOf(s.d v)

    (* Whether v tests a candidate's pointer for being a proxy, which folds:
     * the candidate is not one *)
    let isProxyTest(s: State v: Int): Bool =
        proxyFold.isProxyTest(s.d v fun(p: Int): Bool {s.ptr[p] >= 0} andif s.alive[s.ptr[p]])

    let takenTargets(s: State term: ssa.Terminator): Array(ssa.Target) =
        proxyFold.takenTargets(term fun(v: Int): Bool isProxyTest(s v))

    let setPointer(s: State v: Int a: Int offset: Int): Bool =
        if s.ptr[v] < 0 then begin s.ptr[v] := a s.off[v] := offset true end
        elsif {s.ptr[v] isnot a} orif {s.off[v] isnot offset} then
            (* Two candidates or offsets meet: both escape *)
            begin
                if s.alive[s.ptr[v]] then begin s.alive[s.ptr[v]] := false s.reasons[s.ptr[v]] := "merged" end end
                if s.alive[a] then begin s.alive[a] := false s.reasons[a] := "merged" end end
                false
            end
        else false
        end

    let escapes(s: State a: Int reason: String): Ok =
        if s.alive[a] then begin s.alive[a] := false s.reasons[a] := reason end end

    (* The word of candidate a that an access at imm (from a pointer at offset
     * base) reads or writes, or ~1 if it is not a whole aligned word *)
    let wordAt(s: State a: Int base: Int imm: Int width: Int): Int =
        begin
            let w = proxyFold.wordOf(base imm width)
            if {w >= 0} andif {{{w + 1} * 8} <= s.allocBytes[a]} then w else ~1 end
        end

    (* Propagates candidate pointers to a fixed point over the reachable
     * blocks. A value is a pointer if it is a candidate's allocation result,
     * a constant offset from a pointer, an unproxy of a pointer, a load of a
     * word holding a self-pointer, or a block parameter that every taken edge
     * binds to the same pointer. *)
    let pointers(s: State): Ok =
        begin
            let f = s.f
            let nBlocks = vector.length(f.blocks)
            for v = 0 upto {extent s.ptr - 1} do s.ptr[v] := ~1 end
            for a = 0 upto {extent s.allocValue - 1} do
                for w = 0 upto {extent s.selfHas[a] - 1} do s.selfHas[a][w] := false end
                if s.alive[a] then begin s.ptr[s.allocValue[a]] := a s.off[s.allocValue[a]] := 0 end end
            end
            let var changed = true
            while changed do
                changed := false
                (* The value each parameter is bound to, ~1 for none yet, ~2 for
                 * more than one *)
                let bound = array of(extent s.ptr ~1)
                for b = 0 upto {nBlocks - 1} do
                    if s.reach[b] then
                        let blk = ssa.block(f b)
                        for k = 0 upto {vector.length(blk.insts) - 1} do
                            let i = vector.get(blk.insts k)
                            if ssa.isOp(i ssa.opPtrAdd) then
                                let p = i.args[0]
                                if {s.ptr[p] >= 0} andif s.d.isConst[i.args[1]] then
                                    if setPointer(s i.results[0] s.ptr[p] {s.off[p] + s.d.constant[i.args[1]]}) then
                                        changed := true
                                    end
                                end
                            elsif ssa.isOp(i ssa.opUnproxy) then
                                (* A fresh allocation is never a proxy *)
                                let p = i.args[0]
                                if s.ptr[p] >= 0 then
                                    if setPointer(s i.results[0] s.ptr[p] s.off[p]) then changed := true end
                                end
                            elsif ssa.isOp(i ssa.opStore) then
                                let p = i.args[0]
                                let v = i.args[1]
                                if {s.ptr[p] >= 0} andif {s.ptr[v] >= 0} andif {s.ptr[p] is s.ptr[v]} then
                                    let a = s.ptr[p]
                                    let w = wordAt(s a s.off[p] i.imm i.width)
                                    if w < 0 then escapes(s a "its pointer stored at an odd place in it")
                                    elsif not(s.selfHas[a][w]) then
                                        begin s.selfHas[a][w] := true s.selfOff[a][w] := s.off[v] changed := true end
                                    elsif s.selfOff[a][w] isnot s.off[v] then
                                        escapes(s a "its pointers of two offsets stored in it")
                                    end
                                end
                            elsif ssa.isOp(i ssa.opLoad) then
                                let p = i.args[0]
                                if s.ptr[p] >= 0 then
                                    let a = s.ptr[p]
                                    let w = wordAt(s a s.off[p] i.imm i.width)
                                    if {w >= 0} andif s.selfHas[a][w] then
                                        if setPointer(s i.results[0] a s.selfOff[a][w]) then changed := true end
                                    end
                                end
                            end
                        end
                        let ts = takenTargets(s blk.term)
                        for k = 0 upto {extent ts - 1} do
                            let t = ts[k]
                            let params = ssa.block(f t.block).params
                            for j = 0 upto {extent t.args - 1} do
                                let p = vector.get(params j)
                                if bound[p] is ~1 then bound[p] := t.args[j]
                                elsif bound[p] isnot t.args[j] then bound[p] := ~2
                                end
                            end
                        end
                    end
                end
                for p = 0 upto {extent bound - 1} do
                    if {bound[p] >= 0} andif {s.ptr[bound[p]] >= 0} then
                        if setPointer(s p s.ptr[bound[p]] s.off[bound[p]]) then changed := true end
                    end
                end
            end
        end

    (* Marks the candidates whose pointers are used other than as
     * docs/ssa.md section 4.2 allows, in the blocks reached *)
    let check(s: State): Ok =
        begin
            let f = s.f
            let nBlocks = vector.length(f.blocks)
            let isPointer(v: Int): Bool = {s.ptr[v] >= 0} andif s.alive[s.ptr[v]]
            (* Whether every reachable use of v is a proxy test *)
            let onlyProxyTests(v: Int): Bool =
                begin
                    let var only = true
                    for b = 0 upto {nBlocks - 1} do
                        if s.reach[b] then
                            let blk = ssa.block(f b)
                            for k = 0 upto {vector.length(blk.insts) - 1} do
                                let i = vector.get(blk.insts k)
                                for j = 0 upto {extent i.args - 1} do
                                    if {i.args[j] is v}
                                            andif {{extent i.results is 0} orif not(isProxyTest(s i.results[0]))} then
                                        only := false
                                    end
                                end
                            end
                            let uses = ssa.terminatorUses(blk.term)
                            for j = 0 upto {extent uses - 1} do if uses[j] is v then only := false end end
                        end
                    end
                    only
                end
            let inBounds(a: Int o: Int width: Int): Bool = {o >= 0} andif {{o + width} <= s.allocBytes[a]}
            for b = 0 upto {nBlocks - 1} do
                if s.reach[b] then
                    let blk = ssa.block(f b)
                    for k = 0 upto {vector.length(blk.insts) - 1} do
                        let i = vector.get(blk.insts k)
                        for j = 0 upto {extent i.args - 1} do
                            let v = i.args[j]
                            if isPointer(v) then
                                let a = s.ptr[v]
                                if {ssa.isOp(i ssa.opLoad) orif ssa.isOp(i ssa.opStore)} andif {j is 0} then
                                    let o = s.off[v] + i.imm
                                    if not(inBounds(a o i.width)) then
                                        escapes(s a "accessed outside it")
                                    else
                                        (* A word holding its pointer holds
                                         * nothing else *)
                                        let w = wordAt(s a s.off[v] i.imm i.width)
                                        let holds = {w >= 0} andif s.selfHas[a][w]
                                        let pointerStored = ssa.isOp(i ssa.opStore) andif {s.ptr[i.args[1]] is a}
                                        (* An access of part of a word holding
                                         * its pointer *)
                                        let var overlaps = false
                                        if w < 0 then
                                            for x = 0 upto {extent s.selfHas[a] - 1} do
                                                if s.selfHas[a][x] andif {o < {{x * 8} + 8}}
                                                        andif {{x * 8} < {o + i.width}} then overlaps := true end
                                            end
                                        end
                                        if holds andif ssa.isOp(i ssa.opStore) andif not(pointerStored) then
                                            escapes(s a "a word of it holding its pointer and another value")
                                        elsif overlaps then
                                            escapes(s a "a word of it holding its pointer accessed in part")
                                        end
                                    end
                                elsif ssa.isOp(i ssa.opStore) andif {j is 1} then
                                    if s.ptr[i.args[0]] isnot a then escapes(s a "stored") end
                                elsif ssa.isOp(i ssa.opPtrAdd) andif {j is 0} andif s.d.isConst[i.args[1]] then
                                    ok
                                elsif ssa.isOp(i ssa.opUnproxy) then
                                    ok
                                elsif ssa.isOp(i ssa.opPtrToInt) then
                                    if not(onlyProxyTests(i.results[0])) then escapes(s a "converted to an integer") end
                                elsif ssa.isCall(i) andif proxyFold.isBarrier(i.symbol) then
                                    ok
                                elsif ssa.isOp(i ssa.opCall) andif {j is 0} andif {s.allocValue[a] is v}
                                        andif not(holdsItself(s a)) andif s.loadOnly(i.symbol) then
                                    (* A closure passed to its own code, which
                                     * reads its captures and keeps nothing *)
                                    ok
                                elsif ssa.isCall(i) then
                                    escapes(s a "passed to " <> i.symbol)
                                else
                                    escapes(s a "used by " <> ssa.opcodeName(i.op))
                                end
                            end
                        end
                    end
                    (* At a terminator, a pointer passed along a taken edge
                     * must bind to a parameter that tracks the same candidate
                     * and offset *)
                    let ts = takenTargets(s blk.term)
                    for k = 0 upto {extent ts - 1} do
                        let t = ts[k]
                        let params = ssa.block(f t.block).params
                        for j = 0 upto {extent t.args - 1} do
                            let v = t.args[j]
                            if isPointer(v) then
                                let p = vector.get(params j)
                                if {s.ptr[p] isnot s.ptr[v]} orif {s.off[p] isnot s.off[v]} then
                                    escapes(s s.ptr[v] "passed to a block that is not only its")
                                end
                            end
                        end
                    end
                    let other(uses: Array(Int) reason: String): Ok =
                        for j = 0 upto {extent uses - 1} do
                            if isPointer(uses[j]) then escapes(s s.ptr[uses[j]] reason) end
                        end
                    case blk.term
                        when termBranch with x then other(array of x.cond end "used by a branch")
                        when termSwitch with x then other(array of x.value end "used by a switch")
                        when termReturn with x then other(x.values "returned")
                        when termTailCall with x then other(x.call.args "passed to " <> x.call.symbol)
                        when termNone, termJump, termTry, termUnreachable then ok
                    end
                end
            end
        end

    (* The analysis of f *)
    let solve(f: Function loadOnly: All(symbol: String) Bool): State =
        begin
            let nValues = vector.length(f.types)
            let nBlocks = vector.length(f.blocks)
            let d = proxyFold.definitions(f)
            let isConst = d.isConst
            let constant = d.constant
            let values = vector.new(:Int)
            let sizes = vector.new(:Int)
            for b = 0 upto {nBlocks - 1} do
                let blk = ssa.block(f b)
                for k = 0 upto {vector.length(blk.insts) - 1} do
                    let i = vector.get(blk.insts k)
                    if ssa.isOp(i ssa.opCall) andif stringOp.equal(i.symbol "quest_alloc")
                            andif {extent i.args is 2} andif {extent i.results is 1} andif isConst[i.args[0]]
                            andif {constant[i.args[0]] > 0} then
                        vector.append(values i.results[0])
                        vector.append(sizes constant[i.args[0]])
                    end
                end
            end
            let n = vector.length(values)
            let allocBytes = vector.toArray(sizes)
            let selfHas = array of(n array of(0 false))
            let selfOff = array of(n array of(0 0))
            for a = 0 upto {n - 1} do
                selfHas[a] := array of({{allocBytes[a] + 7} / 8} false)
                selfOff[a] := array of({{allocBytes[a] + 7} / 8} 0)
            end
            let s = tuple
                let f = f
                let d = d
                let allocValue = vector.toArray(values)
                let allocBytes = allocBytes
                let alive = array of(n true)
                let reasons = array of(n "")
                let ptr = array of(nValues ~1)
                let off = array of(nValues 0)
                let selfHas = selfHas
                let selfOff = selfOff
                let reach = array of(nBlocks true)
                let loadOnly = loadOnly
            end
            (* Optimistically assume no candidate escapes; each round drops
             * those that do until a round drops none *)
            let countAlive(): Int =
                begin
                    let var c = 0
                    for a = 0 upto {n - 1} do if s.alive[a] then c := c + 1 end end
                    c
                end
            let var before = ~1
            while {n > 0} andif {before isnot countAlive()} do
                before := countAlive()
                (* Reachability depends on known pointers (which fold proxy
                 * tests), and block parameter bindings depend on
                 * reachability *)
                proxyFold.settle(s.d s.reach fun(): Ok pointers(s) fun(v: Int): Bool isProxyTest(s v))
                check(s)
            end
            s
        end

    let nothingLoadOnly(symbol: String): Bool = false

    let analyze(f: Function): Array(Verdict) =
        begin
            let s = solve(f nothingLoadOnly)
            let n = extent s.allocValue
            let verdicts = array of(n tuple let value = 0 let bytes = 0 let escapes = false let reason = "" end)
            for a = 0 upto {n - 1} do
                verdicts[a] := tuple
                    let value = s.allocValue[a]
                    let bytes = s.allocBytes[a]
                    let escapes = not(s.alive[a])
                    let reason = s.reasons[a]
                end
            end
            verdicts
        end

    let typeCode = ssa.typeCode
    let typeOfCode = ssa.typeOfCode

    let escapeIn(f: Function loadOnly: All(symbol: String) Bool): Int =
        begin
            let s = solve(f loadOnly)
            let n = extent s.allocValue
            let isPointer(v: Int): Bool = {s.ptr[v] >= 0} andif s.alive[s.ptr[v]]
            let var removed = 0
            for a = 0 upto {n - 1} do if s.alive[a] then removed := removed + 1 end end
            if removed > 0 then
                let nBlocks = vector.length(f.blocks)
                (* Infer each word's type from its stores (falling back to
                 * loads) so zero-initialization matches what slot promotion
                 * expects, and record whether each word is ever accessed
                 * other than by its first byte *)
                let wordType = array of(n array of(0 0))
                let wordWide = array of(n array of(0 false))
                for a = 0 upto {n - 1} do
                    wordType[a] := array of(extent s.selfHas[a] ~1)
                    wordWide[a] := array of(extent s.selfHas[a] false)
                end
                for pass = 0 upto 1 do
                    for b = 0 upto {nBlocks - 1} do
                        if s.reach[b] then
                            let blk = ssa.block(f b)
                            for k = 0 upto {vector.length(blk.insts) - 1} do
                                let i = vector.get(blk.insts k)
                                let access = ssa.isOp(i ssa.opLoad) orif ssa.isOp(i ssa.opStore)
                                if access andif isPointer(i.args[0]) then
                                    let a = s.ptr[i.args[0]]
                                    let o = s.off[i.args[0]] + i.imm
                                    if {i.width isnot 1} orif {{o % 8} isnot 0} then
                                        for w = {o / 8} upto {{{o + i.width} - 1} / 8} do wordWide[a][w] := true end
                                    end
                                    let w = o / 8
                                    let t =
                                        if {pass is 0} andif ssa.isOp(i ssa.opStore) then
                                            typeCode(ssa.typeOf(f i.args[1]))
                                        elsif {pass is 1} andif ssa.isOp(i ssa.opLoad) then
                                            typeCode(ssa.typeOf(f i.results[0]))
                                        else
                                            ~1
                                        end
                                    if {t >= 0} andif {wordType[a][w] < 0} then wordType[a][w] := t end
                                end
                            end
                        end
                    end
                end
                (* Rewrite each reachable block: replace each surviving
                 * allocation with a zeroed stack slot, drop its derived
                 * pointers, self-pointer stores, and write barriers, fold its
                 * proxy tests to false, and redirect its loads and stores to
                 * the slot address. Proxy tests are identified first because
                 * rewriting modifies block instructions in place. *)
                let proxyTest = array of(extent s.ptr false)
                for v = 0 upto {extent s.ptr - 1} do proxyTest[v] := isProxyTest(s v) end
                for b = 0 upto {nBlocks - 1} do
                    if s.reach[b] then
                        let blk = ssa.block(f b)
                        case blk.term
                            when termBranch with x then
                                if proxyTest[x.cond] then
                                    blk.term := option termJump of ssa.Terminator with let target = x.ifFalse end
                                end
                            when termNone, termJump, termSwitch, termReturn, termTailCall, termTry, termUnreachable then
                                ok
                        end
                        let kept = vector.new(:ssa.Inst)
                        for k = 0 upto {vector.length(blk.insts) - 1} do
                            let i = vector.get(blk.insts k)
                            let result = if extent i.results > 0 then i.results[0] else ~1 end
                            let access = ssa.isOp(i ssa.opLoad) orif ssa.isOp(i ssa.opStore)
                            if {result >= 0} andif isPointer(result) andif {s.allocValue[s.ptr[result]] is result} then
                                let a = s.ptr[result]
                                let words = extent s.selfHas[a]
                                let slot = ssa.instruction(ssa.opSlot array of :Int end i.results
                                        ssa.newSlot(f {words * 8} 8) "" 0 false ssa.emptySignature)
                                slot.loc := i.loc
                                vector.append(kept slot)
                                for w = 0 upto {words - 1} do
                                    if not(s.selfHas[a][w]) then
                                        let zero = proxyFold.zeroOf(f kept typeOfCode(wordType[a][w]) i.loc)
                                        let width = if wordWide[a][w] then 8 else 1 end
                                        let store = ssa.instruction(ssa.opStore array of result zero end
                                                array of :Int end {w * 8} "" width false ssa.emptySignature)
                                        store.loc := i.loc
                                        vector.append(kept store)
                                    end
                                end
                            elsif {result >= 0} andif isPointer(result) then
                                ok
                            elsif ssa.isOp(i ssa.opStore) andif isPointer(i.args[1]) then
                                ok
                            elsif ssa.isOp(i ssa.opPtrToInt) andif isPointer(i.args[0]) then
                                ok
                            elsif ssa.isCall(i) andif proxyFold.isBarrier(i.symbol) andif isPointer(i.args[0]) then
                                ok
                            elsif {result >= 0} andif proxyTest[result] then
                                let zero = ssa.instruction(ssa.opConst array of :Int end i.results 0 "" 0 false
                                        ssa.emptySignature)
                                zero.loc := i.loc
                                vector.append(kept zero)
                            elsif access andif isPointer(i.args[0]) then
                                let p = i.args[0]
                                i.imm := s.off[p] + i.imm
                                i.args[0] := s.allocValue[s.ptr[p]]
                                (* A slot in a loop is reused each time
                                 * round, so what it holds is not invariant *)
                                i.invariant := false
                                vector.append(kept i)
                            else
                                vector.append(kept i)
                            end
                        end
                        vector.clear(blk.insts)
                        for k = 0 upto {vector.length(kept) - 1} do
                            vector.append(blk.insts vector.get(kept k))
                        end
                    end
                end
                (* Remove block parameters that were candidate pointers and
                 * their jump arguments *)
                for b = 0 upto {nBlocks - 1} do
                    if s.reach[b] then
                        let ts = ssa.targets(ssa.block(f b).term)
                        for k = 0 upto {extent ts - 1} do
                            let t = ts[k]
                            let params = ssa.block(f t.block).params
                            let args = vector.new(:Int)
                            for j = 0 upto {extent t.args - 1} do
                                if not(isPointer(vector.get(params j))) then vector.append(args t.args[j]) end
                            end
                            t.args := vector.toArray(args)
                        end
                    end
                end
                for b = 0 upto {nBlocks - 1} do
                    let params = ssa.block(f b).params
                    let left = vector.new(:Int)
                    for j = 0 upto {vector.length(params) - 1} do
                        let p = vector.get(params j)
                        if not(isPointer(p)) then vector.append(left p) end
                    end
                    vector.clear(params)
                    for j = 0 upto {vector.length(left) - 1} do
                        vector.append(params vector.get(left j))
                    end
                end
                (* Drop blocks that were only reachable through folded
                 * proxy-test arms *)
                cfg.dropUnreached(f)
            end
            removed
        end

    let escapeFunction(f: Function): Int = escapeIn(f nothingLoadOnly)

    let callsItself(f: Function): Bool =
        begin
            let var found = false
            for b = 0 upto {vector.length(f.blocks) - 1} do
                let blk = ssa.block(f b)
                for k = 0 upto {vector.length(blk.insts) - 1} do
                    let i = vector.get(blk.insts k)
                    if ssa.isOp(i ssa.opCall) andif stringOp.equal(i.symbol f.symbol) then found := true end
                end
            end
            found
        end

    (* Runs escape analysis on each function of u, tracking which functions
     * use their first parameter only as a load address so that a closure
     * passed to its own code need not escape *)
    let escapeUnit(u: ssa.Unit): Int =
        begin
            let loadOnly = hashMap.new(:String :Bool stringOp.equal hash.string)
            for i = 0 upto {vector.length(u.functions) - 1} do
                let f = vector.get(u.functions i)
                if firstLoadOnly(f) then begin hashMap.insert(loadOnly f.symbol true) ok end end
            end
            let known(symbol: String): Bool = hashMap.contains(loadOnly symbol)
            let var count = 0
            for i = 0 upto {vector.length(u.functions) - 1} do
                (* Skip the load-only closure optimization when passing a slot
                 * to a call would forfeit a tail call: tailCalls marks no
                 * tail calls in a function where a slot's address escapes, so
                 * recursion would grow the stack. Self-recursive functions
                 * are also excluded because accumulate may turn the self-call
                 * into a loop later. *)
                let f = vector.get(u.functions i)
                let keepsTails = tailCalls.hasTailCalls(f) orif callsItself(f)
                count := count + escapeIn(f if keepsTails then nothingLoadOnly else known end)
            end
            count
        end
end
