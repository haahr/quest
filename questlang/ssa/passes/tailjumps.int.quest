(* Quest Self-Hosted Compiler: The SSA's Tail Jumps Interface
 *
 * This pass turns mutual tail recursion into intra-function loops
 * (docs/ssa.md section 4.1). Direct tail calls between functions in a unit
 * form a call graph whose strongly connected components (maximal groups of
 * functions that can all reach one another) are the mutually tail-recursive
 * groups. Into each function in a multi-function group, this pass copies the
 * other group members it reaches through tail calls (each at most once) as
 * long as the copied function has no stack slots or try blocks, passes all
 * parameters in registers, matches the target function's return types and
 * calling convention, and fits within a 100-instruction budget. Tail calls to
 * copied members are then rewritten as jumps to the copy's entry block, while
 * a function's one self tail call is ssa/passes/loops' loop by then, and
 * others are left for the backends to turn into jumps. *)

interface TailJumps
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    jumpUnit(u: ssa.Unit): Ok

    (* Helpers shared with questlang/ssa/passes/trampolines. True if g can be
     * copied into another function: it has no stack slots or try terminators,
     * and all of its parameters are passed in registers (as a jump passes
     * block arguments). *)
    copiable(g: ssa.Function): Bool
    (* True if f and g have the same result types and return calling
     * convention *)
    sameResults(f: ssa.Function g: ssa.Function): Bool
    (* Append a copy of g into block `at` of f (which must not have a
     * terminator yet). The instructions and terminator of g's entry block are
     * appended to `at` with args substituted for g's parameters, and g's
     * remaining blocks are added as new blocks of f. No block in g may branch
     * back to g's entry block. *)
    spliceInto(f: ssa.Function at: Int g: ssa.Function args: Array(Int)): Ok
end
