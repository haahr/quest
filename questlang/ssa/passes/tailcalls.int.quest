(* Quest Self-Hosted Compiler: The SSA's Tail Calls Interface
 *
 * Marks calls in tail position as tail calls (docs/ssa.md section 3,
 * docs/arm64.md section 3.7). A call is in tail position when its results —
 * or a byte sign/zero extension or pointer/QVal retype of its result — are
 * what the function returns, either directly or through empty blocks that
 * only forward them to a return.
 *
 * A function from which any stack slot's address may escape (stored into
 * memory, passed to a call, or returned) gets no tail calls, because a tail
 * call reuses the caller's stack frame and invalidates its slots. That
 * includes every function that enters a try, since its exception-handler
 * record is a stack slot linked onto the handler chain. *)

interface TailCalls
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    (* Whether a stack slot's address may escape from f: stored, passed to a
     * call, or returned *)
    slotsEscape(f: ssa.Function): Bool
    (* Whether a jump to t returns exactly values: its block does nothing but
     * return them, or pass them on to another such block, once its
     * parameters are taken as the jump's arguments *)
    returnsThrough(f: ssa.Function t: ssa.Target values: Array(Int)): Bool
    (* Whether f has a call that markUnit would make a tail call, were none
     * of its slots' addresses to escape *)
    hasTailCalls(f: ssa.Function): Bool
    markUnit(u: ssa.Unit): Ok
end
