(* Quest Self-Hosted Compiler: The SSA's Slot Promotion Interface
 *
 * Promotes stack slots to SSA values (docs/ssa.md section 4.1). A slot sized
 * in whole words whose address is used only to load and store whole words or
 * a word's first byte is split into one SSA variable per word. Each word must
 * hold values of a single type, be stored at a single width, and not be
 * loaded whole if stored by byte.
 *
 * Promotion follows Cytron et al.: it places block parameters (SSA's form of
 * phi nodes) at each variable's iterated dominance frontier — the join blocks
 * where different definitions can meet — and renames loads and stores in a
 * walk of the dominator tree (where each block dominates all blocks reachable
 * only through it). A load before any store reads zero, and remaining slots
 * are renumbered. A slot accessed in a block reachable from a try's handler
 * is kept, because the handler must see values stored by the body before
 * unwinding (docs/arm64.md section 3.6); a slot used only by the body, such
 * as an inlined loop's variables, is promoted. *)

interface Promote
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    (* The number of slots promoted *)
    promoteFunction(f: ssa.Function): Int
    promoteUnit(u: ssa.Unit): Int
end
