(* Quest Self-Hosted Compiler: The SSA's Loops: Bounds Checks Interface
 *
 * A step of the loops pass (ssa/passes/loops, docs/ssa.md section 4.1).
 *
 * A bounds check (a branch on x <u len to a block that raises) goes
 * when the comparisons before it decide it: x is never negative (a constant,
 * a length, such a value plus a small constant, or a block parameter every
 * jump binds such a value to) and x <= len - 1, by a comparison on a branch
 * that dominates the check or, for a block parameter, on every jump into its
 * block: by the value the jump binds, or, for one that binds x + 1, by a test
 * there that x isnot len - 1 (a for loop's, by induction). Values compare by
 * form (a base and a constant offset, with loads by address and symbols by
 * name), so that len - 1 copied for a guard is the header's; string.length's
 * test for a null string is the length, since under a bound of 0 - 1 no index
 * that is not negative reaches the check. *)

interface Bounds
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    (* Decides f's bounds checks that the comparisons before them decide;
     * whether it decided any *)
    decideBounds(f: ssa.Function): Bool
end
