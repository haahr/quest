(* Quest Self-Hosted Compiler: The SSA's Trampolines Interface
 *
 * Inlines small target functions into exported wrapper trampolines
 * (docs/ssa.md section 4.1). Another compilation unit calls a module's
 * function through its exported qv_ wrapper, which passes a null closure
 * environment and tail-calls the implementation — often through a local
 * adapter (ir.md section 8.4.1) that tail-calls the implementation in turn.
 * Without this pass, a cross-unit call such as vector.get takes three jumps,
 * whereas in the C build clang inlines both wrappers.
 *
 * When an exported single-block function ends in a tail call to another
 * function in the same unit, this pass splices a copy of the callee in place
 * of the tail call, repeating up to 4 times while the entry block still ends
 * in an eligible tail call (so an adapter is inlined first, then its target).
 * A callee is eligible when it has at most 64 instructions (counting
 * terminators), makes no non-tail calls outside blocks ending in unreachable
 * (such as raises), has no branch back to its entry block, matches the call's
 * argument and result types, and satisfies tailJumps.copiable. Other callers
 * of the callee are unchanged. *)

interface Trampolines
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    trampolineUnit(u: ssa.Unit): Ok
end
