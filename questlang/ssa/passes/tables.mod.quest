(* Quest Self-Hosted Compiler: The SSA's Tables Implementation *)

module tables : Tables
import
    conv : Conv

    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/ssa/cfg : questlang/ssa/CFG
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    Let Function = ssa.Function
    Let Defs = Array(maybe.T(ssa.Inst))

    (* Minimum number of cases required to build a lookup table, and maximum
     * number of intermediate constant-only blocks an arm may traverse to reach
     * the join block *)
    let fewest = 4
    let longest = 8

    (* True if blk contains only constant definitions (opConst or opSymbol).
     * Because other arms bypass blk on their way to the join block, values
     * defined here cannot be used past the join except as block arguments. *)
    let onlyConstants(blk: ssa.Block): Bool =
        begin
            let var all = true
            for k = 0 upto {vector.length(blk.insts) - 1} do
                let i = vector.get(blk.insts k)
                if not(ssa.isOp(i ssa.opConst) orif ssa.isOp(i ssa.opSymbol)) then all := false end
            end
            all
        end

    (* The join of a switch whose arms return rather than jump: their returns
     * act as jumps to one block that returns its parameters *)
    let returns = ~1

    (* Follow a switch arm starting at target t through up to `longest`
     * parameterless, constant-only jump blocks, returning the first target
     * that passes arguments, or a return of values as a target of the block
     * returns (or none if the arm does not fit that shape). A function whose
     * body is the switch has arms that return, since the simplifier turns a
     * join that only returns into a return in each arm. *)
    let follow(f: Function t: ssa.Target): maybe.T(ssa.Target) =
        begin
            let var at = t
            let var result = maybe.none(:ssa.Target)
            let var steps = 0
            let var going = true
            while going do
                going := false
                if extent at.args > 0 then
                    result := maybe.some(at)
                else
                    let blk = ssa.block(f at.block)
                    if {vector.length(blk.params) is 0} andif {steps < longest} andif onlyConstants(blk) then
                        case blk.term
                            when termJump with x then
                                at := x.target
                                steps := steps + 1
                                going := true
                            when termReturn with x then
                                if extent x.values > 0 then result := maybe.some(ssa.target(returns x.values)) end
                            when termNone, termBranch, termSwitch, termTailCall, termTry, termUnreachable then ok
                        end
                    end
                end
            end
            result
        end

    (* The word of static data that is v, if an opConst or an opSymbol
     * defines it *)
    let wordOf(defs: Defs v: Int): maybe.T(ssa.Word) =
        if maybe.isNone(defs[v]) then
            maybe.none()
        else
            let i = maybe.unwrap(defs[v])
            if ssa.isOp(i ssa.opConst) then maybe.some(option wordInt of ssa.Word with let n = i.imm end)
            elsif ssa.isOp(i ssa.opSymbol) then
                maybe.some(option wordSymbol of ssa.Word with let symbol = i.symbol let addend = i.imm end)
            else maybe.none()
            end
        end

    (* A switch's plan: the join, the least case and the range's size, and for
     * each of the join's parameters either a table's words (varies) or the
     * value every arm passes (same) *)
    Let Plan = Tuple
        join: Int
        least: Int
        size: Int
        varies: Array(Bool)
        same: Array(Int)
        words: Array(Array(ssa.Word))
    end

    (* The lookup-table plan for a switch over cases/targets with the given
     * default target, or none if the switch cannot be converted *)
    let plan(f: Function defs: Defs cases: Array(Int) targets: Array(ssa.Target) default: ssa.Target): maybe.T(Plan) =
        if extent cases < fewest then
            maybe.none()
        else
            let var least = cases[0]
            let var most = cases[0]
            for k = 1 upto {extent cases - 1} do
                if cases[k] < least then least := cases[k] end
                if cases[k] > most then most := cases[k] end
            end
            (* Check that spread is non-negative and dense before adding 1 for
             * size, so widely separated cases cannot wrap around *)
            let spread = most - least
            let dense = {spread >= 0} andif {spread < 2 * extent cases}
            let arms = array of(extent cases maybe.none(:ssa.Target))
            let var fits = dense
            for k = 0 upto {extent cases - 1} do
                if fits then
                    arms[k] := follow(f targets[k])
                    if maybe.isNone(arms[k]) then fits := false end
                end
            end
            if not(fits) then
                maybe.none()
            else
                let size = spread + 1
                let first = maybe.unwrap(arms[0])
                let join = first.block
                let n = extent first.args
                let other = follow(f default)
                let gaps = size > extent cases
                let defaultArm = maybe.isSome(other) andif {maybe.unwrap(other).block is join}
                if gaps andif not(defaultArm) then fits := false end
                for k = 0 upto {extent cases - 1} do
                    let arm = maybe.unwrap(arms[k])
                    if {arm.block isnot join} orif {extent arm.args isnot n} then fits := false end
                end
                if defaultArm andif {extent maybe.unwrap(other).args isnot n} then fits := false end
                let varies = array of(n false)
                let same = array of(n 0)
                let words = array of(n array of :ssa.Word end)
                let var anyVaries = false
                if fits then
                    for p = 0 upto {n - 1} do
                        let v = first.args[p]
                        same[p] := v
                        for k = 1 upto {extent cases - 1} do
                            if maybe.unwrap(arms[k]).args[p] isnot v then varies[p] := true end
                        end
                        if gaps andif {maybe.unwrap(other).args[p] isnot v} then varies[p] := true end
                        if varies[p] then
                            anyVaries := true
                            (* The first arm's argument has the type of the
                             * join's parameter, or of the value returned *)
                            case ssa.typeOf(f v)
                                when typeReal then fits := false
                                when typeInt, typePtr, typeVal then ok
                            end
                        end
                    end
                end
                if fits andif anyVaries then
                    for p = 0 upto {n - 1} do
                        if varies[p] then
                            (* The default's word fills the gaps *)
                            let filler = if gaps then wordOf(defs maybe.unwrap(other).args[p])
                                else maybe.some(option wordInt of ssa.Word with let n = 0 end) end
                            if maybe.isNone(filler) then
                                fits := false
                            else
                                let ws = array of(size maybe.unwrap(filler))
                                for k = 0 upto {extent cases - 1} do
                                    let w = wordOf(defs maybe.unwrap(arms[k]).args[p])
                                    if maybe.isNone(w) then fits := false
                                    else ws[cases[k] - least] := maybe.unwrap(w)
                                    end
                                end
                                words[p] := ws
                            end
                        end
                    end
                end
                if fits andif anyVaries then
                    maybe.some(tuple
                        let join = join
                        let least = least
                        let size = size
                        let varies = varies
                        let same = same
                        let words = words
                    end)
                else
                    maybe.none()
                end
            end
        end

    (* Replace block b's switch on value with a range check (branching to
     * default when out of range) and a new block that loads each varying
     * argument from its static table (appended to u.data as symbol, symbol_1,
     * ...) before jumping to p.join, or returning them when p.join is
     * returns. A load takes the type of the first arm's argument (p.same's),
     * which is the join parameter's, or the value returned. *)
    let convert(u: ssa.Unit f: Function b: Int value: Int default: ssa.Target p: Plan symbol: String): Ok =
        begin
            let blk = ssa.block(f b)
            f.at := blk.termLoc
            let index = if p.least is 0 then value
                else ssa.binary(f b ssa.opSub value ssa.constant(f b p.least)) end
            let inRange = ssa.binary(f b ssa.opUlt index ssa.constant(f b p.size))
            let load = ssa.newBlock(f)
            ssa.block(f load).termLoc := blk.termLoc
            blk.term := option termBranch of ssa.Terminator with
                let cond = inRange
                let ifTrue = ssa.target(load array of :Int end)
                let ifFalse = default
            end
            let args = array of(extent p.same 0)
            let var tables = 0
            let offset = ssa.binary(f load ssa.opShl index ssa.constant(f load 3))
            for k = 0 upto {extent p.same - 1} do
                if p.varies[k] then
                    let name = if tables is 0 then symbol else symbol <> "_" <> conv.int(tables) end
                    tables := tables + 1
                    vector.append(u.data ssa.words(name false false p.words[k]))
                    let address = ssa.ptrAdd(f load ssa.symbolAddress(f load name) offset)
                    args[k] := ssa.invariantLoad(f load address 0 8 false ssa.typeOf(f p.same[k]))
                else
                    args[k] := p.same[k]
                end
            end
            if p.join is returns then
                ssa.terminate(f load option termReturn of ssa.Terminator with let values = args end)
            else
                ssa.terminate(f load option termJump of ssa.Terminator with let target = ssa.target(p.join args) end)
            end
        end

    (* Replace eligible switches in f with table lookups, appending the static
     * tables to u *)
    let tableFunction(u: ssa.Unit f: Function): Ok =
        begin
            let g = cfg.graph(f)
            let nBlocks = vector.length(f.blocks)
            let defs = array of(vector.length(f.types) maybe.none(:ssa.Inst))
            for b = 0 upto {nBlocks - 1} do
                let insts = ssa.block(f b).insts
                for k = 0 upto {vector.length(insts) - 1} do
                    let i = vector.get(insts k)
                    for j = 0 upto {extent i.results - 1} do defs[i.results[j]] := maybe.some(i) end
                end
            end
            let at = f.at
            let var made = 0
            for b = 0 upto {nBlocks - 1} do
                if cfg.reached(g b) then
                    case ssa.block(f b).term
                        when termSwitch with x then
                            let p = plan(f defs x.cases x.targets x.default)
                            if maybe.isSome(p) then
                                convert(u f b x.value x.default maybe.unwrap(p)
                                        "qt_" <> f.symbol <> "_" <> conv.int(made))
                                made := made + 1
                            end
                        when termNone, termJump, termBranch, termReturn, termTailCall, termTry, termUnreachable then ok
                    end
                end
            end
            f.at := at
            if made > 0 then cfg.dropUnreached(f) end
        end

    let tableUnit(u: ssa.Unit): Ok =
        for i = 0 upto {vector.length(u.functions) - 1} do
            tableFunction(u vector.get(u.functions i))
        end
end
