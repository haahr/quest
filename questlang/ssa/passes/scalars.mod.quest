(* Quest Self-Hosted Compiler: The SSA's Scalar Replacement Implementation *)

module scalars : Scalars
import
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/common/maps : questlang/common/Maps
    questlang/ssa/blockParams : questlang/ssa/BlockParams
    questlang/ssa/cfg : questlang/ssa/CFG
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/ssa/passes/proxyFold : questlang/ssa/passes/ProxyFold
export
    Let Function = ssa.Function
    Def Verdict = Tuple value: Int constant: Bool left: Bool reason: String end

    (* A word of a group's layout: nothing known of it (no member stores it
     * and nothing loads it), a value of one type, or a pointer to an object
     * of another group, at an offset, whose own words it stands for *)
    let wordNone = 0
    let wordScalar = 1
    let wordNested = 2

    (* Analysis state for one function. An origin is what creates an object: a
     * quest_alloc of a constant size, or the address of a word in read-only
     * static data (such as a constant option). Origins whose pointers meet at
     * a block parameter or are loaded from the same word of a group belong to
     * one union-find group, whose objects are replaced by their words
     * together. *)
    Let State = Tuple
        f: Function
        d: proxyFold.Defs
        (* Each origin: the value it makes, whether it is static data, its
         * size in words, the static words from its address on, and for an
         * allocation, the value each word is stored by the stores that
         * initialize it (~1 for none), and the index in its block of the last
         * of them (its own index if none) *)
        originValue: vector.T(Int)
        originDatum: vector.T(Bool)
        originWords: vector.T(Int)
        originData: vector.T(Array(ssa.Word))
        stores: vector.T(Array(Int))
        lastStore: vector.T(Int)
        (* The origin each value makes (~1 for none), and the allocation a
         * value points into directly, derived from its value by constant
         * offsets (~1 for none), at what offset *)
        originOf: Array(Int)
        exact: Array(Int)
        exactOff: Array(Int)
        (* The origins' groups (a union-find forest), and whether each origin
         * is left alone, and why *)
        var parent: Array(Int)
        var dead: Array(Bool)
        var reasons: Array(String)
        (* The origin each value points into (~1 for none), and its offset *)
        ptr: Array(Int)
        off: Array(Int)
        (* The blocks reached once proxy tests of the groups' pointers fold *)
        reach: Array(Bool)
    end

    let defOf(s: State v: Int): ssa.Inst = proxyFold.defOf(s.d v)
    let definedBy(s: State v: Int op: ssa.Opcode): Bool = proxyFold.definedBy(s.d v op)

    let rec find(s: State a: Int): Int =
        if s.parent[a] is a then a
        else begin let r = find(s s.parent[a]) s.parent[a] := r r end
        end

    let union(s: State a: Int b: Int): Bool =
        begin
            let x = find(s a)
            let y = find(s b)
            if x is y then false
            else begin
                if x < y then s.parent[y] := x else s.parent[x] := y end
                true
            end
            end
        end

    let kill(s: State a: Int reason: String): Ok =
        if not(s.dead[a]) then begin s.dead[a] := true s.reasons[a] := reason end end

    (* Kills every origin of a's group *)
    let killGroup(s: State a: Int reason: String): Ok =
        begin
            let g = find(s a)
            for o = 0 upto {extent s.parent - 1} do if find(s o) is g then kill(s o reason) end end
        end

    let live(s: State v: Int): Bool = {v >= 0} andif {s.ptr[v] >= 0} andif not(s.dead[s.ptr[v]])

    (* Reports whether v tests a group pointer for being a runtime proxy
     * (QProxy); such tests fold to false because no origin is a proxy *)
    let isProxyTest(s: State v: Int): Bool = proxyFold.isProxyTest(s.d v fun(p: Int): Bool live(s p))

    let takenTargets(s: State term: ssa.Terminator): Array(ssa.Target) =
        proxyFold.takenTargets(term fun(v: Int): Bool isProxyTest(s v))

    (* ======================================================================
     * Origins
     * ====================================================================== *)

    (* The static data's words of a symbol that is never written *)
    let constantWords(u: ssa.Unit): maps.StringMap(Array(ssa.Word)) =
        begin
            let found = maps.newStringMap(:Array(ssa.Word))
            for i = 0 upto {vector.length(u.data) - 1} do
                let d = vector.get(u.data i)
                if not(d.writable) then
                    case d.contents
                        when contentsWords with x then
                            begin hashMap.insert(found d.symbol x.words) ok end
                        else ok
                    end
                end
            end
            found
        end

    let addOrigin(s: State v: Int datum: Bool words: Int data: Array(ssa.Word)): Ok =
        begin
            s.originOf[v] := vector.length(s.originValue)
            vector.append(s.originValue v)
            vector.append(s.originDatum datum)
            vector.append(s.originWords words)
            vector.append(s.originData data)
            vector.append(s.stores array of(words ~1))
            vector.append(s.lastStore s.d.defIndex[v])
        end

    (* The words of a static datum from byte addend on *)
    let wordsFrom(ws: Array(ssa.Word) addend: Int): Array(ssa.Word) =
        begin
            let start = addend / 8
            let n = if extent ws > start then extent ws - start else 0 end
            let result = array of(n option wordInt of ssa.Word with let n = 0 end)
            for k = 0 upto {n - 1} do result[k] := ws[start + k] end
            result
        end

    let newState(u: ssa.Unit f: Function): State =
        begin
            let nValues = vector.length(f.types)
            let nBlocks = vector.length(f.blocks)
            let s = tuple
                let f = f
                let d = proxyFold.definitions(f)
                let originValue = vector.new(:Int)
                let originDatum = vector.new(:Bool)
                let originWords = vector.new(:Int)
                let originData = vector.new(:Array(ssa.Word))
                let stores = vector.new(:Array(Int))
                let lastStore = vector.new(:Int)
                let originOf = array of(nValues ~1)
                let exact = array of(nValues ~1)
                let exactOff = array of(nValues 0)
                let var parent = array of(0 0)
                let var dead = array of(0 false)
                let var reasons = array of(0 "")
                let ptr = array of(nValues ~1)
                let off = array of(nValues 0)
                let reach = array of(nBlocks true)
            end
            let constants = constantWords(u)
            let datumAt(v: Int): maybe.T(Tuple symbol: String addend: Int end) =
                if definedBy(s v ssa.opSymbol) andif hashMap.contains(constants defOf(s v).symbol) then
                    maybe.some(tuple
                        let symbol = defOf(s v).symbol
                        let addend = defOf(s v).imm
                    end)
                else
                    maybe.none()
                end
            for b = 0 upto {nBlocks - 1} do
                let blk = ssa.block(f b)
                for k = 0 upto {vector.length(blk.insts) - 1} do
                    let i = vector.get(blk.insts k)
                    if ssa.isOp(i ssa.opCall) andif stringOp.equal(i.symbol "quest_alloc") andif {extent i.args is 2}
                            andif {extent i.results is 1} andif s.d.isConst[i.args[0]]
                            andif {s.d.constant[i.args[0]] > 0} then
                        addOrigin(s i.results[0] false {{s.d.constant[i.args[0]] + 7} / 8} array of :ssa.Word end)
                    elsif ssa.isOp(i ssa.opSymbol) andif {{i.imm % 8} is 0} andif {i.imm >= 0}
                            andif hashMap.contains(constants i.symbol) then
                        let ws = wordsFrom(hashMap.find(constants i.symbol) i.imm)
                        addOrigin(s i.results[0] true extent ws ws)
                    elsif ssa.isOp(i ssa.opPtrAdd) andif s.d.isConst[i.args[1]] then
                        (* A constant's address plus an offset is another
                         * constant's (a case's, in a table of them) *)
                        let d = datumAt(i.args[0])
                        if maybe.isSome(d) then
                            let at = maybe.unwrap(d)
                            let addend = at.addend + s.d.constant[i.args[1]]
                            if {addend >= 0} andif {{addend % 8} is 0} then
                                let ws = wordsFrom(hashMap.find(constants at.symbol) addend)
                                addOrigin(s i.results[0] true extent ws ws)
                            end
                        end
                    end
                end
            end
            let n = vector.length(s.originValue)
            s.parent := array of(n 0)
            for a = 0 upto {n - 1} do s.parent[a] := a end
            s.dead := array of(n false)
            s.reasons := array of(n "")
            (* The pointers derived from each allocation's value directly *)
            let var changed = true
            for a = 0 upto {n - 1} do
                if not(vector.get(s.originDatum a)) then s.exact[vector.get(s.originValue a)] := a end
            end
            while changed do
                changed := false
                for b = 0 upto {nBlocks - 1} do
                    let blk = ssa.block(f b)
                    for k = 0 upto {vector.length(blk.insts) - 1} do
                        let i = vector.get(blk.insts k)
                        if ssa.isOp(i ssa.opPtrAdd) andif {s.exact[i.args[0]] >= 0} andif s.d.isConst[i.args[1]]
                                andif {s.exact[i.results[0]] < 0} then
                            s.exact[i.results[0]] := s.exact[i.args[0]]
                            s.exactOff[i.results[0]] := s.exactOff[i.args[0]] + s.d.constant[i.args[1]]
                            changed := true
                        elsif ssa.isOp(i ssa.opUnproxy) andif {s.exact[i.args[0]] >= 0}
                                andif {s.exact[i.results[0]] < 0} then
                            (* An origin's object is never a proxy *)
                            s.exact[i.results[0]] := s.exact[i.args[0]]
                            s.exactOff[i.results[0]] := s.exactOff[i.args[0]]
                            changed := true
                        end
                    end
                end
            end
            (* Collects each allocation's initializing stores, requiring them
             * to be in the allocation's own block through its exact pointers,
             * writing each word at most once, with no loads through those
             * pointers before the last store *)
            for b = 0 upto {nBlocks - 1} do
                let blk = ssa.block(f b)
                for k = 0 upto {vector.length(blk.insts) - 1} do
                    let i = vector.get(blk.insts k)
                    if {ssa.isOp(i ssa.opStore) orif ssa.isOp(i ssa.opLoad)} andif {s.exact[i.args[0]] >= 0} then
                        let a = s.exact[i.args[0]]
                        let v = vector.get(s.originValue a)
                        let w = proxyFold.wordOf(s.exactOff[i.args[0]] i.imm i.width)
                        let ws = vector.get(s.stores a)
                        if {w < 0} orif {w >= extent ws} then kill(s a "accessed other than by whole words")
                        elsif ssa.isOp(i ssa.opStore) then
                            if s.d.defBlock[v] isnot b then kill(s a "stored to after it is made")
                            elsif ws[w] >= 0 then kill(s a "a word stored twice")
                            else begin ws[w] := i.args[1] vector.set(s.lastStore a k) end
                            end
                        end
                    end
                end
            end
            for b = 0 upto {nBlocks - 1} do
                let blk = ssa.block(f b)
                for k = 0 upto {vector.length(blk.insts) - 1} do
                    let i = vector.get(blk.insts k)
                    if ssa.isOp(i ssa.opLoad) andif {s.exact[i.args[0]] >= 0} then
                        let a = s.exact[i.args[0]]
                        if {s.d.defBlock[vector.get(s.originValue a)] is b} andif {k < vector.get(s.lastStore a)} then
                            kill(s a "read before it is initialized")
                        end
                    end
                end
            end
            (* An object's values are known at its last initializing store, so
             * an allocation it holds must be initialized before it *)
            for a = 0 upto {n - 1} do
                let ws = vector.get(s.stores a)
                for w = 0 upto {extent ws - 1} do
                    let v = ws[w]
                    if {v >= 0} andif {s.exact[v] >= 0} then
                        let h = s.exact[v]
                        let here = s.d.defBlock[vector.get(s.originValue a)]
                        if {s.d.defBlock[vector.get(s.originValue h)] is here}
                                andif {vector.get(s.lastStore h) > vector.get(s.lastStore a)} then
                            kill(s a "initialized before an object it holds")
                        end
                    end
                end
            end
            s
        end

    (* ======================================================================
     * Analysis
     * ====================================================================== *)

    (* Records that v points into a's group at offset, and returns whether
     * that changed anything: v pointed nowhere yet, or two groups it points
     * into are joined into one. Two offsets kill the group instead. *)
    let setPointer(s: State v: Int a: Int offset: Int): Bool =
        if s.ptr[v] < 0 then begin s.ptr[v] := a s.off[v] := offset true end
        else begin
            let joined = union(s s.ptr[v] a)
            if s.off[v] isnot offset then begin
                killGroup(s a "its pointers met at two offsets")
                false
            end else joined end
        end
        end

    (* Computes, to a fixed point over reachable blocks, which values point
     * into live origins' objects and which origins belong to the same group *)
    let pointers(s: State): Ok =
        begin
            let f = s.f
            let nBlocks = vector.length(f.blocks)
            let n = extent s.parent
            for v = 0 upto {extent s.ptr - 1} do s.ptr[v] := ~1 end
            for a = 0 upto {n - 1} do s.parent[a] := a end
            for a = 0 upto {n - 1} do
                if not(s.dead[a]) then
                    begin s.ptr[vector.get(s.originValue a)] := a s.off[vector.get(s.originValue a)] := 0 end
                end
            end
            let var changed = true
            while changed do
                changed := false
                (* Finds block parameters that may be group pointers: those to
                 * which every taken incoming edge passes a live pointer or
                 * another candidate parameter. This starts optimistically with
                 * every parameter of a reachable target and removes any that
                 * fail, so mutually recursive loop-carried parameters are found
                 * together. *)
                let candidate = array of(extent s.ptr false)
                (* Caches each reachable block's taken outgoing edges at the
                 * start of the round; any edge folded away by a newly
                 * discovered pointer is dropped in the next round *)
                let taken = array of(nBlocks array of :ssa.Target end)
                for b = 0 upto {nBlocks - 1} do
                    if s.reach[b] then taken[b] := takenTargets(s ssa.block(f b).term) end
                end
                for b = 0 upto {nBlocks - 1} do
                    if s.reach[b] then
                        let ts = taken[b]
                        for k = 0 upto {extent ts - 1} do
                            let params = ssa.block(f ts[k].block).params
                            for j = 0 upto {vector.length(params) - 1} do candidate[vector.get(params j)] := true end
                        end
                    end
                end
                let var dropped = true
                while dropped do
                    dropped := false
                    for b = 0 upto {nBlocks - 1} do
                        if s.reach[b] then
                            let ts = taken[b]
                            for k = 0 upto {extent ts - 1} do
                                let t = ts[k]
                                let params = ssa.block(f t.block).params
                                for j = 0 upto {extent t.args - 1} do
                                    let p = vector.get(params j)
                                    let v = t.args[j]
                                    if candidate[p] andif not(live(s v)) andif not(candidate[v]) then
                                        begin candidate[p] := false dropped := true end
                                    end
                                end
                            end
                        end
                    end
                end
                for b = 0 upto {nBlocks - 1} do
                    if s.reach[b] then
                        let blk = ssa.block(f b)
                        for k = 0 upto {vector.length(blk.insts) - 1} do
                            let i = vector.get(blk.insts k)
                            if ssa.isOp(i ssa.opPtrAdd) then
                                let p = i.args[0]
                                if live(s p) andif s.d.isConst[i.args[1]] andif {s.originOf[i.results[0]] < 0} then
                                    if setPointer(s i.results[0] s.ptr[p] {s.off[p] + s.d.constant[i.args[1]]}) then
                                        changed := true
                                    end
                                end
                            elsif ssa.isOp(i ssa.opUnproxy) then
                                let p = i.args[0]
                                if live(s p) then
                                    if setPointer(s i.results[0] s.ptr[p] s.off[p]) then changed := true end
                                end
                            elsif ssa.isOp(i ssa.opLoad) andif live(s i.args[0]) then
                                (* A word that the group's allocations store
                                 * pointers in holds a pointer of theirs *)
                                let p = i.args[0]
                                let w = proxyFold.wordOf(s.off[p] i.imm i.width)
                                if w >= 0 then
                                    let g = find(s s.ptr[p])
                                    for a = 0 upto {n - 1} do
                                        if not(s.dead[a]) andif {find(s a) is g} andif not(vector.get(s.originDatum a))
                                                andif {w < vector.get(s.originWords a)} then
                                            let v = vector.get(s.stores a)[w]
                                            if live(s v) then
                                                if setPointer(s i.results[0] s.ptr[v] s.off[v]) then changed := true end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                (* A parameter that may be a pointer joins the groups of the
                 * pointers it is bound to; one bound only to others like it
                 * gets its group from them, a round later if need be *)
                for b = 0 upto {nBlocks - 1} do
                    if s.reach[b] then
                        let ts = taken[b]
                        for k = 0 upto {extent ts - 1} do
                            let t = ts[k]
                            let params = ssa.block(f t.block).params
                            for j = 0 upto {extent t.args - 1} do
                                let p = vector.get(params j)
                                let v = t.args[j]
                                if candidate[p] andif live(s v) then
                                    if setPointer(s p s.ptr[v] s.off[v]) then changed := true end
                                end
                            end
                        end
                    end
                end
            end
        end

    (* Kills the groups whose pointers are used other than to read their words,
     * initialize them, make other pointers, be tested for being proxies, and
     * be passed to block parameters of their own *)
    let check(s: State): Ok =
        begin
            let f = s.f
            let nBlocks = vector.length(f.blocks)
            let onlyProxyTests(v: Int): Bool = proxyFold.onlyProxyTests(f s.reach v fun(r: Int): Bool isProxyTest(s r))
            for b = 0 upto {nBlocks - 1} do
                if s.reach[b] then
                    let blk = ssa.block(f b)
                    for k = 0 upto {vector.length(blk.insts) - 1} do
                        let i = vector.get(blk.insts k)
                        for j = 0 upto {extent i.args - 1} do
                            let v = i.args[j]
                            if live(s v) then
                                let a = s.ptr[v]
                                if ssa.isOp(i ssa.opLoad) andif {j is 0} then
                                    if proxyFold.wordOf(s.off[v] i.imm i.width) < 0 then
                                        killGroup(s a "read other than by words")
                                    end
                                elsif ssa.isOp(i ssa.opStore) andif {j is 0} then
                                    (* Only an allocation's initializing
                                     * stores *)
                                    let e = s.exact[v]
                                    let w = proxyFold.wordOf(s.exactOff[v] i.imm i.width)
                                    let initializes = {e >= 0} andif {w >= 0}
                                        andif {w < extent vector.get(:Array(Int) s.stores e)}
                                        andif {vector.get(s.stores e)[w] is i.args[1]}
                                        andif {s.d.defBlock[vector.get(s.originValue e)] is b}
                                    if not(initializes) then killGroup(s a "stored to") end
                                elsif ssa.isOp(i ssa.opStore) andif {j is 1} then
                                    (* Into another of the groups' objects, as
                                     * it is initialized *)
                                    if not(live(s i.args[0])) orif {s.exact[i.args[0]] < 0} then
                                        killGroup(s a "stored")
                                    end
                                elsif ssa.isOp(i ssa.opUnproxy) then
                                    ok
                                elsif ssa.isOp(i ssa.opPtrAdd) andif {j is 0} andif s.d.isConst[i.args[1]] then
                                    (* A constant's address plus an offset
                                     * is another constant's, which needs
                                     * the address if it is left *)
                                    let o = s.originOf[i.results[0]]
                                    if {o >= 0} andif s.dead[o] then killGroup(s a "makes a constant left as it is")
                                    end
                                elsif ssa.isOp(i ssa.opPtrToInt) then
                                    if not(onlyProxyTests(i.results[0])) then
                                        killGroup(s a "converted to an integer")
                                    end
                                elsif ssa.isCall(i) andif proxyFold.isBarrier(i.symbol) then
                                    ok
                                elsif ssa.isCall(i) then
                                    killGroup(s a "passed to " <> i.symbol)
                                else
                                    killGroup(s a "used by " <> ssa.opcodeName(i.op))
                                end
                            end
                        end
                    end
                    let ts = takenTargets(s blk.term)
                    for k = 0 upto {extent ts - 1} do
                        let t = ts[k]
                        let params = ssa.block(f t.block).params
                        for j = 0 upto {extent t.args - 1} do
                            let v = t.args[j]
                            let p = vector.get(params j)
                            if live(s v) then
                                if not(live(s p)) orif {find(s s.ptr[p]) isnot find(s s.ptr[v])}
                                        orif {s.off[p] isnot s.off[v]} then
                                    killGroup(s s.ptr[v] "passed to a parameter bound to other values")
                                end
                            elsif live(s p) then
                                (* p is bound to a non-live value (such as a
                                 * parameter in a cycle with no origin), which
                                 * is impossible on paths from entry but
                                 * checked here so the optimistic candidate
                                 * analysis stays sound *)
                                killGroup(s s.ptr[p] "a parameter bound to other values")
                            end
                        end
                    end
                    let other(uses: Array(Int) reason: String): Ok =
                        for j = 0 upto {extent uses - 1} do
                            if live(s uses[j]) then killGroup(s s.ptr[uses[j]] reason) end
                        end
                    case blk.term
                        when termBranch with x then other(array of x.cond end "used by a branch")
                        when termSwitch with x then other(array of x.value end "used by a switch")
                        when termReturn with x then other(x.values "returned")
                        when termTailCall with x then other(x.call.args "passed to " <> x.call.symbol)
                        when termNone, termJump, termTry, termUnreachable then ok
                    end
                end
            end
        end

    (* ======================================================================
     * Layouts
     * ====================================================================== *)

    (* A group's words: each one's kind, and its type code (a value's) or
     * group and offset (a nested object's) *)
    Let Layout = Tuple
        kind: Array(Int)
        code: Array(Int)
        group: Array(Int)
        offset: Array(Int)
        var valid: Bool
    end

    let newLayout(n: Int): Layout =
        tuple
            let kind = array of(n wordNone)
            let code = array of(n 0)
            let group = array of(n ~1)
            let offset = array of(n 0)
            let var valid = true
        end

    (* Adds what one member or load says of word w *)
    let note(l: Layout w: Int kind: Int code: Int group: Int offset: Int): Ok =
        if l.kind[w] is wordNone then begin
            l.kind[w] := kind l.code[w] := code l.group[w] := group l.offset[w] := offset
        end
        elsif {l.kind[w] isnot kind} orif {{kind is wordScalar} andif {l.code[w] isnot code}}
                orif {{kind is wordNested} andif {{l.group[w] isnot group} orif {l.offset[w] isnot offset}}} then
            l.valid := false
        end

    (* The layouts of the live groups, by their roots *)
    let layouts(s: State): maps.IntMap(Layout) =
        begin
            let f = s.f
            let n = extent s.parent
            let size = maps.newIntMap(:Int)
            let grow(g: Int words: Int): Ok =
                if words > maybe.unwrapOr(hashMap.get(size g) 0) then hashMap.insert(size g words) end
            for a = 0 upto {n - 1} do
                if not(s.dead[a]) then
                    grow(find(s a) if vector.get(s.originDatum a) then 0 else vector.get(s.originWords a) end)
                end
            end
            let nBlocks = vector.length(f.blocks)
            for b = 0 upto {nBlocks - 1} do
                if s.reach[b] then
                    let blk = ssa.block(f b)
                    for k = 0 upto {vector.length(blk.insts) - 1} do
                        let i = vector.get(blk.insts k)
                        if ssa.isOp(i ssa.opLoad) andif live(s i.args[0]) then
                            let w = proxyFold.wordOf(s.off[i.args[0]] i.imm i.width)
                            if w >= 0 then grow(find(s s.ptr[i.args[0]]) w + 1) end
                        end
                    end
                end
            end
            let result = maps.newIntMap(:Layout)
            for a = 0 upto {n - 1} do
                let g = find(s a)
                if not(s.dead[a]) andif not(hashMap.contains(result g)) then
                    hashMap.insert(result g newLayout(maybe.unwrapOr(hashMap.get(size g) 0)))
                end
            end
            let valueNote(l: Layout w: Int v: Int): Ok =
                if live(s v) then note(l w wordNested 0 find(s s.ptr[v]) s.off[v])
                else note(l w wordScalar ssa.typeCode(ssa.typeOf(f v)) ~1 0)
                end
            for a = 0 upto {n - 1} do
                if not(s.dead[a]) then
                    let l = hashMap.find(result find(s a))
                    if vector.get(s.originDatum a) then
                        let ws = vector.get(s.originData a)
                        for w = 0 upto {extent l.kind - 1} do
                            if w < extent ws then
                                case ws[w]
                                    when wordInt then note(l w wordScalar 0 ~1 0)
                                    when wordSymbol then note(l w wordScalar 1 ~1 0)
                                end
                            end
                        end
                    else
                        let ws = vector.get(s.stores a)
                        for w = 0 upto {extent ws - 1} do if ws[w] >= 0 then valueNote(l w ws[w]) end end
                    end
                end
            end
            for b = 0 upto {nBlocks - 1} do
                if s.reach[b] then
                    let blk = ssa.block(f b)
                    for k = 0 upto {vector.length(blk.insts) - 1} do
                        let i = vector.get(blk.insts k)
                        if ssa.isOp(i ssa.opLoad) andif live(s i.args[0]) then
                            let w = proxyFold.wordOf(s.off[i.args[0]] i.imm i.width)
                            if w >= 0 then valueNote(hashMap.find(result find(s s.ptr[i.args[0]])) w i.results[0]) end
                        end
                    end
                end
            end
            result
        end

    (* Returns the number of scalar values that replace an object in group g
     * (recursing into nested groups), or ~1 if a group nests inside itself *)
    let rec leafCount(ls: maps.IntMap(Layout) g: Int visiting: maps.IntSet): Int =
        if hashSet.contains(visiting g) then ~1
        else begin
            let ignored = hashSet.insert(visiting g)
            let l = hashMap.find(ls g)
            let var n = 0
            for w = 0 upto {extent l.kind - 1} do
                if n >= 0 then
                    if l.kind[w] is wordScalar then n := n + 1
                    elsif l.kind[w] is wordNested then
                        let m = if hashMap.contains(ls l.group[w]) then leafCount(ls l.group[w] visiting)
                            else ~1 end
                        n := if m < 0 then ~1 else n + m end
                    end
                end
            end
            hashSet.delete(visiting g)
            n
        end
        end

    (* The analysis: the origins replaced are those left alive *)
    let solve(u: ssa.Unit f: Function): State =
        begin
            let s = newState(u f)
            let n = extent s.parent
            let nBlocks = vector.length(f.blocks)
            let countDead(): Int =
                begin
                    let var c = 0
                    for a = 0 upto {n - 1} do if s.dead[a] then c := c + 1 end end
                    c
                end
            let var before = ~1
            while {n > 0} andif {before isnot countDead()} do
                before := countDead()
                proxyFold.settle(s.d s.reach fun(): Ok pointers(s) fun(v: Int): Bool isProxyTest(s v))
                check(s)
                if countDead() is before then
                    let ls = layouts(s)
                    for a = 0 upto {n - 1} do
                        let g = find(s a)
                        if not(s.dead[a]) then
                            let l = hashMap.find(ls g)
                            if not(l.valid) then kill(s a "its objects' words differ")
                            elsif leafCount(ls g maps.newIntSet()) < 0 then
                                kill(s a "it holds a pointer of its own group")
                            end
                        end
                    end
                end
            end
            s
        end

    let analyze(u: ssa.Unit f: Function): Array(Verdict) =
        begin
            let s = solve(u f)
            let n = extent s.parent
            let verdicts = array of(n tuple let value = 0 let constant = false let left = false let reason = "" end)
            for a = 0 upto {n - 1} do
                verdicts[a] := tuple
                    let value = vector.get(s.originValue a)
                    let constant = vector.get(s.originDatum a)
                    let left = s.dead[a]
                    let reason = s.reasons[a]
                end
            end
            verdicts
        end

    (* ======================================================================
     * Replacement
     * ====================================================================== *)

    (* The types of a group's values, in order *)
    let rec leafTypes(ls: maps.IntMap(Layout) g: Int into: vector.T(ssa.Type)): Ok =
        begin
            let l = hashMap.find(ls g)
            for w = 0 upto {extent l.kind - 1} do
                if l.kind[w] is wordScalar then vector.append(into ssa.typeOfCode(l.code[w]))
                elsif l.kind[w] is wordNested then leafTypes(ls l.group[w] into)
                end
            end
        end

    (* The index of word w's first value among its group's *)
    let leafStart(ls: maps.IntMap(Layout) g: Int w: Int): Int =
        begin
            let l = hashMap.find(ls g)
            let var n = 0
            for k = 0 upto {w - 1} do
                if l.kind[k] is wordScalar then n := n + 1
                elsif l.kind[k] is wordNested then
                    n := n + leafCount(ls l.group[k] maps.newIntSet())
                end
            end
            n
        end

    let slice(vs: Array(Int) start: Int n: Int): Array(Int) =
        begin
            let r = array of(n 0)
            for k = 0 upto {n - 1} do r[k] := vs[start + k] end
            r
        end

    let replaceFunction(u: ssa.Unit f: Function): Int =
        begin
            (* The dead parameters go first: promotion leaves them where a
             * variable's slot is live across a loop its value is not (the
             * last of a loop's tuples, carried round an outer loop from a null
             * at the entry); bound to a pointer and to other values, they
             * would keep the pointer's objects whole *)
            let ignored = blockParams.dropDeadParams(f)
            let s = solve(u f)
            let n = extent s.parent
            let var replaced = 0
            for a = 0 upto {n - 1} do if not(s.dead[a]) then replaced := replaced + 1 end end
            if replaced > 0 then
                let ls = layouts(s)
                let nValues = extent s.ptr
                let nBlocks = vector.length(f.blocks)
                let isPointer(v: Int): Bool = {v < nValues} andif live(s v)
                let groupOf(v: Int): Int = find(s s.ptr[v])
                let countOf(g: Int): Int = leafCount(ls g maps.newIntSet())
                (* Maps each replaced object's base pointer (base[v]) to its
                 * flattened scalar values, and maps each replaced load result
                 * (renamed[v]) to its replacement value *)
                let values = maps.newIntMap(:Array(Int))
                let base = array of(nValues ~1)
                let renamed = array of(nValues ~1)
                let rec resolve(v: Int): Int =
                    if {v < nValues} andif {renamed[v] >= 0} then resolve(renamed[v]) else v end
                let valuesOf(v: Int): Array(Int) = hashMap.find(values base[v])
                let proxyTest = array of(nValues false)
                for v = 0 upto {nValues - 1} do proxyTest[v] := isProxyTest(s v) end
                (* The parameters: each pointer one becomes its object's
                 * values *)
                let oldParams = array of(nBlocks array of :Int end)
                for b = 0 upto {nBlocks - 1} do
                    let params = ssa.block(f b).params
                    oldParams[b] := vector.toArray(params)
                    if s.reach[b] then
                        vector.clear(params)
                        for j = 0 upto {extent oldParams[b] - 1} do
                            let p = oldParams[b][j]
                            if isPointer(p) then
                                let types = vector.new(:ssa.Type)
                                leafTypes(ls groupOf(p) types)
                                let vs = array of(vector.length(types) 0)
                                for k = 0 upto {extent vs - 1} do
                                    vs[k] := ssa.newValue(f vector.get(types k))
                                    vector.append(params vs[k])
                                end
                                base[p] := p
                                hashMap.insert(values p vs)
                                ok
                            else
                                vector.append(params p)
                            end
                        end
                    end
                end
                (* An object's values from its words: an allocation's stored
                 * values and zeros, a constant's words *)
                let made = fun(o: Int insts: vector.T(ssa.Inst) loc: ssa.Loc): Ok
                    begin
                        let v = vector.get(s.originValue o)
                        let g = find(s o)
                        let l = hashMap.find(ls g)
                        let result = vector.new(:Int)
                        let zeros = fun(h: Int): Ok
                            begin
                                let types = vector.new(:ssa.Type)
                                leafTypes(ls h types)
                                for k = 0 upto {vector.length(types) - 1} do
                                    vector.append(result proxyFold.zeroOf(f insts vector.get(types k) loc))
                                end
                            end
                        let datum = vector.get(s.originDatum o)
                        let ws = vector.get(s.originData o)
                        let stored = vector.get(s.stores o)
                        for w = 0 upto {extent l.kind - 1} do
                            if l.kind[w] is wordScalar then
                                let t = ssa.typeOfCode(l.code[w])
                                if datum andif {w < extent ws} then
                                    let r = ssa.newValue(f t)
                                    let i =
                                        case ws[w]
                                            when wordInt with x then
                                                ssa.instruction(ssa.opConst array of :Int end array of r end x.n "" 0
                                                        false
                                                        ssa.emptySignature)
                                            when wordSymbol with x then
                                                ssa.instruction(ssa.opSymbol array of :Int end array of r end x.addend
                                                        x.symbol 0
                                                        false ssa.emptySignature)
                                        end
                                    i.loc := loc
                                    vector.append(insts i)
                                    vector.append(result r)
                                elsif not(datum) andif {w < extent stored} andif {stored[w] >= 0} then
                                    vector.append(result stored[w])
                                else
                                    vector.append(result proxyFold.zeroOf(f insts t loc))
                                end
                            elsif l.kind[w] is wordNested then
                                if not(datum) andif {w < extent stored} andif {stored[w] >= 0} then
                                    let nested = valuesOf(stored[w])
                                    for k = 0 upto {extent nested - 1} do vector.append(result nested[k]) end
                                else
                                    zeros(l.group[w])
                                end
                            end
                        end
                        base[v] := v
                        hashMap.insert(values v vector.toArray(result))
                        ok
                    end
                (* The base of a pointer derived from v: an allocation's own
                 * value, for a pointer into it, even before its last store
                 * makes its values (made sets base then); else v's base *)
                let baseOf(v: Int): Int = if s.exact[v] >= 0 then vector.get(s.originValue s.exact[v]) else base[v] end
                (* Walks blocks in reverse postorder so each pointer's scalar
                 * values are recorded before any dominated block uses them;
                 * block parameters were recorded above to handle loop back
                 * edges *)
                let g = cfg.graph(f)
                for r = 0 upto {extent g.order - 1} do
                    let b = g.order[r]
                    if s.reach[b] then
                        let blk = ssa.block(f b)
                        let kept = vector.new(:ssa.Inst)
                        for k = 0 upto {vector.length(blk.insts) - 1} do
                            let i = vector.get(blk.insts k)
                            let result = if extent i.results > 0 then i.results[0] else ~1 end
                            let origin = if result >= 0 then s.originOf[result] else ~1 end
                            if {origin >= 0} andif not(s.dead[origin]) then
                                (* An allocation's values are its stores',
                                 * known after the last of them *)
                                if vector.get(s.originDatum origin) orif {vector.get(s.lastStore origin) is k} then
                                    made(origin kept i.loc)
                                end
                            elsif ssa.isOp(i ssa.opStore) andif isPointer(i.args[0]) then
                                let a = s.exact[i.args[0]]
                                if vector.get(s.lastStore a) is k then made(a kept i.loc) end
                            elsif ssa.isOp(i ssa.opPtrAdd) andif isPointer(i.args[0])
                                    andif {s.originOf[result] < 0} then
                                base[result] := baseOf(i.args[0])
                            elsif ssa.isOp(i ssa.opUnproxy) andif isPointer(i.args[0]) then
                                base[result] := baseOf(i.args[0])
                            elsif ssa.isOp(i ssa.opLoad) andif isPointer(i.args[0]) then
                                let p = i.args[0]
                                let w = proxyFold.wordOf(s.off[p] i.imm i.width)
                                let start = leafStart(ls groupOf(p) w)
                                let vs = valuesOf(p)
                                if isPointer(result) then
                                    base[result] := result
                                    hashMap.insert(values result
                                            slice(vs start countOf(groupOf(result))))
                                    ok
                                else
                                    renamed[result] := vs[start]
                                end
                            elsif ssa.isOp(i ssa.opPtrToInt) andif isPointer(i.args[0]) then
                                ok
                            elsif ssa.isCall(i) andif proxyFold.isBarrier(i.symbol) andif isPointer(i.args[0]) then
                                ok
                            elsif {result >= 0} andif proxyTest[result] then
                                let zero = ssa.instruction(ssa.opConst array of :Int end i.results 0 "" 0 false
                                        ssa.emptySignature)
                                zero.loc := i.loc
                                vector.append(kept zero)
                            else
                                vector.append(kept i)
                            end
                        end
                        vector.clear(blk.insts)
                        for k = 0 upto {vector.length(kept) - 1} do
                            vector.append(blk.insts vector.get(kept k))
                        end
                        case blk.term
                            when termBranch with x then
                                if {x.cond < nValues} andif proxyTest[x.cond] then
                                    blk.term := option termJump of ssa.Terminator with let target = x.ifFalse end
                                end
                            when termNone, termJump, termSwitch, termReturn, termTailCall, termTry, termUnreachable then
                                ok
                        end
                    end
                end
                (* Each edge passes a pointer's values for its parameter's *)
                for b = 0 upto {nBlocks - 1} do
                    if s.reach[b] then
                        let ts = ssa.targets(ssa.block(f b).term)
                        for k = 0 upto {extent ts - 1} do
                            let t = ts[k]
                            let params = oldParams[t.block]
                            let args = vector.new(:Int)
                            for j = 0 upto {extent t.args - 1} do
                                if isPointer(params[j]) then
                                    let vs = valuesOf(t.args[j])
                                    for x = 0 upto {extent vs - 1} do vector.append(args vs[x]) end
                                else
                                    vector.append(args t.args[j])
                                end
                            end
                            t.args := vector.toArray(args)
                        end
                    end
                end
                ssa.replaceUses(f resolve)
                cfg.dropUnreached(f)
            end
            replaced
        end

    let replaceUnit(u: ssa.Unit): Int =
        begin
            let var count = 0
            for i = 0 upto {vector.length(u.functions) - 1} do
                count := count + replaceFunction(u vector.get(u.functions i))
            end
            count
        end
end
