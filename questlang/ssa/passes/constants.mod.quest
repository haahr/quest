(* Quest Self-Hosted Compiler: The SSA's Constant Globals Implementation *)

module constants : Constants
import
    conv : Conv
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/common/maps : questlang/common/Maps
    questlang/ssa/cfg : questlang/ssa/CFG
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/ssa/runtimeFunctions : questlang/ssa/RuntimeFunctions
export
    Let Function = ssa.Function
    Let Defs = Array(maybe.T(ssa.Inst))

    (* An instruction's place: its function, block, and index in the block *)
    Let Site = Tuple function: Int block: Int index: Int end

    (* A global that may be constant: its datum's index in the unit's data,
     * whether a use rules it out, the stores to it (the one store's site and
     * value when there is one), and its loads' sites *)
    Let Candidate = Tuple
        datum: Int
        var ruledOut: Bool
        var stores: Int
        var store: Site
        var value: ssa.Word
        loads: vector.T(Site)
    end

    let siteKey(s: Site): String = conv.int(s.function) <> " " <> conv.int(s.block) <> " " <> conv.int(s.index)

    (* The opSymbol instruction that defines v (giving its symbol and offset),
     * or none if v is not defined by opSymbol *)
    let symbolOf(defs: Defs v: Int): maybe.T(ssa.Inst) =
        if maybe.isSome(defs[v]) andif ssa.isOp(maybe.unwrap(defs[v]) ssa.opSymbol) then defs[v]
        else maybe.none()
        end

    (* Runtime functions that write memory without running Quest code: module
     * startup registration helpers (for types, functions, record dictionaries,
     * GC roots, and stack frame tables; docs/collector.md section 3.8) and GC
     * write barriers (section 3.5), which only record modified objects or
     * slots for the collector *)
    let registrations = array of
        "quest_register_abstract_type" "quest_register_funcs" "quest_register_record_dict" "quest_register_roots"
        "quest_register_frames" "quest_barrier" "quest_barrier_slot"
    end

    (* Whether symbol is a module's initialization, which the builder names
     * qv_mod_<module>_init *)
    let initialization(symbol: String): Bool =
        strutil.startsWith(symbol "qv_mod_") andif strutil.endsWith(symbol "_init")

    (* What deciding whether code could read a global needs: the unit, the
     * definitions of each of its functions' values, its functions by symbol,
     * the global's symbol, the function storing it, and the functions already
     * seen, by index *)
    Let Query = Tuple
        u: ssa.Unit
        allDefs: Array(Defs)
        byName: maps.StringMap(Int)
        symbol: String
        storing: Int
        seen: Array(Bool)
    end

    (* True if executing instruction i of function fi could read the candidate
     * global, either directly via a load or through a call. Indirect calls and
     * recursive calls to the storing function are conservatively treated as
     * reading it. Calls to other functions in the same unit are inspected
     * recursively, while calls from one module initializer to another cannot
     * reach the storing module's code because module imports are acyclic
     * (enforced by detectModuleCycle). External runtime calls are safe only if
     * they are listed in registrations or do not write memory
     * (runtimeFunctions.callWrites assumes any call that can run Quest code
     * writes memory). *)
    let rec reads(q: Query fi: Int i: ssa.Inst): Bool =
        if ssa.isOp(i ssa.opLoad) then
            let a = symbolOf(q.allDefs[fi] i.args[0])
            maybe.isSome(a) andif stringOp.equal(maybe.unwrap(a).symbol q.symbol)
        elsif ssa.isOp(i ssa.opCallIndirect) then
            true
        elsif ssa.isCall(i) then
            let callee = hashMap.get(q.byName i.symbol)
            let storing = vector.get(q.u.functions q.storing).symbol
            if stringOp.equal(i.symbol storing) then true
            elsif initialization(i.symbol) andif initialization(storing) then false
            elsif maybe.isSome(callee) then functionReads(q maybe.unwrap(callee))
            else
                let var registration = false
                for k = 0 upto {extent registrations - 1} do
                    if stringOp.equal(registrations[k] i.symbol) then registration := true end
                end
                not(registration) andif runtimeFunctions.callWrites(i)
            end
        else
            false
        end

    (* True if executing function fi could read the candidate global. Already
     * visited functions return false so cycles terminate; their result is
     * already included in the enclosing traversal. *)
    and functionReads(q: Query fi: Int): Bool =
        if q.seen[fi] then
            false
        else
            q.seen[fi] := true
            let f = vector.get(q.u.functions fi)
            let var any = false
            for b = 0 upto {vector.length(f.blocks) - 1} do
                let blk = ssa.block(f b)
                for k = 0 upto {vector.length(blk.insts) - 1} do
                    if not(any) andif reads(q fi vector.get(blk.insts k)) then any := true end
                end
                case blk.term
                    when termTailCall with x then
                        if not(any) andif reads(q fi x.call) then any := true end
                    when termNone, termJump, termBranch, termSwitch, termReturn, termTry, termUnreachable then ok
                end
            end
            any
        end

    (* True if no instruction that could read the global (according to reads)
     * can run before the store at site s in function f (with control-flow
     * graph g). The backward walk checks instructions before s in its block
     * and all reachable predecessor blocks, and rejects s if its block can
     * reach itself in a loop. *)
    let first(q: Query f: Function g: cfg.Graph s: Site): Bool =
        begin
            let blockReads(b: Int before: Int): Bool =
                begin
                    let insts = ssa.block(f b).insts
                    let var any = false
                    for k = 0 upto {before - 1} do
                        if not(any) andif reads(q s.function vector.get(insts k)) then any := true end
                    end
                    any
                end
            let var clear = not(blockReads(s.block s.index))
            (* The blocks from which s's block can be reached *)
            let seen = array of(vector.length(f.blocks) false)
            let stack = vector.new(:Int)
            vector.append(stack s.block)
            while not(vector.empty(stack)) do
                let b = vector.pop(stack)
                let ps = g.preds[b]
                for k = 0 upto {extent ps - 1} do
                    let p = ps[k]
                    if p is s.block then clear := false
                    elsif clear andif not(seen[p]) andif cfg.reached(g p) then
                        seen[p] := true
                        if blockReads(p vector.length(ssa.block(f p).insts)) then clear := false end
                        vector.append(stack p)
                    end
                end
            end
            clear
        end

    (* The value a store of v stores, as a word of static data, if an
     * opConst or an opSymbol defines v *)
    let wordOf(defs: Defs v: Int): maybe.T(ssa.Word) =
        if maybe.isNone(defs[v]) then
            maybe.none()
        else
            let i = maybe.unwrap(defs[v])
            if ssa.isOp(i ssa.opConst) then maybe.some(option wordInt of ssa.Word with let n = i.imm end)
            elsif ssa.isOp(i ssa.opSymbol) then
                maybe.some(option wordSymbol of ssa.Word with let symbol = i.symbol let addend = i.imm end)
            else maybe.none()
            end
        end

    (* The instruction a load of a constant global becomes: the value w as
     * result, at the load's position *)
    let valueInst(w: ssa.Word result: Int loc: ssa.Loc): ssa.Inst =
        begin
            let i =
                case w
                    when wordInt with x then
                        ssa.instruction(ssa.opConst array of :Int end array of result end x.n "" 0
                                false ssa.emptySignature)
                    when wordSymbol with x then
                        ssa.instruction(ssa.opSymbol array of :Int end array of result end x.addend x.symbol 0 false
                                ssa.emptySignature)
                end
            i.loc := loc
            i
        end

    (* True if a load of type t can be replaced directly by the static word w *)
    let typeFits(w: ssa.Word t: ssa.Type): Bool =
        case w
            when wordInt then stringOp.equal(ssa.typeName(t) "int")
            when wordSymbol then stringOp.equal(ssa.typeName(t) "ptr")
        end

    (* True if candidate c (the global named symbol) is constant: not ruled
     * out, stored once, loaded only with a type matching its stored word, and
     * preceded by nothing that could read it (checked by first). Control-flow
     * graphs in graphs are built lazily on first use. *)
    let constant(u: ssa.Unit allDefs: Array(Defs) byName: maps.StringMap(Int) graphs: Array(maybe.T(cfg.Graph))
            symbol: String c: Candidate): Bool =
        begin
            let var fits = not(c.ruledOut) andif {c.stores is 1}
            for k = 0 upto {vector.length(c.loads) - 1} do
                let s = vector.get(c.loads k)
                let f = vector.get(u.functions s.function)
                let i = vector.get(ssa.block(f s.block).insts s.index)
                if not(typeFits(c.value ssa.typeOf(f i.results[0]))) then fits := false end
            end
            if fits then
                let fi = c.store.function
                let f = vector.get(u.functions fi)
                if maybe.isNone(graphs[fi]) then graphs[fi] := maybe.some(cfg.graph(f)) end
                let q = tuple
                    let u = u
                    let allDefs = allDefs
                    let byName = byName
                    let symbol = symbol
                    let storing = fi
                    let seen = array of(vector.length(u.functions) false)
                end
                first(q f maybe.unwrap(graphs[fi]) c.store)
            else
                false
            end
        end

    let constantUnit(u: ssa.Unit): Ok =
        begin
            let candidates = maps.newStringMap(:Candidate)
            for k = 0 upto {vector.length(u.data) - 1} do
                let d = vector.get(u.data k)
                let zeroWord = case d.contents when contentsZero with x then x.bytes is 8 else false end
                if not(d.exported) andif d.writable andif zeroWord then
                    let c = tuple
                        let datum = k
                        let var ruledOut = false
                        let var stores = 0
                        let var store = tuple let function = ~1 let block = ~1 let index = ~1 end
                        let var value = option wordInt of ssa.Word with let n = 0 end
                        let loads = vector.new(:Site)
                    end
                    let ignored = hashMap.insert(candidates d.symbol c)
                end
            end
            let nFunctions = vector.length(u.functions)
            let allDefs = array of(nFunctions array of :maybe.T(ssa.Inst) end)
            (* Inspect every use of each candidate's address: record 8-byte
             * loads and constant stores at offset 0, and rule out any other
             * use *)
            for fi = 0 upto {nFunctions - 1} do
                let f = vector.get(u.functions fi)
                let defs = ssa.definitions(f)
                allDefs[fi] := defs
                let candidateAt(v: Int): maybe.T(Candidate) =
                    begin
                        let a = symbolOf(defs v)
                        if maybe.isSome(a) then
                            let c = hashMap.get(candidates maybe.unwrap(a).symbol)
                            if maybe.isSome(c) andif {maybe.unwrap(a).imm isnot 0} then
                                maybe.unwrap(c).ruledOut := true
                            end
                            c
                        else
                            maybe.none()
                        end
                    end
                for b = 0 upto {vector.length(f.blocks) - 1} do
                    let blk = ssa.block(f b)
                    for k = 0 upto {vector.length(blk.insts) - 1} do
                        let i = vector.get(blk.insts k)
                        let site = tuple let function = fi let block = b let index = k end
                        for p = 0 upto {extent i.args - 1} do
                            let found = candidateAt(i.args[p])
                            if maybe.isSome(found) then
                                let c = maybe.unwrap(found)
                                let word = {p is 0} andif {i.imm is 0} andif {i.width is 8}
                                if word andif ssa.isOp(i ssa.opLoad) then vector.append(c.loads site)
                                elsif word andif ssa.isOp(i ssa.opStore) then
                                    c.stores := c.stores + 1
                                    c.store := site
                                    let w = wordOf(defs i.args[1])
                                    if maybe.isSome(w) then c.value := maybe.unwrap(w)
                                    else c.ruledOut := true
                                    end
                                else c.ruledOut := true
                                end
                            end
                        end
                    end
                    let uses = ssa.terminatorUses(blk.term)
                    for p = 0 upto {extent uses - 1} do
                        let found = candidateAt(uses[p])
                        if maybe.isSome(found) then maybe.unwrap(found).ruledOut := true end
                    end
                end
            end
            (* Promote each constant global by replacing its loads, marking its
             * store for removal, and making its static datum read-only *)
            let graphs = array of(nFunctions maybe.none(:cfg.Graph))
            let byName = maps.newStringMap(:Int)
            for fi = 0 upto {nFunctions - 1} do
                let ignored = hashMap.insert(byName vector.get(u.functions fi).symbol fi)
            end
            let dropped = maps.newStringMap(:Bool)
            for e = 0 upto {vector.length(u.data) - 1} do
                let symbol = vector.get(u.data e).symbol
                let found = hashMap.get(candidates symbol)
                if maybe.isSome(found) andif constant(u allDefs byName graphs symbol maybe.unwrap(found)) then
                    let c = maybe.unwrap(found)
                    for k = 0 upto {vector.length(c.loads) - 1} do
                        let s = vector.get(c.loads k)
                        let insts = ssa.block(vector.get(u.functions s.function) s.block).insts
                        let i = vector.get(insts s.index)
                        vector.set(insts s.index valueInst(c.value i.results[0] i.loc))
                    end
                    let ignored = hashMap.insert(dropped siteKey(c.store) true)
                    vector.set(u.data c.datum ssa.words(symbol false false array of c.value end))
                end
            end
            (* Remove all dropped stores in a final pass per block so that
             * earlier instruction indices in Site records stay valid *)
            if not(hashMap.empty(dropped)) then
                for fi = 0 upto {nFunctions - 1} do
                    let f = vector.get(u.functions fi)
                    for b = 0 upto {vector.length(f.blocks) - 1} do
                        let insts = ssa.block(f b).insts
                        let kept = vector.new(:ssa.Inst)
                        for k = 0 upto {vector.length(insts) - 1} do
                            let site = tuple let function = fi let block = b let index = k end
                            if not(hashMap.contains(dropped siteKey(site))) then
                                vector.append(kept vector.get(insts k))
                            end
                        end
                        if vector.length(kept) isnot vector.length(insts) then
                            vector.clear(insts)
                            for k = 0 upto {vector.length(kept) - 1} do
                                vector.append(insts vector.get(kept k))
                            end
                        end
                    end
                end
            end
        end
end
