(* Quest Self-Hosted Compiler: The SSA's Selects Interface
 *
 * Performs if-conversion, turning simple branches into branchless select
 * instructions (docs/ssa.md section 4.1). When a branch's two arms both lead
 * to the same join block — either directly or through a single-predecessor
 * block that only jumps there — the pass replaces the branch with a jump to
 * the join block, using a select on the branch condition for each argument
 * where the two arms differ.
 *
 * A carry in an arbitrary-precision arithmetic loop (if b then 1 else 0 for
 * an unpredictable b) is a typical case: arm64 lowers a select to a
 * conditional select (csel or cset), avoiding a branch mispredicted half the
 * time (as the C compiler already does). An arm's block may contain up to two
 * speculable instructions — ones that cannot trap or write and read nothing
 * the branch could affect, such as arithmetic, comparisons, or a load of a
 * module global — which are hoisted before the jump. Branches with real-typed
 * differing arguments (which would need arm64's fcsel) or needing more than
 * two selects are left as branches. *)

interface Selects
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    selectFunction(f: ssa.Function): Ok
    selectUnit(u: ssa.Unit): Ok
end
