(* Quest Self-Hosted Compiler: The SSA's Barrier Check Interface
 *
 * This module checks, in the SSA left by the optimization pipeline, the write-
 * barrier rule that keeps the generational garbage collector sound
 * (docs/collector.md section 3.5). After storing a word that may be a heap
 * pointer into an object that a collection may have seen, either the object's
 * barrier (quest_barrier) or the slot's barrier (quest_barrier_slot) must run
 * before the next call that may collect, and before the function returns or
 * tail-calls. A minor collection scans only young objects and the old objects
 * logged by write barriers; a missed barrier can leave a young object
 * reachable only through an unlogged old object, letting the collector free it
 * while still in use.
 *
 * The check covers 8-byte stores of a ptr (other than a symbol's address or
 * null) and of a val created from one via toVal. A val created from an int is
 * not a pointer; any other val (a parameter, load, or call result) may or may
 * not be a pointer depending on a high-level type the SSA does not track, so
 * its stores are left to the builder. The target object is traced back from
 * the store's address through ptrAdd and copy. A store needs no barrier when
 * its target is a stack slot, a global symbol (globals are roots), a
 * thread-local, or null; or when it is a quest_alloc result with no call that
 * may collect on any path since, because the object is still young. A call may
 * collect if it calls a program function, an indirect function pointer, or a
 * runtime function that allocates (ssa/runtimeFunctions). An object barrier
 * satisfies every store into that object so far; a slot barrier satisfies
 * stores to that address. A try's handler starts with nothing owed and no
 * fresh allocations, because control reaches it only by unwinding from a call.
 *
 * This enforces the builder's own rule (ssa/build/values) after passes that
 * move or remove instructions. *)

interface Barriers
import
    questlang/ssa/nodes : questlang/ssa/Nodes
export
    barrierError: Exception(String)
    (* The stores of a function that a barrier does not follow in time, each
     * described; none if it keeps the rule *)
    functionProblems(f: nodes.Function): Array(String)
    (* Raises barrierError, listing the problems, if a function of the unit
     * does not keep the rule *)
    checkUnit(u: nodes.Unit): Ok
end
