(* Quest Self-Hosted Compiler: The SSA's Control Flow Graph Interface
 *
 * A function's blocks as a graph (docs/ssa.md section 4.1), with the facts
 * about it that the passes ask for:
 *
 * - each block's predecessors and successors;
 * - the blocks the entry reaches in reverse postorder, an order in which a
 *   block comes before its successors except along a loop's back edge, so
 *   that a forward pass sees a block's definitions before their uses;
 * - the dominator tree (by Cooper, Harvey, and Kennedy's algorithm). Block a
 *   dominates block b when every path from the entry to b passes through a;
 *   a value defined in a may then be used in b, which is what the verifier
 *   checks. Each block's preorder and postorder numbers in the tree make
 *   "does a dominate b" two comparisons;
 * - on demand, dominance frontiers, where promotion (ssa/promote) puts the
 *   block parameters that merge a variable's values: b's frontier is the
 *   blocks that b does not strictly dominate (dominate and differ from) but
 *   one of whose predecessors it does dominate: the joins where a value
 *   stored in b may meet another;
 * - on demand, loop depths, by which the register allocator and the arm64
 *   block layout estimate how often a block runs.
 *
 * A graph describes the function as it was when it was made; a pass that
 * changes the blocks or their terminators makes it again. *)

interface Cfg
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    Def Graph = Tuple
        (* Each block's predecessors, in order of block (a predecessor once
         * for each edge from it), and successors, as its terminator lists
         * them *)
        preds: Array(Array(Int))
        succs: Array(Array(Int))
        (* The blocks the entry reaches, in reverse postorder, and each
         * block's position in it (~1 for a block not reached) *)
        order: Array(Int)
        rank: Array(Int)
        (* Each reached block's immediate dominator (~1 for the entry and for
         * a block not reached), and its children in the dominator tree, in
         * reverse postorder *)
        idom: Array(Int)
        children: Array(Array(Int))
        (* Each reached block's preorder and postorder numbers in the
         * dominator tree *)
        pre: Array(Int)
        post: Array(Int)
    end

    graph(f: ssa.Function): Graph
    (* The graph of blocks given by each one's successors (a machine
     * function's, say) *)
    graphOf(succs: Array(Array(Int))): Graph
    (* The blocks reached from the first, in reverse postorder, of a graph
     * given by each block's successors (shared with machine functions) *)
    reversePostorder(succs: Array(Array(Int))): Array(Int)
    reached(g: Graph b: Int): Bool
    (* Whether block a dominates block b (both reached): a block dominates
     * itself *)
    dominates(g: Graph a: Int b: Int): Bool
    (* Each block's dominance frontier: the blocks where its dominance ends *)
    frontiers(g: Graph): Array(Array(Int))
    (* Each block's loop depth: the number of natural loops (of back edges to
     * a block that dominates their source) it is in *)
    loopDepths(g: Graph): Array(Int)
    (* Drops the blocks the entry does not reach, renumbering the rest in
     * order, as a pass that makes blocks unreachable must, since their
     * instructions may use values it removed *)
    dropUnreached(f: ssa.Function): Ok
end
