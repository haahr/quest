(* Quest Self-Hosted Compiler: The SSA's Builder Implementation
 *
 * The builder lives in questlang/ssa/build/, layered in dependency order:
 * values (representations, builder state, emitting, variables, atoms, and
 * words), representation (slots, aggregate components, proxies, and
 * allocation), descriptors, calls (primitives, calls, and module members),
 * aggregates (conversions, tuples, records, variants, options, arrays, and
 * type applications), control (operations and statements), adapters (exported
 * functions and function-type adapters), and unit (functions, static data,
 * and the unit) *)

module build : Build
import
    ir = questlang/ir/nodes : questlang/ir/Nodes
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    vals = questlang/ssa/build/values : questlang/ssa/build/Values
    units = questlang/ssa/build/unit : questlang/ssa/build/Unit
export
    let unsupported: Exception(String) = vals.unsupported
    let buildUnit(unit: ir.Unit): ssa.Unit = units.buildUnit(unit)
end
