(* Quest Self-Hosted Compiler: The SSA Builder's Adapters Interface
 *
 * Builds the unit's synthesized functions—those generated from types and
 * interfaces rather than lowered from IR function bodies:
 *
 * - A module file's exported C entry points, which let other compilation units
 *   call its exported function and polymorphic members directly.
 * - For each function type that has a run-time type descriptor, the three
 *   functions the descriptor points to so quest_convert can change a closure's
 *   type at run time (for dynamic.be and values stored at a subtype; see
 *   docs/c-representation.md section 6.4.4, "Functions").
 *
 * A closure's static type fixes its C calling signature (how each argument and
 * result is passed), so a closure used at a different type must be wrapped.
 * The adapter allocates a new closure of the target type whose code is the
 * thunk and whose environment holds the original closure and both type
 * descriptors. The thunk, called at the target signature, converts each
 * argument to the original type, calls the original closure (directly when the
 * two signatures agree, or through the original type's invoker otherwise), and
 * converts the result back. The invoker calls a closure of this type given an
 * array of uniform 64-bit QVal words and returns a QVal word, allowing a thunk
 * to call a closure whose C signature it does not know statically.
 *
 * The C backend emits the same functions in C (codegen/c/declarations). *)

interface Adapters
import
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    ir = questlang/ir/nodes : questlang/ir/Nodes
    questlang/ssa/build/parts : questlang/ssa/build/Parts
    vals = questlang/ssa/build/values : questlang/ssa/build/Values
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/types/model : questlang/types/Model
export
    Def Type = model.Type
    Def Variable = ir.Variable
    Def Function = ssa.Function

    returnValues(fn: vals.Fn vs: Array(Int)): Ok
    (* A C function's SSA parameter layout: parameter types (after leading
     * pointer parameters), the starting indices of 16-byte two-word composite
     * arguments (pairs), and the indices of single-byte arguments (narrow) *)
    Def Params = Tuple types: vector.T(ssa.Type) pairs: vector.T(Int) narrow: vector.T(Int) end
    pointers(n: Int): Params
    newFunction(u: vals.UnitBuilder symbol: String exported: Bool s: Params results: Array(parts.Part)): vals.Fn
    finished(fn: vals.Fn): Function
    (* Builds a module file's exported C entry point (qv_<module>_<member>) for
     * an interface member that is a function or polymorphic value, or returns
     * none otherwise. The entry point uses the interface's C signature
     * (matching codegen/c/declarations' moduleFunctionSignature) and invokes
     * the member's underlying function or closure. *)
    exportedFunction(u: vals.UnitBuilder clean: String name: String v: Variable): maybe.T(Function)
    (* Builds the thunk (quest_thunk_<tag>), adapter (quest_adapt_<tag>), and
     * invoker (quest_invoke_<tag>) for a function type, matching the C
     * functions emitted by codegen/c/declarations' emitFunTypeAdapters *)
    funTypeAdapters(u: vals.UnitBuilder tag: String funType: Type): Array(Function)
end
