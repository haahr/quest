(* Quest Self-Hosted Compiler: The SSA Builder's Adapters Interface
 *
 * The unit's functions that are not its IR functions, which the builder
 * makes from types and interfaces rather than from code:
 *
 * - a module file's exported functions, C entry points that call its
 *   members' closures;
 * - for each function type the unit describes at run time, the three
 *   functions its descriptor points to, by which the runtime's quest_convert
 *   changes a closure's type, as dynamic.be and a field stored at a subtype
 *   need (docs/c-representation.md section 6.4.4, "Functions"). A closure's
 *   type fixes its C signature (how each argument is passed), so a closure
 *   used at another type must be wrapped. The adapter does that: it returns
 *   a new closure of this type whose code is the thunk and whose
 *   environment holds the original and both types' descriptors. The thunk,
 *   called at this type's signature, converts each argument to the
 *   original's type and calls it, at this signature directly when the two
 *   signatures agree, else through the original type's invoker; it then
 *   converts the result back. The invoker calls a closure of this type
 *   with its arguments as uniform QVal words, and returns the result as
 *   one, which lets a thunk call a closure whose signature it does not know.
 *
 * The C backend writes the same functions in C (codegen/c/declarations). *)

interface Adapters
import
    questlang/types/model : questlang/types/Model
    ir = questlang/ir/nodes : questlang/ir/Nodes
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    vals = questlang/ssa/build/values : questlang/ssa/build/Values
export
    Def Type = model.Type
    Def Variable = ir.Variable
    Def Function = ssa.Function

    returnValues(fn: vals.Fn vs: Array(Int)): Ok
    (* The SSA types of the parameters of a C function of a function type's
     * signature, after lead pointers, and where its 16-byte composites start *)
    Def Params = Tuple types: vector.T(ssa.Type) pairs: vector.T(Int) narrow: vector.T(Int) end
    pointers(n: Int): Params
    newFunction(u: vals.UnitBuilder symbol: String exported: Bool s: Params results: Array(vals.Part)): vals.Fn
    finished(fn: vals.Fn): Function
    (* A module file's exported function for a member of its interface that is
     * a function or a polymorphic value (qv_<module>_<member>): it calls the
     * member's closure, at the interface's C signature
     * (codegen/c/declarations' moduleFunctionSignature) *)
    exportedFunction(u: vals.UnitBuilder clean: String name: String v: Variable): maybe.T(Function)
    (* The adapter of a function type (quest_adapt_<tag>), the thunk its
     * closures call (quest_thunk_<tag>), and its invoker (quest_invoke_<tag>),
     * as codegen/c/declarations' emitFunTypeAdapters writes them in C *)
    funTypeAdapters(u: vals.UnitBuilder tag: String funType: Type): Array(Function)
end
