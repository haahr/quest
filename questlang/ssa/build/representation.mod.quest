(* Quest Self-Hosted Compiler: Slots and Aggregates' Components in SSA Implementation *)

module representation : Representation
import
    questlang/types/model : questlang/types/Model
    ir = questlang/ir/nodes : questlang/ir/Nodes
    questlang/repr/shapes : questlang/repr/Shapes
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/repr/layout : questlang/repr/Layout
    questlang/repr/runtimeLayout : questlang/repr/RuntimeLayout
    util/maybe : util/Maybe
    vals = questlang/ssa/build/values : questlang/ssa/build/Values
export
    Let Type = model.Type
    Let Variable = ir.Variable

    (* The values of a slot at an address (its slot form: a record or variant
     * as its box's pointer) *)
    let readSlot(fn: vals.Fn address: Int t: Type): Array(Int) = vals.readParts(fn address vals.slotParts(t))
    let writeSlot(fn: vals.Fn address: Int t: Type values: Array(Int)): Ok = vals.writeParts(fn address vals.slotParts(t) values)
    (* A slot's contents as a QVal word, and back (shapeSlotToQval and
     * shapeQvalToSlot): a box is its pointer's word *)
    let slotToWord(fn: vals.Fn vs: Array(Int) t: Type): Int =
        if layout.isBoxedInSlots(shapes.shape(t)) then vals.toVal(fn vs[0]) else vals.toWord(fn vs t) end
    let slotFromWord(fn: vals.Fn w: Int t: Type): Array(Int) =
        if layout.isBoxedInSlots(shapes.shape(t)) then array of vals.fromVal(fn w vals.tPtr) end else vals.fromWord(fn w t) end
    (* The index of a case of a variant or option shape (0 if it has none of
     * that name), as tags number them *)
    let tagIndex(s: shapes.Shape tag: String): Int =
        begin
            let var index = 0
            for i = 0 upto {extent s.cases - 1} do
                if vals.eq(maybe.unwrapOr(:String s.cases[i].name "") tag) then index := i end
            end
            index
        end
    let heldShape(t: Type kind: shapes.ShapeKind): shapes.Shape =
        begin
            let h = layout.resolvedShape(shapes.shape(t))
            if not(shapes.sameKind(h.kind kind)) then
                raise vals.unsupported with "a " <> shapes.kindName(kind) <> " operation on " <> model.show(t) end
            end
            h
        end
    let componentShape(s: shapes.Shape i: Int): shapes.Shape = maybe.unwrap(:shapes.Shape s.components[i].shape)
    (* A value chosen by a branch: then's in one block, otherwise's in another,
     * merged into a block of parameters of the types *)
    let choose(fn: vals.Fn cond: Int types: Array(ssa.Type) yes: All() Array(Int) no: All() Array(Int)): Array(Int) =
        begin
            let thenB = ssa.newBlock(fn.f)
            let elseB = ssa.newBlock(fn.f)
            let merged = ssa.newBlock(fn.f)
            let results = array of(extent types 0)
            for i = 0 upto {extent types - 1} do results[i] := ssa.addParam(fn.f merged types[i]) end
            vals.terminate(fn option termBranch of ssa.Terminator with
                let cond = cond let ifTrue = ssa.target(thenB vals.noValues) let ifFalse = ssa.target(elseB vals.noValues)
            end)
            fn.cur := thenB
            vals.jump(fn merged yes())
            fn.cur := elseB
            vals.jump(fn merged no())
            fn.cur := merged
            results
        end
    (* The object a tuple's or an option's pointer is: the original a proxy
     * views (its first field, the pointer less its tag bit), or the pointer
     * itself (quest_unproxy). An unproxy instruction, so that value
     * numbering merges the tests of one value, which ssa/passes/unproxies
     * lowers for the backends *)
    let unproxy(fn: vals.Fn p: Int): Int = ssa.emit(fn.f fn.cur ssa.opUnproxy array of p end vals.tPtr)
    (* Component i of the tuple at t (shape ts), in its slot form, vals.read as
     * access says: directly, from the original of what may be a proxy, or
     * through the proxy if it is one *)
    let tupleComponent(fn: vals.Fn t: Int ts: shapes.Shape i: Int access: ir.Access): Array(Int) =
        begin
            let comp = componentShape(ts i)
            let offset = 8 * i
            case access
                when direct then readSlot(fn vals.offsetPtr(fn t offset) comp.type)
                when original then readSlot(fn vals.offsetPtr(fn unproxy(fn t) offset) comp.type)
                when proxy then
                    choose(fn vals.isProxy(fn t) vals.typesOf(vals.slotParts(comp.type))
                        fun(): Array(Int)
                            slotFromWord(fn vals.call1(fn "quest_proxy_element" array of t vals.constant(fn i) end) comp.type)
                        fun(): Array(Int) readSlot(fn vals.offsetPtr(fn t offset) comp.type))
            end
        end
    (* The tag of the option at o, vals.read as access says *)
    let optionTag(fn: vals.Fn o: Int access: ir.Access): Int =
        case access
            when direct then vals.invariantWord(fn o runtimeLayout.offset("QOptionHeader" "tag") vals.tInt)
            (* A proxy's tag is the view's numbering of the original's *)
            when original, proxy then
                choose(fn vals.isProxy(fn o) array of vals.tInt end
                    fun(): Array(Int) array of vals.call1(fn "quest_proxy_tag" array of o end) end
                    fun(): Array(Int) array of vals.invariantWord(fn o runtimeLayout.offset("QOptionHeader" "tag") vals.tInt) end)[0]
        end
    (* The tag of a variant or option value vs of shape ts, in its numbering,
     * or through the view map of a bounded type parameter's value *)
    let tagOf(fn: vals.Fn vs: Array(Int) ts: shapes.Shape access: ir.Access viewMap: maybe.T(Variable)): Int =
        if maybe.isSome(:Variable viewMap) then
            let vm = vals.atom1(fn ir.atomOfVar(maybe.unwrap(:Variable viewMap)))
            case ts.kind
                when shapeVariant then
                    let index = vals.invariantWord(fn vm runtimeLayout.offset("QViewMap" "index") vals.tPtr)
                    let scaled = vals.binary(fn ssa.opMul vs[0] vals.constant(fn 8))
                    vals.invariantWord(fn vals.indexPtr(fn index scaled) 0 vals.tInt)
                when shapeInt, shapeReal, shapeBool, shapeChar, shapeString, shapeOk, shapeWord, shapeBottom,
                    shapeTuple, shapeRecord, shapeOption, shapeArray, shapeCell, shapeOut, shapeException, shapeFun,
                    shapeAll, shapeAuto, shapeTypevar, shapeAbstract, shapeExternal, shapeOperator, shapePending then
                    vals.call1(fn "quest_view_option_tag" array of vs[0] vm end)
            end
        elsif shapes.kindIs(ts shapes.shapeVariant) then
            vs[0]
        else
            optionTag(fn vs[0] access)
        end
    (* Component i (~1: the payload, when it is not a tuple) of case tag's
     * payload of the option at o, in its slot form, vals.read as access says *)
    let optionComponent(fn: vals.Fn o: Int os: shapes.Shape tag: String i: Int access: ir.Access): Array(Int) =
        begin
            let cs = maybe.unwrap(:shapes.Shape maybe.unwrap(:shapes.Component shapes.caseOf(os tag)).shape)
            let comp = if i < 0 then cs else componentShape(cs i) end
            let offset = 8 + 8 * {if i < 0 then 0 else i end}
            case access
                when direct then readSlot(fn vals.offsetPtr(fn o offset) comp.type)
                when original then readSlot(fn vals.offsetPtr(fn unproxy(fn o) offset) comp.type)
                when proxy then
                    choose(fn vals.isProxy(fn o) vals.typesOf(vals.slotParts(comp.type))
                        fun(): Array(Int) slotFromWord(fn
                            vals.call1(fn "quest_proxy_option_element" array of o vals.constant(fn {if i < 0 then 0 else i end})
                                end)
                            comp.type)
                        fun(): Array(Int) readSlot(fn vals.offsetPtr(fn o offset) comp.type))
            end
        end
    (* A new object of n bytes, zeroed by the collector, laid out as the
     * layout at the symbol says *)
    let alloc(fn: vals.Fn bytes: Int layout: String): Int =
        vals.call1(fn "quest_alloc" array of vals.constant(fn bytes) vals.symbolAt(fn layout) end)
end
