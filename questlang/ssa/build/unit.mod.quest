(* Quest Self-Hosted Compiler: The SSA Builder's Unit Implementation *)

module unit : Unit
import
    conv : Conv
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/iter : util/Iter
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/files : questlang/common/Files
    questlang/common/location : questlang/common/Location
    questlang/common/maps : questlang/common/Maps
    ir = questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/walk : questlang/ir/Walk
    questlang/repr/objectLayout : questlang/repr/ObjectLayout
    questlang/repr/runtimeLayout : questlang/repr/RuntimeLayout
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/repr/staticdata : questlang/repr/StaticData
    questlang/repr/symbols : questlang/repr/Symbols
    adapters = questlang/ssa/build/adapters : questlang/ssa/build/Adapters
    control = questlang/ssa/build/control : questlang/ssa/build/Control
    descriptors = questlang/ssa/build/descriptors : questlang/ssa/build/Descriptors
    vals = questlang/ssa/build/values : questlang/ssa/build/Values
    questlang/ssa/cfg : questlang/ssa/CFG
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/ssa/statics : questlang/ssa/Statics
    questlang/types/model : questlang/types/Model
export
    Let Type = model.Type
    Let Variable = ir.Variable
    Let Function = ssa.Function

    (* =========================================================================
     * Functions
     * ====================================================================== *)

    let countTypeParams(t: Type): Int =
        begin
            let var s = shapes.shape(t)
            let var n = 0
            while shapes.kindIs(s shapes.shapeAll) do
                n := n + extent s.typeParams
                s := shapes.body(s)
            end
            n
        end

    (* Lowers an IR function to SSA. Its C calling signature takes the closure
     * pointer first, then descriptors for its own type parameters, then its
     * value and var/out parameters. Captured type-parameter descriptors are
     * loaded from the closure immediately after its code pointer. *)
    let function(u: vals.UnitBuilder f: ir.Function): Function =
        begin
            let own = countTypeParams(f.v.type)
            let nCaptured = extent f.typeParams - own
            let paramTypes = vector.new(:ssa.Type)
            let paramPairs = vector.new(:Int)
            let paramNarrow = vector.new(:Int)
            vector.append(paramTypes vals.tPtr)
            for i = 0 upto {own - 1} do vector.append(paramTypes vals.tPtr) end
            for i = 0 upto {extent f.params - 1} do
                let entry = f.params[i]
                if not(vals.eq(entry.mode "value")) then
                    vector.append(paramTypes vals.tPtr)
                else
                    let ps = vals.varParts(entry.v)
                    (* An Ok parameter is a QVal word in C *)
                    if extent ps is 0 then vector.append(paramTypes vals.tVal) end
                    if extent ps is 2 then vector.append(paramPairs vector.length(paramTypes)) end
                    if {extent ps is 1} andif {ps[0].width is 1} then
                        vector.append(paramNarrow vector.length(paramTypes))
                    end
                    for k = 0 upto {extent ps - 1} do vector.append(paramTypes ps[k].type) end
                end
            end
            let params = vector.toArray(paramTypes)
            let resultParts = if f.unboxedResult then vals.unboxedParts(f.resultType) else vals.parts(f.resultType) end
            let sf = ssa.newFunction(vals.codeName(u f) false params vals.typesOf(resultParts))
            sf.signature := vals.signatureOf(params vector.toArray(paramPairs) vector.toArray(paramNarrow)
                    resultParts)
            let fn = vals.newFn(u sf hashMap.get(u.closuresOf f.id))
            let params = ssa.block(sf 0).params
            let var at = 0
            let next(): Int = begin let v = vector.get(params at) at := at + 1 v end
            let envValue = next()
            if maybe.isSome(f.env) then
                (* A lambda-lifted function's env parameter has placeholder
                 * type Ok and refers to its own closure. An adapter's env has
                 * a function type and refers to the adapted closure stored in
                 * QAdaptClosure.orig (see questlang/ir/thunks). *)
                let env = maybe.unwrap(f.env)
                let v = if shapes.kindIs(shapes.shape(env.type) shapes.shapeOk) then envValue
                    else vals.invariantWord(fn envValue runtimeLayout.offset("QAdaptClosure" "orig") vals.tPtr)
                    end
                vals.bindToValues(fn env array of v end)
            end
            (* Load captured type-parameter descriptors stored after the code
             * pointer *)
            for i = 0 upto {nCaptured - 1} do
                let d = vals.loadWord(fn envValue 8 * {i + 1} vals.tPtr)
                vals.bindToValues(fn f.descriptorParams[i].v array of d end)
            end
            for i = nCaptured upto {extent f.descriptorParams - 1} do
                vals.bindToValues(fn f.descriptorParams[i].v array of next() end)
            end
            for i = 0 upto {extent f.params - 1} do
                let entry = f.params[i]
                if not(vals.eq(entry.mode "value")) then
                    vals.bindToPointer(fn entry.v next())
                else
                    let ps = vals.varParts(entry.v)
                    if extent ps is 0 then
                        let ignored = next()
                        vals.bindToValues(fn entry.v vals.noValues)
                    else
                        let vs = array of(extent ps 0)
                        (* Zero- or sign-extend narrow parameters (Bool or
                         * Char), whose upper bits are unspecified by AAPCS64 *)
                        for k = 0 upto {extent ps - 1} do vs[k] := vals.narrowed(fn next() ps[k]) end
                        if entry.v.isMutable then vals.write(fn entry.v vs)
                        else vals.bindToValues(fn entry.v vs)
                        end
                    end
                end
            end
            for i = 0 upto {extent f.viewMaps - 1} do
                let m = f.viewMaps[i]
                let d = vals.atom1(fn ir.atomOfVar(m.descriptor))
                vals.bindToValues(fn m.v
                        array of vals.call1(fn "quest_view_map" array of d descriptors.descriptor(fn m.bound) end) end)
            end
            control.body(fn f.body)
            vals.finish(fn)
            sf
        end

    (* Builds a top-level SSA function (main, a JIT phrase entry, or a module
     * initializer) by emitting before, lowering body b, and emitting after if
     * control reaches the body's end. Variables bound outside loops and
     * referenced by other bodies become unit globals (walk.globalVariables).
     *
     * A construct's block for after it is left open even when nothing jumps
     * to it (a try whose body and handler both jump to an enclosing join),
     * so an open block at the end may still be unreached, and after must
     * not run there: a JIT phrase module's after reads its record, whose let
     * follows a raise that ended the body and so was never built. *)
    let topLevel(u: vals.UnitBuilder symbol: String b: ir.Body before: All(fn: vals.Fn) Ok after: All(fn: vals.Fn) Ok
            results: Array(ssa.Type) params: Array(ssa.Type) exported: Bool): Function =
        begin
            let sf = ssa.newFunction(symbol exported params results)
            let fn = vals.newFn(u sf maybe.none())
            before(fn)
            control.body(fn b)
            if not(vals.terminated(fn)) andif cfg.reached(cfg.graph(sf) fn.cur) then after(fn) end
            vals.finish(fn)
            sf
        end

    (* =========================================================================
     * Static data, registration, and the unit
     * ====================================================================== *)

    let wordOf(n: Int): ssa.Word = option wordInt of ssa.Word with let n = n end
    let addressWord(symbol: String): ssa.Word =
        option wordSymbol of ssa.Word with let symbol = symbol let addend = 0 end
    let addData(u: vals.UnitBuilder d: ssa.Data): Ok = vector.append(u.built.data d)

    (* Emits static data for the unit's type descriptors, record offset tables,
     * and variant tag maps (matching the C printer's declarations), along with
     * the adapter functions for each function-type descriptor *)
    let descriptorData(u: vals.UnitBuilder): Ok =
        if maybe.isSome(u.unit.staticData) then
            let data = maybe.unwrap(u.unit.staticData)
            let ctx = maybe.some(u.naming)
            let plain = vector.new(:Type)
            let echoed = vector.new(:Type)
            for i = 0 upto {vector.length(data.descriptors) - 1} do
                let d = vector.get(data.descriptors i)
                vector.append(if d.echo then echoed else plain end d.type)
            end
            let collected = staticdata.collectDescriptors(plain echoed ctx maps.newStringMap())
            let formOf(t: Type): staticdata.DescriptorForm = staticdata.descriptorForm(t ctx)
            let text(s: String): String = vals.stringSymbol(u s)
            for k = 0 upto {extent staticdata.descriptorKinds - 1} do
                let forms = staticdata.formsOf(collected staticdata.descriptorKinds[k])
                for i = 0 upto {vector.length(forms) - 1} do
                    let f = vector.get(forms i)
                    let ds = statics.descriptorData(staticdata.describeDescriptor(f ctx formOf) text)
                    for j = 0 upto {extent ds - 1} do addData(u ds[j]) end
                    if vals.eq(f.kind "fun") then
                        let fs = adapters.funTypeAdapters(u f.tag maybe.unwrap(f.type))
                        for j = 0 upto {extent fs - 1} do vector.append(u.built.functions fs[j]) end
                    end
                end
            end
            let seen = maps.newStringMap(:Bool)
            for i = 0 upto {vector.length(data.offsetTables) - 1} do
                let t = vector.get(data.offsetTables i)
                let table = staticdata.describeOffsetTable(u.naming t.view t.layout)
                if not(hashMap.contains(seen table.symbol)) then
                    vals.put(seen table.symbol true)
                    (* Each field's byte offset, followed by a null stored_types
                     * pointer slot *)
                    let ws = array of({extent table.offsets + 1} wordOf(0))
                    for j = 0 upto {extent table.offsets - 1} do ws[j] := wordOf(table.offsets[j].bytes) end
                    addData(u ssa.words(table.symbol false false ws))
                end
            end
            for i = 0 upto {vector.length(data.tagMaps) - 1} do
                let t = vector.get(data.tagMaps i)
                let map = staticdata.describeTagMap(t.target t.source)
                if not(hashMap.contains(seen map.symbol)) then
                    vals.put(seen map.symbol true)
                    let ws = array of({if extent map.entries > 0 then extent map.entries else 1 end} wordOf(0))
                    for j = 0 upto {extent map.entries - 1} do ws[j] := wordOf(map.entries[j]) end
                    addData(u ssa.words(map.symbol false false ws))
                end
            end
        end

    let isModuleFile(unit: ir.Unit): Bool = not(unit.isProgram)

    (* Names the synthetic module that runs a JIT phrase unit's phrases and the
     * entry point the JIT invokes (docs/jit.md section 3.2) *)
    let phraseModule(unit: ir.Unit): String =
        if maybe.isSome(unit.phrase) then "qj_" <> conv.int(maybe.unwrap(unit.phrase).number)
        else ""
        end
    let phraseEntry(unit: ir.Unit): String = phraseModule(unit) <> "_entry"

    (* Emits the traceback function table qr_funcs (docs/exceptions.md section
     * 5.2), a placeholder frame table qr_frames, and the qr_register_dicts
     * helper that registers GC roots, frames, traceback functions, and record
     * offset tables for supertype views *)
    let registration(u: vals.UnitBuilder): Function =
        begin
            let unit = u.unit
            let entries = vector.new(:ssa.Word)
            let entry(symbol: String frame: String): Ok =
                begin
                    vector.append(entries addressWord(symbol))
                    vector.append(entries addressWord(vals.stringSymbol(u frame)))
                end
            for i = 0 upto {vector.length(unit.functions) - 1} do
                let f = vector.get(unit.functions i)
                if maybe.isSome(f.traceName) then entry(vals.codeName(u f) maybe.unwrap(f.traceName)) end
            end
            for i = 0 upto {vector.length(unit.modules) - 1} do
                let m = vector.get(unit.modules i)
                (* A phrase unit's own module is its top level; a module an
                 * input declares has the name it was declared with *)
                let prefix = phraseModule(unit) <> "_"
                let frame = if stringOp.equal(m.name phraseModule(unit)) then diagnostics.mainFrame
                    elsif {stringOp.length(prefix) > 1} andif strutil.startsWith(m.name prefix) then
                        diagnostics.initFrame(stringOp.getSub(m.name stringOp.length(prefix)
                                stringOp.length(m.name) - stringOp.length(prefix)))
                    else diagnostics.initFrame(m.name)
                    end
                entry("qv_mod_" <> symbols.mangleModuleName(m.name) <> "_init" frame)
            end
            if not(isModuleFile(unit)) andif maybe.isNone(unit.phrase) then
                entry("main" diagnostics.mainFrame)
            end
            let fn = adapters.newFunction(u "qr_register_dicts" false adapters.pointers(0) array of :vals.Part end)
            vals.callVoid(fn "quest_register_roots" array of vals.symbolAt(fn "qr_roots") end)
            (* Emit an empty placeholder for the GC frame table (docs/arm64.md
             * section 3.13); the arm64 backend replaces it with the real
             * table *)
            addData(u ssa.words("qr_frames" false false array of wordOf(0) end))
            vals.callVoid(fn "quest_register_frames" array of vals.symbolAt(fn "qr_frames") end)
            if not(vector.empty(entries)) then
                addData(u ssa.words("qr_funcs" false false vector.toArray(entries)))
                vals.callVoid(fn "quest_register_funcs"
                        array of vals.symbolAt(fn "qr_funcs") vals.constant(fn vector.length(entries) / 2) end)
            end
            if maybe.isSome(unit.staticData) then
                let tables = maybe.unwrap(unit.staticData).offsetTables
                let registered = maps.newStringMap(:Bool)
                for i = 0 upto {vector.length(tables) - 1} do
                    let table = vector.get(tables i)
                    let dict = staticdata.describeOffsetTable(u.naming table.view table.layout).symbol
                    if maybe.isSome(table.registered)
                            andif not(hashMap.contains(registered dict)) then
                        vals.put(registered dict true)
                        let r = maybe.unwrap(table.registered)
                        vals.callVoid(fn "quest_register_record_dict"
                                array of descriptors.formAddress(fn descriptors.staticFormOf(u r.view))
                                    descriptors.formAddress(fn descriptors.staticFormOf(u r.layout))
                                    vals.symbolAt(fn dict)
                                end)
                    end
                end
            end
            adapters.returnValues(fn vals.noValues)
            adapters.finished(fn)
        end

    (* Marks main's argc parameter and return value as 32-bit C ints *)
    let mainOf(f: Function): Function =
        begin
            f.signature := ssa.withResult(ssa.withParam(f.signature 0 ssa.passInt32) ssa.passInt32)
            f
        end

    let buildUnit(unit: ir.Unit): ssa.Unit =
        begin
            let u = tuple
                let unit = unit
                let built = ssa.newUnit()
                let globals = walk.globalVariables(unit)
                let globalSymbols = maps.newIntMap(:String)
                let codeNames = maps.newIntMap(:String)
                let usedNames = maps.newStringMap(:Bool)
                let closuresOf = maps.newIntMap(:ir.OpMakeClosure)
                let closureVars = maps.newIntMap(:ir.OpMakeClosure)
                let strings = maps.newStringMap(:String)
                let var stringCount = 0
                let stringObjects = maps.newStringMap(:String)
                let optionTables = maps.newStringMap(:String)
                let naming = staticdata.newRecordNaming()
                let layouts = objectLayout.newTable()
                let roots = vector.new(:vals.RootEntry)
            end
            (* Record source files as absolute paths (or "" if unknown): index
             * 0 is the unit's own file, followed by any merged sources *)
            for k = 0 upto vector.length(unit.mergedSources) do
                let file = ir.sourceFile(unit k)
                vector.append(u.built.files
                        if maybe.isSome(file) then files.absolute(maybe.unwrap(file)) else "" end)
            end
            (* Record one OpMakeClosure per lifted function so lowering can
             * determine its closure environment layout *)
            let bodies = vector.new(:ir.Body)
            vector.append(bodies unit.main)
            for i = 0 upto {vector.length(unit.modules) - 1} do
                vector.append(bodies vector.get(unit.modules i).init)
            end
            for i = 0 upto {vector.length(unit.functions) - 1} do
                vector.append(bodies vector.get(unit.functions i).body)
            end
            for b = 0 upto {vector.length(bodies) - 1} do
                let stmts = walk.walkStatements(vector.get(bodies b) false)
                for i = 0 upto {vector.length(stmts) - 1} do
                    case vector.get(stmts i)
                        when sLet with x then
                            case x.value
                                when opMakeClosure with c then
                                    if not(hashMap.contains(u.closuresOf c.code.id)) then
                                        vals.put(u.closuresOf c.code.id c)
                                    end
                                else ok
                            end
                        else ok
                    end
                end
            end
            (* Map variables statically known to hold a specific closure
             * (through let bindings, copies, or environment reads; see
             * walk.knownClosures) so call sites can emit direct calls *)
            let known = walk.knownClosures(unit)
            let entries = hashMap.entryIter(known)
            while iter.more(entries) do
                let e = iter.next(entries)
                vals.put(u.closureVars e.key e.value)
            end
            for i = 0 upto {vector.length(unit.functions) - 1} do
                vector.append(u.built.functions function(u vector.get(unit.functions i)))
            end
            for i = 0 upto {vector.length(unit.modules) - 1} do
                let m = vector.get(unit.modules i)
                let clean = symbols.mangleModuleName(m.name)
                let initialized = "qv_mod_" <> clean <> "_initialized"
                let exported = maybe.isSome(m.exports)
                addData(u tuple
                    let symbol = symbols.moduleRecordIdent(clean)
                    let exported = exported
                    let writable = true
                    let contents = option contentsZero of ssa.Contents with let bytes = 16 end
                end)
                (* Register the module record as a GC root unless
                 * whole.dropUnreachable removed its recordVar, leaving the
                 * global zeroed *)
                if maybe.isSome(m.recordVar) then
                    vector.append(u.roots tuple
                        let symbol = symbols.moduleRecordIdent(clean)
                        let words = 2
                    end)
                end
                addData(u tuple
                    let symbol = initialized
                    let exported = false
                    let writable = true
                    let contents = option contentsZero of ssa.Contents with let bytes = 8 end
                end)
                vector.append(u.built.functions topLevel(u "qv_mod_" <> clean <> "_init" m.init
                        fun(fn: vals.Fn): Ok
                            begin
                                (* Idempotence guard: return immediately if already
                                 * initialized *)
                                let flag = vals.symbolAt(fn initialized)
                                let done = vals.load(fn flag 0 vals.part(vals.tInt 1 false))
                                let ret = control.newBlock(fn)
                                let go = control.newBlock(fn)
                                vals.terminate(fn option termBranch of ssa.Terminator with
                                    let cond = done
                                    let ifTrue = ssa.target(ret vals.noValues)
                                    let ifFalse = ssa.target(go vals.noValues)
                                end)
                                fn.cur := ret
                                vals.terminate(fn option termReturn of ssa.Terminator with
                                    let values = vals.noValues
                                end)
                                fn.cur := go
                                vals.store(fn vals.symbolAt(fn initialized) 0 1 vals.constant(fn 1))
                                (* Register the module's abstract types for dynamic
                                 * values, skipping any representation that has no
                                 * static descriptor *)
                                for j = 0 upto {extent m.abstractTypes - 1} do
                                    let entry = m.abstractTypes[j]
                                    let form =
                                        try maybe.some(descriptors.staticFormOf(u entry.descriptor))
                                        when staticdata.missingDescriptor then maybe.none(:staticdata.DescriptorForm)
                                        end
                                    if maybe.isSome(form) then
                                        vals.callVoid(fn "quest_register_abstract_type"
                                                array of vals.symbolAt(fn vals.stringSymbol(u entry.name))
                                                    vals.constant(fn entry.arity)
                                                    descriptors.formAddress(fn maybe.unwrap(form))
                                                end)
                                    end
                                end
                                (* An exported module's initializer registers this
                                 * unit's tables and initializes its imports, just
                                 * as a program's main does *)
                                if exported then
                                    vals.callOwn(fn "qr_register_dicts")
                                    for j = 0 upto {extent unit.imports - 1} do
                                        vals.callOwn(fn "qv_mod_"
                                            <> symbols.mangleModuleName(unit.imports[j].canonicalPath) <> "_init")
                                    end
                                    (* and the copies of inlined modules the unit
                                     * holds (ir/opened), which read the modules'
                                     * members *)
                                    for j = 0 upto {vector.length(unit.modules) - 1} do
                                        let o = vector.get(unit.modules j)
                                        if maybe.isSome(ir.openedModuleName(o)) then
                                            vals.callOwn(fn "qv_mod_" <> symbols.mangleModuleName(o.name) <> "_init")
                                        end
                                    end
                                end
                            end
                        fun(fn: vals.Fn): Ok
                            begin
                                if maybe.isSome(m.recordVar) then
                                    let recordValues = vals.read(fn maybe.unwrap(m.recordVar))
                                    vals.writeValue(fn vals.symbolAt(fn symbols.moduleRecordIdent(clean))
                                            maybe.unwrap(m.recordVar).type recordValues)
                                end
                                vals.terminate(fn option termReturn of ssa.Terminator with
                                    let values = vals.noValues
                                end)
                            end
                        array of :ssa.Type end array of :ssa.Type end exported))
                (* Emit exported C entry points for other compilation units,
                 * except for a JIT phrase unit's own module, whose bindings
                 * later phrases read from its module record *)
                if exported andif not(stringOp.equal(m.name phraseModule(unit))) then
                    let exports = maybe.unwrap(m.exports)
                    for j = 0 upto {vector.length(exports.names) - 1} do
                        let name = vector.get(exports.names j)
                        let f = adapters.exportedFunction(u clean name maybe.unwrap(ir.member(exports name)))
                        if maybe.isSome(f) then vector.append(u.built.functions maybe.unwrap(f)) end
                    end
                end
            end
            (* Emit a static closure object for each function, used whenever a
             * closure captures no variables *)
            for i = 0 upto {vector.length(unit.functions) - 1} do
                let code = vals.codeName(u vector.get(unit.functions i))
                addData(u ssa.words(code <> "_closure" false false array of addressWord(code) end))
            end
            descriptorData(u)
            vector.append(u.built.functions registration(u))
            if maybe.isSome(unit.phrase) then
                (* Build the JIT phrase entry point. Like main, it registers
                 * tables and initializes modules, but skips GC and builtin
                 * setup because the host has already run them. When capture is
                 * enabled, echoed output is captured and stored as a string in
                 * qj_<n>_echo. *)
                let capture = maybe.unwrap(unit.phrase).capture
                let echoed = phraseModule(unit) <> "_echo"
                if capture then
                    addData(u tuple
                        let symbol = echoed
                        let exported = true
                        let writable = true
                        let contents = option contentsZero of ssa.Contents with let bytes = 8 end
                    end)
                end
                vector.append(u.built.functions topLevel(u phraseEntry(unit) unit.main
                        fun(fn: vals.Fn): Ok
                            begin
                                if capture then vals.callVoid(fn "quest_echo_capture" vals.noValues) end
                                vals.callOwn(fn "qr_register_dicts")
                                for j = 0 upto {extent unit.imports - 1} do
                                    vals.callOwn(fn "qv_mod_" <> symbols.mangleModuleName(unit.imports[j].canonicalPath)
                                        <> "_init")
                                end
                                for j = 0 upto {vector.length(unit.modules) - 1} do
                                    vals.callOwn(fn "qv_mod_"
                                        <> symbols.mangleModuleName(vector.get(unit.modules j).name) <> "_init")
                                end
                                if capture then
                                    let text = vals.call1(fn "quest_echo_captured" vals.noValues)
                                    vals.store(fn vals.symbolAt(fn echoed) 0 8 text)
                                end
                            end
                        fun(fn: vals.Fn): Ok
                            vals.terminate(fn option termReturn of ssa.Terminator with let values = vals.noValues end)
                        array of :ssa.Type end array of :ssa.Type end true))
            elsif not(isModuleFile(unit)) then
                vector.append(u.built.functions mainOf(topLevel(u "main" unit.main
                        fun(fn: vals.Fn): Ok
                            begin
                                let params = ssa.block(fn.f 0).params
                                vals.callVoid(fn "quest_gc_init" vals.noValues)
                                vals.callVoid(fn "quest_builtins_init" array of vector.get(params 0)
                                    vector.get(params 1)
                                end)
                                vals.callOwn(fn "qr_register_dicts")
                                for j = 0 upto {extent unit.imports - 1} do
                                    vals.callOwn(fn "qv_mod_" <> symbols.mangleModuleName(unit.imports[j].canonicalPath)
                                        <> "_init")
                                end
                                for j = 0 upto {vector.length(unit.modules) - 1} do
                                    vals.callOwn(fn "qv_mod_"
                                        <> symbols.mangleModuleName(vector.get(unit.modules j).name)
                                        <> "_init")
                                end
                            end
                        fun(fn: vals.Fn): Ok
                            vals.terminate(fn option termReturn of ssa.Terminator with
                                let values = array of vals.constant(fn 0) end
                            end)
                        array of vals.tInt end array of vals.tInt vals.tPtr end true)))
            end
            (* Emit GC object layout descriptors for every heap object shape
             * registered while lowering the functions above *)
            let ls = objectLayout.layouts(u.layouts)
            for i = 0 upto {extent ls - 1} do
                let ds = statics.layoutData(ls[i] fun(s: String): String vals.stringSymbol(u s))
                for j = 0 upto {extent ds - 1} do addData(u ds[j]) end
            end
            (* Emit the GC root table (docs/collector.md section 3.8) listing
             * all pointer-holding globals and module records collected above,
             * terminated by a pair of zero words *)
            let rootWords = vector.new(:ssa.Word)
            for i = 0 upto {vector.length(u.roots) - 1} do
                let e = vector.get(u.roots i)
                vector.append(rootWords addressWord(e.symbol))
                vector.append(rootWords wordOf(e.words))
            end
            vector.append(rootWords wordOf(0))
            vector.append(rootWords wordOf(0))
            addData(u ssa.words("qr_roots" false false vector.toArray(rootWords)))
            u.built
        end
end
