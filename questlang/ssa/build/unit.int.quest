(* Quest Self-Hosted Compiler: The SSA Builder's Unit Interface
 *
 * Lowers a complete IR compilation unit into SSA: its functions, module
 * initializers, main or JIT phrase entry point, static data (strings, type
 * descriptors, offset tables, tag maps, object layouts, and GC root tables),
 * and run-time table registration. Subsequent SSA passes are driven by
 * questlang/ssa/pipeline. *)

interface Unit
import
    ir = questlang/ir/nodes : questlang/ir/Nodes
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export

    buildUnit(unit: ir.Unit): ssa.Unit
end
