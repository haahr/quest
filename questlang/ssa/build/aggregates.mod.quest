(* Quest Self-Hosted Compiler: The SSA Builder's Aggregates Implementation *)

module aggregates : Aggregates
import
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    ir = questlang/ir/nodes : questlang/ir/Nodes
    questlang/repr/layout : questlang/repr/Layout
    questlang/repr/objectLayout : questlang/repr/ObjectLayout
    questlang/repr/runtimeLayout : questlang/repr/RuntimeLayout
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/repr/staticdata : questlang/repr/StaticData
    questlang/repr/symbols : questlang/repr/Symbols
    calls = questlang/ssa/build/calls : questlang/ssa/build/Calls
    descriptors = questlang/ssa/build/descriptors : questlang/ssa/build/Descriptors
    questlang/ssa/build/objects : questlang/ssa/build/Objects
    questlang/ssa/build/parts : questlang/ssa/build/Parts
    vals = questlang/ssa/build/values : questlang/ssa/build/Values
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/types/model : questlang/types/Model
export
    Let Type = model.Type
    Let Variable = ir.Variable
    Let Atom = ir.Atom

    (* =========================================================================
     * Conversions (the represent pass's plans, ir.Plan)
     * ====================================================================== *)

    let rec convert(fn: vals.Fn vs: Array(Int) plan: ir.Plan): Array(Int) =
        begin
            let kind = plan.kind
            case kind
                when planBox then
                    array of vals.toWord(fn vs plan.source) end
                when planUnbox then
                    vals.fromWord(fn vs[0] plan.target)
                when planRecordView then
                    vals.runtime(fn "quest_record_view" array of vs[0] vs[1] descriptors.descriptor(fn
                            plan.descriptors[0]) end)
                when planVariantTags then
                    let table = maybe.unwrap(plan.tagMap)
                    let map = staticdata.describeTagMap(table.target table.source)
                    let scaled = vals.binary(fn ssa.opMul vs[0] vals.constant(fn 8))
                    array of vals.invariantWord(fn vals.indexPtr(fn vals.symbolAt(fn map.symbol) scaled) 0 vals.tInt)
                        vs[1]
                    end
                when planCast then
                    vs
                when planUnproxy then
                    array of objects.unproxy(fn vs[0]) end
                when planSlotBox then
                    if layout.isBoxedInSlots(shapes.shape(plan.source)) then vals.boxed(fn vs plan.source) else vs end
                when planSlotUnbox then
                    vals.unboxed(fn vs plan.target)
                when planView then
                    let word = vals.toWord(fn vs plan.source)
                    let converted = vals.call1(fn "quest_convert"
                            array of word descriptors.descriptor(fn plan.descriptors[0]) descriptors.descriptor(fn
                                    plan.descriptors[1]) end)
                    vals.fromWord(fn converted plan.target)
                when planRuntime then
                    let l = maybe.unwrap(plan.layout)
                    let genericType = if l.toGeneric then plan.target else plan.source end
                    let nativeType = model.substitute(genericType l.subst)
                    let fromType = if l.toGeneric then nativeType else genericType end
                    let toType = if l.toGeneric then genericType else nativeType end
                    let word = vals.toWord(fn vs fromType)
                    let converted = vals.call1(fn "quest_convert"
                            array of word descriptors.descriptor(fn plan.descriptors[0]) descriptors.descriptor(fn
                                    plan.descriptors[1]) end)
                    vals.fromWord(fn converted toType)
                when planAdapt then
                    if maybe.isNone(plan.thunk) then
                        raise vals.unsupported with "an adapt plan without its adapter" end
                    end
                    let clos = objects.alloc(fn maybe.unwrap(runtimeLayout.struct("QAdaptClosure")).bytes
                            objectLayout.adaptClosureSymbol)
                    let code = vals.symbolAt(fn vals.codeName(fn.u maybe.unwrap(plan.thunk)))
                    vals.store(fn clos runtimeLayout.offset("QAdaptClosure" "fn") 8 code)
                    vals.store(fn clos runtimeLayout.offset("QAdaptClosure" "orig") 8 vs[0])
                    array of clos end
                when planCopy then
                    let source = vs[0]
                    let sourceS = shapes.shape(plan.source)
                    let targetS = shapes.shape(plan.target)
                    let n = if extent targetS.components < extent plan.fields then extent targetS.components
                        else extent plan.fields end
                    let tup = objects.alloc(fn 8 * {if n is 0 then 1 else n end}
                            objectLayout.register(fn.u.layouts objectLayout.tuplePrefixLayout(targetS n)))
                    let mark = vals.beginInit(fn tup)
                    for i = 0 upto {n - 1} do
                        let tc = objects.componentShape(targetS i)
                        let sc = objects.componentShape(sourceS i)
                        let fc = objects.tupleComponent(fn source sourceS i plan.access[i])
                        let fp = plan.fields[i]
                        let byDescriptor = maybe.isSome(fp) andif ir.planIs(maybe.unwrap(fp) ir.planView)
                        let converted =
                            if byDescriptor then
                                (* Convert by runtime type descriptors, moving from
                                 * the source slot's QVal word to the target
                                 * slot's representation *)
                                let f = maybe.unwrap(fp)
                                let word = objects.slotToWord(fn fc sc.type)
                                let w = vals.call1(fn "quest_convert"
                                        array of word
                                            descriptors.descriptor(fn f.descriptors[0])
                                            descriptors.descriptor(fn
                                                    f.descriptors[1])
                                        end)
                                objects.slotFromWord(fn w tc.type)
                            elsif maybe.isSome(fp) then
                                slotStore(fn convert(fn slotLoad(fn fc sc.type) maybe.unwrap(fp)) tc.type)
                            else
                                objects.slotFromWord(fn objects.slotToWord(fn fc sc.type) tc.type)
                            end
                        objects.writeSlot(fn vals.offsetPtr(fn tup 8 * i) tc.type converted)
                    end
                    vals.endInit(fn mark tup)
                    array of tup end
            end
        end

    (* Convert between a value's slot form (where records and variants are
     * boxed) and its unboxed value form *)
    and slotLoad(fn: vals.Fn vs: Array(Int) t: Type): Array(Int) =
        if layout.isBoxedInSlots(shapes.shape(t)) then vals.unboxed(fn vs t) else vs end
    and slotStore(fn: vals.Fn vs: Array(Int) t: Type): Array(Int) =
        if layout.isBoxedInSlots(shapes.shape(t)) then vals.boxed(fn vs t) else vs end

    (* =========================================================================
     * Tuples
     * ====================================================================== *)

    (* Stores an aggregate's fields at offsets from base. Normal fields are
     * written in slot form; fields embedded by the represent pass (records or
     * variants) are written into inline 16-byte boxes starting at byte offset
     * boxes, and the field slot holds a pointer to that box. *)
    let storeFields(fn: vals.Fn base: Int offsets: Array(Int) args: Array(Atom) types: Array(Type) embedded: Array(Int)
            boxes: Int): Ok =
        begin
            let var k = 0
            for i = 0 upto {extent args - 1} do
                let var isEmbedded = false
                for j = 0 upto {extent embedded - 1} do if embedded[j] is i then isEmbedded := true end end
                let vs = vals.atom(fn args[i])
                if isEmbedded then
                    let box = vals.offsetPtr(fn base boxes + 16 * k)
                    vals.writeValue(fn box types[i] vs)
                    vals.store(fn base offsets[i] 8 box)
                    k := k + 1
                else
                    objects.writeSlot(fn vals.offsetPtr(fn base offsets[i]) types[i] vs)
                end
            end
        end

    (* The shapes of the fields embedded by the represent pass, in order,
     * describing the inline boxes placed after the aggregate's struct *)
    let embeddedShapes(args: Array(Atom) types: Array(Type) embedded: Array(Int)): Array(shapes.Shape) =
        begin
            let res = vector.new(:shapes.Shape)
            for i = 0 upto {extent args - 1} do
                for j = 0 upto {extent embedded - 1} do
                    if embedded[j] is i then vector.append(res shapes.shape(types[i])) end
                end
            end
            vector.toArray(res)
        end

    let noBoxes = array of :shapes.Shape end

    let makeTuple(fn: vals.Fn x: ir.OpMakeTuple t: Type): Array(Int) =
        begin
            let rs = shapes.shape(t)
            let n = extent rs.components
            let structBytes = 8 * {if n is 0 then 1 else n end}
            let offsets = array of(extent x.args 0)
            let types = array of(extent x.args model.okType)
            for i = 0 upto {extent x.args - 1} do
                offsets[i] := 8 * i
                types[i] := if i < n then objects.componentShape(rs i).type else ir.atomType(x.args[i]) end
            end
            let boxes = embeddedShapes(x.args types x.embedded)
            let tup = objects.alloc(fn structBytes + 16 * extent boxes
                    objectLayout.register(fn.u.layouts objectLayout.tupleLayout(rs "" boxes)))
            let mark = vals.beginInit(fn tup)
            storeFields(fn tup offsets x.args types x.embedded structBytes)
            vals.endInit(fn mark tup)
            array of tup end
        end

    (* =========================================================================
     * Records
     * ====================================================================== *)

    let fieldIndex(rs: shapes.Shape field: String): Int =
        begin
            let fields = shapes.sortedComponents(rs)
            let var index = 0
            for i = 0 upto {extent fields - 1} do
                if vals.eq(maybe.unwrapOr(fields[i].name "") field) then index := i end
            end
            index
        end

    (* Returns the address of field's slot in record vs (of shape rs). For a
     * bounded type parameter's value, viewMap translates from the concrete
     * type argument to the bound via quest_view_record_slot; otherwise the
     * byte offset is loaded from the record's offset table vs[1]. *)
    let recordSlot(fn: vals.Fn vs: Array(Int) rs: shapes.Shape field: String viewMap: maybe.T(Variable)): Int =
        begin
            let k = fieldIndex(rs field)
            if maybe.isSome(viewMap) then
                let vm = vals.atom1(fn ir.atomOfVar(maybe.unwrap(viewMap)))
                vals.call1(fn "quest_view_record_slot" array of vs[0] vs[1] vm vals.constant(fn k) end)
            else
                vals.indexPtr(fn vs[0] vals.invariantWord(fn vs[1] 8 * k vals.tInt))
            end
        end

    let fieldShape(rs: shapes.Shape field: String): shapes.Shape =
        maybe.unwrap(shapes.sortedComponents(rs)[fieldIndex(rs field)].shape)

    let recordField(fn: vals.Fn vs: Array(Int) rs: shapes.Shape o: ir.OpRecordField): Array(Int) =
        begin
            let fs = fieldShape(rs o.name)
            if not(o.stored) then
                objects.readSlot(fn recordSlot(fn vs rs o.name o.viewMap) fs.type)
            elsif maybe.isSome(o.viewMap) then
                let vm = vals.atom1(fn ir.atomOfVar(maybe.unwrap(o.viewMap)))
                let w = vals.call1(fn "quest_view_record_field"
                        array of vs[0] vs[1] vm vals.constant(fn fieldIndex(rs o.name)) end)
                vals.fromWord(fn w fs.type)
            else
                (* When the offset table records a different stored type for
                 * this field, load the raw QVal word and convert it to the
                 * field's type; otherwise read the slot directly *)
                let k = fieldIndex(rs o.name)
                let slot = recordSlot(fn vs rs o.name maybe.none())
                let stored = vals.loadWord(fn vs[1] 8 * extent rs.components vals.tPtr)
                let t = fs.type
                let types = parts.typesOf(parts.ofType(t))
                let plainRead = fun(): Array(Int) slotLoad(fn objects.readSlot(fn slot t) t)
                objects.choose(fn vals.binary(fn ssa.opPne stored vals.null(fn)) types
                        fun(): Array(Int)
                            begin
                                let storedType = vals.loadWord(fn stored 8 * k vals.tPtr)
                                objects.choose(fn vals.binary(fn ssa.opPne storedType vals.null(fn)) types
                                        fun(): Array(Int) vals.fromWord(fn
                                                vals.call1(fn "quest_convert"
                                                        array of vals.loadWord(fn slot 0 vals.tVal)
                                                            storedType
                                                            descriptors.maybeDescriptor(fn o.descriptor)
                                                        end) t)
                                        plainRead)
                            end
                        plainRead)
            end
        end

    let makeRecord(fn: vals.Fn o: ir.OpMakeRecord result: Variable): Array(Int) =
        begin
            let fields = vector.new(:model.RecordField)
            for i = 0 upto {extent o.fields - 1} do
                let f = o.fields[i]
                vector.append(fields tuple let name = f.name let type = ir.atomType(f.atom) let isVar = f.isVar end)
            end
            let concrete = model.recordType(vector.toArray(fields) maybe.none())
            let structBytes = layout.recordBytes(concrete)
            (* Layout of the single allocation: 16-byte QRecordVal box, then
             * the record payload, then any inline embedded boxes *)
            let stored = vector.new(:Int)
            for i = 0 upto {extent o.fields - 1} do
                if not(shapes.kindIs(shapes.shape(ir.atomType(o.fields[i].atom)) shapes.shapeOk)) then
                    vector.append(stored i)
                end
            end
            let argList = vector.new(:Atom)
            let typeList = vector.new(:Type)
            let offsetList = vector.new(:Int)
            let embedded = vector.new(:Int)
            for j = 0 upto {vector.length(stored) - 1} do
                let i = vector.get(stored j)
                vector.append(argList o.fields[i].atom)
                vector.append(typeList ir.atomType(o.fields[i].atom))
                vector.append(offsetList layout.recordFieldOffset(concrete o.fields[i].name))
                for k = 0 upto {extent o.embedded - 1} do if o.embedded[k] is i then vector.append(embedded j) end end
            end
            let args = vector.toArray(argList)
            let types = vector.toArray(typeList)
            let offsets = vector.toArray(offsetList)
            let embeddedArray = vector.toArray(embedded)
            let boxes = embeddedShapes(args types embeddedArray)
            let box = objects.alloc(fn 16 + structBytes + 16 * extent boxes
                    objectLayout.register(fn.u.layouts objectLayout.recordLayout(concrete "" boxes)))
            let mark = vals.beginInit(fn box)
            let payload = vals.offsetPtr(fn box 16)
            vals.store(fn payload runtimeLayout.offset("QRecordHeader" "descriptor") 8
                    descriptors.maybeDescriptor(fn o.descriptor))
            storeFields(fn payload offsets args types embeddedArray structBytes)
            let dict =
                if o.runtimeOffsets then
                    vals.call1(fn "quest_record_dict" array of descriptors.maybeDescriptor(fn o.viewDescriptor)
                        descriptors.maybeDescriptor(fn o.descriptor)
                    end)
                else
                    let table = maybe.unwrap(o.offsets)
                    vals.symbolAt(fn staticdata.describeOffsetTable(fn.u.naming table.view table.layout).symbol)
                end
            vals.store(fn box runtimeLayout.offset("QRecordVal" "val") 8 payload)
            vals.store(fn box runtimeLayout.offset("QRecordVal" "dict") 8 dict)
            vals.endInit(fn mark box)
            if result.boxed then array of box end else array of payload dict end end
        end

    (* =========================================================================
     * Variants and options
     * ====================================================================== *)

    let caseShape(s: shapes.Shape tag: String): maybe.T(shapes.Shape) =
        begin
            let c = shapes.caseOf(s tag)
            if maybe.isSome(c) then maybe.unwrap(c).shape else maybe.none() end
        end

    let tagShape(t: Type): shapes.Shape =
        begin
            let h = layout.resolvedShape(shapes.shape(t))
            if not(shapes.kindIs(h shapes.shapeVariant) orif shapes.kindIs(h shapes.shapeOption)) then
                raise vals.unsupported with "a tag test on a value of type " <> model.show(t) end
            end
            h
        end

    (* Returns table[v] via an SSA switch, or v directly when table is the
     * identity *)
    let mapped(fn: vals.Fn v: Int table: Array(Int)): Int =
        begin
            let var identity = true
            for i = 0 upto {extent table - 1} do if table[i] isnot i then identity := false end end
            if identity then
                v
            else
                let merged = ssa.newBlock(fn.f)
                let r = ssa.addParam(fn.f merged vals.tInt)
                let blocks = array of(extent table ssa.target(0 vals.noValues))
                let cases = array of(extent table 0)
                let start = fn.cur
                let otherwise = ssa.newBlock(fn.f)
                for i = 0 upto {extent table - 1} do
                    let b = ssa.newBlock(fn.f)
                    fn.cur := b
                    vals.jump(fn merged array of vals.constant(fn table[i]) end)
                    blocks[i] := ssa.target(b vals.noValues)
                    cases[i] := i
                end
                fn.cur := otherwise
                vals.terminate(fn ssa.termUnreachable)
                fn.cur := start
                vals.terminate(fn option termSwitch of ssa.Terminator with
                    let value = v
                    let cases = cases
                    let targets = blocks
                    let default = ssa.target(otherwise vals.noValues)
                end)
                fn.cur := merged
                r
            end
        end

    let makeAllocatedOption(fn: vals.Fn o: ir.OpMakeOption t: Type os: shapes.Shape): Array(Int) =
        begin
            let opt = objects.alloc(fn layout.optionBytes(os.structure)
                    objectLayout.register(fn.u.layouts objectLayout.optionLayout(os "" o.tag)))
            let mark = vals.beginInit(fn opt)
            let var tag = o.tag
            if maybe.isSome(o.ordinalAtom) then
                (* The ordinal counts in the type's cases as written; the tag
                 * numbers the shape's, ordered by name *)
                let ordinalAtom = maybe.unwrap(o.ordinalAtom)
                (* Reject ordinals outside [0, count) using unsigned less-than
                 * (opUlt), which treats negative values as large unsigned
                 * numbers (inlined quest_check_option_ordinal_at) *)
                let checked = vals.atom1(fn ordinalAtom)
                let count = vals.constant(fn extent os.cases)
                vals.check(fn vals.binary(fn ssa.opUlt checked count) true "quest_option_ordinal_error_at"
                        fun(): Array(Int) array of checked vals.constant(fn extent os.cases) vals.site(fn o.offset) end)
                let tags = array of(extent o.cases 0)
                for i = 0 upto {extent o.cases - 1} do tags[i] := objects.tagIndex(os o.cases[i]) end
                vals.store(fn opt runtimeLayout.offset("QOptionHeader" "tag") 8 mapped(fn checked tags))
                let n =
                    case ordinalAtom
                        when atomConst with x then case x.c.value when constInt with y then y.n else ~1 end
                        else ~1
                    end
                tag := if {n >= 0}
                        andif {n < extent o.cases} then maybe.some(o.cases[n]) else os.cases[0].name end
            else
                vals.store(fn opt runtimeLayout.offset("QOptionHeader" "tag") 8
                        vals.constant(fn objects.tagIndex(os maybe.unwrapOr(tag ""))))
            end
            if maybe.isSome(o.payload) andif maybe.isSome(tag) then
                let tagName = maybe.unwrap(tag)
                let pt = caseShape(os tagName)
                let payloadAtom = maybe.unwrap(o.payload)
                let pv = vals.atom(fn payloadAtom)
                if maybe.isSome(pt)
                        andif shapes.kindIs(maybe.unwrap(pt) shapes.shapeTuple) then
                    let pts = maybe.unwrap(pt)
                    let ps = shapes.shape(ir.atomType(payloadAtom))
                    for i = 0 upto {extent pts.components - 1} do
                        let comp = objects.componentShape(pts i)
                        objects.writeSlot(fn vals.offsetPtr(fn opt 8 + 8 * i) comp.type
                                objects.tupleComponent(fn pv[0] ps i o.access[i]))
                    end
                else
                    let st = if maybe.isSome(pt) then maybe.unwrap(pt).type else ir.atomType(payloadAtom) end
                    objects.writeSlot(fn vals.offsetPtr(fn opt 8) st pv)
                end
            end
            vals.endInit(fn mark opt)
            array of opt end
        end

    (* Whether an option shape's case has no components *)
    let caseWithoutComponents(os: shapes.Shape tag: String): Bool =
        begin
            let pt = caseShape(os tag)
            maybe.isNone(pt) orif {extent maybe.unwrap(:shapes.Shape pt).components is 0}
        end

    let makeOption(fn: vals.Fn o: ir.OpMakeOption t: Type): Array(Int) =
        begin
            let os = layout.resolvedShape(shapes.shape(t))
            let var allWithout = true
            for i = 0 upto {extent os.cases - 1} do
                if not(caseWithoutComponents(os maybe.unwrapOr(os.cases[i].name ""))) then allWithout := false end
            end
            (* Payload-free option cases reuse static constants from the option
             * struct's table instead of allocating (docs/c-representation.md
             * section 5.3) *)
            let table = fun(): Int vals.symbolAt(fn vals.optionTable(fn.u layout.shapeTag(os) extent os.cases))
            if maybe.isNone(o.ordinalAtom) andif maybe.isSome(o.tag)
                    andif caseWithoutComponents(os maybe.unwrap(o.tag)) then
                array of vals.offsetPtr(fn table() 8 * objects.tagIndex(os maybe.unwrap(o.tag))) end
            elsif maybe.isSome(o.ordinalAtom) andif allWithout then
                let ordinalAtom = maybe.unwrap(o.ordinalAtom)
                let checked = vals.atom1(fn ordinalAtom)
                vals.check(fn vals.binary(fn ssa.opUlt checked vals.constant(fn extent os.cases)) true
                        "quest_option_ordinal_error_at"
                        fun(): Array(Int) array of checked vals.constant(fn extent os.cases) vals.site(fn o.offset) end)
                let tags = array of(extent o.cases 0)
                for i = 0 upto {extent o.cases - 1} do tags[i] := objects.tagIndex(os o.cases[i]) end
                array of vals.indexPtr(fn table()
                        vals.binary(fn ssa.opShl mapped(fn checked tags) vals.constant(fn 3))) end
            else
                makeAllocatedOption(fn o t os)
            end
        end

    (* Allocates a tuple of type tupleType holding the components of case tag
     * from option opt (of shape os), read according to access. Components are
     * placed starting at index offset; when offset > 0, slot 0 holds
     * ordinalValue (the case's ordinal). *)
    let optionCaseTuple(fn: vals.Fn opt: Int os: shapes.Shape tag: String tupleType: Type offset: Int
            access: Array(ir.Access)
            ordinalValue: Int): Int =
        begin
            let ts = shapes.shape(tupleType)
            let n = extent ts.components
            let tup = objects.alloc(fn 8 * {if n is 0 then 1 else n end}
                    objectLayout.register(fn.u.layouts objectLayout.tupleLayout(ts "" noBoxes)))
            let mark = vals.beginInit(fn tup)
            let pt = caseShape(os tag)
            if offset > 0 then vals.store(fn tup 0 8 vals.constant(fn ordinalValue)) end
            if maybe.isSome(pt) andif shapes.kindIs(maybe.unwrap(pt) shapes.shapeTuple) then
                let pts = maybe.unwrap(pt)
                for i = 0 upto {extent pts.components - 1} do
                    if {i + offset} < n then
                        let src = objects.optionComponent(fn opt os tag i access[i])
                        let wanted = objects.componentShape(ts i + offset)
                        let have = objects.componentShape(pts i)
                        let value =
                            if parts.slotIsQVal(have) andif not(parts.slotIsQVal(wanted)) then
                                objects.slotFromWord(fn src[0] wanted.type)
                            else
                                src
                            end
                        objects.writeSlot(fn vals.offsetPtr(fn tup 8 * {i + offset}) wanted.type value)
                    end
                end
            elsif maybe.isSome(pt) then
                let comp = objects.componentShape(ts offset)
                objects.writeSlot(fn vals.offsetPtr(fn tup 8 * offset) comp.type
                        objects.optionComponent(fn opt os tag ~1 access[0]))
            end
            vals.endInit(fn mark tup)
            tup
        end

    (* Returns a pointer to the tuple payload of an option's case, which the
     * case's binder shares. When tagAccess is direct, the payload starts 8
     * bytes past opt (after its tag); otherwise it unproxies opt or calls
     * quest_proxy_option_payload when a component is read through a subtype
     * proxy. *)
    let optionCasePayload(fn: vals.Fn opt: Int tagAccess: ir.Access access: Array(ir.Access)): Int =
        begin
            let var proxied = false
            for i = 0 upto {extent access - 1} do
                case access[i] when proxy then proxied := true when direct, original then ok end
            end
            let tagDirect = case tagAccess when direct then true when original, proxy then false end
            if tagDirect then vals.offsetPtr(fn opt 8)
            elsif not(proxied) then vals.offsetPtr(fn objects.unproxy(fn opt) 8)
            else
                objects.choose(fn vals.isProxy(fn opt) array of vals.tPtr end
                        fun(): Array(Int) array of vals.call1(fn "quest_proxy_option_payload" array of opt end) end
                        fun(): Array(Int) array of vals.offsetPtr(fn opt 8) end)[0]
            end
        end

    (* Reads case tag's payload from a variant or option vs held at a bounded
     * type parameter's own view, converting it to type t through the view map
     * vm (which translates from the type argument to the bound ts). Returns a
     * variant's payload, an option's single component, or a freshly allocated
     * tuple of an option's case components (leaving a leading 0 slot for the
     * case ordinal when t has more components than the case). *)
    let viewPayload(fn: vals.Fn vs: Array(Int) ts: shapes.Shape tag: String vm: Int t: Type): Array(Int) =
        begin
            let b = objects.tagIndex(ts tag)
            let cs = caseShape(ts tag)
            case ts.kind
                when shapeVariant then
                    let caseT = if maybe.isSome(cs) then maybe.unwrap(cs).type else t end
                    vals.fromWord(fn vals.call1(fn "quest_view_part" array of vm vals.constant(fn b) vs[1] end) caseT)
                when shapeInt, shapeReal, shapeBool, shapeChar, shapeString, shapeOk, shapeWord, shapeBottom,
                        shapeTuple, shapeRecord, shapeOption, shapeArray, shapeCell, shapeOut, shapeException, shapeFun,
                        shapeAll, shapeAuto, shapeTypevar, shapeAbstract, shapeExternal, shapeOperator,
                        shapePending then
                    let tupleS = shapes.shape(t)
                    if not(shapes.kindIs(tupleS shapes.shapeTuple)) then
                        vals.fromWord(fn vals.call1(fn "quest_view_option_component"
                                array of vs[0] vm vals.constant(fn b) vals.constant(fn 0) end) t)
                    else
                        let n = extent tupleS.components
                        let tup = objects.alloc(fn 8 * {if n is 0 then 1 else n end}
                                objectLayout.register(fn.u.layouts objectLayout.tupleLayout(tupleS "" noBoxes)))
                        let mark = vals.beginInit(fn tup)
                        let var count = 0
                        if maybe.isSome(cs) then
                            let pt = maybe.unwrap(cs)
                            count := if shapes.kindIs(pt shapes.shapeTuple) then extent pt.components else 1 end
                        end
                        let offset = n - count
                        if offset > 0 then vals.store(fn tup 0 8 vals.constant(fn 0)) end
                        for j = 0 upto {count - 1} do
                            let w = vals.call1(fn "quest_view_option_component"
                                    array of vs[0] vm vals.constant(fn b) vals.constant(fn j) end)
                            let comp = objects.componentShape(tupleS j + offset)
                            objects.writeSlot(fn vals.offsetPtr(fn tup 8 * {j + offset}) comp.type
                                    objects.slotFromWord(fn w comp.type))
                        end
                        vals.endInit(fn mark tup)
                        array of tup end
                    end
            end
        end

    let payload(fn: vals.Fn o: ir.OpPayload t: Type): Array(Int) =
        begin
            let ts = tagShape(ir.atomType(o.value))
            let vs = vals.atom(fn o.value)
            (* A decided payload's tag is known, and not tested *)
            if not(o.decided) then
                let index = objects.tagIndex(ts o.tag)
                let tag = objects.tagOf(fn vs ts o.access o.viewMap)
                let good = ssa.newBlock(fn.f)
                let bad = ssa.newBlock(fn.f)
                vals.terminate(fn option termBranch of ssa.Terminator with
                    let cond = vals.binary(fn ssa.opEq tag vals.constant(fn index))
                    let ifTrue = ssa.target(good vals.noValues)
                    let ifFalse = ssa.target(bad vals.noValues)
                end)
                fn.cur := bad
                vals.callVoid(fn "quest_raise_variant_error_at" array of vals.site(fn o.offset) end)
                vals.terminate(fn ssa.termUnreachable)
                fn.cur := good
            end
            if maybe.isSome(o.viewMap) then
                let vm = vals.atom1(fn ir.atomOfVar(maybe.unwrap(o.viewMap)))
                let result = viewPayload(fn vs ts o.tag vm t)
                if shapes.kindIs(ts shapes.shapeOption) then
                    vals.store(fn result[0] 0 8 vals.constant(fn maybe.unwrapOr(o.ordinalIndex 0)))
                end
                result
            elsif shapes.kindIs(ts shapes.shapeVariant) then
                let cs = caseShape(ts o.tag)
                let caseT = if maybe.isSome(cs) then maybe.unwrap(cs).type else t end
                objects.slotFromWord(fn vs[1] caseT)
            else
                array of optionCaseTuple(fn vs[0] ts o.tag t 1 o.components maybe.unwrapOr(o.ordinalIndex 0)) end
            end
        end

    (* =========================================================================
     * Arrays
     * ====================================================================== *)

    let elementShape(a: Atom): shapes.Shape = shapes.element(shapes.shape(ir.atomType(a)))

    (* Returns the address of arr[idx] after checking bounds (inlined
     * quest_check_array_bounds_at). A null array or an out-of-range index
     * raises array.error; unsigned less-than (opUlt) catches negative indices
     * as large unsigned values. *)
    let elementAddress(fn: vals.Fn arr: Int idx: Int offset: maybe.T(Int)): Int =
        begin
            let site = fun(): Array(Int) array of vals.site(fn offset) end
            vals.check(fn vals.binary(fn ssa.opPeq arr vals.null(fn)) false "quest_raise_array_error_at" site)
            let length = vals.invariantWord(fn arr runtimeLayout.offset("QArray" "length") vals.tInt)
            vals.check(fn vals.binary(fn ssa.opUlt idx length) true "quest_raise_array_error_at" site)
            let scaled = vals.binary(fn ssa.opMul idx vals.constant(fn 8))
            vals.indexPtr(fn vals.offsetPtr(fn arr runtimeLayout.offset("QArray" "data")) scaled)
        end

    let makeArray(fn: vals.Fn args: Array(Atom) t: Type): Array(Int) =
        begin
            let elem = shapes.element(shapes.shape(t))
            let n = extent args
            let arr = objects.alloc(fn runtimeLayout.offset("QArray" "data") + 8 * n
                    objectLayout.arraySymbol(objectLayout.slotKind(elem)))
            let mark = vals.beginInit(fn arr)
            vals.store(fn arr runtimeLayout.offset("QArray" "length") 8 vals.constant(fn n))
            for i = 0 upto {n - 1} do
                vals.store(fn arr runtimeLayout.offset("QArray" "data") + 8
                    * i 8 objects.slotToWord(fn vals.atom(fn args[i]) elem.type))
            end
            vals.endInit(fn mark arr)
            array of arr end
        end

    (* =========================================================================
     * Non-thunk type applications (polymorphic values with no value parameters)
     * ====================================================================== *)

    (* A call of the closure at clos, with the closure itself and args *)
    let callClosureWith(fn: vals.Fn clos: Int args: Array(Int) results: Array(parts.Part)): Array(Int) =
        begin
            let code = vals.invariantWord(fn clos runtimeLayout.offset("QClosure" "fn") vals.tPtr)
            vals.callQuest(fn "" vals.concat(array of code clos end args) vals.noValues vals.noValues results)
        end

    (* Evaluates a polymorphic value with no value parameters applied to type
     * arguments (for example, a generic empty list at Int). Such a value is
     * compiled as a function taking runtime type descriptors, so this calls it
     * (via a variable's closure, a module member's closure, or an imported
     * function) with the type arguments' descriptors and converts the generic
     * result using the application's plan (docs/ir.md section 8.3). A type
     * application whose instance is a function has already been lowered to a
     * thunk closure (questlang/ir/thunks, docs/ir.md section 8.4.1), so seeing
     * thunkParams here raises unsupported. *)
    let typeApp(fn: vals.Fn o: ir.OpTypeApp result: Variable): Array(Int) =
        begin
            if maybe.isSome(o.thunkParams) then
                raise vals.unsupported with
                    "a type application whose instance is a function, not its thunk's closure"
                end
            end
            let descs = descriptors.descriptors(fn o.descriptors)
            let var origType = model.okType
            let called =
                if maybe.isSome(o.callee) then
                    let callee = maybe.unwrap(o.callee)
                    origType := callee.type
                    let clos = vals.atom1(fn ir.atomOfVar(callee))
                    callClosureWith(fn clos descs calls.resultParts(callee.type))
                else
                    let r = maybe.unwrap(o.moduleRef)
                    case r
                        when refImport with x then
                            origType := maybe.unwrapOr(o.calleeType model.okType)
                            let symbol = symbols.mangleModuleIdent(symbols.mangleModuleName(x.i.canonicalPath)
                                    maybe.unwrap(o.member))
                            vals.callQuest(fn symbol descs vals.noValues vals.noValues calls.resultParts(origType))
                        when refModule with x then
                            let member = maybe.unwrap(ir.member(x.m.members maybe.unwrap(o.member)))
                            origType := member.type
                            let clos = vals.atom1(fn ir.atomOfVar(member))
                            callClosureWith(fn clos descs calls.resultParts(member.type))
                    end
                end
            let values = calls.resultsOf(fn calls.resultParts(origType) called)
            let pl = o.plans[0]
            if maybe.isNone(pl) then values else convert(fn values maybe.unwrap(pl)) end
        end
end
