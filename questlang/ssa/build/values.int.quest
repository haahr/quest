(* Quest Self-Hosted Compiler: The SSA Builder's Values Interface
 *
 * Provides the SSA builder's foundation (docs/ssa.md, docs/arm64.md section
 * 3.2): splitting Quest values into SSA word parts, unit and function builder
 * state, instruction emission, variable bindings (SSA values, stack slots,
 * pointers, globals, and exception handler state), atoms, QVal word and box
 * conversions, runtime error checks, and function lifecycle helpers.
 * ssa/build/representation handles aggregate component access. *)

interface Values
import
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/common/maps : questlang/common/Maps
    ir = questlang/ir/nodes : questlang/ir/Nodes
    questlang/repr/layout : questlang/repr/Layout
    questlang/repr/objectLayout : questlang/repr/ObjectLayout
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/repr/staticdata : questlang/repr/StaticData
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/types/model : questlang/types/Model
export
    Def Type = model.Type
    Def Variable = ir.Variable
    Def Atom = ir.Atom
    Def Function = ssa.Function

    unsupported: Exception(String)
    eq(a: String b: String): Bool
    put(K::TYPE V::TYPE m: hashMap.T(K V) k: K v: V): Ok
    tInt: ssa.Type
    tPtr: ssa.Type
    tReal: ssa.Type
    tVal: ssa.Type
    noValues: Array(Int)
    noValuesTypes: Array(ssa.Type)

    (* Representations as SSA values *)
    (* A word of a value's representation: its SSA type, and how it is stored
     * (its width in bytes, and for a narrow one, whether it is signed) *)
    Def Part = Tuple type: ssa.Type width: Int signed: Bool end
    part(t: ssa.Type width: Int signed: Bool): Part
    (* The parts of a value of t, as a variable holds it
     * (layout.representation): none for Ok, two for a record or a variant, a
     * byte for a Bool or a Char stored, and otherwise a word *)
    parts(t: Type): Array(Part)
    (* Whether a value of shape s is a QVal in a slot (an Ok's is too) *)
    slotIsQVal(s: shapes.Shape): Bool
    (* The parts of a variable's value: a boxed record or variant holds its box
     * pointer, an unboxed tuple holds its components' slot parts, and other
     * variables hold parts(v.type) *)
    varParts(v: Variable): Array(Part)
    (* The parts of an unboxed tuple of type t (questlang/ir/unbox): its
     * components in their slot forms, a word each *)
    unboxedParts(t: Type): Array(Part)
    typesOf(ps: Array(Part)): Array(ssa.Type)

    (* The unit's builder and each function's *)
    (* An entry of a unit's root table: a global's symbol and its words *)
    Def RootEntry = Tuple symbol: String words: Int end
    Def UnitBuilder = Tuple
        (* The IR unit being built, and the SSA unit it is built into *)
        unit: ir.Unit
        built: ssa.Unit
        (* The unit's global variables, by id (walk.globalVariables): those its
         * top-level bodies bind that functions or other bodies name, which
         * live in static data rather than in values or slots *)
        globals: maps.IntMap(Bool)
        (* The symbols of the unit's global variables and functions, by id,
         * each made the first time it is asked for (globalSymbol, codeName),
         * and every symbol so far made, so that a fresh one is unique *)
        globalSymbols: maps.IntMap(String)
        codeNames: maps.IntMap(String)
        usedNames: maps.StringMap(Bool)
        (* The closure each lifted function is made by, by function id, and
         * the closures variables are bound to, by variable id *)
        closuresOf: maps.IntMap(ir.OpMakeClosure)
        closureVars: maps.IntMap(ir.OpMakeClosure)
        (* String literals' symbols, by text, and how many there are, which
         * numbers the next *)
        strings: maps.StringMap(String)
        var stringCount: Int
        (* String literals' static objects' symbols, by text *)
        stringObjects: maps.StringMap(String)
        (* The tables of options of cases without components, by option
         * struct (docs/c-representation.md section 5.3) *)
        optionTables: maps.StringMap(String)
        (* Names records and their offset tables as the unit's static data
         * does *)
        naming: staticdata.RecordNaming
        (* The layouts of the objects the unit allocates (docs/collector.md
         * section 3.2), laid out as its static data *)
        layouts: objectLayout.Table
        (* The unit's GC root table (docs/collector.md section 3.8): its
         * globals that may hold pointers and its module records, each symbol
         * with its words *)
        roots: vector.T(RootEntry)
    end
    (* The blocks of a loop: its head, where continue jumps, and the block
     * after it, where break jumps *)
    Def LoopTargets = Tuple head: Int after: Int end
    (* A capture of a variable a let rec binds, stored once the let rec's body
     * has run: the environment, the capture's offset in it, and the atom *)
    Def DeferredCapture = Tuple env: Int offset: Int a: Atom end
    (* The let rec being built: the variables it binds, by id, and the
     * captures of them made so far. A closure of a let rec captures
     * variables that the let rec has not bound yet (its own, or a sibling's),
     * so the environment's words for them are stored after the body. *)
    Def Deferred = Tuple vars: maps.IntMap(Bool) captures: vector.T(DeferredCapture) end
    (* How a variable of the function being built is held: as SSA values (an
     * immutable variable), in a stack slot (a mutable one), at the location a
     * var or out parameter points to, in a handler's copy of the exception
     * state (the handler's variable), or in the unit's static data (a global,
     * which no function's table holds) *)
    Def Binding = Option
        bindValues with values: Array(Int) end
        bindSlot with slot: Int end
        bindPointer with address: Int end
        bindHandler with state: Int end
        bindGlobal
    end
    Def Fn = Tuple
        u: UnitBuilder
        f: Function
        (* The block instructions are emitted into *)
        var cur: Int
        (* The calls emitted so far that may collect, and the objects whose
         * initializing stores are being emitted, outermost first, each with
         * the calls emitted before its allocation ended (beginInit) *)
        var calls: Int
        initObjects: vector.T(Int)
        initMarks: vector.T(Int)
        (* How each variable is held, by variable id *)
        bindings: maps.IntMap(Binding)
        (* Each join point's block, by its label, and how many parts (block
         * parameters) each of the join's parameters takes. A join point is
         * the IR's sJoin: a labelled continuation that a jump in its body
         * enters with arguments, like a local function called only in tail
         * position. *)
        joins: maps.StringMap(Int)
        joinParts: maps.StringMap(Array(Int))
        (* The blocks of each loop, by its label *)
        loops: maps.StringMap(LoopTargets)
        (* The function's IR closure (its environment's layout), if it is a
         * lifted function's *)
        closure: maybe.T(ir.OpMakeClosure)
        (* The innermost let rec being built, if any *)
        var deferred: maybe.T(Deferred)
        (* The handler records of the trys entered, innermost last, and for
         * each loop and join point the number entered where it is defined *)
        handlers: vector.T(Int)
        labelDepth: maps.StringMap(Int)
    end
    (* The symbol of f's code, qf_ and its name, made unique in the unit the
     * first time it is asked for *)
    codeName(u: UnitBuilder f: ir.Function): String
    (* The symbol of the global variable v, g_ and its name. The first time it
     * is asked for, this also adds v's storage to the unit's static data,
     * writable and zeroed, a word for each part (at least one), and to the
     * root table if a part may be a pointer, so that the collector sees it. *)
    globalSymbol(u: UnitBuilder v: Variable): String
    (* The symbol of the read-only C string s, qs_ and a number, added to the
     * unit's static data the first time s is asked for *)
    stringSymbol(u: UnitBuilder s: String): String
    (* The symbol of the string literal s's static object, qso_ and a number,
     * added to the unit's static data the first time s is asked for: a
     * header word, quest_layout_string's address with Q_HEADER_READONLY, then
     * the QString, s's length and its bytes (stringSymbol). The string is the
     * object's address plus 8, past its header (docs/extensions.md,
     * String Literals). *)
    stringObject(u: UnitBuilder s: String): String
    (* Returns the symbol of a read-only table of count words where word i is
     * i. Each entry acts as a static option constant of tag i for payload-free
     * cases of option struct key, whose only accessed field is the tag
     * (docs/c-representation.md section 5.3). *)
    optionTable(u: UnitBuilder key: String count: Int): String
    constant(fn: Fn n: Int): Int
    binary(fn: Fn op: ssa.Opcode x: Int y: Int): Int
    (* A one-operand operation whose result's type is t, a conversion *)
    unary(fn: Fn op: ssa.Opcode x: Int t: ssa.Type): Int
    symbolAt(fn: Fn symbol: String): Int
    symbolPlus(fn: Fn symbol: String addend: Int): Int
    load(fn: Fn address: Int offset: Int p: Part): Int
    loadWord(fn: Fn address: Int offset: Int t: ssa.Type): Int
    (* A word that nothing writes once the object holding it is made, a
     * closure's code, say (ssa.Inst.invariant) *)
    invariantWord(fn: Fn address: Int offset: Int t: ssa.Type): Int
    store(fn: Fn address: Int offset: Int width: Int value: Int): Ok
    (* Emits a call to runtime function name using its signature from
     * ssa/runtimeFunctions, returning all results (runtime), its single result
     * (call1), or nothing (callVoid) *)
    runtime(fn: Fn name: String args: Array(Int)): Array(Int)
    call1(fn: Fn name: String args: Array(Int)): Int
    callVoid(fn: Fn name: String args: Array(Int)): Ok
    (* Brackets an object's initializing stores, which normally need no GC
     * write barrier because the object starts in the young generation. A call
     * that may trigger collection (any Quest function or allocating runtime
     * helper) can promote the object to the old generation (docs/collector.md
     * section 3.5), so subsequent stores must be logged before the next
     * collection: from the second such call on, a barrier is emitted before
     * the call, and endInit emits one after the last store if any collecting
     * call occurred. Pass beginInit's return value as endInit's mark. *)
    beginInit(fn: Fn obj: Int): Int
    endInit(fn: Fn mark: Int obj: Int): Ok
    (* A call of a function of the unit, or another unit's, of no parameters
     * and no results *)
    callOwn(fn: Fn symbol: String): Ok
    (* The signature of a Quest function's call or its definition: words and
     * reals of its parameters' types, but 16-byte composites starting at
     * pairs and bytes (Bools and Chars) at narrow; and its results' parts, a
     * byte for a Bool or a Char *)
    signatureOf(params: Array(ssa.Type) pairs: Array(Int) narrow: Array(Int) results: Array(Part)): ssa.Signature
    (* A call of a Quest function: of the unit's or another unit's (or with
     * symbol "", of the code pointer args[0]), its results *)
    callQuest(fn: Fn symbol: String args: Array(Int) pairs: Array(Int) narrow: Array(Int) results: Array(Part))
            : Array(Int)
    terminate(fn: Fn t: ssa.Terminator): Ok
    terminated(fn: Fn): Bool
    jump(fn: Fn b: Int args: Array(Int)): Ok
    null(fn: Fn): Int
    toInt(fn: Fn v: Int): Int
    (* An int or a ptr as a QVal word, and a QVal word as an int or a ptr *)
    toVal(fn: Fn v: Int): Int
    fromVal(fn: Fn v: Int t: ssa.Type): Int
    (* Converts each value in vs to match the corresponding SSA type in ts
     * where one is a QVal word and the other is an int or pointer, leaving
     * other elements unchanged (or returning vs untouched if the lengths
     * differ). Used by direct calls when a closure's type and its code's type
     * treat pointers and QVal words alike (shapes.referencesAlike) and no
     * adapter was generated. *)
    retyped(fn: Fn vs: Array(Int) ts: Array(ssa.Type)): Array(Int)
    (* The SSA types of the parameters of f's code (as questlang/ssa/build/unit
     * makes them): its closure, its own type parameters' descriptors, then
     * its parameters' parts; and of its results *)
    codeParamTypes(f: ir.Function): Array(ssa.Type)
    codeResultParts(f: ir.Function): Array(Part)
    (* A pointer n bytes past p *)
    offsetPtr(fn: Fn p: Int n: Int): Int
    (* A pointer plus a byte count held in a value *)
    indexPtr(fn: Fn p: Int n: Int): Int
    (* Whether a tuple's or an option's pointer is a proxy's: its tag bit set
     * (docs/c-representation.md section 5.8) *)
    isProxy(fn: Fn p: Int): Int
    concat(a: Array(Int) b: Array(Int)): Array(Int)
    (* Extends a 1-byte bool or char returned from a callee to a full word,
     * since the ARM64 ABI (AAPCS64) leaves the upper bytes unspecified *)
    narrowed(fn: Fn v: Int p: Part): Int
    (* The source site of a raise or a check, a C string, or NULL *)
    site(fn: Fn offset: maybe.T(Int)): Int

    (* Variables *)
    isGlobal(fn: Fn v: Variable): Bool
    (* Binds v to values, to the location a var or out parameter points to,
     * or to a handler's copy of the exception state *)
    bindToValues(fn: Fn v: Variable vs: Array(Int)): Ok
    bindToPointer(fn: Fn v: Variable address: Int): Ok
    bindToHandler(fn: Fn v: Variable state: Int): Ok
    (* The location a var or out parameter points to, if v is one *)
    pointerOf(fn: Fn v: Variable): maybe.T(Int)
    (* The exception state of a handler's variable *)
    handlerState(fn: Fn v: Variable): Int
    (* The address of a mutable variable's slot (made the first time) *)
    slotOf(fn: Fn v: Variable): Int
    (* Reads or stores a value of type t at address, one part per word, with no
     * write barrier. A location (a cell, or a var/out parameter's target)
     * holds a record or variant as its box pointer
     * (layout.shapeLocationRepresentation), whereas writeValue stores the
     * value itself, as in a box or global record. Storing to a zero-part
     * location (Ok) is a no-op; otherwise a mismatched value count raises
     * unsupported. *)
    readLocation(fn: Fn address: Int t: Type): Array(Int)
    writeValue(fn: Fn address: Int t: Type values: Array(Int)): Ok
    writeLocation(fn: Fn address: Int t: Type values: Array(Int)): Ok
    (* The values a variable holds now *)
    read(fn: Fn v: Variable): Array(Int)
    (* Binds or assigns a variable: rebinds an immutable one to the values,
     * and stores a mutable one's into its slot (made the first time), a
     * global's into static data, or a var or out parameter's through its
     * pointer, then with a barrier if the value may hold a pointer; raises
     * unsupported for a handler's variable *)
    write(fn: Fn v: Variable values: Array(Int)): Ok

    (* Atoms *)
    realBitsOf(r: Real): Int
    (* An atom's values. A boxed mutable variable (or var parameter) holds its
     * location's box, and its value is the box's record or variant. *)
    atom(fn: Fn a: Atom): Array(Int)
    (* An atom of one value *)
    atom1(fn: Fn a: Atom): Int
    atoms(fn: Fn xs: Array(Atom)): Array(Int)
    (* Lowers call arguments to SSA values. An Ok argument has zero parts, so
     * it is passed as a 0 QVal word to match the C ABI and codeParamTypes. *)
    callAtoms(fn: Fn xs: Array(Atom)): Array(Int)

    (* Values as QVal words (layout.wordForm) *)
    toWord(fn: Fn vs: Array(Int) t: Type): Int
    fromWord(fn: Fn w: Int t: Type): Array(Int)
    (* The names of IR operations and statements, for what the builder does
     * not build yet *)
    opName(o: ir.Op): String
    statementName(s: ir.Stmt): String

    (* A record or variant into a new box, and out of its box *)
    boxed(fn: Fn vs: Array(Int) t: Type): Array(Int)
    unboxed(fn: Fn vs: Array(Int) t: Type): Array(Int)
    (* Continues where cond is (holds true) or is not (holds false); otherwise
     * calls the runtime's function name, which raises, with the arguments
     * args makes there, so that the common path computes none of them *)
    check(fn: Fn cond: Int holds: Bool name: String args: All() Array(Int)): Ok
    (* Whether a value of type t has a word that may be a pointer, which a
     * store of it into an existing object must barrier (docs/collector.md
     * section 3.5) *)
    holdsPointer(t: Type): Bool

    (* Functions being built *)
    newFn(u: UnitBuilder f: Function closure: maybe.T(ir.OpMakeClosure)): Fn
    (* Finishes a function: blocks nothing reaches the end of end in
     * unreachable, and blocks the entry does not reach are dropped, the rest
     * renumbered in order *)
    finish(fn: Fn): Ok

    (* The parts of a value of t in an aggregate's slot or a QVal word: one
     * word, a record or variant as a pointer to its box
     * (layout.isBoxedInSlots), a Bool or Char widened to the word *)
    slotParts(t: model.Type): Array(Part)
    (* The values of parts ps at an address, and their store; a location of no
     * words (an Ok's) holds nothing, whatever is stored *)
    readParts(fn: Fn address: Int ps: Array(Part)): Array(Int)
    writeParts(fn: Fn address: Int ps: Array(Part) values: Array(Int)): Ok
end
