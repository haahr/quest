(* Quest Self-Hosted Compiler: The SSA Builder's Adapters Implementation *)

module adapters : Adapters
import
    questlang/types/model : questlang/types/Model
    ir = questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/shapes : questlang/ir/Shapes
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/ir/slots : questlang/ir/Slots
    questlang/codegen/symbols : questlang/codegen/Symbols
    questlang/codegen/staticdata : questlang/codegen/StaticData
    questlang/codegen/runtimeLayout : questlang/codegen/RuntimeLayout
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    vals = questlang/ssa/build/values : questlang/ssa/build/Values
    descriptors = questlang/ssa/build/descriptors : questlang/ssa/build/Descriptors
    calls = questlang/ssa/build/calls : questlang/ssa/build/Calls
    control = questlang/ssa/build/control : questlang/ssa/build/Control
export
    Let Type = model.Type
    Let Variable = ir.Variable
    Let Function = ssa.Function

    (* =========================================================================
     * The unit's other functions: exported functions and function types'
     * adapters
     * ====================================================================== *)

    let returnValues(fn: vals.Fn vs: Array(Int)): Ok = vals.terminate(fn option termReturn of ssa.Terminator with let values = vs end)
    let param(f: Function i: Int): Int = vector.get(:Int ssa.block(f 0).params i)

    (* The SSA types of the parameters of a C function of a function type's
     * signature, after lead pointers: its type parameters' descriptors, then
     * its parameters (a var or out parameter's location, an Ok as a word);
     * and where its 16-byte composites start *)
    Def Params = Tuple types: vector.T(ssa.Type) pairs: vector.T(Int) narrow: vector.T(Int) end
    let paramsOf(lead: Int sig: staticdata.ShapeSignature): Params =
        begin
            let types = vector.new(:ssa.Type)
            let pairs = vector.new(:Int)
            let narrow = vector.new(:Int)
            for i = 0 upto {lead + vector.length(:maybe.T(Type) sig.bounds) - 1} do vector.append(:ssa.Type types vals.tPtr) end
            for j = 0 upto {vector.length(:model.Param sig.params) - 1} do
                let p = vector.get(:model.Param sig.params j)
                if p.isVar orif p.isOut then
                    vector.append(:ssa.Type types vals.tPtr)
                else
                    let ps = vals.parts(p.type)
                    if extent ps is 0 then vector.append(:ssa.Type types vals.tVal) end
                    if extent ps is 2 then vector.append(:Int pairs vector.length(:ssa.Type types)) end
                    if {extent ps is 1}
                        andif {ps[0].width is 1} then vector.append(:Int narrow vector.length(:ssa.Type types)) end
                    for k = 0 upto {extent ps - 1} do vector.append(:ssa.Type types ps[k].type) end
                end
            end
            tuple let types = types let pairs = pairs let narrow = narrow end
        end
    let pointers(n: Int): Params =
        begin
            let types = vector.new(:ssa.Type)
            for i = 0 upto {n - 1} do vector.append(:ssa.Type types vals.tPtr) end
            tuple let types = types let pairs = vector.new(:Int) let narrow = vector.new(:Int) end
        end

    (* The pairs of a call whose arguments are a signature's parameters after
     * more lead words *)
    let shifted(xs: vector.T(Int) by: Int): Array(Int) =
        begin
            let r = vector.toArray(:Int xs)
            for i = 0 upto {extent r - 1} do r[i] := r[i] + by end
            r
        end

    let newFunction(u: vals.UnitBuilder symbol: String exported: Bool s: Params results: Array(vals.Part)): vals.Fn =
        begin
            let params = vector.toArray(:ssa.Type s.types)
            let sf = ssa.newFunction(symbol exported params vals.typesOf(results))
            sf.signature := vals.signatureOf(params vector.toArray(:Int s.pairs) vector.toArray(:Int s.narrow) results)
            vals.newFn(u sf maybe.none(:ir.OpMakeClosure))
        end

    let finished(fn: vals.Fn): Function = begin vals.finish(fn) fn.f end

    (* A module file's exported function for a member of its interface that is
     * a function or a polymorphic value (qv_<module>_<member>): it calls the
     * member's closure, at the interface's C signature
     * (codegen/c/declarations' moduleFunctionSignature) *)
    let exportedFunction(u: vals.UnitBuilder clean: String name: String v: Variable): maybe.T(Function) =
        begin
            let shape = shapes.shape(v.type)
            if not(shapes.kindIs(shape shapes.shapeFun)) andif not(shapes.kindIs(shape shapes.shapeAll)) then
                maybe.none(:Function)
            else
                let sig = staticdata.funShapeSignature(v.type)
                let s = paramsOf(0 sig)
                let ps = vals.parts(sig.result)
                let fn = newFunction(u symbols.mangleModuleIdent(clean name) true s ps)
                let args = array of(vector.length(:ssa.Type s.types) 0)
                for i = 0 upto {extent args - 1} do args[i] := param(fn.f i) end
                let known = hashMap.get(:Int :ir.OpMakeClosure u.closureVars v.id)
                let direct = maybe.isSome(:ir.OpMakeClosure known)
                    andif {extent maybe.unwrap(:ir.OpMakeClosure known).typeArgs is 0}
                    andif {extent maybe.unwrap(:ir.OpMakeClosure known).captures is 0}
                let results = if direct then
                    vals.callQuest(fn vals.codeName(u maybe.unwrap(:ir.OpMakeClosure known).code)
                        vals.concat(array of vals.null(fn) end args) shifted(s.pairs 1) shifted(s.narrow 1) ps)
                else
                    let clos = vals.read(fn v)[0]
                    let fnPtr = vals.loadWord(fn clos runtimeLayout.offset("QClosure" "fn") vals.tPtr)
                    let env = vals.loadWord(fn clos runtimeLayout.offset("QClosure" "env") vals.tPtr)
                    vals.callQuest(fn "" vals.concat(array of fnPtr env end args) shifted(s.pairs 2) shifted(s.narrow 2)
                        ps)
                end
                returnValues(fn calls.resultsOf(fn ps results))
                maybe.some(:Function finished(fn))
            end
        end

    (* The adapter of a function type (quest_adapt_<tag>), the thunk its
     * closures call (quest_thunk_<tag>), and its invoker (quest_invoke_<tag>),
     * as codegen/c/declarations' emitFunTypeAdapters writes them in C *)
    let funTypeAdapters(u: vals.UnitBuilder tag: String funType: Type): Array(Function) =
        begin
            let sig = staticdata.funShapeSignature(funType)
            let nq = vector.length(:maybe.T(Type) sig.bounds)
            let np = vector.length(:model.Param sig.params)
            let ret = sig.result
            let retParts = vals.parts(ret)
            let isOk(t: Type): Bool = shapes.kindIs(shapes.shape(t) shapes.shapeOk)
            let byLocation(p: model.Param): Bool = p.isVar orif p.isOut
            let s = paramsOf(1 sig)
            let thunkName = "quest_thunk_" <> tag
            let bytes(name: String): Int = maybe.unwrap(:runtimeLayout.Struct runtimeLayout.struct(name)).bytes
            let extraAt = runtimeLayout.offset("QTypeDescriptor" "extra")
            let resultAt = runtimeLayout.offset("QFunTypeDescriptor" "result_type")
            let paramType(fn: vals.Fn d: Int j: Int): Int =
                vals.loadWord(fn d bytes("QFunTypeDescriptor") + {bytes("QFunParamDescriptor") * j} vals.tPtr)
            let convertWord(fn: vals.Fn w: Int from: Int to: Int): Int = vals.call1(fn "quest_convert" array of w from
                to end)
            let closureFn(fn: vals.Fn c: Int): Int = vals.loadWord(fn c runtimeLayout.offset("QClosure" "fn") vals.tPtr)
            let closureEnv(fn: vals.Fn c: Int): Int = vals.loadWord(fn c runtimeLayout.offset("QClosure" "env") vals.tPtr)

            (* The thunk, whose environment is a QFunAdapterEnv *)
            let thunk = newFunction(u thunkName false s retParts)
            let tf = thunk.f
            let e = param(tf 0)
            let orig = vals.loadWord(thunk e runtimeLayout.offset("QFunAdapterEnv" "orig") vals.tPtr)
            let from = vals.loadWord(thunk vals.loadWord(thunk e runtimeLayout.offset("QFunAdapterEnv" "from") vals.tPtr) extraAt vals.tPtr)
            let to = vals.loadWord(thunk vals.loadWord(thunk e runtimeLayout.offset("QFunAdapterEnv" "to") vals.tPtr) extraAt vals.tPtr)
            let directFlag = vals.load(thunk e runtimeLayout.offset("QFunAdapterEnv" "direct") vals.part(vals.tInt 1 false))
            let directB = control.newBlock(thunk)
            let uniformB = control.newBlock(thunk)
            vals.terminate(thunk option termBranch of ssa.Terminator with
                let cond = directFlag let ifTrue = ssa.target(directB vals.noValues) let ifFalse = ssa.target(uniformB vals.noValues)
            end)
            let descs = array of(nq 0)
            for k = 0 upto {nq - 1} do descs[k] := param(tf 1 + k) end
            (* Each parameter's values *)
            let paramValues = vector.new(:Array(Int))
            let var at = 1 + nq
            for j = 0 upto {np - 1} do
                let p = vector.get(:model.Param sig.params j)
                let n = if byLocation(p) orif {extent vals.parts(p.type) is 0} then 1 else extent vals.parts(p.type) end
                let vs = array of(n 0)
                for k = 0 upto {n - 1} do vs[k] := param(tf at + k) end
                at := at + n
                vector.append(:Array(Int) paramValues vs)
            end
            (* Called directly, at the type's own C signature *)
            thunk.cur := directB
            let var directArgs = vals.concat(array of closureEnv(thunk orig) end descs)
            for j = 0 upto {np - 1} do
                let p = vector.get(:model.Param sig.params j)
                let vs = vector.get(:Array(Int) paramValues j)
                let converted = not(byLocation(p)) andif not(isOk(p.type))
                    andif slots.mayBeStoredAsSubtype(shapes.shape(p.type))
                directArgs := vals.concat(directArgs if converted then
                    vals.fromWord(thunk convertWord(thunk vals.toWord(thunk vs p.type) paramType(thunk to j) paramType(thunk from j))
                        p.type)
                else vs end)
            end
            let directResults = calls.resultsOf(thunk retParts vals.callQuest(thunk ""
                vals.concat(array of closureFn(thunk orig) end directArgs) shifted(s.pairs 1) shifted(s.narrow
                    1) retParts))
            returnValues(thunk if not(isOk(ret)) andif slots.mayBeStoredAsSubtype(shapes.shape(ret)) then
                vals.fromWord(thunk convertWord(thunk vals.toWord(thunk directResults ret) vals.loadWord(thunk from resultAt vals.tPtr)
                    vals.loadWord(thunk to resultAt vals.tPtr)) ret)
            else directResults end)
            (* Called through the invoker of the closure's own type, with
             * words *)
            thunk.cur := uniformB
            let words = array of({nq + np} 0)
            for k = 0 upto {nq - 1} do words[k] := vals.toVal(thunk descs[k]) end
            for j = 0 upto {np - 1} do
                let p = vector.get(:model.Param sig.params j)
                let vs = vector.get(:Array(Int) paramValues j)
                words[nq + j] := if byLocation(p) then vals.toVal(thunk vs[0])
                    elsif isOk(p.type) then vs[0]
                    else convertWord(thunk vals.toWord(thunk vs p.type) paramType(thunk to j) paramType(thunk from j))
                    end
            end
            let argsArray = descriptors.slotArray(thunk words)
            let invoker = vals.loadWord(thunk from runtimeLayout.offset("QFunTypeDescriptor" "invoke") vals.tPtr)
            let invoked = vals.callQuest(thunk "" array of invoker orig argsArray end vals.noValues vals.noValues
                array of vals.part(vals.tVal 8 false) end)[0]
            returnValues(thunk if isOk(ret) then vals.noValues
                else vals.fromWord(thunk convertWord(thunk invoked vals.loadWord(thunk from resultAt vals.tPtr) vals.loadWord(thunk to resultAt vals.tPtr))
                    ret)
                end)

            (* The adapter: a closure of the thunk *)
            let adapt = newFunction(u "quest_adapt_" <> tag false pointers(3) array of vals.part(vals.tPtr 8 false) end)
            let af = adapt.f
            let env = vals.alloc(adapt bytes("QFunAdapterEnv"))
            vals.store(adapt env runtimeLayout.offset("QFunAdapterEnv" "orig") 8 param(af 0))
            vals.store(adapt env runtimeLayout.offset("QFunAdapterEnv" "from") 8 param(af 1))
            vals.store(adapt env runtimeLayout.offset("QFunAdapterEnv" "to") 8 param(af 2))
            let same = vals.narrowed(adapt vals.call1(adapt "quest_fun_signature_equivalent" array of param(af 1)
                param(af 2) end)
                vals.part(vals.tInt 1 false))
            vals.store(adapt env runtimeLayout.offset("QFunAdapterEnv" "direct") 1 same)
            let adapted = vals.alloc(adapt bytes("QClosure"))
            vals.store(adapt adapted runtimeLayout.offset("QClosure" "fn") 8 vals.symbolAt(adapt thunkName))
            vals.store(adapt adapted runtimeLayout.offset("QClosure" "env") 8 env)
            returnValues(adapt array of adapted end)

            (* The invoker: a call of a closure of this type with words *)
            let invoke = newFunction(u "quest_invoke_"
                <> tag false pointers(2) array of vals.part(vals.tVal 8 false) end)
            let vf = invoke.f
            let c = param(vf 0)
            let argv = param(vf 1)
            let var invokeArgs = array of closureEnv(invoke c) end
            for k = 0 upto {nq - 1} do invokeArgs := vals.concat(invokeArgs array of vals.loadWord(invoke argv 8 * k vals.tPtr) end) end
            for j = 0 upto {np - 1} do
                let p = vector.get(:model.Param sig.params j)
                let w = vals.loadWord(invoke argv 8 * {nq + j} if byLocation(p) then vals.tPtr else vals.tVal end)
                invokeArgs := vals.concat(invokeArgs if byLocation(p) orif isOk(p.type) then array of w end
                    else vals.fromWord(invoke w p.type) end)
            end
            let invokeResults = calls.resultsOf(invoke retParts vals.callQuest(invoke ""
                vals.concat(array of closureFn(invoke c) end invokeArgs) shifted(s.pairs 1) shifted(s.narrow
                    1) retParts))
            returnValues(invoke array of
                if isOk(ret) then vals.toVal(invoke vals.constant(invoke 0))
                else vals.toWord(invoke invokeResults ret) end
            end)
            array of finished(thunk) finished(adapt) finished(invoke) end
        end
end
