(* Quest Self-Hosted Compiler: The SSA Builder's Adapters Implementation *)

module adapters : Adapters
import
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    ir = questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/slots : questlang/ir/Slots
    questlang/repr/layout : questlang/repr/Layout
    questlang/repr/objectLayout : questlang/repr/ObjectLayout
    questlang/repr/runtimeLayout : questlang/repr/RuntimeLayout
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/repr/staticdata : questlang/repr/StaticData
    questlang/repr/symbols : questlang/repr/Symbols
    calls = questlang/ssa/build/calls : questlang/ssa/build/Calls
    control = questlang/ssa/build/control : questlang/ssa/build/Control
    descriptors = questlang/ssa/build/descriptors : questlang/ssa/build/Descriptors
    questlang/ssa/build/objects : questlang/ssa/build/Objects
    questlang/ssa/build/parts : questlang/ssa/build/Parts
    vals = questlang/ssa/build/values : questlang/ssa/build/Values
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/types/model : questlang/types/Model
export
    Let Type = model.Type
    Let Variable = ir.Variable
    Let Function = ssa.Function

    (* =========================================================================
     * The unit's other functions: exported functions and function types'
     * adapters
     * ====================================================================== *)

    let returnValues(fn: vals.Fn vs: Array(Int)): Ok =
        vals.terminate(fn option termReturn of ssa.Terminator with let values = vs end)
    let param(f: Function i: Int): Int = vector.get(ssa.block(f 0).params i)

    (* Builds the SSA parameter layout for a C function matching sig after lead
     * pointer parameters: type-parameter descriptors come first, followed by
     * value parameters (with var/out parameters passed as pointers and Ok
     * parameters passed as a QVal word). Records the starting indices of
     * 16-byte two-word composites in pairs and single-byte arguments in
     * narrow. *)
    Def Params = Tuple types: vector.T(ssa.Type) pairs: vector.T(Int) narrow: vector.T(Int) end
    let paramsOf(lead: Int sig: staticdata.ShapeSignature): Params =
        begin
            let types = vector.new(:ssa.Type)
            let pairs = vector.new(:Int)
            let narrow = vector.new(:Int)
            for i = 0 upto {lead + vector.length(sig.bounds) - 1} do vector.append(types vals.tPtr) end
            for j = 0 upto {vector.length(sig.params) - 1} do
                let p = vector.get(sig.params j)
                if p.isVar orif p.isOut then
                    vector.append(types vals.tPtr)
                else
                    let ps = parts.ofType(p.type)
                    if extent ps is 0 then vector.append(types vals.tVal) end
                    if extent ps is 2 then vector.append(pairs vector.length(types)) end
                    if {extent ps is 1}
                            andif {ps[0].width is 1} then vector.append(narrow vector.length(types)) end
                    for k = 0 upto {extent ps - 1} do vector.append(types ps[k].type) end
                end
            end
            tuple let types = types let pairs = pairs let narrow = narrow end
        end
    let pointers(n: Int): Params =
        begin
            let types = vector.new(:ssa.Type)
            for i = 0 upto {n - 1} do vector.append(types vals.tPtr) end
            tuple let types = types let pairs = vector.new() let narrow = vector.new() end
        end

    (* Returns parameter indices xs (pairs or narrow) shifted by adding by,
     * accounting for extra leading arguments passed at a call site *)
    let shifted(xs: vector.T(Int) by: Int): Array(Int) =
        begin
            let r = vector.toArray(xs)
            for i = 0 upto {extent r - 1} do r[i] := r[i] + by end
            r
        end

    let newFunction(u: vals.UnitBuilder symbol: String exported: Bool s: Params results: Array(parts.Part)): vals.Fn =
        begin
            let params = vector.toArray(s.types)
            let sf = ssa.newFunction(symbol exported params parts.typesOf(results))
            sf.signature := vals.signatureOf(params vector.toArray(s.pairs) vector.toArray(s.narrow) results)
            vals.newFn(u sf maybe.none())
        end

    let finished(fn: vals.Fn): Function = begin vals.finish(fn) fn.f end

    (* Builds a module file's exported C entry point (qv_<module>_<member>) for
     * an interface member that is a function or polymorphic value, using the
     * interface's C signature (codegen/c/declarations'
     * moduleFunctionSignature). When the member is known to be a capture-free
     * closure (or an adapter when the interface type differs), it calls the
     * underlying function directly; otherwise it calls through the closure. *)
    let exportedFunction(u: vals.UnitBuilder clean: String name: String v: Variable): maybe.T(Function) =
        begin
            let shape = shapes.shape(v.type)
            if not(shapes.kindIs(shape shapes.shapeFun)) andif not(shapes.kindIs(shape shapes.shapeAll)) then
                maybe.none()
            else
                let sig = staticdata.funShapeSignature(v.type)
                let s = paramsOf(0 sig)
                let ps = parts.ofType(sig.result)
                let fn = newFunction(u symbols.mangleModuleIdent(clean name) true s ps)
                let args = array of(vector.length(s.types) 0)
                for i = 0 upto {extent args - 1} do args[i] := param(fn.f i) end
                let known = hashMap.get(u.closureVars v.id)
                let direct = maybe.isSome(known)
                    andif {extent maybe.unwrap(:ir.OpMakeClosure known).typeArgs is 0}
                    andif {extent maybe.unwrap(:ir.OpMakeClosure known).captures is 0}
                let results =
                    if direct then
                        (* Retype arguments and results to match the callee's own
                         * SSA types (which may use pointers where the interface
                         * uses QVal words) *)
                        let code = maybe.unwrap(known).code
                        let all =
                            vals.retyped(fn vals.concat(array of vals.null(fn) end args) vals.codeParamTypes(code))
                        let vs = vals.callQuest(fn vals.codeName(u code) all shifted(s.pairs 1) shifted(s.narrow 1)
                                vals.codeResultParts(code))
                        vals.retyped(fn vs parts.typesOf(ps))
                    else
                        let clos = vals.read(fn v)[0]
                        let fnPtr = vals.invariantWord(fn clos runtimeLayout.offset("QClosure" "fn") vals.tPtr)
                        vals.callQuest(fn "" vals.concat(array of fnPtr clos end args) shifted(s.pairs 2)
                                shifted(s.narrow 2)
                                ps)
                    end
                returnValues(fn calls.resultsOf(fn ps results))
                maybe.some(finished(fn))
            end
        end

    (* Builds the thunk (quest_thunk_<tag>), adapter (quest_adapt_<tag>), and
     * invoker (quest_invoke_<tag>) for a function type, matching the C
     * functions emitted by codegen/c/declarations' emitFunTypeAdapters *)
    let funTypeAdapters(u: vals.UnitBuilder tag: String funType: Type): Array(Function) =
        begin
            let sig = staticdata.funShapeSignature(funType)
            let nq = vector.length(sig.bounds)
            let np = vector.length(sig.params)
            let ret = sig.result
            let retParts = parts.ofType(ret)
            let isOk(t: Type): Bool = shapes.kindIs(shapes.shape(t) shapes.shapeOk)
            let byLocation(p: model.Param): Bool = p.isVar orif p.isOut
            let s = paramsOf(1 sig)
            let thunkName = "quest_thunk_" <> tag
            let bytes(name: String): Int = maybe.unwrap(runtimeLayout.struct(name)).bytes
            let extraAt = runtimeLayout.offset("QTypeDescriptor" "extra")
            let resultAt = runtimeLayout.offset("QFunTypeDescriptor" "result_type")
            let paramType(fn: vals.Fn d: Int j: Int): Int =
                vals.loadWord(fn d bytes("QFunTypeDescriptor") + {bytes("QFunParamDescriptor") * j} vals.tPtr)
            let convertWord(fn: vals.Fn w: Int from: Int to: Int): Int = vals.call1(fn "quest_convert" array of w from
                to
            end)
            let closureFn(fn: vals.Fn c: Int): Int =
                vals.invariantWord(fn c runtimeLayout.offset("QClosure" "fn") vals.tPtr)

            (* The thunk, whose closure is a QFunAdapterClosure *)
            let thunk = newFunction(u thunkName false s retParts)
            let tf = thunk.f
            let e = param(tf 0)
            let orig = vals.loadWord(thunk e runtimeLayout.offset("QFunAdapterClosure" "orig") vals.tPtr)
            let from =
                vals.loadWord(thunk vals.loadWord(thunk e runtimeLayout.offset("QFunAdapterClosure" "from") vals.tPtr)
                        extraAt vals.tPtr)
            let to =
                vals.loadWord(thunk vals.loadWord(thunk e runtimeLayout.offset("QFunAdapterClosure" "to") vals.tPtr)
                        extraAt vals.tPtr)
            let directFlag =
                vals.load(thunk e runtimeLayout.offset("QFunAdapterClosure" "direct") parts.part(vals.tInt 1 false))
            let directB = control.newBlock(thunk)
            let uniformB = control.newBlock(thunk)
            vals.terminate(thunk option termBranch of ssa.Terminator with
                let cond = directFlag
                let ifTrue = ssa.target(directB vals.noValues)
                let ifFalse = ssa.target(uniformB vals.noValues)
            end)
            let descs = array of(nq 0)
            for k = 0 upto {nq - 1} do descs[k] := param(tf 1 + k) end
            (* Each parameter's values, a narrow one (a Bool or a Char)
             * extended, as a function's own are on entry (AAPCS64 leaves its
             * upper bits unspecified), since the slow path makes a QVal word
             * of it *)
            let paramValues = vector.new(:Array(Int))
            let var at = 1 + nq
            for j = 0 upto {np - 1} do
                let p = vector.get(sig.params j)
                let ps = if byLocation(p) then array of :parts.Part end else parts.ofType(p.type) end
                let n = if extent ps is 0 then 1 else extent ps end
                let vs = array of(n 0)
                for k = 0 upto {n - 1} do
                    vs[k] :=
                        if extent ps is 0 then param(tf at + k) else vals.narrowed(thunk param(tf at + k) ps[k]) end
                end
                at := at + n
                vector.append(paramValues vs)
            end
            (* A var or out argument whose parameter's types differ (their
             * descriptors are not one) is passed as a temporary of one word,
             * converted in from the location (an out argument's whose word is
             * a pointer starts null) and back into it after the call (an
             * unassigned one's left as it was): on the direct path one that
             * may hold a value of a subtype, its word as the location holds it
             * (the closure's is the same); on the uniform path every one, its
             * QVal word, which holds any representation's cell from its
             * start, as the closure's invoker reads its own. Where the
             * descriptors are one the location is passed as it is, so that
             * the closure's writes reach it as they are made. Each one's
             * parameter, location, the reference passed (the location or the
             * temporary), the temporary, and whether it starts null *)
            Let Back = Tuple j: Int location: Int ref: Int temp: Int unassigned: Bool end
            let startsNull(p: model.Param): Bool =
                begin
                    let ps = shapes.shape(p.type)
                    p.isOut
                        andif {if layout.isBoxedInSlots(ps) then layout.slotIsPointer(ps) else layout.isPointer(ps) end}
                end
            (* The reference passed for parameter j at location: a temporary
             * holding initial's word (made only where the descriptors differ)
             * or the location *)
            let reference(j: Int location: Int unassigned: Bool initial: All() Int): Back =
                begin
                    let temp = ssa.slotAddress(tf thunk.cur ssa.newSlot(tf 8 8))
                    let copy = control.newBlock(thunk)
                    let join = control.newBlock(thunk)
                    let ref = ssa.addParam(tf join vals.tPtr)
                    vals.terminate(thunk option termBranch of ssa.Terminator with
                        let cond = vals.binary(thunk ssa.opPne paramType(thunk to j) paramType(thunk from j))
                        let ifTrue = ssa.target(copy vals.noValues)
                        let ifFalse = ssa.target(join array of location end)
                    end)
                    thunk.cur := copy
                    vals.store(thunk temp 0 8 if unassigned then vals.toVal(thunk vals.null(thunk)) else initial() end)
                    vals.jump(thunk join array of temp end)
                    thunk.cur := join
                    tuple
                        let j = j
                        let location = location
                        let ref = ref
                        let temp = temp
                        let unassigned = unassigned
                    end
                end
            (* After the call: each temporary's word, converted, stored back
             * by store *)
            let writeBack(backs: vector.T(Back) store: All(b: Back w: Int) Ok): Ok =
                for k = 0 upto {vector.length(backs) - 1} do
                    let b = vector.get(backs k)
                    let join = control.newBlock(thunk)
                    let copied = control.newBlock(thunk)
                    vals.terminate(thunk option termBranch of ssa.Terminator with
                        let cond = vals.binary(thunk ssa.opPne b.ref b.location)
                        let ifTrue = ssa.target(copied vals.noValues)
                        let ifFalse = ssa.target(join vals.noValues)
                    end)
                    thunk.cur := copied
                    let word = vals.loadWord(thunk b.temp 0 vals.tVal)
                    if b.unassigned then
                        let write = control.newBlock(thunk)
                        vals.terminate(thunk option termBranch of ssa.Terminator with
                            let cond = vals.binary(thunk ssa.opPne vals.fromVal(thunk word vals.tPtr) vals.null(thunk))
                            let ifTrue = ssa.target(write vals.noValues)
                            let ifFalse = ssa.target(join vals.noValues)
                        end)
                        thunk.cur := write
                    end
                    store(b convertWord(thunk word paramType(thunk from b.j) paramType(thunk to b.j)))
                    vals.callVoid(thunk "quest_barrier_slot" array of b.location end)
                    vals.jump(thunk join vals.noValues)
                    thunk.cur := join
                end
            (* Fast path: signatures match, so call orig directly at this C
             * signature *)
            thunk.cur := directB
            let var directArgs = vals.concat(array of orig end descs)
            let backs = vector.new(:Back)
            for j = 0 upto {np - 1} do
                let p = vector.get(sig.params j)
                let vs = vector.get(paramValues j)
                let ps = shapes.shape(p.type)
                let converted = not(byLocation(p)) andif not(isOk(p.type)) andif slots.mayBeStoredAsSubtype(ps)
                if byLocation(p) andif slots.mayBeStoredAsSubtype(ps) then
                    let b = reference(j vs[0] startsNull(p) fun(): Int
                        convertWord(thunk vals.loadWord(thunk vs[0] 0 vals.tVal) paramType(thunk to j)
                                paramType(thunk from j)))
                    vector.append(backs b)
                    directArgs := vals.concat(directArgs array of b.ref end)
                else
                    directArgs := vals.concat(directArgs if converted then
                        vals.fromWord(thunk
                                convertWord(thunk vals.toWord(thunk vs p.type) paramType(thunk to j)
                                        paramType(thunk from j))
                                p.type)
                    else
                        vs
                    end)
                end
            end
            let directResults = calls.resultsOf(thunk retParts vals.callQuest(thunk ""
                    vals.concat(array of closureFn(thunk orig) end directArgs) shifted(s.pairs 1) shifted(s.narrow
                            1) retParts))
            writeBack(backs fun(b: Back w: Int): Ok vals.store(thunk b.location 0 8 w))
            returnValues(thunk if not(isOk(ret)) andif slots.mayBeStoredAsSubtype(shapes.shape(ret)) then
                vals.fromWord(thunk
                        convertWord(thunk vals.toWord(thunk directResults ret)
                                vals.loadWord(thunk from resultAt vals.tPtr)
                                vals.loadWord(thunk to resultAt vals.tPtr)) ret)
            else
                directResults
            end)
            (* Slow path: signatures differ, so pack arguments as QVal words
             * and call orig through its own type's invoker; a location's value
             * is read and written in its own representation, as its QVal
             * word *)
            thunk.cur := uniformB
            let boxed(t: Type): Bool = layout.isBoxedInSlots(shapes.shape(t))
            let words = array of({nq + np} 0)
            for k = 0 upto {nq - 1} do words[k] := vals.toVal(thunk descs[k]) end
            let uniformBacks = vector.new(:Back)
            for j = 0 upto {np - 1} do
                let p = vector.get(sig.params j)
                let vs = vector.get(paramValues j)
                words[nq + j] := if byLocation(p) andif isOk(p.type) then vals.toVal(thunk vs[0])
                    elsif byLocation(p) then
                        let b = reference(j vs[0] startsNull(p) fun(): Int
                            begin
                                let held = vals.readLocation(thunk vs[0] p.type)
                                let w =
                                    if boxed(p.type) then
                                        vals.toVal(thunk held[0])
                                    else
                                        vals.toWord(thunk held p.type)
                                    end
                                convertWord(thunk w paramType(thunk to j) paramType(thunk from j))
                            end)
                        vector.append(uniformBacks b)
                        vals.toVal(thunk b.ref)
                    elsif isOk(p.type) then vs[0]
                    else convertWord(thunk vals.toWord(thunk vs p.type) paramType(thunk to j) paramType(thunk from j))
                    end
            end
            let argsArray = descriptors.slotArray(thunk words)
            let invoker = vals.loadWord(thunk from runtimeLayout.offset("QFunTypeDescriptor" "invoke") vals.tPtr)
            let invoked = vals.callQuest(thunk "" array of invoker orig argsArray end vals.noValues vals.noValues
                    array of parts.part(vals.tVal 8 false) end)[0]
            writeBack(uniformBacks fun(b: Back w: Int): Ok
                begin
                    let t = vector.get(sig.params b.j).type
                    vals.writeLocation(thunk b.location t
                            if boxed(t) then
                                array of vals.fromVal(thunk w vals.tPtr) end
                            else
                                vals.fromWord(thunk w t)
                            end)
                end)
            returnValues(thunk if isOk(ret) then
                vals.noValues
            else
                vals.fromWord(thunk
                        convertWord(thunk invoked vals.loadWord(thunk from resultAt vals.tPtr)
                                vals.loadWord(thunk to resultAt vals.tPtr))
                        ret)
            end)

            (* Adapter: allocates a QFunAdapterClosure pointing to the thunk *)
            let adapt =
                newFunction(u "quest_adapt_" <> tag false pointers(3) array of parts.part(vals.tPtr 8 false) end)
            let af = adapt.f
            let adapted = objects.alloc(adapt bytes("QFunAdapterClosure") objectLayout.adapterClosureSymbol)
            let mark = vals.beginInit(adapt adapted)
            vals.store(adapt adapted runtimeLayout.offset("QFunAdapterClosure" "fn") 8 vals.symbolAt(adapt thunkName))
            vals.store(adapt adapted runtimeLayout.offset("QFunAdapterClosure" "orig") 8 param(af 0))
            vals.store(adapt adapted runtimeLayout.offset("QFunAdapterClosure" "from") 8 param(af 1))
            vals.store(adapt adapted runtimeLayout.offset("QFunAdapterClosure" "to") 8 param(af 2))
            let same = vals.narrowed(adapt vals.call1(adapt "quest_fun_signature_equivalent" array of param(af 1)
                param(af 2)
            end)
                    parts.part(vals.tInt 1 false))
            vals.store(adapt adapted runtimeLayout.offset("QFunAdapterClosure" "direct") 1 same)
            vals.endInit(adapt mark adapted)
            returnValues(adapt array of adapted end)

            (* Invoker: unpacks QVal words and calls a closure at this C
             * signature *)
            let invoke = newFunction(u "quest_invoke_"
                <> tag false pointers(2) array of parts.part(vals.tVal 8 false) end)
            let vf = invoke.f
            let c = param(vf 0)
            let argv = param(vf 1)
            let var invokeArgs = array of c end
            for k = 0 upto {nq - 1} do
                invokeArgs := vals.concat(invokeArgs array of vals.loadWord(invoke argv 8 * k vals.tPtr) end)
            end
            for j = 0 upto {np - 1} do
                let p = vector.get(sig.params j)
                let w = vals.loadWord(invoke argv 8 * {nq + j} if byLocation(p) then vals.tPtr else vals.tVal end)
                invokeArgs := vals.concat(invokeArgs if byLocation(p) orif isOk(p.type) then array of w end
                    else vals.fromWord(invoke w p.type) end)
            end
            let invokeResults = calls.resultsOf(invoke retParts vals.callQuest(invoke ""
                    vals.concat(array of closureFn(invoke c) end invokeArgs) shifted(s.pairs 1) shifted(s.narrow
                            1) retParts))
            returnValues(invoke array of
                if isOk(ret) then vals.toVal(invoke vals.constant(invoke 0))
                else vals.toWord(invoke invokeResults ret)
                end
            end)
            array of finished(thunk) finished(adapt) finished(invoke) end
        end
end
