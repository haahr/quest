(* Quest Self-Hosted Compiler: The SSA Builder's Control Interface
 *
 * Operations, each a let's value, and statements: control flow, joins and
 * loops, switches, trys and raises, inspects, and the bodies they make. *)

interface Control
import
    ir = questlang/ir/nodes : questlang/ir/Nodes
    vals = questlang/ssa/build/values : questlang/ssa/build/Values
export
    (* A new empty block of the function being built; fn.cur is unchanged *)
    newBlock(fn: vals.Fn): Int
    (* Emits b's statements at fn.cur and into the blocks they make, leaving
     * fn.cur at the block where control goes on after b. That block is
     * terminated if b cannot fall off its end (it returns, jumps, or
     * raises), which a caller tests with vals.terminated before adding a
     * jump of its own *)
    body(fn: vals.Fn b: ir.Body): Ok
end
