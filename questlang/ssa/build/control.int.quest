(* Quest Self-Hosted Compiler: The SSA Builder's Control Interface
 *
 * Operations, each a let's value, and statements: control flow, joins and
 * loops, switches, trys and raises, inspects, and the bodies they make. *)

interface Control
import
    ir = questlang/ir/nodes : questlang/ir/Nodes
    vals = questlang/ssa/build/values : questlang/ssa/build/Values
export
    newBlock(fn: vals.Fn): Int
    body(fn: vals.Fn b: ir.Body): Ok
end
