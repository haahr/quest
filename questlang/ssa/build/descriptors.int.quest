(* Quest Self-Hosted Compiler: The SSA Builder's Descriptors Interface
 *
 * Lowers run-time type descriptors to SSA values: static descriptors addressed
 * by symbol, polymorphic descriptors instantiated at run time, and
 * stack-allocated pointer arrays used to pass descriptor lists. *)

interface Descriptors
import
    ir = questlang/ir/nodes : questlang/ir/Nodes
    questlang/repr/staticdata : questlang/repr/StaticData
    util/maybe : util/Maybe
    vals = questlang/ssa/build/values : questlang/ssa/build/Values
export

    (* The SSA address of the static type descriptor described by f *)
    formAddress(fn: vals.Fn f: staticdata.DescriptorForm): Int
    (* Resolves a static descriptor operand to its DescriptorForm, preferring
     * its echo form (for value printing) when d.echo is set and one exists *)
    staticFormOf(u: vals.UnitBuilder d: ir.StaticDescriptor): staticdata.DescriptorForm
    descriptor(fn: vals.Fn d: ir.Descriptor): Int
    (* Allocates a stack array holding ptrs and returns its address *)
    slotArray(fn: vals.Fn ptrs: Array(Int)): Int
    descriptors(fn: vals.Fn ds: Array(ir.Descriptor)): Array(Int)
    maybeDescriptor(fn: vals.Fn d: maybe.T(ir.Descriptor)): Int
end
