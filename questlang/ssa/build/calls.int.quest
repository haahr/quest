(* Quest Self-Hosted Compiler: The SSA Builder's Calls Interface
 *
 * Lowers IR primitive operations, function calls, and module accesses to SSA.
 * Handles direct calls to unit-local and imported functions, indirect calls
 * through closures (passing the closure environment and type descriptors),
 * inlined runtime helpers, and C ABI argument and result conventions. *)

interface Calls
import
    util/maybe : util/Maybe

    ir = questlang/ir/nodes : questlang/ir/Nodes
    questlang/ssa/build/parts : questlang/ssa/build/Parts
    vals = questlang/ssa/build/values : questlang/ssa/build/Values
    questlang/types/model : questlang/types/Model
export
    Def Type = model.Type
    Def Atom = ir.Atom

    prim(fn: vals.Fn o: ir.OpPrim): Array(Int)

    (* The C ABI result parts for a function type's return type *)
    resultParts(t: Type): Array(parts.Part)
    resultsOf(fn: vals.Fn ps: Array(parts.Part) results: Array(Int)): Array(Int)
    (* Returns the starting argument indices of 16-byte two-word composite
     * arguments in args, offset by lead leading word arguments *)
    pairsOf(lead: Int args: Array(Atom)): Array(Int)
    (* Returns the argument indices in args that C passes as a single byte
     * (such as Bool or Char), offset by lead leading word arguments *)
    narrowOf(lead: Int args: Array(Atom)): Array(Int)
    callOp(fn: vals.Fn o: ir.OpCall): Array(Int)
    (* Emits inline SSA instructions for a call to an external C runtime
     * function defined inline in runtime/quest_runtime.h (word operations and
     * ascii.val), or returns none if symbol is not inlined here *)
    inlineExternal(fn: vals.Fn symbol: String args: Array(Atom)): maybe.T(Int)
    (* A module's record, or one of its members *)
    moduleMember(fn: vals.Fn r: ir.ModuleRef member: maybe.T(String)): Array(Int)
end
