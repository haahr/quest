(* Quest Self-Hosted Compiler: The SSA Builder's Aggregates Interface
 *
 * Builds SSA for representation conversions (the represent pass's plans),
 * tuples, records, variants, options, arrays, and non-thunk type
 * applications *)

interface Aggregates
import
    util/maybe : util/Maybe

    ir = questlang/ir/nodes : questlang/ir/Nodes
    questlang/repr/shapes : questlang/repr/Shapes
    vals = questlang/ssa/build/values : questlang/ssa/build/Values
    questlang/types/model : questlang/types/Model
export
    Def Type = model.Type
    Def Variable = ir.Variable
    Def Atom = ir.Atom

    (* Conversions (the represent pass's plans, ir.Plan) *)
    convert(fn: vals.Fn vs: Array(Int) plan: ir.Plan): Array(Int)
    (* Returns the address of field's slot in record vs (of shape rs). For a
     * bounded type parameter's value, viewMap translates from the concrete
     * type argument to the bound via quest_view_record_slot; otherwise the
     * byte offset is loaded from the record's offset table vs[1]. *)
    recordSlot(fn: vals.Fn vs: Array(Int) rs: shapes.Shape field: String viewMap: maybe.T(Variable)): Int
    fieldShape(rs: shapes.Shape field: String): shapes.Shape
    recordField(fn: vals.Fn vs: Array(Int) rs: shapes.Shape o: ir.OpRecordField): Array(Int)
    makeRecord(fn: vals.Fn o: ir.OpMakeRecord result: Variable): Array(Int)

    (* Tuples *)
    makeTuple(fn: vals.Fn x: ir.OpMakeTuple t: Type): Array(Int)

    (* Variants and options *)
    caseShape(s: shapes.Shape tag: String): maybe.T(shapes.Shape)
    tagShape(t: Type): shapes.Shape
    (* Returns table[v] via an SSA switch, or v directly when table is the
     * identity *)
    mapped(fn: vals.Fn v: Int table: Array(Int)): Int
    makeOption(fn: vals.Fn o: ir.OpMakeOption t: Type): Array(Int)
    (* Returns a pointer to the tuple payload of an option's case, which the
     * case's binder shares. When tagAccess is direct, the payload starts 8
     * bytes past opt (after its tag); otherwise it unproxies opt or calls
     * quest_proxy_option_payload when a component is read through a subtype
     * proxy. *)
    optionCasePayload(fn: vals.Fn opt: Int tagAccess: ir.Access access: Array(ir.Access)): Int
    (* Reads case tag's payload from a variant or option vs held at a bounded
     * type parameter's own view, converting it to type t through the view map
     * vm (which translates from the type argument to the bound ts). Returns a
     * variant's payload, an option's single component, or a freshly allocated
     * tuple of an option's case components (leaving a leading 0 slot for the
     * case ordinal when t has more components than the case). *)
    viewPayload(fn: vals.Fn vs: Array(Int) ts: shapes.Shape tag: String vm: Int t: Type): Array(Int)
    payload(fn: vals.Fn o: ir.OpPayload t: Type): Array(Int)

    (* Arrays *)
    elementShape(a: Atom): shapes.Shape
    (* The address of an array's element, after its bounds check *)
    elementAddress(fn: vals.Fn arr: Int idx: Int offset: maybe.T(Int)): Int
    makeArray(fn: vals.Fn args: Array(Atom) t: Type): Array(Int)
    typeApp(fn: vals.Fn o: ir.OpTypeApp result: Variable): Array(Int)
end
