(* Quest Self-Hosted Compiler: The SSA Builder's Calls Implementation *)

module calls : Calls
import
    questlang/types/model : questlang/types/Model
    ir = questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/shapes : questlang/ir/Shapes
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/codegen/layout : questlang/codegen/Layout
    questlang/codegen/symbols : questlang/codegen/Symbols
    questlang/codegen/runtimeLayout : questlang/codegen/RuntimeLayout
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/sort : util/Sort
    vals = questlang/ssa/build/values : questlang/ssa/build/Values
    descriptors = questlang/ssa/build/descriptors : questlang/ssa/build/Descriptors
export
    Let Type = model.Type
    Let Variable = ir.Variable
    Let Atom = ir.Atom

    (* =========================================================================
     * Primitives
     * ====================================================================== *)

    let prim(fn: vals.Fn o: ir.OpPrim): Array(Int) =
        begin
            let x(): Int = vals.atom1(fn o.args[0])
            let y(): Int = vals.atom1(fn o.args[1])
            let arith(op: ssa.Opcode): Array(Int) = array of vals.binary(fn op x() y()) end
            let checked(helper: String): Array(Int) =
                array of vals.call1(fn helper array of x() y() vals.site(fn o.offset) end) end
            let site(): Array(Int) = array of vals.site(fn o.offset) end
            (* Int division and remainder (quest_int_div_at and quest_int_mod_at,
             * inline): a zero divisor raises int.error, and a divisor of -1,
             * whose one quotient outside Int's range wraps, is negation (or a
             * remainder of 0), which div and rem leave undefined *)
            let divided(op: ssa.Opcode byMinusOne: All(a: Int) Int): Array(Int) =
                begin
                    let a = x()
                    let b = y()
                    vals.check(fn vals.binary(fn ssa.opNe b vals.constant(fn 0)) true "quest_raise_int_error_at" site)
                    vals.choose(fn vals.binary(fn ssa.opEq b vals.constant(fn ~1)) array of vals.tInt end
                        fun(): Array(Int) array of byMinusOne(a) end
                        fun(): Array(Int) array of vals.binary(fn op a b) end)
                end
            (* Real arithmetic (quest_real_add_at and the rest, inline): a NaN
             * result raises real.error, and so, for //, does a zero divisor *)
            let real(op: ssa.Opcode a: Int b: Int): Array(Int) =
                begin
                    let r = vals.binary(fn op a b)
                    let nan = ssa.emit(fn.f fn.cur ssa.opIsNaN array of r end vals.tInt)
                    vals.check(fn nan false "quest_raise_real_error_at" site)
                    array of r end
                end
            (* is, or with isIs false, isnot *)
            let identity(isIs: Bool): Array(Int) =
                begin
                    let first = o.args[0]
                    let same = if layout.isQVal(shapes.shape(ir.atomType(first))) then
                        let args = array of descriptors.maybeDescriptor(fn o.descriptor) vals.atom1(fn o.args[0]) vals.atom1(fn o.args[1]) end
                        vals.narrowed(fn vals.call1(fn "quest_val_is" args) vals.part(vals.tInt 1 false))
                    elsif maybe.isSome(:ir.Descriptor o.descriptor) then
                        (* An option type whose options is compares by case or
                         * component (docs/extensions.md, Options as Values) *)
                        let args = array of descriptors.maybeDescriptor(fn o.descriptor) vals.atom1(fn o.args[0])
                            vals.atom1(fn o.args[1]) end
                        vals.narrowed(fn vals.call1(fn "quest_option_is" args) vals.part(vals.tInt 1 false))
                    else
                        let a = vals.atom(fn o.args[0])
                        let b = vals.atom(fn o.args[1])
                        if extent a isnot 1 then
                            raise vals.unsupported with "is of a value of "
                                <> layout.representation(ir.atomType(first)) end
                        end
                        case ssa.typeOf(fn.f a[0])
                            when typePtr then
                                case o.access
                                    when original then vals.binary(fn ssa.opPeq vals.unproxy(fn a[0]) vals.unproxy(fn b[0]))
                                    when direct, proxy then vals.binary(fn ssa.opPeq a[0] b[0])
                                end
                            when typeReal then vals.binary(fn ssa.opFeq a[0] b[0])
                            when typeInt then vals.binary(fn ssa.opEq a[0] b[0])
                            (* QVal words are the same if their bits are *)
                            when typeVal then
                                vals.binary(fn ssa.opEq vals.fromVal(fn a[0] vals.tInt) vals.fromVal(fn b[0] vals.tInt))
                        end
                    end
                    array of if isIs then same else vals.binary(fn ssa.opXor same vals.constant(fn 1)) end end
                end
            case o.op
                when primNot then array of vals.binary(fn ssa.opXor x() vals.constant(fn 1)) end
                when primExtent then array of vals.loadWord(fn x() runtimeLayout.offset("QArray" "length") vals.tInt) end
                when primDiv then divided(ssa.opDiv fun(a: Int): Int vals.binary(fn ssa.opSub vals.constant(fn 0) a))
                when primRem, primMod then divided(ssa.opRem fun(a: Int): Int vals.constant(fn 0))
                when primRealAdd then real(ssa.opFadd x() y())
                when primRealSub then real(ssa.opFsub x() y())
                when primRealMul then real(ssa.opFmul x() y())
                when primRealDiv then
                    begin
                        let a = x()
                        let b = y()
                        let zero = ssa.realConstant(fn.f fn.cur vals.realBitsOf(0.0))
                        vals.check(fn vals.binary(fn ssa.opFeq b zero) false "quest_raise_real_error_at" site)
                        real(ssa.opFdiv a b)
                    end
                when primRealPow then checked("quest_real_pow_at")
                when primConcat then array of vals.call1(fn "quest_string_concat" array of x() y() end) end
                when primIs then identity(true)
                when primIsnot then identity(false)
                when primAdd then arith(ssa.opAdd)
                when primSub then arith(ssa.opSub)
                when primMul then arith(ssa.opMul)
                when primLt then arith(ssa.opLt)
                when primLe then arith(ssa.opLe)
                when primGt then arith(ssa.opGt)
                when primGe then arith(ssa.opGe)
                when primRealLt then arith(ssa.opFlt)
                when primRealLe then arith(ssa.opFle)
                when primRealGt then arith(ssa.opFgt)
                when primRealGe then arith(ssa.opFge)
                when primAnd then arith(ssa.opAnd)
                when primOr then arith(ssa.opOr)
            end
        end

    (* =========================================================================
     * Calls
     * ====================================================================== *)

    (* The C signature's results of a function type's result *)
    let resultParts(t: Type): Array(vals.Part) =
        begin
            let var s = shapes.shape(t)
            while shapes.kindIs(s shapes.shapeAll) do s := shapes.body(s) end
            if shapes.kindIs(s shapes.shapeFun) then vals.parts(shapes.result(s).type) else vals.parts(s.type) end
        end

    let resultsOf(fn: vals.Fn ps: Array(vals.Part) results: Array(Int)): Array(Int) =
        begin
            let r = array of(extent results 0)
            for i = 0 upto {extent results - 1} do r[i] := vals.narrowed(fn results[i] ps[i]) end
            r
        end

    (* Where each 16-byte composite starts among a call's arguments, from the
     * IR atoms that make them (after leading words) *)
    let pairsOf(lead: Int args: Array(Atom)): Array(Int) =
        begin
            let starts = vector.new(:Int)
            let var at = lead
            for i = 0 upto {extent args - 1} do
                let n = extent vals.parts(ir.atomType(args[i]))
                if n is 2 then vector.append(:Int starts at) end
                at := at + {if n is 0 then 1 else n end}
            end
            vector.toArray(:Int starts)
        end

    (* Which of a call's arguments C passes as one byte, from the IR atoms
     * that make them (after leading words) *)
    let narrowOf(lead: Int args: Array(Atom)): Array(Int) =
        begin
            let found = vector.new(:Int)
            let var at = lead
            for i = 0 upto {extent args - 1} do
                let ps = vals.parts(ir.atomType(args[i]))
                if {extent ps is 1} andif {ps[0].width is 1} then vector.append(:Int found at) end
                at := at + {if extent ps is 0 then 1 else extent ps end}
            end
            vector.toArray(:Int found)
        end

    (* A direct call whose results are ps *)
    let directCallOf(fn: vals.Fn symbol: String lead: Array(Int) args: Array(Atom) ps: Array(vals.Part)): Array(Int) =
        begin
            let vs = vals.callQuest(fn symbol vals.concat(lead vals.callAtoms(fn args)) pairsOf(extent lead args)
                narrowOf(extent lead args) ps)
            resultsOf(fn ps vs)
        end

    let directCall(fn: vals.Fn symbol: String lead: Array(Int) args: Array(Atom) resultType: Type): Array(Int) =
        directCallOf(fn symbol lead args resultParts(resultType))

    let calleeResultType(t: Type): Type = t

    (* A call of the closure the variable holds: its function directly, when
     * the variable is bound to a closure of one of the unit's functions, or
     * through its function pointer *)
    let rec callClosure(fn: vals.Fn callee: Variable descs: Array(Int) args: Array(Atom)): Array(Int) =
        begin
            let known = hashMap.get(:Int :ir.OpMakeClosure fn.u.closureVars callee.id)
            if maybe.isSome(:ir.OpMakeClosure known)
                andif {extent maybe.unwrap(:ir.OpMakeClosure known).typeArgs is 0} then
                let k = maybe.unwrap(:ir.OpMakeClosure known)
                let env = if extent k.captures is 0 then vals.null(fn)
                    else vals.loadWord(fn vals.atom1(fn ir.atomOfVar(callee)) runtimeLayout.offset("QClosure" "env") vals.tPtr)
                end
                (* A function returning an unboxed tuple returns its
                 * components (questlang/ir/unbox) *)
                let ps = if k.code.unboxedResult then vals.unboxedParts(k.code.resultType) else resultParts(callee.type) end
                directCallOf(fn vals.codeName(fn.u k.code) vals.concat(array of env end descs) args ps)
            else
                indirectCall(fn callee descs args)
            end
        end

    and indirectCall(fn: vals.Fn callee: Variable descs: Array(Int) args: Array(Atom)): Array(Int) =
        begin
            let clos = vals.atom1(fn ir.atomOfVar(callee))
            let fnPtr = vals.loadWord(fn clos runtimeLayout.offset("QClosure" "fn") vals.tPtr)
            let env = vals.loadWord(fn clos runtimeLayout.offset("QClosure" "env") vals.tPtr)
            let ps = resultParts(callee.type)
            let all = vals.concat(vals.concat(array of fnPtr env end descs) vals.callAtoms(fn args))
            let vs = vals.callQuest(fn "" all pairsOf({2 + extent descs} args) narrowOf({2 + extent descs} args) ps)
            resultsOf(fn ps vs)
        end

    let moduleOf(r: ir.ModuleRef): maybe.T(ir.Module) =
        case r when refModule with x then maybe.some(:ir.Module x.m) else maybe.none(:ir.Module) end
    let importOf(r: ir.ModuleRef): maybe.T(ir.Import) =
        case r when refImport with x then maybe.some(:ir.Import x.i) else maybe.none(:ir.Import) end

    (* Whether a function type's parameters and result are all held as words
     * or bytes, not QVal words (or the result is Ok): a library function's
     * wrapper then has the C function's signature (as the C printer's
     * libraryExternal requires) *)
    let concrete(t: maybe.T(Type)): Bool =
        if maybe.isNone(:Type t) then false
        else
            case maybe.unwrap(:Type t).form
                when typeFun with f then
                    let unboxed(p: Type): Bool =
                        case layout.representationKind(p)
                            when repInt, repWord, repBool, repChar, repPointer then true
                            else false
                        end
                    let var all = case layout.representationKind(f.result) when repVoid then true else unboxed(f.result) end
                    for i = 0 upto {extent f.params - 1} do
                        if not(unboxed(f.params[i].type)) then all := false end
                    end
                    all
                else false
            end
        end

    (* The constant an atom is, if it is an Int's *)
    let constantOf(a: Atom): maybe.T(Int) =
        case a
            when atomConst with x then
                case x.c.value when constInt with y then maybe.some(:Int y.n) else maybe.none(:Int) end
            else maybe.none(:Int)
        end

    (* A call of one of the standard library's external functions that C
     * inlines (runtime/quest_runtime.h's word primitives, and the string's
     * and ascii's that read or write a byte), as the instructions it is: the
     * C backend calls the C function itself (the C printer's libraryExternal),
     * which clang inlines, and the SSA would otherwise call the module's
     * wrapper. The rest, and a shift by a count that is not a constant, call
     * the wrapper. *)
    let libraryOperation(fn: vals.Fn imp: ir.Import member: String o: ir.OpCall): maybe.T(Array(Int)) =
        begin
            let none = maybe.none(:Array(Int))
            let one(v: Int): maybe.T(Array(Int)) = maybe.some(:Array(Int) array of v end)
            let x(): Int = vals.atom1(fn o.args[0])
            let y(): Int = vals.atom1(fn o.args[1])
            let binary(op: ssa.Opcode): maybe.T(Array(Int)) = one(vals.binary(fn op x() y()))
            let negated(v: Int): Int = vals.binary(fn ssa.opXor v vals.constant(fn 1))
            let noSite = fun(): Array(Int) array of :Int end
            (* A string's byte at an index, after the check of
             * quest_string_get_char and quest_string_set_char: a null string,
             * or an index outside it, raises string.error *)
            let byteAddress(s: Int idx: Int): Int =
                begin
                    vals.check(fn vals.binary(fn ssa.opPeq s vals.null(fn)) false "quest_raise_string_error" noSite)
                    let length = vals.loadWord(fn s runtimeLayout.offset("QString" "length") vals.tInt)
                    vals.check(fn vals.binary(fn ssa.opUlt idx length) true "quest_raise_string_error" noSite)
                    vals.indexPtr(fn vals.loadWord(fn s runtimeLayout.offset("QString" "data") vals.tPtr) idx)
                end
            let named(name: String): Bool = vals.eq(member name)
            if maybe.isNone(:String imp.libPath) orif not(concrete(o.calleeType)) then none
            else
                let lib = maybe.unwrap(:String imp.libPath)
                if vals.eq(lib "word") then
                    if named("andBits") then binary(ssa.opAnd)
                    elsif named("orBits") then binary(ssa.opOr)
                    elsif named("xorBits") then binary(ssa.opXor)
                    elsif named("notBits") then one(vals.binary(fn ssa.opXor x() vals.constant(fn ~1)))
                    elsif named("add") then binary(ssa.opAdd)
                    elsif named("sub") then binary(ssa.opSub)
                    elsif named("mul") then binary(ssa.opMul)
                    elsif named("fromInt") orif named("toInt") then one(x())
                    elsif named("lt") then binary(ssa.opUlt)
                    elsif named("gt") then one(vals.binary(fn ssa.opUlt y() x()))
                    elsif named("le") then one(negated(vals.binary(fn ssa.opUlt y() x())))
                    elsif named("ge") then one(negated(vals.binary(fn ssa.opUlt x() y())))
                    elsif named("shift") then
                        (* quest_word_shift: left by a positive count, right by
                         * a negative one, 0 by one of 64 or more either way;
                         * by a constant, one instruction or none *)
                        let w = x()
                        let count = constantOf(o.args[1])
                        if maybe.isSome(:Int count) then
                            let n = maybe.unwrap(:Int count)
                            if {n >= 64} orif {n <= ~64} then one(vals.constant(fn 0))
                            elsif n > 0 then one(vals.binary(fn ssa.opShl w vals.constant(fn n)))
                            elsif n < 0 then one(vals.binary(fn ssa.opLshr w vals.constant(fn 0 - n)))
                            else one(w)
                            end
                        else
                            let n = y()
                            let shifted(op: ssa.Opcode by: Int): Array(Int) =
                                vals.choose(fn vals.binary(fn ssa.opUlt by vals.constant(fn 64)) array of vals.tInt end
                                    fun(): Array(Int) array of vals.binary(fn op w by) end
                                    fun(): Array(Int) array of vals.constant(fn 0) end)
                            maybe.some(:Array(Int) vals.choose(fn vals.binary(fn ssa.opLt n vals.constant(fn 0))
                                array of vals.tInt end
                                fun(): Array(Int) shifted(ssa.opLshr vals.binary(fn ssa.opSub vals.constant(fn 0) n))
                                fun(): Array(Int) shifted(ssa.opShl n)))
                        end
                    else none
                    end
                elsif vals.eq(lib "ascii") then
                    (* A Char is held zero-extended *)
                    if named("val") then one(x())
                    elsif named("char") then
                        let n = x()
                        vals.check(fn vals.binary(fn ssa.opUlt n vals.constant(fn 256)) true "quest_raise_ascii_error"
                            noSite)
                        one(n)
                    else none
                    end
                elsif vals.eq(lib "string") then
                    if named("length") then
                        let s = x()
                        maybe.some(:Array(Int) vals.choose(fn vals.binary(fn ssa.opPeq s vals.null(fn))
                            array of vals.tInt end
                            fun(): Array(Int) array of vals.constant(fn 0) end
                            fun(): Array(Int)
                                array of vals.loadWord(fn s runtimeLayout.offset("QString" "length") vals.tInt) end))
                    elsif named("getChar") then
                        one(vals.load(fn byteAddress(x() y()) 0 vals.part(vals.tInt 1 false)))
                    elsif named("setChar") then
                        vals.store(fn byteAddress(x() y()) 0 1 vals.atom1(fn o.args[2]))
                        maybe.some(:Array(Int) array of :Int end)
                    else none
                    end
                else none
                end
            end
        end

    let callOp(fn: vals.Fn o: ir.OpCall): Array(Int) =
        begin
            let descs = descriptors.descriptors(fn o.descriptors)
            if maybe.isNone(:Variable o.callee) then
                let r = maybe.unwrap(:ir.ModuleRef o.moduleRef)
                let member = maybe.unwrap(:String o.member)
                if maybe.isSome(:ir.Module moduleOf(r)) then
                    let v = maybe.unwrap(:Variable ir.member(maybe.unwrap(:ir.Module moduleOf(r)).members member))
                    callClosure(fn v descs o.args)
                else
                    let imp = maybe.unwrap(:ir.Import importOf(r))
                    let inline = libraryOperation(fn imp member o)
                    if maybe.isSome(:Array(Int) inline) then maybe.unwrap(:Array(Int) inline)
                    else
                        let clean = symbols.mangleModuleName(imp.canonicalPath)
                        let calleeType = maybe.unwrapOr(:Type o.calleeType model.okType)
                        directCall(fn symbols.mangleModuleIdent(clean member) descs o.args calleeType)
                    end
                end
            else
                callClosure(fn maybe.unwrap(:Variable o.callee) descs o.args)
            end
        end

    (* =========================================================================
     * Module members
     * ====================================================================== *)

    (* An imported module's member, from its record: the field's offset in the
     * record's payload is in the record's offset table, at the field's index in
     * name order *)
    let sortBefore(a: String b: String): Bool = sort.stringCompare(a b) < 0

    let importedMember(fn: vals.Fn imp: ir.Import member: String): Array(Int) =
        begin
            let clean = symbols.mangleModuleName(imp.canonicalPath)
            let recordAt = vals.symbolAt(fn symbols.moduleRecordIdent(clean))
            if maybe.isNone(:Type imp.recordType) then raise vals.unsupported with "module " <> imp.name
                <> ": its interface is unknown" end end
            let recType = maybe.unwrap(:Type imp.recordType)
            let fields = case recType.form
                when typeRecord with rt then rt.fields
                else vector.toArray(:model.RecordField vector.new(:model.RecordField))
            end
            let var fieldType = model.okType
            let var index = 0
            for i = 0 upto {extent fields - 1} do
                if vals.eq(fields[i].name member) then fieldType := fields[i].type end
                if sortBefore(fields[i].name member) then index := index + 1 end
            end
            let val = vals.loadWord(fn recordAt runtimeLayout.offset("QRecordVal" "val") vals.tPtr)
            let dict = vals.loadWord(fn recordAt runtimeLayout.offset("QRecordVal" "dict") vals.tPtr)
            let offset = vals.loadWord(fn dict 8 * index vals.tInt)
            vals.readSlot(fn vals.indexPtr(fn val offset) fieldType)
        end

    let moduleMember(fn: vals.Fn r: ir.ModuleRef member: maybe.T(String)): Array(Int) =
        case r
            when refModule with x then
                if maybe.isNone(:String member) then
                    let recordAt = vals.symbolAt(fn symbols.moduleRecordIdent(symbols.mangleModuleName(x.m.name)))
                    array of
                        vals.loadWord(fn recordAt runtimeLayout.offset("QRecordVal" "val") vals.tPtr)
                        vals.loadWord(fn recordAt runtimeLayout.offset("QRecordVal" "dict") vals.tPtr)
                    end
                else
                    vals.read(fn maybe.unwrap(:Variable ir.member(x.m.members maybe.unwrap(:String member))))
                end
            when refImport with x then
                if maybe.isNone(:String member) then
                    let recordAt = vals.symbolAt(fn symbols.moduleRecordIdent(symbols.mangleModuleName(x.i.canonicalPath)))
                    array of
                        vals.loadWord(fn recordAt runtimeLayout.offset("QRecordVal" "val") vals.tPtr)
                        vals.loadWord(fn recordAt runtimeLayout.offset("QRecordVal" "dict") vals.tPtr)
                    end
                else
                    importedMember(fn x.i maybe.unwrap(:String member))
                end
        end
end
