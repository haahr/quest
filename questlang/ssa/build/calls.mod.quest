(* Quest Self-Hosted Compiler: The SSA Builder's Calls Implementation *)

module calls : Calls
import
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/sort : util/Sort

    ir = questlang/ir/nodes : questlang/ir/Nodes
    questlang/repr/externals : questlang/repr/Externals
    questlang/repr/layout : questlang/repr/Layout
    questlang/repr/runtimeLayout : questlang/repr/RuntimeLayout
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/repr/symbols : questlang/repr/Symbols
    descriptors = questlang/ssa/build/descriptors : questlang/ssa/build/Descriptors
    questlang/ssa/build/objects : questlang/ssa/build/Objects
    questlang/ssa/build/parts : questlang/ssa/build/Parts
    vals = questlang/ssa/build/values : questlang/ssa/build/Values
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/types/model : questlang/types/Model
export
    Let Type = model.Type
    Let Variable = ir.Variable
    Let Atom = ir.Atom

    (* =========================================================================
     * Primitives
     * ====================================================================== *)

    let prim(fn: vals.Fn o: ir.OpPrim): Array(Int) =
        begin
            let x(): Int = vals.atom1(fn o.args[0])
            let y(): Int = vals.atom1(fn o.args[1])
            let arith(op: ssa.Opcode): Array(Int) = array of vals.binary(fn op x() y()) end
            let checked(helper: String): Array(Int) =
                array of vals.call1(fn helper array of x() y() vals.site(fn o.offset) end) end
            let site(): Array(Int) = array of vals.site(fn o.offset) end
            (* Lowers Int division and remainder inline (matching
             * quest_int_div_at and quest_int_mod_at). A zero divisor raises
             * int.error. A divisor of -1 is handled separately because
             * INT64_MIN / -1 overflows signed division (leaving SSA opDiv and
             * opRem undefined); byMinusOne yields wrapping negation for
             * division or 0 for remainder. *)
            let divided(op: ssa.Opcode byMinusOne: All(a: Int) Int): Array(Int) =
                begin
                    let a = x()
                    let b = y()
                    vals.check(fn vals.binary(fn ssa.opNe b vals.constant(fn 0)) true "quest_raise_int_error_at" site)
                    objects.choose(fn vals.binary(fn ssa.opEq b vals.constant(fn ~1)) array of vals.tInt end
                            fun(): Array(Int) array of byMinusOne(a) end
                            fun(): Array(Int) array of vals.binary(fn op a b) end)
                end
            (* Lowers Real arithmetic inline (matching quest_real_add_at and
             * its siblings): any NaN result raises real.error. Division (//)
             * checks for a zero divisor before calling this helper. *)
            let real(op: ssa.Opcode a: Int b: Int): Array(Int) =
                begin
                    let r = vals.binary(fn op a b)
                    let nan = ssa.emit(fn.f fn.cur ssa.opIsNaN array of r end vals.tInt)
                    vals.check(fn nan false "quest_raise_real_error_at" site)
                    array of r end
                end
            (* is, or with isIs false, isnot *)
            let identity(isIs: Bool): Array(Int) =
                begin
                    let first = o.args[0]
                    let same =
                        if layout.isQVal(shapes.shape(ir.atomType(first))) then
                            let args =
                                array of descriptors.maybeDescriptor(fn o.descriptor)
                                    vals.atom1(fn o.args[0])
                                    vals.atom1(fn o.args[1])
                                end
                            vals.narrowed(fn vals.call1(fn "quest_val_is" args) parts.part(vals.tInt 1 false))
                        elsif maybe.isSome(o.descriptor)
                                andif vals.eq(layout.representation(ir.atomType(first)) "QVariantVal") then
                            (* Compares variants by tag and payload value (see
                             * docs/extensions.md, "Variants as Values") *)
                            let a = vals.atom(fn o.args[0])
                            let b = vals.atom(fn o.args[1])
                            let args = array of descriptors.maybeDescriptor(fn o.descriptor) a[0] a[1] b[0] b[1] end
                            vals.narrowed(fn vals.call1(fn "quest_variant_is" args) parts.part(vals.tInt 1 false))
                        elsif vals.eq(layout.representation(ir.atomType(first)) "QRecordVal") then
                            (* Record identity compares payload pointers only: a
                             * supertype view (quest_record_view) replaces the
                             * offset table without changing the record itself *)
                            vals.binary(fn ssa.opPeq vals.atom(fn o.args[0])[0] vals.atom(fn o.args[1])[0])
                        elsif maybe.isSome(o.descriptor) then
                            (* Compares option values by case or component using
                             * their descriptor (docs/extensions.md, "Options as
                             * Values") *)
                            let args = array of descriptors.maybeDescriptor(fn o.descriptor) vals.atom1(fn o.args[0])
                                vals.atom1(fn o.args[1])
                            end
                            vals.narrowed(fn vals.call1(fn "quest_option_is" args) parts.part(vals.tInt 1 false))
                        else
                            let a = vals.atom(fn o.args[0])
                            let b = vals.atom(fn o.args[1])
                            if extent a isnot 1 then
                                raise vals.unsupported with "is of a value of "
                                    <> layout.representation(ir.atomType(first)) end
                            end
                            case ssa.typeOf(fn.f a[0])
                                when typePtr then
                                    case o.access
                                        when original then
                                            vals.binary(fn ssa.opPeq objects.unproxy(fn a[0])
                                                    objects.unproxy(fn b[0]))
                                        when direct, proxy then vals.binary(fn ssa.opPeq a[0] b[0])
                                    end
                                when typeReal then vals.binary(fn ssa.opFeq a[0] b[0])
                                when typeInt then vals.binary(fn ssa.opEq a[0] b[0])
                                (* QVal words are the same if their bits are *)
                                when typeVal then
                                    vals.binary(fn ssa.opEq vals.fromVal(fn a[0] vals.tInt)
                                            vals.fromVal(fn b[0] vals.tInt))
                            end
                        end
                    array of if isIs then same else vals.binary(fn ssa.opXor same vals.constant(fn 1)) end end
                end
            case o.op
                when primNot then array of vals.binary(fn ssa.opXor x() vals.constant(fn 1)) end
                when primExtent then
                    array of vals.invariantWord(fn x() runtimeLayout.offset("QArray" "length") vals.tInt) end
                when primDiv then divided(ssa.opDiv fun(a: Int): Int vals.binary(fn ssa.opSub vals.constant(fn 0) a))
                when primRem, primMod then divided(ssa.opRem fun(a: Int): Int vals.constant(fn 0))
                when primRealAdd then real(ssa.opFadd x() y())
                when primRealSub then real(ssa.opFsub x() y())
                when primRealMul then real(ssa.opFmul x() y())
                when primRealDiv then
                    begin
                        let a = x()
                        let b = y()
                        let zero = ssa.realConstant(fn.f fn.cur vals.realBitsOf(0.0))
                        vals.check(fn vals.binary(fn ssa.opFeq b zero) false "quest_raise_real_error_at" site)
                        real(ssa.opFdiv a b)
                    end
                when primRealPow then checked("quest_real_pow_at")
                when primConcat then array of vals.call1(fn "quest_string_concat" array of x() y() end) end
                when primIs then identity(true)
                when primIsnot then identity(false)
                when primAdd then arith(ssa.opAdd)
                when primSub then arith(ssa.opSub)
                when primMul then arith(ssa.opMul)
                when primLt then arith(ssa.opLt)
                when primLe then arith(ssa.opLe)
                when primGt then arith(ssa.opGt)
                when primGe then arith(ssa.opGe)
                when primRealLt then arith(ssa.opFlt)
                when primRealLe then arith(ssa.opFle)
                when primRealGt then arith(ssa.opFgt)
                when primRealGe then arith(ssa.opFge)
                when primAnd then arith(ssa.opAnd)
                when primOr then arith(ssa.opOr)
            end
        end

    (* =========================================================================
     * Calls
     * ====================================================================== *)

    (* The C ABI result parts for a function type's return type *)
    let resultParts(t: Type): Array(parts.Part) =
        begin
            let var s = shapes.shape(t)
            while shapes.kindIs(s shapes.shapeAll) do s := shapes.body(s) end
            if shapes.kindIs(s shapes.shapeFun) then parts.ofType(shapes.result(s).type) else parts.ofType(s.type) end
        end

    let resultsOf(fn: vals.Fn ps: Array(parts.Part) results: Array(Int)): Array(Int) =
        begin
            let r = array of(extent results 0)
            for i = 0 upto {extent results - 1} do r[i] := vals.narrowed(fn results[i] ps[i]) end
            r
        end

    (* Returns the starting argument indices of 16-byte two-word composite
     * arguments in args, offset by lead leading word arguments *)
    let pairsOf(lead: Int args: Array(Atom)): Array(Int) =
        begin
            let starts = vector.new(:Int)
            let var at = lead
            for i = 0 upto {extent args - 1} do
                let n = extent parts.ofType(ir.atomType(args[i]))
                if n is 2 then vector.append(starts at) end
                at := at + {if n is 0 then 1 else n end}
            end
            vector.toArray(starts)
        end

    (* Returns the argument indices in args that C passes as a single byte
     * (such as Bool or Char), offset by lead leading word arguments *)
    let narrowOf(lead: Int args: Array(Atom)): Array(Int) =
        begin
            let found = vector.new(:Int)
            let var at = lead
            for i = 0 upto {extent args - 1} do
                let ps = parts.ofType(ir.atomType(args[i]))
                if {extent ps is 1} andif {ps[0].width is 1} then vector.append(found at) end
                at := at + {if extent ps is 0 then 1 else extent ps end}
            end
            vector.toArray(found)
        end

    (* An Int constant's value, if the atom is one *)
    let intConstant(a: Atom): maybe.T(Int) =
        case a
            when atomConst with x then
                case x.c.value when constInt with k then maybe.some(k.n) else maybe.none() end
            when atomVar then maybe.none()
        end

    (* Emits inline SSA instructions for external C runtime functions defined
     * inline in runtime/quest_runtime.h: word arithmetic, bitwise operations,
     * unsigned comparisons, int/word conversions, constant-count shifts and
     * rotations, ascii.val (since Char is already held zero-extended), and
     * real.int, which is a conversion (scvtf on arm64), rounding to nearest
     * as C's (double) does, though the runtime defines it out of line.
     * Returns none for any other symbol. *)
    let inlineExternal(fn: vals.Fn symbol: String args: Array(Atom)): maybe.T(Int) =
        begin
            let x(): Int = vals.atom1(fn args[0])
            let y(): Int = vals.atom1(fn args[1])
            let one(v: Int): maybe.T(Int) = maybe.some(v)
            let both(op: ssa.Opcode): maybe.T(Int) = one(vals.binary(fn op x() y()))
            let below(a: Int b: Int): Int = vals.binary(fn ssa.opUlt a b)
            let inverted(v: Int): Int = vals.binary(fn ssa.opXor v vals.constant(fn 1))
            let named(name: String): Bool = vals.eq(symbol name)
            let count = if extent args is 2 then intConstant(args[1]) else maybe.none(:Int) end
            if named("quest_word_from_int") orif named("quest_word_to_int") orif named("quest_ascii_val") then one(x())
            elsif named("quest_real_from_int") then one(vals.unary(fn ssa.opIntToReal x() vals.tReal))
            elsif named("quest_word_add") then both(ssa.opAdd)
            elsif named("quest_word_sub") then both(ssa.opSub)
            elsif named("quest_word_mul") then both(ssa.opMul)
            elsif named("quest_word_mul_hi") then both(ssa.opMulHiU)
            elsif named("quest_word_and_bits") then both(ssa.opAnd)
            elsif named("quest_word_or_bits") then both(ssa.opOr)
            elsif named("quest_word_xor_bits") then both(ssa.opXor)
            elsif named("quest_word_not_bits") then one(vals.binary(fn ssa.opXor x() vals.constant(fn ~1)))
            elsif named("quest_word_lt") then one(below(x() y()))
            elsif named("quest_word_gt") then
                let a = x()
                one(below(y() a))
            elsif named("quest_word_le") then
                let a = x()
                one(inverted(below(y() a)))
            elsif named("quest_word_ge") then one(inverted(below(x() y())))
            elsif named("quest_word_shift_val") andif maybe.isSome(count) then
                (* Positive counts shift left, negative counts shift right
                 * logically, and counts of magnitude 64 or more yield 0 *)
                let c = maybe.unwrap(count)
                if {c >= 64} orif {c <= ~64} then
                    one(vals.constant(fn 0))
                elsif c > 0 then
                    one(vals.binary(fn ssa.opShl x() vals.constant(fn c)))
                elsif c < 0 then
                    one(vals.binary(fn ssa.opLshr x() vals.constant(fn 0 - c)))
                else
                    one(x())
                end
            elsif named("quest_word_rotate_val") andif maybe.isSome(count) then
                (* A left rotation by the count modulo 64 *)
                let c = maybe.unwrap(count) % 64
                let s = if c < 0 then c + 64 else c end
                if s is 0 then
                    one(x())
                else
                    let w = x()
                    let left = vals.binary(fn ssa.opShl w vals.constant(fn s))
                    one(vals.binary(fn ssa.opOr left vals.binary(fn ssa.opLshr w vals.constant(fn 64 - s))))
                end
            else
                maybe.none()
            end
        end

    (* A call of one of the standard library's external functions that C
     * inlines, as the instructions it is, where inlineExternal does not
     * already make them: a word shift by a count that is not a constant, and
     * the string's and ascii's operations that read or write a byte; none for
     * any other symbol. The C backend calls the C function itself (the C
     * printer's libraryExternal), which clang inlines, and the SSA would
     * otherwise call it. It is reached both from an imported member, through
     * libraryExternal's symbol for it (callOp), and from a member of a module
     * in the unit, through the symbol its thunk forwards to (callClosure), as
     * whole-program compilation calls them *)
    let externalOperation(fn: vals.Fn symbol: String args: Array(Atom)): maybe.T(Array(Int)) =
        begin
            let none = maybe.none(:Array(Int))
            let one(v: Int): maybe.T(Array(Int)) = maybe.some(array of v end)
            let x(): Int = vals.atom1(fn args[0])
            let y(): Int = vals.atom1(fn args[1])
            let noSite = fun(): Array(Int) array of :Int end
            (* A string's byte at an index, after the check of
             * quest_string_get_char and quest_string_set_char: a null string,
             * or an index outside it, raises string.error *)
            let byteAddress(s: Int idx: Int): Int =
                begin
                    vals.check(fn vals.binary(fn ssa.opPeq s vals.null(fn)) false "quest_raise_string_error" noSite)
                    let length = vals.invariantWord(fn s runtimeLayout.offset("QString" "length") vals.tInt)
                    vals.check(fn vals.binary(fn ssa.opUlt idx length) true "quest_raise_string_error" noSite)
                    vals.indexPtr(fn vals.invariantWord(fn s runtimeLayout.offset("QString" "data") vals.tPtr) idx)
                end
            let named(name: String): Bool = vals.eq(symbol name)
            if named("quest_word_shift_val") andif maybe.isNone(intConstant(args[1])) then
                (* quest_word_shift: left by a positive count, right by a
                 * negative one, 0 by one of 64 or more either way *)
                begin
                    let w = x()
                    let n = y()
                    let shifted(op: ssa.Opcode by: Int): Array(Int) =
                        objects.choose(fn vals.binary(fn ssa.opUlt by vals.constant(fn 64))
                                array of vals.tInt end
                                fun(): Array(Int) array of vals.binary(fn op w by) end
                                fun(): Array(Int) array of vals.constant(fn 0) end)
                    maybe.some(objects.choose(fn vals.binary(fn ssa.opLt n vals.constant(fn 0))
                            array of vals.tInt end
                            fun(): Array(Int) shifted(ssa.opLshr vals.binary(fn ssa.opSub vals.constant(fn 0) n))
                            fun(): Array(Int) shifted(ssa.opShl n)))
                end
            elsif named("quest_ascii_char") then
                (* A Char is held zero-extended *)
                let n = x()
                vals.check(fn vals.binary(fn ssa.opUlt n vals.constant(fn 256)) true "quest_raise_ascii_error" noSite)
                one(n)
            elsif named("quest_string_length") then
                let s = x()
                maybe.some(objects.choose(fn vals.binary(fn ssa.opPeq s vals.null(fn))
                        array of vals.tInt end
                        fun(): Array(Int) array of vals.constant(fn 0) end
                        fun(): Array(Int)
                            array of vals.invariantWord(fn s runtimeLayout.offset("QString" "length") vals.tInt) end))
            elsif named("quest_string_get_char") then
                one(vals.load(fn byteAddress(x() y()) 0 parts.part(vals.tInt 1 false)))
            elsif named("quest_string_set_char") then
                let s = x()
                let address = byteAddress(s y())
                (* A read-only string (a literal) raises string.error, as
                 * quest_string_set_char does: its header's bit, in the byte of
                 * the word before the string that holds it *)
                let bit = runtimeLayout.constant("Q_HEADER_READONLY_BIT")
                let headerByte = vals.load(fn s {bit / 8} - 8 parts.part(vals.tInt 1 false))
                let var mask = 1
                for k = 1 upto {bit % 8} do mask := 2 * mask end
                let clear = vals.binary(fn ssa.opEq vals.binary(fn ssa.opAnd headerByte vals.constant(fn mask))
                        vals.constant(fn 0))
                vals.check(fn clear true "quest_raise_string_error" noSite)
                vals.store(fn address 0 1 vals.atom1(fn args[2]))
                maybe.some(array of :Int end)
            else
                none
            end
        end

    (* A direct call whose results are ps *)
    let directCallOf(fn: vals.Fn symbol: String lead: Array(Int) args: Array(Atom) ps: Array(parts.Part)): Array(Int) =
        begin
            let vs = vals.callQuest(fn symbol vals.concat(lead vals.callAtoms(fn args)) pairsOf(extent lead args)
                    narrowOf(extent lead args) ps)
            resultsOf(fn ps vs)
        end

    let directCall(fn: vals.Fn symbol: String lead: Array(Int) args: Array(Atom) resultType: Type): Array(Int) =
        directCallOf(fn symbol lead args resultParts(resultType))

    (* Returns the external C symbol if f is a simple forwarding thunk
     * (questlang/ir/thunks) that takes no type descriptors, calls the external
     * with f's value parameters in order, and immediately returns the result
     * (or ok). Returns none otherwise. *)
    let forwardedExternal(f: ir.Function): maybe.T(String) =
        begin
            let stmts = f.body.statements
            let var found = maybe.none(:String)
            if {vector.length(stmts) is 2} andif {extent f.descriptorParams is 0} then
                let call =
                    case vector.get(stmts 0)
                        when sLet with x then maybe.some(x.value)
                        when sDo with x then maybe.some(x.value)
                        else maybe.none(:ir.Op)
                    end
                let returns = case vector.get(stmts 1) when sReturn then true else false end
                case maybe.unwrapOr(call option opAtom of ir.Op with let var atom = ir.atomOfVar(f.v) end)
                    when opCallExternal with x then
                        let var forwards = returns andif {extent x.descriptors is 0}
                            andif {extent x.args is extent f.params}
                        for i = 0 upto {extent x.args - 1} do
                            let same =
                                case x.args[i]
                                    when atomVar with a then
                                        forwards andif {a.v.id is f.params[i].v.id}
                                            andif vals.eq(f.params[i].mode "value")
                                    when atomConst then false
                                end
                            if not(same) then forwards := false end
                        end
                        if forwards then found := maybe.some(x.symbol) end
                    else ok
                end
            end
            found
        end

    (* Lowers a call to the closure held in callee. When callee is statically
     * known to hold a closure of a unit-local function with no captured type
     * arguments, this emits a direct call to that function (or directly to the
     * external C function, or inline SSA, when it is an external's thunk);
     * otherwise it loads and calls the closure's function pointer. *)
    let rec callClosure(fn: vals.Fn callee: Variable descs: Array(Int) args: Array(Atom)): Array(Int) =
        begin
            let known = hashMap.get(fn.u.closureVars callee.id)
            if maybe.isSome(known)
                    andif {extent maybe.unwrap(:ir.OpMakeClosure known).typeArgs is 0} then
                let k = maybe.unwrap(known)
                (* The code's first argument is the closure itself, which
                 * holds its captures *)
                let env = if extent k.captures is 0 then vals.null(fn) else vals.atom1(fn ir.atomOfVar(callee)) end
                (* A function returning an unboxed tuple returns its
                 * components (questlang/ir/unbox) *)
                let ps =
                    if k.code.unboxedResult then parts.unboxedParts(k.code.resultType) else resultParts(callee.type) end
                let thunked = forwardedExternal(k.code)
                let operation =
                    if maybe.isSome(thunked) then
                        externalOperation(fn maybe.unwrap(thunked) args)
                    else
                        maybe.none(:Array(Int))
                    end
                let inlined =
                    if maybe.isSome(thunked) andif maybe.isNone(operation) then
                        inlineExternal(fn maybe.unwrap(thunked) args)
                    else
                        maybe.none(:Int)
                    end
                if maybe.isSome(operation) then
                    maybe.unwrap(operation)
                elsif maybe.isSome(inlined) then
                    array of maybe.unwrap(inlined) end
                elsif maybe.isSome(thunked) then
                    directCallOf(fn maybe.unwrap(thunked) array of :Int end args ps)
                else
                    (* Convert arguments and results to the callee's own SSA
                     * types (vals.retyped), which may use a pointer where the
                     * closure's type uses a uniform QVal word *)
                    let lead = vals.concat(array of env end descs)
                    let all = vals.retyped(fn vals.concat(lead vals.callAtoms(fn args)) vals.codeParamTypes(k.code))
                    let vs = vals.callQuest(fn vals.codeName(fn.u k.code) all pairsOf(extent lead args)
                            narrowOf(extent lead args) vals.codeResultParts(k.code))
                    resultsOf(fn ps vals.retyped(fn vs parts.typesOf(ps)))
                end
            else
                indirectCall(fn callee descs args)
            end
        end

    and indirectCall(fn: vals.Fn callee: Variable descs: Array(Int) args: Array(Atom)): Array(Int) =
        begin
            let clos = vals.atom1(fn ir.atomOfVar(callee))
            let fnPtr = vals.invariantWord(fn clos runtimeLayout.offset("QClosure" "fn") vals.tPtr)
            let ps = resultParts(callee.type)
            let all = vals.concat(vals.concat(array of fnPtr clos end descs) vals.callAtoms(fn args))
            let vs = vals.callQuest(fn "" all pairsOf({2 + extent descs} args) narrowOf({2 + extent descs} args) ps)
            resultsOf(fn ps vs)
        end

    let moduleOf(r: ir.ModuleRef): maybe.T(ir.Module) =
        case r when refModule with x then maybe.some(x.m) else maybe.none() end
    let importOf(r: ir.ModuleRef): maybe.T(ir.Import) =
        case r when refImport with x then maybe.some(x.i) else maybe.none() end

    (* Reports whether every parameter of function type t is represented as an
     * Int, Word, Bool, Char, or pointer (and the result is one of those or
     * void). Only then does a library wrapper match the C function's
     * signature, as required by the C printer's libraryExternal. *)
    let concrete(t: maybe.T(Type)): Bool =
        if maybe.isNone(t) then
            false
        else
            case maybe.unwrap(t).form
                when typeFun with f then
                    let unboxed(p: Type): Bool =
                        case layout.representationKind(p)
                            when repInt, repWord, repBool, repChar, repPointer then true
                            else false
                        end
                    let var all =
                        case layout.representationKind(f.result) when repVoid then true else unboxed(f.result) end
                    for i = 0 upto {extent f.params - 1} do
                        if not(unboxed(f.params[i].type)) then all := false end
                    end
                    all
                else false
            end
        end

    (* Returns the underlying C symbol for an imported member if it is a
     * standard-library external built into the compiler
     * (questlang/repr/externals), the import resolves to lib/, and no argument
     * or result is represented as a QVal word (which happens when the importer
     * sees an external type only as abstract, such as os/process's process.T).
     * Mirrors the C printer's libraryExternal. *)
    let libraryExternal(imp: ir.Import member: String args: Array(Atom) calleeType: Type): maybe.T(String) =
        begin
            let held(ps: Array(parts.Part)): Bool =
                begin
                    let var any = false
                    for k = 0 upto {extent ps - 1} do
                        case ps[k].type when typeVal then any := true else ok end
                    end
                    any
                end
            let var unheld = not(held(resultParts(calleeType)))
            for i = 0 upto {extent args - 1} do
                if held(parts.ofType(ir.atomType(args[i]))) then unheld := false end
            end
            let var symbol = maybe.none(:String)
            if unheld andif maybe.isSome(imp.libPath) then
                for i = 0 upto {extent externals.functions - 1} do
                    let entry = externals.functions[i]
                    if vals.eq(entry[0] maybe.unwrap(imp.libPath)) andif vals.eq(entry[1] member) then
                        symbol := maybe.some(entry[2])
                    end
                end
            end
            symbol
        end

    let callOp(fn: vals.Fn o: ir.OpCall): Array(Int) =
        begin
            let descs = descriptors.descriptors(fn o.descriptors)
            if maybe.isNone(o.callee) then
                let r = maybe.unwrap(o.moduleRef)
                let member = maybe.unwrap(o.member)
                if maybe.isSome(moduleOf(r)) then
                    let v = maybe.unwrap(ir.member(maybe.unwrap(moduleOf(r)).members member))
                    callClosure(fn v descs o.args)
                else
                    let imp = maybe.unwrap(importOf(r))
                    let calleeType = maybe.unwrapOr(o.calleeType model.okType)
                    let direct = libraryExternal(imp member o.args calleeType)
                    let inline =
                        if maybe.isSome(direct) andif concrete(o.calleeType) then
                            externalOperation(fn maybe.unwrap(direct) o.args)
                        else
                            maybe.none(:Array(Int))
                        end
                    if maybe.isSome(inline) then
                        maybe.unwrap(inline)
                    else
                        let clean = symbols.mangleModuleName(imp.canonicalPath)
                        let inlined =
                            if maybe.isSome(direct) then
                                inlineExternal(fn maybe.unwrap(direct) o.args)
                            else
                                maybe.none(:Int)
                            end
                        if maybe.isSome(inlined) then
                            array of maybe.unwrap(inlined) end
                        elsif maybe.isSome(direct) then
                            (* Call the C function directly instead of the
                             * module wrapper, since their signatures match *)
                            directCall(fn maybe.unwrap(direct) array of :Int end o.args calleeType)
                        else
                            directCall(fn symbols.mangleModuleIdent(clean member) descs o.args calleeType)
                        end
                    end
                end
            else
                callClosure(fn maybe.unwrap(o.callee) descs o.args)
            end
        end

    (* =========================================================================
     * Module members
     * ====================================================================== *)

    let sortBefore(a: String b: String): Bool = sort.stringCompare(a b) < 0

    (* Loads a member from an imported module's record. The field's byte offset
     * within the record payload is stored in the record's offset table
     * (dictionary) at the field's alphabetical index. *)
    let importedMember(fn: vals.Fn imp: ir.Import member: String): Array(Int) =
        begin
            let clean = symbols.mangleModuleName(imp.canonicalPath)
            let recordAt = vals.symbolAt(fn symbols.moduleRecordIdent(clean))
            if maybe.isNone(imp.recordType) then raise vals.unsupported with "module " <> imp.name
                <> ": its interface is unknown" end end
            let recType = maybe.unwrap(imp.recordType)
            let fields =
                case recType.form
                    when typeRecord with rt then rt.fields
                    else vector.toArray(vector.new(:model.RecordField))
                end
            let var fieldType = model.okType
            let var index = 0
            for i = 0 upto {extent fields - 1} do
                if vals.eq(fields[i].name member) then fieldType := fields[i].type end
                if sortBefore(fields[i].name member) then index := index + 1 end
            end
            let val = vals.loadWord(fn recordAt runtimeLayout.offset("QRecordVal" "val") vals.tPtr)
            let dict = vals.loadWord(fn recordAt runtimeLayout.offset("QRecordVal" "dict") vals.tPtr)
            let offset = vals.loadWord(fn dict 8 * index vals.tInt)
            objects.readSlot(fn vals.indexPtr(fn val offset) fieldType)
        end

    (* Loads the two-word QRecordVal for the module named name: its payload
     * pointer and its offset table pointer *)
    let moduleRecord(fn: vals.Fn name: String): Array(Int) =
        begin
            let recordAt = vals.symbolAt(fn symbols.moduleRecordIdent(symbols.mangleModuleName(name)))
            array of
                vals.loadWord(fn recordAt runtimeLayout.offset("QRecordVal" "val") vals.tPtr)
                vals.loadWord(fn recordAt runtimeLayout.offset("QRecordVal" "dict") vals.tPtr)
            end
        end

    let moduleMember(fn: vals.Fn r: ir.ModuleRef member: maybe.T(String)): Array(Int) =
        case r
            when refModule with x then
                if maybe.isNone(member) then
                    moduleRecord(fn x.m.name)
                else
                    vals.read(fn maybe.unwrap(ir.member(x.m.members maybe.unwrap(member))))
                end
            when refImport with x then
                if maybe.isNone(member) then
                    moduleRecord(fn x.i.canonicalPath)
                else
                    importedMember(fn x.i maybe.unwrap(member))
                end
        end
end
