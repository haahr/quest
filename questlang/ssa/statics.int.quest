(* Quest Self-Hosted Compiler: The SSA's Static Descriptors Interface
 *
 * Lays out the descriptors a unit defines as the SSA's static data (docs/ssa.md
 * section 5), from repr/staticdata's descriptions, as the runtime's structs
 * (repr/runtimeLayout) and the C declarations (codegen/c/declarations) lay
 * them out: quest_type_<tag>, and the structs its extra field points at. *)

interface Statics
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/repr/staticdata : questlang/repr/StaticData
    questlang/repr/objectLayout : questlang/repr/ObjectLayout
export
    (* A reference to a descriptor (or NULL) as a word *)
    refWord(r: staticdata.Ref): ssa.Word
    (* The data of a descriptor the unit defines; text(s) is the symbol of a
     * string's data *)
    descriptorData(d: staticdata.Descriptor text: All(s: String) String): Array(ssa.Data)
    (* The data of a layout of the unit (docs/collector.md section 3.2): its
     * kinds, packed in words, and its QLayout *)
    layoutData(l: objectLayout.Layout text: All(s: String) String): Array(ssa.Data)
end
