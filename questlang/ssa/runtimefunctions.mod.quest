(* Quest Self-Hosted Compiler: The Runtime's Functions Implementation *)

module runtimeFunctions : RuntimeFunctions
import
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/common/maps : questlang/common/Maps
    questlang/repr/runtimeLayout : questlang/repr/RuntimeLayout
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/ssa/verify : questlang/ssa/Verify
export
    Def Memory = Option memoryNone memoryReads memoryWrites end
    Def Effects = Tuple memory: Memory raises: Bool allocates: Bool noReturn: Bool end
    Def Function = Tuple
        name: String
        result: String
        params: Array(String)
        effects: Effects
        fresh: Bool
        registration: Bool
    end

    let memoryNone: Memory = option memoryNone of Memory end
    let memoryReads: Memory = option memoryReads of Memory end
    let memoryWrites: Memory = option memoryWrites of Memory end
    let effects(memory: Memory raises: Bool allocates: Bool noReturn: Bool): Effects =
        tuple let memory = memory let raises = raises let allocates = allocates let noReturn = noReturn end
    let fn(name: String result: String params: Array(String) e: Effects): Function =
        tuple
            let name = name
            let result = result
            let params = params
            let effects = e
            let fresh = false
            let registration = false
        end
    (* f, marked as returning a new object, or as a registration *)
    let fresh(f: Function): Function =
        tuple
            let name = f.name
            let result = f.result
            let params = f.params
            let effects = f.effects
            let fresh = true
            let registration = f.registration
        end
    let registration(f: Function): Function =
        tuple
            let name = f.name
            let result = f.result
            let params = f.params
            let effects = f.effects
            let fresh = f.fresh
            let registration = true
        end
    (* The effects the passes take a call of a function the table does not
     * have to have: it writes memory, may raise, and allocates *)
    let unknownEffects = effects(memoryWrites true true false)

    (* In order of name *)
    let functions = array of
        fn("puts" "int" array of "const char *" end effects(memoryWrites false false false))
        fresh(fn("quest_alloc" "void *" array of "size_t" "const QLayout *" end effects(memoryNone false true false)))
        fn("quest_alloc_exception" "const QException *"
                array of "const char *" end effects(memoryReads false true false))
        fresh(fn("quest_array_new" "QArray *" array of "int64_t" "QVal" "const QLayout *" end
                effects(memoryNone false true false)))
        fn("quest_auto_new" "QAuto *"
                array of "const QTypeDescriptor *" "QVal" end effects(memoryNone false true false))
        (* The barriers write only an object's header word, the collector's
         * log, and the card table, none of which compiled code loads, so
         * value numbering keeps its loads across them; reads keeps them
         * from counting as pure *)
        registration(fn("quest_barrier" "void" array of "const void *" end effects(memoryReads false false false)))
        registration(fn("quest_barrier_slot" "void" array of "const void *" end effects(memoryReads false false false)))
        fn("quest_builtins_init" "void" array of "int" "char **" end effects(memoryWrites false false false))
        fn("quest_convert" "QVal"
                array of "QVal" "const QTypeDescriptor *" "const QTypeDescriptor *" end effects(memoryReads true true
                        false))
        fn("quest_echo_capture" "void" array of :String end effects(memoryWrites false true false))
        fn("quest_echo_captured" "QString *" array of :String end effects(memoryWrites false true false))
        fn("quest_echo_text" "void" array of "const char *" end effects(memoryWrites false false false))
        fn("quest_fun_signature_equivalent" "bool"
                array of "const QTypeDescriptor *" "const QTypeDescriptor *" end effects(memoryReads false false false))
        fn("quest_gc_alloc_slow" "void *" array of "size_t" "const QLayout *" end effects(memoryNone false true false))
        fn("quest_gc_init" "void" array of :String end effects(memoryWrites false false false))
        fn("quest_instantiate_descriptor" "const QTypeDescriptor *"
                array of "const QTypeDescriptor *"
                    "size_t"
                    "const QTypeDescriptor *const *"
                end effects(memoryReads false
                        true false))
        fn("quest_is_subtype" "bool"
                array of "const QTypeDescriptor *" "const QTypeDescriptor *" end effects(memoryReads false false false))
        fn("quest_layout_conversion_error" "void"
                array of "const QTypeDescriptor *" "const QTypeDescriptor *" end effects(memoryReads true false false))
        fn("quest_layout_equivalent" "bool"
                array of "const QTypeDescriptor *" "const QTypeDescriptor *" end effects(memoryReads false false false))
        fn("quest_option_ordinal_error_at" "void"
                array of "int64_t" "int64_t" "const char *" end effects(memoryWrites true false true))
        fn("quest_option_is" "bool"
                array of "const QTypeDescriptor *"
                    "const void *"
                    "const void *"
                end effects(memoryReads false true false))
        fn("quest_print_typed" "void"
                array of "const char *"
                    "QVal"
                    "const QTypeDescriptor *"
                    "const char *"
                end effects(memoryWrites false false
                        false))
        fn("quest_print_value" "void"
                array of "const char *"
                    "QVal"
                    "const char *"
                    "const char *"
                end effects(memoryWrites false false false))
        fn("quest_proxy_element" "QVal" array of "const void *" "size_t" end effects(memoryReads true true false))
        fn("quest_proxy_option_element" "QVal"
                array of "const void *" "size_t" end effects(memoryReads true true false))
        fn("quest_proxy_option_payload" "void *" array of "const void *" end effects(memoryReads false true false))
        fn("quest_proxy_slot" "void *" array of "const void *" "size_t" end effects(memoryReads true false false))
        fn("quest_proxy_store" "void"
                array of "const void *" "size_t" "QVal" end effects(memoryWrites true false false))
        fn("quest_proxy_tag" "int64_t" array of "const void *" end effects(memoryReads false false false))
        fn("quest_raise_array_error_at" "void" array of "const char *" end effects(memoryWrites true false true))
        fn("quest_raise_ascii_error" "void" array of :String end effects(memoryWrites true false true))
        fn("quest_raise_at" "void"
                array of "const QException *" "QVal" "const char *" end effects(memoryWrites true false true))
        fn("quest_raise_dynamic_error_at" "void" array of "const char *" end effects(memoryWrites true false true))
        fn("quest_raise_int_error_at" "void" array of "const char *" end effects(memoryWrites true false true))
        fn("quest_raise_real_error_at" "void" array of "const char *" end effects(memoryWrites true false true))
        fn("quest_raise_string_error" "void" array of :String end effects(memoryWrites true false true))
        fn("quest_raise_typed_at" "void"
                array of "const QException *" "QVal" "const QTypeDescriptor *" "const char *" "const char *" end
                effects(memoryWrites true false true))
        fn("quest_raise_variant_error" "void" array of :String end effects(memoryWrites true false true))
        fn("quest_raise_variant_error_at" "void" array of "const char *" end effects(memoryWrites true false true))
        fn("quest_raised_capture" "QRaised *"
                array of "const QExceptionState *" end effects(memoryReads false true false))
        fn("quest_real_pow_at" "double"
                array of "double" "double" "const char *" end effects(memoryNone true false false))
        fn("quest_record_box" "QRecordVal *" array of "QRecordVal" end effects(memoryNone false true false))
        fn("quest_record_dict" "const void *"
                array of "const QTypeDescriptor *" "const QTypeDescriptor *" end effects(memoryReads false true false))
        fn("quest_record_view" "QRecordVal"
                array of "QRecordVal" "const QTypeDescriptor *" end effects(memoryReads false true false))
        registration(fn("quest_register_abstract_type" "void"
                array of "const char *" "size_t" "const QTypeDescriptor *" end effects(memoryWrites false false false)))
        registration(fn("quest_register_frames" "void"
                array of "const void *" end effects(memoryWrites false false false)))
        registration(fn("quest_register_funcs" "void"
                array of "const QFuncEntry *" "size_t" end effects(memoryWrites false false false)))
        registration(fn("quest_register_record_dict" "void"
                array of "const QTypeDescriptor *" "const QTypeDescriptor *" "const void *" end
                effects(memoryWrites false false false)))
        registration(fn("quest_register_roots" "void"
                array of "const QRootEntry *" end effects(memoryWrites false false false)))
        fn("quest_reraise" "void" array of "QExceptionState" end effects(memoryWrites true false true))
        (* Three of the library's externals (repr/externals), which the
         * builder calls as it calls any external, not through this table: each
         * returns a new string, which the conditions pass knows is not null.
         * Their effects are an unknown call's, which no pass has needed
         * finer. *)
        fresh(fn("quest_string_alloc" "QString *" array of "int64_t" "QChar" end unknownEffects))
        fresh(fn("quest_string_cat_sub" "QString *"
                array of "const QString *"
                    "int64_t"
                    "int64_t"
                    "const QString *"
                    "int64_t"
                    "int64_t"
                end unknownEffects))
        fresh(fn("quest_string_concat" "QString *"
                array of "const QString *" "const QString *" end effects(memoryReads false true false)))
        fresh(fn("quest_string_concat_n" "QString *"
                array of "int64_t"
                    "const QString *"
                    "const QString *"
                    "const QString *"
                    "const QString *"
                    "const QString *"
                    "const QString *" "const QString *"
                end effects(memoryReads false true false)))
        fresh(fn("quest_string_get_sub" "QString *" array of "const QString *" "int64_t" "int64_t" end unknownEffects))
        fresh(fn("quest_string_new" "QString *"
                array of "const char *" "int64_t" end effects(memoryReads false true false)))
        fn("quest_val_is" "bool"
                array of "const QTypeDescriptor *" "QVal" "QVal" end effects(memoryReads false true false))
        fn("quest_variant_box" "QVariantVal *" array of "QVariantVal" end effects(memoryNone false true false))
        fn("quest_variant_is" "bool"
                array of "const QTypeDescriptor *"
                    "QVariantVal"
                    "QVariantVal"
                end effects(memoryReads false true false))
        fn("quest_view_map" "const QViewMap *"
                array of "const QTypeDescriptor *" "const QTypeDescriptor *" end effects(memoryReads false true false))
        fn("quest_view_option_component" "QVal"
                array of "const void *" "const QViewMap *" "size_t" "size_t" end effects(memoryReads true true false))
        fn("quest_view_option_payload" "void *"
                array of "const void *" "const QViewMap *" end effects(memoryReads false true false))
        fn("quest_view_option_tag" "int64_t"
                array of "const void *" "const QViewMap *" end effects(memoryReads false false false))
        fn("quest_view_part" "QVal"
                array of "const QViewMap *" "size_t" "QVal" end effects(memoryReads true true false))
        fn("quest_view_record_field" "QVal"
                array of "QRecordVal" "const QViewMap *" "size_t" end effects(memoryReads true true false))
        fn("quest_view_record_slot" "void *"
                array of "QRecordVal" "const QViewMap *" "size_t" end effects(memoryReads false false false))
        fn("quest_view_tuple_element" "QVal"
                array of "const void *" "const QViewMap *" "size_t" end effects(memoryReads true true false))
        fn("quest_view_tuple_slot" "void *"
                array of "const void *" "const QViewMap *" "size_t" end effects(memoryReads false false false))
    end

    let function(name: String): Function =
        begin
            let var found = maybe.none(:Function)
            for i = 0 upto {extent functions - 1} do
                if stringOp.equal(functions[i].name name) then found := maybe.some(functions[i]) end
            end
            if maybe.isNone(found) then raise verify.verifyError with "internal: no runtime function " <> name end end
            maybe.unwrap(found)
        end

    (* The table's functions, by name *)
    let byName: maps.StringMap(Function) =
        begin
            let m = maps.newStringMap(:Function)
            for i = 0 upto {extent functions - 1} do
                begin let ignored = hashMap.insert(m functions[i].name functions[i]) end
            end
            m
        end

    let returnsFresh(symbol: String): Bool =
        begin
            let found = hashMap.get(byName symbol)
            maybe.isSome(found) andif maybe.unwrap(found).fresh
        end

    let registers(symbol: String): Bool =
        begin
            let found = hashMap.get(byName symbol)
            maybe.isSome(found) andif maybe.unwrap(found).registration
        end

    let callWrites(i: ssa.Inst): Bool =
        if ssa.isOp(i ssa.opCallIndirect) then
            true
        else
            let var writes = true
            for k = 0 upto {extent functions - 1} do
                if stringOp.equal(functions[k].name i.symbol) then
                    writes := case functions[k].effects.memory when memoryWrites then true else false end
                end
            end
            writes
        end

    let isPure(f: Function): Bool =
        case f.effects.memory
            when memoryNone then not(f.effects.raises) andif not(f.effects.allocates)
            when memoryReads, memoryWrites then false
        end

    (* How C passes a value of a C type, and its words' SSA types *)
    Let Passing = Tuple passed: Array(ssa.Passed) types: Array(ssa.Type) end
    let passing(c: String): Passing =
        begin
            let one = fun(p: ssa.Passed
                    t: ssa.Type): Passing tuple let passed = array of p end let types = array of t end end
            let pair = fun(first: ssa.Type second: ssa.Type): Passing
                tuple let passed = array of ssa.passPair ssa.passPairRest end let types = array of first second end end
            if stringOp.equal(c
                    "void") then tuple let passed = array of :ssa.Passed end let types = array of :ssa.Type end end
            elsif strutil.endsWith(c "*") then one(ssa.passWord ssa.typePtr)
            elsif stringOp.equal(c "double") then one(ssa.passReal ssa.typeReal)
            elsif stringOp.equal(c "bool") orif stringOp.equal(c "char") orif stringOp.equal(c "QChar") then
                one(ssa.passByte ssa.typeInt)
            elsif stringOp.equal(c "int") then one(ssa.passInt32 ssa.typeInt)
            (* A record is its payload's and its offset table's pointers, a
             * variant its tag and its payload's word *)
            elsif stringOp.equal(c "QRecordVal") then pair(ssa.typePtr ssa.typePtr)
            elsif stringOp.equal(c "QVariantVal") then pair(ssa.typeInt ssa.typeVal)
            elsif stringOp.equal(c "QVal") then one(ssa.passWord ssa.typeVal)
            (* A larger struct, by its copy's address *)
            elsif maybe.isSome(runtimeLayout.struct(c)) then
                let bytes = maybe.unwrap(runtimeLayout.struct(c)).bytes
                one(option passMemory of ssa.Passed with let bytes = bytes end ssa.typePtr)
            (* Any other, such as int64_t, size_t, or QInt, an integer word *)
            else one(ssa.passWord ssa.typeInt)
            end
        end

    let all(cs: Array(String)): Passing =
        begin
            let passed = vector.new(:ssa.Passed)
            let types = vector.new(:ssa.Type)
            for i = 0 upto {extent cs - 1} do
                let p = passing(cs[i])
                for k = 0 upto {extent p.passed - 1} do
                    vector.append(passed p.passed[k])
                    vector.append(types p.types[k])
                end
            end
            tuple let passed = vector.toArray(passed) let types = vector.toArray(types) end
        end

    let signature(f: Function): ssa.Signature =
        tuple let params = all(f.params).passed let results = passing(f.result).passed end
    let paramTypes(f: Function): Array(ssa.Type) = all(f.params).types
    let resultTypes(f: Function): Array(ssa.Type) = passing(f.result).types
end
