(* Quest Self-Hosted Compiler: The SSA's Verifier Interface
 *
 * This module checks the structural invariants of SSA functions and units
 * (docs/ssa.md section 7). It verifies that each value is defined once and its
 * definition dominates all its uses (questlang/ssa/cfg); that every
 * instruction's arguments, results, and load/store widths match its opcode
 * (with narrow loads returning int and narrow stores taking int); that call
 * and function signatures match their parameter and result types, and direct
 * calls to functions in the same unit match their parameter and result types;
 * that jumps pass the right number and types of block arguments; that switch
 * cases are distinct; that returns and tail calls match the function's result
 * types; that every block is terminated; that try handlers have no parameters
 * and are reached only from their try; and that all referenced slots and
 * blocks exist. *)

interface Verify
import
    questlang/ssa/nodes : questlang/ssa/Nodes
export
    (* The SSA's one internal error, raised by the verifier, the barrier
     * check (ssa/barriers), and the table of runtime functions
     * (ssa/runtimeFunctions); ssa/pipeline.attempt catches it *)
    verifyError: Exception(String)
    (* The problems with a function, none if it is well formed (its calls of
     * other functions unchecked) *)
    functionProblems(f: nodes.Function): Array(String)
    (* Raises verifyError, listing the problems, if a function of the unit is
     * not well formed *)
    checkUnit(u: nodes.Unit): Ok
end
