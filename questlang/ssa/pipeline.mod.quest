(* Quest Self-Hosted Compiler: The SSA's Pipeline Implementation *)

module pipeline : Pipeline
import
    stringOp = string : StringOp
    system : System

    collections/vector : collections/Vector
    util/strutil : util/Strutil

    ir = questlang/ir/nodes : questlang/ir/Nodes
    questlang/ssa/barriers : questlang/ssa/Barriers
    ssaBuild = questlang/ssa/build : questlang/ssa/Build
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/ssa/passNames : questlang/ssa/PassNames
    questlang/ssa/passes/accumulate : questlang/ssa/passes/Accumulate
    questlang/ssa/passes/allocations : questlang/ssa/passes/Allocations
    questlang/ssa/passes/concats : questlang/ssa/passes/Concats
    questlang/ssa/passes/conditions : questlang/ssa/passes/Conditions
    questlang/ssa/passes/constants : questlang/ssa/passes/Constants
    questlang/ssa/passes/escape : questlang/ssa/passes/Escape
    questlang/ssa/passes/interrupts : questlang/ssa/passes/Interrupts
    questlang/ssa/passes/loops : questlang/ssa/passes/Loops
    questlang/ssa/passes/nanChecks : questlang/ssa/passes/NanChecks
    questlang/ssa/passes/promote : questlang/ssa/passes/Promote
    questlang/ssa/passes/selects : questlang/ssa/passes/Selects
    questlang/ssa/passes/tables : questlang/ssa/passes/Tables
    questlang/ssa/passes/tailCalls : questlang/ssa/passes/TailCalls
    questlang/ssa/passes/tailJumps : questlang/ssa/passes/TailJumps
    questlang/ssa/passes/trampolines : questlang/ssa/passes/Trampolines
    questlang/ssa/passes/unproxies : questlang/ssa/passes/Unproxies
    questlang/ssa/passes/valueNumbers : questlang/ssa/passes/ValueNumbers
    questlang/ssa/scalars : questlang/ssa/Scalars
    questlang/ssa/verify : questlang/ssa/Verify
export
    let passes = passNames.passes

    let settings = tuple let var interruptChecks = false end
    let setInterruptChecks(on: Bool): Ok = settings.interruptChecks := on

    (* A pass: its name, and what runs it on a unit, under a backend's
     * policy *)
    Let Pass = Tuple name: String run: All(u: ssa.Unit p: ssa.Policy) Ok end

    let unknownPass: Exception(String) = exception unknownPass: String end

    (* The passes whose functions return what a pass's run does not *)
    let escapeUnit(u: ssa.Unit): Ok = begin let ignored = escape.escapeUnit(u) end
    let promoteUnit(u: ssa.Unit): Ok = begin let ignored = promote.promoteUnit(u) end
    let replaceUnit(u: ssa.Unit): Ok = begin let ignored = scalars.replaceUnit(u) end

    (* Copying a mutually recursive function into its caller can leave a self
     * tail call, which loops makes a loop as it does before *)
    let jumpUnit(u: ssa.Unit p: ssa.Policy): Ok =
        begin
            tailJumps.jumpUnit(u)
            loops.loopTailCalls(u p)
        end

    (* The pass passNames calls name; raises unknownPass if there is none, which
     * the first compile through the SSA would show, since the table is built
     * from every name when this module starts *)
    let passOf(name: String): Pass =
        begin
            let pass = fun(run: All(u: ssa.Unit p: ssa.Policy) Ok): Pass tuple name run end
            (* A pass that the policy does not change *)
            let plain = fun(run: All(u: ssa.Unit) Ok): Pass pass(fun(u: ssa.Unit p: ssa.Policy): Ok run(u))
            if stringOp.equal(name "escape") then plain(escapeUnit)
            elsif stringOp.equal(name "promote") then plain(promoteUnit)
            elsif stringOp.equal(name "scalars") then plain(replaceUnit)
            elsif stringOp.equal(name "constants") then plain(constants.constantUnit)
            elsif stringOp.equal(name "concats") then plain(concats.concatUnit)
            elsif stringOp.equal(name "nanChecks") then plain(nanChecks.checkUnit)
            elsif stringOp.equal(name "valueNumbers") then pass(valueNumbers.numberUnit)
            elsif stringOp.equal(name "conditions") then pass(conditions.decideUnit)
            elsif stringOp.equal(name "selects") then plain(selects.selectUnit)
            elsif stringOp.equal(name "tables") then plain(tables.tableUnit)
            elsif stringOp.equal(name "accumulate") then plain(accumulate.accumulateUnit)
            elsif stringOp.equal(name "loops") then pass(loops.loopUnit)
            elsif stringOp.equal(name "tailCalls") then plain(tailCalls.markUnit)
            elsif stringOp.equal(name "tailJumps") then pass(jumpUnit)
            elsif stringOp.equal(name "trampolines") then plain(trampolines.trampolineUnit)
            else raise unknownPass with name end
            end
        end

    (* The passes, in passNames' order *)
    let table: Array(Pass) =
        begin
            let t = vector.new(:Pass)
            for i = 0 upto {extent passes - 1} do vector.append(t passOf(passes[i])) end
            vector.toArray(t)
        end

    let skipped(name: String): Bool =
        begin
            let names = strutil.split(system.getEnv("QUEST_SKIP_PASSES") ",")
            let var found = false
            for i = 0 upto {vector.length(names) - 1} do
                if stringOp.equal(strutil.strip(vector.get(names i)) name) then found := true end
            end
            found
        end

    let run(unit: ir.Unit p: ssa.Policy after: All(name: String u: ssa.Unit) Ok): ssa.Unit =
        begin
            let checks = stringOp.equal(system.getEnv("QUEST_CHECK_IR") "1")
            let u = ssaBuild.buildUnit(unit)
            if checks then
                verify.checkUnit(u)
                barriers.checkUnit(u)
            end
            after("built" u)
            for i = 0 upto {extent table - 1} do
                let pass = table[i]
                if not(skipped(pass.name)) then
                    pass.run(u p)
                    if checks then
                        verify.checkUnit(u)
                        barriers.checkUnit(u)
                    end
                end
                after(pass.name u)
            end
            (* The chains the selects pass's conversions left, merged only
             * now, so that the loops pass saw each loop's header apart *)
            selects.straightenUnit(u)
            if settings.interruptChecks andif not(skipped("interrupts")) then interrupts.checkUnit(u) end
            verify.checkUnit(u)
            barriers.checkUnit(u)
            u
        end

    let build(unit: ir.Unit p: ssa.Policy): ssa.Unit = run(unit p fun(name: String u: ssa.Unit): Ok ok)

    let inlineAllocation(u: ssa.Unit): Ok =
        if not(skipped("inlineAllocation")) then
            allocations.inlineUnit(u)
            verify.checkUnit(u)
        end

    let lower(u: ssa.Unit): Ok =
        begin
            unproxies.lowerUnit(u)
            verify.checkUnit(u)
            inlineAllocation(u)
        end
end
