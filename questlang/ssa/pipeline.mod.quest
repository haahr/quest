(* Quest Self-Hosted Compiler: The SSA's Pipeline Implementation *)

module pipeline : Pipeline
import
    ir = questlang/ir/nodes : questlang/ir/Nodes
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    ssaBuild = questlang/ssa/build : questlang/ssa/Build
    collections/vector : collections/Vector
    questlang/ssa/verify : questlang/ssa/Verify
    questlang/ssa/barriers : questlang/ssa/Barriers
    questlang/ssa/scalars : questlang/ssa/Scalars
    questlang/ssa/passes/escape : questlang/ssa/passes/Escape
    questlang/ssa/passes/promote : questlang/ssa/passes/Promote
    questlang/ssa/passes/tailCalls : questlang/ssa/passes/TailCalls
    questlang/ssa/passes/tailJumps : questlang/ssa/passes/TailJumps
    questlang/ssa/passes/interrupts : questlang/ssa/passes/Interrupts
    questlang/ssa/passes/allocations : questlang/ssa/passes/Allocations
    questlang/ssa/passes/valueNumbers : questlang/ssa/passes/ValueNumbers
    questlang/ssa/passes/accumulate : questlang/ssa/passes/Accumulate
    questlang/ssa/passes/selects : questlang/ssa/passes/Selects
    questlang/ssa/passes/tables : questlang/ssa/passes/Tables
    questlang/ssa/passes/constants : questlang/ssa/passes/Constants
    util/strutil : util/Strutil
    stringOp = string : StringOp
    system : System
export
    let passes = array of
        "escape" "promote" "scalars" "constants" "valueNumbers" "selects" "tables" "accumulate" "tailCalls" "tailJumps"
    end

    let settings = tuple let var interruptChecks = false end
    let setInterruptChecks(on: Bool): Ok = settings.interruptChecks := on

    let unknownPass: Exception(String) = exception unknownPass: String end

    let runPass(name: String u: ssa.Unit): Ok =
        if stringOp.equal(name "scalars") then begin let ignored = scalars.replaceUnit(u) end
        elsif stringOp.equal(name "escape") then begin let ignored = escape.escapeUnit(u) end
        elsif stringOp.equal(name "promote") then begin let ignored = promote.promoteUnit(u) end
        elsif stringOp.equal(name "constants") then constants.constantUnit(u)
        elsif stringOp.equal(name "valueNumbers") then valueNumbers.numberUnit(u)
        elsif stringOp.equal(name "selects") then selects.selectUnit(u)
        elsif stringOp.equal(name "tables") then tables.tableUnit(u)
        elsif stringOp.equal(name "accumulate") then accumulate.accumulateUnit(u)
        elsif stringOp.equal(name "tailCalls") then tailCalls.markUnit(u)
        elsif stringOp.equal(name "tailJumps") then tailJumps.jumpUnit(u)
        else raise unknownPass with name end end

    let skipped(name: String): Bool =
        begin
            let names = strutil.split(system.getEnv("QUEST_SKIP_PASSES") ",")
            let var found = false
            for i = 0 upto {vector.length(:String names) - 1} do
                if stringOp.equal(strutil.strip(vector.get(:String names i)) name) then found := true end
            end
            found
        end

    let run(unit: ir.Unit after: All(name: String u: ssa.Unit) Ok): ssa.Unit =
        begin
            let checks = stringOp.equal(system.getEnv("QUEST_CHECK_IR") "1")
            let u = ssaBuild.buildUnit(unit)
            if checks then
                verify.checkUnit(u)
                barriers.checkUnit(u)
            end
            after("built" u)
            for i = 0 upto {extent passes - 1} do
                if not(skipped(passes[i])) then
                    runPass(passes[i] u)
                    if checks then
                        verify.checkUnit(u)
                        barriers.checkUnit(u)
                    end
                end
                after(passes[i] u)
            end
            if settings.interruptChecks andif not(skipped("interrupts")) then interrupts.checkUnit(u) end
            verify.checkUnit(u)
            barriers.checkUnit(u)
            u
        end

    let build(unit: ir.Unit): ssa.Unit = run(unit fun(name: String u: ssa.Unit): Ok ok)

    let inlineAllocation(u: ssa.Unit): Ok =
        if not(skipped("inlineAllocation")) then
            allocations.inlineUnit(u)
            verify.checkUnit(u)
        end
end
