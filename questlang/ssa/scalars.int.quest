(* Quest Self-Hosted Compiler: The SSA's Scalar Replacement Interface
 *
 * This pass replaces heap-allocated or static-constant objects that never
 * escape a function (even when merged through block parameters) with the SSA
 * values of their individual words (docs/ssa.md section 4.3). For example, a
 * loop carrying a tuple instead carries its components directly, and a join of
 * options constructed in several branches (including static constants) joins
 * their tags and payloads. Escape analysis (section 4.2) removes single-origin
 * allocations that never merge; this pass runs after stack-slot promotion has
 * turned loop-carried variables into block parameters, removing merged
 * allocations and any further allocations that promotion exposes. *)

interface Scalars
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    (* An origin of an object: the value that makes it (an allocation's, or a
     * constant's address), whether it is a constant, and whether it is left
     * as it is, and if so why *)
    Def Verdict = Tuple value: Int constant: Bool left: Bool reason: String end

    (* Returns the verdict for each object origin in f, in creation order,
     * without modifying f (replaceFunction first drops unused block
     * parameters, which can otherwise keep objects from being replaced) *)
    analyze(u: ssa.Unit f: ssa.Function): Array(Verdict)

    (* Replaces f's merged objects by their words, the static data of u giving
     * the words of its constants; returns the number of objects (allocations
     * and constants) replaced *)
    replaceFunction(u: ssa.Unit f: ssa.Function): Int
    replaceUnit(u: ssa.Unit): Int
end
