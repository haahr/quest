(* Quest Self-Hosted Compiler: The SSA's Slot Promotion Implementation *)

module promote : Promote
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/ssa/cfg : questlang/ssa/Cfg
    collections/vector : collections/Vector
export
    Let Function = ssa.Function

    let typeCode(t: ssa.Type): Int =
        case t when typeInt then 0 when typePtr then 1 when typeReal then 2 when typeVal then 3 end

    let typeOfCode(code: Int): ssa.Type =
        if code is 0 then ssa.typeInt
        elsif code is 1 then ssa.typePtr
        elsif code is 2 then ssa.typeReal
        else ssa.typeVal end

    let enters(f: Function): Bool =
        begin
            let var found = false
            for b = 0 upto {vector.length(:ssa.Block f.blocks) - 1} do
                case ssa.block(f b).term
                    when termTry then found := true
                    when termNone, termJump, termBranch, termSwitch, termReturn, termTailCall, termUnreachable then ok
                end
            end
            found
        end

    (* A function's slots and their words, the variables promotion makes *)
    Let Variables = Tuple
        (* The slot whose address each value is, ~1 for others *)
        slotOf: Array(Int)
        (* Each slot's first variable, and whether it is promoted *)
        base: Array(Int)
        promoted: Array(Bool)
        (* Each variable's type code *)
        kind: Array(Int)
    end

    (* The variable an access of a slot reads or writes, ~1 if it is not a
     * whole word or a word's first byte *)
    let variableOf(f: Function vs: Variables i: ssa.Inst): Int =
        begin
            let s = vs.slotOf[i.args[0]]
            let words = vector.get(:ssa.Slot f.slots s).bytes / 8
            let aligned = {i.imm >= 0} andif {{i.imm % 8} is 0} andif {{i.imm / 8} < words}
            if aligned andif {{i.width is 8} orif {i.width is 1}} then vs.base[s] + {i.imm / 8} else ~1 end
        end

    (* The slots that can be promoted: of whole words, their addresses only
     * loaded from and stored to, a word at a time, or its first byte; each word
     * of values of one type, stored all of one width, and loaded whole only if
     * stored whole *)
    let variables(f: Function): Variables =
        begin
            let nSlots = vector.length(:ssa.Slot f.slots)
            let slotOf = array of(vector.length(:ssa.Type f.types) ~1)
            for b = 0 upto {vector.length(:ssa.Block f.blocks) - 1} do
                let blk = ssa.block(f b)
                for k = 0 upto {vector.length(:ssa.Inst blk.insts) - 1} do
                    let i = vector.get(:ssa.Inst blk.insts k)
                    if ssa.isOp(i ssa.opSlot) then slotOf[i.results[0]] := i.imm end
                end
            end
            let base = array of(nSlots 0)
            let promoted = array of(nSlots true)
            let var nVars = 0
            for s = 0 upto {nSlots - 1} do
                let bytes = vector.get(:ssa.Slot f.slots s).bytes
                base[s] := nVars
                if {bytes % 8} isnot 0 then promoted[s] := false else nVars := nVars + {bytes / 8} end
            end
            (* ~2 for a variable not yet seen; 0 for none, else 8 or 1, or ~1
             * for both *)
            let kind = array of(nVars ~2)
            let stored = array of(nVars 0)
            let loadedWhole = array of(nVars false)
            let vs = tuple let slotOf = slotOf let base = base let promoted = promoted let kind = kind end
            let note(v: Int t: ssa.Type): Ok =
                if kind[v] is ~2 then kind[v] := typeCode(t) elsif kind[v] isnot typeCode(t) then kind[v] := ~1 end
            let escape(v: Int): Ok = if slotOf[v] >= 0 then promoted[slotOf[v]] := false end
            for b = 0 upto {vector.length(:ssa.Block f.blocks) - 1} do
                let blk = ssa.block(f b)
                for k = 0 upto {vector.length(:ssa.Inst blk.insts) - 1} do
                    let i = vector.get(:ssa.Inst blk.insts k)
                    (* Any other use of a slot's address escapes *)
                    if ssa.isOp(i ssa.opSlot) then ok
                    elsif ssa.isOp(i ssa.opLoad) then
                        let s = slotOf[i.args[0]]
                        if {s >= 0} andif promoted[s] then
                            let v = variableOf(f vs i)
                            if v < 0 then promoted[s] := false
                            else
                                note(v ssa.typeOf(f i.results[0]))
                                if i.width is 8 then loadedWhole[v] := true end
                            end
                        end
                    elsif ssa.isOp(i ssa.opStore) then
                        let s = slotOf[i.args[0]]
                        if {s >= 0} andif promoted[s] then
                            let v = variableOf(f vs i)
                            if v < 0 then promoted[s] := false
                            else
                                note(v ssa.typeOf(f i.args[1]))
                                if stored[v] is 0 then stored[v] := i.width
                                elsif stored[v] isnot i.width then stored[v] := ~1 end
                            end
                        end
                        escape(i.args[1])
                    else
                        for a = 0 upto {extent i.args - 1} do escape(i.args[a]) end
                    end
                end
                let uses = ssa.terminatorUses(blk.term)
                for a = 0 upto {extent uses - 1} do escape(uses[a]) end
            end
            for s = 0 upto {nSlots - 1} do
                if promoted[s] then
                    for w = 0 upto {{vector.get(:ssa.Slot f.slots s).bytes / 8} - 1} do
                        let v = base[s] + w
                        (* A word never loaded or stored is an integer's *)
                        if kind[v] is ~2 then kind[v] := 0 end
                        if {kind[v] < 0} orif {stored[v] < 0} orif {{stored[v] is 1} andif loadedWhole[v]} then
                            promoted[s] := false
                        end
                    end
                end
            end
            vs
        end

    let promoteFunction(f: Function): Int =
        if {vector.length(:ssa.Slot f.slots) is 0} orif enters(f) then 0 else
            begin
                let nBlocks = vector.length(:ssa.Block f.blocks)
                let nSlots = vector.length(:ssa.Slot f.slots)
                let nValues = vector.length(:ssa.Type f.types)
                let vs = variables(f)
                let nVars = extent vs.kind
                let slotOf = vs.slotOf
                let promoted = vs.promoted
                let variableAt(i: ssa.Inst): Int =
                    if {slotOf[i.args[0]] >= 0} andif promoted[slotOf[i.args[0]]] then variableOf(f vs i) else ~1 end
                let g = cfg.graph(f)
                let frontier = cfg.frontiers(g)
                (* The blocks that store to each variable *)
                let stores = array of(nVars vector.new(:Int))
                for v = 0 upto {nVars - 1} do stores[v] := vector.new(:Int) end
                for b = 0 upto {nBlocks - 1} do
                    let blk = ssa.block(f b)
                    for k = 0 upto {vector.length(:ssa.Inst blk.insts) - 1} do
                        let i = vector.get(:ssa.Inst blk.insts k)
                        if ssa.isOp(i ssa.opStore) then
                            let v = variableAt(i)
                            if v >= 0 then vector.append(:Int stores[v] b) end
                        end
                    end
                end
                (* Where each variable needs a block parameter: the iterated
                 * frontier of the blocks that store to it *)
                let needs = array of(nVars array of(0 false))
                for s = 0 upto {nSlots - 1} do
                    if promoted[s] then
                        for w = 0 upto {{vector.get(:ssa.Slot f.slots s).bytes / 8} - 1} do
                            let v = vs.base[s] + w
                            needs[v] := array of(nBlocks false)
                            let queued = array of(nBlocks false)
                            let work = vector.new(:Int)
                            for k = 0 upto {vector.length(:Int stores[v]) - 1} do
                                let b = vector.get(:Int stores[v] k)
                                if not(queued[b]) then begin queued[b] := true vector.append(:Int work b) end end
                            end
                            while not(vector.empty(:Int work)) do
                                let b = vector.pop(:Int work)
                                for k = 0 upto {extent frontier[b] - 1} do
                                    let x = frontier[b][k]
                                    if not(needs[v][x]) then
                                        needs[v][x] := true
                                        if not(queued[x]) then
                                            queued[x] := true
                                            vector.append(:Int work x)
                                        end
                                    end
                                end
                            end
                            (* The entry's parameters are the function's *)
                            if needs[v][0] then promoted[s] := false end
                        end
                    end
                end
                (* The parameters, in each block, after its own *)
                let paramVariables = array of(nBlocks vector.new(:Int))
                let paramValues = array of(nBlocks vector.new(:Int))
                for b = 0 upto {nBlocks - 1} do
                    paramVariables[b] := vector.new(:Int)
                    paramValues[b] := vector.new(:Int)
                end
                for s = 0 upto {nSlots - 1} do
                    if promoted[s] then
                        for w = 0 upto {{vector.get(:ssa.Slot f.slots s).bytes / 8} - 1} do
                            let v = vs.base[s] + w
                            for b = 0 upto {nBlocks - 1} do
                                if needs[v][b] then
                                    vector.append(:Int paramVariables[b] v)
                                    vector.append(:Int paramValues[b] ssa.addParam(f b typeOfCode(vs.kind[v])))
                                end
                            end
                        end
                    end
                end
                (* What each load's result is replaced by, and the zeros that
                 * loads before any store read, made in the entry *)
                let replaced = array of(nValues ~1)
                let resolve(v: Int): Int =
                    begin
                        let var r = v
                        while {r < nValues} andif {replaced[r] >= 0} do r := replaced[r] end
                        r
                    end
                let zeros = array of(nVars ~1)
                let prelude = vector.new(:ssa.Inst)
                let current = array of(nVars ~1)
                let valueOf(v: Int): Int =
                    begin
                        if current[v] < 0 then
                            if zeros[v] < 0 then
                                let t = typeOfCode(vs.kind[v])
                                zeros[v] := ssa.newValue(f t)
                                let zero(op: ssa.Opcode args: Array(Int) result: Int): Ok =
                                    vector.append(:ssa.Inst prelude ssa.inst(op args array of result end))
                                case t
                                    when typeInt then zero(ssa.opConst array of :Int end zeros[v])
                                    when typePtr then zero(ssa.opNull array of :Int end zeros[v])
                                    when typeReal then zero(ssa.opRealConst array of :Int end zeros[v])
                                    (* A QVal word's zero, from an int's *)
                                    when typeVal then
                                        let n = ssa.newValue(f ssa.typeInt)
                                        zero(ssa.opConst array of :Int end n)
                                        zero(ssa.opToVal array of n end zeros[v])
                                end
                            end
                            zeros[v]
                        else current[v] end
                    end
                let children = g.children
                (* Renaming each block before its children, in order, by an
                 * explicit stack: a block's entry, then its exit, which
                 * restores the definitions saved at its entry *)
                let stackBlocks = vector.new(:Int)
                let stackExits = vector.new(:Bool)
                let savedDefinitions = vector.new(:Array(Int))
                vector.append(:Int stackBlocks 0)
                vector.append(:Bool stackExits false)
                while not(vector.empty(:Int stackBlocks)) do
                    let b = vector.pop(:Int stackBlocks)
                    if vector.pop(:Bool stackExits) then
                        let saved = vector.pop(:Array(Int) savedDefinitions)
                        for v = 0 upto {nVars - 1} do current[v] := saved[v] end
                    else
                        let saved = array of(nVars 0)
                        for v = 0 upto {nVars - 1} do saved[v] := current[v] end
                        vector.append(:Array(Int) savedDefinitions saved)
                        for k = 0 upto {vector.length(:Int paramVariables[b]) - 1} do
                            current[vector.get(:Int paramVariables[b] k)] := vector.get(:Int paramValues[b] k)
                        end
                        let blk = ssa.block(f b)
                        let kept = vector.new(:ssa.Inst)
                        for k = 0 upto {vector.length(:ssa.Inst blk.insts) - 1} do
                            let i = vector.get(:ssa.Inst blk.insts k)
                            if ssa.isOp(i ssa.opSlot) then
                                if not(promoted[slotOf[i.results[0]]]) then vector.append(:ssa.Inst kept i) end
                            elsif ssa.isOp(i ssa.opLoad) andif {variableAt(i) >= 0} then
                                let v = variableAt(i)
                                if i.width is 8 then replaced[i.results[0]] := valueOf(v)
                                else
                                    (* A byte, the extension of the word's *)
                                    let op = if i.signed then ssa.opSext8 else ssa.opZext8 end
                                    vector.append(:ssa.Inst kept ssa.inst(op array of valueOf(v) end i.results))
                                end
                            elsif ssa.isOp(i ssa.opStore) andif {variableAt(i) >= 0} then
                                current[variableAt(i)] := resolve(i.args[1])
                            else
                                vector.append(:ssa.Inst kept i)
                            end
                        end
                        vector.clear(:ssa.Inst blk.insts)
                        for k = 0 upto {vector.length(:ssa.Inst kept) - 1} do
                            vector.append(:ssa.Inst blk.insts vector.get(:ssa.Inst kept k))
                        end
                        let ts = ssa.targets(blk.term)
                        for k = 0 upto {extent ts - 1} do
                            let t = ts[k]
                            let n = vector.length(:Int paramVariables[t.block])
                            if n > 0 then
                                let args = array of({extent t.args + n} 0)
                                for a = 0 upto {extent t.args - 1} do args[a] := t.args[a] end
                                for a = 0 upto {n - 1} do
                                    args[extent t.args + a] := valueOf(vector.get(:Int paramVariables[t.block] a))
                                end
                                t.args := args
                            end
                        end
                        vector.append(:Int stackBlocks b)
                        vector.append(:Bool stackExits true)
                        for k = {extent children[b] - 1} downto 0 do
                            vector.append(:Int stackBlocks children[b][k])
                            vector.append(:Bool stackExits false)
                        end
                    end
                end
                (* Every use, of what replaced it; the slots left, renumbered *)
                let renumbered = array of(nSlots ~1)
                let left = vector.new(:ssa.Slot)
                let var count = 0
                for s = 0 upto {nSlots - 1} do
                    if promoted[s] then count := count + 1
                    else
                        renumbered[s] := vector.length(:ssa.Slot left)
                        vector.append(:ssa.Slot left vector.get(:ssa.Slot f.slots s))
                    end
                end
                vector.clear(:ssa.Slot f.slots)
                for s = 0 upto {vector.length(:ssa.Slot left) - 1} do
                    vector.append(:ssa.Slot f.slots vector.get(:ssa.Slot left s))
                end
                for b = 0 upto {nBlocks - 1} do
                    let blk = ssa.block(f b)
                    if b is 0 then
                        let rest = vector.copy(:ssa.Inst blk.insts)
                        vector.clear(:ssa.Inst blk.insts)
                        for k = 0 upto {vector.length(:ssa.Inst prelude) - 1} do
                            vector.append(:ssa.Inst blk.insts vector.get(:ssa.Inst prelude k))
                        end
                        for k = 0 upto {vector.length(:ssa.Inst rest) - 1} do
                            vector.append(:ssa.Inst blk.insts vector.get(:ssa.Inst rest k))
                        end
                    end
                    for k = 0 upto {vector.length(:ssa.Inst blk.insts) - 1} do
                        let i = vector.get(:ssa.Inst blk.insts k)
                        if ssa.isOp(i ssa.opSlot) then i.imm := renumbered[i.imm] end
                    end
                end
                ssa.replaceUses(f resolve)
                count
            end
        end

    let promoteUnit(u: ssa.Unit): Int =
        begin
            let var count = 0
            for i = 0 upto {vector.length(:Function u.functions) - 1} do
                count := count + promoteFunction(vector.get(:Function u.functions i))
            end
            count
        end
end
