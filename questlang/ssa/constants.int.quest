(* Quest Self-Hosted Compiler: The SSA's Constant Globals Interface
 *
 * Constant globals (docs/ssa.md section 4.1): a global of the unit's own, a
 * word of static data that starts as zero, which the unit stores to once,
 * with a constant or a symbol's address, before any load of it and any call
 * that could run Quest code in the function that stores it, and otherwise
 * only loads, becomes static data holding that value from the start,
 * read-only, and each of its loads the value itself. A module's global bound
 * to a constant, as util/bignum's oneW = word.fromInt(1), is such a global:
 * its module's initialization stores it, and each use loaded it, in every
 * iteration of a loop that uses it. Only a global the unit does not export:
 * another unit could store to one it does. *)

interface Constants
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    constantUnit(u: ssa.Unit): Ok
end
