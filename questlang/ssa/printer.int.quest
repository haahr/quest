(* Quest Self-Hosted Compiler: The SSA's Printer Interface
 *
 * This module formats SSA functions and units in the textual form specified in
 * docs/ssa.md section 6, used by --stop-after ssa and the SSA golden tests,
 * placing source positions on their own lines whenever they change *)

interface Printer
import
    questlang/ssa/nodes : questlang/ssa/Nodes
export
    formatFunction(f: nodes.Function): String
    formatUnit(u: nodes.Unit): String
end
