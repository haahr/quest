(* Quest Self-Hosted Compiler: The SSA's Pipeline Interface
 *
 * This module runs the SSA optimization passes in the order listed in passes
 * (docs/ssa.md section 4.1). The driver can dump the SSA after any pass as
 * phase ssa_NAME (ssa_built after the builder, ssa after the final pass). When
 * QUEST_CHECK_IR=1, the verifier (ssa/verify) and write-barrier check
 * (ssa/barriers) run after the builder and after each pass; QUEST_SKIP_PASSES
 * accepts a comma-separated list of pass names to omit for testing or
 * bisection. The final SSA is always verified and barrier-checked regardless
 * of environment variables. *)

interface Pipeline
import
    ir = questlang/ir/nodes : questlang/ir/Nodes
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    (* The passes' names, in order *)
    passes: Array(String)
    (* Builds the SSA for unit and runs each non-skipped pass in order, calling
     * after(name, u) after the builder (with name "built") and after each
     * pass *)
    run(unit: ir.Unit after: All(name: String u: ssa.Unit) Ok): ssa.Unit
    (* Builds and optimizes unit without calling an observer *)
    build(unit: ir.Unit): ssa.Unit
    (* Controls whether run and build insert interrupt checks after the passes
     * (ssa/passes/interrupts) for JIT-compiled code in the Jupyter kernel
     * (--kernel); defaults to false, and is skipped if QUEST_SKIP_PASSES names
     * interrupts *)
    setInterruptChecks(on: Bool): Ok
    (* ssa/passes/loops' setRotateAll *)
    setRotateAll(on: Bool): Ok
    (* Expands the unit's allocations into the collector's inline sequence
     * (ssa/passes/allocations), for the SSA's backends; left out
     * when QUEST_SKIP_PASSES names inlineAllocation *)
    inlineAllocation(u: ssa.Unit): Ok
    (* Lowers for the SSA's backends what the passes leave: each unproxy
     * (ssa/passes/unproxies), then the allocations (inlineAllocation) *)
    lower(u: ssa.Unit): Ok
end
