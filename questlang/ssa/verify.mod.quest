(* Quest Self-Hosted Compiler: The SSA's Verifier Implementation *)

module verify : Verify
import
    questlang/ssa/nodes : questlang/ssa/Nodes
    questlang/ssa/cfg : questlang/ssa/Cfg
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    util/strutil : util/Strutil
    stringOp = string : StringOp
    conv : Conv
export
    Let Function = nodes.Function
    Let Type = nodes.Type

    let verifyError: Exception(String) = exception verifyError: String end

    let blockCount(f: Function): Int = vector.length(:nodes.Block f.blocks)

    let sameType(a: Type b: Type): Bool =
        case a
            when typeInt then case b when typeInt then true when typePtr, typeReal then false end
            when typePtr then case b when typePtr then true when typeInt, typeReal then false end
            when typeReal then case b when typeReal then true when typeInt, typePtr then false end
        end

    (* The problems with f; callee is the unit's function of a symbol, if the
     * unit has one *)
    let problemsIn(f: Function callee: All(symbol: String) maybe.T(Function)): Array(String) =
        begin
            let problems = vector.new(:String)
            let where = "function " <> f.symbol
            let problem(text: String): Ok = vector.append(:String problems where <> ": " <> text)
            let n = blockCount(f)
            let nValues = vector.length(:Type f.types)
            let nSlots = vector.length(:nodes.Slot f.slots)
            let g = cfg.graph(f)
            (* Where each value is defined: its block, and its position in it
             * (~1 for a block parameter) *)
            let defBlock = array of(nValues ~1)
            let defIndex = array of(nValues ~2)
            let define(v: Int b: Int i: Int): Ok =
                if {v < 0} orif {v >= nValues} then
                    problem("block " <> conv.int(b) <> " defines value " <> conv.int(v) <> ", which does not exist")
                elsif defBlock[v] >= 0 then
                    problem("value %" <> conv.int(v) <> " is defined more than once")
                else
                    defBlock[v] := b
                    defIndex[v] := i
                end
            for b = 0 upto {n - 1} do
                let blk = nodes.block(f b)
                for i = 0 upto {vector.length(:Int blk.params) - 1} do define(vector.get(:Int blk.params i) b ~1) end
                for i = 0 upto {vector.length(:nodes.Inst blk.insts) - 1} do
                    let inst = vector.get(:nodes.Inst blk.insts i)
                    for r = 0 upto {extent inst.results - 1} do define(inst.results[r] b i) end
                end
            end
            (* The entry's parameters are the function's *)
            let entry = nodes.block(f 0)
            if vector.length(:Int entry.params) isnot vector.length(:Type f.paramTypes) then
                problem("its entry block's parameters are not its parameters")
            end
            let use(v: Int b: Int i: Int what: String): Ok =
                if {v < 0} orif {v >= nValues} then
                    problem(what <> " in block " <> conv.int(b) <> " uses value " <> conv.int(v) <> ", which does not exist")
                elsif defBlock[v] < 0 then
                    problem(what <> " in block " <> conv.int(b) <> " uses %" <> conv.int(v) <> ", which nothing defines")
                elsif cfg.reached(g b) then
                    let dominated = if defBlock[v] is b then defIndex[v] < i else cfg.dominates(g defBlock[v] b) end
                    if not(dominated) then
                        problem(what <> " in block " <> conv.int(b) <> " uses %" <> conv.int(v)
                            <> ", whose definition does not dominate it")
                    end
                end
            let typeIs(v: Int t: Type what: String): Ok =
                if {v >= 0} andif {v < nValues} andif not(sameType(nodes.typeOf(f v) t)) then
                    problem(what <> ": %" <> conv.int(v) <> " is " <> nodes.typeName(nodes.typeOf(f v)) <> ", not "
                        <> nodes.typeName(t))
                end
            let tInt = nodes.typeInt
            let tPtr = nodes.typePtr
            let tReal = nodes.typeReal
            let argsAre(inst: nodes.Inst types: Array(Type) what: String): Ok =
                if extent inst.args isnot extent types then
                    problem(what <> " has " <> conv.int(extent inst.args) <> " arguments, not " <> conv.int(extent types))
                else
                    for k = 0 upto {extent types - 1} do typeIs(inst.args[k] types[k] what) end
                end
            let resultsAre(inst: nodes.Inst types: Array(Type) what: String): Ok =
                if extent inst.results isnot extent types then
                    problem(what <> " has " <> conv.int(extent inst.results) <> " results, not "
                        <> conv.int(extent types))
                else
                    for k = 0 upto {extent types - 1} do typeIs(inst.results[k] types[k] what <> "'s result") end
                end
            let one(t: Type): Array(Type) = array of t end
            let noTypes = array of :Type end
            (* A signature of parameters and results of the types given: one
             * for each, a pair's first word followed by its second, a real a
             * double, and others not *)
            let signatureIsValid(sig: nodes.Signature params: Array(Type) results: Array(Type) what: String): Ok =
                begin
                    let classes(ps: Array(nodes.Passed) types: Array(Type) name: String): Ok =
                        if extent ps isnot extent types then
                            problem(what <> "'s signature has " <> conv.int(extent ps) <> " " <> name <> ", not "
                                <> conv.int(extent types))
                        else
                            for k = 0 upto {extent ps - 1} do
                                let isReal = sameType(types[k] tReal)
                                let rest = {k > 0} andif case ps[k - 1]
                                    when passPair then true
                                    when passWord, passReal, passPairRest, passByte, passInt32, passMemory then false
                                end
                                let fits = case ps[k]
                                    when passReal then isReal
                                    when passPairRest then rest
                                    when passWord, passPair, passByte, passInt32, passMemory then not(isReal)
                                end
                                let missing = rest andif case ps[k]
                                    when passPairRest then false
                                    when passWord, passReal, passPair, passByte, passInt32, passMemory then true
                                end
                                (* A pair's first word last, its second
                                 * missing *)
                                let unfinished = {k is {extent ps - 1}} andif case ps[k]
                                    when passPair then true
                                    when passWord, passReal, passPairRest, passByte, passInt32, passMemory then false
                                end
                                if not(fits) orif missing orif unfinished then
                                    problem(what <> "'s signature does not fit its " <> name <> " " <> conv.int(k))
                                end
                            end
                        end
                    classes(sig.params params "parameters")
                    classes(sig.results results "results")
                end
            let valueTypes(vs: Array(Int)): Array(Type) =
                begin
                    let ts = array of(extent vs tInt)
                    for k = 0 upto {extent vs - 1} do if {vs[k] >= 0}
                        andif {vs[k] < nValues} then ts[k] := nodes.typeOf(f vs[k]) end end
                    ts
                end
            (* A call's arguments and results: its signature, and for a call of
             * the unit's own function, its parameters and results *)
            let callIsValid(inst: nodes.Inst what: String): Ok =
                begin
                    signatureIsValid(inst.signature valueTypes(inst.args) valueTypes(inst.results) what)
                    if extent inst.results > 2 then problem(what <> " has " <> conv.int(extent inst.results)
                        <> " results") end
                    if nodes.isOp(inst nodes.opCall) then
                        let target = callee(inst.symbol)
                        if maybe.isSome(:Function target) then
                            let c = maybe.unwrap(:Function target)
                            argsAre(inst vector.toArray(:Type c.paramTypes) what <> " " <> inst.symbol)
                            resultsAre(inst vector.toArray(:Type c.resultTypes) what <> " " <> inst.symbol)
                        end
                    end
                end
            let checkTarget(t: nodes.Target from: Int what: String): Ok =
                if {t.block < 0} orif {t.block >= n} then
                    problem(what <> " in block " <> conv.int(from) <> " goes to block " <> conv.int(t.block) <> ", which does not exist")
                else
                    let params = nodes.block(f t.block).params
                    if extent t.args isnot vector.length(:Int params) then
                        problem(what <> " in block " <> conv.int(from) <> " passes " <> conv.int(extent t.args)
                            <> " arguments to block " <> conv.int(t.block) <> ", which has " <> conv.int(vector.length(:Int params))
                            <> " parameters")
                    else
                        for k = 0 upto {extent t.args - 1} do
                            typeIs(t.args[k] nodes.typeOf(f vector.get(:Int params k)) what <> " to block " <> conv.int(t.block))
                        end
                    end
                end
            signatureIsValid(f.signature vector.toArray(:Type f.paramTypes) vector.toArray(:Type f.resultTypes)
                "the function")
            for b = 0 upto {n - 1} do
                let blk = nodes.block(f b)
                let count = vector.length(:nodes.Inst blk.insts)
                for i = 0 upto {count - 1} do
                    let inst = vector.get(:nodes.Inst blk.insts i)
                    let what = nodes.opcodeName(inst.op)
                    for k = 0 upto {extent inst.args - 1} do use(inst.args[k] b i what) end
                    let widthIsValid(): Ok =
                        if not({inst.width is 8} orif {inst.width is 4} orif {inst.width is 1}) then
                            problem(what <> " of width " <> conv.int(inst.width))
                        end
                    case inst.op
                        when opConst then
                            argsAre(inst noTypes what)
                            resultsAre(inst one(tInt) what)
                        when opRealConst then
                            argsAre(inst noTypes what)
                            resultsAre(inst one(tReal) what)
                        when opSymbol, opNull then
                            argsAre(inst noTypes what)
                            resultsAre(inst one(tPtr) what)
                        when opAdd, opSub, opMul, opDiv, opRem, opAnd, opOr, opXor, opShl, opLshr, opAshr, opEq, opNe, opLt, opLe,
                            opGt, opGe, opUlt then
                            argsAre(inst array of tInt tInt end what)
                            resultsAre(inst one(tInt) what)
                        when opPeq, opPne then
                            argsAre(inst array of tPtr tPtr end what)
                            resultsAre(inst one(tInt) what)
                        when opFadd, opFsub, opFmul, opFdiv then
                            argsAre(inst array of tReal tReal end what)
                            resultsAre(inst one(tReal) what)
                        when opFeq, opFlt, opFle, opFgt, opFge then
                            argsAre(inst array of tReal tReal end what)
                            resultsAre(inst one(tInt) what)
                        when opIsNaN, opRealBits then
                            argsAre(inst array of tReal end what)
                            resultsAre(inst one(tInt) what)
                        when opIntToPtr then
                            argsAre(inst one(tInt) what)
                            resultsAre(inst one(tPtr) what)
                        when opBitsReal then
                            argsAre(inst one(tInt) what)
                            resultsAre(inst one(tReal) what)
                        when opSext8, opZext8 then
                            argsAre(inst one(tInt) what)
                            resultsAre(inst one(tInt) what)
                        when opPtrToInt then
                            argsAre(inst one(tPtr) what)
                            resultsAre(inst one(tInt) what)
                        when opLoad then
                            if extent inst.args isnot 1 then problem("a load has " <> conv.int(extent inst.args) <> " arguments")
                            else typeIs(inst.args[0] tPtr what) end
                            widthIsValid()
                            if extent inst.results isnot 1 then
                                problem("a load has " <> conv.int(extent inst.results) <> " results")
                            elsif inst.width < 8 then
                                (* A narrow load extends its bytes to an int *)
                                typeIs(inst.results[0] tInt what <> conv.int(inst.width))
                            end
                        when opStore then
                            if extent inst.args isnot 2 then problem("a store has " <> conv.int(extent inst.args) <> " arguments")
                            else
                                typeIs(inst.args[0] tPtr what)
                                (* A narrow store truncates an int *)
                                if inst.width < 8 then typeIs(inst.args[1] tInt what <> conv.int(inst.width)) end
                            end
                            widthIsValid()
                            resultsAre(inst noTypes what)
                        when opCall then callIsValid(inst what)
                        when opCallIndirect then
                            if extent inst.args < 1 then problem("an indirect call has no function")
                            else typeIs(inst.args[0] tPtr what) end
                            callIsValid(inst what)
                        when opSlot then
                            argsAre(inst noTypes what)
                            resultsAre(inst one(tPtr) what)
                            if {inst.imm < 0} orif {inst.imm >= nSlots} then
                                problem("slot " <> conv.int(inst.imm) <> " does not exist")
                            end
                        when opPtrAdd then
                            argsAre(inst array of tPtr tInt end what)
                            resultsAre(inst one(tPtr) what)
                        when opThreadLocal then
                            argsAre(inst noTypes what)
                            resultsAre(inst one(tPtr) what)
                        when opCopy then
                            if extent inst.args isnot 1 then
                                problem("a copy has " <> conv.int(extent inst.args) <> " arguments")
                            else
                                resultsAre(inst one(nodes.typeOf(f inst.args[0])) what)
                            end
                    end
                end
                let t = blk.term
                let uses = nodes.terminatorUses(t)
                for k = 0 upto {extent uses - 1} do use(uses[k] b count "a terminator") end
                case t
                    when termNone then problem("block " <> conv.int(b) <> " has no terminator")
                    when termJump with x then checkTarget(x.target b "a jump")
                    when termBranch with x then
                        typeIs(x.cond tInt "a branch's condition")
                        checkTarget(x.ifTrue b "a branch")
                        checkTarget(x.ifFalse b "a branch")
                    when termSwitch with x then
                        typeIs(x.value tInt "a switch's value")
                        if extent x.cases isnot extent x.targets then problem("a switch's cases are not its targets") end
                        for k = 0 upto {extent x.cases - 1} do
                            for j = 0 upto {k - 1} do
                                if x.cases[j] is x.cases[k] then problem("a switch's case " <> conv.int(x.cases[k])
                                    <> " repeats") end
                            end
                        end
                        for k = 0 upto {extent x.targets - 1} do checkTarget(x.targets[k] b "a switch") end
                        checkTarget(x.default b "a switch")
                    when termReturn with x then
                        if extent x.values isnot vector.length(:Type f.resultTypes) then
                            problem("block " <> conv.int(b) <> " returns " <> conv.int(extent x.values) <> " values, not "
                                <> conv.int(vector.length(:Type f.resultTypes)))
                        else
                            for k = 0 upto {extent x.values - 1} do
                                typeIs(x.values[k] vector.get(:Type f.resultTypes k) "a return")
                            end
                        end
                    when termTailCall with x then
                        let what = nodes.opcodeName(x.call.op)
                        if nodes.isCall(x.call) then
                            if nodes.isOp(x.call nodes.opCallIndirect) andif {extent x.call.args < 1} then
                                problem("an indirect call has no function")
                            end
                            callIsValid(x.call "a tail " <> what)
                            resultsAre(x.call vector.toArray(:Type f.resultTypes) "a tail " <> what)
                        else
                            problem("block " <> conv.int(b) <> "'s tail call is a " <> what)
                        end
                    when termTry with x then
                        checkTarget(x.body b "a try")
                        if {x.slot < 0} orif {x.slot >= nSlots} then problem("a try's slot " <> conv.int(x.slot) <> " does not exist") end
                        if {x.handler < 0} orif {x.handler >= n} then
                            problem("a try's handler " <> conv.int(x.handler) <> " does not exist")
                        else
                            let hp = g.preds[x.handler]
                            if {extent hp isnot 1} orif {hp[0] isnot b} then
                                problem("block " <> conv.int(x.handler) <> ", a try's handler, is reached from elsewhere too")
                            end
                            if not(vector.empty(:Int nodes.block(f x.handler).params)) then
                                problem("block " <> conv.int(x.handler) <> ", a try's handler, has parameters")
                            end
                        end
                    when termUnreachable then ok
                end
            end
            vector.toArray(:String problems)
        end

    let functionProblems(f: Function): Array(String) = problemsIn(f fun(symbol: String): maybe.T(Function)
        maybe.none(:Function))

    let checkUnit(u: nodes.Unit): Ok =
        begin
            let functions = hashMap.new(:String :Function stringOp.equal hash.string)
            for i = 0 upto {vector.length(:Function u.functions) - 1} do
                let f = vector.get(:Function u.functions i)
                let ignored = hashMap.insert(:String :Function functions f.symbol f)
            end
            let callee = fun(symbol: String): maybe.T(Function) hashMap.get(:String :Function functions symbol)
            let all = vector.new(:String)
            for i = 0 upto {vector.length(:Function u.functions) - 1} do
                let ps = problemsIn(vector.get(:Function u.functions i) callee)
                for k = 0 upto {extent ps - 1} do vector.append(:String all ps[k]) end
            end
            if not(vector.empty(:String all)) then
                raise verifyError with "internal: the SSA is not well formed:\n  " <> strutil.join("\n  " all) end
            end
        end
end
