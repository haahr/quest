(* Quest Self-Hosted Compiler: The SSA's Tail Calls Interface
 *
 * Marks the SSA's calls in tail position as tail calls (docs/ssa.md section 3,
 * docs/arm64.md section 3.7): a call whose results, or the extension of its
 * byte result, are what the function returns, directly or through blocks that
 * only pass them on to a return. A function a stack slot's address may escape
 * from (stored, passed to a call, or returned) has none, since a tail call
 * ends its frame: that includes every function that enters a try, whose
 * handler record is a slot on the chain. *)

interface TailCalls
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    markFunction(f: ssa.Function): Ok
    markUnit(u: ssa.Unit): Ok
end
