(* Quest Self-Hosted Compiler: The SSA's Builder Interface
 *
 * Builds the SSA of a described IR unit (docs/ssa.md, docs/arm64.md section
 * 3.2): a function of the SSA for each of the unit's functions, its main
 * routine, and its modules' initializers. Each IR variable of a value is the
 * SSA values of its representation (none for Ok, two for a record or a
 * variant); each mutable variable is a stack slot, loaded and stored, which a
 * later pass may promote to values. The builder does what the C printer prints
 * for each operation (docs/arm64.md section 7.2); a construct it does not
 * build yet raises unsupported, naming it. *)

interface Build
import
    ir = questlang/ir/nodes : questlang/ir/Nodes
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    unsupported: Exception(String)
    buildUnit(unit: ir.Unit): ssa.Unit
end
