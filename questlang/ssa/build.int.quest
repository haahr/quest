(* Quest Self-Hosted Compiler: The SSA's Builder Interface
 *
 * This module lowers a described IR unit into Static Single Assignment (SSA)
 * form (docs/ssa.md, docs/arm64.md section 3.2), producing one SSA function
 * for each IR function, the main routine, and each module initializer. Each
 * immutable IR variable maps to the SSA values of its representation (none for
 * Ok, two words for a record or variant); each mutable variable becomes a
 * stack slot that is loaded and stored and that a later pass may promote to
 * SSA values. The builder mirrors the C backend for each operation
 * (docs/arm64.md section 7.2) and raises unsupported, naming the construct,
 * for anything it does not yet handle. *)

interface Build
import
    ir = questlang/ir/nodes : questlang/ir/Nodes
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    unsupported: Exception(String)
    buildUnit(unit: ir.Unit): ssa.Unit
end
