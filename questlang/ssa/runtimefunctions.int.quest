(* Quest Self-Hosted Compiler: The Runtime's Functions Interface
 *
 * This module catalogs the functions from runtime/quest_runtime.h that the SSA
 * builder calls (docs/ssa.md section 2.2), and three of the library's
 * externals the passes know a fact of, recording each function's C prototype
 * (which determines its calling signature and SSA parameter and result types)
 * and its side effects and facts for optimization passes. The table is
 * checked against the C header: the questlang test codegen_runtime_functions
 * emits a C type assertion for each entry, which
 * tests/python/test_runtime_layout.py compiles against quest_runtime.h. *)

interface RuntimeFunctions
import
    ssa = questlang/ssa/nodes : questlang/ssa/Nodes
export
    (* What a function does to memory: nothing, reads it, or writes it (and
     * reads it) *)
    Def Memory = Option memoryNone memoryReads memoryWrites end
    (* A function's effects: what it does to memory, whether it may raise,
     * whether it allocates, and whether it never returns. One that does
     * nothing to memory, cannot raise, and does not allocate is pure. *)
    Def Effects = Tuple memory: Memory raises: Bool allocates: Bool noReturn: Bool end
    (* A function: its name, its C result type and parameter types, its
     * effects, and two facts the passes use:
     * - fresh: its result is a new object, so never null (an allocation, an
     *   array made, and each function that returns a string);
     * - registration: it records something for the runtime (types,
     *   functions, dictionaries, roots, frames, or a barrier's entry in the
     *   collector's log) and reads no global of the program's, so that the
     *   constants pass need not take it as reading one *)
    Def Function = Tuple
        name: String
        result: String
        params: Array(String)
        effects: Effects
        fresh: Bool
        registration: Bool
    end
    functions: Array(Function)
    (* The function of a name; raises ssa/verify's verifyError if the table has
     * none *)
    function(name: String): Function
    (* Whether symbol names a function of the table that is fresh, or a
     * registration *)
    returnsFresh(symbol: String): Bool
    registers(symbol: String): Bool
    isPure(f: Function): Bool
    (* Reports whether call instruction i may write observable memory: true for
     * every call except a direct call to a runtime function whose table entry
     * does not have memoryWrites (quest_alloc writes only the object it
     * returns). All Quest functions are conservatively treated as writing
     * memory, so a call for which callWrites is false cannot run Quest code. *)
    callWrites(i: ssa.Inst): Bool
    (* Returns how C passes f's parameters and results, along with their SSA
     * types: a 16-byte struct (QRecordVal, QVariantVal) passes as two words,
     * and a larger struct (such as QExceptionState) passes as the address of a
     * copy *)
    signature(f: Function): ssa.Signature
    paramTypes(f: Function): Array(ssa.Type)
    resultTypes(f: Function): Array(ssa.Type)
end
