(* Quest Self-Hosted Compiler: The SSA's Parser Interface
 *
 * Reads the SSA's textual form (docs/ssa.md section 6) back into a unit, so
 * that printing what it reads prints the text it read
 * (docs/backend-improvements.md section 3.4): a pass can be tested on SSA
 * written by hand, and a program's SSA cut down to what shows a bug. Values
 * keep their numbers, and a number the text never defines has type int. *)

interface Parser
import
    questlang/ssa/nodes : questlang/ssa/Nodes
export
    (* What the text is not, with its line number *)
    readError: Exception(String)
    readUnit(text: String): nodes.Unit
end
