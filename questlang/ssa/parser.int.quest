(* Quest Self-Hosted Compiler: The SSA's Parser Interface
 *
 * This module parses the SSA's textual format (docs/ssa.md section 6) back
 * into a Unit so that parsing and printing round-trip. This lets passes be
 * tested on hand-written SSA and lets a program's SSA be reduced to a minimal
 * reproducer. Values keep their numbers, and any value number never defined in
 * the text defaults to type int. *)

interface Parser
import
    questlang/ssa/nodes : questlang/ssa/Nodes
export
    (* Raised on a syntax error, naming the problem and its line number *)
    readError: Exception(String)
    readUnit(text: String): nodes.Unit
end
