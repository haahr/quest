(* Quest Self-Hosted Compiler: The Dynamic Format's Types Implementation *)

module dynamicJson : DynamicJSON
import
    conv : Conv
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/json : util/Json
    util/maybe : util/Maybe
    util/sort : util/Sort
    sb = util/stringBuilder : util/StringBuilder
    util/strutil : util/Strutil

    questlang/modules/abstractTypes : questlang/modules/AbstractTypes
    tm = questlang/types/model : questlang/types/Model
    questlang/types/reduce : questlang/types/Reduce
    questlang/types/subtyping : questlang/types/Subtyping
    questlang/values/model : questlang/values/Model
export
    Let Type = tm.Type
    Let Value = model.Value

    (* Graphs larger than this come from types that are not regular (their
     * unfoldings never repeat) *)
    let maxTypeNodes = 100000
    let formatVersion = 1
    let wordType = "uint64_t"

    let none = maybe.none(:Int)
    let fail(A::TYPE): A = model.raiseException(model.dynamicError none)
    let intEqual(a: Int b: Int): Bool = a is b
    let intKey(i: Int): String = conv.int(i)

    (* A type ref: a built-in type's name, or a node's index *)
    Let Ref = Tuple name: String index: Int end
    let builtin(name: String): Ref = tuple let name = name let index = ~1 end
    let nodeRef(index: Int): Ref = tuple let name = "" let index = index end

    let isBuiltin(r: Ref): Bool = stringOp.length(r.name) > 0
    let isRef(r: Ref name: String): Bool = stringOp.equal(r.name name)
    let isVarLabel(label: String): Bool = strutil.startsWith(label "var ") orif stringOp.equal(label "var")
    let items(v: json.Value): vector.T(json.Value) = case v when jArray with x then x.items else fail() end
    let text(v: json.Value): String = case v when jString with x then x.s else fail() end

    (* The built-in types a ref may name *)
    let builtinNames = array of "Ok" "Bool" "Char" "String" "Int" "Real" "Dynamic" end
    let builtinTypes =
        array of tm.okType tm.boolType tm.charType tm.stringType tm.intType tm.realType tm.dynamicType end

    let builtinType(name: String): Type =
        begin
            let var found = tm.okType
            for i = 0 upto {extent builtinNames - 1} do
                if stringOp.equal(builtinNames[i] name) then found := builtinTypes[i] end
            end
            found
        end

    let isBuiltinName(name: String): Bool =
        begin
            let var found = false
            for i = 0 upto {extent builtinNames - 1} do
                if stringOp.equal(builtinNames[i] name) then found := true end
            end
            found
        end

    let varLabel(name: String isVar: Bool): String =
        if not(isVar) then name elsif stringOp.length(name) > 0 then "var " <> name else "var" end

    let fieldName(label: String): String =
        if strutil.startsWith(label "var ") then stringOp.getSub(label 4 {stringOp.length(label) - 4})
        elsif stringOp.equal(label "var") then ""
        else label
        end

    let mentions(t: Type symbolId: Int): Bool =
        begin
            let var found = false
            for i = 0 upto {extent t.fv - 1} do if t.fv[i] is symbolId then found := true end end
            found
        end

    (* ======================================================================
     * 1. Types
     * ====================================================================== *)

    (* True for Auto A::TYPE with a:A end, the type of dynamic values, whatever
     * its parameter is named *)
    let isDynamicType(t: Type): Bool =
        case t.form
            when typeAuto with x then
                if tm.sameKind(x.kindBound tm.typeKind) andif {extent x.signature is 1} then
                    let f = x.signature[0]
                    stringOp.equal(f.name "a") andif not(f.isVar)
                        andif case f.type.form when typeVariable with v then v.symbolId is x.symbolId else false end
                else
                    false
                end
            else false
        end

    (* Returns t0 with aliases, solved metavariables (inferred type variables),
     * applications, and recursion unfolded down to its outer constructor,
     * raising dynamic.error after reduce.maxBetaSteps steps. This does not use
     * reduce.normalizeType, because normalizeType leaves an application whose
     * operator takes a different number of arguments, whereas evaluateLazily
     * reduces it. *)
    let structure(t0: Type): Type =
        begin
            let var t = t0
            let var result = maybe.none(:Type)
            let var steps = 0
            while maybe.isNone(result) andif {steps < reduce.maxBetaSteps} do
                steps := steps + 1
                t := tm.unalias(tm.prune(t))
                if t.form?typeRec orif t.form?typeRecGroup orif t.form?typeApp then
                    let unfolded = tm.evaluateLazily(t tm.noLookup)
                    if tm.same(unfolded t) then result := maybe.some(t) else t := unfolded end
                else
                    result := maybe.some(t)
                end
            end
            if maybe.isNone(result) then fail(:Ok) end
            maybe.unwrap(result)
        end

    (* Whether an abstract type of this kind is encodable: TYPE or POWER(B), or
     * an operator from types to TYPE *)
    let isUnbounded(k0: tm.Kind): Bool =
        if tm.isPower(k0) then
            true
        else
            let var k = k0
            let var ok0 = true
            while k.form?kindAll do
                case k.form
                    when kindAll with a then
                        if not(a.paramKind.form?kindType) then ok0 := false end
                        k := a.resultKind
                    else ok
                end
            end
            ok0 andif k.form?kindType
        end

    let boundOf(t: Type): tm.Kind =
        case t.form
            when typeVariable with v then maybe.unwrapOr(v.bound tm.typeKind)
            else tm.typeKind
        end

    Let Abstract = Tuple entry: abstractTypes.ModuleAbstractType args: Array(Type) end

    (* The module abstract type s is, or is an application of, with the
     * application's arguments *)
    let moduleAbstractType(s0: Type): maybe.T(Abstract) =
        begin
            let var s = s0
            let var args = array of :Type end
            case s0.form
                when typeApp with a then
                    args := a.arguments
                    s := tm.unalias(tm.prune(a.constructor))
                else ok
            end
            case s.form
                when typeVariable with v then
                    let entry = abstractTypes.abstractTypeBySymbol(v.symbolId)
                    if maybe.isNone(entry)
                            orif not(isUnbounded(boundOf(maybe.unwrap(entry).typeVar))) then
                        maybe.none()
                    else
                        maybe.some(tuple
                            let entry = maybe.unwrap(entry)
                            let args = args
                        end)
                    end
                else maybe.none()
            end
        end

    let allTypesEqual(a: Array(Type) b: Array(Type)): Bool =
        begin
            let var equal = extent a is extent b
            if equal then
                for i = 0 upto {extent a - 1} do
                    if not(subtyping.isTypeEqual(a[i] b[i] maybe.none())) then equal := false end
                end
            end
            equal
        end

    (* The representation of a module abstract type, or of an application of an
     * abstract type operator *)
    let representation(entry: abstractTypes.ModuleAbstractType args: Array(Type)): Type =
        if entry.linked then
            if maybe.isNone(entry.rep) then fail(:Ok) end
            let rep = maybe.unwrap(entry.rep)
            if extent args > 0 then tm.typeApp(rep args) else rep end
        else
            let var found = maybe.none(:Type)
            for i = 0 upto {vector.length(entry.instances) - 1} do
                let inst = vector.get(entry.instances i)
                if maybe.isNone(found) andif allTypesEqual(inst.args args) then found := maybe.some(inst.rep) end
            end
            if maybe.isNone(found) then fail(:Ok) end
            maybe.unwrap(found)
        end

    (* =========================================================================
     * 2. The graph of types
     *
     * A node is a shape and children. The shape holds the constructor and its
     * labels; children are type refs, in the order the node lists them: record
     * fields sorted by name, tuple components and function parameters in order
     * (then the function's result), variant and option cases by name (only
     * those with a payload), an abstract type's arguments (then its
     * representation), and an auto type's bound (if it has one, then its
     * components). A param node refers to the type parameter of the auto type N
     * auto types out from it.
     * ====================================================================== *)

    (* A node's shape: its kind; the labels of fields, cases, or parameter
     * modes; flags (a case's payload, an auto type's bound); text (an
     * external type's C type, an abstract type's global name); and count (an
     * abstract type's arguments, a param node's depth) *)
    Let Shape = Tuple kind: String labels: Array(String) flags: Array(Bool) text: String count: Int end
    Let Node = Tuple shape: Shape children: Array(Ref) end

    let shape(kind: String labels: Array(String) flags: Array(Bool) text: String count: Int): Shape =
        tuple let kind = kind let labels = labels let flags = flags let text = text let count = count end

    (* The key by which equal shapes are told apart *)
    let shapeKey(s: Shape): String =
        begin
            let b = sb.new()
            sb.str(b s.kind)
            sb.char(b '\x01')
            sb.str(b s.text)
            sb.char(b '\x01')
            sb.int(b s.count)
            sb.char(b '\x01')
            for i = 0 upto {extent s.labels - 1} do sb.str(b s.labels[i]) sb.char(b '\x02') end
            sb.char(b '\x01')
            for i = 0 upto {extent s.flags - 1} do sb.char(b if s.flags[i] then 't' else 'f' end) end
            sb.toString(b)
        end

    (* Graph holds the types a value mentions, from which canonicalTable builds
     * the document's type table.
     *
     * ref(g t) returns how the table refers to t: a built-in type by its name
     * ("Int", "String", "Dynamic"), and any other type by the index of its
     * node, which it adds, with the nodes of its parts, the first time it
     * meets the type. A node is a shape (its constructor and labels: a
     * record's field names, an option's case names) and the refs of its
     * parts, so that
     *
     *     Let Rec L = Option nil cons with head: Int tail: L end end
     *
     * is two nodes, the option and its payload tuple, and the tuple's tail
     * refers back to the option:
     *
     *     {"option": {"cons": 1, "nil": null}}
     *     {"tuple": [["head", "Int"], ["tail", 0]]}
     *
     * Nodes are keyed by the id of a type's structure: types are hash-consed
     * (made once for each structure), so equal types written alike share one,
     * and a recursive type becomes a cycle as its unfolding reaches the type
     * again. Equal types written differently may make separate nodes, which
     * the canonical table merges.
     *
     * Inside an auto type (a value packed with a type it hides, its witness),
     * an occurrence of its type parameter is a param node numbered by how many
     * auto types lie between it and its binder (0 for the nearest), and a type
     * that mentions such parameters is a node for each way it refers to
     * them. *)
    Let Graph = Tuple
        nodes: vector.T(Node)
        index: hashMap.T(String Int)
        (* The type parameters of the auto types around the type being added,
         * innermost last *)
        binders: vector.T(Int)
    end

    let newGraph(): Graph =
        tuple
            let nodes = vector.new()
            let index = hashMap.new(stringOp.equal hash.string)
            let binders = vector.new()
        end

    let nodeOf(g: Graph r: Ref): Node = vector.get(g.nodes r.index)
    let kindOf(g: Graph r: Ref): String = if isBuiltin(r) then "" else nodeOf(g r).shape.kind end

    let placeholder: Node =
        tuple let shape = shape("" array of :String end array of :Bool end "" 0) let children = array of :Ref end end

    let sortedRecordFields(fields: Array(tm.RecordField)): Array(tm.RecordField) =
        sort.sorted(fields fun(a: tm.RecordField b: tm.RecordField): Int sort.stringCompare(a.name b.name))

    let refs(n: Int): Array(Ref) = array of(n builtin("Ok"))

    (* Returns how the table refers to t (see Graph), adding the nodes of t and
     * its parts to g the first time they are met. A type parameter of an
     * enclosing auto type becomes a param node recording its depth; any other
     * type is keyed by the id of its structure and, if it mentions enclosing
     * auto types' parameters, by which ones at which depths. This raises
     * dynamic.error (fail) for a type the format cannot encode, or when g
     * reaches maxTypeNodes. *)
    let rec ref(g: Graph t: Type): Ref =
        begin
            let s = structure(t)
            let var found = maybe.none(:Ref)
            for i = 0 upto {extent builtinTypes - 1} do
                if maybe.isNone(found) andif tm.same(s builtinTypes[i]) then
                    found := maybe.some(builtin(builtinNames[i]))
                end
            end
            if maybe.isSome(found) then
                maybe.unwrap(found)
            elsif isDynamicType(s) then
                builtin("Dynamic")
            else
                let n = vector.length(g.binders)
                let var depth = ~1
                case s.form
                    when typeVariable with v then
                        for i = 0 upto {n - 1} do
                            if vector.get(g.binders i) is v.symbolId then depth := {n - 1} - i end
                        end
                    else ok
                end
                if depth >= 0 then
                    add(g "p" <> intKey(depth) s false depth)
                else
                    (* A type that mentions enclosing auto types' parameters is
                     * a node for each way it refers to them *)
                    let key = sb.new()
                    sb.char(key 's')
                    sb.int(key s.id)
                    for i = 0 upto {n - 1} do
                        let b = vector.get(g.binders i)
                        if mentions(s b) then
                            sb.char(key ':')
                            sb.int(key b)
                            sb.char(key ',')
                            sb.int(key {n - 1} - i)
                        end
                    end
                    add(g sb.toString(key) s true 0)
                end
            end
        end
    (* Returns the ref of g's node for key, creating it the first time key is
     * met: from structure s via makeNode if isStructure is true, or as a param
     * node of depth otherwise. The node's index is reserved with a placeholder
     * before makeNode visits its parts, so that a part leading back to s (a
     * recursive type) finds the index and refers to it, ending the walk. *)
    and add(g: Graph key: String s: Type isStructure: Bool depth: Int): Ref =
        begin
            let existing = hashMap.get(g.index key)
            if maybe.isSome(existing) then
                nodeRef(maybe.unwrap(existing))
            else
                if vector.length(g.nodes) >= maxTypeNodes then fail(:Ok) end
                let index = vector.length(g.nodes)
                hashMap.insert(g.index key index)
                vector.append(g.nodes placeholder)
                let n =
                    if isStructure then
                        makeNode(g s)
                    else
                        tuple
                            let shape = shape("param" array of :String end array of :Bool end "" depth)
                            let children = array of :Ref end
                        end
                    end
                vector.set(g.nodes index n)
                nodeRef(index)
            end
        end
    and makeNode(g: Graph s: Type): Node =
        begin
            let noLabels = array of :String end
            let noFlags = array of :Bool end
            let make(sh: Shape children: Array(Ref)): Node = tuple let shape = sh let children = children end
            case s.form
                when typeRecord with x then
                    let fields = sortedRecordFields(x.fields)
                    let labels = array of(extent fields "")
                    let children = refs(extent fields)
                    for i = 0 upto {extent fields - 1} do
                        labels[i] := varLabel(fields[i].name fields[i].isVar)
                        children[i] := ref(g fields[i].type)
                    end
                    make(shape("record" labels noFlags "" 0) children)
                when typeTuple with x then
                    let components = tm.tupleValueFields(x.fields)
                    (* Type components (abstract tuples) are not encodable
                     * yet *)
                    if extent components isnot extent x.fields then fail(:Ok) end
                    let labels = array of(extent components "")
                    let children = refs(extent components)
                    for i = 0 upto {extent components - 1} do
                        labels[i] := varLabel(maybe.unwrapOr(components[i].name "") components[i].isVar)
                        children[i] := ref(g components[i].type)
                    end
                    make(shape("tuple" labels noFlags "" 0) children)
                when typeVariant with x then
                    (* Cases are listed by name, as compiled code numbers them
                     * (docs/dynamic.md section 2.2) *)
                    let cases = sort.sorted(x.variants
                            fun(a: tm.VariantField b: tm.VariantField): Int sort.stringCompare(a.name b.name))
                    let labels = array of(extent cases "")
                    let flags = array of(extent cases false)
                    let children = vector.new(:Ref)
                    for i = 0 upto {extent cases - 1} do
                        labels[i] := varLabel(cases[i].name cases[i].isVar)
                        flags[i] := maybe.isSome(cases[i].type)
                        if flags[i] then vector.append(children ref(g maybe.unwrap(cases[i].type))) end
                    end
                    make(shape("variant" labels flags "" 0) vector.toArray(children))
                when typeOption with x then
                    let cases = sort.sorted(x.options
                            fun(a: tm.OptionField b: tm.OptionField): Int sort.stringCompare(a.name b.name))
                    let labels = array of(extent cases "")
                    let flags = array of(extent cases false)
                    let children = vector.new(:Ref)
                    for i = 0 upto {extent cases - 1} do
                        labels[i] := cases[i].name
                        flags[i] := maybe.isSome(cases[i].payload)
                        if flags[i] then vector.append(children ref(g maybe.unwrap(cases[i].payload))) end
                    end
                    make(shape("option" labels flags "" 0) vector.toArray(children))
                when typeArray with x then
                    make(shape("array" noLabels noFlags "" 0) array of ref(g x.element) end)
                when typeFun with x then
                    let modes = array of(extent x.params "")
                    let children = refs({extent x.params + 1})
                    for i = 0 upto {extent x.params - 1} do
                        modes[i] := if x.params[i].isVar then "var" elsif x.params[i].isOut then "out" else "" end
                        children[i] := ref(g x.params[i].type)
                    end
                    children[extent x.params] := ref(g x.result)
                    make(shape("fun" modes noFlags "" 0) children)
                when typeException with x then
                    make(shape("exception" noLabels noFlags "" 0) array of ref(g x.payload) end)
                when typeAuto with x then
                    let bound =
                        if tm.isPower(x.kindBound) then
                            array of ref(g tm.powerBound(x.kindBound)) end
                        elsif x.kindBound.form?kindType then
                            array of :Ref end
                        else
                            fail(:Array(Ref))
                        end
                    let labels = array of(extent x.signature "")
                    let children = refs({extent bound + extent x.signature})
                    if extent bound > 0 then children[0] := bound[0] end
                    vector.append(g.binders x.symbolId)
                    for i = 0 upto {extent x.signature - 1} do
                        labels[i] := varLabel(x.signature[i].name x.signature[i].isVar)
                        children[extent bound + i] := ref(g x.signature[i].type)
                    end
                    vector.pop(g.binders)
                    make(shape("auto" labels array of {extent bound > 0} end "" 0) children)
                else
                    let isWord =
                        case s.form
                            when typeExternal with x then stringOp.equal(x.cType wordType)
                            else false
                        end
                    if isWord then
                        make(shape("external" noLabels noFlags wordType 0) array of :Ref end)
                    else
                        let found = moduleAbstractType(s)
                        (* Polymorphic types, other abstract or external types,
                         * and type operators are not encodable *)
                        if maybe.isNone(found) then fail(:Ok) end
                        let a = maybe.unwrap(found)
                        let children = refs({extent a.args + 1})
                        for i = 0 upto {extent a.args - 1} do children[i] := ref(g a.args[i]) end
                        children[extent a.args] := ref(g representation(a.entry a.args))
                        make(shape("abstract" noLabels noFlags a.entry.globalName extent a.args) children)
                    end
            end
        end

    (* ======================================================================
     * 3. The canonical table
     * ====================================================================== *)

    Let Table = Tuple types: json.Value index: hashMap.T(Int Int) end

    let refJson(r: Ref t: Table): json.Value =
        if isBuiltin(r) then json.string(r.name) else json.int(hashMap.find(t.index r.index)) end

    (* Builds the canonical type table for the types reachable from roots, along
     * with the table index of each included node, so that equal types produce
     * the same text however the graph spells them (docs/dynamic.md section 2.2,
     * "Canonical tables"). The graph need not be minimal: an interpreter's
     * type and a compiled descriptor unroll a recursive type differently,
     * and equal types written differently may make separate nodes.
     *
     * Equivalent nodes are merged first. Two nodes are equivalent (bisimilar)
     * when they have the same shape and their children, in order, are the
     * same built-in types or equivalent nodes; this holds through cycles. The
     * classes are found by partition refinement: each node starts in the
     * class of its shape, and each round splits a class whose nodes' children
     * lie in different classes, until a round leaves the number of classes
     * unchanged. That gives the coarsest such partition, the fewest classes.
     *
     * The classes are then numbered in the order a depth-first walk first
     * reaches them, from each root in turn and each node's children in
     * order, and the table lists one node of each class reached. Neither
     * step depends on the graph's node numbering, so equal types number
     * alike. *)
    let canonicalTable(nodes: vector.T(Node) roots: vector.T(Ref)): Table =
        begin
            let n = vector.length(nodes)
            let shapeIds = hashMap.new(:String :Int stringOp.equal hash.string)
            let var cls = array of(n 0)
            for i = 0 upto {n - 1} do
                let key = shapeKey(vector.get(nodes i).shape)
                if not(hashMap.contains(shapeIds key)) then
                    hashMap.insert(shapeIds key hashMap.size(shapeIds))
                end
                cls[i] := hashMap.find(shapeIds key)
            end
            let var count = hashMap.size(shapeIds)
            let var stable = false
            while not(stable) do
                let sigs = hashMap.new(:String :Int stringOp.equal hash.string)
                let refined = array of(n 0)
                for i = 0 upto {n - 1} do
                    let key = sb.new()
                    sb.int(key cls[i])
                    let children = vector.get(nodes i).children
                    for j = 0 upto {extent children - 1} do
                        if isBuiltin(children[j]) then sb.char(key ':') sb.str(key children[j].name)
                        else sb.char(key '#') sb.int(key cls[children[j].index])
                        end
                    end
                    let k = sb.toString(key)
                    if not(hashMap.contains(sigs k)) then hashMap.insert(sigs k hashMap.size(sigs)) end
                    refined[i] := hashMap.find(sigs k)
                end
                if hashMap.size(sigs) is count then
                    stable := true
                else
                    cls := refined
                    count := hashMap.size(sigs)
                end
            end
            let classes = cls
            (* class -> table index, and a representative node of each class, in
             * table order *)
            let number = hashMap.new(:Int :Int intEqual hash.int)
            let order = vector.new(:Int)
            let rec visit(r: Ref): Ok =
                if isBuiltin(r) orif hashMap.contains(number classes[r.index]) then
                    ok
                else
                    hashMap.insert(number classes[r.index] vector.length(order))
                    vector.append(order r.index)
                    let children = vector.get(nodes r.index).children
                    for j = 0 upto {extent children - 1} do visit(children[j]) end
                end
            for i = 0 upto {vector.length(roots) - 1} do visit(vector.get(roots i)) end
            let index = hashMap.new(:Int :Int intEqual hash.int)
            for i = 0 upto {n - 1} do
                if hashMap.contains(number classes[i]) then
                    hashMap.insert(index i hashMap.find(number classes[i]))
                end
            end
            let t: Table = tuple let types = json.null let index = index end
            let table = vector.new(:json.Value)
            for k = 0 upto {vector.length(order) - 1} do
                let node = vector.get(nodes vector.get(order k))
                let sh = node.shape
                let rs = node.children
                let o = json.newObject()
                let body = json.newObject()
                let pairs(labels: Array(String) refs0: Array(Ref) offset: Int): json.Value =
                    begin
                        let items = vector.new(:json.Value)
                        for i = 0 upto {extent labels - 1} do
                            let pair = vector.new(:json.Value)
                            vector.append(pair json.string(labels[i]))
                            vector.append(pair refJson(refs0[offset + i] t))
                            vector.append(items json.arrayValue(pair))
                        end
                        json.arrayValue(items)
                    end
                if stringOp.equal(sh.kind "record") then
                    for i = 0 upto {extent sh.labels - 1} do json.put(body sh.labels[i] refJson(rs[i] t)) end
                    json.put(o "record" json.object(body))
                elsif stringOp.equal(sh.kind "tuple") then
                    json.put(o "tuple" pairs(sh.labels rs 0))
                elsif stringOp.equal(sh.kind "variant") orif stringOp.equal(sh.kind "option") then
                    let var next = 0
                    for i = 0 upto {extent sh.labels - 1} do
                        if sh.flags[i] then
                            json.put(body sh.labels[i] refJson(rs[next] t))
                            next := next + 1
                        else
                            json.put(body sh.labels[i] json.null)
                        end
                    end
                    json.put(o sh.kind json.object(body))
                elsif stringOp.equal(sh.kind "array") then
                    json.put(o "array" refJson(rs[0] t))
                elsif stringOp.equal(sh.kind "fun") then
                    json.put(body "params" pairs(sh.labels rs 0))
                    json.put(body "result" refJson(rs[extent rs - 1] t))
                    json.put(o "fun" json.object(body))
                elsif stringOp.equal(sh.kind "external") then
                    json.put(o "external" json.string(sh.text))
                elsif stringOp.equal(sh.kind "abstract") then
                    json.put(o "abstract" json.string(sh.text))
                    if sh.count > 0 then
                        let args = vector.new(:json.Value)
                        for i = 0 upto {sh.count - 1} do vector.append(args refJson(rs[i] t)) end
                        json.put(o "args" json.arrayValue(args))
                    end
                    json.put(o "rep" refJson(rs[extent rs - 1] t))
                elsif stringOp.equal(sh.kind "auto") then
                    let hasBound = sh.flags[0]
                    json.put(body "bound" if hasBound then refJson(rs[0] t) else json.null end)
                    json.put(body "components" pairs(sh.labels rs if hasBound then 1 else 0 end))
                    json.put(o "auto" json.object(body))
                elsif stringOp.equal(sh.kind "param") then
                    json.put(o "param" json.int(sh.count))
                else
                    json.put(o "exception" refJson(rs[0] t))
                end
                vector.append(table json.object(o))
            end
            tuple let types = json.arrayValue(table) let index = index end
        end
end
