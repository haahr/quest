(* Quest Self-Hosted Compiler: Reading Dynamic Values Implementation *)

module dynamicReader : DynamicReader
import
    conv : Conv
    realOp = real : RealOp
    stringOp = string : StringOp
    word : Word

    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/json : util/JSON
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/modules/abstractTypes : questlang/modules/AbstractTypes
    tm = questlang/types/model : questlang/types/Model
    questlang/types/subtyping : questlang/types/Subtyping
    questlang/types/symbols : questlang/types/Symbols
    questlang/values/dynamicJson : questlang/values/DynamicJSON
    questlang/values/model : questlang/values/Model
export
    Let Type = tm.Type
    Let Value = model.Value
    let none = maybe.none(:Int)
    let intEqual(a: Int b: Int): Bool = a is b
    let intKey(i: Int): String = conv.int(i)
    Let Ref = dynamicJson.Ref
    let formatVersion = dynamicJson.formatVersion
    let wordType = dynamicJson.wordType
    let fail = dynamicJson.fail
    let builtin = dynamicJson.builtin
    let nodeRef = dynamicJson.nodeRef
    let isBuiltin = dynamicJson.isBuiltin
    let isVarLabel = dynamicJson.isVarLabel
    let items = dynamicJson.items
    let text = dynamicJson.text
    (* An object read with an @id, and the type it was read at *)
    Let Seen = Tuple value: Value readAt: Ref end

    let arity(k0: tm.Kind): Int =
        begin
            let var n = 0
            let var k = k0
            while k.form?kindAll do
                case k.form when kindAll with a then begin n := n + 1 k := a.resultKind end else ok end
            end
            n
        end
    (* TYPE, or the kind of an operator from n types to TYPE: that of an
     * abstract type of an unlinked module *)
    let operatorKind(n: Int): tm.Kind =
        begin
            let var k = tm.typeKind
            for i = {n - 1} downto 0 do
                k := tm.allKind("A" <> intKey(i + 1) symbols.allocateSymbolId() tm.typeKind k)
            end
            k
        end
    let members(v: json.Value): json.Object = case v when jObject with x then x.o else fail() end
    let member(o: json.Object name: String): json.Value =
        begin
            let found = json.get(o name)
            if maybe.isNone(found) then fail(:Ok) end
            maybe.unwrap(found)
        end
    let isNull(v: json.Value): Bool = v?jNull
    let memberCount(o: json.Object): Int = extent json.names(o)
    let hasMember(o: json.Object name: String): Bool = maybe.isSome(json.get(o name))
    (* A JSON integer that is not a boolean, as an Int *)
    let integer(v: json.Value): Int =
        case v
            when jNumber with x then
                if not(x.isInteger) then fail(:Ok) end
                let n = strutil.tryToInt(x.text)
                (* Saturate integers outside Int's range, matching C's strtoll;
                 * json.parse has already checked the numeric syntax *)
                if maybe.isSome(n) then maybe.unwrap(n)
                elsif strutil.startsWith(x.text "-") then {0 - 9223372036854775807} - 1
                else 9223372036854775807
                end
            else fail()
        end
    (* Reader decodes a document's value by its type using the document's type
     * table, raising dynamic.error (fail) on anything ill-formed.
     *
     * newReader checks every node of the table before anything is read
     * (checkNode). typeOf makes the type of a node, once: a node reached
     * again while its own type is being made, as a list's option node is
     * from its payload's tail (dynamicJson's Graph shows one), becomes a
     * recursive type. value decodes JSON by its type, the reverse of
     * dynamicWriter's encodeValue: an object with an @id is recorded in
     * objects as it is made, so that a later {"@ref": n} returns that same
     * object, shared as it was when written. *)
    Let Reader = Tuple
        (* The type table's entries, by node index *)
        table: Array(json.Value)
        (* The type of each node made so far, by index, kept only when it
         * mentions no recursive type's binder and no enclosing auto type's
         * parameter (a type that does is made again wherever it is reached) *)
        types: hashMap.T(Int Type)
        (* The nodes whose types are being made, and those of them reached
         * again while being made, which become recursive types *)
        active: hashMap.T(Int Bool)
        recursive: hashMap.T(Int Bool)
        (* A fresh symbol id for each node, the binder of its recursive type
         * if it becomes one, and the same ids as a set *)
        binderIds: Array(Int)
        binderIdSet: hashMap.T(Int Bool)
        (* The objects read so far, by their @id *)
        objects: hashMap.T(Int Seen)
        (* The type parameters of the auto types being built, innermost last,
         * which param nodes refer to; and the witnesses of the auto values
         * being read, which values of those parameters are read at *)
        autoParams: vector.T(Type)
        witnesses: vector.T(Ref)
    end
    let checkRef(rd: Reader v: json.Value): Ref =
        case v
            when jString with x then if dynamicJson.isBuiltinName(x.s) then builtin(x.s) else fail() end
            when jNumber with x then
                let i = integer(v)
                if {i < 0} orif {i >= extent rd.table} then fail(:Ok) end
                nodeRef(i)
            else fail()
        end
    let isPairList(v: json.Value): Bool =
        case v
            when jArray with x then
                let var good = true
                for i = 0 upto {vector.length(x.items) - 1} do
                    case vector.get(x.items i)
                        when jArray with p then
                            if {vector.length(p.items) isnot 2} orif not(vector.get(p.items 0)?jString) then
                                good := false
                            end
                        else good := false
                    end
                end
                good
            else false
        end
    let checkPairs(rd: Reader v: json.Value): Ok =
        begin
            if not(isPairList(v)) then fail(:Ok) end
            let ps = items(v)
            for i = 0 upto {vector.length(ps) - 1} do
                checkRef(rd vector.get(items(vector.get(ps i)) 1))
            end
        end
    let onlyMembers(o: json.Object allowed: Array(String)): Bool =
        begin
            let ns = json.names(o)
            let var good = true
            for i = 0 upto {extent ns - 1} do
                let var found = false
                for j = 0 upto {extent allowed - 1} do if stringOp.equal(ns[i] allowed[j]) then found := true end end
                if not(found) then good := false end
            end
            good
        end
    (* Checks that one entry of a document's type table has the form
     * docs/dynamic.md section 2.2 gives, raising dynamic.error (fail) if not.
     *
     * A document may come from anywhere, so the reader checks the whole table
     * before reading anything with it, and the rest of the reader can then
     * index the table and take a node's parts apart without checking. An
     * entry is an object with one key, naming a type constructor, such as
     *
     *     {"tuple": [["head", "Int"], ["tail", 0]]}
     *
     * or an abstract type, {"abstract": ..., "args": [...], "rep": ...}, whose
     * args are optional but not empty. Every type reference must be the name
     * of a built-in type ("Int") or the index of an entry in the table (0)
     * (checkRef). An option case's reference, if any, must be to a tuple
     * entry, the case's components. A function parameter's mode is "", "var",
     * or "out", and a param entry's count of auto types is a non-negative
     * integer. Labels are checked only to be strings. *)
    let checkNode(rd: Reader node: json.Value): Ok =
        begin
            let o = members(node)
            if hasMember(o "abstract") then
                if not(onlyMembers(o array of "abstract" "args" "rep" end)) orif not(hasMember(o "rep"))
                        orif not(member(o "abstract")?jString) then
                    fail(:Ok)
                end
                if hasMember(o "args") then
                    let args = member(o "args")
                    if not(args?jArray) orif vector.empty(items(args)) then fail(:Ok) end
                    for i = 0 upto {vector.length(items(args)) - 1} do
                        checkRef(rd vector.get(items(args) i))
                    end
                end
                checkRef(rd member(o "rep"))
                ok
            else
                if memberCount(o) isnot 1 then fail(:Ok) end
                let kind = json.names(o)[0]
                let body = member(o kind)
                if stringOp.equal(kind "record") orif stringOp.equal(kind "variant")
                        orif stringOp.equal(kind "option") then
                    let b = members(body)
                    let ns = json.names(b)
                    for i = 0 upto {extent ns - 1} do
                        let r = member(b ns[i])
                        if not(isNull(r)) orif stringOp.equal(kind "record") then checkRef(rd r) end
                        if stringOp.equal(kind "option") andif not(isNull(r)) then
                            (* An option case's components are a tuple type *)
                            let target = checkRef(rd r)
                            if isBuiltin(target) then fail(:Ok) end
                            case rd.table[target.index]
                                when jObject with t then if not(hasMember(t.o "tuple")) then fail(:Ok) end
                                else fail(:Ok)
                            end
                        end
                    end
                elsif stringOp.equal(kind "tuple") then
                    checkPairs(rd body)
                elsif stringOp.equal(kind "array") orif stringOp.equal(kind "exception") then
                    checkRef(rd body)
                    ok
                elsif stringOp.equal(kind "external") then
                    if not(body?jString) orif not(stringOp.equal(text(body) wordType)) then fail(:Ok) end
                elsif stringOp.equal(kind "param") then
                    if integer(body) < 0 then fail(:Ok) end
                elsif stringOp.equal(kind "auto") then
                    let b = members(body)
                    if {memberCount(b) isnot 2} orif not(hasMember(b "bound")) orif not(hasMember(b "components")) then
                        fail(:Ok)
                    end
                    if not(isNull(member(b "bound"))) then checkRef(rd member(b "bound")) end
                    checkPairs(rd member(b "components"))
                elsif stringOp.equal(kind "fun") then
                    let b = members(body)
                    if {memberCount(b) isnot 2} orif not(hasMember(b "params")) orif not(hasMember(b "result"))
                            orif not(member(b "params")?jArray) then
                        fail(:Ok)
                    end
                    let ps = items(member(b "params"))
                    for i = 0 upto {vector.length(ps) - 1} do
                        let p = vector.get(ps i)
                        let good =
                            case p
                                when jArray with x then
                                    if vector.length(x.items) is 2 then
                                        case vector.get(x.items 0)
                                            when jString with m then
                                                stringOp.equal(m.s "") orif stringOp.equal(m.s "var")
                                                    orif stringOp.equal(m.s "out")
                                            else false
                                        end
                                    else
                                        false
                                    end
                                else false
                            end
                        if not(good) then fail(:Ok) end
                        checkRef(rd vector.get(items(p) 1))
                    end
                    checkRef(rd member(b "result"))
                    ok
                else
                    fail()
                end
            end
        end
    let newReader(table: json.Value): Reader =
        begin
            let entries = vector.toArray(items(table))
            let binderIds = array of(extent entries 0)
            let binderIdSet = hashMap.new(:Int :Bool intEqual hash.int)
            let rd: Reader = tuple
                let table = entries
                let types = hashMap.new(intEqual hash.int)
                let active = hashMap.new(intEqual hash.int)
                let recursive = hashMap.new(intEqual hash.int)
                let binderIds = binderIds
                let binderIdSet = binderIdSet
                let objects = hashMap.new(intEqual hash.int)
                let autoParams = vector.new()
                let witnesses = vector.new()
            end
            for i = 0 upto {extent entries - 1} do checkNode(rd entries[i]) end
            for i = 0 upto {extent entries - 1} do
                binderIds[i] := symbols.allocateSymbolId()
                hashMap.insert(binderIdSet binderIds[i] true)
            end
            rd
        end
    (* A node's kind and body: an abstract node is its own body *)
    Let Entry = Tuple kind: String body: json.Value end
    let entryOf(rd: Reader r: Ref): Entry =
        begin
            let o = members(rd.table[r.index])
            if hasMember(o "abstract") then
                tuple let kind = "abstract" let body = rd.table[r.index] end
            else
                let kind = json.names(o)[0]
                tuple let kind = kind let body = member(o kind) end
            end
        end
    (* Returns the ref that a value of type r0 is written at: r0 itself, unless
     * it is an abstract node (followed to its representation) or a param node
     * (followed to the witness of its enclosing auto value from witnesses, by
     * depth). Raises dynamic.error (fail) for a param with no such auto value,
     * or for a chain longer than the table and witnesses, which can only be a
     * cycle. *)
    let concreteRef(rd: Reader r0: Ref): Ref =
        begin
            let var r = r0
            let var steps = 0
            let limit = {extent rd.table + vector.length(rd.witnesses)} + 1
            let var done = false
            while not(done) do
                if steps >= limit then fail(:Ok) end
                steps := steps + 1
                if isBuiltin(r) then
                    done := true
                else
                    let e = entryOf(rd r)
                    if stringOp.equal(e.kind "abstract") then
                        r := checkRef(rd member(members(e.body) "rep"))
                    elsif stringOp.equal(e.kind "param") then
                        let n = integer(e.body)
                        let count = vector.length(rd.witnesses)
                        if n >= count then fail(:Ok) end
                        r := vector.get(rd.witnesses {{count - 1} - n})
                    else
                        done := true
                    end
                end
            end
            r
        end
    let mentionsAny(t: Type ids: hashMap.T(Int Bool)): Bool =
        begin
            let var found = false
            for i = 0 upto {extent t.fv - 1} do if hashMap.contains(ids t.fv[i]) then found := true end end
            found
        end
    (* The module abstract type name (applied to args), whose recorded
     * representation is rep: the linked module's type if rep is its
     * representation, or the opaque type of an unlinked module (docs/dynamic.md
     * section 2.3) *)
    let abstractType(rd: Reader name: String args: Array(Type) rep: Type): Type =
        begin
            let var closed = not(mentionsAny(rep rd.binderIdSet))
            for i = 0 upto {extent args - 1} do if mentionsAny(args[i] rd.binderIdSet) then closed := false end end
            let found = abstractTypes.abstractTypeByName(name)
            let entry =
                if maybe.isNone(found) then
                    if not(closed) then fail(:Ok) end
                    let var0 = tm.typeVariable(name abstractTypes.abstractTypeSymbolId(name)
                            maybe.some(operatorKind(extent args)))
                    abstractTypes.registerUnlinkedAbstractType(name var0)
                else
                    maybe.unwrap(found)
                end
            let bound = dynamicJson.boundOf(entry.typeVar)
            if {arity(bound) isnot extent args} orif not(dynamicJson.isUnbounded(bound)) then fail(:Ok) end
            let known =
                if not(entry.linked) then
                    try
                        dynamicJson.representation(entry args)
                    when model.runError with err then
                        if not(closed) then raise model.runError with err end end
                        vector.append(entry.instances tuple let args = args let rep = rep end)
                        rep
                    end
                else
                    dynamicJson.representation(entry args)
                end
            if not(subtyping.isTypeEqual(known rep maybe.none())) then fail(:Ok) end
            if extent args > 0 then tm.typeApp(entry.typeVar args) else entry.typeVar end
        end
    let pairsOf(v: json.Value): vector.T(json.Value) = items(v)
    let pairLabel(p: json.Value): String = text(vector.get(items(p) 0))
    let pairRef(rd: Reader p: json.Value): Ref = checkRef(rd vector.get(items(p) 1))
    (* The type of a table entry; a node reached again while it is being built
     * becomes a recursive type *)
    let rec typeOf(rd: Reader r: Ref): Type =
        if isBuiltin(r) then
            dynamicJson.builtinType(r.name)
        elsif hashMap.contains(rd.types r.index) then
            hashMap.find(rd.types r.index)
        else
            let e = entryOf(rd r)
            if stringOp.equal(e.kind "param") then
                let n = integer(e.body)
                let count = vector.length(rd.autoParams)
                if n >= count then fail(:Ok) end
                vector.get(rd.autoParams {{count - 1} - n})
            elsif hashMap.contains(rd.active r.index) then
                hashMap.insert(rd.recursive r.index true)
                tm.typeVariable("T" <> intKey(r.index) rd.binderIds[r.index] maybe.some(tm.typeKind))
            else
                let binder = rd.binderIds[r.index]
                hashMap.insert(rd.active r.index true)
                let t0 = build(rd e)
                hashMap.delete(rd.active r.index)
                let t =
                    if hashMap.contains(rd.recursive r.index) then
                        tm.recType("T" <> intKey(r.index) binder tm.typeKind t0)
                    else
                        t0
                    end
                (* A type that mentions a recursive type's binder, or an
                 * enclosing auto type's parameter, is that type only where it
                 * was reached *)
                let var local = mentionsAny(t rd.binderIdSet)
                for i = 0 upto {vector.length(rd.autoParams) - 1} do
                    case vector.get(rd.autoParams i).form
                        when typeVariable with p then if dynamicJson.mentions(t p.symbolId) then local := true end
                        else ok
                    end
                end
                if not(local) then hashMap.insert(rd.types r.index t) end
                t
            end
        end
    and build(rd: Reader e: Entry): Type =
        if stringOp.equal(e.kind "record") then
            let b = members(e.body)
            let ns = json.names(b)
            let fields = vector.new(:tm.RecordField)
            for i = 0 upto {extent ns - 1} do
                vector.append(fields tuple
                    let name = dynamicJson.fieldName(ns[i])
                    let type = typeOf(rd checkRef(rd member(b ns[i])))
                    let isVar = isVarLabel(ns[i])
                end)
            end
            tm.recordType(vector.toArray(fields) maybe.none())
        elsif stringOp.equal(e.kind "tuple") then
            let ps = pairsOf(e.body)
            let fields = vector.new(:tm.TupleComponent)
            for i = 0 upto {vector.length(ps) - 1} do
                let p = vector.get(ps i)
                let label = pairLabel(p)
                let name = dynamicJson.fieldName(label)
                vector.append(fields tm.tupleField(
                        if stringOp.length(name) > 0 then maybe.some(name) else maybe.none(:String) end
                        typeOf(rd pairRef(rd p)) isVarLabel(label)))
            end
            tm.tupleType(vector.toArray(fields))
        elsif stringOp.equal(e.kind "variant") then
            let b = members(e.body)
            let ns = json.names(b)
            let cases = vector.new(:tm.VariantField)
            for i = 0 upto {extent ns - 1} do
                let r = member(b ns[i])
                vector.append(cases tuple
                    let name = dynamicJson.fieldName(ns[i])
                    let type = if isNull(r) then maybe.none(:Type) else maybe.some(typeOf(rd checkRef(rd r))) end
                    let isVar = isVarLabel(ns[i])
                end)
            end
            tm.variantType(vector.toArray(cases))
        elsif stringOp.equal(e.kind "option") then
            let b = members(e.body)
            let ns = json.names(b)
            let cases = vector.new(:tm.OptionField)
            for i = 0 upto {extent ns - 1} do
                let r = member(b ns[i])
                vector.append(cases tuple
                    let name = ns[i]
                    let payload = if isNull(r) then maybe.none(:Type) else maybe.some(typeOf(rd checkRef(rd r))) end
                end)
            end
            tm.optionType(vector.toArray(cases))
        elsif stringOp.equal(e.kind "array") then
            tm.arrayType(typeOf(rd checkRef(rd e.body)))
        elsif stringOp.equal(e.kind "external") then
            tm.externalType(text(e.body) text(e.body))
        elsif stringOp.equal(e.kind "abstract") then
            let o = members(e.body)
            let args = vector.new(:Type)
            if hasMember(o "args") then
                let a = items(member(o "args"))
                for i = 0 upto {vector.length(a) - 1} do
                    vector.append(args typeOf(rd checkRef(rd vector.get(a i))))
                end
            end
            let argTypes = vector.toArray(args)
            abstractType(rd text(member(o "abstract")) argTypes typeOf(rd checkRef(rd member(o "rep"))))
        elsif stringOp.equal(e.kind "auto") then
            let b = members(e.body)
            let boundJson = member(b "bound")
            let kindBound =
                if isNull(boundJson) then tm.typeKind else tm.powerKind(typeOf(rd checkRef(rd boundJson))) end
            let param = tm.typeVariable("A" <> intKey(vector.length(rd.autoParams)) symbols.allocateSymbolId()
                    maybe.some(kindBound))
            vector.append(rd.autoParams param)
            let ps = pairsOf(member(b "components"))
            let signature = vector.new(:tm.RecordField)
            for i = 0 upto {vector.length(ps) - 1} do
                let p = vector.get(ps i)
                let label = pairLabel(p)
                vector.append(signature tuple
                    let name = dynamicJson.fieldName(label)
                    let type = typeOf(rd pairRef(rd p))
                    let isVar = isVarLabel(label)
                end)
            end
            vector.pop(rd.autoParams)
            case param.form
                when typeVariable with v then tm.autoType(v.name v.symbolId kindBound vector.toArray(signature))
                else fail()
            end
        elsif stringOp.equal(e.kind "fun") then
            let b = members(e.body)
            let ps = items(member(b "params"))
            let params = vector.new(:tm.Param)
            for i = 0 upto {vector.length(ps) - 1} do
                let p = vector.get(ps i)
                let mode = pairLabel(p)
                vector.append(params tuple
                    let name = "x" <> intKey(i + 1)
                    let type = typeOf(rd pairRef(rd p))
                    let isVar = stringOp.equal(mode "var")
                    let isOut = stringOp.equal(mode "out")
                end)
            end
            tm.funType(vector.toArray(params) typeOf(rd checkRef(rd member(b "result"))))
        else
            tm.exceptionOf(typeOf(rd checkRef(rd e.body)))
        end
    (* Resolves {"@ref": n} at type r, verifying that the referenced object was
     * read at a subtype of r (as the runtime's quest_read_value checks).
     * Otherwise returns the object's @id, if any, and its unwrapped
     * contents. *)
    Let Shared = Tuple existing: maybe.T(Value) objId: maybe.T(Int) contents: json.Value end
    let sameRef(a: Ref b: Ref): Bool = stringOp.equal(a.name b.name) andif {a.index is b.index}
    let sharedOf(rd: Reader data: json.Value kind: String r: Ref): Shared =
        case data
            when jObject with x then
                if hasMember(x.o "@ref") then
                    if memberCount(x.o) isnot 1 then fail(:Ok) end
                    let n = integer(member(x.o "@ref"))
                    let found = hashMap.get(rd.objects n)
                    if maybe.isNone(found) then fail(:Ok) end
                    let obj = maybe.unwrap(found)
                    if not(sameRef(obj.readAt r))
                            andif not(subtyping.isSubtype(typeOf(rd obj.readAt) typeOf(rd r) maybe.none())) then
                        fail(:Ok)
                    end
                    tuple let existing = maybe.some(obj.value) let objId = maybe.none() let contents = json.null end
                elsif hasMember(x.o "@id") then
                    let id = integer(member(x.o "@id"))
                    if hashMap.contains(rd.objects id) then fail(:Ok) end
                    if stringOp.equal(kind "record") then
                        let rest = json.newObject()
                        let ns = json.names(x.o)
                        for i = 0 upto {extent ns - 1} do
                            if not(stringOp.equal(ns[i] "@id")) then json.put(rest ns[i] member(x.o ns[i])) end
                        end
                        tuple
                            let existing = maybe.none()
                            let objId = maybe.some(id)
                            let contents = json.object(rest)
                        end
                    else
                        if {memberCount(x.o) isnot 2} orif not(hasMember(x.o "@items")) then fail(:Ok) end
                        tuple
                            let existing = maybe.none()
                            let objId = maybe.some(id)
                            let contents = member(x.o "@items")
                        end
                    end
                else
                    tuple let existing = maybe.none() let objId = maybe.none() let contents = data end
                end
            else tuple let existing = maybe.none() let objId = maybe.none() let contents = data end
        end
    let wordLimit = "18446744073709551615"
    (* A word's integer: 0 to 2^64 - 1 *)
    let wordOf(v: json.Value): word.T =
        case v
            when jNumber with x then
                let t = x.text
                let n = stringOp.length(t)
                let tooLarge = {n > stringOp.length(wordLimit)}
                    orif {{n is stringOp.length(wordLimit)} andif not(stringOp.precedes(t wordLimit))}
                if not(x.isInteger) orif tooLarge orif {{n > 0} andif {stringOp.getChar(t 0) is '-'}} then fail(:Ok) end
                let w = strutil.tryToWord(t)
                if maybe.isNone(w) then fail(:Ok) end
                maybe.unwrap(w)
            else fail()
        end
    let labelsOf(ps: vector.T(json.Value)): maybe.T(Array(maybe.T(String))) =
        begin
            let labels = array of(vector.length(ps) maybe.none(:String))
            for i = 0 upto {vector.length(ps) - 1} do
                let name = dynamicJson.fieldName(pairLabel(vector.get(ps i)))
                labels[i] := if stringOp.length(name) > 0 then maybe.some(name) else maybe.none() end
            end
            maybe.some(labels)
        end
    let rec value(rd: Reader data: json.Value r0: Ref): Value =
        begin
            let r = concreteRef(rd r0)
            if isBuiltin(r) then
                builtinValue(rd data r.name)
            else
                let e = entryOf(rd r)
                if stringOp.equal(e.kind "external") then
                    option vWord of Value with let w = wordOf(data) end
                elsif stringOp.equal(e.kind "auto") then
                    let o = members(data)
                    if {memberCount(o) isnot 2} orif not(hasMember(o "@type")) orif not(hasMember(o "@value")) then
                        fail(:Ok)
                    end
                    let witness = checkRef(rd member(o "@type"))
                    let b = members(e.body)
                    if not(isNull(member(b "bound"))) andif not(subtyping.isSubtype(typeOf(rd witness)
                            typeOf(rd checkRef(rd member(b "bound"))) maybe.none())) then
                        fail(:Ok)
                    end
                    let values = items(member(o "@value"))
                    let components = pairsOf(member(b "components"))
                    if vector.length(values) isnot vector.length(components) then fail(:Ok) end
                    vector.append(rd.witnesses witness)
                    let vs = array of(vector.length(values) model.okValue)
                    for i = 0 upto {extent vs - 1} do
                        vs[i] := value(rd vector.get(values i) pairRef(rd vector.get(components i)))
                    end
                    vector.pop(rd.witnesses)
                    let labels = array of(extent vs maybe.none(:String))
                    for i = 0 upto {extent vs - 1} do
                        labels[i] := maybe.some(dynamicJson.fieldName(pairLabel(vector.get(components i))))
                    end
                    option vAuto of Value with
                        let a = tuple
                            let value = model.tupleValue(vs maybe.some(labels))
                            let type = typeOf(rd witness)
                        end
                    end
                elsif stringOp.equal(e.kind "record") then
                    let s = sharedOf(rd data "record" r)
                    if maybe.isSome(s.existing) then
                        maybe.unwrap(s.existing)
                    else
                        let fields = members(s.contents)
                        let b = members(e.body)
                        let labels = json.names(b)
                        (* The fields must be the type's, each once *)
                        if extent json.names(fields) isnot extent labels then fail(:Ok) end
                        for i = 0 upto {extent labels - 1} do
                            if not(hasMember(fields dynamicJson.fieldName(labels[i]))) then fail(:Ok) end
                        end
                        let map = model.newFields()
                        let result = model.recordValue(map)
                        if maybe.isSome(s.objId) then
                            hashMap.insert(rd.objects maybe.unwrap(s.objId)
                                    tuple let value = result let readAt = r end)
                        end
                        for i = 0 upto {extent labels - 1} do
                            let name = dynamicJson.fieldName(labels[i])
                            hashMap.insert(map name value(rd member(fields name) checkRef(rd member(b labels[i]))))
                        end
                        result
                    end
                elsif stringOp.equal(e.kind "array") then
                    let s = sharedOf(rd data "array" r)
                    if maybe.isSome(s.existing) then
                        maybe.unwrap(s.existing)
                    else
                        let its = items(s.contents)
                        let elements = array of(vector.length(its) model.okValue)
                        let result = option vArray of Value with let a = elements end
                        if maybe.isSome(s.objId) then
                            hashMap.insert(rd.objects maybe.unwrap(s.objId)
                                    tuple let value = result let readAt = r end)
                        end
                        let elementRef = checkRef(rd e.body)
                        for i = 0 upto {extent elements - 1} do
                            elements[i] := value(rd vector.get(its i) elementRef)
                        end
                        result
                    end
                elsif stringOp.equal(e.kind "tuple") then
                    let s = sharedOf(rd data "tuple" r)
                    if maybe.isSome(s.existing) then
                        maybe.unwrap(s.existing)
                    else
                        let its = items(s.contents)
                        let ps = pairsOf(e.body)
                        if vector.length(its) isnot vector.length(ps) then fail(:Ok) end
                        let elements = array of(vector.length(ps) model.okValue)
                        let result = model.tupleValue(elements labelsOf(ps))
                        if maybe.isSome(s.objId) then
                            hashMap.insert(rd.objects maybe.unwrap(s.objId)
                                    tuple let value = result let readAt = r end)
                        end
                        for i = 0 upto {extent elements - 1} do
                            elements[i] := value(rd vector.get(its i) pairRef(rd vector.get(ps i)))
                        end
                        result
                    end
                elsif stringOp.equal(e.kind "variant") orif stringOp.equal(e.kind "option") then
                    let isVariant = stringOp.equal(e.kind "variant")
                    let b = members(e.body)
                    let labels = json.names(b)
                    (* The case of a tag, and its payload's ref (none, or Ok,
                     * for a bare tag) *)
                    let caseRef(tag: String): maybe.T(json.Value) =
                        begin
                            let var found = maybe.none(:json.Value)
                            for i = 0 upto {extent labels - 1} do
                                if stringOp.equal(dynamicJson.fieldName(labels[i]) tag) then
                                    found := maybe.some(member(b labels[i]))
                                end
                            end
                            found
                        end
                    let isBare(c: json.Value): Bool =
                        isNull(c) orif case c when jString with x then stringOp.equal(x.s "Ok") else false end
                    let make(tag: String payload: Value): Value =
                        if isVariant then model.variantValue(tag maybe.some(payload))
                        else model.optionValue(tag maybe.some(payload))
                        end
                    case data
                        when jString with x then
                            let c = caseRef(x.s)
                            if maybe.isNone(c) orif not(isBare(maybe.unwrap(c))) then fail(:Ok) end
                            make(x.s model.okValue)
                        when jObject with x then
                            if memberCount(x.o) isnot 1 then fail(:Ok) end
                            let tag = json.names(x.o)[0]
                            let payload = member(x.o tag)
                            let c = caseRef(tag)
                            if maybe.isNone(c) orif isBare(maybe.unwrap(c)) then fail(:Ok) end
                            let payloadRef = checkRef(rd maybe.unwrap(c))
                            if isVariant then
                                make(tag value(rd payload payloadRef))
                            else
                                (* The case's components, written in place *)
                                let ps = pairsOf(entryOf(rd payloadRef).body)
                                let its = items(payload)
                                if vector.length(its) isnot vector.length(ps) then fail(:Ok) end
                                let elements = array of(vector.length(ps) model.okValue)
                                for i = 0 upto {extent elements - 1} do
                                    elements[i] := value(rd vector.get(its i) pairRef(rd vector.get(ps i)))
                                end
                                make(tag model.tupleValue(elements labelsOf(ps)))
                            end
                        else fail()
                    end
                else
                    fail()
                end
            end
        end
    and builtinValue(rd: Reader data: json.Value name: String): Value =
        case data
            when jNumber with x then
                if stringOp.equal(name "Int") andif x.isInteger then
                    model.intValue(integer(data))
                elsif stringOp.equal(name "Real") then
                    let r = strutil.tryToReal(x.text)
                    if maybe.isNone(r) then fail(:Ok) end
                    model.realValue(maybe.unwrap(r))
                else
                    fail()
                end
            when jString with x then
                if stringOp.equal(name "Real") andif stringOp.equal(x.s "Infinity") then
                    model.realValue(realOp.maxReal ** 2.0)
                elsif stringOp.equal(name "Real") andif stringOp.equal(x.s "-Infinity") then
                    model.realValue(0.0 -- {realOp.maxReal ** 2.0})
                elsif stringOp.equal(name "Char") andif {stringOp.length(x.s) is 1} then
                    model.charValue(stringOp.getChar(x.s 0))
                elsif stringOp.equal(name "String") then
                    model.stringValue(x.s)
                else
                    fail()
                end
            when jBool with x then
                if stringOp.equal(name "Bool") then model.boolValue(x.b) else fail() end
            when jNull then
                if stringOp.equal(name "Ok") then model.okValue else fail() end
            when jObject with x then
                if stringOp.equal(name "Dynamic") andif {memberCount(x.o) is 2} andif hasMember(x.o "@type")
                        andif hasMember(x.o "@value") then
                    dynamic(rd checkRef(rd member(x.o "@type")) member(x.o "@value"))
                else
                    fail()
                end
            else fail()
        end
    and dynamic(rd: Reader r: Ref data: json.Value): Value =
        begin
            let v = value(rd data r)
            option vAuto of Value with
                let a = tuple
                    let value = model.tupleValue(array of v end maybe.some(array of maybe.some("a") end))
                    let type = typeOf(rd r)
                end
            end
        end
    let decodeDocument(document: json.Value): Value =
        begin
            let o = members(document)
            if {memberCount(o) isnot 4} orif not(hasMember(o "quest")) orif not(hasMember(o "types"))
                    orif not(hasMember(o "type")) orif not(hasMember(o "value")) then
                fail(:Ok)
            end
            if integer(member(o "quest")) isnot formatVersion then fail(:Ok) end
            let rd = newReader(member(o "types"))
            dynamic(rd checkRef(rd member(o "type")) member(o "value"))
        end

    (* A repeated key is an error, as in every reader *)
    let decode(text: String): Value =
        decodeDocument(try json.parseWith(text json.parsingDynamic) when json.error then fail(:json.Value) end)
end
