(* Quest Self-Hosted Compiler: Writing Dynamic Values Interface
 *
 * dynamic.extern's document (docs/dynamic.md section 2): a dynamic value's
 * type table, canonical (values/dynamicJson), and its value. An object
 * reached more than once is written once, with @id, and then as
 * {"@ref": n}; a value the format cannot hold raises dynamic.error. The
 * counterpart is bootstrap/python/quest/values/dynamic_writer.py. *)

interface DynamicWriter
import
    questlang/values/model : questlang/values/Model
export
    (* A dynamic value (an auto value of one component) as a version 1
     * document *)
    encode(d: model.Value): String
end
