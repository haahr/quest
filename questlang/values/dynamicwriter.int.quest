(* Quest Self-Hosted Compiler: Writing Dynamic Values Interface
 *
 * Implements dynamic.extern's serialization of dynamic values into format
 * version 1 documents (docs/dynamic.md section 2), producing a canonical type
 * table (values/dynamicJson) and the encoded value. Any object reached more
 * than once is written once with an @id and referenced thereafter as
 * {"@ref": n}; any value the format cannot represent raises dynamic.error.
 * The counterpart is bootstrap/python/quest/values/dynamic_writer.py. *)

interface DynamicWriter
import
    questlang/values/model : questlang/values/Model
export
    (* A dynamic value (an auto value of one component) as a version 1
     * document *)
    encode(d: model.Value): String
end
