(* Quest Self-Hosted Compiler: Reading Dynamic Values Interface
 *
 * Implements dynamic.intern's decoding of serialized dynamic documents
 * (docs/dynamic.md section 2). It converts a document's type table into Quest
 * types and decodes its value at its declared type, resolving each @ref at the
 * type expected by its position. Any malformed or ill-typed document raises
 * dynamic.error. The counterpart is
 * bootstrap/python/quest/values/dynamic_reader.py. *)

interface DynamicReader
import
    questlang/values/model : questlang/values/Model
    util/json : util/Json
export
    (* A version 1 document's dynamic value *)
    decode(text: String): model.Value
    (* The same, from the document parsed (with json.parsingDynamic) *)
    decodeDocument(document: json.Value): model.Value
end
