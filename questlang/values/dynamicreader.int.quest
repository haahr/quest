(* Quest Self-Hosted Compiler: Reading Dynamic Values Interface
 *
 * dynamic.intern's reading of a document (docs/dynamic.md section 2): its
 * type table made into types, and its value read at its type, an @ref at the
 * type its place expects. A document that does not fit raises dynamic.error.
 * The counterpart is bootstrap/python/quest/values/dynamic_reader.py. *)

interface DynamicReader
import
    questlang/values/model : questlang/values/Model
export
    (* A version 1 document's dynamic value *)
    decode(text: String): model.Value
end
