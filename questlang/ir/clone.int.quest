(* Quest Self-Hosted Compiler: IR Cloning Interface
 *
 * Clones IR functions and bodies while applying a type substitution: every
 * variable the copy binds becomes a fresh one (or one explicitly bound via
 * bindVar), and every other node is copied except module references and free
 * variables. A relabeling cloner also assigns fresh labels to the loops and
 * join points (local merge targets) bound inside the copy so it can sit beside
 * its original in one function during inlining; specialize's clones become
 * separate functions and keep their labels. *)

interface Clone
import
    collections/hashMap : collections/HashMap
    util/maybe : util/Maybe

    questlang/ir/nodes : questlang/ir/Nodes
    questlang/types/model : questlang/types/Model
export
    (* The count of the fresh labels made in a unit *)
    Def Labels = Tuple var count: Int end
    (* State for a copy in progress. subst maps type parameter symbols to
     * replacement types. vars maps each original variable id to the variable
     * used in the copy, and labels maps each bound loop or join-point label to
     * its fresh label. relabeling holds the unit's shared label counter when
     * fresh labels are generated. sharesCode is true for a closed unit, where
     * functions live at the unit's top level and a copied closure keeps its
     * existing function instead of cloning it. *)
    Def Cloner = Tuple
        subst: model.Subst
        vars: hashMap.T(Int nodes.Variable)
        labels: hashMap.T(String String)
        relabeling: maybe.T(Labels)
        sharesCode: Bool
    end

    newCloner(subst: model.Subst): Cloner
    newRelabelingCloner(subst: model.Subst counter: Labels): Cloner
    (* A cloner for a closed unit's code, whose closures' copies share their
     * functions *)
    newClosedCloner(subst: model.Subst): Cloner
    newLabels(): Labels

    (* A type with the substitution applied *)
    ty(c: Cloner t: model.Type): model.Type
    tys(c: Cloner ts: Array(model.Type)): Array(model.Type)
    (* A fresh variable for v, which the copy binds in its place *)
    fresh(c: Cloner v: nodes.Variable): nodes.Variable
    (* Has the copy use another variable in v's place *)
    bindVar(c: Cloner v: nodes.Variable to: nodes.Variable): Ok
    (* The variable the copy uses in v's place *)
    var1(c: Cloner v: nodes.Variable): nodes.Variable
    (* Makes fresh variables (and labels, if the cloner relabels) for every
     * binder in a body and the functions it binds, before the body is
     * copied *)
    bindAll(c: Cloner b: nodes.Body): Ok
    (* A copy of b, using the variables and labels bindAll made for those it
     * binds; any other variable stays as it is *)
    copyBody(c: Cloner b: nodes.Body): nodes.Body
    (* Returns a copy of f using the variables bindAll made for f and its
     * parameters and a copy of its body. Its type parameters are f's,
     * unchanged, and fields set by closure conversion and later passes (env,
     * descriptorParams, viewMaps, unboxedResult) are left unset, because
     * cloning is used by the inliner and specialize before closure conversion
     * runs. *)
    copyFunction(c: Cloner f: nodes.Function): nodes.Function
end
