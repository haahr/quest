(* Quest Self-Hosted Compiler: Closure Conversion Interface
 *
 * Closure conversion lifts every nested function to the unit's top-level
 * function list and replaces each function definition with a closure
 * (docs/ir.md section 8.2; counterpart: bootstrap/python/quest/ir/closure.py).
 * Each funs statement becomes a sequence of let bindings that construct
 * closures pairing the lifted code with its captures (free variables other
 * than globals, in first-use order), which the lifted function unpacks from
 * its environment parameter on entry. A function nested inside polymorphic
 * functions prepends their type parameters to its own, and its closure
 * supplies them as leading type arguments. When a recursive group captures
 * one of its own functions (or itself) alongside outer captures or type
 * parameters, the closure bindings are wrapped in a let rec. *)

interface Closure
import
    questlang/ir/nodes : questlang/ir/Nodes
export
    (* Raised for a function that captures a mutable variable (the bootstrap's
     * ValueError) *)
    capturesMutable: Exception(String)

    (* Converts the unit's functions to closures of lifted functions, in place,
     * returning it *)
    closureConvertUnit(unit: nodes.Unit): nodes.Unit
end
