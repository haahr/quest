(* Quest Self-Hosted Compiler: The IR's Nodes Implementation *)

module nodes : Nodes
import
    questlang/common/location : questlang/common/Location
    questlang/types/model : questlang/types/Model
    questlang/ir/shapes : questlang/ir/Shapes
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    stringOp = string : StringOp
export
    Let Type = model.Type
    Let Shape = shapes.Shape

    Let Rec Variable = Tuple
        id: Int
        hint: String
        type: Type
        isMutable: Bool
        (* Set by the represent pass for a variable of a record or variant type held boxed *)
        var boxed: Bool
    end
    (* A constant: an Int, Real, Bool, Char, or String, or ok *)
    and Const = Tuple value: ConstValue shape: Shape end
    and ConstValue = Option
        constInt with n: Int end
        constReal with r: Real end
        constBool with b: Bool end
        constChar with c: Char end
        constString with s: String end
        constOk
    end
    and Atom = Option
        atomVar with v: Variable end
        atomConst with c: Const end
    end

    (* The static descriptor of a type that mentions no type parameter in scope, or of a template *)
    and StaticDescriptor = Tuple id: Int type: Type echo: Bool end
    (* A descriptor operand (after the describe pass) *)
    and Descriptor = Option
        descVar with v: Variable end
        descStatic with d: StaticDescriptor end
        descInstantiate with template: Type args: Array(Descriptor) end
    end
    and DescriptorParam = Tuple v: Variable symbols: Array(Int) end
    and ViewMapParam = Tuple v: Variable symbol: Int descriptor: Variable bound: Descriptor end
    and Registered = Tuple view: StaticDescriptor layout: StaticDescriptor end
    and OffsetTable = Tuple id: Int view: Type layout: Type var registered: maybe.T(Registered) end
    and TagMap = Tuple id: Int target: Type source: Type end
    and StaticData = Tuple
        descriptors: vector.T(StaticDescriptor)
        offsetTables: vector.T(OffsetTable)
        tagMaps: vector.T(TagMap)
        types: vector.T(Type)
    end
    and TypeParam = Tuple name: String symbolId: Int kind: model.Kind bound: maybe.T(Shape) end

    (* A plan's layout: the polymorphic callee's type parameters' instantiation, and whether the value goes to the
     * generic layout *)
    and PlanLayout = Tuple subst: model.Subst toGeneric: Bool end
    (* How convert changes a value's representation (docs/ir.md section 8.3) *)
    and Plan = Tuple
        id: Int
        kind: String
        source: Type
        target: Type
        var fields: Array(maybe.T(Plan))
        var layout: maybe.T(PlanLayout)
        var access: Array(String)
        var thunkSymbols: Array(Array(Int))
        var descriptors: Array(Descriptor)
        var thunkParams: Array(DescriptorParam)
        var tagMap: maybe.T(TagMap)
    end

    and TypeComponent = Tuple name: String type: Type end
    and FieldAtom = Tuple name: String atom: Atom isVar: Bool end

    (* The operations, the right-hand sides of let, and the atoms *)
    and Op = Option
        opAtom with n: OpAtom end
        opPrim with n: OpPrim end
        opCall with n: OpCall end
        opTypeApp with n: OpTypeApp end
        opModuleMember with n: OpModuleMember end
        opBuiltin with n: OpBuiltin end
        opExternal with n: OpExternal end
        opCallExternal with n: OpCallExternal end
        opMakeClosure with n: OpMakeClosure end
        opEnvField with n: OpEnvField end
        opConvert with n: OpConvert end
        opMakeTuple with n: OpMakeTuple end
        opTupleField with n: OpTupleField end
        opMakeRecord with n: OpMakeRecord end
        opRecordField with n: OpRecordField end
        opMakeVariant with n: OpMakeVariant end
        opMakeOption with n: OpMakeOption end
        opIsTag with n: OpIsTag end
        opPayload with n: OpPayload end
        opOrdinal with n: OpOrdinal end
        opMakeArray with n: OpMakeArray end
        opArrayRep with n: OpArrayRep end
        opIndex with n: OpIndex end
        opMakeAuto with n: OpMakeAuto end
        opMakeException with n: OpMakeException end
        opExceptionPayload with n: OpExceptionPayload end
        opAddrVar with n: OpAddrVar end
        opAddrCell with n: OpAddrCell end
        opAddrField with n: OpAddrField end
        opAddrComponent with n: OpAddrComponent end
        opAddrElement with n: OpAddrElement end
        opLoad with n: OpLoad end
    end

    and ParamEntry = Tuple v: Variable mode: String end
    (* A function: v names it; after closure conversion, a function is one of the unit's, and env, if any, is the
     * environment of the closure it runs *)
    and Function = Tuple
        id: Int
        var v: Variable
        var typeParams: Array(TypeParam)
        var params: Array(ParamEntry)
        var resultType: Type
        var body: Body
        var env: maybe.T(Variable)
        var traceName: maybe.T(String)
        var descriptorParams: Array(DescriptorParam)
        var viewMaps: Array(ViewMapParam)
    end
    and Case = Tuple tags: Array(String) var body: Body var binder: maybe.T(Variable) var components: Array(String) end
    and DescriptorPair = Tuple source: Descriptor target: Descriptor end
    (* How an inspect case of an auto value obtains its components from the payload *)
    and InspectArm = Tuple
        converted: Array(maybe.T(String))
        exact: Bool
        shared: Bool
        plan: maybe.T(Plan)
        layoutError: Bool
        var descriptors: Array(maybe.T(DescriptorPair))
    end
    and InspectCase = Tuple
        matchType: Type
        var binders: Array(Variable)
        var body: Body
        exact: Bool
        var arm: maybe.T(InspectArm)
        var descriptor: maybe.T(Descriptor)
    end

    and Stmt = Option
        sLet with n: StmtLet end
        sVarDecl with n: StmtVarDecl end
        sAssign with n: StmtAssign end
        sStoreAt with n: StmtStoreAt end
        sStoreField with n: StmtStoreField end
        sStoreComponent with n: StmtStoreComponent end
        sStoreElement with n: StmtStoreElement end
        sDo with n: StmtDo end
        sFuns with n: StmtFuns end
        sLetRec with n: StmtLetRec end
        sIf with n: StmtIf end
        sSwitch with n: StmtSwitch end
        sInspect with n: StmtInspect end
        sLoop with n: StmtLoop end
        sTry with n: StmtTry end
        sJoin with n: StmtJoin end
        sEcho with n: StmtEcho end
        sEchoText with n: StmtEchoText end
        sReturn with n: StmtReturn end
        sJump with n: StmtJump end
        sBreak with n: StmtBreak end
        sContinue with n: StmtContinue end
        sRaise with n: StmtRaise end
        sReraise with n: StmtReraise end
        sUnreachable
    end
    (* The fields of each operation and statement, which a case's binding shares (its payload is this tuple) *)
    and OpAtom = Tuple var atom: Atom end
    and OpPrim = Tuple
        op: String
        var args: Array(Atom)
        offset: maybe.T(Int)
        var access: String
        var descriptor: maybe.T(Descriptor)
    end
    and OpCall = Tuple
        var callee: maybe.T(Variable)
        var typeArgs: Array(Type)
        var args: Array(Atom)
        var moduleRef: maybe.T(ModuleRef)
        var member: maybe.T(String)
        var calleeType: maybe.T(Type)
        var descriptors: Array(Descriptor)
    end
    and OpTypeApp = Tuple
        var callee: maybe.T(Variable)
        var typeArgs: Array(Type)
        var moduleRef: maybe.T(ModuleRef)
        var member: maybe.T(String)
        var calleeType: maybe.T(Type)
        var plans: Array(maybe.T(Plan))
        var thunkSymbols: Array(Array(Int))
        var descriptors: Array(Descriptor)
        var thunkParams: maybe.T(Array(DescriptorParam))
    end
    and OpModuleMember = Tuple var moduleRef: ModuleRef var member: maybe.T(String) end
    and OpBuiltin = Tuple name: String end
    and OpExternal = Tuple symbol: String end
    and OpCallExternal = Tuple
        symbol: String
        var typeArgs: Array(Type)
        var args: Array(Atom)
        var descriptors: Array(Descriptor)
    end
    and OpMakeClosure = Tuple
        var code: Function
        var captures: Array(Atom)
        var typeArgs: Array(Type)
        var descriptors: Array(Descriptor)
    end
    and OpEnvField = Tuple var env: Atom index: Int end
    and OpConvert = Tuple var value: Atom var plan: Plan end
    and OpMakeTuple = Tuple var args: Array(Atom) typeComponents: Array(TypeComponent) var embedded: Array(Int) end
    and OpTupleField = Tuple var tup: Atom var index: Int var access: String var viewMap: maybe.T(Variable) end
    and OpMakeRecord = Tuple
        var fields: Array(FieldAtom)
        var embedded: Array(Int)
        var runtimeOffsets: Bool
        var descriptor: maybe.T(Descriptor)
        var offsets: maybe.T(OffsetTable)
        var viewDescriptor: maybe.T(Descriptor)
    end
    and OpRecordField = Tuple
        var recordAtom: Atom
        name: String
        var stored: Bool
        var descriptor: maybe.T(Descriptor)
        var viewMap: maybe.T(Variable)
    end
    and OpMakeVariant = Tuple tag: String var payload: maybe.T(Atom) end
    and OpMakeOption = Tuple
        tag: maybe.T(String)
        var payload: maybe.T(Atom)
        var ordinalAtom: maybe.T(Atom)
        offset: maybe.T(Int)
        cases: Array(String)
        var access: Array(String)
    end
    and OpIsTag = Tuple var value: Atom tag: String var access: String var viewMap: maybe.T(Variable) end
    and OpPayload = Tuple
        var value: Atom
        tag: String
        offset: maybe.T(Int)
        var access: String
        var components: Array(String)
        ordinalIndex: maybe.T(Int)
        var viewMap: maybe.T(Variable)
    end
    and OpOrdinal = Tuple var value: Atom cases: Array(String) var access: String var viewMap: maybe.T(Variable) end
    and OpMakeArray = Tuple var args: Array(Atom) end
    and OpArrayRep = Tuple var count: Atom var init: Atom offset: maybe.T(Int) end
    and OpIndex = Tuple var arr: Atom var index: Atom offset: maybe.T(Int) end
    and OpMakeAuto = Tuple witness: Type autoType: Type var payload: Atom var descriptor: maybe.T(Descriptor) end
    and OpMakeException = Tuple name: String payloadType: maybe.T(Type) end
    and OpExceptionPayload = Tuple var exc: Atom end
    and OpAddrVar = Tuple var v: Variable end
    and OpAddrCell = Tuple var init: Atom end
    and OpAddrField = Tuple var base: Atom name: String var viewMap: maybe.T(Variable) end
    and OpAddrComponent = Tuple var base: Atom index: Int var access: String var viewMap: maybe.T(Variable) end
    and OpAddrElement = Tuple var base: Atom var index: Atom offset: maybe.T(Int) end
    and OpLoad = Tuple var address: Atom end
    and StmtLet = Tuple var v: Variable var value: Op end
    and StmtVarDecl = Tuple var v: Variable var init: maybe.T(Atom) end
    and StmtAssign = Tuple var v: Variable var value: Atom end
    and StmtStoreAt = Tuple var value: Atom var address: Atom end
    and StmtStoreField = Tuple var value: Atom var base: Atom name: String var viewMap: maybe.T(Variable) end
    and StmtStoreComponent = Tuple
        var value: Atom
        var base: Atom
        index: Int
        var access: String
        var viewMap: maybe.T(Variable)
    end
    and StmtStoreElement = Tuple var value: Atom var base: Atom var index: Atom offset: maybe.T(Int) end
    and StmtDo = Tuple var value: Op end
    and StmtFuns = Tuple var functions: Array(Function) recursive: Bool end
    and StmtLetRec = Tuple var vars: Array(Variable) var body: Body end
    and StmtIf = Tuple var cond: Atom var thenBody: Body var elseBody: Body end
    and StmtSwitch = Tuple
        var value: Atom
        var cases: Array(Case)
        var elseBody: maybe.T(Body)
        var access: String
        var viewMap: maybe.T(Variable)
    end
    and StmtInspect = Tuple
        var value: Atom
        var cases: Array(InspectCase)
        var elseBody: maybe.T(Body)
        autoType: maybe.T(Type)
        offset: maybe.T(Int)
        var witness: maybe.T(DescriptorParam)
    end
    and StmtLoop = Tuple label: String var body: Body end
    and StmtTry = Tuple var body: Body var exc: Variable var handler: Body catching: String var catches: Array(Atom) end
    and StmtJoin = Tuple label: String var params: Array(Variable) var continuation: Body var body: Body end
    and StmtEcho = Tuple var value: Atom type: Type prefix: String var descriptor: maybe.T(Descriptor) end
    and StmtEchoText = Tuple text: String end
    and StmtReturn = Tuple var value: Atom end
    and StmtJump = Tuple label: String var args: Array(Atom) end
    and StmtBreak = Tuple label: String end
    and StmtContinue = Tuple label: String end
    and StmtRaise = Tuple var exc: Atom var payload: maybe.T(Atom) offset: maybe.T(Int) end
    and StmtReraise = Tuple var exc: Variable end
    (* A sequence of statements; a terminator, if any, is last *)
    and Body = Tuple id: Int var statements: vector.T(Stmt) end

    (* A module's members (or exports) by name, in the order they were bound *)
    and Members = Tuple names: vector.T(String) vars: hashMap.T(String Variable) end
    and AbstractTypeEntry = Tuple name: String arity: Int descriptor: StaticDescriptor end
    (* A module defined by the unit *)
    and Module = Tuple
        id: Int
        name: String
        interfaceName: String
        var init: Body
        var members: Members
        var exports: maybe.T(Members)
        var recordVar: maybe.T(Variable)
        var abstractTypes: Array(AbstractTypeEntry)
    end
    (* A module the unit uses from elsewhere *)
    and Import = Tuple
        id: Int
        name: String
        modulePath: String
        canonicalPath: String
        interfacePath: String
        recordType: maybe.T(Type)
    end
    (* A reference to a module: one the unit defines, or one it imports (by identity, never by name) *)
    and ModuleRef = Option
        refModule with m: Module end
        refImport with i: Import end
    end

    (* A compilation unit *)
    Let Unit = Tuple
        var main: Body
        var modules: vector.T(Module)
        var imports: Array(Import)
        var functions: vector.T(Function)
        var stage: String
        var sourceMap: maybe.T(location.SourceMap)
        var staticData: maybe.T(StaticData)
    end

    let direct = "direct"
    let original = "original"
    let proxy = "proxy"

    let catchListed = "listed"
    let catchAll = "all"
    let catchUnknown = "unknown"

    let stages = array of "core" "specialized" "closed" "represented" "described" end

    let descriptorType = model.externalType("descriptor" "const QTypeDescriptor *")
    let viewMapType = model.externalType("view_map" "const QViewMap *")

    (* Identities of the records the passes key maps by *)
    let counter = tuple let var id = 0 end
    let nextId(): Int = begin counter.id := counter.id + 1 counter.id end

    (* =========================================================================
     * Constructors
     * ========================================================================= *)

    let newVar(hint: String t: Type isMutable: Bool): Variable =
        tuple let id = nextId() let hint = hint let type = t let isMutable = isMutable let var boxed = false end

    let newBody(): Body = tuple let id = nextId() let var statements = vector.new(:Stmt) end
    let bodyOf(statements: Array(Stmt)): Body =
        tuple let id = nextId() let var statements = vector.fromArray(:Stmt statements) end

    let newStaticDescriptor(t: Type echo: Bool): StaticDescriptor = tuple let id = nextId() let type = t let echo = echo end

    let newPlan(kind: String source: Type target: Type): Plan =
        tuple
            let id = nextId()
            let kind = kind
            let source = source
            let target = target
            let var fields = array of :maybe.T(Plan) end
            let var layout = maybe.none(:PlanLayout)
            let var access = array of :String end
            let var thunkSymbols = array of :Array(Int) end
            let var descriptors = array of :Descriptor end
            let var thunkParams = array of :DescriptorParam end
            let var tagMap = maybe.none(:TagMap)
        end

    let newFunction(v: Variable typeParams: Array(TypeParam) params: Array(ParamEntry) resultType: Type body: Body
            traceName: maybe.T(String)): Function =
        tuple
            let id = nextId()
            let var v = v
            let var typeParams = typeParams
            let var params = params
            let var resultType = resultType
            let var body = body
            let var env = maybe.none(:Variable)
            let var traceName = traceName
            let var descriptorParams = array of :DescriptorParam end
            let var viewMaps = array of :ViewMapParam end
        end

    let newMembers(): Members =
        tuple let names = vector.new(:String) let vars = hashMap.new(:String :Variable stringOp.equal hash.string) end

    let addMember(m: Members name: String v: Variable): Ok =
        begin
            if not(hashMap.contains(:String :Variable m.vars name)) then vector.append(:String m.names name) end
            hashMap.insert(:String :Variable m.vars name v)
            ok
        end

    let member(m: Members name: String): maybe.T(Variable) = hashMap.get(:String :Variable m.vars name)

    let newModule(name: String interfaceName: String init: Body members: Members): Module =
        tuple
            let id = nextId()
            let name = name
            let interfaceName = interfaceName
            let var init = init
            let var members = members
            let var exports = maybe.none(:Members)
            let var recordVar = maybe.none(:Variable)
            let var abstractTypes = array of :AbstractTypeEntry end
        end

    let newImport(name: String modulePath: String canonicalPath: String interfacePath: String
            recordType: maybe.T(Type)): Import =
        tuple
            let id = nextId()
            let name = name
            let modulePath = modulePath
            let canonicalPath = canonicalPath
            let interfacePath = interfacePath
            let recordType = recordType
        end

    let newUnit(main: Body modules: vector.T(Module) imports: Array(Import) sourceMap: maybe.T(location.SourceMap)): Unit =
        tuple
            let var main = main
            let var modules = modules
            let var imports = imports
            let var functions = vector.new(:Function)
            let var stage = "core"
            let var sourceMap = sourceMap
            let var staticData = maybe.none(:StaticData)
        end

    let atomOfVar(v: Variable): Atom = option atomVar of Atom with let v = v end
    let atomOfConst(c: Const): Atom = option atomConst of Atom with let c = c end
    let opOfAtom(a: Atom): Op = option opAtom of Op with let n = tuple let var atom = a end end
    let opOfVar(v: Variable): Op = opOfAtom(atomOfVar(v))
    let letStmt(v: Variable value: Op): Stmt = option sLet of Stmt with let n = tuple let var v = v let var value = value end end

    let prim(op: String args: Array(Atom) offset: maybe.T(Int)): Op =
        option opPrim of Op with let n = tuple
            let op = op
            let var args = args
            let offset = offset
            let var access = direct
            let var descriptor = maybe.none(:Descriptor)
        end end

    let call(callee: maybe.T(Variable) typeArgs: Array(Type) args: Array(Atom) moduleRef: maybe.T(ModuleRef)
            member: maybe.T(String) calleeType: maybe.T(Type)): Op =
        option opCall of Op with let n = tuple
            let var callee = callee
            let var typeArgs = typeArgs
            let var args = args
            let var moduleRef = moduleRef
            let var member = member
            let var calleeType = calleeType
            let var descriptors = array of :Descriptor end
        end end

    let typeApp(callee: maybe.T(Variable) typeArgs: Array(Type) moduleRef: maybe.T(ModuleRef) member: maybe.T(String)
            calleeType: maybe.T(Type)): Op =
        option opTypeApp of Op with let n = tuple
            let var callee = callee
            let var typeArgs = typeArgs
            let var moduleRef = moduleRef
            let var member = member
            let var calleeType = calleeType
            let var plans = array of :maybe.T(Plan) end
            let var thunkSymbols = array of :Array(Int) end
            let var descriptors = array of :Descriptor end
            let var thunkParams = maybe.none(:Array(DescriptorParam))
        end end

    let makeTuple(args: Array(Atom) typeComponents: Array(TypeComponent)): Op =
        option opMakeTuple of Op with let n = tuple
            let var args = args
            let typeComponents = typeComponents
            let var embedded = array of :Int end
        end end

    let tupleField(tup: Atom index: Int): Op =
        option opTupleField of Op with let n = tuple
            let var tup = tup
            let var index = index
            let var access = direct
            let var viewMap = maybe.none(:Variable)
        end end

    let makeRecord(fields: Array(FieldAtom)): Op =
        option opMakeRecord of Op with let n = tuple
            let var fields = fields
            let var embedded = array of :Int end
            let var runtimeOffsets = false
            let var descriptor = maybe.none(:Descriptor)
            let var offsets = maybe.none(:OffsetTable)
            let var viewDescriptor = maybe.none(:Descriptor)
        end end

    let recordField(recordAtom: Atom name: String): Op =
        option opRecordField of Op with let n = tuple
            let var recordAtom = recordAtom
            let name = name
            let var stored = false
            let var descriptor = maybe.none(:Descriptor)
            let var viewMap = maybe.none(:Variable)
        end end

    let makeOption(tag: maybe.T(String) payload: maybe.T(Atom) ordinalAtom: maybe.T(Atom) offset: maybe.T(Int)
            cases: Array(String)): Op =
        option opMakeOption of Op with let n = tuple
            let tag = tag
            let var payload = payload
            let var ordinalAtom = ordinalAtom
            let offset = offset
            let cases = cases
            let var access = array of :String end
        end end

    let isTag(value: Atom tag: String): Op =
        option opIsTag of Op with let n = tuple
            let var value = value
            let tag = tag
            let var access = direct
            let var viewMap = maybe.none(:Variable)
        end end

    let payload(value: Atom tag: String offset: maybe.T(Int) ordinalIndex: maybe.T(Int)): Op =
        option opPayload of Op with let n = tuple
            let var value = value
            let tag = tag
            let offset = offset
            let var access = direct
            let var components = array of :String end
            let ordinalIndex = ordinalIndex
            let var viewMap = maybe.none(:Variable)
        end end

    let ordinalOf(value: Atom cases: Array(String)): Op =
        option opOrdinal of Op with let n = tuple
            let var value = value
            let cases = cases
            let var access = direct
            let var viewMap = maybe.none(:Variable)
        end end

    let switchStmt(value: Atom cases: Array(Case) elseBody: maybe.T(Body)): Stmt =
        option sSwitch of Stmt with let n = tuple
            let var value = value
            let var cases = cases
            let var elseBody = elseBody
            let var access = direct
            let var viewMap = maybe.none(:Variable)
        end end

    let inspectStmt(value: Atom cases: Array(InspectCase) elseBody: maybe.T(Body) autoType: maybe.T(Type)
            offset: maybe.T(Int)): Stmt =
        option sInspect of Stmt with let n = tuple
            let var value = value
            let var cases = cases
            let var elseBody = elseBody
            let autoType = autoType
            let offset = offset
            let var witness = maybe.none(:DescriptorParam)
        end end

    let newCase(tags: Array(String) body: Body binder: maybe.T(Variable)): Case =
        tuple let tags = tags let var body = body let var binder = binder let var components = array of :String end end

    let newInspectCase(matchType: Type binders: Array(Variable) body: Body exact: Bool): InspectCase =
        tuple
            let matchType = matchType
            let var binders = binders
            let var body = body
            let exact = exact
            let var arm = maybe.none(:InspectArm)
            let var descriptor = maybe.none(:Descriptor)
        end

    (* =========================================================================
     * Queries
     * ========================================================================= *)

    let same(a: Variable b: Variable): Bool = a.id is b.id

    let isTerminator(s: Stmt): Bool =
        case s
            when sReturn then true
            when sJump then true
            when sBreak then true
            when sContinue then true
            when sRaise then true
            when sReraise then true
            when sUnreachable then true
            else false
        end

    let terminated(b: Body): Bool =
        not(vector.empty(:Stmt b.statements)) andif isTerminator(vector.last(:Stmt b.statements))

    let atomVarOf(a: Atom): maybe.T(Variable) =
        case a
            when atomVar with x then maybe.some(:Variable x.v)
            else maybe.none(:Variable)
        end

    let atomType(a: Atom): Type =
        case a
            when atomVar with x then x.v.type
            when atomConst with x then x.c.shape.type
        end

    let moduleRefName(r: ModuleRef): String =
        case r
            when refModule with x then x.m.name
            when refImport with x then x.i.name
        end

    let sameModuleRef(a: ModuleRef b: ModuleRef): Bool =
        case a
            when refModule with x then case b when refModule with y then x.m.id is y.m.id else false end
            when refImport with x then case b when refImport with y then x.i.id is y.i.id else false end
        end

    let atLeast(unit: Unit stage: String): Bool =
        begin
            let var at = ~1
            let var wanted = ~1
            for i = 0 upto {extent stages - 1} do
                if stringOp.equal(stages[i] unit.stage) then at := i end
                if stringOp.equal(stages[i] stage) then wanted := i end
            end
            at >= wanted
        end
end
