(* Quest Self-Hosted Compiler: The Inliner Implementation *)

module inline : Inline
import
    questlang/types/model : questlang/types/Model
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/walk : questlang/ir/Walk
    questlang/ir/clone : questlang/ir/Clone
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    stringOp = string : StringOp
    conv : Conv
export
    Let Variable = nodes.Variable
    Let Atom = nodes.Atom
    Let Body = nodes.Body
    Let Stmt = nodes.Stmt

    let intEqual(a: Int b: Int): Bool = a is b
    let okAtom(): Atom =
        nodes.atomOfConst(tuple
            let value = option constOk of nodes.ConstValue end
            let shape = shapes.shape(model.okType)
        end)

    Def Analysis = Tuple
        functions: hashMap.T(Int nodes.Function)
        components: hashMap.T(Int Int)
        recursive: hashMap.T(Int Bool)
        callsExternalAtTypes: hashMap.T(Int Bool)
        static: hashMap.T(Int Array(Bool))
        sizes: hashMap.T(Int Int)
        size: Int
    end

    let isCall(s: Stmt): Bool = maybe.isSome(walk.statementCall(s))

    let callSize = 2

    let size(b: Body): Int =
        begin
            let stmts = walk.walkStatements(b true)
            let var n = 0
            for i = 0 upto {vector.length(stmts) - 1} do
                n := n + if isCall(vector.get(stmts i)) then callSize else 1 end
            end
            n
        end

    (* ======================================================================
     * Analysis
     * ====================================================================== *)

    (* The functions the unit's funs statements bind, in the order met *)
    let collect(all: Array(Body)): vector.T(nodes.Function) =
        begin
            let found = vector.new(:nodes.Function)
            for b = 0 upto {extent all - 1} do
                let stmts = walk.walkStatements(all[b] true)
                for i = 0 upto {vector.length(stmts) - 1} do
                    case vector.get(stmts i)
                        when sFuns with x then
                            for j = 0 upto {extent x.functions - 1} do
                                vector.append(found x.functions[j])
                            end
                        else ok
                    end
                end
            end
            found
        end

    (* The functions a function's body names (not those its own functions'
     * bodies do), by their variables' ids *)
    let named(f: nodes.Function functions: hashMap.T(Int nodes.Function)): Array(Int) =
        begin
            let found = vector.new(:Int)
            let stmts = walk.walkStatements(f.body false)
            for i = 0 upto {vector.length(stmts) - 1} do
                let used = walk.statementUses(vector.get(stmts i))
                for j = 0 upto {extent used - 1} do
                    case used[j]
                        when atomVar with x then
                            if hashMap.contains(functions x.v.id) then
                                vector.append(found x.v.id)
                            end
                        when atomConst then ok
                    end
                end
            end
            vector.toArray(found)
        end

    (* Tarjan's strongly connected components of the graph of which functions
     * name which, numbered in the order they are completed *)
    let components(order: vector.T(nodes.Function) functions: hashMap.T(Int nodes.Function)): hashMap.T(Int Int) =
        begin
            let result = hashMap.new(:Int :Int intEqual hash.int)
            let index = hashMap.new(:Int :Int intEqual hash.int)
            let low = hashMap.new(:Int :Int intEqual hash.int)
            let onStack = hashMap.new(:Int :Bool intEqual hash.int)
            let stack = vector.new(:Int)
            let numbers = tuple let var next = 0 let var count = 0 end
            let rec visit(id: Int): Ok =
                begin
                    hashMap.insert(index id numbers.next)
                    hashMap.insert(low id numbers.next)
                    numbers.next := numbers.next + 1
                    vector.append(stack id)
                    hashMap.insert(onStack id true)
                    let targets = named(hashMap.find(functions id) functions)
                    for k = 0 upto {extent targets - 1} do
                        let t = targets[k]
                        if not(hashMap.contains(index t)) then
                            visit(t)
                            if hashMap.find(low t) < hashMap.find(low id) then
                                hashMap.insert(low id hashMap.find(low t))
                            end
                        elsif hashMap.contains(onStack t) then
                            if hashMap.find(index t) < hashMap.find(low id) then
                                hashMap.insert(low id hashMap.find(index t))
                            end
                        end
                    end
                    if hashMap.find(low id) is hashMap.find(index id) then
                        let var more = true
                        while more do
                            let member = vector.pop(stack)
                            hashMap.delete(onStack member)
                            hashMap.insert(result member numbers.count)
                            more := member isnot id
                        end
                        numbers.count := numbers.count + 1
                    end
                end
            for i = 0 upto {vector.length(order) - 1} do
                let id = vector.get(order i).v.id
                if not(hashMap.contains(index id)) then visit(id) end
            end
            result
        end

    (* The variables a function names and does not bind (its parameters, and
     * the binders of its body and its functions, are bound), in the order
     * first named *)
    let freeVariables(f: nodes.Function): Array(Variable) =
        begin
            let bound = hashMap.new(:Int :Bool intEqual hash.int)
            for i = 0 upto {extent f.params - 1} do hashMap.insert(bound f.params[i].v.id true) end
            hashMap.insert(bound f.v.id true)
            let stmts = walk.walkStatements(f.body true)
            for i = 0 upto {vector.length(stmts) - 1} do
                let st = vector.get(stmts i)
                let binders = walk.statementBinders(st)
                for k = 0 upto {extent binders - 1} do hashMap.insert(bound binders[k].id true) end
                case st
                    when sFuns with x then
                        for k = 0 upto {extent x.functions - 1} do
                            let g = x.functions[k]
                            for j = 0 upto {extent g.params - 1} do
                                hashMap.insert(bound g.params[j].v.id true)
                            end
                        end
                    else ok
                end
            end
            let found = vector.new(:Variable)
            let seen = hashMap.new(:Int :Bool intEqual hash.int)
            for i = 0 upto {vector.length(stmts) - 1} do
                let used = walk.statementUses(vector.get(stmts i))
                for k = 0 upto {extent used - 1} do
                    case used[k]
                        when atomVar with x then
                            if not(hashMap.contains(bound x.v.id))
                                andif not(hashMap.contains(seen x.v.id)) then
                                hashMap.insert(seen x.v.id true)
                                vector.append(found x.v)
                            end
                        when atomConst then ok
                    end
                end
            end
            vector.toArray(found)
        end

    (* Whether a function's body, or a function it binds, calls an external
     * function at type arguments *)
    let callsExternalAtTypes(f: nodes.Function): Bool =
        begin
            let stmts = walk.walkStatements(f.body true)
            let var found = false
            for i = 0 upto {vector.length(stmts) - 1} do
                let o = case vector.get(stmts i)
                    when sLet with x then maybe.some(x.value)
                    when sDo with x then maybe.some(x.value)
                    else maybe.none(:nodes.Op)
                end
                if maybe.isSome(o) then
                    case maybe.unwrap(o)
                        when opCallExternal with x then if extent x.typeArgs > 0 then found := true end
                        else ok
                    end
                end
            end
            found
        end

    (* The call a statement makes of the function v names, if it makes one *)
    let callOfVariable(st: Stmt v: Variable): maybe.T(nodes.OpCall) =
        begin
            let c = walk.statementCall(st)
            if maybe.isSome(c) andif maybe.isSome(maybe.unwrap(c).callee)
                andif nodes.same(maybe.unwrap(maybe.unwrap(c).callee) v)
            then c
            else maybe.none() end
        end

    (* Whether a type argument is the type parameter itself *)
    let isParameter(t: model.Type p: nodes.TypeParam): Bool =
        case t.form
            when typeVariable with x then x.symbolId is p.symbolId
            else false
        end

    (* Computes a boolean mask of f's static parameters: value parameters that
     * every recursive call (in f's body or nested functions) passes unchanged
     * at f's own type parameters. Returns an empty array if f makes no
     * recursive calls or is referenced anywhere except as such a call's
     * callee. *)
    let staticParams(f: nodes.Function): Array(Bool) =
        begin
            let static = array of(extent f.params false)
            for i = 0 upto {extent f.params - 1} do static[i] := stringOp.equal(f.params[i].mode "value") end
            let var other = false
            let var any = false
            let stmts = walk.walkStatements(f.body true)
            for i = 0 upto {vector.length(stmts) - 1} do
                let st = vector.get(stmts i)
                let call = callOfVariable(st f.v)
                if maybe.isSome(call) then
                    let c = maybe.unwrap(call)
                    if {extent c.args isnot extent f.params} orif {extent c.typeArgs isnot extent f.typeParams} then
                        other := true
                    else
                        for k = 0 upto {extent f.typeParams - 1} do
                            if not(isParameter(c.typeArgs[k] f.typeParams[k])) then other := true end
                        end
                        for k = 0 upto {extent c.args - 1} do
                            let same = case c.args[k]
                                when atomVar with x then nodes.same(x.v f.params[k].v)
                                when atomConst then false
                            end
                            if not(same) then static[k] := false end
                        end
                        (* The callee is the call's use of f; any other is a
                         * use as a value *)
                        let used = walk.statementUses(st)
                        let var named = 0
                        for k = 0 upto {extent used - 1} do
                            case used[k]
                                when atomVar with x then if nodes.same(x.v f.v) then named := named + 1 end
                                when atomConst then ok
                            end
                        end
                        if named > 1 then other := true end
                        any := true
                    end
                else
                    let used = walk.statementUses(st)
                    for k = 0 upto {extent used - 1} do
                        case used[k]
                            when atomVar with x then if nodes.same(x.v f.v) then other := true end
                            when atomConst then ok
                        end
                    end
                end
            end
            if other orif not(any) then array of :Bool end else static end
        end

    let analyze(all: Array(Body)): Analysis =
        begin
            let order = collect(all)
            let functions = hashMap.new(:Int :nodes.Function intEqual hash.int)
            let sizes = hashMap.new(:Int :Int intEqual hash.int)
            for i = 0 upto {vector.length(order) - 1} do
                let f = vector.get(order i)
                hashMap.insert(functions f.v.id f)
                hashMap.insert(sizes f.v.id size(f.body))
            end
            let var total = 0
            for b = 0 upto {extent all - 1} do total := total + size(all[b]) end
            let numbers = components(order functions)
            (* A function is recursive if it names itself, or another of its
             * component *)
            let members = hashMap.new(:Int :Int intEqual hash.int)
            for i = 0 upto {vector.length(order) - 1} do
                let c = hashMap.find(numbers vector.get(order i).v.id)
                hashMap.insert(members c 1 + maybe.unwrapOr(hashMap.get(members c) 0))
            end
            let recursive = hashMap.new(:Int :Bool intEqual hash.int)
            for i = 0 upto {vector.length(order) - 1} do
                let f = vector.get(order i)
                let targets = named(f functions)
                let var self = hashMap.find(members hashMap.find(numbers f.v.id)) > 1
                for k = 0 upto {extent targets - 1} do if targets[k] is f.v.id then self := true end end
                hashMap.insert(recursive f.v.id self)
            end
            (* A function recursive through itself alone may have static
             * parameters *)
            let static = hashMap.new(:Int :Array(Bool) intEqual hash.int)
            for i = 0 upto {vector.length(order) - 1} do
                let f = vector.get(order i)
                let alone = hashMap.find(members hashMap.find(numbers f.v.id)) is 1
                if alone andif hashMap.find(recursive f.v.id) then
                    let params = staticParams(f)
                    let var some = false
                    for k = 0 upto {extent params - 1} do if params[k] then some := true end end
                    if some then hashMap.insert(static f.v.id params) end
                end
            end
            let externals = hashMap.new(:Int :Bool intEqual hash.int)
            for i = 0 upto {vector.length(order) - 1} do
                let f = vector.get(order i)
                hashMap.insert(externals f.v.id callsExternalAtTypes(f))
            end
            tuple
                let functions = functions
                let components = numbers
                let recursive = recursive
                let callsExternalAtTypes = externals
                let static = static
                let sizes = sizes
                let size = total
            end
        end

    (* ======================================================================
     * Expansion
     * ====================================================================== *)

    (* Replaces each return in b (excluding nested functions), in place, with
     * the statement produced by calling replaced on its value and position *)
    let rec returns(b: Body replaced: All(a: Atom pos: Int) Stmt): Ok =
        for i = 0 upto {vector.length(b.statements) - 1} do
            let s = vector.get(b.statements i)
            case s
                when sReturn with x then vector.set(b.statements i replaced(x.value x.pos))
                else
                    let inner = walk.statementBodies(s)
                    for k = 0 upto {extent inner - 1} do returns(inner[k] replaced) end
            end
        end

    (* How many returns a function's body has (not counting those of the
     * functions it binds) *)
    let rec countReturns(b: Body): Int =
        begin
            let var n = 0
            for i = 0 upto {vector.length(b.statements) - 1} do
                let s = vector.get(b.statements i)
                case s
                    when sReturn then n := n + 1
                    else
                        let inner = walk.statementBodies(s)
                        for k = 0 upto {extent inner - 1} do n := n + countReturns(inner[k]) end
                end
            end
            n
        end

    Def Read = Tuple v: Variable op: nodes.Op end

    (* A cloner of f's body at typeArgs, its labels counted by labels *)
    let clonerAt(f: nodes.Function typeArgs: Array(model.Type) labels: clone.Labels): clone.Cloner =
        begin
            let subst = model.newSubst()
            for i = 0 upto {extent f.typeParams - 1} do
                if i < extent typeArgs then
                    hashMap.insert(subst f.typeParams[i].symbolId typeArgs[i])
                end
            end
            clone.newRelabelingCloner(subst labels)
        end

    (* Emits a let binding at pos in bound for each entry in reads, mapping its
     * variable in c to the fresh local *)
    let bindReads(c: clone.Cloner reads: Array(Read) pos: Int bound: vector.T(Stmt)): Ok =
        for i = 0 upto {extent reads - 1} do
            let v = reads[i].v
            let local = nodes.newVar(v.hint clone.ty(c v.type) false)
            clone.bindVar(c v local)
            let binding = nodes.letStmt(local reads[i].op)
            nodes.positionAt(binding pos)
            vector.append(bound binding)
        end

    let expand(f: nodes.Function typeArgs: Array(model.Type) args: Array(Atom) byRef: Array(maybe.T(Variable))
        reads: Array(Read) into: maybe.T(Variable) pos: Int rest: Array(Stmt) labels: clone.Labels): Array(Stmt) =
        begin
            let c = clonerAt(f typeArgs labels)
            let result = maybe.unwrapOr(into nodes.newVar("r" clone.ty(c f.resultType) false))
            let bound = vector.new(:Stmt)
            for i = 0 upto {extent f.params - 1} do
                let p = f.params[i].v
                if {i < extent byRef} andif maybe.isSome(byRef[i]) then
                    clone.bindVar(c p maybe.unwrap(byRef[i]))
                else
                    let binding = nodes.letStmt(clone.fresh(c p) nodes.opOfAtom(args[i]))
                    nodes.positionAt(binding pos)
                    vector.append(bound binding)
                end
            end
            bindReads(c reads pos bound)
            clone.bindAll(c f.body)
            let body = clone.copyBody(c f.body)
            let n = vector.length(body.statements)
            let last = if n > 0 then case vector.get(body.statements n - 1) when sReturn then true else false end
                else false end
            if last andif {countReturns(body) is 1} then
                (* Its one return is its end: its value is the call's *)
                let value = case vector.pop(body.statements) when sReturn with x then x.value else okAtom() end
                let all = vector.copy(bound)
                for i = 0 upto {vector.length(body.statements) - 1} do
                    vector.append(all vector.get(body.statements i))
                end
                let resultBinding = nodes.letStmt(result nodes.opOfAtom(value))
                nodes.positionAt(resultBinding pos)
                vector.append(all resultBinding)
                for i = 0 upto {extent rest - 1} do vector.append(all rest[i]) end
                vector.toArray(all)
            else
                labels.count := labels.count + 1
                let label = "inlined" <> conv.int(labels.count)
                returns(body fun(a: Atom pos: Int): Stmt
                    option sJump of Stmt with let var pos = pos let label = label let var args = array of a end end)
                let inner = vector.copy(bound)
                for i = 0 upto {vector.length(body.statements) - 1} do
                    vector.append(inner vector.get(body.statements i))
                end
                array of
                    option sJoin of Stmt with
                        let label = label
                        let var params = array of result end
                        let var continuation = nodes.bodyOf(rest)
                        let var body = nodes.bodyOf(vector.toArray(inner))
                    end
                end
            end
        end

    let specialize(f: nodes.Function static: Array(Bool) typeArgs: Array(model.Type) args: Array(Atom)
        reads: Array(Read) into: maybe.T(Variable) pos: Int rest: Array(Stmt) labels: clone.Labels): Array(Stmt) =
        begin
            let c = clonerAt(f typeArgs labels)
            let result = maybe.unwrapOr(into nodes.newVar("r" clone.ty(c f.resultType) false))
            let bound = vector.new(:Stmt)
            bindReads(c reads pos bound)
            (* Collect the local function's non-static parameters and arguments;
             * each static parameter is mapped directly to its argument
             * variable, or to a fresh local bound to a constant argument *)
            let params = vector.new(:nodes.ParamEntry)
            let types = vector.new(:model.Param)
            let passed = vector.new(:Atom)
            for i = 0 upto {extent f.params - 1} do
                let p = f.params[i].v
                if static[i] then
                    case args[i]
                        when atomVar with x then clone.bindVar(c p x.v)
                        when atomConst then
                            begin
                                let q = clone.fresh(c p)
                                let binding = nodes.letStmt(q nodes.opOfAtom(args[i]))
                                nodes.positionAt(binding pos)
                                vector.append(bound binding)
                            end
                    end
                else
                    let q = clone.fresh(c p)
                    vector.append(params tuple let v = q let mode = "value" end)
                    vector.append(types tuple
                        let name = q.hint let type = q.type let isVar = false let isOut = false
                    end)
                    vector.append(passed args[i])
                end
            end
            let resultType = clone.ty(c f.resultType)
            let inner = nodes.newVar(f.v.hint model.funType(vector.toArray(types) resultType) false)
            clone.bindVar(c f.v inner)
            clone.bindAll(c f.body)
            let body = clone.copyBody(c f.body)
            (* Rewrite recursive calls to target inner without the static
             * arguments *)
            let stmts = walk.walkStatements(body true)
            for i = 0 upto {vector.length(stmts) - 1} do
                let call = callOfVariable(vector.get(stmts i) inner)
                if maybe.isSome(call) then
                    let x = maybe.unwrap(call)
                    let kept = vector.new(:Atom)
                    for k = 0 upto {extent x.args - 1} do
                        if not(static[k]) then vector.append(kept x.args[k]) end
                    end
                    x.args := vector.toArray(kept)
                    x.typeArgs := array of :model.Type end
                    x.calleeType := maybe.none()
                end
            end
            let g = nodes.newFunction(inner array of :nodes.TypeParam end vector.toArray(params)
                resultType body f.traceName)
            let all = vector.copy(bound)
            let funs = option sFuns of Stmt with
                let var functions = array of g end
                let recursive = true
            end
            vector.append(all funs)
            let call = nodes.letStmt(result nodes.call(maybe.some(inner) array of :model.Type end
                vector.toArray(passed) maybe.none() maybe.none() maybe.none()))
            nodes.positionAt(call pos)
            vector.append(all call)
            for i = 0 upto {extent rest - 1} do vector.append(all rest[i]) end
            vector.toArray(all)
        end
end
