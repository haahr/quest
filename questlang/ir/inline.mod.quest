(* Quest Self-Hosted Compiler: The Inliner Implementation *)

module inline : Inline
import
    questlang/types/model : questlang/types/Model
    questlang/ir/shapes : questlang/ir/Shapes
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/walk : questlang/ir/Walk
    questlang/ir/clone : questlang/ir/Clone
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    stringOp = string : StringOp
    conv : Conv
export
    Let Variable = nodes.Variable
    Let Atom = nodes.Atom
    Let Body = nodes.Body
    Let Stmt = nodes.Stmt

    let intEqual(a: Int b: Int): Bool = a is b
    let okAtom(): Atom =
        nodes.atomOfConst(tuple
            let value = option constOk of nodes.ConstValue end
            let shape = shapes.shape(model.okType)
        end)

    Def Analysis = Tuple
        functions: hashMap.T(Int nodes.Function)
        components: hashMap.T(Int Int)
        recursive: hashMap.T(Int Bool)
        closed: hashMap.T(Int Bool)
        free: hashMap.T(Int Array(Variable))
        callsExternalAtTypes: hashMap.T(Int Bool)
        static: hashMap.T(Int Array(Bool))
        sizes: hashMap.T(Int Int)
        size: Int
    end

    let isCall(s: Stmt): Bool =
        case s
            when sLet with x then case x.value when opCall then true else false end
            when sDo with x then case x.value when opCall then true else false end
            else false
        end

    let size(b: Body): Int =
        begin
            let stmts = walk.walkStatements(b true)
            let var n = 0
            for i = 0 upto {vector.length(:Stmt stmts) - 1} do
                n := n + if isCall(vector.get(:Stmt stmts i)) then 2 else 1 end
            end
            n
        end

    (* ======================================================================
     * Analysis
     * ====================================================================== *)

    (* The functions the unit's funs statements bind, in the order met *)
    let collect(all: Array(Body)): vector.T(nodes.Function) =
        begin
            let found = vector.new(:nodes.Function)
            for b = 0 upto {extent all - 1} do
                let stmts = walk.walkStatements(all[b] true)
                for i = 0 upto {vector.length(:Stmt stmts) - 1} do
                    case vector.get(:Stmt stmts i)
                        when sFuns with x then
                            for j = 0 upto {extent x.functions - 1} do
                                vector.append(:nodes.Function found x.functions[j])
                            end
                        else ok
                    end
                end
            end
            found
        end

    (* The functions a function's body names (not those its own functions'
     * bodies do), by their variables' ids *)
    let named(f: nodes.Function functions: hashMap.T(Int nodes.Function)): Array(Int) =
        begin
            let found = vector.new(:Int)
            let stmts = walk.walkStatements(f.body false)
            for i = 0 upto {vector.length(:Stmt stmts) - 1} do
                let used = walk.statementUses(vector.get(:Stmt stmts i))
                for j = 0 upto {extent used - 1} do
                    case used[j]
                        when atomVar with x then
                            if hashMap.contains(:Int :nodes.Function functions x.v.id) then
                                vector.append(:Int found x.v.id)
                            end
                        when atomConst then ok
                    end
                end
            end
            vector.toArray(:Int found)
        end

    (* Tarjan's strongly connected components of the graph of which functions
     * name which, numbered in the order they are completed *)
    let components(order: vector.T(nodes.Function) functions: hashMap.T(Int nodes.Function)): hashMap.T(Int Int) =
        begin
            let result = hashMap.new(:Int :Int intEqual hash.int)
            let index = hashMap.new(:Int :Int intEqual hash.int)
            let low = hashMap.new(:Int :Int intEqual hash.int)
            let onStack = hashMap.new(:Int :Bool intEqual hash.int)
            let stack = vector.new(:Int)
            let numbers = tuple let var next = 0 let var count = 0 end
            let rec visit(id: Int): Ok =
                begin
                    hashMap.insert(:Int :Int index id numbers.next)
                    hashMap.insert(:Int :Int low id numbers.next)
                    numbers.next := numbers.next + 1
                    vector.append(:Int stack id)
                    hashMap.insert(:Int :Bool onStack id true)
                    let targets = named(hashMap.find(:Int :nodes.Function functions id) functions)
                    for k = 0 upto {extent targets - 1} do
                        let t = targets[k]
                        if not(hashMap.contains(:Int :Int index t)) then
                            visit(t)
                            if hashMap.find(:Int :Int low t) < hashMap.find(:Int :Int low id) then
                                hashMap.insert(:Int :Int low id hashMap.find(:Int :Int low t))
                            end
                        elsif hashMap.contains(:Int :Bool onStack t) then
                            if hashMap.find(:Int :Int index t) < hashMap.find(:Int :Int low id) then
                                hashMap.insert(:Int :Int low id hashMap.find(:Int :Int index t))
                            end
                        end
                    end
                    if hashMap.find(:Int :Int low id) is hashMap.find(:Int :Int index id) then
                        let var more = true
                        while more do
                            let member = vector.pop(:Int stack)
                            hashMap.delete(:Int :Bool onStack member)
                            hashMap.insert(:Int :Int result member numbers.count)
                            more := member isnot id
                        end
                        numbers.count := numbers.count + 1
                    end
                end
            for i = 0 upto {vector.length(:nodes.Function order) - 1} do
                let id = vector.get(:nodes.Function order i).v.id
                if not(hashMap.contains(:Int :Int index id)) then visit(id) end
            end
            result
        end

    (* The variables a function names and does not bind (its parameters, and
     * the binders of its body and its functions, are bound), in the order
     * first named *)
    let freeVariables(f: nodes.Function): Array(Variable) =
        begin
            let bound = hashMap.new(:Int :Bool intEqual hash.int)
            for i = 0 upto {extent f.params - 1} do hashMap.insert(:Int :Bool bound f.params[i].v.id true) end
            hashMap.insert(:Int :Bool bound f.v.id true)
            let stmts = walk.walkStatements(f.body true)
            for i = 0 upto {vector.length(:Stmt stmts) - 1} do
                let st = vector.get(:Stmt stmts i)
                let binders = walk.statementBinders(st)
                for k = 0 upto {extent binders - 1} do hashMap.insert(:Int :Bool bound binders[k].id true) end
                case st
                    when sFuns with x then
                        for k = 0 upto {extent x.functions - 1} do
                            let g = x.functions[k]
                            for j = 0 upto {extent g.params - 1} do
                                hashMap.insert(:Int :Bool bound g.params[j].v.id true)
                            end
                        end
                    else ok
                end
            end
            let found = vector.new(:Variable)
            let seen = hashMap.new(:Int :Bool intEqual hash.int)
            for i = 0 upto {vector.length(:Stmt stmts) - 1} do
                let used = walk.statementUses(vector.get(:Stmt stmts i))
                for k = 0 upto {extent used - 1} do
                    case used[k]
                        when atomVar with x then
                            if not(hashMap.contains(:Int :Bool bound x.v.id))
                                andif not(hashMap.contains(:Int :Bool seen x.v.id)) then
                                hashMap.insert(:Int :Bool seen x.v.id true)
                                vector.append(:Variable found x.v)
                            end
                        when atomConst then ok
                    end
                end
            end
            vector.toArray(:Variable found)
        end

    (* Whether a function's body, or a function it binds, calls an external
     * function at type arguments *)
    let callsExternalAtTypes(f: nodes.Function): Bool =
        begin
            let stmts = walk.walkStatements(f.body true)
            let var found = false
            for i = 0 upto {vector.length(:Stmt stmts) - 1} do
                let o = case vector.get(:Stmt stmts i)
                    when sLet with x then maybe.some(:nodes.Op x.value)
                    when sDo with x then maybe.some(:nodes.Op x.value)
                    else maybe.none(:nodes.Op)
                end
                if maybe.isSome(:nodes.Op o) then
                    case maybe.unwrap(:nodes.Op o)
                        when opCallExternal with x then if extent x.typeArgs > 0 then found := true end
                        else ok
                    end
                end
            end
            found
        end

    (* The calls a statement makes of a function, by its variable *)
    let callOfVariable(st: Stmt v: Variable): maybe.T(nodes.OpCall) =
        begin
            let o = case st
                when sLet with x then maybe.some(:nodes.Op x.value)
                when sDo with x then maybe.some(:nodes.Op x.value)
                else maybe.none(:nodes.Op)
            end
            if maybe.isSome(:nodes.Op o) then
                case maybe.unwrap(:nodes.Op o)
                    when opCall with c then
                        if maybe.isSome(:Variable c.callee) andif nodes.same(maybe.unwrap(:Variable c.callee) v) then
                            maybe.some(:nodes.OpCall c)
                        else maybe.none(:nodes.OpCall) end
                    else maybe.none(:nodes.OpCall)
                end
            else maybe.none(:nodes.OpCall) end
        end

    (* Whether a type argument is the type parameter itself *)
    let isParameter(t: model.Type p: nodes.TypeParam): Bool =
        case t.form
            when typeVariable with x then x.symbolId is p.symbolId
            else false
        end

    (* A function's static parameters: each value parameter that every call it
     * makes of itself (in its body, or in the functions its body binds) passes
     * unchanged, at its own type parameters. A use of the function other than
     * as such a call's callee leaves it none. *)
    let staticParams(f: nodes.Function): Array(Bool) =
        begin
            let static = array of(extent f.params false)
            for i = 0 upto {extent f.params - 1} do static[i] := stringOp.equal(f.params[i].mode "value") end
            let var other = false
            let var any = false
            let stmts = walk.walkStatements(f.body true)
            for i = 0 upto {vector.length(:Stmt stmts) - 1} do
                let st = vector.get(:Stmt stmts i)
                let call = callOfVariable(st f.v)
                if maybe.isSome(:nodes.OpCall call) then
                    let c = maybe.unwrap(:nodes.OpCall call)
                    if {extent c.args isnot extent f.params} orif {extent c.typeArgs isnot extent f.typeParams} then
                        other := true
                    else
                        for k = 0 upto {extent f.typeParams - 1} do
                            if not(isParameter(c.typeArgs[k] f.typeParams[k])) then other := true end
                        end
                        for k = 0 upto {extent c.args - 1} do
                            let same = case c.args[k]
                                when atomVar with x then nodes.same(x.v f.params[k].v)
                                when atomConst then false
                            end
                            if not(same) then static[k] := false end
                        end
                        (* The callee is the call's use of f; any other is a
                         * use as a value *)
                        let used = walk.statementUses(st)
                        let var named = 0
                        for k = 0 upto {extent used - 1} do
                            case used[k]
                                when atomVar with x then if nodes.same(x.v f.v) then named := named + 1 end
                                when atomConst then ok
                            end
                        end
                        if named > 1 then other := true end
                        any := true
                    end
                else
                    let used = walk.statementUses(st)
                    for k = 0 upto {extent used - 1} do
                        case used[k]
                            when atomVar with x then if nodes.same(x.v f.v) then other := true end
                            when atomConst then ok
                        end
                    end
                end
            end
            if other orif not(any) then array of :Bool end else static end
        end

    let analyze(all: Array(Body)): Analysis =
        begin
            let order = collect(all)
            let functions = hashMap.new(:Int :nodes.Function intEqual hash.int)
            let sizes = hashMap.new(:Int :Int intEqual hash.int)
            for i = 0 upto {vector.length(:nodes.Function order) - 1} do
                let f = vector.get(:nodes.Function order i)
                hashMap.insert(:Int :nodes.Function functions f.v.id f)
                hashMap.insert(:Int :Int sizes f.v.id size(f.body))
            end
            let var total = 0
            for b = 0 upto {extent all - 1} do total := total + size(all[b]) end
            let numbers = components(order functions)
            (* A function is recursive if it names itself, or another of its
             * component *)
            let members = hashMap.new(:Int :Int intEqual hash.int)
            for i = 0 upto {vector.length(:nodes.Function order) - 1} do
                let c = hashMap.find(:Int :Int numbers vector.get(:nodes.Function order i).v.id)
                hashMap.insert(:Int :Int members c 1 + maybe.unwrapOr(:Int hashMap.get(:Int :Int members c) 0))
            end
            let recursive = hashMap.new(:Int :Bool intEqual hash.int)
            for i = 0 upto {vector.length(:nodes.Function order) - 1} do
                let f = vector.get(:nodes.Function order i)
                let targets = named(f functions)
                let var self = hashMap.find(:Int :Int members hashMap.find(:Int :Int numbers f.v.id)) > 1
                for k = 0 upto {extent targets - 1} do if targets[k] is f.v.id then self := true end end
                hashMap.insert(:Int :Bool recursive f.v.id self)
            end
            let closed = hashMap.new(:Int :Bool intEqual hash.int)
            let free = hashMap.new(:Int :Array(Variable) intEqual hash.int)
            for i = 0 upto {vector.length(:nodes.Function order) - 1} do
                let f = vector.get(:nodes.Function order i)
                let named = freeVariables(f)
                hashMap.insert(:Int :Array(Variable) free f.v.id named)
                hashMap.insert(:Int :Bool closed f.v.id extent named is 0)
            end
            (* A function recursive through itself alone may have static
             * parameters *)
            let static = hashMap.new(:Int :Array(Bool) intEqual hash.int)
            for i = 0 upto {vector.length(:nodes.Function order) - 1} do
                let f = vector.get(:nodes.Function order i)
                let alone = hashMap.find(:Int :Int members hashMap.find(:Int :Int numbers f.v.id)) is 1
                if alone andif hashMap.find(:Int :Bool recursive f.v.id) then
                    let params = staticParams(f)
                    let var some = false
                    for k = 0 upto {extent params - 1} do if params[k] then some := true end end
                    if some then hashMap.insert(:Int :Array(Bool) static f.v.id params) end
                end
            end
            let externals = hashMap.new(:Int :Bool intEqual hash.int)
            for i = 0 upto {vector.length(:nodes.Function order) - 1} do
                let f = vector.get(:nodes.Function order i)
                hashMap.insert(:Int :Bool externals f.v.id callsExternalAtTypes(f))
            end
            tuple
                let functions = functions
                let components = numbers
                let recursive = recursive
                let closed = closed
                let free = free
                let callsExternalAtTypes = externals
                let static = static
                let sizes = sizes
                let size = total
            end
        end

    (* ======================================================================
     * Expansion
     * ====================================================================== *)

    (* The returns of a function's body (not those of the functions it binds),
     * each replaced, in place, by what replaced makes of its value *)
    let rec returns(b: Body replaced: All(a: Atom pos: Int) Stmt): Ok =
        for i = 0 upto {vector.length(:Stmt b.statements) - 1} do
            let s = vector.get(:Stmt b.statements i)
            case s
                when sReturn with x then vector.set(:Stmt b.statements i replaced(x.value x.pos))
                else
                    let inner = walk.statementBodies(s)
                    for k = 0 upto {extent inner - 1} do returns(inner[k] replaced) end
            end
        end

    let countReturns(b: Body): Int =
        begin
            let counted = tuple let var n = 0 end
            returns(b fun(a: Atom pos: Int): Stmt
                begin
                    counted.n := counted.n + 1
                    option sReturn of Stmt with let var pos = pos let var value = a end
                end)
            counted.n
        end

    Def Read = Tuple v: Variable op: nodes.Op end

    let expand(f: nodes.Function typeArgs: Array(model.Type) args: Array(Atom) byRef: Array(maybe.T(Variable))
        reads: Array(Read) into: maybe.T(Variable) pos: Int rest: Array(Stmt) labels: clone.Labels): Array(Stmt) =
        begin
            let subst = model.newSubst()
            for i = 0 upto {extent f.typeParams - 1} do
                if i < extent typeArgs then
                    hashMap.insert(:Int :model.Type subst f.typeParams[i].symbolId typeArgs[i])
                end
            end
            let c = clone.newRelabelingCloner(subst labels)
            let result = maybe.unwrapOr(:Variable into nodes.newVar("r" clone.ty(c f.resultType) false))
            let bound = vector.new(:Stmt)
            for i = 0 upto {extent f.params - 1} do
                let p = f.params[i].v
                if {i < extent byRef} andif maybe.isSome(:Variable byRef[i]) then
                    clone.bindVar(c p maybe.unwrap(:Variable byRef[i]))
                else
                    let binding = nodes.letStmt(clone.fresh(c p) nodes.opOfAtom(args[i]))
                    nodes.positionAt(binding pos)
                    vector.append(:Stmt bound binding)
                end
            end
            for i = 0 upto {extent reads - 1} do
                let v = reads[i].v
                let local = nodes.newVar(v.hint clone.ty(c v.type) false)
                clone.bindVar(c v local)
                let binding = nodes.letStmt(local reads[i].op)
                nodes.positionAt(binding pos)
                vector.append(:Stmt bound binding)
            end
            clone.bindAll(c f.body)
            let body = clone.copyBody(c f.body)
            let n = vector.length(:Stmt body.statements)
            let last = if n > 0 then case vector.get(:Stmt body.statements n - 1) when sReturn then true else false end
                else false end
            if last andif {countReturns(body) is 1} then
                (* Its one return is its end: its value is the call's *)
                let value = case vector.pop(:Stmt body.statements) when sReturn with x then x.value else okAtom() end
                let all = vector.copy(:Stmt bound)
                for i = 0 upto {vector.length(:Stmt body.statements) - 1} do
                    vector.append(:Stmt all vector.get(:Stmt body.statements i))
                end
                let resultBinding = nodes.letStmt(result nodes.opOfAtom(value))
                nodes.positionAt(resultBinding pos)
                vector.append(:Stmt all resultBinding)
                for i = 0 upto {extent rest - 1} do vector.append(:Stmt all rest[i]) end
                vector.toArray(:Stmt all)
            else
                labels.count := labels.count + 1
                let label = "inlined" <> conv.int(labels.count)
                returns(body fun(a: Atom pos: Int): Stmt
                    option sJump of Stmt with let var pos = pos let label = label let var args = array of a end end)
                let inner = vector.copy(:Stmt bound)
                for i = 0 upto {vector.length(:Stmt body.statements) - 1} do
                    vector.append(:Stmt inner vector.get(:Stmt body.statements i))
                end
                array of
                    option sJoin of Stmt with
                        let label = label
                        let var params = array of result end
                        let var continuation = nodes.bodyOf(rest)
                        let var body = nodes.bodyOf(vector.toArray(:Stmt inner))
                    end
                end
            end
        end

    let specialize(f: nodes.Function static: Array(Bool) typeArgs: Array(model.Type) args: Array(Atom)
        reads: Array(Read) into: maybe.T(Variable) pos: Int rest: Array(Stmt) labels: clone.Labels): Array(Stmt) =
        begin
            let subst = model.newSubst()
            for i = 0 upto {extent f.typeParams - 1} do
                if i < extent typeArgs then
                    hashMap.insert(:Int :model.Type subst f.typeParams[i].symbolId typeArgs[i])
                end
            end
            let c = clone.newRelabelingCloner(subst labels)
            let result = maybe.unwrapOr(:Variable into nodes.newVar("r" clone.ty(c f.resultType) false))
            let bound = vector.new(:Stmt)
            for i = 0 upto {extent reads - 1} do
                let v = reads[i].v
                let local = nodes.newVar(v.hint clone.ty(c v.type) false)
                clone.bindVar(c v local)
                let binding = nodes.letStmt(local reads[i].op)
                nodes.positionAt(binding pos)
                vector.append(:Stmt bound binding)
            end
            (* The local function's parameters, and the arguments it is called
             * with, the static ones left out *)
            let params = vector.new(:nodes.ParamEntry)
            let types = vector.new(:model.Param)
            let passed = vector.new(:Atom)
            for i = 0 upto {extent f.params - 1} do
                let p = f.params[i].v
                if static[i] then
                    case args[i]
                        when atomVar with x then clone.bindVar(c p x.v)
                        when atomConst then ok
                    end
                else
                    let q = clone.fresh(c p)
                    vector.append(:nodes.ParamEntry params tuple let v = q let mode = "value" end)
                    vector.append(:model.Param types tuple
                        let name = q.hint let type = q.type let isVar = false let isOut = false
                    end)
                    vector.append(:Atom passed args[i])
                end
            end
            let resultType = clone.ty(c f.resultType)
            let inner = nodes.newVar(f.v.hint model.funType(vector.toArray(:model.Param types) resultType) false)
            clone.bindVar(c f.v inner)
            clone.bindAll(c f.body)
            let body = clone.copyBody(c f.body)
            (* Its calls of itself, on the other arguments *)
            let stmts = walk.walkStatements(body true)
            for i = 0 upto {vector.length(:Stmt stmts) - 1} do
                let call = callOfVariable(vector.get(:Stmt stmts i) inner)
                if maybe.isSome(:nodes.OpCall call) then
                    let x = maybe.unwrap(:nodes.OpCall call)
                    let kept = vector.new(:Atom)
                    for k = 0 upto {extent x.args - 1} do
                        if not(static[k]) then vector.append(:Atom kept x.args[k]) end
                    end
                    x.args := vector.toArray(:Atom kept)
                    x.typeArgs := array of :model.Type end
                    x.calleeType := maybe.none(:model.Type)
                end
            end
            let g = nodes.newFunction(inner array of :nodes.TypeParam end vector.toArray(:nodes.ParamEntry params)
                resultType body f.traceName)
            let all = vector.copy(:Stmt bound)
            let funs = option sFuns of Stmt with
                let var functions = array of g end
                let recursive = true
            end
            vector.append(:Stmt all funs)
            let call = nodes.letStmt(result nodes.call(maybe.some(:Variable inner) array of :model.Type end
                vector.toArray(:Atom passed) maybe.none(:nodes.ModuleRef) maybe.none(:String) maybe.none(:model.Type)))
            nodes.positionAt(call pos)
            vector.append(:Stmt all call)
            for i = 0 upto {extent rest - 1} do vector.append(:Stmt all rest[i]) end
            vector.toArray(:Stmt all)
        end
end
