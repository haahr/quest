(* Quest Self-Hosted Compiler: IR Pipeline Interface
 *
 * Runs the post-lowering IR passes shared by every backend before code
 * generation, and identifies modules a unit references implicitly without
 * importing them (docs/ir.md; counterpart:
 * bootstrap/python/quest/ir/pipeline.py) *)

interface Pipeline
import
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/stages : questlang/ir/Stages
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
export
    (* Takes a lowered unit (the core stage) through the passes of docs/ir.md
     * section 8, in order, to stage last, and returns it. after(u s) is called
     * on the unit at each stage s from core on: the driver verifies and dumps
     * there. Each stage's pass is simplify, specialize, closure conversion,
     * unbox and represent, or describe and thunks: unbox is taken with
     * represent, and describe with thunks, because the described stage's
     * invariants need the adapter functions that thunks makes (section 9).
     * referencesAlike says whether the backend holds a pointer and a QVal word
     * alike (codegen/choice.referencesAlike), which the represent pass needs. *)
    runThrough(unit: nodes.Unit last: stages.Stage referencesAlike: Bool after: All(u: nodes.Unit s: stages.Stage) Ok)
            : nodes.Unit
    (* runThrough to the described stage, verifying the unit at each stage when
     * QUEST_CHECK_IR=1: what the backends compile *)
    runPasses(unit: nodes.Unit referencesAlike: Bool): nodes.Unit
    (* The simplifier's unit, the first of the passes, without the copies of
     * inlined modules' members (ir/opened) that nothing calls once it is
     * done *)
    simplified(unit: nodes.Unit): nodes.Unit
    (* The modules (by canonical name and interface) a program's unit uses
     * without importing them: standard library modules, which it links
     * against too *)
    Def ImplicitImport = Tuple canonicalPath: String interfacePath: String end
    implicitImports(unit: nodes.Unit program: typedAst.Program): Array(ImplicitImport)
end
