(* Quest Self-Hosted Compiler: Representation Interface
 *
 * Mirrors bootstrap/python/quest/ir/represent.py (docs/ir.md section 8.3). This
 * pass inserts opConvert operations wherever a value's representation differs
 * from the one its use requires. A value's representation is determined by its
 * type (repr/layout), and each use expects the representation of its target
 * type; where the two differ, plan chooses the conversion plan. The pass also
 * computes how inspect cases extract their components (nodes.InspectArm),
 * plans the adapter thunks for type applications, and in its final step
 * (ir/slots) decides slot boxing and proxy reads. *)

interface Represent
import
    questlang/types/model : questlang/types/Model
    questlang/ir/nodes : questlang/ir/Nodes
    util/maybe : util/Maybe
export
    (* A change of representation the represent pass does not handle *)
    unsupportedConversion: Exception(String)
    (* A conversion that would copy mutable data laid out differently, which
     * would then not share its updates: the program's error, which plan
     * raises and representUnit reports as diagnostics.compilerError, located
     * at the statement whose conversion it is *)
    rejectedConversion: Exception(String)

    (* How a value of type source is converted to be used at type target (none
     * when it is used as it is); layout is given for a value passed to or
     * returned from a polymorphic callee *)
    plan(source: model.Type target: model.Type layout: maybe.T(nodes.PlanLayout)): maybe.T(nodes.Plan)
    (* Inserts the unit's conversions, in place, returning it; raises
     * diagnostics.compilerError for a conversion plan rejects *)
    representUnit(unit: nodes.Unit): nodes.Unit
end
