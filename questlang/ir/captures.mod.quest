(* Quest Self-Hosted Compiler: Captured Mutable Variables Implementation *)

module captures : Captures
import
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    collections/hashMap : collections/HashMap
    util/hash : util/Hash
    util/maybe : util/Maybe
export
    (* Adds to captured the symbols of the local var variables that functions
     * nested in their scope use: a let var anywhere but directly at a unit's or
     * a module's top level (where it is global), used inside a function within
     * its scope. *)
    let capturedMutables(prog: typedAst.Program captured: hashMap.T(Int Bool)): Ok =
        begin
            let declared = hashMap.new(:Int :Int fun(a: Int b: Int): Bool a is b hash.int)
            let rec walkChild(c: typedAst.Child depth: Int top: Bool): Ok =
                case c
                    when childExpr with x then walkExpr(x.e depth)
                    when childBinding with x then
                        let lets = typedAst.letValues(x.b)
                        for i = 0 upto {extent lets - 1} do
                            if lets[i].symbol.isVar andif not(top) then
                                hashMap.insert(:Int :Int declared lets[i].symbol.symbolId depth)
                            end
                        end
                        (* A module's bindings are at the top level it is at *)
                        let children = typedAst.bindingChildren(x.b)
                        let childTop = top andif x.b.form?bindModule
                        for i = 0 upto {extent children - 1} do walkChild(children[i] depth childTop) end
                end
            and walkExpr(e: typedAst.Expr depth: Int): Ok =
                begin
                    case e.form
                        when exprVar with x then
                            let d = hashMap.get(:Int :Int declared x.symbol.symbolId)
                            if maybe.isSome(:Int d) andif {maybe.unwrap(:Int d) < depth} then
                                hashMap.insert(:Int :Bool captured x.symbol.symbolId true)
                            end
                        else ok
                    end
                    walkChildren(typedAst.children(e) if e.form?exprFun then depth + 1 else depth end)
                end
            and walkChildren(cs: Array(typedAst.Child) depth: Int): Ok =
                for i = 0 upto {extent cs - 1} do walkChild(cs[i] depth false) end
            for i = 0 upto {extent prog.phrases - 1} do
                walkChild(option childBinding of typedAst.Child with let b = prog.phrases[i] end 0 true)
            end
        end
end
