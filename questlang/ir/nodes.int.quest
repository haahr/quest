(* Quest Self-Hosted Compiler: The IR's Nodes Interface
 *
 * bootstrap/python/quest/ir/nodes.py (docs/ir.md sections 3, 5, 6). A unit is a
 * body of statements (its main) together with the modules it defines. Bodies
 * are sequences of statements. Operations take atoms (variables and constants)
 * and are named by let; structured statements (if, switch, loop, try) contain
 * bodies; values produced on several paths join through join points.
 *
 * Binders are records with identity: a Variable (the bootstrap's Var) is bound
 * by exactly one binder, and every use refers to that same record (same
 * compares their ids). Nodes are built once by lowering and then rewritten by
 * the passes in place: the fields the passes set are var fields. An operation's
 * or statement's fields are its case's payload, which a case's binder shares,
 * so a pass sets them through it.
 *
 * The bootstrap's operations and atoms are one family here (Op): a let binds an
 * operation or an atom (opAtom). Its fields named with keywords are renamed:
 * tuple, record, array, var, module, exception, and ordinal are tup, recordAtom
 * (a module's record, recordVar), arr, v, moduleRef, exc, and ordinalAtom (a
 * payload's, ordinalIndex). *)

interface Nodes
import
    questlang/common/location : questlang/common/Location
    questlang/types/model : questlang/types/Model
    questlang/repr/shapes : questlang/repr/Shapes
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
export
    Def Type = model.Type
    Def Shape = shapes.Shape

    (* The primitive operations (docs/ir.md section 5): Quest's infix operators
     * on Ints, Reals, Strings, and Bools, is and isnot, not, and extent *)
    Def Prim = Option primAdd primSub primMul primDiv primRem primMod primLt primLe primGt primGe primRealAdd
        primRealSub primRealMul primRealDiv primRealPow primRealLt primRealLe primRealGt primRealGe primConcat primAnd
        primOr primIs primIsnot primNot primExtent end
    primAdd: Prim
    primSub: Prim
    primMul: Prim
    primDiv: Prim
    primRem: Prim
    primMod: Prim
    primLt: Prim
    primLe: Prim
    primGt: Prim
    primGe: Prim
    primRealAdd: Prim
    primRealSub: Prim
    primRealMul: Prim
    primRealDiv: Prim
    primRealPow: Prim
    primRealLt: Prim
    primRealLe: Prim
    primRealGt: Prim
    primRealGe: Prim
    primConcat: Prim
    primAnd: Prim
    primOr: Prim
    primIs: Prim
    primIsnot: Prim
    primNot: Prim
    primExtent: Prim
    (* A primitive's spelling in Quest; the primitive spelled name *)
    primName(p: Prim): String
    primNamed(name: String): Prim
    (* Whether a primitive is is or isnot *)
    comparesIdentity(p: Prim): Bool

    (* The kinds of conversion plans (docs/ir.md section 8.3) *)
    Def PlanKind = Option
        planBox planUnbox planRecordView planVariantTags planCast planUnproxy
        planSlotBox planSlotUnbox planView planRuntime planAdapt planCopy
    end
    planBox: PlanKind
    planUnbox: PlanKind
    planRecordView: PlanKind
    planVariantTags: PlanKind
    planCast: PlanKind
    planUnproxy: PlanKind
    planSlotBox: PlanKind
    planSlotUnbox: PlanKind
    planView: PlanKind
    planRuntime: PlanKind
    planAdapt: PlanKind
    planCopy: PlanKind
    (* A plan kind's name in the IR's dumps *)
    planKindName(k: PlanKind): String

    (* How an operation reads (or writes) a component of a tuple or option, as
     * the represent pass decides in its last step (questlang/ir/slots,
     * docs/ir.md section 8.3); lowering makes every access direct. A tuple or
     * option upcast to a supertype at which a component's representation
     * changes (a record's offset table, a variant's tag numbering) is not
     * copied, so that it stays the same object and shares its var components:
     * it is wrapped in a proxy, a run-time view holding the original object,
     * which converts components as they are read (docs/c-representation.md
     * section 5.8). So:
     * - direct: the value is not a proxy (its type cannot be one, or the
     *   function made it), so the component is in its own slot;
     * - original: it may be a proxy, but the component's type cannot change
     *   view, so it is read (or written) in the original's slot; for is, the
     *   originals are compared;
     * - proxy: it may be a proxy, and the component's type can change view,
     *   so the read checks for a proxy and converts through it (a write goes
     *   into the original). An option's tag is read direct or proxy *)
    Def Access = Option direct original proxy end
    direct: Access
    original: Access
    proxy: Access
    accessName(a: Access): String

    (* What a try's handler catches: listed exceptions, all, all with their
     * frames captured (its else branch names the exception, docs/raised.md
     * section 5), or unknown until it runs *)
    Def Catching = Option catchListed catchAll catchAllTraced catchUnknown end
    catchListed: Catching
    catchAll: Catching
    catchAllTraced: Catching
    catchUnknown: Catching

    (* The IR's stages, in order: each pass produces the next *)
    stages: Array(String)

    (* The types of the variables the describe pass binds (docs/ir.md sections
     * 7 and 8.4), external types whose C forms are pointers.
     *
     * A descriptor is a type as a run-time value (C's const QTypeDescriptor *,
     * docs/c-representation.md section 6.4). Compiled code erases types, so
     * generic code, which holds an unbounded type parameter's values as
     * uniform words, is passed each type parameter's descriptor (before its
     * value parameters) to compare, convert, print, or inspect its values. A
     * descriptor variable (DescriptorParam) stands for a type parameter's: a
     * function's, a thunk's, or an inspected auto value's type component.
     *
     * A view map (const QViewMap *, docs/c-representation.md section 5.1, Own
     * views) lets generic code read a value of a type parameter bounded by a
     * record, variant, option, or tuple type, held at its type argument's
     * representation, as a value of the bound: for a record, where each of
     * the bound's fields is in the type argument's offset table; for a
     * variant or option, the bound's tag for each of the type argument's. A
     * function computes one where it begins, from the type parameter's
     * descriptor and the bound's (Function.viewMaps), for each such type
     * parameter whose values it reads so, and those reads name it (their
     * viewMap fields) *)
    descriptorType: Type
    viewMapType: Type

    Def Rec Variable = Tuple
        id: Int
        hint: String
        type: Type
        isMutable: Bool
        (* Set by the represent pass for a variable of a record or variant type
         * held boxed *)
        var boxed: Bool
        (* Set by questlang/ir/unbox for a variable of a tuple type held as its
         * components, never allocated *)
        var unboxed: Bool
    end
    (* A constant: an Int, Real, Bool, Char, or String, or ok *)
    and Const = Tuple value: ConstValue shape: Shape end
    and ConstValue = Option
        constInt with n: Int end
        constReal with r: Real end
        constBool with b: Bool end
        constChar with c: Char end
        constString with s: String end
        constOk
    end
    and Atom = Option
        atomVar with v: Variable end
        atomConst with c: Const end
    end

    (* The static descriptor of a type that mentions no type parameter in scope,
     * or of a template, a type with holes (descriptors.holeVar) that stand for
     * type parameters and are filled in at run time (descInstantiate); a
     * backend emits it as a constant. echo: the descriptor echo writes a value
     * of the closed type by, which writes its type components by their alias
     * names, rather than the one shared by every type of its shape *)
    and StaticDescriptor = Tuple id: Int type: Type echo: Bool end
    (* A descriptor operand (after the describe pass, docs/ir.md section 8.4):
     * a type parameter's descriptor variable, a static descriptor, or a
     * template instantiated with the descriptors of its holes, in order. The
     * operands are small pure expressions rather than variables bound by let,
     * so a backend evaluates each where it is used *)
    and Descriptor = Option
        descVar with v: Variable end
        descStatic with d: StaticDescriptor end
        descInstantiate with template: Type args: Array(Descriptor) end
    end
    (* A descriptor variable v bound for a type parameter (see descriptorType).
     * symbols are the ids the type parameter is named by in the types it
     * describes: one for a function's, but a thunk's type parameter is named
     * both in the closure's type and in the type it is adapted to *)
    and DescriptorParam = Tuple v: Variable symbols: Array(Int) end
    (* A view map variable v (see viewMapType) for the type parameter named
     * symbol, computed where its function begins from descriptor, the type
     * parameter's descriptor variable, and bound, its bound's descriptor *)
    and ViewMapParam = Tuple v: Variable symbol: Int descriptor: Variable bound: Descriptor end
    (* An offset table's two types' static descriptors, by which the runtime
     * finds the table for a dynamic value *)
    and Registered = Tuple view: StaticDescriptor layout: StaticDescriptor end
    (* A static offset table (docs/c-representation.md section 5.2): where each
     * field of the record type view is in a record laid out as the record
     * type layout. registered is set when both types are closed. id is view's
     * shape's id, by which the verifier checks that a table is listed *)
    and OffsetTable = Tuple id: Int view: Type layout: Type var registered: maybe.T(Registered) end
    (* A static table that maps a variant's tags from source's numbering to
     * that of its supertype target, for a variantTags plan; id is target's
     * shape's id *)
    and TagMap = Tuple id: Int target: Type source: Type end
    (* The static descriptors and tables a unit's operations refer to (after the
     * describe pass), which a backend emits, each listed once; and types, the
     * types whose aggregates (tuples, records, options, variants, and those
     * inside them) a backend declares (docs/ir.md section 8.4) *)
    and StaticData = Tuple
        descriptors: vector.T(StaticDescriptor)
        offsetTables: vector.T(OffsetTable)
        tagMaps: vector.T(TagMap)
        types: vector.T(Type)
    end
    and TypeParam = Tuple name: String symbolId: Int kind: model.Kind bound: maybe.T(Shape) end

    (* A plan's layout: the polymorphic callee's type parameters' instantiation
     * (its symbols in the order they were bound, as the bootstrap's dictionary
     * keeps them), and whether the value goes to the generic layout *)
    and PlanLayout = Tuple subst: model.Subst keys: vector.T(Int) toGeneric: Bool end
    (* How convert changes a value's representation from source's to target's
     * (docs/ir.md section 8.3, which lists the kinds). The represent pass sets
     * the fields after kind, source, and target, and the describe pass the
     * descriptors and tables:
     * - fields: a copy's plan for each component of the new tuple, or an
     *   adapt plan's for each of the closure's parameters (none for var and
     *   out ones), then its result's; none where a value is used as it is;
     * - layout: for a runtime plan, the polymorphic callee's layout the value
     *   goes to or comes from (an adapt plan has its call's, by which its
     *   fields convert; a view plan of an abstract type's value, the layout
     *   its module's generic code gives the type's representation);
     * - access: how a copy reads each component of the source tuple;
     * - thunkSymbols: for each of an adapt plan's thunk's type parameters, the
     *   symbols it is named by in the plans of fields (the target's and the
     *   source's);
     * - descriptors: the descriptors the plan converts by: a recordView's,
     *   the target record's; a view's or a runtime's, those of the two
     *   representations it converts from and to;
     * - thunkParams: an adapt plan's thunk's descriptor variables, which the
     *   descriptors of its fields use;
     * - tagMap: a variantTags plan's table *)
    and Plan = Tuple
        id: Int
        kind: PlanKind
        source: Type
        target: Type
        var fields: Array(maybe.T(Plan))
        var layout: maybe.T(PlanLayout)
        var access: Array(Access)
        var thunkSymbols: Array(Array(Int))
        var descriptors: Array(Descriptor)
        var thunkParams: Array(DescriptorParam)
        var tagMap: maybe.T(TagMap)
        (* An adapt plan's adapter, a function of the unit (made by the
         * thunks pass, which empties the plan's thunk parameters and fields:
         * they are the adapter's) *)
        var thunk: maybe.T(Function)
    end

    and TypeComponent = Tuple name: String type: Type end
    and FieldAtom = Tuple name: String atom: Atom isVar: Bool end

    (* The operations, the right-hand sides of let, and the atoms (docs/ir.md
     * section 5). Lowering makes most of them; fields shared by many cases:
     * - offset: the operation's place in the unit's source (fileOffset), the
     *   site reported if it raises a run-time error (site);
     * - access: how a tuple's or option's component or tag is read or written
     *   (Access), set by the represent pass (questlang/ir/slots);
     * - descriptor, descriptors: the descriptors of the types the operation
     *   needs at run time (its type arguments' for a call), set by the
     *   describe pass;
     * - viewMap: for a value of a type parameter bounded by a record,
     *   variant, option, or tuple type, the view map it is read through its
     *   bound by (viewMapType), set by the describe pass *)
    and Op = Option
        opAtom with var atom: Atom end
        (* For is and isnot: access original (set by the represent pass) when
         * the values may be proxies, and a descriptor of their type (set by
         * the describe pass) when they are QVal words (quest_val_is) or
         * options that is compares by case (quest_option_is), since then
         * whether two are the same depends on the type *)
        opPrim with
            op: Prim
            var args: Array(Atom)
            offset: maybe.T(Int)
            var access: Access
            var descriptor: maybe.T(Descriptor)
        end
        (* A call of a function a funs statement binds or a variable holds
         * (callee), or of a module's member (moduleRef and member, the
         * member's type calleeType) *)
        opCall with
            var callee: maybe.T(Variable)
            var typeArgs: Array(Type)
            var args: Array(Atom)
            var moduleRef: maybe.T(ModuleRef)
            var member: maybe.T(String)
            var calleeType: maybe.T(Type)
            var descriptors: Array(Descriptor)
        end
        (* A polymorphic value applied to types only (maybe.none(:Int)). The
         * represent pass sets plans: for a value of no parameters, its
         * value's conversion to the let's type; for a function, whose instance
         * is a thunk converting its arguments and result, the parameters'
         * plans (none for var and out ones), then the result's; and
         * thunkSymbols, the symbols the thunk's own type parameters are named
         * by in those plans. The describe pass sets thunkParams, for a
         * function only: the thunk's descriptor variables, which its plans'
         * descriptors use (docs/ir.md section 8.4) *)
        opTypeApp with
            var callee: maybe.T(Variable)
            var typeArgs: Array(Type)
            var moduleRef: maybe.T(ModuleRef)
            var member: maybe.T(String)
            var calleeType: maybe.T(Type)
            var plans: Array(maybe.T(Plan))
            var thunkSymbols: Array(Array(Int))
            var descriptors: Array(Descriptor)
            var thunkParams: maybe.T(Array(DescriptorParam))
        end
        (* A module's member as a value, or with no member the module itself *)
        opModuleMember with var moduleRef: ModuleRef var member: maybe.T(String) end
        (* A built-in function as a value, such as an infix operator (+) *)
        opBuiltin with name: String end
        (* An external C value or function (external "symbol") as a value *)
        opExternal with symbol: String end
        (* A call of an external C function: the body of a function defined as
         * external "symbol", passing the C function its type parameters'
         * descriptors and its parameters (addresses for var and out) *)
        opCallExternal with
            symbol: String
            var typeArgs: Array(Type)
            var args: Array(Atom)
            var descriptors: Array(Descriptor)
        end
        (* A closure, made by closure conversion: code, one of the unit's
         * functions, with the values it captures, which its body reads from
         * its environment, and first the types of the enclosing functions'
         * type parameters it takes (its leading type parameters) *)
        opMakeClosure with
            var code: Function
            var captures: Array(Atom)
            var typeArgs: Array(Type)
            var descriptors: Array(Descriptor)
        end
        (* A value a closure captured, read from the environment env of the
         * function it runs: its index'th capture. Closure conversion binds
         * one at a function's start for each variable it captures *)
        opEnvField with var env: Atom index: Int end
        (* A value changed from one representation to another, as plan says
         * (made by the represent pass) *)
        opConvert with var value: Atom var plan: Plan end
        (* A tuple of its value components, args. typeComponents are its type
         * components' names and types, which compiled code erases, for the
         * IR's dumps and its interpreter. embedded (set by the represent
         * pass) lists the positions of the records and variants the tuple's
         * own allocation boxes, rather than a box of their own (a box is
         * immutable, so it may be shared) *)
        opMakeTuple with var args: Array(Atom) typeComponents: Array(TypeComponent) var embedded: Array(Int) end
        opTupleField with var tup: Atom var index: Int var access: Access var viewMap: maybe.T(Variable) end
        (* A record, made in its box. embedded is as a tuple's. The represent
         * pass sets runtimeOffsets when the offset table of the view the let
         * binds it at (docs/c-representation.md section 5.2) cannot be known
         * statically, since the view is not the record's type or a supertype
         * by width alone. The describe pass sets descriptor, that of the
         * record's own type (its fields' atoms' types), which the record
         * carries, and either offsets, the static offset table of its view,
         * or with runtime offsets viewDescriptor, the view's descriptor, by
         * which the runtime finds the table (quest_record_dict) *)
        opMakeRecord with
            var fields: Array(FieldAtom)
            var embedded: Array(Int)
            var runtimeOffsets: Bool
            var descriptor: maybe.T(Descriptor)
            var offsets: maybe.T(OffsetTable)
            var viewDescriptor: maybe.T(Descriptor)
        end
        (* A record's field. The represent pass sets stored for an immutable
         * field that a subtype's record may hold at another type
         * (docs/c-representation.md section 5.2): it is read through the
         * offset table's stored types and converted to the field's type,
         * whose descriptor the describe pass sets *)
        opRecordField with
            var recordAtom: Atom
            name: String
            var stored: Bool
            var descriptor: maybe.T(Descriptor)
            var viewMap: maybe.T(Variable)
        end
        opMakeVariant with tag: String var payload: maybe.T(Atom) end
        (* An option of case tag, or with ordinalAtom, of the case whose
         * index in cases is its value, computed at run time; cases are the
         * names of the cases of the option's type as written
         * (canonical.optionCaseNames), not its shape's order. A payload is a
         * tuple of the case's components, which access says how to read
         * (set by the represent pass) *)
        opMakeOption with
            tag: maybe.T(String)
            var payload: maybe.T(Atom)
            var ordinalAtom: maybe.T(Atom)
            offset: maybe.T(Int)
            cases: Array(String)
            var access: Array(Access)
        end
        (* Whether a variant or option is of case tag (v?tag) *)
        opIsTag with var value: Atom tag: String var access: Access var viewMap: maybe.T(Variable) end
        (* The payload of case tag (v!tag, raising if it is another): a
         * variant's, or an option's components as a new tuple, which starts
         * with ordinalIndex, the case's index in the option's type as written
         * (docs/ir.md section 5). access says how the tag is read, and
         * components (set by the represent pass) how the components are *)
        opPayload with
            var value: Atom
            tag: String
            offset: maybe.T(Int)
            var access: Access
            var components: Array(Access)
            ordinalIndex: maybe.T(Int)
            var viewMap: maybe.T(Variable)
        end
        (* An option's ordinal: its case's index in cases, as opMakeOption's *)
        opOrdinal with var value: Atom cases: Array(String) var access: Access var viewMap: maybe.T(Variable) end
        opMakeArray with var args: Array(Atom) end
        (* An array of count copies of init *)
        opArrayRep with var count: Atom var init: Atom offset: maybe.T(Int) end
        opIndex with var arr: Atom var index: Atom offset: maybe.T(Int) end
        (* An auto value of type autoType (Auto A::K with ... end,
         * docs/c-representation.md section 8.1): witness, its type component,
         * the type A stands for in it, and payload, a tuple of its other
         * components. The describe pass sets descriptor, the witness's, which
         * the value carries, for inspect to test *)
        opMakeAuto with witness: Type autoType: Type var payload: Atom var descriptor: maybe.T(Descriptor) end
        (* A new exception (exceptions are generative), with the type of the
         * payload it carries, if any *)
        opMakeException with name: String payloadType: maybe.T(Type) end
        (* The payload of a handler's exception exc *)
        opExceptionPayload with var exc: Atom end
        (* A handler's exception as a value of raised.T (docs/raised.md) *)
        opCaughtException with var exc: Atom end
        (* Addresses of locations, passed as var and out arguments: of a
         * mutable variable (@x); of a fresh temporary cell holding init
         * (var(e)); of a record's var field (@r.f), a tuple's var component
         * (@t.f, through a proxy the original's slot), or an array's element
         * (@a[i]) *)
        opAddrVar with var v: Variable end
        opAddrCell with var init: Atom end
        opAddrField with var base: Atom name: String var viewMap: maybe.T(Variable) end
        opAddrComponent with var base: Atom index: Int var access: Access var viewMap: maybe.T(Variable) end
        opAddrElement with var base: Atom var index: Atom offset: maybe.T(Int) end
        (* The value at an address *)
        opLoad with var address: Atom end
    end

    (* A parameter and its mode: "value", "var", or "out" *)
    and ParamEntry = Tuple v: Variable mode: String end
    (* A function: v names it; after closure conversion, a function is one of
     * the unit's, and env, if any, is the environment of the closure it runs,
     * from which its body reads the values it captured (opEnvField).
     * traceName is its frame's name in tracebacks (docs/exceptions.md section
     * 2.3), none for the thunks the passes make. The describe pass sets
     * descriptorParams, a descriptor variable for each of its type
     * parameters, in order, and viewMaps, those its body reads values of
     * bounded type parameters through (see viewMapType) *)
    and Function = Tuple
        id: Int
        var v: Variable
        var typeParams: Array(TypeParam)
        var params: Array(ParamEntry)
        var resultType: Type
        var body: Body
        var env: maybe.T(Variable)
        var traceName: maybe.T(String)
        var descriptorParams: Array(DescriptorParam)
        var viewMaps: Array(ViewMapParam)
        (* Set by questlang/ir/unbox: the function returns its tuple result's
         * components *)
        var unboxedResult: Bool
    end
    (* A case of a switch: the tags it matches, its body, and the variable
     * bound to the payload, if any. An option's payload is a new tuple of the
     * case's components, read as components says (set by the represent
     * pass) *)
    and Case = Tuple tags: Array(String) var body: Body var binder: maybe.T(Variable) var components: Array(Access) end
    and DescriptorPair = Tuple source: Descriptor target: Descriptor end
    (* How an inspect case of an auto value obtains its components from the
     * payload, which is stored in the auto type's witness-independent layout
     * (docs/c-representation.md section 8.1): its signature's layout with the
     * type component an abstract type, the same whatever type the witness
     * is. Decided by the represent pass.
     *
     * converted says, for each component, how a new tuple of the case's
     * components gets it: none, copied as it is; "component", a value of the
     * type component itself, converted from the value's witness to the
     * case's type; "mentions", a component whose type mentions the type
     * component, converted from its stored type at the witness. descriptors
     * (set by the describe pass) are the descriptors each converted
     * component converts from and to.
     *
     * For an exact case (exact), the code checks at run time whether the
     * stored layout is the case's (quest_layout_equivalent): if it is, the
     * stored payload serves, as it is (shared: the layouts agree statically,
     * so var components are shared too) or converted by plan; if not, the
     * components are converted as for any case, after raising a layout error
     * (layoutError) when the auto type has var components, whose updates a
     * copy would not share *)
    and InspectArm = Tuple
        converted: Array(maybe.T(String))
        exact: Bool
        shared: Bool
        plan: maybe.T(Plan)
        layoutError: Bool
        var descriptors: Array(maybe.T(DescriptorPair))
    end
    and InspectCase = Tuple
        matchType: Type
        var binders: Array(Variable)
        var body: Body
        exact: Bool
        var arm: maybe.T(InspectArm)
        var descriptor: maybe.T(Descriptor)
    end

    and Stmt = Option
        sLet with var pos: Int var v: Variable var value: Op end
        sVarDecl with var pos: Int var v: Variable var init: maybe.T(Atom) end
        sAssign with var pos: Int var v: Variable var value: Atom end
        sStoreAt with var pos: Int var value: Atom var address: Atom end
        sStoreField with var pos: Int var value: Atom var base: Atom name: String var viewMap: maybe.T(Variable) end
        sStoreComponent with
            var pos: Int
            var value: Atom
            var base: Atom
            index: Int
            var access: Access
            var viewMap: maybe.T(Variable)
        end
        sStoreElement with var pos: Int var value: Atom var base: Atom var index: Atom offset: maybe.T(Int) end
        sDo with var pos: Int var value: Op end
        sFuns with var functions: Array(Function) recursive: Bool end
        (* Recursive values (let rec self: T = tuple ... end): body computes
         * each of vars' values, a constructor or a function, and the closures
         * it makes may refer to any of vars, which are bound when body
         * finishes *)
        sLetRec with var vars: Array(Variable) var body: Body end
        sIf with var pos: Int var cond: Atom var thenBody: Body var elseBody: Body end
        sSwitch with
            var pos: Int
            var value: Atom
            var cases: Array(Case)
            var elseBody: maybe.T(Body)
            var access: Access
            var viewMap: maybe.T(Variable)
        end
        (* An inspect of an auto value (whose type is autoType) by its
         * run-time type component (docs/ir.md section 6.5); with no case
         * matching and no else body, it raises a dynamic error, reported at
         * offset. The describe pass sets witness, the descriptor variable that
         * stands for the value's type component, bound under the auto type's
         * own symbol in the cases' arms (InspectArm), which convert the
         * value's components by it *)
        sInspect with
            var pos: Int
            var value: Atom
            var cases: Array(InspectCase)
            var elseBody: maybe.T(Body)
            autoType: maybe.T(Type)
            offset: maybe.T(Int)
            var witness: maybe.T(DescriptorParam)
        end
        sLoop with label: String var body: Body end
        (* A try region (docs/ir.md section 6.4): a raise in body, or in what
         * it calls, runs handler, with exc bound to the exception raised.
         * catching says what the handler catches; for catchListed, catches
         * are the exceptions its branches name, evaluated before the try, by
         * which a raise tells whether it will be caught, and walks the stack
         * for a traceback's frames only if not (docs/exceptions.md section
         * 5.1) *)
        sTry with var body: Body var exc: Variable var handler: Body catching: Catching var catches: Array(Atom) end
        (* A join point (docs/ir.md section 6.3), where paths that produce a
         * value meet. Lowering makes let x = if c then 1 else 2 end; rest
         *     join k(x) { rest } in { if c { jump k(1) } else { jump k(2) } }
         * body runs first; a jump label(args) in it, in tail position and not
         * from a function it binds, binds params to args and runs
         * continuation, the only place params are in scope. After the
         * continuation, or if body ends without jumping, control goes on
         * after the join *)
        sJoin with label: String var params: Array(Variable) var continuation: Body var body: Body end
        (* Prints a top-level phrase's value as the driver's --echo does: prefix
         * (let x:T = , for a binding) and the value, or for an expression
         * (prefix empty) the value and : type. The describe pass sets
         * descriptor when the type does not say how the value is written *)
        sEcho with var pos: Int var value: Atom type: Type prefix: String var descriptor: maybe.T(Descriptor) end
        sEchoText with text: String end
        sReturn with var pos: Int var value: Atom end
        sJump with var pos: Int label: String var args: Array(Atom) end
        sBreak with var pos: Int label: String end
        sContinue with var pos: Int label: String end
        (* A raise; with a payload of a type other than Ok, its type as the
         * raise wrote it, and the descriptor the describe pass gives it, by
         * which an uncaught exception's payload is shown (docs/exceptions.md
         * section 2.1) *)
        sRaise with
            var pos: Int var exc: Atom var payload: maybe.T(Atom) offset: maybe.T(Int) payloadText: String
            var descriptor: maybe.T(Descriptor)
        end
        sReraise with var pos: Int var exc: Variable end
        sUnreachable
    end
    (* The fields of each operation and statement, as a tuple type: the type
     * of its case's binder, so each lists its case's fields *)
    and OpAtom = Tuple var atom: Atom end
    and OpPrim = Tuple
        op: Prim
        var args: Array(Atom)
        offset: maybe.T(Int)
        var access: Access
        var descriptor: maybe.T(Descriptor)
    end
    and OpCall = Tuple
        var callee: maybe.T(Variable)
        var typeArgs: Array(Type)
        var args: Array(Atom)
        var moduleRef: maybe.T(ModuleRef)
        var member: maybe.T(String)
        var calleeType: maybe.T(Type)
        var descriptors: Array(Descriptor)
    end
    and OpTypeApp = Tuple
        var callee: maybe.T(Variable)
        var typeArgs: Array(Type)
        var moduleRef: maybe.T(ModuleRef)
        var member: maybe.T(String)
        var calleeType: maybe.T(Type)
        var plans: Array(maybe.T(Plan))
        var thunkSymbols: Array(Array(Int))
        var descriptors: Array(Descriptor)
        var thunkParams: maybe.T(Array(DescriptorParam))
    end
    and OpModuleMember = Tuple var moduleRef: ModuleRef var member: maybe.T(String) end
    and OpBuiltin = Tuple name: String end
    and OpExternal = Tuple symbol: String end
    and OpCallExternal = Tuple
        symbol: String
        var typeArgs: Array(Type)
        var args: Array(Atom)
        var descriptors: Array(Descriptor)
    end
    and OpMakeClosure = Tuple
        var code: Function
        var captures: Array(Atom)
        var typeArgs: Array(Type)
        var descriptors: Array(Descriptor)
    end
    and OpEnvField = Tuple var env: Atom index: Int end
    and OpConvert = Tuple var value: Atom var plan: Plan end
    and OpMakeTuple = Tuple var args: Array(Atom) typeComponents: Array(TypeComponent) var embedded: Array(Int) end
    and OpTupleField = Tuple var tup: Atom var index: Int var access: Access var viewMap: maybe.T(Variable) end
    and OpMakeRecord = Tuple
        var fields: Array(FieldAtom)
        var embedded: Array(Int)
        var runtimeOffsets: Bool
        var descriptor: maybe.T(Descriptor)
        var offsets: maybe.T(OffsetTable)
        var viewDescriptor: maybe.T(Descriptor)
    end
    and OpRecordField = Tuple
        var recordAtom: Atom
        name: String
        var stored: Bool
        var descriptor: maybe.T(Descriptor)
        var viewMap: maybe.T(Variable)
    end
    and OpMakeVariant = Tuple tag: String var payload: maybe.T(Atom) end
    and OpMakeOption = Tuple
        tag: maybe.T(String)
        var payload: maybe.T(Atom)
        var ordinalAtom: maybe.T(Atom)
        offset: maybe.T(Int)
        cases: Array(String)
        var access: Array(Access)
    end
    and OpIsTag = Tuple var value: Atom tag: String var access: Access var viewMap: maybe.T(Variable) end
    and OpPayload = Tuple
        var value: Atom
        tag: String
        offset: maybe.T(Int)
        var access: Access
        var components: Array(Access)
        ordinalIndex: maybe.T(Int)
        var viewMap: maybe.T(Variable)
    end
    and OpOrdinal = Tuple var value: Atom cases: Array(String) var access: Access var viewMap: maybe.T(Variable) end
    and OpMakeArray = Tuple var args: Array(Atom) end
    and OpArrayRep = Tuple var count: Atom var init: Atom offset: maybe.T(Int) end
    and OpIndex = Tuple var arr: Atom var index: Atom offset: maybe.T(Int) end
    and OpMakeAuto = Tuple witness: Type autoType: Type var payload: Atom var descriptor: maybe.T(Descriptor) end
    and OpMakeException = Tuple name: String payloadType: maybe.T(Type) end
    and OpExceptionPayload = Tuple var exc: Atom end
    and OpCaughtException = Tuple var exc: Atom end
    and OpAddrVar = Tuple var v: Variable end
    and OpAddrCell = Tuple var init: Atom end
    and OpAddrField = Tuple var base: Atom name: String var viewMap: maybe.T(Variable) end
    and OpAddrComponent = Tuple var base: Atom index: Int var access: Access var viewMap: maybe.T(Variable) end
    and OpAddrElement = Tuple var base: Atom var index: Atom offset: maybe.T(Int) end
    and OpLoad = Tuple var address: Atom end
    and StmtLet = Tuple var pos: Int var v: Variable var value: Op end
    and StmtVarDecl = Tuple var pos: Int var v: Variable var init: maybe.T(Atom) end
    and StmtAssign = Tuple var pos: Int var v: Variable var value: Atom end
    and StmtStoreAt = Tuple var pos: Int var value: Atom var address: Atom end
    and StmtStoreField = Tuple
        var pos: Int var value: Atom var base: Atom name: String var viewMap: maybe.T(Variable)
    end
    and StmtStoreComponent = Tuple
        var pos: Int
        var value: Atom
        var base: Atom
        index: Int
        var access: Access
        var viewMap: maybe.T(Variable)
    end
    and StmtStoreElement = Tuple var pos: Int var value: Atom var base: Atom var index: Atom offset: maybe.T(Int) end
    and StmtDo = Tuple var pos: Int var value: Op end
    and StmtFuns = Tuple var functions: Array(Function) recursive: Bool end
    and StmtLetRec = Tuple var vars: Array(Variable) var body: Body end
    and StmtIf = Tuple var pos: Int var cond: Atom var thenBody: Body var elseBody: Body end
    and StmtSwitch = Tuple
        var pos: Int
        var value: Atom
        var cases: Array(Case)
        var elseBody: maybe.T(Body)
        var access: Access
        var viewMap: maybe.T(Variable)
    end
    and StmtInspect = Tuple
        var pos: Int
        var value: Atom
        var cases: Array(InspectCase)
        var elseBody: maybe.T(Body)
        autoType: maybe.T(Type)
        offset: maybe.T(Int)
        var witness: maybe.T(DescriptorParam)
    end
    and StmtLoop = Tuple label: String var body: Body end
    and StmtTry = Tuple var body: Body var exc: Variable var handler: Body catching: Catching var catches: Array(Atom) end
    and StmtJoin = Tuple label: String var params: Array(Variable) var continuation: Body var body: Body end
    and StmtEcho = Tuple var pos: Int var value: Atom type: Type prefix: String var descriptor: maybe.T(Descriptor) end
    and StmtEchoText = Tuple text: String end
    and StmtReturn = Tuple var pos: Int var value: Atom end
    and StmtJump = Tuple var pos: Int label: String var args: Array(Atom) end
    and StmtBreak = Tuple var pos: Int label: String end
    and StmtContinue = Tuple var pos: Int label: String end
    and StmtRaise = Tuple
        var pos: Int var exc: Atom var payload: maybe.T(Atom) offset: maybe.T(Int) payloadText: String
        var descriptor: maybe.T(Descriptor)
    end
    and StmtReraise = Tuple var pos: Int var exc: Variable end
    (* A sequence of statements; a terminator, if any, is last *)
    and Body = Tuple id: Int var statements: vector.T(Stmt) end

    (* A module's members (or exports) by name, in the order they were bound *)
    and Members = Tuple names: vector.T(String) vars: hashMap.T(String Variable) end
    and AbstractTypeEntry = Tuple name: String arity: Int descriptor: StaticDescriptor end
    (* A module defined by the unit *)
    and Module = Tuple
        id: Int
        name: String
        interfaceName: String
        var init: Body
        var members: Members
        var exports: maybe.T(Members)
        var recordVar: maybe.T(Variable)
        var abstractTypes: Array(AbstractTypeEntry)
    end
    (* A module the unit uses from elsewhere *)
    and Import = Tuple
        id: Int
        name: String
        modulePath: String
        canonicalPath: String
        interfacePath: String
        recordType: maybe.T(Type)
        (* The module's path in lib/ (collections/vector) when the import
         * resolves to one of the standard library's modules, whose external
         * functions are called directly (questlang/repr/externals) *)
        libPath: maybe.T(String)
    end
    (* A reference to a module: one the unit defines, or one it imports (by
     * identity, never by name) *)
    and ModuleRef = Option
        refModule with m: Module end
        refImport with i: Import end
    end

    (* A source position: the file's number in its unit (0 for the unit's
     * own source, k + 1 for its kth merged one), and its line and column,
     * from 1 *)
    Def SourcePos = Tuple file: Int line: Int col: Int end

    (* A phrase unit, one input of the REPL: its number, and whether the
     * results its phrases show are captured, for the REPL, rather than
     * written. Its top level is the initializer of a module of its own
     * (qj_<number>), whose record holds its bindings, which later inputs read
     * as an import's members (ir/lower). *)
    Def Phrase = Tuple number: Int capture: Bool end

    (* A compilation unit: a program's, with a main (and with --whole-program,
     * the modules it imports, driver/whole), or a module file's *)
    Def Unit = Tuple
        var isProgram: Bool
        var main: Body
        var modules: vector.T(Module)
        var imports: Array(Import)
        var functions: vector.T(Function)
        var stage: String
        var sourceMap: maybe.T(location.SourceMap)
        (* With --whole-program, the maps of the files of the modules merged
         * into the unit (driver/whole): file k's offsets are fileOffset(k + 1 ...) *)
        var mergedSources: vector.T(maybe.T(location.SourceMap))
        var staticData: maybe.T(StaticData)
        (* A phrase unit's (docs/jit.md section 3.2), compiled for the JIT *)
        var phrase: maybe.T(Phrase)
    end

    (* ======================================================================
     * Constructors, with the bootstrap's defaults
     * ====================================================================== *)

    newVar(hint: String t: Type isMutable: Bool): Variable
    newBody(): Body
    bodyOf(statements: Array(Stmt)): Body
    newStaticDescriptor(t: Type echo: Bool): StaticDescriptor
    newPlan(kind: PlanKind source: Type target: Type): Plan
    (* Whether plan p is of kind k *)
    planIs(p: Plan k: PlanKind): Bool
    newFunction(v: Variable typeParams: Array(TypeParam) params: Array(ParamEntry) resultType: Type body: Body
        traceName: maybe.T(String)): Function
    newMembers(): Members
    addMember(m: Members name: String v: Variable): Ok
    member(m: Members name: String): maybe.T(Variable)
    newModule(name: String interfaceName: String init: Body members: Members): Module
    newImport(name: String modulePath: String canonicalPath: String interfacePath: String recordType: maybe.T(Type)
        libPath: maybe.T(String)): Import
    newUnit(main: Body modules: vector.T(Module) imports: Array(Import) sourceMap: maybe.T(location.SourceMap)): Unit

    (* The offset in a unit of offset in its file numbered file: 0 for the
     * unit's own source, k + 1 for its kth merged one *)
    fileOffset(file: Int offset: Int): Int
    (* The site of a raise or a check at offset in unit u, as "file:line:col",
     * if its file is known *)
    site(u: Unit offset: Int): maybe.T(String)
    (* The position of offset in unit u, and the name of the unit's file
     * numbered file, if they are known *)
    sourcePos(u: Unit offset: Int): maybe.T(SourcePos)
    sourceFile(u: Unit file: Int): maybe.T(String)

    atomOfVar(v: Variable): Atom
    atomOfConst(c: Const): Atom
    opOfAtom(a: Atom): Op
    opOfVar(v: Variable): Op
    letStmt(v: Variable value: Op): Stmt

    (* Operations with their other fields at their defaults *)
    prim(op: Prim args: Array(Atom) offset: maybe.T(Int)): Op
    call(callee: maybe.T(Variable) typeArgs: Array(Type) args: Array(Atom) moduleRef: maybe.T(ModuleRef)
        member: maybe.T(String) calleeType: maybe.T(Type)): Op
    typeApp(callee: maybe.T(Variable) typeArgs: Array(Type) moduleRef: maybe.T(ModuleRef) member: maybe.T(String)
        calleeType: maybe.T(Type)): Op
    makeTuple(args: Array(Atom) typeComponents: Array(TypeComponent)): Op
    tupleField(tup: Atom index: Int): Op
    makeRecord(fields: Array(FieldAtom)): Op
    recordField(recordAtom: Atom name: String): Op
    makeOption(tag: maybe.T(String) payload: maybe.T(Atom) ordinalAtom: maybe.T(Atom) offset: maybe.T(Int)
        cases: Array(String)): Op
    isTag(value: Atom tag: String): Op
    payload(value: Atom tag: String offset: maybe.T(Int) ordinalIndex: maybe.T(Int)): Op
    ordinalOf(value: Atom cases: Array(String)): Op

    (* Statements with their other fields at their defaults *)
    switchStmt(value: Atom cases: Array(Case) elseBody: maybe.T(Body)): Stmt
    inspectStmt(value: Atom cases: Array(InspectCase) elseBody: maybe.T(Body) autoType: maybe.T(Type)
        offset: maybe.T(Int)): Stmt
    newCase(tags: Array(String) body: Body binder: maybe.T(Variable)): Case
    newInspectCase(matchType: Type binders: Array(Variable) body: Body exact: Bool): InspectCase

    (* ======================================================================
     * Queries
     * ====================================================================== *)

    same(a: Variable b: Variable): Bool
    (* The source position of a statement that makes code where it is (a let,
     * a store, a branch, a jump, a raise; not a loop, a try, a join point, or
     * functions, whose bodies have their own): an offset in the unit, as
     * fileOffset numbers it, or ~1 if unknown or not such a statement *)
    stmtPos(s: Stmt): Int
    (* Sets the position of such a statement s to pos if it has none *)
    positionAt(s: Stmt pos: Int): Ok
    isTerminator(s: Stmt): Bool
    terminated(b: Body): Bool
    (* The variable an atom is, if it is one *)
    atomVarOf(a: Atom): maybe.T(Variable)
    (* The type of an atom: a variable's, or a constant's shape's *)
    atomType(a: Atom): Type
    moduleRefName(r: ModuleRef): String
    sameModuleRef(a: ModuleRef b: ModuleRef): Bool
    (* Whether the unit is at the given stage or a later one *)
    atLeast(unit: Unit stage: String): Bool
end
