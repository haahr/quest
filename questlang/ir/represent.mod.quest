(* Quest Self-Hosted Compiler: Representation Implementation *)

module represent : Represent
import
    conv : Conv
    stringOp = string : StringOp
    word : Word

    collections/hashMap : collections/HashMap
    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe

    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/common/maps : questlang/common/Maps
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/slots : questlang/ir/Slots
    questlang/ir/stages : questlang/ir/Stages
    questlang/ir/walk : questlang/ir/Walk
    questlang/repr/genericLayout : questlang/repr/GenericLayout
    questlang/repr/layout : questlang/repr/Layout
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/repr/written : questlang/repr/Written
    questlang/types/model : questlang/types/Model
    questlang/types/subtyping : questlang/types/Subtyping
export
    Let Type = model.Type
    Let Shape = shapes.Shape
    Let Variable = nodes.Variable
    Let Atom = nodes.Atom
    Let Body = nodes.Body
    Let Stmt = nodes.Stmt
    Let Op = nodes.Op
    Let Plan = nodes.Plan
    Let Layout = maybe.T(nodes.PlanLayout)

    let unsupportedConversion: Exception(String) = exception unsupportedConversion: String end
    let rejectedConversion: Exception(String) = exception rejectedConversion: String end

    let unsupported(A::TYPE message: String): A = raise unsupportedConversion with message end

    let eq(a: String b: String): Bool = stringOp.equal(a b)
    let none: maybe.T(Plan) = maybe.none()
    let noLayout: Layout = maybe.none()
    let lookupNone = maybe.none(:model.Lookup)

    let some(p: Plan): maybe.T(Plan) = maybe.some(p)
    let newPlan(kind: nodes.PlanKind source: Type target: Type): maybe.T(Plan) = some(nodes.newPlan(kind source target))
    (* Whether there is a plan of kind k *)
    let isPlan(p: maybe.T(Plan) k: nodes.PlanKind): Bool = maybe.isSome(p) andif nodes.planIs(maybe.unwrap(p) k)
    (* Whether a plan boxes or unboxes, which changes no slot: a slot holds a
     * value's QVal form *)
    let boxing(p: maybe.T(Plan)): Bool = isPlan(p nodes.planBox) orif isPlan(p nodes.planUnbox)
    (* A polymorphic callee's type parameters' instantiation, its symbols in the
     * order they were bound *)
    Let Instantiation = Tuple subst: model.Subst keys: vector.T(Int) end

    let newInstantiation(): Instantiation = tuple let subst = model.newSubst() let keys = vector.new() end

    let bind(inst: Instantiation symbolId: Int t: Type): Ok =
        begin
            if not(hashMap.contains(inst.subst symbolId)) then vector.append(inst.keys symbolId) end
            hashMap.insert(inst.subst symbolId t)
            ok
        end

    let isEmpty(inst: Instantiation): Bool = hashMap.empty(inst.subst)

    let layoutOf(inst: Instantiation toGeneric: Bool): Layout =
        maybe.some(tuple let subst = inst.subst let keys = inst.keys let toGeneric = toGeneric end)
    let hasInstantiation(layout: Layout): Bool =
        maybe.isSome(layout) andif not(hashMap.empty(maybe.unwrap(layout).subst))

    let isFunctionKind(s: Shape): Bool = shapes.kindIs(s shapes.shapeFun) orif shapes.kindIs(s shapes.shapeAll)

    let typeOf(a: Atom): Type = nodes.atomType(a)

    let arrayElement(t: Type): Type =
        begin
            let element = written.arrayElement(t)
            if maybe.isNone(element) then unsupported(:Ok "an array operation on a value of type " <> model.show(t)) end
            maybe.unwrap(element)
        end

    (* Whether s is a module's abstract type's (or an abstract or path type's)
     * bounded by a record, variant, or option type, held viewed at its bound *)
    let boundedView(s: Shape): Bool = layout.heldAtBound(s) andif shapes.isViewedKind(layout.resolvedShape(s).kind)

    (* Whether s is a type parameter's bounded by a record, variant, option, or
     * tuple type, whose values are held at their own view *)
    let ownViewed(s: Shape): Bool =
        layout.ownView(s) andif {shapes.isViewedKind(layout.resolvedShape(s).kind)
            orif shapes.kindIs(layout.resolvedShape(s) shapes.shapeTuple)}

    let equal(a: Type b: Type): Bool = model.same(a b) orif subtyping.isTypeEqual(a b lookupNone)

    (* The type variables in each type met, by the type's id, while a unit is
     * represented: representUnit clears it, so that a process that compiles
     * many units (the REPL, the JIT, a driver build) does not keep every
     * type's *)
    let typeVarsMemo = maps.newIntMap(:Array(Type))

    (* The type variables t0 mentions, each once, in the order first met; a
     * subterm's are taken from typeVarsMemo when an earlier call found them *)
    let typeVars(t0: Type): Array(Type) =
        begin
            let found = vector.new(:Type)
            let foundIds = maps.newIntSet()
            let rec visit(p: model.Part): Ok =
                case p
                    when partType with x then
                        if x.t.form?typeVariable then
                            if not(hashSet.contains(foundIds x.t.id)) then
                                hashSet.insert(foundIds x.t.id)
                                vector.append(found x.t)
                            end
                        elsif extent x.t.fv > 0 then
                            let memo = hashMap.get(typeVarsMemo x.t.id)
                            if maybe.isSome(memo) then
                                let vars = maybe.unwrap(memo)
                                for i = 0 upto {extent vars - 1} do
                                    if not(hashSet.contains(foundIds vars[i].id)) then
                                        hashSet.insert(foundIds vars[i].id)
                                        vector.append(found vars[i])
                                    end
                                end
                            else
                                vector.forEach(model.typeParts(x.t) visit)
                            end
                        end
                    when partKind with x then
                        if extent x.k.fv > 0 then vector.forEach(model.kindParts(x.k) visit) end
                end
            visit(option partType of model.Part with let t = t0 end)
            let result = vector.toArray(found)
            hashMap.insert(typeVarsMemo t0.id result)
            result
        end

    (* Whether two equal types hold their type parameters at the same views *)
    let sameViews(a: Type b: Type): Bool =
        if {extent a.fv is 0} orif {extent b.fv is 0} then
            true
        else
            let bounds = maps.newIntMap(:maybe.T(model.Kind))
            let var same = true
            let vars = vector.fromArray(typeVars(a))
            let more = typeVars(b)
            for i = 0 upto {extent more - 1} do vector.append(vars more[i]) end
            for i = 0 upto {vector.length(vars) - 1} do
                case vector.get(vars i).form
                    when typeVariable with v then
                        let first = hashMap.get(bounds v.symbolId)
                        if maybe.isNone(first) then
                            begin hashMap.insert(bounds v.symbolId v.bound) ok end
                        else
                            let f = maybe.unwrap(first)
                            let agree =
                                if maybe.isNone(f) orif maybe.isNone(v.bound) then
                                    maybe.isNone(f) andif maybe.isNone(v.bound)
                                else
                                    model.sameKind(maybe.unwrap(f) maybe.unwrap(v.bound))
                                        orif subtyping.isKindEqual(maybe.unwrap(f) maybe.unwrap(v.bound) lookupNone)
                                end
                            if not(agree) then same := false end
                        end
                    else ok
                end
            end
            same
        end

    let caseNamed(cases: Array(shapes.Component) name: String): maybe.T(shapes.Component) =
        begin
            let var found = maybe.none(:shapes.Component)
            for i = {extent cases - 1} downto 0 do
                if eq(maybe.unwrapOr(cases[i].name "") name) then found := maybe.some(cases[i]) end
            end
            found
        end

    (* Whether every case of the variant shape s is a case of t, with an equal
     * payload *)
    let variantSubtype(s: Shape t: Shape): Bool =
        begin
            let var all = true
            for i = 0 upto {extent s.cases - 1} do
                let c = s.cases[i]
                let other = caseNamed(t.cases maybe.unwrapOr(c.name ""))
                if maybe.isNone(other) then
                    all := false
                else
                    let o = maybe.unwrap(other).shape
                    let same =
                        if maybe.isSome(c.shape) andif maybe.isSome(o)
                                andif shapes.same(maybe.unwrap(c.shape) maybe.unwrap(o)) then
                            true
                        elsif maybe.isNone(c.shape) orif maybe.isNone(o) then
                            maybe.isNone(c.shape) andif maybe.isNone(o)
                        else
                            subtyping.isTypeEqual(maybe.unwrap(c.shape).type maybe.unwrap(o).type lookupNone)
                        end
                    if not(same) then all := false end
                end
            end
            all
        end

    (* How a value passed to or returned from a polymorphic callee converts
     * between the callee's generic layout of its type and the native layout at
     * the call's type arguments *)
    let layoutPlan(source: Type target: Type lay: nodes.PlanLayout): maybe.T(Plan) =
        begin
            let genericType = if lay.toGeneric then target else source end
            let nativeType = model.substitute(genericType lay.subst)
            let genericShape = shapes.shape(genericType)
            let nativeShape = shapes.shape(nativeType)
            let genericC = layout.shapeRepresentation(genericShape)
            let nativeC = layout.shapeRepresentation(nativeShape)
            let isRecord = eq(genericC "QRecordVal") andif eq(nativeC "QRecordVal")
            let endsStar =
                fun(s: String): Bool
                    {
                    stringOp.length(s) > 0} andif {stringOp.getChar(s {stringOp.length(s) - 1}) is '*'}
            if isFunctionKind(genericShape) then
                none
            elsif not(isRecord) andif {not(endsStar(genericC)) orif not(endsStar(nativeC))} then
                none
            elsif genericLayout.genericLayoutAgrees(genericType lay.subst) then
                if eq(genericC nativeC) then none else newPlan(nodes.planCast source target) end
            elsif genericLayout.genericLayoutCopiesMutableData(genericType lay.subst) then
                raise rejectedConversion with
                    "Compiled code cannot pass a value of type '" <> model.show(nativeType)
                        <> "' to or from a polymorphic function that lays it out as '" <> model.show(genericType)
                        <> "': the layouts differ, and converting the value would copy mutable data, which would then "
                        <> "not share its updates"
                end
            else
                let p = nodes.newPlan(nodes.planRuntime source target)
                p.layout := maybe.some(lay)
                some(p)
            end
        end

    Def Shared = Tuple sParams: Array(model.Param) sResult: Type tParams: Array(model.Param) tResult: Type end

    (* Two function types' parameters and results as written, target's type
     * parameters renamed to source's *)
    let sharedSignatures(source: Type target: Type): Shared =
        begin
            let s = written.quantified(source)
            let t = written.quantified(target)
            let var tInner = t.body
            if {extent s.quantifiers > 0} andif {extent s.quantifiers is extent t.quantifiers} then
                let renamed = model.newSubst()
                for i = 0 upto {extent s.quantifiers - 1} do
                    let sq = s.quantifiers[i]
                    hashMap.insert(renamed t.quantifiers[i].symbolId
                            model.typeVariable(sq.name sq.symbolId maybe.some(sq.bound)))
                end
                let subst = model.newSubst()
                for i = 0 upto {extent s.quantifiers - 1} do
                    let sq = s.quantifiers[i]
                    let var bound = model.substituteInKind(t.quantifiers[i].bound renamed)
                    if subtyping.isKindEqual(bound sq.bound lookupNone) then bound := sq.bound end
                    hashMap.insert(subst t.quantifiers[i].symbolId
                            model.typeVariable(sq.name sq.symbolId maybe.some(bound)))
                end
                tInner := model.substitute(tInner subst)
            end
            let params =
                fun(inner: Type): Array(model.Param)
                    case inner.form when typeFun with x then x.params else array of :model.Param end end
            let result = fun(inner: Type): Type case inner.form when typeFun with x then x.result else inner end
            tuple
                let sParams = params(s.body)
                let sResult = result(s.body)
                let tParams = params(tInner)
                let tResult = result(tInner)
            end
        end

    (* Whether each of an adapter's fields converts nothing, or only boxes or
     * unboxes between a QVal and a pointer (no record, variant, or scalar),
     * which change nothing where the two are held alike *)
    let referencesOnly(fields: Array(maybe.T(Plan))): Bool =
        begin
            let held = fun(t: Type): Bool
                case layout.representationKind(t) when repPointer, repQVal then true else false end
            let var only = true
            for i = 0 upto extent fields - 1 do
                if maybe.isSome(fields[i]) then
                    let p = maybe.unwrap(fields[i])
                    if not(boxing(fields[i]) andif held(p.source) andif held(p.target)) then only := false end
                end
            end
            only
        end

    (* The pairs of shapes being planned (with their layouts), and of function
     * types being adapted, for recursive types, which are compared
     * coinductively *)
    let planning = maps.newStringSet()
    let adapting = maps.newStringSet()

    (* Returns lay's contribution to a planning key: "-" for none, or its
     * substitution's object identity and direction. Identity suffices because
     * the key only distinguishes layouts of plans currently in progress, whose
     * substitutions are live, distinct objects (a nested plan forwards its
     * layout unchanged, so a recursive type meets the same substitution
     * again). *)
    let layoutKey(lay: Layout): String =
        if maybe.isNone(lay) then
            "-"
        else
            let l = maybe.unwrap(lay)
            conv.int(word.toInt(hash.identityHash(l.subst))) <> if l.toGeneric then "t" else "f" end
        end

    (* Returns the plan converting a value of type source for use at type
     * target, or none if it serves as it is, decided from the two types'
     * shapes and their C representations.
     *
     * A shape is a type reduced to what decides how C holds its values
     * (repr/shapes), its representation: an Int as an int64_t, a tuple as a
     * pointer to its struct, and so on. A view is the type a value's layout is
     * read at, which a record, variant, or option seen at a supertype may
     * change, and a proxy is a small object that shows a tuple or option at
     * another view (docs/c-representation.md section 5.8).
     *
     * planInner and viewPlan test cases in order, and the first that applies
     * decides:
     *
     * 1. Ok on either side: nothing to convert.
     * 2. An applied abstract type operator crossing between its module's
     *    generic layout and its concrete representation: abstractPlan.
     * 3. A function type on each side: adaptPlan, which wraps the closure in
     *    a thunk if its C signature, or an argument or result, changes.
     * 4. A value passed to or returned from a polymorphic callee (lay given)
     *    whose generic layout there differs from its layout at the call's
     *    type arguments: layoutPlan. (If that finds nothing to do but either
     *    side is a module's abstract type held at its bound, the tests go
     *    on.)
     * 5. Into or out of a QVal, the one word in which generic code holds an
     *    unbounded type parameter's values: box or unbox. A call id(:Int 2) of
     *    id(A::TYPE x: A): A, not specialized, boxes 2 and unboxes the result.
     *    Both QVals, or equal types at the same views: nothing.
     * 6. A type parameter bounded by a record, variant, option, or tuple type,
     *    whose values are held at their own view, their type argument's: view,
     *    converted at run time between the two types' descriptors. The same
     *    parameter on both sides needs nothing.
     * 7. Records: record_view, since a record seen at a supertype has another
     *    table of field offsets (docs/c-representation.md section 5.2).
     * 8. Variants: nothing if both number the cases alike and no payload
     *    changes view; variant_tags to renumber a subtype's tags; otherwise
     *    view.
     * 9. Options: nothing, or a cast between C types, if their cases agree;
     *    otherwise a view, a proxy of the original.
     * 10. Tuples: nothing, or a cast, if no component changes but by boxing;
     *     otherwise a view (a proxy). A tuple cannot gain components.
     * 11. The same representation (but for functions, options, and arrays),
     *     or arrays whose elements need at most boxing either way: nothing.
     *
     * Anything else raises unsupportedConversion, rather than leave the C
     * printer to print it wrong. A pair met again while it is being planned (a
     * recursive type's component) needs nothing of its own, and a cast to a
     * tuple or option type that cannot be a proxy, from one that may be,
     * becomes unproxy (unproxied). *)
    let rec plan(source: Type target: Type lay: Layout): maybe.T(Plan) =
        if model.same(source target) then
            none
        (* Types of one shape have one representation (a transparent abstract
         * type's and its representation's, in a whole program), but at an
         * instantiation, whose generic and native layouts may differ *)
        elsif shapes.transparentAbstractTypes() andif not(hasInstantiation(lay))
                andif {shapes.shape(source).id is shapes.shape(target).id} then
            none
        else
            let key =
                conv.int(shapes.shape(source).id) <> "," <> conv.int(shapes.shape(target).id) <> "," <> layoutKey(lay)
            if hashSet.contains(planning key) then
                (* A pair being planned (a recursive type's component): needs no
                 * conversion of its own *)
                none
            else
                hashSet.insert(planning key)
                let result = unproxied(planInner(source target lay))
                hashSet.delete(planning key)
                result
            end
        end

    (* p, or for a cast from a tuple or option type that may be proxied to one
     * that may not, an unproxy plan *)
    and unproxied(p: maybe.T(Plan)): maybe.T(Plan) =
        if not(isPlan(p nodes.planCast)) then
            p
        else
            let x = maybe.unwrap(p)
            let ss = layout.resolvedShape(shapes.shape(x.source))
            let ts = layout.resolvedShape(shapes.shape(x.target))
            if {shapes.kindIs(ts shapes.shapeTuple) orif shapes.kindIs(ts shapes.shapeOption)}
                    andif layout.mayBeProxied(ss) andif not(layout.mayBeProxied(ts)) then
                newPlan(nodes.planUnproxy x.source x.target)
            else
                p
            end
        end

    (* How a closure of type source is used at type target: as it is, or wrapped
     * in a thunk of target's signature *)
    and adaptPlan(source: Type target: Type lay: Layout): maybe.T(Plan) =
        if equal(source target) andif not(hasInstantiation(lay)) then
            none
        else
            let toGeneric = maybe.isSome(lay) andif maybe.unwrap(lay).toGeneric
            let key = conv.int(shapes.shape(source).id) <> "," <> conv.int(shapes.shape(target).id) <> ","
                <> if toGeneric then "t" else "f" end
            if hashSet.contains(adapting key) then
                none
            else
                let shared = sharedSignatures(source target)
                if extent shared.sParams isnot extent shared.tParams then
                    unsupported(:Ok "converting a function of type " <> model.show(source) <> " to "
                        <> model.show(target))
                end
                let flipped =
                    if maybe.isSome(lay) then
                        let l = maybe.unwrap(lay)
                        layoutOf(tuple let subst = l.subst let keys = l.keys end not(l.toGeneric))
                    else
                        noLayout
                    end
                hashSet.insert(adapting key)
                let fields = array of({extent shared.sParams + 1} none)
                for i = 0 upto {extent shared.sParams - 1} do
                    let tp = shared.tParams[i]
                    fields[i] :=
                        if tp.isVar orif tp.isOut then none else plan(tp.type shared.sParams[i].type flipped) end
                end
                fields[extent shared.sParams] := plan(shared.sResult shared.tResult lay)
                hashSet.delete(adapting key)
                let var allNone = true
                for i = 0 upto {extent fields - 1} do if maybe.isSome(fields[i]) then allNone := false end end
                if allNone
                        andif eq(genericLayout.signatureRepresentation(source)
                                genericLayout.signatureRepresentation(target)) then
                    none
                elsif shapes.referencesAlike() andif referencesOnly(fields)
                        andif {extent written.quantified(source).quantifiers
                                is extent written.quantified(target).quantifiers} then
                    (* Where a reference and a QVal are held alike, a closure
                     * whose parts are only boxed or unboxed between the two
                     * has target's signature already: its callers call it as
                     * it is, at no adapter's cost *)
                    none
                else
                    (* The thunk takes target's type parameters, which the
                     * fields' types name by source's symbols or target's own *)
                    let sQuants = written.quantified(source).quantifiers
                    let tQuants = written.quantified(target).quantifiers
                    let thunkSymbols = array of(extent tQuants array of :Int end)
                    for k = 0 upto {extent tQuants - 1} do
                        thunkSymbols[k] :=
                            if k < extent sQuants then array of tQuants[k].symbolId sQuants[k].symbolId end
                            else array of tQuants[k].symbolId end
                            end
                    end
                    let p = nodes.newPlan(nodes.planAdapt source target)
                    p.fields := fields
                    p.layout := lay
                    p.thunkSymbols := thunkSymbols
                    some(p)
                end
            end
        end

    and planInner(source: Type target: Type lay: Layout): maybe.T(Plan) =
        begin
            let ss = shapes.shape(source)
            let ts = shapes.shape(target)
            if shapes.kindIs(ss shapes.shapeOk) orif shapes.kindIs(ts shapes.shapeOk) then
                none
            else
                let cs = layout.shapeRepresentation(ss)
                let ct = layout.shapeRepresentation(ts)
                let abstract = abstractPlan(source target ss ts cs ct)
                if maybe.isSome(abstract) then
                    maybe.unwrap(abstract)
                elsif not(eq(cs "QVal")) andif not(eq(ct "QVal")) andif isFunctionKind(ss) andif isFunctionKind(ts) then
                    adaptPlan(source target lay)
                else
                    let laid =
                        if hasInstantiation(lay) andif not(eq(cs "QVal")) andif not(eq(ct "QVal")) then
                            let lp = layoutPlan(source target maybe.unwrap(lay))
                            (* A module's abstract type's value is held viewed at
                             * its bound, whatever the layouts *)
                            if maybe.isSome(lp) orif not(boundedView(ss) orif boundedView(ts)) then maybe.some(lp)
                            else maybe.none(:maybe.T(Plan))
                            end
                        else
                            maybe.none(:maybe.T(Plan))
                        end
                    if maybe.isSome(laid) then
                        maybe.unwrap(laid)
                    else
                        viewPlan(source target ss ts cs ct)
                    end
                end
            end
        end

    (* Plans conversion between an applied abstract type operator (laid out
     * outside its module in the module's generic layout) and its concrete
     * representation inside the module at the same type arguments
     * (docs/c-representation.md section 5.1). Returns a runtime view plan when
     * the two layouts differ (or raises rejectedConversion if that would copy
     * mutable data), and none so later tests run when the layouts agree or the
     * other side is not the native representation. *)
    and abstractPlan(source: Type target: Type ss: Shape ts: Shape cs: String ct: String): maybe.T(maybe.T(Plan)) =
        begin
            let toGeneric = shapes.kindIs(ts shapes.shapeAbstract)
            let abstractT = if toGeneric then target else source end
            let nativeT = if toGeneric then source else target end
            let nativeC = if toGeneric then cs else ct end
            let instance =
                if {shapes.kindIs(ss shapes.shapeAbstract) is toGeneric} orif eq(nativeC "QVal") then
                    maybe.none(:genericLayout.AbstractInstance)
                else
                    genericLayout.abstractInstance(abstractT)
                end
            if maybe.isNone(instance) then
                maybe.none()
            else
                let i = maybe.unwrap(instance)
                if genericLayout.genericLayoutAgrees(i.generic i.subst)
                        orif not(equal(model.substitute(i.generic i.subst) nativeT)) then
                    maybe.none()
                elsif genericLayout.genericLayoutCopiesMutableData(i.generic i.subst) then
                    raise rejectedConversion with
                        "Compiled code cannot convert a value of type '" <> model.show(abstractT)
                            <> "' between its module's layout of it and its own: the layouts differ, and converting "
                            <> "the value would copy mutable data, which would then not share its updates"
                    end
                else
                    let inst = newInstantiation()
                    hashMap.forEach(i.subst fun(k: Int t: Type): Ok bind(inst k t))
                    let p = nodes.newPlan(nodes.planView source target)
                    p.layout := layoutOf(inst toGeneric)
                    maybe.some(some(p))
                end
            end
        end

    (* The plan from source to target, of shapes ss and ts and C
     * representations cs and ct, by plan's tests 5 to 11 (boxing, bounded
     * type parameters' views, records, variants, options, tuples, and the
     * rest), where neither a function's adapter nor a polymorphic callee's
     * layout decided it *)
    and viewPlan(source: Type target: Type ss: Shape ts: Shape cs: String ct: String): maybe.T(Plan) =
        (* A value of a type parameter, held as a QVal word: a scalar or pointer
         * in its bits, a record or variant boxed *)
        if eq(ct "QVal") andif not(eq(cs "QVal")) then
            newPlan(nodes.planBox source target)
        elsif eq(cs "QVal") andif not(eq(ct "QVal")) then
            newPlan(nodes.planUnbox source target)
        elsif eq(cs "QVal") orif {equal(source target) andif sameViews(source target)} then
            none
        elsif layout.ownView(ss) andif layout.ownView(ts) andif {ss.symbolId is ts.symbolId} then
            (* One type parameter, at whatever bounds: its values are held at
             * their own view either way *)
            none
        elsif ownViewed(ss) orif ownViewed(ts) then
            (* A bounded type parameter's value is held at its own view: used at
             * another type, it is converted by the runtime between the two
             * types' descriptors *)
            newPlan(nodes.planView source target)
        else
            let sHeld = layout.resolvedShape(ss)
            let tHeld = layout.resolvedShape(ts)
            if shapes.kindIs(sHeld shapes.shapeRecord) andif shapes.kindIs(tHeld shapes.shapeRecord) then
                if equal(sHeld.type tHeld.type) then none else newPlan(nodes.planRecordView source target) end
            elsif shapes.kindIs(sHeld shapes.shapeVariant) andif shapes.kindIs(tHeld shapes.shapeVariant) then
                let var sameIndices = true
                for i = 0 upto {extent sHeld.cases - 1} do
                    let name = maybe.unwrapOr(sHeld.cases[i].name "")
                    let var index = ~1
                    for j = {extent tHeld.cases - 1} downto 0 do
                        if eq(maybe.unwrapOr(tHeld.cases[j].name "") name) then index := j end
                    end
                    if index isnot i then sameIndices := false end
                end
                if sameIndices then
                    if not(variantPayloadsChange(sHeld tHeld)) then none
                    (* A payload changes view: converted by the runtime, which
                     * converts the payload *)
                    else newPlan(nodes.planView sHeld.structure tHeld.structure)
                    end
                elsif variantSubtype(sHeld tHeld) then
                    newPlan(nodes.planVariantTags source target)
                else
                    (* From a bounded type parameter's view at its bound back to
                     * the type the caller holds it at *)
                    newPlan(nodes.planView sHeld.structure tHeld.structure)
                end
            elsif shapes.kindIs(sHeld shapes.shapeOption) andif shapes.kindIs(tHeld shapes.shapeOption) andif eq(cs ct)
                    andif equal(sHeld.type tHeld.type) andif not(boundedView(ss) orif boundedView(ts)) then
                (* Equal option types spelled otherwise (an option of an alias,
                 * and of the type it names): one representation, nothing to
                 * convert *)
                none
            elsif shapes.kindIs(sHeld shapes.shapeOption) andif shapes.kindIs(tHeld shapes.shapeOption)
                    andif not(equal(sHeld.type tHeld.type)) then
                if not(boundedView(ss) orif boundedView(ts)) andif optionCasesAgree(sHeld tHeld) then
                    if eq(cs ct) then none else newPlan(nodes.planCast source target) end
                else
                    (* A proxy (made by the runtime, between the two views'
                     * descriptors) *)
                    newPlan(nodes.planView sHeld.structure tHeld.structure)
                end
            elsif shapes.kindIs(sHeld shapes.shapeTuple) andif shapes.kindIs(tHeld shapes.shapeTuple)
                    andif layout.heldAtBound(ss) andif not(layout.heldAtBound(ts))
                    andif {extent sHeld.components < extent tHeld.components} then
                (* A module's abstract type's value, held at its tuple bound,
                 * back at its representation, a wider tuple: the module made
                 * it, so it is one, or a proxy of one *)
                if layout.mayBeProxied(sHeld) then newPlan(nodes.planUnproxy source target)
                else newPlan(nodes.planCast source target)
                end
            elsif shapes.kindIs(sHeld shapes.shapeTuple) andif shapes.kindIs(tHeld shapes.shapeTuple) then
                let ss = sHeld
                let ts = tHeld
                if extent ss.components < extent ts.components then
                    unsupported("converting a tuple of type " <> model.show(source) <> " to " <> model.show(target))
                else
                    let var changing = false
                    for i = 0 upto {extent ts.components - 1} do
                        let p =
                            plan(shapes.componentShape(ss.components[i]).type
                                    shapes.componentShape(ts.components[i]).type noLayout)
                        (* A box or unbox changes no slot: a slot holds a
                         * value's QVal form *)
                        if maybe.isSome(p) andif not(boxing(p)) then
                            changing := true
                        end
                    end
                    if not(changing) then
                        if eq(cs ct) then none else newPlan(nodes.planCast source target) end
                    else
                        (* Components change view: a proxy of the tuple, which
                         * converts them as they are read *)
                        newPlan(nodes.planView source target)
                    end
                end
            elsif eq(cs ct) andif not(isFunctionKind(ts) orif shapes.kindIs(ts shapes.shapeOption)
                    orif shapes.kindIs(ts shapes.shapeArray)) then
                none
            else
                let arrayServes =
                    if shapes.kindIs(ss shapes.shapeArray) andif shapes.kindIs(ts shapes.shapeArray)
                            andif eq(cs ct) then
                        (* An array is shared and assigned through, so its elements
                         * cannot change view: it serves as it is when they need no
                         * conversion either way, or only a box or unbox *)
                        let there = plan(shapes.element(ss).type shapes.element(ts).type noLayout)
                        let back = plan(shapes.element(ts).type shapes.element(ss).type noLayout)
                        let fine = fun(p: maybe.T(Plan)): Bool maybe.isNone(p) orif boxing(p)
                        fine(there) andif fine(back)
                    else
                        false
                    end
                if arrayServes then
                    none
                else
                    unsupported("converting a value of type " <> model.show(source) <> " (" <> cs <> ") to "
                        <> model.show(target) <> " (" <> ct <> ")")
                end
            end
        end

    (* Whether a payload of a variant of shape s changes representation as one
     * of t's *)
    and variantPayloadsChange(s: Shape t: Shape): Bool =
        begin
            let var changes = false
            for i = 0 upto {extent s.cases - 1} do
                let c = s.cases[i]
                let other = caseNamed(t.cases maybe.unwrapOr(c.name ""))
                if maybe.isSome(c.shape) andif maybe.isSome(other)
                        andif maybe.isSome(maybe.unwrap(other).shape) then
                    let p = plan(maybe.unwrap(c.shape).type maybe.unwrap(maybe.unwrap(other).shape).type noLayout)
                    if maybe.isSome(p) andif not(boxing(p)) then
                        changes := true
                    end
                end
            end
            changes
        end

    (* Whether an option of shape s is laid out as one of shape t: each of its
     * cases has the same index in t, with a payload that converts by a cast at
     * most *)
    and optionCasesAgree(s: Shape t: Shape): Bool =
        begin
            let var agree = true
            for i = 0 upto {extent s.cases - 1} do
                let c = s.cases[i]
                if {i >= extent t.cases} orif not(eq(maybe.unwrapOr(t.cases[i].name "") maybe.unwrapOr(c.name ""))) then
                    agree := false
                else
                    let tc = t.cases[i]
                    if maybe.isNone(c.shape) isnot maybe.isNone(tc.shape) then
                        agree := false
                    elsif maybe.isSome(c.shape) andif agree then
                        let p = plan(maybe.unwrap(c.shape).type maybe.unwrap(tc.shape).type noLayout)
                        if maybe.isSome(p) andif not(isPlan(p nodes.planCast)) then agree := false end
                    end
                end
            end
            agree
        end

    (* Whether t is the type variable (or abstract type) of the symbol *)
    let isTypeVariable(t: Type symbolId: Int): Bool =
        case shapes.shape(t).type.form
            when typeVariable with x then x.symbolId is symbolId
            when typeAbstract with x then x.symbolId is symbolId
            else false
        end

    (* Whether a slot of shape source holds its value as a slot of shape target
     * does *)
    let slotsAgree(source: Shape target: Shape): Bool =
        begin
            let sc = layout.shapeSlotRepresentation(source)
            let tc = layout.shapeSlotRepresentation(target)
            eq(sc tc) orif {eq(tc "QVal") andif not(eq(sc "void"))}
        end

    Def AutoParts = Tuple symbolId: Int signature: Array(model.RecordField) end

    let autoParts(t: Type): AutoParts =
        case t.form
            when typeAuto with x then tuple let symbolId = x.symbolId let signature = x.signature end
            else unsupported("not an auto type: " <> model.show(t))
        end

    (* How an auto value's components are stored, in the auto type's
     * witness-independent layout *)
    let autoPayloadPlan(payloadType: Type storedType: Type autoType: Type): maybe.T(Plan) =
        begin
            let a = autoParts(autoType)
            let source = shapes.shape(payloadType).components
            let target = shapes.shape(storedType).components
            let n = if extent source < extent target then extent source else extent target end
            let count = if extent a.signature < n then extent a.signature else n end
            let fields = array of(count none)
            for i = 0 upto {count - 1} do
                let sc = shapes.componentShape(source[i])
                let tc = shapes.componentShape(target[i])
                fields[i] := if isTypeVariable(a.signature[i].type a.symbolId) andif slotsAgree(sc tc) then none
                    else plan(sc.type tc.type noLayout) end
            end
            let var allNone = true
            for i = 0 upto {count - 1} do if maybe.isSome(fields[i]) then allNone := false end end
            let var allAgree = true
            for i = 0 upto {n - 1} do
                if not(slotsAgree(shapes.componentShape(source[i]) shapes.componentShape(target[i]))) then
                    allAgree := false
                end
            end
            if allNone andif allAgree then
                if eq(layout.shapeRepresentation(shapes.shape(payloadType))
                        layout.shapeRepresentation(shapes.shape(storedType))) then
                    none
                else
                    unproxied(newPlan(nodes.planCast payloadType storedType))
                end
            else
                let payloadShape = shapes.shape(payloadType)
                let access = array of(count nodes.direct)
                for i = 0 upto {count - 1} do access[i] := slots.tupleAccess(payloadShape i false) end
                let p = nodes.newPlan(nodes.planCopy payloadType storedType)
                p.fields := fields
                p.access := access
                some(p)
            end
        end

    (* Whether an auto value's stored payload can be read in place as an inspect
     * case's components *)
    let autoLayoutsAgree(storedType: Type armType: Type): Bool =
        begin
            let stored = shapes.shape(storedType).components
            let arm = shapes.shape(armType).components
            let var agree = true
            for i = 0 upto {extent stored - 1} do
                if i < extent arm then
                    let storedShape = shapes.componentShape(stored[i])
                    let armShape = shapes.componentShape(arm[i])
                    let storedC = layout.shapeSlotRepresentation(storedShape)
                    let armC = layout.shapeSlotRepresentation(armShape)
                    if eq(storedC armC) then
                        if isFunctionKind(armShape)
                                andif not(eq(genericLayout.signatureRepresentation(storedShape.type)
                                        genericLayout.signatureRepresentation(armShape.type))) then
                            agree := false
                        end
                    elsif not(eq(storedC "QVal")) orif eq(armC "void") then
                        agree := false
                    end
                end
            end
            agree
        end

    (* How an inspect case of an auto value of type autoType obtains its
     * components *)
    let inspectArm(autoType: Type c: nodes.InspectCase): nodes.InspectArm =
        begin
            let a = autoParts(autoType)
            let storedType = model.autoPayloadType(autoType maybe.none())
            let armType = model.autoPayloadType(autoType maybe.some(c.matchType))
            let var hasVar = false
            for i = 0 upto {extent a.signature - 1} do if a.signature[i].isVar then hasVar := true end end
            let converted = array of(extent a.signature maybe.none(:String))
            for i = 0 upto {extent a.signature - 1} do
                let t = a.signature[i].type
                let var mentions = false
                for j = 0 upto {extent t.fv - 1} do if t.fv[j] is a.symbolId then mentions := true end end
                converted[i] := if not(mentions) then maybe.none()
                    elsif isTypeVariable(t a.symbolId) then maybe.some("component")
                    else maybe.some("mentions") end
            end
            if not(c.exact) then
                tuple
                    let converted = converted
                    let exact = false
                    let shared = false
                    let plan = none
                    let layoutError = false
                    let var descriptors = array of :maybe.T(nodes.DescriptorPair) end
                end
            else
                let shared = autoLayoutsAgree(storedType armType)
                if not(shared) andif hasVar then
                    unsupported(:Ok "Compiled code cannot inspect an auto value of type '" <> model.show(autoType)
                        <> "' at type '" <> model.show(c.matchType) <> "': its components need conversion, so the var "
                        <> "components could not be shared with the auto value")
                end
                tuple
                    let converted = converted
                    let exact = true
                    let shared = shared
                    let plan = if shared then none else plan(storedType armType noLayout) end
                    let layoutError = hasVar
                    let var descriptors = array of :maybe.T(nodes.DescriptorPair) end
                end
            end
        end

    Def TypeAppPlans = Tuple plans: Array(maybe.T(Plan)) thunkSymbols: Array(Array(Int)) end

    (* How a polymorphic value of type origType applied to the type arguments is
     * used at targetType *)
    let typeAppPlans(origType: Type typeArgs: Array(Type) targetType: Type): TypeAppPlans =
        begin
            let q = written.quantified(origType)
            let instantiation = newInstantiation()
            for i = 0 upto {extent q.quantifiers - 1} do
                if i < extent typeArgs then bind(instantiation q.quantifiers[i].symbolId typeArgs[i]) end
            end
            case q.body.form
                when typeFun with inner then
                    let t = written.quantified(targetType)
                    let var k = 0
                    for i = extent typeArgs upto {extent q.quantifiers - 1} do
                        if k < extent t.quantifiers then
                            let tq = t.quantifiers[k]
                            bind(instantiation q.quantifiers[i].symbolId
                                    model.typeVariable(tq.name tq.symbolId maybe.some(tq.bound)))
                        end
                        k := k + 1
                    end
                    let tParams = case t.body.form when typeFun with x then x.params else array of :model.Param end end
                    let tResult = case t.body.form when typeFun with x then x.result else t.body end
                    let n = if extent tParams < extent inner.params then extent tParams else extent inner.params end
                    let plans = array of({n + 1} none)
                    for i = 0 upto {n - 1} do
                        let tp = tParams[i]
                        plans[i] := if tp.isVar orif tp.isOut then none
                            else plan(tp.type inner.params[i].type layoutOf(instantiation true)) end
                    end
                    plans[n] := plan(inner.result tResult layoutOf(instantiation false))
                    let symbols = array of(extent t.quantifiers array of :Int end)
                    for i = 0 upto {extent t.quantifiers - 1} do
                        symbols[i] := array of t.quantifiers[i].symbolId end
                    end
                    tuple let plans = plans let thunkSymbols = symbols end
                else
                    tuple
                        let plans = array of plan(q.body targetType layoutOf(instantiation false)) end
                        let thunkSymbols = array of :Array(Int) end
                    end
            end
        end

    (* ======================================================================
     * The pass
     * ====================================================================== *)

    (* A polymorphic call's result, which comes in the callee's generic
     * layout: the callee's result type as written (generic), that type at the
     * call's type arguments (instantiated), and the instantiation, by which
     * statement converts the result from the one to the other *)
    Def GenericResult = Tuple generic: Type instantiated: Type instantiation: Instantiation end

    (* The pass's state: joins, each join point's parameters by label, for
     * the jumps to it, which pass their arguments at the parameters' types;
     * and genericResults, which call leaves empty, or holding the
     * GenericResult of the polymorphic call it converted, for statement *)
    Let Representer = Tuple
        unit: nodes.Unit
        joins: maps.StringMap(Array(Variable))
        var genericResults: vector.T(GenericResult)
        (* The position of the statement being represented, or of the nearest
         * before it that has one, in its function or initializer *)
        var pos: Int
    end

    let convertOp(a: Atom p: Plan): Op = option opConvert of Op with let var value = a let var plan = p end

    let letConvert(v: Variable a: Atom p: Plan): Stmt = nodes.letStmt(v convertOp(a p))

    (* a, converted to be used at target (by a let added to before), or a
     * itself *)
    let convert(a: Atom target: Type before: vector.T(Stmt) lay: Layout): Atom =
        begin
            let p = plan(typeOf(a) target lay)
            if maybe.isNone(p) then
                a
            else
                let hint = case a when atomVar with x then x.v.hint else "" end
                let converted = nodes.newVar(hint target false)
                vector.append(before letConvert(converted a maybe.unwrap(p)))
                nodes.atomOfVar(converted)
            end
        end

    let convertAll(atoms: Array(Atom) types: Array(Type) before: vector.T(Stmt)): Array(Atom) =
        begin
            let result = vector.new(:Atom)
            for i = 0 upto {extent atoms - 1} do
                vector.append(result if i < extent types then
                    convert(atoms[i] types[i] before noLayout)
                else
                    atoms[i]
                end)
            end
            vector.toArray(result)
        end

    (* Converts the result of a let's operation, of type resultType, to its
     * variable's type *)
    let result(s: nodes.StmtLet resultType: Type after: vector.T(Stmt)): Ok =
        begin
            let p = plan(resultType s.v.type noLayout)
            if maybe.isSome(p) then
                let r = nodes.newVar(s.v.hint resultType false)
                vector.append(after letConvert(s.v nodes.atomOfVar(r) maybe.unwrap(p)))
                s.v := r
            end
        end

    let memberType(m: nodes.Module name: String): Type = hashMap.find(m.members.vars name).type

    (* The address passed for a var or out argument: the location's own, or that
     * of a temporary of the parameter's representation, copied in from the
     * location (for var) and out to it after the call *)
    let refArgument(address: Atom param: model.Param instantiation: Instantiation before: vector.T(Stmt)
            after: vector.T(Stmt)): Atom =
        begin
            let locationType =
                case typeOf(address).form
                    when typeVar with x then x.element
                    when typeOut with x then x.element
                    else typeOf(address)
                end
            let paramType = param.type
            let instantiated = not(isEmpty(instantiation))
            let pOut = plan(paramType locationType if instantiated then layoutOf(instantiation false) else noLayout end)
            (* An out argument whose location is the generic parameter at its
             * instantiation (an Int for A at Int) starts from the location's
             * value in the parameter's layout, as a var argument does, so
             * that a callee that assigns nothing leaves the location as it
             * was *)
            let keeps = param.isOut andif instantiated andif maybe.isSome(pOut)
                andif equal(locationType model.substitute(paramType instantiation.subst))
            let inLayout = if instantiated then layoutOf(instantiation true) else noLayout end
            let pIn = if param.isOut andif not(keeps) then none else plan(locationType paramType inLayout) end
            if maybe.isNone(pOut) andif maybe.isNone(pIn) then
                address
            else
                let refType = if param.isOut then model.outType(paramType) else model.varType(paramType) end
                let boxOrNone = fun(p: maybe.T(Plan)): Bool maybe.isNone(p) orif boxing(p)
                if layout.isBoxedInSlots(shapes.shape(locationType)) andif layout.isQVal(shapes.shape(paramType))
                        andif boxOrNone(pIn) andif boxOrNone(pOut) then
                    (* The location holds the record or variant boxed, as the
                     * generic parameter's QVal does *)
                    let cast = nodes.newVar("" refType false)
                    let castPlan = nodes.newPlan(nodes.planCast typeOf(address) refType)
                    vector.append(before letConvert(cast address castPlan))
                    nodes.atomOfVar(cast)
                else
                    let temp = nodes.newVar("cell" paramType true)
                    let tempAddress = nodes.newVar("" refType false)
                    let var init = maybe.none(:Atom)
                    if not(param.isOut) orif keeps then
                        let current = nodes.newVar("" locationType false)
                        vector.append(before
                                nodes.letStmt(current option opLoad of Op with let var address = address end))
                        init := maybe.some(nodes.atomOfVar(current))
                        if maybe.isSome(pIn) then
                            let converted = nodes.newVar("" paramType false)
                            vector.append(before letConvert(converted nodes.atomOfVar(current) maybe.unwrap(pIn)))
                            init := maybe.some(nodes.atomOfVar(converted))
                        end
                    end
                    vector.append(before option sVarDecl of Stmt with
                        let var pos = ~1
                        let var v = temp
                        let var init = init
                    end)
                    vector.append(before nodes.letStmt(tempAddress option opAddrVar of Op with let var v = temp end))
                    (* An out argument's cell without a value (one whose
                     * location is a supertype laid out differently) is
                     * written back only if the callee assigned it: a callee
                     * that assigns nothing leaves the location as it was *)
                    let writeback = nodes.newBody()
                    let var written = nodes.newVar("" paramType false)
                    vector.append(writeback.statements nodes.letStmt(written nodes.opOfVar(temp)))
                    if maybe.isSome(pOut) then
                        let converted = nodes.newVar("" locationType false)
                        vector.append(writeback.statements
                                letConvert(converted nodes.atomOfVar(written) maybe.unwrap(pOut)))
                        written := converted
                    end
                    vector.append(writeback.statements option sStoreAt of Stmt with
                        let var pos = ~1
                        let var value = nodes.atomOfVar(written)
                        let var address = address
                    end)
                    if maybe.isSome(init) then
                        for i = 0 upto {vector.length(writeback.statements) - 1} do
                            vector.append(after vector.get(writeback.statements i))
                        end
                    else
                        let set = nodes.newVar("" model.boolType false)
                        vector.append(after nodes.letStmt(set option opIsSet of Op with let var v = temp end))
                        vector.append(after option sIf of Stmt with
                            let var pos = ~1
                            let var cond = nodes.atomOfVar(set)
                            let var thenBody = writeback
                            let var elseBody = nodes.newBody()
                        end)
                    end
                    nodes.atomOfVar(tempAddress)
                end
            end
        end

    (* Converts a call's arguments to its callee's parameter types, returning
     * its callee's result type *)
    let call(r: Representer c: nodes.OpCall before: vector.T(Stmt) after: vector.T(Stmt)): Type =
        begin
            r.genericResults := vector.new()
            let calleeType =
                if maybe.isSome(c.callee) then
                    maybe.some(maybe.unwrap(c.callee).type)
                else
                    let fromModule =
                        if maybe.isSome(c.moduleRef) then
                            case maybe.unwrap(c.moduleRef)
                                (* A member of one of the unit's modules, called from
                                 * outside it at its interface's types, works at the
                                 * module's own: its arguments and result convert at the
                                 * boundary *)
                                when refModule with m then maybe.some(memberType(m.m maybe.unwrapOr(c.member "")))
                                else maybe.none(:Type)
                            end
                        else
                            maybe.none(:Type)
                        end
                    if maybe.isSome(fromModule) then fromModule else c.calleeType end
                end
            if maybe.isNone(calleeType) then
                unsupported(:Ok "a call of " <> maybe.unwrapOr(c.member "") <> " whose type is unknown")
            end
            let callee = maybe.unwrap(calleeType)
            let signature = written.funSignature(callee)
            let params = signature.params
            (* A polymorphic callee's parameters at the call's type arguments *)
            let quants = written.quantified(callee).quantifiers
            let instantiation = newInstantiation()
            for i = 0 upto {extent quants - 1} do
                if i < extent c.typeArgs then bind(instantiation quants[i].symbolId c.typeArgs[i]) end
            end
            let instantiated = not(isEmpty(instantiation))
            let args = vector.new(:Atom)
            for i = 0 upto {extent c.args - 1} do
                let var a = c.args[i]
                if i < extent params then
                    let p = params[i]
                    if p.isOut orif p.isVar then
                        a := refArgument(a p instantiation before after)
                    else
                        (* A value of an abstract type's application is laid out
                         * generically already *)
                        let abstract = genericLayout.abstractInstance(typeOf(a))
                        if instantiated andif maybe.isNone(abstract) then
                            a := convert(a model.substitute(p.type instantiation.subst) before noLayout)
                        end
                        a := convert(a p.type before layoutOf(instantiation true))
                    end
                end
                vector.append(args a)
            end
            c.args := vector.toArray(args)
            if instantiated then
                vector.append(r.genericResults tuple
                    let generic = signature.result
                    let instantiated = model.substitute(signature.result instantiation.subst)
                    let instantiation = instantiation
                end)
            end
            signature.result
        end

    (* The type of record field name, of tuple value component index, or of
     * variant case tag's payload, in t's written structure
     * (written.writtenStructure: for a type parameter bounded by such a type,
     * its bound's); none if t has no such structure or member *)
    let writtenField(t: Type kind: shapes.ShapeKind name: String): maybe.T(Type) =
        begin
            let w = written.writtenStructure(t kind)
            if maybe.isNone(w) then
                maybe.none()
            else
                case maybe.unwrap(w).form
                    when typeRecord with x then
                        let f = model.recordGetField(x.fields name)
                        if maybe.isSome(f) then maybe.some(maybe.unwrap(f).type) else maybe.none() end
                    else maybe.none()
                end
            end
        end

    let writtenComponent(t: Type index: Int): maybe.T(Type) =
        begin
            let w = written.writtenStructure(t shapes.shapeTuple)
            if maybe.isNone(w) then
                maybe.none()
            else
                case maybe.unwrap(w).form
                    when typeTuple with x then
                        let values = model.tupleValueFields(x.fields)
                        if index < extent values then maybe.some(values[index].type) else maybe.none() end
                    else maybe.none()
                end
            end
        end

    let writtenVariantCase(t: Type tag: String): maybe.T(Type) =
        begin
            let w = written.writtenStructure(t shapes.shapeVariant)
            if maybe.isNone(w) then
                maybe.none()
            else
                case maybe.unwrap(w).form
                    when typeVariant with x then
                        let c = model.variantGetField(x.variants tag)
                        if maybe.isSome(c) then maybe.unwrap(c).type else maybe.none() end
                    else maybe.none()
                end
            end
        end

    (* Converts an operation's operands to the types it stores them at,
     * returning the type of its result as the operation gives it (none when
     * that is the let's own) *)
    let operation(r: Representer o: Op resultType: Type before: vector.T(Stmt)): maybe.T(Type) =
        case o
            when opMakeTuple with x then
                let w = written.writtenStructure(resultType shapes.shapeTuple)
                if maybe.isSome(w) then
                    case maybe.unwrap(w).form
                        when typeTuple with t then
                            let values = model.tupleValueFields(t.fields)
                            let types = array of(extent values model.okType)
                            for i = 0 upto {extent values - 1} do types[i] := values[i].type end
                            x.args := convertAll(x.args types before)
                        else ok
                    end
                end
                maybe.none()
            when opMakeVariant with x then
                if maybe.isSome(x.payload) then
                    let caseType = writtenVariantCase(resultType x.tag)
                    if maybe.isSome(caseType) then
                        x.payload := maybe.some(convert(maybe.unwrap(x.payload) maybe.unwrap(caseType) before noLayout))
                    end
                end
                maybe.none()
            when opMakeOption with x then
                if maybe.isSome(x.payload) andif maybe.isSome(x.tag) then
                    let w = written.writtenStructure(resultType shapes.shapeOption)
                    if maybe.isSome(w) then
                        case maybe.unwrap(w).form
                            when typeOption with t then
                                let c = model.optionGetField(t.options maybe.unwrap(x.tag))
                                if maybe.isSome(c) andif maybe.isSome(maybe.unwrap(c).payload) then
                                    x.payload := maybe.some(convert(maybe.unwrap(x.payload)
                                            maybe.unwrap(maybe.unwrap(c).payload) before noLayout))
                                end
                            else ok
                        end
                    end
                end
                maybe.none()
            when opMakeArray with x then
                let elem = arrayElement(resultType)
                let args = vector.new(:Atom)
                for i = 0 upto {extent x.args - 1} do vector.append(args convert(x.args[i] elem before noLayout)) end
                x.args := vector.toArray(args)
                maybe.none()
            when opArrayRep with x then
                x.init := convert(x.init arrayElement(resultType) before noLayout)
                maybe.none()
            when opMakeAuto with x then
                let storedType = model.autoPayloadType(x.autoType maybe.none())
                let p = autoPayloadPlan(typeOf(x.payload) storedType x.autoType)
                if maybe.isSome(p) then
                    let stored = nodes.newVar("payload" storedType false)
                    vector.append(before letConvert(stored x.payload maybe.unwrap(p)))
                    x.payload := nodes.atomOfVar(stored)
                end
                maybe.none()
            when opTupleField with x then writtenComponent(typeOf(x.tup) x.index)
            when opRecordField with x then writtenField(typeOf(x.recordAtom) shapes.shapeRecord x.name)
            when opIndex with x then maybe.some(arrayElement(typeOf(x.arr)))
            when opModuleMember with x then
                case x.moduleRef
                    when refModule with m then
                        if maybe.isSome(x.member) then maybe.some(memberType(m.m maybe.unwrap(x.member)))
                        else maybe.none()
                        end
                    else maybe.none()
                end
            when opTypeApp with x then
                let origType =
                    if maybe.isSome(x.callee) then
                        maybe.unwrap(x.callee).type
                    else
                        let fromModule =
                            if maybe.isSome(x.moduleRef) then
                                case maybe.unwrap(x.moduleRef)
                                    when refModule with m then maybe.some(memberType(m.m maybe.unwrapOr(x.member "")))
                                    else maybe.none(:Type)
                                end
                            else
                                maybe.none(:Type)
                            end
                        if maybe.isSome(fromModule) then
                            maybe.unwrap(fromModule)
                        else
                            maybe.unwrapOr(x.calleeType model.okType)
                        end
                    end
                let plans = typeAppPlans(origType x.typeArgs resultType)
                x.plans := plans.plans
                x.thunkSymbols := plans.thunkSymbols
                maybe.none()
            when opPayload with x then writtenVariantCase(typeOf(x.value) x.tag)
            else maybe.none()
        end

    (* The type of the location a store stores into (none for one through an
     * address) *)
    let storedType(s: Stmt): maybe.T(Type) =
        case s
            when sStoreField with x then writtenField(typeOf(x.base) shapes.shapeRecord x.name)
            when sStoreComponent with x then writtenComponent(typeOf(x.base) x.index)
            when sStoreElement with x then maybe.some(arrayElement(typeOf(x.base)))
            else maybe.none()
        end

    (* Decides how an inspect case obtains its components (its arm), and
     * converts them to its binders' types *)
    let inspectCase(autoType: Type c: nodes.InspectCase): Ok =
        if extent c.binders > 0 then
            c.arm := maybe.some(inspectArm(autoType c))
            let armType = model.autoPayloadType(autoType maybe.some(c.matchType))
            let binders = vector.new(:Variable)
            let lets = vector.new(:Stmt)
            for i = 0 upto {extent c.binders - 1} do
                let b = c.binders[i]
                let p = plan(armType b.type noLayout)
                if maybe.isNone(p) then
                    vector.append(binders b)
                else
                    let arm = nodes.newVar(b.hint armType false)
                    vector.append(binders arm)
                    vector.append(lets letConvert(b nodes.atomOfVar(arm) maybe.unwrap(p)))
                end
            end
            c.binders := vector.toArray(binders)
            for i = 0 upto {vector.length(c.body.statements) - 1} do
                vector.append(lets vector.get(c.body.statements i))
            end
            c.body.statements := lets
        end

    (* Returns the statements that replace s, with conversions inserted before s
     * for its operands and after s for its result (plus any writebacks from
     * temporaries for var and out arguments; see refArgument and docs/ir.md
     * section 8.3). A polymorphic call's result converts in two steps: first
     * from the callee's generic layout to the instantiated type, then to the
     * let variable's type. function is the enclosing function, if any, whose
     * result type a return converts to; inspect cases also receive their
     * InspectArm plans here. *)
    let statement(r: Representer s: Stmt function: maybe.T(nodes.Function)): Array(Stmt) =
        begin
            let before = vector.new(:Stmt)
            let after = vector.new(:Stmt)
            case s
                when sLet with x then
                    case x.value
                        when opAtom with y then
                            x.value := nodes.opOfAtom(convert(y.atom x.v.type before noLayout))
                        when opCall with c then
                            let writebacks = vector.new(:Stmt)
                            r.genericResults := vector.new()
                            let resultType = call(r c before writebacks)
                            if not(vector.empty(r.genericResults)) then
                                (* The callee's generic result, converted to its
                                 * type at the type arguments, then to the
                                 * let's *)
                                let g = vector.get(r.genericResults 0)
                                let step = plan(g.generic g.instantiated layoutOf(g.instantiation false))
                                if maybe.isSome(genericLayout.abstractInstance(x.v.type)) then
                                    (* A value of an abstract type's
                                     * application, laid out generically *)
                                    result(x g.generic after)
                                elsif maybe.isSome(step) then
                                    let v = x.v
                                    let instantiated = nodes.newVar(v.hint g.instantiated false)
                                    let generic = nodes.newVar(v.hint g.generic false)
                                    vector.append(after
                                            letConvert(instantiated nodes.atomOfVar(generic) maybe.unwrap(step)))
                                    x.v := generic
                                    let final = plan(g.instantiated v.type noLayout)
                                    if maybe.isNone(final) then
                                        vector.append(after nodes.letStmt(v nodes.opOfVar(instantiated)))
                                    else
                                        vector.append(after
                                                letConvert(v nodes.atomOfVar(instantiated) maybe.unwrap(final)))
                                    end
                                else
                                    (* The generic result is laid out as the
                                     * native one at the type arguments *)
                                    result(x g.instantiated after)
                                end
                            else
                                result(x resultType after)
                            end
                            for i = 0 upto {vector.length(writebacks) - 1} do
                                vector.append(after vector.get(writebacks i))
                            end
                        else
                            let resultType = operation(r x.value x.v.type before)
                            if maybe.isSome(resultType) then result(x maybe.unwrap(resultType) after) end
                    end
                when sDo with x then
                    case x.value
                        when opCall with c then begin call(r c before after) ok end
                        else ok
                    end
                when sVarDecl with x then
                    if maybe.isSome(x.init) then
                        x.init := maybe.some(convert(maybe.unwrap(x.init) x.v.type before noLayout))
                    end
                when sAssign with x then x.value := convert(x.value x.v.type before noLayout)
                when sStoreAt then ok
                when sStoreField with x then
                    let t = storedType(s)
                    if maybe.isSome(t) then x.value := convert(x.value maybe.unwrap(t) before noLayout) end
                when sStoreComponent with x then
                    let t = storedType(s)
                    if maybe.isSome(t) then x.value := convert(x.value maybe.unwrap(t) before noLayout) end
                when sStoreElement with x then
                    let t = storedType(s)
                    if maybe.isSome(t) then x.value := convert(x.value maybe.unwrap(t) before noLayout) end
                when sReturn with x then
                    if maybe.isSome(function) then
                        x.value := convert(x.value maybe.unwrap(function).resultType before noLayout)
                    end
                when sJump with x then
                    let params = hashMap.find(r.joins x.label)
                    let args = vector.new(:Atom)
                    for i = 0 upto {extent x.args - 1} do
                        vector.append(args if i < extent params then
                            convert(x.args[i] params[i].type before noLayout)
                        else
                            x.args[i]
                        end)
                    end
                    x.args := vector.toArray(args)
                when sRaise with x then
                    if maybe.isSome(x.payload) then
                        let w = written.writtenStructure(typeOf(x.exc) shapes.shapeException)
                        if maybe.isSome(w) then
                            case maybe.unwrap(w).form
                                when typeException with e then
                                    x.payload := maybe.some(convert(maybe.unwrap(x.payload) e.payload before noLayout))
                                else ok
                            end
                        end
                    end
                when sInspect with x then
                    if maybe.isSome(x.autoType) then
                        for i = 0 upto {extent x.cases - 1} do inspectCase(maybe.unwrap(x.autoType) x.cases[i]) end
                    end
                else ok
            end
            let all = vector.new(:Stmt)
            for i = 0 upto {vector.length(before) - 1} do vector.append(all vector.get(before i)) end
            vector.append(all s)
            for i = 0 upto {vector.length(after) - 1} do vector.append(all vector.get(after i)) end
            vector.toArray(all)
        end

    (* A conversion rejected at pos in r's unit (nodes.stmtPos), raised as
     * the program's error in the file pos is in (at its start if pos is
     * unknown) *)
    let rejectedAt(r: Representer pos: Int message: String): diagnostics.CompilerError =
        begin
            let p = nodes.sourcePos(r.unit pos)
            if maybe.isNone(p) then
                diagnostics.errorAt(message 0)
            else
                let q = maybe.unwrap(p)
                let e = diagnostics.errorAt(message pos - nodes.fileOffset(q.file 0))
                let file = nodes.sourceFile(r.unit q.file)
                if maybe.isSome(file) then diagnostics.inFile(e maybe.unwrap(file)) else e end
            end
        end

    let rec body(r: Representer b: Body function: maybe.T(nodes.Function)): Ok =
        begin
            let statements = vector.new(:Stmt)
            for i = 0 upto {vector.length(b.statements) - 1} do
                let s = vector.get(b.statements i)
                case s
                    when sJoin with x then
                        begin hashMap.insert(r.joins x.label x.params) ok end
                    else ok
                end
                let bodies = walk.statementBodies(s)
                for j = 0 upto {extent bodies - 1} do body(r bodies[j] function) end
                (* Where a rejected conversion is reported: s, or the nearest
                 * statement before it with a position *)
                if nodes.stmtPos(s) >= 0 then r.pos := nodes.stmtPos(s) end
                let made =
                    try statement(r s function)
                    when rejectedConversion with m then diagnostics.raiseError(:Array(Stmt) rejectedAt(r r.pos m))
                    end
                for j = 0 upto {extent made - 1} do vector.append(statements made[j]) end
            end
            b.statements := statements
        end

    let representUnit(unit: nodes.Unit): nodes.Unit =
        begin
            let r = tuple
                let unit = unit
                let joins = maps.newStringMap(:Array(Variable))
                let var genericResults = vector.new(:GenericResult)
                let var pos = ~1
            end
            for i = 0 upto {vector.length(unit.modules) - 1} do
                r.pos := ~1
                body(r vector.get(unit.modules i).init maybe.none())
            end
            r.pos := ~1
            body(r unit.main maybe.none())
            for i = 0 upto {vector.length(unit.functions) - 1} do
                let f = vector.get(unit.functions i)
                r.pos := ~1
                body(r f.body maybe.some(f))
            end
            slots.decideSlots(unit)
            unit.stage := stages.represented
            hashMap.clear(typeVarsMemo)
            unit
        end
end
