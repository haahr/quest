(* Quest Self-Hosted Compiler: Unboxed Tuples Interface
 *
 * Identifies function-returned tuples that do not need heap allocation
 * (docs/ir.md section 8.7). After closure conversion, a monomorphic function
 * qualifies when every closure of it is only called directly, every return
 * builds a fresh tuple exclusively for that return, and every caller only
 * reads components from the result. Qualifying functions are marked with
 * Function.unboxedResult, and both the returned tuples and call-result
 * bindings are marked Variable.unboxed so backends pass their components
 * directly (as a C struct or SSA register values) without allocating. The
 * tuple must match the function's result type and have one or two immutable
 * components, each an Int, Bool, Char, or String, so no conversion, box, or
 * proxy is needed and two words fit every backend's return convention. *)

interface Unbox
import
    questlang/ir/nodes : questlang/ir/Nodes
export
    (* Marks the unit's unboxed results and variables, in place, returning
     * it *)
    unboxUnit(unit: nodes.Unit): nodes.Unit
end
