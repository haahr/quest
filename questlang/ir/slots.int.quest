(* Quest Self-Hosted Compiler: Slots and Proxies Interface
 *
 * This pass is the final step of the represent pass (docs/ir.md section 8.3;
 * counterpart in bootstrap/python/quest/ir/slots.py). It decides how values
 * are stored into and read from aggregate slots (which hold records and
 * variants boxed behind a pointer) and how tuples and options that may be
 * proxies (subtyping wrappers that redirect accesses to an underlying value)
 * are accessed (DIRECT, ORIGINAL, or PROXY). It also marks record field reads
 * that must consult the record's runtime offset table for stored types, and
 * marks record literals whose offset table must be built at run time. *)

interface Slots
import
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/repr/shapes : questlang/repr/Shapes
export
    (* Whether a value of shape s may be laid out as a subtype's value, and so
     * need converting when read at s's type (records, variants, options,
     * nonempty tuples, and functions) *)
    mayBeStoredAsSubtype(s: shapes.Shape): Bool
    (* Returns how component index of a tuple with shape ts is accessed. fresh
     * is true when the tuple was allocated by the current function and so
     * cannot be a proxy. *)
    tupleAccess(ts: shapes.Shape index: Int fresh: Bool): nodes.Access
    (* Decides, in place, how the unit's values are stored into and read from
     * slots, and read through proxies *)
    decideSlots(unit: nodes.Unit): Ok
    (* Decides the same for a function made after the unit's were decided (a
     * thunk), whose body has no nested functions *)
    decideFunctionSlots(f: nodes.Function): Ok
end
