(* Quest Self-Hosted Compiler: Contification Interface
 *
 * Contification (docs/ir.md section 8.6; the term is MLton's) turns a local
 * function into a loop inside its one caller, so that each of its calls of
 * itself costs a jump rather than a call, and no closure is made for it. A
 * function qualifies when a funs statement binds it; it has value parameters
 * only and no type parameters; control cannot fall off its body's end; and
 * every use of it is a call: one outside its body, and the others tail calls
 * of itself in its body (not in the functions it binds, nor in a try's
 * region). It must also loop: call itself, or be recursive through other
 * functions. One that does not is left to the inliner (which never inlines a
 * recursive function).
 *
 * The outside call becomes a join point, whose parameter is the call's
 * result and whose continuation is the rest of the caller's body, around a
 * loop that runs the function's body. The function's returns jump to the join
 * point; its tail calls assign their arguments to mutable variables, one per
 * parameter, and continue the loop. Each iteration binds the parameters to
 * those variables anew, so that the function's own functions capture
 * immutable values, as before (contify.mod's transform shows an example) *)

interface Contify
import
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/clone : questlang/ir/Clone
    collections/hashMap : collections/HashMap
export
    (* Contifies the functions of the bodies (and the functions they bind) that
     * can be, other than the pinned ones (by their variables' ids), in place,
     * with labels counted by labels; whether it contified any. recursive says
     * which functions name themselves, directly or not (inline.analyze's) *)
    contify(bodies: Array(nodes.Body) recursive: hashMap.T(Int Bool) pinned: hashMap.T(Int Bool)
        labels: clone.Labels): Bool
end
