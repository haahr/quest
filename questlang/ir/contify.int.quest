(* Quest Self-Hosted Compiler: Contification Interface
 *
 * Local functions made loops of their callers (docs/inlining.md section 4,
 * MLton's contification): a function a funs statement binds, of value
 * parameters and no type parameters, whose every use is a call, one of them
 * outside its own body and the others in its body (not its functions') tail
 * calls of itself, becomes a loop at the outside call. The call's result is a
 * join point's parameter, whose continuation is the rest of the caller's body;
 * the function's returns jump to it, its tail calls assign its parameters'
 * variables and continue the loop, and each iteration binds the parameters to
 * them, so that the function's own functions capture values as before. *)

interface Contify
import
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/clone : questlang/ir/Clone
    collections/hashMap : collections/HashMap
export
    (* Contifies the functions of the bodies (and the functions they bind) that
     * can be, other than the pinned ones (by their variables' ids), in place,
     * with labels counted by labels; whether it contified any *)
    contify(bodies: Array(nodes.Body) pinned: hashMap.T(Int Bool) labels: clone.Labels): Bool
end
