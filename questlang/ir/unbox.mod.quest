(* Quest Self-Hosted Compiler: Unboxed Tuples Implementation *)

module unbox : Unbox
import
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/common/maps : questlang/common/Maps
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/walk : questlang/ir/Walk
    questlang/repr/shapes : questlang/repr/Shapes
export
    Let Variable = nodes.Variable
    Let Atom = nodes.Atom
    Let Body = nodes.Body
    Let Stmt = nodes.Stmt
    Let Op = nodes.Op

    (* The most components an unboxed tuple has: two words of results *)
    let maxComponents = 2

    (* What the unit holds: each variable's uses; the uses as a call's callee,
     * and as the tuple a component is read from; what each let binds; the
     * closures of each function, by its id; and the variables kept whatever
     * their use counts say (modules' members and exports, which are named
     * from outside the bodies, and let rec's variables) *)
    Let Facts = Tuple
        uses: maps.IntMap(Int)
        callees: maps.IntMap(Int)
        reads: maps.IntMap(Int)
        defs: maps.IntMap(Op)
        closures: maps.IntMap(vector.T(Variable))
        calls: vector.T(Stmt)
        pinned: maps.IntMap(Bool)
    end

    let bump(m: maps.IntMap(Int) id: Int): Ok =
        begin hashMap.insert(m id 1 + maybe.unwrapOr(hashMap.get(m id) 0)) ok end
    let countOf(m: maps.IntMap(Int) v: Variable): Int = maybe.unwrapOr(hashMap.get(m v.id) 0)

    let gather(f: Facts b: Body): Ok =
        begin
            let stmts = walk.walkStatements(b true)
            for i = 0 upto {vector.length(stmts) - 1} do
                let st = vector.get(stmts i)
                let op =
                    case st
                        when sLet with x then
                            begin
                                hashMap.insert(f.defs x.v.id x.value)
                                maybe.some(x.value)
                            end
                        when sDo with x then maybe.some(x.value)
                        else maybe.none(:Op)
                    end
                if maybe.isSome(op) then
                    case maybe.unwrap(op)
                        when opCall with c then
                            if maybe.isSome(c.callee) then
                                bump(f.callees maybe.unwrap(c.callee).id)
                                vector.append(f.calls st)
                            end
                        when opTupleField with t then
                            case t.tup when atomVar with x then bump(f.reads x.v.id) when atomConst then ok end
                        when opMakeClosure with c then
                            case st
                                when sLet with x then
                                    if not(hashMap.contains(f.closures c.code.id)) then
                                        hashMap.insert(f.closures c.code.id vector.new(:Variable))
                                    end
                                    vector.append(hashMap.find(f.closures c.code.id) x.v)
                                else ok
                            end
                        else ok
                    end
                end
            end
        end

    (* Whether a tuple type's values can be held as their components: one or
     * two, each an Int, Bool, Char, or String, none var *)
    let unboxable(s: shapes.Shape): Bool =
        if not(shapes.kindIs(s shapes.shapeTuple)) orif {extent s.components is 0}
                orif {extent s.components > maxComponents} then
            false
        else
            let var all = true
            for i = 0 upto {extent s.components - 1} do
                let c = s.components[i]
                let k = shapes.componentShape(c)
                if c.isVar orif not(shapes.kindIs(k shapes.shapeInt) orif shapes.kindIs(k shapes.shapeBool)
                        orif shapes.kindIs(k shapes.shapeChar) orif shapes.kindIs(k shapes.shapeString)) then
                    all := false
                end
            end
            all
        end

    (* Returns the tuple variables returned by fun1, or none if any return is
     * not a single-use immutable tuple allocated for that return with fun1's
     * result type *)
    let returned(f: Facts fun1: nodes.Function): maybe.T(vector.T(Variable)) =
        begin
            let found = vector.new(:Variable)
            let var all = true
            let stmts = walk.walkStatements(fun1.body false)
            for i = 0 upto {vector.length(stmts) - 1} do
                case vector.get(stmts i)
                    when sReturn with r then
                        case r.value
                            when atomVar with x then
                                let d = hashMap.get(f.defs x.v.id)
                                let made = maybe.isSome(d)
                                    andif {case maybe.unwrap(d)
                                        when opMakeTuple with t then extent t.embedded is 0
                                        else false
                                    end}
                                if made andif {countOf(f.uses x.v) is 1} andif not(x.v.isMutable)
                                        andif nodes.sameType(x.v.type fun1.resultType) then
                                    vector.append(found x.v)
                                else
                                    all := false
                                end
                            when atomConst then all := false
                        end
                    else ok
                end
            end
            if all andif not(vector.empty(found)) then maybe.some(found) else maybe.none() end
        end

    let unboxUnit(unit: nodes.Unit): nodes.Unit =
        begin
            let f = tuple
                let uses = maps.newIntMap(:Int)
                let callees = maps.newIntMap(:Int)
                let reads = maps.newIntMap(:Int)
                let defs = maps.newIntMap(:Op)
                let closures = maps.newIntMap(:vector.T(Variable))
                let calls = vector.new(:Stmt)
                let pinned = maps.newIntMap(:Bool)
            end
            walk.countUses(unit f.uses f.pinned)
            let all = walk.unitBodies(unit)
            for b = 0 upto {extent all - 1} do gather(f all[b]) end
            for i = 0 upto {vector.length(unit.functions) - 1} do
                let fun1 = vector.get(unit.functions i)
                let closures = maybe.unwrapOr(hashMap.get(f.closures fun1.id)
                        vector.new(:Variable))
                (* Every closure of it is only called *)
                let var known = {extent fun1.typeParams is 0} andif not(vector.empty(closures))
                    andif unboxable(shapes.shape(fun1.resultType))
                for k = 0 upto {vector.length(closures) - 1} do
                    let c = vector.get(closures k)
                    if hashMap.contains(f.pinned c.id) orif {countOf(f.uses c) isnot countOf(f.callees c)} then
                        known := false
                    end
                end
                (* Every call's result, if bound, is of its result type and only
                 * read from *)
                let results = vector.new(:Variable)
                if known then
                    for k = 0 upto {vector.length(f.calls) - 1} do
                        let st = vector.get(f.calls k)
                        let callee =
                            case st
                                when sLet with x then
                                    case x.value when opCall with c then c.callee else maybe.none(:Variable) end
                                when sDo with x then
                                    case x.value when opCall with c then c.callee else maybe.none(:Variable) end
                                else maybe.none(:Variable)
                            end
                        let var mine = false
                        for j = 0 upto {vector.length(closures) - 1} do
                            if maybe.isSome(callee)
                                    andif nodes.same(maybe.unwrap(callee) vector.get(closures j)) then mine := true end
                        end
                        if mine then
                            case st
                                when sLet with x then
                                    if nodes.sameType(x.v.type fun1.resultType) andif not(x.v.isMutable)
                                            andif not(hashMap.contains(f.pinned x.v.id))
                                            andif {countOf(f.uses x.v) is countOf(f.reads x.v)} then
                                        vector.append(results x.v)
                                    else
                                        known := false
                                    end
                                else ok
                            end
                        end
                    end
                end
                let tuples = if known then returned(f fun1) else maybe.none(:vector.T(Variable)) end
                if maybe.isSome(tuples) then
                    fun1.unboxedResult := true
                    let made = maybe.unwrap(tuples)
                    for k = 0 upto {vector.length(made) - 1} do vector.get(made k).unboxed := true end
                    for k = 0 upto {vector.length(results) - 1} do vector.get(results k).unboxed := true end
                end
            end
            unit
        end
end
