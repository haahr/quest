(* Quest Self-Hosted Compiler: Captured Mutable Variables Interface
 *
 * This pre-pass for IR lowering finds local mutable (var) variables that are
 * used by functions nested inside their scope. Lowering (ir/lower) stores
 * those variables in heap-allocated mutable cells (boxes) so that closures
 * share updates to them. The counterpart is
 * bootstrap/python/quest/ir/captures.py. *)

interface Captures
import
    collections/hashMap : collections/HashMap

    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
export
    (* Adds to captured the symbol ids of local var variables used by functions
     * nested in their scope. A qualifying variable is any let var not declared
     * directly at a unit's or module's top level (where it is global) that is
     * referenced inside an inner function. *)
    capturedMutables(prog: typedAst.Program captured: hashMap.T(Int Bool)): Ok
end
