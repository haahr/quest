(* Quest Self-Hosted Compiler: Captured Mutable Variables Interface
 *
 * Lowering's pre-pass over a typed program: the local var variables that
 * functions nested in their scope use, which lowering holds in boxes the
 * closures share (ir/lower). The counterpart is
 * bootstrap/python/quest/ir/captures.py. *)

interface Captures
import
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    collections/hashMap : collections/HashMap
export
    (* Adds to captured the symbols of the local var variables that functions
     * nested in their scope use: a let var anywhere but directly at a unit's or
     * a module's top level (where it is global), used inside a function within
     * its scope *)
    capturedMutables(prog: typedAst.Program captured: hashMap.T(Int Bool)): Ok
end
