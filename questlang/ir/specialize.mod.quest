(* Quest Self-Hosted Compiler: Specialization Implementation *)

module specialize : Specialize
import
    questlang/types/model : questlang/types/Model
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/walk : questlang/ir/Walk
    questlang/repr/written : questlang/repr/Written
    cloning = questlang/ir/clone : questlang/ir/Clone
    questlang/repr/layout : questlang/repr/Layout
    questlang/repr/genericLayout : questlang/repr/GenericLayout
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    util/strutil : util/Strutil
    stringOp = string : StringOp
    conv : Conv
export
    Let Type = model.Type
    Let Shape = shapes.Shape
    Let Variable = nodes.Variable
    Let Atom = nodes.Atom
    Let Body = nodes.Body
    Let Stmt = nodes.Stmt
    Let Op = nodes.Op

    let intEqual(a: Int b: Int): Bool = a is b
    let eq(a: String b: String): Bool = stringOp.equal(a b)

    (* The depth of clones made for calls in clones, beyond which calls stay
     * generic: polymorphic recursion would otherwise specialize without end *)
    let maxDepth = 16

    Let Ids = hashMap.T(Int Bool)
    let newIds(): Ids = hashMap.new(:Int :Bool intEqual hash.int)
    let withIds(ids: Ids more: Array(nodes.TypeParam)): Ids =
        begin
            let result = newIds()
            hashMap.forEach(:Int :Bool ids fun(k: Int b: Bool): Ok begin hashMap.insert(:Int :Bool result k b) ok end)
            for i = 0 upto {extent more - 1} do hashMap.insert(:Int :Bool result more[i].symbolId true) end
            result
        end

    let mentionsAny(t: Type ids: Ids): Bool =
        begin
            let var found = false
            for i = 0 upto {extent t.fv - 1} do if hashMap.contains(:Int :Bool ids t.fv[i]) then found := true end end
            found
        end

    let holdsRecordOrVariant(s0: Shape): Bool =
        begin
            let seen = newIds()
            let rec holds(s: Shape): Bool =
                if hashMap.contains(:Int :Bool seen s.id) then
                    false
                else
                    hashMap.insert(:Int :Bool seen s.id true)
                    let kind = s.kind
                    case kind
                        when shapeRecord, shapeVariant then
                            true
                        when shapeTypevar then
                            maybe.isSome(:Shape s.bound) andif holds(maybe.unwrap(:Shape s.bound))
                        when shapeTuple then
                            let var found = false
                            for i = 0 upto {extent s.components - 1} do
                                if not(found) andif holds(shapes.componentShape(s.components[i])) then found := true end
                            end
                            found
                        when shapeOption then
                            let var found = false
                            for i = 0 upto {extent s.cases - 1} do
                                let c = s.cases[i].shape
                                if not(found) andif maybe.isSome(:Shape c)
                                    andif holds(maybe.unwrap(:Shape c)) then found := true end
                            end
                            found
                        when shapeArray, shapeCell, shapeOut then
                            holds(shapes.element(s))
                        when shapeInt, shapeReal, shapeBool, shapeChar, shapeString, shapeOk, shapeWord, shapeBottom,
                            shapeException, shapeFun, shapeAll, shapeAuto, shapeAbstract, shapeExternal, shapeOperator,
                            shapePending then
                            false
                    end
                end
            holds(s0)
        end

    let shouldSpecialize(f: nodes.Function typeArgs: Array(Type)): Bool =
        begin
            (* A function defined as an external C function stays generic: the
             * C function takes its type parameters' values in their slot
             * form, a word *)
            let var isExternal = false
            for i = 0 upto {vector.length(:nodes.Stmt f.body.statements) - 1} do
                case vector.get(:nodes.Stmt f.body.statements i)
                    when sLet with s then case s.value when opCallExternal then isExternal := true else ok end
                    else ok
                end
            end
            (* A type operator (the argument of a higher-kinded type parameter)
             * is not the type of values, and has no shape *)
            let var found = false
            for i = 0 upto {extent typeArgs - 1} do
                if not(found) andif not(written.isTypeOperator(typeArgs[i])) andif holdsRecordOrVariant(shapes.shape(typeArgs[i])) then
                    found := true
                end
            end
            let ids = withIds(newIds() f.typeParams)
            for i = 0 upto {extent f.params - 1} do
                let p = f.params[i]
                if not(found) then
                    if not(eq(p.mode "value")) andif mentionsAny(p.v.type ids) then found := true end
                    if shapes.kindIs(shapes.shape(p.v.type) shapes.shapeTuple)
                        andif mentionsAny(p.v.type ids) then found := true end
                end
            end
            not(isExternal) andif {found orif
                {shapes.kindIs(shapes.shape(f.resultType) shapes.shapeTuple) andif mentionsAny(f.resultType ids)}}
        end

    (* The clone of a function the substitution instantiates (its type
     * parameters are substituted away) *)
    let cloneFunction(c: cloning.Cloner f: nodes.Function): nodes.Function =
        begin
            cloning.bindAll(c f.body)
            let params = array of(extent f.params tuple let v = f.v let mode = "" end)
            for i = 0 upto {extent f.params - 1} do params[i] := tuple let v = cloning.fresh(c f.params[i].v) let mode = f.params[i].mode end end
            let resultType = cloning.ty(c f.resultType)
            (* The clone's type is made from its parameters and result: the type
             * of the variable naming the original may be elaborated with
             * quantifiers of other symbols than the function's own type
             * parameters *)
            let inner = written.quantified(f.v.type).body
            let names = case inner.form
                when typeFun with x then
                    let ns = array of(extent x.params "")
                    for i = 0 upto {extent x.params - 1} do ns[i] := x.params[i].name end
                    ns
                else array of :String end
            end
            (* A function of type parameters alone (a polymorphic value,
             * hashMap.newIdentityMap) is cloned as a function without
             * parameters, which its type application is a call of *)
            let ps = array of(extent params
                tuple let name = "" let type = model.okType let isVar = false let isOut = false end)
            for i = 0 upto {extent params - 1} do
                ps[i] := tuple
                    let name = if i < extent names then names[i] else params[i].v.hint end
                    let type = params[i].v.type
                    let isVar = eq(params[i].mode "var")
                    let isOut = eq(params[i].mode "out")
                end
            end
            let cloneType = model.funType(ps resultType)
            let v = nodes.newVar(f.v.hint <> "_spec" cloneType f.v.isMutable)
            nodes.newFunction(v array of :nodes.TypeParam end params resultType cloning.copyBody(c f.body) f.traceName)
        end

    (* ======================================================================
     * The specializer
     * ====================================================================== *)

    (* A function bound by a funs statement, and where: its statement, the
     * module whose member it is (if any), and the type parameters of the
     * functions enclosing it *)
    Let Definition = Tuple function: nodes.Function funs: Stmt owner: maybe.T(nodes.Module) enclosing: Ids end
    Let Pending = Tuple clone: nodes.Function enclosing: Ids depth: Int end

    (* The state of specializing a unit: finding the functions that its funs
     * statements (the IR's binders of groups of functions) bind, then
     * redirecting calls of them to clones made for the calls' type arguments.
     *
     *     let id(A::TYPE x: A): A = x;
     *     let p = id(:Record x: Int end record x = 1 end);
     *     let n = id(:Int 2);
     *
     * The first call is specialized and the second is not (shouldSpecialize:
     * generic code boxes a record, not an Int), so after the pass, as
     * --stop-after ir_specialized prints it (condensed),
     *
     *     fun id [A::TYPE](x: A): A { return x }
     *     fun id_spec(x.1: Record x: Int end): Record x: Int end { return x.1 }
     *     let p: Record x: Int end = call id_spec(%1)
     *     let n: Int = call id [Int](2)
     *
     * A call is specialized only when its type arguments are closed: one that
     * mentions a type parameter of a function around the call (enclosing) has
     * no single type to clone for.
     *
     * - definitions holds each function, by its variable's id, with its funs
     *   statement, its module, and the type parameters of the functions
     *   around it. collect fills it, and clone adds each clone and the local
     *   functions inside it.
     * - clones holds each clone, by function and type arguments, so that calls
     *   with the same arguments share one; counts numbers the clones of each
     *   function, which names those that are module members (f_spec1, ...).
     * - pending holds the clones whose bodies are still to be specialized,
     *   each with its depth, the number of clones that led to it (depth is
     *   that of the body being specialized). A clone's body may call for more
     *   clones; past maxDepth none is made, so that polymorphic recursion (a
     *   function of A calling itself at List(A)) does not clone without
     *   end. *)
    Let Specializer = Tuple
        definitions: hashMap.T(Int Definition)
        clones: hashMap.T(String nodes.Function)
        counts: hashMap.T(Int Int)
        pending: vector.T(Pending)
        var depth: Int
    end

    let rec collect(sp: Specializer b: Body m: maybe.T(nodes.Module) enclosing: Ids): Ok =
        for i = 0 upto {vector.length(:Stmt b.statements) - 1} do
            let s = vector.get(:Stmt b.statements i)
            case s
                when sFuns with x then
                    for j = 0 upto {extent x.functions - 1} do
                        let f = x.functions[j]
                        hashMap.insert(:Int :Definition sp.definitions f.v.id
                            tuple let function = f let funs = s let owner = m let enclosing = enclosing end)
                        collect(sp f.body maybe.none(:nodes.Module) withIds(enclosing f.typeParams))
                    end
                else
                    let bodies = walk.statementBodies(s)
                    for j = 0 upto {extent bodies - 1} do collect(sp bodies[j] m enclosing) end
            end
        end

    let memberName(m: nodes.Module v: Variable): String =
        begin
            let var found = ""
            let var done = false
            for i = 0 upto {vector.length(:String m.members.names) - 1} do
                let n = vector.get(:String m.members.names i)
                if not(done) andif nodes.same(hashMap.find(:String :Variable m.members.vars n) v) then
                    found := n
                    done := true
                end
            end
            found
        end

    (* The clone of definition's function at typeArgs, made once and shared
     * by every call at the same type arguments; none when the call is in a
     * clone maxDepth deep, which leaves it generic. A new clone is bound by
     * the original's funs statement, beside it, and for a module's function
     * is also the module's member <name>_spec<n>, the nth clone of it. It
     * becomes a definition, as do its local functions, and waits in pending
     * for its own calls to be specialized, one level deeper *)
    let clone(sp: Specializer definition: Definition typeArgs: Array(Type)): maybe.T(nodes.Function) =
        begin
            let f = definition.function
            (* By function and type arguments (by symbol and type identity,
             * never by name) *)
            let keyBuilder = vector.new(:String)
            vector.append(:String keyBuilder conv.int(f.id))
            for i = 0 upto {extent typeArgs - 1} do vector.append(:String keyBuilder layout.typeIdentityKey(typeArgs[i])) end
            let keyText = strutil.join("|" keyBuilder)
            let existing = hashMap.get(:String :nodes.Function sp.clones keyText)
            if maybe.isSome(:nodes.Function existing) then
                existing
            elsif sp.depth >= maxDepth then
                maybe.none(:nodes.Function)
            else
                let n = maybe.unwrapOr(:Int hashMap.get(:Int :Int sp.counts f.id) 0)
                hashMap.insert(:Int :Int sp.counts f.id n + 1)
                let subst = model.newSubst()
                for i = 0 upto {extent f.typeParams - 1} do
                    if i < extent typeArgs then hashMap.insert(:Int :Type subst f.typeParams[i].symbolId typeArgs[i]) end
                end
                let cloner = cloning.newCloner(subst)
                let cloned = cloneFunction(cloner f)
                hashMap.insert(:String :nodes.Function sp.clones keyText cloned)
                case definition.funs
                    when sFuns with x then
                        let functions = vector.fromArray(:nodes.Function x.functions)
                        vector.append(:nodes.Function functions cloned)
                        x.functions := vector.toArray(:nodes.Function functions)
                    else ok
                end
                if maybe.isSome(:nodes.Module definition.owner) then
                    let m = maybe.unwrap(:nodes.Module definition.owner)
                    nodes.addMember(m.members memberName(m f.v) <> "_spec" <> conv.int(n + 1) cloned.v)
                end
                hashMap.insert(:Int :Definition sp.definitions cloned.v.id
                    tuple let function = cloned let funs = definition.funs let owner = definition.owner let enclosing = definition.enclosing end)
                (* The clone's local functions are definitions too, whose calls
                 * (in the clone) may be specialized *)
                collect(sp cloned.body maybe.none(:nodes.Module) definition.enclosing)
                vector.append(:Pending sp.pending tuple let clone = cloned let enclosing = definition.enclosing let depth = sp.depth + 1 end)
                maybe.some(:nodes.Function cloned)
            end
        end

    (* The definition of the function a call or a type application applies:
     * its callee, or a member of one of the unit's modules *)
    let definitionOf(sp: Specializer callee: maybe.T(Variable) moduleRef: maybe.T(nodes.ModuleRef)
            member: maybe.T(String)): maybe.T(Definition) =
        if maybe.isSome(:Variable callee) then
            hashMap.get(:Int :Definition sp.definitions maybe.unwrap(:Variable callee).id)
        elsif maybe.isSome(:nodes.ModuleRef moduleRef) then
            case maybe.unwrap(:nodes.ModuleRef moduleRef)
                when refModule with r then
                    let m = nodes.member(r.m.members maybe.unwrapOr(:String member ""))
                    if maybe.isSome(:Variable m) then
                        hashMap.get(:Int :Definition sp.definitions maybe.unwrap(:Variable m).id)
                    else maybe.none(:Definition) end
                (* A function of another unit, whose IR this unit does not
                 * have *)
                else maybe.none(:Definition)
            end
        else
            maybe.none(:Definition)
        end

    (* Whether f applied to typeArgs (closed, since they mention none of the
     * enclosing type parameters) is specialized *)
    let specializes(f: nodes.Function typeArgs: Array(Type) enclosing: Ids): Bool =
        begin
            let var open = false
            for i = 0 upto {extent typeArgs - 1} do if mentionsAny(typeArgs[i] enclosing) then open := true end end
            {extent typeArgs is extent f.typeParams} andif not(open) andif shouldSpecialize(f typeArgs)
        end

    (* Whether a call of a module's member from outside the module, at
     * typeArgs, would give its clone values of the module's abstract types
     * that the clone lays out otherwise than code outside the module does
     * (generically, docs/c-representation.md section 5.1): such a call stays
     * generic, rather than convert them at every call *)
    let crossesAbstractLayouts(moduleRef: maybe.T(nodes.ModuleRef) calleeType: maybe.T(Type) typeArgs: Array(Type)):
            Bool =
        if maybe.isNone(:nodes.ModuleRef moduleRef) orif maybe.isNone(:Type calleeType) then
            false
        else
            let q = written.quantified(maybe.unwrap(:Type calleeType))
            let subst = model.newSubst()
            for i = 0 upto {extent q.quantifiers - 1} do
                if i < extent typeArgs then hashMap.insert(:Int :Type subst q.quantifiers[i].symbolId typeArgs[i]) end
            end
            genericLayout.abstractLayoutsDiffer(model.substitute(q.body subst))
        end

    let specializeCall(sp: Specializer o: Op enclosing: Ids): Ok =
        case o
            when opCall with call then
                if extent call.typeArgs > 0 then
                    let definition = definitionOf(sp call.callee call.moduleRef call.member)
                    if maybe.isSome(:Definition definition) then
                        let d = maybe.unwrap(:Definition definition)
                        if specializes(d.function call.typeArgs enclosing)
                            andif not(crossesAbstractLayouts(call.moduleRef call.calleeType call.typeArgs)) then
                            let cloned = clone(sp d call.typeArgs)
                            if maybe.isSome(:nodes.Function cloned) then
                                let c = maybe.unwrap(:nodes.Function cloned)
                                if maybe.isSome(:Variable call.callee) then
                                    call.callee := maybe.some(:Variable c.v)
                                else
                                    call.member := maybe.some(:String memberName(maybe.unwrap(:nodes.Module d.owner) c.v))
                                end
                                call.typeArgs := array of :Type end
                            end
                        end
                    end
                end
            else ok
        end

    (* A type application whose instance is not a function runs the function
     * applied, as a call without arguments does: specialized as such a call
     * is, it is a call of the clone. Its result is otherwise laid out
     * generically where the clones that a whole program's calls of a module's
     * functions are specialized to expect it native (an identity hash map of
     * Reals, hashMap.newIdentityMap) *)
    let specializeTypeApp(sp: Specializer o: Op result: Variable enclosing: Ids): maybe.T(Op) =
        case o
            when opTypeApp with app then
                let definition = definitionOf(sp app.callee app.moduleRef app.member)
                if maybe.isSome(:Definition definition) andif not(shapes.isFunction(result.type)) then
                    let d = maybe.unwrap(:Definition definition)
                    if {extent d.function.params is 0} andif specializes(d.function app.typeArgs enclosing)
                        andif not(crossesAbstractLayouts(app.moduleRef app.calleeType app.typeArgs)) then
                        let cloned = clone(sp d app.typeArgs)
                        if maybe.isSome(:nodes.Function cloned) then
                            let c = maybe.unwrap(:nodes.Function cloned)
                            let none = array of :Type end
                            if maybe.isSome(:Variable app.callee) then
                                maybe.some(:Op nodes.call(maybe.some(:Variable c.v) none array of :Atom end
                                    maybe.none(:nodes.ModuleRef) maybe.none(:String) app.calleeType))
                            else
                                let member = memberName(maybe.unwrap(:nodes.Module d.owner) c.v)
                                maybe.some(:Op nodes.call(maybe.none(:Variable) none array of :Atom end app.moduleRef
                                    maybe.some(:String member) app.calleeType))
                            end
                        else maybe.none(:Op) end
                    else maybe.none(:Op) end
                else maybe.none(:Op) end
            else maybe.none(:Op)
        end

    let rec specializeBody(sp: Specializer b: Body enclosing: Ids): Ok =
        for i = 0 upto {vector.length(:Stmt b.statements) - 1} do
            let s = vector.get(:Stmt b.statements i)
            case s
                when sLet with x then
                    specializeCall(sp x.value enclosing)
                    let call = specializeTypeApp(sp x.value x.v enclosing)
                    if maybe.isSome(:Op call) then x.value := maybe.unwrap(:Op call) end
                when sDo with x then specializeCall(sp x.value enclosing)
                when sFuns with x then
                    let functions = x.functions
                    for j = 0 upto {extent functions - 1} do
                        specializeBody(sp functions[j].body withIds(enclosing functions[j].typeParams))
                    end
                else
                    let bodies = walk.statementBodies(s)
                    for j = 0 upto {extent bodies - 1} do specializeBody(sp bodies[j] enclosing) end
            end
        end

    let specializeUnit(unit: nodes.Unit): nodes.Unit =
        begin
            let sp = tuple
                let definitions = hashMap.new(:Int :Definition intEqual hash.int)
                let clones = hashMap.new(:String :nodes.Function stringOp.equal hash.string)
                let counts = hashMap.new(:Int :Int intEqual hash.int)
                let pending = vector.new(:Pending)
                let var depth = 0
            end
            for i = 0 upto {vector.length(:nodes.Module unit.modules) - 1} do
                let m = vector.get(:nodes.Module unit.modules i)
                collect(sp m.init maybe.some(:nodes.Module m) newIds())
            end
            collect(sp unit.main maybe.none(:nodes.Module) newIds())
            for i = 0 upto {vector.length(:nodes.Module unit.modules) - 1} do
                specializeBody(sp vector.get(:nodes.Module unit.modules i).init newIds())
            end
            specializeBody(sp unit.main newIds())
            while not(vector.empty(:Pending sp.pending)) do
                let p = vector.pop(:Pending sp.pending)
                sp.depth := p.depth
                specializeBody(sp p.clone.body p.enclosing)
            end
            unit.stage := "specialized"
            unit
        end
end
