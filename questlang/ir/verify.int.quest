(* Quest Self-Hosted Compiler: The IR Verifier Interface
 *
 * Mirrors bootstrap/python/quest/ir/verify.py (docs/ir.md section 9). Checks a
 * unit's invariants for its current stage after every pass during tests. Core
 * invariants: operations' arguments are atoms; every variable is bound once
 * and used only in its scope; module references are to the unit's modules and
 * imports; a function uses no mutable variable of an enclosing function;
 * jumps, breaks, and continues name enclosing join points and loops; returns
 * occur only in functions; terminators end their bodies; ordinals record their
 * options' cases. After closure conversion, no funs statement remains and
 * closures are of the unit's functions; after the represent pass, values are
 * used in the representations their uses require; after the describe pass,
 * every run-time use of a type has its descriptor operands. It runs when
 * QUEST_CHECK_IR=1, which the test runners set. *)

interface Verify
import
    questlang/ir/nodes : questlang/ir/Nodes
export
    (* Whether QUEST_CHECK_IR is 1, as the test runners set it: then the
     * driver, the backends, and the JIT verify the unit after each pass
     * (docs/ir.md section 9) *)
    irChecksEnabled(): Bool
    (* Raises nodes.irError (the bootstrap's AssertionError) if the unit
     * violates an invariant *)
    checkUnit(unit: nodes.Unit): Ok
end
