(* Quest Self-Hosted Compiler: IR Traversals Implementation *)

module walk : Walk
import
    questlang/ir/nodes : questlang/ir/Nodes
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
export
    Let Variable = nodes.Variable
    Let Atom = nodes.Atom
    Let Body = nodes.Body
    Let Stmt = nodes.Stmt
    Let Op = nodes.Op

    let intEqual(a: Int b: Int): Bool = a is b

    let statementBodies(s: Stmt): Array(Body) =
        case s
            when sIf with x then array of x.thenBody x.elseBody end
            when sSwitch with x then
                let bodies = vector.new(:Body)
                for i = 0 upto {extent x.cases - 1} do vector.append(:Body bodies x.cases[i].body) end
                if maybe.isSome(:Body x.elseBody) then vector.append(:Body bodies maybe.unwrap(:Body x.elseBody)) end
                vector.toArray(:Body bodies)
            when sInspect with x then
                let bodies = vector.new(:Body)
                for i = 0 upto {extent x.cases - 1} do vector.append(:Body bodies x.cases[i].body) end
                if maybe.isSome(:Body x.elseBody) then vector.append(:Body bodies maybe.unwrap(:Body x.elseBody)) end
                vector.toArray(:Body bodies)
            when sLoop with x then array of x.body end
            when sLetRec with x then array of x.body end
            when sTry with x then array of x.body x.handler end
            when sJoin with x then array of x.continuation x.body end
            else array of :Body end
        end

    let statementBinders(s: Stmt): Array(Variable) =
        case s
            when sLet with x then array of x.v end
            when sVarDecl with x then array of x.v end
            when sFuns with x then
                let vars = vector.new(:Variable)
                for i = 0 upto {extent x.functions - 1} do vector.append(:Variable vars x.functions[i].v) end
                vector.toArray(:Variable vars)
            when sLetRec with x then x.vars
            when sSwitch with x then
                let vars = vector.new(:Variable)
                for i = 0 upto {extent x.cases - 1} do
                    if maybe.isSome(:Variable x.cases[i].binder) then
                        vector.append(:Variable vars maybe.unwrap(:Variable x.cases[i].binder))
                    end
                end
                vector.toArray(:Variable vars)
            when sInspect with x then
                let vars = vector.new(:Variable)
                for i = 0 upto {extent x.cases - 1} do
                    for j = 0 upto {extent x.cases[i].binders - 1} do vector.append(:Variable vars x.cases[i].binders[j]) end
                end
                vector.toArray(:Variable vars)
            when sTry with x then array of x.exc end
            when sJoin with x then x.params
            else array of :Variable end
        end

    Let Uses = vector.T(Atom)

    let use(u: Uses a: Atom): Ok = vector.append(:Atom u a)
    let useVar(u: Uses v: Variable): Ok = use(u nodes.atomOfVar(v))
    let useOpt(u: Uses a: maybe.T(Atom)): Ok = if maybe.isSome(:Atom a) then use(u maybe.unwrap(:Atom a)) end
    let useAll(u: Uses atoms: Array(Atom)): Ok = for i = 0 upto {extent atoms - 1} do use(u atoms[i]) end

    let opUses(o: Op): Array(Atom) =
        begin
            let u = vector.new(:Atom)
            case o
                when opAtom with x then use(u x.atom)
                when opPrim with x then useAll(u x.args)
                when opCall with x then
                    begin
                        if maybe.isSome(:Variable x.callee) then useVar(u maybe.unwrap(:Variable x.callee)) end
                        useAll(u x.args)
                    end
                when opTypeApp with x then
                    if maybe.isSome(:Variable x.callee) then useVar(u maybe.unwrap(:Variable x.callee)) end
                when opCallExternal with x then useAll(u x.args)
                when opMakeClosure with x then useAll(u x.captures)
                when opEnvField with x then use(u x.env)
                when opConvert with x then use(u x.value)
                when opMakeTuple with x then useAll(u x.args)
                when opTupleField with x then use(u x.tup)
                when opMakeRecord with x then for i = 0 upto {extent x.fields - 1} do use(u x.fields[i].atom) end
                when opRecordField with x then use(u x.recordAtom)
                when opMakeVariant with x then useOpt(u x.payload)
                when opMakeOption with x then begin useOpt(u x.payload) useOpt(u x.ordinalAtom) end
                when opIsTag with x then use(u x.value)
                when opPayload with x then use(u x.value)
                when opOrdinal with x then use(u x.value)
                when opMakeArray with x then useAll(u x.args)
                when opArrayRep with x then begin use(u x.count) use(u x.init) end
                when opIndex with x then begin use(u x.arr) use(u x.index) end
                when opMakeAuto with x then use(u x.payload)
                when opExceptionPayload with x then use(u x.exc)
                when opCaughtException with x then use(u x.exc)
                when opAddrVar with x then useVar(u x.v)
                when opAddrCell with x then use(u x.init)
                when opAddrField with x then use(u x.base)
                when opAddrComponent with x then use(u x.base)
                when opAddrElement with x then begin use(u x.base) use(u x.index) end
                when opLoad with x then use(u x.address)
                else ok
            end
            vector.toArray(:Atom u)
        end

    let statementUses(s: Stmt): Array(Atom) =
        case s
            when sLet with x then opUses(x.value)
            when sDo with x then opUses(x.value)
            when sVarDecl with x then if maybe.isSome(:Atom x.init) then array of maybe.unwrap(:Atom x.init) end else array of :Atom end end
            when sAssign with x then array of nodes.atomOfVar(x.v) x.value end
            when sStoreAt with x then array of x.value x.address end
            when sStoreField with x then array of x.value x.base end
            when sStoreComponent with x then array of x.value x.base end
            when sStoreElement with x then array of x.value x.base x.index end
            when sIf with x then array of x.cond end
            when sSwitch with x then array of x.value end
            when sInspect with x then array of x.value end
            when sEcho with x then array of x.value end
            when sReturn with x then array of x.value end
            when sJump with x then x.args
            when sRaise with x then
                if maybe.isSome(:Atom x.payload) then array of x.exc maybe.unwrap(:Atom x.payload) end else array of x.exc end end
            when sReraise with x then array of nodes.atomOfVar(x.exc) end
            when sTry with x then x.catches
            else array of :Atom end
        end

    let walkStatements(body: Body intoFunctions: Bool): vector.T(Stmt) =
        begin
            let found = vector.new(:Stmt)
            let rec visit(b: Body): Ok =
                for i = 0 upto {vector.length(:Stmt b.statements) - 1} do
                    let s = vector.get(:Stmt b.statements i)
                    vector.append(:Stmt found s)
                    if intoFunctions then
                        case s
                            when sFuns with x then for j = 0 upto {extent x.functions - 1} do visit(x.functions[j].body) end
                            else ok
                        end
                    end
                    let bodies = statementBodies(s)
                    for j = 0 upto {extent bodies - 1} do visit(bodies[j]) end
                end
            visit(body)
            found
        end

    Let Rename = All(v: Variable) Variable

    let atom(a: Atom f: Rename): Atom =
        case a
            when atomVar with x then
                let v = f(x.v)
                if nodes.same(v x.v) then a else nodes.atomOfVar(v) end
            else a
        end

    let atoms(items: Array(Atom) f: Rename): Array(Atom) =
        begin
            let mapped = vector.new(:Atom)
            for i = 0 upto {extent items - 1} do vector.append(:Atom mapped atom(items[i] f)) end
            vector.toArray(:Atom mapped)
        end

    let optAtom(a: maybe.T(Atom) f: Rename): maybe.T(Atom) =
        if maybe.isSome(:Atom a) then maybe.some(:Atom atom(maybe.unwrap(:Atom a) f)) else a end

    let optVar(v: maybe.T(Variable) f: Rename): maybe.T(Variable) =
        if maybe.isSome(:Variable v) then maybe.some(:Variable f(maybe.unwrap(:Variable v))) else v end

    let descriptor(d: nodes.Descriptor f: Rename): nodes.Descriptor =
        case d
            when descVar with x then option descVar of nodes.Descriptor with let v = f(x.v) end
            else d
        end

    let optDescriptor(d: maybe.T(nodes.Descriptor) f: Rename): maybe.T(nodes.Descriptor) =
        if maybe.isSome(:nodes.Descriptor d) then maybe.some(:nodes.Descriptor descriptor(maybe.unwrap(:nodes.Descriptor d) f)) else d end

    let descriptors(items: Array(nodes.Descriptor) f: Rename): Array(nodes.Descriptor) =
        begin
            let mapped = vector.new(:nodes.Descriptor)
            for i = 0 upto {extent items - 1} do vector.append(:nodes.Descriptor mapped descriptor(items[i] f)) end
            vector.toArray(:nodes.Descriptor mapped)
        end

    let vars(items: Array(Variable) f: Rename): Array(Variable) =
        begin
            let mapped = vector.new(:Variable)
            for i = 0 upto {extent items - 1} do vector.append(:Variable mapped f(items[i])) end
            vector.toArray(:Variable mapped)
        end

    (* A map of atoms, for the atoms a node holds *)
    Let AtomMap = All(a: Atom) Atom

    let mapAtoms(items: Array(Atom) g: AtomMap): Array(Atom) =
        begin
            let mapped = vector.new(:Atom)
            for i = 0 upto {extent items - 1} do vector.append(:Atom mapped g(items[i])) end
            vector.toArray(:Atom mapped)
        end

    let mapOptAtom(a: maybe.T(Atom) g: AtomMap): maybe.T(Atom) =
        if maybe.isSome(:Atom a) then maybe.some(:Atom g(maybe.unwrap(:Atom a))) else a end

    let mapInOp(o: Op f: Rename g: AtomMap): Ok =
        case o
            when opAtom with x then x.atom := g(x.atom)
            when opPrim with x then
                begin
                    x.args := mapAtoms(x.args g)
                    x.descriptor := optDescriptor(x.descriptor f)
                end
            when opCall with x then
                begin
                    x.callee := optVar(x.callee f)
                    x.args := mapAtoms(x.args g)
                    x.descriptors := descriptors(x.descriptors f)
                end
            when opTypeApp with x then
                begin
                    x.callee := optVar(x.callee f)
                    x.descriptors := descriptors(x.descriptors f)
                end
            when opCallExternal with x then
                begin
                    x.args := mapAtoms(x.args g)
                    x.descriptors := descriptors(x.descriptors f)
                end
            when opMakeClosure with x then
                begin
                    x.captures := mapAtoms(x.captures g)
                    x.descriptors := descriptors(x.descriptors f)
                end
            when opEnvField with x then x.env := g(x.env)
            when opConvert with x then x.value := g(x.value)
            when opMakeTuple with x then x.args := mapAtoms(x.args g)
            when opTupleField with x then
                begin
                    x.tup := g(x.tup)
                    x.viewMap := optVar(x.viewMap f)
                end
            when opMakeRecord with x then
                begin
                    let fields = vector.new(:nodes.FieldAtom)
                    for i = 0 upto {extent x.fields - 1} do
                        let fa = x.fields[i]
                        vector.append(:nodes.FieldAtom fields
                            tuple let name = fa.name let atom = g(fa.atom) let isVar = fa.isVar end)
                    end
                    x.fields := vector.toArray(:nodes.FieldAtom fields)
                    x.descriptor := optDescriptor(x.descriptor f)
                    x.viewDescriptor := optDescriptor(x.viewDescriptor f)
                end
            when opRecordField with x then
                begin
                    x.recordAtom := g(x.recordAtom)
                    x.descriptor := optDescriptor(x.descriptor f)
                    x.viewMap := optVar(x.viewMap f)
                end
            when opMakeVariant with x then x.payload := mapOptAtom(x.payload g)
            when opMakeOption with x then
                begin
                    x.payload := mapOptAtom(x.payload g)
                    x.ordinalAtom := mapOptAtom(x.ordinalAtom g)
                end
            when opIsTag with x then
                begin
                    x.value := g(x.value)
                    x.viewMap := optVar(x.viewMap f)
                end
            when opPayload with x then
                begin
                    x.value := g(x.value)
                    x.viewMap := optVar(x.viewMap f)
                end
            when opOrdinal with x then
                begin
                    x.value := g(x.value)
                    x.viewMap := optVar(x.viewMap f)
                end
            when opMakeArray with x then x.args := mapAtoms(x.args g)
            when opArrayRep with x then
                begin
                    x.count := g(x.count)
                    x.init := g(x.init)
                end
            when opIndex with x then
                begin
                    x.arr := g(x.arr)
                    x.index := g(x.index)
                end
            when opMakeAuto with x then
                begin
                    x.payload := g(x.payload)
                    x.descriptor := optDescriptor(x.descriptor f)
                end
            when opExceptionPayload with x then x.exc := g(x.exc)
            when opCaughtException with x then x.exc := g(x.exc)
            when opAddrVar with x then x.v := f(x.v)
            when opAddrCell with x then x.init := g(x.init)
            when opAddrField with x then
                begin
                    x.base := g(x.base)
                    x.viewMap := optVar(x.viewMap f)
                end
            when opAddrComponent with x then
                begin
                    x.base := g(x.base)
                    x.viewMap := optVar(x.viewMap f)
                end
            when opAddrElement with x then
                begin
                    x.base := g(x.base)
                    x.index := g(x.index)
                end
            when opLoad with x then x.address := g(x.address)
            else ok
        end

    let mapInStmt(s: Stmt f: Rename g: AtomMap): Ok =
        case s
            when sLet with x then
                begin
                    x.v := f(x.v)
                    mapInOp(x.value f g)
                end
            when sVarDecl with x then
                begin
                    x.v := f(x.v)
                    x.init := mapOptAtom(x.init g)
                end
            when sAssign with x then
                begin
                    x.v := f(x.v)
                    x.value := g(x.value)
                end
            when sStoreAt with x then
                begin
                    x.value := g(x.value)
                    x.address := g(x.address)
                end
            when sStoreField with x then
                begin
                    x.value := g(x.value)
                    x.base := g(x.base)
                    x.viewMap := optVar(x.viewMap f)
                end
            when sStoreComponent with x then
                begin
                    x.value := g(x.value)
                    x.base := g(x.base)
                    x.viewMap := optVar(x.viewMap f)
                end
            when sStoreElement with x then
                begin
                    x.value := g(x.value)
                    x.base := g(x.base)
                    x.index := g(x.index)
                end
            when sDo with x then mapInOp(x.value f g)
            when sLetRec with x then x.vars := vars(x.vars f)
            when sIf with x then x.cond := g(x.cond)
            when sSwitch with x then
                begin
                    x.value := g(x.value)
                    x.viewMap := optVar(x.viewMap f)
                end
            when sInspect with x then x.value := g(x.value)
            when sTry with x then
                begin
                    x.exc := f(x.exc)
                    x.catches := mapAtoms(x.catches g)
                end
            when sJoin with x then x.params := vars(x.params f)
            when sEcho with x then
                begin
                    x.value := g(x.value)
                    x.descriptor := optDescriptor(x.descriptor f)
                end
            when sReturn with x then x.value := g(x.value)
            when sJump with x then x.args := mapAtoms(x.args g)
            when sRaise with x then
                begin
                    x.exc := g(x.exc)
                    x.payload := mapOptAtom(x.payload g)
                end
            when sReraise with x then x.exc := f(x.exc)
            else ok
        end

    let replaceVarsInOp(o: Op f: Rename): Ok = mapInOp(o f fun(a: Atom): Atom atom(a f))
    let replaceVarsInStmt(s: Stmt f: Rename): Ok = mapInStmt(s f fun(a: Atom): Atom atom(a f))

    let globalVariables(unit: nodes.Unit): hashMap.T(Int Bool) =
        begin
            (* The variables each top level binds outside loops and functions,
             * by the index of the top level (a module's initializer, or the
             * main body after them) *)
            let bound = hashMap.new(:Int :Int intEqual hash.int)
            let rec visit(b: Body where: Int): Ok =
                for i = 0 upto {vector.length(:Stmt b.statements) - 1} do
                    let s = vector.get(:Stmt b.statements i)
                    let binders = statementBinders(s)
                    for j = 0 upto {extent binders - 1} do hashMap.insert(:Int :Int bound binders[j].id where) end
                    if not(s?sLoop) then
                        let bodies = statementBodies(s)
                        for j = 0 upto {extent bodies - 1} do visit(bodies[j] where) end
                    end
                end
            let n = vector.length(:nodes.Module unit.modules)
            for i = 0 upto {n - 1} do visit(vector.get(:nodes.Module unit.modules i).init i) end
            visit(unit.main n)
            (* Of those, the ones named where they are not bound: by a function
             * (where is ~1), or by another top level *)
            let found = hashMap.new(:Int :Bool intEqual hash.int)
            let note(v: Variable where: Int): Ok =
                begin
                    let b = hashMap.get(:Int :Int bound v.id)
                    if maybe.isSome(:Int b) andif {{where < 0} orif {maybe.unwrap(:Int b) isnot where}} then
                        hashMap.insert(:Int :Bool found v.id true)
                    end
                end
            let rec names(b: Body where: Int): Ok =
                begin
                    let stmts = walkStatements(b false)
                    for i = 0 upto {vector.length(:Stmt stmts) - 1} do
                        let s = vector.get(:Stmt stmts i)
                        replaceVarsInStmt(s fun(v: Variable): Variable begin note(v where) v end)
                        case s
                            when sFuns with x then
                                for j = 0 upto {extent x.functions - 1} do names(x.functions[j].body ~1) end
                            else ok
                        end
                    end
                end
            for i = 0 upto {n - 1} do names(vector.get(:nodes.Module unit.modules i).init i) end
            names(unit.main n)
            for i = 0 upto {vector.length(:nodes.Function unit.functions) - 1} do
                names(vector.get(:nodes.Function unit.functions i).body ~1)
            end
            (* And a module's members, exports, and record, which other units
             * and the module's exported functions read *)
            let member(v: Variable): Ok =
                if hashMap.contains(:Int :Int bound v.id) then hashMap.insert(:Int :Bool found v.id true) end
            let members(ms: nodes.Members): Ok =
                for j = 0 upto {vector.length(:String ms.names) - 1} do
                    member(hashMap.find(:String :Variable ms.vars vector.get(:String ms.names j)))
                end
            for i = 0 upto {n - 1} do
                let m = vector.get(:nodes.Module unit.modules i)
                members(m.members)
                if maybe.isSome(:nodes.Members m.exports) then members(maybe.unwrap(:nodes.Members m.exports)) end
                if maybe.isSome(:Variable m.recordVar) then member(maybe.unwrap(:Variable m.recordVar)) end
            end
            found
        end
    let replaceAtomsInOp(o: Op g: AtomMap): Ok = mapInOp(o fun(v: Variable): Variable v g)
    let replaceAtomsInStmt(s: Stmt g: AtomMap): Ok = mapInStmt(s fun(v: Variable): Variable v g)

    let opViewMap(o: Op): maybe.T(Variable) =
        case o
            when opTupleField with x then x.viewMap
            when opRecordField with x then x.viewMap
            when opIsTag with x then x.viewMap
            when opPayload with x then x.viewMap
            when opOrdinal with x then x.viewMap
            when opAddrField with x then x.viewMap
            when opAddrComponent with x then x.viewMap
            else maybe.none(:Variable)
        end

    let stmtViewMap(s: Stmt): maybe.T(Variable) =
        case s
            when sStoreField with x then x.viewMap
            when sStoreComponent with x then x.viewMap
            when sSwitch with x then x.viewMap
            else maybe.none(:Variable)
        end

    let knownClosures(unit: nodes.Unit): hashMap.T(Int nodes.OpMakeClosure) =
        begin
            let same = fun(a: Int b: Int): Bool a is b
            let known = hashMap.new(:Int :nodes.OpMakeClosure same hash.int)
            let bodies = vector.new(:nodes.Body)
            vector.append(:nodes.Body bodies unit.main)
            for i = 0 upto {vector.length(:nodes.Module unit.modules) - 1} do
                vector.append(:nodes.Body bodies vector.get(:nodes.Module unit.modules i).init)
            end
            for i = 0 upto {vector.length(:nodes.Function unit.functions) - 1} do
                vector.append(:nodes.Body bodies vector.get(:nodes.Function unit.functions i).body)
            end
            let stmts = vector.new(:nodes.Stmt)
            for b = 0 upto {vector.length(:nodes.Body bodies) - 1} do
                let found = walkStatements(vector.get(:nodes.Body bodies b) false)
                for k = 0 upto {vector.length(:nodes.Stmt found) - 1} do
                    vector.append(:nodes.Stmt stmts vector.get(:nodes.Stmt found k))
                end
            end
            (* Each function's closures, by its id *)
            let closuresOf = hashMap.new(:Int :vector.T(nodes.OpMakeClosure) same hash.int)
            for k = 0 upto {vector.length(:nodes.Stmt stmts) - 1} do
                case vector.get(:nodes.Stmt stmts k)
                    when sLet with x then
                        case x.value
                            when opMakeClosure with c then
                                if not(hashMap.contains(:Int :vector.T(nodes.OpMakeClosure) closuresOf c.code.id)) then
                                    hashMap.insert(:Int :vector.T(nodes.OpMakeClosure) closuresOf c.code.id
                                        vector.new(:nodes.OpMakeClosure))
                                end
                                vector.append(:nodes.OpMakeClosure
                                    hashMap.find(:Int :vector.T(nodes.OpMakeClosure) closuresOf c.code.id) c)
                            else ok
                        end
                    else ok
                end
            end
            (* Each read of a lifted function's environment: the variable it
             * binds, the function, and the index *)
            Let Read = Tuple v: nodes.Variable function: Int index: Int end
            let reads = vector.new(:Read)
            for i = 0 upto {vector.length(:nodes.Function unit.functions) - 1} do
                let fn = vector.get(:nodes.Function unit.functions i)
                if maybe.isSome(:nodes.Variable fn.env) then
                    let env = maybe.unwrap(:nodes.Variable fn.env)
                    let found = walkStatements(fn.body false)
                    for k = 0 upto {vector.length(:nodes.Stmt found) - 1} do
                        case vector.get(:nodes.Stmt found k)
                            when sLet with x then
                                case x.value
                                    when opEnvField with y then
                                        case y.env
                                            when atomVar with e then
                                                if e.v.id is env.id then
                                                    vector.append(:Read reads tuple
                                                        let v = x.v let function = fn.id let index = y.index
                                                    end)
                                                end
                                            when atomConst then ok
                                        end
                                    else ok
                                end
                            else ok
                        end
                    end
                end
            end
            let note = fun(v: nodes.Variable c: nodes.OpMakeClosure): Bool
                if hashMap.contains(:Int :nodes.OpMakeClosure known v.id) then false
                else begin hashMap.insert(:Int :nodes.OpMakeClosure known v.id c) true end end
            let var changed = true
            while changed do
                changed := false
                for k = 0 upto {vector.length(:nodes.Stmt stmts) - 1} do
                    case vector.get(:nodes.Stmt stmts k)
                        when sLet with x then
                            case x.value
                                when opMakeClosure with c then if note(x.v c) then changed := true end
                                when opAtom with a then
                                    case a.atom
                                        when atomVar with y then
                                            let c = hashMap.get(:Int :nodes.OpMakeClosure known y.v.id)
                                            if maybe.isSome(:nodes.OpMakeClosure c) then
                                                if note(x.v maybe.unwrap(:nodes.OpMakeClosure c)) then
                                                    changed := true
                                                end
                                            end
                                        when atomConst then ok
                                    end
                                else ok
                            end
                        else ok
                    end
                end
                for r = 0 upto {vector.length(:Read reads) - 1} do
                    let read = vector.get(:Read reads r)
                    let cs = hashMap.get(:Int :vector.T(nodes.OpMakeClosure) closuresOf read.function)
                    if not(hashMap.contains(:Int :nodes.OpMakeClosure known read.v.id))
                        andif maybe.isSome(:vector.T(nodes.OpMakeClosure) cs) then
                        let closures = maybe.unwrap(:vector.T(nodes.OpMakeClosure) cs)
                        (* The closure every one captures at the index, if all
                         * capture closures of one function *)
                        let var agreed = maybe.none(:nodes.OpMakeClosure)
                        let var all = vector.length(:nodes.OpMakeClosure closures) > 0
                        for k = 0 upto {vector.length(:nodes.OpMakeClosure closures) - 1} do
                            let c = vector.get(:nodes.OpMakeClosure closures k)
                            let held = if read.index < extent c.captures then
                                case c.captures[read.index]
                                    when atomVar with y then hashMap.get(:Int :nodes.OpMakeClosure known y.v.id)
                                    when atomConst then maybe.none(:nodes.OpMakeClosure)
                                end
                            else maybe.none(:nodes.OpMakeClosure) end
                            if maybe.isNone(:nodes.OpMakeClosure held) then all := false
                            elsif maybe.isNone(:nodes.OpMakeClosure agreed) then agreed := held
                            elsif maybe.unwrap(:nodes.OpMakeClosure agreed).code.id
                                isnot maybe.unwrap(:nodes.OpMakeClosure held).code.id then
                                all := false
                            end
                        end
                        if all andif maybe.isSome(:nodes.OpMakeClosure agreed) then
                            if note(read.v maybe.unwrap(:nodes.OpMakeClosure agreed)) then changed := true end
                        end
                    end
                end
            end
            known
        end
end
