(* Quest Self-Hosted Compiler: The Describe Pass Implementation *)

module describe : Describe
import
    conv : Conv
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/common/maps : questlang/common/Maps
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/stages : questlang/ir/Stages
    questlang/ir/walk : questlang/ir/Walk
    questlang/modules/abstractTypes : questlang/modules/AbstractTypes
    questlang/repr/descriptors : questlang/repr/Descriptors
    questlang/repr/genericLayout : questlang/repr/GenericLayout
    questlang/repr/layout : questlang/repr/Layout
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/repr/written : questlang/repr/Written
    questlang/types/model : questlang/types/Model
    questlang/types/reduce : questlang/types/Reduce
export
    Let Type = model.Type
    Let Shape = shapes.Shape
    Let Variable = nodes.Variable
    Let Atom = nodes.Atom
    Let Body = nodes.Body
    Let Stmt = nodes.Stmt
    Let Op = nodes.Op
    Let Plan = nodes.Plan
    Let Descriptor = nodes.Descriptor

    (* Raised, as nodes.irError, when the pass cannot build a descriptor, such
     * as inside a generated adapter thunk for a type that mentions an
     * enclosing function's type parameter whose descriptor the thunk does not
     * receive *)
    let unsupported(A::TYPE message: String): A = nodes.internal(message)

    let eq(a: String b: String): Bool = stringOp.equal(a b)

    let typeOf(a: Atom): Type = nodes.atomType(a)

    (* Whether is compares options of t other than as one object: t is an
     * option type with a case without components (docs/extensions.md,
     * Options as Values) *)
    let comparesAsOption(t: Type): Bool =
        shapes.shape(t).kind?shapeOption andif begin
            let rule = reduce.optionIdentity(t)
            maybe.isSome(rule) andif {extent maybe.unwrap(:reduce.OptionIdentity rule).empty > 0}
        end

    (* The structure of layout.heldShape(t kind), raising nodes.irError
     * if t is not held at a shape of kind *)
    let heldStructure(t: Type kind: shapes.ShapeKind): Type =
        begin
            let h = layout.heldShape(t kind)
            if maybe.isNone(h) then
                unsupported(:Ok "not a " <> shapes.kindName(kind) <> ": " <> model.show(t))
            end
            maybe.unwrap(h).structure
        end

    let baseValueKind(kind: shapes.ShapeKind): String =
        case kind
            when shapeInt then "Int"
            when shapeReal then "Real"
            when shapeBool then "Bool"
            when shapeChar then "Char"
            when shapeString then "String"
            when shapeOk then "Ok"
            when shapeWord, shapeBottom, shapeTuple, shapeRecord, shapeVariant, shapeOption, shapeArray, shapeCell,
                    shapeOut, shapeException, shapeFun, shapeAll, shapeAuto, shapeTypevar, shapeAbstract, shapeExternal,
                    shapeOperator, shapePending then ""
        end

    let echoValueKind(t: Type): String =
        begin
            let s = shapes.opaqueShape(t)
            if shapes.kindIs(s shapes.shapeWord) then "Word"
            elsif shapes.kindIs(s shapes.shapeFun) orif shapes.kindIs(s shapes.shapeAll) then "fun"
            elsif shapes.kindIs(s shapes.shapeTypevar) orif {shapes.kindIs(s shapes.shapeAbstract)
                    andif not(s.structure.form?typeApp)} then "hidden"
            else baseValueKind(s.kind)
            end
        end

    let freeTypeVars(t: Type wanted: All(symbolId: Int) Bool): Array(Type) =
        begin
            let free = t.fv
            let var any = false
            for i = 0 upto {extent free - 1} do if wanted(free[i]) then any := true end end
            if not(any) then
                array of :Type end
            else
                let isFree = maps.newIntSet()
                for i = 0 upto {extent free - 1} do hashSet.insert(isFree free[i]) end
                let found = vector.new(:Type)
                let foundIds = maps.newIntSet()
                let seen = maps.newIntSet()
                let note = fun(node: Type symbolId: Int): Ok
                    if hashSet.contains(isFree symbolId) andif wanted(symbolId)
                            andif not(hashSet.contains(foundIds symbolId)) then
                        hashSet.insert(foundIds symbolId)
                        vector.append(found node)
                    end
                let rec visit(p: model.Part): Ok =
                    case p
                        when partType with x then
                            if not(hashSet.contains(seen x.t.id)) then
                                hashSet.insert(seen x.t.id)
                                case x.t.form
                                    when typeVariable with v then note(x.t v.symbolId)
                                    when typeAbstract with v then note(x.t v.symbolId)
                                    else ok
                                end
                                vector.forEach(model.typeParts(x.t) visit)
                            end
                        when partKind with x then
                            if not(hashSet.contains(seen x.k.id)) then
                                hashSet.insert(seen x.k.id)
                                vector.forEach(model.kindParts(x.k) visit)
                            end
                    end
                visit(option partType of model.Part with let t = t end)
                vector.toArray(found)
            end
        end

    let symbolOf(v: Type): Int =
        case v.form
            when typeVariable with x then x.symbolId
            when typeAbstract with x then x.symbolId
            else 0
        end

    let boundOf(v: Type): maybe.T(model.Kind) =
        case v.form
            when typeVariable with x then x.bound
            when typeAbstract with x then maybe.some(x.bound)
            else maybe.none()
        end

    let isConstantKind(kind: shapes.ShapeKind): Bool =
        case kind
            when shapeInt, shapeReal, shapeBool, shapeChar, shapeString, shapeOk, shapeWord then true
            when shapeBottom, shapeTuple, shapeRecord, shapeVariant, shapeOption, shapeArray, shapeCell, shapeOut,
                    shapeException, shapeFun, shapeAll, shapeAuto, shapeTypevar, shapeAbstract, shapeExternal,
                    shapeOperator, shapePending then false
        end

    (* Whether a template's descriptor is one of the runtime's own, whatever its
     * holes: a scalar's, a word's, the empty tuple's, or a bound type
     * parameter's placeholder *)
    let isConstant(template: Type): Bool =
        begin
            let s = shapes.opaqueShape(template)
            if isConstantKind(s.kind) orif maybe.isSome(descriptors.boundVarIndex(s.structure)) then
                true
            else
                case s.structure.form
                    when typeTuple with x then extent x.fields is 0
                    else false
                end
            end
        end

    (* Counts one more (by 1) or one fewer (by ~1) of v's uses in uses *)
    let use(uses: maps.IntMap(Int) v: Variable by: Int): Ok =
        begin hashMap.insert(uses v.id maybe.unwrapOr(hashMap.get(uses v.id) 0) + by) ok end
    let descStatic(d: nodes.StaticDescriptor): Descriptor = option descStatic of Descriptor with let d = d end

    (* The pass's state for a unit: the static data it lists, with the keys
     * by which each descriptor and table is listed only once (see static,
     * tagMap, and offsetTable), and the scope of the function, thunk, or
     * inspect arm being described *)
    Let Describer = Tuple
        unit: nodes.Unit
        data: nodes.StaticData
        staticKeys: maps.StringMap(nodes.StaticDescriptor)
        offsetKeys: maps.StringMap(nodes.OffsetTable)
        tagKeys: maps.StringMap(nodes.TagMap)
        (* The descriptor variables in scope, by the symbols of the type
         * parameters they describe, and the symbols of type parameters whose
         * descriptors are not available here (an enclosing function's, in a
         * thunk) *)
        var scope: maps.IntMap(Variable)
        var unavailable: maps.IntMap(Bool)
        (* The view maps of the function being described, by the symbols of
         * their type parameters, in order *)
        var viewMaps: maps.IntMap(nodes.ViewMapParam)
        var viewMapOrder: vector.T(nodes.ViewMapParam)
        (* Handlers' exception variables, which is compares as exceptions *)
        handlerVars: maps.IntSet
        (* How many descriptor operands (and view maps) name each descriptor
         * variable, by its id (unusedEnclosing) *)
        uses: maps.IntMap(Int)
    end

    let descVar(d: Describer v: Variable): Descriptor =
        begin
            use(d.uses v 1)
            option descVar of Descriptor with let v = v end
        end

    let newScope(): maps.IntMap(Variable) = maps.newIntMap()

    (* Returns a static descriptor operand for t (a closed type or a template)
     * and records its descriptor once in the unit's static data. Types with the
     * same shape share one static descriptor (keyed by "s" and the shape's id),
     * whereas an echo descriptor preserves the alias names written in the type,
     * so each type gets its own (keyed by "e" and the type's id). The returned
     * operand is a fresh node separate from the listed entry; a backend looks
     * up the listed entry by the operand's type, matching the bootstrap
     * compiler. *)
    let static(d: Describer t: Type echo: Bool): nodes.StaticDescriptor =
        begin
            let key = if echo then "e" <> conv.int(t.id) else "s" <> conv.int(shapes.opaqueShape(t).id) end
            if not(hashMap.contains(d.staticKeys key)) then
                let listed = nodes.newStaticDescriptor(t echo)
                hashMap.insert(d.staticKeys key listed)
                vector.append(d.data.descriptors listed)
            end
            nodes.newStaticDescriptor(t echo)
        end

    (* Raises nodes.irError if t mentions a type parameter whose
     * descriptor is unavailable here (in a thunk, one of the enclosing
     * function's, which the thunk is not passed) *)
    let checkAvailable(d: Describer t: Type): Ok =
        begin
            let missing = freeTypeVars(t fun(sid: Int): Bool
                hashMap.contains(d.unavailable sid) andif not(hashMap.contains(d.scope sid)))
            if extent missing > 0 then
                let names = vector.new(:String)
                for i = 0 upto {extent missing - 1} do
                    vector.append(names case missing[i].form
                        when typeVariable with x then x.name
                        when typeAbstract with x then x.name
                        else ""
                    end)
                end
                unsupported(:Ok
                        "C code generation: a thunk converts by the descriptor of '" <> model.show(t)
                    <> "', which mentions the type parameter " <> strutil.join(", " names)
                    <> " of the function it is made in, whose descriptor it is not passed")
            end
        end

    (* The descriptor of t with a hole for each of holes (type variables),
     * instantiated with args *)
    let template(d: Describer t: Type holes: Array(Type) args: Array(Descriptor)): Descriptor =
        if extent holes is 0 then
            descStatic(static(d t false))
        else
            let subst = model.newSubst()
            for i = 0 upto {extent holes - 1} do
                hashMap.insert(subst symbolOf(holes[i]) descriptors.holeVar(i boundOf(holes[i])))
            end
            let template = model.substitute(t subst)
            if isConstant(template) then
                descStatic(static(d template false))
            else
                static(d template false)
                option descInstantiate of Descriptor with let template = template let args = args end
            end
        end

    (* The descriptor of t here: a type parameter's variable, a closed type's
     * static descriptor, or the template of a type mentioning type parameters
     * in scope, instantiated with their descriptors *)
    let rec describeType(d: Describer t: Type): Descriptor =
        begin
            let v = shapes.opaqueShape(t).type
            let scoped =
                case v.form
                    when typeVariable with x then hashMap.get(d.scope x.symbolId)
                    when typeAbstract with x then hashMap.get(d.scope x.symbolId)
                    else maybe.none(:Variable)
                end
            if maybe.isSome(scoped) then
                descVar(d maybe.unwrap(scoped))
            else
                if not(hashMap.empty(d.unavailable)) then checkAvailable(d t) end
                let params = freeTypeVars(t fun(sid: Int): Bool hashMap.contains(d.scope sid))
                let args =
                    array of(extent params option descStatic of Descriptor with
                        let d = nodes.newStaticDescriptor(t false)
                    end)
                for i = 0 upto {extent params - 1} do
                    args[i] := descVar(d hashMap.find(d.scope symbolOf(params[i])))
                end
                template(d t params args)
            end
        end

    (* The descriptor of a polymorphic callee's type t laid out as the callee
     * lays it out at the call's type arguments *)
    let layoutDescriptor(d: Describer t: Type lay: nodes.PlanLayout): Descriptor =
        begin
            if not(hashMap.empty(d.unavailable)) then checkAvailable(d t) end
            let params = freeTypeVars(t fun(sid: Int): Bool hashMap.contains(lay.subst sid))
            let inScope = freeTypeVars(t fun(sid: Int): Bool
                hashMap.contains(d.scope sid) andif not(hashMap.contains(lay.subst sid)))
            let holes = vector.fromArray(params)
            let args = vector.new(:Descriptor)
            for i = 0 upto {extent params - 1} do
                vector.append(args describeType(d hashMap.find(lay.subst symbolOf(params[i]))))
            end
            for i = 0 upto {extent inScope - 1} do
                vector.append(holes inScope[i])
                vector.append(args descVar(d hashMap.find(d.scope symbolOf(inScope[i]))))
            end
            template(d t vector.toArray(holes) vector.toArray(args))
        end

    (* Runs f in the scope of a thunk taking type parameters named by symbols,
     * with its descriptor parameters *)
    let thunk(d: Describer symbols: Array(Array(Int)) f: All(params: Array(nodes.DescriptorParam)) Ok): Ok =
        begin
            let made = vector.new(:nodes.DescriptorParam)
            for k = 0 upto {extent symbols - 1} do
                vector.append(made
                        tuple
                            let v = nodes.newVar("qd_" <> conv.int(k) nodes.descriptorType false)
                            let symbols = symbols[k]
                        end)
            end
            let params = vector.toArray(made)
            let savedScope = d.scope
            let savedUnavailable = d.unavailable
            let unavailable = maps.newIntMap(:Bool)
            hashMap.forEach(d.unavailable fun(k: Int b: Bool): Ok begin hashMap.insert(unavailable k b) ok end)
            hashMap.forEach(d.scope fun(k: Int v: Variable): Ok begin hashMap.insert(unavailable k true) ok end)
            let scope = newScope()
            for k = 0 upto {extent params - 1} do
                for j = 0 upto {extent params[k].symbols - 1} do
                    hashMap.insert(scope params[k].symbols[j] params[k].v)
                end
            end
            d.unavailable := unavailable
            d.scope := scope
            f(params)
            d.scope := savedScope
            d.unavailable := savedUnavailable
        end

    (* Static tables *)

    (* The tag map from the variant type source's tag numbering to its
     * supertype target's, listed once in the unit's static data for each pair
     * of shapes and shared by the plans that use it *)
    let tagMap(d: Describer target: Type source: Type): nodes.TagMap =
        begin
            let key = conv.int(shapes.shape(target).id) <> "," <> conv.int(shapes.shape(source).id)
            let found = hashMap.get(d.tagKeys key)
            if maybe.isSome(found) then
                maybe.unwrap(found)
            else
                let table = tuple let id = shapes.shape(target).id let target = target let source = source end
                hashMap.insert(d.tagKeys key table)
                vector.append(d.data.tagMaps table)
                table
            end
        end

    (* Returns the offset table for a record laid out as lay and viewed at view,
     * listing it once in the unit's static data for each pair of shapes. When
     * registered is true (both types are closed), the table also records static
     * descriptors for both types so the runtime can find it for dynamic values;
     * once registered, the table stays registered for every literal that shares
     * it. *)
    let offsetTable(d: Describer view: Type lay: Type registered: Bool): nodes.OffsetTable =
        begin
            let key = conv.int(shapes.shape(view).id) <> "," <> conv.int(shapes.shape(lay).id)
            let found = hashMap.get(d.offsetKeys key)
            let table =
                if maybe.isSome(found) then
                    maybe.unwrap(found)
                else
                    let t =
                        tuple
                            let id = shapes.shape(view).id
                            let view = view
                            let layout = lay
                            let var registered = maybe.none(:nodes.Registered)
                        end
                    hashMap.insert(d.offsetKeys key t)
                    vector.append(d.data.offsetTables t)
                    t
                end
            if registered andif maybe.isNone(table.registered) then
                table.registered :=
                        maybe.some(tuple let view = static(d view false) let layout = static(d lay false) end)
            end
            table
        end

    (* Plans *)

    (* Gives a plan (and the plans in it) the descriptors it converts by, in
     * place *)
    let rec describePlan(d: Describer p0: maybe.T(Plan)): Ok =
        if maybe.isSome(p0) then
            let p = maybe.unwrap(p0)
            case p.kind
                when planRecordView then
                    p.descriptors := array of describeType(d heldStructure(p.target shapes.shapeRecord)) end
                when planView then
                    p.descriptors :=
                        if maybe.isNone(p.layout) then
                            array of describeType(d p.source) describeType(d p.target) end
                        else
                            (* A value of an abstract type's application, laid out
                             * as its module's generic code lays out the
                             * representation (represent's abstractPlan) *)
                            let lay = maybe.unwrap(p.layout)
                            let abstractT = if lay.toGeneric then p.target else p.source end
                            let generic = maybe.unwrap(genericLayout.abstractInstance(abstractT)).generic
                            let genericD = layoutDescriptor(d generic lay)
                            if lay.toGeneric then array of describeType(d p.source) genericD end
                            else array of genericD describeType(d p.target) end
                            end
                        end
                when planRuntime then
                    let lay = maybe.unwrap(p.layout)
                    let genericType = if lay.toGeneric then p.target else p.source end
                    let genericD = layoutDescriptor(d genericType lay)
                    let nativeD = describeType(d model.substitute(genericType lay.subst))
                    p.descriptors := if lay.toGeneric then array of nativeD genericD end
                        else array of genericD nativeD end end
                when planVariantTags then
                    let map = tagMap(d heldStructure(p.target shapes.shapeVariant)
                            heldStructure(p.source shapes.shapeVariant))
                    p.tagMap := maybe.some(map)
                when planCopy then
                    for i = 0 upto {extent p.fields - 1} do describePlan(d p.fields[i]) end
                when planAdapt then
                    thunk(d p.thunkSymbols fun(params: Array(nodes.DescriptorParam)): Ok
                        begin
                            p.thunkParams := params
                            for i = 0 upto {extent p.fields - 1} do describePlan(d p.fields[i]) end
                        end)
                when planBox, planUnbox, planCast, planUnproxy, planSlotBox, planSlotUnbox then ok
            end
        end

    (* Bodies *)

    (* Returns the view map (a runtime mapping from a concrete type's layout to
     * its bound's layout) used to read a value of a type parameter in scope
     * bounded by a record, variant, option, or tuple type. Creates and records
     * the view map on the enclosing function on first use. *)
    let viewMap(d: Describer a: Atom): maybe.T(Variable) =
        begin
            let s = shapes.shape(typeOf(a))
            let held = layout.resolvedShape(s)
            let heldKind = shapes.kindIs(held shapes.shapeRecord) orif shapes.kindIs(held shapes.shapeVariant)
                orif shapes.kindIs(held shapes.shapeOption) orif shapes.kindIs(held shapes.shapeTuple)
            if not(layout.ownView(s)) orif not(heldKind) orif not(hashMap.contains(d.scope s.symbolId)) then
                maybe.none()
            else
                let found = hashMap.get(d.viewMaps s.symbolId)
                if maybe.isSome(found) then
                    maybe.some(maybe.unwrap(found).v)
                else
                    let name = if stringOp.isEmpty(s.name) then "t" else strutil.replace(s.name "." "_") end
                    let param = tuple
                        let v = nodes.newVar("view_" <> name nodes.viewMapType false)
                        let symbol = s.symbolId
                        let descriptor = hashMap.find(d.scope s.symbolId)
                        let bound = describeType(d held.structure)
                    end
                    use(d.uses param.descriptor 1)
                    hashMap.insert(d.viewMaps s.symbolId param)
                    vector.append(d.viewMapOrder param)
                    maybe.some(param.v)
                end
            end
        end

    let describeTypes(d: Describer types: Array(Type)): Array(Descriptor) =
        begin
            let result = vector.new(:Descriptor)
            for i = 0 upto {extent types - 1} do vector.append(result describeType(d types[i])) end
            vector.toArray(result)
        end

    (* How is compares values of a's type: a QVal word, a variant (by case and
     * value), and an option is compares by case, by their descriptor; a
     * record by its payload; anything else, and a handler's exception
     * variable (compared by the exception's address), by its words *)
    let identityOf(d: Describer a: Atom): nodes.Identity =
        begin
            let t = typeOf(a)
            let isHandler = case a when atomVar with y then hashSet.contains(d.handlerVars y.v.id) else false end
            if isHandler then
                nodes.identityWords
            else
                case layout.representationKind(t)
                    when repQVal then nodes.identityQVal
                    when repVariant then nodes.identityVariant
                    when repRecord then nodes.identityRecord
                    when repVoid, repInt, repWord, repBool, repChar, repReal, repPointer then
                        if comparesAsOption(t) then nodes.identityOption else nodes.identityWords end
                end
            end
        end

    let memberType(m: nodes.Module name: String): Type = hashMap.find(m.members.vars name).type

    (* Attaches the run-time descriptors and view maps needed by operation o in
     * place, where result is the variable bound by the enclosing let (none for
     * a do statement; docs/ir.md section 8.4):
     * - reads of a type parameter bounded by a record, variant, option, or
     *   tuple (field, component, tag, payload, ordinal, or address) get the
     *   view map they read through (viewMap);
     * - is and isnot get the operand type's descriptor when identity depends on
     *   the type: QVal (generic uniform-word) values (quest_val_is), options
     *   compared by case (quest_option_is, docs/extensions.md, Options as
     *   Values), and variants (QVariantVal). Handler exception variables are
     *   excluded because they are compared by the exception's address;
     * - calls, external calls, closures, and type applications get descriptors
     *   for their type arguments; a type application of a function also gets
     *   its thunk's descriptor variables for its plans;
     * - conversions describe their plans (describePlan);
     * - record literals get their concrete type's descriptor (stored in the
     *   record header) plus either a static offset table or, with run-time
     *   offsets, the view's descriptor so the runtime can look up the table;
     * - field reads marked stored (converted from a subtype's stored type) get
     *   the expected field type's descriptor;
     * - auto values get the descriptor of their witness (run-time type
     *   component). *)
    let operation(d: Describer o: Op result: maybe.T(Variable)): Ok =
        begin
            case o
                when opRecordField with x then x.viewMap := viewMap(d x.recordAtom)
                when opTupleField with x then x.viewMap := viewMap(d x.tup)
                when opAddrField with x then x.viewMap := viewMap(d x.base)
                when opAddrComponent with x then x.viewMap := viewMap(d x.base)
                when opIsTag with x then x.viewMap := viewMap(d x.value)
                when opPayload with x then x.viewMap := viewMap(d x.value)
                when opOrdinal with x then x.viewMap := viewMap(d x.value)
                else ok
            end
            case o
                when opPrim with x then
                    if nodes.comparesIdentity(x.op) andif {extent x.args > 0} then
                        x.identity := identityOf(d x.args[0])
                        case x.identity
                            when identityQVal, identityVariant, identityOption then
                                x.descriptor := maybe.some(describeType(d typeOf(x.args[0])))
                            when identityWords, identityRecord then ok
                        end
                    end
                when opCall with x then x.descriptors := describeTypes(d x.typeArgs)
                when opCallExternal with x then x.descriptors := describeTypes(d x.typeArgs)
                when opMakeClosure with x then x.descriptors := describeTypes(d x.typeArgs)
                when opTypeApp with x then
                    x.descriptors := describeTypes(d x.typeArgs)
                    let origType =
                        if maybe.isSome(x.callee) then
                            maybe.unwrap(x.callee).type
                        else
                            let fromModule =
                                if maybe.isSome(x.moduleRef) then
                                    case maybe.unwrap(x.moduleRef)
                                        when refModule with m then
                                            maybe.some(memberType(m.m maybe.unwrapOr(x.member "")))
                                        else maybe.none(:Type)
                                    end
                                else
                                    maybe.none(:Type)
                                end
                            if maybe.isSome(fromModule) then
                                maybe.unwrap(fromModule)
                            else
                                maybe.unwrapOr(x.calleeType model.okType)
                            end
                        end
                    if shapes.isFunction(origType) then
                        (* The instance is a thunk, whose plans convert its
                         * arguments and result *)
                        thunk(d x.thunkSymbols fun(params: Array(nodes.DescriptorParam)): Ok
                            begin
                                x.thunkParams := maybe.some(params)
                                for i = 0 upto {extent x.plans - 1} do describePlan(d x.plans[i]) end
                            end)
                    else
                        for i = 0 upto {extent x.plans - 1} do describePlan(d x.plans[i]) end
                    end
                when opConvert with x then describePlan(d maybe.some(x.plan))
                when opMakeRecord with x then
                    let fields =
                        array of(extent x.fields tuple let name = "" let type = model.okType let isVar = false end)
                    for i = 0 upto {extent x.fields - 1} do
                        fields[i] := tuple
                            let name = x.fields[i].name
                            let type = typeOf(x.fields[i].atom)
                            let isVar = x.fields[i].isVar
                        end
                    end
                    let concrete = model.recordType(fields maybe.none())
                    let held = layout.heldShape(maybe.unwrap(result).type shapes.shapeRecord)
                    let target = if maybe.isSome(held) then maybe.unwrap(held).structure else concrete end
                    x.descriptor := maybe.some(describeType(d concrete))
                    if x.runtimeOffsets then
                        x.viewDescriptor := maybe.some(describeType(d target))
                    else
                        let targetD = describeType(d target)
                        let registered = maybe.unwrap(x.descriptor)?descStatic andif targetD?descStatic
                        x.offsets := maybe.some(offsetTable(d target concrete registered))
                    end
                when opRecordField with x then
                    if x.stored then
                        let rs = maybe.unwrap(layout.heldShape(typeOf(x.recordAtom) shapes.shapeRecord))
                        let fields = shapes.sortedComponents(rs)
                        let var field = fields[0]
                        for i = {extent fields - 1} downto 0 do
                            if eq(maybe.unwrapOr(fields[i].name "") x.name) then field := fields[i] end
                        end
                        x.descriptor := maybe.some(describeType(d shapes.componentShape(field).type))
                    end
                when opMakeAuto with x then x.descriptor := maybe.some(describeType(d x.witness))
                else ok
            end
        end

    (* Gives inspect x of an auto value its descriptors, in place. An auto
     * value stores its components in a layout that does not depend on its
     * type component (docs/c-representation.md section 8.1): for Auto
     * A::TYPE with a: A show(:A): String end, a is a QVal word and show a
     * closure taking one, whatever A is, and a case at Int needs a as an Int
     * and show as a closure taking an Int.
     *
     * x.witness is a new descriptor variable standing for the value's type
     * component, its A (the C printer binds it to the value's type_desc).
     * Each case gets its matched type's descriptor, and the arm of a case
     * with binders gets a DescriptorPair per component the represent pass
     * marked converted (arm.converted; the others are copied), giving the
     * descriptors it is converted from and to:
     * - "component", a component of type A itself (a): from the witness to
     *   the case's type for it;
     * - "mentions", one whose type mentions A otherwise (show): from its stored
     *   type, A being the witness, to the case's type for it.
     * The arm's descriptors, and its plan's for an exact case, are described
     * with A's symbol bound to the witness. *)
    let describeInspect(d: Describer x: nodes.StmtInspect): Ok =
        if maybe.isSome(x.autoType) then
            let autoType = maybe.unwrap(x.autoType)
            let symbol = case autoType.form when typeAuto with a then a.symbolId else 0 end
            let witness =
                tuple let v = nodes.newVar("witness" nodes.descriptorType false) let symbols = array of symbol end end
            x.witness := maybe.some(witness)
            let storedType = model.autoPayloadType(autoType maybe.none())
            let storedFields =
                case storedType.form
                    when typeTuple with t then model.tupleValueFields(t.fields)
                    else array of :model.ValueField end
                end
            for i = 0 upto {extent x.cases - 1} do
                let c = x.cases[i]
                c.descriptor := maybe.some(describeType(d c.matchType))
                if {extent c.binders > 0} andif maybe.isSome(c.arm) then
                    let arm = maybe.unwrap(c.arm)
                    let armType = model.autoPayloadType(autoType maybe.some(c.matchType))
                    let armFields =
                        case armType.form
                            when typeTuple with t then model.tupleValueFields(t.fields)
                            else array of :model.ValueField end
                        end
                    let saved = d.scope
                    let scope = newScope()
                    hashMap.forEach(saved fun(k: Int v: Variable): Ok begin hashMap.insert(scope k v) ok end)
                    hashMap.insert(scope symbol witness.v)
                    d.scope := scope
                    let n =
                        if extent arm.converted < extent storedFields then
                            extent arm.converted
                        else
                            extent storedFields
                        end
                    let m = if n < extent armFields then n else extent armFields end
                    let pairs = array of(m maybe.none(:nodes.DescriptorPair))
                    for j = 0 upto {m - 1} do
                        let how = arm.converted[j]
                        pairs[j] :=
                            if maybe.isNone(how) then
                                maybe.none()
                            elsif eq(maybe.unwrap(how) "component") then
                                maybe.some(tuple
                                    let source = descVar(d witness.v)
                                    let target = describeType(d armFields[j].type)
                                end)
                            else
                                maybe.some(tuple
                                    let source = describeType(d storedFields[j].type)
                                    let target = describeType(d armFields[j].type)
                                end)
                            end
                    end
                    arm.descriptors := pairs
                    describePlan(d arm.plan)
                    d.scope := saved
                end
            end
        end

    let rec body(d: Describer b: Body): Ok =
        begin
            let statements = vector.new(:Stmt)
            for i = 0 upto {vector.length(b.statements) - 1} do
                vector.append(statements statement(d vector.get(b.statements i)))
            end
            b.statements := statements
        end

    (* Attaches the needed descriptors and view maps to s and its nested
     * statements in place, returning s or its replacement. An echo of a
     * package, whose output line is determined statically by its written type,
     * is replaced by sEchoText. *)
    and statement(d: Describer s: Stmt): Stmt =
        begin
            let var replaced = maybe.none(:Stmt)
            case s
                when sLet with x then operation(d x.value maybe.some(x.v))
                when sDo with x then operation(d x.value maybe.none())
                when sInspect with x then describeInspect(d x)
                when sTry with x then begin hashSet.insert(d.handlerVars x.exc.id) ok end
                when sStoreField with x then x.viewMap := viewMap(d x.base)
                when sStoreComponent with x then x.viewMap := viewMap(d x.base)
                when sSwitch with x then x.viewMap := viewMap(d x.value)
                when sEcho with x then
                    let text =
                        if stringOp.isEmpty(x.prefix) then maybe.none(:String) else written.packageText(x.type) end
                    if maybe.isSome(text) then
                        (* A package's components are hidden, so its line is
                         * known statically, from its type as written *)
                        replaced := maybe.some(option sEchoText of Stmt with
                            let text = x.prefix <> maybe.unwrap(text)
                        end)
                    elsif stringOp.isEmpty(echoValueKind(x.type)) then
                        let closed =
                            extent freeTypeVars(x.type fun(sid: Int): Bool hashMap.contains(:Int :Variable d.scope sid))
                                is 0
                        x.descriptor :=
                                maybe.some(if closed then
                                    descStatic(static(d x.type true))
                                else
                                    describeType(d x.type)
                                end)
                    end
                when sRaise with x then
                    (* The payload is shown by its type, written as echo
                     * writes a value *)
                    if maybe.isSome(x.payload) andif not(stringOp.isEmpty(x.payloadText)) then
                        let t = typeOf(maybe.unwrap(x.payload))
                        let closed =
                            extent freeTypeVars(t fun(sid: Int): Bool hashMap.contains(:Int :Variable d.scope sid)) is 0
                        x.descriptor :=
                                maybe.some(if closed then descStatic(static(d t true)) else describeType(d t) end)
                    end
                else ok
            end
            if maybe.isSome(replaced) then
                maybe.unwrap(replaced)
            else
                let bodies = walk.statementBodies(s)
                for i = 0 upto {extent bodies - 1} do body(d bodies[i]) end
                s
            end
        end

    (* Functions and modules *)

    (* Gives f a descriptor variable for each of its type parameters
     * (descriptor_<name>), describes its body in their scope, and sets
     * f.viewMaps to the view maps the body reads through, in the order first
     * needed *)
    let function(d: Describer f: nodes.Function): Ok =
        begin
            let made = vector.new(:nodes.DescriptorParam)
            for i = 0 upto {extent f.typeParams - 1} do
                let tp = f.typeParams[i]
                vector.append(made tuple
                    let v = nodes.newVar("descriptor_" <> tp.name nodes.descriptorType false)
                    let symbols = array of tp.symbolId
                    end
                end)
            end
            let params = vector.toArray(made)
            f.descriptorParams := params
            let scope = newScope()
            for i = 0 upto {extent params - 1} do hashMap.insert(scope params[i].symbols[0] params[i].v) end
            d.scope := scope
            d.viewMaps := maps.newIntMap()
            d.viewMapOrder := vector.new()
            body(d f.body)
            f.viewMaps := vector.toArray(d.viewMapOrder)
            d.viewMaps := maps.newIntMap()
            d.viewMapOrder := vector.new()
            d.scope := newScope()
        end

    (* A module's abstract types, each registered with its representation (an
     * operator's as a template whose holes are its parameters), for dynamic
     * values (docs/dynamic.md section 2.3) *)
    let abstractTypesOf(d: Describer canon: String): Array(nodes.AbstractTypeEntry) =
        begin
            let found = vector.new(:nodes.AbstractTypeEntry)
            let entries = abstractTypes.moduleAbstractTypes(canon)
            for i = 0 upto {extent entries - 1} do
                let entry = entries[i]
                let var rep = shapes.opaqueShape(maybe.unwrap(entry.rep)).type
                let var arity = 0
                let var kind =
                    case entry.typeVar.form when typeVariable with x then x.bound else maybe.none(:model.Kind) end
                let var more = true
                while more do
                    if maybe.isSome(kind) then
                        case maybe.unwrap(kind).form
                            when kindAll with k then
                                arity := arity + 1
                                kind := maybe.some(k.resultKind)
                            else more := false
                        end
                    else
                        more := false
                    end
                end
                let isTypeKind = maybe.isSome(kind) andif maybe.unwrap(kind).form?kindType
                let isPower = maybe.isSome(kind) andif maybe.unwrap(kind).form?kindPower
                let var usable = {isTypeKind orif isPower} andif not({arity > 0} andif isPower)
                if usable andif {arity > 0} then
                    case rep.form
                        when typeOperator with op then
                            if extent op.params isnot arity then
                                usable := false
                            else
                                let subst = model.newSubst()
                                for j = 0 upto {extent op.params - 1} do
                                    hashMap.insert(subst op.params[j].symbolId
                                            descriptors.holeVar(j maybe.some(op.params[j].bound)))
                                end
                                rep := model.substitute(op.body subst)
                            end
                        else usable := false
                    end
                end
                if usable then
                    vector.append(found tuple
                        let name = entry.globalName
                        let arity = arity
                        let descriptor = static(d rep false)
                    end)
                end
            end
            vector.toArray(found)
        end

    (* =========================================================================
     * Aggregate types declared in a unit's C output
     *
     * Collects the types of a unit's variables, function results, operations,
     * plans (and the types converted inside them), record literals, inspect-arm
     * payloads, imported interfaces, and offset tables in order of first
     * appearance. The traversal visits each node's fields in the same order as
     * the bootstrap compiler's walk.contents.
     * ====================================================================== *)

    (* Tracks visited type, IR node, and kind ids separately: kinds use the type
     * model's id counter and IR nodes use ir/nodes's, so a kind and a node can
     * share the same numeric id *)
    Let Collector = Tuple
        found: vector.T(Type)
        seenTypes: maps.IntSet
        seenNodes: maps.IntSet
        seenKinds: maps.IntSet
    end

    let add(c: Collector t: Type): Ok =
        if not(hashSet.contains(c.seenTypes t.id)) then
            hashSet.insert(c.seenTypes t.id)
            vector.append(c.found t)
        end

    let addOpt(c: Collector t: maybe.T(Type)): Ok = if maybe.isSome(t) then add(c maybe.unwrap(t)) end

    (* A node seen for the first time: its id noted *)
    let first(c: Collector id: Int): Bool =
        if hashSet.contains(c.seenNodes id) then false
        else begin hashSet.insert(c.seenNodes id) true end
        end

    let rec kindTypes(c: Collector k: model.Kind): Ok =
        if not(hashSet.contains(c.seenKinds k.id)) then
            hashSet.insert(c.seenKinds k.id)
            case k.form
                when kindPower with x then add(c x.bound)
                when kindAll with x then begin kindTypes(c x.paramKind) kindTypes(c x.resultKind) end
                else ok
            end
        end

    let variable(c: Collector v: Variable): Ok = if first(c v.id) then add(c v.type) end
    let optVariable(c: Collector v: maybe.T(Variable)): Ok = if maybe.isSome(v) then variable(c maybe.unwrap(v)) end
    let atom(c: Collector a: Atom): Ok = case a when atomVar with x then variable(c x.v) else ok end

    let rec descriptorTypes(c: Collector d: Descriptor): Ok =
        case d
            when descVar with x then variable(c x.v)
            when descStatic with x then add(c x.d.type)
            when descInstantiate with x then
                begin
                    add(c x.template)
                    for i = 0 upto {extent x.args - 1} do descriptorTypes(c x.args[i]) end
                end
        end

    let rec planTypes(c: Collector p0: maybe.T(Plan)): Ok =
        if maybe.isSome(p0) then
            let p = maybe.unwrap(p0)
            if first(c p.id) then
                add(c p.source)
                add(c p.target)
                for i = 0 upto {extent p.fields - 1} do planTypes(c p.fields[i]) end
                if maybe.isSome(p.layout) then
                    let lay = maybe.unwrap(p.layout)
                    for i = 0 upto {vector.length(lay.keys) - 1} do
                        add(c hashMap.find(lay.subst vector.get(lay.keys i)))
                    end
                end
            end
        end

    let rec moduleRefTypes(c: Collector r: nodes.ModuleRef): Ok =
        case r
            when refModule with x then moduleTypes(c x.m)
            when refImport with x then importTypes(c x.i)
        end

    and importTypes(c: Collector i: nodes.Import): Ok = if first(c i.id) then addOpt(c i.recordType) end

    and membersTypes(c: Collector m: nodes.Members): Ok =
        for i = 0 upto {vector.length(m.names) - 1} do
            variable(c hashMap.find(m.vars vector.get(m.names i)))
        end

    and moduleTypes(c: Collector m: nodes.Module): Ok =
        if first(c m.id) then
            bodyTypes(c m.init)
            membersTypes(c m.members)
            if maybe.isSome(m.exports) then membersTypes(c maybe.unwrap(m.exports)) end
            optVariable(c m.recordVar)
            for i = 0 upto {extent m.abstractTypes - 1} do add(c m.abstractTypes[i].descriptor.type) end
        end

    and functionTypes(c: Collector f: nodes.Function): Ok =
        if first(c f.id) then
            variable(c f.v)
            for i = 0 upto {extent f.typeParams - 1} do kindTypes(c f.typeParams[i].kind) end
            for i = 0 upto {extent f.params - 1} do variable(c f.params[i].v) end
            add(c f.resultType)
            bodyTypes(c f.body)
            optVariable(c f.env)
            for i = 0 upto {extent f.descriptorParams - 1} do variable(c f.descriptorParams[i].v) end
            for i = 0 upto {extent f.viewMaps - 1} do
                variable(c f.viewMaps[i].v)
                descriptorTypes(c f.viewMaps[i].bound)
            end
        end

    (* The visitor that adds the types of what a node holds (ir/walk), in
     * the order of its fields *)
    and holdings(c: Collector): walk.Visitor =
        begin
            let onAtom = fun(a: Atom): Ok atom(c a)
            let onVariable = fun(v: Variable): Ok variable(c v)
            let onBody = fun(b: Body): Ok bodyTypes(c b)
            let onFunction = fun(f: nodes.Function): Ok functionTypes(c f)
            let onType = fun(t: Type): Ok add(c t)
            let onPlan = fun(p: Plan): Ok planTypes(c maybe.some(p))
            let onModuleRef = fun(r: nodes.ModuleRef): Ok moduleRefTypes(c r)
            tuple
                let atom = onAtom
                let used = onVariable
                let binder = onVariable
                let body = onBody
                let function = onFunction
                let type = onType
                let plan = onPlan
                let moduleRef = onModuleRef
            end
        end

    (* A record literal's type, which no field holds, comes first *)
    and opTypes(c: Collector o: Op): Ok =
        begin
            case o
                when opMakeRecord with x then
                    let fields =
                        array of(extent x.fields tuple let name = "" let type = model.okType let isVar = false end)
                    for i = 0 upto {extent x.fields - 1} do
                        fields[i] := tuple
                            let name = x.fields[i].name
                            let type = typeOf(x.fields[i].atom)
                            let isVar = x.fields[i].isVar
                        end
                    end
                    add(c model.recordType(fields maybe.none()))
                else ok
            end
            walk.visitOp(o holdings(c))
        end

    (* As opTypes adds a record literal's type, an inspect of an auto value
     * adds its cases' payload types first, and a raise its payload's type
     * after the rest; a funs statement adds its functions' types alone *)
    and stmtTypes(c: Collector s: Stmt): Ok =
        case s
            when sLet with x then begin variable(c x.v) opTypes(c x.value) end
            when sDo with x then opTypes(c x.value)
            when sFuns with x then for i = 0 upto {extent x.functions - 1} do functionTypes(c x.functions[i]) end
            when sInspect with x then
                begin
                    if maybe.isSome(x.autoType) then
                        for i = 0 upto {extent x.cases - 1} do
                            if extent x.cases[i].binders > 0 then
                                add(c model.autoPayloadType(maybe.unwrap(x.autoType) maybe.some(x.cases[i].matchType)))
                            end
                        end
                    end
                    walk.visitStmt(s holdings(c))
                end
            when sRaise with x then
                begin
                    walk.visitStmt(s holdings(c))
                    if maybe.isSome(x.payload) andif not(stringOp.isEmpty(x.payloadText)) then
                        add(c typeOf(maybe.unwrap(x.payload)))
                    end
                end
            else walk.visitStmt(s holdings(c))
        end

    and bodyTypes(c: Collector b: Body): Ok =
        if first(c b.id) then
            for i = 0 upto {vector.length(b.statements) - 1} do stmtTypes(c vector.get(b.statements i)) end
        end

    (* The types a unit's C declares the aggregates of, in the order first
     * met *)
    let unitTypes(unit: nodes.Unit): Array(Type) =
        begin
            let c = tuple
                let found = vector.new(:Type)
                let seenTypes = maps.newIntSet()
                let seenNodes = maps.newIntSet()
                let seenKinds = maps.newIntSet()
            end
            for i = 0 upto {vector.length(unit.modules) - 1} do moduleTypes(c vector.get(unit.modules i)) end
            bodyTypes(c unit.main)
            for i = 0 upto {vector.length(unit.functions) - 1} do functionTypes(c vector.get(unit.functions i)) end
            for i = 0 upto {extent unit.imports - 1} do importTypes(c unit.imports[i]) end
            if maybe.isSome(unit.staticData) then
                let data = maybe.unwrap(unit.staticData)
                for i = 0 upto {vector.length(data.offsetTables) - 1} do
                    let table = vector.get(data.offsetTables i)
                    add(c table.view)
                    add(c table.layout)
                end
            end
            vector.toArray(c.found)
        end

    (* Removes enclosing type-parameter descriptors from a function and its
     * closures when the function never uses any of them. A closure that also
     * captures no values can then be emitted statically instead of allocated on
     * each creation (for example, a nested function that only passes enclosing
     * type-parameter values around as uniform words). Removing one function's
     * descriptors may make its enclosing function's descriptors unused as well,
     * so this repeats to a fixed point. *)
    let unusedEnclosing(unit: nodes.Unit uses: maps.IntMap(Int)): Ok =
        begin
            let closures = maps.newIntMap(:vector.T(nodes.OpMakeClosure))
            let collect = fun(b: Body): Ok
                begin
                    let stmts = walk.walkStatements(b false)
                    for i = 0 upto {vector.length(stmts) - 1} do
                        case vector.get(stmts i)
                            when sLet with x then
                                case x.value
                                    when opMakeClosure with c then
                                        if not(hashMap.contains(closures c.code.id)) then
                                            hashMap.insert(closures c.code.id vector.new())
                                        end
                                        vector.append(hashMap.find(closures c.code.id) c)
                                    else ok
                                end
                            else ok
                        end
                    end
                end
            for i = 0 upto {vector.length(unit.modules) - 1} do collect(vector.get(unit.modules i).init) end
            collect(unit.main)
            for i = 0 upto {vector.length(unit.functions) - 1} do collect(vector.get(unit.functions i).body) end
            let rec release(o: Descriptor): Ok =
                case o
                    when descVar with x then use(uses x.v ~1)
                    when descInstantiate with x then for i = 0 upto {extent x.args - 1} do release(x.args[i]) end
                    else ok
                end
            let var changed = true
            while changed do
                changed := false
                for i = 0 upto {vector.length(unit.functions) - 1} do
                    let f = vector.get(unit.functions i)
                    let captured = nodes.capturedDescriptors(f)
                    let var unused = {captured > 0} andif hashMap.contains(closures f.id)
                    for k = 0 upto {captured - 1} do
                        if maybe.unwrapOr(hashMap.get(uses f.descriptorParams[k].v.id) 0) > 0 then
                            unused := false
                        end
                    end
                    if unused then
                        let n = extent f.typeParams - captured
                        let typeParams = array of(n f.typeParams[0])
                        let descriptorParams = array of(n f.descriptorParams[0])
                        for k = 0 upto {n - 1} do
                            typeParams[k] := f.typeParams[captured + k]
                            descriptorParams[k] := f.descriptorParams[captured + k]
                        end
                        f.typeParams := typeParams
                        f.descriptorParams := descriptorParams
                        let made = hashMap.find(closures f.id)
                        let var captures = 0
                        for j = 0 upto {vector.length(made) - 1} do
                            let c = vector.get(made j)
                            for k = 0 upto {extent c.descriptors - 1} do release(c.descriptors[k]) end
                            c.typeArgs := array of :Type end
                            c.descriptors := array of :Descriptor end
                            captures := captures + extent c.captures
                        end
                        if captures is 0 then f.env := maybe.none() end
                        changed := true
                    end
                end
            end
        end

    let describeUnit(unit: nodes.Unit): nodes.Unit =
        begin
            let d = tuple
                let unit = unit
                let data = tuple
                    let descriptors = vector.new(:nodes.StaticDescriptor)
                    let offsetTables = vector.new(:nodes.OffsetTable)
                    let tagMaps = vector.new(:nodes.TagMap)
                    let types = vector.new(:Type)
                end
                let staticKeys = maps.newStringMap(:nodes.StaticDescriptor)
                let offsetKeys = maps.newStringMap(:nodes.OffsetTable)
                let tagKeys = maps.newStringMap(:nodes.TagMap)
                let var scope = newScope()
                let var unavailable = maps.newIntMap(:Bool)
                let var viewMaps = maps.newIntMap(:nodes.ViewMapParam)
                let var viewMapOrder = vector.new(:nodes.ViewMapParam)
                let handlerVars = maps.newIntSet()
                let uses = maps.newIntMap(:Int)
            end
            for i = 0 upto {vector.length(unit.modules) - 1} do
                let m = vector.get(unit.modules i)
                body(d m.init)
                m.abstractTypes := abstractTypesOf(d m.name)
            end
            body(d unit.main)
            for i = 0 upto {vector.length(unit.functions) - 1} do function(d vector.get(unit.functions i)) end
            unusedEnclosing(unit d.uses)
            (* Collect unit types before attaching staticData, matching the
             * bootstrap compiler *)
            let found = unitTypes(unit)
            for i = 0 upto {extent found - 1} do vector.append(d.data.types found[i]) end
            unit.staticData := maybe.some(d.data)
            unit.stage := stages.described
            unit
        end
end
