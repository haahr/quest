(* Quest Self-Hosted Compiler: Lowering to Core IR Implementation *)

module lower : Lower
import
    questlang/common/location : questlang/common/Location
    questlang/common/diagnostics : questlang/common/Diagnostics
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
    questlang/types/subtyping : questlang/types/Subtyping
    questlang/types/reduce : questlang/types/Reduce
    questlang/types/env : questlang/types/Env
    questlang/typechecker/typedAst : questlang/typechecker/TypedAst
    questlang/modules/elaboration : questlang/modules/Elaboration
    questlang/modules/stdlib : questlang/modules/Stdlib
    questlang/modules/paths : questlang/modules/Paths
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/repr/layout : questlang/repr/Layout
    questlang/repr/genericLayout : questlang/repr/GenericLayout
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    stringOp = string : StringOp
    conv : Conv
    questlang/ir/captures : questlang/ir/Captures
export
    Let Type = model.Type
    Let Expr = typedAst.Expr
    Let Binding = typedAst.Binding
    Let Variable = nodes.Variable
    Let Atom = nodes.Atom
    Let Body = nodes.Body
    Let Stmt = nodes.Stmt
    Let Op = nodes.Op

    let loweringError: Exception(String) = exception loweringError: String end

    let fail(A::TYPE message: String): A = raise loweringError with message end

    let intEqual(a: Int b: Int): Bool = a is b
    let eq(a: String b: String): Bool = stringOp.equal(a b)
    let isOk(t: Type): Bool = model.same(t model.okType)

    (* The built-in functions lowered to primitives: the infix operators, is,
     * isnot, not, extent, and ordinal *)
    let builtinFunction(name: String): Bool =
        maybe.isSome(env.infixOperator(name))
            orif eq(name "is") orif eq(name "isnot") orif eq(name "not") orif eq(name "extent") orif eq(name "ordinal")

    (* The standard library's array operations, which are lowered to the IR's *)
    let arrayOp(name: String): Bool = eq(name "new") orif eq(name "size") orif eq(name "get") orif eq(name "set")

    (* The standard library's module of a name, by its name or its name
     * lowercased *)
    let standardModuleName(name: String): maybe.T(String) =
        begin
            let var found = maybe.none(:String)
            let lowered = paths.lower(name)
            for i = 0 upto {extent stdlib.standardModules - 1} do
                let m = stdlib.standardModules[i][0]
                if eq(m name) orif eq(paths.lower(m) name) then found := maybe.some(m) end
            end
            if maybe.isNone(found) then
                for i = 0 upto {extent stdlib.standardModules - 1} do
                    let m = stdlib.standardModules[i][0]
                    if eq(m lowered) orif eq(paths.lower(m) lowered) then found := maybe.some(m) end
                end
            end
            found
        end

    let standardInterface(name: String): String =
        begin
            let var found = ""
            for i = 0 upto {extent stdlib.standardModules - 1} do
                if eq(stdlib.standardModules[i][0] name) then found := stdlib.standardModules[i][1] end
            end
            found
        end

    (* The parameter types of a function's variable's type (varType), as
     * written, for a function of count parameters and type funType, in the
     * function's own type parameters; none when they are not known *)
    let expectedParams(varType: Type funType: Type count: Int): maybe.T(Array(Type)) =
        begin
            let funQuants = case funType.form
                when typeAll with x then x.quantifiers
                else array of :model.Quantifier end
            end
            let collected = reduce.collectFunQuantifiers(varType)
            let quants = collected.quantifiers
            case collected.body.form
                when typeFun with inner then
                    if {extent quants isnot extent funQuants} orif {extent inner.params isnot count} then
                        maybe.none()
                    else
                        let subst = model.newSubst()
                        for i = 0 upto {extent quants - 1} do
                            hashMap.insert(subst quants[i].symbolId
                                model.typeVariable(funQuants[i].name funQuants[i].symbolId maybe.some(funQuants[i].bound)))
                        end
                        let types = array of(count model.okType)
                        for i = 0 upto {count - 1} do
                            types[i] := if hashMap.empty(subst) then inner.params[i].type
                                else model.substitute(inner.params[i].type subst) end
                        end
                        maybe.some(types)
                    end
                else maybe.none()
            end
        end

    (* The names of the cases of t as written, if it is an option type (or a
     * type parameter bounded by one) *)
    let optionCases(t: Type): maybe.T(Array(String)) =
        try maybe.some(reduce.optionCaseNames(t)) when reduce.notAnOption then maybe.none() end

    (* An element type of a Var or Out type, or the type *)
    let unref(t: Type): Type =
        case t.form
            when typeVar with x then x.element
            when typeOut with x then x.element
            else t
        end

    (* The state of lowering a unit's typed program (or module) to Core IR.
     *
     * Core IR (docs/ir.md) is flat: an operation's operands are atoms,
     * variables and constants, never nested expressions, so every
     * intermediate value is named by a let. Where control paths meet again,
     * as after an if expression's branches, the IR has a join point, a local
     * block that the paths jump to with their values. So
     *
     *     let abs(n: Int): Int = if n < 0 then 0 - n else n end;
     *
     * is lowered to (as --stop-after ir_core prints it)
     *
     *     fun abs(n: Int): Int {
     *       join k1(r: Int) {
     *         return r
     *       } in {
     *         let %1: Bool = prim <(n, 0)
     *         if %1 {
     *           let %2: Int = prim -(0, n)
     *           jump k1(%2)
     *         } else {
     *           jump k1(n)
     *         }
     *       }
     *     }
     *
     * Statements are appended to the current body, body, which a construct
     * with bodies of its own (the if's branches, a function, a join point)
     * replaces while it lowers them (inBody). The rest of the state:
     *
     * - vars, the IR variable of each typed-AST symbol whose binder has been
     *   lowered, and builtins, the builtin values' names by symbol;
     * - loops, the labels of the enclosing loops, innermost last: an exit
     *   expression leaves the innermost; labelCounts numbers the labels made;
     * - imports and moduleRefs, the modules the unit imports and defines;
     * - frame, the name of the code being lowered as exception tracebacks
     *   show it;
     * - echo and printResult, whether every phrase's result is printed
     *   (--echo) or only the last one's (--print-result), and sourceMap, the
     *   file in which the offsets of nodes that can raise are.
     *
     * value and effect, under Values and Effects below, are the entry points
     * for expressions. *)
    Let Earlier = Tuple holder: String field: String recordType: Type isVar: Bool boxed: Bool end

    Let Lowerer = Tuple
        vars: hashMap.T(Int Variable)
        builtins: hashMap.T(Int String)
        env: env.T
        echo: Bool
        printResult: Bool
        (* The source file's map, in which the offsets of the nodes that can
         * raise are *)
        sourceMap: maybe.T(location.SourceMap)
        (* The number of the file whose offsets these are in the unit
         * (nodes.fileOffset) *)
        file: Int
        (* The frame of the code being lowered, which names the functions it
         * makes *)
        var frame: String
        var body: Body
        (* The offset in the unit of the expression or binding being lowered,
         * the position of the statements it makes (nodes.stmtPos), or ~1 *)
        var pos: Int
        var loops: vector.T(String)
        labelCounts: hashMap.T(String Int)
        imports: vector.T(nodes.Import)
        (* The modules the unit defines and imports, by the symbols their names
         * bind *)
        moduleRefs: hashMap.T(Int nodes.ModuleRef)
        (* The local var variables that closures capture (capturedMutables),
         * and the boxes that hold those bound so far: a tuple of one var
         * component, which the frame and the closures share *)
        captured: hashMap.T(Int Bool)
        boxes: hashMap.T(Int Variable)
        (* In a phrase unit, the earlier inputs' bindings it may name, by
         * symbol, and the imports of those inputs' records, by number *)
        earlier: hashMap.T(Int Earlier)
        earlierImports: hashMap.T(String nodes.Import)
        (* What a phrase unit's declared modules' names begin with, so that
         * each input's are its own *)
        var modulePrefix: String
        (* Whether the unit is an interactive input's phrase unit, whose slots
         * are held in boxes (boxesSlot) *)
        var boxSlots: Bool
        (* Where each lowered module's initializer ends, by module id: its
         * init, or the continuation of a join it made (an if's value at its
         * top level), which the statements after its bindings go in *)
        moduleEnds: hashMap.T(Int Body)
    end

    let newLowerer(e: env.T sourceMap: maybe.T(location.SourceMap) file: Int echo: Bool printResult: Bool): Lowerer =
        begin
            let builtins = hashMap.new(:Int :String intEqual hash.int)
            hashMap.forEach(e.baseScope.values fun(name: String sym: symbols.ValueSymbol): Ok
                begin hashMap.insert(builtins sym.symbolId name) ok end)
            tuple
                let vars = hashMap.new(intEqual hash.int)
                let builtins = builtins
                let env = e
                let echo = echo
                let printResult = printResult
                let sourceMap = sourceMap
                let file = file
                let var frame = diagnostics.mainFrame
                let var body = nodes.newBody()
                let var pos = ~1
                let var loops = vector.new()
                let labelCounts = hashMap.new(stringOp.equal hash.string)
                let imports = vector.new()
                let moduleRefs = hashMap.new(intEqual hash.int)
                let captured = hashMap.new(intEqual hash.int)
                let boxes = hashMap.new(intEqual hash.int)
                let earlier = hashMap.new(intEqual hash.int)
                let earlierImports = hashMap.new(stringOp.equal hash.string)
                let var modulePrefix = ""
                let var boxSlots = false
                let moduleEnds = hashMap.new(intEqual hash.int)
            end
        end

    (* Building *)

    let va(v: Variable): Atom = nodes.atomOfVar(v)

    (* Appends s to the current body, at the current position if it has
     * none *)
    let emit(l: Lowerer s: Stmt): Ok =
        begin
            nodes.positionAt(s l.pos)
            vector.append(l.body.statements s)
        end

    (* f's result, with the statements it makes at offset, in the file being
     * lowered (at none for ~1) *)
    let at(A::TYPE l: Lowerer offset: Int f: All() A): A =
        begin
            let saved = l.pos
            l.pos := if offset < 0 then ~1 else nodes.fileOffset(l.file offset) end
            let result = f()
            l.pos := saved
            result
        end

    (* Emits a terminator; what follows it is unreachable, and goes into a body
     * that is discarded *)
    let terminate(l: Lowerer s: Stmt): Ok =
        begin
            emit(l s)
            l.body := nodes.newBody()
        end

    let fresh(hint: String t: Type isMutable: Bool): Variable = nodes.newVar(hint t isMutable)

    let label(l: Lowerer prefix: String): String =
        begin
            let n = maybe.unwrapOr(hashMap.get(l.labelCounts prefix) 0) + 1
            hashMap.insert(l.labelCounts prefix n)
            prefix <> conv.int(n)
        end

    let letVar(l: Lowerer o: Op t: Type into: maybe.T(Variable) hint: String): Variable =
        begin
            let v = if maybe.isSome(into) then maybe.unwrap(into) else fresh(hint t false) end
            emit(l nodes.letStmt(v o))
            v
        end

    let letOp(l: Lowerer o: Op t: Type into: maybe.T(Variable)): Atom = va(letVar(l o t into ""))

    let bindSymbol(l: Lowerer symbol: symbols.ValueSymbol t: maybe.T(Type) isMutable: Bool): Variable =
        begin
            if hashMap.contains(l.vars symbol.symbolId) then
                fail(:Ok "symbol '" <> symbol.name <> "' (#" <> conv.int(symbol.symbolId) <> ") is bound twice")
            end
            let v = fresh(symbol.name maybe.unwrapOr(t symbol.type) isMutable)
            hashMap.insert(l.vars symbol.symbolId v)
            v
        end

    (* Lowers into another body for the duration of f *)
    let inBody(l: Lowerer b: Body f: All() Ok): Ok =
        begin
            let saved = l.body
            l.body := b
            try
                f()
                l.body := saved
            when loweringError with message then
                l.body := saved
                fail(message)
            end
        end

    let const(value: nodes.ConstValue t: Type): Atom =
        nodes.atomOfConst(tuple let value = value let shape = shapes.shape(t) end)

    let okConst(): Atom = const(option constOk of nodes.ConstValue end model.okType)
    let intConst(n: Int): Atom = const(option constInt of nodes.ConstValue with let n = n end model.intType)
    let boolConst(b: Bool): Atom = const(option constBool of nodes.ConstValue with let b = b end model.boolType)

    let copyInto(l: Lowerer a: Atom into: maybe.T(Variable)): Atom =
        if maybe.isNone(into) then
            a
        else
            emit(l nodes.letStmt(maybe.unwrap(into) nodes.opOfAtom(a)))
            va(maybe.unwrap(into))
        end

    let some(v: Variable): maybe.T(Variable) = maybe.some(v)
    let none: maybe.T(Variable) = maybe.none()
    let offsetOf(l: Lowerer e: Expr): maybe.T(Int) = maybe.some(nodes.fileOffset(l.file e.offset))

    (* The variable of the value symbol of e, if it is a variable whose binder
     * the unit has *)
    let boundVar(l: Lowerer e: Expr): maybe.T(Variable) =
        case e.form
            when exprVar with x then hashMap.get(l.vars x.symbol.symbolId)
            else maybe.none()
        end

    (* An imported module, with the record type of the interface it is imported
     * through *)
    let makeImport(l: Lowerer name: String modulePath: String canonicalPath: String interfacePath: String): nodes.Import =
        begin
            let var scope = env.lookupModule(l.env canonicalPath)
            if maybe.isNone(scope) then scope := env.lookupModule(l.env modulePath) end
            if maybe.isNone(scope) then scope := env.lookupModule(l.env name) end
            if maybe.isNone(scope) then scope := env.lookupInterface(l.env interfacePath) end
            let recordType = if maybe.isSome(scope) then
                maybe.some(elaboration.buildRecordTypeFromScope(maybe.unwrap(scope) maybe.none(:String)))
            else
                maybe.none(:Type)
            end
            let source = env.resolveModule(l.env canonicalPath).source
            let libPath = if maybe.isSome(source) then paths.libModulePath(maybe.unwrap(source))
                else maybe.none(:String) end
            nodes.newImport(name modulePath canonicalPath interfacePath recordType libPath)
        end

    let phraseModuleName(number: Int): String = "qj_" <> conv.int(number)

    (* The slot a symbol is bound to (docs/repl.md section 6): the id of
     * the first symbol bound to it, which is the symbol's own but for an
     * interactive let that redefines an earlier one *)
    let slotOf(e: env.T symbolId: Int): Int = maybe.unwrapOr(hashMap.get(e.slots symbolId) symbolId)

    (* Whether a phrase unit holds a symbol's slot in a box: a one-component
     * var tuple, which every use reads and a redefinition stores to
     * (docs/jit.md section 3.2); one of type Ok has no words, and is
     * not held *)
    let boxesSlot(e: env.T sym: symbols.ValueSymbol): Bool =
        e.interactive andif hashMap.contains(e.slots sym.symbolId) andif not(isOk(sym.type))

    (* The earlier input's binding the symbol symbolId is, if it is one (in a
     * phrase unit), with the import of the record that holds it; a slot's is
     * its first symbol's *)
    let earlierBinding(l: Lowerer symbolId: Int): maybe.T(Tuple binding: Earlier ref: nodes.ModuleRef end) =
        begin
            let found = hashMap.get(l.earlier slotOf(l.env symbolId))
            if maybe.isNone(found) orif hashMap.contains(l.vars symbolId) then
                maybe.none()
            else
                let b = maybe.unwrap(found)
                if not(hashMap.contains(l.earlierImports b.holder)) then
                    let imp = nodes.newImport(b.holder b.holder b.holder "" maybe.some(b.recordType)
                        maybe.none())
                    hashMap.insert(l.earlierImports b.holder imp)
                    vector.append(l.imports imp)
                end
                let ref = option refImport of nodes.ModuleRef with
                    let i = hashMap.find(l.earlierImports b.holder)
                end
                maybe.some(tuple let binding = b let ref = ref end)
            end
        end

    (* The earlier input's binding e names, if it is one *)
    let earlierOf(l: Lowerer e: Expr): maybe.T(Tuple binding: Earlier ref: nodes.ModuleRef end) =
        case e.form
            when exprVar with x then earlierBinding(l x.symbol.symbolId)
            else maybe.none()
        end

    (* The type of a record's field *)
    let fieldType(recordType: Type name: String): Type =
        case recordType.form
            when typeRecord with r then
                begin
                    let var found = maybe.none(:Type)
                    for i = 0 upto {extent r.fields - 1} do
                        if eq(r.fields[i].name name) then found := maybe.some(r.fields[i].type) end
                    end
                    if maybe.isNone(found) then fail(:Ok "no field '" <> name <> "' in an earlier record") end
                    maybe.unwrap(found)
                end
            else fail("an earlier input's record is not a record")
        end

    (* The box holding the symbol symbolId, if it is held in one: a captured
     * var variable's (capturedMutables), or a slot's, the unit's own or an
     * earlier input's, read from its record *)
    let boxOfSymbol(l: Lowerer symbolId: Int): maybe.T(Variable) =
        begin
            let local = hashMap.get(l.boxes slotOf(l.env symbolId))
            let earlier = if maybe.isSome(local) then maybe.none(:Tuple binding: Earlier ref: nodes.ModuleRef end)
                else earlierBinding(l symbolId) end
            if maybe.isSome(earlier)
                andif maybe.unwrap(earlier).binding.boxed then
                let found = maybe.unwrap(earlier)
                maybe.some(letVar(l option opModuleMember of Op with
                    let var moduleRef = found.ref let var member = maybe.some(found.binding.field)
                end fieldType(found.binding.recordType found.binding.field) none ""))
            else
                local
            end
        end

    (* The box holding the variable e, if it is one held in a box *)
    let boxOf(l: Lowerer e: Expr): maybe.T(Variable) =
        case e.form
            when exprVar with x then boxOfSymbol(l x.symbol.symbolId)
            else maybe.none()
        end

    (* The module e refers to, if it is a reference to a module rather than a
     * value *)
    let moduleRefOf(l: Lowerer e: Expr): maybe.T(nodes.ModuleRef) =
        case e.form
            when exprVar with x then
                if hashMap.contains(l.vars x.symbol.symbolId) then
                    maybe.none()
                else
                    let found = hashMap.get(l.moduleRefs x.symbol.symbolId)
                    (* A module an earlier input declared or imported, whose
                     * record is its value: its entry has no field (the
                     * session's remember). An earlier input's value binding
                     * is a field of that input's record, and not a module *)
                    let declared = earlierBinding(l x.symbol.symbolId)
                    if maybe.isNone(found)
                        andif maybe.isSome(declared) andif eq(maybe.unwrap(declared).binding.field "") then
                        let d = maybe.unwrap(declared)
                        maybe.some(d.ref)
                    elsif maybe.isNone(found) andif model.bindsModule(x.name e.type) then
                        (* A standard library module, which a unit uses without
                         * importing it *)
                        let std = standardModuleName(x.name)
                        if maybe.isNone(std) then
                            fail(:Ok "module '" <> x.name <> "' (#" <> conv.int(x.symbol.symbolId) <> ") is neither defined nor imported")
                        end
                        let name = maybe.unwrap(std)
                        let imp = makeImport(l x.name name name standardInterface(name))
                        vector.append(l.imports imp)
                        let r = option refImport of nodes.ModuleRef with let i = imp end
                        hashMap.insert(l.moduleRefs x.symbol.symbolId r)
                        maybe.some(r)
                    else
                        found
                    end
                end
            else maybe.none()
        end

    (* The position among tupleType's components of the one named field, if
     * one is, or else of the one at index; raises loweringError if there is
     * none *)
    let tupleIndex(tupleType: Type index: Int field: maybe.T(String)): Int =
        begin
            (* A type parameter bounded by a tuple type is indexed as its
             * bound *)
            let s = layout.resolvedShape(shapes.shape(tupleType))
            if not(shapes.kindIs(s shapes.shapeTuple)) then fail(:Ok "tuple component of a "
                <> shapes.kindName(s.kind)) end
            let var found = ~1
            if maybe.isSome(field) then
                for i = 0 upto {extent s.components - 1} do
                    if {found < 0} andif maybe.isSome(s.components[i].name)
                        andif eq(maybe.unwrap(s.components[i].name) maybe.unwrap(field)) then
                        found := i
                    end
                end
            end
            if found >= 0 then
                found
            elsif {index >= 0} andif {index < extent s.components} then
                index
            else
                fail("tuple " <> model.show(tupleType) <> " has no component "
                    <> if maybe.isSome(field) then maybe.unwrap(field) else conv.int(index) end)
            end
        end

    Let Callee = Tuple callee: maybe.T(Variable) moduleRef: maybe.T(nodes.ModuleRef) member: maybe.T(String) end

    (* Values *)

    (* The atom that holds e's value, with e lowered into the current body at
     * its offset. With into, the value is bound to that variable and the atom
     * is it, so that a let binds its own variable rather than a copy; with
     * none, the atom may be a constant or an existing variable, and a fresh
     * variable is made only for an operation *)
    let rec value(l: Lowerer e: Expr into: maybe.T(Variable)): Atom =
        at(l e.offset fun(): Atom valueForm(l e into))
    and valueForm(l: Lowerer e: Expr into: maybe.T(Variable)): Atom =
        case e.form
            when exprInt with x then copyInto(l intConst(x.value) into)
            when exprReal with x then copyInto(l const(option constReal of nodes.ConstValue with let r = x.value end model.realType) into)
            when exprBool with x then copyInto(l boolConst(x.value) into)
            when exprChar with x then copyInto(l const(option constChar of nodes.ConstValue with let c = x.value end model.charType) into)
            when exprString with x then
                copyInto(l const(option constString of nodes.ConstValue with let s = x.value end model.stringType) into)
            when exprOk then copyInto(l okConst() into)
            when exprVar then varValue(l e into)
            when exprDerefCell with x then
                let target = boundVar(l x.target)
                let box = boxOf(l x.target)
                if maybe.isSome(box) then
                    letOp(l nodes.tupleField(va(maybe.unwrap(box)) 0) e.type into)
                elsif maybe.isSome(target) andif maybe.unwrap(target).isMutable then
                    (* Reading a mutable variable *)
                    copyInto(l va(maybe.unwrap(target)) into)
                else
                    letOp(l option opLoad of Op with let var address = value(l x.target none) end e.type into)
                end
            when exprExternal with x then letOp(l option opExternal of Op with let symbol = x.symbol end e.type into)
            when exprFun then
                let v = if maybe.isSome(into) then maybe.unwrap(into) else fresh("f" e.type false) end
                emit(l option sFuns of Stmt with let var functions = array of function(l e v maybe.none()) end let recursive = false end)
                va(v)
            when exprApp then call(l e into)
            when exprTypeApp then typeApplication(l e into)
            when exprInfix with x then
                let left = value(l x.left none)
                let right = value(l x.right none)
                letOp(l nodes.prim(nodes.primNamed(x.op) array of left right end offsetOf(l e)) e.type into)
            when exprRecord with x then
                let fields = vector.new(:nodes.FieldAtom)
                for i = 0 upto {extent x.fields - 1} do
                    let f = x.fields[i]
                    let a = value(l f.value none)
                    vector.append(fields tuple let name = f.name let atom = a let isVar = f.isVar end)
                end
                letOp(l nodes.makeRecord(vector.toArray(fields)) e.type into)
            when exprTuple then lowerTuple(l e into)
            when exprSelect with x then select(l e x.target x.field into)
            when exprIndex with x then
                let a = value(l x.target none)
                let i = value(l x.index none)
                letOp(l option opIndex of Op with let var arr = a let var index = i let offset = offsetOf(l e) end e.type into)
            when exprArray with x then
                let atoms = vector.new(:Atom)
                for i = 0 upto {extent x.elements - 1} do vector.append(atoms value(l x.elements[i] none)) end
                letOp(l option opMakeArray of Op with let var args = vector.toArray(atoms) end e.type into)
            when exprArrayRep with x then
                let n = value(l x.count none)
                let v = value(l x.initVal none)
                letOp(l option opArrayRep of Op with let var count = n let var init = v let offset = offsetOf(l e) end e.type into)
            when exprVarCell with x then
                letOp(l option opAddrCell of Op with let var init = value(l x.value none) end e.type into)
            when exprSelectRef with x then
                letOp(l option opAddrField of Op with
                    let var base = value(l x.target none)
                    let name = x.field
                    let var viewMap = maybe.none()
                end e.type into)
            when exprIndexRef with x then
                let a = value(l x.target none)
                let i = value(l x.index none)
                letOp(l option opAddrElement of Op with let var base = a let var index = i let offset = offsetOf(l e) end e.type into)
            when exprTupleSelectRef with x then
                if maybe.isSome(payloadBase(x.target)) then
                    payloadAddress(l e x.target tupleIndex(x.target.type x.index x.field) into)
                else
                    let t = value(l x.target none)
                    letOp(l option opAddrComponent of Op with
                        let var base = t
                        let index = tupleIndex(x.target.type x.index x.field)
                        let var access = nodes.direct
                        let var viewMap = maybe.none()
                    end e.type into)
                end
            when exprVariant with x then
                let p = if maybe.isSome(x.payload) then maybe.some(value(l maybe.unwrap(x.payload) none))
                    else maybe.none(:Atom) end
                letOp(l option opMakeVariant of Op with let tag = x.tag let var payload = p end e.type into)
            when exprOption with x then
                let ordinalAtom = if maybe.isSome(x.ordinalExpr) then
                    maybe.some(value(l maybe.unwrap(x.ordinalExpr) none))
                else
                    maybe.none(:Atom)
                end
                let p = if maybe.isSome(x.payload) then maybe.some(value(l maybe.unwrap(x.payload) none))
                    else maybe.none(:Atom) end
                let cases = if maybe.isSome(ordinalAtom) then reduce.optionCaseNames(e.type) else array of :String end end
                letOp(l nodes.makeOption(x.tag p ordinalAtom offsetOf(l e) cases) e.type into)
            when exprVariantCheck with x then letOp(l nodes.isTag(value(l x.target none) x.tag) e.type into)
            when exprVariantAssert then letOp(l payloadOp(l e value(l extractedOf(e) none)) e.type into)
            when exprAuto with x then
                letOp(l option opMakeAuto of Op with
                    let witness = x.witnessType
                    let autoType = x.autoType
                    let var payload = value(l x.payload none)
                    let var descriptor = maybe.none()
                end e.type into)
            when exprException with x then
                let made = option opMakeException of Op with let name = x.name let payloadType = x.payloadType end
                if maybe.isSome(x.symbol) then
                    let bound = bindSymbol(l maybe.unwrap(x.symbol) maybe.some(e.type) false)
                    emit(l nodes.letStmt(bound made))
                    copyInto(l va(bound) into)
                else
                    letOp(l made e.type into)
                end
            when exprBlock with x then
                for i = 0 upto {extent x.bindings - 1} do binding(l x.bindings[i] false) end
                value(l x.result into)
            when exprIf then branchValue(l e into)
            when exprCase then branchValue(l e into)
            when exprInspect then branchValue(l e into)
            when exprTry then branchValue(l e into)
            when exprWhile then begin effect(l e) copyInto(l okConst() into) end
            when exprLoop then begin effect(l e) copyInto(l okConst() into) end
            when exprFor then begin effect(l e) copyInto(l okConst() into) end
            when exprAssign then begin effect(l e) copyInto(l okConst() into) end
            when exprIndexAssign then begin effect(l e) copyInto(l okConst() into) end
            when exprRaise then
                begin
                    effect(l e)
                    (* Unreachable: the value is never used *)
                    letOp(l option opLoad of Op with let var address = okConst() end e.type into)
                end
            when exprExit then
                begin
                    effect(l e)
                    letOp(l option opLoad of Op with let var address = okConst() end e.type into)
                end
            else fail("lowering this expression is not implemented")
        end

    and branchValue(l: Lowerer e: Expr into: maybe.T(Variable)): Atom =
        if isOk(e.type) then
            begin
                effect(l e)
                copyInto(l okConst() into)
            end
        else
            joined(l e into)
        end

    and varValue(l: Lowerer e: Expr into: maybe.T(Variable)): Atom =
        case e.form
            when exprVar with x then
                let symbolId = x.symbol.symbolId
                let bound = hashMap.get(l.vars symbolId)
                let builtin = hashMap.get(l.builtins symbolId)
                let box = boxOfSymbol(l symbolId)
                if maybe.isSome(box) andif not(x.symbol.isVar) then
                    (* A slot's value is its box's component *)
                    letOp(l nodes.tupleField(va(maybe.unwrap(box)) 0) e.type into)
                elsif maybe.isSome(box) then
                    (* A boxed variable's address is its box's component's *)
                    letOp(l option opAddrComponent of Op with
                        let var base = va(maybe.unwrap(box)) let index = 0 let var access = nodes.direct
                        let var viewMap = maybe.none()
                    end e.type into)
                elsif maybe.isSome(bound) then
                    let v = maybe.unwrap(bound)
                    if v.isMutable then
                        (* A mutable variable not read through a dereference is
                         * passed by address *)
                        letOp(l option opAddrVar of Op with let var v = v end e.type into)
                    else
                        copyInto(l va(v) into)
                    end
                elsif maybe.isSome(earlierOf(l e)) then
                    (* An earlier input's binding is a field of its record; a
                     * var's address is its field's; one of type Ok is not in
                     * the record *)
                    let found = maybe.unwrap(earlierOf(l e))
                    if isOk(e.type) andif not(found.binding.isVar) then
                        copyInto(l okConst() into)
                    elsif found.binding.isVar then
                        let recordAtom = letOp(l option opModuleMember of Op with
                            let var moduleRef = found.ref let var member = maybe.none()
                        end found.binding.recordType none)
                        letOp(l option opAddrField of Op with
                            let var base = recordAtom let name = found.binding.field
                            let var viewMap = maybe.none()
                        end e.type into)
                    else
                        letOp(l option opModuleMember of Op with
                            let var moduleRef = found.ref let var member = maybe.some(found.binding.field)
                        end e.type into)
                    end
                elsif maybe.isSome(builtin) then
                    let name = maybe.unwrap(builtin)
                    if eq(name "true") orif eq(name "false") then
                        copyInto(l boolConst(eq(name "true")) into)
                    elsif eq(name "ok") then
                        copyInto(l okConst() into)
                    else
                        letOp(l option opBuiltin of Op with let name = name end e.type into)
                    end
                else
                    let m = moduleRefOf(l e)
                    if maybe.isSome(m) then
                        letOp(l option opModuleMember of Op with
                            let var moduleRef = maybe.unwrap(m)
                            let var member = maybe.none()
                        end e.type into)
                    else
                        fail("variable '" <> x.name <> "' (#" <> conv.int(symbolId) <> ") has no binder in the unit")
                    end
                end
            else fail("not a variable")
        end

    (* What a call or type application applies: a variable, or a module's
     * member *)
    and calleeOf(l: Lowerer func: Expr): Callee =
        begin
            let m = case func.form
                when exprSelect with x then moduleRefOf(l x.target)
                else maybe.none(:nodes.ModuleRef)
            end
            if maybe.isSome(m) then
                let field = case func.form when exprSelect with x then x.field else "" end
                tuple let callee = none let moduleRef = m let member = maybe.some(field) end
            else
                case value(l func none)
                    when atomVar with x then
                        tuple let callee = some(x.v) let moduleRef = maybe.none() let member = maybe.none() end
                    else fail("calling a constant")
                end
            end
        end

    (* A type application, f(:A)(:B) as one. Applied to fewer types than it
     * takes, a polymorphic function is a closure over the rest (and its value
     * parameters, if it has any), which applies it to all of them, since the
     * backend calls a polymorphic function with all its type arguments at
     * once. *)
    and typeApplication(l: Lowerer e: Expr into: maybe.T(Variable)): Atom =
        begin
            (* The applications' type arguments, innermost first *)
            let var func = e
            let levels = vector.new(:Array(Type))
            let var unwrapping = true
            while unwrapping do
                case func.form
                    when exprTypeApp with x then
                        vector.append(levels x.typeArgs)
                        func := x.func
                    else unwrapping := false
                end
            end
            let typeArgs = vector.new(:Type)
            for i = {vector.length(levels) - 1} downto 0 do
                let level = vector.get(levels i)
                for j = 0 upto {extent level - 1} do vector.append(typeArgs level[j]) end
            end
            let c = calleeOf(l func)
            let calleeType = if maybe.isSome(c.moduleRef) then maybe.some(func.type) else maybe.none(:Type) end
            let given = vector.toArray(typeArgs)
            if extent given >= extent reduce.collectFunQuantifiers(func.type).quantifiers then
                letOp(l nodes.typeApp(c.callee given c.moduleRef c.member calleeType) e.type into)
            else
                let rest = reduce.collectFunQuantifiers(e.type)
                let v = if maybe.isSome(into) then maybe.unwrap(into) else fresh("f" e.type false) end
                let typeParams = vector.new(:nodes.TypeParam)
                for i = 0 upto {extent rest.quantifiers - 1} do
                    let q = rest.quantifiers[i]
                    vector.append(typeParams tuple
                        let name = q.name
                        let symbolId = q.symbolId
                        let kind = q.bound
                        let bound = if model.isPower(q.bound) then maybe.some(shapes.shape(model.powerBound(q.bound)))
                            else maybe.none(:shapes.Shape) end
                    end)
                    vector.append(typeArgs model.typeVariable(q.name q.symbolId maybe.some(q.bound)))
                end
                let allTypeArgs = vector.toArray(typeArgs)
                let params = vector.new(:nodes.ParamEntry)
                let fbody = nodes.newBody()
                let resultType = case rest.body.form when typeFun with f then f.result else rest.body end
                inBody(l fbody fun(): Ok
                    begin
                        let result = case rest.body.form
                            when typeFun with f then
                                let args = vector.new(:Atom)
                                for i = 0 upto {extent f.params - 1} do
                                    let p = f.params[i]
                                    let mode = if p.isVar orif p.type.form?typeVar then "var"
                                        elsif p.isOut orif p.type.form?typeOut then "out" else "value" end
                                    let param = fresh(p.name unref(p.type) not(eq(mode "value")))
                                    vector.append(params tuple let v = param let mode = mode end)
                                    if eq(mode "value") then
                                        vector.append(args va(param))
                                    else
                                        let refType = if eq(mode "var") then model.varType(param.type) else model.outType(param.type) end
                                        vector.append(args letOp(l option opAddrVar of Op with let var v = param end refType none))
                                    end
                                end
                                letOp(l nodes.call(c.callee allTypeArgs vector.toArray(args) c.moduleRef c.member calleeType)
                                    f.result none)
                            else letOp(l nodes.typeApp(c.callee allTypeArgs c.moduleRef c.member calleeType) rest.body none)
                        end
                        terminate(l option sReturn of Stmt with let var pos = ~1 let var value = result end)
                    end)
                emit(l option sFuns of Stmt with
                    let var functions = array of
                        nodes.newFunction(v vector.toArray(typeParams) vector.toArray(params)
                            resultType fbody maybe.some(l.frame))
                    end
                    let recursive = false
                end)
                va(v)
            end
        end

    (* A call, e (into as for value). The type arguments of f(:A)(:B)(x) are
     * gathered into one list, A then B, since the backend passes all of a
     * function's type arguments at once. A call of a built-in function such
     * as (+) or not is its primitive operation, and one of ordinal an
     * opOrdinal; a call of a member of the standard library's arrayOp is the
     * array operation itself (arrayOperation); any other is an opCall of its
     * callee, a variable or a module's member, whose type as the call sees it
     * the call records (calleeType) *)
    and call(l: Lowerer e: Expr into: maybe.T(Variable)): Atom =
        case e.form
            when exprApp with app then
                let var func = app.func
                let typeArgs = vector.new(:Type)
                let var unwrapping = true
                while unwrapping do
                    case func.form
                        when exprTypeApp with x then
                            let combined = vector.fromArray(x.typeArgs)
                            for i = 0 upto {vector.length(typeArgs) - 1} do vector.append(combined vector.get(typeArgs i)) end
                            vector.clear(typeArgs)
                            for i = 0 upto {vector.length(combined) - 1} do vector.append(typeArgs vector.get(combined i)) end
                            func := x.func
                        else unwrapping := false
                    end
                end
                let builtin = case func.form
                    when exprVar with x then hashMap.get(l.builtins x.symbol.symbolId)
                    else maybe.none(:String)
                end
                if maybe.isSome(builtin) andif builtinFunction(maybe.unwrap(builtin)) then
                    let name = maybe.unwrap(builtin)
                    let args = vector.new(:Atom)
                    for i = 0 upto {extent app.args - 1} do vector.append(args value(l app.args[i] none)) end
                    let atoms = vector.toArray(args)
                    let o = if eq(name "ordinal") then
                        nodes.ordinalOf(atoms[0] reduce.optionCaseNames(app.args[0].type))
                    else
                        nodes.prim(nodes.primNamed(name) atoms offsetOf(l e))
                    end
                    letOp(l o e.type into)
                else
                    let c = calleeOf(l func)
                    let args = vector.new(:Atom)
                    for i = 0 upto {extent app.args - 1} do vector.append(args value(l app.args[i] none)) end
                    let atoms = vector.toArray(args)
                    let isArrayOp = if maybe.isSome(c.moduleRef) then
                        case maybe.unwrap(c.moduleRef)
                            when refImport with x then
                                eq(paths.lower(x.i.canonicalPath) "arrayop") andif arrayOp(maybe.unwrapOr(c.member ""))
                            else false
                        end
                    else
                        false
                    end
                    if isArrayOp then
                        arrayOperation(l maybe.unwrap(c.member) atoms e.type into offsetOf(l e))
                    else
                        let calleeType = if maybe.isSome(c.moduleRef) then maybe.some(func.type) else maybe.none(:Type) end
                        letOp(l nodes.call(c.callee vector.toArray(typeArgs) atoms c.moduleRef c.member calleeType) e.type into)
                    end
                end
            else fail("not a call")
        end

    (* A call of the standard library's arrayOp, as the array operation it is;
     * its errors are located at the call *)
    and arrayOperation(l: Lowerer member: String args: Array(Atom) t: Type into: maybe.T(Variable) offset: maybe.T(Int)): Atom =
        if eq(member "new") then
            letOp(l option opArrayRep of Op with let var count = args[0] let var init = args[1] let offset = offset end t into)
        elsif eq(member "size") then
            letOp(l nodes.prim(nodes.primExtent array of args[0] end maybe.none()) t into)
        elsif eq(member "get") then
            letOp(l option opIndex of Op with let var arr = args[0] let var index = args[1] let offset = offset end t into)
        else
            emit(l option sStoreElement of Stmt with
                let var pos = ~1
                let var value = args[2]
                let var base = args[0]
                let var index = args[1]
                let offset = offset
            end)
            copyInto(l okConst() into)
        end

    and select(l: Lowerer e: Expr target: Expr field: String into: maybe.T(Variable)): Atom =
        begin
            let m = moduleRefOf(l target)
            if maybe.isSome(m) then
                letOp(l option opModuleMember of Op with
                    let var moduleRef = maybe.unwrap(m)
                    let var member = maybe.some(field)
                end e.type into)
            else
                let base = value(l target none)
                let s = layout.resolvedShape(shapes.shape(target.type))
                case s.kind
                    when shapeTuple then
                        letOp(l nodes.tupleField(base tupleIndex(target.type ~1 maybe.some(field))) e.type into)
                    when shapeInt, shapeReal, shapeBool, shapeChar, shapeString, shapeOk, shapeWord, shapeBottom,
                        shapeRecord, shapeVariant, shapeOption, shapeArray, shapeCell, shapeOut, shapeException,
                        shapeFun, shapeAll, shapeAuto, shapeTypevar, shapeAbstract, shapeExternal, shapeOperator,
                        shapePending then
                        letOp(l nodes.recordField(base field) e.type into)
                end
            end
        end

    (* Lowers a tuple expression: each component is computed, in order, then
     * a make-tuple operation collects them (into, if given).
     *
     *     tuple let a = 1 let b = a + 1 end    let a: Int = 1
     *                                          let b: Int = prim +(a, 1)
     *                                          let t: ... = tuple(a, b)
     *
     * A label (let a = ...) names its component for the components after it,
     * so a labelled component is computed into a variable bound to the label.
     * Components declared with let rec ... and ... are functions that see one
     * another: they become one funs rec statement, whose closures are the
     * components. A type component (Let T = Int) is a witness, the type it
     * stands for, not a value: it computes nothing, and becomes one of the
     * make-tuple's type components,
     *
     *     tuple Let T = Int let x: T = 3 end  ->  tuple(Let T = Int x)
     *
     * Binding each label as soon as its value is computed is right even for a
     * simultaneous group (let a = ... and b = ...), whose members do not see
     * one another: a member refers to a binding that a label shadows by that
     * binding's own symbol, never the label's. *)
    and lowerTuple(l: Lowerer e: Expr into: maybe.T(Variable)): Atom =
        case e.form
            when exprTuple with x then
                let n = extent x.elements
                let labelOf = fun(i: Int): maybe.T(symbols.ValueSymbol)
                    if i < extent x.labels then x.labels[i] else maybe.none() end
                let values = hashMap.new(:Int :Atom intEqual hash.int)
                let setValue = fun(i: Int a: Atom): Ok begin hashMap.insert(values i a) ok end
                let typeComponents = vector.new(:nodes.TypeComponent)
                let isWitness = fun(el: Expr): Bool el.form?exprTypeWitness
                (* The first index of each recursive group, and the members of
                 * all *)
                let groupAt = fun(i: Int): maybe.T(Array(Int))
                    begin
                        let var found = maybe.none(:Array(Int))
                        for g = 0 upto {extent x.recGroups - 1} do
                            if {extent x.recGroups[g] > 0} andif {x.recGroups[g][0] is i} then
                                found := maybe.some(x.recGroups[g])
                            end
                        end
                        found
                    end
                let inGroup = fun(i: Int): Bool
                    begin
                        let var found = false
                        for g = 0 upto {extent x.recGroups - 1} do
                            for k = 0 upto {extent x.recGroups[g] - 1} do if x.recGroups[g][k] is i then found := true end end
                        end
                        found
                    end
                for i = 0 upto {n - 1} do
                    let element = x.elements[i]
                    let group = groupAt(i)
                    case element.form
                        when exprTypeWitness with w then
                            vector.append(typeComponents tuple let name = w.name let type = w.witnessType end)
                        else
                            if maybe.isSome(group) then
                                (* Recursive components: functions that see one
                                 * another, through their labels *)
                                let members = maybe.unwrap(group)
                                let funVars = vector.new(:Variable)
                                for k = 0 upto {extent members - 1} do
                                    let sym = labelOf(members[k])
                                    let v = if maybe.isSome(sym) then
                                        bindSymbol(l maybe.unwrap(sym) maybe.none() false)
                                    else
                                        fresh("f" x.elements[members[k]].type false)
                                    end
                                    setValue(members[k] va(v))
                                    vector.append(funVars v)
                                end
                                let funs = vector.new(:nodes.Function)
                                for k = 0 upto {extent members - 1} do
                                    let funExpr = x.elements[members[k]]
                                    if not(funExpr.form?exprFun) then fail(:Ok "recursive tuple components other than functions") end
                                    vector.append(funs function(l funExpr vector.get(funVars k) maybe.none(:String)))
                                end
                                emit(l option sFuns of Stmt with let var functions = vector.toArray(funs) let recursive = true end)
                            elsif not(inGroup(i)) then
                                let lbl = labelOf(i)
                                if maybe.isNone(lbl) then
                                    setValue(i value(l element none))
                                else
                                    (* A label names its component's value for
                                     * the later components *)
                                    let v = bindSymbol(l maybe.unwrap(lbl) maybe.some(element.type) false)
                                    setValue(i value(l element some(v)))
                                end
                            end
                    end
                end
                let atoms = vector.new(:Atom)
                for i = 0 upto {n - 1} do
                    if not(isWitness(x.elements[i])) then vector.append(atoms hashMap.find(values i)) end
                end
                letOp(l nodes.makeTuple(vector.toArray(atoms) vector.toArray(typeComponents)) e.type into)
            else fail("not a tuple")
        end

    (* A value produced on several paths: each path jumps to a join point with
     * its value *)
    and joined(l: Lowerer e: Expr into: maybe.T(Variable)): Atom =
        begin
            let result = if maybe.isSome(into) then maybe.unwrap(into) else fresh("r" e.type false) end
            let lbl = label(l "k")
            let joinBody = nodes.newBody()
            let continuation = nodes.newBody()
            emit(l option sJoin of Stmt with
                let label = lbl
                let var params = array of result end
                let var continuation = continuation
                let var body = joinBody
            end)
            inBody(l joinBody fun(): Ok branches(l e fun(branch: Expr): Ok jumpWith(l lbl branch)))
            l.body := continuation
            va(result)
        end

    and jumpWith(l: Lowerer lbl: String branch: Expr): Ok =
        begin
            let a = value(l branch none)
            if not(nodes.terminated(l.body)) then
                terminate(l option sJump of Stmt with
                    let var pos = ~1 let label = lbl let var args = array of a end
                end)
            end
        end

    (* Effects *)

    (* e lowered into the current body at its offset for its effects alone,
     * its value dropped, so that a statement position makes no variable for
     * it *)
    and effect(l: Lowerer e: Expr): Ok = at(l e.offset fun(): Ok effectForm(l e))
    and effectForm(l: Lowerer e: Expr): Ok =
        case e.form
            when exprIf then branches(l e fun(b: Expr): Ok effect(l b))
            when exprCase then branches(l e fun(b: Expr): Ok effect(l b))
            when exprInspect then branches(l e fun(b: Expr): Ok effect(l b))
            when exprTry then branches(l e fun(b: Expr): Ok effect(l b))
            when exprBlock with x then
                for i = 0 upto {extent x.bindings - 1} do binding(l x.bindings[i] false) end
                effect(l x.result)
            when exprWhile with x then
                let lbl = label(l "L")
                let loopBody = nodes.newBody()
                emit(l option sLoop of Stmt with let label = lbl let var body = loopBody end)
                vector.append(l.loops lbl)
                inBody(l loopBody fun(): Ok
                    begin
                        let c = value(l x.cond none)
                        let thenBody = nodes.newBody()
                        emit(l option sIf of Stmt with
                            let var pos = ~1
                            let var cond = c
                            let var thenBody = thenBody
                            let var elseBody = nodes.bodyOf(array of option sBreak of Stmt with
                                let var pos = l.pos let label = lbl
                            end end)
                        end)
                        inBody(l thenBody fun(): Ok effect(l x.body))
                    end)
                vector.pop(l.loops)
                ok
            when exprLoop with x then
                let lbl = label(l "L")
                let loopBody = nodes.newBody()
                emit(l option sLoop of Stmt with let label = lbl let var body = loopBody end)
                vector.append(l.loops lbl)
                inBody(l loopBody fun(): Ok effect(l x.body))
                vector.pop(l.loops)
                ok
            when exprFor then forLoop(l e)
            when exprExit then
                if vector.empty(l.loops) then fail(:Ok "exit outside a loop") end
                terminate(l option sBreak of Stmt with let var pos = ~1 let label = vector.last(l.loops) end)
            when exprAssign with x then assign(l x.target x.value)
            when exprIndexAssign with x then
                let a = value(l x.target none)
                let i = value(l x.index none)
                let v = value(l x.value none)
                emit(l option sStoreElement of Stmt with
                    let var pos = ~1 let var value = v let var base = a let var index = i let offset = offsetOf(l e)
                end)
            when exprRaise with x then
                let exc = value(l x.exc none)
                let p = if maybe.isSome(x.payload) then maybe.some(value(l maybe.unwrap(x.payload) none))
                    else maybe.none(:Atom) end
                (* The payload's type as the interpreters show it *)
                let text = if maybe.isSome(x.payload) andif not(isOk(maybe.unwrap(x.payload).type)) then
                    model.show(maybe.unwrap(x.payload).type) else "" end
                terminate(l option sRaise of Stmt with
                    let var pos = ~1 let var exc = exc let var payload = p let offset = offsetOf(l e) let payloadText = text
                    let var descriptor = maybe.none()
                end)
            when exprApp then
                if isOk(e.type) then
                    let a = call(l e none)
                    (* A call for its effect: its result is not used (Ok) *)
                    let stmts = l.body.statements
                    if not(vector.empty(stmts)) then
                        case vector.last(stmts)
                            when sLet with x then
                                let isCall = x.value?opCall
                                let sameVar = case a when atomVar with y then nodes.same(y.v x.v) else false end
                                if isCall andif sameVar then
                                    vector.set(stmts {vector.length(stmts) - 1} option sDo of Stmt with
                                        let var pos = x.pos let var value = x.value
                                    end)
                                end
                            else ok
                        end
                    end
                else
                    begin value(l e none) ok end
                end
            else begin value(l e none) ok end
        end

    (* The target of e, an extraction o!tag *)
    and extractedOf(e: Expr): Expr =
        case e.form when exprVariantAssert with x then x.target else fail("not an extraction") end

    (* The payload of e, an extraction o!tag, from o's value: a variant's
     * payload, or a new tuple of an option's ordinal (its case's index in o's
     * type as written) and components, raising if o is of another case *)
    and payloadOp(l: Lowerer e: Expr o: Atom): Op =
        case e.form
            when exprVariantAssert with x then
                let cases = optionCases(x.target.type)
                let var ordinalIndex = maybe.none(:Int)
                if maybe.isSome(cases) then
                    let names = maybe.unwrap(cases)
                    for i = {extent names - 1} downto 0 do
                        if eq(names[i] x.tag) then ordinalIndex := maybe.some(i) end
                    end
                    if maybe.isNone(ordinalIndex) then fail(:Ok "no case '" <> x.tag <> "'") end
                end
                nodes.payload(o x.tag offsetOf(l e) ordinalIndex)
            else fail("not an extraction")
        end

    (* base, if it is an option's extraction o!tag. A selection o!tag.f used as
     * a location (an assignment's target or an @ argument) is the option's own
     * component f, which its case's binder shares (type-system.md section
     * 6.8), not the component of o!tag's copy. A variant's extraction is its
     * payload already *)
    and payloadBase(base: Expr): maybe.T(Expr) =
        case base.form
            when exprVariantAssert with x then
                if maybe.isSome(optionCases(x.target.type)) then maybe.some(base) else maybe.none() end
            else maybe.none()
        end

    (* Lowers inCase, given the binder of a switch on o, the option of
     * extraction (o!tag), in its one case, tag: the option's own payload, a
     * tuple of the case's components. The switch's else is o!tag itself,
     * which raises there as the extraction does, at its location; otherwise
     * is lowered after it, given that copy, for a value the else must jump
     * with (it never runs). So o is evaluated, then its case checked, then
     * inCase's own operands, as case o when tag with c then ... end would *)
    and inPayload(l: Lowerer extraction: Expr inCase: All(c: Variable) Ok otherwise: All(copy: Atom) Ok): Ok =
        begin
            let o = value(l extractedOf(extraction) none)
            let fields = case extraction.type.form
                when typeTuple with t then t.fields
                else fail(:Array(model.TupleComponent) "an option's extraction of type " <> model.show(extraction.type))
            end
            let payloadFields = array of(extent fields - 1 fields[0])
            for i = 1 upto {extent fields - 1} do payloadFields[i - 1] := fields[i] end
            let c = fresh("p" model.tupleType(payloadFields) false)
            let theCase = nodes.newCase(array of extractedTag(extraction) end nodes.newBody() some(c))
            inBody(l theCase.body fun(): Ok inCase(c))
            let elseBody = nodes.newBody()
            inBody(l elseBody fun(): Ok otherwise(letOp(l payloadOp(l extraction o) extraction.type none)))
            emit(l nodes.switchStmt(o array of theCase end maybe.some(elseBody)))
        end

    (* Lowers o!tag.f := v, f at index in o!tag's type: a store into the
     * option's own component f, through its case's binder, whose index is one
     * less (it has no ordinal) *)
    and payloadStore(l: Lowerer extraction: Expr index: Int v: Expr): Ok =
        inPayload(l extraction
            fun(c: Variable): Ok begin
                let a = value(l v none)
                emit(l option sStoreComponent of Stmt with
                    let var pos = ~1 let var value = a let var base = va(c) let index = index - 1
                    let var access = nodes.direct let var viewMap = maybe.none()
                end)
            end
            fun(copy: Atom): Ok ok)

    (* @o!tag.f, of e, f at index in o!tag's type: the address of the
     * option's own component f, from its case's binder, joined out of the
     * switch *)
    and payloadAddress(l: Lowerer e: Expr extraction: Expr index: Int into: maybe.T(Variable)): Atom =
        begin
            let result = if maybe.isSome(into) then maybe.unwrap(into) else fresh("r" e.type false) end
            let lbl = label(l "k")
            let joinBody = nodes.newBody()
            let continuation = nodes.newBody()
            emit(l option sJoin of Stmt with
                let label = lbl let var params = array of result end let var continuation = continuation
                let var body = joinBody
            end)
            let address(base: Atom at: Int): Ok =
                begin
                    let a = letOp(l option opAddrComponent of Op with
                        let var base = base let index = at let var access = nodes.direct let var viewMap = maybe.none()
                    end e.type none)
                    terminate(l option sJump of Stmt with let var pos = ~1 let label = lbl let var args = array of a end end)
                end
            inBody(l joinBody fun(): Ok inPayload(l extraction
                fun(c: Variable): Ok address(va(c) index - 1) fun(copy: Atom): Ok address(copy index)))
            l.body := continuation
            va(result)
        end

    (* The tag of e, an extraction o!tag *)
    and extractedTag(e: Expr): String =
        case e.form when exprVariantAssert with x then x.tag else fail("not an extraction") end

    (* Lowers target := v, by what target is:
     * - a variable held in a box (a var variable a closure captures, or a
     *   phrase unit's slot): a store to the box's one component;
     * - a mutable variable: an assignment;
     * - an earlier input's var, in a phrase unit: a store to the field of
     *   that input's record;
     * - a tuple's var component or a record's var field: a store to it;
     * - any other target, whose value is a location's address (an array's
     *   element, say): a store at the address.
     * In the last two, target's record, tuple, or address is evaluated
     * before v *)
    and assign(l: Lowerer target: Expr v: Expr): Ok =
        begin
            let bound = boundVar(l target)
            let box = boxOf(l target)
            if maybe.isSome(box) then
                let a = value(l v none)
                emit(l option sStoreComponent of Stmt with
                    let var pos = ~1 let var value = a let var base = va(maybe.unwrap(box)) let index = 0
                    let var access = nodes.direct let var viewMap = maybe.none()
                end)
            elsif maybe.isSome(bound) andif maybe.unwrap(bound).isMutable then
                let a = value(l v none)
                emit(l option sAssign of Stmt with
                    let var pos = ~1 let var v = maybe.unwrap(bound) let var value = a
                end)
            elsif maybe.isSome(earlierOf(l target)) then
                (* An earlier input's var is a field of its record *)
                let found = maybe.unwrap(earlierOf(l target))
                let a = value(l v none)
                let recordAtom = letOp(l option opModuleMember of Op with
                    let var moduleRef = found.ref let var member = maybe.none()
                end found.binding.recordType none)
                emit(l option sStoreField of Stmt with
                    let var pos = ~1 let var value = a let var base = recordAtom let name = found.binding.field
                    let var viewMap = maybe.none()
                end)
            else
                case target.form
                    when exprSelect with x then
                        if maybe.isSome(payloadBase(x.target)) then
                            payloadStore(l maybe.unwrap(payloadBase(x.target))
                                tupleIndex(x.target.type ~1 maybe.some(x.field)) v)
                        else
                            let base = value(l x.target none)
                            let a = value(l v none)
                            let s = layout.resolvedShape(shapes.shape(x.target.type))
                            case s.kind
                                when shapeTuple then
                                    emit(l option sStoreComponent of Stmt with
                                        let var pos = ~1
                                        let var value = a
                                        let var base = base
                                        let index = tupleIndex(x.target.type ~1 maybe.some(x.field))
                                        let var access = nodes.direct
                                        let var viewMap = maybe.none()
                                    end)
                                when shapeInt, shapeReal, shapeBool, shapeChar, shapeString, shapeOk, shapeWord,
                                    shapeBottom, shapeRecord, shapeVariant, shapeOption, shapeArray, shapeCell, shapeOut,
                                    shapeException, shapeFun, shapeAll, shapeAuto, shapeTypevar, shapeAbstract,
                                    shapeExternal, shapeOperator, shapePending then
                                    emit(l option sStoreField of Stmt with
                                        let var pos = ~1
                                        let var value = a
                                        let var base = base
                                        let name = x.field
                                        let var viewMap = maybe.none()
                                    end)
                            end
                        end
                    else
                        let address = value(l target none)
                        let a = value(l v none)
                        emit(l option sStoreAt of Stmt with
                            let var pos = ~1 let var value = a let var address = address
                        end)
                end
            end
        end

    (* Lowers for i = start upto stop do body end (or downto) as a loop over
     * a mutable counter. start and stop are evaluated once, before it; each
     * iteration breaks when the counter has passed stop, binds i anew to the
     * counter's value (an immutable variable, which closures in the body may
     * capture), runs the body, and steps the counter by 1 (unless the body
     * ended in a terminator). The loop's label is the one an exit in the
     * body breaks to:
     *     var c := start
     *     loop L {
     *       if c <= stop { let i = c; body; c := c + 1 } else { break L }
     *     } *)
    and forLoop(l: Lowerer e: Expr): Ok =
        case e.form
            when exprFor with x then
                (* var c = start; if c <= stop then loop L { let i = c; body;
                 * if c is stop then break L; c := c + 1 } (downto alike). The
                 * loop tests the bound before it steps, so a loop to maxInt
                 * (or downto minInt) ends there rather than wrapping. Each
                 * iteration binds i afresh, immutably, so a closure made in
                 * the body captures that iteration's value, not the counter.
                 * The bootstrap's for_loop (ir/lower.py) is the same *)
                let start = value(l x.start none)
                let stop = value(l x.stop none)
                let counter = fresh(x.varName model.intType true)
                emit(l option sVarDecl of Stmt with
                    let var pos = ~1 let var v = counter let var init = maybe.some(start)
                end)
                let lbl = label(l "L")
                let more = letOp(l nodes.prim(if x.isDownto then nodes.primGe else nodes.primLe end array of va(counter) stop end
                    maybe.none()) model.boolType none)
                let loopBody = nodes.newBody()
                emit(l option sIf of Stmt with
                    let var pos = ~1
                    let var cond = more
                    let var thenBody = nodes.bodyOf(array of option sLoop of Stmt with
                        let label = lbl let var body = loopBody
                    end end)
                    let var elseBody = nodes.newBody()
                end)
                vector.append(l.loops lbl)
                inBody(l loopBody fun(): Ok
                    begin
                        let i = bindSymbol(l x.symbol maybe.some(model.intType) false)
                        emit(l nodes.letStmt(i nodes.opOfVar(counter)))
                        effect(l x.body)
                        if not(nodes.terminated(l.body)) then
                            let last = letOp(l nodes.prim(nodes.primIs array of va(counter) stop end maybe.none())
                                model.boolType none)
                            emit(l option sIf of Stmt with
                                let var pos = ~1
                                let var cond = last
                                let var thenBody = nodes.bodyOf(array of option sBreak of Stmt with
                                    let var pos = l.pos let label = lbl
                                end end)
                                let var elseBody = nodes.newBody()
                            end)
                            let step = letOp(l nodes.prim(if x.isDownto then nodes.primSub else nodes.primAdd end
                                array of va(counter) intConst(1) end maybe.none()) model.intType none)
                            emit(l option sAssign of Stmt with
                                let var pos = ~1 let var v = counter let var value = step
                            end)
                        end
                    end)
                vector.pop(l.loops)
                ok
            else fail("not a for loop")
        end

    (* Lowers the branches of an if, case, inspect, or try, each with
     * lowerBranch (into the branch's body) *)
    and branches(l: Lowerer e: Expr lowerBranch: All(b: Expr) Ok): Ok =
        case e.form
            when exprIf with x then
                let c = value(l x.cond none)
                let thenBody = nodes.newBody()
                let elseBody = nodes.newBody()
                emit(l option sIf of Stmt with
                    let var pos = ~1 let var cond = c let var thenBody = thenBody let var elseBody = elseBody
                end)
                inBody(l thenBody fun(): Ok lowerBranch(x.thenBranch))
                inBody(l elseBody fun(): Ok lowerBranch(x.elseBranch))
            when exprCase with x then
                let v = value(l x.target none)
                let cases = vector.new(:nodes.Case)
                for i = 0 upto {extent x.branches - 1} do
                    let br = x.branches[i]
                    let binder = if maybe.isSome(br.binder) then
                        some(bindSymbol(l maybe.unwrap(br.binder) maybe.none() false))
                    else
                        none
                    end
                    let c = nodes.newCase(br.tags nodes.newBody() binder)
                    inBody(l c.body fun(): Ok lowerBranch(br.body))
                    vector.append(cases c)
                end
                let elseBody = elseOf(l x.elseBranch lowerBranch)
                emit(l nodes.switchStmt(v vector.toArray(cases) elseBody))
            when exprInspect with x then
                let v = value(l x.target none)
                let cases = vector.new(:nodes.InspectCase)
                for i = 0 upto {extent x.branches - 1} do
                    let br = x.branches[i]
                    let binders = vector.new(:Variable)
                    for j = 0 upto {extent br.binders - 1} do
                        vector.append(binders bindSymbol(l br.binders[j] maybe.none(:Type) false))
                    end
                    let c = nodes.newInspectCase(br.matchType vector.toArray(binders) nodes.newBody() br.exact)
                    inBody(l c.body fun(): Ok lowerBranch(br.body))
                    vector.append(cases c)
                end
                let elseBody = elseOf(l x.elseBranch lowerBranch)
                emit(l nodes.inspectStmt(v vector.toArray(cases) elseBody x.autoType offsetOf(l e)))
            when exprTry with x then
                let exc = fresh("e" model.exceptionType false)
                (* What the handler catches, when that is known before the try:
                 * its patterns' values, computed before the try when computing
                 * them there gives the same values *)
                let var catching = nodes.catchUnknown
                let var patterns = maybe.none(:Array(Atom))
                if maybe.isSome(x.elseBinder) then
                    catching := nodes.catchAllTraced
                elsif maybe.isSome(x.elseBranch) then
                    catching := nodes.catchAll
                else
                    let var pure = true
                    for i = 0 upto {extent x.branches - 1} do
                        if pure andif not(purePattern(l x.branches[i].excPattern)) then pure := false end
                    end
                    if pure then
                        let values = vector.new(:Atom)
                        for i = 0 upto {extent x.branches - 1} do vector.append(values value(l x.branches[i].excPattern none)) end
                        patterns := maybe.some(vector.toArray(values))
                        catching := nodes.catchListed
                    end
                end
                let tryBody = nodes.newBody()
                let handlerBody = nodes.newBody()
                let listed = patterns
                emit(l option sTry of Stmt with
                    let var body = tryBody
                    let var exc = exc
                    let var handler = handlerBody
                    let catching = catching
                    let var catches = maybe.unwrapOr(listed array of :Atom end)
                end)
                inBody(l tryBody fun(): Ok lowerBranch(x.body))
                inBody(l handlerBody fun(): Ok handler(l exc x.branches 0 x.elseBranch x.elseBinder lowerBranch listed))
            else fail("branches of this expression")
        end

    and elseOf(l: Lowerer elseBranch: maybe.T(Expr) lowerBranch: All(b: Expr) Ok): maybe.T(Body) =
        if maybe.isSome(elseBranch) then
            let b = nodes.newBody()
            inBody(l b fun(): Ok lowerBranch(maybe.unwrap(elseBranch)))
            maybe.some(b)
        else
            maybe.none()
        end

    (* Whether a try's pattern has the same value computed before the try as in
     * its handler: an immutable variable already bound, or a module's member *)
    and purePattern(l: Lowerer e: Expr): Bool =
        case e.form
            when exprVar then
                let v = boundVar(l e)
                maybe.isSome(v) andif not(maybe.unwrap(v).isMutable)
            when exprSelect with x then maybe.isSome(moduleRefOf(l x.target))
            else false
        end

    (* A try's handler: the branches' patterns (or their values, computed before
     * the try) tested in order against the exception, else the else branch
     * (with its binder, if it names the exception), or the exception raised
     * again *)
    and handler(l: Lowerer exc: Variable branches: Array(typedAst.TryBranch) first: Int elseBranch: maybe.T(Expr)
            elseBinder: maybe.T(symbols.ValueSymbol) lowerBranch: All(b: Expr) Ok patterns: maybe.T(Array(Atom))): Ok =
        if first >= extent branches then
            if maybe.isSome(elseBranch) then
                if maybe.isSome(elseBinder) then
                    let v = bindSymbol(l maybe.unwrap(elseBinder) maybe.none() false)
                    emit(l nodes.letStmt(v option opCaughtException of Op with let var exc = va(exc) end))
                end
                lowerBranch(maybe.unwrap(elseBranch))
            else
                terminate(l option sReraise of Stmt with let var pos = ~1 let var exc = exc end)
            end
        else
            let br = branches[first]
            let pattern = if maybe.isSome(patterns) then maybe.unwrap(patterns)[first]
                else value(l br.excPattern none) end
            let matches = letOp(l nodes.prim(nodes.primIs array of va(exc) pattern end maybe.none()) model.boolType none)
            let thenBody = nodes.newBody()
            let elseBody = nodes.newBody()
            emit(l option sIf of Stmt with
                let var pos = ~1 let var cond = matches let var thenBody = thenBody let var elseBody = elseBody
            end)
            inBody(l thenBody fun(): Ok
                begin
                    if maybe.isSome(br.binder) then
                        let v = bindSymbol(l maybe.unwrap(br.binder) maybe.none() false)
                        emit(l nodes.letStmt(v option opExceptionPayload of Op with let var exc = va(exc) end))
                    end
                    lowerBranch(br.body)
                end)
            inBody(l elseBody fun(): Ok handler(l exc branches first + 1 elseBranch elseBinder lowerBranch patterns))
        end

    (* Functions *)

    (* The function e, bound to binder if it is let-bound. A function checked
     * against its variable's type may annotate a value parameter with a
     * supertype of the type's: its parameter has the variable's type's, which
     * callers pass, and a let at its entry binds the annotation's *)
    and function(l: Lowerer e: Expr v: Variable binder: maybe.T(String)): nodes.Function =
        case e.form
            when exprFun with x then
                let traceName = diagnostics.frameName(l.frame binder)
                let t = e.type
                let typeParams = vector.new(:nodes.TypeParam)
                let inner = case t.form
                    when typeAll with all then
                        for i = 0 upto {extent all.quantifiers - 1} do
                            let q = all.quantifiers[i]
                            vector.append(typeParams tuple
                                let name = q.name
                                let symbolId = q.symbolId
                                let kind = q.bound
                                let bound = if model.isPower(q.bound) then maybe.some(shapes.shape(model.powerBound(q.bound)))
                                    else maybe.none(:shapes.Shape) end
                            end)
                        end
                        all.body
                    else t
                end
                let resultType = case inner.form when typeFun with f then f.result else inner end
                let expected = expectedParams(v.type t extent x.params)
                let params = vector.new(:nodes.ParamEntry)
                let entry = vector.new(:Stmt)
                for i = 0 upto {extent x.params - 1} do
                    let p = x.params[i]
                    let mode = if p.isVar then "var" elsif p.isOut then "out" else "value" end
                    let paramType = unref(p.type)
                    let expectedType = if maybe.isSome(expected) then
                        maybe.some(unref(maybe.unwrap(expected)[i]))
                    else
                        maybe.none(:Type)
                    end
                    if eq(mode "value") andif maybe.isSome(expectedType)
                        andif not(subtyping.isTypeEqual(maybe.unwrap(expectedType) paramType maybe.none())) then
                        let param = fresh(p.symbol.name maybe.unwrap(expectedType) false)
                        vector.append(entry nodes.letStmt(bindSymbol(l p.symbol maybe.some(paramType) false) nodes.opOfVar(param)))
                        vector.append(params tuple let v = param let mode = mode end)
                    else
                        vector.append(params tuple
                            let v = bindSymbol(l p.symbol maybe.some(paramType) not(eq(mode "value")))
                            let mode = mode
                        end)
                    end
                end
                let fbody = nodes.bodyOf(vector.toArray(entry))
                let savedLoops = l.loops
                let savedFrame = l.frame
                l.loops := vector.new()
                l.frame := traceName
                let paramArray = vector.toArray(params)
                inBody(l fbody fun(): Ok
                    begin
                        let result = case x.body.form
                            when exprExternal with ext then externalCall(l ext.symbol t paramArray resultType)
                            else value(l x.body none)
                        end
                        (* The return has no position of its own: it is at the
                         * last of the body's *)
                        if not(nodes.terminated(l.body)) then
                            at(l ~1 fun(): Ok
                                terminate(l option sReturn of Stmt with let var pos = ~1 let var value = result end))
                        end
                    end)
                l.loops := savedLoops
                l.frame := savedFrame
                nodes.newFunction(v vector.toArray(typeParams) paramArray resultType fbody
                    maybe.some(traceName))
            else fail("not a function")
        end

    (* The body of a function defined as an external C function: a call of it *)
    and externalCall(l: Lowerer symbol: String t: Type params: Array(nodes.ParamEntry) resultType: Type): Atom =
        begin
            let typeArgs = vector.new(:Type)
            case t.form
                when typeAll with all then
                    for i = 0 upto {extent all.quantifiers - 1} do
                        let q = all.quantifiers[i]
                        vector.append(typeArgs model.typeVariable(q.name q.symbolId maybe.some(q.bound)))
                    end
                else ok
            end
            let args = vector.new(:Atom)
            for i = 0 upto {extent params - 1} do
                let entry = params[i]
                if eq(entry.mode "value") then
                    vector.append(args va(entry.v))
                else
                    let refType = if eq(entry.mode "var") then model.varType(entry.v.type) else model.outType(entry.v.type) end
                    vector.append(args letOp(l option opAddrVar of Op with let var v = entry.v end refType none))
                end
            end
            letOp(l option opCallExternal of Op with
                let symbol = symbol
                let var typeArgs = vector.toArray(typeArgs)
                let var args = vector.toArray(args)
                let var descriptors = array of :nodes.Descriptor end
            end resultType none)
        end

    (* Bindings *)

    and funText(name: String t: Type): Stmt =
        option sEchoText of Stmt with let text = "let " <> name <> ":" <> model.show(t) <> " = <fun>" end

    (* Whether a let binds a slot that the unit holds in a box *)
    and boxedLet(l: Lowerer lv: typedAst.LetValue): Bool = l.boxSlots andif boxesSlot(l.env lv.symbol)

    (* A slot's box type: a tuple of one var component *)
    and boxType(lv: typedAst.LetValue): Type =
        model.tupleType(array of model.tupleField(maybe.some(lv.name) lv.symbol.type true) end)

    (* The value of a let held in a slot, lowered into a fresh variable, which
     * no symbol names: a function's closure, or the value *)
    and slotValue(l: Lowerer lv: typedAst.LetValue): Variable =
        begin
            let v = fresh(lv.name lv.symbol.type false)
            if lv.value.form?exprFun then
                emit(l option sFuns of Stmt with
                    let var functions = array of function(l lv.value v maybe.some(lv.name)) end
                    let recursive = false
                end)
            else
                if lv.isRec then fail(:Ok "recursive values other than functions") end
                begin value(l lv.value some(v)) ok end
            end
            v
        end

    (* Puts a slot's value v in its box: a new box, which the unit's record
     * holds, or, for a redefinition, the slot's box, the unit's own or an
     * earlier input's, stored to (docs/jit.md section 3.2) *)
    and storeSlot(l: Lowerer lv: typedAst.LetValue v: Variable): Ok =
        if lv.redefines then
            let box = boxOfSymbol(l lv.symbol.symbolId)
            if maybe.isNone(box) then fail(:Ok "slot '" <> lv.name <> "' has no box") end
            emit(l option sStoreComponent of Stmt with
                let var pos = ~1 let var value = va(v) let var base = va(maybe.unwrap(box)) let index = 0
                let var access = nodes.direct let var viewMap = maybe.none()
            end)
        else
            let box = letVar(l nodes.makeTuple(array of va(v) end array of :nodes.TypeComponent end) boxType(lv) none lv.name)
            hashMap.insert(l.boxes lv.symbol.symbolId box)
            ok
        end

    (* What a let held in a slot shows when it is echoed *)
    and showSlot(l: Lowerer lv: typedAst.LetValue v: Variable): Ok =
        if lv.value.form?exprFun then emit(l funText(lv.name lv.symbol.type))
        else echoBinding(l lv.name lv.symbol v) end

    (* Recursive functions held in slots: each new slot's box is made with the
     * functions, in one let rec, so that their bodies, which name the slots,
     * read the boxes; a redefined slot's box is stored to after *)
    and recSlots(l: Lowerer members: Array(typedAst.LetValue) show: Bool): Ok =
        begin
            let fvs = array of(extent members fresh("f" model.okType false))
            let vars = vector.new(:Variable)
            for i = 0 upto {extent members - 1} do
                fvs[i] := fresh(members[i].name members[i].symbol.type false)
                vector.append(vars fvs[i])
            end
            let made = vector.new(:Tuple box: Variable value: Variable end)
            for i = 0 upto {extent members - 1} do
                if not(members[i].redefines) then
                    let box = fresh(members[i].name boxType(members[i]) false)
                    hashMap.insert(l.boxes members[i].symbol.symbolId box)
                    vector.append(vars box)
                    vector.append(made tuple let box = box let value = fvs[i] end)
                end
            end
            let groupBody = nodes.newBody()
            emit(l option sLetRec of Stmt with let var vars = vector.toArray(vars) let var body = groupBody end)
            inBody(l groupBody fun(): Ok
                begin
                    let functions = vector.new(:nodes.Function)
                    for i = 0 upto {extent members - 1} do
                        vector.append(functions
                            function(l members[i].value fvs[i] maybe.some(members[i].name)))
                    end
                    emit(l option sFuns of Stmt with
                        let var functions = vector.toArray(functions) let recursive = false
                    end)
                    for i = 0 upto {vector.length(made) - 1} do
                        let m = vector.get(made i)
                        emit(l nodes.letStmt(m.box nodes.makeTuple(array of va(m.value) end array of :nodes.TypeComponent end)))
                    end
                end)
            for i = 0 upto {extent members - 1} do
                if members[i].redefines then storeSlot(l members[i] fvs[i]) end
                if show then showSlot(l members[i] fvs[i]) end
            end
        end

    (* Lowers the binding lv, echoing it if show: in a phrase unit, a slot's
     * binding stores its value into the slot's box (boxesSlot), a recursive
     * function's as a group of one (recSlots); any other binds a variable
     * (plainLetValue) *)
    and letValue(l: Lowerer lv: typedAst.LetValue show: Bool): Ok =
        if boxedLet(l lv) andif lv.isRec andif lv.value.form?exprFun then
            recSlots(l array of lv end show)
        elsif boxedLet(l lv) then
            let v = slotValue(l lv)
            storeSlot(l lv v)
            if show then showSlot(l lv v) end
        else
            plainLetValue(l lv show)
        end

    and plainLetValue(l: Lowerer lv: typedAst.LetValue show: Bool): Ok =
        begin
            let symbol = lv.symbol
            (* A var bound to a function is a mutable variable like any other,
             * initialized from the function's closure *)
            if lv.value.form?exprFun andif not(symbol.isVar) then
                let v = bindSymbol(l symbol maybe.none() false)
                emit(l option sFuns of Stmt with
                    let var functions = array of function(l lv.value v maybe.some(lv.name)) end
                    let recursive = lv.isRec
                end)
                if show then emit(l funText(lv.name symbol.type)) end
            else
                let v = if symbol.isVar andif hashMap.contains(l.captured symbol.symbolId) then
                    (* Held in a box that closures capture
                     * (capturedMutables) *)
                    let init = value(l lv.value none)
                    let boxType = model.tupleType(array of
                        model.tupleField(maybe.some(lv.name) symbol.type true)
                    end)
                    let box = letVar(l nodes.makeTuple(array of init end array of :nodes.TypeComponent end) boxType none lv.name)
                    hashMap.insert(l.boxes symbol.symbolId box)
                    box
                elsif symbol.isVar then
                    let init = value(l lv.value none)
                    let mv = bindSymbol(l symbol maybe.none() true)
                    emit(l option sVarDecl of Stmt with
                        let var pos = ~1 let var v = mv let var init = maybe.some(init)
                    end)
                    mv
                else
                    if lv.isRec then fail(:Ok "recursive values other than functions") end
                    (* The value is lowered before the variable is bound, so
                     * that it refers to any binding it shadows *)
                    let bound = fresh(symbol.name symbol.type false)
                    value(l lv.value some(bound))
                    if hashMap.contains(l.vars symbol.symbolId) then
                        fail(:Ok "symbol '" <> lv.name <> "' is bound twice")
                    end
                    hashMap.insert(l.vars symbol.symbolId bound)
                    bound
                end
                if show then echoBinding(l lv.name symbol v) end
            end
        end

    (* Lowers one declaration of a block or a unit's top level, emitting its
     * statements into the current body. With show, as for a top-level phrase
     * run with --echo, it also emits what the interactive system prints for
     * it.
     *
     *     let x = 1;                  let x: Int = 1
     *     let var y = x + 1;          let %1: Int = prim +(x, 1)
     *                                 var y: Int = %1
     *     let x = x + 2;              let x.1: Int = prim +(x, 2)
     *     let f(n: Int): Int = n + x; funs { fun f(n: Int): Int {...} }
     *     Let T = Int;                (nothing)
     *
     * - A value is computed straight into the variable that binds it
     *   (letValue, through value's into). The variable is entered in vars,
     *   where uses look it up, only after its value is lowered, so that the
     *   value sees the binding it shadows: the second x reads the first, and
     *   is printed x.1.
     * - A var is a mutable variable (sVarDecl), initialized from its value.
     * - A function becomes a funs statement, which makes closures. Functions
     *   declared together with let rec ... and ... are one funs rec, whose
     *   functions see one another. A let rec of values that are not all
     *   functions (a record of functions, say) goes to recValues.
     * - A simultaneous let ... and ... (without rec) is lowered member by
     *   member: its members' values refer to the bindings the members shadow,
     *   which are other symbols, so binding each as it is computed means the
     *   same.
     * - Type and kind declarations exist only for the type checker; they
     *   lower to nothing, but for their echoed text.
     * - An expression statement goes to phraseExpr: lowered for its effect
     *   alone if its type is Ok, and otherwise for its value, which --echo
     *   prints. An import adds the imported modules to the unit. *)
    and binding(l: Lowerer b: Binding show: Bool): Ok = at(l b.offset fun(): Ok bindingForm(l b show))
    and bindingForm(l: Lowerer b: Binding show: Bool): Ok =
        begin
            case b.form
                when bindLetValue with x then
                    if x.value.isRec andif not(x.value.value.form?exprFun) then
                        recValues(l array of x.value end show)
                    else
                        letValue(l x.value show)
                    end
                when bindLetValueGroup with x then
                    let isRec = {extent x.members > 0} andif x.members[0].isRec
                    let var allFuns = true
                    for i = 0 upto {extent x.members - 1} do if not(x.members[i].value.form?exprFun) then allFuns := false end end
                    let var anyBoxed = false
                    for i = 0 upto {extent x.members - 1} do if boxedLet(l x.members[i]) then anyBoxed := true end end
                    if isRec andif not(allFuns) then
                        recValues(l x.members show)
                    elsif isRec andif anyBoxed then
                        recSlots(l x.members show)
                    elsif anyBoxed then
                        (* Simultaneous, with slots: every member's value is
                         * computed before any is stored, since a member may
                         * read a slot another redefines *)
                        let values = array of(extent x.members fresh("v" model.okType false))
                        for i = 0 upto {extent x.members - 1} do
                            values[i] := if boxedLet(l x.members[i]) then slotValue(l x.members[i])
                                else
                                    let v = fresh(x.members[i].name x.members[i].symbol.type false)
                                    begin value(l x.members[i].value some(v)) v end
                                end
                        end
                        for i = 0 upto {extent x.members - 1} do
                            let m = x.members[i]
                            if boxedLet(l m) then
                                storeSlot(l m values[i])
                                if show then showSlot(l m values[i]) end
                            else
                                hashMap.insert(l.vars m.symbol.symbolId values[i])
                                if show then echoBinding(l m.name m.symbol values[i]) end
                            end
                        end
                    elsif isRec then
                        let vars = vector.new(:Variable)
                        for i = 0 upto {extent x.members - 1} do
                            vector.append(vars bindSymbol(l x.members[i].symbol maybe.none(:Type) false))
                        end
                        let functions = vector.new(:nodes.Function)
                        for i = 0 upto {extent x.members - 1} do
                            let m = x.members[i]
                            vector.append(functions function(l m.value vector.get(vars i) maybe.some(m.name)))
                        end
                        emit(l option sFuns of Stmt with let var functions = vector.toArray(functions) let recursive = true end)
                        if show then
                            for i = 0 upto {extent x.members - 1} do emit(l funText(x.members[i].name x.members[i].symbol.type)) end
                        end
                    else
                        (* Simultaneous: every member's value refers to the
                         * bindings the members shadow, which their symbols keep
                         * apart, so lowering them in order and binding each as
                         * it is computed is the same *)
                        for i = 0 upto {extent x.members - 1} do
                            binding(l typedAst.binding(x.members[i].offset
                                option bindLetValue of typedAst.BindingForm with let value = x.members[i] end) show)
                        end
                    end
                when bindExprStmt with x then phraseExpr(l x.expr show)
                when bindLetType with x then letType(l x.value show)
                when bindLetTypeGroup with x then for i = 0 upto {extent x.members - 1} do letType(l x.members[i] show) end
                when bindDefKind with x then
                    if show then
                        emit(l option sEchoText of Stmt with let text = "DEF " <> x.name <> " = " <> model.showKind(x.symbol.kind) end)
                    end
                when bindImport with x then addImports(l x.items)
                when bindInterface then fail("TypedInterface inside a block")
                when bindModule then fail("TypedModule inside a block")
            end
        end

    and letType(l: Lowerer lt: typedAst.LetType show: Bool): Ok =
        if show then
            let kindText = model.showKind(lt.symbol.kind)
            if maybe.isSome(lt.symbol.definition) then
                emit(l option sEchoText of Stmt with
                    let text = "Let " <> lt.name <> "::" <> kindText <> " = " <> model.show(maybe.unwrap(lt.symbol.definition))
                end)
            else
                emit(l option sEchoText of Stmt with let text = "Let " <> lt.name <> "::" <> kindText end)
            end
        end

    (* Recursive values (and functions) declared together: each member's value
     * is computed into its variable in a let rec, where closures may refer to
     * all of them *)
    and recValues(l: Lowerer members: Array(typedAst.LetValue) show: Bool): Ok =
        begin
            let vars = vector.new(:Variable)
            for i = 0 upto {extent members - 1} do
                vector.append(vars bindSymbol(l members[i].symbol maybe.none(:Type) false))
            end
            let groupBody = nodes.newBody()
            emit(l option sLetRec of Stmt with let var vars = vector.toArray(vars) let var body = groupBody end)
            inBody(l groupBody fun(): Ok
                for i = 0 upto {extent members - 1} do
                    let m = members[i]
                    let v = vector.get(vars i)
                    if m.value.form?exprFun then
                        emit(l option sFuns of Stmt with
                            let var functions = array of function(l m.value v maybe.some(m.name)) end
                            let recursive = false
                        end)
                    else
                        begin value(l m.value some(v)) ok end
                    end
                end)
            if show then
                for i = 0 upto {extent members - 1} do
                    let m = members[i]
                    if m.value.form?exprFun then
                        emit(l funText(m.name m.symbol.type))
                    else
                        echoBinding(l m.name m.symbol vector.get(vars i))
                    end
                end
            end
            (* Slots among them are held in boxes from here on; within the
             * group, the members name one another directly *)
            for i = 0 upto {extent members - 1} do
                if boxedLet(l members[i]) then
                    hashMap.delete(l.vars members[i].symbol.symbolId)
                    storeSlot(l members[i] vector.get(vars i))
                end
            end
        end

    and phraseExpr(l: Lowerer e: Expr show: Bool): Ok =
        begin
            let namedException = case e.form
                when exprException with x then stringOp.length(x.name) > 0
                else false
            end
            if namedException then
                value(l e none)
                if show then
                    case e.form
                        when exprException with x then emit(l option sEchoText of Stmt with let text = "exception " <> x.name end)
                        else ok
                    end
                end
            elsif isOk(e.type) then
                effect(l e)
            else
                let a = value(l e none)
                if show then
                    emit(l option sEcho of Stmt with
                        let var pos = ~1
                        let var value = a
                        let type = e.type
                        let prefix = ""
                        let var descriptor = maybe.none()
                    end)
                end
            end
        end

    and echoBinding(l: Lowerer name: String symbol: symbols.ValueSymbol v: Variable): Ok =
        begin
            let prefix = "let " <> if symbol.isVar then "var " else "" end <> name <> ":" <> model.show(symbol.type) <> " = "
            if isOk(symbol.type) then
                emit(l option sEchoText of Stmt with let text = prefix <> "ok" end)
            else
                emit(l option sEcho of Stmt with
                    let var pos = ~1
                    let var value = va(v)
                    let type = symbol.type
                    let prefix = prefix
                    let var descriptor = maybe.none()
                end)
            end
        end

    (* Units *)

    and addImports(l: Lowerer items: Array(typedAst.ImportItem)): Ok =
        for i = 0 upto {extent items - 1} do
            let item = items[i]
            let modulePaths = typedAst.effectiveModulePaths(item)
            let canonicalPaths = typedAst.effectiveCanonicalModulePaths(item)
            let interfacePath = typedAst.effectiveInterfacePath(item)
            for j = 0 upto {extent item.names - 1} do
                let imp = makeImport(l item.names[j] modulePaths[j] canonicalPaths[j] interfacePath)
                vector.append(l.imports imp)
                if maybe.isSome(item.symbolIds) then
                    let ids = maybe.unwrap(item.symbolIds)
                    if {j < extent ids} andif maybe.isSome(ids[j]) then
                        hashMap.insert(l.moduleRefs maybe.unwrap(ids[j])
                            option refImport of nodes.ModuleRef with let i = imp end)
                    end
                end
            end
        end

    (* A module binding lowered to a module of the unit: its initializer runs
     * its bindings, and its members are the values they bind and the
     * exceptions they name; its imports become the unit's *)
    let lowerModule(l: Lowerer b: Binding): nodes.Module =
        case b.form
            when bindModule with m then
                let init = nodes.newBody()
                let members = nodes.newMembers()
                let savedFrame = l.frame
                let var last = init
                l.frame := diagnostics.initFrame(m.name)
                inBody(l init fun(): Ok begin
                    for i = 0 upto {extent m.bindings - 1} do
                        let mb = m.bindings[i]
                        case mb.form
                            when bindImport with x then addImports(l x.items)
                            else
                                binding(l mb false)
                                let exc = typedAst.declaredException(mb)
                                if maybe.isSome(exc) then
                                    case maybe.unwrap(exc).form
                                        when exprException with x then
                                            nodes.addMember(members x.name
                                                hashMap.find(l.vars maybe.unwrap(x.symbol).symbolId))
                                        else ok
                                    end
                                end
                                let addValue = fun(lv: typedAst.LetValue): Ok
                                    nodes.addMember(members lv.name hashMap.find(l.vars lv.symbol.symbolId))
                                case mb.form
                                    when bindLetValue with x then addValue(x.value)
                                    when bindLetValueGroup with x then for j = 0 upto {extent x.members - 1} do addValue(x.members[j]) end
                                    else ok
                                end
                        end
                    end
                    last := l.body
                end)
                l.frame := savedFrame
                let lowered = nodes.newModule(l.modulePrefix <> m.name m.interfaceName init members)
                hashMap.insert(l.moduleEnds lowered.id last)
                if maybe.isSome(m.symbolId) then
                    hashMap.insert(l.moduleRefs maybe.unwrap(m.symbolId)
                        option refModule of nodes.ModuleRef with let m = lowered end)
                end
                lowered
            else fail("not a module")
        end

    let program(l: Lowerer prog: typedAst.Program): nodes.Unit =
        begin
            captures.capturedMutables(prog l.captured)
            let main = nodes.newBody()
            let modules = vector.new(:nodes.Module)
            let phrases = prog.phrases
            inBody(l main fun(): Ok
                for i = 0 upto {extent phrases - 1} do
                    let show = l.echo orif {l.printResult andif {i is {extent phrases - 1}}}
                    let phrase = phrases[i]
                    case phrase.form
                        when bindModule with x then
                            if not(x.isPrecompiled) then vector.append(modules lowerModule(l phrase)) end
                        when bindInterface then ok
                        else binding(l phrase show)
                    end
                end)
            nodes.newUnit(main modules vector.toArray(l.imports) l.sourceMap)
        end

    (* The body a module's initializer ends in, which statements after its
     * bindings are appended to *)
    let moduleEnd(l: Lowerer m: nodes.Module): Body = hashMap.find(l.moduleEnds m.id)

    (* Ends a module's initializer by making its record: of its members, or of
     * its exports *)
    let addModuleRecord(l: Lowerer m: nodes.Module): Ok =
        begin
            let fields = maybe.unwrapOr(m.exports m.members)
            let recordFields = vector.new(:model.RecordField)
            let atoms = vector.new(:nodes.FieldAtom)
            for i = 0 upto {vector.length(fields.names) - 1} do
                let n = vector.get(fields.names i)
                let v = hashMap.find(fields.vars n)
                vector.append(recordFields tuple let name = n let type = v.type let isVar = false end)
                vector.append(atoms tuple let name = n let atom = va(v) let isVar = false end)
            end
            let recordType = model.recordType(vector.toArray(recordFields) maybe.none())
            let rv = fresh(m.name <> "_record" recordType false)
            m.recordVar := some(rv)
            vector.append(moduleEnd(l m).statements
                nodes.letStmt(rv nodes.makeRecord(vector.toArray(atoms))))
        end

    let lowerProgram(prog: typedAst.Program e: env.T sourceMap: maybe.T(location.SourceMap) echo: Bool printResult: Bool):
            nodes.Unit =
        begin
            let l = newLowerer(e sourceMap 0 echo printResult)
            let unit = program(l prog)
            for i = 0 upto {vector.length(unit.modules) - 1} do
                addModuleRecord(l vector.get(unit.modules i))
            end
            unit
        end

    let lowerModuleFile(b: Binding e: env.T sourceMap: maybe.T(location.SourceMap) file: Int): nodes.Unit =
        begin
            let l = newLowerer(e sourceMap file false false)
            let unit = program(l tuple let offset = b.offset let phrases = array of b end end)
            let m = vector.get(unit.modules 0)
            let exports = nodes.newMembers()
            case b.form
                when bindModule with x then
                    for i = 0 upto {vector.length(x.scope.declarations) - 1} do
                        case vector.get(x.scope.declarations i)
                            when valueSymbol with s then
                                let sym = s.sym
                                let member = nodes.member(m.members sym.name)
                                if maybe.isNone(member) then
                                    fail(:Ok "module " <> x.name <> " does not define its interface's member '" <> sym.name <> "'")
                                end
                                let mv = maybe.unwrap(member)
                                (* An export converts to its interface's
                                 * type where it differs, or holds an
                                 * abstract type's application at a layout
                                 * of the module's own
                                 * (docs/c-representation.md section 5.1) *)
                                if subtyping.isTypeEqual(mv.type sym.type maybe.none())
                                    andif not(genericLayout.abstractLayoutsDiffer(sym.type)) then
                                    nodes.addMember(exports sym.name mv)
                                else
                                    let exported = fresh(sym.name sym.type false)
                                    vector.append(moduleEnd(l m).statements
                                        nodes.letStmt(exported nodes.opOfVar(mv)))
                                    nodes.addMember(exports sym.name exported)
                                end
                            else ok
                        end
                    end
                else ok
            end
            m.exports := maybe.some(exports)
            addModuleRecord(l m)
            unit.isProgram := false
            unit
        end

    let phraseField(symbolId: Int): String = "v" <> conv.int(symbolId)

    let phraseSeparator = "\x1e"

    (* The phrases are lowered as program() lowers them, into the initializer
     * of a module of their own, whose members are their top-level value
     * bindings (but those of type Ok, which have no words); its record is
     * made, as a module file's is, when they have run, with a var field for a
     * var (docs/jit.md section 3.2) *)
    let lowerPhrases(prog: typedAst.Program e: env.T sourceMap: maybe.T(location.SourceMap) number: Int
        earlier: hashMap.T(Int Earlier) echo: Bool printResult: Bool capture: Bool): nodes.Unit =
        begin
            let l = newLowerer(e sourceMap 0 echo printResult)
            hashMap.forEach(earlier fun(k: Int b: Earlier): Ok
                begin hashMap.insert(l.earlier k b) ok end)
            captures.capturedMutables(prog l.captured)
            l.modulePrefix := phraseModuleName(number) <> "_"
            l.boxSlots := e.interactive
            let init = nodes.newBody()
            let modules = vector.new(:nodes.Module)
            let members = nodes.newMembers()
            (* A binding of type Ok has no words to keep: it is not in the
             * record *)
            let bound(symbol: symbols.ValueSymbol): Ok =
                if boxesSlot(e symbol) then
                    (* A slot's box, which a redefinition stores to and does
                     * not add *)
                    if not(env.redefines(e symbol)) then
                        nodes.addMember(members phraseField(symbol.symbolId)
                            hashMap.find(l.boxes symbol.symbolId))
                    end
                elsif env.redefines(e symbol) then
                    (* A redefined slot of type Ok, which has no words *)
                    ok
                else
                    let v = hashMap.find(l.vars symbol.symbolId)
                    let name = phraseField(symbol.symbolId)
                    if not(isOk(v.type)) andif maybe.isNone(nodes.member(members name)) then
                        nodes.addMember(members name v)
                    end
                end
            let var lastBody = init
            inBody(l init fun(): Ok
                begin
                    for i = 0 upto {extent prog.phrases - 1} do
                        let phrase = prog.phrases[i]
                        (* What a phrase shows (all with echo, the last with
                         * printResult) the runtime writes as it runs; captured,
                         * each phrase's begins with a separator line *)
                        let show = echo orif {printResult andif {i is {extent prog.phrases - 1}}}
                        if capture then emit(l option sEchoText of Stmt with let text = phraseSeparator end) end
                        case phrase.form
                            when bindModule with x then
                                if not(x.isPrecompiled) then
                                    (* Its record is exported, for later
                                     * inputs *)
                                    let dm = lowerModule(l phrase)
                                    dm.exports := maybe.some(dm.members)
                                    addModuleRecord(l dm)
                                    vector.append(modules dm)
                                end
                            when bindInterface then ok
                            when bindLetValue with x then
                                binding(l phrase show)
                                bound(x.value.symbol)
                            when bindLetValueGroup with x then
                                binding(l phrase show)
                                for j = 0 upto {extent x.members - 1} do bound(x.members[j].symbol) end
                            else binding(l phrase show)
                        end
                        (* An exception it declares, which later inputs may
                         * raise and catch *)
                        let exc = typedAst.declaredException(phrase)
                        if maybe.isSome(exc) then
                            case maybe.unwrap(exc).form
                                when exprException with y then bound(maybe.unwrap(y.symbol))
                                else ok
                            end
                        end
                    end
                    lastBody := l.body
                end)
            (* Its record, of its members' values when the phrases have run,
             * made where they end (after a join, in its continuation) *)
            let recordFields = vector.new(:model.RecordField)
            let atoms = vector.new(:nodes.FieldAtom)
            for i = 0 upto {vector.length(members.names) - 1} do
                let n = vector.get(members.names i)
                let v = hashMap.find(members.vars n)
                vector.append(recordFields
                    tuple let name = n let type = v.type let isVar = v.isMutable end)
                vector.append(atoms tuple let name = n let atom = va(v) let isVar = v.isMutable end)
            end
            let recordType = model.recordType(vector.toArray(recordFields) maybe.none())
            let rv = fresh(phraseModuleName(number) <> "_record" recordType false)
            l.body := lastBody
            emit(l nodes.letStmt(rv nodes.makeRecord(vector.toArray(atoms))))
            let m = nodes.newModule(phraseModuleName(number) "" init members)
            m.exports := maybe.some(members)
            m.recordVar := some(rv)
            vector.append(modules m)
            let unit = nodes.newUnit(nodes.newBody() modules vector.toArray(l.imports) sourceMap)
            unit.phrase := maybe.some(tuple let number = number let capture = capture end)
            unit
        end
end
