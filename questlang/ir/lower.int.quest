(* Quest Self-Hosted Compiler: Lowering to Core IR Interface
 *
 * Lowers a typed AST into a Core IR unit (docs/ir.md section 1; counterpart
 * in bootstrap/python/quest/ir/lower.py). Each expression is lowered into the
 * current body, producing an atom (a variable or constant) for its value;
 * expressions that yield a value along multiple control paths merge them via
 * a join point (a local labeled continuation). Every typed-AST symbol maps to
 * a single IR variable when its binder is lowered. Unlike the bootstrap's
 * lower_program, which reads echo from compiler options, this interface takes
 * echo and printResult explicitly. *)

interface Lower
import
    collections/hashMap : collections/HashMap
    util/maybe : util/Maybe

    questlang/common/location : questlang/common/Location
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/typechecker/typedAst : questlang/typechecker/TypedAST
    questlang/types/env : questlang/types/Env
    questlang/types/model : questlang/types/Model
    questlang/types/symbols : questlang/types/Symbols
export
    (* A typed program the lowering does not handle (a gap in the lowering, not
     * an error in the program) *)
    loweringError: Exception(String)

    (* A typed program lowered to a Core IR unit: echo prints every phrase's
     * result, printResult the last one's *)
    lowerProgram(program: typedAst.Program e: env.T sourceMap: maybe.T(location.SourceMap) echo: Bool
            printResult: Bool):
            nodes.Unit
    (* A module file's typed module lowered to a unit of the module alone, with
     * its exports, its offsets those of the file numbered file
     * (nodes.fileOffset: 0 but for the modules driver/whole merges) *)
    lowerModuleFile(m: typedAst.Binding e: env.T sourceMap: maybe.T(location.SourceMap) file: Int): nodes.Unit

    (* Describes a binding from an earlier REPL input that a phrase unit reads
     * (or writes, if isVar) as a field of a module record (docs/jit.md section
     * 3.2). holder names the module owning the record, field names the record
     * field (empty when referring to a module declared or imported by that
     * input), and recordType is the record's type. When boxed is true, the
     * field holds a mutable box for a redefinable interactive slot, keyed by
     * the slot's first symbol id. *)
    Def Earlier = Tuple holder: String field: String recordType: model.Type isVar: Bool boxed: Bool end
    (* Whether a phrase unit holds a symbol's interactive top-level let slot in
     * a box (all such slots except those of type Ok) *)
    boxesSlot(e: env.T sym: symbols.ValueSymbol): Bool
    (* The module whose initializer runs input number's phrases (qj_<number>),
     * whose name begins the names of the modules the input declares
     * (qj_<number>_<name>), and its record's field for the binding of the
     * symbol symbolId *)
    phraseModuleName(number: Int): String
    phraseField(symbolId: Int): String
    (* Lowers REPL input number into a phrase unit (nodes.Phrase), resolving
     * references to earlier inputs' bindings via earlier (keyed by symbol id).
     * Results are echoed like a program's (every phrase with echo, or the last
     * with printResult); when capture is true, each phrase's output is
     * prefixed by a phraseSeparator line so the REPL can split it. *)
    phraseSeparator: String
    lowerPhrases(program: typedAst.Program e: env.T sourceMap: maybe.T(location.SourceMap) number: Int
            earlier: hashMap.T(Int Earlier) echo: Bool printResult: Bool capture: Bool): nodes.Unit
end
