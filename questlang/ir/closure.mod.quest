(* Quest Self-Hosted Compiler: Closure Conversion Implementation *)

module closure : Closure
import
    questlang/types/model : questlang/types/Model
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/walk : questlang/ir/Walk
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
export
    Let Variable = nodes.Variable
    Let Body = nodes.Body
    Let Stmt = nodes.Stmt

    let capturesMutable: Exception(String) = exception capturesMutable: String end

    let intEqual(a: Int b: Int): Bool = a is b

    (* The unit, to whose functions lifted ones are added, and its globals
     * (walk.globalVariables), which lifted functions read directly rather
     * than capture *)
    Let Converter = Tuple unit: nodes.Unit globals: hashMap.T(Int Bool) end

    let concat(a: Array(nodes.TypeParam) b: Array(nodes.TypeParam)): Array(nodes.TypeParam) =
        begin
            let result = vector.fromArray(a)
            for i = 0 upto {extent b - 1} do vector.append(result b[i]) end
            vector.toArray(result)
        end

    (* Replaces, in place, the uses in body of the variables renamed maps (none
     * of which body binds) *)
    let rename(b: Body renamed: hashMap.T(Int Variable)): Ok =
        begin
            let stmts = walk.walkStatements(b false)
            let f = fun(v: Variable): Variable maybe.unwrapOr(hashMap.get(renamed v.id) v)
            for i = 0 upto {vector.length(stmts) - 1} do walk.replaceVarsInStmt(vector.get(stmts i) f) end
        end

    Let Lifted = Tuple code: nodes.Function captures: Array(Variable) end

    (* Replaces, in place, the funs statements of b and of the bodies it holds
     * by lets of closures of their lifted functions (funs); typeParams are
     * the type parameters of the functions enclosing b, outermost first *)
    let rec convertBody(c: Converter b: Body typeParams: Array(nodes.TypeParam)): Ok =
        begin
            let statements = vector.new(:Stmt)
            for i = 0 upto {vector.length(b.statements) - 1} do
                let s = vector.get(b.statements i)
                case s
                    when sFuns with x then
                        let lets = funs(c x.functions x.recursive typeParams)
                        for j = 0 upto {extent lets - 1} do vector.append(statements lets[j]) end
                    else
                        let bodies = walk.statementBodies(s)
                        for j = 0 upto {extent bodies - 1} do convertBody(c bodies[j] typeParams) end
                        vector.append(statements s)
                end
            end
            b.statements := statements
        end

    (* The statements that replace a funs statement binding functions (a let
     * rec when recursive), nested in functions whose type parameters,
     * outermost first, are typeParams: a let of each function's closure, of
     * its lifted code and its captures, passing typeParams to the code as its
     * leading type arguments. When a closure captures one of the group, the
     * lets are in a let rec, so that each closure can hold the others. But
     * when the group captures nothing but its own functions and no
     * polymorphic function encloses it, no closure needs an environment: each
     * code reads the others as closures without captures (docs/ir.md section
     * 8.2), which are static, rather than allocated each time the enclosing
     * function runs *)
    and funs(c: Converter functions: Array(nodes.Function) recursive: Bool typeParams: Array(nodes.TypeParam)): Array(Stmt) =
        begin
            let typeArgs = array of(extent typeParams model.okType)
            for i = 0 upto {extent typeParams - 1} do
                let tp = typeParams[i]
                typeArgs[i] := model.typeVariable(tp.name tp.symbolId maybe.some(tp.kind))
            end
            let lets = vector.new(:Stmt)
            let var capturesGroup = false
            let group = hashMap.new(:Int :Bool intEqual hash.int)
            for i = 0 upto {extent functions - 1} do hashMap.insert(group functions[i].v.id true) end
            let all = array of(extent functions tuple
                let code = functions[0] let captures = array of :Variable end
            end)
            (* Whether the group's functions capture nothing but each other *)
            let var closed = extent typeParams is 0
            for i = 0 upto {extent functions - 1} do
                all[i] := lift(c functions[i] typeParams)
                for j = 0 upto {extent all[i].captures - 1} do
                    if hashMap.contains(group all[i].captures[j].id) then capturesGroup := true
                    else closed := false end
                end
            end
            if closed andif capturesGroup then
                (* Then each function's closure is static: what it reads from
                 * its environment is the static closure of another (as a
                 * specialized local function's of itself, docs/ir.md section
                 * 8.6), and none needs one *)
                let codes = hashMap.new(:Int :nodes.Function intEqual hash.int)
                for i = 0 upto {extent functions - 1} do
                    hashMap.insert(codes functions[i].v.id all[i].code)
                end
                for i = 0 upto {extent functions - 1} do
                    let code = all[i].code
                    let n = extent all[i].captures
                    (* lift began the code's body with a let of each capture
                     * read from the environment, in capture order *)
                    for k = 0 upto {n - 1} do
                        case vector.get(code.body.statements k)
                            when sLet with x then
                                x.value := option opMakeClosure of nodes.Op with
                                    let var code = hashMap.find(codes all[i].captures[k].id)
                                    let var captures = array of :nodes.Atom end
                                    let var typeArgs = array of :model.Type end
                                    let var descriptors = array of :nodes.Descriptor end
                                end
                            else ok
                        end
                    end
                    code.env := maybe.none()
                    all[i] := tuple let code = code let captures = array of :Variable end end
                end
                capturesGroup := false
            end
            for i = 0 upto {extent functions - 1} do
                let f = functions[i]
                let lifted = all[i]
                let captures = array of(extent lifted.captures nodes.atomOfVar(f.v))
                for j = 0 upto {extent lifted.captures - 1} do captures[j] := nodes.atomOfVar(lifted.captures[j]) end
                vector.append(lets nodes.letStmt(f.v option opMakeClosure of nodes.Op with
                    let var code = lifted.code
                    let var captures = captures
                    let var typeArgs = typeArgs
                    let var descriptors = array of :nodes.Descriptor end
                end))
            end
            if recursive andif capturesGroup then
                let vars = array of(extent functions functions[0].v)
                for i = 0 upto {extent functions - 1} do vars[i] := functions[i].v end
                array of option sLetRec of Stmt with let var vars = vars let var body = nodes.bodyOf(vector.toArray(lets)) end end
            else
                vector.toArray(lets)
            end
        end

    (* The lifted function, added to the unit's, and the variables its closures
     * capture *)
    and lift(c: Converter f: nodes.Function typeParams: Array(nodes.TypeParam)): Lifted =
        begin
            convertBody(c f.body concat(typeParams f.typeParams))
            let bound = hashMap.new(:Int :Bool intEqual hash.int)
            for i = 0 upto {extent f.params - 1} do hashMap.insert(bound f.params[i].v.id true) end
            let used = vector.new(:Variable)
            let usedIds = hashMap.new(:Int :Bool intEqual hash.int)
            let stmts = walk.walkStatements(f.body false)
            for i = 0 upto {vector.length(stmts) - 1} do
                let s = vector.get(stmts i)
                let binders = walk.statementBinders(s)
                for j = 0 upto {extent binders - 1} do hashMap.insert(bound binders[j].id true) end
                let uses = walk.statementUses(s)
                for j = 0 upto {extent uses - 1} do
                    case uses[j]
                        when atomVar with x then
                            if not(hashMap.contains(usedIds x.v.id)) then
                                hashMap.insert(usedIds x.v.id true)
                                vector.append(used x.v)
                            end
                        else ok
                    end
                end
            end
            let captures = vector.new(:Variable)
            for i = 0 upto {vector.length(used) - 1} do
                let v = vector.get(used i)
                if not(hashMap.contains(bound v.id)) andif not(hashMap.contains(c.globals v.id)) then
                    vector.append(captures v)
                end
            end
            let var env = maybe.none(:Variable)
            if not(vector.empty(captures)) orif {extent typeParams > 0} then
                (* The environment (of the captured values, and of the
                 * descriptors of the enclosing functions' type parameters) is
                 * not a value of a Quest type; its type is a placeholder (it
                 * prints without one) *)
                let e = nodes.newVar("env" model.okType false)
                env := maybe.some(e)
                let renamed = hashMap.new(:Int :Variable intEqual hash.int)
                let prologue = vector.new(:Stmt)
                for i = 0 upto {vector.length(captures) - 1} do
                    let captured = vector.get(captures i)
                    if captured.isMutable then
                        raise capturesMutable with
                            "function '" <> f.v.hint <> "' captures mutable variable '" <> captured.hint <> "'"
                        end
                    end
                    let local = nodes.newVar(captured.hint captured.type false)
                    hashMap.insert(renamed captured.id local)
                    vector.append(prologue nodes.letStmt(local option opEnvField of nodes.Op with
                        let var env = nodes.atomOfVar(e)
                        let index = i
                    end))
                end
                rename(f.body renamed)
                for i = 0 upto {vector.length(f.body.statements) - 1} do
                    vector.append(prologue vector.get(f.body.statements i))
                end
                f.body.statements := prologue
            end
            let code = nodes.newFunction(nodes.newVar(f.v.hint f.v.type false) concat(typeParams f.typeParams) f.params
                f.resultType f.body f.traceName)
            code.env := env
            vector.append(c.unit.functions code)
            tuple let code = code let captures = vector.toArray(captures) end
        end

    let closureConvertUnit(unit: nodes.Unit): nodes.Unit =
        begin
            let c = tuple let unit = unit let globals = walk.globalVariables(unit) end
            for i = 0 upto {vector.length(unit.modules) - 1} do
                convertBody(c vector.get(unit.modules i).init array of :nodes.TypeParam end)
            end
            convertBody(c unit.main array of :nodes.TypeParam end)
            unit.stage := "closed"
            unit
        end
end
