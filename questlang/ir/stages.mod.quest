(* Quest Self-Hosted Compiler: The IR's Stages Implementation *)

module stages : Stages
export
    Def Stage = Option stageCore stageSimplified stageSpecialized stageClosed stageRepresented stageDescribed end

    (* A stage's position in all *)
    let index(s: Stage): Int =
        case s
            when stageCore then 0
            when stageSimplified then 1
            when stageSpecialized then 2
            when stageClosed then 3
            when stageRepresented then 4
            when stageDescribed then 5
        end

    let core: Stage = option stageCore of Stage end
    let simplified: Stage = option stageSimplified of Stage end
    let specialized: Stage = option stageSpecialized of Stage end
    let closed: Stage = option stageClosed of Stage end
    let represented: Stage = option stageRepresented of Stage end
    let described: Stage = option stageDescribed of Stage end

    let all = array of core simplified specialized closed represented described end

    let name(s: Stage): String =
        case s
            when stageCore then "core"
            when stageSimplified then "simplified"
            when stageSpecialized then "specialized"
            when stageClosed then "closed"
            when stageRepresented then "represented"
            when stageDescribed then "described"
        end

    let atLeast(a: Stage b: Stage): Bool = index(a) >= index(b)
end
