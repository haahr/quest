(* Quest Self-Hosted Compiler: The Simplifier Implementation *)

module simplify : Simplify
import
    questlang/types/model : questlang/types/Model
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/walk : questlang/ir/Walk
    questlang/repr/genericLayout : questlang/repr/GenericLayout
    questlang/ir/clone : questlang/ir/Clone
    questlang/ir/inline : questlang/ir/Inline
    questlang/ir/contify : questlang/ir/Contify
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    util/strutil : util/Strutil
    conv : Conv
    stringOp = string : StringOp
    system : System
    intOp = int : IntOp
export
    Let Variable = nodes.Variable
    Let Atom = nodes.Atom
    Let Body = nodes.Body
    Let Stmt = nodes.Stmt
    Let Op = nodes.Op

    let intEqual(a: Int b: Int): Bool = a is b
    let eq(a: String b: String): Bool = stringOp.equal(a b)

    (* Returns default, or the integer override for name in QUEST_INLINE (a
     * comma-separated list such as rounds=3,size=60; docs/inlining.md
     * section 1) *)
    let setting(name: String default: Int): Int =
        begin
            let var value = default
            let pairs = strutil.split(system.getEnv("QUEST_INLINE") ",")
            for i = 0 upto {vector.length(pairs) - 1} do
                let pair = strutil.split(vector.get(pairs i) "=")
                if {vector.length(pair) is 2} andif eq(vector.get(pair 0) name) then
                    value := strutil.toInt(vector.get(pair 1))
                end
            end
            value
        end

    (* The most rounds the simplifier makes over a unit: each round simplifies
     * what the last one made simpler, and inlines into what it inlined *)
    let maxRounds = setting("rounds" 6)

    (* Inlining heuristics (docs/ir.md section 8.6): a function is inlined if
     * it is called once (regardless of size) or if its size minus call-site
     * bonuses is at most inlineSize. Small-function inlining stops once the
     * unit has grown by growthPercent (75%) of its initial size, or by
     * minimumBudget if that is larger. *)
    let inlineSize = setting("size" 30)
    let minimumBudget = setting("budget" 1000)
    let growthPercent = setting("growth" 75)
    (* The call supplies type arguments: the caller no longer calls a
     * polymorphic function *)
    let polymorphicBonus = setting("polymorphic" 30)
    (* An argument that is a known function, whose calls then are known *)
    let functionBonus = setting("function" 10)
    (* An argument that is a constant, which the callee may branch on *)
    let constantBonus = setting("constant" 5)

    Let Simplifier = Tuple
        (* How many times each variable is used, by id, counted at the start of
         * the round *)
        uses: hashMap.T(Int Int)
        (* The variables kept whatever their use counts say, since uses the
         * counts do not see may name them: modules' members, exports, and
         * record variables, which are named from outside the unit's bodies,
         * and let rec's variables, whose values its body makes *)
        pinned: hashMap.T(Int Bool)
        (* The operation each immutable variable is bound to by a let, by id,
         * for those met so far *)
        defs: hashMap.T(Int Op)
        (* Maps eliminated copy-binding variable ids to their source variables,
         * and eliminated constant-binding variable ids to their constant
         * atoms *)
        renames: hashMap.T(Int Variable)
        consts: hashMap.T(Int Atom)
        (* The tag each immutable variable is known to have, by id, in the
         * then-branch of an if on its is_tag being simplified *)
        tags: hashMap.T(Int String)
        (* The variable each tuple_field read so far was bound to, by its
         * tuple's variable's id and its index, while nothing since can have
         * changed the component (a var one): a later read of it is a copy *)
        var loads: hashMap.T(String Variable)
        var changed: Bool
        (* The unit's functions, as the round began *)
        var analysis: inline.Analysis
        (* The labels inlining made, and how much it has grown the unit, of
         * how much it may *)
        labels: clone.Labels
        var grown: Int
        var budget: Int
    end

    (* ======================================================================
     * What the round knows
     * ====================================================================== *)

    let setRename(s: Simplifier id: Int v: Variable): Ok = begin hashMap.insert(s.renames id v) ok end
    let setDef(s: Simplifier id: Int o: Op): Ok = begin hashMap.insert(s.defs id o) ok end
    let setConst(s: Simplifier id: Int a: Atom): Ok = begin hashMap.insert(s.consts id a) ok end

    (* Counts every use of each variable in the unit, and pins the variables
     * named from outside its bodies and let rec's *)
    let count(s: Simplifier unit: nodes.Unit): Ok = walk.countUses(unit s.uses s.pinned)

    let usesOf(s: Simplifier v: Variable): Int = maybe.unwrapOr(hashMap.get(s.uses v.id) 0)
    let pinned(s: Simplifier v: Variable): Bool = hashMap.contains(s.pinned v.id)

    (* The operation an atom's variable is bound to, if it is an immutable
     * one bound by a let met so far *)
    let defOf(s: Simplifier a: Atom): maybe.T(Op) =
        case a
            when atomVar with x then hashMap.get(s.defs x.v.id)
            when atomConst then maybe.none()
        end

    (* The constant an atom is, or its variable is bound to *)
    let constOf(s: Simplifier a: Atom): maybe.T(nodes.ConstValue) =
        case a
            when atomConst with x then maybe.some(x.c.value)
            when atomVar then
                let d = defOf(s a)
                if maybe.isSome(d) then
                    case maybe.unwrap(d)
                        when opAtom with x then
                            case x.atom
                                when atomConst with c then maybe.some(c.c.value)
                                when atomVar then maybe.none()
                            end
                        else maybe.none()
                    end
                else
                    maybe.none()
                end
        end

    let boolOf(s: Simplifier a: Atom): maybe.T(Bool) =
        begin
            let c = constOf(s a)
            if maybe.isSome(c) then
                case maybe.unwrap(c)
                    when constBool with x then maybe.some(x.b)
                    else maybe.none()
                end
            else
                maybe.none()
            end
        end

    let intOf(s: Simplifier a: Atom): maybe.T(Int) =
        begin
            let c = constOf(s a)
            if maybe.isSome(c) then
                case maybe.unwrap(c)
                    when constInt with x then maybe.some(x.n)
                    else maybe.none()
                end
            else
                maybe.none()
            end
        end

    (* An option's or variant's tag and payload, made by the operation an atom's
     * variable is bound to, directly or through copies (of another type, such
     * as maybe.T(Int) of T(Int), which copy propagation leaves), and whether
     * it is a variant's *)
    Let Made = Tuple tag: String payload: maybe.T(Atom) isVariant: Bool end
    let rec madeOf(s: Simplifier a: Atom): maybe.T(Made) =
        begin
            let d = defOf(s a)
            if maybe.isSome(d) then
                case maybe.unwrap(d)
                    when opAtom with x then
                        case x.atom
                            when atomVar with y then if y.v.isMutable then maybe.none() else madeOf(s x.atom) end
                            when atomConst then maybe.none()
                        end
                    when opMakeVariant with x then
                        maybe.some(tuple let tag = x.tag let payload = x.payload let isVariant = true end)
                    when opMakeOption with x then
                        if maybe.isSome(x.tag) then
                            maybe.some(tuple
                                let tag = maybe.unwrap(x.tag) let payload = x.payload let isVariant = false
                            end)
                        else
                            maybe.none()
                        end
                    else maybe.none()
                end
            else
                maybe.none()
            end
        end

    (* The tag an atom's value is known to have: made in scope, as madeOf
     * says, or tested by an enclosing if whose then-branch this is, with no
     * payload known *)
    let tagOf(s: Simplifier a: Atom): maybe.T(Made) =
        begin
            let m = madeOf(s a)
            if maybe.isSome(m) then
                m
            else
                case a
                    when atomVar with x then
                        let t = hashMap.get(s.tags x.v.id)
                        if maybe.isSome(t) then
                            maybe.some(tuple
                                let tag = maybe.unwrap(t)
                                let payload = maybe.none(:Atom)
                                let isVariant = shapes.kindIs(shapes.shape(x.v.type) shapes.shapeVariant)
                            end)
                        else
                            maybe.none()
                        end
                    when atomConst then maybe.none()
                end
            end
        end

    (* ======================================================================
     * Operations
     * ====================================================================== *)


    (* Whether two atoms are options made by operations the simplifier knows *)
    let knownOptions(s: Simplifier a: Atom b: Atom): Bool =
        begin
            let m = madeOf(s a)
            let n = madeOf(s b)
            maybe.isSome(m) andif maybe.isSome(n) andif not(maybe.unwrap(m).isVariant)
                andif not(maybe.unwrap(n).isVariant)
        end

    let boolConst(b: Bool): Op =
        nodes.opOfAtom(nodes.atomOfConst(tuple
            let value = option constBool of nodes.ConstValue with let b = b end
            let shape = shapes.shape(model.boolType)
        end))
    let intConst(n: Int): Op =
        nodes.opOfAtom(nodes.atomOfConst(tuple
            let value = option constInt of nodes.ConstValue with let n = n end
            let shape = shapes.shape(model.intType)
        end))

    (* Whether evaluating an operation can do nothing but compute its value:
     * no effect, no exception *)
    let pure(o: nodes.Op): Bool =
        case o
            when opPrim with x then
                case x.op
                    (* Int division by zero raises int.error, and Real
                     * arithmetic with an infinite or NaN result real.error;
                     * Int arithmetic otherwise wraps *)
                    when primDiv, primRem, primMod, primRealAdd, primRealSub, primRealMul, primRealDiv,
                        primRealPow then false
                    when primAdd, primSub, primMul, primLt, primLe, primGt, primGe, primRealLt, primRealLe, primRealGt,
                        primRealGe, primConcat, primAnd, primOr, primIs, primIsnot, primNot, primExtent then true
                end
            when opAtom, opExternal, opMakeClosure, opEnvField, opMakeTuple, opTupleField, opMakeRecord, opRecordField,
                opMakeVariant, opMakeOption, opIsTag, opOrdinal, opMakeArray, opMakeAuto, opMakeException,
                opExceptionPayload, opAddrVar, opIsSet, opAddrCell, opAddrField, opAddrComponent, opLoad then true
            (* A module's member is read from its record or its global, both
             * made before any code that names it runs *)
            when opModuleMember then true
            (* A payload raises when the value is of another case, unless it
             * is decided *)
            when opPayload with x then x.decided
            when opCall, opTypeApp, opBuiltin, opCallExternal, opConvert, opArrayRep,
                opIndex, opCaughtException, opAddrElement then false
        end

    (* An Int primitive's result on constants, unless it raises (division by
     * zero) *)
    let foldInt(op: nodes.Prim a: Int b: Int): maybe.T(Op) =
        try
            case op
                when primAdd then maybe.some(intConst(a + b))
                when primSub then maybe.some(intConst(a - b))
                when primMul then maybe.some(intConst(a * b))
                when primDiv then maybe.some(intConst(a / b))
                when primRem, primMod then maybe.some(intConst(a % b))
                when primLt then maybe.some(boolConst(a < b))
                when primLe then maybe.some(boolConst(a <= b))
                when primGt then maybe.some(boolConst(a > b))
                when primGe then maybe.some(boolConst(a >= b))
                when primIs then maybe.some(boolConst(a is b))
                when primIsnot then maybe.some(boolConst(a isnot b))
                else maybe.none()
            end
        when intOp.error then
            maybe.none()
        end

    let foldPrim(s: Simplifier x: nodes.OpPrim): maybe.T(Op) =
        if {extent x.args is 2} andif {x.op?primIs orif x.op?primIsnot} andif knownOptions(s x.args[0] x.args[1]) then
            (* Options of different cases are never the same, and of one case
             * made without components always are (docs/extensions.md,
             * Options as Values) *)
            let a = maybe.unwrap(madeOf(s x.args[0]))
            let b = maybe.unwrap(madeOf(s x.args[1]))
            if eq(a.tag b.tag) andif {maybe.isSome(a.payload) orif maybe.isSome(b.payload)} then
                maybe.none()
            else
                maybe.some(boolConst(eq(a.tag b.tag) is x.op?primIs))
            end
        elsif {extent x.args is 1} andif {case x.op when primNot then true else false end} then
            let b = boolOf(s x.args[0])
            if maybe.isSome(b) then maybe.some(boolConst(not(maybe.unwrap(b)))) else maybe.none() end
        elsif extent x.args is 2 then
            let i = intOf(s x.args[0])
            let j = intOf(s x.args[1])
            let p = boolOf(s x.args[0])
            let q = boolOf(s x.args[1])
            if maybe.isSome(i) andif maybe.isSome(j) then
                foldInt(x.op maybe.unwrap(i) maybe.unwrap(j))
            elsif maybe.isSome(p) andif maybe.isSome(q) then
                let a = maybe.unwrap(p)
                let b = maybe.unwrap(q)
                case x.op
                    when primAnd then maybe.some(boolConst(a andif b))
                    when primOr then maybe.some(boolConst(a orif b))
                    when primIs then maybe.some(boolConst(a is b))
                    when primIsnot then maybe.some(boolConst(a isnot b))
                    else maybe.none()
                end
            else
                maybe.none()
            end
        else
            maybe.none()
        end

    (* Whether an atom has one value wherever it is in scope: a constant, or an
     * immutable variable (not a mutable one, which a later read may find
     * changed since the value was made of it) *)
    let stable(a: Atom): Bool =
        case a
            when atomVar with x then not(x.v.isMutable)
            when atomConst then true
        end

    (* Whether a tuple type's component is a var one (or unknown) *)
    let varComponent(t: model.Type index: Int): Bool =
        begin
            let sh = shapes.shape(t)
            {index >= extent sh.components} orif sh.components[index].isVar
        end

    (* The atom whose variable a tuple was made into, found from an atom
     * bound to it directly or through copies (of another type, such as
     * iter.T(Int) of the tuple, which copy propagation leaves), if any *)
    let rec tupleSource(s: Simplifier a: Atom): maybe.T(Atom) =
        begin
            let d = defOf(s a)
            if maybe.isSome(d) then
                case maybe.unwrap(d)
                    when opAtom with x then
                        case x.atom
                            when atomVar with y then if y.v.isMutable then maybe.none() else tupleSource(s x.atom) end
                            when atomConst then maybe.none()
                        end
                    when opMakeTuple then maybe.some(a)
                    else maybe.none()
                end
            else
                maybe.none()
            end
        end

    (* The operation that replaces another, if it is simpler *)
    let simpler(s: Simplifier o: Op): maybe.T(Op) =
        case o
            when opPrim with x then foldPrim(s x)
            when opTupleField with x then
                let src = tupleSource(s x.tup)
                if maybe.isSome(src) then
                    case maybe.unwrap(defOf(s maybe.unwrap(src)))
                        when opMakeTuple with t then
                            if {x.index < extent t.args} andif not(varComponent(nodes.atomType(x.tup) x.index))
                                andif not(varComponent(nodes.atomType(maybe.unwrap(src)) x.index))
                                andif stable(t.args[x.index]) then
                                maybe.some(nodes.opOfAtom(t.args[x.index]))
                            else
                                maybe.none()
                            end
                        else maybe.none()
                    end
                else
                    maybe.none()
                end
            when opIsTag with x then
                let m = tagOf(s x.value)
                if maybe.isSome(m) then maybe.some(boolConst(eq(maybe.unwrap(m).tag x.tag)))
                else maybe.none() end
            when opOrdinal with x then
                (* A known option's ordinal: its case's position in the cases
                 * as written *)
                let m = tagOf(s x.value)
                let var n = ~1
                if maybe.isSome(m) andif not(maybe.unwrap(m).isVariant) then
                    for i = 0 upto {extent x.cases - 1} do
                        if eq(x.cases[i] maybe.unwrap(m).tag) then n := i end
                    end
                end
                if n >= 0 then maybe.some(intConst(n)) else maybe.none() end
            when opPayload with x then
                (* A variant's payload is the value it was made of; an
                 * option's is a new tuple (of its ordinal and its
                 * components). Either, of a value known to be of its case,
                 * is decided: it needs no test of the tag, and cannot
                 * raise *)
                let m = tagOf(s x.value)
                let known = maybe.isSome(m) andif eq(maybe.unwrap(m).tag x.tag)
                if known andif maybe.unwrap(m).isVariant andif maybe.isSome(maybe.unwrap(m).payload)
                    andif stable(maybe.unwrap(maybe.unwrap(m).payload)) then
                    maybe.some(nodes.opOfAtom(maybe.unwrap(maybe.unwrap(m).payload)))
                elsif known andif not(x.decided) then
                    x.decided := true
                    maybe.some(o)
                else
                    maybe.none()
                end
            else maybe.none()
        end

    let simplified(s: Simplifier o: Op): Op =
        begin
            let r = simpler(s o)
            if maybe.isSome(r) then begin s.changed := true maybe.unwrap(r) end else o end
        end

    (* ======================================================================
     * Statements
     * ====================================================================== *)

    let rename(s: Simplifier): All(v: Variable) Variable =
        fun(v: Variable): Variable maybe.unwrapOr(hashMap.get(s.renames v.id) v)
    let constant(s: Simplifier): All(a: Atom) Atom =
        fun(a: Atom): Atom
            case a
                when atomVar with x then maybe.unwrapOr(hashMap.get(s.consts x.v.id) a)
                when atomConst then a
            end

    (* The constant a let of one binds its variable to, where every use of the
     * variable can be the constant: one of the variable's shape, and not a
     * String, whose identity is that of the variable's one value *)
    let propagated(s: Simplifier x: nodes.StmtLet): maybe.T(Atom) =
        case x.value
            when opAtom with a then
                case a.atom
                    when atomConst with c then
                        let isString = case c.c.value when constString then true else false end
                        if not(isString) andif not(pinned(s x.v)) andif not(x.v.isMutable)
                            andif {c.c.shape.id is shapes.shape(x.v.type).id} then
                            maybe.some(a.atom)
                        else
                            maybe.none()
                        end
                    when atomVar then maybe.none()
                end
            else maybe.none()
        end

    (* The case of a switch on a known tag: its body and binder, or the else
     * body, if any *)
    (* The case of a switch that matches tag, if one does *)
    let caseOf(x: nodes.StmtSwitch tag: String): maybe.T(nodes.Case) =
        begin
            let var found = maybe.none(:nodes.Case)
            for i = 0 upto {extent x.cases - 1} do
                for j = 0 upto {extent x.cases[i].tags - 1} do
                    if maybe.isNone(found) andif eq(x.cases[i].tags[j] tag) then found := maybe.some(x.cases[i]) end
                end
            end
            found
        end

    (* The immutable variable an if's condition tests the tag of, and the
     * tag, when the condition is bound to an is_tag *)
    Let Tested = Tuple id: Int tag: String end
    let tested(s: Simplifier cond: Atom): maybe.T(Tested) =
        begin
            let d = defOf(s cond)
            if maybe.isSome(d) then
                case maybe.unwrap(d)
                    when opIsTag with x then
                        case x.value
                            when atomVar with y then
                                if y.v.isMutable then maybe.none()
                                else maybe.some(tuple let id = y.v.id let tag = x.tag end)
                                end
                            when atomConst then maybe.none()
                        end
                    else maybe.none()
                end
            else
                maybe.none()
            end
        end

    (* Forgets the tuple_field reads, at a statement that may change a
     * component or that holds bodies, which start with none known *)
    let forget(s: Simplifier): Ok = hashMap.clear(s.loads)

    (* The key of a tuple_field read of an immutable variable's component in
     * s.loads *)
    let loadKey(o: Op): maybe.T(String) =
        case o
            when opTupleField with x then
                case x.tup
                    when atomVar with b then
                        if b.v.isMutable then maybe.none()
                        else maybe.some(conv.int(b.v.id) <> "." <> conv.int(x.index))
                        end
                    when atomConst then maybe.none()
                end
            else maybe.none()
        end

    (* A tuple_field read, bound to v, of a component an earlier read kept in
     * s.loads made, as a copy of the earlier one's variable *)
    let loaded(s: Simplifier v: Variable o: Op): maybe.T(Op) =
        begin
            let key = loadKey(o)
            let earlier = if maybe.isSome(key) then hashMap.get(s.loads maybe.unwrap(key))
                else maybe.none(:Variable) end
            if maybe.isSome(earlier) andif nodes.sameType(maybe.unwrap(earlier).type v.type) then
                maybe.some(nodes.opOfAtom(nodes.atomOfVar(maybe.unwrap(earlier))))
            else
                maybe.none()
            end
        end

    (* Keeps a let's tuple_field read, of an immutable variable v, for later
     * reads of the component *)
    let remember(s: Simplifier v: Variable o: Op): Ok =
        begin
            let key = loadKey(o)
            if maybe.isSome(key) andif not(v.isMutable) then
                hashMap.insert(s.loads maybe.unwrap(key) v)
                ok
            end
        end

    Let Chosen = Tuple body: Body binder: maybe.T(Variable) end
    let chosen(x: nodes.StmtSwitch tag: String): maybe.T(Chosen) =
        begin
            let var found = maybe.none(:Chosen)
            for i = 0 upto {extent x.cases - 1} do
                if maybe.isNone(found) then
                    let c = x.cases[i]
                    for j = 0 upto {extent c.tags - 1} do
                        if eq(c.tags[j] tag) then
                            found := maybe.some(tuple let body = c.body let binder = c.binder end)
                        end
                    end
                end
            end
            if maybe.isNone(found) andif maybe.isSome(x.elseBody) then
                found := maybe.some(tuple
                    let body = maybe.unwrap(x.elseBody)
                    let binder = maybe.none(:Variable)
                end)
            end
            found
        end

    (* ======================================================================
     * Inlining
     * ====================================================================== *)

    (* The variable a variable's copies lead back to, and whether each of
     * them, and it, is used once *)
    Let Resolved = Tuple v: Variable once: Bool end
    let resolve(s: Simplifier v0: Variable): Resolved =
        begin
            let var v = v0
            let var once = {usesOf(s v0) is 1} andif not(pinned(s v0))
            let var more = true
            while more do
                more := false
                let d = hashMap.get(s.defs v.id)
                if maybe.isSome(d) then
                    case maybe.unwrap(d)
                        when opAtom with a then
                            case a.atom
                                when atomVar with y then
                                    if not(y.v.isMutable) then
                                        v := y.v
                                        once := once andif {usesOf(s y.v) is 1} andif not(pinned(s y.v))
                                        more := true
                                    end
                                when atomConst then ok
                            end
                        else ok
                    end
                end
            end
            tuple let v = v let once = once end
        end

    (* The bonus for an argument: a constant, or a known function *)
    let argumentBonus(s: Simplifier a: Atom): Int =
        case a
            when atomConst then constantBonus
            when atomVar with x then
                if maybe.isSome(constOf(s a)) then constantBonus
                elsif hashMap.contains(s.analysis.functions resolve(s x.v).v.id) then functionBonus
                else 0 end
        end

    (* The variable whose address an argument is, if it is one taken in scope *)
    let addressed(s: Simplifier a: Atom): maybe.T(Variable) =
        begin
            let d = defOf(s a)
            if maybe.isSome(d) then
                case maybe.unwrap(d)
                    when opAddrVar with x then maybe.some(x.v)
                    else maybe.none()
                end
            else
                maybe.none()
            end
        end

    (* The variable a call of a member of one of the unit's modules calls (a
     * placeholder, which names no function, for any other call) *)
    let noVariable = nodes.newVar("" model.okType false)
    let memberOf(x: nodes.OpCall): Variable =
        if maybe.isSome(x.moduleRef) andif maybe.isSome(x.member) then
            case maybe.unwrap(x.moduleRef)
                when refModule with r then
                    maybe.unwrapOr(nodes.member(r.m.members maybe.unwrap(x.member)) noVariable)
                when refImport then noVariable
            end
        else
            noVariable
        end

    (* The name of the member of a module's that a variable of its is, if it is
     * one: the member's variable, or the variable the module's initialization
     * copies to it (an exception's, error, which error.1 is bound to) *)
    let memberName(m: nodes.Module v: Variable): maybe.T(String) =
        begin
            let var found = maybe.none(:String)
            for i = 0 upto {vector.length(m.members.names) - 1} do
                let name = vector.get(m.members.names i)
                let w = nodes.member(m.members name)
                if maybe.isSome(w) andif {maybe.unwrap(w).id is v.id} then
                    found := maybe.some(name)
                end
            end
            if maybe.isNone(found) then
                for i = 0 upto {vector.length(m.init.statements) - 1} do
                    case vector.get(m.init.statements i)
                        when sLet with x then
                            case x.value
                                when opAtom with a then
                                    case a.atom
                                        when atomVar with y then
                                            if y.v.id is v.id then
                                                for k = 0 upto {vector.length(m.members.names) - 1} do
                                                    let name = vector.get(m.members.names k)
                                                    let w = nodes.member(m.members name)
                                                    if maybe.isSome(w)
                                                        andif {maybe.unwrap(w).id is x.v.id} then
                                                        found := maybe.some(name)
                                                    end
                                                end
                                            end
                                        when atomConst then ok
                                    end
                                else ok
                            end
                        else ok
                    end
                end
            end
            found
        end

    (* Builds the replacement module-member reads needed to inline a module's
     * function outside its defining module (docs/ir.md section 8.6). Succeeds
     * only if every free variable is an immutable non-function member (so
     * calls do not lose known callees) whose type has the same representation
     * outside the module (either an exception type, or any type when abstract
     * types are transparent in whole-program mode). *)
    let memberReads(free: Array(Variable) ref: nodes.ModuleRef): maybe.T(Array(inline.Read)) =
        case ref
            when refModule with r then
                let reads = vector.new(:inline.Read)
                let var all = true
                for i = 0 upto {extent free - 1} do
                    let v = free[i]
                    let name = memberName(r.m v)
                    let sh = shapes.shape(v.type)
                    let laidOut = shapes.transparentAbstractTypes() orif shapes.kindIs(sh shapes.shapeException)
                    if v.isMutable orif shapes.isFunction(v.type) orif not(laidOut) orif maybe.isNone(name) then
                        all := false
                    else
                        vector.append(reads tuple
                            let v = v
                            let op = option opModuleMember of Op with
                                let var moduleRef = ref
                                let var member = name
                            end
                        end)
                    end
                end
                if all then maybe.some(vector.toArray(reads))
                else maybe.none() end
            when refImport then maybe.none()
        end

    (* Returns the net size growth from inlining a function of the given size,
     * subtracting the call it replaces. Counting the full size would exhaust
     * the growth budget on trivial copies no larger than a call (such as
     * maybe.none), preventing larger calls later in the unit from being
     * inlined. *)
    let net(size: Int): Int = if size > inline.callSize then size - inline.callSize else 0 end

    (* A call to inline: its function, the variables passed by address for its
     * var and out parameters, what the copy reads for the variables it names
     * of the function's module, the function's size, and, for a recursive
     * function specialized to the call (inline.specialize), its static
     * parameters *)
    Let Choice = Tuple
        function: nodes.Function
        byRef: Array(maybe.T(Variable))
        reads: Array(inline.Read)
        size: Int
        static: maybe.T(Array(Bool))
    end

    (* The function a call calls, if the round knows it, and whether the call
     * is its one use *)
    let calleeOf(s: Simplifier x: nodes.OpCall): maybe.T(Tuple f: nodes.Function once: Bool end) =
        begin
            let callee = if maybe.isSome(x.callee) then resolve(s maybe.unwrap(x.callee))
                else tuple let v = memberOf(x) let once = false end end
            let found = hashMap.get(s.analysis.functions callee.v.id)
            if maybe.isSome(found) then
                maybe.some(tuple let f = maybe.unwrap(found) let once = callee.once end)
            else maybe.none() end
        end

    (* Returns the module-member reads needed to inline f at call x, or none if
     * the call cannot be inlined. A call to a module member from outside its
     * module uses the interface's type, which may hide abstract types with
     * different layouts, and f may reference module-local variables out of the
     * caller's scope. Cross-module calls are therefore allowed only when the
     * call's type matches f's representation (same shape, or same calling
     * representation when abstract types are transparent) and f's free
     * variables can all be read as module members via memberReads. *)
    let readsAtItsType(s: Simplifier x: nodes.OpCall f: nodes.Function): maybe.T(Array(inline.Read)) =
        if maybe.isSome(x.callee) then
            maybe.some(array of :inline.Read end)
        else
            let sameShape = maybe.isNone(x.calleeType)
                orif {shapes.shape(maybe.unwrap(x.calleeType)).id is shapes.shape(f.v.type).id}
                orif {shapes.transparentAbstractTypes()
                    andif eq(genericLayout.signatureRepresentation(maybe.unwrap(x.calleeType))
                        genericLayout.signatureRepresentation(f.v.type))}
            (* Recompute f's free variables from its current body, because an
             * earlier inline into f during this round (such as fail into
             * f(): Int = fail(:Int)) may have pulled in module variables
             * (such as error) that the round's initial analysis did not see *)
            if not(sameShape) then
                maybe.none()
            else
                let free = inline.freeVariables(f)
                if extent free is 0 then maybe.some(array of :inline.Read end)
                else memberReads(free maybe.unwrap(x.moduleRef)) end
            end
        end

    (* Returns whether f is eligible for inlining or specialization at call x
     * inside component within. Rejects calls within f's own strongly connected
     * component, recursive functions unless they have static parameters and
     * this call passes a known function for at least one, arity mismatches,
     * bounded type parameters (substituting a subtype could change layout or
     * option ordinals), and polymorphic functions that make polymorphic
     * external calls (which expect boxed QVal words rather than concrete
     * types). *)
    let eligible(s: Simplifier x: nodes.OpCall f: nodes.Function within: maybe.T(Int)): Bool =
        begin
            let component = hashMap.find(s.analysis.components f.v.id)
            let within1 = maybe.isSome(within) andif {maybe.unwrap(within) is component}
            let static = hashMap.get(s.analysis.static f.v.id)
            let recursive = hashMap.find(s.analysis.recursive f.v.id)
            let var fits = not(within1) andif {not(recursive) orif maybe.isSome(static)}
                andif {extent x.typeArgs is extent f.typeParams} andif {extent x.args is extent f.params}
            if fits andif recursive then
                let params = maybe.unwrap(static)
                let var known = false
                for i = 0 upto {extent params - 1} do
                    if params[i] then
                        case x.args[i]
                            when atomVar with a then
                                if hashMap.contains(s.analysis.functions resolve(s a.v).v.id) then
                                    known := true
                                end
                            when atomConst then ok
                        end
                    end
                end
                if not(known) then fits := false end
            end
            for i = 0 upto {extent f.typeParams - 1} do
                if maybe.isSome(f.typeParams[i].bound) then fits := false end
            end
            if {extent f.typeParams > 0} andif hashMap.find(s.analysis.callsExternalAtTypes f.v.id) then
                fits := false
            end
            fits
        end

    (* Decides whether to inline or specialize call x (inside component within,
     * or none outside functions) and returns the inlining Choice if so.
     * Requires a known, eligible callee at a compatible type, an in-scope
     * variable for every var or out parameter, and either a single use or a
     * size within threshold. A self-recursive function with a known function
     * passed to a static parameter is specialized instead of inlined so calls
     * to that parameter become direct in the specialized copy. *)
    let inlining(s: Simplifier x: nodes.OpCall within: maybe.T(Int)): maybe.T(Choice) =
        begin
            let callee = calleeOf(s x)
            if maybe.isNone(callee) then
                maybe.none()
            else
                let f = maybe.unwrap(callee).f
                let reads = readsAtItsType(s x f)
                let size = hashMap.find(s.analysis.sizes f.v.id)
                let recursive = hashMap.find(s.analysis.recursive f.v.id)
                let byRef = array of(extent f.params maybe.none(:Variable))
                let var fits = maybe.isSome(reads) andif eligible(s x f within)
                (* Resolve var/out parameter addresses and sum call-site
                 * bonuses *)
                let var bonus = if extent x.typeArgs > 0 then polymorphicBonus else 0 end
                for i = 0 upto {extent f.params - 1} do
                    if fits then
                        if eq(f.params[i].mode "value") then
                            bonus := bonus + argumentBonus(s x.args[i])
                        else
                            byRef[i] := addressed(s x.args[i])
                            if maybe.isNone(byRef[i]) then fits := false end
                        end
                    end
                end
                let once = maybe.unwrap(callee).once andif not(pinned(s f.v))
                (* A specialization is bounded by the threshold alone, not
                 * the unit's growth: its copy replaces a closure made at the
                 * call and a call through it on each step, and there is at
                 * most one at each call of a known function, so the bound on
                 * growth would leave the calls in the largest functions
                 * (ratio-regions' preflowPush, made last) as they were *)
                let grows = recursive orif {{s.grown + net(size)} <= s.budget}
                let small = {{size - bonus} <= inlineSize} andif grows
                if fits andif {once orif small} then
                    maybe.some(tuple
                        let function = f
                        let byRef = byRef
                        let reads = maybe.unwrap(reads)
                        let size = size
                        let static = if recursive then hashMap.get(s.analysis.static f.v.id)
                            else maybe.none(:Array(Bool)) end
                    end)
                else
                    maybe.none()
                end
            end
        end

    (* Extracts the call from an operation or statement (and its result
     * variable in intoOf). A type application whose result is not a function
     * (such as maybe.none(:Int)) invokes a zero-argument polymorphic function
     * immediately (docs/ir.md section 8.1), so it is treated and inlined as a
     * call. A type application whose result is a function produces a closure
     * instead and is not treated as a call. *)
    let opCallOf(o: Op result: maybe.T(Variable)): maybe.T(nodes.OpCall) =
        case o
            when opCall with c then maybe.some(c)
            when opTypeApp with t then
                if maybe.isSome(result) andif not(shapes.isFunction(maybe.unwrap(result).type)) then
                    maybe.some(tuple
                        let var callee = t.callee
                        let var typeArgs = t.typeArgs
                        let var args = array of :Atom end
                        let var moduleRef = t.moduleRef
                        let var member = t.member
                        let var calleeType = t.calleeType
                        let var descriptors = t.descriptors
                    end)
                else
                    maybe.none()
                end
            else maybe.none()
        end
    let callOf(st: Stmt): maybe.T(nodes.OpCall) =
        case st
            when sLet with x then opCallOf(x.value maybe.some(x.v))
            when sDo with x then opCallOf(x.value maybe.none())
            else maybe.none()
        end
    let intoOf(st: Stmt): maybe.T(Variable) =
        case st
            when sLet with x then maybe.some(x.v)
            else maybe.none()
        end

    (* The component of a function the round knows *)
    let componentOf(s: Simplifier f: nodes.Function): maybe.T(Int) = hashMap.get(s.analysis.components f.v.id)

    (* The jumps to a join point's label in its body *)
    let jumpsTo(b: Body label: String): Int =
        begin
            let stmts = walk.walkStatements(b false)
            let var n = 0
            for i = 0 upto {vector.length(stmts) - 1} do
                case vector.get(stmts i)
                    when sJump with x then if eq(x.label label) then n := n + 1 end
                    else ok
                end
            end
            n
        end

    (* The value a join point's continuation returns, if it only returns one *)
    let returned(x: nodes.StmtJoin): maybe.T(Atom) =
        if vector.length(x.continuation.statements) is 1 then
            case vector.get(x.continuation.statements 0)
                when sReturn with r then maybe.some(r.value)
                else maybe.none()
            end
        else
            maybe.none()
        end

    (* Replaces, in place, the jumps to label in a body (not in the functions
     * it binds) by returns of what returnOf makes of the jump's arguments *)
    let rec jumpsReturn(b: Body label: String returnOf: All(args: Array(Atom)) Atom): Ok =
        for i = 0 upto {vector.length(b.statements) - 1} do
            let st = vector.get(b.statements i)
            case st
                when sJump with x then
                    if eq(x.label label) then
                        vector.set(b.statements i
                            option sReturn of Stmt with let var pos = x.pos let var value = returnOf(x.args) end)
                    end
                else
                    let inner = walk.statementBodies(st)
                    for k = 0 upto {extent inner - 1} do jumpsReturn(inner[k] label returnOf) end
            end
        end

    (* Flattens a join point into straight-line statements when possible.
     * Succeeds in three cases: the body never jumps to the join (return the
     * body), the continuation is a single return (rewrite every jump into a
     * return), or the only jump is the body's last statement (bind the join
     * parameters and append the continuation). *)
    let straightened(x: nodes.StmtJoin): maybe.T(vector.T(Stmt)) =
        begin
            let n = jumpsTo(x.body x.label)
            let stmts = x.body.statements
            let last = vector.length(stmts) - 1
            let tail = if last >= 0 then
                case vector.get(stmts last)
                    when sJump with j then
                        if eq(j.label x.label) then maybe.some(j) else maybe.none(:nodes.StmtJump) end
                    else maybe.none(:nodes.StmtJump)
                end
            else
                maybe.none(:nodes.StmtJump)
            end
            let value = returned(x)
            if n is 0 then
                maybe.some(vector.copy(stmts))
            elsif maybe.isSome(value) then
                (* A jump returns the argument for the parameter returned, or
                 * the value returned, if not a parameter *)
                let v = maybe.unwrap(value)
                let var index = ~1
                for k = 0 upto {extent x.params - 1} do
                    case v when atomVar with y then if nodes.same(x.params[k] y.v) then index := k end else ok end
                end
                let param = index
                jumpsReturn(x.body x.label fun(args: Array(Atom)): Atom if param >= 0 then args[param] else v end)
                maybe.some(vector.copy(stmts))
            elsif {n is 1} andif maybe.isSome(tail) then
                let j = maybe.unwrap(tail)
                let result = vector.new(:Stmt)
                for i = 0 upto {last - 1} do vector.append(result vector.get(stmts i)) end
                for i = 0 upto {extent x.params - 1} do
                    vector.append(result nodes.letStmt(x.params[i] nodes.opOfAtom(j.args[i])))
                end
                for i = 0 upto {vector.length(x.continuation.statements) - 1} do
                    vector.append(result vector.get(x.continuation.statements i))
                end
                maybe.some(result)
            else
                maybe.none()
            end
        end

    (* Simplifies a body's statements, in place, inlining the calls to inline
     * in it; within is the component of the function it is the body of *)
    let rec body(s: Simplifier b: Body within: maybe.T(Int)): Ok =
        begin
            let kept = vector.new(:Stmt)
            let var live = true
            (* Adds a body's statements in place of the statement that held it;
             * the statements after a terminated one are never reached *)
            let splice = fun(inner: Body): Ok
                begin
                    for k = 0 upto {vector.length(inner.statements) - 1} do
                        vector.append(kept vector.get(inner.statements k))
                    end
                    if nodes.terminated(inner) then live := false end
                end
            let var ss = b.statements
            let var i = 0
            while live andif {i < vector.length(ss)} do
                let st = vector.get(ss i)
                walk.replaceVarsInStmt(st rename(s))
                walk.replaceAtomsInStmt(st constant(s))
                let call = callOf(st)
                let choice = if maybe.isSome(call) then
                    inlining(s maybe.unwrap(call) within)
                else
                    maybe.none(:Choice)
                end
                if maybe.isSome(choice) then
                    (* The call's expansion, and the statements after it, are
                     * what is left to simplify *)
                    let ch = maybe.unwrap(choice)
                    let c = maybe.unwrap(call)
                    let rest = vector.new(:Stmt)
                    for k = i + 1 upto {vector.length(ss) - 1} do
                        vector.append(rest vector.get(ss k))
                    end
                    ss := vector.fromArray(if maybe.isSome(ch.static) then
                        inline.specialize(ch.function maybe.unwrap(ch.static) c.typeArgs c.args ch.reads
                            intoOf(st) nodes.stmtPos(st) vector.toArray(rest) s.labels)
                    else
                        inline.expand(ch.function c.typeArgs c.args ch.byRef ch.reads intoOf(st) nodes.stmtPos(st)
                            vector.toArray(rest) s.labels)
                    end)
                    (* The copy's variables are used where it uses them (and
                     * those of the rest, counted again, no less) *)
                    walk.countBodyUses(nodes.bodyOf(vector.toArray(ss)) s.uses s.pinned)
                    i := 0
                    s.grown := s.grown + net(ch.size)
                    s.changed := true
                else
                case st
                    when sLet with x then
                        x.value := simplified(s x.value)
                        if not(pure(x.value)) then forget(s) end
                        let reread = loaded(s x.v x.value)
                        if maybe.isSome(reread) then
                            x.value := maybe.unwrap(reread)
                            s.changed := true
                        end
                        let copied = case x.value
                            when opAtom with a then
                                case a.atom
                                    when atomVar with y then
                                        if not(y.v.isMutable) andif not(pinned(s x.v))
                                            andif nodes.sameType(y.v.type x.v.type) then
                                            maybe.some(y.v)
                                        else
                                            maybe.none(:Variable)
                                        end
                                    when atomConst then maybe.none(:Variable)
                                end
                            else maybe.none(:Variable)
                        end
                        let known = propagated(s x)
                        if maybe.isSome(copied) then
                            setRename(s x.v.id maybe.unwrap(copied))
                            s.changed := true
                        elsif maybe.isSome(known) then
                            setConst(s x.v.id maybe.unwrap(known))
                            s.changed := true
                        elsif {usesOf(s x.v) is 0} andif not(pinned(s x.v)) andif pure(x.value) then
                            s.changed := true
                        else
                            (* Pinned variables have no def: a let rec's
                             * variable is in scope after the body that binds
                             * it, where what made its value may not be *)
                            if not(x.v.isMutable) andif not(pinned(s x.v)) then setDef(s x.v.id x.value) end
                            remember(s x.v x.value)
                            vector.append(kept st)
                        end
                    when sDo with x then
                        x.value := simplified(s x.value)
                        if pure(x.value) then s.changed := true else begin forget(s) vector.append(kept st) end end
                    when sIf with x then
                        let c = boolOf(s x.cond)
                        if maybe.isSome(c) then
                            let taken = if maybe.unwrap(c) then x.thenBody else x.elseBody end
                            body(s taken within)
                            splice(taken)
                            s.changed := true
                        else
                            (* In the then-branch of an if on an is_tag, the
                             * value tested is of that case; both branches
                             * start with the reads made before the if *)
                            let t = tested(s x.cond)
                            let added = maybe.isSome(t) andif not(hashMap.contains(s.tags maybe.unwrap(t).id))
                            if added then
                                hashMap.insert(s.tags maybe.unwrap(t).id maybe.unwrap(t).tag)
                                ok
                            end
                            let before = hashMap.map(s.loads fun(k: String v: Variable): Variable v)
                            body(s x.thenBody within)
                            if added then
                                hashMap.delete(s.tags maybe.unwrap(t).id)
                                ok
                            end
                            s.loads := before
                            body(s x.elseBody within)
                            forget(s)
                            vector.append(kept st)
                        end
                    when sSwitch with x then
                        forget(s)
                        let m = tagOf(s x.value)
                        let c = if maybe.isSome(m) then chosen(x maybe.unwrap(m).tag)
                            else maybe.none(:Chosen) end
                        (* A binder is bound to the payload, which a case that
                         * binds one has: a variant's, which is the value it
                         * was made of, but not an option's, whose payload is
                         * a copy of the tuple it was made of, in its own
                         * allocation, that the binder shares *)
                        if maybe.isSome(c) andif {maybe.isNone(maybe.unwrap(c).binder)
                            orif {maybe.unwrap(m).isVariant
                                andif maybe.isSome(maybe.unwrap(m).payload)
                                andif stable(maybe.unwrap(maybe.unwrap(m).payload))}} then
                            let ch = maybe.unwrap(c)
                            let payload = maybe.unwrap(m).payload
                            if maybe.isSome(ch.binder) andif maybe.isSome(payload) then
                                let binder = maybe.unwrap(ch.binder)
                                let bound = nodes.letStmt(binder nodes.opOfAtom(maybe.unwrap(payload)))
                                vector.append(kept bound)
                                setDef(s binder.id nodes.opOfAtom(maybe.unwrap(payload)))
                            end
                            body(s ch.body within)
                            splice(ch.body)
                            s.changed := true
                        else
                            (* A switch whose case is known but binds an
                             * option's payload, or a variant's not known, is
                             * decided: its one case, with no test of the
                             * tag *)
                            let known = if maybe.isSome(m) andif not(x.decided) then caseOf(x maybe.unwrap(m).tag)
                                else maybe.none(:nodes.Case) end
                            if maybe.isSome(known) then
                                x.cases := array of maybe.unwrap(known) end
                                x.elseBody := maybe.none()
                                x.decided := true
                                s.changed := true
                            end
                            let inner = walk.statementBodies(st)
                            for k = 0 upto {extent inner - 1} do
                                forget(s)
                                body(s inner[k] within)
                            end
                            forget(s)
                            vector.append(kept st)
                        end
                    when sJoin with x then
                        (* Straightened, its statements and the rest are what
                         * is left to simplify *)
                        let straight = straightened(x)
                        if maybe.isSome(straight) then
                            let more = maybe.unwrap(straight)
                            for k = i + 1 upto {vector.length(ss) - 1} do
                                vector.append(more vector.get(ss k))
                            end
                            ss := more
                            i := ~1
                            s.changed := true
                        else
                            forget(s)
                            body(s x.continuation within)
                            forget(s)
                            body(s x.body within)
                            forget(s)
                            vector.append(kept st)
                        end
                    when sFuns with x then
                        for k = 0 upto {extent x.functions - 1} do
                            forget(s)
                            body(s x.functions[k].body componentOf(s x.functions[k]))
                        end
                        forget(s)
                        let var used = false
                        for k = 0 upto {extent x.functions - 1} do
                            if {usesOf(s x.functions[k].v) > 0} orif pinned(s x.functions[k].v) then used := true end
                        end
                        if used then vector.append(kept st) else s.changed := true end
                    else
                        let inner = walk.statementBodies(st)
                        for k = 0 upto {extent inner - 1} do
                            forget(s)
                            body(s inner[k] within)
                        end
                        forget(s)
                        vector.append(kept st)
                        if nodes.isTerminator(st) then live := false end
                end
                i := i + 1
                end
            end
            b.statements := kept
        end

    (* Removes empty funs statements from b and its nested bodies. Contify
     * leaves an empty funs statement behind when it turns a group's last
     * function into a loop, expecting the next round to drop it; this cleans
     * up after the final round when no next round runs. *)
    let rec dropEmptyFuns(b: Body): Ok =
        begin
            let kept = vector.new(:Stmt)
            for i = 0 upto {vector.length(b.statements) - 1} do
                let st = vector.get(b.statements i)
                case st
                    when sFuns with x then
                        for k = 0 upto {extent x.functions - 1} do dropEmptyFuns(x.functions[k].body) end
                        if extent x.functions > 0 then vector.append(kept st) end
                    else
                        let inner = walk.statementBodies(st)
                        for k = 0 upto {extent inner - 1} do dropEmptyFuns(inner[k]) end
                        vector.append(kept st)
                end
            end
            b.statements := kept
        end

    let simplifyUnit(unit: nodes.Unit): nodes.Unit =
        begin
            let s = tuple
                let uses = hashMap.new(:Int :Int intEqual hash.int)
                let pinned = hashMap.new(:Int :Bool intEqual hash.int)
                let defs = hashMap.new(:Int :Op intEqual hash.int)
                let renames = hashMap.new(:Int :Variable intEqual hash.int)
                let consts = hashMap.new(:Int :Atom intEqual hash.int)
                let tags = hashMap.new(:Int :String intEqual hash.int)
                let var loads = hashMap.new(:String :Variable stringOp.equal hash.string)
                let var changed = true
                let var analysis = inline.analyze(walk.unitBodies(unit))
                let labels = clone.newLabels()
                let var grown = 0
                let var budget = 0
            end
            let grow = {s.analysis.size * growthPercent} / 100
            s.budget := if grow > minimumBudget then grow else minimumBudget end
            let var round = 0
            while s.changed andif {round < maxRounds} do
                s.changed := false
                count(s unit)
                hashMap.clear(s.defs)
                let all = walk.unitBodies(unit)
                if round > 0 then s.analysis := inline.analyze(all) end
                for b = 0 upto {extent all - 1} do
                    forget(s)
                    body(s all[b] maybe.none())
                end
                if contify.contify(all s.analysis.recursive s.pinned s.labels) then s.changed := true end
                round := round + 1
            end
            if s.changed then
                let all = walk.unitBodies(unit)
                for b = 0 upto {extent all - 1} do dropEmptyFuns(all[b]) end
            end
            unit.stage := "simplified"
            unit
        end
end
