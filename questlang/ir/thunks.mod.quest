(* Quest Self-Hosted Compiler: The Thunks Pass Implementation *)

module thunks : Thunks
import
    conv : Conv
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/sort : util/Sort
    util/strutil : util/Strutil

    questlang/common/maps : questlang/common/Maps
    questlang/ir/clone : questlang/ir/Clone
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/walk : questlang/ir/Walk
    questlang/repr/digests : questlang/repr/Digests
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/repr/written : questlang/repr/Written
    questlang/types/model : questlang/types/Model
export
    Let Type = model.Type
    Let Variable = nodes.Variable
    Let Atom = nodes.Atom
    Let Body = nodes.Body
    Let Stmt = nodes.Stmt
    Let Op = nodes.Op
    Let Plan = nodes.Plan
    Let Descriptor = nodes.Descriptor
    Let Function = nodes.Function

    let eq(a: String b: String): Bool = stringOp.equal(a b)

    let isOk(t: Type): Bool = shapes.kindIs(shapes.shape(t) shapes.shapeOk)
    let countOf(m: maps.IntMap(Int) id: Int): Int = if hashMap.contains(m id) then hashMap.find(m id) else 0 end
    let isFunctionType(t: Type): Bool =
        shapes.kindIs(shapes.shape(t) shapes.shapeFun) orif shapes.kindIs(shapes.shape(t) shapes.shapeAll)
    let okAtom(): Atom =
        nodes.atomOfConst(tuple
            let value = option constOk of nodes.ConstValue end
            let shape = shapes.shape(model.okType)
        end)
    let descVar(v: Variable): Descriptor = option descVar of Descriptor with let v = v end
    let doStmt(o: Op): Stmt = option sDo of Stmt with let var pos = ~1 let var value = o end
    let returnStmt(a: Atom): Stmt = option sReturn of Stmt with let var pos = ~1 let var value = a end
    let closureOp(code: Function captures: Array(Atom) typeArgs: Array(Type) descriptors: Array(Descriptor)): Op =
        option opMakeClosure of Op with
            let var code = code
            let var captures = captures
            let var typeArgs = typeArgs
            let var descriptors = descriptors
        end

    (* The keys thunks are shared by, as the bootstrap's C printer keys them *)
    let typeKey(t: Type): String = digests.typeIdentityKey(t)
    let layoutKey(l: maybe.T(nodes.PlanLayout)): String =
        if maybe.isNone(l) then
            "()"
        else
            let lay = maybe.unwrap(l)
            let keys = sort.sorted(vector.toArray(lay.keys) sort.intCompare)
            let pairs = array of(extent keys "")
            for i = 0 upto {extent keys - 1} do
                pairs[i] := "\n" <> conv.int(keys[i]) <> "=" <> typeKey(hashMap.find(lay.subst keys[i]))
            end
            {if lay.toGeneric then "True" else "False" end} <> strutil.joinArray("" pairs)
        end

    (* An adapt plan's fields and thunk parameters, which the plan gives up to
     * its adapter *)
    Let Adapted = Tuple fields: Array(maybe.T(Plan)) thunkParams: Array(nodes.DescriptorParam) end

    (* What a variable is known to hold, so that its adapter calls it without
     * holding it: a closure of a function, without captures or type arguments,
     * or an imported module's member, which never changes once its module is
     * initialized, before the importer's code runs *)
    Def Known = Option
        knownFunction with f: Function end
        knownMember with i: nodes.Import member: String type: Type end
    end

    (* Where a global is bound: by a let in body (atStart false), or as a
     * parameter of a join whose continuation is body (atStart true) *)
    Def Site = Tuple body: Body atStart: Bool end

    Let Thunker = Tuple
        unit: nodes.Unit
        (* The thunks made so far, by key (typeKey, layoutKey), so that
         * thunks alike are one function *)
        thunks: maps.StringMap(Function)
        (* The variables bound to external C functions used as functions, by
         * id, and their symbols *)
        externals: maps.IntMap(String)
        (* The variables bound to closures without captures or type
         * arguments, or to imported modules' members, by id *)
        known: maps.IntMap(Known)
        (* Each adapt plan's fields and thunk parameters, by plan id, once its
         * adapter is made *)
        adapted: maps.IntMap(Adapted)
        (* For closures made only to be converted (lambdaOf): the closures
         * with captures the variables are bound to, by id; how many times
         * each variable is used; how many closures each function is made
         * into, by id; and the variables and functions such a conversion
         * leaves unused, dropped once the unit is done *)
        closures: maps.IntMap(nodes.OpMakeClosure)
        uses: maps.IntMap(Int)
        madeInto: maps.IntMap(Int)
        dropped: maps.IntSet
        droppedFunctions: maps.IntSet
        (* For conversions of immutable globals, made once: where each such
         * global is bound, by id; the global holding each conversion, by the
         * global's id and the plan's types; and the lets of those, each to go
         * where its global is bound *)
        topLets: maps.IntMap(Site)
        globalConversions: maps.StringMap(Variable)
        pending: vector.T(Tuple after: Int stmt: Stmt end)
    end

    (* ======================================================================
     * Building thunks
     * ====================================================================== *)

    (* A thunk's type parameters: the quantifiers of its function type *)
    let typeParamsOf(quantifiers: Array(model.Quantifier)): Array(nodes.TypeParam) =
        begin
            let res = vector.new(:nodes.TypeParam)
            for i = 0 upto {extent quantifiers - 1} do
                let q = quantifiers[i]
                vector.append(res tuple
                    let name = q.name
                    let symbolId = q.symbolId
                    let kind = q.bound
                    let bound = if model.isPower(q.bound) then maybe.some(shapes.shape(model.powerBound(q.bound)))
                        else maybe.none(:shapes.Shape) end
                end)
            end
            vector.toArray(res)
        end

    let typeVariables(params: Array(nodes.TypeParam)): Array(Type) =
        begin
            let res = array of(extent params model.okType)
            for i = 0 upto {extent params - 1} do
                res[i] := model.typeVariable(params[i].name params[i].symbolId maybe.some(params[i].kind))
            end
            res
        end

    let descriptorsOf(params: Array(nodes.DescriptorParam)): Array(Descriptor) =
        begin
            let res = vector.new(:Descriptor)
            for i = 0 upto {extent params - 1} do vector.append(res descVar(params[i].v)) end
            vector.toArray(res)
        end

    (* A thunk's parameters, of its function type's signature *)
    let paramsOf(sig: written.Signature): Array(nodes.ParamEntry) =
        begin
            let res = vector.new(:nodes.ParamEntry)
            for i = 0 upto {extent sig.params - 1} do
                let p = sig.params[i]
                let mode = nodes.modeOf(p.isVar p.isOut)
                let hint = if stringOp.length(p.name) > 0 then p.name else "a" end
                vector.append(res tuple
                    let v = nodes.newVar(hint p.type not(mode?modeValue))
                    let mode = mode
                end)
            end
            vector.toArray(res)
        end

    (* The arguments a thunk passes on: its parameters, each converted by its
     * plan, if any (a var or out parameter's location is passed as it is) *)
    let forwarded(stmts: vector.T(Stmt) params: Array(nodes.ParamEntry) plans: Array(maybe.T(Plan))): Array(Atom) =
        begin
            let res = vector.new(:Atom)
            for i = 0 upto {extent params - 1} do
                let p = params[i]
                if not(p.mode?modeValue) then
                    (* Of the location's type, as lowering types an argument
                     * @x *)
                    let refType = if p.mode?modeVar then model.varType(p.v.type) else model.outType(p.v.type) end
                    let a = nodes.newVar(p.v.hint refType false)
                    vector.append(stmts nodes.letStmt(a option opAddrVar of Op with let var v = p.v end))
                    vector.append(res nodes.atomOfVar(a))
                elsif {i < extent plans} andif maybe.isSome(plans[i]) then
                    let plan = maybe.unwrap(plans[i])
                    let a = nodes.newVar(p.v.hint plan.target false)
                    vector.append(stmts nodes.letStmt(a option opConvert of Op with
                        let var value = nodes.atomOfVar(p.v)
                        let var plan = plan
                    end))
                    vector.append(res nodes.atomOfVar(a))
                else
                    vector.append(res nodes.atomOfVar(p.v))
                end
            end
            vector.toArray(res)
        end

    (* Ends a thunk's body with the call it makes and the return of its
     * result, converted by resultPlan: a call returning Ok (a C function
     * returning nothing) returns ok, which is Ok's value when the thunk's
     * result is a type parameter's *)
    let finish(stmts: vector.T(Stmt) called: Op sourceResult: Type targetResult: Type resultPlan: maybe.T(Plan)): Ok =
        if isOk(targetResult) orif isOk(sourceResult) then
            vector.append(stmts doStmt(called))
            vector.append(stmts returnStmt(okAtom()))
        else
            let r = nodes.newVar("r" sourceResult false)
            vector.append(stmts nodes.letStmt(r called))
            if maybe.isNone(resultPlan) then
                vector.append(stmts returnStmt(nodes.atomOfVar(r)))
            else
                let pl = maybe.unwrap(resultPlan)
                let converted = nodes.newVar("r" pl.target false)
                vector.append(stmts nodes.letStmt(converted option opConvert of Op with
                    let var value = nodes.atomOfVar(r)
                    let var plan = pl
                end))
                vector.append(stmts returnStmt(nodes.atomOfVar(converted)))
            end
        end

    let addThunk(t: Thunker key: String f: Function): Function =
        begin
            hashMap.insert(t.thunks key f)
            vector.append(t.unit.functions f)
            f
        end

    (* Returns the adapter function for an adapt plan, creating and caching it
     * if needed. The adapter has the plan's target type and takes the target's
     * type parameters (the plan's thunk parameters), forwarding them to the
     * adapted closure while converting each argument and the result using the
     * plan's field plans. When known is none, the adapted closure is passed as
     * the adapter's environment; when known is a capture-free function or an
     * imported module member, the adapter needs no environment, calls it
     * directly, and yields a static closure. *)
    let adapter(t: Thunker plan: Plan a: Adapted known: maybe.T(Known)): Function =
        begin
            let knownKey = if maybe.isNone(known) then ""
                else case maybe.unwrap(known)
                    when knownFunction with k then "\nknown " <> conv.int(k.f.id)
                    when knownMember with k then "\nmember " <> k.i.canonicalPath <> "\n" <> k.member
                end
                end
            let key =
                "adapt\n" <> typeKey(plan.source) <> "\n" <> typeKey(plan.target) <> "\n" <> layoutKey(plan.layout)
                    <> knownKey
            let found = hashMap.get(t.thunks key)
            if maybe.isSome(found) then
                maybe.unwrap(found)
            else
                let source = written.funSignature(plan.source)
                let target = written.funSignature(plan.target)
                let typeParams = typeParamsOf(written.quantified(plan.target).quantifiers)
                let orig = nodes.newVar("orig" plan.source false)
                let params = paramsOf(target)
                let stmts = vector.new(:Stmt)
                let member = if maybe.isNone(known) then maybe.none(:Known)
                    else case maybe.unwrap(known)
                        when knownFunction with k then
                            vector.append(stmts nodes.letStmt(orig closureOp(k.f
                                    array of :Atom end array of :Type end array of :Descriptor end)))
                            maybe.none(:Known)
                        when knownMember then known
                    end
                    end
                let args = forwarded(stmts params a.fields)
                let called =
                    if maybe.isSome(member) then
                        case maybe.unwrap(member)
                            when knownMember with k then
                                nodes.call(maybe.none() typeVariables(typeParams) args
                                        maybe.some(option refImport of nodes.ModuleRef with let i = k.i end)
                                        maybe.some(k.member) maybe.some(k.type))
                            else nodes.call(maybe.some(orig) typeVariables(typeParams) args
                                    maybe.none() maybe.none() maybe.none())
                        end
                    else
                        nodes.call(maybe.some(orig) typeVariables(typeParams) args maybe.none() maybe.none()
                                maybe.none())
                    end
                case called when opCall with c then c.descriptors := descriptorsOf(a.thunkParams) else ok end
                let last = if extent a.fields > 0 then a.fields[extent a.fields - 1] else maybe.none(:Plan) end
                finish(stmts called source.result target.result last)
                let f = nodes.newFunction(nodes.newVar("qa_adapt" plan.target false) typeParams params target.result
                        nodes.bodyOf(vector.toArray(stmts)) maybe.none())
                if maybe.isNone(known) then f.env := maybe.some(orig) end
                (* Each thunk parameter carries both the target and source
                 * type-parameter symbol ids; on the adapter function
                 * itself, record only the target's symbol id *)
                let descriptorParams = vector.new(:nodes.DescriptorParam)
                for i = 0 upto {extent a.thunkParams - 1} do
                    let tp = a.thunkParams[i]
                    vector.append(descriptorParams
                            tuple let v = tp.v let symbols = array of tp.symbols[0] end end)
                end
                f.descriptorParams := vector.toArray(descriptorParams)
                addThunk(t key f)
            end
        end

    (* Rewrites each return in b and its nested bodies, in place, to convert
     * its value with plan *)
    let rec convertReturns(b: Body plan: Plan): Ok =
        begin
            let rewritten = vector.new(:Stmt)
            for i = 0 upto {vector.length(b.statements) - 1} do
                let s = vector.get(b.statements i)
                let bodies = walk.statementBodies(s)
                for j = 0 upto {extent bodies - 1} do convertReturns(bodies[j] plan) end
                case s
                    when sReturn with x then
                        let r = nodes.newVar("r" plan.target false)
                        vector.append(rewritten nodes.letStmt(r option opConvert of Op with
                            let var value = x.value
                            let var plan = plan
                        end))
                        x.value := nodes.atomOfVar(r)
                    else ok
                end
                vector.append(rewritten s)
            end
            b.statements := rewritten
        end

    (* Removes let bindings in b and its nested bodies for variables marked in
     * t.dropped *)
    let rec dropLets(t: Thunker b: Body): Ok =
        begin
            let kept = vector.new(:Stmt)
            for i = 0 upto {vector.length(b.statements) - 1} do
                let s = vector.get(b.statements i)
                let bodies = walk.statementBodies(s)
                for j = 0 upto {extent bodies - 1} do dropLets(t bodies[j]) end
                let drop = case s when sLet with x then hashSet.contains(t.dropped x.v.id) else false end
                if not(drop) then vector.append(kept s) end
            end
            b.statements := kept
        end

    (* Builds a specialized copy of c's function directly at plan's target type
     * for a closure that is created only to be adapted. The copy converts its
     * parameters using a.fields, clones the body with the same environment
     * layout and capture order as c, and converts every return using the final
     * field plan. This avoids double allocation: one closure holds the
     * captures directly instead of an adapter closure wrapping c's closure. *)
    let lambdaAdapter(t: Thunker plan: Plan a: Adapted c: nodes.OpMakeClosure): Function =
        begin
            let f = c.code
            let target = written.funSignature(plan.target)
            let typeParams = typeParamsOf(written.quantified(plan.target).quantifiers)
            let params = paramsOf(target)
            let stmts = vector.new(:Stmt)
            let args = forwarded(stmts params a.fields)
            let cl = clone.newClosedCloner(model.newSubst())
            for i = 0 upto {extent f.params - 1} do
                case args[i]
                    when atomVar with x then clone.bindVar(cl f.params[i].v x.v)
                    when atomConst then ok
                end
            end
            let env = nodes.newVar("env" model.okType false)
            clone.bindVar(cl maybe.unwrap(f.env) env)
            (* Drop dead lets from f's body before cloning, because cloning
             * assigns fresh variable ids that t.dropped does not list *)
            dropLets(t f.body)
            clone.bindAll(cl f.body)
            let copied = clone.copyBody(cl f.body)
            (* Count uses of the copy's fresh variables so conversions inside
             * the copy can detect single-use closures *)
            walk.countBodyUses(copied t.uses maps.newIntSet())
            let last = if extent a.fields > 0 then a.fields[extent a.fields - 1] else maybe.none(:Plan) end
            if maybe.isSome(last) then convertReturns(copied maybe.unwrap(last)) end
            for i = 0 upto {vector.length(copied.statements) - 1} do
                vector.append(stmts vector.get(copied.statements i))
            end
            let g = nodes.newFunction(nodes.newVar("qa_lambda" plan.target false) typeParams params target.result
                    nodes.bodyOf(vector.toArray(stmts)) f.traceName)
            g.env := maybe.some(env)
            let descriptorParams = vector.new(:nodes.DescriptorParam)
            for i = 0 upto {extent a.thunkParams - 1} do
                let tp = a.thunkParams[i]
                vector.append(descriptorParams tuple let v = tp.v let symbols = array of tp.symbols[0] end end)
            end
            g.descriptorParams := vector.toArray(descriptorParams)
            vector.append(t.unit.functions g)
            g
        end

    (* Returns the wrapper thunk for a type application whose result is a
     * function of targetType, creating and caching it if needed. Its
     * environment captures the applied function (of origType) and its leading
     * type parameters match the applied type arguments, mirroring how closure
     * conversion lifts enclosing type parameters. The thunk forwards both sets
     * of type parameters and descriptors to the original function while
     * converting each argument and the result via o.plans. *)
    let typeAppThunk(t: Thunker o: nodes.OpTypeApp origType: Type targetType: Type): Function =
        begin
            let typeArgKeys = vector.new(:String)
            for i = 0 upto {extent o.typeArgs - 1} do vector.append(typeArgKeys typeKey(o.typeArgs[i])) end
            let key = "type_app\n" <> typeKey(origType) <> "\n" <> typeKey(targetType) <> "\n"
                <> strutil.join("\t" typeArgKeys)
            let found = hashMap.get(t.thunks key)
            if maybe.isSome(found) then
                maybe.unwrap(found)
            else
                let n = extent o.typeArgs
                let origQuantifiers = written.quantified(origType).quantifiers
                let captured = vector.new(:model.Quantifier)
                for i = 0 upto {n - 1} do
                    if i < extent origQuantifiers then vector.append(captured origQuantifiers[i]) end
                end
                let capturedParams = typeParamsOf(vector.toArray(captured))
                let ownParams = typeParamsOf(written.quantified(targetType).quantifiers)
                let thunkParams = maybe.unwrap(o.thunkParams)
                let allParams = vector.new(:nodes.TypeParam)
                let descriptorParams = vector.new(:nodes.DescriptorParam)
                for i = 0 upto {extent capturedParams - 1} do
                    vector.append(allParams capturedParams[i])
                    vector.append(descriptorParams tuple
                        let v = nodes.newVar("descriptor_" <> capturedParams[i].name nodes.descriptorType false)
                        let symbols = array of capturedParams[i].symbolId end
                    end)
                end
                for i = 0 upto {extent ownParams - 1} do vector.append(allParams ownParams[i]) end
                let typeParams = vector.toArray(allParams)
                for i = 0 upto {extent thunkParams - 1} do vector.append(descriptorParams thunkParams[i]) end
                (* The environment, as closure conversion makes it: its
                 * type is a placeholder *)
                let env = nodes.newVar("env" model.okType false)
                let orig = nodes.newVar("orig" origType false)
                let stmts = vector.new(:Stmt)
                vector.append(stmts nodes.letStmt(orig option opEnvField of Op with
                    let var env = nodes.atomOfVar(env)
                    let index = 0
                end))
                let target = written.funSignature(targetType)
                let params = paramsOf(target)
                let args = forwarded(stmts params o.plans)
                let descriptors = descriptorsOf(vector.toArray(descriptorParams))
                let called = nodes.call(maybe.some(orig) typeVariables(typeParams) args
                        maybe.none() maybe.none() maybe.none())
                case called when opCall with c then c.descriptors := descriptors else ok end
                let resultPlan = if extent o.plans > 0 then o.plans[extent o.plans - 1] else maybe.none(:Plan) end
                finish(stmts called written.funSignature(origType).result target.result resultPlan)
                let f = nodes.newFunction(nodes.newVar("qa_type_app" targetType false) typeParams params target.result
                        nodes.bodyOf(vector.toArray(stmts)) maybe.none())
                f.env := maybe.some(env)
                f.descriptorParams := vector.toArray(descriptorParams)
                addThunk(t key f)
            end
        end

    (* The function an external C function used as a value is a closure of: it
     * calls the C function with its arguments (its type parameters'
     * descriptors are not passed on, as a direct call of the external passes
     * none) *)
    let externalThunk(t: Thunker symbol: String ty: Type): Function =
        begin
            let key = "external\n" <> symbol <> "\n" <> typeKey(ty)
            let found = hashMap.get(t.thunks key)
            if maybe.isSome(found) then
                maybe.unwrap(found)
            else
                let sig = written.funSignature(ty)
                let typeParams = typeParamsOf(written.quantified(ty).quantifiers)
                let made = vector.new(:nodes.DescriptorParam)
                for i = 0 upto {extent typeParams - 1} do
                    vector.append(made tuple
                        let v = nodes.newVar("qd_" <> conv.int(i) nodes.descriptorType false)
                        let symbols = array of typeParams[i].symbolId end
                    end)
                end
                let descriptorParams = vector.toArray(made)
                let params = paramsOf(sig)
                let stmts = vector.new(:Stmt)
                let args = forwarded(stmts params array of :maybe.T(Plan) end)
                let called = option opCallExternal of Op with
                    let symbol = symbol
                    let var typeArgs = array of :Type end
                    let var args = args
                    let var descriptors = array of :Descriptor end
                end
                finish(stmts called sig.result sig.result maybe.none())
                let f = nodes.newFunction(nodes.newVar("qx_" <> symbol ty false) typeParams params sig.result
                        nodes.bodyOf(vector.toArray(stmts)) maybe.none())
                f.descriptorParams := descriptorParams
                addThunk(t key f)
            end
        end

    (* ======================================================================
     * The pass
     * ====================================================================== *)

    (* An adapt plan's fields and thunk parameters: its own, saved for the
     * adapters of known functions made after its adapter *)
    let adaptedOf(t: Thunker p: Plan): Adapted =
        begin
            if not(hashMap.contains(t.adapted p.id)) then
                hashMap.insert(t.adapted p.id
                        tuple let fields = p.fields let thunkParams = p.thunkParams end)
            end
            hashMap.find(t.adapted p.id)
        end

    (* The function a variable is known to be a closure of, without captures or
     * type arguments *)
    let knownOf(t: Thunker a: Atom): maybe.T(Known) =
        case a
            when atomVar with x then hashMap.get(t.known x.v.id)
            when atomConst then maybe.none()
        end

    (* Gives every adapt plan in a plan its adapter, in place. The adapter
     * takes the plan's thunk parameters and converts by its fields, so the
     * plan keeps neither: a plan shared by several conversions is given its
     * adapter once. *)
    let rec plan(t: Thunker p0: maybe.T(Plan)): Ok =
        if maybe.isSome(p0) then
            let p = maybe.unwrap(p0)
            case p.kind
                when planAdapt then
                    if maybe.isNone(p.thunk) then
                        let a = adaptedOf(t p)
                        p.thunk := maybe.some(adapter(t p a maybe.none(:Known)))
                        p.fields := array of :maybe.T(Plan) end
                        p.thunkParams := array of :nodes.DescriptorParam end
                    end
                when planCopy then
                    for i = 0 upto {extent p.fields - 1} do plan(t p.fields[i]) end
                when planBox, planUnbox, planRecordView, planVariantTags, planCast, planUnproxy, planSlotBox,
                        planSlotUnbox, planView, planRuntime then ok
            end
        end

    let moduleOf(r: nodes.ModuleRef): maybe.T(nodes.Module) =
        case r when refModule with x then maybe.some(x.m) else maybe.none() end

    (* The function a type application applies, as an atom, after the
     * statements that compute it (added to before), and its type *)
    Let Applied = Tuple atom: Atom type: Type end
    let applied(before: vector.T(Stmt) o: nodes.OpTypeApp): Applied =
        if maybe.isSome(o.callee) then
            let v = maybe.unwrap(o.callee)
            tuple let atom = nodes.atomOfVar(v) let type = v.type end
        else
            (* A module's member, read by a let: the variable bound to it is
             * the module's, in scope in its initialization alone *)
            let r = maybe.unwrap(o.moduleRef)
            let member = maybe.unwrap(o.member)
            let m = moduleOf(r)
            let ty =
                if maybe.isSome(m) then
                    maybe.unwrap(nodes.member(maybe.unwrap(m).members member)).type
                else
                    maybe.unwrap(o.calleeType)
                end
            let v = nodes.newVar(member ty false)
            vector.append(before nodes.letStmt(v option opModuleMember of Op with
                let var moduleRef = r
                let var member = maybe.some(member)
            end))
            tuple let atom = nodes.atomOfVar(v) let type = ty end
        end

    (* Returns the OpMakeClosure converted by x when that closure was created
     * solely for this adapt conversion and can be fused into lambdaAdapter.
     * Requires a single-use variable bound to a capturing closure whose
     * function has no other closures, no type parameters, descriptors, or
     * record view maps, no unboxed result, only value parameters, and
     * compatible Ok-ness between source and target results. *)
    let lambdaOf(t: Thunker x: nodes.OpConvert): maybe.T(nodes.OpMakeClosure) =
        begin
            let isAdapt = case x.plan.kind when planAdapt then true else false end
            let c =
                case x.value
                    when atomVar with v then
                        if isAdapt andif {countOf(t.uses v.v.id) is 1} then hashMap.get(t.closures v.v.id)
                        else maybe.none(:nodes.OpMakeClosure)
                        end
                    when atomConst then maybe.none(:nodes.OpMakeClosure)
                end
            if maybe.isNone(c) then
                c
            else
                let k = maybe.unwrap(c)
                let f = k.code
                let var simple = {countOf(t.madeInto f.id) is 1} andif {extent f.typeParams is 0}
                    andif {extent f.descriptorParams is 0} andif {extent f.viewMaps is 0} andif not(f.unboxedResult)
                    andif maybe.isSome(f.env) andif {extent k.typeArgs is 0} andif {extent k.descriptors is 0}
                for i = 0 upto {extent f.params - 1} do
                    if not(f.params[i].mode?modeValue) then simple := false end
                end
                if simple then
                    let source = written.funSignature(x.plan.source)
                    let target = written.funSignature(x.plan.target)
                    let fields = adaptedOf(t x.plan).fields
                    let last = if extent fields > 0 then fields[extent fields - 1] else maybe.none(:Plan) end
                    if {extent target.params isnot extent f.params}
                            orif {maybe.isNone(last) andif {isOk(source.result) isnot isOk(target.result)}} then
                        simple := false
                    end
                end
                if simple then c else maybe.none(:nodes.OpMakeClosure) end
            end
        end

    (* Whether a descriptor mentions only the descriptor variables own holds *)
    let rec ownDescriptor(d: Descriptor own: maps.IntSet): Bool =
        case d
            when descVar with x then hashSet.contains(own x.v.id)
            when descStatic then true
            when descInstantiate with x then
                begin
                    let var ok1 = true
                    for i = 0 upto {extent x.args - 1} do
                        if not(ownDescriptor(x.args[i] own)) then ok1 := false end
                    end
                    ok1
                end
        end

    (* Whether a plan (with descriptors descs and fields/thunk parameters a)
     * uses only static descriptors and its own thunk parameters, so the
     * conversion can be hoisted out of the local scope where it appears *)
    let rec planOwnDescriptors(descs: Array(Descriptor) a: Adapted own: maps.IntSet): Bool =
        begin
            for i = 0 upto {extent a.thunkParams - 1} do
                begin hashSet.insert(own a.thunkParams[i].v.id) ok end
            end
            let var ok1 = true
            for i = 0 upto {extent descs - 1} do if not(ownDescriptor(descs[i] own)) then ok1 := false end end
            for i = 0 upto {extent a.fields - 1} do
                if maybe.isSome(a.fields[i]) then
                    let f = maybe.unwrap(a.fields[i])
                    let fa = tuple let fields = f.fields let thunkParams = f.thunkParams end
                    if not(planOwnDescriptors(f.descriptors fa own)) then ok1 := false end
                end
            end
            ok1
        end

    (* Hoists an adapt conversion of an immutable top-level global when the
     * plan depends only on static descriptors and its own thunk parameters.
     * Schedules a single top-level let binding in t.pending right after the
     * global's definition and returns that cached variable for all matching
     * conversions. *)
    let globalConversion(t: Thunker x: nodes.OpConvert): maybe.T(Variable) =
        case x.value
            when atomVar with v then
                let isAdapt = case x.plan.kind when planAdapt then true else false end
                if isAdapt andif not(v.v.isMutable) andif hashMap.contains(t.topLets v.v.id)
                        andif planOwnDescriptors(x.plan.descriptors adaptedOf(t x.plan)
                                maps.newIntSet()) then
                    let key = conv.int(v.v.id) <> "\n" <> typeKey(x.plan.target) <> "\n" <> layoutKey(x.plan.layout)
                    let found = hashMap.get(t.globalConversions key)
                    if maybe.isSome(found) then
                        found
                    else
                        let g = nodes.newVar(v.v.hint x.plan.target false)
                        let converted = option opConvert of Op with
                            let var value = x.value
                            let var plan = x.plan
                        end
                        plan(t maybe.some(x.plan))
                        vector.append(t.pending tuple let after = v.v.id let stmt = nodes.letStmt(g converted) end)
                        begin hashMap.insert(t.globalConversions key g) ok end
                        maybe.some(g)
                    end
                else
                    maybe.none(:Variable)
                end
            when atomConst then maybe.none(:Variable)
        end

    (* An operation with its thunks: the operation that replaces it, if any,
     * after the statements that compute its operands (added to before) *)
    let operation(t: Thunker before: vector.T(Stmt) o: Op result: maybe.T(Variable)): maybe.T(Op) =
        case o
            when opConvert with x then
                (* A known function adapted is a static closure of its own
                 * adapter; a closure made only to be converted is made at
                 * the converted type *)
                let known = knownOf(t x.value)
                let lambda = if maybe.isSome(known) then maybe.none(:nodes.OpMakeClosure) else lambdaOf(t x) end
                if maybe.isSome(lambda) then
                    let c = maybe.unwrap(lambda)
                    let g = lambdaAdapter(t x.plan adaptedOf(t x.plan) c)
                    case x.value when atomVar with v then begin hashSet.insert(t.dropped v.v.id) ok end else ok end
                    let ignored = hashSet.insert(t.droppedFunctions c.code.id)
                    maybe.some(closureOp(g c.captures array of :Type end array of :Descriptor end))
                elsif maybe.isSome(known) andif {case x.plan.kind when planAdapt then true else false end} then
                    let f = adapter(t x.plan adaptedOf(t x.plan) known)
                    maybe.some(closureOp(f array of :Atom end array of :Type end array of :Descriptor end))
                elsif maybe.isSome(globalConversion(t x)) then
                    let g = maybe.unwrap(globalConversion(t x))
                    maybe.some(option opAtom of Op with let var atom = nodes.atomOfVar(g) end)
                else
                    plan(t maybe.some(x.plan))
                    maybe.none()
                end
            when opTypeApp with x then
                if maybe.isSome(x.thunkParams) then
                    let target = maybe.unwrap(result).type
                    let a = applied(before x)
                    let f = typeAppThunk(t x a.type target)
                    maybe.some(closureOp(f array of a.atom end x.typeArgs x.descriptors))
                else
                    for i = 0 upto {extent x.plans - 1} do plan(t x.plans[i]) end
                    maybe.none()
                end
            when opExternal with x then
                if maybe.isSome(result) andif shapes.isFunction(maybe.unwrap(result).type) then
                    let f = externalThunk(t x.symbol maybe.unwrap(result).type)
                    maybe.some(closureOp(f array of :Atom end array of :Type end array of :Descriptor end))
                else
                    maybe.none()
                end
            when opCall with x then
                (* A call of an external C function bound to a variable calls
                 * it directly, without its type parameters' descriptors *)
                let symbol =
                    if maybe.isSome(x.callee) then
                        hashMap.get(t.externals maybe.unwrap(x.callee).id)
                    else
                        maybe.none(:String)
                    end
                if maybe.isSome(symbol) andif {extent x.typeArgs is 0} then
                    maybe.some(option opCallExternal of Op with
                        let symbol = maybe.unwrap(symbol)
                        let var typeArgs = array of :Type end
                        let var args = x.args
                        let var descriptors = array of :Descriptor end
                    end)
                else
                    maybe.none()
                end
            else maybe.none()
        end

    let rec body(t: Thunker b: Body): Ok =
        begin
            let rewritten = vector.new(:Stmt)
            for i = 0 upto {vector.length(b.statements) - 1} do
                let s = vector.get(b.statements i)
                let before = vector.new(:Stmt)
                case s
                    when sLet with x then
                        let r = operation(t before x.value maybe.some(x.v))
                        if maybe.isSome(r) then x.value := maybe.unwrap(r) end
                        let known =
                            case x.value
                                when opMakeClosure with c then
                                    if {extent c.captures is 0} andif {extent c.typeArgs is 0} then
                                        maybe.some(option knownFunction of Known with let f = c.code end)
                                    else
                                        maybe.none(:Known)
                                    end
                                when opAtom with c then knownOf(t c.atom)
                                when opModuleMember with m then
                                    (* An imported member of function type; the
                                     * unit's own module's members are its
                                     * globals, which may still be unbound *)
                                    case m.moduleRef
                                        when refImport with r then
                                            if maybe.isSome(m.member) andif isFunctionType(x.v.type) then
                                                maybe.some(option knownMember of Known with
                                                    let i = r.i
                                                    let member = maybe.unwrap(m.member)
                                                    let type = x.v.type
                                                end)
                                            else
                                                maybe.none(:Known)
                                            end
                                        when refModule then maybe.none(:Known)
                                    end
                                else maybe.none(:Known)
                            end
                        if maybe.isSome(known) andif not(x.v.isMutable) then
                            hashMap.insert(t.known x.v.id maybe.unwrap(known))
                        end
                        case x.value
                            when opMakeClosure with c then
                                if {extent c.captures > 0} andif not(x.v.isMutable) then
                                    begin hashMap.insert(t.closures x.v.id c) ok end
                                end
                            else ok
                        end
                    when sDo with x then
                        let r = operation(t before x.value maybe.none())
                        if maybe.isSome(r) then x.value := maybe.unwrap(r) end
                    when sInspect with x then
                        for j = 0 upto {extent x.cases - 1} do
                            let arm = x.cases[j].arm
                            if maybe.isSome(arm) then plan(t maybe.unwrap(arm).plan) end
                        end
                    else ok
                end
                let bodies = walk.statementBodies(s)
                for j = 0 upto {extent bodies - 1} do body(t bodies[j]) end
                for j = 0 upto {vector.length(before) - 1} do vector.append(rewritten vector.get(before j)) end
                vector.append(rewritten s)
            end
            b.statements := rewritten
        end

    (* The variables bound to external C functions used as functions *)
    let findExternals(t: Thunker b: Body): Ok =
        begin
            let stmts = walk.walkStatements(b false)
            for i = 0 upto {vector.length(stmts) - 1} do
                case vector.get(stmts i)
                    when sLet with x then
                        case x.value
                            when opExternal with e then
                                if shapes.isFunction(x.v.type) then hashMap.insert(t.externals x.v.id e.symbol) end
                            else ok
                        end
                    else ok
                end
            end
        end

    let thunkUnit(unit: nodes.Unit): nodes.Unit =
        begin
            let t = tuple
                let unit = unit
                let thunks = maps.newStringMap(:Function)
                let externals = maps.newIntMap(:String)
                let known = maps.newIntMap(:Known)
                let adapted = maps.newIntMap(:Adapted)
                let closures = maps.newIntMap(:nodes.OpMakeClosure)
                let uses = maps.newIntMap(:Int)
                let madeInto = maps.newIntMap(:Int)
                let dropped = maps.newIntSet()
                let droppedFunctions = maps.newIntSet()
                let topLets = maps.newIntMap(:Site)
                let globalConversions = maps.newStringMap(:Variable)
                let pending = vector.new(:Tuple after: Int stmt: Stmt end)
            end
            (* Where the globals are bound: the main body's and the modules'
             * initializations' lets and join parameters outside loops *)
            let globals = walk.globalVariables(unit)
            let rec sites(b: Body): Ok =
                for k = 0 upto {vector.length(b.statements) - 1} do
                    let st = vector.get(b.statements k)
                    case st
                        when sLet with x then
                            if hashSet.contains(globals x.v.id) then
                                begin hashMap.insert(t.topLets x.v.id tuple let body = b let atStart = false end) ok end
                            end
                        when sJoin with x then
                            for j = 0 upto {extent x.params - 1} do
                                if hashSet.contains(globals x.params[j].id) then
                                    begin
                                        hashMap.insert(t.topLets x.params[j].id
                                                tuple let body = x.continuation let atStart = true end)
                                        ok
                                    end
                                end
                            end
                        else ok
                    end
                    case st
                        when sLoop then ok
                        else
                            let inner = walk.statementBodies(st)
                            for j = 0 upto {extent inner - 1} do sites(inner[j]) end
                    end
                end
            sites(unit.main)
            for i = 0 upto {vector.length(unit.modules) - 1} do sites(vector.get(unit.modules i).init) end
            walk.countUses(unit t.uses maps.newIntSet())
            let bodies = vector.new(:Body)
            vector.append(bodies unit.main)
            for i = 0 upto {vector.length(unit.modules) - 1} do
                vector.append(bodies vector.get(unit.modules i).init)
            end
            for i = 0 upto {vector.length(unit.functions) - 1} do
                vector.append(bodies vector.get(unit.functions i).body)
            end
            for i = 0 upto {vector.length(bodies) - 1} do findExternals(t vector.get(bodies i)) end
            for i = 0 upto {vector.length(bodies) - 1} do
                let stmts = walk.walkStatements(vector.get(bodies i) false)
                for k = 0 upto {vector.length(stmts) - 1} do
                    case vector.get(stmts k)
                        when sLet with x then
                            case x.value
                                when opMakeClosure with c then
                                    begin hashMap.insert(t.madeInto c.code.id countOf(t.madeInto c.code.id) + 1) ok end
                                else ok
                            end
                        else ok
                    end
                end
            end
            body(t unit.main)
            for i = 0 upto {vector.length(unit.modules) - 1} do body(t vector.get(unit.modules i).init) end
            (* The thunks made are functions of the unit too, whose bodies may
             * need thunks of their own *)
            let var i = 0
            while i < vector.length(unit.functions) do
                (* Skip functions replaced by lambdaAdapter: their specialized
                 * copies were cloned from the original body and are walked
                 * instead *)
                let f = vector.get(unit.functions i)
                if not(hashSet.contains(t.droppedFunctions f.id)) then body(t f.body) end
                i := i + 1
            end
            (* Insert each hoisted global conversion right after its global is
             * bound *)
            for k = 0 upto {vector.length(t.pending) - 1} do
                let p = vector.get(t.pending k)
                let site = hashMap.find(t.topLets p.after)
                let b = site.body
                let rewritten = vector.new(:Stmt)
                if site.atStart then vector.append(rewritten p.stmt) end
                for j = 0 upto {vector.length(b.statements) - 1} do
                    let s = vector.get(b.statements j)
                    vector.append(rewritten s)
                    case s
                        when sLet with x then if x.v.id is p.after then vector.append(rewritten p.stmt) end
                        else ok
                    end
                end
                b.statements := rewritten
            end
            (* Remove dead lets and functions left behind by fused lambda
             * closures *)
            if not(hashSet.empty(t.dropped)) then
                dropLets(t unit.main)
                for k = 0 upto {vector.length(unit.modules) - 1} do dropLets(t vector.get(unit.modules k).init) end
                let kept = vector.new(:Function)
                for k = 0 upto {vector.length(unit.functions) - 1} do
                    let f = vector.get(unit.functions k)
                    if not(hashSet.contains(t.droppedFunctions f.id)) then
                        dropLets(t f.body)
                        vector.append(kept f)
                    end
                end
                vector.clear(unit.functions)
                for k = 0 upto {vector.length(kept) - 1} do vector.append(unit.functions vector.get(kept k)) end
            end
            unit
        end
end
