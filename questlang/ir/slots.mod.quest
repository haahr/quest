(* Quest Self-Hosted Compiler: Slots and Proxies Implementation *)

module slots : Slots
import
    questlang/types/model : questlang/types/Model
    questlang/types/subtyping : questlang/types/Subtyping
    questlang/ir/shapes : questlang/ir/Shapes
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/walk : questlang/ir/Walk
    questlang/codegen/layout : questlang/codegen/Layout
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    stringOp = string : StringOp
export
    Let Type = model.Type
    Let Shape = shapes.Shape
    Let Variable = nodes.Variable
    Let Atom = nodes.Atom
    Let Body = nodes.Body
    Let Stmt = nodes.Stmt
    Let Op = nodes.Op

    let intEqual(a: Int b: Int): Bool = a is b
    let eq(a: String b: String): Bool = stringOp.equal(a b)

    let isViewedKind(kind: String): Bool = eq(kind "record") orif eq(kind "variant") orif eq(kind "option")

    let mayBeStoredAsSubtype(s: Shape): Bool =
        if eq(s.kind "tuple") then extent s.components > 0
        else eq(s.kind "fun") orif eq(s.kind "all") orif isViewedKind(layout.resolvedShape(s).kind) end

    let typeOf(a: Atom): Type = nodes.atomType(a)

    let held(t: Type kind: String): maybe.T(Shape) =
        begin
            let h = layout.resolvedShape(shapes.shape(t))
            if eq(h.kind kind) then maybe.some(:Shape h) else maybe.none(:Shape) end
        end

    let tagShape(t: Type): maybe.T(Shape) =
        begin
            let v = held(t "variant")
            if maybe.isSome(:Shape v) then v else held(t "option") end
        end

    let boxed(s: maybe.T(Shape)): Bool = maybe.isSome(:Shape s) andif layout.isBoxedInSlots(maybe.unwrap(:Shape s))

    (* The shape of the payload of an exception of type t *)
    let exceptionPayload(t: Type): maybe.T(Shape) =
        begin
            let s = shapes.shape(t)
            if eq(s.kind "exception") then s.elementShape else maybe.none(:Shape) end
        end

    let tupleAccess(ts: Shape index: Int fresh: Bool): String =
        if fresh orif not(layout.mayBeProxied(ts)) then nodes.direct
        elsif layout.changesView(shapes.componentShape(ts.components[index])) then nodes.proxy
        else nodes.original end

    let optionTagAccess(os: Shape): String = if layout.mayBeProxied(os) then nodes.proxy else nodes.direct end

    let optionComponentAccesses(os: Shape tag: maybe.T(String)): Array(String) =
        begin
            let c = if maybe.isSome(:String tag) then shapes.caseOf(os maybe.unwrap(:String tag)) else maybe.none(:shapes.Component) end
            if maybe.isNone(:shapes.Component c) orif maybe.isNone(:Shape maybe.unwrap(:shapes.Component c).shape) then
                array of :String end
            else
                let payload = maybe.unwrap(:Shape maybe.unwrap(:shapes.Component c).shape)
                let comps = vector.new(:Shape)
                if eq(payload.kind "tuple") then
                    for i = 0 upto {extent payload.components - 1} do vector.append(:Shape comps shapes.componentShape(payload.components[i])) end
                else
                    vector.append(:Shape comps payload)
                end
                let proxied = layout.mayBeProxied(os)
                let result = array of(vector.length(:Shape comps) nodes.direct)
                for i = 0 upto {vector.length(:Shape comps) - 1} do
                    result[i] := if not(proxied) then nodes.direct
                        elsif layout.changesView(vector.get(:Shape comps i)) then nodes.proxy
                        else nodes.original end
                end
                result
            end
        end

    (* The shape of the values at an address (of a var or out location) *)
    let locatedShape(address: Atom): Shape =
        begin
            let s = shapes.shape(typeOf(address))
            if eq(s.kind "cell") orif eq(s.kind "out") then shapes.element(s) else s end
        end

    (* The case whose layout an option being made stores its payload in: its
     * tag's, or for a computed ordinal, a constant one's, else the first
     * case's *)
    let optionCaseTag(os: Shape cases: Array(String) tag: maybe.T(String) ordinalAtom: maybe.T(Atom)): maybe.T(String) =
        if maybe.isNone(:Atom ordinalAtom) then
            tag
        else
            let n = case maybe.unwrap(:Atom ordinalAtom)
                when atomConst with x then case x.c.value when constInt with y then y.n else ~1 end
                else ~1
            end
            if {n >= 0} andif {n < extent cases} then maybe.some(:String cases[n]) else os.cases[0].name end
        end

    let newBox(hint: String t: Type): Variable =
        begin
            let box = nodes.newVar(hint t false)
            box.boxed := true
            box
        end

    let slotUnbox(box: Variable t: Type): Op =
        option opConvert of Op with let var value = nodes.atomOfVar(box) let var plan = nodes.newPlan("slot_unbox" t t) end

    Let SlotState = Tuple
        (* The boxes of the records and variants read from slots (by the
         * variable bound to the value) *)
        var boxes: hashMap.T(Int Variable)
        (* The tuples and options the function made (by variable), which are not
         * proxies *)
        var fresh: hashMap.T(Int Bool)
    end

    let isFresh(st: SlotState a: Atom): Bool =
        case a when atomVar with x then hashMap.contains(:Int :Bool st.fresh x.v.id) else false end

    (* A record or variant atom in its slot form: its box (remembered, or a new
     * one, made by a let added to before) *)
    let slot(st: SlotState a: Atom before: vector.T(Stmt)): Atom =
        begin
            let own = case a
                when atomVar with x then
                    if x.v.boxed andif not(x.v.isMutable) then maybe.some(:Atom a)
                    else
                        let remembered = hashMap.get(:Int :Variable st.boxes x.v.id)
                        if maybe.isSome(:Variable remembered) then maybe.some(:Atom nodes.atomOfVar(maybe.unwrap(:Variable remembered)))
                        else maybe.none(:Atom) end
                    end
                else maybe.none(:Atom)
            end
            if maybe.isSome(:Atom own) then
                maybe.unwrap(:Atom own)
            else
                let t = typeOf(a)
                let box = newBox("box" t)
                vector.append(:Stmt before nodes.letStmt(box option opConvert of Op with
                    let var value = a let var plan = nodes.newPlan("slot_box" t t)
                end))
                nodes.atomOfVar(box)
            end
        end

    let slotIfBoxed(st: SlotState a: Atom s: maybe.T(Shape) before: vector.T(Stmt)): Atom =
        if boxed(s) then slot(st a before) else a end

    let optSlotIfBoxed(st: SlotState a: maybe.T(Atom) s: maybe.T(Shape) before: vector.T(Stmt)): maybe.T(Atom) =
        if maybe.isSome(:Atom a) then maybe.some(:Atom slotIfBoxed(st maybe.unwrap(:Atom a) s before)) else a end

    (* Binds a case's binder to its payload's box, from which a let at the
     * case's start reads the value *)
    let unboxBinder(st: SlotState c: nodes.Case): Ok =
        begin
            let b = maybe.unwrap(:Variable c.binder)
            let box = newBox(if stringOp.isEmpty(b.hint) then "box" else b.hint <> "_box" end b.type)
            c.binder := maybe.some(:Variable box)
            let statements = vector.new(:Stmt)
            vector.append(:Stmt statements nodes.letStmt(b slotUnbox(box b.type)))
            for i = 0 upto {vector.length(:Stmt c.body.statements) - 1} do vector.append(:Stmt statements vector.get(:Stmt c.body.statements i)) end
            c.body.statements := statements
            hashMap.insert(:Int :Variable st.boxes b.id box)
            ok
        end

    let caseShape(s: Shape tag: String fallback: Type): Shape =
        begin
            let c = shapes.caseOf(s tag)
            if maybe.isSome(:shapes.Component c) andif maybe.isSome(:Shape maybe.unwrap(:shapes.Component c).shape) then
                maybe.unwrap(:Shape maybe.unwrap(:shapes.Component c).shape)
            else
                shapes.shape(fallback)
            end
        end

    (* A switch's case of a variant, whose binder takes the payload: a record or
     * variant in its slot form *)
    let variantCase(st: SlotState vs: Shape c: nodes.Case): Ok =
        if maybe.isSome(:Variable c.binder) then
            let b = maybe.unwrap(:Variable c.binder)
            if not(eq(shapes.shape(b.type).kind "ok")) andif boxed(maybe.some(:Shape caseShape(vs c.tags[0] b.type))) then
                unboxBinder(st c)
            end
        end

    (* A switch's case of an option, whose binder takes the payload: a tuple of
     * its components, read as decided, or a payload that is not a tuple in its
     * slot form *)
    let optionCase(st: SlotState os: Shape c: nodes.Case): Ok =
        if maybe.isSome(:Variable c.binder) then
            let b = maybe.unwrap(:Variable c.binder)
            if not(eq(shapes.shape(b.type).kind "ok")) then
                c.components := optionComponentAccesses(os maybe.some(:String c.tags[0]))
                if not(eq(shapes.shape(b.type).kind "tuple")) andif boxed(maybe.some(:Shape caseShape(os c.tags[0] b.type))) then
                    unboxBinder(st c)
                end
            end
        end

    (* Whether the offset table of a record literal's view is found at run time:
     * when the view is not the literal's type or a supertype of it by width
     * alone *)
    let runtimeOffsets(fields: Array(nodes.FieldAtom) v: maybe.T(Variable)): Bool =
        if maybe.isNone(:Variable v) then
            false
        else
            let recordFields = array of(extent fields tuple let name = "" let type = model.okType let isVar = false end)
            for i = 0 upto {extent fields - 1} do
                recordFields[i] := tuple let name = fields[i].name let type = typeOf(fields[i].atom) let isVar = fields[i].isVar end
            end
            let concrete = model.recordType(recordFields maybe.none(:String))
            let h = held(maybe.unwrap(:Variable v).type "record")
            let target = if maybe.isSome(:Shape h) then maybe.unwrap(:Shape h).structure else concrete end
            not(subtyping.isTypeEqual(target concrete maybe.none(:model.Lookup)) orif layout.isRecordSubtype(concrete target))
        end

    let hasBox(st: SlotState a: Atom): Bool =
        case a
            when atomVar with x then {x.v.boxed andif not(x.v.isMutable)} orif hashMap.contains(:Int :Variable st.boxes x.v.id)
            else false
        end

    (* Decides how an operation reads and stores slots, converting the atoms it
     * stores to their slot forms (by lets added to before); whether it yields a
     * record or variant in its slot form, which the let binding it then binds
     * to a boxed variable *)
    let operation(st: SlotState o: Op v: maybe.T(Variable) before: vector.T(Stmt)): Bool =
        case o
            when opTupleField with x then
                let ts = shapes.shape(typeOf(x.tup))
                if layout.ownView(ts) then
                    (* A tuple-bounded type parameter's value: read through the
                     * view map, converted, as a value *)
                    false
                else
                    x.access := tupleAccess(ts x.index isFresh(st x.tup))
                    boxed(ts.components[x.index].shape)
                end
            when opRecordField with x then
                let rs = held(typeOf(x.recordAtom) "record")
                if maybe.isNone(:Shape rs) then
                    false
                else
                    let fields = shapes.sortedComponents(maybe.unwrap(:Shape rs))
                    let var field = fields[0]
                    for i = {extent fields - 1} downto 0 do
                        if eq(maybe.unwrapOr(:String fields[i].name "") x.name) then field := fields[i] end
                    end
                    let fieldShape = shapes.componentShape(field)
                    let own = layout.ownView(shapes.shape(typeOf(x.recordAtom)))
                    if not(field.isVar) andif {own orif eq(layout.shapeRepresentation(fieldShape) "QVal") orif mayBeStoredAsSubtype(fieldShape)} then
                        (* A subtype's payload may store it at another type, or
                         * a bounded type parameter's value at its type
                         * argument's type for it: read through the offset table
                         * and converted, as a value *)
                        x.stored := true
                        false
                    else
                        boxed(maybe.some(:Shape fieldShape))
                    end
                end
            when opIndex with x then boxed(shapes.shape(typeOf(x.arr)).elementShape)
            when opLoad with x then boxed(maybe.some(:Shape locatedShape(x.address)))
            when opModuleMember with x then
                case x.moduleRef
                    when refImport then
                        maybe.isSome(:String x.member) andif maybe.isSome(:Variable v)
                            andif boxed(maybe.some(:Shape shapes.shape(maybe.unwrap(:Variable v).type)))
                    else false
                end
            when opConvert with x then
                let p = x.plan
                if eq(p.kind "unbox") andif boxed(maybe.some(:Shape shapes.shape(p.target))) then
                    (* A QVal word holds a record or variant as its box *)
                    true
                else
                    if eq(p.kind "box") then
                        case x.value
                            when atomVar with y then
                                let remembered = hashMap.get(:Int :Variable st.boxes y.v.id)
                                (* A record's or variant's QVal word is its box:
                                 * the one it was read from serves *)
                                if maybe.isSome(:Variable remembered) then x.value := nodes.atomOfVar(maybe.unwrap(:Variable remembered)) end
                            else ok
                        end
                    end
                    if eq(p.kind "copy") andif isFresh(st x.value) then
                        (* A copy of a tuple the function made reads its
                         * components directly *)
                        let copy = nodes.newPlan(p.kind p.source p.target)
                        copy.fields := p.fields
                        copy.layout := p.layout
                        copy.access := array of(extent p.access nodes.direct)
                        copy.thunkSymbols := p.thunkSymbols
                        copy.descriptors := p.descriptors
                        copy.thunkParams := p.thunkParams
                        copy.tagMap := p.tagMap
                        x.plan := copy
                    end
                    false
                end
            when opMakeRecord with x then
                let fields = vector.new(:nodes.FieldAtom)
                let embedded = vector.new(:Int)
                for i = 0 upto {extent x.fields - 1} do
                    let f = x.fields[i]
                    let var a = f.atom
                    let s = shapes.shape(typeOf(a))
                    if not(eq(s.kind "ok")) andif boxed(maybe.some(:Shape s)) then
                        if hasBox(st a) then a := slot(st a before) else vector.append(:Int embedded i) end
                    end
                    vector.append(:nodes.FieldAtom fields tuple let name = f.name let atom = a let isVar = f.isVar end)
                end
                x.fields := vector.toArray(:nodes.FieldAtom fields)
                x.embedded := vector.toArray(:Int embedded)
                x.runtimeOffsets := runtimeOffsets(x.fields v)
                maybe.isSome(:Variable v)
            when opMakeTuple with x then
                let components = if maybe.isSome(:Variable v) then shapes.shape(maybe.unwrap(:Variable v).type).components
                    else array of :shapes.Component end end
                let args = vector.new(:Atom)
                let embedded = vector.new(:Int)
                for i = 0 upto {extent x.args - 1} do
                    let var a = x.args[i]
                    if {i < extent components} andif boxed(components[i].shape) then
                        if hasBox(st a) then a := slot(st a before) else vector.append(:Int embedded i) end
                    end
                    vector.append(:Atom args a)
                end
                x.args := vector.toArray(:Atom args)
                x.embedded := vector.toArray(:Int embedded)
                false
            when opMakeOption with x then
                if maybe.isSome(:Variable v) then
                    let os = held(maybe.unwrap(:Variable v).type "option")
                    let tag = if maybe.isSome(:Shape os) then optionCaseTag(maybe.unwrap(:Shape os) x.cases x.tag x.ordinalAtom)
                        else maybe.none(:String) end
                    if maybe.isSome(:Atom x.payload) andif maybe.isSome(:String tag) then
                        let c = shapes.caseOf(maybe.unwrap(:Shape os) maybe.unwrap(:String tag))
                        let pt = if maybe.isSome(:shapes.Component c) then maybe.unwrap(:shapes.Component c).shape else maybe.none(:Shape) end
                        if maybe.isSome(:Shape pt) andif eq(maybe.unwrap(:Shape pt).kind "tuple") then
                            let payload = maybe.unwrap(:Atom x.payload)
                            let ps = shapes.shape(typeOf(payload))
                            let fresh = isFresh(st payload)
                            let n = extent maybe.unwrap(:Shape pt).components
                            let access = array of(n nodes.direct)
                            for i = 0 upto {n - 1} do access[i] := tupleAccess(ps i fresh) end
                            x.access := access
                        else
                            x.payload := optSlotIfBoxed(st x.payload pt before)
                        end
                    end
                end
                false
            when opMakeVariant with x then
                if maybe.isSome(:Variable v) andif maybe.isSome(:Atom x.payload) then
                    let vs = held(maybe.unwrap(:Variable v).type "variant")
                    let c = if maybe.isSome(:Shape vs) then shapes.caseOf(maybe.unwrap(:Shape vs) x.tag) else maybe.none(:shapes.Component) end
                    x.payload := optSlotIfBoxed(st x.payload
                        if maybe.isSome(:shapes.Component c) then maybe.unwrap(:shapes.Component c).shape else maybe.none(:Shape) end before)
                end
                false
            when opExceptionPayload with x then boxed(exceptionPayload(typeOf(x.exc)))
            when opIsTag with x then
                if not(layout.ownView(shapes.shape(typeOf(x.value)))) then
                    let ts = tagShape(typeOf(x.value))
                    if maybe.isSome(:Shape ts) andif eq(maybe.unwrap(:Shape ts).kind "option") then
                        x.access := optionTagAccess(maybe.unwrap(:Shape ts))
                    end
                end
                false
            when opOrdinal with x then
                if not(layout.ownView(shapes.shape(typeOf(x.value)))) then
                    let ts = tagShape(typeOf(x.value))
                    if maybe.isSome(:Shape ts) andif eq(maybe.unwrap(:Shape ts).kind "option") then
                        x.access := optionTagAccess(maybe.unwrap(:Shape ts))
                    end
                end
                false
            when opPayload with x then
                if layout.ownView(shapes.shape(typeOf(x.value))) then
                    (* Read through the view map, converted, as a value *)
                    false
                else
                    let ts = tagShape(typeOf(x.value))
                    if maybe.isSome(:Shape ts) andif eq(maybe.unwrap(:Shape ts).kind "option") then
                        x.access := optionTagAccess(maybe.unwrap(:Shape ts))
                        x.components := optionComponentAccesses(maybe.unwrap(:Shape ts) maybe.some(:String x.tag))
                        false
                    elsif maybe.isSome(:Shape ts) then
                        let c = shapes.caseOf(maybe.unwrap(:Shape ts) x.tag)
                        boxed(if maybe.isSome(:shapes.Component c) then maybe.unwrap(:shapes.Component c).shape else maybe.none(:Shape) end)
                    else
                        false
                    end
                end
            when opMakeArray with x then
                if maybe.isSome(:Variable v) then
                    let elem = shapes.shape(maybe.unwrap(:Variable v).type).elementShape
                    let args = vector.new(:Atom)
                    for i = 0 upto {extent x.args - 1} do vector.append(:Atom args slotIfBoxed(st x.args[i] elem before)) end
                    x.args := vector.toArray(:Atom args)
                end
                false
            when opArrayRep with x then
                if maybe.isSome(:Variable v) then
                    x.init := slotIfBoxed(st x.init shapes.shape(maybe.unwrap(:Variable v).type).elementShape before)
                end
                false
            when opAddrCell with x then
                x.init := slotIfBoxed(st x.init maybe.some(:Shape shapes.shape(typeOf(x.init))) before)
                false
            when opAddrComponent with x then
                if not(layout.ownView(shapes.shape(typeOf(x.base)))) then
                    x.access := tupleAccess(shapes.shape(typeOf(x.base)) x.index false)
                end
                false
            when opPrim with x then
                if {eq(x.op "is") orif eq(x.op "isnot")} andif {extent x.args is 2} then
                    let t = typeOf(x.args[0])
                    let t2 = typeOf(x.args[1])
                    if not(eq(layout.shapeRepresentation(shapes.shape(t)) "QVal"))
                        andif {layout.mayBeProxied(shapes.shape(t)) orif layout.mayBeProxied(shapes.shape(t2))} then
                        (* A proxy is the object it views *)
                        x.access := nodes.original
                    end
                end
                false
            else false
        end

    let letStatement(st: SlotState s: Stmt): Array(Stmt) =
        case s
            when sLet with x then
                let v = x.v
                let isAtom = case x.value when opAtom then true else false end
                let freshValue = case x.value
                    when opMakeTuple then true
                    when opMakeOption then true
                    when opAtom with y then isFresh(st y.atom)
                    else false
                end
                if freshValue then hashMap.insert(:Int :Bool st.fresh v.id true) end
                if isAtom then
                    case x.value
                        when opAtom with y then
                            case y.atom
                                when atomVar with z then
                                    let remembered = hashMap.get(:Int :Variable st.boxes z.v.id)
                                    if maybe.isSome(:Variable remembered) then
                                        hashMap.insert(:Int :Variable st.boxes v.id maybe.unwrap(:Variable remembered))
                                    end
                                else ok
                            end
                        else ok
                    end
                    array of s end
                else
                    let before = vector.new(:Stmt)
                    if not(operation(st x.value maybe.some(:Variable v) before)) then
                        vector.append(:Stmt before s)
                        vector.toArray(:Stmt before)
                    else
                        (* The operation reads the value in its slot form, a
                         * box: bound to a boxed variable, from which the value
                         * is read *)
                        let box = newBox(if stringOp.isEmpty(v.hint) then "box" else v.hint <> "_box" end v.type)
                        x.v := box
                        hashMap.insert(:Int :Variable st.boxes v.id box)
                        vector.append(:Stmt before s)
                        vector.append(:Stmt before nodes.letStmt(v slotUnbox(box v.type)))
                        vector.toArray(:Stmt before)
                    end
                end
            else array of s end
        end

    let statement(st: SlotState s: Stmt): Array(Stmt) =
        begin
            let before = vector.new(:Stmt)
            case s
                when sLet then ok
                when sDo with x then begin operation(st x.value maybe.none(:Variable) before) ok end
                when sVarDecl with x then
                    if x.v.boxed andif maybe.isSome(:Atom x.init) then x.init := maybe.some(:Atom slot(st maybe.unwrap(:Atom x.init) before)) end
                when sAssign with x then if x.v.boxed then x.value := slot(st x.value before) end
                when sStoreAt with x then x.value := slotIfBoxed(st x.value maybe.some(:Shape locatedShape(x.address)) before)
                when sStoreField with x then
                    let rs = held(typeOf(x.base) "record")
                    let var field = maybe.none(:Shape)
                    if maybe.isSome(:Shape rs) then
                        let fields = shapes.sortedComponents(maybe.unwrap(:Shape rs))
                        for i = {extent fields - 1} downto 0 do
                            if eq(maybe.unwrapOr(:String fields[i].name "") x.name) then field := fields[i].shape end
                        end
                    end
                    x.value := slotIfBoxed(st x.value field before)
                when sStoreComponent with x then
                    let bs = shapes.shape(typeOf(x.base))
                    if layout.ownView(bs) then
                        (* Into a tuple-bounded type parameter's value, through
                         * the view map *)
                        let ts = layout.resolvedShape(bs)
                        x.value := slotIfBoxed(st x.value ts.components[x.index].shape before)
                    else
                        x.value := slotIfBoxed(st x.value bs.components[x.index].shape before)
                        (* A store is never into a fresh tuple's view *)
                        x.access := tupleAccess(bs x.index false)
                    end
                when sStoreElement with x then x.value := slotIfBoxed(st x.value shapes.shape(typeOf(x.base)).elementShape before)
                when sSwitch with x then
                    let ts = tagShape(typeOf(x.value))
                    if layout.ownView(shapes.shape(typeOf(x.value))) then
                        (* A bounded type parameter's value: its payloads are
                         * read through the view map, converted, as values *)
                        ok
                    elsif maybe.isSome(:Shape ts) andif eq(maybe.unwrap(:Shape ts).kind "option") then
                        x.access := optionTagAccess(maybe.unwrap(:Shape ts))
                        for i = 0 upto {extent x.cases - 1} do optionCase(st maybe.unwrap(:Shape ts) x.cases[i]) end
                    elsif maybe.isSome(:Shape ts) then
                        for i = 0 upto {extent x.cases - 1} do variantCase(st maybe.unwrap(:Shape ts) x.cases[i]) end
                    end
                when sRaise with x then
                    if maybe.isSome(:Atom x.payload) then x.payload := optSlotIfBoxed(st x.payload exceptionPayload(typeOf(x.exc)) before) end
                when sEcho with x then x.value := slotIfBoxed(st x.value maybe.some(:Shape shapes.shape(x.type)) before)
                else ok
            end
            case s
                when sLet then letStatement(st s)
                else
                    vector.append(:Stmt before s)
                    vector.toArray(:Stmt before)
            end
        end

    let rec body(st: SlotState b: Body): Ok =
        begin
            let statements = vector.new(:Stmt)
            for i = 0 upto {vector.length(:Stmt b.statements) - 1} do
                let s = vector.get(:Stmt b.statements i)
                let bodies = walk.statementBodies(s)
                for j = 0 upto {extent bodies - 1} do body(st bodies[j]) end
                let made = statement(st s)
                for j = 0 upto {extent made - 1} do vector.append(:Stmt statements made[j]) end
            end
            b.statements := statements
        end

    let decideSlots(unit: nodes.Unit): Ok =
        begin
            let bodies = vector.new(:Body)
            for i = 0 upto {vector.length(:nodes.Module unit.modules) - 1} do vector.append(:Body bodies vector.get(:nodes.Module unit.modules i).init) end
            vector.append(:Body bodies unit.main)
            for i = 0 upto {vector.length(:nodes.Function unit.functions) - 1} do vector.append(:Body bodies vector.get(:nodes.Function unit.functions i).body) end
            (* The mutable variables of record or variant types whose addresses
             * are taken are held boxed, as are var and out parameters of those
             * types *)
            for i = 0 upto {vector.length(:Body bodies) - 1} do
                let stmts = walk.walkStatements(vector.get(:Body bodies i) false)
                for j = 0 upto {vector.length(:Stmt stmts) - 1} do
                    case vector.get(:Stmt stmts j)
                        when sLet with x then
                            case x.value
                                when opAddrVar with y then
                                    if boxed(maybe.some(:Shape shapes.shape(y.v.type))) then y.v.boxed := true end
                                else ok
                            end
                        else ok
                    end
                end
            end
            for i = 0 upto {vector.length(:nodes.Function unit.functions) - 1} do
                let f = vector.get(:nodes.Function unit.functions i)
                for j = 0 upto {extent f.params - 1} do
                    let p = f.params[j]
                    if not(eq(p.mode "value")) andif boxed(maybe.some(:Shape shapes.shape(p.v.type))) then p.v.boxed := true end
                end
            end
            for i = 0 upto {vector.length(:Body bodies) - 1} do
                let st = tuple
                    let var boxes = hashMap.new(:Int :Variable intEqual hash.int)
                    let var fresh = hashMap.new(:Int :Bool intEqual hash.int)
                end
                body(st vector.get(:Body bodies i))
            end
        end
end
