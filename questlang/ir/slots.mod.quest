(* Quest Self-Hosted Compiler: Slots and Proxies Implementation *)

module slots : Slots
import
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/common/maps : questlang/common/Maps
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/walk : questlang/ir/Walk
    questlang/repr/genericLayout : questlang/repr/GenericLayout
    questlang/repr/layout : questlang/repr/Layout
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/types/model : questlang/types/Model
    questlang/types/subtyping : questlang/types/Subtyping
export
    Let Type = model.Type
    Let Shape = shapes.Shape
    Let Variable = nodes.Variable
    Let Atom = nodes.Atom
    Let Body = nodes.Body
    Let Stmt = nodes.Stmt
    Let Op = nodes.Op

    let eq(a: String b: String): Bool = stringOp.equal(a b)

    let mayBeStoredAsSubtype(s: Shape): Bool =
        if shapes.kindIs(s shapes.shapeTuple) then extent s.components > 0
        else shapes.kindIs(s shapes.shapeFun) orif shapes.kindIs(s shapes.shapeAll)
            orif shapes.isViewedKind(layout.resolvedShape(s).kind)
        end

    let typeOf(a: Atom): Type = nodes.atomType(a)

    let tagShape(t: Type): maybe.T(Shape) =
        begin
            let v = layout.heldShape(t shapes.shapeVariant)
            if maybe.isSome(v) then v else layout.heldShape(t shapes.shapeOption) end
        end

    let boxed(s: maybe.T(Shape)): Bool = maybe.isSome(s) andif layout.isBoxedInSlots(maybe.unwrap(s))

    (* The shape of the payload of an exception of type t *)
    let exceptionPayload(t: Type): maybe.T(Shape) =
        begin
            let s = shapes.shape(t)
            if shapes.kindIs(s shapes.shapeException) then s.elementShape else maybe.none() end
        end

    let tupleAccess(ts: Shape index: Int fresh: Bool): nodes.Access =
        if fresh orif not(layout.mayBeProxied(ts)) then nodes.direct
        elsif layout.changesView(shapes.componentShape(ts.components[index])) then nodes.proxy
        else nodes.original
        end

    (* How the tag of an option of shape os is read *)
    let optionTagAccess(os: Shape): nodes.Access = if layout.mayBeProxied(os) then nodes.proxy else nodes.direct end

    (* How the payload components of case tag of an option of shape os are
     * read *)
    let optionComponentAccesses(os: Shape tag: maybe.T(String)): Array(nodes.Access) =
        begin
            let c = if maybe.isSome(tag) then shapes.caseOf(os maybe.unwrap(tag)) else maybe.none(:shapes.Component) end
            if maybe.isNone(c) orif maybe.isNone(maybe.unwrap(c).shape) then
                array of :nodes.Access end
            else
                let payload = maybe.unwrap(maybe.unwrap(c).shape)
                let comps = vector.new(:Shape)
                case payload.kind
                    when shapeTuple then
                        for i = 0 upto {extent payload.components - 1} do
                            vector.append(comps shapes.componentShape(payload.components[i]))
                        end
                    when shapeInt, shapeReal, shapeBool, shapeChar, shapeString, shapeOk, shapeWord, shapeBottom,
                            shapeRecord, shapeVariant, shapeOption, shapeArray, shapeCell, shapeOut, shapeException,
                            shapeFun, shapeAll, shapeAuto, shapeTypevar, shapeAbstract, shapeExternal, shapeOperator,
                            shapePending then
                        vector.append(comps payload)
                end
                let proxied = layout.mayBeProxied(os)
                let result = array of(vector.length(comps) nodes.direct)
                for i = 0 upto {vector.length(comps) - 1} do
                    result[i] := if not(proxied) then nodes.direct
                        elsif layout.changesView(vector.get(comps i)) then nodes.proxy
                        else nodes.original end
                end
                result
            end
        end

    (* The shape of the values at an address (of a var or out location) *)
    let locatedShape(address: Atom): Shape =
        begin
            let s = shapes.shape(typeOf(address))
            if shapes.kindIs(s shapes.shapeCell) orif shapes.kindIs(s shapes.shapeOut) then shapes.element(s) else s end
        end

    (* The case whose layout an option being made stores its payload in: its
     * tag's, or for a computed ordinal, a constant one's, else the first
     * case's *)
    let optionCaseTag(os: Shape cases: Array(String) tag: maybe.T(String) ordinalAtom: maybe.T(Atom)): maybe.T(String) =
        if maybe.isNone(ordinalAtom) then
            tag
        else
            let n =
                case maybe.unwrap(ordinalAtom)
                    when atomConst with x then case x.c.value when constInt with y then y.n else ~1 end
                    else ~1
                end
            if {n >= 0} andif {n < extent cases} then maybe.some(cases[n]) else os.cases[0].name end
        end

    let newBox(hint: String t: Type): Variable =
        begin
            let box = nodes.newVar(hint t false)
            box.boxed := true
            box
        end

    let slotUnbox(box: Variable t: Type): Op =
        option opConvert of Op with
            let var value = nodes.atomOfVar(box)
            let var plan = nodes.newPlan(nodes.planSlotUnbox t t)
        end

    Let SlotState = Tuple
        (* The boxes of the records and variants read from slots (by the
         * variable bound to the value) *)
        var boxes: maps.IntMap(Variable)
        (* The tuples and options the function made (by variable), which are not
         * proxies *)
        var fresh: maps.IntSet
    end

    let isFresh(st: SlotState a: Atom): Bool =
        case a when atomVar with x then hashSet.contains(st.fresh x.v.id) else false end

    (* A record or variant atom in its slot form: its box (remembered, or a new
     * one, made by a let added to before) *)
    let slot(st: SlotState a: Atom before: vector.T(Stmt)): Atom =
        begin
            let own =
                case a
                    when atomVar with x then
                        if x.v.boxed andif not(x.v.isMutable) then
                            maybe.some(a)
                        else
                            let remembered = hashMap.get(st.boxes x.v.id)
                            if maybe.isSome(remembered) then maybe.some(nodes.atomOfVar(maybe.unwrap(remembered)))
                            else maybe.none(:Atom)
                            end
                        end
                    else maybe.none(:Atom)
                end
            if maybe.isSome(own) then
                maybe.unwrap(own)
            else
                let t = typeOf(a)
                let box = newBox("box" t)
                vector.append(before nodes.letStmt(box option opConvert of Op with
                    let var value = a
                    let var plan = nodes.newPlan(nodes.planSlotBox t t)
                end))
                nodes.atomOfVar(box)
            end
        end

    let slotIfBoxed(st: SlotState a: Atom s: maybe.T(Shape) before: vector.T(Stmt)): Atom =
        if boxed(s) then slot(st a before) else a end

    let optSlotIfBoxed(st: SlotState a: maybe.T(Atom) s: maybe.T(Shape) before: vector.T(Stmt)): maybe.T(Atom) =
        if maybe.isSome(a) then maybe.some(slotIfBoxed(st maybe.unwrap(a) s before)) else a end

    (* Binds a case's binder to its payload's box, from which a let at the
     * case's start reads the value *)
    let unboxBinder(st: SlotState c: nodes.Case): Ok =
        begin
            let b = maybe.unwrap(c.binder)
            let box = newBox(if stringOp.isEmpty(b.hint) then "box" else b.hint <> "_box" end b.type)
            c.binder := maybe.some(box)
            let statements = vector.new(:Stmt)
            vector.append(statements nodes.letStmt(b slotUnbox(box b.type)))
            for i = 0 upto {vector.length(c.body.statements) - 1} do
                vector.append(statements vector.get(c.body.statements i))
            end
            c.body.statements := statements
            hashMap.insert(st.boxes b.id box)
            ok
        end

    let caseShape(s: Shape tag: String fallback: Type): Shape =
        begin
            let c = shapes.caseOf(s tag)
            if maybe.isSome(c) andif maybe.isSome(maybe.unwrap(c).shape) then
                maybe.unwrap(maybe.unwrap(c).shape)
            else
                shapes.shape(fallback)
            end
        end

    (* Rewrites a variant switch case whose payload is boxed so that its binder
     * receives the box and unboxes it at case entry *)
    let variantCase(st: SlotState vs: Shape c: nodes.Case): Ok =
        if maybe.isSome(c.binder) then
            let b = maybe.unwrap(c.binder)
            if not(shapes.kindIs(shapes.shape(b.type) shapes.shapeOk))
                    andif boxed(maybe.some(caseShape(vs c.tags[0] b.type))) then
                unboxBinder(st c)
            end
        end

    (* Sets component access modes for an option switch case, and unboxes its
     * binder when the payload is a boxed non-tuple *)
    let optionCase(st: SlotState os: Shape c: nodes.Case): Ok =
        if maybe.isSome(c.binder) then
            let b = maybe.unwrap(c.binder)
            if not(shapes.kindIs(shapes.shape(b.type) shapes.shapeOk)) then
                c.components := optionComponentAccesses(os maybe.some(c.tags[0]))
                if not(shapes.kindIs(shapes.shape(b.type) shapes.shapeTuple))
                        andif boxed(maybe.some(caseShape(os c.tags[0] b.type))) then
                    unboxBinder(st c)
                end
            end
        end

    (* Whether the offset table of a record literal's view is found at run time:
     * when the view is not the literal's type or a supertype of it by width
     * alone *)
    let runtimeOffsets(fields: Array(nodes.FieldAtom) v: maybe.T(Variable)): Bool =
        if maybe.isNone(v) then
            false
        else
            let recordFields = array of(extent fields tuple let name = "" let type = model.okType let isVar = false end)
            for i = 0 upto {extent fields - 1} do
                recordFields[i] := tuple
                    let name = fields[i].name
                    let type = typeOf(fields[i].atom)
                    let isVar = fields[i].isVar
                end
            end
            let concrete = model.recordType(recordFields maybe.none())
            let h = layout.heldShape(maybe.unwrap(v).type shapes.shapeRecord)
            let target = if maybe.isSome(h) then maybe.unwrap(h).structure else concrete end
            not(subtyping.isTypeEqual(target concrete maybe.none()) orif genericLayout.isRecordSubtype(concrete target))
        end

    let hasBox(st: SlotState a: Atom): Bool =
        case a
            when atomVar with x then {x.v.boxed andif not(x.v.isMutable)} orif hashMap.contains(st.boxes x.v.id)
            else false
        end

    (* Decides how o reads and stores slots, appending boxing lets to before
     * for any record or variant atoms stored into slots. Returns true when o
     * yields a record or variant in boxed slot form, so the enclosing let
     * binds a boxed variable and unboxes it. *)
    let operation(st: SlotState o: Op v: maybe.T(Variable) before: vector.T(Stmt)): Bool =
        case o
            when opTupleField with x then
                let ts = layout.resolvedShape(shapes.shape(typeOf(x.tup)))
                if layout.ownView(shapes.shape(typeOf(x.tup))) then
                    (* Values of a tuple-bounded type parameter are read
                     * through the view map and converted, so they arrive
                     * unboxed *)
                    false
                else
                    x.access := tupleAccess(ts x.index isFresh(st x.tup))
                    boxed(ts.components[x.index].shape)
                end
            when opRecordField with x then
                let rs = layout.heldShape(typeOf(x.recordAtom) shapes.shapeRecord)
                if maybe.isNone(rs) then
                    false
                else
                    let fields = shapes.sortedComponents(maybe.unwrap(rs))
                    let var field = fields[0]
                    for i = {extent fields - 1} downto 0 do
                        if eq(maybe.unwrapOr(fields[i].name "") x.name) then field := fields[i] end
                    end
                    let fieldShape = shapes.componentShape(field)
                    let own = layout.ownView(shapes.shape(typeOf(x.recordAtom)))
                    if not(field.isVar)
                            andif {own orif layout.isQVal(fieldShape) orif mayBeStoredAsSubtype(fieldShape)} then
                        (* A subtype or bounded type parameter may store this
                         * field at a different type, so it is read through the
                         * offset table and converted to a value *)
                        x.stored := true
                        false
                    else
                        boxed(maybe.some(fieldShape))
                    end
                end
            when opIndex with x then boxed(shapes.shape(typeOf(x.arr)).elementShape)
            when opLoad with x then boxed(maybe.some(locatedShape(x.address)))
            when opModuleMember with x then
                case x.moduleRef
                    when refImport then
                        maybe.isSome(x.member) andif maybe.isSome(v)
                            andif boxed(maybe.some(shapes.shape(maybe.unwrap(v).type)))
                    else false
                end
            when opConvert with x then
                let p = x.plan
                if nodes.planIs(p nodes.planUnbox) andif boxed(maybe.some(shapes.shape(p.target))) then
                    (* A QVal (uniform polymorphic value word) holds a record
                     * or variant as its box *)
                    true
                else
                    if nodes.planIs(p nodes.planBox) then
                        case x.value
                            when atomVar with y then
                                let remembered = hashMap.get(st.boxes y.v.id)
                                (* A record's or variant's QVal word is its box:
                                 * the one it was read from serves *)
                                if maybe.isSome(remembered) then
                                    x.value := nodes.atomOfVar(maybe.unwrap(remembered))
                                end
                            else ok
                        end
                    end
                    if nodes.planIs(p nodes.planCopy) andif isFresh(st x.value) then
                        (* A copy of a tuple the function made reads its
                         * components directly *)
                        let copy = nodes.newPlan(p.kind p.source p.target)
                        copy.fields := p.fields
                        copy.layout := p.layout
                        copy.access := array of(extent p.access nodes.direct)
                        copy.thunkSymbols := p.thunkSymbols
                        copy.descriptors := p.descriptors
                        copy.thunkParams := p.thunkParams
                        copy.tagMap := p.tagMap
                        x.plan := copy
                    end
                    false
                end
            when opMakeRecord with x then
                let fields = vector.new(:nodes.FieldAtom)
                let embedded = vector.new(:Int)
                for i = 0 upto {extent x.fields - 1} do
                    let f = x.fields[i]
                    let var a = f.atom
                    let s = shapes.shape(typeOf(a))
                    if not(shapes.kindIs(s shapes.shapeOk)) andif boxed(maybe.some(s)) then
                        if hasBox(st a) then a := slot(st a before) else vector.append(embedded i) end
                    end
                    vector.append(fields tuple let name = f.name let atom = a let isVar = f.isVar end)
                end
                x.fields := vector.toArray(fields)
                x.embedded := vector.toArray(embedded)
                x.runtimeOffsets := runtimeOffsets(x.fields v)
                maybe.isSome(v)
            when opMakeTuple with x then
                let components = if maybe.isSome(v) then shapes.shape(maybe.unwrap(v).type).components
                    else array of :shapes.Component end end
                let args = vector.new(:Atom)
                let embedded = vector.new(:Int)
                for i = 0 upto {extent x.args - 1} do
                    let var a = x.args[i]
                    if {i < extent components} andif boxed(components[i].shape) then
                        if hasBox(st a) then a := slot(st a before) else vector.append(embedded i) end
                    end
                    vector.append(args a)
                end
                x.args := vector.toArray(args)
                x.embedded := vector.toArray(embedded)
                false
            when opMakeOption with x then
                if maybe.isSome(v) then
                    let os = layout.heldShape(maybe.unwrap(v).type shapes.shapeOption)
                    let tag = if maybe.isSome(os) then optionCaseTag(maybe.unwrap(os) x.cases x.tag x.ordinalAtom)
                        else maybe.none(:String) end
                    if maybe.isSome(x.payload) andif maybe.isSome(tag) then
                        let c = shapes.caseOf(maybe.unwrap(os) maybe.unwrap(tag))
                        let pt = if maybe.isSome(c) then maybe.unwrap(c).shape else maybe.none(:Shape) end
                        if maybe.isSome(pt) andif shapes.kindIs(maybe.unwrap(pt) shapes.shapeTuple) then
                            let payload = maybe.unwrap(x.payload)
                            let ps = shapes.shape(typeOf(payload))
                            let fresh = isFresh(st payload)
                            let n = extent maybe.unwrap(:Shape pt).components
                            let access = array of(n nodes.direct)
                            for i = 0 upto {n - 1} do access[i] := tupleAccess(ps i fresh) end
                            x.access := access
                        else
                            x.payload := optSlotIfBoxed(st x.payload pt before)
                        end
                    end
                end
                false
            when opMakeVariant with x then
                if maybe.isSome(v) andif maybe.isSome(x.payload) then
                    let vs = layout.heldShape(maybe.unwrap(v).type shapes.shapeVariant)
                    let c =
                        if maybe.isSome(vs) then
                            shapes.caseOf(maybe.unwrap(vs) x.tag)
                        else
                            maybe.none(:shapes.Component)
                        end
                    x.payload := optSlotIfBoxed(st x.payload
                            if maybe.isSome(c) then maybe.unwrap(c).shape else maybe.none() end before)
                end
                false
            (* Decide boxing from the binder's payload type because x.exc has
             * the bare type Exception *)
            when opExceptionPayload then
                maybe.isSome(v) andif boxed(maybe.some(shapes.shape(maybe.unwrap(v).type)))
            when opIsTag with x then
                if not(layout.ownView(shapes.shape(typeOf(x.value)))) then
                    let ts = tagShape(typeOf(x.value))
                    if maybe.isSome(ts) andif shapes.kindIs(maybe.unwrap(ts) shapes.shapeOption) then
                        x.access := optionTagAccess(maybe.unwrap(ts))
                    end
                end
                false
            when opOrdinal with x then
                if not(layout.ownView(shapes.shape(typeOf(x.value)))) then
                    let ts = tagShape(typeOf(x.value))
                    if maybe.isSome(ts) andif shapes.kindIs(maybe.unwrap(ts) shapes.shapeOption) then
                        x.access := optionTagAccess(maybe.unwrap(ts))
                    end
                end
                false
            when opPayload with x then
                if layout.ownView(shapes.shape(typeOf(x.value))) then
                    (* Values of bounded type parameters are read through the
                     * view map and converted *)
                    false
                else
                    let ts = tagShape(typeOf(x.value))
                    if maybe.isSome(ts) andif shapes.kindIs(maybe.unwrap(ts) shapes.shapeOption) then
                        x.access := optionTagAccess(maybe.unwrap(ts))
                        x.components := optionComponentAccesses(maybe.unwrap(ts) maybe.some(x.tag))
                        false
                    elsif maybe.isSome(ts) then
                        let c = shapes.caseOf(maybe.unwrap(ts) x.tag)
                        boxed(if maybe.isSome(c) then maybe.unwrap(c).shape else maybe.none() end)
                    else
                        false
                    end
                end
            when opMakeArray with x then
                if maybe.isSome(v) then
                    let elem = shapes.shape(maybe.unwrap(v).type).elementShape
                    let args = vector.new(:Atom)
                    for i = 0 upto {extent x.args - 1} do vector.append(args slotIfBoxed(st x.args[i] elem before)) end
                    x.args := vector.toArray(args)
                end
                false
            when opArrayRep with x then
                if maybe.isSome(v) then
                    x.init := slotIfBoxed(st x.init shapes.shape(maybe.unwrap(v).type).elementShape before)
                end
                false
            when opAddrCell with x then
                x.init := slotIfBoxed(st x.init maybe.some(shapes.shape(typeOf(x.init))) before)
                false
            when opAddrComponent with x then
                if not(layout.ownView(shapes.shape(typeOf(x.base)))) then
                    x.access := tupleAccess(layout.resolvedShape(shapes.shape(typeOf(x.base))) x.index false)
                end
                false
            when opPrim with x then
                if nodes.comparesIdentity(x.op) andif {extent x.args is 2} then
                    let t = typeOf(x.args[0])
                    let t2 = typeOf(x.args[1])
                    if not(layout.isQVal(shapes.shape(t)))
                            andif {layout.mayBeProxied(shapes.shape(t)) orif layout.mayBeProxied(shapes.shape(t2))} then
                        (* A proxy is the object it views *)
                        x.access := nodes.original
                    end
                end
                false
            else false
        end

    (* Returns the statements that replace a let statement s, preceded by any
     * boxing lets needed for records and variants stored into slots (see
     * operation). When the operation yields a record or variant in boxed slot
     * form, s binds a new boxed variable and a following let unboxes it into
     * s's original variable; st remembers the box so later stores can reuse
     * it. Copying a variable propagates its remembered box and freshness, and
     * allocating a tuple or option marks its variable fresh (not a proxy). *)
    let letStatement(st: SlotState s: Stmt): Array(Stmt) =
        case s
            when sLet with x then
                let v = x.v
                let isAtom = case x.value when opAtom then true else false end
                let freshValue =
                    case x.value
                        when opMakeTuple then true
                        when opMakeOption then true
                        when opAtom with y then isFresh(st y.atom)
                        else false
                    end
                if freshValue then hashSet.insert(st.fresh v.id) end
                if isAtom then
                    case x.value
                        when opAtom with y then
                            case y.atom
                                when atomVar with z then
                                    let remembered = hashMap.get(st.boxes z.v.id)
                                    if maybe.isSome(remembered) then
                                        hashMap.insert(st.boxes v.id maybe.unwrap(remembered))
                                    end
                                else ok
                            end
                        else ok
                    end
                    array of s end
                else
                    let before = vector.new(:Stmt)
                    if not(operation(st x.value maybe.some(v) before)) then
                        vector.append(before s)
                        vector.toArray(before)
                    else
                        (* The operation yields a boxed value, so bind it to a
                         * boxed variable and unbox it into v *)
                        let box = newBox(if stringOp.isEmpty(v.hint) then "box" else v.hint <> "_box" end v.type)
                        x.v := box
                        hashMap.insert(st.boxes v.id box)
                        vector.append(before s)
                        vector.append(before nodes.letStmt(v slotUnbox(box v.type)))
                        vector.toArray(before)
                    end
                end
            else array of s end
        end

    (* Decides how a switch reads an option's tag and payload, and rewrites
     * boxed case binders to bind the payload's box and unbox it at case entry.
     * This runs before visiting the case bodies so st remembers each binder's
     * box and any store of the binder into another slot reuses it. *)
    let switchCases(st: SlotState s: Stmt): Ok =
        case s
            when sSwitch with x then
                let ts = tagShape(typeOf(x.value))
                if layout.ownView(shapes.shape(typeOf(x.value))) then
                    (* Payloads of a bounded type parameter are read through
                     * the view map and converted to values *)
                    ok
                elsif maybe.isSome(ts) andif shapes.kindIs(maybe.unwrap(ts) shapes.shapeOption) then
                    x.access := optionTagAccess(maybe.unwrap(ts))
                    for i = 0 upto {extent x.cases - 1} do optionCase(st maybe.unwrap(ts) x.cases[i]) end
                elsif maybe.isSome(ts) then
                    for i = 0 upto {extent x.cases - 1} do variantCase(st maybe.unwrap(ts) x.cases[i]) end
                end
            else ok
        end

    (* Returns the statements that replace s, delegating lets to letStatement
     * and leaving switches to switchCases. Boxes any record or variant stored
     * into a slot (boxed variable init or assignment, store, raise payload, or
     * echo) by prepending boxing lets, and sets the access mode for tuple
     * component stores. *)
    let statement(st: SlotState s: Stmt): Array(Stmt) =
        begin
            let before = vector.new(:Stmt)
            case s
                when sLet then ok
                when sDo with x then begin operation(st x.value maybe.none() before) ok end
                when sVarDecl with x then
                    if x.v.boxed andif maybe.isSome(x.init) then
                        x.init := maybe.some(slot(st maybe.unwrap(x.init) before))
                    end
                when sAssign with x then if x.v.boxed then x.value := slot(st x.value before) end
                when sStoreAt with x then x.value := slotIfBoxed(st x.value maybe.some(locatedShape(x.address)) before)
                when sStoreField with x then
                    let rs = layout.heldShape(typeOf(x.base) shapes.shapeRecord)
                    let var field = maybe.none(:Shape)
                    if maybe.isSome(rs) then
                        let fields = shapes.sortedComponents(maybe.unwrap(rs))
                        for i = {extent fields - 1} downto 0 do
                            if eq(maybe.unwrapOr(fields[i].name "") x.name) then field := fields[i].shape end
                        end
                    end
                    x.value := slotIfBoxed(st x.value field before)
                when sStoreComponent with x then
                    let bs = shapes.shape(typeOf(x.base))
                    if layout.ownView(bs) then
                        (* Stores into a tuple-bounded type parameter go
                         * through the view map *)
                        let ts = layout.resolvedShape(bs)
                        x.value := slotIfBoxed(st x.value ts.components[x.index].shape before)
                    else
                        let ts = layout.resolvedShape(bs)
                        x.value := slotIfBoxed(st x.value ts.components[x.index].shape before)
                        (* A store is never into a fresh tuple's view *)
                        x.access := tupleAccess(ts x.index false)
                    end
                when sStoreElement with x then
                    x.value := slotIfBoxed(st x.value shapes.shape(typeOf(x.base)).elementShape before)
                when sSwitch then ok  (* switchCases, before its cases' bodies *)
                when sRaise with x then
                    if maybe.isSome(x.payload) then
                        x.payload := optSlotIfBoxed(st x.payload exceptionPayload(typeOf(x.exc)) before)
                    end
                when sEcho with x then x.value := slotIfBoxed(st x.value maybe.some(shapes.shape(x.type)) before)
                else ok
            end
            case s
                when sLet then letStatement(st s)
                else
                    vector.append(before s)
                    vector.toArray(before)
            end
        end

    (* Decides slot boxing and proxy access for b's statements in place. Each
     * switch's cases are processed before their bodies, and nested bodies are
     * processed before their enclosing statement. *)
    let rec body(st: SlotState b: Body): Ok =
        begin
            let statements = vector.new(:Stmt)
            for i = 0 upto {vector.length(b.statements) - 1} do
                let s = vector.get(b.statements i)
                switchCases(st s)
                let bodies = walk.statementBodies(s)
                for j = 0 upto {extent bodies - 1} do body(st bodies[j]) end
                let made = statement(st s)
                for j = 0 upto {extent made - 1} do vector.append(statements made[j]) end
            end
            b.statements := statements
        end

    let decideSlots(unit: nodes.Unit): Ok =
        begin
            let bodies = walk.unitBodies(unit)
            (* The mutable variables of record or variant types whose addresses
             * are taken are held boxed, as are var and out parameters of those
             * types *)
            for i = 0 upto {extent bodies - 1} do
                let stmts = walk.walkStatements(bodies[i] false)
                for j = 0 upto {vector.length(stmts) - 1} do
                    case vector.get(stmts j)
                        when sLet with x then
                            case x.value
                                when opAddrVar with y then
                                    if boxed(maybe.some(shapes.shape(y.v.type))) then y.v.boxed := true end
                                else ok
                            end
                        else ok
                    end
                end
            end
            for i = 0 upto {vector.length(unit.functions) - 1} do
                let f = vector.get(unit.functions i)
                for j = 0 upto {extent f.params - 1} do
                    let p = f.params[j]
                    if not(p.mode?modeValue) andif boxed(maybe.some(shapes.shape(p.v.type))) then
                        p.v.boxed := true
                    end
                end
            end
            for i = 0 upto {extent bodies - 1} do
                let st = tuple
                    let var boxes = maps.newIntMap(:Variable)
                    let var fresh = maps.newIntSet()
                end
                body(st bodies[i])
            end
        end
end
