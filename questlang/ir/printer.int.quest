(* Quest Self-Hosted Compiler: The IR Printer Interface
 *
 * bootstrap/python/quest/ir/printer.py: the IR's textual form (docs/ir.md
 * section 10), for dumps and goldens. Variables print as their hints, made
 * distinct within a unit by a numeric suffix (x, x.1, ...) in the order they
 * are bound, and temporaries (no hint) as %1, %2, ...; types print as Quest
 * types, with alias names. After the describe pass, descriptor operands print
 * in place of type arguments. The bootstrap's printer reads nodes' fields by
 * reflection; this one lists each node's fields. *)

interface Printer
import
    questlang/ir/nodes : questlang/ir/Nodes
export
    (* The textual form of a unit: its static data (after the describe pass),
     * its modules, then its main body *)
    formatUnit(unit: nodes.Unit): String
    formatBody(body: nodes.Body): String
end
