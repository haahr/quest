(* Quest Self-Hosted Compiler: The IR Printer Interface
 *
 * Formats Core IR in its textual form (docs/ir.md section 10) for compiler
 * dumps and golden tests; its counterpart is
 * bootstrap/python/quest/ir/printer.py. Variables print as their name hints,
 * disambiguated within a unit by a numeric suffix (x, x.1, ...) in binding
 * order, and unnamed temporaries print as %1, %2, ...; types print as Quest
 * types with alias names. After the describe pass, runtime type descriptors
 * print in place of type arguments. A statement with a source position ends
 * with @line:col (docs/ir.md section 5), which the bootstrap's printer lacks.
 * Whereas the bootstrap's printer inspects node fields by reflection, this
 * one handles each node explicitly. *)

interface Printer
import
    questlang/ir/nodes : questlang/ir/Nodes
export
    (* The textual form of a unit: its imports, static data (after the describe
     * pass), lifted functions, modules, and main body *)
    formatUnit(unit: nodes.Unit): String
    formatBody(body: nodes.Body): String
end
