(* Quest Self-Hosted Compiler: Contification Implementation *)

module contify : Contify
import
    conv : Conv
    stringOp = string : StringOp

    collections/hashMap : collections/HashMap
    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/common/maps : questlang/common/Maps
    questlang/ir/clone : questlang/ir/Clone
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/walk : questlang/ir/Walk
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/types/model : questlang/types/Model
export
    Let Variable = nodes.Variable
    Let Atom = nodes.Atom
    Let Body = nodes.Body
    Let Stmt = nodes.Stmt

    (* The most functions contified in one call, a bound on its rounds *)
    let maxContified = 1000

    (* A statement's place: its body and its index there *)
    Let Site = Tuple body: Body index: Int end

    (* The function a statement calls, if it calls one by its variable *)
    let callee(st: Stmt): maybe.T(Variable) =
        begin
            let c = walk.statementCall(st)
            if maybe.isSome(c) then maybe.unwrap(c).callee else maybe.none() end
        end

    (* A statement's call, which it is known to make *)
    let callIn(st: Stmt): nodes.OpCall = maybe.unwrap(walk.statementCall(st))

    let calls(st: Stmt f: nodes.Function): Bool =
        begin
            let c = callee(st)
            maybe.isSome(c) andif nodes.same(maybe.unwrap(c) f.v)
        end

    let returnsOk(st: Stmt): Bool =
        case st
            when sReturn with x then case x.value when atomConst with c then c.c.value?constOk else false end
            else false
        end

    (* ======================================================================
     * What the unit holds
     * ====================================================================== *)

    (* The functions funs statements bind, with their statements; each
     * variable's uses; and the places of the calls of each function *)
    Let Unit = Tuple
        functions: vector.T(nodes.Function)
        funs: maps.IntMap(nodes.StmtFuns)
        uses: maps.IntMap(Int)
        sites: maps.IntMap(vector.T(Site))
    end

    let rec gather(u: Unit b: Body): Ok =
        for i = 0 upto {vector.length(b.statements) - 1} do
            let st = vector.get(b.statements i)
            let used = walk.statementUses(st)
            for j = 0 upto {extent used - 1} do
                case used[j]
                    when atomVar with x then
                        hashMap.insert(u.uses x.v.id 1 + maybe.unwrapOr(hashMap.get(u.uses x.v.id) 0))
                        ok
                    when atomConst then ok
                end
            end
            let c = callee(st)
            if maybe.isSome(c) then
                let id = maybe.unwrap(c).id
                if not(hashMap.contains(u.sites id)) then
                    hashMap.insert(u.sites id vector.new(:Site))
                end
                vector.append(hashMap.find(u.sites id) tuple let body = b let index = i end)
            end
            case st
                when sFuns with x then
                    for k = 0 upto {extent x.functions - 1} do
                        vector.append(u.functions x.functions[k])
                        hashMap.insert(u.funs x.functions[k].v.id x)
                        gather(u x.functions[k].body)
                    end
                else ok
            end
            let inner = walk.statementBodies(st)
            for k = 0 upto {extent inner - 1} do gather(u inner[k]) end
        end

    (* Records the ids of b and all nested bodies (including inside nested
     * functions) in ids *)
    let rec bodyIds(b: Body ids: maps.IntSet): Ok =
        begin
            hashSet.insert(ids b.id)
            for i = 0 upto {vector.length(b.statements) - 1} do
                let st = vector.get(b.statements i)
                case st
                    when sFuns with x then
                        for k = 0 upto {extent x.functions - 1} do bodyIds(x.functions[k].body ids) end
                    else ok
                end
                let inner = walk.statementBodies(st)
                for k = 0 upto {extent inner - 1} do bodyIds(inner[k] ids) end
            end
        end

    (* ======================================================================
     * Tail calls
     * ====================================================================== *)

    (* A tail call of the function itself, at the end of its body: the call,
     * and whether the return after it goes with it *)
    Let Tail = Tuple body: Body index: Int withReturn: Bool end
    Let Scan = Tuple tails: vector.T(Tail) var calls: Int end

    (* Counts calls to f in b (excluding nested functions) and records tail
     * calls in sc. allowed is false inside a try body, where the exception
     * handler prevents tail calls; fallsOk is true when falling off the end of
     * b returns ok from f. *)
    let rec scan(f: nodes.Function sc: Scan b: Body allowed: Bool fallsOk: Bool): Ok =
        begin
            let n = vector.length(b.statements)
            for k = 0 upto {n - 1} do
                let st = vector.get(b.statements k)
                let next = if {k + 1} < n then maybe.some(vector.get(b.statements k + 1)) else maybe.none(:Stmt) end
                let okNext = maybe.isSome(next) andif returnsOk(maybe.unwrap(next)) andif {{k + 2} is n}
                (* Falling off the statement returns ok *)
                let tail = allowed andif {{{{k + 1} is n} andif fallsOk} orif okNext}
                if calls(st f) then
                    sc.calls := sc.calls + 1
                    case st
                        when sLet with x then
                            let returned =
                                if maybe.isSome(next) andif {{k + 2} is n} then
                                    case maybe.unwrap(next)
                                        when sReturn with r then
                                            case r.value when atomVar with y then nodes.same(y.v x.v) else false end
                                        else false
                                    end
                                else
                                    false
                                end
                            if allowed andif returned then
                                vector.append(sc.tails tuple let body = b let index = k let withReturn = true end)
                            end
                        when sDo then
                            if tail then
                                vector.append(sc.tails tuple let body = b let index = k let withReturn = okNext end)
                            end
                        else ok
                    end
                end
                case st
                    when sIf with x then begin scan(f sc x.thenBody allowed tail) scan(f sc x.elseBody allowed tail) end
                    when sSwitch with x then
                        begin
                            for j = 0 upto {extent x.cases - 1} do scan(f sc x.cases[j].body allowed tail) end
                            if maybe.isSome(x.elseBody) then scan(f sc maybe.unwrap(x.elseBody) allowed tail) end
                        end
                    when sInspect with x then
                        begin
                            for j = 0 upto {extent x.cases - 1} do scan(f sc x.cases[j].body allowed tail) end
                            if maybe.isSome(x.elseBody) then scan(f sc maybe.unwrap(x.elseBody) allowed tail) end
                        end
                    when sJoin with x then
                        begin scan(f sc x.continuation allowed tail) scan(f sc x.body allowed tail) end
                    (* Falling off a loop's body repeats it; a try's body runs
                     * under an exception handler, so calls inside it are not
                     * tail calls *)
                    when sTry with x then begin scan(f sc x.body false false) scan(f sc x.handler allowed false) end
                    when sLoop, sLetRec then
                        let inner = walk.statementBodies(st)
                        for j = 0 upto {extent inner - 1} do scan(f sc inner[j] allowed false) end
                    else ok
                end
            end
        end

    (* Whether a break in b, or in a body within it, leaves the loop label *)
    let rec breaksTo(b: Body label: String): Bool =
        begin
            let var found = false
            for k = 0 upto {vector.length(b.statements) - 1} do
                let st = vector.get(b.statements k)
                case st
                    when sBreak with x then
                        found := found orif stringOp.equal(x.label label)
                    else
                        let inner = walk.statementBodies(st)
                        for j = 0 upto {extent inner - 1} do found := found orif breaksTo(inner[j] label) end
                end
            end
            found
        end

    (* Returns true when control cannot fall off the end of b. This holds when
     * the last statement transfers control (return, raise, unreachable, jump,
     * break, or continue), is a structured statement (if, switch with else,
     * inspect, join, or try) whose branches all end control (an inspect without
     * an else raises on mismatch), or is a loop with no matching break. This
     * check is conservative: a switch without an else is treated as falling
     * off. Contification requires this of f's body because it becomes a loop
     * body, where falling off the end would repeat the loop instead of
     * returning. *)
    let rec endsControl(b: Body): Bool =
        begin
            let n = vector.length(b.statements)
            if n is 0 then
                false
            else
                case vector.get(b.statements n - 1)
                    when sReturn, sRaise, sUnreachable, sJump, sBreak, sContinue then true
                    when sIf with x then endsControl(x.thenBody) andif endsControl(x.elseBody)
                    when sSwitch with x then
                        let var all = maybe.isSome(x.elseBody) andif endsControl(maybe.unwrap(x.elseBody))
                        for j = 0 upto {extent x.cases - 1} do
                            if not(endsControl(x.cases[j].body)) then all := false end
                        end
                        all
                    when sInspect with x then
                        let var all = maybe.isNone(x.elseBody) orif endsControl(maybe.unwrap(x.elseBody))
                        for j = 0 upto {extent x.cases - 1} do
                            if not(endsControl(x.cases[j].body)) then all := false end
                        end
                        all
                    when sJoin with x then endsControl(x.body) andif endsControl(x.continuation)
                    when sTry with x then endsControl(x.body) andif endsControl(x.handler)
                    when sLoop with x then not(breaksTo(x.body x.label))
                    else false
                end
            end
        end

    (* ======================================================================
     * The transformation
     * ====================================================================== *)

    (* Replaces, in place, the returns of a body of f's (not of its
     * functions') by jumps to label *)
    let rec jumps(b: Body label: String): Ok =
        for i = 0 upto {vector.length(b.statements) - 1} do
            let s = vector.get(b.statements i)
            case s
                when sReturn with x then
                    vector.set(b.statements i option sJump of Stmt with
                        let var pos = x.pos
                        let label = label
                        let var args = array of x.value end
                    end)
                else
                    let inner = walk.statementBodies(s)
                    for k = 0 upto {extent inner - 1} do jumps(inner[k] label) end
            end
        end

    (* Makes f, which funs binds, a loop at its one outside call, the statement
     * at site, in place; tails are f's tail calls of itself. A mutable
     * variable stands for each parameter; the loop's body binds the
     * parameters to them, then runs f's body, whose returns become jumps to a
     * join point whose continuation is the rest of the caller's body. Each
     * tail call (with the return after it) becomes assignments to the
     * variables and a continue. For example, with f(n) returning n when
     * n = 0 and calling f(n - 1) otherwise,
     *     let r = call f(10); rest
     * becomes (the labels counted by labels)
     *     join contified2(r) { rest } in {
     *       var n' := 10
     *       loop contified1 {
     *         let n = n'
     *         if n = 0 { jump contified2(n) }
     *         else { let m = n - 1; n' := m; continue contified1 }
     *       }
     *     }
     * Each iteration binds the parameters anew, immutable, because f's own
     * functions may capture them and no function may capture a mutable
     * variable (closure conversion rejects one). funs no longer binds f. *)
    let transform(f: nodes.Function funs: nodes.StmtFuns site: Site tails: vector.T(Tail) labels: clone.Labels): Ok =
        begin
            labels.count := labels.count + 1
            let loopLabel = "contified" <> conv.int(labels.count)
            labels.count := labels.count + 1
            let joinLabel = "contified" <> conv.int(labels.count)
            let st = vector.get(site.body.statements site.index)
            let call = callIn(st)
            let result = case st when sLet with x then x.v else nodes.newVar("r" f.resultType false) end
            let vars = array of(extent f.params f.v)
            for i = 0 upto {extent f.params - 1} do
                let p = f.params[i].v
                vars[i] := nodes.newVar(p.hint p.type true)
            end
            (* Each tail call assigns the parameters' variables and repeats *)
            for t = 0 upto {vector.length(tails) - 1} do
                let tail = vector.get(tails t)
                let tailCall = vector.get(tail.body.statements tail.index)
                let c = callIn(tailCall)
                let kept = vector.new(:Stmt)
                for i = 0 upto {tail.index - 1} do vector.append(kept vector.get(tail.body.statements i)) end
                for i = 0 upto {extent vars - 1} do
                    vector.append(kept option sAssign of Stmt with
                        let var pos = nodes.stmtPos(tailCall)
                        let var v = vars[i]
                        let var value = c.args[i]
                    end)
                end
                vector.append(kept option sContinue of Stmt with
                    let var pos = nodes.stmtPos(tailCall)
                    let label = loopLabel
                end)
                tail.body.statements := kept
            end
            jumps(f.body joinLabel)
            let iteration = vector.new(:Stmt)
            for i = 0 upto {extent vars - 1} do
                vector.append(iteration nodes.letStmt(f.params[i].v nodes.opOfVar(vars[i])))
            end
            for i = 0 upto {vector.length(f.body.statements) - 1} do
                vector.append(iteration vector.get(f.body.statements i))
            end
            let inner = vector.new(:Stmt)
            for i = 0 upto {extent vars - 1} do
                vector.append(inner option sVarDecl of Stmt with
                    let var pos = nodes.stmtPos(st)
                    let var v = vars[i]
                    let var init = maybe.some(call.args[i])
                end)
            end
            vector.append(inner option sLoop of Stmt with
                let label = loopLabel
                let var body = nodes.bodyOf(vector.toArray(iteration))
            end)
            let rest = vector.new(:Stmt)
            for i = site.index + 1 upto {vector.length(site.body.statements) - 1} do
                vector.append(rest vector.get(site.body.statements i))
            end
            let before = vector.new(:Stmt)
            for i = 0 upto {site.index - 1} do vector.append(before vector.get(site.body.statements i)) end
            vector.append(before option sJoin of Stmt with
                let label = joinLabel
                let var params = array of result end
                let var continuation = nodes.bodyOf(vector.toArray(rest))
                let var body = nodes.bodyOf(vector.toArray(inner))
            end)
            site.body.statements := before
            (* The function is the loop now, and its funs statement binds the
             * others (the simplifier removes one that binds none) *)
            let others = vector.new(:nodes.Function)
            for i = 0 upto {extent funs.functions - 1} do
                if not(nodes.same(funs.functions[i].v f.v)) then vector.append(others funs.functions[i]) end
            end
            funs.functions := vector.toArray(others)
        end

    (* Contifies the first eligible, unpinned function in all (in the order
     * gather finds them) and returns whether one was contified. It gathers
     * functions, uses, and call sites afresh each round because each
     * transformation moves bodies and statements, invalidating earlier
     * sites. *)
    let contifyOne(all: Array(Body) recursive: maps.IntMap(Bool) pinned: maps.IntSet labels: clone.Labels)
            : Bool =
        begin
            let u = tuple
                let functions = vector.new(:nodes.Function)
                let funs = maps.newIntMap(:nodes.StmtFuns)
                let uses = maps.newIntMap(:Int)
                let sites = maps.newIntMap(:vector.T(Site))
            end
            for b = 0 upto {extent all - 1} do gather(u all[b]) end
            let var done = false
            for i = 0 upto {vector.length(u.functions) - 1} do
                let f = vector.get(u.functions i)
                let var values = extent f.typeParams is 0
                for k = 0 upto {extent f.params - 1} do
                    if not(stringOp.equal(f.params[k].mode "value")) then values := false end
                end
                let sites = maybe.unwrapOr(hashMap.get(u.sites f.v.id) vector.new(:Site))
                let uses = maybe.unwrapOr(hashMap.get(u.uses f.v.id) 0)
                if not(done) andif values andif not(hashSet.contains(pinned f.v.id))
                        andif {uses is vector.length(sites)} andif {uses > 0} andif endsControl(f.body) then
                    let sc = tuple let tails = vector.new(:Tail) let var calls = 0 end
                    scan(f sc f.body true false)
                    let inside = maps.newIntSet()
                    bodyIds(f.body inside)
                    let outside = vector.new(:Site)
                    for k = 0 upto {vector.length(sites) - 1} do
                        let s = vector.get(sites k)
                        if not(hashSet.contains(inside s.body.id)) then vector.append(outside s) end
                    end
                    (* A function that never calls itself and is not
                     * recursive through others is left to the inliner: as a
                     * loop at a module's top level, its bindings would be the
                     * loop's, not the module's, and its functions would
                     * capture them *)
                    let loops = {sc.calls > 0}
                        orif maybe.unwrapOr(hashMap.get(recursive f.v.id) false)
                    if {vector.length(outside) is 1} andif {vector.length(sc.tails) is sc.calls}
                            andif loops andif {{sc.calls + 1} is uses} then
                        transform(f hashMap.find(u.funs f.v.id) vector.get(outside 0) sc.tails labels)
                        done := true
                    end
                end
            end
            done
        end

    let contify(all: Array(Body) recursive: maps.IntMap(Bool) pinned: maps.IntSet labels: clone.Labels)
            : Bool =
        begin
            let var any = false
            let var more = true
            let var n = 0
            while more andif {n < maxContified} do
                more := contifyOne(all recursive pinned labels)
                if more then any := true end
                n := n + 1
            end
            any
        end
end
