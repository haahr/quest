(* Quest Self-Hosted Compiler: Contification Implementation *)

module contify : Contify
import
    questlang/types/model : questlang/types/Model
    questlang/ir/shapes : questlang/ir/Shapes
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/walk : questlang/ir/Walk
    questlang/ir/clone : questlang/ir/Clone
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/hash : util/Hash
    util/maybe : util/Maybe
    stringOp = string : StringOp
    conv : Conv
export
    Let Variable = nodes.Variable
    Let Atom = nodes.Atom
    Let Body = nodes.Body
    Let Stmt = nodes.Stmt

    let intEqual(a: Int b: Int): Bool = a is b

    (* The most functions contified in one call, a bound on its rounds *)
    let maxContified = 1000

    (* A statement's place: its body and its index there *)
    Let Site = Tuple body: Body index: Int end

    (* The function a statement calls, if it calls one by its variable *)
    let callee(st: Stmt): maybe.T(Variable) =
        case st
            when sLet with x then case x.value when opCall with c then c.callee else maybe.none(:Variable) end
            when sDo with x then case x.value when opCall with c then c.callee else maybe.none(:Variable) end
            else maybe.none(:Variable)
        end

    (* A statement's call, which it is known to make *)
    let callIn(st: Stmt): nodes.OpCall =
        begin
            let found = case st
                when sLet with x then case x.value when opCall with c then maybe.some(:nodes.OpCall c) else maybe.none(:nodes.OpCall) end
                when sDo with x then case x.value when opCall with c then maybe.some(:nodes.OpCall c) else maybe.none(:nodes.OpCall) end
                else maybe.none(:nodes.OpCall)
            end
            maybe.unwrap(:nodes.OpCall found)
        end

    let calls(st: Stmt f: nodes.Function): Bool =
        begin
            let c = callee(st)
            maybe.isSome(:Variable c) andif nodes.same(maybe.unwrap(:Variable c) f.v)
        end

    let returnsOk(st: Stmt): Bool =
        case st
            when sReturn with x then case x.value when atomConst with c then c.c.value?constOk else false end
            else false
        end

    (* ======================================================================
     * What the unit holds
     * ====================================================================== *)

    (* The functions funs statements bind, with their statements; each
     * variable's uses; and the places of the calls of each function *)
    Let Unit = Tuple
        functions: vector.T(nodes.Function)
        funs: hashMap.T(Int nodes.StmtFuns)
        uses: hashMap.T(Int Int)
        sites: hashMap.T(Int vector.T(Site))
    end

    let rec gather(u: Unit b: Body): Ok =
        for i = 0 upto {vector.length(:Stmt b.statements) - 1} do
            let st = vector.get(:Stmt b.statements i)
            let used = walk.statementUses(st)
            for j = 0 upto {extent used - 1} do
                case used[j]
                    when atomVar with x then
                        hashMap.insert(:Int :Int u.uses x.v.id 1 + maybe.unwrapOr(:Int hashMap.get(:Int :Int u.uses x.v.id) 0))
                        ok
                    when atomConst then ok
                end
            end
            let c = callee(st)
            if maybe.isSome(:Variable c) then
                let id = maybe.unwrap(:Variable c).id
                if not(hashMap.contains(:Int :vector.T(Site) u.sites id)) then
                    hashMap.insert(:Int :vector.T(Site) u.sites id vector.new(:Site))
                end
                vector.append(:Site hashMap.find(:Int :vector.T(Site) u.sites id) tuple let body = b let index = i end)
            end
            case st
                when sFuns with x then
                    for k = 0 upto {extent x.functions - 1} do
                        vector.append(:nodes.Function u.functions x.functions[k])
                        hashMap.insert(:Int :nodes.StmtFuns u.funs x.functions[k].v.id x)
                        gather(u x.functions[k].body)
                    end
                else ok
            end
            let inner = walk.statementBodies(st)
            for k = 0 upto {extent inner - 1} do gather(u inner[k]) end
        end

    (* The ids of a body and of the bodies it holds, its functions' too *)
    let rec bodyIds(b: Body ids: hashMap.T(Int Bool)): Ok =
        begin
            hashMap.insert(:Int :Bool ids b.id true)
            for i = 0 upto {vector.length(:Stmt b.statements) - 1} do
                let st = vector.get(:Stmt b.statements i)
                case st
                    when sFuns with x then for k = 0 upto {extent x.functions - 1} do bodyIds(x.functions[k].body ids) end
                    else ok
                end
                let inner = walk.statementBodies(st)
                for k = 0 upto {extent inner - 1} do bodyIds(inner[k] ids) end
            end
        end

    (* ======================================================================
     * Tail calls
     * ====================================================================== *)

    (* A tail call of the function itself, at the end of its body: the call,
     * and whether the return after it goes with it *)
    Let Tail = Tuple body: Body index: Int withReturn: Bool end
    Let Scan = Tuple tails: vector.T(Tail) var calls: Int end

    (* The calls of f in a body of f's (not of its functions'); allowed
     * whether a call in it may be a tail call (not in a try's region, which
     * holds the call), and fallsOk whether falling off its end returns ok
     * from f *)
    let rec scan(f: nodes.Function sc: Scan b: Body allowed: Bool fallsOk: Bool): Ok =
        begin
            let n = vector.length(:Stmt b.statements)
            for k = 0 upto {n - 1} do
                let st = vector.get(:Stmt b.statements k)
                let next = if {k + 1} < n then maybe.some(:Stmt vector.get(:Stmt b.statements k + 1)) else maybe.none(:Stmt) end
                let okNext = maybe.isSome(:Stmt next) andif returnsOk(maybe.unwrap(:Stmt next)) andif {{k + 2} is n}
                (* Falling off the statement returns ok *)
                let tail = allowed andif {{{{k + 1} is n} andif fallsOk} orif okNext}
                if calls(st f) then
                    sc.calls := sc.calls + 1
                    case st
                        when sLet with x then
                            let returned = if maybe.isSome(:Stmt next) andif {{k + 2} is n} then
                                case maybe.unwrap(:Stmt next)
                                    when sReturn with r then
                                        case r.value when atomVar with y then nodes.same(y.v x.v) else false end
                                    else false
                                end
                            else
                                false
                            end
                            if allowed andif returned then
                                vector.append(:Tail sc.tails tuple let body = b let index = k let withReturn = true end)
                            end
                        when sDo then
                            if tail then
                                vector.append(:Tail sc.tails tuple let body = b let index = k let withReturn = okNext end)
                            end
                        else ok
                    end
                end
                case st
                    when sIf with x then begin scan(f sc x.thenBody allowed tail) scan(f sc x.elseBody allowed tail) end
                    when sSwitch with x then
                        begin
                            for j = 0 upto {extent x.cases - 1} do scan(f sc x.cases[j].body allowed tail) end
                            if maybe.isSome(:Body x.elseBody) then scan(f sc maybe.unwrap(:Body x.elseBody) allowed tail) end
                        end
                    when sInspect with x then
                        begin
                            for j = 0 upto {extent x.cases - 1} do scan(f sc x.cases[j].body allowed tail) end
                            if maybe.isSome(:Body x.elseBody) then scan(f sc maybe.unwrap(:Body x.elseBody) allowed tail) end
                        end
                    when sJoin with x then begin scan(f sc x.continuation allowed tail) scan(f sc x.body allowed tail) end
                    (* Falling off a loop's body repeats it; a try's body is its
                     * region, which holds the calls in it *)
                    when sTry with x then begin scan(f sc x.body false false) scan(f sc x.handler allowed false) end
                    when sLoop, sLetRec then
                        let inner = walk.statementBodies(st)
                        for j = 0 upto {extent inner - 1} do scan(f sc inner[j] allowed false) end
                    else ok
                end
            end
        end

    (* ======================================================================
     * The transformation
     * ====================================================================== *)

    (* Replaces, in place, the returns of a body of f's (not of its
     * functions') by jumps to label *)
    let rec jumps(b: Body label: String): Ok =
        for i = 0 upto {vector.length(:Stmt b.statements) - 1} do
            let s = vector.get(:Stmt b.statements i)
            case s
                when sReturn with x then
                    vector.set(:Stmt b.statements i option sJump of Stmt with
                        let var pos = x.pos let label = label let var args = array of x.value end
                    end)
                else
                    let inner = walk.statementBodies(s)
                    for k = 0 upto {extent inner - 1} do jumps(inner[k] label) end
            end
        end

    let transform(f: nodes.Function funs: nodes.StmtFuns site: Site tails: vector.T(Tail) labels: clone.Labels): Ok =
        begin
            labels.count := labels.count + 1
            let loopLabel = "contified" <> conv.int(labels.count)
            labels.count := labels.count + 1
            let joinLabel = "contified" <> conv.int(labels.count)
            let st = vector.get(:Stmt site.body.statements site.index)
            let call = callIn(st)
            let result = case st when sLet with x then x.v else nodes.newVar("r" f.resultType false) end
            let vars = array of(extent f.params f.v)
            for i = 0 upto {extent f.params - 1} do
                let p = f.params[i].v
                vars[i] := nodes.newVar(p.hint p.type true)
            end
            (* Each tail call assigns the parameters' variables and repeats *)
            for t = 0 upto {vector.length(:Tail tails) - 1} do
                let tail = vector.get(:Tail tails t)
                let tailCall = vector.get(:Stmt tail.body.statements tail.index)
                let c = callIn(tailCall)
                let kept = vector.new(:Stmt)
                for i = 0 upto {tail.index - 1} do vector.append(:Stmt kept vector.get(:Stmt tail.body.statements i)) end
                for i = 0 upto {extent vars - 1} do
                    vector.append(:Stmt kept option sAssign of Stmt with
                        let var pos = nodes.stmtPos(tailCall) let var v = vars[i] let var value = c.args[i]
                    end)
                end
                vector.append(:Stmt kept option sContinue of Stmt with
                    let var pos = nodes.stmtPos(tailCall) let label = loopLabel
                end)
                tail.body.statements := kept
            end
            jumps(f.body joinLabel)
            let iteration = vector.new(:Stmt)
            for i = 0 upto {extent vars - 1} do
                vector.append(:Stmt iteration nodes.letStmt(f.params[i].v nodes.opOfVar(vars[i])))
            end
            for i = 0 upto {vector.length(:Stmt f.body.statements) - 1} do
                vector.append(:Stmt iteration vector.get(:Stmt f.body.statements i))
            end
            let inner = vector.new(:Stmt)
            for i = 0 upto {extent vars - 1} do
                vector.append(:Stmt inner option sVarDecl of Stmt with
                    let var pos = nodes.stmtPos(st) let var v = vars[i] let var init = maybe.some(:Atom call.args[i])
                end)
            end
            vector.append(:Stmt inner option sLoop of Stmt with
                let label = loopLabel
                let var body = nodes.bodyOf(vector.toArray(:Stmt iteration))
            end)
            let rest = vector.new(:Stmt)
            for i = site.index + 1 upto {vector.length(:Stmt site.body.statements) - 1} do
                vector.append(:Stmt rest vector.get(:Stmt site.body.statements i))
            end
            let before = vector.new(:Stmt)
            for i = 0 upto {site.index - 1} do vector.append(:Stmt before vector.get(:Stmt site.body.statements i)) end
            vector.append(:Stmt before option sJoin of Stmt with
                let label = joinLabel
                let var params = array of result end
                let var continuation = nodes.bodyOf(vector.toArray(:Stmt rest))
                let var body = nodes.bodyOf(vector.toArray(:Stmt inner))
            end)
            site.body.statements := before
            (* The function is the loop now, and its funs statement binds the
             * others (the simplifier removes one that binds none) *)
            let others = vector.new(:nodes.Function)
            for i = 0 upto {extent funs.functions - 1} do
                if not(nodes.same(funs.functions[i].v f.v)) then vector.append(:nodes.Function others funs.functions[i]) end
            end
            funs.functions := vector.toArray(:nodes.Function others)
        end

    (* Contifies one function, if one can be: whether it did *)
    let contifyOne(all: Array(Body) recursive: hashMap.T(Int Bool) pinned: hashMap.T(Int Bool) labels: clone.Labels)
        : Bool =
        begin
            let u = tuple
                let functions = vector.new(:nodes.Function)
                let funs = hashMap.new(:Int :nodes.StmtFuns intEqual hash.int)
                let uses = hashMap.new(:Int :Int intEqual hash.int)
                let sites = hashMap.new(:Int :vector.T(Site) intEqual hash.int)
            end
            for b = 0 upto {extent all - 1} do gather(u all[b]) end
            let var done = false
            for i = 0 upto {vector.length(:nodes.Function u.functions) - 1} do
                let f = vector.get(:nodes.Function u.functions i)
                let var values = extent f.typeParams is 0
                for k = 0 upto {extent f.params - 1} do
                    if not(stringOp.equal(f.params[k].mode "value")) then values := false end
                end
                let sites = maybe.unwrapOr(:vector.T(Site) hashMap.get(:Int :vector.T(Site) u.sites f.v.id) vector.new(:Site))
                let uses = maybe.unwrapOr(:Int hashMap.get(:Int :Int u.uses f.v.id) 0)
                if not(done) andif values andif not(hashMap.contains(:Int :Bool pinned f.v.id))
                    andif {uses is vector.length(:Site sites)} andif {uses > 0} then
                    let sc = tuple let tails = vector.new(:Tail) let var calls = 0 end
                    scan(f sc f.body true false)
                    let inside = hashMap.new(:Int :Bool intEqual hash.int)
                    bodyIds(f.body inside)
                    let outside = vector.new(:Site)
                    for k = 0 upto {vector.length(:Site sites) - 1} do
                        let s = vector.get(:Site sites k)
                        if not(hashMap.contains(:Int :Bool inside s.body.id)) then vector.append(:Site outside s) end
                    end
                    (* A function that never calls itself and is not
                     * recursive through others is left to the inliner: as a
                     * loop at a module's top level, its bindings would be the
                     * loop's, not the module's, and its functions would
                     * capture them *)
                    let loops = {sc.calls > 0}
                        orif maybe.unwrapOr(:Bool hashMap.get(:Int :Bool recursive f.v.id) false)
                    if {vector.length(:Site outside) is 1} andif {vector.length(:Tail sc.tails) is sc.calls}
                        andif loops andif {{sc.calls + 1} is uses} then
                        transform(f hashMap.find(:Int :nodes.StmtFuns u.funs f.v.id) vector.get(:Site outside 0) sc.tails labels)
                        done := true
                    end
                end
            end
            done
        end

    let contify(all: Array(Body) recursive: hashMap.T(Int Bool) pinned: hashMap.T(Int Bool) labels: clone.Labels)
        : Bool =
        begin
            let var any = false
            let var more = true
            let var n = 0
            while more andif {n < maxContified} do
                more := contifyOne(all recursive pinned labels)
                if more then any := true end
                n := n + 1
            end
            any
        end
end
