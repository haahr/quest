(* Quest Self-Hosted Compiler: The IR's Core Invariants Interface
 *
 * Checks the structural invariants preserved by every stage of the IR
 * (docs/ir.md section 9): A-Normal Form (every operand is an atom), single
 * binding and lexical scoping for variables, valid targets for jumps, breaks,
 * and continues, and stage-appropriate operations. The ir/verify module adds
 * stage-specific checks and runs the full verifier. Counterpart:
 * bootstrap/python/quest/ir/verify_core.py. *)

interface VerifyCore
import
    collections/vector : collections/Vector
    util/maybe : util/Maybe

    questlang/common/maps : questlang/common/Maps
    questlang/ir/nodes : questlang/ir/Nodes
export
    Def Ids = maps.IntMap(Bool)
    (* A join point in scope: its label and the number of values a jump to it
     * passes *)
    Def JoinPoint = Tuple label: String arity: Int end
    (* What the checks find: the problems so far, the variables bound so far,
     * and what the unit defines *)
    Def Verifier = Tuple
        problems: vector.T(String)
        bound: Ids
        (* Ids of modules defined or imported by the unit, for checking module
         * references *)
        modules: Ids
        (* After closure conversion, the unit's function ids, which closures
         * must target *)
        var functions: maybe.T(Ids)
        (* Whether the unit is past the represent pass, before which no
         * operation may be a convert *)
        var represented: Bool
    end
    (* Lexical scope at the current verification point: variables, join points,
     * loops, and enclosing-function state. Whereas the bootstrap verifier uses
     * immutable scopes extended per statement, this verifier mutates one scope
     * in place, undoing body-local bindings via logs when a body ends and
     * saving/restoring the other fields around each function. *)
    Def Scope = Tuple
        vars: Ids
        var joins: vector.T(JoinPoint)
        var loops: vector.T(String)
        var inFunction: Bool
        (* Mutable variables of enclosing functions, which a nested function
         * must not use *)
        var outerMutables: Ids
        (* Mutable variables of the current function (or top level), and whether
         * this is a top level *)
        var localMutables: Ids
        var topLevel: Bool
        (* The variables added in each body being checked, removed when it
         * ends *)
        logs: vector.T(vector.T(nodes.Variable))
    end
    newIds(): Ids
    newScope(vars: Ids): Scope
    copyIds(ids: Ids): Ids
    (* Adds a problem, text, to those found *)
    problem(v: Verifier text: String): Ok
    (* Notes that x is bound (in where, as problems name it), a problem if it
     * was bound before *)
    bind(v: Verifier x: nodes.Variable where: String): Ok
    (* The checks of o: that it may occur at the unit's stage, refers only to
     * the unit's modules and imports, and uses only variables in scope *)
    operation(v: Verifier o: nodes.Op scope: Scope where: String): Ok
    (* The checks of f and its body, in scope with f's parameters and
     * environment: the enclosing join points and loops are out of scope in
     * it, and the enclosing functions' mutable variables may not be used *)
    function(v: Verifier f: nodes.Function scope: Scope): Ok
    (* The checks of b's statements; what b binds leaves scope at its end *)
    body(v: Verifier b: nodes.Body scope: Scope where: String): Ok
end
