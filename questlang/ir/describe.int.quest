(* Quest Self-Hosted Compiler: The Describe Pass Interface
 *
 * Mirrors bootstrap/python/quest/ir/describe.py (docs/ir.md sections 7 and
 * 8.4). This pass runs after represent and makes run-time type information
 * explicit, producing the described stage. Every run-time use of a type gets a
 * descriptor operand (a run-time representation of a type): a type parameter in
 * scope uses its descriptor variable, a closed type uses a static descriptor,
 * and a type mentioning type parameters in scope uses a template with a hole
 * for each parameter, instantiated with their descriptors. The pass also
 * collects the unit's static data (static descriptors, record offset tables,
 * variant tag maps, and the types whose aggregate structs a backend declares)
 * and registers each module's abstract types. *)

interface Describe
import
    questlang/types/model : questlang/types/Model
    questlang/ir/nodes : questlang/ir/Nodes
export
    (* Raised when the pass cannot build a descriptor, such as inside a
     * generated adapter thunk for a type that mentions an enclosing function's
     * type parameter whose descriptor the thunk does not receive *)
    unsupportedDescriptor: Exception(String)

    (* How echo writes a value of type t without a descriptor: "Word", "fun",
     * "hidden", or a base type's name; "" if it writes it by a descriptor of
     * its type *)
    echoValueKind(t: model.Type): String
    (* The type variables (and abstract types) occurring free in t for which
     * wanted(symbolId) holds, in order of appearance *)
    freeTypeVars(t: model.Type wanted: All(symbolId: Int) Bool): Array(model.Type)
    (* The types a unit's C declares the aggregates of, in the order first
     * met *)
    unitTypes(unit: nodes.Unit): Array(model.Type)
    (* Gives the unit's run-time uses of types their descriptors, in place,
     * returning it *)
    describeUnit(unit: nodes.Unit): nodes.Unit
end
