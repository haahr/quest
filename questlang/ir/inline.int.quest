(* Quest Self-Hosted Compiler: The Inliner Interface
 *
 * What the simplifier needs to inline calls (docs/ir.md section
 * 8.6): the functions funs statements bind, their strongly connected components
 * in the graph of which functions name which, and their sizes; and a call's
 * expansion, the callee's body copied in its place, with fresh variables and
 * labels. Which calls to inline is the simplifier's decision. *)

interface Inline
import
    questlang/types/model : questlang/types/Model
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/clone : questlang/ir/Clone
    collections/hashMap : collections/HashMap
    util/maybe : util/Maybe
export
    Def Analysis = Tuple
        (* The functions funs statements bind, by their variables' ids *)
        functions: hashMap.T(Int nodes.Function)
        (* Each function's strongly connected component, by its variable's id:
         * functions that name one another, directly or not, share one *)
        components: hashMap.T(Int Int)
        (* Whether each function names itself, directly or not *)
        recursive: hashMap.T(Int Bool)
        (* Whether each function names no variable it does not bind itself
         * (none of its module's, for one), so that it can be copied anywhere *)
        closed: hashMap.T(Int Bool)
        (* The variables each function names and does not bind, in the order
         * first named: those of its module's, for one, or of the functions
         * that enclose it *)
        free: hashMap.T(Int Array(nodes.Variable))
        (* Whether each function calls an external function at type arguments
         * (passing and returning their values as QVal words, which a call at
         * other type arguments would not box) *)
        callsExternalAtTypes: hashMap.T(Int Bool)
        (* Each function's static parameters, by its variable's id, for one
         * recursive through itself alone: whether each value parameter is
         * passed unchanged by every call the function makes of itself, at its
         * own type parameters, and the function names itself only in such
         * calls (none for any other function, or one with none) *)
        static: hashMap.T(Int Array(Bool))
        (* Each function's size *)
        sizes: hashMap.T(Int Int)
        (* The size of the unit's bodies and functions *)
        size: Int
    end

    (* The functions of a unit's bodies, as they are *)
    analyze(bodies: Array(nodes.Body)): Analysis

    (* A body's size: its statements, with those in the bodies and functions it
     * holds, a call counting twice *)
    size(b: nodes.Body): Int

    (* A variable f names and does not bind, and what the copy reads in its
     * place (a module's member, for one of its module's variables named from
     * outside the module) *)
    Def Read = Tuple v: nodes.Variable op: nodes.Op end

    (* The statements that do what a call of f does and then what rest does:
     * the call's result bound to into (or to a fresh variable), f's body
     * copied with its type parameters substituted by typeArgs, fresh variables
     * and labels, each value parameter bound to its argument, each var or out
     * parameter replaced by the variable whose address is passed for it
     * (byRef), and each variable reads names bound first to what it reads. A
     * body whose only return is its last statement is followed by rest; any
     * other is a join point's body, whose returns jump to it, and whose
     * continuation is rest. The parameters' bindings, the reads', and the
     * result's are at the call's position, pos; the body keeps its own. *)
    expand(f: nodes.Function typeArgs: Array(model.Type) args: Array(nodes.Atom)
        byRef: Array(maybe.T(nodes.Variable)) reads: Array(Read) into: maybe.T(nodes.Variable) pos: Int
        rest: Array(nodes.Stmt) labels: clone.Labels): Array(nodes.Stmt)
    (* The statements that do what a call of f, a function with static
     * parameters, does and then what rest does, with f specialized to the
     * call's arguments for them (docs/ir.md section 8.6): a funs statement
     * binding a local function of f's other parameters, whose body is f's
     * copied with its type parameters substituted by typeArgs, each static
     * parameter replaced by its argument (a variable), each call of f a call
     * of the local function on the other arguments, and each variable reads
     * names bound first to what it reads; then the call's result bound to
     * into (or to a fresh variable) by a call of the local function on the
     * call's other arguments; then rest. *)
    specialize(f: nodes.Function static: Array(Bool) typeArgs: Array(model.Type) args: Array(nodes.Atom)
        reads: Array(Read) into: maybe.T(nodes.Variable) pos: Int rest: Array(nodes.Stmt) labels: clone.Labels)
        : Array(nodes.Stmt)
end
