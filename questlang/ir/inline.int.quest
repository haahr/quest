(* Quest Self-Hosted Compiler: The Inliner Interface
 *
 * This module provides the analysis and code-cloning operations that the
 * simplifier uses to inline and specialize calls (docs/ir.md section 8.6).
 * Analysis collects all functions bound by funs statements, groups mutually
 * recursive functions into strongly connected components, detects static
 * parameters on self-recursive functions, and computes function sizes.
 * Expansion and specialization clone a callee's body with fresh variables and
 * labels; deciding which calls to inline belongs to the simplifier. *)

interface Inline
import
    questlang/types/model : questlang/types/Model
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/clone : questlang/ir/Clone
    collections/hashMap : collections/HashMap
    util/maybe : util/Maybe
export
    Def Analysis = Tuple
        (* The functions funs statements bind, by their variables' ids *)
        functions: hashMap.T(Int nodes.Function)
        (* Each function's strongly connected component, by its variable's id:
         * functions that name one another, directly or not, share one *)
        components: hashMap.T(Int Int)
        (* Whether each function names itself, directly or not *)
        recursive: hashMap.T(Int Bool)
        (* Whether each function calls an external function with type arguments
         * (external calls pass polymorphic values as uniform QVal words, which
         * a call specialized to concrete types would not box) *)
        callsExternalAtTypes: hashMap.T(Int Bool)
        (* For each self-recursive function (not mutually recursive) with at
         * least one static parameter, a boolean mask over its parameters by
         * variable id. A value parameter is static if every recursive call
         * passes it unchanged at the function's own type parameters, and the
         * function is never referenced except as the callee of such calls. *)
        static: hashMap.T(Int Array(Bool))
        (* Each function's size *)
        sizes: hashMap.T(Int Int)
        (* The size of the unit's bodies and functions *)
        size: Int
    end

    (* Analyzes all functions bound in bodies as they currently stand *)
    analyze(bodies: Array(nodes.Body)): Analysis

    (* A body's statement count, including nested bodies and functions, with
     * each call weighted by callSize (2) *)
    size(b: nodes.Body): Int
    callSize: Int

    (* A variable f names and does not bind, and what the copy reads in its
     * place (a module's member, for one of its module's variables named from
     * outside the module) *)
    Def Read = Tuple v: nodes.Variable op: nodes.Op end

    (* Returns the free variables of f in first-use order (such as module
     * variables or variables from enclosing functions). Inspects f's current
     * body rather than cached analysis, because earlier inlining in the same
     * round may have introduced new free variables. *)
    freeVariables(f: nodes.Function): Array(nodes.Variable)

    (* Expands a call to f followed by rest, binding the result to into (or a
     * fresh variable). Clones f's body with typeArgs substituted for its type
     * parameters and with fresh variables and labels: value parameters are
     * bound to args, var/out parameters are replaced by the variables in
     * byRef, and free variables listed in reads are bound first to their
     * replacement operations. If f's only return is its final statement, rest
     * follows inline; otherwise f's body is wrapped in a join point (a labeled
     * merge block whose continuation is rest) and each return becomes a jump
     * to it. Bindings for parameters, reads, and the result take source
     * position pos; cloned body statements keep their own. *)
    expand(f: nodes.Function typeArgs: Array(model.Type) args: Array(nodes.Atom)
        byRef: Array(maybe.T(nodes.Variable)) reads: Array(Read) into: maybe.T(nodes.Variable) pos: Int
        rest: Array(nodes.Stmt) labels: clone.Labels): Array(nodes.Stmt)
    (* Specializes a self-recursive function f to the call's arguments for its
     * static parameters, followed by rest (docs/ir.md section 8.6). Emits
     * bindings for reads (and any constant static arguments), then a recursive
     * funs statement defining a local function over only f's non-static
     * parameters, with typeArgs substituted, static parameters replaced by
     * their call-site arguments, and recursive calls rewritten to target the
     * local function. Finally binds into (or a fresh variable) to a call to
     * the local function on the remaining arguments, followed by rest. *)
    specialize(f: nodes.Function static: Array(Bool) typeArgs: Array(model.Type) args: Array(nodes.Atom)
        reads: Array(Read) into: maybe.T(nodes.Variable) pos: Int rest: Array(nodes.Stmt) labels: clone.Labels)
        : Array(nodes.Stmt)
end
