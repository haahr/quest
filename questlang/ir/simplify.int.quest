(* Quest Self-Hosted Compiler: The Simplifier Interface
 *
 * The Core IR simplified (docs/ir.md section 8.6), the simplified stage:
 * copies of variables propagated, lets and funs nothing reads removed when
 * they cannot raise, constants folded, an if on a constant replaced by its
 * branch, a switch on an option or variant made in scope replaced by its case,
 * and the tag tests, payloads, and projections of the options, variants, and
 * tuples (but their var components) made in scope replaced by what made them;
 * in rounds, to a bound. The self-hosted compiler's alone: the bootstrap has
 * no such stage. *)

interface Simplify
import
    questlang/ir/nodes : questlang/ir/Nodes
export
    (* Simplifies the unit's bodies, in place, returning it *)
    simplifyUnit(unit: nodes.Unit): nodes.Unit
    (* Whether evaluating an operation can do nothing but compute its value:
     * no effect, no exception *)
    pure(o: nodes.Op): Bool
end
