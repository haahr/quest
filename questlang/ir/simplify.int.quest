(* Quest Self-Hosted Compiler: The Simplifier Interface
 *
 * Optimizes the Core IR into the simplified stage (docs/ir.md section 8.6),
 * before specialization and closure conversion, while nested functions are
 * still funs statements with free variables. This pass exists only in the
 * self-hosted compiler; the bootstrap compiler has no simplified stage.
 *
 * The simplifier runs in rounds (at most 6 by default) until a round makes no
 * changes. Each round propagates variable copies and constants, folds constant
 * expressions and branches, eliminates unused pure let and funs bindings,
 * simplifies switches, tag tests, payloads, and immutable tuple projections on
 * values constructed in scope, decides tag tests, payloads, and switches on a
 * variable inside the then-branch of an if that tests its tag (and reuses an
 * earlier read of an unchanged tuple component), and inlines eligible calls
 * (questlang/ir/inline) that are small or called once within a growth budget.
 * Each round then runs contification (questlang/ir/contify), which converts
 * local functions called from one site (plus their own tail calls) into loops
 * at that site, letting later rounds simplify the result. The QUEST_INLINE
 * environment variable overrides the default bounds and thresholds for
 * measurement (docs/inlining.md section 1). *)

interface Simplify
import
    questlang/ir/nodes : questlang/ir/Nodes
export
    (* The optimizer's setting name: default, or the integer QUEST_INLINE
     * gives it (a list of name=value separated by commas; docs/inlining.md
     * section 1) *)
    setting(name: String default: Int): Int
    (* The largest function inlined at a call that gives it type arguments,
     * before the bonuses its arguments earn: the size threshold and the
     * polymorphic bonus *)
    polymorphicInlineSize: Int
    (* Simplifies the unit's bodies, in place, returning it *)
    simplifyUnit(unit: nodes.Unit): nodes.Unit
    (* Whether evaluating an operation can do nothing but compute its value:
     * no effect, no exception *)
    pure(o: nodes.Op): Bool
end
