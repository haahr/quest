(* Quest Self-Hosted Compiler: Whole-Program Units Interface
 *
 * A program's Core IR unit with every module it imports, and every module
 * those import, merged into it (docs/build-process.md section 1.2, the
 * self-hosted compiler's --whole-program; docs/arm64.md section 3.12):
 * each module lowered from its typed module as a module file is, then its
 * module and functions moved into the program's unit, dependencies first, and
 * every reference to it made a reference to the module the unit now defines.
 * The passes and every backend then see one unit. *)
interface Whole
import
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/types/env : questlang/types/Env
export
    (* unit, a program's, with the modules it imports merged into it; raises
     * lower.loweringError if one is known only through its interface (a
     * precompiled module, whose source the build does not have) *)
    mergeImports(unit: nodes.Unit e: env.T): nodes.Unit
    (* unit, a whole program's, with only the members of its modules that its
     * code can reach: from its main body, and from what its modules'
     * initializers do other than bind a member to a pure operation or a
     * function, through the variables each uses and the members it names.
     * The others' bindings are deleted, and they leave their modules' members
     * and exports, and a module
     * whose record nothing reads (as a value, member reads being of the
     * members' variables) is left without one (docs/ir.md section 8.6) *)
    dropUnreachable(unit: nodes.Unit): nodes.Unit
end
