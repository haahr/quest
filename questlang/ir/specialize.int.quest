(* Quest Self-Hosted Compiler: Specialization Interface
 *
 * Mirrors bootstrap/python/quest/ir/specialize.py (docs/ir.md section 8.1).
 * This pass clones polymorphic functions for calls whose type arguments call
 * for specialization. A call of a function bound by a funs statement, with
 * type arguments for all of its type parameters, is specialized when the
 * arguments are closed and the selective trigger holds (shouldSpecialize). The
 * clone is the function with its type parameters substituted and fresh
 * binders, bound by the same funs statement as the original; a clone of a
 * module's function is also a member of the module. Clones are specialized in
 * turn, and specializations are shared by function and type arguments. The
 * bootstrap's clone copies nodes by reflection; this one copies them with
 * ir/clone, which lists each node's fields. *)

interface Specialize
import
    questlang/ir/nodes : questlang/ir/Nodes
export
    (* Specializes the unit's calls in place, returning it *)
    specializeUnit(unit: nodes.Unit): nodes.Unit
end
