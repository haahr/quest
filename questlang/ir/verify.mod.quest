(* Quest Self-Hosted Compiler: The IR Verifier Implementation *)

module verify : Verify
import
    conv : Conv
    stringOp = string : StringOp
    system : System

    collections/hashMap : collections/HashMap
    collections/hashSet : collections/HashSet
    collections/vector : collections/Vector
    util/maybe : util/Maybe
    util/strutil : util/Strutil

    questlang/common/maps : questlang/common/Maps
    questlang/ir/describe : questlang/ir/Describe
    questlang/ir/nodes : questlang/ir/Nodes
    questlang/ir/stages : questlang/ir/Stages
    questlang/ir/verifyCore : questlang/ir/VerifyCore
    questlang/ir/walk : questlang/ir/Walk
    questlang/repr/layout : questlang/repr/Layout
    questlang/repr/shapes : questlang/repr/Shapes
    questlang/repr/written : questlang/repr/Written
    questlang/types/model : questlang/types/Model
export
    Let Variable = nodes.Variable
    Let Atom = nodes.Atom
    Let Body = nodes.Body
    Let Stmt = nodes.Stmt
    Let Op = nodes.Op

    let eq(a: String b: String): Bool = stringOp.equal(a b)

    let irChecksEnabled(): Bool = eq(system.getEnv("QUEST_CHECK_IR") "1")

    (* The scopes and the core invariants are questlang/ir/verifyCore's; this
     * module adds the represented and described stages' checks *)

    (* =========================================================================
     * Representations (after the represent pass)
     *
     * Checks that every value is used in the representation its use requires.
     * A value's representation comes from its type, or from its slot
     * representation when boxed (a boxed mutable variable reads as its value
     * and is assigned its box); aggregate slots require records and variants to
     * be boxed unless embedded in the aggregate's own allocation.
     * ====================================================================== *)

    (* A value of type t's C type, or none for Ok *)
    let rep(t: model.Type): maybe.T(String) =
        if shapes.kindIs(shapes.shape(t) shapes.shapeOk) then maybe.none() else maybe.some(layout.cType(t)) end

    (* Whether a is a boxed variable read as its box *)
    let isBox(a: Atom): Bool = case a when atomVar with x then x.v.boxed andif not(x.v.isMutable) else false end

    (* The C type a is used in: its slot's if it is a box *)
    let have(a: Atom): maybe.T(String) =
        if isBox(a) then maybe.some(layout.slotCType(nodes.atomType(a))) else rep(nodes.atomType(a)) end

    (* The C type a variable is assigned in *)
    let target(v: Variable): maybe.T(String) = if v.boxed then maybe.some(layout.slotCType(v.type)) else rep(v.type) end

    (* A problem if a is used as want, a C type other than its own *)
    let expect(problems: vector.T(String) a: Atom want: maybe.T(String) where: String): Ok =
        begin
            let had = have(a)
            if maybe.isSome(had) andif maybe.isSome(want) andif not(eq(maybe.unwrap(had) maybe.unwrap(want))) then
                vector.append(problems where <> ": a " <> maybe.unwrap(had) <> " used as a " <> maybe.unwrap(want))
            end
        end

    (* A problem if a, stored into a slot of shape s (embedded: boxed in the
     * aggregate's allocation), is boxed where the slot takes a value or not
     * where it takes a box *)
    let slot(problems: vector.T(String) a: Atom s: maybe.T(shapes.Shape) where: String embedded: Bool): Ok =
        if maybe.isSome(s) andif not(shapes.kindIs(maybe.unwrap(s) shapes.shapeOk)) then
            let boxedIn = layout.isBoxedInSlots(maybe.unwrap(s))
            if boxedIn andif not(embedded) andif not(isBox(a)) then
                vector.append(problems where <> ": a record or variant stored into a slot unboxed")
            elsif {not(boxedIn) orif embedded} andif isBox(a) then
                vector.append(problems where <> ": a box stored into a slot that does not take one")
            end
        end

    (* The shape of what an address a stores into *)
    let located(a: Atom): shapes.Shape =
        begin
            let s = shapes.shape(nodes.atomType(a))
            if shapes.kindIs(s shapes.shapeCell) orif shapes.kindIs(s shapes.shapeOut) then shapes.element(s) else s end
        end

    (* The problems of a call's arguments and result *)
    let checkCall(problems: vector.T(String) c: nodes.OpCall result: maybe.T(Variable) where: String): Ok =
        begin
            let ct = nodes.calleeType(c.callee c.moduleRef c.member c.calleeType)
            let signature = written.funSignature(maybe.unwrapOr(ct model.okType))
            for i = 0 upto {extent c.args - 1} do
                if i < extent signature.params then
                    let p = signature.params[i]
                    if not(p.isVar orif p.isOut) then
                        expect(problems c.args[i] rep(p.type) where <> ": an argument of " <> p.name)
                    end
                end
            end
            if maybe.isSome(result) then
                expect(problems nodes.atomOfVar(maybe.unwrap(result)) rep(signature.result) where
                    <> ": the result of a call")
            end
        end

    (* The problems of a let's value, of v *)
    let letValue(problems: vector.T(String) v: Variable value: Op where: String): Ok =
        case value
            when opAtom with y then expect(problems y.atom target(v) where <> ": let " <> v.hint)
            when opCall with c then checkCall(problems c maybe.some(v) where)
            when opMakeTuple with y then
                let components = shapes.shape(v.type).components
                for i = 0 upto {extent y.args - 1} do
                    if i < extent components then
                        slot(problems y.args[i] components[i].shape where <> ": component " <> conv.int(i) <> " of "
                            <> v.hint maps.intIsOneOf(i y.embedded))
                    end
                end
            when opMakeRecord with y then
                for i = 0 upto {extent y.fields - 1} do
                    let fa = y.fields[i]
                    slot(problems fa.atom maybe.some(shapes.shape(nodes.atomType(fa.atom)))
                            where <> ": field " <> fa.name <> " of " <> v.hint maps.intIsOneOf(i y.embedded))
                end
            when opMakeArray with y then
                for i = 0 upto {extent y.args - 1} do
                    slot(problems y.args[i] shapes.shape(v.type).elementShape where <> ": an element of " <> v.hint
                            false)
                end
            when opArrayRep with y then
                slot(problems y.init shapes.shape(v.type).elementShape where <> ": the element of " <> v.hint false)
            when opAddrCell with y then
                slot(problems y.init maybe.some(shapes.shape(nodes.atomType(y.init))) where <> ": a cell" false)
            when opMakeVariant with y then
                if maybe.isSome(y.payload) then
                    let vs = layout.resolvedShape(shapes.shape(v.type))
                    let c = if shapes.kindIs(vs shapes.shapeVariant) then shapes.caseOf(vs y.tag)
                        else maybe.none(:shapes.Component) end
                    slot(problems maybe.unwrap(y.payload)
                            if maybe.isSome(c) then maybe.unwrap(c).shape else maybe.none() end
                            where <> ": the payload of " <> v.hint false)
                end
            else ok
        end

    (* The problems of a statement s of function (none for a top level's), but
     * its jumps'; a join point's parameters go in joins, for its jumps *)
    let representationStatement(problems: vector.T(String) s: Stmt function: maybe.T(nodes.Function) where: String
            joins: maps.StringMap(Array(Variable))): Ok =
        begin
            let binders = walk.statementBinders(s)
            for i = 0 upto {extent binders - 1} do
                let b = binders[i]
                if b.boxed andif not(layout.isBoxedInSlots(shapes.shape(b.type))) then
                    vector.append(problems where <> ": variable '" <> b.hint
                        <> "' is boxed, but not of a record or variant type")
                end
            end
            case s
                when sJoin with x then
                    begin hashMap.insert(joins x.label x.params) ok end
                when sLet with x then letValue(problems x.v x.value where)
                when sDo with x then
                    case x.value
                        when opCall with c then checkCall(problems c maybe.none() where)
                        else ok
                    end
                when sRaise with x then
                    if maybe.isSome(x.payload) then
                        let es = shapes.shape(nodes.atomType(x.exc))
                        let payloadShape = if shapes.kindIs(es shapes.shapeException) then es.elementShape
                            else maybe.none(:shapes.Shape) end
                        slot(problems maybe.unwrap(x.payload) payloadShape where <> ": a raised payload" false)
                    end
                when sEcho with x then
                    slot(problems x.value maybe.some(shapes.shape(x.type)) where <> ": an echoed value" false)
                when sStoreAt with x then
                    slot(problems x.value maybe.some(located(x.address)) where <> ": a store" false)
                when sStoreComponent with x then
                    slot(problems x.value
                            layout.resolvedShape(shapes.shape(nodes.atomType(x.base))).components[x.index].shape
                            where <> ": a store" false)
                when sStoreElement with x then
                    slot(problems x.value shapes.shape(nodes.atomType(x.base)).elementShape where <> ": a store" false)
                when sVarDecl with x then
                    if maybe.isSome(x.init) then
                        expect(problems maybe.unwrap(x.init) target(x.v) where <> ": var " <> x.v.hint)
                    end
                when sAssign with x then expect(problems x.value target(x.v) where <> ": " <> x.v.hint <> " :=")
                when sReturn with x then
                    if maybe.isSome(function) then
                        expect(problems x.value rep(maybe.unwrap(function).resultType) where <> ": return")
                    end
                else ok
            end
        end

    (* The problems of a body of function (none for a top level's): its
     * statements', and then its jumps', whose join points it binds *)
    let representationBody(problems: vector.T(String) b: Body function: maybe.T(nodes.Function)): Ok =
        begin
            let where = if maybe.isSome(function) then "function '" <> maybe.unwrap(function).v.hint <> "'"
                else "a top level" end
            let joins = maps.newStringMap(:Array(Variable))
            let stmts = walk.walkStatements(b false)
            for si = 0 upto {vector.length(stmts) - 1} do
                representationStatement(problems vector.get(stmts si) function where joins)
            end
            for si = 0 upto {vector.length(stmts) - 1} do
                case vector.get(stmts si)
                    when sJump with x then
                        let params = hashMap.get(joins x.label)
                        if maybe.isSome(params) then
                            let ps = maybe.unwrap(params)
                            for i = 0 upto {extent x.args - 1} do
                                if i < extent ps then
                                    expect(problems x.args[i] target(ps[i]) where <> ": jump " <> x.label)
                                end
                            end
                        end
                    else ok
                end
            end
        end

    let representationProblems(unit: nodes.Unit): vector.T(String) =
        begin
            let problems = vector.new(:String)
            for i = 0 upto {vector.length(unit.modules) - 1} do
                representationBody(problems vector.get(unit.modules i).init maybe.none())
            end
            representationBody(problems unit.main maybe.none())
            for i = 0 upto {vector.length(unit.functions) - 1} do
                let f = vector.get(unit.functions i)
                representationBody(problems f.body maybe.some(f))
            end
            problems
        end

    (* =========================================================================
     * Descriptors (after the describe pass)
     *
     * Checks that no descriptor operand is missing, out of scope, or
     * ill-formed, and that every static descriptor, offset table, and tag map
     * referenced by an operation is listed in the unit's static data.
     * ====================================================================== *)

    (* The descriptor variables in scope, and the symbols of the type parameters
     * a static descriptor must not mention *)
    Let DescriptorScope = Tuple vars: verifyCore.Ids symbols: verifyCore.Ids end

    let withParams(scope: DescriptorScope params: Array(nodes.DescriptorParam)): DescriptorScope =
        begin
            let vars = verifyCore.copyIds(scope.vars)
            let symbols = verifyCore.copyIds(scope.symbols)
            for i = 0 upto {extent params - 1} do
                hashSet.insert(vars params[i].v.id)
                for j = 0 upto {extent params[i].symbols - 1} do hashSet.insert(symbols params[i].symbols[j]) end
            end
            tuple let vars = vars let symbols = symbols end
        end

    (* The descriptor check's state: its problems; the unit's static
     * descriptors (by staticKey), offset tables, and tag maps; the descriptor
     * variables bound so far, each once; and the variables handlers bind
     * exceptions to, whose identity tests need no descriptor *)
    Let DescriptorCheck = Tuple
        problems: vector.T(String)
        staticKeys: maps.StringSet
        offsetTables: verifyCore.Ids
        tagMaps: verifyCore.Ids
        bound: verifyCore.Ids
        handlerVars: verifyCore.Ids
    end

    let staticKey(echo: Bool t: model.Type): String =
        if echo then "e" <> conv.int(t.id) else "s" <> conv.int(shapes.shape(t).id) end

    let problem(c: DescriptorCheck text: String): Ok = vector.append(c.problems text)

    (* Binds descriptor parameters, each once and of the descriptor type *)
    let bindDescriptors(c: DescriptorCheck params: Array(nodes.DescriptorParam) where: String): Ok =
        for i = 0 upto {extent params - 1} do
            let p = params[i]
            if hashSet.contains(c.bound p.v.id) then
                problem(c where <> ": descriptor variable '" <> p.v.hint <> "' is bound more than once")
            end
            hashSet.insert(c.bound p.v.id)
            if not(model.same(p.v.type nodes.descriptorType)) then
                problem(c where <> ": descriptor variable '" <> p.v.hint <> "' is not of the descriptor type")
            end
        end

    (* A problem if t, a static descriptor's type, mentions a type parameter
     * whose descriptor is a variable in scope *)
    let closed(c: DescriptorCheck t: model.Type scope: DescriptorScope where: String): Ok =
        begin
            let mentioned = describe.freeTypeVars(t fun(sid: Int): Bool hashSet.contains(scope.symbols sid))
            if extent mentioned > 0 then
                let names = vector.new(:String)
                for i = 0 upto {extent mentioned - 1} do
                    vector.append(names case mentioned[i].form
                        when typeVariable with x then x.name
                        when typeAbstract with x then x.name
                        else ""
                    end)
                end
                problem(c where <> ": the static descriptor of " <> model.show(t) <> " mentions "
                    <> strutil.join(", " names) <> ", whose descriptor is a variable")
            end
        end

    (* The problems of a descriptor operand: missing, a variable out of scope,
     * or a static descriptor or template not in the unit's static data *)
    let rec descriptor(c: DescriptorCheck d: maybe.T(nodes.Descriptor) scope: DescriptorScope where: String): Ok =
        if maybe.isNone(d) then
            problem(c where <> ": a descriptor operand is missing")
        else
            case maybe.unwrap(d)
                when descVar with x then
                    if not(hashSet.contains(scope.vars x.v.id)) then
                        problem(c where <> ": descriptor variable '" <> x.v.hint <> "' is used outside its scope")
                    end
                when descStatic with x then
                    begin
                        if not(hashSet.contains(c.staticKeys staticKey(x.d.echo x.d.type))) then
                            problem(c where <> ": the static descriptor of " <> model.show(x.d.type)
                                <> " is not in the unit's static data")
                        end
                        closed(c x.d.type scope where)
                    end
                when descInstantiate with x then
                    begin
                        if not(hashSet.contains(c.staticKeys staticKey(false x.template))) then
                            problem(c where <> ": the template " <> model.show(x.template)
                                <> " is not in the unit's static data")
                        end
                        closed(c x.template scope where)
                        for i = 0 upto {extent x.args - 1} do descriptor(c maybe.some(x.args[i]) scope where) end
                    end
            end
        end

    (* The problems of an operation's descriptors for its n type arguments *)
    let descriptorList(c: DescriptorCheck ds: Array(nodes.Descriptor) n: Int scope: DescriptorScope where: String): Ok =
        begin
            if extent ds isnot n then
                problem(c where <> ": " <> conv.int(extent ds) <> " descriptors for " <> conv.int(n)
                    <> " type arguments")
            end
            for i = 0 upto {extent ds - 1} do descriptor(c maybe.some(ds[i]) scope where) end
        end

    (* The problems of a conversion plan: its descriptors, a variant_tags
     * plan's tag map, and an adapt plan's adapter *)
    let rec plan(c: DescriptorCheck p0: maybe.T(nodes.Plan) scope: DescriptorScope where: String): Ok =
        if maybe.isSome(p0) then
            let p = maybe.unwrap(p0)
            let wanted =
                case p.kind
                    when planRecordView then 1
                    when planView, planRuntime then 2
                    when planBox, planUnbox, planVariantTags, planCast, planUnproxy, planSlotBox, planSlotUnbox,
                            planAdapt, planCopy then
                        0
                end
            if extent p.descriptors isnot wanted then
                problem(c where <> ": a " <> nodes.planKindName(p.kind) <> " plan with "
                    <> conv.int(extent p.descriptors) <> " descriptors")
            end
            for i = 0 upto {extent p.descriptors - 1} do descriptor(c maybe.some(p.descriptors[i]) scope where) end
            if nodes.planIs(p nodes.planVariantTags) andif {maybe.isNone(p.tagMap)
                    orif not(hashSet.contains(c.tagMaps maybe.unwrap(p.tagMap).id))} then
                problem(c where <> ": a variant_tags plan whose tag map is not in the unit's static data")
            end
            (* An adapt plan's thunk parameters and fields are its adapter's,
             * a function of the unit (the thunks pass) *)
            if nodes.planIs(p nodes.planAdapt) andif {maybe.isNone(p.thunk)
                    orif {extent p.fields > 0} orif {extent p.writebacks > 0} orif {extent p.thunkParams > 0}} then
                problem(c where <> ": an adapt plan without its adapter")
            end
            for i = 0 upto {extent p.fields - 1} do plan(c p.fields[i] scope where) end
            for i = 0 upto {extent p.writebacks - 1} do plan(c p.writebacks[i] scope where) end
        end

    (* The problems of an operation's descriptors and plans *)
    let operationDescriptors(c: DescriptorCheck o: Op scope: DescriptorScope where: String): Ok =
        case o
            when opCall with x then descriptorList(c x.descriptors extent x.typeArgs scope where)
            when opCallExternal with x then descriptorList(c x.descriptors extent x.typeArgs scope where)
            when opMakeClosure with x then descriptorList(c x.descriptors extent x.typeArgs scope where)
            when opTypeApp with x then
                descriptorList(c x.descriptors extent x.typeArgs scope where)
                (* An instance that is a function is its thunk's closure (the
                 * thunks pass) *)
                if maybe.isSome(x.thunkParams) then
                    problem(c where <> ": a type application whose instance is a function, not its thunk's closure")
                end
                for i = 0 upto {extent x.plans - 1} do plan(c x.plans[i] scope where) end
                for i = 0 upto {extent x.writebacks - 1} do plan(c x.writebacks[i] scope where) end
            when opConvert with x then plan(c maybe.some(x.plan) scope where)
            when opPrim with x then
                if nodes.comparesIdentity(x.op) andif {extent x.args > 0} then
                    let a = x.args[0]
                    let isHandler =
                        case a when atomVar with y then hashSet.contains(c.handlerVars y.v.id) else false end
                    if not(isHandler) andif layout.isQVal(shapes.shape(nodes.atomType(a))) then
                        descriptor(c x.descriptor scope where)
                    end
                end
            when opMakeAuto with x then descriptor(c x.descriptor scope where)
            when opRecordField with x then if x.stored then descriptor(c x.descriptor scope where) end
            when opMakeRecord with x then
                descriptor(c x.descriptor scope where)
                if x.runtimeOffsets then
                    descriptor(c x.viewDescriptor scope where)
                elsif maybe.isNone(x.offsets) orif not(hashSet.contains(c.offsetTables maybe.unwrap(x.offsets).id)) then
                    problem(c where <> ": a record whose offset table is not in the unit's static data")
                end
            else ok
        end

    (* The problems of an inspect of an auto value: its witness, its cases'
     * descriptors, and its arms' components' descriptors and plans *)
    let inspectDescriptors(c: DescriptorCheck x: nodes.StmtInspect scope: DescriptorScope where: String): Ok =
        if maybe.isSome(x.autoType) then
            let armed =
                if maybe.isNone(x.witness) then
                    begin
                        problem(c where <> ": an inspect of an auto value without its witness")
                        scope
                    end
                else
                    let w = array of maybe.unwrap(x.witness) end
                    bindDescriptors(c w where)
                    withParams(scope w)
                end
            for i = 0 upto {extent x.cases - 1} do
                let ic = x.cases[i]
                descriptor(c ic.descriptor scope where)
                if {extent ic.binders > 0} andif maybe.isSome(ic.arm) then
                    let arm = maybe.unwrap(ic.arm)
                    if extent arm.descriptors isnot extent arm.converted then
                        problem(c where <> ": an inspect arm without its components' descriptors")
                    end
                    let n = if extent arm.descriptors < extent arm.converted then extent arm.descriptors
                        else extent arm.converted end
                    for j = 0 upto {n - 1} do
                        let how = arm.converted[j]
                        let pair = arm.descriptors[j]
                        if maybe.isNone(how) isnot maybe.isNone(pair) then
                            problem(c where <> ": an inspect arm's component " <> maybe.unwrapOr(how "None")
                                <> " has descriptors " <> if maybe.isNone(pair) then "None" else "(...)" end)
                        end
                        if maybe.isSome(pair) then
                            descriptor(c maybe.some(maybe.unwrap(pair).source) armed where)
                            descriptor(c maybe.some(maybe.unwrap(pair).target) armed where)
                        end
                    end
                    plan(c arm.plan armed where)
                end
            end
        end

    (* The problems of a body's statements' descriptors, and their bodies' *)
    let rec descriptorBody(c: DescriptorCheck b: Body scope: DescriptorScope where: String): Ok =
        for si = 0 upto {vector.length(b.statements) - 1} do
            let s = vector.get(b.statements si)
            case s
                when sLet with x then operationDescriptors(c x.value scope where)
                when sDo with x then operationDescriptors(c x.value scope where)
                when sTry with x then begin hashSet.insert(c.handlerVars x.exc.id) ok end
                when sEcho with x then if maybe.isSome(x.descriptor) then descriptor(c x.descriptor scope where) end
                when sInspect with x then inspectDescriptors(c x scope where)
                else ok
            end
            let bodies = walk.statementBodies(s)
            for i = 0 upto {extent bodies - 1} do descriptorBody(c bodies[i] scope where) end
        end

    (* The problems of a function's descriptor parameters, which must be its
     * type parameters', of its body, and of its view maps: each of one of
     * its type parameters, and every one its body reads through declared *)
    let functionDescriptors(c: DescriptorCheck f: nodes.Function top: DescriptorScope): Ok =
        begin
            let where = "function '" <> f.v.hint <> "'"
            let var matching = extent f.descriptorParams is extent f.typeParams
            if matching then
                for j = 0 upto {extent f.typeParams - 1} do
                    let syms = f.descriptorParams[j].symbols
                    if {extent syms isnot 1} orif {syms[0] isnot f.typeParams[j].symbolId} then matching := false end
                end
            end
            if not(matching) then problem(c where <> ": its descriptor parameters are not its type parameters'") end
            bindDescriptors(c f.descriptorParams where)
            let inner = withParams(top f.descriptorParams)
            descriptorBody(c f.body inner where)
            let own = verifyCore.newIds()
            for j = 0 upto {extent f.descriptorParams - 1} do hashSet.insert(own f.descriptorParams[j].v.id) end
            let maps = verifyCore.newIds()
            for j = 0 upto {extent f.viewMaps - 1} do
                let m = f.viewMaps[j]
                if not(model.same(m.v.type nodes.viewMapType)) orif not(hashSet.contains(own m.descriptor.id)) then
                    problem(c where <> ": view map " <> m.v.hint <> " is not of one of its type parameters")
                end
                descriptor(c maybe.some(m.bound) inner where)
                hashSet.insert(maps m.v.id)
            end
            let stmts = walk.walkStatements(f.body false)
            for j = 0 upto {vector.length(stmts) - 1} do
                let s = vector.get(stmts j)
                let opMap =
                    case s
                        when sLet with x then walk.opViewMap(x.value)
                        when sDo with x then walk.opViewMap(x.value)
                        else maybe.none(:Variable)
                    end
                let used = array of walk.stmtViewMap(s) opMap end
                for k = 0 upto 1 do
                    if maybe.isSome(used[k]) andif not(hashSet.contains(maps maybe.unwrap(used[k]).id)) then
                        problem(c where <> ": an operation reads through a view map that is not the function's")
                    end
                end
            end
        end

    let staticDescriptor(d: nodes.StaticDescriptor): maybe.T(nodes.Descriptor) =
        maybe.some(option descStatic of nodes.Descriptor with let d = d end)

    let descriptorProblems(unit: nodes.Unit): vector.T(String) =
        begin
            let problems = vector.new(:String)
            if maybe.isNone(unit.staticData) then
                vector.append(problems "the described unit has no static data")
            else
                let data = maybe.unwrap(unit.staticData)
                let c = tuple
                    let problems = problems
                    let staticKeys = maps.newStringSet()
                    let offsetTables = verifyCore.newIds()
                    let tagMaps = verifyCore.newIds()
                    let bound = verifyCore.newIds()
                    let handlerVars = verifyCore.newIds()
                end
                for i = 0 upto {vector.length(data.descriptors) - 1} do
                    let d = vector.get(data.descriptors i)
                    hashSet.insert(c.staticKeys staticKey(d.echo d.type))
                end
                for i = 0 upto {vector.length(data.offsetTables) - 1} do
                    hashSet.insert(c.offsetTables vector.get(data.offsetTables i).id)
                end
                for i = 0 upto {vector.length(data.tagMaps) - 1} do
                    hashSet.insert(c.tagMaps vector.get(data.tagMaps i).id)
                end
                let top = tuple let vars = verifyCore.newIds() let symbols = verifyCore.newIds() end
                for i = 0 upto {vector.length(unit.modules) - 1} do
                    let m = vector.get(unit.modules i)
                    let where = "module '" <> m.name <> "'"
                    descriptorBody(c m.init top where)
                    for j = 0 upto {extent m.abstractTypes - 1} do
                        descriptor(c staticDescriptor(m.abstractTypes[j].descriptor) top where)
                    end
                end
                descriptorBody(c unit.main top "main")
                for i = 0 upto {vector.length(unit.functions) - 1} do
                    functionDescriptors(c vector.get(unit.functions i) top)
                end
                for i = 0 upto {vector.length(data.offsetTables) - 1} do
                    let table = vector.get(data.offsetTables i)
                    if maybe.isSome(table.registered) then
                        let r = maybe.unwrap(table.registered)
                        descriptor(c staticDescriptor(r.view) top "the unit's offset tables")
                        descriptor(c staticDescriptor(r.layout) top "the unit's offset tables")
                    end
                end
            end
            problems
        end

    (* The problems of a unit at its stage (none when it satisfies every
     * invariant) *)
    let verifyUnit(unit: nodes.Unit): Array(String) =
        begin
            let modules = verifyCore.newIds()
            for i = 0 upto {vector.length(unit.modules) - 1} do
                hashSet.insert(modules vector.get(unit.modules i).id)
            end
            for i = 0 upto {extent unit.imports - 1} do hashSet.insert(modules unit.imports[i].id) end
            let functions =
                if nodes.atLeast(unit stages.closed) then
                    let ids = verifyCore.newIds()
                    for i = 0 upto {vector.length(unit.functions) - 1} do
                        hashSet.insert(ids vector.get(unit.functions i).id)
                    end
                    maybe.some(ids)
                else
                    maybe.none(:verifyCore.Ids)
                end
            let v = tuple
                let problems = vector.new(:String)
                let bound = verifyCore.newIds()
                let modules = modules
                let var functions = functions
                let var represented = nodes.atLeast(unit stages.represented)
            end
            (* A module's members are visible to the code after its definition
             * (by name, through the module), not as variables; each module's
             * initializer is its own top level *)
            for i = 0 upto {vector.length(unit.modules) - 1} do
                let m = vector.get(unit.modules i)
                verifyCore.body(v m.init verifyCore.newScope(verifyCore.newIds()) "module '" <> m.name <> "'")
            end
            verifyCore.body(v unit.main verifyCore.newScope(verifyCore.newIds()) "main")
            (* Each statement's traversals agree with walk's visitor *)
            let bodies = walk.unitBodies(unit)
            for i = 0 upto {extent bodies - 1} do
                let stmts = walk.walkStatements(bodies[i] true)
                for k = 0 upto {vector.length(stmts) - 1} do
                    let found = walk.traversalProblems(vector.get(stmts k))
                    for j = 0 upto {extent found - 1} do
                        vector.append(v.problems "walk." <> found[j] <> " disagrees with walk.visitStmt")
                    end
                end
            end
            if nodes.atLeast(unit stages.closed) then
                (* Lifted functions use their parameters, their environment, and
                 * the unit's globals *)
                let globals = walk.globalVariables(unit)
                for i = 0 upto {vector.length(unit.functions) - 1} do
                    verifyCore.function(v vector.get(unit.functions i) verifyCore.newScope(verifyCore.copyIds(globals)))
                end
            end
            if nodes.atLeast(unit stages.represented) then
                let found = representationProblems(unit)
                for i = 0 upto {vector.length(found) - 1} do vector.append(v.problems vector.get(found i)) end
            end
            if nodes.atLeast(unit stages.described) then
                let found = descriptorProblems(unit)
                for i = 0 upto {vector.length(found) - 1} do vector.append(v.problems vector.get(found i)) end
            end
            vector.toArray(v.problems)
        end

    let checkUnit(unit: nodes.Unit): Ok =
        begin
            let problems = verifyUnit(unit)
            if extent problems > 0 then
                let shown = vector.new(:String)
                for i = 0 upto {extent problems - 1} do if i < 20 then vector.append(shown problems[i]) end end
                nodes.internal(:Ok "internal: the IR is not well formed:\n  " <> strutil.join("\n  " shown))
            end
        end
end
