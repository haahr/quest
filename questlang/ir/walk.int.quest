(* Quest Self-Hosted Compiler: IR Traversals Interface
 *
 * Provides IR traversals and variable/atom substitution helpers shared by the
 * IR passes and verifier (counterpart: bootstrap/python/quest/ir/walk.py).
 * These cover statement bodies, binders, atom uses, unit globals, known
 * closures, and in-place variable or atom replacement. The bootstrap's
 * reflective traversals (fields_of, rebuild, contents) have no counterpart
 * here; each walker inspects every node variant explicitly. *)

interface Walk
import
    questlang/ir/nodes : questlang/ir/Nodes
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
export
    (* The bodies a statement contains (not those of the functions a funs
     * statement binds) *)
    statementBodies(s: nodes.Stmt): Array(nodes.Body)
    (* The variables a statement binds itself (not those bound in the bodies it
     * contains) *)
    statementBinders(s: nodes.Stmt): Array(nodes.Variable)
    (* The atoms an operation uses directly, in the order of its fields (not its
     * descriptor operands) *)
    opUses(o: nodes.Op): Array(nodes.Atom)
    (* The atoms a statement uses directly: its operation's, or its own; not
     * those of the bodies or functions it contains, nor its binders *)
    statementUses(s: nodes.Stmt): Array(nodes.Atom)
    (* Every statement in body and the bodies it contains (and in the functions
     * funs statements bind, if intoFunctions), in order *)
    walkStatements(body: nodes.Body intoFunctions: Bool): vector.T(nodes.Stmt)
    (* Returns the variable ids that are globals: those that a unit's main body
     * or a module's initializer binds outside any loop or function, and that
     * are named elsewhere (by a function or by another top-level body) or are
     * a module's members, exports, or record. Functions read globals directly
     * rather than capturing them (questlang/ir/closure). The rest are locals
     * of the body that binds them, which a backend can keep in registers. A
     * variable bound in a loop is a local even at the top level: it is bound
     * anew on each iteration, so closures made in different iterations capture
     * different values, whereas a global would hold only the last. *)
    globalVariables(unit: nodes.Unit): hashMap.T(Int Bool)
    (* Maps each variable id in a closure-converted unit to the closure it is
     * known to hold, enabling direct calls instead of indirect closure calls
     * (docs/ir.md section 8.2). Tracks closure allocations, copies of known
     * closures, and environment reads (env_field) at indices where every
     * closure of that lifted function captures a closure of the same target
     * function. *)
    knownClosures(unit: nodes.Unit): hashMap.T(Int nodes.OpMakeClosure)

    (* Replaces, in place, each variable v that a statement or operation holds
     * in its fields (directly, in arrays, and a let's or do's operation's) by
     * f(v); not those in the bodies, functions, cases, or plans it contains,
     * nor a closure's code *)
    replaceVarsInStmt(s: nodes.Stmt f: All(v: nodes.Variable) nodes.Variable): Ok
    replaceVarsInOp(o: nodes.Op f: All(v: nodes.Variable) nodes.Variable): Ok
    (* Replaces, in place, each atom a that a statement or operation holds in
     * its fields by g(a), as replaceVarsInStmt replaces variables, but not the
     * variables held as variables (binders, callees, addresses taken) *)
    replaceAtomsInStmt(s: nodes.Stmt g: All(a: nodes.Atom) nodes.Atom): Ok
    replaceAtomsInOp(o: nodes.Op g: All(a: nodes.Atom) nodes.Atom): Ok

    (* The view map through which an operation or a statement reads (or
     * stores into) a value of a bounded type parameter, at the parameter's
     * bound (docs/ir.md section 8.4), if it has one *)
    opViewMap(o: nodes.Op): maybe.T(nodes.Variable)
    stmtViewMap(s: nodes.Stmt): maybe.T(nodes.Variable)

    (* The unit's bodies: its modules' initializations first, in order (each
     * runs before the main body, and what it binds its members to is known
     * when the main body calls them), then its main body and its functions *)
    unitBodies(unit: nodes.Unit): Array(nodes.Body)
    (* The call a let or do statement makes, if its operation is one *)
    statementCall(st: nodes.Stmt): maybe.T(nodes.OpCall)
    (* Fills uses with how many times each variable (by id) is used in the
     * unit's bodies, and pinned with the variables a pass must keep as they
     * are, since they are named from outside the bodies or bound together:
     * the modules' members and exports, their record variables, and each let
     * rec's variables. Both are cleared first. *)
    countUses(unit: nodes.Unit uses: hashMap.T(Int Int) pinned: hashMap.T(Int Bool)): Ok
    (* Adds b's uses to uses, and pins its let recs' variables, without
     * clearing either *)
    countBodyUses(b: nodes.Body uses: hashMap.T(Int Int) pinned: hashMap.T(Int Bool)): Ok
end
