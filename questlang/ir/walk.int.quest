(* Quest Self-Hosted Compiler: IR Traversals Interface
 *
 * bootstrap/python/quest/ir/walk.py: traversals of the IR shared by the passes
 * and the verifier: the bodies a statement contains, the variables it binds,
 * the atoms it uses, and the global variables of a unit; and replacing the
 * variables a node holds. The bootstrap's reflective traversal (fields_of,
 * rebuild, contents) has no counterpart: each walker that used it lists the
 * fields it reads, case by case. *)

interface Walk
import
    questlang/ir/nodes : questlang/ir/Nodes
    collections/hashMap : collections/HashMap
    collections/vector : collections/Vector
    util/maybe : util/Maybe
export
    (* The bodies a statement contains (not those of the functions a funs
     * statement binds) *)
    statementBodies(s: nodes.Stmt): Array(nodes.Body)
    (* The variables a statement binds itself (not those bound in the bodies it
     * contains) *)
    statementBinders(s: nodes.Stmt): Array(nodes.Variable)
    (* The atoms an operation uses directly, in the order of its fields (not its
     * descriptor operands) *)
    opUses(o: nodes.Op): Array(nodes.Atom)
    (* The atoms a statement uses directly: its operation's, or its own; not
     * those of the bodies or functions it contains, nor its binders *)
    statementUses(s: nodes.Stmt): Array(nodes.Atom)
    (* Every statement in body and the bodies it contains (and in the functions
     * funs statements bind, if intoFunctions), in order *)
    walkStatements(body: nodes.Body intoFunctions: Bool): vector.T(nodes.Stmt)
    (* The variables (by id) a unit's main body and its modules' initializers
     * bind outside loops and functions that are named elsewhere (by a
     * function, or by another of those bodies) or are a module's members,
     * exports, or record; the rest are locals of the body that binds them,
     * which a backend can keep in registers *)
    globalVariables(unit: nodes.Unit): hashMap.T(Int Bool)
    (* The closure each variable of a closed unit is known to hold, by the
     * variable's id, so that a call through it can call the closure's
     * function directly: a let of the closure, a copy of a variable known to
     * hold one, and the read of a lifted function's environment (env_field)
     * at an index where every closure made of that function captures a
     * variable known to hold a closure of one function (the closure of a
     * local function another local function names, docs/ir.md section
     * 8.2) *)
    knownClosures(unit: nodes.Unit): hashMap.T(Int nodes.OpMakeClosure)

    (* Replaces, in place, each variable v that a statement or operation holds
     * in its fields (directly, in arrays, and a let's or do's operation's) by
     * f(v); not those in the bodies, functions, cases, or plans it contains,
     * nor a closure's code *)
    replaceVarsInStmt(s: nodes.Stmt f: All(v: nodes.Variable) nodes.Variable): Ok
    replaceVarsInOp(o: nodes.Op f: All(v: nodes.Variable) nodes.Variable): Ok
    (* Replaces, in place, each atom a that a statement or operation holds in
     * its fields by g(a), as replaceVarsInStmt replaces variables, but not the
     * variables held as variables (binders, callees, addresses taken) *)
    replaceAtomsInStmt(s: nodes.Stmt g: All(a: nodes.Atom) nodes.Atom): Ok
    replaceAtomsInOp(o: nodes.Op g: All(a: nodes.Atom) nodes.Atom): Ok

    (* The view map an operation or a statement reads a value through its type's
     * bound by, if it has one *)
    opViewMap(o: nodes.Op): maybe.T(nodes.Variable)
    stmtViewMap(s: nodes.Stmt): maybe.T(nodes.Variable)
end
