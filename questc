#!/bin/sh
# Launcher for the self-hosted compiler (docs/milestone-5.md section 2.3 and
# docs/release-compiler.md section 2): runs stage 2, the compiler that
# questlang/driver/main.quest builds when compiled by the seed's build of it
# (stage 1). The seed is the current release (release/current, which compiles
# stage 1 against its own lib/ and runtime/), or the bootstrap when there is no
# release or QUESTC_SEED=bootstrap. The stages are rebuilt first when any file
# they are built from (under questlang/, lib/, or runtime/, and bootstrap/ for
# the bootstrap seed) is newer than stage 2, each build compiling only the units
# that are stale, and from nothing when the seed has changed. Set
# QUESTC_VERBOSE=1 to see the builds' steps. The release builds stage 1, and
# stage 1 builds stage 2, compiling QUESTC_JOBS modules at once (-j; by default,
# as many as there are CPUs); the bootstrap builds stage 1 one at a time.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BUILD="$SCRIPT_DIR/.build/questc"
STAGE1="$BUILD/stage1/questc"
STAGE2="$BUILD/stage2/questc"
DRIVER="questlang/driver/main.quest"
JOBS="${QUESTC_JOBS:-$(sysctl -n hw.ncpu 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)}"
RELEASE="$SCRIPT_DIR/release/current"

SEED="${QUESTC_SEED:-}"
if [ -z "$SEED" ]; then
    if [ -x "$RELEASE/questc" ]; then
        SEED=release
    else
        echo "questc: no release in release/current (make one with tools/release); seeding from the bootstrap" >&2
        SEED=bootstrap
    fi
fi
case "$SEED" in
    release)
        [ -x "$RELEASE/questc" ] || { echo "questc: QUESTC_SEED=release, but there is no release/current" >&2; exit 1; }
        RECORDED="$(sed -n 's/.*"sha256": *"\([0-9a-f]*\)".*/\1/p' "$RELEASE/release.json")"
        ACTUAL="$(shasum -a 256 "$RELEASE/questc" | cut -d ' ' -f 1)"
        if [ -z "$RECORDED" ] || [ "$RECORDED" != "$ACTUAL" ]; then
            echo "questc: release/current/questc is not the binary its release.json describes" >&2
            exit 1
        fi
        SEED_ID="release $ACTUAL"
        SOURCES="questlang lib runtime"
        ;;
    bootstrap)
        SEED_ID="bootstrap"
        SOURCES="questlang lib runtime bootstrap"
        ;;
    *)
        echo "questc: QUESTC_SEED must be release or bootstrap, not $SEED" >&2
        exit 1
        ;;
esac

# Stages built by another seed are discarded: a release's home/ has its
# commit's times, so its artifacts cannot be judged stale against another's
if [ "$(cat "$BUILD/seed" 2>/dev/null)" != "$SEED_ID" ]; then
    rm -rf "$BUILD"
fi

stale() {
    [ ! -x "$STAGE2" ] && return 0
    # shellcheck disable=SC2086
    [ -n "$(cd "$SCRIPT_DIR" && find $SOURCES -type f -newer "$STAGE2" 2>/dev/null | head -n 1)" ]
}

if stale; then
    VERBOSE=""
    [ -n "$QUESTC_VERBOSE" ] && VERBOSE="-v"
    mkdir -p "$BUILD/stage1" "$BUILD/stage2" || exit 1
    printf '%s\n' "$SEED_ID" > "$BUILD/seed"
    if [ "$SEED" = release ]; then
        echo "questc: building stage 1 (the release compiling $DRIVER)..." >&2
        (cd "$SCRIPT_DIR" && QUEST_HOME="$RELEASE/home" "$RELEASE/questc" $VERBOSE -j "$JOBS" -I "$SCRIPT_DIR" \
            --build-dir "$BUILD/stage1/build" -o "$STAGE1" "$DRIVER") || exit 1
    else
        echo "questc: building stage 1 (the bootstrap compiling $DRIVER)..." >&2
        (cd "$SCRIPT_DIR" && ./quest $VERBOSE --build-dir "$BUILD/stage1/build" -o "$STAGE1" "$DRIVER") || exit 1
    fi
    echo "questc: building stage 2 (stage 1 compiling $DRIVER)..." >&2
    (cd "$SCRIPT_DIR" && QUEST_HOME="$SCRIPT_DIR" "$STAGE1" $VERBOSE -j "$JOBS" --build-dir "$BUILD/stage2/build" \
        -o "$STAGE2" "$DRIVER") || exit 1
fi

QUEST_HOME="${QUEST_HOME:-$SCRIPT_DIR}" exec "$STAGE2" "$@"
