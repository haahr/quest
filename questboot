#!/bin/sh
# Launcher for the bootstrap compiler (bootstrap/python/quest_driver.py), which
# builds the self-hosted compiler (./quest) when there is no release, and writes
# the goldens the two compilers share (docs/testing.md section 2.8).
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/tools/python.sh"
exec "$PY" "$SCRIPT_DIR/bootstrap/python/quest_driver.py" "$@"
