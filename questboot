#!/bin/sh
# Launcher for the bootstrap compiler (bootstrap/python/quest_driver.py), which
# builds the self-hosted compiler (./quest) when there is no release, and writes
# the goldens the two compilers share (docs/testing.md section 2.8).
if [ -n "$PYTHON" ]; then
    PY="$PYTHON"
elif [ -x "/opt/homebrew/opt/python@3.11/libexec/bin/python" ]; then
    PY="/opt/homebrew/opt/python@3.11/libexec/bin/python"
elif [ -x "/opt/homebrew/bin/python3" ]; then
    PY="/opt/homebrew/bin/python3"
elif command -v python3.11 >/dev/null 2>&1; then
    PY="python3.11"
else
    PY="python3"
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$PY" "$SCRIPT_DIR/bootstrap/python/quest_driver.py" "$@"
