(* Quest WebAssembly Runtime: Dynamic Values' Serialization Interface
 *
 * The runtime's upper layer (docs/wasm.md section 4.2): dynamic.extern and
 * dynamic.intern, as quest_serialization.c has them, over the core's
 * descriptors and values as slots hold them. The format is docs/dynamic.md's,
 * version 1, and the text is the C runtime's, byte for byte. lib/dynamic's
 * wasm variant (lib/dynamic.wasm.mod.quest) calls it. A failure raises
 * dynamic.error. *)

unsound interface Dynamic
import
    wasm/core : wasm/Core
    reader : Reader
    writer : Writer
export
    (* Writes the dynamic value d (an auto value of Auto A::TYPE with a: A
     * end) to wr as a document: its type table, its type, and its value
     * (quest_dynamic_extern) *)
    extern(wr: writer.T d: core.Any): Ok
    (* Reads a document from rd, which is left after it: the dynamic value
     * (quest_dynamic_intern) *)
    intern(rd: reader.T): core.Any
end
