(* Quest WebAssembly Runtime: The Core
 *
 * Monomorphic, and importing nothing (docs/wasm-plan.md section 4.5): it
 * uses no library unit's Quest code, and so no maybe, vector, or hashMap. *)

unsound module core : Core
import
    stringOp = string : StringOp
    system : System
    realOp = real : RealOp
    writer : Writer
    reader : Reader
export
    Let Any = external "eqref"

    Def Rec Desc = Tuple
        kind: Int
        name: String
        parts: Array(Desc)
        labels: Array(String)
        positions: Array(Int)
        texts: Array(String)
        (* each part's flags: 1 var, 2 out, 4 a function's result *)
        flags: Array(Int)
    end

    let kindNone = 0
    let kindInt = 1
    let kindReal = 2
    let kindBool = 3
    let kindChar = 4
    let kindString = 5
    let kindOk = 6
    let kindWord = 7
    let kindFun = 8
    let kindTuple = 9
    let kindRecord = 10
    let kindOption = 11
    let kindVariant = 12
    let kindArray = 13
    let kindException = 14
    let kindOpaque = 15
    let kindAuto = 16
    let kindBoundVar = 17
    let kindHole = 18
    let kindStored = 19
    let kindCount = 20

    let names = array of
        "" "Int" "Real" "Bool" "Char" "String" "Ok" "Word.T" "fun" "Tuple end" "record" "option" "variant" "array"
        "exception" "opaque" "auto" "?" "?" "stored"
    end

    let plain(kind: Int): Desc =
        tuple
            let kind = kind let name = names[kind] let parts = array of :Desc end let labels = array of :String end
            let positions = array of :Int end let texts = array of :String end
            let flags = array of :Int end
        end

    let bases: Array(Desc) =
        begin
            let all = array of(kindCount plain(kindNone))
            for k = 1 upto kindCount - 1 do all[k] := plain(k) end
            all
        end

    let base(kind: Int): Desc = bases[kind]

    (* The bound variable descriptor of index i (quest_type_bound_vars[i]):
     * an auto type's components refer to its type parameter as index 0, the
     * enclosing auto type's as 1, and so on. Index 0's is the base one; each
     * other is made once, its index its one position *)
    let boundVars = tuple let var items = array of :Desc end end
    let boundVar(i: Int): Desc =
        if i <= 0 then bases[kindBoundVar]
        else
            if i >= extent boundVars.items then
                let more = array of(i + 1 bases[kindBoundVar])
                for k = 0 upto extent boundVars.items - 1 do more[k] := boundVars.items[k] end
                for k = extent boundVars.items upto i do
                    if k > 0 then
                        more[k] := tuple
                            let kind = kindBoundVar let name = "?" let parts = array of :Desc end
                            let labels = array of :String end let positions = array of k end
                            let texts = array of :String end let flags = array of :Int end
                        end
                    end
                end
                boundVars.items := more
            end
            boundVars.items[i]
        end
    let boundIndex(d: Desc): Int = if extent d.positions > 0 then d.positions[0] else 0 end

    (* An auto type's components, and its bound, a last part flagged 32, or
     * none *)
    let autoBound(d: Desc): Desc =
        begin
            let n = extent d.parts
            if {n > 0} andif {d.flags[n - 1] is 32} then d.parts[n - 1] else bases[kindNone] end
        end
    let autoComponents(d: Desc): Int = if autoBound(d).kind is kindNone then extent d.parts else extent d.parts - 1 end

    let newDesc(kind: Int name: String n: Int m: Int): Desc =
        tuple
            let kind = kind let name = name let parts = array of(n bases[kindNone]) let labels = array of(n "")
            let positions = array of(m 0) let texts = array of(m "")
            let flags = array of(n 0)
        end

    let setPart(d: Desc i: Int part: Desc label: String): Ok =
        begin
            d.parts[i] := part
            d.labels[i] := label
        end

    let setFlags(d: Desc i: Int flags: Int): Ok = d.flags[i] := flags

    let setText(d: Desc i: Int position: Int text: String): Ok =
        begin
            d.positions[i] := position
            d.texts[i] := text
        end

    (* The instances made, each by its template and arguments, and the
     * descriptors an instantiation has copied, each by its original, so that
     * a cycle closes; each a list grown by doubling *)
    Def Instance = Tuple template: Desc args: Array(Desc) result: Desc end
    let instances = tuple
        let var items = array of :Instance end
        let var count = 0
        let var copied = array of :Desc end
        let var copies = array of :Desc end
        let var ncopied = 0
        let var updating = 0
    end

    let updating(): Int = instances.updating

    (* The hole's index, the digits of its name after "?" *)
    let holeIndex(d: Desc): Int =
        begin
            let var n = 0
            for i = 1 upto stringOp.length(d.name) - 1 do
                let c = stringOp.getChar(d.name i)
                let var v = 0
                for k = 0 upto 9 do if c is stringOp.getChar("0123456789" k) then v := k end end
                n := {n * 10} + v
            end
            n
        end

    (* An instance's name: its template's, each hole ?N in it its Nth
     * argument's name, cut off at 80 characters (quest_inst_name) *)
    let charNumber(c: Char): Int = external "wasm.charCode"
    let instName(name: String args: Array(Desc)): String =
        begin
            let n = stringOp.length(name)
            let pieces = array of(n + 1 "")
            let var count = 0
            let var start = 0
            let var i = 0
            while i < n do
                if {stringOp.getChar(name i) is '?'} andif {{i + 1} < n} then
                    let var j = i + 1
                    let var k = 0
                    let var digits = 0
                    while {j < n} andif {digits < 6} andif {charNumber(stringOp.getChar(name j)) >= 48}
                        andif {charNumber(stringOp.getChar(name j)) <= 57} do
                        k := {k * 10} + {charNumber(stringOp.getChar(name j)) - 48}
                        j := j + 1
                        digits := digits + 1
                    end
                    if {digits > 0} andif {k < extent args} then
                        pieces[count] := stringOp.getSub(name start i - start)
                        pieces[count + 1] := args[k].name
                        count := count + 2
                        start := j
                        i := j
                    else i := i + 1
                    end
                else i := i + 1
                end
            end
            pieces[count] := stringOp.getSub(name start n - start)
            if count is 0 then name
            else
                let var all = ""
                for m = 0 upto count do all := all <> pieces[m] end
                (* cut off as static names are, at 80 characters *)
                if stringOp.length(all) > 80 then stringOp.getSub(all 0 80) <> "..." else all end
            end
        end

    let rec copy(d: Desc args: Array(Desc)): Desc =
        if d.kind is kindHole then
            let k = holeIndex(d)
            if k < extent args then args[k] else d end
        elsif extent d.parts is 0 then d
        else
            let var found = ~1
            for i = 0 upto instances.ncopied - 1 do if instances.copied[i] is d then found := i end end
            if found >= 0 then instances.copies[found]
            else
                let c = newDesc(d.kind instName(d.name args) extent d.parts extent d.texts)
                if instances.ncopied >= extent instances.copied then
                    let more = array of({2 * instances.ncopied} + 4 d)
                    let moreCopies = array of({2 * instances.ncopied} + 4 d)
                    for i = 0 upto instances.ncopied - 1 do
                        more[i] := instances.copied[i]
                        moreCopies[i] := instances.copies[i]
                    end
                    instances.copied := more
                    instances.copies := moreCopies
                end
                instances.copied[instances.ncopied] := d
                instances.copies[instances.ncopied] := c
                instances.ncopied := instances.ncopied + 1
                for i = 0 upto extent d.texts - 1 do setText(c i d.positions[i] d.texts[i]) end
                for i = 0 upto extent d.parts - 1 do
                    setPart(c i copy(d.parts[i] args) d.labels[i])
                    c.flags[i] := d.flags[i]
                end
                c
            end
        end

    let instantiate(t: Desc args: Array(Desc)): Desc =
        begin
            let var found = ~1
            for i = 0 upto instances.count - 1 do
                let x = instances.items[i]
                if {x.template is t} andif {extent x.args is extent args} then
                    let var same = true
                    for j = 0 upto extent args - 1 do if not(x.args[j] is args[j]) then same := false end end
                    if same then found := i end
                end
            end
            if found >= 0 then instances.items[found].result
            else
                instances.updating := instances.updating + 1
                instances.ncopied := 0
                let result = copy(t args)
                let made = tuple let template = t let args = args let result = result end
                if instances.count >= extent instances.items then
                    let more = array of({2 * instances.count} + 4 made)
                    for i = 0 upto instances.count - 1 do more[i] := instances.items[i] end
                    instances.items := more
                end
                instances.items[instances.count] := made
                instances.count := instances.count + 1
                instances.updating := instances.updating - 1
                result
            end
        end


    (* The registry of abstract types' representations (see below) *)
    Def Abstract = Tuple name: String arity: Int rep: Desc end
    let abstracts = tuple let var items = array of :Abstract end let var count = 0 end

    let registerAbstract(name: String arity: Int rep: Desc): Ok =
        begin
            let var found = false
            for i = 0 upto abstracts.count - 1 do
                if stringOp.equal(abstracts.items[i].name name) then found := true end
            end
            if not(found) then
                let e = tuple let name = name let arity = arity let rep = rep end
                if abstracts.count >= extent abstracts.items then
                    let more = array of({2 * abstracts.count} + 8 e)
                    for i = 0 upto abstracts.count - 1 do more[i] := abstracts.items[i] end
                    abstracts.items := more
                end
                abstracts.items[abstracts.count] := e
                abstracts.count := abstracts.count + 1
            end
        end

    (* An abstract type's representation (an application's, its arguments
     * filled in), or none if its module registered none *)
    let abstractRep(d: Desc): Desc =
        begin
            let var rep = bases[kindNone]
            (* its arguments, without a representation a document recorded *)
            let var recorded = bases[kindNone]
            let var args = 0
            for i = 0 upto extent d.flags - 1 do
                if d.flags[i] is 16 then recorded := d.parts[i] else args := args + 1 end
            end
            if d.kind is kindOpaque then
                for i = 0 upto abstracts.count - 1 do
                    let e = abstracts.items[i]
                    if stringOp.equal(e.name d.name) andif {e.arity is args} then
                        let given = array of(args bases[kindNone])
                        for j = 0 upto args - 1 do given[j] := d.parts[j] end
                        rep := if e.arity > 0 then instantiate(e.rep given) else e.rep end
                    end
                end
            end
            (* a module the program does not link: the representation the
             * document recorded *)
            if rep.kind is kindNone then rep := recorded end
            rep
        end

    (* ======================================================================
     * Subtyping, record tables, and conversion (quest_types.c's
     * quest_is_subtype, quest_views.c's quest_record_dict and quest_convert,
     * docs/wasm-plan.md step 17)
     *
     * A slot holds every value in one form here, so no two layouts of a type
     * differ: what a value seen at another type may need is only its view, a
     * record's table, a variant's tag in the other type's numbering.
     * ====================================================================== *)

    (* What a value is, as a slot holds it: a record's box (its payload, the
     * payload's layout, and the table it is seen through), a variant's box
     * (its tag and payload), and a null reference *)
    let recordLayoutAny(payload: Any): Any = external "wasm.recordLayout"
    let recordPayload(x: Any): Any = external "wasm.recPayload"
    let recDict(x: Any): Any = external "wasm.recDict"
    let newRecBox(payload: Any dict: Any): Any = external "wasm.newRecBox"
    let variantTag(x: Any): Int = external "wasm.variantTag"
    let variantPayload(x: Any): Any = external "wasm.variantPayload"
    let newVarBox(tag: Int payload: Any): Any = external "wasm.newVarBox"
    let isNull(x: Any): Bool = external "wasm.isNull"
    let nullAny(): Any = external "wasm.nullAny"
    (* A table ($dict): its indices, an array of i32s, and its stored types,
     * an array of descriptors or null *)
    let newI32s(n: Int): Any = external "wasm.newI32s"
    let setI32(a: Any i: Int v: Int): Ok = external "wasm.setI32"
    let newDict(indices: Any stored: Any): Any = external "wasm.newDict"
    let dictStored(d: Any): Any = external "wasm.dictStored"
    let descsAny(ds: Array(Desc)): Any = external "wasm.toAny"
    let anyDescs(x: Any): Array(Desc) = external "wasm.fromAny"
    let anyDesc(x: Any): Desc = external "wasm.fromAny"
    (* dynamic.error, which a view of a value at a type it is not raises *)
    let dynamicError(): Ok = external "wasm.dynamicError"

    (* A stored type's descriptor stands for its part, where it has one: an
     * opaque descriptor of a bounded abstract type, held at its storage *)
    let storedType(d: Desc): Desc =
        if {d.kind is kindStored} andif {extent d.parts > 0} then d.parts[0] else d end
    let storage(d: Desc): Desc =
        if {d.kind is kindStored} andif {extent d.parts > 1} then d.parts[1] else bases[kindNone] end
    (* How a value of type d is held: a stored type's at its storage, viewed
     * at the bound (quest_stored_representation) *)
    let storedRep(d: Desc): Desc = if storage(d).kind isnot kindNone then storage(d) else storedType(d) end

    (* The index of d's part labeled label, or ~1 *)
    let partNamed(d: Desc label: String): Int =
        begin
            let var found = ~1
            for i = 0 upto extent d.parts - 1 do
                if {found < 0} andif stringOp.equal(d.labels[i] label) then found := i end
            end
            found
        end

    (* Whether d's part i is var *)
    let isVar(d: Desc i: Int): Bool = {i < extent d.flags} andif {d.flags[i] is 1}

    (* The pairs whose proofs are in progress, which are assumed to hold
     * (quest_is_subtype's trail: descriptors of recursive types are cyclic) *)
    Def Pair = Tuple sub: Desc sup: Desc end
    let trail = tuple let var items = array of :Pair end let var count = 0 end

    (* word.T, the base descriptor or the opaque one (quest_is_word_type) *)
    let isWordType(d: Desc): Bool =
        {d.kind is kindWord}
            orif {{d.kind is kindOpaque} andif {extent d.parts is 0} andif stringOp.equal(d.name "word.T")}

    let rec isSubtype(sub0: Desc sup0: Desc): Bool =
        begin
            let sub = storedType(sub0)
            let sup = storedType(sup0)
            if {sub is sup} orif {isWordType(sub) andif isWordType(sup)} then true
            else
                let var assumed = false
                for i = 0 upto trail.count - 1 do
                    if {trail.items[i].sub is sub} andif {trail.items[i].sup is sup} then assumed := true end
                end
                if assumed then true
                else
                    let pair = tuple let sub = sub let sup = sup end
                    if trail.count >= extent trail.items then
                        let more = array of({2 * trail.count} + 16 pair)
                        for i = 0 upto trail.count - 1 do more[i] := trail.items[i] end
                        trail.items := more
                    end
                    trail.items[trail.count] := pair
                    trail.count := trail.count + 1
                    let result = subtypeParts(sub sup)
                    trail.count := trail.count - 1
                    result
                end
            end
        end

    (* By sup's kind, as quest_is_subtype compares them *)
    and subtypeParts(sub: Desc sup: Desc): Bool =
        begin
            let k = sup.kind
            let both = fun(a: Desc b: Desc): Bool isSubtype(a b) andif isSubtype(b a)
            if {k is kindTuple} then
                if sub.kind isnot kindTuple then false
                elsif extent sup.parts is 0 then true
                elsif extent sub.parts < extent sup.parts then false
                else
                    let var match = true
                    for i = 0 upto extent sup.parts - 1 do
                        let named = not(stringOp.isEmpty(sup.labels[i]))
                        if named andif not(stringOp.equal(sub.labels[i] sup.labels[i])) then match := false
                        elsif isVar(sup i) then
                            if not(isVar(sub i)) orif {match andif not(both(sub.parts[i] sup.parts[i]))} then
                                match := false
                            end
                        elsif match andif not(isSubtype(sub.parts[i] sup.parts[i])) then match := false
                        end
                    end
                    match
                end
            elsif k is kindRecord then
                if sub.kind isnot kindRecord then false
                else
                    let var match = true
                    for j = 0 upto extent sup.parts - 1 do
                        let i = partNamed(sub sup.labels[j])
                        if i < 0 then match := false
                        elsif isVar(sup j) then
                            if not(isVar(sub i)) orif {match andif not(both(sub.parts[i] sup.parts[j]))} then
                                match := false
                            end
                        elsif match andif not(isSubtype(sub.parts[i] sup.parts[j])) then match := false
                        end
                    end
                    match
                end
            elsif {k is kindVariant} orif {k is kindOption} then
                if {sub.kind isnot kindVariant} andif {sub.kind isnot kindOption} then false
                else
                    let var match = true
                    for i = 0 upto extent sub.parts - 1 do
                        let j = partNamed(sup sub.labels[i])
                        if j < 0 then match := false
                        else
                            let sp = sub.parts[i]
                            let tp = sup.parts[j]
                            let sNone = sp.kind is kindNone
                            let tNone = tp.kind is kindNone
                            if sNone orif tNone then
                                if sNone isnot tNone then match := false end
                            elsif isVar(sub i) orif isVar(sup j) then
                                if match andif not(both(sp tp)) then match := false end
                            elsif match andif not(isSubtype(sp tp)) then match := false
                            end
                        end
                    end
                    match
                end
            elsif {k is kindArray} orif {k is kindException} then
                {sub.kind is k} andif {extent sub.parts is extent sup.parts}
                    andif {{extent sup.parts is 0} orif both(sub.parts[0] sup.parts[0])}
            elsif k is kindFun then
                (* as many parameters, each of the same mode: contravariant
                 * value parameters, invariant var ones, covariant out ones and
                 * result *)
                if {sub.kind isnot kindFun} orif {extent sub.parts isnot extent sup.parts} then false
                else
                    let var match = true
                    for i = 0 upto extent sup.parts - 1 do
                        let mode = sup.flags[i]
                        if sub.flags[i] isnot mode then match := false
                        elsif not(match) then ok
                        elsif mode is 1 then match := both(sub.parts[i] sup.parts[i])
                        elsif {mode is 2} orif {mode is 4} then match := isSubtype(sub.parts[i] sup.parts[i])
                        else match := isSubtype(sup.parts[i] sub.parts[i])
                        end
                    end
                    match
                end
            elsif k is kindAuto then
                (* a bound within sup's, if it has one, then a prefix of
                 * components with equal names and var-ness, covariant, or
                 * invariant when var *)
                if {sub.kind isnot kindAuto} orif {autoComponents(sub) < autoComponents(sup)} then false
                elsif {autoBound(sup).kind isnot kindNone} andif {{autoBound(sub).kind is kindNone}
                    orif not(isSubtype(autoBound(sub) autoBound(sup)))} then false
                else
                    let var match = true
                    for i = 0 upto autoComponents(sup) - 1 do
                        if not(stringOp.equal(sub.labels[i] sup.labels[i])) orif {isVar(sub i) isnot isVar(sup i)} then
                            match := false
                        elsif not(match) then ok
                        elsif isVar(sup i) then match := both(sub.parts[i] sup.parts[i])
                        else match := isSubtype(sub.parts[i] sup.parts[i])
                        end
                    end
                    match
                end
            elsif k is kindOpaque then
                (* the same name, and an application's arguments equal (not
                 * the representation a document recorded, flagged 16) *)
                let args = fun(d: Desc): Int
                    begin
                        let var n = 0
                        for i = 0 upto extent d.parts - 1 do if d.flags[i] isnot 16 then n := n + 1 end end
                        n
                    end
                if {sub.kind isnot k} orif not(stringOp.equal(sub.name sup.name)) orif {args(sub) isnot args(sup)}
                then false
                else
                    let var match = true
                    for i = 0 upto args(sup) - 1 do
                        if match andif not(both(sub.parts[i] sup.parts[i])) then match := false end
                    end
                    match
                end
            else false
            end
        end

    let sameType(a: Desc b: Desc): Bool = isSubtype(a b) andif isSubtype(b a)

    (* Whether a part stored at type stored must be converted to be read at
     * type viewed (quest_stored_type_differs): its view differs *)
    let storedDiffers(stored: Desc viewed: Desc): Bool =
        if stored is viewed then false
        else
            let k = storedType(viewed).kind
            if {k is kindRecord} orif {k is kindVariant} orif {k is kindOption} orif {k is kindTuple}
                orif {k is kindFun} then not(sameType(stored viewed))
            else false
            end
        end

    (* The record tables made, each by its view and its layout: the map of
     * record tables (quest_record_dict) *)
    Def DictEntry = Tuple view: Desc layout: Desc dict: Any end
    let dicts = tuple let var items = array of :DictEntry end let var count = 0 end

    (* The table for a payload laid out as layout, seen at view: for each of
     * view's fields, in name order, its slot in the payload (whose slots are
     * in layout's name order), and the type each field is stored at where it
     * differs from view's; dynamic.error if layout lacks a field of view's *)
    let buildDict(view: Desc layout: Desc): Any =
        begin
            let n = extent view.parts
            let indices = newI32s(n)
            let none = bases[kindNone]
            let stored = array of(n none)
            let var differs = false
            for j = 0 upto n - 1 do
                let i = partNamed(layout view.labels[j])
                if i < 0 then dynamicError() end
                setI32(indices j i)
                if storedDiffers(layout.parts[i] view.parts[j]) then
                    stored[j] := layout.parts[i]
                    differs := true
                end
            end
            newDict(indices if differs then descsAny(stored) else nullAny() end)
        end

    let recordDict(view: Desc layout: Desc): Any =
        begin
            let var found = ~1
            for i = 0 upto dicts.count - 1 do
                let e = dicts.items[i]
                if {found < 0} andif {e.view is view} andif {e.layout is layout} then found := i end
            end
            if found >= 0 then dicts.items[found].dict
            else
                let dict = buildDict(view layout)
                let made = tuple let view = view let layout = layout let dict = dict end
                instances.updating := instances.updating + 1
                if dicts.count >= extent dicts.items then
                    let more = array of({2 * dicts.count} + 16 made)
                    for i = 0 upto dicts.count - 1 do more[i] := dicts.items[i] end
                    dicts.items := more
                end
                dicts.items[dicts.count] := made
                dicts.count := dicts.count + 1
                instances.updating := instances.updating - 1
                dict
            end
        end

    (* The table for the record payload seen at view, from the payload's own
     * layout, which it was made with *)
    let viewDict(payload: Any view: Desc): Any = recordDict(storedType(view) anyDesc(recordLayoutAny(payload)))


    (* ======================================================================
     * Proxies (quest_views.c's quest_make_proxy, quest_proxy_element, and
     * the rest; docs/c-representation.md section 5.8): a tuple or option
     * seen at a supertype at which a component changes view is not copied,
     * so that it keeps its identity and its var components; it is a proxy,
     * which holds the original, the type its components are stored at, the
     * type it is seen at, and an option's tags in that type's numbering, and
     * converts each component as it is read
     * ====================================================================== *)

    Def Proxied = Tuple orig: Any stored: Desc view: Desc tags: Array(Int) end
    let isProxy(x: Any): Bool = external "wasm.isProxy"
    let newProxy(state: Any): Any = external "wasm.newProxy"
    let proxyStateAny(p: Any): Any = external "wasm.proxyState"
    let proxiedAny(s: Proxied): Any = external "wasm.toAny"
    let anyProxied(x: Any): Proxied = external "wasm.fromAny"
    let slotOf(x: Any i: Int): Any = external "wasm.tupleSlot"
    let optionTagOf(x: Any): Int = external "wasm.optionTag"
    let newTupleOf(slots: Array(Any)): Any = external "wasm.newTuple"
    let newOptionOf(tag: Int slots: Array(Any)): Any = external "wasm.newOption"
    let proxied(p: Any): Proxied = anyProxied(proxyStateAny(p))

    (* The object a value is: a proxy's original *)
    let unproxy(v: Any): Any = if isProxy(v) then proxied(v).orig else v end

    (* The descriptors a walk is in, which a cyclic descriptor meets again *)
    Def Walk = Tuple var items: Array(Desc) var count: Int end
    let newWalk(): Walk = tuple let var items = array of(16 bases[kindNone]) let var count = 0 end
    let walking(w: Walk d: Desc): Bool =
        begin
            let var found = false
            for i = 0 upto w.count - 1 do if w.items[i] is d then found := true end end
            found
        end
    let enterWalk(w: Walk d: Desc): Ok =
        begin
            if w.count >= extent w.items then
                let more = array of(2 * w.count d)
                for i = 0 upto w.count - 1 do more[i] := w.items[i] end
                w.items := more
            end
            w.items[w.count] := d
            w.count := w.count + 1
        end

    (* Whether a value of type d may be a proxy, as the compiler decides it
     * (quest_may_be_proxied): a tuple one of whose components may change
     * view, an option of two or more cases or one of whose payloads'
     * components may. A component may change view when it is view-sensitive
     * (a record, variant, or auto value, a value stored as a type parameter,
     * a function whose type mentions a view-sensitive type, or a tuple or
     * option that may be a proxy) or may hold a proxy (a tuple, an option
     * with a payload) *)
    let holdsProxies(d: Desc): Bool =
        if d.kind is kindTuple then true
        elsif d.kind is kindOption then
            let var any = false
            for i = 0 upto extent d.parts - 1 do if d.parts[i].kind isnot kindNone then any := true end end
            any
        else false
        end

    let rec mayBeProxiedIn(d: Desc w: Walk): Bool =
        if walking(w d) then false
        else
            enterWalk(w d)
            let result = if d.kind is kindTuple then
                    let var any = false
                    for i = 0 upto extent d.parts - 1 do
                        if not(any) andif {holdsProxies(d.parts[i]) orif viewSensitive(d.parts[i] w)} then
                            any := true
                        end
                    end
                    any
                elsif d.kind is kindOption then
                    if extent d.parts >= 2 then true
                    else
                        let var any = false
                        for i = 0 upto extent d.parts - 1 do
                            let p = d.parts[i]
                            if not(any) andif {p.kind is kindTuple} andif mayBeProxiedIn(p w) then any := true end
                        end
                        any
                    end
                else false
                end
            w.count := w.count - 1
            result
        end

    and viewSensitive(d: Desc w: Walk): Bool =
        begin
            let k = d.kind
            if {k is kindRecord} orif {k is kindVariant} orif {k is kindAuto} orif {k is kindStored}
                orif {k is kindBoundVar} orif {k is kindHole} then true
            elsif {k is kindTuple} orif {k is kindOption} then mayBeProxiedIn(d w)
            else false
            end
        end

    let mayBeProxied(d: Desc): Bool = mayBeProxiedIn(storedType(d) newWalk())

    (* Whether values of type a can be used at type b as they are, as far as
     * their views go (quest_layout_equivalent, here, where every slot holds
     * a value in one form): the same type, or tuples whose components are,
     * a prefix of a's, or records, variants, and options whose fields or
     * cases are, by name and position *)
    let equivTrail = tuple let var items = array of :Pair end let var count = 0 end
    let rec viewEquivalent(a0: Desc b0: Desc): Bool =
        begin
            let a = storedType(a0)
            let b = storedType(b0)
            if a is b then true
            else
                let var assumed = false
                for i = 0 upto equivTrail.count - 1 do
                    if {equivTrail.items[i].sub is a} andif {equivTrail.items[i].sup is b} then assumed := true end
                end
                if assumed then true
                else
                    let pair = tuple let sub = a let sup = b end
                    if equivTrail.count >= extent equivTrail.items then
                        let more = array of({2 * equivTrail.count} + 16 pair)
                        for i = 0 upto equivTrail.count - 1 do more[i] := equivTrail.items[i] end
                        equivTrail.items := more
                    end
                    equivTrail.items[equivTrail.count] := pair
                    equivTrail.count := equivTrail.count + 1
                    let k = b.kind
                    let result = if a.kind isnot k then false
                        elsif k is kindTuple then
                            let var same = extent a.parts >= extent b.parts
                            for i = 0 upto extent b.parts - 1 do
                                if same andif not(viewEquivalent(a.parts[i] b.parts[i])) then same := false end
                            end
                            same
                        elsif {k is kindRecord} orif {k is kindVariant} orif {k is kindOption} then
                            let var same = extent a.parts is extent b.parts
                            for i = 0 upto extent b.parts - 1 do
                                if same andif not(stringOp.equal(a.labels[i] b.labels[i])) then same := false end
                                if same andif {{a.parts[i].kind is kindNone} isnot {b.parts[i].kind is kindNone}} then
                                    same := false
                                end
                                if same andif {a.parts[i].kind isnot kindNone}
                                    andif not(viewEquivalent(a.parts[i] b.parts[i])) then same := false end
                            end
                            same
                        else sameType(a b)
                        end
                    equivTrail.count := equivTrail.count - 1
                    result
                end
            end
        end

    (* Whether a tuple or option of type from can be used at to as it is, as
     * far as proxies go: no component, at any depth through tuples and
     * options, of a type whose values may be proxies is used at a type whose
     * values never are (quest_proxies_agree) *)
    let rec proxiesAgreeIn(from0: Desc to0: Desc depth: Int): Bool =
        begin
            let from = storedType(from0)
            let to = storedType(to0)
            if {from is to} orif {depth >= 64} then true
            elsif {to.kind isnot kindTuple} andif {to.kind isnot kindOption} then true
            elsif from.kind isnot to.kind then true
            elsif {depth > 0} andif not(mayBeProxied(to)) andif mayBeProxied(from) then false
            elsif to.kind is kindTuple then
                let var agree = true
                for i = 0 upto extent to.parts - 1 do
                    if agree andif {i < extent from.parts} andif not(proxiesAgreeIn(from.parts[i] to.parts[i] depth + 1))
                    then agree := false end
                end
                agree
            else
                let var agree = true
                for i = 0 upto extent from.parts - 1 do
                    let j = partNamed(to from.labels[i])
                    if agree andif {j >= 0} andif {from.parts[i].kind isnot kindNone} andif {to.parts[j].kind isnot kindNone}
                        andif not(proxiesAgreeIn(from.parts[i] to.parts[j] depth + 1)) then agree := false end
                end
                agree
            end
        end
    let proxiesAgree(from: Desc to: Desc): Bool = proxiesAgreeIn(from to 0)

    (* The tuple or option v, of type from, seen at to as a proxy, or as its
     * original where nothing changes view *)
    let makeProxy(v: Any from0: Desc to0: Desc): Any =
        begin
            let orig = unproxy(v)
            let from = storedType(if isProxy(v) then proxied(v).stored else from0 end)
            let to = storedType(to0)
            if {from is to} orif {viewEquivalent(from to) andif proxiesAgree(from to)} then orig
            else
                let tags = if to.kind is kindOption then array of(extent from.parts ~1) else array of :Int end end
                if to.kind is kindOption then
                    for i = 0 upto extent from.parts - 1 do tags[i] := partNamed(to from.labels[i]) end
                end
                newProxy(proxiedAny(tuple let orig = orig let stored = from let view = to let tags = tags end))
            end
        end

    (* Component i of a payload's type: its tuple's component, or itself *)
    let elementType(payload: Desc i: Int): Desc =
        if storedType(payload).kind is kindTuple then storedType(payload).parts[i] else payload end

    (* Through a proxy: an option's tag in the proxy's type's numbering, a
     * tuple's component i, and an option's payload's component i, each read
     * from the original and converted from the type it is stored at *)
    let proxyTag(p: Any): Int =
        begin
            let s = proxied(p)
            s.tags[optionTagOf(s.orig)]
        end
    (* An option's case's payload, seen through a proxy, as its case binder
     * is: the original's payload, itself proxied where it changes view *)
    let proxyOptionPayload(p: Any): Any =
        begin
            let s = proxied(p)
            let tag = optionTagOf(s.orig)
            makeProxy(s.orig s.stored.parts[tag] s.view.parts[s.tags[tag]])
        end

    (* A tuple's or option's tag and components, a proxy's or not *)
    let tagAt(v: Any): Int = if isProxy(v) then proxyTag(v) else optionTagOf(v) end

    (* A function type's descriptor: its parameters (flags 0, 1 var, 2 out),
     * its result (4), its quantifiers' bounds (8). Its uniform entry takes a
     * descriptor for each quantifier, then each parameter *)
    let countFlagged(d: Desc which: All(flags: Int) Bool): Int =
        begin
            let var n = 0
            for i = 0 upto extent d.flags - 1 do if which(d.flags[i]) then n := n + 1 end end
            n
        end
    let funQuantifiers(d: Desc): Int = countFlagged(d fun(x: Int): Bool x is 8)
    let funArity(d: Desc): Int = countFlagged(d fun(x: Int): Bool {x isnot 4} andif {x isnot 8})
    (* A closure of type from seen at to, through an adapter of uniform arity
     * n (made by the backend), or as it is past the most it makes *)
    let adaptClosure(v: Any from: Desc to: Desc n: Int): Any = external "wasm.adaptClosure"

    (* A module's abstract type is held as its representation is
     * (quest_concrete_representation) *)
    let concreteRep(d: Desc): Desc =
        if d.kind is kindOpaque then
            let rep = abstractRep(d)
            if rep.kind is kindNone then d else storedType(rep) end
        else d
        end

    (* A variant's box seen at variant type to, from from: its tag renumbered
     * to to's for the case of the same name, and its payload converted when
     * the cases' types differ (quest_variant_adapt) *)
    let rec variantAdapt(v: Any from: Desc to: Desc): Any =
        begin
            let tag = variantTag(v)
            let j = if {tag >= 0} andif {tag < extent from.parts} then partNamed(to from.labels[tag]) else ~1 end
            if j < 0 then
                dynamicError()
                v
            else
                let fp = from.parts[tag]
                let tp = to.parts[j]
                let payload = if {fp.kind is kindNone} orif {tp.kind is kindNone} orif {fp is tp} then variantPayload(v)
                    else convert(variantPayload(v) fp tp)
                    end
                newVarBox(j payload)
            end
        end

    (* v, as a slot holds it, of type from, seen at type to (quest_convert):
     * a record's box with the table for its payload at to; a variant's box
     * adapted; anything else as it is, until tuples', options', and
     * functions' views are built *)
    and convert(v: Any from0: Desc to0: Desc): Any =
        begin
            let from = concreteRep(storedRep(from0))
            let to = concreteRep(storedRep(to0))
            if {to.kind is kindRecord} andif {from.kind is kindRecord} then
                let payload = recordPayload(v)
                newRecBox(payload viewDict(payload to))
            elsif {from is to} orif {from.kind isnot to.kind} then v
            elsif to.kind is kindVariant then variantAdapt(v from to)
            elsif to.kind is kindFun then
                (* the same type: nothing to adapt; else an adapter *)
                if isSubtype(to from) then v else adaptClosure(v from to funQuantifiers(to) + funArity(to)) end
            elsif {to.kind is kindTuple} orif {to.kind is kindOption} then
                if not(isProxy(v)) andif viewEquivalent(from to) andif proxiesAgree(from to) then v
                elsif mayBeProxied(to) then makeProxy(v from to)
                elsif isProxy(v) andif viewEquivalent(proxied(v).stored to) then proxied(v).orig
                else copyViewed(v from to)
                end
            else v
            end
        end

    and proxyElement(p: Any i: Int): Any =
        begin
            let s = proxied(p)
            let fe = s.stored.parts[i]
            let te = s.view.parts[i]
            if fe is te then slotOf(s.orig i) else convert(slotOf(s.orig i) fe te) end
        end
    and proxyOptionElement(p: Any i: Int): Any =
        begin
            let s = proxied(p)
            let tag = optionTagOf(s.orig)
            let fc = s.stored.parts[tag]
            let tc = s.view.parts[s.tags[tag]]
            convert(slotOf(s.orig i) elementType(fc i) elementType(tc i))
        end
    and elementAt(v: Any i: Int): Any = if isProxy(v) then proxyElement(v i) else slotOf(v i) end
    and optionElementAt(v: Any i: Int): Any = if isProxy(v) then proxyOptionElement(v i) else slotOf(v i) end

    (* A copy of the tuple or option v, of type from, laid out as to, which
     * values are never proxies of: its components converted
     * (quest_copy_viewed) *)
    (* An adapter's argument k (a descriptor for each quantifier, then the
     * parameters): a value parameter's converted from the adapter's type to
     * the closure's, contravariantly; a var or out parameter's location as
     * it is; and the result converted from the closure's to the adapter's *)
    and adaptArg(from: Desc to: Desc k: Int v: Any): Any =
        begin
            let q = funQuantifiers(to)
            if k < q then v
            else
                let i = k - q
                if {i < extent to.flags} andif {to.flags[i] is 0} then convert(v to.parts[i] from.parts[i]) else v end
            end
        end
    and adaptResult(from: Desc to: Desc v: Any): Any =
        begin
            let r = funArity(to)
            if {r < extent to.parts} andif {r < extent from.parts} then convert(v from.parts[r] to.parts[r]) else v end
        end

    and copyViewed(v: Any from: Desc to: Desc): Any =
        if to.kind is kindTuple then
            let n = extent to.parts
            let slots = array of(n v)
            for i = 0 upto n - 1 do
                slots[i] := if i < extent from.parts then convert(elementAt(v i) from.parts[i] to.parts[i])
                    else elementAt(v i)
                    end
            end
            newTupleOf(slots)
        else
            let tag = tagAt(v)
            let j = if {tag >= 0} andif {tag < extent from.parts} then partNamed(to from.labels[tag]) else ~1 end
            if j < 0 then
                dynamicError()
                v
            else
                let fc = from.parts[tag]
                let tc = to.parts[j]
                let n = if tc.kind is kindNone then 0
                    elsif storedType(tc).kind is kindTuple then extent storedType(tc).parts
                    else 1
                    end
                let slots = array of(n v)
                for i = 0 upto n - 1 do
                    slots[i] := convert(optionElementAt(v i) elementType(fc i) elementType(tc i))
                end
                newOptionOf(j slots)
            end
        end


    (* A record field read as its payload stores it, v, seen at to through
     * the table dict, which says whether it is stored at another type *)
    let storedField(v: Any dict: Any i: Int to: Desc): Any =
        begin
            let stored = dictStored(dict)
            if isNull(stored) then v
            else
                let ds = anyDescs(stored)
                if {i >= extent ds} orif {ds[i].kind is kindNone} then v else convert(v ds[i] to) end
            end
        end


    (* A view map (quest_view_map, docs/c-representation.md section 5.1):
     * generic code holds a value of a type parameter bounded by a record,
     * tuple, variant, or option type at its type argument's view, actual,
     * and reads it through the bound by the map. index: a record's, for each
     * of the bound's fields in name order, the field's index among actual's;
     * a variant's or option's, for each of actual's tags, the bound's for its
     * case. from and to: the types parts read through the bound are
     * converted from and to (none in from where they agree): a record's and
     * a tuple's, for each of the bound's fields or components; a variant's,
     * for each of the bound's cases, its payload; an option's, for each
     * component of each of the bound's cases, flattened, case b's first at
     * start[b] *)
    Def ViewMap = Tuple
        actual: Desc
        bound: Desc
        index: Array(Int)
        from: Array(Desc)
        to: Array(Desc)
        start: Array(Int)
    end
    let anyViewMap(x: Any): ViewMap = external "wasm.fromAny"
    let viewMapAny(m: ViewMap): Any = external "wasm.toAny"
    let viewMaps = tuple let var items = array of :ViewMap end let var count = 0 end

    (* The type a part read through the bound is converted from: none where
     * actual's agrees with the bound's (quest_view_from) *)
    let viewFrom(actual: Desc bound: Desc): Desc =
        begin
            let agrees = {actual is bound} orif {actual.kind is kindNone} orif {bound.kind is kindNone}
            if agrees orif isSubtype(bound actual) then bases[kindNone] else actual end
        end

    (* An option's case's components: its payload's parts if it is a tuple,
     * else the payload itself, else none *)
    let caseComponents(payload: Desc): Array(Desc) =
        if payload.kind is kindNone then array of :Desc end
        elsif storedType(payload).kind is kindTuple then storedType(payload).parts
        else array of payload end
        end

    let fillViewMap(actual: Desc bound: Desc): ViewMap =
        begin
            let none = bases[kindNone]
            let a = actual
            let b = bound
            if {a.kind is kindRecord} andif {b.kind is kindRecord} then
                let n = extent b.parts
                let index = array of(n ~1)
                let from = array of(n none)
                for k = 0 upto n - 1 do
                    let j = partNamed(a b.labels[k])
                    if j < 0 then dynamicError() end
                    index[k] := j
                    from[k] := viewFrom(a.parts[j] b.parts[k])
                end
                tuple let actual = a let bound = b let index = index let from = from let to = b.parts
                    let start = array of :Int end end
            elsif {a.kind is kindTuple} andif {b.kind is kindTuple} then
                let n = extent b.parts
                let from = array of(n none)
                for k = 0 upto n - 1 do
                    if k < extent a.parts then from[k] := viewFrom(a.parts[k] b.parts[k]) end
                end
                tuple let actual = a let bound = b let index = array of :Int end let from = from let to = b.parts
                    let start = array of :Int end end
            elsif {{a.kind is kindVariant} orif {a.kind is kindOption}} andif {b.kind is a.kind} then
                let index = array of(extent a.parts 0)
                for i = 0 upto extent a.parts - 1 do
                    let j = partNamed(b a.labels[i])
                    if j < 0 then dynamicError() end
                    index[i] := j
                end
                if a.kind is kindVariant then
                    let n = extent b.parts
                    let from = array of(n none)
                    for k = 0 upto n - 1 do
                        let i = partNamed(a b.labels[k])
                        if i >= 0 then from[k] := viewFrom(a.parts[i] b.parts[k]) end
                    end
                    tuple let actual = a let bound = b let index = index let from = from let to = b.parts
                        let start = array of :Int end end
                else
                    let nb = extent b.parts
                    let start = array of(nb + 1 0)
                    let var total = 0
                    for k = 0 upto nb - 1 do
                        start[k] := total
                        total := total + extent caseComponents(b.parts[k])
                    end
                    start[nb] := total
                    let from = array of(total none)
                    let to = array of(total none)
                    for k = 0 upto nb - 1 do
                        let tb = caseComponents(b.parts[k])
                        let i = partNamed(a b.labels[k])
                        let ta = if i >= 0 then caseComponents(a.parts[i]) else array of :Desc end end
                        for j = 0 upto extent tb - 1 do
                            to[start[k] + j] := tb[j]
                            if j < extent ta then from[start[k] + j] := viewFrom(ta[j] tb[j]) end
                        end
                    end
                    tuple let actual = a let bound = b let index = index let from = from let to = to
                        let start = start end
                end
            else
                dynamicError()
                tuple let actual = a let bound = b let index = array of :Int end let from = array of :Desc end
                    let to = array of :Desc end let start = array of :Int end end
            end
        end

    (* The view map of actual at bound, made once *)
    let viewMap(actual0: Desc bound0: Desc): Any =
        begin
            let actual = storedType(actual0)
            let bound = storedType(bound0)
            let var found = ~1
            for i = 0 upto viewMaps.count - 1 do
                let m = viewMaps.items[i]
                if {found < 0} andif {m.actual is actual} andif {m.bound is bound} then found := i end
            end
            if found >= 0 then viewMapAny(viewMaps.items[found])
            else
                let m = fillViewMap(actual bound)
                instances.updating := instances.updating + 1
                if viewMaps.count >= extent viewMaps.items then
                    let more = array of({2 * viewMaps.count} + 16 m)
                    for i = 0 upto viewMaps.count - 1 do more[i] := viewMaps.items[i] end
                    viewMaps.items := more
                end
                viewMaps.items[viewMaps.count] := m
                viewMaps.count := viewMaps.count + 1
                instances.updating := instances.updating - 1
                viewMapAny(m)
            end
        end

    (* Through a view map: entry i of its index (a record's field's index
     * among actual's, a tag in the bound's numbering); part i, as a slot
     * holds it, converted from actual's type for it to the bound's
     * (quest_view_part) *)
    let viewIndex(m: Any i: Int): Int = anyViewMap(m).index[i]
    let viewPart(m0: Any i: Int v: Any): Any =
        begin
            let m = anyViewMap(m0)
            if m.from[i].kind is kindNone then v else convert(v m.from[i] m.to[i]) end
        end

    (* Through the view map of a record type: the slot in the payload of
     * the bound's field k, and the field's value converted to the bound's
     * type for it, from the type the payload stores it at or actual's
     * (quest_view_record_field) *)
    let dictIndex(d: Any i: Int): Int = external "wasm.dictIndex"
    let payloadSlot(payload: Any i: Int): Any = external "wasm.recordSlot"
    let viewRecordSlot(dict: Any m: Any k: Int): Int = dictIndex(dict anyViewMap(m).index[k])
    let viewRecordField(payload: Any dict: Any m0: Any k: Int): Any =
        begin
            let m = anyViewMap(m0)
            let j = m.index[k]
            let v = payloadSlot(payload dictIndex(dict j))
            let stored = dictStored(dict)
            let ds = if isNull(stored) then array of :Desc end else anyDescs(stored) end
            if {j < extent ds} andif {ds[j].kind isnot kindNone} then convert(v ds[j] m.to[k])
            else viewPart(m0 k v)
            end
        end

    (* Through the view map of an option type: component j of the payload of
     * the option opt, of the bound's case b, converted to the bound's type
     * for it (quest_view_option_component) *)
    let optionSlot(opt: Any j: Int): Any = external "wasm.tupleSlot"
    (* Through the view map of an option type: the payload of the option
     * opt's case, as its case binder is, the original's payload seen at the
     * bound's case's type (quest_view_option_payload) *)
    let viewOptionPayload(opt: Any m0: Any): Any =
        begin
            let m = anyViewMap(m0)
            let orig = unproxy(opt)
            let stored = if isProxy(opt) then proxied(opt).stored else m.actual end
            let tag = optionTagOf(orig)
            convert(orig storedType(stored).parts[tag] m.bound.parts[m.index[tagAt(opt)]])
        end

    let viewOptionComponent(opt: Any m0: Any b: Int j: Int): Any =
        viewPart(m0 {anyViewMap(m0).start[b] + j} optionSlot(opt j))

    (* ======================================================================
     * Abstract types (quest_register_abstract_type, docs/dynamic.md section
     * 2.3): each module registers its abstract types' representations where
     * it begins, by the types' global names, so that is and the identity hash
     * compare a value as its representation's, and dynamic values write and
     * read it so
     * ====================================================================== *)

    (* The type is compares a value of type d at: a stored type's type, an
     * abstract type's representation (quest_identity_type) *)
    let identityType(d0: Desc): Desc =
        begin
            let var d = d0
            let var depth = 0
            while depth < 64 do
                let next = if d.kind is kindStored then storedType(d)
                    elsif d.kind is kindOpaque then abstractRep(d)
                    else d
                    end
                if {next is d} orif {next.kind is kindNone} then depth := 64
                else
                    d := next
                    depth := depth + 1
                end
            end
            d
        end

    (* An option's one case with one component that is not var, the others
     * without components: its tag, or ~1 (quest_single_word_case) *)
    let singleWordCase(d: Desc): Int =
        begin
            let var found = ~1
            let var single = true
            for i = 0 upto extent d.parts - 1 do
                let p = d.parts[i]
                let n = if p.kind is kindNone then 0
                    elsif storedType(p).kind is kindTuple then extent storedType(p).parts
                    else 1
                    end
                if n > 0 then
                    let varComponent = {storedType(p).kind is kindTuple} andif {n is 1} andif isVar(storedType(p) 0)
                    if {found >= 0} orif {n isnot 1} orif varComponent then single := false else found := i end
                end
            end
            if single then found else ~1 end
        end

    (* is on values of the type d describes, as slots hold them
     * (quest_val_is): the same reference or bits; an option by its case, or
     * a single-word option's component; a tuple as its original; a Real by
     * value *)
    let boxedIntOf(x: Any): Int = external "wasm.boxedInt"
    let isBoxedInt0(x: Any): Bool = external "wasm.isBoxedInt"
    let realOf(x: Any): Real = external "wasm.fromAny"
    let isBoxedReal(x: Any): Bool = external "wasm.isBoxedReal"
    let realEq(a: Real b: Real): Bool = external "wasm.realEq"
    let same0(a: Any b: Any): Bool = external "wasm.same"
    let rec valIs(d0: Desc a: Any b: Any): Bool =
        if same0(a b) then true
        elsif isBoxedInt0(a) andif isBoxedInt0(b) then boxedIntOf(a) is boxedIntOf(b)
        else
            let d = identityType(d0)
            if d.kind is kindOption then
                if same0(unproxy(a) unproxy(b)) then true
                else
                    let tag = tagAt(a)
                    if {tag isnot tagAt(b)} orif {tag < 0} orif {tag >= extent d.parts} then false
                    elsif d.parts[tag].kind is kindNone then true
                    elsif singleWordCase(d) isnot tag then false
                    else
                        let p = storedType(d.parts[tag])
                        let component = if p.kind is kindTuple then p.parts[0] else p end
                        valIs(component optionElementAt(a 0) optionElementAt(b 0))
                    end
                end
            elsif d.kind is kindTuple then same0(unproxy(a) unproxy(b))
            elsif {d.kind is kindReal} andif isBoxedReal(a) andif isBoxedReal(b) then realEq(realOf(a) realOf(b))
            else false
            end
        end

    (* ======================================================================
     * Auto values (docs/c-representation.md section 8.1)
     * ====================================================================== *)

    (* An auto value's witness's descriptor, its other components' tuple, and
     * a new one of the two *)
    let autoDescAny(x: Any): Any = external "wasm.autoDesc"
    let autoPayload(x: Any): Any = external "wasm.autoPayload"
    let newAuto(d: Any payload: Any): Any = external "wasm.newAuto"
    let autoWitness(x: Any): Desc = anyDesc(autoDescAny(x))

    (* dynamic.copy: a new dynamic value of the same witness, its one
     * component the same (quest_dynamic_copy) *)
    let dynamicCopy(d: Any): Any =
        begin
            let one = array of(1 slotOf(autoPayload(d) 0))
            newAuto(autoDescAny(d) newTupleOf(one))
        end

    (* ======================================================================
     * The library's externals in Quest
     * ====================================================================== *)

    (* A Char's code, an Int's bits shifted right with zeros, and xor *)
    let code(c: Char): Int = external "wasm.charCode"
    let shrU(n: Int k: Int): Int = external "wasm.shrU"
    let xor(a: Int b: Int): Int = external "wasm.xor"
    (* SplitMix64's finalizer, quest_hash_mix64 *)
    let mix(n: Int): Int = external "wasm.hashMix"
    (* What a value is, as a slot holds it: an i31, an Int's box (and its
     * value), a record's box (and its payload), an object with a hash (and
     * its hash, 0 until set), an option (and its tag) *)
    let isSmall(x: Any): Bool = external "wasm.isSmall"
    let smallValue(x: Any): Int = external "wasm.smallValue"
    let isBoxedInt(x: Any): Bool = external "wasm.isBoxedInt"
    let boxedInt(x: Any): Int = external "wasm.boxedInt"
    let isRecBox(x: Any): Bool = external "wasm.isRecBox"
    let recPayload(x: Any): Any = external "wasm.recPayload"
    let isObject(x: Any): Bool = external "wasm.isObject"
    let hashOf(x: Any): Int = external "wasm.hashOf"
    let setHash(x: Any h: Int): Ok = external "wasm.setHash"
    let optionTag(x: Any): Int = external "wasm.optionTag"
    let tupleSlot(x: Any i: Int): Any = external "wasm.tupleSlot"
    let decimal(n: Int): String = external "wasm.decimal"
    let convInt(n: Int): String = external "wasm.convInt"
    let charString(c: Char): String = external "wasm.charString"

    let stringError(): Ok = raise stringOp.error end

    let checkSub(s: String start: Int size: Int): Ok =
        if {start < 0} orif {size < 0} orif {{start + size} > stringOp.length(s)} then stringError() end

    let catSub(s1: String start1: Int size1: Int s2: String start2: Int size2: Int): String =
        begin
            checkSub(s1 start1 size1)
            checkSub(s2 start2 size2)
            stringOp.getSub(s1 start1 size1) <> stringOp.getSub(s2 start2 size2)
        end

    let conc(a: Array(String)): String =
        begin
            let var total = 0
            for i = 0 upto extent a - 1 do total := total + stringOp.length(a[i]) end
            let s = stringOp.new(total ' ')
            let var at = 0
            for i = 0 upto extent a - 1 do
                stringOp.setSub(s at a[i] 0 stringOp.length(a[i]))
                at := at + stringOp.length(a[i])
            end
            s
        end

    (* How the first size1 bytes of s1 from start1 compare with those of s2:
     * negative, zero, or positive, as memcmp then the lengths order them *)
    let compare(s1: String start1: Int size1: Int s2: String start2: Int size2: Int): Int =
        begin
            let n = if size1 < size2 then size1 else size2 end
            let var result = 0
            let var i = 0
            while {result is 0} andif {i < n} do
                result := code(stringOp.getChar(s1 start1 + i)) - code(stringOp.getChar(s2 start2 + i))
                i := i + 1
            end
            if result is 0 then size1 - size2 else result end
        end

    let equalSub(s1: String start1: Int size1: Int s2: String start2: Int size2: Int): Bool =
        begin
            checkSub(s1 start1 size1)
            checkSub(s2 start2 size2)
            compare(s1 start1 size1 s2 start2 size2) is 0
        end

    let precedes(s1: String s2: String): Bool =
        compare(s1 0 stringOp.length(s1) s2 0 stringOp.length(s2)) <= 0

    let precedesSub(s1: String start1: Int size1: Int s2: String start2: Int size2: Int): Bool =
        begin
            checkSub(s1 start1 size1)
            checkSub(s2 start2 size2)
            compare(s1 start1 size1 s2 start2 size2) <= 0
        end

    (* The objects' hashes, given out in order the first time each is asked
     * for (docs/wasm-plan.md section 2.8) *)
    let hashes = tuple let var next = 0 end

    let objectHash(x: Any): Int =
        begin
            let h = hashOf(x)
            if h isnot 0 then h
            else
                hashes.next := {hashes.next + 1} % 1073741824
                if hashes.next is 0 then hashes.next := 1 end
                setHash(x hashes.next)
                hashes.next
            end
        end

    (* quest_identity_hash: a value hashes by its bits (a scalar's), by its
     * tag and its component (an option of at most one), or by its identity
     * (an object's), so that values is takes as equal hash equally *)
    (* At the type is compares a value of type d at (identityType) *)
    let rec identityHash(d: Desc x: Any): Int = identityHashAt(identityType(d) x)
    and identityHashAt(d: Desc x: Any): Int =
        if {d.kind is kindOption} andif not(isSmall(x)) then
            let tag = tagAt(x)
            let p = if {tag >= 0} andif {tag < extent d.parts} then d.parts[tag] else bases[kindNone] end
            if {p.kind is kindNone} orif {p.kind is kindOk} orif {{p.kind is kindTuple} andif {extent p.parts is 0}} then
                mix(xor(~7046029254386353131 tag))
            elsif p.kind isnot kindTuple then mix(xor(tag identityHash(p optionElementAt(x 0))))
            elsif extent p.parts is 1 then mix(xor(tag identityHash(p.parts[0] optionElementAt(x 0))))
            else mix(objectHash(unproxy(x)))
            end
        elsif isSmall(x) then mix(smallValue(x))
        elsif isBoxedInt(x) then mix(boxedInt(x))
        elsif isRecBox(x) then mix(objectHash(recPayload(x)))
        elsif isObject(x) then mix(objectHash(unproxy(x)))
        else mix(0)
        end

    (* A string builder: its bytes, a string grown by doubling, and how many
     * of them are used *)
    Let Buffer = Tuple var bytes: String var length: Int end

    let sbNew(): Buffer = tuple let var bytes = stringOp.new(64 ' ') let var length = 0 end

    let reserve(b: Buffer n: Int): Ok =
        if {b.length + n} > stringOp.length(b.bytes) then
            let var size = stringOp.length(b.bytes) * 2
            while size < {b.length + n} do size := size * 2 end
            let more = stringOp.new(size ' ')
            stringOp.setSub(more 0 b.bytes 0 b.length)
            b.bytes := more
        end

    let sbAppendSub(b: Buffer s: String start: Int size: Int): Ok =
        begin
            checkSub(s start size)
            reserve(b size)
            stringOp.setSub(b.bytes b.length s start size)
            b.length := b.length + size
        end

    let sbAppendString(b: Buffer s: String): Ok = sbAppendSub(b s 0 stringOp.length(s))

    let sbAppendChar(b: Buffer c: Char): Ok =
        begin
            reserve(b 1)
            stringOp.setChar(b.bytes b.length c)
            b.length := b.length + 1
        end

    let sbAppendInt(b: Buffer n: Int): Ok = sbAppendString(b convInt(n))

    let sbAppendBool(b: Buffer v: Bool): Ok = sbAppendString(b if v then "true" else "false" end)

    (* A Word in decimal, unsigned: its bits halved, so that they are an Int
     * that is not negative, then a tenth and a last digit *)
    let sbAppendWord(b: Buffer w: Int): Ok =
        if w >= 0 then sbAppendString(b decimal(w))
        else
            let q = shrU(w 1) / 5
            let r = w - {q * 10}
            sbAppendString(b decimal(q))
            sbAppendString(b decimal(r))
        end

    let sbAppendRepeat(b: Buffer c: Char n: Int): Ok =
        begin
            if n < 0 then stringError() end
            reserve(b n)
            for i = 0 upto n - 1 do stringOp.setChar(b.bytes b.length + i c) end
            b.length := b.length + n
        end

    let sbClear(b: Buffer): Ok = b.length := 0

    let sbLength(b: Buffer): Int = b.length

    let sbToString(b: Buffer): String = stringOp.getSub(b.bytes 0 b.length)

    (* ======================================================================
     * WASI
     * ====================================================================== *)

    (* The base's memory, at i64 addresses, and WASI's functions, each giving
     * its errno (0 for success) *)
    let load8(a: Int): Int = external "wasm.base.memLoad8"
    let load32(a: Int): Int = external "wasm.base.memLoad32"
    let load64(a: Int): Int = external "wasm.base.memLoad64"
    let store32(a: Int v: Int): Ok = external "wasm.base.memStore32"
    let store64(a: Int v: Int): Ok = external "wasm.base.memStore64"
    let ensure(a: Int): Ok = external "wasm.base.memEnsure"
    let memString(a: Int n: Int): String = external "wasm.base.memToString"
    let toMemory(s: String a: Int): Ok = external "wasm.base.stringToMem"
    let argsSizesGet(a: Int b: Int): Int = external "wasm.base.wasi:args_sizes_get"
    let argsGet(a: Int b: Int): Int = external "wasm.base.wasi:args_get"
    let environSizesGet(a: Int b: Int): Int = external "wasm.base.wasi:environ_sizes_get"
    let environGet(a: Int b: Int): Int = external "wasm.base.wasi:environ_get"
    let prestatGet(fd: Int a: Int): Int = external "wasm.base.wasi:fd_prestat_get"
    let prestatDirName(fd: Int a: Int n: Int): Int = external "wasm.base.wasi:fd_prestat_dir_name"
    let pathOpen(fd: Int dirflags: Int a: Int n: Int oflags: Int base: Int inheriting: Int fdflags: Int into: Int): Int =
        external "wasm.base.wasi:path_open"
    let fdRead(fd: Int iovs: Int count: Int into: Int): Int = external "wasm.base.wasi:fd_read"
    let fdClose(fd: Int): Int = external "wasm.base.wasi:fd_close"
    let pathFilestatGet(fd: Int flags: Int a: Int n: Int into: Int): Int = external "wasm.base.wasi:path_filestat_get"
    let pathCreateDirectory(fd: Int a: Int n: Int): Int = external "wasm.base.wasi:path_create_directory"
    let pathUnlinkFile(fd: Int a: Int n: Int): Int = external "wasm.base.wasi:path_unlink_file"
    let pathRemoveDirectory(fd: Int a: Int n: Int): Int = external "wasm.base.wasi:path_remove_directory"
    let pathRename(fd: Int a: Int n: Int fd2: Int b: Int m: Int): Int = external "wasm.base.wasi:path_rename"
    let fdReaddir(fd: Int a: Int n: Int cookie: Int into: Int): Int = external "wasm.base.wasi:fd_readdir"
    let intAny(n: Int): Any = external "wasm.toAny"
    let anyInt(x: Any): Int = external "wasm.fromAny"

    (* The memory's layout for these calls: results at 64 and up, a path at
     * 1024, and a buffer after it *)
    let results = 64
    let pathAt = 1024
    let bufferAt = 8192
    let bufferSize = 65536

    (* The NUL-terminated strings at a: n of them *)
    let cStrings(a: Int n: Int): Array(String) =
        begin
            let all = array of(n "")
            for i = 0 upto n - 1 do
                let p = load32(a + {4 * i})
                let var stop = p
                while load8(stop) isnot 0 do stop := stop + 1 end
                all[i] := memString(p stop - p)
            end
            all
        end

    let systemArgs(): Array(String) =
        begin
            argsSizesGet(results results + 4)
            let count = load32(results)
            let size = load32(results + 4)
            ensure({bufferAt + {4 * count}} + size)
            argsGet(bufferAt bufferAt + {4 * count})
            cStrings(bufferAt count)
        end

    (* The environment, read once: WASI's does not change as a program runs *)
    let environ = tuple let var read = false let var all = array of :String end end

    let rec environment(): Array(String) =
        if environ.read then environ.all
        else
            environ.all := readEnvironment()
            environ.read := true
            environ.all
        end

    and readEnvironment(): Array(String) =
        begin
            environSizesGet(results results + 4)
            let count = load32(results)
            let size = load32(results + 4)
            ensure({bufferAt + {4 * count}} + size)
            environGet(bufferAt bufferAt + {4 * count})
            cStrings(bufferAt count)
        end

    let startsWith(s: String prefix: String): Bool =
        {stringOp.length(s) >= stringOp.length(prefix)}
            andif stringOp.equal(stringOp.getSub(s 0 stringOp.length(prefix)) prefix)

    let getEnv(name: String): String =
        begin
            let env = environment()
            let var found = ""
            for i = 0 upto extent env - 1 do
                if startsWith(env[i] name <> "=") then
                    let n = stringOp.length(name) + 1
                    found := stringOp.getSub(env[i] n stringOp.length(env[i]) - n)
                end
            end
            found
        end

    (* The directories the host opens, by name, found the first time *)
    Def Preopen = Tuple fd: Int name: String end
    let opened = tuple let var found = false let var all = array of :Preopen end let var cwd = "" end

    let preopens(): Array(Preopen) =
        begin
            if not(opened.found) then
                let var fd = 3
                let var more = true
                let var all = array of :Preopen end
                while more do
                    if prestatGet(fd results) isnot 0 then more := false
                    else
                        let n = load32(results + 4)
                        ensure(pathAt + n)
                        prestatDirName(fd pathAt n)
                        let more2 = array of({extent all} + 1 tuple let fd = fd let name = memString(pathAt n) end)
                        for i = 0 upto extent all - 1 do more2[i] := all[i] end
                        all := more2
                        fd := fd + 1
                    end
                end
                opened.all := all
                opened.found := true
                opened.cwd := getEnv("PWD")
            end
            opened.all
        end

    (* path made absolute against the current directory, if there is one *)
    let absolute(path: String): String =
        begin
            preopens()
            if startsWith(path "/") orif stringOp.isEmpty(opened.cwd) then path
            elsif stringOp.equal(path ".") then opened.cwd
            else opened.cwd <> "/" <> path
            end
        end

    (* The directory a path is opened from and the path relative to it:
     * an absolute path's from /, a relative one's from . *)
    Def Resolved = Tuple fd: Int path: String end
    let resolve(path: String): Resolved =
        begin
            let full = absolute(path)
            let all = preopens()
            let var fd = ~1
            let var rest = full
            for i = 0 upto extent all - 1 do
                if startsWith(full "/") then
                    if stringOp.equal(all[i].name "/") then
                        fd := all[i].fd
                        rest := stringOp.getSub(full 1 stringOp.length(full) - 1)
                    end
                elsif stringOp.equal(all[i].name ".") then fd := all[i].fd
                end
            end
            if stringOp.isEmpty(rest) then rest := "." end
            tuple let fd = fd let path = rest end
        end

    (* path written at pathAt, and its length *)
    let pathArg(path: String): Int =
        begin
            ensure(pathAt + stringOp.length(path))
            toMemory(path pathAt)
            stringOp.length(path)
        end

    (* The file type of what path names, or ~1 for none: 3 a directory, 4 a
     * regular file *)
    let fileType(path: String): Int =
        begin
            let r = resolve(path)
            if r.fd < 0 then ~1
            else
                let n = pathArg(r.path)
                let fd = r.fd
                let errno = pathFilestatGet(fd 1 pathAt n results)
                if errno isnot 0 then ~1 else load8(results + 16) end
            end
        end

    let fileExists(path: String): Bool = fileType(path) >= 0
    let isFile(path: String): Bool = fileType(path) is 4
    let isDirectory(path: String): Bool = fileType(path) is 3

    let systemError(): Ok = raise system.error end

    Def Stat = Tuple
        kind: Int size: Int mode: Int accessTime: Real modifiedTime: Real changeTime: Real accessNs: Int
        modifiedNs: Int changeNs: Int
    end

    (* Seconds, as Python computes st_mtime from st_mtime_ns *)
    let seconds(ns: Int): Real = realOp.int(ns / 1000000000) ++ {realOp.int(ns % 1000000000) ** 0.000000001}

    let fileStat(path: String follow: Bool): Stat =
        begin
            let r = resolve(path)
            let errno = if r.fd < 0 then 44
                else
                    let n = pathArg(r.path)
                    let fd = r.fd
                    pathFilestatGet(fd if follow then 1 else 0 end pathAt n results)
                end
            if errno isnot 0 then
                (* none for ENOENT and ENOTDIR, system.error for the rest *)
                if {errno isnot 44} andif {errno isnot 54} then systemError() end
                tuple
                    let kind = ~1 let size = 0 let mode = 0 let accessTime = 0.0 let modifiedTime = 0.0
                    let changeTime = 0.0 let accessNs = 0 let modifiedNs = 0 let changeNs = 0
                end
            else
                let type = load8(results + 16)
                let kind = if type is 4 then 0 elsif type is 3 then 1 elsif type is 7 then 2 else 3 end
                let at = load64(results + 40)
                let mt = load64(results + 48)
                let ct = load64(results + 56)
                tuple
                    let kind = kind let size = load64(results + 32) let mode = if kind is 1 then 493 else 420 end
                    let accessTime = seconds(at) let modifiedTime = seconds(mt) let changeTime = seconds(ct)
                    let accessNs = at let modifiedNs = mt let changeNs = ct
                end
            end
        end

    (* An operation on a path: its errno, with system.error for a path no
     * opened directory holds *)
    let onPath(path: String op: All(fd: Int n: Int) Int): Ok =
        begin
            let r = resolve(path)
            if r.fd < 0 then systemError() end
            if op(r.fd pathArg(r.path)) isnot 0 then systemError() end
        end

    (* Each directory along path made, as quest_mkdir_recursive makes them,
     * one that exists already (EEXIST, 20) left as it is *)
    let makeDirectory(path: String): Ok =
        begin
            if stringOp.isEmpty(path) then systemError() end
            let make = fun(p: String): Ok
                onPath(p fun(fd: Int n: Int): Int
                    begin
                        let errno = pathCreateDirectory(fd pathAt n)
                        if errno is 20 then 0 else errno end
                    end)
            for i = 1 upto stringOp.length(path) - 1 do
                if stringOp.getChar(path i) is '/' then make(stringOp.getSub(path 0 i)) end
            end
            make(path)
        end
    let removeFile(path: String): Ok = onPath(path fun(fd: Int n: Int): Int pathUnlinkFile(fd pathAt n))
    let removeDirectory(path: String): Ok = onPath(path fun(fd: Int n: Int): Int pathRemoveDirectory(fd pathAt n))

    let renameFile(from: String to: String): Ok =
        begin
            let a = resolve(from)
            let b = resolve(to)
            if {a.fd < 0} orif {b.fd < 0} then systemError() end
            let n = stringOp.length(a.path)
            let m = stringOp.length(b.path)
            ensure({pathAt + n} + m)
            toMemory(a.path pathAt)
            toMemory(b.path pathAt + n)
            if pathRename(a.fd pathAt n b.fd {pathAt + n} m) isnot 0 then systemError() end
        end

    let currentDirectory(): String =
        begin
            preopens()
            if stringOp.isEmpty(opened.cwd) then systemError() end
            opened.cwd
        end

    (* The current directory: path made absolute, with its . and .. parts
     * resolved, if it names a directory *)
    let changeDirectory(path: String): Ok =
        begin
            let full = absolute(path)
            if not(isDirectory(full)) then systemError() end
            let parts = array of(stringOp.length(full) + 1 "")
            let var count = 0
            let var start = 0
            for i = 0 upto stringOp.length(full) do
                if {i is stringOp.length(full)} orif {stringOp.getChar(full i) is '/'} then
                    let part = stringOp.getSub(full start i - start)
                    if stringOp.equal(part "..") then if count > 0 then count := count - 1 end
                    elsif not(stringOp.isEmpty(part)) andif not(stringOp.equal(part ".")) then
                        parts[count] := part
                        count := count + 1
                    end
                    start := i + 1
                end
            end
            let var cwd = ""
            for i = 0 upto count - 1 do cwd := cwd <> "/" <> parts[i] end
            opened.cwd := if stringOp.isEmpty(cwd) then "/" else cwd end
        end

    (* fd, opened from path's directory with oflags (1 to create, 2 for a
     * directory, 8 to truncate), with the rights to read, write, seek, tell,
     * and stat a file, or to list and stat a directory; ~1 if it cannot be *)
    let open(path: String oflags: Int): Int =
        begin
            let r = resolve(path)
            if r.fd < 0 then ~1
            else
                let n = pathArg(r.path)
                let rights = if {oflags % 4} >= 2 then 2113536 else 2113638 end
                if pathOpen(r.fd 1 pathAt n oflags rights 0 0 results) isnot 0 then ~1
                else load32(results)
                end
            end
        end

    (* Sorts names in place, as strcmp orders them *)
    let sort(names: Array(String)): Ok =
        for i = 1 upto extent names - 1 do
            let x = names[i]
            let var j = i - 1
            while {j >= 0} andif not(precedes(names[j] x)) do
                names[j + 1] := names[j]
                j := j - 1
            end
            names[j + 1] := x
        end

    let listDirectory(path: String): Array(String) =
        begin
            let fd = open(path 2)
            if fd < 0 then systemError() end
            let var names = array of :String end
            let var cookie = 0
            let var more = true
            ensure(bufferAt + bufferSize)
            while more do
                if fdReaddir(fd bufferAt bufferSize cookie results) isnot 0 then
                    fdClose(fd)
                    systemError()
                end
                let used = load32(results)
                let var at = bufferAt
                let var whole = true
                while whole andif {{at + 24} <= {bufferAt + used}} do
                    let length = load32(at + 16)
                    if {{at + 24} + length} > {bufferAt + used} then whole := false
                    else
                        let name = memString(at + 24 length)
                        cookie := load64(at)
                        if not(stringOp.equal(name ".")) andif not(stringOp.equal(name "..")) then
                            let more2 = array of({extent names} + 1 name)
                            for i = 0 upto extent names - 1 do more2[i] := names[i] end
                            names := more2
                        end
                        at := {at + 24} + length
                    end
                end
                more := used is bufferSize
            end
            fdClose(fd)
            sort(names)
            names
        end

    let writerError(): Ok = raise writer.error end

    let writerFile(name: String): Any =
        begin
            let fd = open(name 9)
            if fd < 0 then writerError() end
            intAny(fd)
        end

    let writerClose(w: Any): Ok =
        begin
            let fd = anyInt(w)
            if fd > 2 then fdClose(fd) end
            ok
        end

    (* A reader: its file descriptor, the bytes read and not yet taken, and
     * whether it is closed *)
    Let Reader = Tuple fd: Int var buffer: String var at: Int var closed: Bool end
    let input = tuple let fd = 0 let var buffer = "" let var at = 0 let var closed = false end

    let readerError(): Ok = raise reader.error end

    let readerInput(): Reader = input

    let readerFile(name: String): Reader =
        begin
            let fd = open(name 0)
            if fd < 0 then readerError() end
            tuple let fd = fd let var buffer = "" let var at = 0 let var closed = false end
        end

    (* Whether r has bytes not yet taken, reading more if it has none *)
    let fill(r: Reader): Bool =
        begin
            if r.closed then readerError() end
            if r.at >= stringOp.length(r.buffer) then
                ensure(bufferAt + bufferSize)
                store32(results bufferAt)
                store32(results + 4 bufferSize)
                if fdRead(r.fd results 1 results + 8) isnot 0 then readerError() end
                r.buffer := memString(bufferAt load32(results + 8))
                r.at := 0
            end
            r.at < stringOp.length(r.buffer)
        end

    let readerMore(r: Reader): Bool = fill(r)
    (* The character read last read again: one character of lookahead *)
    let readerUnget(r: Reader): Ok = if r.at > 0 then r.at := r.at - 1 end

    let readerGetChar(r: Reader): Char =
        begin
            if not(fill(r)) then readerError() end
            let c = stringOp.getChar(r.buffer r.at)
            r.at := r.at + 1
            c
        end

    (* Up to size bytes, fewer only at the end *)
    let readerGetString(r: Reader size: Int): String =
        begin
            if size < 0 then readerError() end
            let b = sbNew()
            while {sbLength(b) < size} andif fill(r) do
                let n = if {stringOp.length(r.buffer) - r.at} < {size - sbLength(b)} then
                        stringOp.length(r.buffer) - r.at
                    else size - sbLength(b)
                    end
                sbAppendSub(b r.buffer r.at n)
                r.at := r.at + n
            end
            sbToString(b)
        end

    let readerGetSubString(r: Reader s: String start: Int size: Int): Ok =
        begin
            if {start < 0} orif {size < 0} orif {{start + size} > stringOp.length(s)} then readerError() end
            let got = readerGetString(r size)
            if stringOp.length(got) < size then readerError() end
            stringOp.setSub(s start got 0 size)
        end

    let readerClose(r: Reader): Ok =
        begin
            if not(r.closed) then
                if r.fd > 2 then fdClose(r.fd) end
                r.closed := true
            end
            ok
        end
end
