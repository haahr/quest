(* Quest WebAssembly Runtime: Printing Values Interface
 *
 * The runtime's upper layer (docs/wasm-plan.md section 4.2): values written
 * by their descriptors, as the interpreters and the C runtime's quest_print.c
 * write them, for echo and for an uncaught exception's payload. A unit that
 * echoes such a value imports it; the backend adds the import. *)

unsound interface Print
import
    wasm/core : wasm/Core
export
    (* The value v of the type d describes, as text *)
    show(v: core.Any d: core.Desc): String
    (* Writes prefix, v as show writes it, suffix, and a newline, as
     * quest_print_typed does, with echoText *)
    echo(prefix: String v: core.Any d: core.Desc suffix: String): Ok
    (* Writes an echo's text: to standard output, or, while a capture is on,
     * to the capture, which a phrase unit's echoes are written with
     * (docs/wasm-plan.md step 13) *)
    echoText(text: String): Ok
    (* Starts a capture, forgetting what an earlier one held *)
    capture(): Ok
    (* Ends the capture: what it held *)
    captured(): String
end
