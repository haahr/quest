(* What every converted benchmark needs: how many times to do its work, and
 * the exception it raises when a result is wrong (SML's Fail "bug") *)

interface Bench
export
    (* The program's first argument, or 1 if it has none *)
    count(): Int
    (* Whether the first argument is testit: a benchmark from the SML/NJ suite
     * then runs its testit, which prints its results, rather than its doit *)
    testit(): Bool
    (* Raised when a benchmark computes a wrong result *)
    bug: Exception
end
