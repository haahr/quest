(* SML's IntInf: integers of any size, as the benchmarks use them (MLton's
 * IntInf is GMP; this is schoolbook arithmetic in Quest) *)

interface IntInf
import util/maybe : util/Maybe
export
    T::TYPE

    fromInt(n: Int): T
    (* Raises overflow if t is outside Int's range *)
    toInt(t: T): Int
    overflow: Exception

    (* IntInf.toString: decimal, with ~ for negatives *)
    toString(t: T): String
    (* IntInf.fromString: an optional sign (~, -, or +) and digits, after any
     * whitespace; none if s does not start with them *)
    fromString(s: String): maybe.T(T)

    add(a: T b: T): T
    sub(a: T b: T): T
    mul(a: T b: T): T
    (* ~ *)
    neg(a: T): T
    abs(a: T): T
    (* Truncating division and its remainder (quot, rem), and flooring
     * division and its modulus (div, mod); each raises div by zero *)
    quot(a: T b: T): T
    rem(a: T b: T): T
    div(a: T b: T): T
    mod(a: T b: T): T
    divide: Exception

    equal(a: T b: T): Bool
    less(a: T b: T): Bool
    (* ~1, 0, or 1, as a is less than, equal to, or greater than b *)
    compare(a: T b: T): Int
end
