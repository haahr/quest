module reals : Reals
import
    util/maybe : util/Maybe
    util/strutil : util/Strutil
    util/stringBuilder : util/StringBuilder
    stringOp = string : StringOp
    real : RealOp
    conv : Conv
export
    let negInfinity = 0.0 -- real.infinity

    let sign(r: Real): String = if r << 0.0 then "~" else "" end

    (* |r|, with ~0.0 as 0.0, which SML writes without a sign *)
    let magnitude(r: Real): Real = if r is 0.0 then 0.0 else real.abs(r) end

    (* SML writes an exponent as E6 or E~1; conv.int writes ~ too *)
    let exponent(e: Int): String = "E" <> conv.int(e)

    (* The significant digits of a nonnegative real rounded to n of them, and
     * the exponent of the first: printf's %.{n-1}e, taken apart *)
    Let Decimal = Tuple digits: String exp: Int end
    let decompose(a: Real n: Int): Decimal =
        begin
            let s = real.format(a 'e' n - 1)
            let e = strutil.find(s "e")
            let mantissa = stringOp.getSub(s 0 e)
            tuple
                let digits = strutil.replace(mantissa "." "")
                let exp = strutil.toInt(stringOp.getSub(s e + 1 {stringOp.length(s) - e} - 1))
            end
        end

    let zeros(n: Int): String = if n > 0 then stringOp.new(n '0') else "" end

    let special(r: Real f: All(r: Real) String): String =
        if r is real.infinity then "inf" elsif r is negInfinity then "~inf" else f(r) end

    let fmtGen(r: Real digits: Int): String =
        special(r fun(r: Real): String
            if r is 0.0 then "0"
            else
                begin
                    let d = decompose(magnitude(r) digits)
                    (* Without trailing zeros *)
                    let var k = stringOp.length(d.digits)
                    while {k > 1} andif {stringOp.getChar(d.digits k - 1) is '0'} do k := k - 1 end
                    let ds = stringOp.getSub(d.digits 0 k)
                    let e = d.exp
                    let sci = stringOp.getSub(ds 0 1) <> {if k > 1 then "." <> stringOp.getSub(ds 1 k - 1) else "" end}
                        <> exponent(e)
                    let fix =
                        if e >= 0 then
                            if k <= {e + 1} then ds <> zeros({e + 1} - k)
                            else stringOp.getSub(ds 0 e + 1) <> "." <> stringOp.getSub(ds e + 1 {k - e} - 1)
                            end
                        else "0." <> zeros({0 - e} - 1) <> ds
                        end
                    sign(r) <> {if stringOp.length(sci) < stringOp.length(fix) then sci else fix end}
                end
            end)

    let toString(r: Real): String = fmtGen(r 12)

    let fmtSci(r: Real digits: Int): String =
        special(r fun(r: Real): String
            begin
                let d = decompose(magnitude(r) digits + 1)
                let point = if digits > 0 then "." <> stringOp.getSub(d.digits 1 digits) else "" end
                sign(r) <> stringOp.getSub(d.digits 0 1) <> point <> exponent(if r is 0.0 then 0 else d.exp end)
            end)

    let fmtFix(r: Real digits: Int): String =
        special(r fun(r: Real): String sign(r) <> real.format(magnitude(r) 'f' digits))

    let isDigit(c: Char): Bool = strutil.isDigit(c)

    let fromString(s: String): maybe.T(Real) =
        begin
            let n = stringOp.length(s)
            let var i = 0
            while {i < n} andif strutil.isSpace(stringOp.getChar(s i)) do i := i + 1 end
            let b = stringBuilder.new()
            if {i < n} andif {{stringOp.getChar(s i) is '~'} orif {stringOp.getChar(s i) is '-'}} then
                b.char('-') i := i + 1
            elsif {i < n} andif {stringOp.getChar(s i) is '+'} then
                i := i + 1
            end
            let start = i
            while {i < n} andif isDigit(stringOp.getChar(s i)) do b.char(stringOp.getChar(s i)) i := i + 1 end
            let var fracDigits = 0
            if {{i + 1} < n} andif {stringOp.getChar(s i) is '.'} andif isDigit(stringOp.getChar(s i + 1)) then
                b.char('.') i := i + 1
                while {i < n} andif isDigit(stringOp.getChar(s i)) do
                    b.char(stringOp.getChar(s i)) i := i + 1 fracDigits := fracDigits + 1
                end
            end
            if {i is start} then maybe.none(:Real)
            else
                begin
                    (* An exponent, if digits follow its sign *)
                    if {i < n} andif {{stringOp.getChar(s i) is 'e'} orif {stringOp.getChar(s i) is 'E'}} then
                        let var j = i + 1
                        let negative = {j < n}
                            andif {{stringOp.getChar(s j) is '~'} orif {stringOp.getChar(s j) is '-'}}
                        if {j < n} andif {negative orif {stringOp.getChar(s j) is '+'}} then j := j + 1 end
                        if {j < n} andif isDigit(stringOp.getChar(s j)) then
                            b.char('e')
                            if negative then b.char('-') end
                            while {j < n}
                                andif isDigit(stringOp.getChar(s j)) do b.char(stringOp.getChar(s j)) j := j + 1 end
                        end
                    end
                    maybe.some(:Real strutil.toReal(b.toString()))
                end
            end
        end
end
