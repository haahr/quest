module bench : Bench
import
    system : System
    util/strutil : util/Strutil
    stringOp = string : StringOp
export
    let testit(): Bool = {extent system.args > 1} andif stringOp.equal(system.args[1] "testit")

    let count(): Int = if {extent system.args > 1} andif not(testit()) then strutil.toInt(system.args[1]) else 1 end

    let bug: Exception = exception bug: Ok end
end
