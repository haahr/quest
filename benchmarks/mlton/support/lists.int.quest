(* SML's lists and the functions of its List structure that the benchmarks
 * use, with SML's names; functions SML curries take one parameter list here,
 * as the Basis's uncurried ones do *)

interface Lists
export
    Def Rec T(A::TYPE) = Option nil cons with hd: A tl: T(A) end end

    (* Raised by hd, tl, and nth (SML's Empty and Subscript) *)
    empty: Exception
    subscript: Exception

    nil(A::TYPE): T(A)
    cons(A::TYPE)(hd: A tl: T(A)): T(A)
    null(A::TYPE)(l: T(A)): Bool
    hd(A::TYPE)(l: T(A)): A
    tl(A::TYPE)(l: T(A)): T(A)
    length(A::TYPE)(l: T(A)): Int
    (* l1 @ l2 *)
    append(A::TYPE)(l1: T(A) l2: T(A)): T(A)
    rev(A::TYPE)(l: T(A)): T(A)
    revAppend(A::TYPE)(l1: T(A) l2: T(A)): T(A)
    nth(A::TYPE)(l: T(A) i: Int): A
    (* The first i elements, and the rest; each raises subscript if l is
     * shorter than i *)
    take(A::TYPE)(l: T(A) i: Int): T(A)
    drop(A::TYPE)(l: T(A) i: Int): T(A)
    tabulate(A::TYPE)(n: Int f: All(i: Int) A): T(A)
    fromArray(A::TYPE)(a: Array(A)): T(A)
    map(A::TYPE B::TYPE)(f: All(a: A) B l: T(A)): T(B)
    app(A::TYPE)(f: All(a: A) Ok l: T(A)): Ok
    filter(A::TYPE)(f: All(a: A) Bool l: T(A)): T(A)
    exists(A::TYPE)(f: All(a: A) Bool l: T(A)): Bool
    all(A::TYPE)(f: All(a: A) Bool l: T(A)): Bool
    foldl(A::TYPE B::TYPE)(f: All(a: A b: B) B b: B l: T(A)): B
    foldr(A::TYPE B::TYPE)(f: All(a: A b: B) B b: B l: T(A)): B
end
