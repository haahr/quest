(* SML's conversions between reals and strings, as MLton writes and reads
 * them: ~ for negation, E for the exponent *)

interface Reals
import util/maybe : util/Maybe
export
    (* Real.toString: Real.fmt (StringCvt.GEN NONE) *)
    toString(r: Real): String
    (* Real.fmt (StringCvt.GEN (SOME digits)): digits significant digits, as
     * fixed point or scientific notation, whichever is shorter, without
     * trailing zeros *)
    fmtGen(r: Real digits: Int): String
    (* Real.fmt (StringCvt.SCI (SOME digits)): one digit, a point, digits
     * digits, and the exponent *)
    fmtSci(r: Real digits: Int): String
    (* Real.fmt (StringCvt.FIX (SOME digits)): digits digits after the point *)
    fmtFix(r: Real digits: Int): String
    (* Real.fromString: SML's syntax, with ~ or - for negation, after any
     * whitespace; none if s does not start with a real *)
    fromString(s: String): maybe.T(Real)
end
