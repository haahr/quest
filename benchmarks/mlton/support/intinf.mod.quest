module intInf : IntInf
import
    util/maybe : util/Maybe
    util/strutil : util/Strutil
    stringOp = string : StringOp
    ascii : Ascii
    conv : Conv
export
    (* A sign and a magnitude, little-endian limbs in base 10^9 with no high
     * zero limbs (zero is no limbs, and not negative) *)
    Let T = Tuple neg: Bool mag: Array(Int) end
    Let Mag = Array(Int)

    let base = 1000000000
    let baseDigits = 9

    let overflow: Exception = exception overflow: Ok end
    let divide: Exception = exception divide: Ok end

    let empty: Mag = array of :Int end

    (* m without its high zero limbs *)
    let trim(m: Mag): Mag =
        begin
            let var n = extent m
            while {n > 0} andif {m[n - 1] is 0} do n := n - 1 end
            if n is extent m then m
            else
                begin
                    let r = array of(n 0)
                    for i = 0 upto n - 1 do r[i] := m[i] end
                    r
                end
            end
        end

    let make(neg: Bool mag: Mag): T =
        begin
            let m = trim(mag)
            tuple let neg = neg andif {extent m > 0} let mag = m end
        end

    (* Magnitudes *)

    let compareMag(a: Mag b: Mag): Int =
        if extent a isnot extent b then if extent a < extent b then ~1 else 1 end
        else
            begin
                let var i = extent a - 1
                while {i >= 0} andif {a[i] is b[i]} do i := i - 1 end
                if i < 0 then 0 elsif a[i] < b[i] then ~1 else 1 end
            end
        end

    let addMag(a: Mag b: Mag): Mag =
        begin
            let n = if extent a > extent b then extent a else extent b end
            let r = array of(n + 1 0)
            let var carry = 0
            for i = 0 upto n - 1 do
                let s = {if i < extent a then a[i] else 0 end} + {if i < extent b then b[i] else 0 end} + carry
                if s >= base then begin r[i] := s - base carry := 1 end else begin r[i] := s carry := 0 end end
            end
            r[n] := carry
            r
        end

    (* a - b, for a >= b *)
    let subMag(a: Mag b: Mag): Mag =
        begin
            let r = array of(extent a 0)
            let var borrow = 0
            for i = 0 upto extent a - 1 do
                let d = {a[i] - {if i < extent b then b[i] else 0 end}} - borrow
                if d < 0 then begin r[i] := d + base borrow := 1 end else begin r[i] := d borrow := 0 end end
            end
            r
        end

    let mulMag(a: Mag b: Mag): Mag =
        if {extent a is 0} orif {extent b is 0} then empty
        else
            begin
                let r = array of(extent a + extent b 0)
                for i = 0 upto extent a - 1 do
                    let ai = a[i]
                    let var carry = 0
                    for j = 0 upto extent b - 1 do
                        let t = r[i + j] + {ai * b[j]} + carry
                        r[i + j] := t % base
                        carry := t / base
                    end
                    r[i + extent b] := carry
                end
                r
            end
        end

    (* a * m, for 0 <= m < base *)
    let mulSmall(a: Mag m: Int): Mag =
        begin
            let r = array of(extent a + 1 0)
            let var carry = 0
            for i = 0 upto extent a - 1 do
                let t = {a[i] * m} + carry
                r[i] := t % base
                carry := t / base
            end
            r[extent a] := carry
            r
        end

    Let DivMod = Tuple q: Mag r: Mag end

    (* a divided by d, for 0 < d < base *)
    let divSmall(a: Mag d: Int): Tuple q: Mag r: Int end =
        begin
            let q = array of(extent a 0)
            let var r = 0
            for i = extent a - 1 downto 0 do
                let t = {r * base} + a[i]
                q[i] := t / d
                r := t % d
            end
            tuple let q = q let r = r end
        end

    (* a divided by b, for b not zero: Knuth's algorithm D (The Art of
     * Computer Programming, volume 2, section 4.3.1) *)
    let divModMag(a: Mag b: Mag): DivMod =
        if compareMag(a b) < 0 then tuple let q = empty let r = a end
        elsif extent b is 1 then
            begin
                let d = divSmall(a b[0])
                tuple let q = d.q let r = array of d.r end end
            end
        else
            begin
                let n = extent b
                let m = extent a - n
                (* Normalize, so that the divisor's top limb is at least base/2 *)
                let f = base / {b[n - 1] + 1}
                let u = mulSmall(a f)
                let v = trim(mulSmall(b f))
                let q = array of(m + 1 0)
                let vTop = v[n - 1]
                let vNext = v[n - 2]
                for j = m downto 0 do
                    let num = {u[j + n] * base} + u[{j + n} - 1]
                    let var qhat = num / vTop
                    let var rhat = num % vTop
                    loop
                        if {qhat >= base} orif {{qhat * vNext} > {{rhat * base} + u[{j + n} - 2]}} then
                            qhat := qhat - 1
                            rhat := rhat + vTop
                            if rhat >= base then exit end
                        else exit
                        end
                    end
                    (* u[j..j+n] -= qhat * v *)
                    let var borrow = 0
                    let var carry = 0
                    for i = 0 upto n - 1 do
                        let p = {qhat * v[i]} + carry
                        carry := p / base
                        let d = {u[i + j] - {p % base}} - borrow
                        if d < 0 then begin u[i + j] := d + base borrow := 1 end
                            else begin u[i + j] := d borrow := 0 end end
                    end
                    let top = {u[j + n] - carry} - borrow
                    if top < 0 then
                        (* qhat was one too large: add v back *)
                        begin
                            u[j + n] := top + base
                            qhat := qhat - 1
                            let var c = 0
                            for i = 0 upto n - 1 do
                                let s = u[i + j] + v[i] + c
                                if s >= base then begin u[i + j] := s - base c := 1 end
                                    else begin u[i + j] := s c := 0 end end
                            end
                            u[j + n] := {u[j + n] + c} % base
                        end
                    else u[j + n] := top
                    end
                    q[j] := qhat
                end
                let r = array of(n 0)
                for i = 0 upto n - 1 do r[i] := u[i] end
                tuple let q = q let r = divSmall(trim(r) f).q end
            end
        end

    (* Integers *)

    let fromInt(n: Int): T =
        begin
            let neg = n < 0
            (* Limbs of |n|, built from the negative side so that the most
             * negative Int works *)
            let limbs = array of(3 0)
            let var k = if neg then n else 0 - n end
            for i = 0 upto 2 do
                limbs[i] := 0 - {k % base}
                k := k / base
            end
            make(neg limbs)
        end

    let toInt(t: T): Int =
        begin
            if extent t.mag > 3 then raise overflow end end
            let var r = 0
            for i = extent t.mag - 1 downto 0 do r := {r * base} + t.mag[i] end
            if t.neg then 0 - r else r end
        end

    let toString(t: T): String =
        if extent t.mag is 0 then "0"
        else
            begin
                let n = extent t.mag
                let s = stringOp.new({n * baseDigits} + 1 '0')
                let var pos = 0
                if t.neg then begin stringOp.setChar(s 0 '~') pos := 1 end end
                let top = conv.int(t.mag[n - 1])
                stringOp.setSub(s pos top 0 stringOp.length(top))
                pos := pos + stringOp.length(top)
                for i = n - 2 downto 0 do
                    let var limb = t.mag[i]
                    for k = baseDigits - 1 downto 0 do
                        stringOp.setChar(s pos + k ascii.char(ascii.val('0') + {limb % 10}))
                        limb := limb / 10
                    end
                    pos := pos + baseDigits
                end
                stringOp.getSub(s 0 pos)
            end
        end

    let fromString(s: String): maybe.T(T) =
        begin
            let n = stringOp.length(s)
            let var i = 0
            while {i < n} andif strutil.isSpace(stringOp.getChar(s i)) do i := i + 1 end
            let var neg = false
            if {i < n} andif {{stringOp.getChar(s i) is '~'} orif {stringOp.getChar(s i) is '-'}} then
                begin neg := true i := i + 1 end
            elsif {i < n} andif {stringOp.getChar(s i) is '+'} then
                i := i + 1
            end
            let start = i
            while {i < n} andif strutil.isDigit(stringOp.getChar(s i)) do i := i + 1 end
            if i is start then maybe.none(:T)
            else
                begin
                    (* Limbs of baseDigits digits, from the right *)
                    let digits = i - start
                    let limbs = array of({{digits + baseDigits} - 1} / baseDigits 0)
                    for d = 0 upto digits - 1 do
                        let c = ascii.val(stringOp.getChar(s {i - 1} - d)) - ascii.val('0')
                        let limb = d / baseDigits
                        let var p = 1
                        for e = 1 upto d % baseDigits do p := p * 10 end
                        limbs[limb] := limbs[limb] + {c * p}
                    end
                    maybe.some(:T make(neg limbs))
                end
            end
        end

    let neg(a: T): T = make(not(a.neg) a.mag)
    let abs(a: T): T = make(false a.mag)

    let add(a: T b: T): T =
        if a.neg is b.neg then make(a.neg addMag(a.mag b.mag))
        elsif compareMag(a.mag b.mag) >= 0 then make(a.neg subMag(a.mag b.mag))
        else make(b.neg subMag(b.mag a.mag))
        end

    let sub(a: T b: T): T = add(a neg(b))

    let mul(a: T b: T): T = make(a.neg isnot b.neg mulMag(a.mag b.mag))

    let divMod(a: T b: T): DivMod =
        begin
            if extent b.mag is 0 then raise divide end end
            divModMag(a.mag b.mag)
        end

    let quot(a: T b: T): T = make(a.neg isnot b.neg divMod(a b).q)
    let rem(a: T b: T): T = make(a.neg divMod(a b).r)

    let div(a: T b: T): T =
        begin
            let d = divMod(a b)
            let q = make(a.neg isnot b.neg d.q)
            let r = trim(d.r)
            if {a.neg isnot b.neg} andif {extent r > 0} then sub(q fromInt(1)) else q end
        end

    let mod(a: T b: T): T =
        begin
            let r = make(a.neg divMod(a b).r)
            if {a.neg isnot b.neg} andif {extent r.mag > 0} then add(r b) else r end
        end

    let compare(a: T b: T): Int =
        if a.neg isnot b.neg then if a.neg then ~1 else 1 end
        elsif a.neg then compareMag(b.mag a.mag)
        else compareMag(a.mag b.mag)
        end

    let equal(a: T b: T): Bool = compare(a b) is 0
    let less(a: T b: T): Bool = compare(a b) < 0
end
