(* smith-normal-form: the Smith normal form of a 35x35 integer matrix, by row
 * and column operations on arbitrary-precision integers (Henry Cejtin) *)

import
    support/bench : support/Bench
    support/lists : support/Lists
    intInf = support/intinf : support/IntInf
    util/maybe : util/Maybe
    conv : Conv
    writer : Writer

(* structure Matrix: a matrix is its height, width, and entries in row-major
 * order. Matrix.toString, which the benchmark does not use, is left out. *)
Let Matrix(E::TYPE) = Tuple height: Int width: Int mat: Array(E) end

let sizeError: Exception = exception sizeError: Ok end
let index: Exception = exception index: Ok end

let make(E::TYPE)(height: Int width: Int generator: All(row: Int col: Int) E): Matrix(E) =
    if {height < 0} orif {width < 0} then raise sizeError end
    else
        begin
            let n = height * width
            let mat = array of(n generator(0 0))
            for z = 0 upto n - 1 do mat[z] := generator(z / width z % width) end
            tuple let height = height let width = width let mat = mat end
        end
    end

let height(E::TYPE)(m: Matrix(E)): Int = m.height
let width(E::TYPE)(m: Matrix(E)): Int = m.width

let fetch(E::TYPE)(m: Matrix(E) row: Int col: Int): E =
    if {0 <= row} andif {row < m.height} andif {0 <= col} andif {col < m.width} then m.mat[col + {m.width * row}]
    else raise index end
    end

let fetchRow(E::TYPE)(m: Matrix(E) row: Int): All(col: Int) E =
    if {0 <= row} andif {row < m.height} then
        begin
            let offset = m.width * row
            fun(col: Int): E if {0 <= col} andif {col < m.width} then m.mat[col + offset] else raise index end end
        end
    else raise index end
    end

let fetchCol(E::TYPE)(m: Matrix(E) col: Int): All(row: Int) E =
    if {0 <= col} andif {col < m.width} then
        fun(row: Int): E if {0 <= row} andif {row < m.height} then m.mat[col + {m.width * row}] else raise index end end
    else raise index end
    end

let storeRow(E::TYPE)(m: Matrix(E) row: Int): All(col: Int entry: E) Ok =
    if {0 <= row} andif {row < m.height} then
        begin
            let offset = m.width * row
            fun(col: Int entry: E): Ok
                if {0 <= col} andif {col < m.width} then m.mat[col + offset] := entry else raise index end end
        end
    else raise index end
    end

let storeCol(E::TYPE)(m: Matrix(E) col: Int): All(row: Int entry: E) Ok =
    if {0 <= col} andif {col < m.width} then
        fun(row: Int entry: E): Ok
            if {0 <= row} andif {row < m.height} then m.mat[col + {m.width * row}] := entry else raise index end end
    else raise index end
    end

let swapLoop(E::TYPE)(from1: All(i: Int) E to1: All(i: Int e: E) Ok from2: All(i: Int) E to2: All(i: Int e: E) Ok
    limit: Int): Ok =
    begin
        let rec go(i: Int): Ok =
            if i is limit then ok
            else
                begin
                    let tmp = from1(i)
                    to1(i from2(i))
                    to2(i tmp)
                    go(i + 1)
                end
            end
        go(0)
    end

let rowSwap(E::TYPE)(m: Matrix(E) row1: Int row2: Int): Ok =
    if {0 <= row1} andif {row1 < m.height} andif {0 <= row2} andif {row2 < m.height} then
        if row1 is row2 then ok
        else swapLoop(:E)(fetchRow(:E)(m row1) storeRow(:E)(m row1) fetchRow(:E)(m row2) storeRow(:E)(m row2) m.width)
        end
    else raise index end
    end

let colSwap(E::TYPE)(m: Matrix(E) col1: Int col2: Int): Ok =
    if {0 <= col1} andif {col1 < m.width} andif {0 <= col2} andif {col2 < m.width} then
        if col1 is col2 then ok
        else swapLoop(:E)(fetchCol(:E)(m col1) storeCol(:E)(m col1) fetchCol(:E)(m col2) storeCol(:E)(m col2) m.height)
        end
    else raise index end
    end

let opLoop(E::TYPE)(from1: All(i: Int) E from2: All(i: Int) E to2: All(i: Int e: E) Ok limit: Int
    f: All(a: E b: E) E): Ok =
    begin
        let rec go(i: Int): Ok = if i is limit then ok else begin to2(i f(from1(i) from2(i))) go(i + 1) end end
        go(0)
    end

let rowOp(E::TYPE)(m: Matrix(E) row1: Int row2: Int f: All(a: E b: E) E): Ok =
    if {0 <= row1} andif {row1 < m.height} andif {0 <= row2} andif {row2 < m.height} andif {row1 isnot row2} then
        opLoop(:E)(fetchRow(:E)(m row1) fetchRow(:E)(m row2) storeRow(:E)(m row2) m.width f)
    else raise index end
    end

let colOp(E::TYPE)(m: Matrix(E) col1: Int col2: Int f: All(a: E b: E) E): Ok =
    if {0 <= col1} andif {col1 < m.width} andif {0 <= col2} andif {col2 < m.width} andif {col1 isnot col2} then
        opLoop(:E)(fetchCol(:E)(m col1) fetchCol(:E)(m col2) storeCol(:E)(m col2) m.height f)
    else raise index end
    end

let copy(E::TYPE)(m: Matrix(E)): Matrix(E) =
    begin
        let mat = array of(extent m.mat m.mat[0])
        for i = 0 upto extent m.mat - 1 do mat[i] := m.mat[i] end
        tuple let height = m.height let width = m.width let mat = mat end
    end

let map(E1::TYPE E2::TYPE)(m: Matrix(E1) f: All(e: E1) E2): Matrix(E2) =
    begin
        let mat = array of(extent m.mat f(m.mat[0]))
        for i = 0 upto extent m.mat - 1 do mat[i] := f(m.mat[i]) end
        tuple let height = m.height let width = m.width let mat = mat end
    end

Let Int2 = intInf.T

let zero = intInf.fromInt(0)

let smaller(a: Int2 b: Int2): Bool =
    not(intInf.equal(a zero)) andif {intInf.equal(b zero) orif intInf.less(intInf.abs(a) intInf.abs(b))}

let print(s: String): Ok = writer.putString(writer.output s)

let smithNormalForm(mat0: Matrix(Int2)): Matrix(Int2) =
    begin
        let height = height(:Int2)(mat0)
        let width = width(:Int2)(mat0)
        let mat = copy(:Int2)(mat0)
        let range = if width < height then width else height end
        let dd(pos: Int): Ok =
            begin
                let matCol = fetchCol(:Int2)(mat pos)
                let matRow = fetchRow(:Int2)(mat pos)
                print("dd: pos = " <> conv.int(pos) <> "\n")
                let rec swapRowLoop(best: Int2 bestRow: Int bestCol: Int row: Int): Ok =
                    if row >= height then begin rowSwap(:Int2)(mat pos bestRow) colSwap(:Int2)(mat pos bestCol) end
                    else
                        begin
                            let matRow = fetchRow(:Int2)(mat row)
                            let rec swapColLoop(best: Int2 bestRow: Int bestCol: Int col: Int): Ok =
                                if col >= width then swapRowLoop(best bestRow bestCol row + 1)
                                else
                                    begin
                                        let next = matRow(col)
                                        if smaller(next best) then swapColLoop(next row col col + 1)
                                        else swapColLoop(best bestRow bestCol col + 1)
                                        end
                                    end
                                end
                            swapColLoop(best bestRow bestCol pos)
                        end
                    end
                let rec rowLoop(row: Int): Ok =
                    if row < height then
                        if intInf.equal(matCol(row) zero) then rowLoop(row + 1)
                        else
                            begin
                                rowOp(:Int2)(mat pos row
                                    begin
                                        let x = intInf.neg(intInf.quot(matCol(row) matCol(pos)))
                                        fun(lhs: Int2 rhs: Int2): Int2 intInf.add(intInf.mul(lhs x) rhs)
                                    end)
                                if intInf.equal(matCol(row) zero) then rowLoop(row + 1) else hitPosAgain() end
                            end
                        end
                    else
                        begin
                            let rec colLoop(col: Int): Ok =
                                if col < width then
                                    if intInf.equal(matRow(col) zero) then colLoop(col + 1)
                                    else
                                        begin
                                            colOp(:Int2)(mat pos col
                                                begin
                                                    let x = intInf.neg(intInf.quot(matRow(col) matRow(pos)))
                                                    fun(lhs: Int2 rhs: Int2): Int2 intInf.add(intInf.mul(lhs x) rhs)
                                                end)
                                            if intInf.equal(matRow(col) zero) then colLoop(col + 1)
                                                else hitPosAgain() end
                                        end
                                    end
                                end
                            colLoop(pos + 1)
                        end
                    end
                and hitPosAgain(): Ok = begin swapRowLoop(zero pos pos pos) rowLoop(pos + 1) end
                hitPosAgain()
            end
        let rec loop1(pos: Int): Matrix(Int2) = if pos is range then mat else begin dd(pos) loop1(pos + 1) end end
        loop1(0)
    end

let row(a: Array(Int)): lists.T(Int) = lists.fromArray(:Int)(a)
