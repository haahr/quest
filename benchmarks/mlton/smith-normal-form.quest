                 ~2 ~7  3 ~5 ~2 ~5  5 ~3 ~4 ~2 ~8  2 ~8  0 ~8  0 ~8  9  8 ~5 ~5  1  3  5 ~4 end)
    row(array of ~8 ~8  0 ~5 ~8 ~6  3 ~6 ~4  6  1 ~5 ~6 ~8 ~4 ~6 ~2 ~6  6 ~4  8  8  4 ~5 ~1
                  0  9 ~8 ~3 ~1 ~8  7 ~3  0 ~7  1 ~7 ~1 ~7  3 ~7  3 ~4 ~8  8 ~7 ~9 ~8  3  2 end)
    row(array of  3  6  8 ~9  7  1 ~9  9  3  8  6  4 ~2  1 ~8  4 ~7 ~4 ~3  3 ~5 ~6 ~7 ~2  0
                 ~4  5  2  5  6  3 ~8  2 ~5 ~7  6  8 ~2 ~5 ~4  9  9  2 ~2 ~2  7  4  4 ~2  3 end)
    row(array of  6  6 ~5 ~2 ~8 ~2 ~9  0  2  4 ~6 ~9  9  0 ~8 ~3 ~1 ~2 ~1  6  8  2 ~9  5 ~2
                  1  7 ~6  5  1 ~1  4 ~4 ~7 ~6 ~3 ~8  2  2  5  5 ~6  5  3  3  7  4  7 ~3 ~9 end)
    row(array of ~9  6 ~4  1  3 ~8 ~8 ~8 ~1  5  1  1 ~1  6  5  1 ~1  5 ~8  8 ~7 ~5 ~1 ~1  6
                 ~8 ~3 ~1 ~2 ~6 ~5 ~5 ~6  0  2  2  7 ~1 ~5 ~7 ~1 ~3  7  6  0  2  4 ~5  0 ~4 end)
end)

let f(x: Int y: Int): Int = lists.nth(:Int)(lists.nth(:lists.T(Int))(table x) y)

let snf(): Ok =
    begin
        let dim = 35
        let big = map(:Int :Int2)(make(:Int)(dim dim f) intInf.fromInt)
        let entry = fetch(:Int2)(smithNormalForm(big) dim - 1 dim - 1)
        if not(intInf.equal(entry
            maybe.unwrap(:Int2 intInf.fromString("~1027954043102083189860753402541358641712697245"))))
        then raise bench.bug end
        end
    end

for i = 1 upto bench.count() do snf() end
