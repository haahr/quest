(* tailfib: a tail-recursive Fibonacci function, fib 44 a million times each
 * time *)

import support/bench : support/Bench

let rec fib1(n: Int a: Int b: Int): Int = if n is 0 then a else fib1(n - 1 a + b a) end
let fib(n: Int): Int = fib1(n 0 1)

let doit(): Ok = if 701408733 isnot fib(44) then raise bench.bug end end

for i = 1 upto bench.count() * 1000000 do doit() end
