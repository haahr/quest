(* main.sml *)

let done: Exception = exception done: Ok end

let testit(): Ok =
    try exists(fun(z: Term): Ok solution2(z fun(): Ok raise done end)) when done
        then writer.putString(writer.output "yes\n") end

let doit(): Ok = try exists(fun(z: Term): Ok solution2(z fun(): Ok raise done end)) when done then ok end

if bench.testit() then testit() else for i = 1 upto bench.count() do doit() end end
