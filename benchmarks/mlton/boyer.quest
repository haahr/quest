(* boyer: the Boyer-Moore tautology checker, rewriting with 106 lemmas, proving
 * a tautology of implications (from the SML/NJ benchmark suite) *)

import
    support/bench : support/Bench
    support/lists : support/Lists
    stringOp = string : StringOp
    writer : Writer

(* terms.sml: Manipulations over terms *)

(* A head is a name and its lemmas (the original's property list) *)
Let Rec Term = Option variable with v: Int end prop with head: Head args: lists.T(Term) end end
and Head = Tuple name: String props: Props end
and Props = Tuple var v: lists.T(Lemma) end
and Lemma = Tuple left: Term right: Term end
Let Terms = lists.T(Term)

let lemmas = tuple let var v = lists.nil(:Head) end

(* Replacement for property lists *)

let headname(h: Head): String = h.name

let get(name: String): Head =
    begin
        let rec getRec(l: lists.T(Head)): Head =
            case l
                when cons with c then if stringOp.equal(c.hd.name name) then c.hd else getRec(c.tl) end
                when nil then
                    begin
                        let props: Props = tuple let var v = lists.nil(:Lemma) end
                        let entry: Head = tuple let name = name let props = props end
                        lemmas.v := lists.cons(:Head)(entry lemmas.v)
                        entry
                    end
            end
        getRec(lemmas.v)
    end

let match: Exception = exception match: Ok end

let addLemma(t: Term): Ok =
    case t
        when prop with p then
            case p.args
                when cons with a1 then
                    case a1.hd
                        when prop with left then
                            case a1.tl
                                when cons with a2 then
                                    if lists.null(:Term)(a2.tl) then
                                        left.head.props.v :=
                                            lists.cons(:Lemma)(tuple let left = a1.hd let right = a2.hd end
                                            left.head.props.v)
                                    else raise match end
                                    end
                                else raise match end
                            end
                        else raise match end
                    end
                else raise match end
            end
        else raise match end
    end

(* Substitutions *)

let failure: Exception(String) = exception failure: String end

Let Binding = Tuple v: Int t: Term end
Let Bindings = lists.T(Binding)

let getBinding(v: Int l: Bindings): Term =
    begin
        let rec getRec(l: Bindings): Term =
            case l
                when nil then raise failure with "unbound" end
                when cons with c then if v is c.hd.v then c.hd.t else getRec(c.tl) end
            end
        getRec(l)
    end

let applySubst(alist: Bindings): All(t: Term) Term =
    begin
        let rec asRec(t: Term): Term =
            case t
                when variable with x then try getBinding(x.v alist) when failure then t end
                when prop with p then option prop of Term with p.head lists.map(:Term :Term)(asRec p.args) end
            end
        asRec
    end

(* SML's = on heads (a name and a ref) and on terms *)
let headEq(a: Head b: Head): Bool = stringOp.equal(a.name b.name) andif {a.props is b.props}
let rec termEq(a: Term b: Term): Bool =
    case a
        when variable with x then case b when variable with y then x.v is y.v else false end
        when prop with x then case b when prop with y then headEq(x.head y.head) andif termsEq(x.args y.args)
            else false end
    end
and termsEq(a: Terms b: Terms): Bool =
    case a
        when nil then lists.null(:Term)(b)
        when cons with x then case b when cons with y then termEq(x.hd y.hd) andif termsEq(x.tl y.tl) else false end
    end

let unifyFailed: Exception = exception unifyFailed: Ok end

let rec unify1(term1: Term term2: Term unifySubst: Bindings): Bindings =
    case term2
        when variable with x then
            try if termEq(getBinding(x.v unifySubst) term1) then unifySubst else raise unifyFailed end end
            when failure then lists.cons(:Binding)(tuple let v = x.v let t = term1 end unifySubst)
            end
        when prop with p2 then
            case term1
                when variable then raise unifyFailed end
                when prop with p1 then
                    if headEq(p1.head p2.head) then unify1Lst(p1.args p2.args unifySubst) else raise unifyFailed end end
            end
    end
and unify1Lst(l1: Terms l2: Terms unifySubst: Bindings): Bindings =
    case l1
        when nil then case l2 when nil then unifySubst else raise unifyFailed end end
        when cons with c1 then
            case l2 when cons with c2 then unify1Lst(c1.tl c2.tl unify1(c1.hd c2.hd unifySubst))
                else raise unifyFailed end end
    end

let unify(term1: Term term2: Term): Bindings = unify1(term1 term2 lists.nil(:Binding))

(* The original's handler, handle unify =>, binds a variable: it catches every
 * exception, as else does *)
let rec rewrite(t: Term): Term =
    case t
        when variable then t
        when prop with p then
            rewriteWithLemmas(option prop of Term with p.head lists.map(:Term :Term)(rewrite p.args) end p.head.props.v)
    end
and rewriteWithLemmas(t: Term l: lists.T(Lemma)): Term =
    case l
        when nil then t
        when cons with c then
            try rewrite(applySubst(unify(t c.hd.left))(c.hd.right)) else rewriteWithLemmas(t c.tl) end
    end

(* rules.sml *)

Let Rec CTerm = Option cvar with v: Int end cprop with name: String args: Array(CTerm) end end

let cv(v: Int): CTerm = option cvar of CTerm with v end
let cp(name: String args: Array(CTerm)): CTerm = option cprop of CTerm with name args end

let rec ctermToTerm(c: CTerm): Term =
    case c
        when cvar with x then option variable of Term with x.v end
        when cprop with p then
            begin
                (* SML's map makes each argument in order *)
                let args = lists.map(:CTerm :Term)(ctermToTerm lists.fromArray(:CTerm)(p.args))
                option prop of Term with get(p.name) args end
            end
    end

let add(t: CTerm): Ok = addLemma(ctermToTerm(t))

let addRules(): Ok =
    begin
        add(cp("equal" array of
            cp("compile" array of cv(5) end)
            cp("reverse" array of
                cp("codegen" array of cp("optimize" array of cv(5) end) cp("nil" array of :CTerm end) end)
            end)
        end))
        add(cp("equal" array of
            cp("eqp" array of cv(23) cv(24) end)
            cp("equal" array of cp("fix" array of cv(23) end) cp("fix" array of cv(24) end) end)
        end))
        add(cp("equal" array of cp("gt" array of cv(23) cv(24) end) cp("lt" array of cv(24) cv(23) end) end))
        add(cp("equal" array of cp("le" array of cv(23) cv(24) end) cp("ge" array of cv(24) cv(23) end) end))
        add(cp("equal" array of cp("ge" array of cv(23) cv(24) end) cp("le" array of cv(24) cv(23) end) end))
        add(cp("equal" array of
            cp("boolean" array of cv(23) end)
            cp("or" array of
                cp("equal" array of cv(23) cp("true" array of :CTerm end) end)
                cp("equal" array of cv(23) cp("false" array of :CTerm end) end)
            end)
        end))
        add(cp("equal" array of
            cp("iff" array of cv(23) cv(24) end)
            cp("and" array of cp("implies" array of cv(23) cv(24) end) cp("implies" array of cv(24) cv(23) end) end)
        end))
        add(cp("equal" array of
            cp("even1" array of cv(23) end)
            cp("if" array of
                cp("zerop" array of cv(23) end)
                cp("true" array of :CTerm end)
                cp("odd" array of cp("sub1" array of cv(23) end) end)
            end)
        end))
        add(cp("equal" array of
            cp("countps_" array of cv(11) cv(15) end)
            cp("countps_loop" array of cv(11) cv(15) cp("zero" array of :CTerm end) end)
        end))
        add(cp("equal" array of
            cp("fact_" array of cv(8) end)
            cp("fact_loop" array of cv(8) cp("one" array of :CTerm end) end)
        end))
        add(cp("equal" array of
            cp("reverse_" array of cv(23) end)
            cp("reverse_loop" array of cv(23) cp("nil" array of :CTerm end) end)
        end))
        add(cp("equal" array of
            cp("divides" array of cv(23) cv(24) end)
            cp("zerop" array of cp("remainder" array of cv(24) cv(23) end) end)
        end))
        add(cp("equal" array of
            cp("assume_true" array of cv(21) cv(0) end)
            cp("cons" array of cp("cons" array of cv(21) cp("true" array of :CTerm end) end) cv(0) end)
        end))
        add(cp("equal" array of
            cp("assume_false" array of cv(21) cv(0) end)
            cp("cons" array of cp("cons" array of cv(21) cp("false" array of :CTerm end) end) cv(0) end)
        end))
        add(cp("equal" array of
            cp("tautology_checker" array of cv(23) end)
            cp("tautologyp" array of cp("normalize" array of cv(23) end) cp("nil" array of :CTerm end) end)
        end))
        add(cp("equal" array of
            cp("falsify" array of cv(23) end)
            cp("falsify1" array of cp("normalize" array of cv(23) end) cp("nil" array of :CTerm end) end)
        end))
        add(cp("equal" array of
            cp("prime" array of cv(23) end)
            cp("and" array of
                cp("not" array of cp("zerop" array of cv(23) end) end)
                cp("not" array of
                    cp("equal" array of cv(23) cp("add1" array of cp("zero" array of :CTerm end) end) end)
                end)
                cp("prime1" array of cv(23) cp("sub1" array of cv(23) end) end)
            end)
        end))
        add(cp("equal" array of
            cp("and" array of cv(15) cv(16) end)
            cp("if" array of
                cv(15)
                cp("if" array of cv(16) cp("true" array of :CTerm end) cp("false" array of :CTerm end) end)
                cp("false" array of :CTerm end)
            end)
        end))
        add(cp("equal" array of
            cp("or" array of cv(15) cv(16) end)
            cp("if" array of
                cv(15)
                cp("true" array of :CTerm end)
                cp("if" array of cv(16) cp("true" array of :CTerm end) cp("false" array of :CTerm end) end)
                cp("false" array of :CTerm end)
            end)
        end))
        add(cp("equal" array of
            cp("not" array of cv(15) end)
            cp("if" array of cv(15) cp("false" array of :CTerm end) cp("true" array of :CTerm end) end)
        end))
