            end)
        end))
        add(cp("equal" array of
            cp("meaning" array of cp("plus_tree" array of cp("plus_fringe" array of cv(23) end) end) cv(0) end)
            cp("fix" array of cp("meaning" array of cv(23) cv(0) end) end)
        end))
        add(cp("equal" array of
            cp("append" array of cp("append" array of cv(23) cv(24) end) cv(25) end)
            cp("append" array of cv(23) cp("append" array of cv(24) cv(25) end) end)
        end))
        add(cp("equal" array of
            cp("reverse" array of cp("append" array of cv(0) cv(1) end) end)
            cp("append" array of cp("reverse" array of cv(1) end) cp("reverse" array of cv(0) end) end)
        end))
        add(cp("equal" array of
            cp("times" array of cv(23) cp("plus" array of cv(24) cv(25) end) end)
            cp("plus" array of cp("times" array of cv(23) cv(24) end) cp("times" array of cv(23) cv(25) end) end)
        end))
        add(cp("equal" array of
            cp("times" array of cp("times" array of cv(23) cv(24) end) cv(25) end)
            cp("times" array of cv(23) cp("times" array of cv(24) cv(25) end) end)
        end))
        add(cp("equal" array of
            cp("equal" array of cp("times" array of cv(23) cv(24) end) cp("zero" array of :CTerm end) end)
            cp("or" array of cp("zerop" array of cv(23) end) cp("zerop" array of cv(24) end) end)
        end))
        add(cp("equal" array of
            cp("exec" array of cp("append" array of cv(23) cv(24) end) cv(15) cv(4) end)
            cp("exec" array of cv(24) cp("exec" array of cv(23) cv(15) cv(4) end) cv(4) end)
        end))
        add(cp("equal" array of
            cp("mc_flatten" array of cv(23) cv(24) end)
