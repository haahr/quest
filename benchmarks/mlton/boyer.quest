addRules()

(* boyer.sml: Tautology checker *)

let rec mem(x: Term l: Terms): Bool = case l when cons with c then termEq(x c.hd) orif mem(x c.tl) else false end

let truep(x: Term lst: Terms): Bool =
    case x when prop with p then stringOp.equal(headname(p.head) "true") orif mem(x lst) else mem(x lst) end

let falsep(x: Term lst: Terms): Bool =
    case x when prop with p then stringOp.equal(headname(p.head) "false") orif mem(x lst) else mem(x lst) end

let rec tautologyp(x: Term trueLst: Terms falseLst: Terms): Bool =
    if truep(x trueLst) then true
    elsif falsep(x falseLst) then false
    else
        case x
            when variable then false
            when prop with p then
                if {lists.length(:Term)(p.args) is 3} then
                    begin
                        let test = lists.nth(:Term)(p.args 0)
                        let yes = lists.nth(:Term)(p.args 1)
                        let no = lists.nth(:Term)(p.args 2)
                        if stringOp.equal(headname(p.head) "if") then
                            if truep(test trueLst) then tautologyp(yes trueLst falseLst)
                            elsif falsep(test falseLst) then tautologyp(no trueLst falseLst)
                            else tautologyp(yes lists.cons(:Term)(test trueLst) falseLst)
                                andif tautologyp(no trueLst lists.cons(:Term)(test falseLst))
                            end
                        else false
                        end
                    end
                else raise match end
                end
        end
    end

let tautp(x: Term): Bool = tautologyp(rewrite(x) lists.nil(:Term) lists.nil(:Term))

(* The benchmark *)

let v(n: Int): Term = option variable of Term with n end
let p(name: String args: Array(Term)): Term = option prop of Term with get(name) lists.fromArray(:Term)(args) end
let bind(v: Int t: Term): Binding = tuple let v = v let t = t end

let subst = lists.fromArray(:Binding)(array of
    bind(23 p("f" array
        of p("plus" array of p("plus" array of v(0) v(1) end)
            p("plus" array of v(2) p("zero" array of :Term end) end) end) end))
    bind(24 p("f" array
        of p("times" array of p("times" array of v(0) v(1) end) p("plus" array of v(2) v(3) end) end) end))
    bind(25 p("f" array
        of p("reverse" array
            of p("append" array of p("append" array of v(0) v(1) end) p("nil" array of :Term end) end) end) end))
    bind(20 p("equal" array of p("plus" array of v(0) v(1) end) p("difference" array of v(23) v(24) end) end))
    bind(22 p("lt" array of p("remainder" array of v(0) v(1) end)
        p("member" array of v(0) p("length" array of v(1) end) end) end))
end)

let term =
    p("implies" array of
        p("and" array of
            p("implies" array of v(23) v(24) end)
            p("and" array of
                p("implies" array of v(24) v(25) end)
                p("and" array of p("implies" array of v(25) v(20) end) p("implies" array of v(20) v(22) end) end)
            end)
        end)
        p("implies" array of v(23) v(22) end)
    end)

let testit(): Ok =
    writer.putString(writer.output if tautp(applySubst(subst)(term)) then "Proved!\n" else "Cannot prove!\n" end)

let doit(): Ok = begin tautp(applySubst(subst)(term)) ok end

if bench.testit() then testit() else for i = 1 upto bench.count() do doit() end end
