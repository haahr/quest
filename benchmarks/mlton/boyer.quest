            cp("equal" array of cp("fix" array of cv(1) end) cp("fix" array of cv(2) end) end)
        end))
        add(cp("equal" array of
            cp("equal" array of cp("zero" array of :CTerm end) cp("difference" array of cv(23) cv(24) end) end)
            cp("not" array of cp("gt" array of cv(24) cv(23) end) end)
        end))
        add(cp("equal" array of
            cp("equal" array of cv(23) cp("difference" array of cv(23) cv(24) end) end)
            cp("and" array of
                cp("numberp" array of cv(23) end)
