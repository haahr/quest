(* even-odd: mutually recursive even and odd, counting down from 500000000 *)

import
    support/bench : support/Bench
    intOp = int : IntOp

let rec even1(i: Int): Bool = if i is 0 then true else odd1(i - 1) end
and odd1(i: Int): Bool = if i is 0 then false else even1(i - 1) end

let even(i: Int): Bool = even1(intOp.abs(i))
let odd(i: Int): Bool = odd1(intOp.abs(i))

for i = 1 upto bench.count() do
    if even(500000000) isnot not(odd(500000000)) then raise bench.bug end end
end
