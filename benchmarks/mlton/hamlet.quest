(* hamlet: HaMLet 0.5, Andreas Rossberg's implementation of Standard ML as
 * the Definition of Standard ML defines it, executing DATA/hamlet-input.sml
 * (HaMLet Copyright 1999-2001 by Andreas Rossberg; its maps and sets are the
 * SML/NJ Library's, Copyright 1993 by AT&T Bell Laboratories). The input
 * declares a datatype and some functions over it and applies them, so the
 * benchmark parses, elaborates, and evaluates core declarations, printing
 * their values and types. Left out is the code it never runs, as an
 * execution-count profile of the original (MLton's -profile count) shows:
 * the module language beyond top-level declarations; the phrases the input
 * does not use (special constants, records with labels, let, case, handle,
 * raise, exceptions, references, type abbreviations, infix declarations, and
 * the other derived forms), from the grammar's actions and the lexer's to
 * elaboration, evaluation, and printing; the error messages of syntax errors;
 * the printing of uncaught exceptions; and the other modes of the interpreter
 * (parse, elaborate, or evaluate only, and reading files). Where the left-out
 * code would run, the conversion raises failure. The tables of its parser
 * and lexer were transliterated by tools/mlyacc_tables.py and
 * tools/mllex_tables.py. *)

import
    support/bench : support/Bench
    support/lists : support/Lists
    stringOp = string : StringOp
    ascii : Ascii
    conv : Conv
    reader : Reader
    writer : Writer

(* raise e, as any type *)
let throw(A::TYPE)(e: Exception): A = raise e end

let strEq(a: String b: String): Bool = stringOp.equal(a b)

(* String.compare, as -1, 0, or 1 *)
let strCompare(a: String b: String): Int =
    begin
        let la = stringOp.length(a)
        let lb = stringOp.length(b)
        let rec cmp(i: Int): Int =
            if i is la then if i is lb then 0 else 0 - 1 end
            elsif i is lb then 1
            else
                begin
                    let ca = ascii.val(stringOp.getChar(a i))
                    let cb = ascii.val(stringOp.getChar(b i))
                    if ca < cb then 0 - 1 elsif ca > cb then 1 else cmp(i + 1) end
                end
            end
        cmp(0)
    end

(* Int.compare *)
let intCompare(a: Int b: Int): Int = if a < b then 0 - 1 elsif a > b then 1 else 0 end

let intToString(i: Int): String = if i < 0 then "~" <> conv.int(0 - i) else conv.int(i) end

Let Strings = lists.T(String)
Let Ints = lists.T(Int)
Let Chars = lists.T(Char)

(* SML's option *)
Let Opt(A::TYPE) = Option oNone oSome with x: A end end
let none(A::TYPE)(): Opt(A) = option oNone of Opt(A) end
let some(A::TYPE)(x: A): Opt(A) = option oSome of Opt(A) with x end
let isSome(A::TYPE)(o: Opt(A)): Bool = case o when oSome then true else false end

(* pairs *)
Let P2(A::TYPE B::TYPE) = Tuple a: A b: B end
let p2(A::TYPE B::TYPE)(a: A b: B): P2(A B) = tuple let a = a let b = b end

(* List.concat *)
let flatten(A::TYPE)(l: lists.T(lists.T(A))): lists.T(A) =
    lists.foldr(:lists.T(A) :lists.T(A))(fun(a: lists.T(A) r: lists.T(A)): lists.T(A) lists.append(:A)(a r)
        lists.nil(:A) l)

let single(A::TYPE)(x: A): lists.T(A) = lists.cons(:A)(x lists.nil(:A))

(* String.concat *)
let concat(l: Strings): String =
    begin
        let n = lists.foldl(:String :Int)(fun(s: String n: Int): Int n + stringOp.length(s) 0 l)
        let s = stringOp.new(n ' ')
        let rec fill(l: Strings i: Int): Ok =
            case l
                when cons with c then
                    begin stringOp.setSub(s i c.hd 0 stringOp.length(c.hd)) fill(c.tl i + stringOp.length(c.hd)) end
                else ok
            end
        fill(l 0)
        s
    end

let print(s: String): Ok = writer.putString(writer.output s)

let notFound: Exception = exception notFound: Ok end

(* SML's Fail, raised as any type; also raised for the constructs left out *)
let hamletFailure: Exception(String) = exception failure: String end
let failure(A::TYPE)(s: String): A = raise hamletFailure with s end
let matchE: Exception = exception matchE: Ok end

(* structure Stamp *)
let stampCounter = tuple let var r = 0 end
let stamp(): Int = begin stampCounter.r := stampCounter.r + 1 stampCounter.r end

(* functor BinaryMapFn and functor FinMapFn: each function takes the order of
 * the keys, as -1, 0, or 1 *)

Let Cmp(K::TYPE) = All(a: K b: K) Int

Let Rec Map(K::TYPE V::TYPE) = Option
    mE
    mT with key: K value: V cnt: Int left: Map(K V) right: Map(K V) end
end

let mapEmpty(K::TYPE V::TYPE)(): Map(K V) = option mE of Map(K V) end
let mT(K::TYPE V::TYPE)(k: K v: V cnt: Int l: Map(K V) r: Map(K V)): Map(K V) =
    option mT of Map(K V) with k v cnt l r end

let mapIsEmpty(K::TYPE V::TYPE)(m: Map(K V)): Bool = case m when mE then true else false end
let mapNumItems(K::TYPE V::TYPE)(m: Map(K V)): Int = case m when mT with n then n.cnt else 0 end

let wt(i: Int): Int = i + i + i

let mapN(K::TYPE V::TYPE)(k: K v: V l: Map(K V) r: Map(K V)): Map(K V) =
    mT(:K :V)(k v 1 + mapNumItems(:K :V)(l) + mapNumItems(:K :V)(r) l r)

let mapSingleL(K::TYPE V::TYPE)(a: K av: V x: Map(K V) r: Map(K V)): Map(K V) =
    case r when mT with b then mapN(:K :V)(b.key b.value mapN(:K :V)(a av x b.left) b.right)
        else throw(:Map(K V))(matchE) end
let mapSingleR(K::TYPE V::TYPE)(b: K bv: V l: Map(K V) z: Map(K V)): Map(K V) =
    case l when mT with a then mapN(:K :V)(a.key a.value a.left mapN(:K :V)(b bv a.right z))
        else throw(:Map(K V))(matchE) end
let mapDoubleL(K::TYPE V::TYPE)(a: K av: V w: Map(K V) r: Map(K V)): Map(K V) =
    case r
        when mT with c then
            case c.left
                when mT with b then
                    mapN(:K :V)(b.key b.value mapN(:K :V)(a av w b.left) mapN(:K :V)(c.key c.value b.right c.right))
                else throw(:Map(K V))(matchE)
            end
        else throw(:Map(K V))(matchE)
    end
let mapDoubleR(K::TYPE V::TYPE)(c: K cv: V l: Map(K V) z: Map(K V)): Map(K V) =
    case l
        when mT with a then
            case a.right
                when mT with b then
                    mapN(:K :V)(b.key b.value mapN(:K :V)(a.key a.value a.left b.left) mapN(:K :V)(c cv b.right z))
                else throw(:Map(K V))(matchE)
            end
        else throw(:Map(K V))(matchE)
    end

(* T' *)
let mapT1(K::TYPE V::TYPE)(k: K v: V l: Map(K V) r: Map(K V)): Map(K V) =
    begin
        let e(t: Map(K V)): Bool = mapIsEmpty(:K :V)(t)
        let size(t: Map(K V)): Int = mapNumItems(:K :V)(t)
        case l
            when mE then
                case r
                    when mE then mT(:K :V)(k v 1 l r)
                    when mT with rn then
                        if e(rn.right) andif e(rn.left) then mT(:K :V)(k v 2 l r)
                        elsif not(e(rn.left)) andif e(rn.right) then mapDoubleL(:K :V)(k v l r)
                        elsif not(e(rn.left)) andif not(e(rn.right)) then
                            if size(rn.left) < size(rn.right) then mapSingleL(:K :V)(k v l r)
                                else mapDoubleL(:K :V)(k v l r) end
                        else mapSingleL(:K :V)(k v l r)
                        end
                end
            when mT with ln then
                case r
                    when mE then
                        if e(ln.right) andif e(ln.left) then mT(:K :V)(k v 2 l r)
                        elsif e(ln.left) andif not(e(ln.right)) then mapDoubleR(:K :V)(k v l r)
                        elsif not(e(ln.left)) andif not(e(ln.right)) then
                            if size(ln.left) > size(ln.right) then mapSingleR(:K :V)(k v l r)
                                else mapDoubleR(:K :V)(k v l r) end
                        else mapSingleR(:K :V)(k v l r)
                        end
                    when mT with rn then
                        if rn.cnt >= wt(ln.cnt) then
                            if size(rn.left) < size(rn.right) then mapSingleL(:K :V)(k v l r)
                                else mapDoubleL(:K :V)(k v l r) end
                        elsif ln.cnt >= wt(rn.cnt) then
                            if size(ln.right) < size(ln.left) then mapSingleR(:K :V)(k v l r)
                                else mapDoubleR(:K :V)(k v l r) end
                        else mT(:K :V)(k v ln.cnt + rn.cnt + 1 l r)
                        end
                end
        end
    end

let rec mapMin(K::TYPE V::TYPE)(t: Map(K V)): P2(K V) =
    case t
        when mT with n then case n.left when mE then p2(:K :V)(n.key n.value) else mapMin(:K :V)(n.left) end
        else throw(:P2(K V))(matchE)
    end

let rec mapDelmin(K::TYPE V::TYPE)(t: Map(K V)): Map(K V) =
    case t
        when mT with n then case n.left when mE then n.right
            else mapT1(:K :V)(n.key n.value mapDelmin(:K :V)(n.left) n.right) end
        else throw(:Map(K V))(matchE)
    end

let mapDelete(K::TYPE V::TYPE)(l: Map(K V) r: Map(K V)): Map(K V) =
    case l
        when mE then r
        else case r when mE then l else begin
            let m = mapMin(:K :V)(r) mapT1(:K :V)(m.a m.b l mapDelmin(:K :V)(r)) end end
    end

let mapSingleton(K::TYPE V::TYPE)(x: K v: V): Map(K V) = mT(:K :V)(x v 1 mapEmpty(:K :V)() mapEmpty(:K :V)())

let mapInsert(K::TYPE V::TYPE)(cmp: Cmp(K) m: Map(K V) x: K v: V): Map(K V) =
    begin
        let rec insert(t: Map(K V)): Map(K V) =
            case t
                when mT with n then
                    begin
                        let c = cmp(n.key x)
                        if c > 0 then mapT1(:K :V)(n.key n.value insert(n.left) n.right)
                        elsif c < 0 then mapT1(:K :V)(n.key n.value n.left insert(n.right))
                        else mT(:K :V)(x v n.cnt n.left n.right)
                        end
                    end
                else mT(:K :V)(x v 1 t t)
            end
        insert(m)
    end

let mapFind(K::TYPE V::TYPE)(cmp: Cmp(K) m: Map(K V) x: K): Opt(V) =
    begin
        let rec mem(t: Map(K V)): Opt(V) =
            case t
                when mT with n then
                    begin
                        let c = cmp(x n.key)
                        if c > 0 then mem(n.right) elsif c is 0 then some(:V)(n.value) else mem(n.left) end
                    end
                else none(:V)()
            end
        mem(m)
    end

let mapRemove(K::TYPE V::TYPE)(cmp: Cmp(K) m: Map(K V) x: K): P2(Map(K V) V) =
    begin
        let rec remove(t: Map(K V)): P2(Map(K V) V) =
            case t
                when mT with n then
                    begin
                        let c = cmp(n.key x)
                        if c > 0 then
                            begin let lv = remove(n.left)
                                p2(:Map(K V) :V)(mapT1(:K :V)(n.key n.value lv.a n.right) lv.b) end
                        elsif c < 0 then
                            begin let rv = remove(n.right)
                                p2(:Map(K V) :V)(mapT1(:K :V)(n.key n.value n.left rv.a) rv.b) end
                        else p2(:Map(K V) :V)(mapDelete(:K :V)(n.left n.right) n.value)
                        end
                    end
                else throw(:P2(Map(K V) V))(notFound)
            end
        remove(m)
    end

let mapListItemsi(K::TYPE V::TYPE)(m: Map(K V)): lists.T(P2(K V)) =
    begin
        let rec d2l(t: Map(K V) l: lists.T(P2(K V))): lists.T(P2(K V)) =
            case t
                when mT with n then d2l(n.left lists.cons(:P2(K V))(p2(:K :V)(n.key n.value) d2l(n.right l)))
                else l
            end
        d2l(m lists.nil(:P2(K V)))
    end

let mapApp(K::TYPE V::TYPE)(f: All(v: V) Ok m: Map(K V)): Ok =
    begin
        let rec app(t: Map(K V)): Ok = case t when mT with n
            then begin app(n.left) f(n.value) app(n.right) end else ok end
        app(m)
    end

let mapMapi(K::TYPE V::TYPE W::TYPE)(f: All(k: K v: V) W m: Map(K V)): Map(K W) =
    begin
        let rec map(t: Map(K V)): Map(K W) =
            case t
                when mT with n then
                    begin
                        let left = map(n.left)
                        let value = f(n.key n.value)
                        let right = map(n.right)
                        mT(:K :W)(n.key value n.cnt left right)
                    end
                else mapEmpty(:K :W)()
            end
        map(m)
    end

let mapMap(K::TYPE V::TYPE W::TYPE)(f: All(v: V) W m: Map(K V)): Map(K W) =
    mapMapi(:K :V :W)(fun(k: K v: V): W f(v) m)

let mapFoldli(K::TYPE V::TYPE B::TYPE)(f: All(k: K v: V b: B) B init: B m: Map(K V)): B =
    begin
        let rec fold(t: Map(K V) v: B): B = case t when mT with n
            then fold(n.right f(n.key n.value fold(n.left v))) else v end
        fold(m init)
    end

let mapFoldl(K::TYPE V::TYPE B::TYPE)(f: All(v: V b: B) B init: B m: Map(K V)): B =
    mapFoldli(:K :V :B)(fun(k: K v: V b: B): B f(v b) init m)

let mapFoldri(K::TYPE V::TYPE B::TYPE)(f: All(k: K v: V b: B) B init: B m: Map(K V)): B =
    begin
        let rec fold(t: Map(K V) v: B): B = case t when mT with n
            then fold(n.left f(n.key n.value fold(n.right v))) else v end
        fold(m init)
    end

let mapUnionWith(K::TYPE V::TYPE)(cmp: Cmp(K) f: All(a: V b: V) V m1: Map(K V) m2: Map(K V)): Map(K V) =
    begin
        let ins(f: All(a: V b: V) V): All(k: K x: V m: Map(K V)) Map(K V) =
            fun(k: K x: V m: Map(K V)): Map(K V)
                case mapFind(:K :V)(cmp m k)
                    when oSome with x1 then mapInsert(:K :V)(cmp m k f(x x1.x))
                    else mapInsert(:K :V)(cmp m k x)
                end
        if mapNumItems(:K :V)(m1) > mapNumItems(:K :V)(m2) then
            mapFoldli(:K :V :Map(K V))(ins(fun(a: V b: V): V f(b a)) m1 m2)
        else mapFoldli(:K :V :Map(K V))(ins(f) m2 m1)
        end
    end

let mapUnionWithi(K::TYPE V::TYPE)(cmp: Cmp(K) f: All(k: K a: V b: V) V m1: Map(K V) m2: Map(K V)): Map(K V) =
    begin
        let ins(f: All(k: K a: V b: V) V): All(k: K x: V m: Map(K V)) Map(K V) =
            fun(k: K x: V m: Map(K V)): Map(K V)
                case mapFind(:K :V)(cmp m k)
                    when oSome with x1 then mapInsert(:K :V)(cmp m k f(k x x1.x))
                    else mapInsert(:K :V)(cmp m k x)
                end
        if mapNumItems(:K :V)(m1) > mapNumItems(:K :V)(m2) then
            mapFoldli(:K :V :Map(K V))(ins(fun(k: K a: V b: V): V f(k b a)) m1 m2)
        else mapFoldli(:K :V :Map(K V))(ins(f) m2 m1)
        end
    end

(* FinMapFn *)
let mapFromList(K::TYPE V::TYPE)(cmp: Cmp(K) kvs: lists.T(P2(K V))): Map(K V) =
    lists.foldl(:P2(K V) :Map(K V))(fun(kv: P2(K V) m: Map(K V)): Map(K V) mapInsert(:K :V)(cmp m kv.a kv.b)
        mapEmpty(:K :V)() kvs)

let mapAll(K::TYPE V::TYPE)(p: All(v: V) Bool m: Map(K V)): Bool =
    mapFoldl(:K :V :Bool)(fun(v: V b: Bool): Bool b andif p(v) true m)
let mapExists(K::TYPE V::TYPE)(p: All(v: V) Bool m: Map(K V)): Bool =
    mapFoldl(:K :V :Bool)(fun(v: V b: Bool): Bool b orif p(v) false m)

(* functor BinarySetFn and functor FinSetFn *)

Let Rec Set(K::TYPE) = Option sE sT with elt: K cnt: Int left: Set(K) right: Set(K) end end

let setEmpty(K::TYPE)(): Set(K) = option sE of Set(K) end
let setNumItems(K::TYPE)(s: Set(K)): Int = case s when sT with n then n.cnt else 0 end
let setIsEmpty(K::TYPE)(s: Set(K)): Bool = case s when sE then true else false end
let mkT(K::TYPE)(v: K n: Int l: Set(K) r: Set(K)): Set(K) = option sT of Set(K) with v n l r end

let setN(K::TYPE)(v: K l: Set(K) r: Set(K)): Set(K) = mkT(:K)(v 1 + setNumItems(:K)(l) + setNumItems(:K)(r) l r)

let setSingleL(K::TYPE)(a: K x: Set(K) r: Set(K)): Set(K) =
    case r when sT with b then setN(:K)(b.elt setN(:K)(a x b.left) b.right) else throw(:Set(K))(matchE) end
let setSingleR(K::TYPE)(b: K l: Set(K) z: Set(K)): Set(K) =
    case l when sT with a then setN(:K)(a.elt a.left setN(:K)(b a.right z)) else throw(:Set(K))(matchE) end
let setDoubleL(K::TYPE)(a: K w: Set(K) r: Set(K)): Set(K) =
    case r
        when sT with c then
            case c.left when sT with b then setN(:K)(b.elt setN(:K)(a w b.left) setN(:K)(c.elt b.right c.right))
                else throw(:Set(K))(matchE)
            end
        else throw(:Set(K))(matchE)
    end
let setDoubleR(K::TYPE)(c: K l: Set(K) z: Set(K)): Set(K) =
    case l
        when sT with a then
            case a.right when sT with b then setN(:K)(b.elt setN(:K)(a.elt a.left b.left) setN(:K)(c b.right z))
                else throw(:Set(K))(matchE)
            end
        else throw(:Set(K))(matchE)
    end

(* T' *)
let setT1(K::TYPE)(v: K l: Set(K) r: Set(K)): Set(K) =
    begin
        let e(t: Set(K)): Bool = setIsEmpty(:K)(t)
        let size(t: Set(K)): Int = setNumItems(:K)(t)
        case l
            when sE then
                case r
                    when sE then mkT(:K)(v 1 l r)
                    when sT with rn then
                        if e(rn.left) andif e(rn.right) then mkT(:K)(v 2 l r)
                        elsif not(e(rn.left)) andif e(rn.right) then setDoubleL(:K)(v l r)
                        elsif not(e(rn.left)) andif not(e(rn.right)) then
                            if size(rn.left) < size(rn.right) then setSingleL(:K)(v l r) else setDoubleL(:K)(v l r) end
                        else setSingleL(:K)(v l r)
                        end
                end
            when sT with ln then
                case r
                    when sE then
                        if e(ln.left) andif e(ln.right) then mkT(:K)(v 2 l r)
                        elsif e(ln.left) andif not(e(ln.right)) then setDoubleR(:K)(v l r)
                        elsif not(e(ln.left)) andif not(e(ln.right)) then
                            if size(ln.left) > size(ln.right) then setSingleR(:K)(v l r) else setDoubleR(:K)(v l r) end
                        else setSingleR(:K)(v l r)
                        end
                    when sT with rn then
                        if rn.cnt >= wt(ln.cnt) then
                            if size(rn.left) < size(rn.right) then setSingleL(:K)(v l r) else setDoubleL(:K)(v l r) end
                        elsif ln.cnt >= wt(rn.cnt) then
                            if size(ln.right) < size(ln.left) then setSingleR(:K)(v l r) else setDoubleR(:K)(v l r) end
                        else mkT(:K)(v ln.cnt + rn.cnt + 1 l r)
                        end
                end
        end
    end

let setAdd(K::TYPE)(cmp: Cmp(K) s: Set(K) x: K): Set(K) =
    begin
        let rec add(t: Set(K)): Set(K) =
            case t
                when sT with n then
                    begin
                        let c = cmp(x n.elt)
                        if c < 0 then setT1(:K)(n.elt add(n.left) n.right)
                        elsif c > 0 then setT1(:K)(n.elt n.left add(n.right))
                        else mkT(:K)(x n.cnt n.left n.right)
                        end
                    end
                else mkT(:K)(x 1 t t)
            end
        add(s)
    end

let rec concat3(K::TYPE)(cmp: Cmp(K) l: Set(K) v: K r: Set(K)): Set(K) =
    case l
        when sE then setAdd(:K)(cmp r v)
        when sT with n1 then
            case r
                when sE then setAdd(:K)(cmp l v)
                when sT with n2 then
                    if wt(n1.cnt) < n2.cnt then setT1(:K)(n2.elt concat3(:K)(cmp l v n2.left) n2.right)
                    elsif wt(n2.cnt) < n1.cnt then setT1(:K)(n1.elt n1.left concat3(:K)(cmp n1.right v r))
                    else setN(:K)(v l r)
                    end
            end
    end

let rec splitLt(K::TYPE)(cmp: Cmp(K) s: Set(K) x: K): Set(K) =
    case s
        when sT with n then
            begin
                let c = cmp(n.elt x)
                if c > 0 then splitLt(:K)(cmp n.left x)
                elsif c < 0 then concat3(:K)(cmp n.left n.elt splitLt(:K)(cmp n.right x))
                else n.left
                end
            end
        else s
    end

let rec splitGt(K::TYPE)(cmp: Cmp(K) s: Set(K) x: K): Set(K) =
    case s
        when sT with n then
            begin
                let c = cmp(n.elt x)
                if c < 0 then splitGt(:K)(cmp n.right x)
                elsif c > 0 then concat3(:K)(cmp splitGt(:K)(cmp n.left x) n.elt n.right)
                else n.right
                end
            end
        else s
    end

let rec setMin(K::TYPE)(s: Set(K)): K =
    case s
        when sT with n then case n.left when sE then n.elt else setMin(:K)(n.left) end
        else throw(:K)(matchE)
    end

let rec setDelmin(K::TYPE)(s: Set(K)): Set(K) =
    case s
        when sT with n then case n.left when sE then n.right else setT1(:K)(n.elt setDelmin(:K)(n.left) n.right) end
        else throw(:Set(K))(matchE)
    end

let setDelete1(K::TYPE)(l: Set(K) r: Set(K)): Set(K) =
    case l
        when sE then r
        else case r when sE then l else setT1(:K)(setMin(:K)(r) l setDelmin(:K)(r)) end
    end

let rec setConcat(K::TYPE)(t1: Set(K) t2: Set(K)): Set(K) =
    case t1
        when sE then t2
        when sT with n1 then
            case t2
                when sE then t1
                when sT with n2 then
                    if wt(n1.cnt) < n2.cnt then setT1(:K)(n2.elt setConcat(:K)(t1 n2.left) n2.right)
                    elsif wt(n2.cnt) < n1.cnt then setT1(:K)(n1.elt n1.left setConcat(:K)(n1.right t2))
                    else setT1(:K)(setMin(:K)(t2) t1 setDelmin(:K)(t2))
                    end
            end
    end

(* hedge_union *)
let setUnion(K::TYPE)(cmp: Cmp(K) s1: Set(K) s2: Set(K)): Set(K) =
    begin
        let rec trim(lo: K hi: K s: Set(K)): Set(K) =
            case s
                when sT with n then
                    if cmp(n.elt lo) > 0 then if cmp(n.elt hi) < 0 then s else trim(lo hi n.left) end
                    else trim(lo hi n.right)
                    end
                else s
            end
        let rec uniBd(s: Set(K) s2: Set(K) lo: K hi: K): Set(K) =
            case s2
                when sT with n2 then
                    case s
                        when sT with n then
                            concat3(:K)(cmp uniBd(n.left trim(lo n.elt s2) lo n.elt) n.elt
                                uniBd(n.right trim(n.elt hi s2) n.elt hi))
                        else concat3(:K)(cmp splitGt(:K)(cmp n2.left lo) n2.elt splitLt(:K)(cmp n2.right hi))
                    end
                else s
            end
        let rec trimLo(lo: K s: Set(K)): Set(K) =
            case s when sT with n then if cmp(n.elt lo) > 0 then s else trimLo(lo n.right) end else s end
        let rec trimHi(hi: K s: Set(K)): Set(K) =
            case s when sT with n then if cmp(n.elt hi) < 0 then s else trimHi(hi n.left) end else s end
        let rec uniHi(s: Set(K) s2: Set(K) hi: K): Set(K) =
            case s2
                when sT with n2 then
                    case s
                        when sT with n then
                            concat3(:K)(cmp uniHi(n.left trimHi(n.elt s2) n.elt) n.elt
                                uniBd(n.right trim(n.elt hi s2) n.elt hi))
                        else concat3(:K)(cmp n2.left n2.elt splitLt(:K)(cmp n2.right hi))
                    end
                else s
            end
        let rec uniLo(s: Set(K) s2: Set(K) lo: K): Set(K) =
            case s2
                when sT with n2 then
                    case s
                        when sT with n then
                            concat3(:K)(cmp uniBd(n.left trim(lo n.elt s2) lo n.elt) n.elt
                                uniLo(n.right trimLo(n.elt s2) n.elt))
                        else concat3(:K)(cmp splitGt(:K)(cmp n2.left lo) n2.elt n2.right)
                    end
                else s
            end
        case s2
            when sT then
                case s1
                    when sT with n then
                        concat3(:K)(cmp uniHi(n.left trimHi(n.elt s2) n.elt) n.elt
                            uniLo(n.right trimLo(n.elt s2) n.elt))
                    else s2
                end
            else s1
        end
    end

let setSingleton(K::TYPE)(x: K): Set(K) = mkT(:K)(x 1 setEmpty(:K)() setEmpty(:K)())

let setAddList(K::TYPE)(cmp: Cmp(K) s: Set(K) l: lists.T(K)): Set(K) =
    lists.foldl(:K :Set(K))(fun(i: K s: Set(K)): Set(K) setAdd(:K)(cmp s i) s l)

let setMember(K::TYPE)(cmp: Cmp(K) s: Set(K) x: K): Bool =
    begin
        let rec pk(t: Set(K)): Bool =
            case t
                when sT with n then begin let c = cmp(x n.elt) if c < 0 then pk(n.left) elsif c is 0 then true
                    else pk(n.right) end end
                else false
            end
        pk(s)
    end

let setIsSubset(K::TYPE)(cmp: Cmp(K) t: Set(K) t1: Set(K)): Bool =
    begin
        let rec isIn(s: Set(K)): Bool =
            case s
                when sT with n then
                    setMember(:K)(cmp t1 n.elt) andif {setIsEmpty(:K)(n.left) orif isIn(n.left)}
                        andif {setIsEmpty(:K)(n.right) orif isIn(n.right)}
                else true
            end
        case t
            when sT with n then
                case t1 when sT with n1 then {n.cnt <= n1.cnt} andif isIn(t) else false end
            else true
        end
    end

let setDelete(K::TYPE)(cmp: Cmp(K) s: Set(K) x: K): Set(K) =
    begin
        let rec delete(t: Set(K)): Set(K) =
            case t
                when sT with n then
                    begin
                        let c = cmp(x n.elt)
                        if c < 0 then setT1(:K)(n.elt delete(n.left) n.right)
                        elsif c > 0 then setT1(:K)(n.elt n.left delete(n.right))
                        else setDelete1(:K)(n.left n.right)
                        end
                    end
                else throw(:Set(K))(notFound)
            end
        delete(s)
    end

let rec setIntersection(K::TYPE)(cmp: Cmp(K) s: Set(K) t: Set(K)): Set(K) =
    case s
        when sE then s
        else
            case t
                when sT with n then
                    begin
                        let l2 = splitLt(:K)(cmp s n.elt)
                        let r2 = splitGt(:K)(cmp s n.elt)
                        if setMember(:K)(cmp s n.elt) then
                            concat3(:K)(cmp setIntersection(:K)(cmp l2 n.left) n.elt
                                setIntersection(:K)(cmp r2 n.right))
                        else setConcat(:K)(setIntersection(:K)(cmp l2 n.left) setIntersection(:K)(cmp r2 n.right))
                        end
                    end
                else t
            end
    end

let rec setDifference(K::TYPE)(cmp: Cmp(K) s: Set(K) t: Set(K)): Set(K) =
    case s
        when sE then s
        else
            case t
                when sT with n then
                    begin
                        let l2 = splitLt(:K)(cmp s n.elt)
                        let r2 = splitGt(:K)(cmp s n.elt)
                        setConcat(:K)(setDifference(:K)(cmp l2 n.left) setDifference(:K)(cmp r2 n.right))
                    end
                else s
            end
    end

let setFoldr(K::TYPE B::TYPE)(f: All(k: K b: B) B b: B s: Set(K)): B =
    begin
        let rec foldf(t: Set(K) b: B): B = case t when sT with n then foldf(n.left f(n.elt foldf(n.right b))) else b end
        foldf(s b)
    end

let setFoldl(K::TYPE B::TYPE)(f: All(k: K b: B) B b: B s: Set(K)): B =
    begin
        let rec foldf(t: Set(K) b: B): B = case t when sT with n then foldf(n.right f(n.elt foldf(n.left b))) else b end
        foldf(s b)
    end

let setListItems(K::TYPE)(s: Set(K)): lists.T(K) =
    setFoldr(:K :lists.T(K))(fun(k: K l: lists.T(K)): lists.T(K) lists.cons(:K)(k l) lists.nil(:K) s)

let setFromList(K::TYPE)(cmp: Cmp(K) xs: lists.T(K)): Set(K) = setAddList(:K)(cmp setEmpty(:K)() xs)

let setApp(K::TYPE)(f: All(k: K) Ok s: Set(K)): Ok =
    begin
        let rec apply(t: Set(K)): Ok = case t when sT with n
            then begin apply(n.left) f(n.elt) apply(n.right) end else ok end
        apply(s)
    end

let rec setExists(K::TYPE)(p: All(k: K) Bool s: Set(K)): Bool =
    case s when sT with n then setExists(:K)(p n.left) orif p(n.elt) orif setExists(:K)(p n.right) else false end

(* Identifiers: VId, TyCon, StrId are strings; long identifiers are their
 * structure identifiers and an identifier *)
Let LongId = Tuple strids: Strings id: String end
let longIdFromId(id: String): LongId = tuple let strids = lists.nil(:String) let id = id end
let isUnqualified(l: LongId): Bool = lists.null(:String)(l.strids)

(* Int.fromString: after any whitespace, an optional sign and at least one
 * digit *)
let intFromString(s: String): Opt(Int) =
    begin
        let n = stringOp.length(s)
        let isWs(c: Char): Bool = begin let k = ascii.val(c) {k is 32} orif {{k >= 9} andif {k <= 13}} end
        let isDigit(c: Char): Bool = {ascii.val(c) >= ascii.val('0')} andif {ascii.val(c) <= ascii.val('9')}
        let var i = 0
        while {i < n} andif isWs(stringOp.getChar(s i)) do i := i + 1 end
        let var neg = false
        if i < n then
            begin
                let c = stringOp.getChar(s i)
                if {c is '~'} orif {c is '-'} then begin neg := true i := i + 1 end
                elsif c is '+' then i := i + 1
                end
            end
        end
        if {i < n} andif isDigit(stringOp.getChar(s i)) then
            begin
                let var v = 0
                while {i < n} andif isDigit(stringOp.getChar(s i)) do
                    v := {v * 10} + {ascii.val(stringOp.getChar(s i)) - ascii.val('0')}
                    i := i + 1
                end
                some(:Int)(if neg then 0 - v else v end)
            end
        else none(:Int)()
        end
    end

(* structure TyVar *)
Let TyVar = Tuple name: String equality: Bool end
let tyVar(name: String equality: Bool): TyVar = tuple let name = name let equality = equality end
let tyVarEq(a: TyVar b: TyVar): Bool = strEq(a.name b.name) andif {a.equality is b.equality}
let tyVarCompare(a: TyVar b: TyVar): Int = strCompare(a.name b.name)
let tyVarInvent(equality: Bool): TyVar = tyVar("'#" <> intToString(stamp()) equality)
let tyVarFromString(s: String): TyVar =
    tyVar(s {stringOp.length(s) > 1} andif {stringOp.getChar(s 1) is '\''})
let tyVarIsExplicit(a: TyVar): Bool = {stringOp.length(a.name) is 1} orif {stringOp.getChar(a.name 1) isnot '#'}
let tyVarFromIndex(equality: Bool n: Int): TyVar =
    begin
        let rec rep(n: Int c: String): String = if n is 0 then c else c <> rep(n - 1 c) end
        let c = stringOp.new(1 ascii.char(ascii.val('a') + {n % 26}))
        tyVar(if equality then "''" else "'" end <> rep(n / 26 c) equality)
    end
let tyVarInstance(a: TyVar): TyVar = tyVarInvent(a.equality)
let tyVarNormalise(a: TyVar n: Int): TyVar = tyVarFromIndex(a.equality n)

(* structure TyName *)
Let Equality = Option noEq eqEq specialEq end
let noEq = option noEq of Equality end
let eqEq = option eqEq of Equality end
let specialEq = option specialEq of Equality end
let isEqEq(e: Equality): Bool = case e when eqEq then true else false end

Let TyName = Tuple tycon: String stamp: Int arity: Int equality: Equality span: Int end
let tyName(tycon: String arity: Int equality: Equality span: Int): TyName =
    begin
        let s = stamp()
        tuple let tycon = tycon let stamp = s let arity = arity let equality = equality let span = span end
    end
let tyNameRemoveEquality(t: TyName): TyName = tyName(t.tycon t.arity noEq t.span)
let tyNameEq(a: TyName b: TyName): Bool = a.stamp is b.stamp
let tyNameCompare(a: TyName b: TyName): Int = intCompare(a.stamp b.stamp)

(* structure Lab *)
let labCompare(lab1: String lab2: String): Int =
    case intFromString(lab1)
        when oSome with i1 then
            case intFromString(lab2) when oSome with i2 then intCompare(i1.x i2.x) else strCompare(lab1 lab2) end
        else strCompare(lab1 lab2)
    end

(* structure OverloadingClass *)
Let OClass = Tuple t: Set(TyName) default: TyName end
let oClassUnion(a: OClass b: OClass): OClass =
    tuple let t = setUnion(:TyName)(tyNameCompare a.t b.t) let default = b.default end

(* structure Type *)

Let RowVar = Option closedRow flexRow with eq: Bool end end
let closedRow = option closedRow of RowVar end

Let Rec TypeR = Tuple var t: Type1 end
and Type1 = Option
    tvTyVar with alpha: TyVar end
    tvRow with row: RowType end
    tvFun with a: TypeR b: TypeR end
    tvCons with taus: lists.T(TypeR) t: TyName end
    tvOverloaded with o: OClass end
    tvLink with tau: TypeR end
end
and RowType = Tuple rho: Map(String TypeR) r: RowVar end

Let Types = lists.T(TypeR)
Let TyVars = lists.T(TyVar)
(* TypeScheme and TypeFcn *)
Let TypeFcn = Tuple alphas: TyVars tau: TypeR end
Let Subst = Map(TyVar TypeR)
Let Realisation = Map(TyName TypeFcn)

let typeFcn(alphas: TyVars tau: TypeR): TypeFcn = tuple let alphas = alphas let tau = tau end
let typeRef(t: Type1): TypeR = tuple let var t = t end
let rowType(rho: Map(String TypeR) r: RowVar): RowType = tuple let rho = rho let r = r end

let typeInvent(): TypeR = typeRef(option tvTyVar of Type1 with tyVarInvent(false) end)
let fromTyVar(alpha: TyVar): TypeR = typeRef(option tvTyVar of Type1 with alpha end)
let fromRowType(row: RowType): TypeR = typeRef(option tvRow of Type1 with row end)
let fromFunType(a: TypeR b: TypeR): TypeR = typeRef(option tvFun of Type1 with a b end)
let fromConsType(taus: Types t: TyName): TypeR = typeRef(option tvCons of Type1 with taus t end)

let typeRange(tau: TypeR): TypeR = case tau.t when tvFun with f then f.b else tau end

let typeTyName(tau: TypeR): TyName =
    case tau.t when tvCons with c then c.t else failure(:TyName)("Type.tyname: non-constructed type") end

let typeNormalise(tau0: TypeR): TypeR =
    begin
        let alphas = tuple let var l = lists.nil(:P2(TyVar TypeR)) end
        let rec normalise(tau: TypeR): TypeR =
            case tau.t
                when tvTyVar with x then
                    begin
                        let rec find(l: lists.T(P2(TyVar TypeR))): TypeR =
                            case l
                                when cons with c then if tyVarEq(c.hd.a x.alpha) then c.hd.b else find(c.tl) end
                                else begin alphas.l :=
                                    lists.cons(:P2(TyVar TypeR))(p2(:TyVar :TypeR)(x.alpha tau) alphas.l) tau end
                            end
                        find(alphas.l)
                    end
                when tvLink with x then normalise(x.tau)
                else begin tau.t := normalise1(tau.t) tau end
            end
        and normalise1(t: Type1): Type1 =
            case t
                when tvRow with x then
                    option tvRow of Type1 with rowType(mapMap(:String :TypeR :TypeR)(normalise x.row.rho) x.row.r) end
                when tvFun with x then
                    begin let a = normalise(x.a) let b = normalise(x.b) option tvFun of Type1 with a b end end
                when tvCons with x then option tvCons of Type1 with lists.map(:TypeR :TypeR)(normalise x.taus) x.t end
                when tvOverloaded then t
                else failure(:Type1)("Type.normalise: bypassed type variable or link")
            end
        normalise(tau0)
    end

let typeClone(mu: Subst phi: Realisation tau0: TypeR): TypeR =
    begin
        let muRef = tuple let var m = mu end
        let cloned = tuple let var l = lists.nil(:P2(TypeR TypeR)) end
        let rec clone(tau: TypeR): TypeR =
            begin
                let rec find(l: lists.T(P2(TypeR TypeR))): TypeR =
                    case l
                        when cons with c then if c.hd.a is tau then c.hd.b else find(c.tl) end
                        else
                            begin
                                let tau2 = clone1(tau)
                                cloned.l := lists.cons(:P2(TypeR TypeR))(p2(:TypeR :TypeR)(tau tau2) cloned.l)
                                tau2
                            end
                    end
                find(cloned.l)
            end
        and clone1(tau: TypeR): TypeR =
            case tau.t
                when tvTyVar with x then
                    case mapFind(:TyVar :TypeR)(tyVarCompare muRef.m x.alpha) when oSome with t then t.x else tau end
                when tvRow with x then
                    typeRef(option tvRow of Type1 with
                        rowType(mapMap(:String :TypeR :TypeR)(clone x.row.rho) x.row.r) end)
                when tvFun with x then
                    begin let a = clone(x.a) let b = clone(x.b) typeRef(option tvFun of Type1 with a b end) end
                when tvCons with x then
                    begin
                        let taus2 = lists.map(:TypeR :TypeR)(clone x.taus)
                        case mapFind(:TyName :TypeFcn)(tyNameCompare phi x.t)
                            when oSome with f then
                                begin
                                    let cloned1 = cloned.l
                                    let rec pairs(alphas: TyVars taus: Types m: Subst): Subst =
                                        case alphas
                                            when cons with a then
                                                case taus
                                                    when cons with t
                                                        then pairs(a.tl t.tl
                                                            mapInsert(:TyVar :TypeR)(tyVarCompare m a.hd t.hd))
                                                    else m
                                                end
                                            else m
                                        end
                                    muRef.m := pairs(f.x.alphas taus2 muRef.m)
                                    let result = clone1(f.x.tau)
                                    cloned.l := cloned1
                                    result
                                end
                            else typeRef(option tvCons of Type1 with taus2 x.t end)
                        end
                    end
                when tvOverloaded with x then typeRef(option tvOverloaded of Type1 with x.o end)
                when tvLink with x then clone(x.tau)
            end
        clone(tau0)
    end

let typeSubstitute(mu: Subst tau: TypeR): TypeR = typeClone(mu mapEmpty(:TyName :TypeFcn)() tau)
let typeRealise(phi: Realisation tau: TypeR): TypeR = typeClone(mapEmpty(:TyVar :TypeR)() phi tau)

Let TyVarSet = Set(TyVar)
Let TyNameSet = Set(TyName)

let rec typeTyvars(tau: TypeR): TyVarSet =
    case tau.t
        when tvTyVar with x then setSingleton(:TyVar)(x.alpha)
        when tvRow with x then
            mapFoldl(:String :TypeR :TyVarSet)(
                fun(tau: TypeR u: TyVarSet): TyVarSet setUnion(:TyVar)(tyVarCompare u typeTyvars(tau))
                    setEmpty(:TyVar)()
                x.row.rho)
        when tvFun with x then setUnion(:TyVar)(tyVarCompare typeTyvars(x.a) typeTyvars(x.b))
        when tvCons with x then
            lists.foldl(:TypeR :TyVarSet)(fun(tau: TypeR u: TyVarSet): TyVarSet
                setUnion(:TyVar)(tyVarCompare u typeTyvars(tau))
                setEmpty(:TyVar)() x.taus)
        when tvOverloaded then setEmpty(:TyVar)()
        when tvLink with x then typeTyvars(x.tau)
    end

let rec typeTynames(tau: TypeR): TyNameSet =
    case tau.t
        when tvTyVar then setEmpty(:TyName)()
        when tvRow with x then
            mapFoldl(:String :TypeR :TyNameSet)(
                fun(tau: TypeR u: TyNameSet): TyNameSet setUnion(:TyName)(tyNameCompare u typeTynames(tau))
                setEmpty(:TyName)() x.row.rho)
        when tvFun with x then setUnion(:TyName)(tyNameCompare typeTynames(x.a) typeTynames(x.b))
        when tvCons with x then
            begin
                let t = lists.foldl(:TypeR :TyNameSet)(
                    fun(tau: TypeR u: TyNameSet): TyNameSet setUnion(:TyName)(tyNameCompare u typeTynames(tau))
                    setEmpty(:TyName)() x.taus)
                setAdd(:TyName)(tyNameCompare t x.t)
            end
        when tvOverloaded with x then x.o.t
        when tvLink with x then typeTynames(x.tau)
    end


let rec typeAdmitsEquality(tau: TypeR): Bool =
    case tau.t
        when tvTyVar with x then x.alpha.equality orif not(tyVarIsExplicit(x.alpha))
        when tvRow with x then
            case x.row.r
                when closedRow then mapAll(:String :TypeR)(typeAdmitsEquality x.row.rho)
                else failure(:Bool)("Type.admitsEquality: flexible row")
            end
        when tvFun then false
        when tvCons with x then
            case x.t.equality
                when specialEq then true
                when eqEq then lists.all(:TypeR)(typeAdmitsEquality x.taus)
                else false
            end
        when tvOverloaded then failure(:Bool)("Type.admitsEquality: overloaded type")
        when tvLink with x then typeAdmitsEquality(x.tau)
    end

let rec typeIsFlexible(tau: TypeR): Bool =
    case tau.t
        when tvTyVar then false
        when tvRow with x then
            case x.row.r when closedRow then mapExists(:String :TypeR)(typeIsFlexible x.row.rho) else true end
        when tvFun with x then typeIsFlexible(x.a) orif typeIsFlexible(x.b)
        when tvCons with x then lists.exists(:TypeR)(typeIsFlexible x.taus)
        when tvOverloaded then false
        when tvLink with x then typeIsFlexible(x.tau)
    end

let unifyE: Exception = exception unify: Ok end

let rec occurs(alpha: TyVar tau: TypeR): Bool = occurs1(alpha tau.t)
and occurs1(alpha: TyVar t: Type1): Bool =
    case t
        when tvTyVar with x then tyVarEq(alpha x.alpha)
        when tvRow with x then mapExists(:String :TypeR)(fun(tau: TypeR): Bool occurs(alpha tau) x.row.rho)
        when tvFun with x then occurs(alpha x.a) orif occurs(alpha x.b)
        when tvCons with x then lists.exists(:TypeR)(fun(tau: TypeR): Bool occurs(alpha tau) x.taus)
        when tvOverloaded then false
        when tvLink with x then occurs(alpha x.tau)
    end

let rec makeEquality(tau: TypeR): Ok = tau.t := makeEquality1(tau.t)
and makeEquality1(t: Type1): Type1 =
    case t
        when tvTyVar with x then
            if x.alpha.equality then t
            elsif tyVarIsExplicit(x.alpha) then throw(:Type1)(unifyE)
            else option tvTyVar of Type1 with tyVarInvent(true) end
            end
        when tvRow with x then
            begin
                mapApp(:String :TypeR)(makeEquality x.row.rho)
                option tvRow of Type1 with
                    rowType(x.row.rho case x.row.r when closedRow then closedRow
                        else option flexRow of RowVar with true end end)
                end
            end
        when tvFun then throw(:Type1)(unifyE)
        when tvCons with x then
            case x.t.equality
                when specialEq then t
                when eqEq then begin lists.app(:TypeR)(makeEquality x.taus) t end
                else throw(:Type1)(unifyE)
            end
        when tvOverloaded then throw(:Type1)(unifyE)
        when tvLink with x then begin makeEquality(x.tau) t end
    end

let rec unify(tau1: TypeR tau2: TypeR): Ok =
    case tau1.t
        when tvLink with l then unify(l.tau tau2)
        else
            case tau2.t
                when tvLink with l then unify(tau1 l.tau)
                else
                    if tau1 is tau2 then ok
                    else
                        begin
                            let t = option tvLink of Type1 with typeRef(unify1(tau1.t tau2.t)) end
                            tau1.t := t
                            tau2.t := t
                        end
                    end
            end
    end
and unify1(t1: Type1 t2: Type1): Type1 =
    case t1
        when tvTyVar with x then unifyTyVar(x.alpha t2)
        else
            case t2
                when tvTyVar with x then unifyTyVar(x.alpha t1)
                else
                    case t1
                        when tvOverloaded then throw(:Type1)(unifyE)
                        when tvFun with f1 then
                            case t2
                                when tvOverloaded then throw(:Type1)(unifyE)
                                when tvFun with f2 then begin unify(f1.a f2.a) unify(f1.b f2.b) t1 end
                                else throw(:Type1)(unifyE)
                            end
                        when tvRow with r1 then
                            case t2
                                when tvOverloaded then throw(:Type1)(unifyE)
                                when tvRow with r2 then unifyRows(r1.row r2.row)
                                else throw(:Type1)(unifyE)
                            end
                        when tvCons with c1 then
                            case t2
                                when tvOverloaded then throw(:Type1)(unifyE)
                                when tvCons with c2 then
                                    if tyNameEq(c1.t c2.t) then
                                        begin
                                            let rec app(a: Types b: Types): Ok =
                                                case a
                                                    when cons with x then
                                                        case b when cons with y
                                                            then begin unify(x.hd y.hd) app(x.tl y.tl) end else ok end
                                                    else ok
                                                end
                                            app(c1.taus c2.taus)
                                            t1
                                        end
                                    else throw(:Type1)(unifyE)
                                    end
                                else throw(:Type1)(unifyE)
                            end
                        else throw(:Type1)(unifyE)
                    end
            end
    end
and unifyRows(row1: RowType row2: RowType): Type1 =
    begin
        Let LabMap = Map(String TypeR)
        let unifyField(r: RowVar): All(lab: String tau1: TypeR rho: LabMap) LabMap =
            fun(lab: String tau1: TypeR rho: LabMap): LabMap
                case mapFind(:String :TypeR)(labCompare rho lab)
                    when oSome with tau2
                        then begin unify(tau1 tau2.x) mapRemove(:String :TypeR)(labCompare rho lab).a end
                    else
                        case r
                            when flexRow with f then begin if f.eq then makeEquality(tau1) end rho end
                            else throw(:LabMap)(unifyE)
                        end
                end
        let rho1 = mapFoldli(:String :TypeR :LabMap)(unifyField(row1.r) row1.rho row2.rho)
        let unused = mapFoldli(:String :TypeR :LabMap)(unifyField(row2.r) row2.rho rho1)
        let r =
            case row1.r
                when closedRow then closedRow
                when flexRow with f1 then
                    case row2.r
                        when closedRow then closedRow
                        when flexRow with f2 then option flexRow of RowVar with f1.eq orif f2.eq end
                    end
            end
        option tvRow of Type1 with
            rowType(mapUnionWith(:String :TypeR)(labCompare fun(a: TypeR b: TypeR): TypeR b row2.rho rho1) r)
        end
    end
and unifyTyVar(alpha: TyVar t: Type1): Type1 =
    case t
        when tvTyVar with x then
            if tyVarEq(alpha x.alpha) then t
            elsif not(tyVarIsExplicit(alpha)) then bindTyVar(alpha t)
            elsif not(tyVarIsExplicit(x.alpha)) then bindTyVar(x.alpha option tvTyVar of Type1 with alpha end)
            else throw(:Type1)(unifyE)
            end
        else
            if tyVarIsExplicit(alpha) orif occurs1(alpha t) then throw(:Type1)(unifyE) else bindTyVar(alpha t) end
    end
and bindTyVar(alpha: TyVar t: Type1): Type1 = if alpha.equality then makeEquality1(t) else t end

let rec defaultOverloaded(tau: TypeR): Ok =
    case tau.t
        when tvOverloaded with x then tau.t := option tvCons of Type1 with lists.nil(:TypeR) x.o.default end
        when tvRow with x then mapApp(:String :TypeR)(defaultOverloaded x.row.rho)
        when tvFun with x then begin defaultOverloaded(x.a) defaultOverloaded(x.b) end
        when tvCons with x then lists.app(:TypeR)(defaultOverloaded x.taus)
        when tvLink with x then defaultOverloaded(x.tau)
        else ok
    end

let emptyRho: RowType = rowType(mapEmpty(:String :TypeR)() closedRow)
let insertRho(row: RowType lab: String
    tau: TypeR): RowType = rowType(mapInsert(:String :TypeR)(labCompare row.rho lab tau) row.r)
let findLab(row: RowType lab: String): Opt(TypeR) = mapFind(:String :TypeR)(labCompare row.rho lab)

(* structure TypeScheme; a TypeFcn is the same type *)

let listFoldri(A::TYPE B::TYPE)(f: All(n: Int x: A b: B) B y0: B xs: lists.T(A)): B =
    begin
        let rec fold(n: Int xs: lists.T(A)): B = case xs when cons with c then f(n c.hd fold(n + 1 c.tl)) else y0 end
        fold(0 xs)
    end

let schemeTyvars(s: TypeFcn): TyVarSet =
    lists.foldl(:TyVar :TyVarSet)(
        fun(alpha: TyVar u: TyVarSet): TyVarSet try setDelete(:TyVar)(tyVarCompare u alpha) when notFound then u end
        typeTyvars(s.tau) s.alphas)

let schemeTynames(s: TypeFcn): TyNameSet = typeTynames(s.tau)

(* ListPair.foldl, into a substitution *)
let pairSubst(alphas: TyVars taus: Types): Subst =
    begin
        let rec f(alphas: TyVars taus: Types mu: Subst): Subst =
            case alphas
                when cons with a then
                    case taus when cons with t
                        then f(a.tl t.tl mapInsert(:TyVar :TypeR)(tyVarCompare mu a.hd t.hd)) else mu end
                else mu
            end
        f(alphas taus mapEmpty(:TyVar :TypeR)())
    end

let schemeInstance1(s: TypeFcn): TypeFcn =
    begin
        let alphas1 = lists.map(:TyVar :TyVar)(tyVarInstance s.alphas)
        let mu = pairSubst(s.alphas lists.map(:TyVar :TypeR)(fromTyVar alphas1))
        typeFcn(alphas1 typeSubstitute(mu s.tau))
    end

let schemeInstance(s: TypeFcn): TypeR = schemeInstance1(s).tau

let schemeClos(tau: TypeR): TypeFcn = typeFcn(setListItems(:TyVar)(typeTyvars(tau)) tau)

let schemeNormalise(s: TypeFcn): TypeFcn =
    begin
        let insert(n: Int alpha: TyVar am: P2(TyVars Subst)): P2(TyVars Subst) =
            begin
                let alpha1 = tyVarNormalise(alpha n)
                let tau = fromTyVar(alpha1)
                p2(:TyVars :Subst)(lists.cons(:TyVar)(alpha1 am.a)
                    mapInsert(:TyVar :TypeR)(tyVarCompare am.b alpha tau))
            end
        let am = listFoldri(:TyVar :P2(TyVars Subst))(insert
            p2(:TyVars :Subst)(lists.nil(:TyVar) mapEmpty(:TyVar :TypeR)())
            s.alphas)
        typeFcn(am.a typeSubstitute(am.b s.tau))
    end

let schemeRealise(phi: Realisation s: TypeFcn): TypeFcn = typeFcn(s.alphas typeRealise(phi s.tau))

(* structure TypeFcn *)

let typeFcnFromTyName(t: TyName): TypeFcn =
    begin
        let alphas = lists.tabulate(:TyVar)(t.arity fun(n: Int): TyVar tyVarFromIndex(false n))
        typeFcn(alphas fromConsType(lists.map(:TyVar :TypeR)(fromTyVar alphas) t))
    end

let typeFcnToTyName(f: TypeFcn): Opt(TyName) =
    case f.tau.t
        when tvCons with c then
            begin
                let isSame(alpha: TyVar tau: TypeR): Bool =
                    case tau.t when tvTyVar with x then tyVarEq(alpha x.alpha) else false end
                let rec all(a: TyVars b: Types): Bool =
                    case a
                        when cons with x then case b when cons with y then isSame(x.hd y.hd) andif all(x.tl y.tl)
                            else true end
                        else true
                    end
                if {lists.length(:TyVar)(f.alphas) is lists.length(:TypeR)(c.taus)} andif all(f.alphas c.taus) then
                    some(:TyName)(c.t)
                else none(:TyName)()
                end
            end
        else none(:TyName)()
    end

let applyE: Exception = exception apply: Ok end

let typeFcnApply(taus: Types f: TypeFcn): TypeR =
    if lists.length(:TypeR)(taus) isnot lists.length(:TyVar)(f.alphas) then throw(:TypeR)(applyE)
    else typeSubstitute(pairSubst(f.alphas taus) f.tau)
    end

(* structure IdStatus *)
Let IdStatus = Option isC isE isV end
let isC = option isC of IdStatus end
let isE = option isE of IdStatus end
let isV = option isV of IdStatus end

(* functor GenericEnvFn and structure StaticEnv *)

Let ValStr = Tuple sigma: TypeFcn status: IdStatus end
Let ValEnv = Map(String ValStr)
Let TyStr = Tuple theta: TypeFcn ve: ValEnv end
Let TyEnv = Map(String TyStr)
Let Rec SStr = Tuple se: Map(String SStr) te: TyEnv ve: ValEnv end
Let StaticEnv = SStr

let valStr(sigma: TypeFcn status: IdStatus): ValStr = tuple let sigma = sigma let status = status end
let tyStr(theta: TypeFcn ve: ValEnv): TyStr = tuple let theta = theta let ve = ve end
let staticEnv(se: Map(String SStr) te: TyEnv ve: ValEnv): StaticEnv = tuple let se = se let te = te let ve = ve end

let emptyVE = mapEmpty(:String :ValStr)()
let emptyTE = mapEmpty(:String :TyStr)()
let emptySE = mapEmpty(:String :SStr)()
let staticEmpty = staticEnv(emptySE emptyTE emptyVE)
let staticFromVE(ve: ValEnv): StaticEnv = staticEnv(emptySE emptyTE ve)
let staticFromVEandTE(ve: ValEnv te: TyEnv): StaticEnv = staticEnv(emptySE te ve)

let second(A::TYPE)(a: A b: A): A = b

let staticPlus(e: StaticEnv e1: StaticEnv): StaticEnv =
    staticEnv(mapUnionWith(:String :SStr)(strCompare second(:SStr) e.se e1.se)
        mapUnionWith(:String :TyStr)(strCompare second(:TyStr) e.te e1.te)
        mapUnionWith(:String :ValStr)(strCompare second(:ValStr) e.ve e1.ve))
let staticPlusVE(e: StaticEnv ve: ValEnv): StaticEnv =
    staticEnv(e.se e.te mapUnionWith(:String :ValStr)(strCompare second(:ValStr) e.ve ve))
let staticPlusTE(e: StaticEnv te: TyEnv): StaticEnv =
    staticEnv(e.se mapUnionWith(:String :TyStr)(strCompare second(:TyStr) e.te te) e.ve)

let findVId(e: StaticEnv vid: String): Opt(ValStr) = mapFind(:String :ValStr)(strCompare e.ve vid)
let findTyCon(e: StaticEnv tycon: String): Opt(TyStr) = mapFind(:String :TyStr)(strCompare e.te tycon)

(* findLongX, for the unqualified identifiers the input uses *)
let findLongVId(e: StaticEnv l: LongId): Opt(ValStr) =
    if isUnqualified(l) then findVId(e l.id) else failure(:Opt(ValStr))("long identifiers") end
let findLongTyCon(e: StaticEnv l: LongId): Opt(TyStr) =
    if isUnqualified(l) then findTyCon(e l.id) else failure(:Opt(TyStr))("long identifiers") end

let tyvarsVE(ve: ValEnv): TyVarSet =
    mapFoldl(:String :ValStr :TyVarSet)(fun(v: ValStr u: TyVarSet): TyVarSet
        setUnion(:TyVar)(tyVarCompare u schemeTyvars(v.sigma))
        setEmpty(:TyVar)() ve)
let tyvarsTE(te: TyEnv): TyVarSet =
    mapFoldl(:String :TyStr :TyVarSet)(
        fun(t: TyStr u: TyVarSet): TyVarSet
            setUnion(:TyVar)(tyVarCompare setUnion(:TyVar)(tyVarCompare u schemeTyvars(t.theta)) tyvarsVE(t.ve))
        setEmpty(:TyVar)() te)
let rec staticTyvars(e: StaticEnv): TyVarSet =
    setUnion(:TyVar)(tyVarCompare setUnion(:TyVar)(tyVarCompare tyvarsSE(e.se) tyvarsTE(e.te)) tyvarsVE(e.ve))
and tyvarsSE(se: Map(String SStr)): TyVarSet =
    mapFoldl(:String :SStr :TyVarSet)(fun(e: SStr u: TyVarSet): TyVarSet
        setUnion(:TyVar)(tyVarCompare u staticTyvars(e))
        setEmpty(:TyVar)() se)

let tynamesVE(ve: ValEnv): TyNameSet =
    mapFoldl(:String :ValStr :TyNameSet)(
        fun(v: ValStr u: TyNameSet): TyNameSet setUnion(:TyName)(tyNameCompare u schemeTynames(v.sigma))
        setEmpty(:TyName)() ve)
let tynamesTE(te: TyEnv): TyNameSet =
    mapFoldl(:String :TyStr :TyNameSet)(
        fun(t: TyStr u: TyNameSet): TyNameSet
            setUnion(:TyName)(tyNameCompare setUnion(:TyName)(tyNameCompare u schemeTynames(t.theta)) tynamesVE(t.ve))
        setEmpty(:TyName)() te)
let rec staticTynames(e: StaticEnv): TyNameSet =
    setUnion(:TyName)(tyNameCompare setUnion(:TyName)(tyNameCompare tynamesSE(e.se) tynamesTE(e.te)) tynamesVE(e.ve))
and tynamesSE(se: Map(String SStr)): TyNameSet =
    mapFoldl(:String :SStr :TyNameSet)(fun(e: SStr u: TyNameSet): TyNameSet
        setUnion(:TyName)(tyNameCompare u staticTynames(e))
        setEmpty(:TyName)() se)

let closVE(ve: ValEnv): ValEnv =
    mapMap(:String :ValStr :ValStr)(fun(v: ValStr): ValStr valStr(schemeClos(v.sigma.tau) v.status) ve)
let containsFlexibleType(ve: ValEnv): Bool =
    mapExists(:String :ValStr)(fun(v: ValStr): Bool typeIsFlexible(v.sigma.tau) ve)
let defaultOverloadedVE(ve: ValEnv): Ok = mapApp(:String :ValStr)(fun(v: ValStr): Ok defaultOverloaded(v.sigma.tau) ve)

let realiseVE(phi: Realisation ve: ValEnv): ValEnv =
    mapMap(:String :ValStr :ValStr)(fun(v: ValStr): ValStr valStr(schemeRealise(phi v.sigma) v.status) ve)
let realiseTE(phi: Realisation te: TyEnv): TyEnv =
    mapMap(:String :TyStr :TyStr)(fun(t: TyStr): TyStr tyStr(schemeRealise(phi t.theta) realiseVE(phi t.ve)) te)

let admitsEqualityValStr(v: ValStr): Bool = typeAdmitsEquality(v.sigma.tau)

Let TEVE = Tuple te: TyEnv ve: ValEnv end

let maximiseEquality(te: TyEnv ve: ValEnv): TEVE =
    begin
        Let PhiChanged = Tuple phi: Realisation changed: Bool end
        let checkTyStr(t: TyStr pc: PhiChanged): PhiChanged =
            begin
                let tn = typeFcnToTyName(t.theta)!oSome.x
                if isEqEq(tn.equality) andif not(mapAll(:String :ValStr)(admitsEqualityValStr t.ve)) then
                    tuple
                        let phi = mapInsert(:TyName :TypeFcn)(tyNameCompare pc.phi tn
                            typeFcnFromTyName(tyNameRemoveEquality(tn)))
                        let changed = true
                    end
                else pc
                end
            end
        let rec checkTE(te: TyEnv phi: Realisation): P2(TyEnv Realisation) =
            begin
                let pc = mapFoldl(:String :TyStr :PhiChanged)(checkTyStr tuple let phi = phi let changed = false end te)
                let te1 = realiseTE(pc.phi te)
                if pc.changed then checkTE(te1 pc.phi) else p2(:TyEnv :Realisation)(te1 pc.phi) end
            end
        let tp = checkTE(te mapEmpty(:TyName :TypeFcn)())
        tuple let te = tp.a let ve = realiseVE(tp.b ve) end
    end

(* structure Source: a region is its left and right positions *)
Let Info = Tuple l: Int r: Int end
let info(l: Int r: Int): Info = tuple let l = l let r = r end
let over(r1: Info r2: Info): Info = info(r1.l r2.r)
let regionCompare(a: Info b: Info): Int = begin let c = intCompare(a.l b.l) if c is 0 then intCompare(a.r b.r)
    else c end end

(* functor GrammarCoreFn, GrammarModuleFn, and GrammarProgramFn: the phrases
 * the input's declarations use *)

Let OpKind = Option sansOp withOp end
let sansOp = option sansOp of OpKind end

Let Rec AtExp = Option
    aLongVId with i: Info opk: OpKind longvid: LongId end
    aRecord with i: Info exprow: Opt(ExpRow) end
    aPar with i: Info exp: Exp end
end
and ExpRow = Tuple i: Info lab: String exp: Exp next: Opt(ExpRow) end
and Exp = Option
    eAtExp with i: Info atexp: AtExp end
    eApp with i: Info exp: Exp atexp: AtExp end
    eFn with i: Info match: Match end
end
and Match = Tuple i: Info mrule: Mrule next: Opt(Match) end
and Mrule = Tuple i: Info pat: Pat exp: Exp end
and Dec = Option
    dVal with i: Info tyvarseq: TyVarseq valbind: ValBind end
    dDatatype with i: Info datbind: DatBind end
end
and ValBind = Option
    vbPlain with i: Info pat: Pat exp: Exp next: Opt(ValBind) end
    vbRec with i: Info valbind: ValBind end
end
and DatBind = Tuple i: Info tyvarseq: TyVarseq tycon: String conbind: ConBind next: Opt(DatBind) end
and ConBind = Tuple i: Info opk: OpKind vid: String ty: Opt(Ty) next: Opt(ConBind) end
and AtPat = Option
    apWildcard with i: Info end
    apLongVId with i: Info opk: OpKind longvid: LongId end
    apRecord with i: Info patrow: Opt(PatRow) end
    apPar with i: Info pat: Pat end
end
and PatRow = Option
    prWildcard with i: Info end
    prRow with i: Info lab: String pat: Pat next: Opt(PatRow) end
end
and Pat = Option
    pAtPat with i: Info atpat: AtPat end
    pCon with i: Info opk: OpKind longvid: LongId atpat: AtPat end
    pTyped with i: Info pat: Pat ty: Ty end
end
and Ty = Option
    tyTyVar with i: Info tyvar: TyVar end
    tyRecord with i: Info tyrow: Opt(TyRow) end
    tyCon with i: Info tyseq: Tyseq longtycon: LongId end
    tyArrow with i: Info a: Ty b: Ty end
end
and TyRow = Tuple i: Info lab: String ty: Ty next: Opt(TyRow) end
and Tyseq = Tuple i: Info tys: lists.T(Ty) end
and TyVarseq = Tuple i: Info tyvars: TyVars end

Let StrDec = Tuple i: Info dec: Dec end
Let Rec TopDec = Tuple i: Info strdec: StrDec next: Opt(TopDec) end
Let Rec Program = Tuple i: Info topdec: TopDec next: Opt(Program) end

let infoAtExp(a: AtExp): Info = case a when aLongVId with x then x.i when aRecord with x then x.i when aPar with x
    then x.i end
let infoAtPat(a: AtPat): Info =
    case a when apWildcard with x then x.i when apLongVId with x then x.i when apRecord with x then x.i
        when apPar with x then x.i end
let infoPat(p: Pat): Info = case p when pAtPat with x then x.i when pCon with x then x.i when pTyped with x then x.i end
let infoTy(t: Ty): Info =
    case t when tyTyVar with x then x.i when tyRecord with x then x.i when tyCon with x then x.i when tyArrow with x
        then x.i end

(* structure DerivedFormsCore: the derived forms the input uses *)

let labFromInt(n: Int): String = intToString(n)

let tupleAtPat(i: Info pats: lists.T(Pat)): AtPat =
    case pats
        when cons with c then
            case c.tl
                when nil then option apPar of AtPat with i c.hd end
                else
                    begin
                        let rec toPatRow(n: Int pats: lists.T(Pat)): Opt(PatRow) =
                            case pats
                                when cons with p then
                                    some(:PatRow)(option prRow of PatRow with i labFromInt(n) p.hd
                                        toPatRow(n + 1 p.tl) end)
                                else none(:PatRow)()
                            end
                        option apRecord of AtPat with i toPatRow(1 pats) end
                    end
            end
        else option apRecord of AtPat with i none(:PatRow)() end
    end

let tupleAtExp(i: Info exps: lists.T(Exp)): AtExp =
    case exps
        when cons with c then
            case c.tl
                when nil then option aPar of AtExp with i c.hd end
                else
                    begin
                        let rec toExpRow(n: Int exps: lists.T(Exp)): Opt(ExpRow) =
                            case exps
                                when cons with e then
                                    some(:ExpRow)(tuple let i = i let lab = labFromInt(n) let exp = e.hd
                                        let next = toExpRow(n + 1 e.tl) end)
                                else none(:ExpRow)()
                            end
                        option aRecord of AtExp with i toExpRow(1 exps) end
                    end
            end
        else option aRecord of AtExp with i none(:ExpRow)() end
    end

let tupleTy(i: Info tys: lists.T(Ty)): Ty =
    case tys
        when cons with c then
            case c.tl
                when nil then c.hd
                else
                    begin
                        let rec toTyRow(n: Int tys: lists.T(Ty)): Opt(TyRow) =
                            case tys
                                when cons with t then
                                    some(:TyRow)(tuple let i = i let lab = labFromInt(n) let ty = t.hd
                                        let next = toTyRow(n + 1 t.tl) end)
                                else none(:TyRow)()
                            end
                        option tyRecord of Ty with i toTyRow(1 tys) end
                    end
            end
        else option tyRecord of Ty with i none(:TyRow)() end
    end

(* DATATYPEDec, without withtype *)
let datatypeDec(i: Info datbind: DatBind): Dec = option dDatatype of Dec with i datbind end

(* structure Infix: infix resolution, of the input's nonfix phrases *)

Let Assoc = Option leftAssoc rightAssoc end
Let InfStatus = Tuple assoc: Assoc prec: Int end
Let InfEnv = Map(String InfStatus)


Let Categorised(A::TYPE) = Option nonfix with e: A end infix with status: InfStatus vid: String i: Info end end

let categoriseLongVId(A::TYPE)(j: InfEnv atomic: A i: Info longvid: LongId): Categorised(A) =
    if isUnqualified(longvid) then
        case mapFind(:String :InfStatus)(strCompare j longvid.id)
            when oSome with s then option infix of Categorised(A) with s.x longvid.id i end
            else option nonfix of Categorised(A) with atomic end
        end
    else option nonfix of Categorised(A) with atomic end
    end

let categoriseAtExp(j: InfEnv a: AtExp): Categorised(AtExp) =
    case a
        when aLongVId with x then
            case x.opk when sansOp then categoriseLongVId(:AtExp)(j a x.i x.longvid)
                else option nonfix of Categorised(AtExp) with a end end
        else option nonfix of Categorised(AtExp) with a end
    end

let categoriseAtPat(j: InfEnv a: AtPat): Categorised(AtPat) =
    case a
        when apLongVId with x then
            case x.opk when sansOp then categoriseLongVId(:AtPat)(j a x.i x.longvid)
                else option nonfix of Categorised(AtPat) with a end end
        else option nonfix of Categorised(AtPat) with a end
    end

(* parse, for phrases with no infix identifiers *)
let infixParse(A::TYPE)(app: All(a: A b: A) A es: lists.T(Categorised(A))): A =
    begin
        Let Cs = lists.T(Categorised(A))
        let nonfix(e: A): Categorised(A) = option nonfix of Categorised(A) with e end
        let rec loopF(s: Cs i: Cs): A =
            case s
                when cons with s1 then
                    case s1.hd
                        when nonfix with e2 then
                            case s1.tl
                                when nil then
                                    case i
                                        when nil then e2.e
                                        when cons with i1 then
                                            case i1.hd
                                                when nonfix then loopF(lists.cons(:Categorised(A))(i1.hd s) i1.tl)
                                                else failure(:A)("infix operators")
                                            end
                                    end
                                when cons with s2 then
                                    case s2.hd
                                        when nonfix with e1
                                            then loopF(lists.cons(:Categorised(A))(nonfix(app(e1.e e2.e)) s2.tl) i)
                                        else failure(:A)("infix operators")
                                    end
                            end
                        else failure(:A)("infix operators")
                    end
                else
                    case i
                        when cons with i1 then
                            case i1.hd
                                when nonfix then loopF(lists.cons(:Categorised(A))(i1.hd s) i1.tl)
                                else failure(:A)("infix operators")
                            end
                        else failure(:A)("infix operators")
                    end
            end
        loopF(lists.nil(:Categorised(A)) es)
    end

let atexpExp(a: AtExp): Exp = case a when aPar with x then x.exp else option eAtExp of Exp with infoAtExp(a) a end end

let appExp(a1: AtExp a2: AtExp): AtExp =
    begin
        let i1 = infoAtExp(a1)
        let i2 = infoAtExp(a2)
        let i = over(i1 i2)
        option aPar of AtExp with i option eApp of Exp with i atexpExp(a1) a2 end end
    end

let parseExp(j: InfEnv atexps: lists.T(AtExp)): Exp =
    atexpExp(infixParse(:AtExp)(appExp
        lists.map(:AtExp :Categorised(AtExp))(fun(a: AtExp): Categorised(AtExp) categoriseAtExp(j a)
        atexps)))

let atpatPat(a: AtPat): Pat = case a when apPar with x then x.pat else option pAtPat of Pat with infoAtPat(a) a end end

let conPat(a1: AtPat a2: AtPat): AtPat =
    case a1
        when apLongVId with x then
            begin
                let i2 = infoAtPat(a2)
                let i = over(x.i i2)
                option apPar of AtPat with i option pCon of Pat with i x.opk x.longvid a2 end end
            end
        else failure(:AtPat)("non-constructor applied to argument in pattern")
    end

let parsePat(j: InfEnv atpats: lists.T(AtPat)): Pat =
    atpatPat(infixParse(:AtPat)(conPat
        lists.map(:AtPat :Categorised(AtPat))(fun(a: AtPat): Categorised(AtPat) categoriseAtPat(j a)
        atpats)))

(* structure InitialInfixEnv *)
let j0: InfEnv =
    mapFromList(:String :InfStatus)(strCompare lists.fromArray(:P2(String InfStatus))(array of
        p2(:String :InfStatus)("::" tuple let assoc = option rightAssoc of Assoc end let prec = 5 end)
        p2(:String :InfStatus)("=" tuple let assoc = option leftAssoc of Assoc end let prec = 4 end)
        p2(:String :InfStatus)(":=" tuple let assoc = option leftAssoc of Assoc end let prec = 3 end)
    end))

(* structure Context: a context is its type names, its explicit type
 * variables, and its environment *)
Let Context = Tuple t: TyNameSet u: TyVarSet e: StaticEnv end
let context(t: TyNameSet u: TyVarSet e: StaticEnv): Context = tuple let t = t let u = u let e = e end
let contextPlusVE(c: Context ve: ValEnv): Context = context(c.t c.u staticPlusVE(c.e ve))
let contextPlusU(c: Context u: TyVarSet): Context = context(c.t setUnion(:TyVar)(tyVarCompare c.u u) c.e)
let contextOplusTE(c: Context te: TyEnv): Context =
    context(setUnion(:TyName)(tyNameCompare c.t tynamesTE(te)) c.u staticPlusTE(c.e te))
let contextTyvars(c: Context): TyVarSet = setUnion(:TyVar)(tyVarCompare c.u staticTyvars(c.e))

(* structure StaticBasis: its functor and signature environments, empty here,
 * are left out *)
Let StaticBasis = Tuple t: TyNameSet e: StaticEnv end
let staticBasis(t: TyNameSet e: StaticEnv): StaticBasis = tuple let t = t let e = e end
let staticBasisEmpty = staticBasis(setEmpty(:TyName)() staticEmpty)
let staticBasisTyvars(b: StaticBasis): TyVarSet = setUnion(:TyVar)(tyVarCompare setEmpty(:TyVar)() staticTyvars(b.e))
let staticBasisCof(b: StaticBasis): Context = context(b.t setEmpty(:TyVar)() b.e)
let staticBasisPlus(b: StaticBasis b1: StaticBasis): StaticBasis =
    staticBasis(setUnion(:TyName)(tyNameCompare b.t b1.t) staticPlus(b.e b1.e))

(* structure InitialStaticEnv *)

let pairType(tau1: TypeR tau2: TypeR): TypeR =
    begin
        let rho = mapInsert(:String :TypeR)(labCompare mapInsert(:String :TypeR)(labCompare mapEmpty(:String :TypeR)()
            labFromInt(1) tau1) labFromInt(2) tau2)
        fromRowType(rowType(rho closedRow))
    end

let tBool = tyName("bool" 0 eqEq 2)
let tInt = tyName("int" 0 eqEq 0)
let tWord = tyName("word" 0 eqEq 0)
let tReal = tyName("real" 0 noEq 0)
let tString = tyName("string" 0 eqEq 0)
let tChar = tyName("char" 0 eqEq 0)
let tList = tyName("list" 1 eqEq 2)
let tRef = tyName("ref" 1 specialEq 1)
let tExn = tyName("exn" 0 noEq 0)

let t0 = setFromList(:TyName)(tyNameCompare lists.fromArray(:TyName)(array of
    tBool tInt tWord tReal tString tChar tList tRef tExn end))

let alpha = tyVarFromString("'a")
let alphaEq = tyVarFromString("''a")
let tauAlpha = fromTyVar(alpha)
let tauAlphaEq = fromTyVar(alphaEq)
let noTypes = lists.nil(:TypeR)

let tauUnit = fromRowType(emptyRho)
let tauBool = fromConsType(noTypes tBool)
let tauInt = fromConsType(noTypes tInt)
let tauWord = fromConsType(noTypes tWord)
let tauReal = fromConsType(noTypes tReal)
let tauString = fromConsType(noTypes tString)
let tauChar = fromConsType(noTypes tChar)
let tauExn = fromConsType(noTypes tExn)
let tauAlphaList = fromConsType(single(:TypeR)(tauAlpha) tList)
let tauAlphaRef = fromConsType(single(:TypeR)(tauAlpha) tRef)

let noTyVars = lists.nil(:TyVar)
let oneAlpha = single(:TyVar)(alpha)

let sigmaEq = typeFcn(single(:TyVar)(alphaEq) fromFunType(pairType(tauAlphaEq tauAlphaEq) tauBool))
let sigmaAssign = typeFcn(oneAlpha fromFunType(pairType(tauAlphaRef tauAlpha) tauUnit))
let sigmaFalse = typeFcn(noTyVars tauBool)
let sigmaTrue = typeFcn(noTyVars tauBool)
let sigmaNil = typeFcn(oneAlpha tauAlphaList)
let sigmaCons = typeFcn(oneAlpha fromFunType(pairType(tauAlpha tauAlphaList) tauAlphaList))
let sigmaRef = typeFcn(oneAlpha fromFunType(tauAlpha tauAlphaRef))
let sigmaMatch = typeFcn(noTyVars tauExn)
let sigmaBind = typeFcn(noTyVars tauExn)

let valstrEq = valStr(sigmaEq isV)
let valstrAssign = valStr(sigmaAssign isV)
let valstrFalse = valStr(sigmaFalse isC)
let valstrTrue = valStr(sigmaTrue isC)
let valstrNil = valStr(sigmaNil isC)
let valstrCons = valStr(sigmaCons isC)
let valstrRef = valStr(sigmaRef isC)
let valstrMatch = valStr(sigmaMatch isE)
let valstrBind = valStr(sigmaBind isE)

let veFromList(l: Array(P2(String ValStr))): ValEnv =
    mapFromList(:String :ValStr)(strCompare lists.fromArray(:P2(String ValStr))(l))
let vs(vid: String v: ValStr): P2(String ValStr) = p2(:String :ValStr)(vid v)

let veBool = veFromList(array of vs("false" valstrFalse) vs("true" valstrTrue) end)
let veList = veFromList(array of vs("nil" valstrNil) vs("::" valstrCons) end)
let veRef = veFromList(array of vs("ref" valstrRef) end)

let ts(tycon: String theta: TypeFcn ve: ValEnv): P2(String TyStr) = p2(:String :TyStr)(tycon tyStr(theta ve))

let te0: TyEnv = mapFromList(:String :TyStr)(strCompare lists.fromArray(:P2(String TyStr))(array of
    ts("unit" typeFcn(noTyVars tauUnit) emptyVE)
    ts("bool" typeFcn(noTyVars tauBool) veBool)
    ts("int" typeFcn(noTyVars tauInt) emptyVE)
    ts("word" typeFcn(noTyVars tauWord) emptyVE)
    ts("real" typeFcn(noTyVars tauReal) emptyVE)
    ts("string" typeFcn(noTyVars tauString) emptyVE)
    ts("char" typeFcn(noTyVars tauChar) emptyVE)
    ts("list" typeFcn(oneAlpha tauAlphaList) veList)
    ts("ref" typeFcn(oneAlpha tauAlphaRef) veRef)
    ts("exn" typeFcn(noTyVars tauExn) emptyVE)
end))

let ve0: ValEnv = veFromList(array of
    vs("=" valstrEq) vs(":=" valstrAssign) vs("ref" valstrRef) vs("nil" valstrNil) vs("::" valstrCons)
    vs("false" valstrFalse) vs("true" valstrTrue) vs("Match" valstrMatch) vs("Bind" valstrBind)
end)

let staticE0 = staticEnv(emptySE te0 ve0)

(* the overloading classes *)
let oClass(tn: TyName): OClass = tuple let t = setSingleton(:TyName)(tn) let default = tn end
let classInt = oClass(tInt)
let classReal = oClass(tReal)
let classWord = oClass(tWord)
let classString = oClass(tString)
let classChar = oClass(tChar)
let classWordInt = oClassUnion(classWord classInt)
let classRealInt = oClassUnion(classReal classInt)
let classNum = oClassUnion(classWord classRealInt)
let classTxt = oClassUnion(classString classChar)
let classNumTxt = oClassUnion(classTxt classNum)

(* structure InitialStaticBasis *)
let staticB0 = staticBasis(t0 staticE0)

(* structure ExName *)
Let ExName = Tuple vid: String stamp: Int end
let exname(vid: String): ExName = begin let s = stamp() tuple let vid = vid let stamp = s end end
let exNameCompare(a: ExName b: ExName): Int = intCompare(a.stamp b.stamp)

(* structure Val and structure DynamicEnv: a function closure is a match, its
 * environment, and the value environment it is recursive in *)

Let Rec Val = Option
    vAssign
    vBasVal with b: String end
    vVId with vid: String end
    vVIdVal with vid: String v: Val end
    vExVal with e: ExVal end
    vRecord with r: Map(String Val) end
    vAddr with a: Int end
    vClosure with match: Match env: DynEnv ve: Map(String DynValStr) end
end
and ExVal = Option exName with en: ExName end exNameVal with en: ExName v: Val end end
and DynValStr = Tuple v: Val status: IdStatus end
and DynEnv = Tuple se: Map(String DynEnv) te: Map(String Map(String DynValStr)) ve: Map(String DynValStr) end

Let DynValEnv = Map(String DynValStr)
Let DynTyEnv = Map(String DynValEnv)

let dynValStr(v: Val status: IdStatus): DynValStr = tuple let v = v let status = status end
let dynEnv(se: Map(String DynEnv) te: DynTyEnv ve: DynValEnv): DynEnv = tuple let se = se let te = te let ve = ve end

(* Val.equal; the input compares no records *)
let rec valEqual(v1: Val v2: Val): Bool =
    case v1
        when vVId with a then case v2 when vVId with b then strEq(a.vid b.vid) else false end
        when vVIdVal with a then
            case v2 when vVIdVal with b then strEq(a.vid b.vid) andif valEqual(a.v b.v) else false end
        when vExVal with a then
            case a.e
                when exName with e1 then
                    case v2
                        when vExVal with b then case b.e when exName with e2 then e1.en.stamp is e2.en.stamp
                            else false end
                        else false
                    end
                else false
            end
        when vAddr with a then case v2 when vAddr with b then a.a is b.a else false end
        else false
    end

let emptyDVE = mapEmpty(:String :DynValStr)()
let emptyDTE = mapEmpty(:String :DynValEnv)()
let emptyDSE = mapEmpty(:String :DynEnv)()
let dynEmpty = dynEnv(emptyDSE emptyDTE emptyDVE)
let dynFromVE(ve: DynValEnv): DynEnv = dynEnv(emptyDSE emptyDTE ve)
let dynFromVEandTE(ve: DynValEnv te: DynTyEnv): DynEnv = dynEnv(emptyDSE te ve)

let dynPlus(e: DynEnv e1: DynEnv): DynEnv =
    dynEnv(mapUnionWith(:String :DynEnv)(strCompare second(:DynEnv) e.se e1.se)
        mapUnionWith(:String :DynValEnv)(strCompare second(:DynValEnv) e.te e1.te)
        mapUnionWith(:String :DynValStr)(strCompare second(:DynValStr) e.ve e1.ve))
let dynPlusVE(e: DynEnv ve: DynValEnv): DynEnv =
    dynEnv(e.se e.te mapUnionWith(:String :DynValStr)(strCompare second(:DynValStr) e.ve ve))

let dynFindVId(e: DynEnv vid: String): Opt(DynValStr) = mapFind(:String :DynValStr)(strCompare e.ve vid)
let dynFindLongVId(e: DynEnv l: LongId): Opt(DynValStr) =
    if isUnqualified(l) then dynFindVId(e l.id) else failure(:Opt(DynValStr))("long identifiers") end

(* Rec *)
let dynRec(ve: DynValEnv): DynValEnv =
    mapMap(:String :DynValStr :DynValStr)(
        fun(x: DynValStr): DynValStr
            case x.v
                when vClosure with c then
                    case x.status when isV
                        then dynValStr(option vClosure of Val with c.match c.env ve end isV) else x end
                else x
            end
        ve)

(* structure InitialDynamicEnv *)

let enMatch = exname("Match")
let enBind = exname("Bind")

let dvs(vid: String v: Val status: IdStatus): P2(String DynValStr) = p2(:String :DynValStr)(vid dynValStr(v status))
let dveFromList(l: Array(P2(String DynValStr))): DynValEnv =
    mapFromList(:String :DynValStr)(strCompare lists.fromArray(:P2(String DynValStr))(l))
let vidVal(vid: String): Val = option vVId of Val with vid end

let dynValstrEq = dvs("=" option vBasVal of Val with "=" end isV)
let dynValstrAssign = dvs(":=" option vAssign of Val end isV)
let dynValstrFalse = dvs("false" vidVal("false") isC)
let dynValstrTrue = dvs("true" vidVal("true") isC)
let dynValstrNil = dvs("nil" vidVal("nil") isC)
let dynValstrCons = dvs("::" vidVal("::") isC)
let dynValstrRef = dvs("ref" vidVal("ref") isC)
let dynValstrMatch = dvs("Match" option vExVal of Val with option exName of ExVal with enMatch end end isE)
let dynValstrBind = dvs("Bind" option vExVal of Val with option exName of ExVal with enBind end end isE)

let dynTE0: DynTyEnv = mapFromList(:String :DynValEnv)(strCompare lists.fromArray(:P2(String DynValEnv))(array of
    p2(:String :DynValEnv)("unit" emptyDVE)
    p2(:String :DynValEnv)("bool" dveFromList(array of dynValstrFalse dynValstrTrue end))
    p2(:String :DynValEnv)("int" emptyDVE)
    p2(:String :DynValEnv)("word" emptyDVE)
    p2(:String :DynValEnv)("real" emptyDVE)
    p2(:String :DynValEnv)("string" emptyDVE)
    p2(:String :DynValEnv)("char" emptyDVE)
    p2(:String :DynValEnv)("list" dveFromList(array of dynValstrNil dynValstrCons end))
    p2(:String :DynValEnv)("ref" dveFromList(array of dynValstrRef end))
    p2(:String :DynValEnv)("exn" emptyDVE)
end))

let dynVE0: DynValEnv = dveFromList(array of
    dynValstrEq dynValstrAssign dynValstrRef dynValstrNil dynValstrCons dynValstrFalse dynValstrTrue dynValstrMatch
    dynValstrBind
end)

let dynE0 = dynEnv(emptyDSE dynTE0 dynVE0)

(* the state: its memory, empty here, is left out *)
Let State = Tuple ens: Set(ExName) end
let s0: State = tuple
    let ens = setFromList(:ExName)(exNameCompare lists.fromArray(:ExName)(array of enMatch enBind end)) end

(* structure DynamicBasis: its functor and signature environments, empty here,
 * are left out *)
Let DynamicBasis = DynEnv
let dynamicB0: DynamicBasis = dynE0

(* structure Basis *)
Let Basis = Tuple stat: StaticBasis dyn: DynamicBasis end
let basis(stat: StaticBasis dyn: DynamicBasis): Basis = tuple let stat = stat let dyn = dyn end
let basisOplus(b: Basis b1: Basis): Basis = basis(staticBasisPlus(b.stat b1.stat) dynPlus(b.dyn b1.dyn))

(* structure Error *)
Let ErrorInfo = Tuple i: Info message: String end
let errorE: Exception(ErrorInfo) = exception errorE: ErrorInfo end
let raiseError(A::TYPE)(e: ErrorInfo): A = raise errorE with e end
let errorAt(A::TYPE)(i: Info message: String): A =
    begin
        writer.putString(writer.err intToString(i.l) <> "-" <> intToString(i.r) <> ": " <> message <> "\n")
        writer.flush(writer.err)
        raiseError(:A)(tuple let i = i let message = message end)
    end

(* structure Pack *)
let pack: Exception(ExVal) = exception pack: ExVal end
let raisePack(A::TYPE)(e: ExVal): A = raise pack with e end

(* structure EvalCore *)

let failE: Exception = exception fail: Ok end

Let StateRef = Tuple var s: State end

let rec evalAtExp(s: StateRef e: DynEnv atexp: AtExp): Val =
    case atexp
        when aLongVId with x then
            case dynFindLongVId(e x.longvid) when oSome with vs then vs.x.v
                else errorAt(:Val)(x.i "runtime error: unknown identifier") end
        when aRecord with x then
            begin
                let r = case x.exprow when oSome with row then evalExpRow(s e row.x) else mapEmpty(:String :Val)() end
                option vRecord of Val with r end
            end
        when aPar with x then evalExp(s e x.exp)
    end
and evalExpRow(s: StateRef e: DynEnv row: ExpRow): Map(String Val) =
    begin
        let v = evalExp(s e row.exp)
        let r = case row.next when oSome with next then evalExpRow(s e next.x) else mapEmpty(:String :Val)() end
        mapInsert(:String :Val)(labCompare r row.lab v)
    end
and evalExp(s: StateRef e: DynEnv exp: Exp): Val =
    case exp
        when eAtExp with x then evalAtExp(s e x.atexp)
        when eApp with x then
            begin
                let v1 = evalExp(s e x.exp)
                let v = evalAtExp(s e x.atexp)
                case v1
                    when vVId with c then
                        if strEq(c.vid "ref") then failure(:Val)("references")
                        else option vVIdVal of Val with c.vid v end
                        end
                    when vExVal with ex then
                        case ex.e
                            when exName with en
                                then option vExVal of Val with option exNameVal of ExVal with en.en v end end
                            else errorAt(:Val)(x.i "runtime type error: applicative value expected")
                        end
                    when vClosure with f then
                        try evalMatch(s dynPlusVE(f.env dynRec(f.ve)) v f.match)
                        when failE then raisePack(:Val)(option exName of ExVal with enMatch end)
                        end
                    else errorAt(:Val)(x.i "runtime type error: applicative value expected")
                end
            end
        when eFn with x then option vClosure of Val with x.match e emptyDVE end
    end
and evalMatch(s: StateRef e: DynEnv v: Val m: Match): Val =
    try evalMrule(s e v m.mrule)
    when failE then case m.next when oSome with next then evalMatch(s e v next.x) else throw(:Val)(failE) end
    end
and evalMrule(s: StateRef e: DynEnv v: Val mrule: Mrule): Val =
    begin
        let ve = evalPat(s e v mrule.pat)
        evalExp(s dynPlusVE(e ve) mrule.exp)
    end
and evalDec(s: StateRef e: DynEnv dec: Dec): DynEnv =
    case dec
        when dVal with x then dynFromVE(evalValBind(s e x.valbind))
        when dDatatype with x then begin let vt = evalDatBind(x.datbind) dynFromVEandTE(vt.a vt.b) end
    end
and evalValBind(s: StateRef e: DynEnv vb: ValBind): DynValEnv =
    case vb
        when vbPlain with x then
            try
                begin
                    let v = evalExp(s e x.exp)
                    let ve = evalPat(s e v x.pat)
                    let ve1 = case x.next when oSome with next then evalValBind(s e next.x) else emptyDVE end
                    mapUnionWith(:String :DynValStr)(strCompare second(:DynValStr) ve ve1)
                end
            when failE then raisePack(:DynValEnv)(option exName of ExVal with enBind end)
            end
        when vbRec with x then dynRec(evalValBind(s e x.valbind))
    end
and evalDatBind(d: DatBind): P2(DynValEnv DynTyEnv) =
    begin
        let ve = evalConBind(d.conbind)
        let vt = case d.next when oSome with next then evalDatBind(next.x)
            else p2(:DynValEnv :DynTyEnv)(emptyDVE emptyDTE) end
        p2(:DynValEnv :DynTyEnv)(mapUnionWith(:String :DynValStr)(strCompare second(:DynValStr) ve vt.a)
            mapInsert(:String :DynValEnv)(strCompare vt.b d.tycon ve))
    end
and evalConBind(c: ConBind): DynValEnv =
    begin
        let ve = case c.next when oSome with next then evalConBind(next.x) else emptyDVE end
        mapInsert(:String :DynValStr)(strCompare ve c.vid dynValStr(vidVal(c.vid) isC))
    end
and evalAtPat(s: StateRef e: DynEnv v: Val atpat: AtPat): DynValEnv =
    case atpat
        when apWildcard then emptyDVE
        when apLongVId with x then
            begin
                let vid = x.longvid.id
                if isUnqualified(x.longvid) andif
                    case dynFindVId(e vid) when oSome with vs then case vs.x.status when isV then true else false end
                        else true end
                then mapSingleton(:String :DynValStr)(vid dynValStr(v isV))
                else
                    begin
                        let v1 =
                            case dynFindLongVId(e x.longvid) when oSome with vs then vs.x.v
                                else errorAt(:Val)(x.i "runtime error: unknown constructor")
                            end
                        if valEqual(v v1) then emptyDVE else throw(:DynValEnv)(failE) end
                    end
                end
            end
        when apRecord with x then
            begin
                let r = case v when vRecord with rv then rv.r
                    else errorAt(:Map(String Val))(x.i "runtime type error: record expected") end
                case x.patrow
                    when oSome with row then evalPatRow(s e r row.x)
                    else
                        if mapIsEmpty(:String :Val)(r) then emptyDVE
                        else errorAt(:DynValEnv)(x.i "runtime type error: empty record expected")
                        end
                end
            end
        when apPar with x then evalPat(s e v x.pat)
    end
and evalPatRow(s: StateRef e: DynEnv r: Map(String Val) row: PatRow): DynValEnv =
    case row
        when prRow with x then
            begin
                let v = case mapFind(:String :Val)(labCompare r x.lab) when oSome with y then y.x
                    else errorAt(:Val)(x.i "runtime type error: unmatched label")
                end
                let ve = evalPat(s e v x.pat)
                let ve1 = case x.next when oSome with next then evalPatRow(s e r next.x) else emptyDVE end
                mapUnionWithi(:String :DynValStr)(strCompare
                    fun(k: String a: DynValStr b: DynValStr): DynValStr b ve ve1)
            end
        else emptyDVE
    end
and evalPat(s: StateRef e: DynEnv v: Val pat: Pat): DynValEnv =
    case pat
        when pAtPat with x then evalAtPat(s e v x.atpat)
        when pCon with x then
            begin
                let fail(): DynValEnv = errorAt(:DynValEnv)(x.i "runtime type error: constructor expected")
                case dynFindLongVId(e x.longvid)
                    when oSome with vs then
                        case vs.x.v
                            when vVId with c then
                                case vs.x.status
                                    when isC then
                                        case v
                                            when vVIdVal with a then
                                                if strEq(c.vid "ref")
                                                    then errorAt(:DynValEnv)(x.i "runtime type error: address expected")
                                                elsif strEq(c.vid a.vid) then evalAtPat(s e a.v x.atpat)
                                                else throw(:DynValEnv)(failE)
                                                end
                                            else fail()
                                        end
                                    else fail()
                                end
                            else fail()
                        end
                    else fail()
                end
            end
        when pTyped with x then evalPat(s e v x.pat)
    end

(* structure EvalModule *)

let evalStrDec(s: StateRef b: DynamicBasis strdec: StrDec): DynEnv = evalDec(s b strdec.dec)

let rec evalTopDec(s: StateRef b: DynamicBasis topdec: TopDec): DynamicBasis =
    begin
        let e = evalStrDec(s b topdec.strdec)
        let b1 = e
        let b2 = case topdec.next when oSome with next then evalTopDec(s dynPlus(b b1) next.x) else dynEmpty end
        dynPlus(b1 b2)
    end

(* structure PrettyPrint *)

Let Mode = Option mH mV mF mA end
Let Rec Doc = Option
    dEmpty
    dBreak with s: String end
    dText with s: String end
    dCons with a: Doc b: Doc end
    dBox with m: Mode d: Doc end
    dNest with k: Int d: Doc end
    dBelow with d: Doc end
end
Let Prim = Option pText with s: String end pLine with i: Int end end

let mH = option mH of Mode end
let mV = option mV of Mode end
let mF = option mF of Mode end
let mA = option mA of Mode end

let empty = option dEmpty of Doc end
let break = option dBreak of Doc with " " end
let text(s: String): Doc = option dText of Doc with s end
let isEmpty(d: Doc): Bool = case d when dEmpty then true else false end

(* ^^ *)
let cat(x: Doc y: Doc): Doc = if isEmpty(y) then x elsif isEmpty(x) then y else option dCons of Doc with x y end end
(* ^/^ *)
let catBreak(x: Doc y: Doc): Doc =
    if isEmpty(y) then x elsif isEmpty(x) then y
        else option dCons of Doc with x option dCons of Doc with break y end end end

let below(x: Doc): Doc = if isEmpty(x) then x else option dBelow of Doc with x end end
let box(m: Mode x: Doc): Doc = if isEmpty(x) then x else option dBox of Doc with m x end end
let hbox(x: Doc): Doc = box(mH x)
let vbox(x: Doc): Doc = box(mV x)
let fbox(x: Doc): Doc = box(mF x)
let abox(x: Doc): Doc = box(mA x)
let nestK(k: Int x: Doc): Doc = if isEmpty(x) then x else option dNest of Doc with k x end end

Let Triple = Tuple i: Int m: Mode d: Doc end
Let Triples = lists.T(Triple)
let triple(i: Int m: Mode d: Doc): Triple = tuple let i = i let m = m let d = d end
let tcons(t: Triple z: Triples): Triples = lists.cons(:Triple)(t z)

let rec fits(w: Int z: Triples): Bool =
    {w >= 0} andif
        case z
            when cons with c then
                begin
                    let t = c.hd
                    case t.d
                        when dEmpty then fits(w c.tl)
                        when dCons with x then fits(w tcons(triple(t.i t.m x.a) tcons(triple(t.i t.m x.b) c.tl)))
                        when dText with x then fits(w - stringOp.length(x.s) c.tl)
                        when dBreak with x then
                            case t.m when mH then fits(w - stringOp.length(x.s) c.tl) when mA then false else true end
                        when dBox with x then
                            case x.m when mV then fits(w tcons(triple(t.i mA x.d) c.tl))
                                else fits(w tcons(triple(t.i mH x.d) c.tl)) end
                        when dNest with x then fits(w tcons(triple(t.i t.m x.d) c.tl))
                        when dBelow with x then fits(w tcons(triple(t.i t.m x.d) c.tl))
                    end
                end
            else true
        end

let prepend(p: Prim a: lists.T(Prim)): lists.T(Prim) = lists.cons(:Prim)(p a)

let rec best(w: Int k: Int z: Triples a: lists.T(Prim)): lists.T(Prim) =
    case z
        when cons with c then
            begin
                let t = c.hd
                let zs = c.tl
                case t.d
                    when dEmpty then best(w k zs a)
                    when dCons with x then best(w k tcons(triple(t.i t.m x.a) tcons(triple(t.i t.m x.b) zs)) a)
                    when dText with x
                        then best(w k + stringOp.length(x.s) zs prepend(option pText of Prim with x.s end a))
                    when dBreak with x then
                        case t.m
                            when mH then horizontal(w k x.s zs a)
                            when mV then vertical(w t.i zs a)
                            when mF then
                                if fits({w - k} - stringOp.length(x.s) zs) then horizontal(w k x.s zs a)
                                    else vertical(w t.i zs a) end
                            else failure(:lists.T(Prim))("PrettyPrint.best")
                        end
                    when dBox with x then
                        case x.m
                            when mA then
                                if fits(w - k tcons(triple(t.i mH x.d) zs))
                                    then best(w k tcons(triple(t.i mH x.d) zs) a)
                                else best(w k tcons(triple(t.i mV x.d) zs) a)
                                end
                            else best(w k tcons(triple(t.i x.m x.d) zs) a)
                        end
                    when dNest with x then best(w k tcons(triple(t.i + x.k t.m x.d) zs) a)
                    when dBelow with x then best(w k tcons(triple(k t.m x.d) zs) a)
                end
            end
        else lists.rev(:Prim)(a)
    end
and horizontal(w: Int k: Int s: String z: Triples a: lists.T(Prim)): lists.T(Prim) =
    best(w k + stringOp.length(s) z prepend(option pText of Prim with s end a))
and vertical(w: Int i: Int z: Triples a: lists.T(Prim)): lists.T(Prim) = best(w i z
    prepend(option pLine of Prim with i end a))

let layout(doc: Doc w: Int): lists.T(Prim) = best(w 0 tcons(triple(0 mV doc) lists.nil(:Triple)) lists.nil(:Prim))

let ppOutput(doc: Doc w: Int): Ok =
    lists.app(:Prim)(
        fun(p: Prim): Ok
            case p
                when pText with x then print(x.s)
                when pLine with x then begin print("\n") for n = 1 upto x.i do print(" ") end end
            end
        layout(doc w))

(* structure PPMisc *)

let nest(x: Doc): Doc = nestK(2 x)
let paren(doc: Doc): Doc = cat(text("(") cat(fbox(below(doc)) text(")")))
let brack(doc: Doc): Doc = cat(text("[") cat(fbox(below(doc)) text("]")))

let rec ppCommaList(A::TYPE)(ppX: All(x: A) Doc l: lists.T(A)): Doc =
    case l
        when cons with c then
            case c.tl
                when nil then ppX(c.hd)
                else cat(ppX(c.hd) cat(text(",") cat(break ppCommaList(:A)(ppX c.tl))))
            end
        else empty
    end

let rec ppStarList(A::TYPE)(ppX: All(x: A) Doc l: lists.T(A)): Doc =
    case l
        when cons with c then
            case c.tl
                when nil then ppX(c.hd)
                else cat(hbox(cat(ppX(c.hd) cat(break text("*")))) cat(break ppStarList(:A)(ppX c.tl)))
            end
        else empty
    end

let ppSeqPrec(A::TYPE)(ppXPrec: All(n: Int x: A) Doc n: Int l: lists.T(A)): Doc =
    case l
        when cons with c then
            case c.tl
                when nil then ppXPrec(n c.hd)
                else paren(ppCommaList(:A)(fun(x: A): Doc ppXPrec(0 x) l))
            end
        else empty
    end

let ppSeq(A::TYPE)(ppX: All(x: A) Doc l: lists.T(A)): Doc = ppSeqPrec(:A)(fun(n: Int x: A): Doc ppX(x) 0 l)

(* structure PPVal *)

let ppFn = text("<fn>")
let ppVIdDoc(vid: String): Doc = text(vid)

let notAList: Exception = exception notAList: Ok end

(* Val.unpair *)
let unpair(v: Val): Opt(P2(Val Val)) =
    case v
        when vRecord with x then
            case mapFind(:String :Val)(labCompare x.r labFromInt(1))
                when oSome with v1 then
                    case mapFind(:String :Val)(labCompare x.r labFromInt(2))
                        when oSome with v2 then some(:P2(Val Val))(p2(:Val :Val)(v1.x v2.x))
                        else none(:P2(Val Val))()
                    end
                else none(:P2(Val Val))()
            end
        else none(:P2(Val Val))()
    end

let rec ppVal(s: State v: Val): Doc = fbox(below(nest(ppValPrec(0 s v))))
and ppValPrec(p: Int s: State v: Val): Doc =
    case v
        when vVId with x then ppVIdDoc(x.vid)
        when vVIdVal with x then
            begin
                let rec items(v: Val vs: lists.T(Val)): lists.T(Val) =
                    case v
                        when vVId with y then if not(strEq(y.vid "nil")) then throw(:lists.T(Val))(notAList)
                            else lists.rev(:Val)(vs) end
                        when vVIdVal with y then
                            if not(strEq(y.vid "::")) then throw(:lists.T(Val))(notAList)
                            else
                                case unpair(y.v)
                                    when oSome with vv then items(vv.x.b lists.cons(:Val)(vv.x.a vs))
                                    else throw(:lists.T(Val))(notAList)
                                end
                            end
                        else throw(:lists.T(Val))(notAList)
                    end
                try
                    begin
                        let vs = items(v lists.nil(:Val))
                        brack(ppCommaList(:Val)(fun(v: Val): Doc ppValPrec(0 s v) vs))
                    end
                when notAList then
                    begin
                        let doc = catBreak(ppVIdDoc(x.vid) ppValPrec(1 s x.v))
                        if p is 0 then doc else paren(doc) end
                    end
                end
            end
        when vClosure then ppFn
        when vAssign then ppFn
        when vBasVal then ppFn
        else failure(:Doc)("special constants, exceptions, records, and references")
    end

(* structure PPType *)

let rec ppType(tau: TypeR): Doc = fbox(below(nest(ppTypePrec(0 tau))))
and ppTypePrec(p: Int tau: TypeR): Doc =
    case tau.t
        when tvTyVar with x then text(x.alpha.name)
        when tvRow with x then
            begin
                let rec isTuple(labs: Strings n: Int): Bool =
                    case labs when cons with c then strEq(c.hd labFromInt(n)) andif isTuple(c.tl n + 1) else n > 2 end
                let labtaus = mapListItemsi(:String :TypeR)(x.row.rho)
                let labs = lists.map(:P2(String TypeR) :String)(fun(lt: P2(String TypeR)): String lt.a labtaus)
                let taus = lists.map(:P2(String TypeR) :TypeR)(fun(lt: P2(String TypeR)): TypeR lt.b labtaus)
                let closed = case x.row.r when closedRow then true else false end
                if closed andif lists.null(:String)(labs) then text("unit")
                elsif closed andif isTuple(labs 1) then
                    begin
                        let doc = ppStarList(:TypeR)(fun(tau: TypeR): Doc ppTypePrec(2 tau) taus)
                        if p > 1 then paren(doc) else fbox(below(nest(doc))) end
                    end
                else failure(:Doc)("record types")
                end
            end
        when tvFun with x then
            begin
                let doc = catBreak(ppTypePrec(1 x.a) catBreak(text("->") ppTypePrec(0 x.b)))
                if p > 0 then paren(doc) else doc end
            end
        when tvCons with x then fbox(nest(catBreak(ppSeqPrec(:TypeR)(ppTypePrec 2 x.taus) text(x.t.tycon))))
        when tvLink with x then ppTypePrec(p x.tau)
        when tvOverloaded then failure(:Doc)("overloaded types")
    end

let ppTypeScheme(sigma: TypeFcn): Doc = ppType(schemeNormalise(sigma).tau)

(* structure PPStaticEnv *)

let ppConTypeScheme(sigma: TypeFcn): Doc =
    case sigma.tau.t when tvFun with f then cat(text("of") cat(break ppType(f.a))) else empty end

let ppExEnv(ve: ValEnv): Doc =
    mapFoldri(:String :ValStr :Doc)(
        fun(vid: String v: ValStr doc: Doc): Doc
            case v.status
                when isE then
                    catBreak(abox(cat(hbox(catBreak(text("exception") ppVIdDoc(vid)))
                        nest(cat(break abox(ppConTypeScheme(v.sigma))))))
                        doc)
                else doc
            end
        empty ve)

let ppConEnv(ve: ValEnv): Doc =
    mapFoldli(:String :ValStr :Doc)(
        fun(vid: String v: ValStr doc: Doc): Doc
            catBreak(doc
                abox(cat(hbox(catBreak(if isEmpty(doc) then empty else text("|") end ppVIdDoc(vid)))
                    nest(catBreak(text("") abox(ppConTypeScheme(v.sigma)))))))
        empty ve)

let absTy(t: TyNameSet tycon: String theta: TypeFcn): Opt(Bool) =
    case typeFcnToTyName(theta)
        when oSome with tn then
            if strEq(tn.x.tycon tycon) andif setMember(:TyName)(tyNameCompare t tn.x) then
                some(:Bool)(case tn.x.equality when noEq then false else true end)
            else none(:Bool)()
            end
        else none(:Bool)()
    end

let ppTyVarDoc(alpha: TyVar): Doc = text(alpha.name)

let ppAbsTyEnv(t: TyNameSet te: TyEnv): Doc =
    mapFoldri(:String :TyStr :Doc)(
        fun(tycon: String ts: TyStr doc: Doc): Doc
            if mapIsEmpty(:String :ValStr)(ts.ve) then
                case absTy(t tycon ts.theta)
                    when oSome with eq then
                        catBreak(abox(hbox(catBreak(text(if eq.x then "eqtype" else "type" end)
                            catBreak(ppSeq(:TyVar)(ppTyVarDoc ts.theta.alphas) text(tycon))))) doc)
                    else doc
                end
            else doc
            end
        empty te)

let ppSynTyEnv(t: TyNameSet te: TyEnv): Doc =
    mapFoldri(:String :TyStr :Doc)(
        fun(tycon: String ts: TyStr doc: Doc): Doc
            if mapIsEmpty(:String :ValStr)(ts.ve) andif not(isSome(:Bool)(absTy(t tycon ts.theta))) then
                catBreak(
                    abox(cat(hbox(catBreak(text("type") catBreak(ppSeq(:TyVar)(ppTyVarDoc ts.theta.alphas)
                        catBreak(text(tycon) text("=")))))
                        nest(cat(break abox(ppType(ts.theta.tau))))))
                    doc)
            else doc
            end
        empty te)

let ppDataTyEnv(te: TyEnv): Doc =
    mapFoldri(:String :TyStr :Doc)(
        fun(tycon: String ts: TyStr doc: Doc): Doc
            if mapIsEmpty(:String :ValStr)(ts.ve) then doc
            else
                catBreak(
                    abox(cat(hbox(catBreak(text("datatype") catBreak(ppSeq(:TyVar)(ppTyVarDoc ts.theta.alphas)
                        catBreak(text(tycon) text("=")))))
                        nest(cat(break abox(ppConEnv(ts.ve))))))
                    doc)
            end
        empty te)

let ppTyEnv(t: TyNameSet te: TyEnv): Doc = vbox(catBreak(ppAbsTyEnv(t te) catBreak(ppSynTyEnv(t te) ppDataTyEnv(te))))

(* structure PPEnv: the static and dynamic environments together; their
 * structure environments, empty here, are left out *)

let ppValEnvPair(s: State veStat: ValEnv veDyn: DynValEnv): Doc =
    mapFoldri(:String :ValStr :Doc)(
        fun(vid: String v: ValStr doc: Doc): Doc
            case v.status
                when isV then
                    begin
                        let dv = mapFind(:String :DynValStr)(strCompare veDyn vid)!oSome.x
                        catBreak(
                            fbox(cat(hbox(catBreak(text("val") ppVIdDoc(vid)))
                                nest(cat(break catBreak(text("=") catBreak(below(abox(ppVal(s dv.v)))
                                    catBreak(text(":") below(abox(ppTypeScheme(v.sigma))))))))))
                            doc)
                    end
                else doc
            end
        empty veStat)

let ppEnvPair(s: State eStat: StaticEnv eDyn: DynEnv): Doc =
    vbox(catBreak(empty catBreak(ppTyEnv(setEmpty(:TyName)() eStat.te) catBreak(ppExEnv(eStat.ve)
        ppValEnvPair(s eStat.ve eDyn.ve)))))

(* structure PPBasis *)
let ppBasis(s: State
    b: Basis): Doc = vbox(catBreak(empty catBreak(empty catBreak(ppEnvPair(s b.stat.e b.dyn) text("")))))

let warning(i: Info message: String): Ok =
    begin
        writer.putString(writer.err intToString(i.l) <> "-" <> intToString(i.r) <> ": warning: " <> message <> "\n")
        writer.flush(writer.err)
    end

(* structure CheckPattern: the descriptions and contexts of the constructors,
 * records, and variables the input's patterns use *)

Let Rec Desc = Option
    descAny
    descCon with vid: String arg: Opt(Desc) end
    descNotCon with vids: Set(String) end
    descRecord with descs: Map(String Desc) end
end
Let Ctx = Option ctxCon with vid: String end ctxLab with lab: String end ctxRecord with descs: Map(String Desc) end end
Let Ctxs = lists.T(Ctx)
Let Know = Tuple desc: Desc ctx: Ctxs end
Let Cont = Tuple patrows: lists.T(Opt(PatRow)) match: Opt(Match) end
Let CheckResult = Tuple p: Set(Info) exhaustive: Bool end


let descAny = option descAny of Desc end
let know(desc: Desc ctx: Ctxs): Know = tuple let desc = desc let ctx = ctx end
let cont(patrows: lists.T(Opt(PatRow)) match: Opt(Match)): Cont = tuple let patrows = patrows let match = match end

let rec augment(context: Ctxs desc: Desc): Ctxs =
    case context
        when cons with c then
            case c.hd
                when ctxCon with x then augment(c.tl option descCon of Desc with x.vid some(:Desc)(desc) end)
                when ctxLab with x then
                    case c.tl
                        when cons with d then
                            case d.hd
                                when ctxRecord with r then
                                    lists.cons(:Ctx)(option ctxRecord of Ctx with
                                        mapInsert(:String :Desc)(labCompare r.descs x.lab desc) end d.tl)
                                else failure(:Ctxs)("CheckPattern.augment: invalid context")
                            end
                        else failure(:Ctxs)("CheckPattern.augment: invalid context")
                    end
                else failure(:Ctxs)("CheckPattern.augment: invalid context")
            end
        else failure(:Ctxs)("CheckPattern.augment: invalid context")
    end

let rec build(context: Ctxs desc: Desc): Desc =
    case context
        when cons with c then
            case c.hd
                when ctxCon with x then build(c.tl option descCon of Desc with x.vid some(:Desc)(desc) end)
                when ctxLab with x then
                    case c.tl
                        when cons with d then
                            case d.hd
                                when ctxRecord with r then
                                    build(d.tl option descRecord of Desc with
                                        mapInsert(:String :Desc)(labCompare r.descs x.lab desc) end)
                                else failure(:Desc)("CheckPattern.build: invalid context")
                            end
                        else failure(:Desc)("CheckPattern.build: invalid context")
                    end
                else failure(:Desc)("CheckPattern.build: invalid context")
            end
        else desc
    end

let checkSuccess: CheckResult = tuple let p = setEmpty(:Info)() let exhaustive = true end
let checkFailureResult: CheckResult = tuple let p = setEmpty(:Info)() let exhaustive = false end

let branch(a: CheckResult b: CheckResult): CheckResult =
    tuple let p = setUnion(:Info)(regionCompare a.p b.p) let exhaustive = a.exhaustive andif b.exhaustive end

let reached(i: Info r: CheckResult): CheckResult = tuple let p = setAdd(:Info)(regionCompare r.p i)
    let exhaustive = r.exhaustive end

let conSpan(tau: TypeR): Int = typeTyName(typeRange(tau)).span

let rec matchMatch(e: StaticEnv desc: Desc m: Match): CheckResult = matchMrule(e desc m.mrule m.next)
and matchMrule(e: StaticEnv desc: Desc mrule: Mrule next: Opt(Match)): CheckResult =
    reached(mrule.i matchPat(e know(desc lists.nil(:Ctx)) mrule.pat cont(lists.nil(:Opt(PatRow)) next)))
and matchAtPat(e: StaticEnv k: Know atpat: AtPat c: Cont): CheckResult =
    case atpat
        when apWildcard then succeed(e k c)
        when apLongVId with x then
            case findLongVId(e x.longvid)
                when oSome with vs then
                    case vs.x.status
                        when isV then succeed(e k c)
                        when isC then matchCon(e k x.longvid.id conSpan(vs.x.sigma.tau) none(:AtPat)() c)
                        else failure(:CheckResult)("exception constructors")
                    end
                else succeed(e k c)
            end
        when apRecord with x then matchRecord(e k x.patrow c)
        when apPar with x then matchPat(e k x.pat c)
    end
and matchPat(e: StaticEnv k: Know pat: Pat c: Cont): CheckResult =
    case pat
        when pAtPat with x then matchAtPat(e k x.atpat c)
        when pCon with x then
            case findLongVId(e x.longvid)
                when oSome with vs then
                    case vs.x.status
                        when isC then matchCon(e k x.longvid.id conSpan(vs.x.sigma.tau) some(:AtPat)(x.atpat) c)
                        else failure(:CheckResult)("CheckMatching.matchPat: invalid constructed pattern")
                    end
                else failure(:CheckResult)("CheckMatching.matchPat: invalid constructed pattern")
            end
        when pTyped with x then matchPat(e k x.pat c)
    end
and matchRecord(e: StaticEnv k: Know patrow: Opt(PatRow) c: Cont): CheckResult =
    begin
        let descs =
            case k.desc
                when descAny then mapEmpty(:String :Desc)()
                when descRecord with r then r.descs
                else failure(:Map(String Desc))("CheckPattern.matchRecord: type error")
            end
        matchPatRowOpt(e lists.cons(:Ctx)(option ctxRecord of Ctx with descs end k.ctx) patrow c)
    end
and matchPatRowOpt(e: StaticEnv context: Ctxs patrow: Opt(PatRow) c: Cont): CheckResult =
    case context
        when cons with ctx then
            case ctx.hd
                when ctxRecord with r then
                    begin
                        let rest(): CheckResult =
                            succeed(e know(option descRecord of Desc with r.descs end ctx.tl) c)
                        case patrow
                            when oSome with pr then
                                case pr.x
                                    when prRow with row then
                                        begin
                                            let desc1 = case mapFind(:String :Desc)(labCompare r.descs row.lab)
                                                when oSome with d then d.x
                                                else descAny
                                            end
                                            matchPat(e
                                                know(desc1
                                                    lists.cons(:Ctx)(option ctxLab of Ctx with row.lab end
                                                        context)) row.pat
                                                cont(lists.cons(:Opt(PatRow))(row.next c.patrows) c.match))
                                        end
                                    else rest()
                                end
                            else rest()
                        end
                    end
                else failure(:CheckResult)("CheckPattern.matchPatRowOpt: inconsistent context")
            end
        else failure(:CheckResult)("CheckPattern.matchPatRowOpt: inconsistent context")
    end
and matchCon(e: StaticEnv k: Know vid: String span: Int atpat: Opt(AtPat) c: Cont): CheckResult =
    begin
        let knowSucc = know(option descCon of Desc with vid none(:Desc)() end
            lists.cons(:Ctx)(option ctxCon of Ctx with vid end k.ctx))
        let knowFail(vids: Set(String)): Know = know(option descNotCon of Desc with
            setAdd(:String)(strCompare vids vid) end k.ctx)
        case k.desc
            when descAny then
                if span is 1 then matchArgOpt(e knowSucc some(:Desc)(descAny) atpat c)
                else
                    begin
                        let a = matchArgOpt(e knowSucc some(:Desc)(descAny) atpat c)
                        let b = fail(e knowFail(setEmpty(:String)()) c)
                        branch(a b)
                    end
                end
            when descCon with x then if strEq(vid x.vid) then matchArgOpt(e knowSucc x.arg atpat c) else fail(e k c) end
            when descNotCon with x then
                if setMember(:String)(strCompare x.vids vid) then fail(e k c)
                elsif setNumItems(:String)(x.vids) is span - 1 then matchArgOpt(e knowSucc some(:Desc)(descAny) atpat c)
                else
                    begin
                        let a = matchArgOpt(e knowSucc some(:Desc)(descAny) atpat c)
                        let b = fail(e knowFail(x.vids) c)
                        branch(a b)
                    end
                end
            else failure(:CheckResult)("CheckPattern.matchSCon: type error")
        end
    end
and matchArgOpt(e: StaticEnv k: Know desc: Opt(Desc) atpat: Opt(AtPat) c: Cont): CheckResult =
    case atpat
        when oSome with a then matchAtPat(e know(desc!oSome.x k.ctx) a.x c)
        else succeed(e know(k.desc lists.tl(:Ctx)(k.ctx)) c)
    end
and succeed(e: StaticEnv k: Know c: Cont): CheckResult =
    case c.patrows
        when cons with pr then matchPatRowOpt(e augment(k.ctx k.desc) pr.hd cont(pr.tl c.match))
        else checkSuccess
    end
and fail(e: StaticEnv k: Know c: Cont): CheckResult =
    case c.match when oSome with m then matchMatch(e build(k.ctx k.desc) m.x) else checkFailureResult end

let checkReachableMrule(reachables: Set(Info) mrule: Mrule): Ok =
    if not(setMember(:Info)(regionCompare reachables mrule.i)) then warning(mrule.i "redundant match rule") end

let rec checkReachableMatchOpt(reachables: Set(Info) m: Opt(Match)): Ok =
    case m when oSome with x
        then begin checkReachableMrule(reachables x.x.mrule) checkReachableMatchOpt(reachables x.x.next) end
        else ok
    end

let checkMatch(e: StaticEnv m: Match): Ok =
    begin
        let r = matchMatch(e descAny m)
        checkReachableMatchOpt(r.p some(:Match)(m))
        if not(r.exhaustive) then warning(m.i "match not exhaustive") end
    end

let checkPat(e: StaticEnv pat: Pat): Ok =
    begin
        let r = matchPat(e know(descAny lists.nil(:Ctx)) pat cont(lists.nil(:Opt(PatRow)) none(:Match)()))
        if not(r.exhaustive) then warning(infoPat(pat) "pattern not exhaustive") end
    end

(* structure ElabCore *)

let validBindVId(vid: String): Bool =
    not(strEq(vid "true")) andif not(strEq(vid "false")) andif not(strEq(vid "nil")) andif not(strEq(vid "::"))
        andif not(strEq(vid "ref"))
let validConBindVId(vid: String): Bool = validBindVId(vid) andif not(strEq(vid "it"))

let tyvarsOf(seq: TyVarseq): P2(TyVarSet TyVars) =
    begin
        let rec collect(tyvars: TyVars u: TyVarSet): TyVarSet =
            case tyvars
                when cons with c then
                    if setMember(:TyVar)(tyVarCompare u c.hd) then errorAt(:TyVarSet)(seq.i "duplicate type variable")
                    else collect(c.tl setAdd(:TyVar)(tyVarCompare u c.hd))
                    end
                else u
            end
        p2(:TyVarSet :TyVars)(collect(seq.tyvars setEmpty(:TyVar)()) seq.tyvars)
    end

let tvUnion(a: TyVarSet b: TyVarSet): TyVarSet = setUnion(:TyVar)(tyVarCompare a b)
let tvEmpty = setEmpty(:TyVar)()

let rec unguardedTyVarsAtExp(a: AtExp): TyVarSet =
    case a
        when aRecord with x then case x.exprow when oSome with r then unguardedTyVarsExpRow(r.x) else tvEmpty end
        when aPar with x then unguardedTyVarsExp(x.exp)
        else tvEmpty
    end
and unguardedTyVarsExpRow(r: ExpRow): TyVarSet =
    tvUnion(unguardedTyVarsExp(r.exp) case r.next when oSome with n then unguardedTyVarsExpRow(n.x) else tvEmpty end)
and unguardedTyVarsExp(e: Exp): TyVarSet =
    case e
        when eAtExp with x then unguardedTyVarsAtExp(x.atexp)
        when eApp with x then tvUnion(unguardedTyVarsExp(x.exp) unguardedTyVarsAtExp(x.atexp))
        when eFn with x then unguardedTyVarsMatch(x.match)
    end
and unguardedTyVarsMatch(m: Match): TyVarSet =
    tvUnion(unguardedTyVarsMrule(m.mrule) case m.next when oSome with n then unguardedTyVarsMatch(n.x) else tvEmpty end)
and unguardedTyVarsMrule(m: Mrule): TyVarSet = tvUnion(unguardedTyVarsPat(m.pat) unguardedTyVarsExp(m.exp))
and unguardedTyVarsValBind(vb: ValBind): TyVarSet =
    case vb
        when vbPlain with x then
            tvUnion(tvUnion(unguardedTyVarsPat(x.pat) unguardedTyVarsExp(x.exp))
                case x.next when oSome with n then unguardedTyVarsValBind(n.x) else tvEmpty end)
        when vbRec with x then unguardedTyVarsValBind(x.valbind)
    end
and unguardedTyVarsAtPat(a: AtPat): TyVarSet =
    case a
        when apRecord with x then case x.patrow when oSome with r then unguardedTyVarsPatRow(r.x) else tvEmpty end
        when apPar with x then unguardedTyVarsPat(x.pat)
        else tvEmpty
    end
and unguardedTyVarsPatRow(r: PatRow): TyVarSet =
    case r
        when prRow with x then
            tvUnion(unguardedTyVarsPat(x.pat) case x.next when oSome with n then unguardedTyVarsPatRow(n.x)
                else tvEmpty end)
        else tvEmpty
    end
and unguardedTyVarsPat(p: Pat): TyVarSet =
    case p
        when pAtPat with x then unguardedTyVarsAtPat(x.atpat)
        when pCon with x then unguardedTyVarsAtPat(x.atpat)
        when pTyped with x then tvUnion(unguardedTyVarsPat(x.pat) unguardedTyVarsTy(x.ty))
    end
and unguardedTyVarsTy(t: Ty): TyVarSet =
    case t
        when tyTyVar with x then setSingleton(:TyVar)(x.tyvar)
        when tyRecord with x then case x.tyrow when oSome with r then unguardedTyVarsTyRow(r.x) else tvEmpty end
        when tyCon with x then
            lists.foldl(:Ty :TyVarSet)(fun(ty: Ty u: TyVarSet): TyVarSet tvUnion(unguardedTyVarsTy(ty) u) tvEmpty
                x.tyseq.tys)
        when tyArrow with x then tvUnion(unguardedTyVarsTy(x.a) unguardedTyVarsTy(x.b))
    end
and unguardedTyVarsTyRow(r: TyRow): TyVarSet =
    tvUnion(unguardedTyVarsTy(r.ty) case r.next when oSome with n then unguardedTyVarsTyRow(n.x) else tvEmpty end)

let rec boundByAtPat(a: AtPat vid: String): Bool =
    case a
        when apLongVId with x then isUnqualified(x.longvid) andif strEq(vid x.longvid.id)
        when apRecord with x then case x.patrow when oSome with r then boundByPatRow(r.x vid) else false end
        when apPar with x then boundByPat(x.pat vid)
        else false
    end
and boundByPatRow(r: PatRow vid: String): Bool =
    case r
        when prRow with x then
            boundByPat(x.pat vid) orif case x.next when oSome with n then boundByPatRow(n.x vid) else false end
        else false
    end
and boundByPat(p: Pat vid: String): Bool =
    case p
        when pAtPat with x then boundByAtPat(x.atpat vid)
        when pCon with x then boundByAtPat(x.atpat vid)
        when pTyped with x then boundByPat(x.pat vid)
    end

let rec isNonExpansiveAtExp(c: Context a: AtExp): Bool =
    case a
        when aLongVId then true
        when aRecord with x then case x.exprow when oSome with r then isNonExpansiveExpRow(c r.x) else true end
        when aPar with x then isNonExpansiveExp(c x.exp)
    end
and isNonExpansiveExpRow(c: Context r: ExpRow): Bool =
    isNonExpansiveExp(c r.exp) andif case r.next when oSome with n then isNonExpansiveExpRow(c n.x) else true end
and isNonExpansiveExp(c: Context e: Exp): Bool =
    case e
        when eAtExp with x then isNonExpansiveAtExp(c x.atexp)
        when eApp with x then isConExp(c x.exp) andif isNonExpansiveAtExp(c x.atexp)
        when eFn then true
    end
and isConAtExp(c: Context a: AtExp): Bool =
    case a
        when aPar with x then isConExp(c x.exp)
        when aLongVId with x then
            not(isUnqualified(x.longvid) andif strEq(x.longvid.id "ref")) andif
                case findLongVId(c.e x.longvid)
                    when oSome with vs then case vs.x.status when isV then false else true end
                    else false
                end
        else false
    end
and isConExp(c: Context e: Exp): Bool = case e when eAtExp with x then isConAtExp(c x.atexp) else false end

let rec hasNonExpansiveRHS(c: Context vid: String vb: ValBind): Bool =
    case vb
        when vbPlain with x then
            if boundByPat(x.pat vid) then isNonExpansiveExp(c x.exp) else hasNonExpansiveRHS(c vid x.next!oSome.x) end
        when vbRec then true
    end

let closValBind(c: Context vb: ValBind ve: ValEnv): ValEnv =
    begin
        let tyvarsC = contextTyvars(c)
        let alphas(vid: String tau: TypeR): TyVars =
            if hasNonExpansiveRHS(c vid vb) then
                setListItems(:TyVar)(setDifference(:TyVar)(tyVarCompare typeTyvars(tau) tyvarsC))
            else lists.nil(:TyVar)
            end
        mapMapi(:String :ValStr :ValStr)(fun(vid: String v: ValStr): ValStr
            valStr(typeFcn(alphas(vid v.sigma.tau) v.sigma.tau) v.status)
            ve)
    end

let duplicate(i: Info what: String): All(vid: String a: ValStr b: ValStr) ValStr =
    fun(vid: String a: ValStr b: ValStr): ValStr errorAt(:ValStr)(i "duplicate " <> what <> " " <> vid)

Let VETau = Tuple ve: ValEnv tau: TypeR end
let veTau(ve: ValEnv tau: TypeR): VETau = tuple let ve = ve let tau = tau end
Let VERho = Tuple ve: ValEnv rho: RowType end

let unifyOr(tau1: TypeR tau2: TypeR i: Info message: String): Ok =
    try unify(tau1 tau2) when unifyE then errorAt(:Ok)(i message) end

let rec elabAtExp(c: Context a: AtExp): TypeR =
    case a
        when aLongVId with x then
            case findLongVId(c.e x.longvid)
                when oSome with vs then schemeInstance(vs.x.sigma)
                else errorAt(:TypeR)(x.i "unknown identifier " <> x.longvid.id)
            end
        when aRecord with x then
            fromRowType(case x.exprow when oSome with r then elabExpRow(c r.x) else emptyRho end)
        when aPar with x then elabExp(c x.exp)
    end
and elabExpRow(c: Context r: ExpRow): RowType =
    begin
        let tau = elabExp(c r.exp)
        let rho = case r.next when oSome with n then elabExpRow(c n.x) else emptyRho end
        if isSome(:TypeR)(findLab(rho r.lab)) then errorAt(:RowType)(r.i "duplicate label " <> r.lab)
        else insertRho(rho r.lab tau)
        end
    end
and elabExp(c: Context e: Exp): TypeR =
    case e
        when eAtExp with x then elabAtExp(c x.atexp)
        when eApp with x then
            begin
                let tau1 = elabExp(c x.exp)
                let tau2 = elabAtExp(c x.atexp)
                let tau = typeInvent()
                unifyOr(tau1 fromFunType(tau2 tau) x.i "type mismatch on application")
                tau
            end
        when eFn with x then
            begin
                let tau = elabMatch(c x.match)
                checkMatch(c.e x.match)
                tau
            end
    end
and elabMatch(c: Context m: Match): TypeR =
    begin
        let tau = elabMrule(c m.mrule)
        case m.next
            when oSome with n then
                begin
                    let tau2 = elabMatch(c n.x)
                    unifyOr(tau tau2 m.i "type mismatch between different matches")
                    tau
                end
            else tau
        end
    end
and elabMrule(c: Context m: Mrule): TypeR =
    begin
        let vt = elabPat(c m.pat)
        let tau1 = elabExp(contextPlusVE(c vt.ve) m.exp)
        fromFunType(vt.tau tau1)
    end
and elabDec(toplevel: Bool c: Context dec: Dec): StaticEnv =
    case dec
        when dVal with x then
            begin
                let u1 = tyvarsOf(x.tyvarseq).a
                let u = tvUnion(u1 setDifference(:TyVar)(tyVarCompare unguardedTyVarsValBind(x.valbind) c.u))
                let ve = elabValBind(toplevel contextPlusU(c u) x.valbind)
                let ve1 = closValBind(c x.valbind ve)
                defaultOverloadedVE(ve1)
                if not(setIsEmpty(:TyVar)(setIntersection(:TyVar)(tyVarCompare c.u u))) then
                    errorAt(:StaticEnv)(x.i "some type variables shadow previous ones")
                elsif containsFlexibleType(ve1) then errorAt(:StaticEnv)(x.i "unresolved flexible record type")
                elsif setIsEmpty(:TyVar)(setIntersection(:TyVar)(tyVarCompare u tyvarsVE(ve1))) then staticFromVE(ve1)
                else errorAt(:StaticEnv)(x.i "some explicit type variables cannot be generalised")
                end
            end
        when dDatatype with x then
            begin
                let te1 = lhsDatBind(x.datbind)
                let vt = elabDatBind(contextOplusTE(c te1) x.datbind)
                let tv = maximiseEquality(vt.te vt.ve)
                staticFromVEandTE(tv.ve tv.te)
            end
    end
and elabValBind(toplevel: Bool c: Context vb: ValBind): ValEnv =
    case vb
        when vbPlain with x then
            begin
                let vt = elabPat(c x.pat)
                let tau2 = elabExp(c x.exp)
                let ve1 = case x.next when oSome with n then elabValBind(toplevel c n.x) else emptyVE end
                unifyOr(vt.tau tau2 x.i "type mismatch between pattern and expression")
                if not(toplevel) then checkPat(c.e x.pat) end
                mapUnionWithi(:String :ValStr)(strCompare duplicate(x.i "variable") vt.ve ve1)
            end
        when vbRec with x then
            begin
                let ve1 = lhsRecValBind(x.valbind)
                elabValBind(toplevel contextPlusVE(c ve1) x.valbind)
            end
    end
and elabDatBind(c: Context d: DatBind): TEVE =
    begin
        let ua = tyvarsOf(d.tyvarseq)
        let theta = case findTyCon(c.e d.tycon) when oSome with ts then ts.x.theta
            else failure(:TypeFcn)("ElabCore.elabDatBind: tycon not pre-bound")
        end
        let ve = elabConBind(c theta.tau d.conbind)
        let vt = case d.next when oSome with n then elabDatBind(c n.x) else tuple let te = emptyTE
            let ve = emptyVE end end
        let closedVE =
            if setIsSubset(:TyVar)(tyVarCompare tyvarsVE(ve) ua.a) then closVE(ve)
            else errorAt(:ValEnv)(d.i "free type variables in datatype binding")
            end
        if isSome(:TyStr)(mapFind(:String :TyStr)(strCompare vt.te d.tycon)) then
            errorAt(:TEVE)(d.i "duplicate type constructor " <> d.tycon)
        else
            begin
                let ve2 = mapUnionWithi(:String :ValStr)(strCompare duplicate(d.i "data cnstructor") closedVE vt.ve)
                tuple let te = mapInsert(:String :TyStr)(strCompare vt.te d.tycon tyStr(theta closedVE))
                    let ve = ve2 end
            end
        end
    end
and elabConBind(c: Context tau: TypeR cb: ConBind): ValEnv =
    begin
        let tau1 = case cb.ty when oSome with ty then fromFunType(elabTy(c ty.x) tau) else tau end
        let ve = case cb.next when oSome with n then elabConBind(c tau n.x) else emptyVE end
        if isSome(:ValStr)(mapFind(:String :ValStr)(strCompare ve cb.vid)) then
            errorAt(:ValEnv)(cb.i "duplicate data constructor " <> cb.vid)
        elsif not(validConBindVId(cb.vid)) then errorAt(:ValEnv)(cb.i "illegal rebinding of identifier " <> cb.vid)
        else mapInsert(:String :ValStr)(strCompare ve cb.vid valStr(typeFcn(lists.nil(:TyVar) tau1) isC))
        end
    end
and elabAtPat(c: Context a: AtPat): VETau =
    case a
        when apWildcard then veTau(emptyVE typeInvent())
        when apLongVId with x then
            begin
                let vid = x.longvid.id
                if isUnqualified(x.longvid) andif
                    case findVId(c.e vid) when oSome with vs then case vs.x.status when isV then true else false end
                        else true end
                then
                    begin
                        let tau = typeInvent()
                        veTau(mapSingleton(:String :ValStr)(vid valStr(typeFcn(lists.nil(:TyVar) tau) isV)) tau)
                    end
                else
                    begin
                        let vs = case findLongVId(c.e x.longvid) when oSome with vs then vs.x
                            else errorAt(:ValStr)(x.i "unknown constructor " <> vid)
                        end
                        let tau = schemeInstance(vs.sigma)
                        case vs.status
                            when isV then errorAt(:VETau)(x.i "non-constructor long identifier in pattern")
                            else veTau(emptyVE tau)
                        end
                    end
                end
            end
        when apRecord with x then
            begin
                let vr = case x.patrow when oSome with r then elabPatRow(c r.x)
                    else tuple let ve = emptyVE let rho = emptyRho end
                end
                veTau(vr.ve fromRowType(vr.rho))
            end
        when apPar with x then elabPat(c x.pat)
    end
and elabPatRow(c: Context r: PatRow): VERho =
    case r
        when prRow with x then
            begin
                let vt = elabPat(c x.pat)
                let vr = case x.next when oSome with n then elabPatRow(c n.x) else tuple let ve = emptyVE
                    let rho = emptyRho end end
                if isSome(:TypeR)(findLab(vr.rho x.lab)) then errorAt(:VERho)(x.i "duplicate label " <> x.lab)
                else
                    tuple
                        let ve = mapUnionWithi(:String :ValStr)(strCompare duplicate(x.i "variable") vt.ve vr.ve)
                        let rho = insertRho(vr.rho x.lab vt.tau)
                    end
                end
            end
        else tuple let ve = emptyVE
            let rho = rowType(mapEmpty(:String :TypeR)() option flexRow of RowVar with false end) end
    end
and elabPat(c: Context p: Pat): VETau =
    case p
        when pAtPat with x then elabAtPat(c x.atpat)
        when pCon with x then
            begin
                let vs = case findLongVId(c.e x.longvid) when oSome with vs then vs.x
                    else errorAt(:ValStr)(x.i "unknown constructor " <> x.longvid.id)
                end
                case vs.status when isV then errorAt(:Ok)(x.i "non-constructor " <> x.longvid.id) else ok end
                let ft = case schemeInstance(vs.sigma).t when tvFun with f then p2(:TypeR :TypeR)(f.a f.b)
                    else errorAt(:P2(TypeR TypeR))(x.i "misplaced nullary constructor " <> x.longvid.id)
                end
                let vt = elabAtPat(c x.atpat)
                unifyOr(ft.a vt.tau x.i "type mismatch in constructor pattern")
                veTau(vt.ve ft.b)
            end
        when pTyped with x then
            begin
                let vt = elabPat(c x.pat)
                let tau = elabTy(c x.ty)
                unifyOr(vt.tau tau x.i "pattern does not match annotation")
                veTau(vt.ve tau)
            end
    end
and elabTy(c: Context ty: Ty): TypeR = typeNormalise(elabTy1(c ty))
and elabTy1(c: Context ty: Ty): TypeR =
    case ty
        when tyTyVar with x then fromTyVar(x.tyvar)
        when tyRecord with x then fromRowType(case x.tyrow when oSome with r then elabTyRow1(c r.x) else emptyRho end)
        when tyCon with x then
            begin
                let k = lists.length(:Ty)(x.tyseq.tys)
                let taus = lists.map(:Ty :TypeR)(fun(ty: Ty): TypeR elabTy1(c ty) x.tyseq.tys)
                let ts = case findLongTyCon(c.e x.longtycon) when oSome with ts then ts.x
                    else errorAt(:TyStr)(x.i "unknown type constructor " <> x.longtycon.id)
                end
                try typeFcnApply(taus ts.theta)
                when applyE then errorAt(:TypeR)(x.i "arity mismatch at type application " <> x.longtycon.id)
                end
            end
        when tyArrow with x then begin let tau = elabTy1(c x.a) let tau1 = elabTy1(c x.b) fromFunType(tau tau1) end
    end
and elabTyRow1(c: Context r: TyRow): RowType =
    begin
        let tau = elabTy1(c r.ty)
        let rho = case r.next when oSome with n then elabTyRow1(c n.x) else emptyRho end
        if isSome(:TypeR)(findLab(rho r.lab)) then errorAt(:RowType)(r.i "duplicate label " <> r.lab)
        else insertRho(rho r.lab tau)
        end
    end
and lhsRecValBind(vb: ValBind): ValEnv =
    case vb
        when vbPlain with x then
            begin
                let ve = lhsRecValBindPat(x.pat)
                let ve1 = case x.next when oSome with n then lhsRecValBind(n.x) else emptyVE end
                case x.exp when eFn then ok
                    else errorAt(:Ok)(x.i "illegal expression within recursive value binding") end
                mapUnionWithi(:String :ValStr)(strCompare duplicate(x.i "variable") ve ve1)
            end
        when vbRec with x then lhsRecValBind(x.valbind)
    end
and lhsRecValBindPat(p: Pat): ValEnv =
    case p
        when pAtPat with x then lhsRecValBindAtPat(x.atpat)
        when pCon with x then lhsRecValBindAtPat(x.atpat)
        when pTyped with x then lhsRecValBindPat(x.pat)
    end
and lhsRecValBindAtPat(a: AtPat): ValEnv =
    case a
        when apLongVId with x then
            if isUnqualified(x.longvid) then
                if not(validBindVId(x.longvid.id))
                    then errorAt(:ValEnv)(x.i "illegal rebinding of identifier " <> x.longvid.id)
                else mapSingleton(:String :ValStr)(x.longvid.id valStr(typeFcn(lists.nil(:TyVar) typeInvent()) isV))
                end
            else emptyVE
            end
        when apRecord with x then case x.patrow when oSome with r then lhsRecValBindPatRow(r.x) else emptyVE end
        when apPar with x then lhsRecValBindPat(x.pat)
        else emptyVE
    end
and lhsRecValBindPatRow(r: PatRow): ValEnv =
    case r
        when prRow with x then
            begin
                let ve = lhsRecValBindPat(x.pat)
                case x.next
                    when oSome with n then
                        mapUnionWithi(:String :ValStr)(strCompare duplicate(x.i "variable") ve lhsRecValBindPatRow(n.x))
                    else ve
                end
            end
        else emptyVE
    end
and lhsDatBind(d: DatBind): TyEnv =
    begin
        let ua = tyvarsOf(d.tyvarseq)
        let k = lists.length(:TyVar)(ua.b)
        let span = lhsConBind(d.conbind)
        let t = tyName(d.tycon k eqEq span)
        let tau = fromConsType(lists.map(:TyVar :TypeR)(fromTyVar ua.b) t)
        let te1 = case d.next when oSome with n then lhsDatBind(n.x) else emptyTE end
        if isSome(:TyStr)(mapFind(:String :TyStr)(strCompare te1 d.tycon)) then
            errorAt(:TyEnv)(d.i "duplicate type constructor " <> d.tycon)
        else mapInsert(:String :TyStr)(strCompare te1 d.tycon tyStr(typeFcn(ua.b tau) emptyVE))
        end
    end
and lhsConBind(cb: ConBind): Int = case cb.next when oSome with n then 1 + lhsConBind(n.x) else 1 end


(* structure ElabModule *)

let elabStrDec(toplevel: Bool b: StaticBasis strdec: StrDec): StaticEnv = elabDec(toplevel staticBasisCof(b) strdec.dec)

let rec elabTopDec(b: StaticBasis topdec: TopDec): StaticBasis =
    begin
        let e = elabStrDec(true b topdec.strdec)
        let b1 = case topdec.next
            when oSome with n
                then elabTopDec(staticBasis(setUnion(:TyName)(tyNameCompare b.t staticTynames(e))
                    staticPlus(b.e e)) n.x)
            else staticBasisEmpty
        end
        let b2 = staticBasisPlus(staticBasis(staticTynames(e) e) b1)
        if setIsEmpty(:TyVar)(staticBasisTyvars(b2)) then b2
            else errorAt(:StaticBasis)(topdec.i "free type variables on top-level") end
    end

(* structure Program *)

let width = 79

let printBasis(s: State b: Basis): Ok = begin ppOutput(ppBasis(s b) width) writer.flush(writer.output) end

let rec execProgram(s: StateRef b: Basis program: Program): Basis =
    try
        begin
            let bStat1 = elabTopDec(b.stat program.topdec)
            let bDyn1 = evalTopDec(s b.dyn program.topdec)
            printBasis(s.s basis(bStat1 bDyn1))
            let b1 = basisOplus(b basis(bStat1 bDyn1))
            case program.next when oSome with n then execProgram(s b1 n.x) else b1 end
        end
    when errorE then case program.next when oSome with n then execProgram(s b n.x) else b end
    when pack then failure(:Basis)("uncaught exceptions")
    end

(* Array.fromList *)
let fromList(A::TYPE)(l: lists.T(A)): Array(A) =
    case l
        when cons with c then
            begin
                let a = array of(lists.length(:A)(l) c.hd)
                let rec fill(l: lists.T(A) i: Int): Ok =
                    case l when cons with c then begin a[i] := c.hd fill(c.tl i + 1) end else ok end
                fill(l 0)
                a
            end
        else begin let a: Array(A) = array of end a end
    end

(* structure LrTable: terminals, nonterminals, and states are their numbers *)

Let Rec Pairlist(A::TYPE B::TYPE) = Option empty pair with a: A b: B r: Pairlist(A B) end end
Let Action = Option aShift with s: Int end aReduce with r: Int end aAccept aError end
Let TermActions = Pairlist(Int Action)
Let ActionEntry = Tuple row: TermActions default: Action end
Let Gotos = Pairlist(Int Int)
Let LrTable = Tuple states: Int rules: Int initialState: Int action: Array(ActionEntry) goto: Array(Gotos) end

let acceptAction = option aAccept of Action end
let errorAction = option aError of Action end
let shiftAction(s: Int): Action = option aShift of Action with s end
let reduceAction(r: Int): Action = option aReduce of Action with r end

let gotoE: Exception = exception gotoE: Ok end

let findTerm(term: Int row: TermActions default: Action): Action =
    begin
        let rec find(l: TermActions): Action =
            case l
                when pair with p then
                    if p.a < term then find(p.r) elsif p.a is term then p.b else default end
                else default
            end
        find(row)
    end

let findNonterm(nt: Int row: Gotos): Opt(Int) =
    begin
        let rec find(l: Gotos): Opt(Int) =
            case l
                when pair with p then
                    if p.a < nt then find(p.r) elsif p.a is nt then some(:Int)(p.b) else none(:Int)() end
                else none(:Int)()
            end
        find(row)
    end

let tableAction(table: LrTable state: Int term: Int): Action =
    begin
        let e = table.action[state]
        findTerm(term e.row e.default)
    end

let tableGoto(table: LrTable state: Int nonterm: Int): Int =
    case findNonterm(nonterm table.goto[state]) when oSome with s then s.x else throw(:Int)(gotoE) end

let mkLrTable(actions: Array(ActionEntry) gotos: Array(Gotos) initialState: Int numStates: Int numRules: Int)
        : LrTable =
    tuple
        let states = numStates let rules = numRules let initialState = initialState let action = actions
            let goto = gotos
    end

