    end

let extract(a: SValue): P2(Program InfEnv) =
    case a when vProgramJ with x then x.f() else failure(:P2(Program InfEnv))("ParseInternal") end

(* structure Tokens: the terminals the lexer makes *)
let tEOF = 0 let tDATATYPE = 7 let tFN = 11 let tOF = 21 let tREC = 26 let tVAL = 29 let tLPAR = 33 let tRPAR = 34
let tCOMMA = 39 let tCOLON = 40 let tSEMICOLON = 41 let tUNDERBAR = 43 let tBAR = 44 let tEQUALS = 45 let tDARROW = 46
let tARROW = 47 let tALPHA = 67 let tSTAR = 69

(* functor LexerFn: the user declarations *)

let nesting = tuple let var n = 0 end

let lexEof(): Token = if nesting.n is 0 then voidToken(tEOF 0 0) else errorAt(:Token)(info(0 0) "unclosed comment") end

(* toLRPos, less 2 for a bug in ML-Lex *)
let toLRPos(yypos: Int yytext: String): Info = begin let p = yypos - 2 info(p p + stringOp.length(yytext)) end

let tokenAt(t: Int yypos: Int yytext: String): Token = begin let i = toLRPos(yypos yytext) voidToken(t i.l i.r) end
let tokenOfId(t: Int yypos: Int yytext: String): Token =
    begin
        let i = toLRPos(yypos yytext)
        token(t option vStr of SValue with fun(): String yytext end i.l i.r)
    end

(* raised if illegal leaf action tried *)
let lexError: Exception = exception lexError: Ok end
let lexerError: Exception = exception lexerError: Ok end

(* structure Internal: each state's accepting actions, and its row of next
 * states, an index into lexRows; the original's rows are strings, compared by
 * contents where these indexes are compared, and ml-lex writes no row twice *)
Let LexState = Tuple fin: Ints trans: Int end
let lexState(fin: Array(Int) trans: Int): LexState = tuple let fin = lists.fromArray(:Int)(fin) let trans = trans end


