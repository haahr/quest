Let LexBuf = Tuple
    (* buffer *)
    var yyb: String
    (* buffer length *)
    var yybl: Int
    (* location of next character to use *)
    var yybufpos: Int
    (* position in file of beginning of buffer *)
    var yygone: Int
    (* eof found yet? *)
    var yydone: Bool
    (* current 'start state' for lexer *)
    var yybegin: Int
end

(* the lexer: the actions of the tokens the input has; the others are left
 * out *)
let makeLexer(yyinput: All(n: Int) String): All() Token =
    begin
        let b: LexBuf = tuple
            let var yyb = "\n" let var yybl = 1 let var yybufpos = 1 let var yygone = 1 let var yydone = false
            let var yybegin = 1
        end
        let rec lex(): Token = scan(b.yybegin lists.nil(:Ints) b.yybufpos b.yybufpos)
        and scan(s: Int acceptingLeaves: lists.T(Ints) l: Int i0: Int): Token =
            begin
                let state = lexTab[s]
                let newAcceptingLeaves = lists.cons(:Ints)(state.fin acceptingLeaves)
                if l is b.yybl then
                    if state.trans is lexTab[0].trans then action(i0 l newAcceptingLeaves)
                    else
                        begin
                            let newchars = if b.yydone then "" else yyinput(1024) end
                            if stringOp.length(newchars) is 0 then
                                begin
                                    b.yydone := true
                                    if l is i0 then lexEof() else action(i0 l newAcceptingLeaves) end
                                end
                            else
                                begin
                                    b.yyb := if i0 is l then newchars else stringOp.getSub(b.yyb i0 l - i0)
                                        <> newchars end
                                    b.yygone := b.yygone + i0
                                    b.yybl := stringOp.length(b.yyb)
                                    scan(s acceptingLeaves l - i0 0)
                                end
                            end
                        end
                    end
                else
                    begin
                        let newChar = ascii.val(stringOp.getChar(b.yyb l))
                        let newState = lexRows[state.trans][newChar]
                        if newState is 0 then action(i0 l newAcceptingLeaves)
                            else scan(newState newAcceptingLeaves l + 1 i0) end
                    end
                end
            end
        and action(i0: Int i: Int leaves: lists.T(Ints)): Token =
            case leaves
                when cons with c then
                    case c.hd
                        when cons with node then
                            begin
                                let yypos = i0 + b.yygone
                                b.yybufpos := i
                                userAction(node.hd stringOp.getSub(b.yyb i0 i - i0) yypos)
                            end
                        else action(i0 i - 1 c.tl)
                    end
                else raise lexError end
            end
        (* The application actions; the original makes yytext only for those
         * that use it *)
        and userAction(yyk: Int yytext: String yypos: Int): Token =
            if yyk is 2 then lex()
            elsif yyk is 10 then tokenAt(tSTAR yypos yytext)
            elsif yyk is 112 then tokenAt(tFN yypos yytext)
            elsif yyk is 12 then tokenAt(tCOMMA yypos yytext)
            elsif yyk is 15 then tokenAt(tARROW yypos yytext)
            elsif yyk is 178 then tokenAt(tOF yypos yytext)
            elsif yyk is 203 then tokenAt(tREC yypos yytext)
            elsif yyk is 21 then tokenAt(tCOLON yypos yytext)
            elsif yyk is 256 then tokenAt(tVAL yypos yytext)
            elsif yyk is 26 then tokenAt(tSEMICOLON yypos yytext)
            elsif yyk is 28 then tokenAt(tEQUALS yypos yytext)
            elsif yyk is 31 then tokenAt(tDARROW yypos yytext)
            elsif yyk is 37 then tokenAt(tUNDERBAR yypos yytext)
            elsif yyk is 41 then tokenAt(tBAR yypos yytext)
            elsif yyk is 433 then tokenOfId(tALPHA yypos yytext)
            elsif yyk is 6 then tokenAt(tLPAR yypos yytext)
            elsif yyk is 8 then tokenAt(tRPAR yypos yytext)
            elsif yyk is 80 then tokenAt(tDATATYPE yypos yytext)
            else raise lexerError end
            end
        lex
    end

(* structure Parse *)
let parseSource(j: InfEnv source: String): P2(InfEnv Program) =
    begin
        let yyread = tuple let var b = false end
        let yyinput(n: Int): String = if yyread.b then "" else begin yyread.b := true source end end
        let lexer = streamify(makeLexer(yyinput))
        let r = extract(lrParse(j parserTable lexer actions voidValue 0).v)
        p2(:InfEnv :Program)(r.b r.a)
    end

(* structure Sml *)

Let ExecArg = Tuple j: InfEnv b: Basis s: State end

let exec(arg: ExecArg source: String): ExecArg =
    begin
        let jp = parseSource(arg.j source)
        let s = tuple let var s = arg.s end
        let b = execProgram(s arg.b jp.b)
        tuple let j = jp.a let b = b let s = s.s end
    end

(* TextIO.inputLine *)
let inputLine(r: reader.T): Opt(String) =
    if not(reader.more(r)) then none(:String)()
    else
        begin
            let rec chars(): Chars =
                if not(reader.more(r)) then lists.nil(:Char)
                else
                    begin
                        let c = reader.getChar(r)
                        if c is '\n' then single(:Char)(c) else lists.cons(:Char)(c chars()) end
                    end
                end
            let cs = chars()
            let s = stringOp.new(lists.length(:Char)(cs) ' ')
            let rec fill(l: Chars i: Int): Ok =
                case l when cons with c then begin stringOp.setChar(s i c.hd) fill(c.tl i + 1) end else ok end
            fill(cs 0)
            some(:String)(s)
        end
    end

let processSession(ins: reader.T initialArg: ExecArg): Ok =
    begin
        let rec loopF(arg: ExecArg): Ok =
            begin
                print("SML> ")
                writer.flush(writer.output)
                case inputLine(ins)
                    when oSome with source then try loopF(exec(arg source.x)) when errorE then loopF(arg) end
                    else ok
                end
            end
        loopF(initialArg)
    end

let execSession(ins: reader.T): Ok =
    processSession(ins tuple let j = j0 let b = basis(staticB0 dynamicB0) let s = s0 end)

(* structure Main *)

let version = "0.5"

let start(ins: reader.T): Ok =
    begin
        print("HaMLet " <> version <> " - to be or not to be SML\n")
        writer.flush(writer.output)
        execSession(ins)
        print("\n")
        writer.flush(writer.output)
    end

(* Main.doit runs its loop from its count down to 0 *)
for n = bench.count() downto 0 do
    let ins = reader.file("DATA/hamlet-input.sml")
    start(ins)
    reader.close(ins)
end
