(* tak: Takeuchi's function, tak(33 22 11) each time *)

import support/bench : support/Bench

let rec tak(x: Int y: Int z: Int): Int =
    if not(y < x) then z
    else tak(tak(x - 1 y z) tak(y - 1 z x) tak(z - 1 x y))
    end

for i = 1 upto bench.count() do
    if 22 isnot tak(33 22 11) then raise bench.bug end end
end
