==benchmark*==starting=========================================================

==settings=====================================================================

resolution             = off
meson                  = on
delta                  = off

resolution_parm:
  subsumption_checking = 1
  positive_refinement  = on
  theap_parm:
    fifo_skew          = 3
    theap_cleaning     = 1000

meson_parm:
  ancestor_pruning     = on
  ancestor_cutting     = on
  state_simplify       = on
  cache_cutting        = on
  divide_conquer       = on
  unit_lemmaizing      = on

limit                  = {time = unlimited, infs = unlimited}

