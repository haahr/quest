HaMLet 0.5 - to be or not to be SML
SML> datatype t = S of t | Z
SML> val zero = Z : t
SML> val one = S Z : t
SML> val two = S (S Z) : t
SML> val add = <fn> : t * t -> t
SML> val mul = <fn> : t * t -> t
SML> val four = S (S (S (S Z))) : t
SML> val exp = <fn> : t * t -> t
SML> SML> 
