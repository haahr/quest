let rAs = lists.fromArray(:Nuc)(array of rA01 rA02 rA03 rA04 rA05 rA06 rA07 rA08 rA09 rA10 end)
let rCs = lists.fromArray(:Nuc)(array of rC01 rC02 rC03 rC04 rC05 rC06 rC07 rC08 rC09 rC10 end)
let rUs = lists.fromArray(:Nuc)(array of rU01 rU02 rU03 rU04 rU05 rU06 rU07 rU08 rU09 rU10 end)

(* -- PARTIAL INSTANTIATIONS ------------------------------------------------ *)

Let NucVar = Tuple i: Int t: Tfo n: Nuc end
Let Inst = lists.T(NucVar)

let nucVar(i: Int t: Tfo n: Nuc): NucVar = tuple let i = i let t = t let n = n end

let atomPos(atom: All(n: Nuc) Pt v: NucVar): Pt = tfoApply(v.t atom(v.n))

let match: Exception = exception match: Ok end

let rec getVar(id: Int vars: Inst): NucVar =
    case vars
        when cons with c then if id is c.hd.i then c.hd else getVar(id c.tl) end
        else raise match end
    end

(* -- SEARCH ---------------------------------------------------------------- *)

Let Domain = All(partialInst: Inst) Inst
Let Constraint = All(v: NucVar partialInst: Inst) Bool

(* Sequential backtracking algorithm; the original's queues are lists *)
let rec search(partialInst: Inst domains: lists.T(Domain) constraint: Constraint): lists.T(Inst) =
    case domains
        when cons with c then searchAux(partialInst c.tl constraint c.hd(partialInst))
        else lists.cons(:Inst)(partialInst lists.nil(:Inst))
    end
and searchAux(partialInst: Inst domains: lists.T(Domain) constraint: Constraint vars: Inst): lists.T(Inst) =
    case vars
        when cons with c then
            if constraint(c.hd partialInst) then
                begin
                    let first = search(lists.cons(:NucVar)(c.hd partialInst) domains constraint)
                    lists.append(:Inst)(first searchAux(partialInst domains constraint c.tl))
                end
            else searchAux(partialInst domains constraint c.tl)
            end
        else lists.nil(:Inst)
    end

(* -- DOMAINS --------------------------------------------------------------- *)

(* Primary structure:   strand A CUGCCACGUCUG, strand B CAGACGUGGCAG
 *
 * Secondary structure: strand A CUGCCACGUCUG
 *                               ||||||||||||
 *                               GACGGUGCAGAC strand B
 *
 * Tertiary structure:
 *
 *    5' end of strand A C1----G12 3' end of strand B
 *                     U2-------A11
 *                    G3-------C10
 *                    C4-----G9
 *                     C5---G8
 *                        A6
 *                      G6-C7
 *                     C5----G8
 *                    A4-------U9
 *                    G3--------C10
 *                     A2-------U11
 *   5' end of strand B C1----G12 3' end of strand A
 *
 * "helix", "stacked" and "connected" describe the spatial relationship
 * between two consecutive nucleotides. E.g. the nucleotides C1 and U2 from
 * the strand A.
 *
 * "wc" (stands for Watson-Crick and is a type of base-pairing), and
 * "wc-dumas" describe the spatial relationship between nucleotides from two
 * chains that are growing in opposite directions. E.g. the nucleotides C1
 * from strand A and G12 from strand B. *)

(* Dynamic Domains *)

(* Given,
 *   "ref" a nucleotide which is already positioned,
 *   "nuc" the nucleotide to be placed,
 *   and "tfo" a transformation matrix which expresses the desired
 *   relationship between "ref" and "nuc",
 * the function "dgf-base" computes the transformation matrix that places the
 * nucleotide "nuc" in the given relationship to "ref". *)
let dgfBase(tfo: Tfo refVar: NucVar nuc: Nuc): Tfo =
    begin
        let t = refVar.t
        let n = refVar.n
        let x =
            case n.specific
                when a with s then tfoAlign(tfoApply(t n.c1s) tfoApply(t s.n9) tfoApply(t n.c4))
                when g with s then tfoAlign(tfoApply(t n.c1s) tfoApply(t s.n9) tfoApply(t n.c4))
                else tfoAlign(tfoApply(t n.c1s) tfoApply(t n.n1) tfoApply(t n.c2))
            end
        tfoCombine(nuc.dgfBaseTfo tfoCombine(tfo tfoInvOrtho(x)))
    end

let single(v: NucVar): Inst = lists.cons(:NucVar)(v lists.nil(:NucVar))

(* Placement of first nucleotide. *)
let reference(nuc: Nuc i: Int): Domain = fun(partialInst: Inst): Inst single(nucVar(i tfoId nuc))

let wcDumasTfo = tfo(~0.9737 ~0.1834 0.1352 ~0.1779 0.2417 ~0.9539 0.1422 ~0.9529 ~0.2679 0.4837 6.2649 8.0285)

let wcDumas(nuc: Nuc i: Int j: Int): Domain =
    fun(partialInst: Inst): Inst single(nucVar(i dgfBase(wcDumasTfo getVar(j partialInst) nuc) nuc))

let helix5sTfo = tfo(0.9886 ~0.0961 0.1156 0.1424 0.8452 ~0.5152 ~0.0482 0.5258 0.8492 ~3.8737 0.5480 3.8024)

let helix5s(nuc: Nuc i: Int j: Int partialInst: Inst): Inst =
    single(nucVar(i dgfBase(helix5sTfo getVar(j partialInst) nuc) nuc))

let helix3sTfo = tfo(0.9886 0.1424 ~0.0482 ~0.0961 0.8452 0.5258 0.1156 ~0.5152 0.8492 3.4426 2.0474 ~3.7042)

let helix3s(nuc: Nuc i: Int j: Int): Domain =
    fun(partialInst: Inst): Inst single(nucVar(i dgfBase(helix3sTfo getVar(j partialInst) nuc) nuc))

let g37A38Tfo = tfo(0.9991 0.0164 ~0.0387 ~0.0375 0.7616 ~0.6470 0.0189 0.6478 0.7615 ~3.3018 0.9975 2.5585)

let g37A38(nuc: Nuc i: Int j: Int partialInst: Inst): NucVar = nucVar(i
    dgfBase(g37A38Tfo getVar(j partialInst) nuc) nuc)

let stacked5s(nuc: Nuc i: Int j: Int): Domain =
    fun(partialInst: Inst): Inst
        begin
            let first = g37A38(nuc i j partialInst)
            lists.cons(:NucVar)(first helix5s(nuc i j partialInst))
        end

let pO3s(nucs: lists.T(Nuc) i: Int j: Int): Domain =
    fun(partialInst: Inst): Inst
        begin
            let v = getVar(j partialInst)
            let t = v.t
            let n = v.n
            let align = tfoInvOrtho(tfoAlign(tfoApply(t n.o3s) tfoApply(t n.c3s) tfoApply(t n.c4s)))
            let placements(nuc: Nuc): Inst =
                begin
                    let v60 = nucVar(i tfoCombine(nuc.pO3s60Tfo align) nuc)
                    let v180 = nucVar(i tfoCombine(nuc.pO3s180Tfo align) nuc)
                    let v275 = nucVar(i tfoCombine(nuc.pO3s275Tfo align) nuc)
                    lists.fromArray(:NucVar)(array of v60 v180 v275 end)
                end
            let concat(l: Inst rest: Inst): Inst = lists.append(:NucVar)(l rest)
            lists.foldr(:Inst :Inst)(concat lists.nil(:NucVar) lists.map(:Nuc :Inst)(placements nucs))
        end

(* -- PROBLEM STATEMENT ----------------------------------------------------- *)

let pseudoknotDomains(): lists.T(Domain) =
    lists.fromArray(:Domain)(array of
        reference(rA 23)
        wcDumas(rU 8 23)
        helix3s(rG 22 23)
        wcDumas(rC 9 22)
        helix3s(rG 21 22)
        wcDumas(rC 10 21)
        helix3s(rC 20 21)
        wcDumas(rG 11 20)
        helix3s(rUp 19 20) (* <-. *)
        wcDumas(rA 12 19)  (*   | Distance *)
                           (*   | Constraint *)
        (* Helix 1                | 4.0 Angstroms *)
        helix3s(rC 3 19)   (*   | *)
        wcDumas(rG 13 3)   (*   | *)
        helix3s(rC 2 3)    (*   | *)
        wcDumas(rG 14 2)   (*   | *)
        helix3s(rC 1 2)    (*   | *)
        wcDumas(rGp 15 1)  (*   | *)
                           (*   | *)
        (* L2 LOOP                | *)
        pO3s(rUs 16 15)    (*   | *)
        pO3s(rCs 17 16)    (*   | *)
        pO3s(rAs 18 17)    (* <-' *)

        (* L1 LOOP *)
        helix3s(rU 7 8)    (* <-. *)
        pO3s(rCs 4 3)      (*   | Constraint *)
        stacked5s(rU 5 4)  (*   | 4.5 Angstroms *)
        stacked5s(rC 6 5)  (* <-' *)
    end)

let pseudoknotConstraint(v: NucVar partialInst: Inst): Bool =
    if v.i is 18 then ptDist(atomPos(nucP getVar(19 partialInst)) atomPos(nucO3s v)) <<= 4.0
    elsif v.i is 6 then ptDist(atomPos(nucP getVar(7 partialInst)) atomPos(nucO3s v)) <<= 4.5
    else true
    end

let pseudoknot(): lists.T(Inst) = search(lists.nil(:NucVar) pseudoknotDomains() pseudoknotConstraint)

let maximum(xs: lists.T(Real)): Real =
    begin
        let rec maxLoop(m: Real l: lists.T(Real)): Real =
            case l when cons with c then maxLoop(if c.hd >> m then c.hd else m end c.tl) else m end
        case xs when cons with c then maxLoop(c.hd c.tl) else raise bench.bug end end
    end

(* The common atoms, then the specific ones, in the order of their fields *)
let listOfAtoms(n: Nuc): lists.T(Pt) =
    begin
        let common = array of
            n.p n.o1p n.o2p n.o5s n.c5s n.h5s n.h5ss n.c4s n.h4s n.o4s n.c1s n.h1s n.c2s
            n.h2ss n.o2s n.h2s n.c3s n.h3s n.o3s n.n1 n.n3 n.c2 n.c4 n.c5 n.c6
        end
        let specific =
            case n.specific
                when a with s then array of s.n6 s.n7 s.n9 s.c8 s.h2 s.h61 s.h62 s.h8 end
                when c with s then array of s.n4 s.o2 s.h41 s.h42 s.h5 s.h6 end
                when g with s then array of s.n2 s.n7 s.n9 s.c8 s.o6 s.h1 s.h21 s.h22 s.h8 end
                when u with s then array of s.o2 s.o4 s.h3 s.h5 s.h6 end
            end
        lists.append(:Pt)(lists.fromArray(:Pt)(common) lists.fromArray(:Pt)(specific))
    end

let varMostDistantAtom(v: NucVar): Real =
    begin
        let distance(pos: Pt): Real =
            begin
                let p = tfoApply(v.t pos)
                real.sqrt({{p.x ** p.x} ++ {p.y ** p.y}} ++ {p.z ** p.z})
            end
        maximum(lists.map(:Pt :Real)(distance listOfAtoms(v.n)))
    end

let solMostDistantAtom(s: Inst): Real = maximum(lists.map(:NucVar :Real)(varMostDistantAtom s))

let mostDistantAtom(sols: lists.T(Inst)): Real = maximum(lists.map(:Inst :Real)(solMostDistantAtom sols))

let doit(): Ok =
    begin
        let result = mostDistantAtom(pseudoknot())
        let x = result // 33.797594890762724
        if not({x >> 0.999999} andif {x << 1.000001}) then raise bench.bug end end
    end

for i = 1 upto bench.count() do doit() end
