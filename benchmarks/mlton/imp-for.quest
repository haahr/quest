(* imp-for: seven nested imperative for loops, written as a higher-order
 * function, counting to ten million *)

import support/bench : support/Bench

(* SML's for (start, stop, f) *)
let forLoop(start: Int stop: Int f: All(i: Int) Ok): Ok =
    begin
        let i = tuple let var v = start end
        let rec repeat(): Ok = if i.v >= stop then ok else begin f(i.v) i.v := i.v + 1 repeat() end end
        repeat()
    end

let doit(): Ok =
    begin
        let x = tuple let var v = 0 end
        forLoop(0 10 fun(a: Int): Ok
        forLoop(0 10 fun(b: Int): Ok
        forLoop(0 10 fun(c: Int): Ok
        forLoop(0 10 fun(d: Int): Ok
        forLoop(0 10 fun(e: Int): Ok
        forLoop(0 10 fun(f: Int): Ok
        forLoop(0 10 fun(g: Int): Ok
            x.v := x.v + 1)))))))
        if x.v isnot 10000000 then raise bench.bug end end
    end

forLoop(0 bench.count() fun(i: Int): Ok doit())
