(* vector-rev: reverses a 200000-element vector twice, 1000 times (and once
 * more) each time *)

import support/bench : support/Bench

(* SML's Vector.tabulate *)
let tabulate(n: Int f: All(i: Int) Int): Array(Int) =
    begin
        let a = array of(n 0)
        for i = 0 upto n - 1 do a[i] := f(i) end
        a
    end

let rev(v: Array(Int)): Array(Int) =
    begin
        let n = extent v
        tabulate(n fun(i: Int): Int v[{n - 1} - i])
    end

let doit(n: Int): Ok =
    begin
        let v = tabulate(200000 fun(i: Int): Int i)
        let rec repeat(n: Int): Ok =
            if n < 0 then ok
            elsif 0 is rev(rev(v))[0] then repeat(n - 1)
            else raise bench.bug end
            end
        repeat(n * 1000)
    end

doit(bench.count())
