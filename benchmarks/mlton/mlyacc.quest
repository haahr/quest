(* mlyacc: ML-Yacc, the LALR(1) parser generator, generating the parser of
 * DATA/ml.grm (the grammar of SML/NJ's parser) as DATA/ml.grm.sig and
 * DATA/ml.grm.sml (ML-Yacc Copyright 1989, 1990 by Andrew W. Appel and David
 * R. Tarditi). Left out, since the benchmark never runs them: the parser's
 * error correction (mkFixError), which only a grammar with a syntax error
 * reaches; the verbose description of the tables (ml.grm.desc), which ml.grm
 * does not ask for; debugging output; and the summary of conflicts, which the
 * benchmark's original prints nowhere. The grammar is read as DATA/ml.grm,
 * where the original names it by its full path, which only its error messages
 * show. The tables of ML-Yacc's own parser and lexer were transliterated by
 * tools/mlyacc_tables.py and tools/mllex_tables.py. *)

import
    support/bench : support/Bench
    support/lists : support/Lists
    stringOp = string : StringOp
    ascii : Ascii
    conv : Conv
    reader : Reader
    writer : Writer

(* raise e, as any type *)
let throw(A::TYPE)(e: Exception): A = raise e end

let strEq(a: String b: String): Bool = stringOp.equal(a b)
(* SML's > on strings *)
let strGt(a: String b: String): Bool = not(stringOp.precedes(a b))
let intToString(i: Int): String = if i < 0 then "~" <> conv.int(0 - i) else conv.int(i) end

Let Strings = lists.T(String)
Let Ints = lists.T(Int)

(* SML's option *)
Let Opt(A::TYPE) = Option oNone oSome with x: A end end
let none(A::TYPE)(): Opt(A) = option oNone of Opt(A) end
let some(A::TYPE)(x: A): Opt(A) = option oSome of Opt(A) with x end

(* String.concat *)
let concat(l: Strings): String =
    begin
        let n = lists.foldl(:String :Int)(fun(s: String n: Int): Int n + stringOp.length(s) 0 l)
        let s = stringOp.new(n ' ')
        let rec fill(l: Strings i: Int): Ok =
            case l
                when cons with c then
                    begin stringOp.setSub(s i c.hd 0 stringOp.length(c.hd)) fill(c.tl i + stringOp.length(c.hd)) end
                else ok
            end
        fill(l 0)
        s
    end

(* List.concat *)
let flatten(A::TYPE)(l: lists.T(lists.T(A))): lists.T(A) =
    lists.foldr(:lists.T(A) :lists.T(A))(fun(a: lists.T(A) r: lists.T(A)): lists.T(A) lists.append(:A)(a r)
        lists.nil(:A) l)

(* Array.fromList *)
let fromList(A::TYPE)(l: lists.T(A)): Array(A) =
    case l
        when cons with c then
            begin
                let a = array of(lists.length(:A)(l) c.hd)
                let rec fill(l: lists.T(A) i: Int): Ok =
                    case l when cons with c then begin a[i] := c.hd fill(c.tl i + 1) end else ok end
                fill(l 0)
                a
            end
        else begin let a: Array(A) = array of end a end
    end

Let Chars = lists.T(Char)

let implode(l: Chars): String =
    begin
        let s = stringOp.new(lists.length(:Char)(l) ' ')
        let rec fill(l: Chars i: Int): Ok =
            case l when cons with c then begin stringOp.setChar(s i c.hd) fill(c.tl i + 1) end else ok end
        fill(l 0)
        s
    end

let explode(s: String): Chars =
    begin
        let var l = lists.nil(:Char)
        for i = stringOp.length(s) - 1 downto 0 do l := lists.cons(:Char)(stringOp.getChar(s i) l) end
        l
    end

let isAlpha(c: Char): Bool =
    begin
        let n = ascii.val(c)
        {{n >= ascii.val('a')} andif {n <= ascii.val('z')}} orif {{n >= ascii.val('A')} andif {n <= ascii.val('Z')}}
    end
let isDigit(c: Char): Bool = {ascii.val(c) >= ascii.val('0')} andif {ascii.val(c) <= ascii.val('9')}

(* functor HeaderFun *)

let var lineno = 0
let var text = lists.nil(:String)

Let InputSource = Tuple name: String errStream: writer.T var errorOccurred: Bool end

let newSource(s: String errs: writer.T): InputSource =
    tuple let name = s let errStream = errs let var errorOccurred = false end

let errorOccurred(s: InputSource): Bool = s.errorOccurred

let error(source: InputSource l: Int msg: String): Ok =
    begin
        let pr(s: String): Ok = writer.putString(source.errStream s)
        pr(source.name) pr(", line ") pr(intToString(l)) pr(": Error: ") pr(msg) pr("\n")
        source.errorOccurred := true
    end

let warn(source: InputSource l: Int msg: String): Ok =
    begin
        let pr(s: String): Ok = writer.putString(source.errStream s)
        pr(source.name) pr(", line ") pr(intToString(l)) pr(": Warning: ") pr(msg) pr("\n")
    end

Let Prec = Option pLeft pRight pNonassoc end

Let Symbol = Tuple name: String pos: Int end
let symbolMake(sp: Symbol): Symbol = tuple let name = sp.name let pos = sp.pos end
Let Symbols = lists.T(Symbol)

Let Control = Option
    cNodefault
    cVerbose
    cParserName with s: Symbol end
    cFunctor with s: String end
    cStartSym with s: Symbol end
    cNshift with l: Symbols end
    cPos with s: String end
    cPure
    cParseArg with a: String b: String end
end
Let Controls = lists.T(Control)

Let Constr = Tuple sym: Symbol ty: Opt(String) end
Let Constrs = lists.T(Constr)
Let PrecDecl = Tuple prec: Prec syms: Symbols end
Let Change = Tuple a: Symbols b: Symbols end
Let Changes = lists.T(Change)
Let ValueDecl = Tuple sym: Symbol s: String end

Let DeclData = Tuple
    eop: Symbols
    keyword: Symbols
    nonterm: Opt(Constrs)
    prec: lists.T(PrecDecl)
    change: Changes
    term: Opt(Constrs)
    control: Controls
    value: lists.T(ValueDecl)
end

let decl(eop: Symbols keyword: Symbols nonterm: Opt(Constrs) prec: lists.T(PrecDecl) change: Changes
        term: Opt(Constrs) control: Controls value: lists.T(ValueDecl)): DeclData =
    tuple
        let eop = eop let keyword = keyword let nonterm = nonterm let prec = prec let change = change let term = term
        let control = control let value = value
    end

Let RhsData = Tuple rhs: Symbols code: String prec: Opt(Symbol) end
Let HRule = Tuple lhs: Symbol rhs: Symbols code: String prec: Opt(Symbol) end
Let HRules = lists.T(HRule)
Let ParseResult = Tuple header: String decl: DeclData rules: HRules end

let joinDecls(d: DeclData d1: DeclData inputSource: InputSource pos: Int): DeclData =
    begin
        let ignore(s: String): Ok = warn(inputSource pos "ignoring duplicate " <> s <> " declaration")
        let join(e: String a: Opt(Constrs) b: Opt(Constrs)): Opt(Constrs) =
            case a when oNone then b else case b when oNone then a else begin ignore(e) a end end end
        (* the kinds of control that mergeControl compares *)
        let kind(c: Control): Int =
            case c
                when cParserName then 1 when cFunctor then 2 when cParseArg then 3 when cStartSym then 4
                    when cPos then 5
                when cNshift then 6 else 0
            end
        let rec mergeControl(l: Controls a: Control): Controls =
            case l
                when cons with c then
                    begin
                        let h = c.hd
                        let k = kind(h)
                        if {k is 0} orif {k isnot kind(a)} then lists.cons(:Control)(h mergeControl(c.tl a))
                        elsif k is 1 then begin ignore("%name") l end
                        elsif k is 2 then begin ignore("%header") l end
                        elsif k is 3 then begin ignore("%arg") l end
                        elsif k is 4 then begin ignore("%start") l end
                        elsif k is 5 then begin ignore("%pos") l end
                        else
                            lists.cons(:Control)(
                                option cNshift of Control with lists.append(:Symbol)(h!cNshift.l a!cNshift.l) end c.tl)
                        end
                    end
                else lists.cons(:Control)(a lists.nil(:Control))
            end
        let rec loopF(l: Controls r: Controls): Controls =
            case l when cons with c then loopF(c.tl mergeControl(r c.hd)) else r end
        let eop = lists.append(:Symbol)(d.eop d1.eop)
        let control = loopF(d1.control d.control)
        let keyword = lists.append(:Symbol)(d1.keyword d.keyword)
        let nonterm = join("%nonterm" d.nonterm d1.nonterm)
        let prec = lists.append(:PrecDecl)(d.prec d1.prec)
        let change = lists.append(:Change)(d.change d1.change)
        let term = join("%term" d.term d1.term)
        let value = lists.append(:ValueDecl)(d.value d1.value)
        decl(eop keyword nonterm prec change term control value)
    end

(* structure LrTable: terminals, nonterminals, and states are their numbers *)

Let Rec Pairlist(A::TYPE B::TYPE) = Option empty pair with a: A b: B r: Pairlist(A B) end end
Let Action = Option aShift with s: Int end aReduce with r: Int end aAccept aError end
Let TermActions = Pairlist(Int Action)
Let ActionEntry = Tuple row: TermActions default: Action end
Let Gotos = Pairlist(Int Int)
Let LrTable = Tuple states: Int rules: Int initialState: Int action: Array(ActionEntry) goto: Array(Gotos) end

let acceptAction = option aAccept of Action end
let errorAction = option aError of Action end
let shiftAction(s: Int): Action = option aShift of Action with s end
let reduceAction(r: Int): Action = option aReduce of Action with r end

let gotoE: Exception = exception gotoE: Ok end

let findTerm(term: Int row: TermActions default: Action): Action =
    begin
        let rec find(l: TermActions): Action =
            case l
                when pair with p then
                    if p.a < term then find(p.r) elsif p.a is term then p.b else default end
                else default
            end
        find(row)
    end

let findNonterm(nt: Int row: Gotos): Opt(Int) =
    begin
        let rec find(l: Gotos): Opt(Int) =
            case l
                when pair with p then
                    if p.a < nt then find(p.r) elsif p.a is nt then some(:Int)(p.b) else none(:Int)() end
                else none(:Int)()
            end
        find(row)
    end

let tableAction(table: LrTable state: Int term: Int): Action =
    begin
        let e = table.action[state]
        findTerm(term e.row e.default)
    end

let tableGoto(table: LrTable state: Int nonterm: Int): Int =
    case findNonterm(nonterm table.goto[state]) when oSome with s then s.x else throw(:Int)(gotoE) end

let mkLrTable(actions: Array(ActionEntry) gotos: Array(Gotos) initialState: Int numStates: Int numRules: Int)
        : LrTable =
    tuple
        let states = numStates let rules = numRules let initialState = initialState let action = actions
            let goto = gotos
    end

(* The tables of ML-Yacc's own parser, the original's strings decoded into
 * their 16-bit integers *)

let actionRowsData: Array(Int) = array of 1 1 74 0 1 5 24 8 23 14 22 16 21 19 20 20 19 21 18 22 17 24 16 25 15 26 14 27
    13 28 12 30 11 34 10 35 9 36 8 38 7 39 6 0 1 6 61 0 1 6 72 0 1 6 84 0 1 6 96 0 1 7 83 32 82 0 1 9 0 0 1 10 59 0 1 11
    3 0 1 12 25 0 1 12 27 0 1 12 28 0 1 12 31 0 1 12 42 13 41 0 1 12 42 13 41 17 40 31 39 37 38 0 1 12 46 0 1 12 51 0 1
    12 69 15 68 0 1 12 69 15 68 32 67 0 1 12 75 0 1 12 78 0 1 12 99 0 1 31 35 0 1 31 48 0 1 31 55 0 1 31 98 0 1 31 102 0
    104 12 51 0 105 0 106 0 107 4 56 0 108 4 56 0 109 0 110 0 111 0 112 0 113 0 114 0 115 0 116 0 117 0 118 0 119 1 64 2
    63 12 42 13 41 0 120 0 121 0 122 0 123 1 64 2 63 12 42 13 41 0 124 0 125 0 126 4 73 0 127 0 128 0 129 4 58 0 130 0
    131 1 64 2 63 12 42 13 41 0 132 23 89 0 133 1 64 2 63 12 42 13 41 0 134 23 57 0 135 4 92 0 136 0 137 0 138 0 139 12
    33 0 140 0 141 0 142 0 143 0 144 0 145 0 146 0 147 0 148 12 42 13 41 0 149 1 64 2 63 12 42 13 41 0 150 1 64 2 63 12
    42 13 41 0 151 1 64 2 63 12 42 13 41 0 152 0 153 0 154 0 155 0 156 0 157 29 94 0 end
let actionRowNumbersData: Array(Int) = array of 9 30 1 29 10 44 11 12 13 63 63 23 15 46 63 63 11 45 16 63 24 17 63 25 31
    58 34 53 39 8 37 63 33 2 47 71 66 69 19 14 76 35 40 32 42 36 41 28 61 3 50 38 0 48 20 15 13 21 62 15 70 15 15 6 4 68
    79 78 77 60 63 63 63 56 57 52 54 43 72 73 67 18 15 59 81 49 51 15 5 75 63 26 22 55 15 81 64 80 74 27 65 7 end
let gotoTData: Array(Int) = array of 1 101 0 6 2 0 5 3 0 0 0 0 2 24 0 0 13 28 14 27 0 3 30 0 3 32 0 0 7 35 17 34 0 0 3
    41 0 3 42 0 2 43 0 0 0 3 45 0 0 10 48 11 47 0 3 52 15 51 16 50 0 0 0 0 0 0 0 0 0 3 58 0 0 0 7 60 0 0 0 0 4 64 8 63 0
    7 68 0 0 0 0 0 0 0 0 10 69 0 0 0 0 0 0 0 0 7 35 17 74 0 13 75 14 27 0 0 0 7 35 17 77 0 0 7 35 17 78 0 7 35 17 79 0 0
    0 0 0 0 0 0 3 84 9 83 0 3 52 15 85 16 50 0 3 86 0 0 7 60 0 0 0 7 60 0 7 60 0 7 60 0 0 4 88 0 7 35 17 89 0 0 12 91 0
    0 0 7 35 17 93 0 0 7 60 0 3 95 0 0 0 7 60 0 7 35 17 98 0 12 99 0 0 0 7 60 0 0 0 0 end
let numstates = 102
let numrules = 54

let var tabS: Array(Int) = actionRowsData
let var tabIndex = 0

let stringToInt(): Int =
    begin
        let i = tabIndex
        tabIndex := i + 1
        tabS[i]
    end

let stringToList(s: Array(Int)): Ints =
    begin
        let len = extent s
        let rec f(): Ints = if tabIndex < len then begin let i = stringToInt() lists.cons(:Int)(i f()) end
            else lists.nil(:Int)
            end
        tabIndex := 0
        tabS := s
        f()
    end

let stringToPairlist(A::TYPE B::TYPE)(convKey: All(n: Int) A convEntry: All(n: Int) B): All() Pairlist(A B) =
    begin
        let rec f(): Pairlist(A B) =
            begin
                let n = stringToInt()
                if n is 0 then option empty of Pairlist(A B) end
                else
                    begin
                        let a = convKey(n - 1)
                        let b = convEntry(stringToInt())
                        option pair of Pairlist(A B) with a b f() end
                    end
                end
            end
        f
    end

let stringToPairlistDefault(convKey: All(n: Int) Int convEntry: All(n: Int) Action): All() ActionEntry =
    begin
        let convRow = stringToPairlist(:Int :Action)(convKey convEntry)
        fun(): ActionEntry
            begin
                let default = convEntry(stringToInt())
                let row = convRow()
                tuple let row = row let default = default end
            end
    end

let stringToTable(A::TYPE)(convertRow: All() A s: Array(Int)): lists.T(A) =
    begin
        let len = extent s
        let rec f(): lists.T(A) =
            if tabIndex < len then begin let r = convertRow() lists.cons(:A)(r f()) end else lists.nil(:A) end
        tabS := s
        tabIndex := 0
        f()
    end

let entryToAction: All(j: Int) Action =
    begin
        let memo = array of(numstates + numrules errorAction)
        for i = 0 upto numstates - 1 do memo[i] := shiftAction(i) end
        for i = numstates upto numstates + numrules - 1 do memo[i] := reduceAction(i - numstates) end
        fun(j: Int): Action if j is 0 then acceptAction elsif j is 1 then errorAction else memo[j - 2] end
    end

let ident(n: Int): Int = n

let parserTable: LrTable =
    begin
        let gotoT = fromList(:Gotos)(stringToTable(:Gotos)(stringToPairlist(:Int :Int)(ident ident) gotoTData))
        let actionRows = stringToTable(:ActionEntry)(stringToPairlistDefault(ident entryToAction) actionRowsData)
        let actionRowNumbers = stringToList(actionRowNumbersData)
        let actionT =
            begin
                let a = fromList(:ActionEntry)(actionRows)
                let actionRowLookUp(i: Int): ActionEntry = a[i]
                fromList(:ActionEntry)(lists.map(:Int :ActionEntry)(actionRowLookUp actionRowNumbers))
            end
        mkLrTable(actionT gotoT 0 numstates numrules)
    end

(* structure MlyValue: the semantic values, each delayed *)

Let IdList = Symbols
Let SValue = Option
    vVoid
    vNtVoid with f: All() Ok end
    vUnknown with f: All() String end
    vTyvar with f: All() String end
    vProg with f: All() String end
    vPrec with f: All() Prec end
    vInt with f: All() String end
    vIddot with f: All() String end
    vId with f: All() Symbol end
    vHeader with f: All() String end
    vTy with f: All() String end
    vChangeDec with f: All() Change end
    vChangeDecl with f: All() Changes end
    vSubstDec with f: All() Change end
    vSubstDecl with f: All() Changes end
    vGRulePrec with f: All() Opt(Symbol) end
    vGRuleList with f: All() HRules end
    vGRule with f: All() HRules end
    vRhsList with f: All() lists.T(RhsData) end
    vRecordList with f: All() String end
    vQualId with f: All() String end
    vMpcDecls with f: All() DeclData end
    vMpcDecl with f: All() DeclData end
    vLabel with f: All() String end
    vIdList with f: All() Symbols end
    vConstrList with f: All() Constrs end
    vBegin with f: All() ParseResult end
end

let voidValue = option vVoid of SValue end

(* A token, and the values on the parser's stack: a semantic value and its
 * left and right positions *)
Let Token = Tuple term: Int v: SValue left: Int right: Int end
Let StackVal = Tuple v: SValue left: Int right: Int end

let token(t: Int v: SValue p1: Int p2: Int): Token = tuple let term = t let v = v let left = p1 let right = p2 end
let voidToken(t: Int p1: Int p2: Int): Token = token(t voidValue p1 p2)

(* structure Stream: a lazy stream of tokens *)
Let Rec Str = Option sEval with p: LexPair end sUneval with f: All() Token end end
and Stream = Tuple var s: Str end
and LexPair = Tuple tok: Token lexer: Stream end

let lexPair(t: Token s: Stream): LexPair = tuple let tok = t let lexer = s end

let streamGet(s: Stream): LexPair =
    case s.s
        when sEval with e then e.p
        when sUneval with u then
            begin
                let t = lexPair(u.f() tuple let var s = option sUneval of Str with u.f end end)
                s.s := option sEval of Str with t end
                t
            end
    end

let streamify(f: All() Token): Stream = tuple let var s = option sUneval of Str with f end end
let streamCons(a: Token s: Stream): Stream = tuple let var s = option sEval of Str with lexPair(a s) end end

(* structure LrParser *)

Let Elem = Tuple state: Int sv: StackVal end
Let Stack = lists.T(Elem)
Let QueueElem = Tuple stack: Stack lp: LexPair end
Let Queue = Tuple x: lists.T(QueueElem) y: lists.T(QueueElem) end
Let ReduceResult = Tuple nt: Int sv: StackVal stack: Stack end
Let Accepted = Tuple v: SValue lexer: Stream end
(* What distanceParse returns: the action, if any, is ACCEPT or ERROR *)
Let DistanceResult = Tuple lp: LexPair stack: Stack queue: Queue distance: Int act: Opt(Action) end
Let SAction = All(i: Int leftPos: Int stack: Stack arg: InputSource) ReduceResult

let parseError: Exception = exception parseError: Ok end
let parseImpossible: Exception(Int) = exception parseImpossible: Int end
let fifoEmpty: Exception = exception fifoEmpty: Ok end

let elem(state: Int sv: StackVal): Elem = tuple let state = state let sv = sv end
let queue(x: lists.T(QueueElem) y: lists.T(QueueElem)): Queue = tuple let x = x let y = y end
let queueElem(stack: Stack lp: LexPair): QueueElem = tuple let stack = stack let lp = lp end
let emptyQueue = queue(lists.nil(:QueueElem) lists.nil(:QueueElem))

Let QueueGot = Tuple a: QueueElem q: Queue end
let rec fifoGet(q: Queue): QueueGot =
    case q.x
        when cons with c then tuple let a = c.hd let q = queue(c.tl q.y) end
        else
            case q.y
                when nil then throw(:QueueGot)(fifoEmpty)
                else fifoGet(queue(lists.rev(:QueueElem)(q.y) lists.nil(:QueueElem)))
            end
    end
let fifoPut(a: QueueElem q: Queue): Queue = queue(q.x lists.cons(:QueueElem)(a q.y))

let impossible(A::TYPE)(n: Int): A = raise parseImpossible with n end

(* ssParse: parser which maintains the queue of (state * lexvalues) in a
 * steady-state; the original's fixError is called on an error, which here
 * raises ParseError *)
let ssParse(table: LrTable saction: SAction arg: InputSource): All(lp: LexPair stack: Stack queue: Queue) Accepted =
    begin
        let rec parseStep(lp: LexPair stack: Stack queue: Queue): Accepted =
            case stack
                when cons with top then
                    begin
                        let terminal = lp.tok.term
                        let value = tuple let v = lp.tok.v let left = lp.tok.left let right = lp.tok.right end
                        let leftPos = lp.tok.left
                        let nextAction = tableAction(table top.hd.state terminal)
                        case nextAction
                            when aShift with s then
                                begin
                                    let newStack = lists.cons(:Elem)(elem(s.s value) stack)
                                    let newLexPair = streamGet(lp.lexer)
                                    let newQueue = fifoGet(fifoPut(queueElem(newStack newLexPair) queue)).q
                                    parseStep(newLexPair lists.cons(:Elem)(elem(s.s value) stack) newQueue)
                                end
                            when aReduce with r then
                                begin
                                    let red = saction(r.r leftPos stack arg)
                                    case red.stack
                                        when cons with c then
                                            parseStep(lp
                                                lists.cons(:Elem)(elem(tableGoto(table c.hd.state red.nt) red.sv)
                                                red.stack) queue)
                                        else impossible(:Accepted)(197)
                                    end
                                end
                            when aError then raise parseError end
                            else tuple let v = top.hd.sv.v let lexer = streamCons(lp.tok lp.lexer) end
                        end
                    end
                else impossible(:Accepted)(204)
            end
        parseStep
    end

(* distanceParse: parse until n tokens are shifted, or accept or error are
 * encountered *)
let distanceParse(table: LrTable saction: SAction arg: InputSource)
        : All(lp: LexPair stack: Stack queue: Queue distance: Int) DistanceResult =
    begin
        let result(lp: LexPair stack: Stack queue: Queue distance: Int act: Opt(Action)): DistanceResult =
            tuple let lp = lp let stack = stack let queue = queue let distance = distance let act = act end
        let rec parseStep(lp: LexPair stack: Stack queue: Queue distance: Int): DistanceResult =
            if distance is 0 then result(lp stack queue 0 none(:Action)())
            else
                case stack
                    when cons with top then
                        begin
                            let terminal = lp.tok.term
                            let value = tuple let v = lp.tok.v let left = lp.tok.left let right = lp.tok.right end
                            let leftPos = lp.tok.left
                            let nextAction = tableAction(table top.hd.state terminal)
                            case nextAction
                                when aShift with s then
                                    begin
                                        let newStack = lists.cons(:Elem)(elem(s.s value) stack)
                                        let newLexPair = streamGet(lp.lexer)
                                        parseStep(newLexPair lists.cons(:Elem)(elem(s.s value) stack)
                                            fifoPut(queueElem(newStack newLexPair) queue) distance - 1)
                                    end
                                when aReduce with r then
                                    begin
                                        let red = saction(r.r leftPos stack arg)
                                        case red.stack
                                            when cons with c then
                                                parseStep(lp lists.cons(:Elem)(
                                                    elem(tableGoto(table c.hd.state red.nt) red.sv) red.stack) queue
                                                    distance)
                                            else impossible(:DistanceResult)(240)
                                        end
                                    end
                                else result(lp stack queue distance some(:Action)(nextAction))
                            end
                        end
                    else impossible(:DistanceResult)(242)
                end
            end
        parseStep
    end

let lrParse(arg: InputSource table: LrTable lexer: Stream saction: SAction void: SValue lookahead: Int): Accepted =
    begin
        (* defer distance tokens *)
        let distance = 15
        let lp = streamGet(lexer)
        let leftPos = lp.tok.left
        let startStack = lists.cons(:Elem)(elem(table.initialState tuple let v = void let left = leftPos
            let right = leftPos end)
            lists.nil(:Elem))
        let startQueue = fifoPut(queueElem(startStack lp) emptyQueue)
        let dParse = distanceParse(table saction arg)
        let sParse = ssParse(table saction arg)
        let loopF(d: DistanceResult): Accepted =
            case d.act
                when oSome with a then
                    case a.x when aAccept then sParse(d.lp d.stack d.queue) else raise parseError end end
                else if d.distance is 0 then sParse(d.lp d.stack d.queue) else raise parseError end end
            end
        loopF(dParse(lp startStack startQueue distance))
    end

(* structure Tokens: the terminals of ML-Yacc's grammar *)
let tARROW = 0 let tASTERISK = 1 let tBLOCK = 2 let tBAR = 3 let tCHANGE = 4 let tCOLON = 5 let tCOMMA = 6
let tDELIMITER = 7 let tEOF = 8 let tFOR = 9 let tHEADER = 10 let tID = 11 let tIDDOT = 12 let tPERCENTHEADER = 13
let tINT = 14 let tKEYWORD = 15 let tLBRACE = 16 let tLPAREN = 17 let tNAME = 18 let tNODEFAULT = 19 let tNONTERM = 20
let tNOSHIFT = 21 let tOF = 22 let tPERCENTEOP = 23 let tPERCENTPURE = 24 let tPERCENTPOS = 25 let tPERCENTARG = 26
let tPREC = 27 let tPRECTAG = 28 let tPREFER = 29 let tPROG = 30 let tRBRACE = 31 let tRPAREN = 32 let tSUBST = 33
let tSTART = 34 let tTERM = 35 let tTYVAR = 36 let tVERBOSE = 37 let tVALUE = 38 let tUNKNOWN = 39 let tBOGUSVALUE = 40

let stringToken(t: Int s: String p1: Int p2: Int): Token =
    begin
        let v =
            if t is tHEADER then option vHeader of SValue with fun(): String s end
            elsif t is tIDDOT then option vIddot of SValue with fun(): String s end
            elsif t is tINT then option vInt of SValue with fun(): String s end
            elsif t is tPROG then option vProg of SValue with fun(): String s end
            elsif t is tTYVAR then option vTyvar of SValue with fun(): String s end
            else option vUnknown of SValue with fun(): String s end
            end
        token(t v p1 p2)
    end
let idToken(i: Symbol p1: Int p2: Int): Token = token(tID option vId of SValue with fun(): Symbol i end p1 p2)
let precToken(i: Prec p1: Int p2: Int): Token = token(tPREC option vPrec of SValue with fun(): Prec i end p1 p2)

(* functor LexMLYACC: the user declarations *)

let var pcount = 0
let var commentLevel = 0
let var actionstart = 0

let eof(i: InputSource): Token =
    begin
        if pcount > 0 then error(i actionstart " eof encountered in action beginning here !") end
        voidToken(tEOF lineno lineno)
    end

let add(s: String): Ok = text := lists.cons(:String)(s text)

Let DictEntry = Tuple s: String t: Int end
let dict: lists.T(DictEntry) =
    begin
        let e(s: String t: Int): DictEntry = tuple let s = s let t = t end
        lists.fromArray(:DictEntry)(array of
            e("%prec" tPRECTAG) e("%term" tTERM) e("%nonterm" tNONTERM) e("%eop" tPERCENTEOP) e("%start" tSTART)
            e("%prefer" tPREFER) e("%subst" tSUBST) e("%change" tCHANGE) e("%keyword" tKEYWORD) e("%name" tNAME)
            e("%verbose" tVERBOSE) e("%nodefault" tNODEFAULT) e("%value" tVALUE) e("%noshift" tNOSHIFT)
            e("%header" tPERCENTHEADER) e("%pure" tPERCENTPURE) e("%arg" tPERCENTARG) e("%pos" tPERCENTPOS)
        end)
    end

let lookup(s: String left: Int right: Int): Token =
    begin
        let rec f(l: lists.T(DictEntry)): Token =
            case l
                when cons with c then if strEq(c.hd.s s) then voidToken(c.hd.t left right) else f(c.tl) end
                else stringToken(tUNKNOWN s left right)
            end
        f(dict)
    end

(* raised if illegal leaf action tried *)
let lexError: Exception = exception lexError: Ok end
let lexerError: Exception = exception lexerError: Ok end

(* structure Internal: each state's accepting actions, and its row of next
 * states, an index into lexRows; the original's rows are strings, compared by
 * contents where these indexes are compared, and ml-lex writes no row twice *)
Let LexState = Tuple fin: Ints trans: Int end
let lexState(fin: Array(Int) trans: Int): LexState = tuple let fin = lists.fromArray(:Int)(fin) let trans = trans end

