    lexState(array of 43 end 0) lexState(array of 38 94 end 0) lexState(array of 40 94 end 0)
    lexState(array of 92 94 end 17) lexState(array of 5 end 0) lexState(array of 73 94 end 18)
    lexState(array of 73 end 18) lexState(array of 94 end 19) lexState(array of 70 end 20) lexState(array of 70 end 21)
    lexState(array of 70 end 22) lexState(array of 70 end 23) lexState(array of 70 end 24)
    lexState(array of 56 70 end 20) lexState(array of 70 end 25) lexState(array of 70 end 26)
    lexState(array of 70 end 27) lexState(array of 70 end 28) lexState(array of 70 end 29) lexState(array of 70 end 30)
    lexState(array of 70 end 31) lexState(array of 66 70 end 20) lexState(array of 70 end 32)
    lexState(array of 70 end 33) lexState(array of 70 end 34) lexState(array of 49 70 end 20)
    lexState(array of 83 end 0) lexState(array of 25 94 end 35) lexState(array of 25 end 35) lexState(array of 20 end 0)
    lexState(array of 103 end 36) lexState(array of 98 end 0) lexState(array of 96 end 37) lexState(array of 8 end 0)
    lexState(array of 100 end 0) lexState(array of 147 end 0) lexState(array of 145 147 end 0)
    lexState(array of 143 147 end 38) lexState(array of 143 end 38) lexState(array of 114 end 39)
    lexState(array of 105 end 40) lexState(array of 108 end 0) lexState(array of 105 end 0)
    lexState(array of 105 end 41) lexState(array of 111 end 0) lexState(array of 134 end 42)
    lexState(array of 129 end 43) lexState(array of 137 end 0) lexState(array of 140 end 0) lexState(array of 127 end 0)
    lexState(array of 131 end 0) lexState(array of 125 end 44) lexState(array of 116 end 45)
    lexState(array of 119 end 0) lexState(array of 116 end 0) lexState(array of 116 end 46) lexState(array of 122 end 0)
end

(* structure StartStates *)
let startA = 3
let startCODE = 5
let startCOMMENT = 9
let startEMPTYCOMMENT = 13
let startF = 7
let startINITIAL = 1
let startSTRING = 11

Let LexBuf = Tuple
    (* buffer *)
    var yyb: String
    (* buffer length *)
    var yybl: Int
    (* location of next character to use *)
    var yybufpos: Int
    (* position in file of beginning of buffer *)
    var yygone: Int
    (* eof found yet? *)
    var yydone: Bool
    (* current 'start state' for lexer *)
    var yybegin: Int
end

let makeLexer(yyinput: All(n: Int) String): All(yyarg: InputSource) All() Token =
    begin
        let b: LexBuf = tuple
            let var yyb = "\n" let var yybl = 1 let var yybufpos = 1 let var yygone = 1 let var yydone = false
            let var yybegin = 1
        end
        fun(yyarg: InputSource): All() Token
            begin
                let inputSource = yyarg
                let rec continue(): Token = scan(b.yybegin lists.nil(:Ints) b.yybufpos b.yybufpos)
                and scan(s: Int acceptingLeaves: lists.T(Ints) l: Int i0: Int): Token =
                    begin
                        let state = lexTab[s]
                        let newAcceptingLeaves = lists.cons(:Ints)(state.fin acceptingLeaves)
                        if l is b.yybl then
                            if state.trans is lexTab[0].trans then action(i0 l newAcceptingLeaves)
                            else
                                begin
                                    let newchars = if b.yydone then "" else yyinput(1024) end
                                    if stringOp.length(newchars) is 0 then
                                        begin
                                            b.yydone := true
                                            if l is i0 then eof(yyarg) else action(i0 l newAcceptingLeaves) end
                                        end
                                    else
                                        begin
                                            b.yyb :=
                                                if i0 is l then newchars
                                                else stringOp.getSub(b.yyb i0 l - i0) <> newchars
                                                end
                                            b.yygone := b.yygone + i0
                                            b.yybl := stringOp.length(b.yyb)
                                            scan(s acceptingLeaves l - i0 0)
                                        end
                                    end
                                end
                            end
                        else
                            begin
                                let newChar = ascii.val(stringOp.getChar(b.yyb l))
                                let newState = if newChar < 128 then lexRows[state.trans][newChar]
                                    else lexRows[state.trans][128]
                                    end
                                if newState is 0 then action(i0 l newAcceptingLeaves)
                                else scan(newState newAcceptingLeaves l + 1 i0)
                                end
                            end
                        end
                    end
                and action(i0: Int i: Int leaves: lists.T(Ints)): Token =
                    case leaves
                        when cons with c then
                            case c.hd
                                when cons with node then
                                    begin
                                        let yytext = stringOp.getSub(b.yyb i0 i - i0)
                                        b.yybufpos := i
                                        userAction(node.hd yytext)
                                    end
                                else action(i0 i - 1 c.tl)
                            end
                        else raise lexError end
                    end
                (* The application actions *)
                and userAction(yyk: Int yytext: String): Token =
                    if yyk is 100 then begin add(yytext) b.yybegin := startSTRING continue() end
                    elsif yyk is 103 then begin add(yytext) continue() end
                    elsif yyk is 105 then begin add(yytext) continue() end
                    elsif yyk is 108 then
                        begin
                            add(yytext)
                            commentLevel := commentLevel - 1
                            if commentLevel is 0 then voidToken(tBOGUSVALUE lineno lineno) else continue() end
                        end
                    elsif yyk is 11 then begin add(yytext) continue() end
                    elsif yyk is 111 then begin add(yytext) commentLevel := commentLevel + 1 continue() end
                    elsif yyk is 114 then begin add(yytext) continue() end
                    elsif yyk is 116 then continue()
                    elsif yyk is 119 then
                        begin
                            commentLevel := commentLevel - 1
                            if commentLevel is 0 then b.yybegin := startA end
                            continue()
                        end
                    elsif yyk is 122 then begin commentLevel := commentLevel + 1 continue() end
                    elsif yyk is 125 then continue()
                    elsif yyk is 127 then begin add(yytext) b.yybegin := startCODE continue() end
                    elsif yyk is 129 then begin add(yytext) continue() end
                    elsif yyk is 131 then
                        begin
                            add(yytext)
                            error(inputSource lineno "unclosed string")
                            lineno := lineno + 1
                            b.yybegin := startCODE
                            continue()
                        end
                    elsif yyk is 134 then begin add(yytext) continue() end
                    elsif yyk is 137 then begin add(yytext) continue() end
                    elsif yyk is 14 then
                        begin
                            b.yybegin := startA
                            stringToken(tHEADER concat(lists.rev(:String)(text)) lineno lineno)
                        end
                    elsif yyk is 140 then
                        begin
                            add(yytext)
                            if strEq(stringOp.getSub(yytext 1 1) "\n") then lineno := lineno + 1 end
                            b.yybegin := startF
                            continue()
                        end
                    elsif yyk is 143 then begin add(yytext) continue() end
                    elsif yyk is 145 then begin add(yytext) b.yybegin := startSTRING continue() end
                    elsif yyk is 147 then
                        begin
                            add(yytext)
                            error(inputSource lineno "unclosed string")
                            b.yybegin := startCODE
                            continue()
                        end
                    elsif yyk is 16 then begin add(yytext) lineno := lineno + 1 continue() end
                    elsif yyk is 18 then begin add(yytext) continue() end
                    elsif yyk is 2 then
                        begin
                            add(yytext)
                            b.yybegin := startCOMMENT
                            commentLevel := 1
                            let t = continue()
                            b.yybegin := startINITIAL
                            t
                        end
                    elsif yyk is 20 then begin lineno := lineno + 1 continue() end
                    elsif yyk is 25 then continue()
                    elsif yyk is 28 then voidToken(tOF lineno lineno)
                    elsif yyk is 32 then voidToken(tFOR lineno lineno)
                    elsif yyk is 34 then voidToken(tLBRACE lineno lineno)
                    elsif yyk is 36 then voidToken(tRBRACE lineno lineno)
                    elsif yyk is 38 then voidToken(tCOMMA lineno lineno)
                    elsif yyk is 40 then voidToken(tASTERISK lineno lineno)
                    elsif yyk is 43 then voidToken(tARROW lineno lineno)
                    elsif yyk is 49 then precToken(option pLeft of Prec end lineno lineno)
                    elsif yyk is 5 then begin b.yybegin := startEMPTYCOMMENT commentLevel := 1 continue() end
                    elsif yyk is 56 then precToken(option pRight of Prec end lineno lineno)
                    elsif yyk is 66 then precToken(option pNonassoc of Prec end lineno lineno)
                    elsif yyk is 70 then lookup(yytext lineno lineno)
                    elsif yyk is 73 then stringToken(tTYVAR yytext lineno lineno)
                    elsif yyk is 77 then stringToken(tIDDOT yytext lineno lineno)
                    elsif yyk is 8 then
                        begin
                            add(yytext)
                            b.yybegin := startCOMMENT
                            commentLevel := 1
                            let t = continue()
                            b.yybegin := startCODE
                            t
                        end
                    elsif yyk is 80 then stringToken(tINT yytext lineno lineno)
                    elsif yyk is 83 then voidToken(tDELIMITER lineno lineno)
                    elsif yyk is 85 then voidToken(tCOLON lineno lineno)
                    elsif yyk is 87 then voidToken(tBAR lineno lineno)
                    elsif yyk is 90 then idToken(tuple let name = yytext let pos = lineno end lineno lineno)
                    elsif yyk is 92 then
                        begin
                            pcount := 1
                            actionstart := lineno
                            text := lists.nil(:String)
                            b.yybegin := startCODE
                            let t = continue()
                            b.yybegin := startA
                            t
                        end
                    elsif yyk is 94 then stringToken(tUNKNOWN yytext lineno lineno)
                    elsif yyk is 96 then begin pcount := pcount + 1 add(yytext) continue() end
                    elsif yyk is 98 then
                        begin
                            pcount := pcount - 1
                            if pcount is 0 then stringToken(tPROG concat(lists.rev(:String)(text)) lineno lineno)
                            else begin add(yytext) continue() end
                            end
                        end
                    else raise lexerError end
                    end
                continue
            end
    end

(* structure Actions: the semantic actions of ML-Yacc's grammar, each taking
 * the values it reduces off the stack, by the patterns the original matches *)

let mlyAction: Exception(Int) = exception mlyAction: Int end

let actions(i: Int defaultPos: Int stack: Stack inputSource: InputSource): ReduceResult =
    begin
        let fail(A::TYPE)(): A = raise mlyAction with i end
        (* the nth value on the stack, counting the top as 1, and the stack below
         * the nth *)
        let el(n: Int): StackVal = lists.nth(:Elem)(stack n - 1).sv
        let rest(n: Int): Stack = lists.drop(:Elem)(stack n)
        let reduced(nt: Int v: SValue left: Int right: Int rest: Stack): ReduceResult =
            tuple let nt = nt let sv = tuple let v = v let left = left let right = right end let stack = rest end
        let str(v: SValue): All() String =
            case v
                when vTyvar with x then x.f when vProg with x then x.f when vInt with x then x.f
                when vIddot with x then x.f when vTy with x then x.f when vRecordList with x then x.f
                when vQualId with x then x.f when vLabel with x then x.f when vHeader with x then x.f
                else fail(:All() String)()
            end
        let prog(v: SValue): All() String = case v when vProg with x then x.f else fail(:All() String)() end
        let ty(v: SValue): All() String = case v when vTy with x then x.f else fail(:All() String)() end
        let id(v: SValue): All() Symbol = case v when vId with x then x.f else fail(:All() Symbol)() end
        let idList(v: SValue): All() Symbols = case v when vIdList with x then x.f else fail(:All() Symbols)() end
        let constrList(v: SValue): All() Constrs =
            case v when vConstrList with x then x.f else fail(:All() Constrs)() end
        let mpcDecls(v: SValue): All() DeclData = case v when vMpcDecls with x then x.f else fail(:All() DeclData)() end
        let mpcDecl(v: SValue): All() DeclData = case v when vMpcDecl with x then x.f else fail(:All() DeclData)() end
        let gRuleList(v: SValue): All() HRules = case v when vGRuleList with x then x.f else fail(:All() HRules)() end
        let gRule(v: SValue): All() HRules = case v when vGRule with x then x.f else fail(:All() HRules)() end
        let rhsList(v: SValue): All() lists.T(RhsData) =
            case v when vRhsList with x then x.f else fail(:All() lists.T(RhsData))() end
        let gRulePrec(v: SValue): All() Opt(Symbol) =
            case v when vGRulePrec with x then x.f else fail(:All() Opt(Symbol))() end
        let changeDecl(v: SValue): All() Changes = case v when vChangeDecl with x then x.f
            else fail(:All() Changes)() end
        let changeDec(v: SValue): All() Change = case v when vChangeDec with x then x.f else fail(:All() Change)() end
        let substDecl(v: SValue): All() Changes = case v when vSubstDecl with x then x.f else fail(:All() Changes)() end
        let substDec(v: SValue): All() Change = case v when vSubstDec with x then x.f else fail(:All() Change)() end
        let precV(v: SValue): All() Prec = case v when vPrec with x then x.f else fail(:All() Prec)() end
        let label(v: SValue): All() String = case v when vLabel with x then x.f else fail(:All() String)() end
        let qualId(v: SValue): All() String = case v when vQualId with x then x.f else fail(:All() String)() end
        let recordList(v: SValue): All() String =
            case v when vRecordList with x then x.f else fail(:All() String)() end
        let iddot(v: SValue): All() String = case v when vIddot with x then x.f else fail(:All() String)() end
        let tyvar(v: SValue): All() String = case v when vTyvar with x then x.f else fail(:All() String)() end
        let int(v: SValue): All() String = case v when vInt with x then x.f else fail(:All() String)() end
        let header(v: SValue): All() String = case v when vHeader with x then x.f else fail(:All() String)() end
        let symNil = lists.nil(:Symbol)
        let noConstrs = none(:Constrs)()
        let precNil = lists.nil(:PrecDecl)
        let changeNil = lists.nil(:Change)
        let controlNil = lists.nil(:Control)
        let valueNil = lists.nil(:ValueDecl)
        let control1(c: Control): Controls = lists.cons(:Control)(c controlNil)
        let mpcDeclV(f: All() DeclData): SValue = option vMpcDecl of SValue with f end
        let tyV(f: All() String): SValue = option vTy of SValue with f end
        let constrListV(f: All() Constrs): SValue = option vConstrList of SValue with f end
        let constr(sym: Symbol ty: Opt(String)): Constr = tuple let sym = sym let ty = ty end
        let rhsData(rhs: Symbols code: String prec: Opt(Symbol)): RhsData =
            tuple let rhs = rhs let code = code let prec = prec end
        if i is 0 then
            begin
                let gRuleList1 = gRuleList(el(1).v)
                let mpcDecls1 = mpcDecls(el(3).v)
                let header1 = header(el(4).v)
                let result = option vBegin of SValue with
                    fun(): ParseResult
                        begin
                            let header = header1()
                            let mpcDecls = mpcDecls1()
                            let gRuleList = gRuleList1()
                            tuple let header = header let decl = mpcDecls let rules = lists.rev(:HRule)(gRuleList) end
                        end
                end
                reduced(0 result el(4).left el(1).right rest(4))
            end
        elsif i is 1 then
            begin
                let mpcDecl1 = mpcDecl(el(1).v)
                let mpcDeclleft = el(1).left
                let mpcDecls1 = mpcDecls(el(2).v)
                let result = option vMpcDecls of SValue with
                    fun(): DeclData
                        begin
                            let mpcDecls = mpcDecls1()
                            let mpcDecl = mpcDecl1()
                            joinDecls(mpcDecls mpcDecl inputSource mpcDeclleft)
                        end
                end
                reduced(5 result el(2).left el(1).right rest(2))
            end
        elsif i is 2 then
            begin
                let result = option vMpcDecls of SValue with
                    fun(): DeclData decl(symNil symNil noConstrs precNil changeNil noConstrs controlNil valueNil)
                end
                reduced(5 result defaultPos defaultPos stack)
            end
        elsif {i is 3} orif {i is 4} then
            begin
                let constrList1 = constrList(el(1).v)
                let result = mpcDeclV(
                    fun(): DeclData
                        begin
                            let constrList = some(:Constrs)(constrList1())
                            if i is 3
                                then decl(symNil symNil noConstrs precNil changeNil constrList controlNil valueNil)
                            else decl(symNil symNil constrList precNil changeNil noConstrs controlNil valueNil)
                            end
                        end)
                reduced(4 result el(2).left el(1).right rest(2))
            end
        elsif i is 5 then
            begin
                let idList1 = idList(el(1).v)
                let prec1 = precV(el(2).v)
                let result = mpcDeclV(
                    fun(): DeclData
                        begin
                            let prec = prec1()
                            let idList = idList1()
                            let precs = lists.cons(:PrecDecl)(tuple let prec = prec let syms = idList end precNil)
                            decl(symNil symNil noConstrs precs changeNil noConstrs controlNil valueNil)
                        end)
                reduced(4 result el(2).left el(1).right rest(2))
            end
        elsif {i is 6} orif {i is 14} then
            begin
                let id1 = id(el(1).v)
                let result = mpcDeclV(
                    fun(): DeclData
                        begin
                            let id = id1()
                            let c =
                                if i is 6 then option cStartSym of Control with symbolMake(id) end
                                else option cParserName of Control with symbolMake(id) end
                                end
                            decl(symNil symNil noConstrs precNil changeNil noConstrs control1(c) valueNil)
                        end)
                reduced(4 result el(2).left el(1).right rest(2))
            end
        elsif {i is 7} orif {i is 8} orif {i is 9} orif {i is 12} then
            begin
                let idList1 = idList(el(1).v)
                let result = mpcDeclV(
                    fun(): DeclData
                        begin
                            let idList = idList1()
                            if i is 7 then decl(idList symNil noConstrs precNil changeNil noConstrs controlNil valueNil)
                            elsif i is 8 then
                                decl(symNil idList noConstrs precNil changeNil noConstrs controlNil valueNil)
                            elsif i is 9 then
                                begin
                                    let change = lists.map(:Symbol :Change)(
                                        fun(i: Symbol): Change
                                            tuple let a = symNil let b = lists.cons(:Symbol)(i symNil) end
                                        idList)
                                    decl(symNil symNil noConstrs precNil change noConstrs controlNil valueNil)
                                end
                            else
                                decl(symNil symNil noConstrs precNil changeNil noConstrs
                                    control1(option cNshift of Control with idList end) valueNil)
                            end
                        end)
                reduced(4 result el(2).left el(1).right rest(2))
            end
        elsif {i is 10} orif {i is 11} then
            begin
                let changes1 = if i is 10 then changeDecl(el(1).v) else substDecl(el(1).v) end
                let result = mpcDeclV(
                    fun(): DeclData
                        begin
                            let change = changes1()
                            decl(symNil symNil noConstrs precNil change noConstrs controlNil valueNil)
                        end)
                reduced(4 result el(2).left el(1).right rest(2))
            end
        elsif i is 13 then
            begin
                let prog1 = prog(el(1).v)
                let result = mpcDeclV(
                    fun(): DeclData
                        begin
                            let prog = prog1()
                            decl(symNil symNil noConstrs precNil changeNil noConstrs
                                control1(option cFunctor of Control with prog end) valueNil)
                        end)
                reduced(4 result el(2).left el(1).right rest(2))
            end
        elsif i is 15 then
            begin
                let ty1 = ty(el(1).v)
                let prog1 = prog(el(3).v)
                let result = mpcDeclV(
                    fun(): DeclData
                        begin
                            let prog = prog1()
                            let ty = ty1()
                            decl(symNil symNil noConstrs precNil changeNil noConstrs
                                control1(option cParseArg of Control with prog ty end) valueNil)
                        end)
                reduced(4 result el(4).left el(1).right rest(4))
            end
        elsif {i is 16} orif {i is 17} orif {i is 18} then
            begin
                let result = mpcDeclV(
                    fun(): DeclData
                        begin
                            let c =
                                if i is 16 then option cVerbose of Control end
                                elsif i is 17 then option cNodefault of Control end
                                else option cPure of Control end
                                end
                            decl(symNil symNil noConstrs precNil changeNil noConstrs control1(c) valueNil)
                        end)
                reduced(4 result el(1).left el(1).right rest(1))
            end
        elsif i is 19 then
            begin
                let ty1 = ty(el(1).v)
                let result = mpcDeclV(
                    fun(): DeclData
                        begin
                            let ty = ty1()
                            decl(symNil symNil noConstrs precNil changeNil noConstrs
                                control1(option cPos of Control with ty end) valueNil)
                        end)
                reduced(4 result el(2).left el(1).right rest(2))
            end
        elsif i is 20 then
            begin
                let prog1 = prog(el(1).v)
                let id1 = id(el(2).v)
                let result = mpcDeclV(
                    fun(): DeclData
                        begin
                            let id = id1()
                            let prog = prog1()
                            let value = lists.cons(:ValueDecl)(tuple let sym = symbolMake(id) let s = prog end valueNil)
                            decl(symNil symNil noConstrs precNil changeNil noConstrs controlNil value)
                        end)
                reduced(4 result el(3).left el(1).right rest(3))
            end
        elsif {i is 21} orif {i is 24} then
            begin
                let decl1 = if i is 21 then changeDecl(el(1).v) else substDecl(el(1).v) end
                let dec1 = if i is 21 then changeDec(el(3).v) else substDec(el(3).v) end
                let f(): Changes =
                    begin
                        let dec = dec1()
                        let decl = decl1()
                        lists.cons(:Change)(dec decl)
                    end
                let result =
                    if i is 21 then option vChangeDecl of SValue with f end
                        else option vSubstDecl of SValue with f end end
                reduced(if i is 21 then 14 else 12 end result el(3).left el(1).right rest(3))
            end
        elsif {i is 22} orif {i is 25} then
            begin
                let dec1 = if i is 22 then changeDec(el(1).v) else substDec(el(1).v) end
                let f(): Changes = begin let dec = dec1() lists.cons(:Change)(dec changeNil) end
                let result =
                    if i is 22 then option vChangeDecl of SValue with f end
                        else option vSubstDecl of SValue with f end end
                reduced(if i is 22 then 14 else 12 end result el(1).left el(1).right rest(1))
            end
        elsif i is 23 then
            begin
                let idList2 = idList(el(1).v)
                let idList1 = idList(el(3).v)
                let result = option vChangeDec of SValue with
                    fun(): Change
                        begin
                            let a = idList1()
                            let b = idList2()
                            tuple let a = a let b = b end
                        end
                end
                reduced(15 result el(3).left el(1).right rest(3))
            end
        elsif i is 26 then
            begin
                let id2 = id(el(1).v)
                let id1 = id(el(3).v)
                let result = option vSubstDec of SValue with
                    fun(): Change
                        begin
                            let id1 = id1()
                            let id2 = id2()
                            tuple
                                let a = lists.cons(:Symbol)(symbolMake(id2) symNil)
                                let b = lists.cons(:Symbol)(symbolMake(id1) symNil)
                            end
                        end
                end
                reduced(13 result el(3).left el(1).right rest(3))
            end
        elsif i is 27 then
            begin
                let ty1 = ty(el(1).v)
                let id1 = id(el(3).v)
                let constrList1 = constrList(el(5).v)
                let result = constrListV(
                    fun(): Constrs
                        begin
                            let constrList = constrList1()
                            let id = id1()
                            let ty = ty1()
                            lists.cons(:Constr)(constr(symbolMake(id) some(:String)(ty)) constrList)
                        end)
                reduced(1 result el(5).left el(1).right rest(5))
            end
        elsif i is 28 then
            begin
                let id1 = id(el(1).v)
                let constrList1 = constrList(el(3).v)
                let result = constrListV(
                    fun(): Constrs
                        begin
                            let constrList = constrList1()
                            let id = id1()
                            lists.cons(:Constr)(constr(symbolMake(id) none(:String)()) constrList)
                        end)
                reduced(1 result el(3).left el(1).right rest(3))
            end
        elsif i is 29 then
            begin
                let ty1 = ty(el(1).v)
                let id1 = id(el(3).v)
                let result = constrListV(
                    fun(): Constrs
                        begin
                            let id = id1()
                            let ty = ty1()
                            lists.cons(:Constr)(constr(symbolMake(id) some(:String)(ty)) lists.nil(:Constr))
                        end)
                reduced(1 result el(3).left el(1).right rest(3))
            end
        elsif i is 30 then
            begin
                let id1 = id(el(1).v)
                let result = constrListV(
                    fun(): Constrs
                        begin
                            let id = id1()
                            lists.cons(:Constr)(constr(symbolMake(id) none(:String)()) lists.nil(:Constr))
                        end)
                reduced(1 result el(1).left el(1).right rest(1))
            end
        elsif i is 31 then
            begin
                let rhsList1 = rhsList(el(1).v)
                let id1 = id(el(3).v)
                let result = option vGRule of SValue with
                    fun(): HRules
                        begin
                            let id = id1()
                            let rhsList = rhsList1()
                            lists.map(:RhsData :HRule)(
                                fun(r: RhsData): HRule
                                    tuple let lhs = symbolMake(id) let rhs = r.rhs let code = r.code
                                        let prec = r.prec end
                                rhsList)
                        end
                end
                reduced(9 result el(3).left el(1).right rest(3))
            end
        elsif i is 32 then
            begin
                let gRule1 = gRule(el(1).v)
                let gRuleList1 = gRuleList(el(2).v)
                let result = option vGRuleList of SValue with
                    fun(): HRules
                        begin
                            let gRuleList = gRuleList1()
                            let gRule = gRule1()
                            lists.append(:HRule)(gRule gRuleList)
                        end
                end
                reduced(10 result el(2).left el(1).right rest(2))
            end
        elsif i is 33 then
            begin
                let gRule1 = gRule(el(1).v)
                let result = option vGRuleList of SValue with fun(): HRules gRule1() end
                reduced(10 result el(1).left el(1).right rest(1))
            end
        elsif i is 34 then
            begin
                let idList1 = idList(el(1).v)
                let id1 = id(el(2).v)
                let result = option vIdList of SValue with
                    fun(): Symbols
                        begin
                            let id = id1()
                            let idList = idList1()
                            lists.cons(:Symbol)(symbolMake(id) idList)
                        end
                end
                reduced(2 result el(2).left el(1).right rest(2))
            end
        elsif i is 35 then
            reduced(2 option vIdList of SValue with fun(): Symbols symNil end defaultPos defaultPos stack)
        elsif i is 36 then
            begin
                let prog1 = prog(el(1).v)
                let gRulePrec1 = gRulePrec(el(2).v)
                let idList1 = idList(el(3).v)
                let result = option vRhsList of SValue with
                    fun(): lists.T(RhsData)
                        begin
                            let idList = idList1()
                            let gRulePrec = gRulePrec1()
                            let prog = prog1()
                            lists.cons(:RhsData)(rhsData(idList prog gRulePrec) lists.nil(:RhsData))
                        end
                end
                reduced(8 result el(3).left el(1).right rest(3))
            end
        elsif i is 37 then
            begin
                let prog1 = prog(el(1).v)
                let gRulePrec1 = gRulePrec(el(2).v)
                let idList1 = idList(el(3).v)
                let rhsList1 = rhsList(el(5).v)
                let result = option vRhsList of SValue with
                    fun(): lists.T(RhsData)
                        begin
                            let rhsList = rhsList1()
                            let idList = idList1()
                            let gRulePrec = gRulePrec1()
                            let prog = prog1()
                            lists.cons(:RhsData)(rhsData(idList prog gRulePrec) rhsList)
                        end
                end
                reduced(8 result el(5).left el(1).right rest(5))
            end
        elsif i is 38 then
            begin
                let tyvar1 = tyvar(el(1).v)
                reduced(16 tyV(fun(): String tyvar1()) el(1).left el(1).right rest(1))
            end
        elsif i is 39 then
            begin
                let recordList1 = recordList(el(2).v)
                reduced(16 tyV(fun(): String "{ " <> recordList1() <> " } ") el(3).left el(1).right rest(3))
            end
        elsif i is 40 then reduced(16 tyV(fun(): String "{}") el(2).left el(1).right rest(2))
        elsif i is 41 then
            begin
                let prog1 = prog(el(1).v)
                reduced(16 tyV(fun(): String " ( " <> prog1() <> " ) ") el(1).left el(1).right rest(1))
            end
        elsif i is 42 then
            begin
                let qualId1 = qualId(el(1).v)
                let ty1 = ty(el(2).v)
                let result = tyV(
                    fun(): String
                        begin
                            let ty = ty1()
                            let qualId = qualId1()
                            ty <> " " <> qualId
                        end)
                reduced(16 result el(2).left el(1).right rest(2))
            end
        elsif i is 43 then
            begin
                let qualId1 = qualId(el(1).v)
                reduced(16 tyV(fun(): String qualId1()) el(1).left el(1).right rest(1))
            end
        elsif {i is 44} orif {i is 45} then
            begin
                let ty2 = ty(el(1).v)
                let ty1 = ty(el(3).v)
                let result = tyV(
                    fun(): String
                        begin
                            let ty1 = ty1()
                            let ty2 = ty2()
                            if i is 44 then ty1 <> "*" <> ty2 else ty1 <> " -> " <> ty2 end
                        end)
                reduced(16 result el(3).left el(1).right rest(3))
            end
        elsif i is 46 then
            begin
                let ty1 = ty(el(1).v)
                let label1 = label(el(3).v)
                let recordList1 = recordList(el(5).v)
                let result = option vRecordList of SValue with
                    fun(): String
                        begin
                            let recordList = recordList1()
                            let label = label1()
                            let ty = ty1()
                            recordList <> "," <> label <> ":" <> ty
                        end
                end
                reduced(7 result el(5).left el(1).right rest(5))
            end
        elsif i is 47 then
            begin
                let ty1 = ty(el(1).v)
                let label1 = label(el(3).v)
                let result = option vRecordList of SValue with
                    fun(): String
                        begin
                            let label = label1()
                            let ty = ty1()
                            label <> ":" <> ty
                        end
                end
                reduced(7 result el(3).left el(1).right rest(3))
            end
        elsif {i is 48} orif {i is 50} then
            begin
                let id1 = id(el(1).v)
                let f(): String = begin let id = id1() id.name end
                let result = if i is 48 then option vQualId of SValue with f end
                    else option vLabel of SValue with f end end
                reduced(if i is 48 then 6 else 3 end result el(1).left el(1).right rest(1))
            end
        elsif i is 49 then
            begin
                let qualId1 = qualId(el(1).v)
                let iddot1 = iddot(el(2).v)
                let result = option vQualId of SValue with
                    fun(): String
                        begin
                            let iddot = iddot1()
                            let qualId = qualId1()
                            iddot <> qualId
                        end
                end
                reduced(6 result el(2).left el(1).right rest(2))
            end
        elsif i is 51 then
            begin
                let int1 = int(el(1).v)
                reduced(3 option vLabel of SValue with fun(): String int1() end el(1).left el(1).right rest(1))
            end
        elsif i is 52 then
            begin
                let id1 = id(el(1).v)
                let result = option vGRulePrec of SValue with
                    fun(): Opt(Symbol) begin let id = id1() some(:Symbol)(symbolMake(id)) end
                end
                reduced(11 result el(2).left el(1).right rest(2))
            end
        elsif i is 53 then
            reduced(11 option vGRulePrec of SValue with fun(): Opt(Symbol) none(:Symbol)() end defaultPos defaultPos
                stack)
        else fail(:ReduceResult)()
        end
    end

let extract(a: SValue): ParseResult =
    case a when vBegin with x then x.f() else raise exception parseInternal: Ok end end end

(* functor ParseGenParserFun *)
Let Parsed = Tuple result: ParseResult source: InputSource end

let parse(file: String): Parsed =
    begin
        let inStr = reader.file(file)
        let source = newSource(file writer.output)
        let stream = streamify(makeLexer(fun(i: Int): String if reader.more(inStr)
            then reader.getString(inStr i) else "" end
            )(source))
        lineno := 1
        text := lists.nil(:String)
        let result = extract(lrParse(source parserTable stream actions voidValue 15).v)
        reader.close(inStr)
        tuple let result = result let source = source end
    end

(* functor ListOrdSet: ordered sets as ordered lists; each function takes the
 * order the functor's argument gives *)

Let Gt(A::TYPE) = All(a: A b: A) Bool

let losInsert(A::TYPE)(gt: Gt(A) eq: Gt(A) key: A s: lists.T(A)): lists.T(A) =
    begin
        let rec f(l: lists.T(A)): lists.T(A) =
            case l
                when cons with c then
                    if gt(key c.hd) then lists.cons(:A)(c.hd f(c.tl))
                    elsif eq(key c.hd) then lists.cons(:A)(key c.tl)
                    else lists.cons(:A)(key l)
                    end
                else lists.cons(:A)(key lists.nil(:A))
            end
        f(s)
    end

let losExists(A::TYPE)(gt: Gt(A) eq: Gt(A) key: A s: lists.T(A)): Bool =
    begin
        let rec f(l: lists.T(A)): Bool =
            case l when cons with c then if gt(key c.hd) then f(c.tl) else eq(c.hd key) end else false end
        f(s)
    end

let losFind(A::TYPE)(gt: Gt(A) eq: Gt(A) key: A s: lists.T(A)): Opt(A) =
    begin
        let rec f(l: lists.T(A)): Opt(A) =
            case l
                when cons with c then
                    if gt(key c.hd) then f(c.tl) elsif eq(c.hd key) then some(:A)(c.hd) else none(:A)() end
                else none(:A)()
            end
        f(s)
    end

let rec losSetEq(A::TYPE)(eq: Gt(A) a: lists.T(A) b: lists.T(A)): Bool =
    case a
        when cons with x then
            case b when cons with y then if eq(x.hd y.hd) then losSetEq(:A)(eq x.tl y.tl) else false end else false end
        else case b when nil then true else false end
    end

let rec losSetGt(A::TYPE)(gt: Gt(A) eq: Gt(A) a: lists.T(A) b: lists.T(A)): Bool =
    case a
        when cons with x then
            case b
                when cons with y then
                    if gt(x.hd y.hd) then true elsif eq(x.hd y.hd) then losSetGt(:A)(gt eq x.tl y.tl) else false end
                else true
            end
        else false
    end

let losUnion(A::TYPE)(gt: Gt(A) eq: Gt(A) a: lists.T(A) b: lists.T(A)): lists.T(A) =
    begin
        let rec union(a: lists.T(A) b: lists.T(A)): lists.T(A) =
            case a
                when cons with x then
                    case b
                        when cons with y then
                            if gt(y.hd x.hd) then lists.cons(:A)(x.hd union(x.tl b))
                            elsif eq(x.hd y.hd) then lists.cons(:A)(x.hd union(x.tl y.tl))
                            else lists.cons(:A)(y.hd union(a y.tl))
                            end
                        else a
                    end
                else b
            end
        union(a b)
    end

let losMakeSet(A::TYPE)(gt: Gt(A) eq: Gt(A) l: lists.T(A)): lists.T(A) =
    lists.foldr(:A :lists.T(A))(fun(key: A s: lists.T(A)): lists.T(A) losInsert(:A)(gt eq key s) lists.nil(:A) l)

(* difference: X-Y *)
let losDifference(A::TYPE)(gt: Gt(A) eq: Gt(A) a: lists.T(A) b: lists.T(A)): lists.T(A) =
    begin
        let rec difference(a: lists.T(A) b: lists.T(A)): lists.T(A) =
            case a
                when cons with x then
                    case b
                        when cons with y then
                            if gt(y.hd x.hd) then lists.cons(:A)(x.hd difference(x.tl b))
                            elsif eq(y.hd x.hd) then difference(x.tl y.tl)
                            else difference(a y.tl)
                            end
                        else a
                    end
                else lists.nil(:A)
            end
        difference(a b)
    end

let losSingleton(A::TYPE)(x: A): lists.T(A) = lists.cons(:A)(x lists.nil(:A))

Let MoreResult(A::TYPE) = Tuple more: lists.T(A) result: lists.T(A) end

let losClosure(A::TYPE)(gt: Gt(A) eq: Gt(A) start: lists.T(A) f: All(a: A) lists.T(A)): lists.T(A) =
    begin
        let rec closure(from: lists.T(A) result: lists.T(A)): lists.T(A) =
            case from
                when nil then result
                else
                    begin
                        let mr = lists.foldr(:A :MoreResult(A))(
                            fun(a: A mr: MoreResult(A)): MoreResult(A)
                                begin
                                    let more = f(a)
                                    let new = losDifference(:A)(gt eq more result)
                                    tuple
                                        let more = losUnion(:A)(gt eq mr.more new)
                                        let result = losUnion(:A)(gt eq mr.result new)
                                    end
                                end
                            tuple let more = lists.nil(:A) let result = result end from)
                        closure(mr.more mr.result)
                    end
            end
        closure(start start)
    end

(* functors RbOrdSet and Table: red-black trees; a Table's elements are its
 * keys paired with their data, ordered by their keys *)

Let Rec RbTree(A::TYPE) = Option rbEmpty rbNode with k: A red: Bool l: RbTree(A) r: RbTree(A) end end

let rbEmpty(A::TYPE)(): RbTree(A) = option rbEmpty of RbTree(A) end
let rbNode(A::TYPE)(k: A red: Bool l: RbTree(A) r: RbTree(A)): RbTree(A) = option rbNode of RbTree(A) with k red l r end
let rbIsRed(A::TYPE)(t: RbTree(A)): Bool = case t when rbNode with n then n.red else false end

let rbInsert(A::TYPE)(gt: Gt(A) key: A t: RbTree(A)): RbTree(A) =
    begin
        let node(k: A red: Bool l: RbTree(A) r: RbTree(A)): RbTree(A) = rbNode(:A)(k red l r)
        let isRed(t: RbTree(A)): Bool = rbIsRed(:A)(t)
        let rec f(t: RbTree(A)): RbTree(A) =
            case t
                when rbEmpty then node(key true rbEmpty(:A)() rbEmpty(:A)())
                when rbNode with n then
                    begin
                        let k = n.k
                        let l = n.l
                        let r = n.r
                        if not(n.red) then
                            if gt(key k) then
                                begin
                                    let r1 = f(r)
                                    let rn = r1!rbNode
                                    if isRed(r1) andif isRed(rn.l) then
                                        begin
                                            let rl = rn.l!rbNode
                                            if isRed(l) then
                                                begin
                                                    let ln = l!rbNode
                                                    node(k true node(ln.k false ln.l ln.r) node(rn.k false rn.l rn.r))
                                                end
                                            else node(rl.k false node(k true l rl.l) node(rn.k true rl.r rn.r))
                                            end
                                        end
                                    elsif isRed(r1) andif isRed(rn.r) then
                                        if isRed(l) then
                                            begin
                                                let ln = l!rbNode
                                                node(k true node(ln.k false ln.l ln.r) node(rn.k false rn.l rn.r))
                                            end
                                        else node(rn.k false node(k true l rn.l) rn.r)
                                        end
                                    else node(k false l r1)
                                    end
                                end
                            elsif gt(k key) then
                                begin
                                    let l1 = f(l)
                                    let ln = l1!rbNode
                                    if isRed(l1) andif isRed(ln.r) then
                                        begin
                                            let lr = ln.r!rbNode
                                            if isRed(r) then
                                                begin
                                                    let rn = r!rbNode
                                                    node(k true node(ln.k false ln.l ln.r) node(rn.k false rn.l rn.r))
                                                end
                                            else node(lr.k false node(ln.k true ln.l lr.l) node(k true lr.r r))
                                            end
                                        end
                                    elsif isRed(l1) andif isRed(ln.l) then
                                        if isRed(r) then
                                            begin
                                                let rn = r!rbNode
                                                node(k true node(ln.k false ln.l ln.r) node(rn.k false rn.l rn.r))
                                            end
                                        else node(ln.k false ln.l node(k true ln.r r))
                                        end
                                    else node(k false l1 r)
                                    end
                                end
                            else node(key false l r)
                            end
                        elsif gt(key k) then node(k true l f(r))
                        elsif gt(k key) then node(k true f(l) r)
                        else node(key true l r)
                        end
                    end
            end
        let t1 = f(t)
        case t1
            when rbNode with n then
                if n.red andif {isRed(n.l) orif isRed(n.r)} then node(n.k false n.l n.r) else t1 end
            else t1
        end
    end

let rbFind(A::TYPE)(gt: Gt(A) key: A t: RbTree(A)): Opt(A) =
    begin
        let rec look(t: RbTree(A)): Opt(A) =
            case t
                when rbNode with n then
                    if gt(n.k key) then look(n.l) elsif gt(key n.k) then look(n.r) else some(:A)(n.k) end
                else none(:A)()
            end
        look(t)
    end

let rbExists(A::TYPE)(gt: Gt(A) key: A t: RbTree(A)): Bool =
    begin
        let rec look(t: RbTree(A)): Bool =
            case t
                when rbNode with n then if gt(n.k key) then look(n.l) elsif gt(key n.k) then look(n.r) else true end
                else false
            end
        look(t)
    end

let rbFold(A::TYPE B::TYPE)(f: All(a: A b: B) B t: RbTree(A) start: B): B =
    begin
        let rec scan(t: RbTree(A) value: B): B =
            case t when rbNode with n then scan(n.l f(n.k scan(n.r value))) else value end
        scan(t start)
    end

let rbMakeList(A::TYPE)(t: RbTree(A)): lists.T(A) =
    rbFold(:A :lists.T(A))(fun(a: A l: lists.T(A)): lists.T(A) lists.cons(:A)(a l) t lists.nil(:A))

(* A Table's element: a key and its data *)
Let KV(K::TYPE V::TYPE) = Tuple k: K d: V end
let kv(K::TYPE V::TYPE)(k: K d: V): KV(K V) = tuple let k = k let d = d end

(* Table.find, which gives the key's data *)
let tableFind(K::TYPE V::TYPE)(gt: Gt(K) key: K t: RbTree(KV(K V))): Opt(V) =
    begin
        let rec look(t: RbTree(KV(K V))): Opt(V) =
            case t
                when rbNode with n then
                    if gt(n.k.k key) then look(n.l) elsif gt(key n.k.k) then look(n.r) else some(:V)(n.k.d) end
                else none(:V)()
            end
        look(t)
    end

(* structures Grammar and IntGrammar *)

Let GSymbol = Option sTerm with t: Int end sNonterm with n: Int end end
Let GSymbols = lists.T(GSymbol)
let termSym(t: Int): GSymbol = option sTerm of GSymbol with t end
let nontermSym(n: Int): GSymbol = option sNonterm of GSymbol with n end

Let GRule = Tuple lhs: Int rhs: GSymbols precedence: Opt(Int) rulenum: Int end

Let Grammar = Tuple
    rules: lists.T(GRule)
    terms: Int
    nonterms: Int
    start: Int
    eop: Ints
    noshift: Ints
    precedence: All(t: Int) Opt(Int)
    termToString: All(t: Int) String
    nontermToString: All(n: Int) String
end

(* IntGrammar.RULE; num is the internal number assigned by CoreUtils *)
Let Rule = Tuple lhs: Int rhs: GSymbols num: Int rulenum: Int precedence: Opt(Int) end
Let Rules = lists.T(Rule)

let eqInt(a: Int b: Int): Bool = a is b
let gtInt(a: Int b: Int): Bool = a > b

let eqSymbol(a: GSymbol b: GSymbol): Bool =
    case a
        when sTerm with x then case b when sTerm with y then x.t is y.t else false end
        when sNonterm with x then case b when sNonterm with y then x.n is y.n else false end
    end

let gtSymbol(a: GSymbol b: GSymbol): Bool =
    case a
        when sTerm with x then case b when sTerm with y then x.t > y.t else false end
        when sNonterm with x then case b when sNonterm with y then x.n > y.n else true end
    end

(* structure SymbolAssoc *)
Let ItemsBySymbol(A::TYPE) = RbTree(KV(GSymbol A))
let gtSymbolKey(A::TYPE)(a: KV(GSymbol A) b: KV(GSymbol A)): Bool = gtSymbol(a.k b.k)

(* functor mkCore *)

Let Item = Tuple rule: Rule dot: Int rhsAfter: GSymbols end
Let Items = lists.T(Item)
let item(rule: Rule dot: Int rhsAfter: GSymbols): Item = tuple let rule = rule let dot = dot let rhsAfter = rhsAfter end

let eqItem(a: Item b: Item): Bool = {a.rule.num is b.rule.num} andif {a.dot is b.dot}
let gtItem(a: Item b: Item): Bool = {a.rule.num > b.rule.num} orif {{a.rule.num is b.rule.num} andif {a.dot > b.dot}}

(* Core.insert and Core.union *)
let coreInsert(i: Item l: Items): Items = losInsert(:Item)(gtItem eqItem i l)

Let Core = Tuple items: Items state: Int end
let core(items: Items state: Int): Core = tuple let items = items let state = state end
let gtCore(a: Core b: Core): Bool = losSetGt(:Item)(gtItem eqItem a.items b.items)
let eqCore(a: Core b: Core): Bool = losSetEq(:Item)(eqItem a.items b.items)

(* functor mkCoreUtils *)

Let ShiftItems = KV(GSymbol Items)
Let CoreFuncs = Tuple
    produces: All(n: Int) Rules
    shifts: All(c: Core) lists.T(ShiftItems)
    rules: Rules
    epsProds: All(c: Core) Rules
end

let mkFuncs(g: Grammar): CoreFuncs =
    begin
        let nonterms = g.nonterms
        let derives = array of(nonterms lists.nil(:Rule))
        (* sort rules by their lhs nonterminal by placing them in an array
         * indexed in their lhs nonterminal *)
        lists.app(:GRule)(
            fun(r: GRule): Ok
                begin
                    let rule = tuple
                        let lhs = r.lhs let rhs = r.rhs let num = 0 let rulenum = r.rulenum
                            let precedence = r.precedence
                    end
                    derives[r.lhs] := lists.cons(:Rule)(rule derives[r.lhs])
                end
            g.rules)
        (* renumber rules so that rule numbers increase monotonically with the
         * number of their lhs nonterminal, and so that rules are numbered
         * sequentially *)
        begin
            Let LI = Tuple l: Rules i: Int end
            let f(r: Rule li: LI): LI =
                tuple
                    let l = lists.cons(:Rule)(
                        tuple
                            let lhs = r.lhs let rhs = r.rhs let num = li.i let rulenum = r.rulenum
                            let precedence = r.precedence
                        end
                        li.l)
                    let i = li.i + 1
                end
            let rec g(i: Int num: Int): Ok =
                if i < nonterms then
                    begin
                        let ln = lists.foldr(:Rule :LI)(f tuple let l = lists.nil(:Rule) let i = num end derives[i])
                        derives[i] := lists.rev(:Rule)(ln.l)
                        g(i + 1 ln.i)
                    end
                end
            g(0 0)
        end
        (* list of rules - sorted by rule number *)
        let rules =
            begin
                let rec g(i: Int): Rules = if i < nonterms then lists.append(:Rule)(derives[i] g(i + 1))
                    else lists.nil(:Rule) end
                g(0)
            end
        (* produces: set of productions with nonterminal n as the lhs, sorted by
         * rule number *)
        let produces(n: Int): Rules = derives[n]
        let memoize(A::TYPE)(f: All(n: Int) A): All(n: Int) A =
            begin
                let rec loopF(i: Int): lists.T(A) =
                    if i is nonterms then lists.nil(:A) else begin let x = f(i) lists.cons(:A)(x loopF(i + 1)) end end
                let data = fromList(:A)(loopF(0))
                fun(i: Int): A data[i]
            end
        (* compute nonterminals which must be added to a closure when a given
         * nonterminal is added, i.e all nonterminals C for each nonterminal A
         * such that A =*=> Cx *)
        let nontermClosure: All(n: Int) Ints =
            begin
                let collectNonterms(n: Int): Ints =
                    lists.foldr(:Rule :Ints)(
                        fun(r: Rule l: Ints): Ints
                            case r.rhs
                                when cons with c then
                                    case c.hd when sNonterm with s then losInsert(:Int)(gtInt eqInt s.n l) else l end
                                else l
                            end
                        lists.nil(:Int) produces(n))
                let closureNonterm(n: Int): Ints = losClosure(:Int)(gtInt eqInt losSingleton(:Int)(n) collectNonterms)
                memoize(:Ints)(closureNonterm)
            end
        (* ntShifts: take the items produced by a nonterminal, and sort them by
         * their first symbol *)
        let sortItems(nt: Int): ItemsBySymbol(Items) =
            begin
                let addItem(a: Rule r: ItemsBySymbol(Items)): ItemsBySymbol(Items) =
                    case a.rhs
                        when cons with c then
                            begin
                                let symbol = c.hd
                                let it = item(a 1 c.tl)
                                let gt = gtSymbolKey(:Items)
                                let l =
                                    case tableFind(:GSymbol :Items)(gtSymbol symbol r)
                                        when oSome with l then lists.cons(:Item)(it l.x)
                                        else lists.cons(:Item)(it lists.nil(:Item))
                                    end
                                rbInsert(:ShiftItems)(gt kv(:GSymbol :Items)(symbol l) r)
                            end
                        else r
                    end
                lists.foldr(:Rule :ItemsBySymbol(Items))(addItem rbEmpty(:ShiftItems)() produces(nt))
            end
        let ntShifts = memoize(:ItemsBySymbol(Items))(sortItems)
        (* getNonterms: get the nonterminals with a . before them in a core, in
         * ascending order *)
        let getNonterms(l: Items): Ints =
            lists.foldr(:Item :Ints)(
                fun(i: Item r: Ints): Ints
                    case i.rhsAfter
                        when cons with c then
                            case c.hd when sNonterm with s then losInsert(:Int)(gtInt eqInt s.n r) else r end
                        else r
                    end
                lists.nil(:Int) l)
        (* closureNonterms: compute the nonterminals that would have a . before
         * them in the closure of the core, in ascending order *)
        let closureNonterms(a: Items): Ints =
            begin
                let nonterms = getNonterms(a)
                lists.foldr(:Int :Ints)(fun(nt: Int r: Ints): Ints losUnion(:Int)(gtInt eqInt nontermClosure(nt) r)
                    nonterms nonterms)
            end
        (* shifts: compute the core sets that result from shift/gotoing on the
         * closure of a kernal set *)
        let shifts(c: Core): lists.T(ShiftItems) =
            begin
                let gt = gtSymbolKey(:Items)
                (* mergeShiftItems: add an item list for a shift/goto symbol to
                 * the table *)
                let mergeShiftItems(kl: ShiftItems r: ItemsBySymbol(Items)): ItemsBySymbol(Items) =
                    case tableFind(:GSymbol :Items)(gtSymbol kl.k r)
                        when oSome with old then
                            rbInsert(:ShiftItems)(gt kv(:GSymbol :Items)(kl.k lists.append(:Item)(kl.d old.x)) r)
                        else rbInsert(:ShiftItems)(gt kl r)
                    end
                (* mergeItems: add all items derived from a nonterminal to the
                 * table *)
                let mergeItems(n: Int r: ItemsBySymbol(Items)): ItemsBySymbol(Items) =
                    rbFold(:ShiftItems :ItemsBySymbol(Items))(mergeShiftItems ntShifts(n) r)
                (* the nonterminals in a core after the closure operation *)
                let nonterms = closureNonterms(c.items)
                let newsets = lists.foldr(:Int :ItemsBySymbol(Items))(mergeItems rbEmpty(:ShiftItems)() nonterms)
                let insertItem(k: GSymbol i: Item r: ItemsBySymbol(Items)): ItemsBySymbol(Items) =
                    case tableFind(:GSymbol :Items)(gtSymbol k r)
                        when oSome with l then rbInsert(:ShiftItems)(gt kv(:GSymbol :Items)(k coreInsert(i l.x)) r)
                        else rbInsert(:ShiftItems)(gt kv(:GSymbol :Items)(k lists.cons(:Item)(i lists.nil(:Item))) r)
                    end
                let shiftCores(i: Item r: ItemsBySymbol(Items)): ItemsBySymbol(Items) =
                    case i.rhsAfter
                        when cons with s then insertItem(s.hd item(i.rule i.dot + 1 s.tl) r)
                        else r
                    end
                (* insert the kernal items of a core *)
                let newsets1 = lists.foldr(:Item :ItemsBySymbol(Items))(shiftCores newsets c.items)
                rbMakeList(:ShiftItems)(newsets1)
            end
        (* nontermEpsProds: a list of epsilon productions produced by a
         * nonterminal sorted by rule number *)
        let nontermEpsProds =
            memoize(:Rules)(
                fun(nt: Int): Rules
                    lists.foldr(:Rule :Rules)(
                        fun(rule: Rule results: Rules): Rules
                            case rule.rhs when nil then lists.cons(:Rule)(rule results) else results end
                        lists.nil(:Rule) produces(nt)))
        (* epsProds: take a core and compute a list of epsilon productions for
         * it sorted by rule number *)
        let epsProds(c: Core): Rules = flatten(:Rule)(lists.map(:Int :Rules)(nontermEpsProds closureNonterms(c.items)))
        tuple let produces = produces let shifts = shifts let rules = rules let epsProds = epsProds end
    end

(* functor mkGraph *)

Let Edge = Tuple edge: GSymbol to: Core end
Let Edges = lists.T(Edge)
Let Graph = Tuple edges: Array(Edges) nodes: lists.T(Core) nodeArray: Array(Core) end

let shiftE: Exception = exception shiftE: Ok end

let graphEdges(c: Core g: Graph): Edges = g.edges[c.state]
let graphShift(g: Graph i: Int sym: GSymbol): Int =
    begin
        let rec find(l: Edges): Int =
            case l
                when cons with c then
                    if gtSymbol(sym c.hd.edge) then find(c.tl)
                    elsif eqSymbol(c.hd.edge sym) then c.hd.to.state
                    else throw(:Int)(shiftE)
                    end
                else throw(:Int)(shiftE)
            end
        find(g.edges[i])
    end
let graphCore(g: Graph i: Int): Core = g.nodeArray[i]

Let GraphFuncs = Tuple graph: Graph produces: All(n: Int) Rules rules: Rules epsProds: All(c: Core) Rules end

let mkGraph(g: Grammar): GraphFuncs =
    begin
        let funcs = mkFuncs(g)
        Let Goto = Tuple nodes: RbTree(Core) edges: Edges future: lists.T(Core) num: Int end
        let addGoto(si: ShiftItems x: Goto): Goto =
            case rbFind(:Core)(gtCore core(si.d 0) x.nodes)
                when oSome with c then
                    begin
                        let edge = tuple let edge = si.k let to = c.x end
                        tuple let nodes = x.nodes let edges = lists.cons(:Edge)(edge x.edges) let future = x.future
                            let num = x.num end
                    end
                else
                    begin
                        let c = core(si.d x.num)
                        let edge = tuple let edge = si.k let to = c end
                        tuple
                            let nodes = rbInsert(:Core)(gtCore c x.nodes)
                            let edges = lists.cons(:Edge)(edge x.edges)
                            let future = lists.cons(:Core)(c x.future)
                            let num = x.num + 1
                        end
                    end
            end
        let rec f(nodes: RbTree(Core) nodeList: lists.T(Core) edgeList: lists.T(Edges) x: lists.T(Core) y: lists.T(Core)
                num: Int): Graph =
            case x
                when cons with c then
                    begin
                        let h = c.hd
                        let r = lists.foldr(:ShiftItems :Goto)(addGoto
                            tuple let nodes = nodes let edges = lists.nil(:Edge) let future = y let num = num end
                            funcs.shifts(h))
                        f(r.nodes lists.cons(:Core)(h nodeList) lists.cons(:Edges)(r.edges edgeList) c.tl
                            r.future r.num)
                    end
                else
                    case y
                        when nil then
                            begin
                                let nodes = lists.rev(:Core)(nodeList)
                                let edges = fromList(:Edges)(lists.rev(:Edges)(edgeList))
                                let nodeArray = fromList(:Core)(nodes)
                                tuple let edges = edges let nodes = nodes let nodeArray = nodeArray end
                            end
                        else f(nodes nodeList edgeList lists.rev(:Core)(y) lists.nil(:Core) num)
                    end
            end
        let graph =
            begin
                let makeItem(r: Rule): Item = item(r 0 r.rhs)
                let initialItemList = lists.map(:Rule :Item)(makeItem funcs.produces(g.start))
                let orderedItemList = lists.foldr(:Item :Items)(coreInsert lists.nil(:Item) initialItemList)
                let initial = core(orderedItemList 0)
                f(rbEmpty(:Core)() lists.nil(:Core) lists.nil(:Edges) lists.cons(:Core)(initial lists.nil(:Core))
                    lists.nil(:Core) 1)
            end
        tuple let graph = graph let produces = funcs.produces let rules = funcs.rules let epsProds = funcs.epsProds end
    end

(* functor mkLook; TermSet and NontermSet are ordered lists of numbers *)

let termUnion(a: Ints b: Ints): Ints = losUnion(:Int)(gtInt eqInt a b)
let termInsert(t: Int s: Ints): Ints = losInsert(:Int)(gtInt eqInt t s)
let termMakeSet(l: Ints): Ints = losMakeSet(:Int)(gtInt eqInt l)

Let LookFuncs = Tuple nullable: All(n: Int) Bool first: All(l: GSymbols) Ints end

let mkLookFuncs(rules: Rules nonterms: Int produces: All(n: Int) Rules): LookFuncs =
    begin
        (* nullable: create a function which tells if a nonterminal is nullable
         * or not *)
        let nullable: All(n: Int) Bool =
            begin
                Let Pending = Tuple lhs: Int rhs: Ints end
                let rec okRhs(l: GSymbols): Bool =
                    case l when cons with c then case c.hd when sTerm then false else okRhs(c.tl) end else true end
                let addRule(r: Rule l: lists.T(Pending)): lists.T(Pending) =
                    if okRhs(r.rhs) then
                        lists.cons(:Pending)(
                            tuple let lhs = r.lhs
                                let rhs = lists.map(:GSymbol :Int)(fun(s: GSymbol): Int s!sNonterm.n r.rhs) end
                            l)
                    else l
                    end
                let items = lists.foldr(:Rule :lists.T(Pending))(addRule lists.nil(:Pending) rules)
                let nullable = array of(nonterms false)
                Let Proof = Tuple l: lists.T(Pending) change: Bool end
                let f(a: Pending p: Proof): Proof =
                    case a.rhs
                        when cons with c then
                            if nullable[c.hd] then
                                tuple let l = lists.cons(:Pending)(tuple let lhs = a.lhs let rhs = c.tl end p.l)
                                    let change = true end
                            else tuple let l = lists.cons(:Pending)(a p.l) let change = p.change end
                            end
                        else begin nullable[a.lhs] := true tuple let l = p.l let change = true end end
                    end
                let rec prove(l: lists.T(Pending) change: Bool): Ok =
                    if change then
                        begin
                            let p = lists.foldr(:Pending :Proof)(f tuple let l = lists.nil(:Pending)
                                let change = false end l)
                            prove(p.l p.change)
                        end
                    end
                prove(items true)
                fun(i: Int): Bool nullable[i]
            end
        (* scanRhs: look at a list of symbols, scanning past nullable
         * nonterminals, applying addSymbol to the symbols scanned *)
        let scanRhs(A::TYPE)(addSymbol: All(s: GSymbol r: A) A): All(l: GSymbols r: A) A =
            begin
                let rec f(l: GSymbols result: A): A =
                    case l
                        when cons with c then
                            case c.hd
                                when sNonterm with nt then
                                    if nullable(nt.n) then f(c.tl addSymbol(c.hd result))
                                        else addSymbol(c.hd result) end
                                else addSymbol(c.hd result)
                            end
                        else result
                    end
                f
            end
        (* accumulate: look at the start of the right-hand-sides of rules,
         * looking past nullable nonterminals, applying addObj to the visible
         * symbols *)
        let accumulate(rules: Rules empty: Ints addObj: All(s: GSymbol r: Ints) Ints): Ints =
            begin
                let scan = scanRhs(:Ints)(addObj)
                lists.foldr(:Rule :Ints)(fun(r: Rule s: Ints): Ints scan(r.rhs s) empty rules)
            end
        let nontermMemo(f: All(n: Int) Ints): All(n: Int) Ints =
            begin
                let lookup = array of(nonterms lists.nil(:Int))
                for i = 0 upto nonterms - 1 do lookup[i] := f(i) end
                fun(j: Int): Ints lookup[j]
            end
        (* first1: the FIRST set of a nonterminal in the grammar *)
        let first1 =
            nontermMemo(
                fun(nt: Int): Ints
                    accumulate(produces(nt) lists.nil(:Int)
                        fun(s: GSymbol set: Ints): Ints case s when sTerm with t then termInsert(t.t set) else set end))
        (* starters1: given a nonterminal "nt", return the set of nonterminals
         * which can start its productions *)
        let starters1 =
            nontermMemo(
                fun(nt: Int): Ints
                    accumulate(produces(nt) lists.nil(:Int)
                        fun(s: GSymbol set: Ints): Ints
                            case s when sNonterm with n then losInsert(:Int)(gtInt eqInt n.n set) else set end))
        (* first: maps a nonterminal to its first-set *)
        let first =
            nontermMemo(
                fun(nt: Int): Ints
                    lists.foldr(:Int :Ints)(fun(a: Int r: Ints): Ints termUnion(r first1(a)) lists.nil(:Int)
                        losClosure(:Int)(gtInt eqInt losSingleton(:Int)(nt) starters1)))
        (* prefix: all possible terminals starting a symbol list *)
        let prefixScan =
            scanRhs(:Ints)(
                fun(s: GSymbol r: Ints): Ints
                    case s when sTerm with t then termInsert(t.t r) when sNonterm with n
                        then termUnion(first(n.n) r) end)
        let prefix(symbols: GSymbols): Ints = prefixScan(symbols lists.nil(:Int))
        tuple let nullable = nullable let first = prefix end
    end

(* functor mkLalr *)

(* an item, and the cell that holds its lookahead *)
Let TmpItem = Tuple item: Item var look: Ints end
Let TmpItems = lists.T(TmpItem)
Let TmpCore = Tuple items: TmpItems state: Int end
Let LItem = Tuple item: Item look: Ints end
Let LCore = Tuple items: lists.T(LItem) state: Int end

let eqTmpItem(a: TmpItem b: TmpItem): Bool = eqItem(a.item b.item)
let gtTmpItem(a: TmpItem b: TmpItem): Bool = gtItem(a.item b.item)

(* NTL: nonterms with lookahead *)
Let NtLook = Tuple nt: Int look: Ints end
let gtNtLook(a: NtLook b: NtLook): Bool = a.nt > b.nt
let ntLook(nt: Int look: Ints): NtLook = tuple let nt = nt let look = look end

let lalrE: Exception(Int) = exception lalrE: Int end
let findE: Exception = exception findE: Ok end

Let ClosureNonterm = Tuple nt: Int look: Ints nullable: Bool end
Let Propagation = Tuple from: TmpItem to: TmpItems end

let addLookahead(graph: Graph nullable: All(n: Int) Bool first: All(l: GSymbols) Ints eop: Ints nonterms: Int
        produces: All(n: Int) Rules rules: Rules epsProds: All(c: Core) Rules): lists.T(LCore) =
    begin
        let eop = termMakeSet(eop)
        (* look_pos: position in the rhs of a rule at which we should start
         * placing lookahead ref cells *)
        let lookPos: All(r: Rule) Int =
            begin
                let positions = array of(lists.length(:Rule)(rules) 0)
                (* rule_pos: calculate place in the rhs of a rule at which we
                 * should start placing lookahead ref cells *)
                let rulePos(r: Rule): Int =
                    begin
                        let reversed = lists.rev(:GSymbol)(r.rhs)
                        case reversed
                            when cons with c then
                                case c.hd
                                    when sTerm then lists.length(:GSymbol)(r.rhs)
                                    else
                                        begin
                                            let rec f(l: GSymbols): Int =
                                                begin
                                                    let c = l!cons
                                                    case c.tl
                                                        when cons with d then
                                                            case d.hd
                                                                when sTerm then lists.length(:GSymbol)(c.tl)
                                                                else
                                                                    if nullable(c.hd!sNonterm.n) then f(c.tl)
                                                                    else lists.length(:GSymbol)(c.tl)
                                                                    end
                                                            end
                                                        else 0
                                                    end
                                                end
                                            f(reversed)
                                        end
                                end
                            else 0
                        end
                    end
                (* the original computes pos for its debugging output *)
                let checkRule(r: Rule): Ok =
                    begin
                        let pos = rulePos(r)
                        positions[r.num] := rulePos(r)
                    end
                lists.app(:Rule)(checkRule rules)
                fun(r: Rule): Int positions[r.num]
            end
        (* rest_is_null: true for items of the form A -> x .B y, where y is
         * nullable *)
        let restIsNull(i: Item): Bool =
            case i.rhsAfter
                when cons with c then case c.hd when sNonterm then i.dot >= lookPos(i.rule) else false end
                else false
            end
        (* map core to a new core including only items of the form A -> x. or
         * A -> x. B y, where y =*=> epsilon. It also adds epsilon productions
         * to the core *)
        let tmpItem(i: Item): TmpItem = tuple let item = i let var look = lists.nil(:Int) end
        let mapCore(c: Core): TmpCore =
            begin
                let f(i: Item r: TmpItems): TmpItems =
                    case i.rhsAfter
                        when nil then lists.cons(:TmpItem)(tmpItem(i) r)
                        else if restIsNull(i) then lists.cons(:TmpItem)(tmpItem(i) r) else r end
                    end
                let epsItems = lists.map(:Rule :TmpItem)(fun(rule: Rule): TmpItem
                    tmpItem(item(rule 0 lists.nil(:GSymbol)))
                    epsProds(c))
                tuple
                    let items = losUnion(:TmpItem)(gtTmpItem eqTmpItem
                        lists.foldr(:Item :TmpItems)(f lists.nil(:TmpItem)
                        c.items) epsItems)
                    let state = c.state
                end
            end
        let newNodes = lists.map(:Core :TmpCore)(mapCore graph.nodes)
        (* findRef: state * item -> lookahead ref cell for item *)
        let findRef: All(state: Int i: Item) TmpItem =
            begin
                let states = fromList(:TmpCore)(newNodes)
                let dummy = lists.nil(:Int)
                fun(state: Int i: Item): TmpItem
                    case losFind(:TmpItem)(gtTmpItem eqTmpItem tuple let item = i
                        let var look = dummy end states[state].items)
                        when oSome with r then r.x
                        else throw(:TmpItem)(findE)
                    end
            end
        (* findRuleRefs: state -> rule -> lookahead refs for rule *)
        let findRuleRefs(state: Int rule: Rule): TmpItems =
            case rule.rhs
                when cons with c then
                    begin
                        let lp = lookPos(rule)
                        let pos = if lp > 1 then lp else 1 end
                        let rec scan1(state: Int rhs: GSymbols pos: Int result: TmpItems): TmpItems =
                            case rhs
                                when cons with r then
                                    begin
                                        let next = graphShift(graph state r.hd)
                                        scan1(next r.tl pos + 1
                                            lists.cons(:TmpItem)(findRef(state item(rule pos rhs)) result))
                                    end
                                else lists.cons(:TmpItem)(findRef(state item(rule pos lists.nil(:GSymbol))) result)
                            end
                        (* find first item of the form A -> x .B y, where y =*=>
                         * epsilon and x is not epsilon, or A -> x. use scan' to
                         * pick up all refs after this point *)
                        let rec scan(state: Int rhs: GSymbols place: Int): TmpItems =
                            case rhs
                                when nil then
                                    lists.cons(:TmpItem)(findRef(state item(rule pos lists.nil(:GSymbol)))
                                        lists.nil(:TmpItem))
                                when cons with r then
                                    if place is 0 then scan1(state rhs pos lists.nil(:TmpItem))
                                    else scan(graphShift(graph state r.hd) r.tl place - 1)
                                    end
                            end
                        scan(graphShift(graph state c.hd) c.tl pos - 1)
                    end
                else lists.cons(:TmpItem)(findRef(state item(rule 0 lists.nil(:GSymbol))) lists.nil(:TmpItem))
            end
        (* nonterms_w_null: for some nonterminal n the set of nonterminals A
         * added through the closure of nonterminal n such that n =c*=> .A x,
         * where x is nullable *)
        let nontermsWNull1(nt: Int): Ints =
            begin
                let collectNonterms(n: Int): Ints =
                    lists.foldr(:Rule :Ints)(
                        fun(rule: Rule r: Ints): Ints
                            case rule.rhs
                                when cons with c then
                                    case c.hd
                                        when sNonterm with n then
                                            if restIsNull(item(rule 0 rule.rhs)) then lists.cons(:Int)(n.n r) else r end
                                        else r
                                    end
                                else r
                            end
                        lists.nil(:Int) produces(n))
                let rec dfs(n: Int r: Ints): Ints =
                    if losExists(:Int)(gtInt eqInt n r) then r
                    else lists.foldr(:Int :Ints)(dfs losInsert(:Int)(gtInt eqInt n r) collectNonterms(n))
                    end
                dfs(nt lists.nil(:Int))
            end
        let nontermsWNull: All(nt: Int) Ints =
            begin
                let data = array of(nonterms lists.nil(:Int))
                for n = 0 upto nonterms - 1 do data[n] := nontermsWNull1(n) end
                fun(nt: Int): Ints data[nt]
            end
        (* look_info: for some nonterminal n the set of nonterms A added through
         * the closure of the nonterminal such that n =c+=> .Ax and the
         * lookahead accumlated for each nonterm A *)
        let ntlFind(a: NtLook r: RbTree(NtLook)): Opt(NtLook) = rbFind(:NtLook)(gtNtLook a r)
        let ntlInsert(a: NtLook r: RbTree(NtLook)): RbTree(NtLook) = rbInsert(:NtLook)(gtNtLook a r)
        let lookInfo(nt: Int): RbTree(NtLook) =
            begin
                let collectNonterms(n: Int): RbTree(NtLook) =
                    lists.foldr(:Rule :RbTree(NtLook))(
                        fun(rule: Rule r: RbTree(NtLook)): RbTree(NtLook)
                            case rule.rhs
                                when cons with c then
                                    case c.hd
                                        when sNonterm with n then
                                            case ntlFind(ntLook(n.n lists.nil(:Int)) r)
                                                when oSome with kd
                                                    then ntlInsert(ntLook(n.n termUnion(kd.x.look first(c.tl))) r)
                                                else ntlInsert(ntLook(n.n first(c.tl)) r)
                                            end
                                        else r
                                    end
                                else r
                            end
                        rbEmpty(:NtLook)() produces(n))
                let rec dfs(a: NtLook r: RbTree(NtLook)): RbTree(NtLook) =
                    case ntlFind(a r)
                        when oSome with d then ntlInsert(ntLook(a.nt termUnion(a.look d.x.look)) r)
                        else rbFold(:NtLook :RbTree(NtLook))(dfs collectNonterms(a.nt) ntlInsert(a r))
                    end
                dfs(ntLook(nt lists.nil(:Int)) rbEmpty(:NtLook)())
            end
        (* prop_look: propagate lookaheads for nonterms added in the closure of
         * a nonterm *)
        let propLook(ntl: RbTree(NtLook)): RbTree(NtLook) =
            begin
                let updLookhd(newLook: Ints): All(nt: Int r: RbTree(NtLook)) RbTree(NtLook) =
                    fun(nt: Int r: RbTree(NtLook)): RbTree(NtLook)
                        case ntlFind(ntLook(nt newLook) r)
                            when oSome with old then ntlInsert(ntLook(nt termUnion(newLook old.x.look)) r)
                            else raise lalrE with 241 end
                        end
                let updNonterm(a: NtLook r: RbTree(NtLook)): RbTree(NtLook) =
                    lists.foldr(:Int :RbTree(NtLook))(updLookhd(a.look) r nontermsWNull(a.nt))
                rbFold(:NtLook :RbTree(NtLook))(updNonterm ntl ntl)
            end
        (* closure_nonterms: for a nonterminal n, triples of a nonterm added
         * through closure, the lookahead for it, and whether it should include
         * the lookahead for the nonterminal whose closure is being taken *)
        let closureNonterms: All(n: Int) lists.T(ClosureNonterm) =
            begin
                let data = array of(nonterms lists.nil(:ClosureNonterm))
                let doNonterm(i: Int): lists.T(ClosureNonterm) =
                    begin
                        let nontermsFollowedByNull = nontermsWNull(i)
                        let nontermsAddedThroughClosure = rbMakeList(:NtLook)(propLook(lookInfo(i)))
                        lists.map(:NtLook :ClosureNonterm)(
                            fun(n: NtLook): ClosureNonterm
                                tuple
                                    let nt = n.nt let look = n.look
                                    let nullable = losExists(:Int)(gtInt eqInt n.nt nontermsFollowedByNull)
                                end
                            nontermsAddedThroughClosure)
                    end
                for i = 0 upto nonterms - 1 do data[i] := doNonterm(i) end
                fun(i: Int): lists.T(ClosureNonterm) data[i]
            end
        let addTo(look: Ints): All(r: TmpItem) Ok = fun(r: TmpItem): Ok r.look := termUnion(r.look look)
        (* add_nonterm_lookahead: Add lookahead to all completion items for
         * rules added when the closure of a given nonterm in some state is
         * taken. It returns a list of lookahead refs to which the given
         * nonterm's lookahead should be propagated *)
        let addNontermLookahead(nt: Int state: Int): TmpItems =
            begin
                let f(c: ClosureNonterm r: TmpItems): TmpItems =
                    begin
                        let refs = flatten(:TmpItem)(lists.map(:Rule :TmpItems)(
                            fun(rule: Rule): TmpItems findRuleRefs(state rule) produces(c.nt)))
                        lists.app(:TmpItem)(addTo(c.look) refs)
                        if c.nullable then lists.append(:TmpItem)(refs r) else r end
                    end
                lists.foldr(:ClosureNonterm :TmpItems)(f lists.nil(:TmpItem) closureNonterms(nt))
            end
        (* scan_core: Scan a core for all items of the form A -> x .B y.
         * Applies add_nonterm_lookahead to each such B, and then merges
         * first(y) into the list of refs returned by add_nonterm_lookahead.
         * It returns a list of ref * ref list for all the items where y =*=>
         * epsilon *)
        let scanCore(c: Core): lists.T(Propagation) =
            begin
                let state = c.state
                let rec f(l: Items r: lists.T(Propagation)): lists.T(Propagation) =
                    case l
                        when cons with x then
                            begin
                                let i = x.hd
                                case i.rhsAfter
                                    when cons with a then
                                        case a.hd
                                            when sNonterm with b then
                                                begin
                                                    let l = addNontermLookahead(b.n state)
                                                    case l
                                                        when nil then r
                                                        else
                                                            begin
                                                                let firstY = first(a.tl)
                                                                let newr =
                                                                    if i.dot >= lookPos(i.rule) then
                                                                        lists.cons(:Propagation)(
                                                                            tuple let from = findRef(state i)
                                                                                let to = l end r)
                                                                    else r
                                                                    end
                                                                lists.app(:TmpItem)(addTo(firstY) l)
                                                                f(x.tl newr)
                                                            end
                                                    end
                                                end
                                            else f(x.tl r)
                                        end
                                    else f(x.tl r)
                                end
                            end
                        else r
                    end
                f(c.items lists.nil(:Propagation))
            end
        (* add end-of-parse symbols to set of items consisting of all items
         * immediately derived from the start symbol *)
        let addEop(c: Core eop: Ints): Ok =
            begin
                let f(i: Item): Ok =
                    begin
                        let refs = findRuleRefs(c.state i.rule)
                        (* first take care of kernal items *)
                        lists.app(:TmpItem)(addTo(eop) refs)
                        (* now take care of closure items *)
                        if i.dot >= lookPos(i.rule) then
                            case i.rhsAfter
                                when cons with a then
                                    case a.hd
                                        when sNonterm with b then
                                            begin
                                                let l = addNontermLookahead(b.n c.state)
                                                case l when nil then ok else lists.app(:TmpItem)(addTo(eop) l) end
                                            end
                                        else ok
                                    end
                                else ok
                            end
                        end
                    end
                lists.app(:Item)(f c.items)
            end
        let iterate(l: lists.T(Propagation)): Ok =
            begin
                let rec f(lookahead: Ints l: TmpItems done: Bool): Bool =
                    case l
                        when cons with c then
                            begin
                                let h = c.hd
                                let old = h.look
                                h.look := termUnion(old lookahead)
                                if lists.length(:Int)(h.look) isnot lists.length(:Int)(old) then f(lookahead c.tl false)
                                else f(lookahead c.tl done)
                                end
                            end
                        else done
                    end
                let rec g(l: lists.T(Propagation) done: Bool): Bool =
                    case l
                        when cons with c then begin let newDone = f(c.hd.from.look c.hd.to done) g(c.tl newDone) end
                        else done
                    end
                let rec loopF(done: Bool): Ok = if not(done) then loopF(g(l true)) end
                loopF(false)
            end
        let lookahead = flatten(:Propagation)(lists.map(:Core :lists.T(Propagation))(scanCore graph.nodes))
        (* used to scan the item list of a TMPCORE and remove the items not
         * being reduced *)
        let createLcoreList(t: TmpItem r: lists.T(LItem)): lists.T(LItem) =
            case t.item.rhsAfter
                when nil then lists.cons(:LItem)(tuple let item = t.item let look = t.look end r)
                else r
            end
        addEop(graphCore(graph 0) eop)
        iterate(lookahead)
        lists.map(:TmpCore :LCore)(
            fun(c: TmpCore): LCore
                tuple let items = lists.foldr(:TmpItem :lists.T(LItem))(createLcoreList lists.nil(:LItem) c.items)
                    let state = c.state
                end
            newNodes)
    end

(* functor mkMakeLrTable *)

(* structure Errs: errors found while constructing an LR table *)
Let Err = Option
    eRR with term: Int state: Int a: Int b: Int end
    eSR with term: Int state: Int rule: Int end
    eNotReduced with rule: Int end
    eNS with term: Int rule: Int end
    eStart with rule: Int end
end
Let Errs = lists.T(Err)

Let Summary = Tuple rr: Int sr: Int start: Int notReduced: Int nonshift: Int end

let summary(l: Errs): Summary =
    begin
        let var numRR = 0
        let var numSR = 0
        let var numSTART = 0
        let var numNOTREDUCED = 0
        let var numNS = 0
        let var r = l
        while not(lists.null(:Err)(r)) do
            case lists.hd(:Err)(r)
                when eRR then numRR := numRR + 1
                when eSR then numSR := numSR + 1
                when eStart then numSTART := numSTART + 1
                when eNotReduced then numNOTREDUCED := numNOTREDUCED + 1
                when eNS then numNS := numNS + 1
            end
            r := lists.tl(:Err)(r)
        end
        tuple let rr = numRR let sr = numSR let start = numSTART let notReduced = numNOTREDUCED let nonshift = numNS end
    end

Let TermAction = Tuple t: Int a: Action end
Let TermActionList = lists.T(TermAction)
Let NtState = Tuple nt: Int state: Int end
Let NtStates = lists.T(NtState)
Let StateActions = Tuple actions: TermActionList default: Action end
Let ReducesErrs = Tuple reduces: TermActionList errs: Errs end
Let StateResult = Tuple actions: StateActions gotos: NtStates errs: Errs end

let termAction(t: Int a: Action): TermAction = tuple let t = t let a = a end
let stateActions(actions: TermActionList default: Action): StateActions =
    tuple let actions = actions let default = default end
let reducesErrs(reduces: TermActionList errs: Errs): ReducesErrs = tuple let reduces = reduces let errs = errs end

let mergeReduces(state: Int): All(item: LItem re: ReducesErrs) ReducesErrs =
    begin
        let rec f(j: TermActionList k: TermActionList result: TermActionList errs: Errs): ReducesErrs =
            case j
                when cons with x then
                    case k
                        when cons with y then
                            begin
                                let t1 = x.hd.t
                                let t2 = y.hd.t
                                if t1 < t2 then f(x.tl k lists.cons(:TermAction)(x.hd result) errs)
                                elsif t1 > t2 then f(j y.tl lists.cons(:TermAction)(y.hd result) errs)
                                else
                                    begin
                                        let num1 = x.hd.a!aReduce.r
                                        let num2 = y.hd.a!aReduce.r
                                        let errs1 = lists.cons(:Err)(option eRR of Err with t1 state num1 num2 end errs)
                                        let action = if num1 < num2 then x.hd else y.hd end
                                        f(x.tl y.tl lists.cons(:TermAction)(action result) errs1)
                                    end
                                end
                            end
                        else f(x.tl k lists.cons(:TermAction)(x.hd result) errs)
                    end
                else
                    case k
                        when cons with y then f(j y.tl lists.cons(:TermAction)(y.hd result) errs)
                        else reducesErrs(lists.rev(:TermAction)(result) errs)
                    end
            end
        fun(i: LItem re: ReducesErrs): ReducesErrs
            begin
                let action = reduceAction(i.item.rule.rulenum)
                let actions = lists.map(:Int :TermAction)(fun(a: Int): TermAction termAction(a action) i.look)
                case re.reduces
                    when nil then reducesErrs(actions re.errs)
                    else f(re.reduces actions lists.nil(:TermAction) re.errs)
                end
            end
    end

let computeActions(rules: Rules precedence: All(t: Int) Opt(Int) graph: Graph defaultReductions: Bool)
        : All(lc: LCore c: Core) StateResult =
    begin
        let rulePrec: All(i: Int) Opt(Int) =
            begin
                let precData = array of(lists.length(:Rule)(rules) none(:Int)())
                lists.app(:Rule)(fun(r: Rule): Ok precData[r.rulenum] := r.precedence rules)
                fun(i: Int): Opt(Int) precData[i]
            end
        let mergeShifts(state: Int shifts: TermActionList reduces: TermActionList): ReducesErrs =
            begin
                let rec f(shifts: TermActionList reduces: TermActionList result: TermActionList
                    errs: Errs): ReducesErrs =
                    case shifts
                        when cons with x then
                            case reduces
                                when cons with y then
                                    begin
                                        let t1 = x.hd.t
                                        let t2 = y.hd.t
                                        if t1 < t2 then f(x.tl reduces lists.cons(:TermAction)(x.hd result) errs)
                                        elsif t1 > t2 then f(shifts y.tl lists.cons(:TermAction)(y.hd result) errs)
                                        else
                                            begin
                                                let rulenum = y.hd.a!aReduce.r
                                                let term1 = x.hd.t
                                                let conflict(): ReducesErrs =
                                                    f(x.tl y.tl lists.cons(:TermAction)(x.hd result)
                                                        lists.cons(:Err)(option eSR of Err with term1 state
                                                            rulenum end errs))
                                                case precedence(term1)
                                                    when oSome with i then
                                                        case rulePrec(rulenum)
                                                            when oSome with j then
                                                                if i.x > j.x then
                                                                    f(x.tl y.tl
                                                                        lists.cons(:TermAction)(x.hd result) errs)
                                                                elsif j.x > i.x then
                                                                    f(x.tl y.tl
                                                                        lists.cons(:TermAction)(y.hd result) errs)
                                                                else
                                                                    f(x.tl y.tl
                                                                        lists.cons(:TermAction)(termAction(t1
                                                                            errorAction)
                                                                            result) errs)
                                                                end
                                                            else conflict()
                                                        end
                                                    else conflict()
                                                end
                                            end
                                        end
                                    end
                                else f(x.tl reduces lists.cons(:TermAction)(x.hd result) errs)
                            end
                        else
                            case reduces
                                when cons with y then f(shifts y.tl lists.cons(:TermAction)(y.hd result) errs)
                                else reducesErrs(lists.rev(:TermAction)(result) errs)
                            end
                    end
                case reduces
                    when nil then reducesErrs(shifts lists.nil(:Err))
                    else
                        case shifts
                            when nil then reducesErrs(reduces lists.nil(:Err))
                            else f(shifts reduces lists.nil(:TermAction) lists.nil(:Err))
                        end
                end
            end
        Let ShiftsGotos = Tuple shifts: TermActionList gotos: NtStates end
        let rec mapCore(l: Edges shifts: TermActionList gotos: NtStates): ShiftsGotos =
            case l
                when cons with c then
                    case c.hd.edge
                        when sTerm with t then
                            mapCore(c.tl
                                lists.cons(:TermAction)(termAction(t.t shiftAction(c.hd.to.state)) shifts) gotos)
                        when sNonterm with nt then
                            mapCore(c.tl shifts
                                lists.cons(:NtState)(tuple let nt = nt.n let state = c.hd.to.state end gotos))
                    end
                else tuple let shifts = lists.rev(:TermAction)(shifts) let gotos = lists.rev(:NtState)(gotos) end
            end
        let rec pruneError(l: TermActionList): TermActionList =
            case l
                when cons with c then
                    case c.hd.a when aError then pruneError(c.tl)
                        else lists.cons(:TermAction)(c.hd pruneError(c.tl)) end
                else l
            end
        fun(lc: LCore c: Core): StateResult
            begin
                let sg = mapCore(graphEdges(c graph) lists.nil(:TermAction) lists.nil(:NtState))
                let tableState = lc.state
                let stateResult(actions: StateActions errs: Errs): StateResult =
                    tuple let actions = actions let gotos = sg.gotos let errs = errs end
                case lc.items
                    when cons with r then
                        case r.tl
                            when nil then
                                begin
                                    let h = r.hd
                                    let rulenum = h.item.rule.rulenum
                                    let reduces = mergeReduces(tableState)(h reducesErrs(lists.nil(:TermAction)
                                        lists.nil(:Err))).reduces
                                    let ae = mergeShifts(tableState sg.shifts reduces)
                                    let actions1 = pruneError(ae.reduces)
                                    let rec hasReduce(l: TermActionList actions: TermActionList): StateActions =
                                        case l
                                            when cons with c then
                                                case c.hd.a
                                                    when aShift
                                                        then hasReduce(c.tl lists.cons(:TermAction)(c.hd actions))
                                                    else hasReduce(c.tl actions)
                                                end
                                            else stateActions(lists.rev(:TermAction)(actions) reduceAction(rulenum))
                                        end
                                    let rec loopF(l: TermActionList actions: TermActionList): StateActions =
                                        case l
                                            when cons with c then
                                                case c.hd.a
                                                    when aShift then loopF(c.tl lists.cons(:TermAction)(c.hd actions))
                                                    when aReduce then hasReduce(c.tl actions)
                                                    else loopF(c.tl actions)
                                                end
                                            else stateActions(lists.rev(:TermAction)(actions) errorAction)
                                        end
                                    let sa =
                                        if defaultReductions
                                            andif {lists.length(:TermAction)(ae.reduces) is
                                                lists.length(:TermAction)(actions1)}
                                        then loopF(ae.reduces lists.nil(:TermAction))
                                        else stateActions(actions1 errorAction)
                                        end
                                    stateResult(sa ae.errs)
                                end
                            else
                                begin
                                    let re = lists.foldr(:LItem :ReducesErrs)(mergeReduces(tableState)
                                        reducesErrs(lists.nil(:TermAction) lists.nil(:Err)) lc.items)
                                    let ae = mergeShifts(tableState sg.shifts re.reduces)
                                    stateResult(stateActions(pruneError(ae.reduces) errorAction)
                                        lists.append(:Err)(re.errs ae.errs))
                                end
                        end
                    else stateResult(stateActions(sg.shifts errorAction) lists.nil(:Err))
                end
            end
    end

Let MadeTable = Tuple table: LrTable errs: Errs end

let mkTable(grammar: Grammar defaultReductions: Bool): MadeTable =
    begin
        let start = grammar.start
        let gf = mkGraph(grammar)
        let rules = gf.rules
        let graph = gf.graph
        let lf = mkLookFuncs(rules grammar.nonterms gf.produces)
        let lcores = addLookahead(graph lf.nullable lf.first grammar.eop grammar.nonterms gf.produces rules gf.epsProds)
        let zipE: Exception = exception mkTable: Ok end
        Let LCoreCore = Tuple lc: LCore c: Core end
        let rec zip(a: lists.T(LCore) b: lists.T(Core)): lists.T(LCoreCore) =
            case a
                when cons with x then
                    case b
                        when cons with y then
                            lists.cons(:LCoreCore)(tuple let lc = x.hd let c = y.hd end zip(x.tl y.tl))
                        else throw(:lists.T(LCoreCore))(zipE)
                    end
                else case b when nil then lists.nil(:LCoreCore) else throw(:lists.T(LCoreCore))(zipE) end
            end
        Let Unzipped = Tuple actions: lists.T(StateActions) gotos: lists.T(NtStates) errs: lists.T(Errs) end
        let unzip(l: lists.T(StateResult)): Unzipped =
            begin
                let rec f(l: lists.T(StateResult) j: lists.T(StateActions) k: lists.T(NtStates) m: lists.T(Errs))
                        : Unzipped =
                    case l
                        when cons with c then
                            f(c.tl lists.cons(:StateActions)(c.hd.actions j) lists.cons(:NtStates)(c.hd.gotos k)
                                lists.cons(:Errs)(c.hd.errs m))
                        else
                            tuple
                                let actions = lists.rev(:StateActions)(j) let gotos = lists.rev(:NtStates)(k)
                                let errs = lists.rev(:Errs)(m)
                            end
                    end
                f(l lists.nil(:StateActions) lists.nil(:NtStates) lists.nil(:Errs))
            end
        let u0 =
            begin
                let doState = computeActions(rules grammar.precedence graph defaultReductions)
                unzip(lists.map(:LCoreCore :StateResult)(fun(x: LCoreCore): StateResult doState(x.lc x.c)
                    zip(lcores graph.nodes)))
            end
        (* add goto from state 0 to a new state. The new state has accept
         * actions for all of the end-of-parse symbols *)
        let u =
            case u0.gotos
                when cons with g then
                    begin
                        let newStateActions =
                            stateActions(
                                lists.map(:Int :TermAction)(fun(t: Int): TermAction termAction(t acceptAction)
                                    termMakeSet(grammar.eop))
                                errorAction)
                        let state0Goto = losInsert(:NtState)(
                            fun(a: NtState b: NtState): Bool a.nt > b.nt fun(a: NtState b: NtState): Bool a.nt is b.nt
                            tuple let nt = start let state = lists.length(:StateActions)(u0.actions) end g.hd)
                        tuple
                            let actions =
                                lists.append(:StateActions)(u0.actions
                                    lists.cons(:StateActions)(newStateActions lists.nil(:StateActions)))
                            let gotos = lists.cons(:NtStates)(state0Goto
                                lists.append(:NtStates)(g.tl
                                    lists.cons(:NtStates)(lists.nil(:NtState) lists.nil(:NtStates))))
                            let errs = lists.append(:Errs)(u0.errs lists.cons(:Errs)(lists.nil(:Err) lists.nil(:Errs)))
                        end
                    end
                else u0
            end
        let startErrs =
            lists.foldr(:Rule :Errs)(
                fun(r: Rule l: Errs): Errs
                    if lists.exists(:GSymbol)(fun(s: GSymbol): Bool case s when sNonterm with a then a.n is start
                        else false end
                        r.rhs)
                    then lists.cons(:Err)(option eStart of Err with r.rulenum end l)
                    else l
                    end
                lists.nil(:Err) rules)
        let nonshiftErrs =
            lists.foldr(:Rule :Errs)(
                fun(r: Rule l: Errs): Errs
                    lists.foldr(:Int :Errs)(
                        fun(nonshift: Int l: Errs): Errs
                            if lists.exists(:GSymbol)(
                                fun(s: GSymbol): Bool case s when sTerm with a then a.t is nonshift
                                    else false end r.rhs)
                            then lists.cons(:Err)(option eNS of Err with nonshift r.rulenum end l)
                            else l
                            end
                        l grammar.noshift)
                lists.nil(:Err) rules)
        let notReduced =
            begin
                let ruleReduced = array of(lists.length(:Rule)(rules) false)
                let test(a: Action): Ok = case a when aReduce with r then ruleReduced[r.r] := true else ok end
                lists.app(:StateActions)(
                    fun(sa: StateActions): Ok
                        begin lists.app(:TermAction)(fun(t: TermAction): Ok test(t.a) sa.actions) test(sa.default) end
                    u.actions)
                let rec scan(i: Int r: Errs): Errs =
                    if i >= 0 then
                        scan(i - 1 if ruleReduced[i] then r
                            else lists.cons(:Err)(option eNotReduced of Err with i end r) end)
                    else r
                    end
                scan(extent ruleReduced - 1 lists.nil(:Err))
            end
        let allErrs = lists.append(:Err)(startErrs lists.append(:Err)(notReduced lists.append(:Err)(nonshiftErrs
            flatten(:Err)(u.errs))))
        let rec toPairlist(A::TYPE B::TYPE)(l: lists.T(KV(A B))): Pairlist(A B) =
            case l
                when cons with c then option pair of Pairlist(A B) with c.hd.k c.hd.d toPairlist(:A :B)(c.tl) end
                else option empty of Pairlist(A B) end
            end
        let actionEntry(sa: StateActions): ActionEntry =
            tuple
                let row = toPairlist(:Int :Action)(lists.map(:TermAction :KV(Int Action))(
                    fun(t: TermAction): KV(Int Action) kv(:Int :Action)(t.t t.a) sa.actions))
                let default = sa.default
            end
        let gotoRow(l: NtStates): Gotos =
            toPairlist(:Int :Int)(lists.map(:NtState :KV(Int Int))(fun(g: NtState): KV(Int Int)
                kv(:Int :Int)(g.nt g.state)
                l))
        let numStates = lists.length(:StateActions)(u.actions)
        let table = mkLrTable(fromList(:ActionEntry)(lists.map(:StateActions :ActionEntry)(actionEntry u.actions))
            fromList(:Gotos)(lists.map(:NtStates :Gotos)(gotoRow u.gotos)) 0 numStates lists.length(:Rule)(rules))
        tuple let table = table let errs = allErrs end
    end

(* functors EquivFun and MergeSortFun; ShrinkLrTableFun *)

let gtAction(a: Action b: Action): Bool =
    case a
        when aShift with s then case b when aShift with t then s.s > t.s else true end
        when aReduce with i then case b when aShift then false when aReduce with j then i.r > j.r else true end
        when aAccept then case b when aError then true else false end
        else false
    end

let eqAction(a: Action b: Action): Bool =
    case a
        when aShift with s then case b when aShift with t then s.s is t.s else false end
        when aReduce with i then case b when aReduce with j then i.r is j.r else false end
        when aAccept then case b when aAccept then true else false end
        else case b when aError then true else false end
    end

let rec eqTermActions(a: TermActions b: TermActions): Bool =
    case a
        when pair with x then
            case b
                when pair with y then {x.a is y.a} andif eqAction(x.b y.b) andif eqTermActions(x.r y.r)
                else false
            end
        else case b when empty then true else false end
    end

let rec gtTermActions(a: TermActions b: TermActions): Bool =
    case a
        when pair with x then
            case b
                when pair with y then
                    {x.a > y.a}
                        orif {{x.a is y.a}
                            andif {gtAction(x.b y.b) orif {eqAction(x.b y.b) andif gtTermActions(x.r y.r)}}}
                else true
            end
        else false
    end

let eqEntry(a: ActionEntry b: ActionEntry): Bool = eqAction(a.default b.default) andif eqTermActions(a.row b.row)
let gtEntry(a: ActionEntry b: ActionEntry): Bool =
    gtAction(a.default b.default) orif {eqAction(a.default b.default) andif gtTermActions(a.row b.row)}

(* sort: an O(n lg n) merge sort *)
let mergeSort(A::TYPE)(gt: Gt(A) l: lists.T(A)): lists.T(A) =
    case l
        when nil then l
        else
            begin
                let rec merge(l: lists.T(A) r: lists.T(A)): lists.T(A) =
                    case l
                        when cons with a then
                            case r
                                when cons with b then
                                    if gt(a.hd b.hd) then lists.cons(:A)(b.hd merge(l b.tl))
                                    else lists.cons(:A)(a.hd merge(a.tl r))
                                    end
                                else l
                            end
                        else r
                    end
                let rec scan(l: lists.T(lists.T(A))): lists.T(lists.T(A)) =
                    case l
                        when cons with a then
                            case a.tl
                                when cons with b then lists.cons(:lists.T(A))(merge(a.hd b.hd) scan(b.tl))
                                else l
                            end
                        else l
                    end
                let rec loopF(l: lists.T(lists.T(A))): lists.T(A) =
                    begin let c = l!cons case c.tl when nil then c.hd else loopF(scan(l)) end end
                loopF(lists.map(:A :lists.T(A))(fun(a: A): lists.T(A) lists.cons(:A)(a lists.nil(:A)) l))
            end
    end

Let Indexed = Tuple e: ActionEntry i: Int end
Let Equivalences = Tuple count: Int classes: Ints reps: lists.T(ActionEntry) end

(* equivalences: take a list of entries and divides them into equivalence
 * classes numbered 0 to n-1 *)
let equivalences(l: lists.T(ActionEntry)): Equivalences =
    begin
        let assignIndex(l: lists.T(ActionEntry)): lists.T(Indexed) =
            begin
                let rec loopF(index: Int l: lists.T(ActionEntry)): lists.T(Indexed) =
                    case l
                        when cons with c
                            then lists.cons(:Indexed)(tuple let e = c.hd let i = index end loopF(index + 1 c.tl))
                        else lists.nil(:Indexed)
                    end
                loopF(0 l)
            end
        Let RSE = Tuple r: lists.T(ActionEntry) se: Ints end
        let createEquivalences(l: lists.T(Indexed)): RSE =
            begin
                let rec loopF(l: lists.T(Indexed) prev: ActionEntry class: Int r: lists.T(ActionEntry) se: Ints): RSE =
                    case l
                        when cons with c then
                            begin
                                let e = c.hd.e
                                if eqEntry(e prev) then loopF(c.tl e class r lists.cons(:Int)(class se))
                                else loopF(c.tl e class + 1 lists.cons(:ActionEntry)(e r)
                                    lists.cons(:Int)(class + 1 se))
                                end
                            end
                        else tuple let r = lists.rev(:ActionEntry)(r) let se = lists.rev(:Int)(se) end
                    end
                case l
                    when cons with c then
                        loopF(c.tl c.hd.e 0 lists.cons(:ActionEntry)(c.hd.e lists.nil(:ActionEntry))
                            lists.cons(:Int)(0 lists.nil(:Int)))
                    else tuple let r = lists.nil(:ActionEntry) let se = lists.nil(:Int) end
                end
            end
        let inversePermute(permutation: Ints l: Ints): Ints =
            case l
                when cons with c then
                    begin
                        let result = array of(lists.length(:Int)(l) c.hd)
                        let rec loopF(l: Ints p: Ints): Ok =
                            case l
                                when cons with x then
                                    case p when cons with y
                                        then begin result[y.hd] := x.hd loopF(x.tl y.tl) end else ok end
                                else ok
                            end
                        let rec listofarray(i: Int): Ints =
                            if i < extent result then lists.cons(:Int)(result[i] listofarray(i + 1))
                                else lists.nil(:Int) end
                        loopF(l permutation)
                        listofarray(0)
                    end
                else l
            end
        let ep = assignIndex(l)
        let sorted = mergeSort(:Indexed)(fun(a: Indexed b: Indexed): Bool gtEntry(a.e b.e) ep)
        let p = lists.map(:Indexed :Int)(fun(x: Indexed): Int x.i sorted)
        let rse = createEquivalences(sorted)
        tuple let count = lists.length(:ActionEntry)(rse.r) let classes = inversePermute(p rse.se) let reps = rse.r end
    end

(* shrinkActionList: the unique action rows *)
let shrinkActionList(table: LrTable): Equivalences =
    begin
        let rec states(i: Int): Ints = if i < table.states then lists.cons(:Int)(i states(i + 1))
            else lists.nil(:Int) end
        equivalences(lists.map(:Int :ActionEntry)(fun(s: Int): ActionEntry table.action[s] states(0)))
    end

(* functor mkPrintStruct *)

(* the code that decodes the printed tables *)
let tableCode =
    "\n" <>
    "val s = ref \"\" and index = ref 0\n" <>
    "val string_to_int = fn () => \n" <>
    "let val i = !index\n" <>
    "in index := i+2; Char.ord(String.sub(!s,i)) + Char.ord(String.sub(!s,i+1)) * 256\n" <>
    "end\n" <>
    "val string_to_list = fn s' =>\n" <>
    "    let val len = String.size s'\n" <>
    "        fun f () =\n" <>
    "           if !index < len then string_to_int() :: f()\n" <>
    "           else nil\n" <>
    "   in index := 0; s := s'; f ()\n" <>
    "   end\n" <>
    "val string_to_pairlist = fn (conv_key,conv_entry) =>\n" <>
    "     let fun f () =\n" <>
    "         case string_to_int()\n" <>
    "         of 0 => EMPTY\n" <>
    "          | n => PAIR(conv_key (n-1),conv_entry (string_to_int()),f())\n" <>
    "     in f\n" <>
    "     end\n" <>
    "val string_to_pairlist_default = fn (conv_key,conv_entry) =>\n" <>
    "    let val conv_row = string_to_pairlist(conv_key,conv_entry)\n" <>
    "    in fn () =>\n" <>
    "       let val default = conv_entry(string_to_int())\n" <>
    "           val row = conv_row()\n" <>
    "       in (row,default)\n" <>
    "       end\n" <>
    "   end\n" <>
    "val string_to_table = fn (convert_row,s') =>\n" <>
    "    let val len = String.size s'\n" <>
    "        fun f ()=\n" <>
    "           if !index < len then convert_row() :: f()\n" <>
    "           else nil\n" <>
    "     in (s := s'; index := 0; f ())\n" <>
    "     end\n" <>
    "local\n" <>
    "  val memo = Array.array(numstates+numrules,ERROR)\n" <>
    "  val _ =let fun g i=(Array.update(memo,i,REDUCE(i-numstates)); g(i+1))\n" <>
    "       fun f i =\n" <>
    "            if i=numstates then g i\n" <>
    "            else (Array.update(memo,i,SHIFT (STATE i)); f (i+1))\n" <>
    "          in f 0 handle Subscript => ()\n" <>
    "          end\n" <>
    "in\n" <>
    "val entry_to_action = fn 0 => ACCEPT | 1 => ERROR | j => Array.sub(memo,(j-2))\n" <>
    "end\n" <>
    "val gotoT=Array.fromList(string_to_table(string_to_pairlist(NT,STATE),gotoT))\n" <>
    "val actionRows=string_to_table(string_to_pairlist_default(T,entry_to_action),actionRows)\n" <>
    "val actionRowNumbers = string_to_list actionRowNumbers\n" <>
    "val actionT = let val actionRowLookUp=\n" <>
    "let val a=Array.fromList(actionRows) in fn i=>Array.sub(a,i) end\n" <>
    "in Array.fromList(map actionRowLookUp actionRowNumbers)\n" <>
    "end\n" <>
    "in LrTable.mkLrTable {actions=actionT,gotos=gotoT,numRules=numrules,\n" <>
    "numStates=numstates,initialState=STATE "

(* lineLength = approximately the largest number of characters to allow on a
 * line when printing out an encode string; maxLength = length of a table
 * entry *)
let numEntries = 72 / 16

(* convert integer between 0 and 255 to the three character ascii decimal
 * escape sequence for it *)
let chr: All(i: Int) String =
    begin
        let lookup = array of(256 "\\000")
        let intToString(i: Int): String =
            if i >= 100 then "\\" <> conv.int(i) elsif i >= 10 then "\\0" <> conv.int(i) else "\\00" <> conv.int(i) end
        for n = 0 upto 255 do lookup[n] := intToString(n) end
        fun(i: Int): String lookup[i]
    end

let makeStruct(table: LrTable name: String print: All(s: String) Ok): Ok =
    begin
        let states = table.states
        let rules = table.rules
        let printPairList(A::TYPE B::TYPE)(prEntry: All(a: A b: B) Ok l: Pairlist(A B)): Ok =
            begin
                let rec f(l: Pairlist(A B) count: Int): Ok =
                    case l
                        when pair with p then
                            if count >= numEntries then begin print("\\\n\\") prEntry(p.a p.b) f(p.r 1) end
                            else begin prEntry(p.a p.b) f(p.r count + 1) end
                            end
                        else ok
                    end
                f(l 0)
            end
        let printList(prEntry: All(a: Int) Ok l: Ints): Ok =
            begin
                let rec f(l: Ints count: Int): Ok =
                    case l
                        when cons with c then
                            if count >= numEntries then begin print("\\\n\\") prEntry(c.hd) f(c.tl 1) end
                            else begin prEntry(c.hd) f(c.tl count + 1) end
                            end
                        else ok
                    end
                f(l 0)
            end
        let prEnd(): Ok = print("\\000\\000\\\n\\")
        let printTable(printRow: All(i: Int) Ok count: Int): Ok =
            begin
                print("\"\\\n\\")
                for i = 0 upto count - 1 do printRow(i) end
                print("\"\n")
            end
        let printChar(i: Int): Ok = print(chr(i))
        (* print an integer between 0 and 2^16-1 as a 2-byte character, with
         * the low byte first *)
        let printInt(i: Int): Ok = begin printChar(i % 256) printChar(i / 256) end
        (* encode actions as integers: ACCEPT => 0, ERROR => 1, SHIFT i => 2 +
         * i, REDUCE rulenum => numstates+2+rulenum *)
        let printAction(a: Action): Ok =
            case a
                when aReduce with r then printInt(r.r + states + 2)
                when aShift with s then printInt(s.s + 2)
                when aAccept then printInt(0)
                else printInt(1)
            end
        let printTermAction(t: Int action: Action): Ok = begin printInt(t + 1) printAction(action) end
        let printGoto(n: Int s: Int): Ok = begin printInt(n + 1) printInt(s) end
        let eq = shrinkActionList(table)
        let getActionRow: All(i: Int) ActionEntry =
            begin let a = fromList(:ActionEntry)(eq.reps) fun(i: Int): ActionEntry a[i] end
        let printGotoRow(i: Int): Ok = begin printPairList(:Int :Int)(printGoto table.goto[i]) prEnd() end
        let printActionRow(i: Int): Ok =
            begin
                let e = getActionRow(i)
                printAction(e.default)
                printPairList(:Int :Action)(printTermAction e.row)
                prEnd()
            end
        print("val ")
        print(name)
        print("=")
        print("let val actionRows =\n")
        printTable(printActionRow eq.count)
        print("val actionRowNumbers =\n\"")
        printList(printInt eq.classes)
        print("\"\n")
        print("val gotoT =\n")
        printTable(printGotoRow states)
        print("val numstates = ")
        print(intToString(states))
        print("\nval numrules = ")
        print(intToString(rules))
        print(tableCode)
        print(intToString(table.initialState))
        print("}\nend\n")
    end

(* structure Absyn *)

Let Rec Exp = Option
    eCode with s: String end
    eApp with a: Exp b: Exp end
    eInt with i: Int end
    eTuple with l: lists.T(Exp) end
    eVar with s: String end
    eFn with p: Pat e: Exp end
    eLet with dl: lists.T(Decl) e: Exp end
    eSeq with a: Exp b: Exp end
    eUnit
end
and Pat = Option
    pVar with s: String end
    pApp with s: String p: Pat end
    pInt with i: Int end
    pList with l: lists.T(Pat) end
    pTuple with l: lists.T(Pat) end
    pWild
    pAs with a: Pat b: Pat end
end
and Decl = Tuple p: Pat e: Exp end
Let ARule = Tuple p: Pat e: Exp end
Let Exps = lists.T(Exp)
Let Pats = lists.T(Pat)

let idchar(c: Char): Bool = {c is '\''} orif {c is '_'} orif isAlpha(c) orif isDigit(c)

let codeToIds(s: String): Strings =
    begin
        let rec g(l: Chars r: Strings): Strings =
            case l when cons with c then if isAlpha(c.hd) then f(c.tl lists.cons(:Char)(c.hd lists.nil(:Char)) r)
                else g(c.tl r) end
                else r
            end
        and f(l: Chars accum: Chars r: Strings): Strings =
            case l
                when cons with c then
                    if idchar(c.hd) then f(c.tl lists.cons(:Char)(c.hd accum) r)
                    else g(l lists.cons(:String)(implode(lists.rev(:Char)(accum)) r))
                    end
                else lists.cons(:String)(implode(lists.rev(:Char)(accum)) r)
            end
        g(explode(s) lists.nil(:String))
    end

let wild = option pWild of Pat end
let isWild(p: Pat): Bool = case p when pWild then true else false end

let simplifyRule(rule: ARule): ARule =
    begin
        let used: All(s: String) Bool =
            begin
                let rec f(e: Exp): Strings =
                    case e
                        when eCode with c then codeToIds(c.s)
                        when eApp with a then lists.append(:String)(f(a.a) f(a.b))
                        when eTuple with t then flatten(:String)(lists.map(:Exp :Strings)(f t.l))
                        when eVar with v then lists.cons(:String)(v.s lists.nil(:String))
                        when eFn with x then f(x.e)
                        when eLet with x then
                            lists.append(:String)(flatten(:String)(lists.map(:Decl :Strings)(fun(d: Decl): Strings
                                f(d.e) x.dl))
                                f(x.e))
                        when eSeq with a then lists.append(:String)(f(a.a) f(a.b))
                        else lists.nil(:String)
                    end
                let identifiers = f(rule.e)
                fun(s: String): Bool lists.exists(:String)(fun(a: String): Bool strEq(a s) identifiers)
            end
        let rec simplifyPat(a: Pat): Pat =
            case a
                when pVar with v then if used(v.s) then a else wild end
                when pApp with x then begin let p = simplifyPat(x.p) if isWild(p) then wild
                    else option pApp of Pat with x.s p end end end
                when pList with x then
                    begin
                        let l = lists.map(:Pat :Pat)(simplifyPat x.l)
                        if lists.exists(:Pat)(fun(p: Pat): Bool not(isWild(p)) l) then option pList of Pat with l end
                            else wild end
                    end
                when pTuple with x then
                    begin
                        let l = lists.map(:Pat :Pat)(simplifyPat x.l)
                        if lists.exists(:Pat)(fun(p: Pat): Bool not(isWild(p)) l) then option pTuple of Pat with l end
                            else wild end
                    end
                when pAs with x then
                    begin
                        let a1 = simplifyPat(x.a)
                        let b1 = simplifyPat(x.b)
                        if isWild(a1) then b1 elsif isWild(b1) then a1 else option pAs of Pat with a1 b1 end end
                    end
                else a
            end
        let rec simplifyExp(e: Exp): Exp =
            case e
                when eApp with x then option eApp of Exp with simplifyExp(x.a) simplifyExp(x.b) end
                when eTuple with x then option eTuple of Exp with lists.map(:Exp :Exp)(simplifyExp x.l) end
                when eFn with x then option eFn of Exp with simplifyPat(x.p) simplifyExp(x.e) end
                when eLet with x then
                    option eLet of Exp with
                        lists.map(:Decl :Decl)(fun(d: Decl): Decl tuple let p = simplifyPat(d.p)
                            let e = simplifyExp(d.e) end x.dl)
                        simplifyExp(x.e)
                    end
                when eSeq with x then option eSeq of Exp with simplifyExp(x.a) simplifyExp(x.b) end
                else e
            end
        let p = simplifyPat(rule.p)
        let e = simplifyExp(rule.e)
        tuple let p = p let e = e end
    end

Let Pieces = lists.T(Strings)

let printRule(say: All(s: String) Ok sayln: All(s: String) Ok): All(r: ARule) Ok =
    begin
        let one(s: String): Strings = lists.cons(:String)(s lists.nil(:String))
        let three(a: String b: String c: String): Strings =
            lists.cons(:String)(a lists.cons(:String)(b lists.cons(:String)(c lists.nil(:String))))
        let lp = one("(")
        let rp = one(")")
        let sp = one(" ")
        let sm = one(";")
        let cm = one(",")
        let cr = one("\n")
        let unit = one("()")
        let cat(l: Pieces): Strings = flatten(:String)(l)
        let ps(l: Array(Strings)): Pieces = lists.fromArray(:Strings)(l)
        let rec printExp(c: Exp): Strings =
            case c
                when eCode with x then three("(" x.s ")")
                when eApp with x then
                    case x.a
                        when eVar with a then
                            case x.b
                                when eUnit then three(a.s " " "()")
                                when eInt with i then three(a.s " " intToString(i.i))
                                when eVar with b then three(a.s " " b.s)
                                else cat(ps(array of one(a.s) lp printExp(x.b) rp end))
                            end
                        else cat(ps(array of lp printExp(x.a) rp lp printExp(x.b) rp end))
                    end
                when eInt with x then one(intToString(x.i))
                when eTuple with x then
                    case x.l
                        when cons with c then
                            begin
                                let rec scan(l: Exps): Pieces =
                                    case l
                                        when cons with h
                                            then lists.cons(:Strings)(cm
                                                lists.cons(:Strings)(printExp(h.hd) scan(h.tl)))
                                        else lists.cons(:Strings)(rp lists.nil(:Strings))
                                    end
                                cat(lists.cons(:Strings)(lp lists.cons(:Strings)(printExp(c.hd) scan(c.tl))))
                            end
                        else one("<bogus-tuple>")
                    end
                when eVar with x then one(x.s)
                when eFn with x then cat(ps(array of one("fn ") printPat(x.p) one(" => ") printExp(x.e) end))
                when eLet with x then
                    case x.dl
                        when nil then printExp(x.e)
                        else
                            begin
                                let rec scan(l: lists.T(Decl)): Pieces =
                                    case l
                                        when cons with h then lists.cons(:Strings)(printDecl(h.hd) scan(h.tl))
                                        else ps(array of one(" in ") printExp(x.e) one(" end") cr end)
                                    end
                                cat(lists.cons(:Strings)(one("let ") scan(x.dl)))
                            end
                    end
                when eSeq with x then cat(ps(array of lp printExp(x.a) sm printExp(x.b) rp end))
                when eUnit then unit
            end
        and printDecl(d: Decl): Strings = cat(ps(array of one("val ") printPat(d.p) one("=") printExp(d.e) cr end))
        and printPat(c: Pat): Strings =
            case c
                when pAs with x then
                    begin
                        let general(): Strings = cat(ps(array of lp printPat(x.a) one(") as (") printPat(x.b) rp end))
                        case x.a
                            when pVar with a then case x.b when pVar with b then three(a.s " as " b.s)
                                else general() end
                            else general()
                        end
                    end
                when pApp with x then
                    case x.p
                        when pWild then three(x.s " " "_")
                        when pInt with i then three(x.s " " intToString(i.i))
                        when pVar with b then three(x.s " " b.s)
                        else cat(ps(array of lp one(x.s) sp printPat(x.p) rp end))
                    end
                when pInt with x then one(intToString(x.i))
                when pList with x then
                    case x.l
                        when nil then one("<bogus-list>")
                        else
                            begin
                                let rec scan(l: Pats): Pieces =
                                    begin
                                        let h = l!cons
                                        case h.tl
                                            when nil then lists.cons(:Strings)(printPat(h.hd) lists.nil(:Strings))
                                            else lists.cons(:Strings)(printPat(h.hd)
                                                lists.cons(:Strings)(one("::") scan(h.tl)))
                                        end
                                    end
                                cat(scan(x.l))
                            end
                    end
                when pTuple with x then
                    case x.l
                        when cons with c then
                            begin
                                let rec scan(l: Pats): Pieces =
                                    case l
                                        when cons with h
                                            then lists.cons(:Strings)(cm
                                                lists.cons(:Strings)(printPat(h.hd) scan(h.tl)))
                                        else lists.cons(:Strings)(rp lists.nil(:Strings))
                                    end
                                cat(lists.cons(:Strings)(lp lists.cons(:Strings)(printPat(c.hd) scan(c.tl))))
                            end
                        else one("<bogus-pattern-tuple>")
                    end
                when pVar with x then one(x.s)
                when pWild then one("_")
            end
        let oursay(a: String): Ok = if strEq(a "\n") then sayln("") else say(a) end
        fun(a: ARule): Ok
            begin
                let r = simplifyRule(a)
                lists.app(:String)(oursay printPat(r.p))
                say(" => ")
                lists.app(:String)(oursay printExp(r.e))
            end
    end

(* functor ParseGenFun *)

(* approx. maximum length of a line *)
let lineLength = 70

let semantic: Exception = exception semantic: Ok end

(* structure SymbolHash: assigns each distinct string a number, in the order
 * they are added *)
Let SymbolHash = Tuple count: Int table: RbTree(KV(String Int)) end
let gtStringKey(a: KV(String Int) b: KV(String Int)): Bool = strGt(a.k b.k)
let hashEmpty: SymbolHash = tuple let count = 0 let table = rbEmpty(:KV(String Int))() end
let hashAdd(e: String h: SymbolHash): SymbolHash =
    tuple let count = h.count + 1
        let table = rbInsert(:KV(String Int))(gtStringKey kv(:String :Int)(e h.count) h.table) end
let hashFind(e: String h: SymbolHash): Opt(Int) = tableFind(:String :Int)(strGt e h.table)
let hashExists(e: String h: SymbolHash): Bool =
    rbExists(:KV(String Int))(gtStringKey kv(:String :Int)(e 0) h.table)

(* A rule, its symbols numbered *)
Let PRule = Tuple lhs: Int rhs: GSymbols code: String prec: Opt(Int) rulenum: Int end

(* names of structures in the program being generated *)
Let Names = Tuple
    miscStruct: String
    tableStruct: String
    tokenStruct: String
    actionsStruct: String
    valueStruct: String
    ecStruct: String
    arg: String
    tokenSig: String
    miscSig: String
    dataStruct: String
    dataSig: String
end

(* common functions and values used in printing out program *)
Let Values = Tuple
    say: All(s: String) Ok
    saydot: All(s: String) Ok
    sayln: All(s: String) Ok
    pureActions: Bool
    posType: String
    argType: String
    ntvoid: String
    termvoid: String
    start: Int
    hasType: All(s: GSymbol) Bool
    termToString: All(t: Int) String
    symbolToString: All(s: GSymbol) String
    term: Constrs
    nonterm: Constrs
    terms: Ints
end

let printTypes(v: Values names: Names symbolType: All(s: GSymbol) Opt(String)): Ok =
    begin
        let say = v.say
        let sayln = v.sayln
        let prConstr(c: Constr): Ok =
            case c.ty
                when oSome with s then
                    say(" | " <> c.sym.name <> " of " <> if v.pureActions then "" else "unit -> " end <> " ("
                        <> s.x <> ")")
                else ok
            end
        sayln("local open Header in")
        sayln("type pos = " <> v.posType)
        sayln("type arg = " <> v.argType)
        sayln("structure " <> names.valueStruct <> " = ")
        sayln("struct")
        say("datatype svalue = " <> v.termvoid <> " | " <> v.ntvoid <> " of" <> if v.pureActions then ""
            else " unit -> " end
            <> " unit")
        lists.app(:Constr)(prConstr v.term)
        lists.app(:Constr)(prConstr v.nonterm)
        sayln("\nend")
        sayln("type svalue = " <> names.valueStruct <> ".svalue")
        say("type result = ")
        case symbolType(nontermSym(v.start)) when oSome with t then begin say(t.x) sayln("") end else sayln("unit") end
        sayln("end")
    end

(* function to print Tokens{n} structure *)
let printTokenStruct(v: Values names: Names): Ok =
    begin
        let say = v.say
        let sayln = v.sayln
        sayln("structure " <> names.tokenStruct <> " : " <> names.tokenSig <> " =")
        sayln("struct")
        sayln("type svalue = " <> names.dataStruct <> ".svalue")
        sayln("type ('a,'b) token = ('a,'b) Token.token")
        lists.app(:Int)(
            fun(i: Int): Ok
                begin
                    say("fun ")
                    say(v.termToString(i))
                    say(" (")
                    if v.hasType(termSym(i)) then say("i,") end
                    say("p1,p2) = Token.TOKEN (")
                    say(names.dataStruct <> "." <> names.tableStruct <> ".T ")
                    say(intToString(i))
                    say(",(")
                    say(names.dataStruct <> "." <> names.valueStruct <> ".")
                    if v.hasType(termSym(i)) then
                        begin say(v.termToString(i)) if v.pureActions then say(" i") else say(" (fn () => i)") end end
                    else say(v.termvoid)
                    end
                    say(",")
                    sayln("p1,p2))")
                end
            v.terms)
        sayln("end")
    end

(* function to print signatures out - takes print function which does not
 * need to insert line breaks *)
let printSigs(v: Values names: Names say: All(s: String) Ok): Ok =
    say("signature " <> names.tokenSig <> " =\nsig\ntype ('a,'b) token\ntype svalue\n" <>
        lists.foldr(:Constr :String)(
            fun(c: Constr r: String): String
                concat(lists.fromArray(:String)(array of
                    "val " c.sym.name
                    case c.ty when oSome with l then ": (" <> l.x <> ") * " else ": " end
                    " 'a * 'a -> (svalue,'a) token\n" r
                end))
            "" v.term) <>
        "end\nsignature " <> names.miscSig <> "=\nsig\nstructure Tokens : " <> names.tokenSig <> "\nstructure " <>
        names.dataStruct <> ":" <> names.dataSig <> "\nsharing type " <> names.dataStruct <>
        ".Token.token = Tokens.token\nsharing type " <> names.dataStruct <> ".svalue = Tokens.svalue\nend\n")

Let TermValue = Tuple t: Int s: String end
Let TermChange = Tuple a: Ints b: Ints end

(* function to print structure for error correction *)
let printEC(keyword: Ints preferredChange: lists.T(TermChange) noshift: Ints value: lists.T(TermValue) v: Values
        names: Names): Ok =
    begin
        let say = v.say
        let sayln = v.sayln
        let sayterm(i: Int): Ok = begin say("(T ") say(intToString(i)) say(")") end
        let printBoolCase(l: Ints): Ok =
            begin
                say("fn ")
                lists.app(:Int)(fun(t: Int): Ok begin sayterm(t) say(" => true") say(" | ") end l)
                sayln("_ => false")
            end
        let printTermList(l: Ints): Ok =
            begin lists.app(:Int)(fun(t: Int): Ok begin sayterm(t) say(" :: ") end l) sayln("nil") end
        let printChange(): Ok =
            begin
                sayln("val preferred_change = ")
                lists.app(:TermChange)(
                    fun(c: TermChange): Ok begin say("(") printTermList(c.a) say(",") printTermList(c.b)
                        sayln(")::") end
                    preferredChange)
                sayln("nil")
            end
        let printErrValues(l: lists.T(TermValue)): Ok =
            begin
                sayln("local open Header in")
                sayln("val errtermvalue=")
                say("fn ")
                lists.app(:TermValue)(
                    fun(ts: TermValue): Ok
                        begin
                            sayterm(ts.t)
                            say(" => ")
                            v.saydot(names.valueStruct)
                            say(v.termToString(ts.t))
                            say("(")
                            if not(v.pureActions) then say("fn () => ") end
                            say("(")
                            say(ts.s)
                            say("))")
                            sayln(" | ")
                        end
                    l)
                say("_ => ")
                say(names.valueStruct <> ".")
                sayln(v.termvoid)
                sayln("end")
            end
        let printNames(): Ok =
            begin
                let f(term: Int): Ok =
                    begin sayterm(term) say(" => ") say("\"") say(v.termToString(term)) sayln("\"") say("  | ") end
                sayln("val showTerminal =")
                say("fn ")
                lists.app(:Int)(f v.terms)
                sayln("_ => \"bogus-term\"")
            end
        let ecTerms =
            lists.foldr(:Int :Ints)(
                fun(t: Int r: Ints): Ints
                    if v.hasType(termSym(t))
                        orif lists.exists(:TermValue)(fun(a: TermValue): Bool a.t is t value) then r
                    else lists.cons(:Int)(t r)
                    end
                lists.nil(:Int) v.terms)
        say("structure ")
        say(names.ecStruct)
        sayln("=")
        sayln("struct")
        say("open ")
        sayln(names.tableStruct)
        sayln("val is_keyword =")
        printBoolCase(keyword)
        printChange()
        sayln("val noShift = ")
        printBoolCase(noshift)
        printNames()
        printErrValues(value)
        say("val terms = ")
        printTermList(ecTerms)
        sayln("end")
    end

Let NumberedSym = Tuple sym: GSymbol num: Int typed: Bool end
Let NumberedSyms = lists.T(NumberedSym)

let printAction(rules: lists.T(PRule) v: Values names: Names): Ok =
    begin
        let say = v.say
        let sayln = v.sayln
        let printAbsynRule = printRule(say sayln)
        let isNonterm(s: GSymbol): Bool = case s when sNonterm then true else false end
        let gtSymKey(a: KV(GSymbol Int) b: KV(GSymbol Int)): Bool = gtSymbol(a.k b.k)
        Let Numbering = Tuple r: NumberedSyms table: RbTree(KV(GSymbol Int)) end
        let numberRhs(r: GSymbols): NumberedSyms =
            lists.foldl(:GSymbol :Numbering)(
                fun(e: GSymbol n: Numbering): Numbering
                    begin
                        let num = case tableFind(:GSymbol :Int)(gtSymbol e n.table) when oSome with i
                            then i.x else 1 end
                        tuple
                            let r = lists.cons(:NumberedSym)(
                                tuple let sym = e let num = num let typed = v.hasType(e) orif isNonterm(e) end n.r)
                            let table = rbInsert(:KV(GSymbol Int))(gtSymKey kv(:GSymbol :Int)(e num + 1) n.table)
                        end
                    end
                tuple let r = lists.nil(:NumberedSym) let table = rbEmpty(:KV(GSymbol Int))() end r).r
        let saySym = v.symbolToString
        let pvar(s: String): Pat = option pVar of Pat with s end
        let evar(s: String): Exp = option eVar of Exp with s end
        let pas(a: Pat b: Pat): Pat = option pAs of Pat with a b end
        let ptuple(l: Array(Pat)): Pat = option pTuple of Pat with lists.fromArray(:Pat)(l) end
        let etuple(l: Array(Exp)): Exp = option eTuple of Exp with lists.fromArray(:Exp)(l) end
        let eapp(a: Exp b: Exp): Exp = option eApp of Exp with a b end
        let efn(p: Pat e: Exp): Exp = option eFn of Exp with p e end
        let elet(dl: lists.T(Decl) e: Exp): Exp = option eLet of Exp with dl e end
        let vb(p: Pat e: Exp): Decl = tuple let p = p let e = e end
        let printCase(i: Int r: PRule): Ok =
            begin
                (* mkToken: Build an argument *)
                let mkToken(s: NumberedSym): Pat =
                    begin
                        let sym = s.sym
                        let num = s.num
                        let symString = v.symbolToString(sym)
                        let symNum = symString <> intToString(num)
                        ptuple(array of
                            wild
                            ptuple(array of
                                if not(v.hasType(sym)) then
                                    if isNonterm(sym) then option pApp of Pat with names.valueStruct <> "."
                                        <> v.ntvoid pvar(symNum) end
                                    else wild
                                    end
                                else
                                    option pApp of Pat with
                                        names.valueStruct <> "." <> symString
                                        if {num is 1} andif v.pureActions then pas(pvar(symNum) pvar(symString))
                                        else pvar(symNum)
                                        end
                                    end
                                end
                                if num is 1 then pas(pvar(symString <> "left") pvar(symNum <> "left"))
                                else pvar(symNum <> "left")
                                end
                                if num is 1 then pas(pvar(symString <> "right") pvar(symNum <> "right"))
                                else pvar(symNum <> "right")
                                end
                            end)
                        end)
                    end
                let numberedRhs = numberRhs(r.rhs)
                (* construct case pattern *)
                let pat = ptuple(array of
                    option pInt of Pat with i end
                    option pList of Pat with
                        lists.append(:Pat)(lists.map(:NumberedSym :Pat)(mkToken numberedRhs)
                            lists.cons(:Pat)(pvar("rest671") lists.nil(:Pat)))
                    end
                end)
                (* remove terminals in argument list w/o types *)
                let argsWithTypes =
                    lists.foldr(:NumberedSym :NumberedSyms)(
                        fun(s: NumberedSym r: NumberedSyms): NumberedSyms if s.typed
                            then lists.cons(:NumberedSym)(s r) else r end
                        lists.nil(:NumberedSym) numberedRhs)
                (* construct case body *)
                let defaultPos = evar("defaultPos")
                let resultexp = evar("result")
                let resultpat = pvar("result")
                let code = option eCode of Exp with r.code end
                let rest = evar("rest671")
                let lhs = nontermSym(r.lhs)
                let body =
                    elet(
                        lists.cons(:Decl)(
                            vb(resultpat
                                eapp(evar(names.valueStruct <> "." <> if v.hasType(lhs) then saySym(lhs)
                                    else v.ntvoid end)
                                    if v.pureActions then code
                                    elsif lists.null(:NumberedSym)(argsWithTypes) then efn(wild code)
                                    else
                                        efn(wild
                                            begin
                                                let body =
                                                    elet(
                                                        lists.map(:NumberedSym :Decl)(
                                                            fun(s: NumberedSym): Decl
                                                                begin
                                                                    let symString = v.symbolToString(s.sym)
                                                                    let symNum = symString <> intToString(s.num)
                                                                    vb(if s.num is 1
                                                                        then pas(pvar(symString) pvar(symNum))
                                                                        else pvar(symNum)
                                                                        end
                                                                        eapp(evar(symNum) option eUnit of Exp end))
                                                                end
                                                            lists.rev(:NumberedSym)(argsWithTypes))
                                                        code)
                                                if v.hasType(lhs) then body
                                                else option eSeq of Exp with body option eUnit of Exp end end
                                                end
                                            end)
                                    end))
                            lists.nil(:Decl))
                        etuple(array of
                            eapp(evar(names.tableStruct <> ".NT") option eInt of Exp with r.lhs end)
                            case r.rhs
                                when nil then etuple(array of resultexp defaultPos defaultPos end)
                                else
                                    begin
                                        let rs = lists.hd(:NumberedSym)(numberedRhs)
                                        let ls = lists.hd(:NumberedSym)(lists.rev(:NumberedSym)(numberedRhs))
                                        etuple(array of
                                            resultexp
                                            evar(v.symbolToString(ls.sym) <> intToString(ls.num) <> "left")
                                            evar(v.symbolToString(rs.sym) <> intToString(rs.num) <> "right")
                                        end)
                                    end
                            end
                            rest
                        end))
                printAbsynRule(tuple let p = pat let e = body end)
            end
        let prRules(): Ok =
            begin
                sayln("fn (i392,defaultPos,stack,")
                say("    (")
                say(names.arg)
                sayln("):arg) =>")
                sayln("case (i392,stack)")
                say("of ")
                lists.app(:PRule)(fun(rule: PRule): Ok begin printCase(rule.rulenum rule) say("| ") end rules)
                sayln("_ => raise (mlyAction i392)")
            end
        say("structure ")
        say(names.actionsStruct)
        sayln(" =")
        sayln("struct ")
        sayln("exception mlyAction of int")
        sayln("local open Header in")
        sayln("val actions = ")
        prRules()
        sayln("end")
        say("val void = ")
        v.saydot(names.valueStruct)
        sayln(v.termvoid)
        say("val extract = ")
        say("fn a => (fn ")
        v.saydot(names.valueStruct)
        if v.hasType(nontermSym(v.start)) then say(v.symbolToString(nontermSym(v.start))) else say("ntVOID") end
        sayln(" x => x")
        sayln("| _ => let exception ParseInternal")
        say("\tin raise ParseInternal end) a ")
        sayln(if v.pureActions then "" else "()" end)
        sayln("end")
    end

let makeParser(p: ParseResult spec: String error: All(l: Int msg: String) Ok wasError: All() Bool): Ok =
    begin
        let header = p.header
        let d = p.decl
        let control = d.control
        let verbose = lists.exists(:Control)(fun(c: Control): Bool case c when cVerbose then true
            else false end control)
        let defaultReductions =
            not(lists.exists(:Control)(fun(c: Control): Bool case c when cNodefault then true else false end control))
        let rec posTypeF(l: Controls): Opt(String) =
            case l when cons with c then case c.hd when cPos with s then some(:String)(s.s) else posTypeF(c.tl) end
                else none(:String)()
            end
        let rec startF(l: Controls): Opt(Symbol) =
            case l when cons with c then case c.hd when cStartSym with s then some(:Symbol)(s.s) else startF(c.tl) end
                else none(:Symbol)()
            end
        let rec nameF(l: Controls): Opt(Symbol) =
            case l when cons with c then case c.hd when cParserName with s then some(:Symbol)(s.s) else nameF(c.tl) end
                else none(:Symbol)()
            end
        let rec headerDeclF(l: Controls): Opt(String) =
            case l when cons with c then case c.hd when cFunctor with s then some(:String)(s.s)
                else headerDeclF(c.tl) end
                else none(:String)()
            end
        Let ArgDecl = Tuple a: String b: String end
        let rec argDeclF(l: Controls): ArgDecl =
            case l
                when cons with c then
                    case c.hd when cParseArg with s then tuple let a = s.a let b = s.b end else argDeclF(c.tl) end
                else tuple let a = "()" let b = "unit" end
            end
        let rec noshiftF(l: Controls): Symbols =
            case l when cons with c then case c.hd when cNshift with s then s.l else noshiftF(c.tl) end
                else lists.nil(:Symbol)
            end
        let rec pureActionsF(l: Controls): Bool =
            case l when cons with c then case c.hd when cPure then true else pureActionsF(c.tl) end else false end
        let posType0 = posTypeF(control)
        let start0 = startF(control)
        let name = nameF(control)
        let headerDecl = headerDeclF(control)
        let argDecl = argDeclF(control)
        let noshift0 = noshiftF(control)
        let pureActions = pureActionsF(control)
        let term =
            case d.term when oSome with l then l.x
                else begin error(1 "missing %term definition") lists.nil(:Constr) end end
        let nonterm =
            case d.nonterm when oSome with l then l.x
                else begin error(1 "missing %nonterm definition") lists.nil(:Constr) end
            end
        let posType = case posType0 when oSome with l then l.x else begin error(1 "missing %pos definition") "" end end
        let termHash =
            lists.foldr(:Constr :SymbolHash)(
                fun(c: Constr table: SymbolHash): SymbolHash
                    begin
                        let name = c.sym.name
                        if hashExists(name table) then
                            begin error(c.sym.pos "duplicate definition of " <> name <> " in %term") table end
                        else hashAdd(name table)
                        end
                    end
                hashEmpty term)
        let isTerm(name: String): Bool = hashExists(name termHash)
        let symbolHash =
            lists.foldr(:Constr :SymbolHash)(
                fun(c: Constr table: SymbolHash): SymbolHash
                    begin
                        let name = c.sym.name
                        if hashExists(name table) then
                            begin
                                error(c.sym.pos
                                    if isTerm(name) then name <> " is defined as a terminal and a nonterminal"
                                    else "duplicate definition of " <> name <> " in %nonterm"
                                    end)
                                table
                            end
                        else hashAdd(name table)
                        end
                    end
                termHash nonterm)
        let rec makeUniqueId(s: String): String = if hashExists(s symbolHash) then makeUniqueId(s <> "'") else s end
        if wasError() then raise semantic end end
        let numTerms = termHash.count
        let numNonterms = symbolHash.count - numTerms
        let symError(sym: String err: String symbol: Symbol): Ok =
            error(symbol.pos symbol.name <> " in " <> err <> " is not defined as a " <> sym)
        let termNum(stmt: String): All(symbol: Symbol) Int =
            fun(symbol: Symbol): Int
                case hashFind(symbol.name symbolHash)
                    when oSome with i then
                        if i.x < numTerms then i.x else begin symError("terminal" stmt symbol) 0 - 1 end end
                    else begin symError("terminal" stmt symbol) 0 - 1 end
                end
        let nontermNum(stmt: String): All(symbol: Symbol) Int =
            fun(symbol: Symbol): Int
                case hashFind(symbol.name symbolHash)
                    when oSome with i then
                        if i.x >= numTerms then i.x - numTerms
                            else begin symError("nonterminal" stmt symbol) 0 - 1 end end
                    else begin symError("nonterminal" stmt symbol) 0 - 1 end
                end
        let symbolNum(stmt: String): All(symbol: Symbol) GSymbol =
            fun(symbol: Symbol): GSymbol
                case hashFind(symbol.name symbolHash)
                    when oSome with i then if i.x >= numTerms then nontermSym(i.x - numTerms) else termSym(i.x) end
                    else begin symError("symbol" stmt symbol) nontermSym(0 - 1) end
                end
        (* map all symbols in the following values to terminals and check that
         * the symbols are defined as terminals *)
        let mapTerms(f: All(s: Symbol) Int l: Symbols): Ints = lists.map(:Symbol :Int)(f l)
        let eop = mapTerms(termNum("%eop") d.eop)
        let keyword = mapTerms(termNum("%keyword") d.keyword)
        Let TermPrec = Tuple prec: Prec terms: Ints end
        let prec =
            lists.map(:PrecDecl :TermPrec)(
                fun(pd: PrecDecl): TermPrec
                    tuple
                        let prec = pd.prec
                        let terms =
                            case pd.prec
                                when pLeft then mapTerms(termNum("%left") pd.syms)
                                when pRight then mapTerms(termNum("%right") pd.syms)
                                when pNonassoc then mapTerms(termNum("%nonassoc") pd.syms)
                            end
                    end
                d.prec)
        let change =
            begin
                let mapTerm = termNum("%prefer, %subst, or %change")
                lists.map(:Change :TermChange)(
                    fun(c: Change): TermChange
                        begin
                            let a = mapTerms(mapTerm c.a)
                            let b = mapTerms(mapTerm c.b)
                            tuple let a = a let b = b end
                        end
                    d.change)
            end
        let noshift = mapTerms(termNum("%noshift") noshift0)
        let value =
            begin
                let mapTerm = termNum("%value")
                lists.map(:ValueDecl :TermValue)(fun(x: ValueDecl): TermValue tuple let t = mapTerm(x.sym)
                    let s = x.s end
                    d.value)
            end
        let rules =
            begin
                let symbolNum = symbolNum("rule")
                let nontermNum = nontermNum("rule")
                let termNum = termNum("%prec tag")
                Let LN = Tuple l: lists.T(PRule) n: Int end
                lists.foldr(:HRule :LN)(
                    fun(r: HRule ln: LN): LN
                        begin
                            let lhs = nontermNum(r.lhs)
                            let rhs = lists.map(:Symbol :GSymbol)(symbolNum r.rhs)
                            let prec = case r.prec when oSome with t then some(:Int)(termNum(t.x)) else none(:Int)() end
                            tuple
                                let l = lists.cons(:PRule)(
                                    tuple let lhs = lhs let rhs = rhs let code = r.code let prec = prec
                                        let rulenum = ln.n end
                                    ln.l)
                                let n = ln.n - 1
                            end
                        end
                    tuple let l = lists.nil(:PRule) let n = lists.length(:HRule)(p.rules) - 1 end p.rules).l
            end
        if wasError() then raise semantic end end
        (* termToString: map terminals back to strings *)
        let termToString: All(t: Int) String =
            begin
                let data = array of(numTerms "")
                lists.app(:Constr)(
                    fun(c: Constr): Ok
                        begin let name = c.sym.name data[hashFind(name symbolHash)!oSome.x] := name end
                    term)
                fun(i: Int): String if {i < 0} orif {i >= numTerms} then "bogus-num" <> intToString(i) else data[i] end
            end
        let nontermToString: All(n: Int) String =
            begin
                let data = array of(numNonterms "")
                lists.app(:Constr)(
                    fun(c: Constr): Ok
                        begin let name = c.sym.name data[hashFind(name symbolHash)!oSome.x - numTerms] := name end
                    nonterm)
                fun(i: Int): String if {i < 0} orif {i >= numNonterms} then "bogus-num" <> intToString(i)
                    else data[i] end
            end
        (* create functions mapping terminals to precedence numbers and rules to
         * precedence numbers *)
        let termPrec: All(t: Int) Opt(Int) =
            begin
                let precData = array of(numTerms none(:Int)())
                let addPrec(termPrec: Opt(Int)): All(t: Int) Ok =
                    fun(i: Int): Ok
                        case precData[i]
                            when oSome then error(1 "multiple precedences specified for terminal " <> termToString(i))
                            else precData[i] := termPrec
                        end
                let termPrec(p: TermPrec i: Int): Int =
                    case p.prec when pLeft then i when pRight then i + 2 when pNonassoc then i + 1 end
                lists.foldl(:TermPrec :Int)(
                    fun(p: TermPrec i: Int): Int begin
                        lists.app(:Int)(addPrec(some(:Int)(termPrec(p i))) p.terms) i + 3 end
                    0 prec)
                fun(i: Int): Opt(Int) if {i < 0} orif {i >= numTerms} then none(:Int)() else precData[i] end
            end
        let elimAssoc(i: Int): Int = {i - {i % 3}} + 1
        let rulePrec(rhs: GSymbols): Opt(Int) =
            begin
                let rec findRightTerm(l: GSymbols r: Opt(Int)): Opt(Int) =
                    case l
                        when cons with c then
                            case c.hd when sTerm with t then findRightTerm(c.tl some(:Int)(t.t))
                                else findRightTerm(c.tl r) end
                        else r
                    end
                case findRightTerm(rhs none(:Int)())
                    when oSome with t then
                        case termPrec(t.x) when oSome with i then some(:Int)(elimAssoc(i.x)) else none(:Int)() end
                    else none(:Int)()
                end
            end
        let grammarRules =
            lists.map(:PRule :GRule)(
                fun(r: PRule): GRule
                    tuple
                        let lhs = r.lhs
                        let rhs = r.rhs
                        let precedence =
                            case r.prec
                                when oSome with t then
                                    case termPrec(t.x) when oSome with i then some(:Int)(elimAssoc(i.x))
                                        else none(:Int)() end
                                else rulePrec(r.rhs)
                            end
                        let rulenum = r.rulenum
                    end
                rules)
        (* get start symbol *)
        let start =
            case start0 when oSome with name then nontermNum("%start")(name.x)
                else lists.hd(:GRule)(grammarRules).lhs end
        let symbolType: All(s: GSymbol) Opt(String) =
            begin
                let data = array of(numTerms + numNonterms none(:String)())
                let unmap(c: Constr): Ok = data[hashFind(c.sym.name symbolHash)!oSome.x] := c.ty
                lists.app(:Constr)(unmap term)
                lists.app(:Constr)(unmap nonterm)
                fun(s: GSymbol): Opt(String)
                    case s
                        when sNonterm with n then
                            if {n.n < 0} orif {n.n >= numNonterms} then none(:String)() else data[n.n + numTerms] end
                        when sTerm with t then if {t.t < 0} orif {t.t >= numTerms} then none(:String)()
                            else data[t.t] end
                    end
            end
        let symbolToString(s: GSymbol): String =
            case s when sNonterm with n then nontermToString(n.n) when sTerm with t then termToString(t.t) end
        let grammar: Grammar =
            tuple
                let rules = grammarRules let terms = numTerms let nonterms = numNonterms let start = start let eop = eop
                let noshift = noshift let precedence = termPrec let termToString = termToString
                let nontermToString = nontermToString
            end
        let name1 = case name when oSome with s then s.x.name else "" end
        let names: Names =
            tuple
                let miscStruct = name1 <> "LrValsFun" let tableStruct = "LrTable" let tokenStruct = "Tokens"
                let actionsStruct = "Actions" let valueStruct = "MlyValue" let ecStruct = "EC" let arg = argDecl.a
                let tokenSig = name1 <> "_TOKENS" let miscSig = name1 <> "_LRVALS" let dataStruct = "ParserData"
                let dataSig = "PARSER_DATA"
            end
        let made = mkTable(grammar defaultReductions)
        let result = writer.file(spec <> ".sml")
        let sigs = writer.file(spec <> ".sig")
        let posCell = tuple let var pos = 0 end
        let pr(s: String): Ok = writer.putString(result s)
        let say(s: String): Ok =
            begin
                let l = stringOp.length(s)
                let newPos = posCell.pos + l
                if newPos > lineLength then begin pr("\n") posCell.pos := l end else posCell.pos := newPos end
                pr(s)
            end
        let saydot(s: String): Ok = say(s <> ".")
        let sayln(t: String): Ok = begin pr(t) pr("\n") posCell.pos := 0 end
        let termvoid = makeUniqueId("VOID")
        let ntvoid = makeUniqueId("ntVOID")
        let hasType(s: GSymbol): Bool = case symbolType(s) when oNone then false else true end
        let terms = begin let rec f(n: Int): Ints = if n is numTerms then lists.nil(:Int)
            else lists.cons(:Int)(n f(n + 1)) end
            f(0) end
        let values: Values =
            tuple
                let say = say let saydot = saydot let sayln = sayln let pureActions = pureActions let posType = posType
                let argType = argDecl.b let ntvoid = ntvoid let termvoid = termvoid let start = start
                    let hasType = hasType
                let termToString = termToString let symbolToString = symbolToString let term = term
                    let nonterm = nonterm
                let terms = terms
            end
        case headerDecl
            when oSome with s then say(s.x)
            else
                begin
                    say("functor ") say(names.miscStruct)
                    sayln("(structure Token : TOKEN)")
                    say(" : sig structure ") say(names.dataStruct)
                    say(" : ") sayln(names.dataSig)
                    say("       structure ")
                    say(names.tokenStruct) say(" : ") sayln(names.tokenSig)
                    sayln("   end")
                end
        end
        sayln(" = ")
        sayln("struct")
        sayln("structure " <> names.dataStruct <> "=")
        sayln("struct")
        sayln("structure Header = ")
        sayln("struct")
        sayln(header)
        sayln("end")
        sayln("structure LrTable = Token.LrTable")
        sayln("structure Token = Token")
        sayln("local open LrTable in ")
        makeStruct(made.table "table" pr)
        sayln("end")
        printTypes(values names symbolType)
        printEC(keyword change noshift value values names)
        printAction(rules values names)
        sayln("end")
        printTokenStruct(values names)
        sayln("end")
        printSigs(values names fun(s: String): Ok writer.putString(sigs s))
        writer.close(sigs)
        writer.close(result)
        (* the summary of conflicts, which the original prints nowhere *)
        let s = summary(made.errs)
    end

let parseGen(spec: String): Ok =
    begin
        let r = parse(spec)
        makeParser(r.result spec fun(l: Int msg: String): Ok error(r.source l msg) fun(): Bool errorOccurred(r.source))
    end

(* structure Main *)

for n = 1 upto bench.count() do parseGen("DATA/ml.grm") end
