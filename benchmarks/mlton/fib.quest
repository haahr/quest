(* fib: the naive doubly recursive Fibonacci function, fib 41 each time *)

import support/bench : support/Bench

let rec fib(n: Int): Int =
    if n is 0 then 0
    elsif n is 1 then 1
    else fib(n - 1) + fib(n - 2)
    end

for i = 1 upto bench.count() do
    if 165580141 isnot fib(41) then raise bench.bug end end
end
