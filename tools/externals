#!/bin/sh
# Launcher for tools/externals.py, which generates the self-hosted compiler's
# table of the standard library's externals from lib/. It finds Python as
# ./questboot does.
if [ -n "$PYTHON" ]; then
    PY="$PYTHON"
elif [ -x "/opt/homebrew/opt/python@3.11/libexec/bin/python" ]; then
    PY="/opt/homebrew/opt/python@3.11/libexec/bin/python"
elif [ -x "/opt/homebrew/bin/python3" ]; then
    PY="/opt/homebrew/bin/python3"
elif command -v python3.11 >/dev/null 2>&1; then
    PY="python3.11"
else
    PY="python3"
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$PY" "$SCRIPT_DIR/externals.py" "$@"
