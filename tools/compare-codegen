#!/bin/sh
# Launcher for tools/compare_codegen.py, which compares the code one compiler
# generates for questlang/ at a revision with the working tree's, ignoring
# source positions. It finds Python with tools/python.sh.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/python.sh"
exec "$PY" "$SCRIPT_DIR/compare_codegen.py" "$@"
