#!/bin/sh
# Launcher for tools/exclusive.py, which runs heavy work one job at a time on
# this machine, on a quiet machine (docs/testing.md section 4.2). It finds
# Python with tools/python.sh.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/python.sh"
exec "$PY" "$SCRIPT_DIR/exclusive.py" "$@"
