#!/bin/sh
# The Quest language server (docs/lsp-plan.md): builds questlang/lsp/main.quest
# with ./quest into .build/lsp when anything it is built from has changed (the
# build engine compiles only what is stale), then runs it on standard input and
# output, with QUEST_HOME set to this checkout so that lib/ and questlang/ are
# found. The build's output goes to standard error, since standard output is
# the protocol's. Editors start this script; tools/vscode's extension does.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
BUILD="$ROOT/.build/lsp"
SERVER="$BUILD/quest-lsp"
(cd "$ROOT" && ./quest --build-dir "$BUILD/build" -o "$SERVER" questlang/lsp/main.quest) 1>&2 || exit 1
QUEST_HOME="$ROOT" exec "$SERVER" "$@"
