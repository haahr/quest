module g : G
export
    let same(A::TYPE)(x: A y: A): Bool = x is y
    let apply(A::TYPE B::TYPE)(f: All(x: A) B x: A): B = f(x)
    let callAll(A::TYPE)(fs: Array(All(x: A) A) x: A): A =
        begin
            let var r = x
            for i = 0 upto extent fs - 1 do r := fs[i](r) end
            r
        end
    let id(A::TYPE)(x: A): A = x
    let put(A::TYPE)(xs: Array(A) i: Int x: A): Ok = xs[i] := x
    let rec iterate(A::TYPE)(f: All(x: A) A x: A n: Int): A = if n is 0 then x else iterate(:A f f(x) n - 1) end
    let fill(A::TYPE)(n: Int x: A): Array(A) = array of(n x)
end
