interface G
export
    same(A::TYPE)(x: A y: A): Bool
    apply(A::TYPE B::TYPE)(f: All(x: A) B x: A): B
    callAll(A::TYPE)(fs: Array(All(x: A) A) x: A): A
    id(A::TYPE)(x: A): A
    put(A::TYPE)(xs: Array(A) i: Int x: A): Ok
    iterate(A::TYPE)(f: All(x: A) A x: A n: Int): A
    fill(A::TYPE)(n: Int x: A): Array(A)
end
