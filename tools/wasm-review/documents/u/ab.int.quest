interface Ab
export
    T::TYPE
    N::TYPE
    X::TYPE
    O::TYPE
    Box::ALL(A::TYPE) TYPE
    Pair::ALL(A::TYPE B::TYPE) TYPE
    mk(x: Int y: Int): T
    sum(t: T): Int
    n(i: Int): N
    x(r: Real): X
    o(i: Int): O
    none: O
    box(A::TYPE a: A): Box(A)
    unbox(A::TYPE b: Box(A)): A
    pair(A::TYPE B::TYPE a: A b: B): Pair(A B)
    first(A::TYPE B::TYPE p: Pair(A B)): A
end
