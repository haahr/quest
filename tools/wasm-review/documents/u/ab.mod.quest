module ab : Ab
export
    Let T = Tuple x: Int y: Int end
    Let N = Int
    Let X = Real
    Let O = Option none some with v: Int end end
    Let Box = Fun(A::TYPE) Tuple v: A end
    Let Pair = Fun(A::TYPE B::TYPE) Tuple a: A b: Array(B) end
    let mk(x: Int y: Int): T = tuple let x = x let y = y end
    let sum(t: T): Int = t.x + t.y
    let n(i: Int): N = i
    let x(r: Real): X = r
    let o(i: Int): O = option some of O with let v = i end
    let none: O = option none of O end
    let box(A::TYPE a: A): Box(A) = tuple let v = a end
    let unbox(A::TYPE b: Box(A)): A = b.v
    let pair(A::TYPE B::TYPE a: A b: B): Pair(A B) = tuple let a = a let b = array of b b end end
    let first(A::TYPE B::TYPE p: Pair(A B)): A = p.a
end
