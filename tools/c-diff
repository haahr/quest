#!/bin/sh
# Launcher for tools/c_diff.py, which diffs the C that a revision's compiler
# generates against the working tree's (docs/testing.md section 2.9). It finds
# Python with tools/python.sh.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/python.sh"
exec "$PY" "$SCRIPT_DIR/c_diff.py" "$@"
