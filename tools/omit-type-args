#!/bin/sh
# Launcher for tools/omit_type_args.py, which omits the written type arguments
# that inference finds throughout questlang/ (docs/type-system.md section 6.9).
# It finds Python with tools/python.sh.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/python.sh"
exec "$PY" "$SCRIPT_DIR/omit_type_args.py" "$@"
