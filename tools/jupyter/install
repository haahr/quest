#!/bin/sh
# Installs the Quest kernel for Jupyter (tools/jupyter/install.py), with
# jupyterlab's own Python, which has ipykernel, or QUEST_JUPYTER_PYTHON
python=${QUEST_JUPYTER_PYTHON:-/opt/homebrew/opt/jupyterlab/libexec/bin/python}
if [ ! -x "$python" ]; then
    echo "install: no Python with Jupyter at $python (set QUEST_JUPYTER_PYTHON)" >&2
    exit 1
fi
exec "$python" "$(dirname "$0")/install.py" --python "$python" "$@"
