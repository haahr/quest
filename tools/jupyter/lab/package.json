{
  "name": "quest-jupyterlab",
  "version": "0.1.0",
  "description": "Quest highlighting and indentation in JupyterLab's editor (docs/jupyter-kernel.md)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/index.js",
  "files": ["src/*.js"],
  "keywords": ["jupyter", "jupyterlab", "jupyterlab-extension"],
  "scripts": {
    "build": "jupyter labextension build .",
    "test": "node test.mjs"
  },
  "dependencies": {
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.2.0",
    "@jupyterlab/codemirror": "^4.0.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.0.0"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "labextension",
    "sharedPackages": {
      "@codemirror/language": {"bundled": false, "singleton": true},
      "@codemirror/state": {"bundled": false, "singleton": true}
    }
  }
}
