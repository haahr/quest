{
  "$comment": "Quest's tokens as tools/jupyter/quest_lexer.py highlights them (docs/syntax.md section 2); its keywords are the tokenizer's, which tests/python/test_lsp.py checks",
  "name": "Quest",
  "scopeName": "source.quest",
  "patterns": [
    {"include": "#comment"},
    {
      "name": "string.quoted.double.quest",
      "begin": "\"",
      "end": "\"",
      "patterns": [{"include": "#escape"}]
    },
    {
      "name": "string.quoted.single.quest",
      "match": "'(?:\\\\(?:[nt\"'\\\\]|x[0-9A-Fa-f]{1,2}|[0-9]{1,3})|[^'\\\\])'"
    },
    {"name": "constant.numeric.hex.quest", "match": "~?0[xX][0-9A-Fa-f]+"},
    {"name": "constant.numeric.float.quest", "match": "~?[0-9]+(?:\\.[0-9]+(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)"},
    {"name": "constant.numeric.integer.quest", "match": "~?[0-9]+"},
    {
      "match": "\\b(let)\\s+(?:(rec|var)\\s+)?([A-Za-z][A-Za-z0-9]*)",
      "captures": {
        "1": {"name": "keyword.other.quest"},
        "2": {"name": "keyword.other.quest"},
        "3": {"name": "entity.name.function.quest"}
      }
    },
    {"name": "constant.language.quest", "match": "\\b(true|false|ok)\\b"},
    {
      "name": "storage.type.quest",
      "match": "\\b(TYPE|POWER|ALL|DEF|All|Array|Auto|Def|Exception|Fun|Let|Option|Out|Rec|Record|Tuple|Var|Variant)\\b"
    },
    {
      "name": "keyword.other.quest",
      "match": "\\b(and|andif|array|as|auto|begin|case|do|downto|else|elsif|end|exception|exit|export|extent|external|for|fun|if|import|inspect|interface|is|isnot|let|loop|module|not|of|option|ordinal|orif|out|raise|rec|record|then|try|tuple|unsound|upto|var|variant|when|while|with)\\b"
    },
    {"name": "entity.name.type.quest", "match": "\\b[A-Z][A-Za-z0-9]*\\b"},
    {"name": "keyword.operator.quest", "match": "[!@#$%&*_+=\\-|\\\\`:<>/?^~]+"}
  ],
  "repository": {
    "comment": {
      "name": "comment.block.quest",
      "begin": "\\(\\*",
      "end": "\\*\\)",
      "patterns": [{"include": "#comment"}]
    },
    "escape": {
      "name": "constant.character.escape.quest",
      "match": "\\\\(?:[nt\"'\\\\]|x[0-9A-Fa-f]{1,2}|[0-9]{1,3})"
    }
  }
}
