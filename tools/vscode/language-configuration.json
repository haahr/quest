{
  "comments": {
    "blockComment": ["(*", "*)"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    {"open": "(", "close": ")"},
    {"open": "[", "close": "]"},
    {"open": "{", "close": "}"},
    {"open": "\"", "close": "\"", "notIn": ["string", "comment"]},
    {"open": "(*", "close": " *)", "notIn": ["string"]}
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(.*\\b(begin|then|else|do|of|export|import|with)\\s*|.*=\\s*)$",
    "decreaseIndentPattern": "^\\s*(end|else|elsif|when|export)\\b"
  }
}
